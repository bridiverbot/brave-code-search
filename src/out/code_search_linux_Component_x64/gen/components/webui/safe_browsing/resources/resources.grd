<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/safe_browsing_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/safe_browsing_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/safe_browsing_resources_map.h"
            type="resource_map_header" />
    <output filename="safe_browsing_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_SAFE_BROWSING_SAFE_BROWSING_CSS" file="${root_gen_dir}/components/webui/safe_browsing/resources/preprocessed/safe_browsing.css" resource_path="safe_browsing.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_SAFE_BROWSING_SAFE_BROWSING_HTML" file="${root_gen_dir}/components/webui/safe_browsing/resources/preprocessed/safe_browsing.html" resource_path="safe_browsing.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_SAFE_BROWSING_SAFE_BROWSING_JS" file="${root_gen_dir}/components/webui/safe_browsing/resources/minified/safe_browsing.js" resource_path="safe_browsing.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
