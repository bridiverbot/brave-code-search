--crate-name
test_simple_rust_exe
--crate-type
bin
-Dwarnings
-Cforce-unwind-tables=yes
-Crelocation-model=pic
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--color=always
--target=aarch64-linux-android
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
-Zbranch-protection=pac-ret,bti
--cfg
cr_rustc_revision="110108a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-8a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-1-24-14453-ge063be79"
-Copt-level=3
-Cforce-frame-pointers=yes
-Zdwarf-version=5
-Cdebuginfo=1
-Zallow-features=
-Cdebug-assertions
-Zdefault-visibility=hidden
--sysroot=local_rustc_sysroot
-Ldependency=local_rustc_sysroot/lib/rustlib/aarch64-linux-android/lib
-Clink-arg=-Bdynamic
-Clink-arg=obj/buildtools/third_party/libunwind/libunwind/Unwind-EHABI.o
