<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/default_browser_modal_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/default_browser_modal_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/default_browser_modal_resources_map.h"
            type="resource_map_header" />
    <output filename="default_browser_modal_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_DEFAULT_BROWSER_MODAL_HEADER_BACKGROUND_SVG" file="${root_src_dir}/chrome/browser/resources/default_browser/default_browser_modal/header_background.svg" resource_path="header_background.svg" use_base_dir="false" type="BINDATA" />
      <include name="IDR_DEFAULT_BROWSER_MODAL_HEADER_BACKGROUND_DARK_SVG" file="${root_src_dir}/chrome/browser/resources/default_browser/default_browser_modal/header_background_dark.svg" resource_path="header_background_dark.svg" use_base_dir="false" type="BINDATA" />
      <include name="IDR_DEFAULT_BROWSER_MODAL_SETTINGS_ILLUSTRATION_SVG" file="${root_src_dir}/chrome/browser/resources/default_browser/default_browser_modal/settings_illustration.svg" resource_path="settings_illustration.svg" use_base_dir="false" type="BINDATA" />
      <include name="IDR_DEFAULT_BROWSER_MODAL_DEFAULT_BROWSER_MODAL_CSS" file="${root_gen_dir}/chrome/browser/resources/default_browser/default_browser_modal/preprocessed/default_browser_modal.css" resource_path="default_browser_modal.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_DEFAULT_BROWSER_MODAL_DEFAULT_BROWSER_MODAL_HTML" file="${root_gen_dir}/chrome/browser/resources/default_browser/default_browser_modal/preprocessed/default_browser_modal.html" resource_path="default_browser_modal.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DEFAULT_BROWSER_MODAL_APP_JS" file="${root_gen_dir}/chrome/browser/resources/default_browser/default_browser_modal/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DEFAULT_BROWSER_MODAL_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/default_browser/default_browser_modal/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DEFAULT_BROWSER_MODAL_BROWSER_PROXY_JS" file="${root_gen_dir}/chrome/browser/resources/default_browser/default_browser_modal/minified/browser_proxy.js" resource_path="browser_proxy.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DEFAULT_BROWSER_MODAL_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/default_browser/default_browser_modal/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DEFAULT_BROWSER_MODAL_DEFAULT_BROWSER_MODAL_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/default_browser/default_browser_modal/minified/default_browser_modal.mojom-webui.js" resource_path="default_browser_modal.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
