/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Настройки Brave";
AIModeSettings.pfm_title = "Настройки интеграции режима ИИ от Google в адресной строке и окне поиска на странице с новой вкладкой";
AIModeSettings.pfm_description = "0 - Разрешить интеграцию режима ИИ\n1 - Запретить интеграцию режима ИИ\nЭто правило определяет, будет ли интегрирован режим ИИ от Google в адресной строке и окне поиска на странице быстрого доступа.\n\nЧтобы получить доступ к этой функции, пользователю нужно сделать Google поисковой системой по умолчанию.\n\nЕсли задано значение \"0\", функция доступна всем пользователям.\n\nЕсли установлено значение \"1\", она недоступна.\n\nЕсли правило не настроено, применяется правило GenAiDefaultSettings.";
AbusiveExperienceInterventionEnforce.pfm_title = "Принудительное прерывание при злоупотреблении доверием";
AbusiveExperienceInterventionEnforce.pfm_description = "Если правило SafeBrowsingEnabled отключено, а правило AbusiveExperienceInterventionEnforce включено или не настроено, то на сайтах, злоупотребляющих доверием, будет заблокировано открытие новых окон и вкладок.\n\nЕсли правила SafeBrowsingEnabled или AbusiveExperienceInterventionEnforce отключены, то новые окна и вкладки на сайтах, злоупотребляющих доверием, блокироваться не будут.";
AccessCodeCastDeviceDuration.pfm_title = "Указывает, сколько секунд устройство для трансляции, выбранное с помощью кода доступа или QR-кода, будет отображаться в списке меню Google Cast";
AccessCodeCastDeviceDuration.pfm_description = "Это правило определяет, сколько секунд устройство для трансляции, выбранное с помощью кода доступа или QR-кода, будет показываться в меню Google Cast.\nОтсчет начинается с момента ввода или сканирования кода.\nВ течение этого периода устройство для трансляции будет доступно в списке меню Google Cast.\nПосле этого нужно будет повторно ввести код доступа или отсканировать QR-код, чтобы воспользоваться устройством.\nПо умолчанию используется нулевой период, поэтому устройства для трансляции не показываются в меню Google Cast и для запуска нового сеанса трансляции нужно повторно ввести или отсканировать код.\nЭто правило определяет только длительность отображения устройств в меню Google Cast и не влияет на текущий сеанс трансляции (не прерывает его).\nЧтобы правило AccessCodeCastEnabled вступило в силу, его нужно включить.";
AccessCodeCastEnabled.pfm_title = "Разрешить пользователям выбирать устройства для трансляции с помощью кода доступа или QR-кода в меню Google Cast";
AccessCodeCastEnabled.pfm_description = "Это правило управляет тем, будет ли пользователю доступен пункт меню Google Cast, позволяющий транслировать контент на устройства, которых нет в меню Google Cast, с помощью кода доступа или QR-кода, показываемого на экране устройства для трансляции.\nПо умолчанию пользователю нужно повторно ввести код доступа или отсканировать QR-код, чтобы начать следующий сеанс трансляции. Если для правила AccessCodeCastDeviceDuration установлено ненулевое значение (0 — значение по умолчанию), устройство для трансляции будет доступно в списке устройств для трансляции до истечения указанного периода.\nЕсли правило включено, пользователи смогут выбирать устройства для трансляции с помощью кода доступа или QR-кода.\nЕсли правило отключено или не настроено, у пользователей не будет такой возможности.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "Выполнять сопоставление с Access-Control-Allow-Methods в предварительном процессе CORS согласно спецификации";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Это правило определяет, будут ли методы запроса указываться в верхнем регистре при сопоставлении с заголовками ответа Access-Control-Allow-Methods в предварительном процессе CORS.\n\nЕсли правило отключено, методы запроса указываются в верхнем регистре.\nЭто относится к Brave 108 и более ранних версий.\n\nЕсли правило включено или не настроено, методы запроса, кроме DELETE, GET, HEAD, OPTIONS, POST и PUT, не указываются в верхнем регистре.\nВ таком случае заголовок ответа fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" будет отклонен, а заголовок ответа fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\" принят.\n\nПримечание. Это не относится к методам запроса \"post\" и \"put\", но относится к методу \"patch\".\n\nЭто правило используется временно и будет удалено в будущем.";
AccessibilityImageLabelsEnabled.pfm_title = "Включить функцию \"Get Image Descriptions from Google\"";
AccessibilityImageLabelsEnabled.pfm_description = "Специальная возможность \"Get Image Descriptions from Google\"\nпозволяет людям, которые пользуются программами чтения с экрана,\nпрослушивать описания размещенных в Интернете изображений без названия. Пользователи, включившие эту функцию,\nсмогут автоматически получать описания таких изображений\nс помощью анонимного сервиса Google.\n\nЕсли функция включена, содержимое\nизображений отправляется на сервера Google. Файлы cookie и другие пользовательские данные\nпри этом не отправляются. Google не сохраняет и не регистрирует содержимое изображения.\n\nЕсли правило включено,\nфункция \"Get Image Descriptions from Google\"\nбудет активирована, но только для тех людей,\nкоторые пользуются программами чтения с экрана или аналогичными технологиями специальных возможностей.\n\nЕсли правило отключено, пользователи не смогут включить эту\nфункцию.\n\nЕсли правило не настроено, пользователь сам сможет выбрать, пользоваться функцией или нет.\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "Разрешить DNS-запросы для дополнительных типов записей DNS";
AdditionalDnsQueryTypesEnabled.pfm_description = "Это правило определяет, может ли Brave запрашивать дополнительные типы записей DNS при выполнении небезопасных DNS-запросов. Оно не применяется к DNS-запросам через безопасный DNS-сервер, который всегда может запрашивать дополнительные типы записей DNS.\n\nЕсли это правило не настроено или включено, помимо A (DNS type 1) и AAAA (DNS type 28), можно запрашивать дополнительные типы записей, например HTTPS (DNS type 65).\n\nЕсли это правило отключено, можно запрашивать только записи A (DNS type 1) и AAAA (DNS type 28).\n\nЭто временное правило, которое будет удалено в одной из следующих версий Brave. После удаления правила Brave всегда сможет запрашивать дополнительные типы записей DNS.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Настройки для сайтов с навязчивой рекламой";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Разрешить рекламу на всех сайтах\n2 - Заблокировать навязчивую рекламу на сайтах\nЕсли правило AdsSettingForIntrusiveAdsSites не настроено или задано значение \"1\", показ рекламы разрешен на всех сайтах при условии, что для правила SafeBrowsingEnabled не указано значение False.\n\nЕсли выбрано значение \"2\", навязчивая реклама на сайтах будет заблокирована.";
AdvancedProtectionAllowed.pfm_title = "Включить расширенные функции безопасности для пользователей, зарегистрированных в программе Дополнительной защиты";
AdvancedProtectionAllowed.pfm_description = "Это правило определяет, получают ли пользователи, зарегистрированные в программе Дополнительной защиты, доступ к расширенным функциям безопасности. Некоторые из этих функций предполагают отправку сведений в Google. Например, пользователи, зарегистрированные в программе Дополнительной защиты, могут отправлять скачиваемые файлы в Google для проверки на наличие вредоносного ПО. Если правило не настроено или задано значение True, пользователи, зарегистрированные в программе Дополнительной защиты, будут получать доступ к расширенным функциям безопасности. Если указано значение False, пользователи, зарегистрированные в программе Дополнительной защиты, будут получать доступ только к стандартным функциям.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Список источников, которым разрешено использовать все схемы HTTP-аутентификации";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "Это правило позволяет указать, каким источникам разрешено использовать все схемы HTTP-аутентификации, которые поддерживает Brave, независимо от настроек правила AuthSchemes.\n\nНачиная с версии Brave 161 это правило применяется только к источникам целевого сервера и не применяется к запросам аутентификации прокси-сервера. Чтобы разрешить прокси-серверам использовать все схемы HTTP-аутентификации, настройте правило AllHttpAuthSchemesAllowedForProxies. До версии 161 прокси-серверам, соответствующим этому правилу, также доступны все схемы HTTP-аутентификации, если не настроено правило AllHttpAuthSchemesAllowedForProxies.\n\nДля шаблонов источников нужно использовать следующий формат: https://support.google.com/chrome/a?p=url_blocklist_filter_format. В правиле AllHttpAuthSchemesAllowedForOrigins можно задать не более 1000 исключений.\nДля подстроки хоста можно использовать подстановочные знаки (например, \"*:8000\" соответствует всем хостам с портом 8000). Чтобы правило действовало для всех схем или всех портов, полностью удалите эту подстроку (например, \"example.com\" соответствует любой схеме и любому порту). Имя хоста (например, example.com) также соответствует его субдоменам. Чтобы правило действовало только для хоста, но не его субдоменов, добавьте в начале точку (например, \".example.com\"). Чтобы правило действовало для всех источников, используйте одну звездочку (*).";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Список прокси-серверов, которым разрешено использовать все схемы HTTP-аутентификации";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "Это правило позволяет указать, каким прокси-серверам разрешено использовать все схемы HTTP-аутентификации, которые поддерживает Brave, независимо от настроек правила AuthSchemes.\n\nДля шаблонов прокси-серверов нужно использовать следующий формат фильтров черного списка URL: https://support.google.com/chrome/a?p=url_blocklist_filter_format. Можно задать не более 1000 исключений.\nДля подстроки хоста можно использовать подстановочные знаки (например, \"*:8080\" соответствует всем прокси-серверам с портом 8080). Имя хоста (например, proxy.example.com) также соответствует его субдоменам. Чтобы правило действовало только для хоста, но не его поддоменов, добавьте в начале точку (например, \".proxy.example.com\").\n\nЕсли правило не настроено, прокси-серверам будут доступны только схемы HTTP-аутентификации, указанные в правиле AuthSchemes. Если они не заданы, будут использоваться схемы по умолчанию.";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Разрешить добавлять страницы с заголовком Cache-Control: no-store в возвратный кеш";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Это правило определяет, можно ли страницы с заголовком Cache-Control: no-store сохранять в возвратном кеше. Сайт, который установил этот заголовок, может предполагать, что страницу нельзя восстановить из возвратного кеша, так как после этого может показываться некоторая конфиденциальная информация, даже если она больше не доступна.\n\nЕсли правило включено или не настроено, страница с заголовком Cache-Control: no-store может быть восстановлена из возвратного кеша, только если не запущено вытеснение данных из кеша (например, когда на сайте изменен файл cookie только для HTTP).\n\nЕсли правило отключено, страница с заголовком Cache-Control: no-store не будет сохраняться в возвратном кеше.";
AllowCrossOriginAuthPrompt.pfm_title = "Междоменные запросы аутентификации HTTP";
AllowCrossOriginAuthPrompt.pfm_description = "Если правило включено, в сторонних изображениях на страницах может показываться окно аутентификации.\n\nЕсли правило отключено или не настроено, показывать окно аутентификации в сторонних изображениях запрещено.\n\nОбычно это правило отключают в целях защиты от фишинга.";
AllowDeletingBrowserHistory.pfm_title = "Удаление истории просмотров и загрузок браузера";
AllowDeletingBrowserHistory.pfm_description = "Если правило включено или не настроено, то в Chrome можно удалить историю браузера и список скачанных файлов. Пользователи не могут изменить этот параметр.\n\nЕсли правило отключено, историю браузера и список скачанных файлов удалить нельзя. Даже если это правило отключено, история браузера и список скачанных файлов могут не сохраниться. Пользователи могут самостоятельно изменить или удалить файлы истории, браузер может устареть, а элементы истории могут быть перемещены в архив в любое время.";
AllowDinosaurEasterEgg.pfm_title = "Разрешает игру с динозавром";
AllowDinosaurEasterEgg.pfm_description = "Если для правила задано значение True, пользователи могут запускать игру с динозавром. Если указано значение False, при отсутствии подключения к интернету игра с динозавром недоступна.\n\nЕсли правило не настроено, игра недоступна на зарегистрированных устройствах Google Chrome OS, однако при других обстоятельствах пользователи могут играть в нее.";
AllowFileSelectionDialogs.pfm_title = "Разрешить вызов окна выбора файлов";
AllowFileSelectionDialogs.pfm_description = "Если это правило включено или не настроено, то пользователи смогут открывать в Chrome окна выбора файлов.\n\nЕсли правило отключено и пользователь выполняет действия, для которых нужно открыть окно выбора файлов (например, импортирует закладки, загружает файлы, сохраняет ссылки и т. д.), вместо окна отображается сообщение и предполагается, что пользователь нажал кнопку \"Отмена\" в окне выбора файлов.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Разрешить случайный выбор размера пула сокетов для прокси-серверов";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "Случайный выбор размера пула сокетов – это механизм безопасности, который не позволяет злоумышленникам использовать детерминированные ограничения пропускной способности для получения информации о других сайтах.\nЕсли обычно в пуле 128 сокетов, этот механизм случайным образом ограничивает количество сокетов в пуле от 128 до 256.\nВ результате количество подключений к прокси-серверу может увеличиться в два раза, но на практике оно увеличивается примерно в 1,2 раза.\n\nЭто влияет на настройки, заданные в правилах MaxConnectionsPerProxy и MaxConnectionsPerProxyForWebSocket.\nВместо установки верхнего предела значения умножаются на два (хотя фактически обычно на 1,2).\n\nПо умолчанию эта функция включена для всех пулов, но это правило позволяет отключить ее специально для пулов прокси.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Разрешать запросы веб-аутентификации на сайтах с ненадежными TLS-сертификатами";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Если правило включено, Brave будет разрешать запросы веб-аутентификации на сайтах, в TLS-сертификатах которых есть ошибки (такие сайты считаются небезопасными).\n\nЕсли правило отключено или не настроено, такие запросы по умолчанию блокируются.";
AllowedDomainsForApps.pfm_title = "Определить разрешенные домены для доступа к сервису Google Workspace";
AllowedDomainsForApps.pfm_description = "Если правило настроено, будет включена функция Chrome, ограничивающая вход в сервис Google Workspace, и пользователи не смогут изменять эту настройку. Пользователи смогут получить доступ к приложениям Google только с помощью аккаунтов в определенных доменах (чтобы разрешить использование аккаунтов Gmail или Googlemail, добавьте consumer_accounts в список доменов). Если аккаунт не связан с доменом из списка разрешенных, эта настройка будет запрещать пользователю входить в аккаунт, а также добавлять дополнительный аккаунт на управляемом устройстве с обязательной аутентификацией Google.\n\nЕсли правило не настроено, пользователь может получить доступ к сервису Google Workspace с помощью любого аккаунта.\n\nПользователи не могут изменить или переопределить эту настройку.\n\nПримечание. Это правило добавляет заголовок X-GoogApps-Allowed-Domains к запросам HTTP и HTTPS во всех доменах google.com. Подробную информацию можно найти здесь: https://support.google.com/a/answer/1668854.";
AlternateErrorPagesEnabled.pfm_title = "Включить дополнительные страницы с сообщениями об ошибках";
AlternateErrorPagesEnabled.pfm_description = "Если для правила задано значение True, используются встроенные в Brave дополнительные страницы с сообщениями об ошибках (такие как \"Страница не найдена\"). Если указано значение False, в Brave такие страницы никогда не используются.\n\nЕсли правило настроено, пользователи не могут изменить его. Если правило не настроено, оно действует, но пользователи могут его изменить.";
AlternativeBrowserParameters.pfm_title = "Параметры командной строки для альтернативного браузера";
AlternativeBrowserParameters.pfm_description = "Если в правиле задан список строк, каждая из них передается в альтернативный браузер как отдельный параметр командной строки. В Microsoft® Windows® параметры объединяются через пробелы. В macOS и Linux® параметр может сам содержать пробелы и при этом обрабатываться как единое целое.\n\nЕсли тот или иной параметр содержит переменную ${url}, то вместо ${url} подставляется URL открываемой страницы. Если ни в одном параметре нет переменной ${url}, нужный URL добавляется в конце командной строки.\n\nПри использовании переменных среды подставляются их значения. В Microsoft® Windows® выражение %ABC% заменяется значением переменной среды ABC. В macOS и Linux® выражение ${ABC} заменяется значением переменной среды ABC.\n\nЕсли правило не настроено, то в качестве параметра командной строки передается только URL.";
AlternativeBrowserPath.pfm_title = "Запуск альтернативного браузера для сайтов из списка";
AlternativeBrowserPath.pfm_description = "Это правило определяет, какая команда должна использоваться для открытия страниц в альтернативном браузере. Можно указать одно из следующих значений: ${ie}, ${firefox}, ${safari}, ${opera}, ${edge} или путь к файлу. Если задать в качестве значения путь к файлу, указанный файл будет обрабатываться как исполняемый. Значение ${ie} доступно только для Microsoft® Windows®, а значения ${safari} и ${edge} – для Microsoft® Windows® и macOS.\n\nЕсли правило не настроено, выбирается используемый по умолчанию вариант в зависимости от платформы: Internet Explorer® для Microsoft® Windows® или Safari® для macOS. В Linux® запустить альтернативный браузер не удастся.";
AlwaysOpenPdfExternally.pfm_title = "Всегда открывать PDF-файлы во внешнем приложении";
AlwaysOpenPdfExternally.pfm_description = "Если правило включено, встроенное средство просмотра PDF-файлов в Brave отключается, они начинают обрабатываться как скачанный контент, а пользователю разрешается открывать их в приложении по умолчанию для данного типа файлов.\n\nЕсли правило отключено, для просмотра PDF-файлов используется плагин PDF (если он не отключен пользователем).\n\nЕсли правило настроено, пользователь не может изменить его в Brave. Если правило не настроено, пользователь может самостоятельно выбирать, как открывать PDF-файлы.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Включить пассивную аутентификацию для определенных типов профилей";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Включить пассивную аутентификацию только для обычных сеансов\n1 - Включить пассивную аутентификацию для режима инкогнито и обычных сеансов\n2 - Включить пассивную аутентификацию для гостевых и обычных сеансов\n3 - Включить пассивную аутентификацию для обычных и гостевых сеансов, а также режима инкогнито\nПозволяет разрешить или запретить пассивную аутентификацию для сеансов в режиме инкогнито и гостевых профилей в Brave.\n\nПассивная аутентификация – это HTTP-аутентификация, для которой применяются учетные данные по умолчанию, если другие данные не были явно предоставлены при использовании схемы NTLM, Kerberos или Negotiate (запрос – ответ).\n\nЕсли установить параметр RegularOnly (значение \"0\"), пассивная аутентификация будет разрешена только в обычных сеансах. В режиме инкогнито и гостевых сеансах она будет запрещена.\n\nЕсли установить параметр IncognitoAndRegular (значение \"1\"), пассивная аутентификация будет разрешена в режиме инкогнито и обычных сеансах. В гостевых сеансах она будет запрещена.\n\nЕсли установить параметр GuestAndRegular (значение \"2\"), пассивная аутентификация будет разрешена в обычных и гостевых сеансах. В режиме инкогнито она будет запрещена.\n\nЕсли установить параметр All (значение \"3\"), пассивная аутентификация будет разрешена во всех сеансах.\n\nОбратите внимание, что в обычных профилях она всегда разрешена.\n\nВ Brave 81 и более поздних версиях: если это правило не настроено, пассивная аутентификация будет включена только в обычных сеансах.";
AudioCaptureAllowed.pfm_title = "Включение или отключение функции захвата аудио";
AudioCaptureAllowed.pfm_description = "Если правило включено или не задано, то все сайты, кроме перечисленных в списке VideoCaptureAllowedUrls, должны отправлять пользователю запрос, чтобы получить разрешение на запись.\n\nЕсли правило отключено, запросы не отправляются, а запись аудио разрешается только сайтам, указанным в списке AudioCaptureAllowedUrls.\n\nПримечание. Это правило действует для всех аудиовходов, а не только встроенного микрофона.";
AudioCaptureAllowedUrls.pfm_title = "URL, которым доступ к аудиозаписывающим устройствам предоставляется без запроса";
AudioCaptureAllowedUrls.pfm_description = "Правило позволяет указать список шаблонов URL, которые сопоставляются с названием безопасного источника, отправляющего запрос. В случае совпадения доступ к звукозаписывающим устройствам предоставляется без запроса разрешения.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns/. Обратите внимание, что в правиле не поддерживается шаблон \"*\", соответствующий любому URL.";
AudioSandboxEnabled.pfm_title = "Разрешить использование тестовой среды для аудио";
AudioSandboxEnabled.pfm_description = "Это правило управляет обработкой аудио в тестовой среде.\nЕсли правило включено, обработка звука будет выполняться в тестовой среде.\nЕсли правило отключено, тестовая среда не будет использоваться для обработки аудио, а на стадии рендеринга будет запущен модуль обработки звука WebRTC.\nВ этом случае пользователи могут подвергнуться рискам безопасности, связанным с запуском подсистемы аудио вне тестовой среды.\nЕсли правило не настроено, для запуска аудио в тестовой среде будет использоваться конфигурация по умолчанию. Она может отличаться в зависимости от платформы.\nЭто правило дает компаниям возможность отключать тестовую среду для звука, если ее не позволяют использовать настройки ПО для обеспечения безопасности.";
AuthNegotiateDelegateAllowlist.pfm_title = "Список разрешенных серверов для делегирования прав по протоколу Kerberos";
AuthNegotiateDelegateAllowlist.pfm_description = "Правило позволяет указать список серверов, которым Brave может предоставлять учетные данные пользователей. Названия серверов нужно разделять запятыми. Допустимы подстановочные знаки (*).\n\nЕсли правило не настроено, Brave не будет передавать учетные данные пользователей серверам, в том числе находящимся в интранете.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Использовать политику KDC для делегирования учетных данных.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Если правило включено, то при HTTP-аутентификации учитывается подтверждение от KDC. То есть Brave передает учетные данные в сервис, если KDC добавляет сигнал OK-AS-DELEGATE в мандат сервиса. Подробные сведения вы найдете на странице https://tools.ietf.org/html/rfc5896.html. Сервис также должен быть разрешен в правиле AuthNegotiateDelegateAllowlist.\n\nЕсли правило отключено или не настроено, политика KDC игнорируется на поддерживаемых платформах и применяется только правило AuthNegotiateDelegateAllowlist.\n\nВ Microsoft® Windows® политика KDC учитывается всегда.";
AuthSchemes.pfm_title = "Поддерживаемые протоколы аутентификации";
AuthSchemes.pfm_description = "Правило позволяет указать, какие схемы HTTP-аутентификации поддерживает Brave.\n\nЕсли правило не настроено, используются все 4 схемы.\n\nВозможные значения:\n\n* basic;\n\n* digest;\n\n* ntlm;\n\n* negotiate.\n\nПримечание. Несколько значений разделяются запятыми.";
AuthServerAllowlist.pfm_title = "Список разрешенных серверов для аутентификации";
AuthServerAllowlist.pfm_description = "Это правило указывает, какие серверы можно использовать для встроенной проверки подлинности Windows (IWA). Встроенная проверка подлинности включается, только когда Brave получает запрос на аутентификацию от прокси-сервера или от сервера из списка разрешенных.\n\nЕсли правило не настроено, Brave отвечает на запросы IWA только после того, как определяет, находится ли сервер в интранете. Если сервер находится в Интернете, Brave игнорирует поступающие от него запросы IWA.\n\nПримечание. Названия серверов нужно разделять запятыми. Допустимы подстановочные знаки (*).";
AutoLaunchProtocolsFromOrigins.pfm_title = "Определение списка протоколов, которые могут запускать внешнее приложение из перечисленных источников без отправки запроса пользователю";
AutoLaunchProtocolsFromOrigins.pfm_description = "Это правило позволяет настроить список протоколов и список допустимых шаблонов источников для каждого протокола, которые могут запускать внешнее приложение без отправки запроса пользователю. Протокол нужно указывать без разделителя – например, \"skype\", а не \"skype:\" или \"skype://\".\n\nЕсли правило настроено, протокол сможет запускать внешнее приложение без отправки запроса пользователю, только если этот протокол указан в списке, а источник сайта, который пытается выполнить такой протокол, соответствует одному из шаблонов в списке allowed_origins, связанном с этим протоколом. Если хотя бы одно из условий не выполняется, правило не сможет предотвратить отправку пользователю запроса о подтверждении запуска внешнего протокола.\n\nЕсли правило не настроено, то запуск любых протоколов без отправки запроса будет невозможен по умолчанию. Пользователи могут отключать запросы для отдельных протоколов или сайтов, если для правила ExternalProtocolDialogShowAlwaysOpenCheckbox не задано значение \"Отключено\". На исключения запросов, заданные пользователями для отдельных протоколов или сайтов, это правило не влияет.\n\nШаблоны источников имеют практически тот же формат, что и шаблоны в правиле URLBlocklist. Подробная информация о формате приведена на странице https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nПри этом в шаблонах источников не могут содержаться элементы /path и @query. Шаблон с такими элементами учитываться не будет.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins.";
AutoOpenAllowedForURLs.pfm_title = "URL, для которых можно применять правило AutoOpenFileTypes";
AutoOpenAllowedForURLs.pfm_description = "Список URL, для которых будет действовать правило AutoOpenFileTypes. Это правило не действует в отношении параметров автоматического открытия, заданных пользователями.\n\nЕсли правило настроено, файлы будут открываться автоматически только при условии, что URL включен в этот список и данный тип файла указан в правиле AutoOpenFileTypes. Если хотя бы одно из условий не выполняется, скачанный файл не будет открыт автоматически.\n\nЕсли правило не настроено, все скачанные файлы, тип которых указан в правиле AutoOpenFileTypes, будут открываться автоматически.\n\nФормат шаблона URL должен соответствовать этим требованиям: https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
AutoOpenFileTypes.pfm_title = "Список типов файлов, которые будут автоматически открываться после скачивания";
AutoOpenFileTypes.pfm_description = "Список типов файлов, которые должны автоматически открываться после скачивания. Тип файла нужно указывать без разделителя, например \"txt\", а не \".txt\".\n\nЕсли включен Безопасный просмотр, файлы по-прежнему будут сначала проверяться с помощью этой функции. Файлы, не прошедшие проверку, не будут открываться автоматически.\n\nЕсли правило не настроено, после скачивания автоматически открываются файлы только тех типов, которые уже указал пользователь.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе Chrome Enterprise Core.\n\nВ macOS это правило можно настроить только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе Chrome Enterprise Core.";
AutoSelectCertificateForUrls.pfm_title = "Автоматический выбор клиентских сертификатов для сайтов";
AutoSelectCertificateForUrls.pfm_description = "Это правило позволяет создать список шаблонов URL с целью указать сайты, для которых Chrome сможет автоматически выбирать сертификат клиента. Значение представляет собой массив словарей JSON, преобразованных в строки. Каждый словарь должен иметь форму { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER }, где $URL_PATTERN – это шаблон настроек контента. $FILTER определяет набор сертификатов клиента, из которых браузер будет автоматически выбирать нужный. Независимо от настроек фильтра выбираются только сертификаты, соответствующие запросу сервера. На устройствах Android и iOS браузер Chrome может выбирать только сертификаты, которые он инициализировал. Установленные на уровне ОС сертификаты недоступны для Chrome.\n\nПримеры использования фрагмента $FILTER:\n\n* Если $FILTER имеет форму { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } }, выбираются только сертификаты клиента, выданные сертификатом с общим названием CommonName $ISSUER_CN.\n\n* Если $FILTER содержит одновременно фрагменты \"ISSUER\" и \"SUBJECT\", выбираются только сертификаты клиента, отвечающие обоим условиям.\n\n* Если $FILTER содержит фрагмент \"SUBJECT\" со значением \"O\", может быть выбран только сертификат, в котором хотя бы одно название организации соответствует указанному значению.\n\n* Если $FILTER содержит фрагмент \"SUBJECT\" со значением \"OU\", может быть выбран только сертификат, в котором хотя бы одно название подразделения организации соответствует указанному значению.\n\n* Если $FILTER содержит пустые скобки {}, выбор сертификатов ничем дополнительно не ограничивается. При этом фильтры веб-сервера все равно применяются.\n\nЕсли правило не настроено, сертификаты не будут выбираться автоматически ни для одного сайта.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls.";
AutofillGenAiSettings.pfm_title = "Настройки функций на основе генеративного ИИ для автозаполнения";
AutofillGenAiSettings.pfm_description = "0 - Разрешить использовать функции автозаполнения на основе генеративного ИИ и улучшать ИИ-модели\n1 - Разрешить использовать функции автозаполнения на основе генеративного ИИ без улучшения ИИ-моделей\n2 - Запретить использовать функции автозаполнения на основе генеративного ИИ\nЭти функции в Brave задействуют модели генеративного ИИ, чтобы помогать заполнять формы в интернете. Чтобы использовать такие функции, Brave собирает определенные данные, например сведения о структуре форм, с которыми взаимодействует пользователь. Для функции \"Поиск и заполнение с Gemini\" также собираются текстовые запросы в подключенных приложениях Gemini. Эти данные отправляются на сервер Google, на котором работает модель генеративного ИИ.\n\nЕсли для правила задано значение \"0\" (Разрешить использовать функции автозаполнения на основе генеративного ИИ и улучшать ИИ-модели), функциями можно пользоваться и Google разрешается совершенствовать свои ИИ-модели с помощью определенных данных. Это могут быть запросы, входные и выходные данные, а также исходные материалы и отзывы, в зависимости от функции. Значение \"0\" используется по умолчанию, за исключением описанных ниже случаев.\n\nЕсли установлено значение \"1\" (Разрешить использовать функции автозаполнения на основе генеративного ИИ без улучшения ИИ-моделей), функциями можно пользоваться, но Google запрещается совершенствовать модели с помощью контента пользователей, в том числе запросов, входных и выходных данных, исходных материалов и отзывов. Это значение используется по умолчанию для корпоративных аккаунтов, управляемых через Google Admin console, и для учебных аккаунтов, управляемых через Google Workspace.\n\nЕсли для правила выбрано значение \"2\" (Запретить использовать функции автозаполнения на основе генеративного ИИ), функциями нельзя пользоваться.\n\nЕсли правило не настроено, действует правило GenAiDefaultSettings.\n\nФункции автозаполнения на основе генеративного ИИ:\n\n- Улучшенное распознавание форм. Модель определяет и классифицирует поля в форме, чтобы заполнить как можно больше из них.\n\n- Поиск и заполнение с Gemini. ИИ находит информацию в приложениях, подключенных к Gemini, и предлагает ее для заполнения в виде умных подсказок в форме или в ответ на запрос пользователя.\n\nЭто правило имеет приоритет над правилом AutofillPredictionSettings, которое продолжает действовать, если это правило не настроено. Для работы функции \"Поиск и заполнение с Gemini\" также необходимо включить правило GeminiSettings.\n\nЭто правило не влияет на функции автозаполнения, которые не используют генеративный ИИ.\n\nПодробнее о том, как обрабатываются данные при использовании функций на основе генеративного ИИ: https://support.google.com/chrome/a?p=generative_ai_settings.";
AutofillSettings.pfm_title = "Блокировать типы данных автозаполнения для определенных сайтов";
AutofillSettings.pfm_description = "Правило позволяет указать, какие типы данных автозаполнения блокируются для определенных шаблонов URL.\n\nОно представляет собой список словарей. Каждый из них должен содержать:\n* url_pattern — шаблон URL настроек контента для основного фрейма (например, https://[*.]example.com).\n* blocked_types — список строк с категориями данных автозаполнения, которые нужно блокировать.\n\nПараметр blocked_types поддерживает следующие значения:\n* contact_info — блокирует заполнение и сохранение контактной информации.\n* payments — блокирует заполнение и сохранение данных банковских карт и способов оплаты.\n* identity_docs — блокирует заполнение и сохранение данных документов, удостоверяющих личность, например паспорта или водительского удостоверения.\n* travel — блокирует заполнение и сохранение информации о путешествиях, например о бронировании авиабилетов или регистрации транспортных средств.\n* shopping — блокирует заполнение и сохранение информации о покупках, например об онлайн-заказах или доставках.\n* all — блокирует заполнение и сохранение всех типов данных автозаполнения.\n\nКогда тип данных заблокирован для сайта, будут отключены как генерация подсказок, так и запросы на сохранение или импорт новых данных этого типа.\n\nЕсли URL соответствует нескольким шаблонам в списке, заблокированные типы из всех подходящих шаблонов объединяются. Недействительные шаблоны URL в списке игнорируются.\n\nЕсли правило не настроено, никакие типы данных автозаполнения не блокируются на уровне доменов.\n\nПодробнее о допустимых шаблонах URL:\nhttps://chromeenterprise.google/policies/url-patterns. Поддерживается подстановочный знак (*). Шаблон с ним подходит всем URL с любой схемой, портом и путем.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=AutofillSettings.";
AutomatedPasswordChangeSettings.pfm_title = "Включить автоматическую смену пароля";
AutomatedPasswordChangeSettings.pfm_description = "0 - Разрешить использовать функцию и улучшать ИИ-модели\n1 - Разрешить использовать функцию без улучшения ИИ-моделей\n2 - Запретить использование функции\nЭто правило определяет, доступна ли функция \"Автоматическая смена пароля\" в Brave.\n\nЕсли она включена, пользователь сможет запустить процесс, в рамках которого браузер попытается автоматически сменить пароль на сайте. Это происходит с помощью генеративного ИИ. Новый пароль сохраняется в менеджере паролей в браузере.\n\nЕсли установлено значение \"0\", функцией можно пользоваться и Google разрешается улучшать свои ИИ-модели с помощью определенных данных. Это могут быть запросы, входные и выходные данные, а также отзывы и исходные материалы в зависимости от функции. Специалисты могут проверять эти данные, чтобы улучшать ИИ-модели. Значение \"0\" используется по умолчанию, за исключением описанных ниже случаев.\n\nЕсли установлено значение \"1\", функцией можно пользоваться, но Google запрещается улучшать ИИ-модели с помощью контента пользователей, в том числе запросов, входных и выходных данных, отзывов и исходных материалов. Это значение по умолчанию для корпоративных пользователей, управляемых через консоль администратора Google, и учебных аккаунтов, управляемых с помощью Google Workspace.\n\nЕсли установлено значение \"2\", функция недоступна.\n\nЕсли правило не настроено, действует правило GenAiDefaultSettings.\n\nЧтобы узнать больше о том, как обрабатываются данные при использовании функций на основе генеративного ИИ, прочитайте статью https://support.google.com/chrome/a?p=generative_ai_settings.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Разрешить автоматическое скачивание на этих сайтах";
AutomaticDownloadsAllowedForUrls.pfm_description = "Это правило позволяет задать список шаблонов URL для указания сайтов, которым разрешено автоматически скачивать несколько файлов.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns.\n\nЕсли URL соответствует шаблонам в обоих правилах (AutomaticDownloadsAllowedForUrls и AutomaticDownloadsBlockedForUrls), приоритет отдается правилу AutomaticDownloadsBlockedForUrls.\n\nЕсли правило не настроено, все сайты следуют правилу DefaultAutomaticDownloadsSetting при условии, что оно задано. В противном случае действуют персональные настройки пользователя.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Запретить автоматическое скачивание на этих сайтах";
AutomaticDownloadsBlockedForUrls.pfm_description = "Это правило позволяет задать список шаблонов URL для указания сайтов, которым запрещено автоматически скачивать несколько файлов.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns.\n\nЕсли URL соответствует шаблонам в обоих правилах (AutomaticDownloadsAllowedForUrls и AutomaticDownloadsBlockedForUrls), приоритет отдается правилу AutomaticDownloadsBlockedForUrls.\n\nЕсли правило не настроено, все сайты следуют правилу DefaultAutomaticDownloadsSetting при условии, что оно задано. В противном случае действуют персональные настройки пользователя.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Разрешить автоматическое открытие в полноэкранном режиме на этих сайтах";
AutomaticFullscreenAllowedForUrls.pfm_description = "Чтобы вызвать метод requestFullscreen() веб-API, пользователю нужно сначала выполнить жест (\"временная активация\"). Это требуется в целях безопасности. В личных настройках пользователи могут разрешать отдельным источникам вызывать API без предварительного жеста, как описано на странице https://chromestatus.com/feature/6218822004768768.\n\nЭто правило имеет приоритет над такими настройками и позволяет источникам, совпадающим с шаблоном, вызывать API без предварительного жеста.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns.\nРазрешено использовать подстановочные знаки (*).\n\nИсточники, совпадающие одновременно с запрещенными и разрешенными шаблонами, будут блокироваться.\nИсточники, которые не указаны в правиле или настройках пользователя, смогут вызывать API только после выполнения жеста.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Запретить автоматическое открытие в полноэкранном режиме на этих сайтах";
AutomaticFullscreenBlockedForUrls.pfm_description = "Чтобы вызвать метод requestFullscreen() веб-API, пользователю нужно сначала выполнить жест (\"временная активация\"). Это требуется в целях безопасности. В личных настройках пользователи могут разрешать отдельным источникам вызывать API без предварительного жеста, как описано на странице https://chromestatus.com/feature/6218822004768768.\n\nЭто правило имеет приоритет над такими настройками и запрещает источникам, совпадающим с шаблоном, вызывать API без предварительного жеста.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns.\nРазрешается использовать подстановочные знаки: *.\n\nИсточники, совпадающие одновременно с запрещенными и разрешенными шаблонами, будут блокироваться.\nИсточники, не указанные в правиле или настройках пользователя, смогут вызывать API только после выполнения жеста.";
AutoplayAllowed.pfm_title = "Разрешить автоматическое воспроизведение видео";
AutoplayAllowed.pfm_description = "Если правило включено, медиафайлы воспроизводятся в Brave автоматически. Если оно отключено, такие файлы не воспроизводятся в Brave автоматически.\n\nЕсли правило не настроено, автовоспроизведение медиаконтента в Brave не работает. Для некоторых шаблонов URL это правило можно переопределить с помощью правила AutoplayAllowlist.\n\nЕсли текущее правило было изменено во время работы Brave, оно будет действовать только для новых вкладок.";
AutoplayAllowlist.pfm_title = "Разрешить автоматически воспроизводить видео на страницах из белого списка шаблонов URL";
AutoplayAllowlist.pfm_description = "Настроив правило, вы разрешите автоматически воспроизводить видео со звуком в Brave (без согласия пользователя). Это правило не будет работать, если для AutoplayAllowed задано значение True. Если в AutoplayAllowed указано False, автовоспроизведение видео будет разрешено для всех шаблонов URL, указанных в текущем правиле. Если изменить правило AutoplayAllowlist во время работы Brave, оно будет распространяться только на новые вкладки.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns/.";
BackgroundTabFreezingEnabled.pfm_title = "Включить заморозку фоновых вкладок";
BackgroundTabFreezingEnabled.pfm_description = "Определяет, будет ли Brave останавливать работу неактивных фоновых вкладок, чтобы экономить ресурсы ЦП и памяти.\n\nЕсли заморозка вкладок в фоновом режиме включена, то работа вкладок, которые не использовались в течение определенного времени, останавливается. При этом приостанавливается выполнение задач по таймеру и кода JavaScript. Остановленные вкладки остаются загруженными в память и мгновенно возобновляют работу, когда пользователь их выбирает. Вкладки с активными фоновыми задачами, например на которых воспроизводится аудио или видео, идет запись экрана или трансляция с камеры, а также такие, где поддерживаются активные подключения WebRTC или удерживаются веб-блокировки, продолжают работу. Сайты, указанные в правиле TabDiscardingExceptions или исключениях пользователя, также не останавливаются.\n\nЕсли правило включено, фоновые вкладки, которые соответствуют требованиям, останавливаются автоматически. Пользователи не могут изменить этот параметр.\n\nЕсли правило отключено, фоновые вкладки не останавливаются. Пользователи не могут изменить этот параметр.\n\nЕсли правило не задано, заморозка фоновых вкладок включена по умолчанию, но пользователи могут регулировать этот параметр в настройках Brave.";
BasicAuthOverHttpEnabled.pfm_title = "Разрешить аутентификацию типа \"Basic\" при подключении по HTTP";
BasicAuthOverHttpEnabled.pfm_description = "Если это правило включено или не настроено, запросы на аутентификацию типа \"Basic\" разрешено получать по небезопасному протоколу HTTP.\n\nЕсли правило отключено, запросы на аутентификацию типа \"Basic\" можно получать только по безопасному протоколу HTTPS.\n\nЭто правило не действует (и аутентификация типа \"Basic\" всегда запрещена), если в настроенном правиле AuthSchemes не указана схема \"Basic\".";
BatterySaverModeAvailability.pfm_title = "Включить режим энергосбережения";
BatterySaverModeAvailability.pfm_description = "0 - Режим энергосбережения отключен\n1 - Включать режим энергосбережения, когда устройство работает от батареи с низким уровнем заряда\n2 - В версии M121 поддержка этого значения прекращена. Если оно задано, то в версии M121 и последующих правило будет действовать так же, как при значении EnabledBelowThreshold.\nПравило позволяет включать или отключать параметр \"Режим энергосбережения\".\nВ Chrome он ограничивает частоту кадров для снижения расхода энергии. Если правило не настроено, конечный пользователь может управлять этим параметром на странице chrome://settings/performance.\nВ ChromeOS он ограничивает частоту кадров и тактовую частоту процессора, а также затемняет подсветку. В Android включается режим энергосбережения. Если на устройстве несколько ЦП, некоторые из них отключаются.\nДля этого правила предусмотрены следующие значения:\nDisabled (0). Режим энергосбережения выключен.\nEnabledBelowThreshold (1). Режим энергосбережения включается, когда устройство работает от батареи с низким зарядом.\nEnabledOnBattery (2). В версии M121 поддержка этого значения прекращена. Если оно задано, то в версии M121 и последующих правило будет действовать так же, как при значении EnabledBelowThreshold.\n";
BlockExternalExtensions.pfm_title = "Заблокировать установку внешних расширений";
BlockExternalExtensions.pfm_description = "Это правило контролирует установку внешних расширений.\n\nЕсли оно включено, устанавливать такие расширения запрещено.\n\nЕсли правило отключено или не настроено, установка внешних расширений разрешена.\n\nПодробная информация о внешних расширениях и их установке приведена на странице https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions.\n\nЭто правило применяется только на платформах, которые поддерживают расширения.";
BlockThirdPartyCookies.pfm_title = "Блокировать сторонние файлы cookie";
BlockThirdPartyCookies.pfm_description = "Если правило включено, элементам веб-страниц из других доменов, кроме указанного в адресной строке, запрещается сохранять файлы cookie. Отключив правило, вы разрешите таким элементам сохранять файлы cookie и запретите пользователям менять этот параметр.\n\nЕсли правило не настроено, сторонние файлы cookie сохраняются, но пользователи могут поменять этот параметр.\n\nОбратите внимание, что это правило не действует в режиме инкогнито, в котором сторонние файлы cookie блокируются и разрешить их сохранять можно только для отдельного сайта. Чтобы разрешить сохранять файлы cookie на уровне сайта, воспользуйтесь правилом CookiesAllowedForUrls.";
BookmarkBarEnabled.pfm_title = "Включить панель закладок";
BookmarkBarEnabled.pfm_description = "Если для правила задано значение True, в Brave будет видна панель закладок. Если задано значение False, панель закладок будет всегда скрыта.\n\nЕсли вы настроите это правило, пользователи не смогут его изменить. Если правило не настроено, пользователи смогут самостоятельно решать, использовать эту функцию или нет.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "Разрешить добавлять людей через диспетчер пользователей";
BrowserAddPersonEnabled.pfm_description = "Если правило не настроено или для него выбрано значение True, в браузерах Brave и Lacros разрешается добавлять новых пользователей из Диспетчера пользователей.\n\nЕсли задано значение False, в браузерах Brave и Lacros запрещается это делать.";
BrowserGuestModeEnabled.pfm_title = "Включает гостевой режим в браузере";
BrowserGuestModeEnabled.pfm_description = "Если правило включено или не настроено, в Brave разрешен гостевой доступ. При гостевом доступе все окна для профилей Brave открываются в режиме инкогнито.\n\nЕсли правило отключено, в Brave нельзя использовать гостевые профили.";
BrowserGuestModeEnforced.pfm_title = "Принудительное включение гостевого режима в браузере";
BrowserGuestModeEnforced.pfm_description = "Если это правило включено, Brave принудительно запускает гостевые сеансы и не допускает входа в профиль. При гостевом доступе все окна для профилей Brave открываются в режиме инкогнито.\n\nЕсли правило отключено или не настроено, а также если гостевой режим в браузере запрещен правилом BrowserGuestModeEnabled, пользователи могут входить в существующие профили и создавать новые.";
BrowserLabsEnabled.pfm_title = "Значок экспериментальных функций браузера на панели инструментов";
BrowserLabsEnabled.pfm_description = "Если правило включено или не задано, пользователи могут получить доступ к экспериментальным функциям браузера с помощью значка на панели инструментов.\n\nЕсли правило отключено, значок экспериментальных функций на панели инструментов не показывается.\n\nНезависимо от того, включено или отключено правило, chrome://flags и другие способы включения и отключения функций браузера будут работать как обычно.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Разрешить отправлять запросы в службу времени Google";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Если правило включено или не настроено, Brave периодически отправляет запросы на сервер Google для получения точных временных меток.\n\nЕсли правило отключено, Brave не отправляет эти запросы.";
BrowserSignin.pfm_title = "Настройки входа в браузере";
BrowserSignin.pfm_description = "0 - Отключить вход в браузере\n1 - Включить вход в браузере\n2 - Включить принудительный вход в браузере\nПравило определяет, должен ли выполняться вход в браузере. Оно позволяет указать, может ли пользователь входить в свой аккаунт в Brave и использовать его для доступа к различным функциям (например, синхронизации Brave).\n\nЕсли для правила выбрано значение \"Отключить вход в браузере\", пользователь не сможет выполнить вход в браузере и использовать аккаунт в определенных сервисах. В этом случае некоторые функции браузера, например синхронизация Brave, будут недоступны. Если это значение было выбрано уже после того, как пользователь выполнил вход на iOS, произойдет автоматический выход из аккаунта. На других платформах это произойдет при следующем запуске Brave. При этом данные локального профиля (пароли, закладки и т. д.) останутся на всех платформах. Пользователь по-прежнему сможет входить в веб-сервисы Google, например Gmail.\n\nЕсли для правила выбрано значение \"Включить вход в браузере\", пользователь сможет входить в свой аккаунт в браузере. На всех платформах, кроме iOS, при входе в веб-сервисы Google (например, Gmail) вход в браузере будет выполняться автоматически. Если войти в систему через браузер, в нем будет сохраняться информация об аккаунте. Однако это не значит, что синхронизация Brave будет работать по умолчанию, – ее понадобится настроить отдельно. Если правило активно, пользователь не сможет отключить функцию, разрешающую вход в браузере. Для управления синхронизацией Brave предназначено правило SyncDisabled.\n\nЕсли для правила задано значение \"Включить принудительный вход в браузере\", то для работы с браузером пользователю потребуется выбрать аккаунт и войти в него. Это гарантирует применение всех необходимых правил для управляемых аккаунтов. Значением по умолчанию для правила BrowserGuestModeEnabled станет \"Отключить\". Обратите внимание, что после включения правила все профили, в которые не выполнен вход, будут заблокированы. Подробную информацию можно найти в Справочном центре: https://support.google.com/chrome/?p=force_browser_signin. Операционные системы Google Chrome OS и Android не поддерживают этот вариант. В них будет использоваться значение \"Включить вход в браузере\".\n\nЕсли правило не настроено, пользователь может сам решать, включать ли вход в Brave.";
BrowserSwitcherDelay.pfm_title = "Задержка перед запуском альтернативного браузера (в миллисекундах)";
BrowserSwitcherDelay.pfm_description = "Заданное в этом правиле число соответствует интервалу в миллисекундах, в течение которого Brave показывает специальное сообщение перед запуском альтернативного браузера.\n\nЕсли правило не настроено или для него указано значение \"0\", страница открывается в альтернативном браузере немедленно.";
BrowserSwitcherEnabled.pfm_title = "Включить функцию \"Поддержка альтернативного браузера\".";
BrowserSwitcherEnabled.pfm_description = "Если это правило включено, Brave по возможности будет открывать некоторые страницы в альтернативном браузере, например в Internet Explorer®. Для настройки этой функции используются правила из группы \"Legacy Browser support\".\n\nЕсли правило отключено или не задано, Brave не будет открывать указанные страницы в альтернативном браузере.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "URL XML-файла, содержащего список URL, которые никогда не должны открываться в другом браузере.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Если задан действительный URL, Brave скачивает список относящихся к этому URL сайтов и применяет элементы списка так же, как и при использовании правила BrowserSwitcherUrlGreylist. Эти правила не позволяют Brave открывать альтернативный браузер, и наоборот.\n\nЕсли задан недействительный URL или правило не настроено, Brave не использует его как источник данных о порядке переключения между браузерами.\n\nОбратите внимание, что это правило указывает на XML-файл в том же формате, что и правило SiteList для Internet Explorer®. Элементы списка загружаются из XML-файла без предоставления доступа к ним браузеру Internet Explorer®. Более подробные сведения о правиле SiteList для Internet Explorer® можно найти на странице https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode.";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL XML-файла, содержащего список URL, которые должны загружаться в альтернативном браузере";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Если задан действительный URL, Brave скачивает список относящихся к этому URL сайтов и применяет элементы списка так же, как и при использовании правила BrowserSwitcherUrlList.\n\nЕсли задан недействительный URL или правило не настроено, Brave не использует его как источник данных о порядке переключения между браузерами.\n\nОбратите внимание, что это правило указывает на XML-файл в том же формате, что и правило SiteList для Internet Explorer®. Элементы списка загружаются из XML-файла без предоставления доступа к ним браузеру Internet Explorer®. Более подробные сведения о правиле SiteList для Internet Explorer® можно найти на странице https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode.";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Оставлять открытой последнюю вкладку в Chrome";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Если это правило включено или не настроено, после переключения на альтернативный браузер в Brave остается открытой как минимум одна вкладка.\n\nЕсли правило отключено, после запуска альтернативного браузера текущая вкладка в Brave закрывается. Если она была последней, работа Brave завершается.";
BrowserSwitcherParsingMode.pfm_title = "Режим анализа списков сайтов";
BrowserSwitcherParsingMode.pfm_description = "0 - Поведение по умолчанию для поддержки альтернативного браузера\n1 - Повышенная совместимость со списками сайтов в режиме предприятия Microsoft IE/Edge\nЭто правило определяет, как Google Chrome интерпретирует правила для списков сайтов и серых списков, используемые в функции \"Поддержка альтернативного браузера\". Оно влияет на следующие правила: BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl и BrowserSwitcherExternalGreylistUrl.\n\nЕсли выбрано значение Default (0) или правило не настроено, применяются менее строгие условия сопоставления URL. Для правил, не содержащих символ \"/\", подстрока может находиться в любом месте в имени хоста URL. При сопоставлении компонентов пути URL учитывается регистр.\n\nЕсли выбрано значение IESiteListMode (1), применяются более строгие условия сопоставления URL. Для правил, не содержащих символ \"/\", подстрока может находиться только в конце имени хоста URL. Кроме того, подстрока должна располагаться на границе доменного имени. При сопоставлении компонентов пути URL регистр не учитывается. Это больше напоминает поведение браузеров Microsoft® Internet Explorer® и Microsoft® Edge®.\n\nНапример, если в правиле задана подстрока example.com и acme.com/abc:\n\nадреса http://example.com/, http://subdomain.example.com/ и http://acme.com/abc считаются подходящими независимо от режима анализа.\n\nАдреса http://notexample.com/, http://example.com.invalid.com/ и http://example.comabc/ считаются подходящими только в режиме Default.\n\nАдрес http://acme.com/ABC считается подходящим только в режиме IESiteListMode.";
BrowserSwitcherUrlGreylist.pfm_title = "Сайты, которые никогда не должны открываться в другом браузере";
BrowserSwitcherUrlGreylist.pfm_description = "Это правило определяет список сайтов, которые никогда не должны открываться в другом браузере. Каждый элемент обрабатывается как отдельное правило. Сайты, которые соответствуют указанным элементам, не открываются в альтернативном браузере. В отличие от BrowserSwitcherUrlList заданные здесь элементы-правила применяются в обоих браузерах. Таким образом, если включено дополнение Internet Explorer®, оно определяет, должен ли браузер Internet Explorer® открывать указанные сайты в Brave.\n\nЕсли правило не настроено, список остается пустым.\n\nДля добавления элементов в список можно также использовать правило BrowserSwitcherExternalGreylistUrl.";
BrowserSwitcherUrlList.pfm_title = "Сайты, которые должны открываться в альтернативном браузере";
BrowserSwitcherUrlList.pfm_description = "Это правило определяет список сайтов, которые должны открываться в другом браузере. Каждый элемент обрабатывается как отдельное правило. По указанным элементам Brave определяет, нужно ли открывать тот или иной сайт в альтернативном браузере. Когда включено дополнение Internet Explorer®, сайт открывается в Brave вместо Internet Explorer®, если URL не соответствует элементам списка. В случае противоречия между элементами браузер Brave использует наиболее конкретный из них.\n\nЕсли правило не настроено, список остается пустым.\n\nДля добавления элементов в список можно также использовать правила BrowserSwitcherUseIeSitelist и BrowserSwitcherExternalSitelistUrl.";
BrowserThemeColor.pfm_title = "Настройка цвета для темы браузера";
BrowserThemeColor.pfm_description = "С помощью этого правила администраторы могут задавать цвет темы Brave. Введенная строка должна быть допустимым шестнадцатеричным кодом цвета в формате #RRGGBB.\n\nЕсли в правиле указан допустимый шестнадцатеричный код цвета, на его основе автоматически формируется и применяется тема браузера. Пользователи не могут изменить тему, заданную в этом правиле.\n\nЕсли правило не настроено, пользователи могут изменить тему браузера.";
BrowsingDataLifetime.pfm_title = "Настройка автоматической очистки данных";
BrowsingDataLifetime.pfm_description = "Правило устанавливает настройки автоматической очистки данных о работе в Brave. Оно позволяет администраторам указывать, когда браузер удаляет информацию определенных типов. Это полезно при работе с конфиденциальными данными клиентов.\n\nВнимание! Правило может повлиять на локальные персональные данные или привести к их удалению. Чтобы избежать этого, рекомендуем проверять настройки перед их применением.\n\nВы можете выбрать следующие типы данных: 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' и 'hosted_app_data'. 'download_history' и 'hosted_app_data' не поддерживаются в Android.\n\nБраузер будет автоматически удалять данные выбранных типов, которые хранятся дольше 'time_to_live_in_hours'. Минимальное допустимое значение: 1 час.\n\nДанные с истекшим сроком хранения удаляются через 15 секунд после запуска браузера и каждые следующие 30 минут во время его работы.\n\nПользователь не выйдет из аккаунта Google после удаления файлов cookie.\n\nВ Chrome с версиями ниже 114 это правило работало, только если для SyncDisabled было установлено значение True. В Chrome версии 115 и более новой правило BrowsingDataLifetime останавливает синхронизацию выбранных типов данных, если функция \"Chrome Sync\" не отключена через SyncDisabled и правило BrowserSignin работает.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime.";
BuiltInAIAPIsEnabled.pfm_title = "Разрешить использование API встроенного ИИ на страницах";
BuiltInAIAPIsEnabled.pfm_description = "Это правило определяет, могут ли на странице использоваться API встроенного ИИ, например, LanguageModel API, Summarization API, Writer API или Rewriter API.\n\nЕсли правило включено или не настроено, API можно использовать.\n\nЕсли правило отключено, попытка использования API приведет к ошибке.";
BuiltInDnsClientEnabled.pfm_title = "Встроенный клиент DNS";
BuiltInDnsClientEnabled.pfm_description = "Правило позволяет выбрать, какой программный стек использовать для взаимодействия с DNS-сервером: клиент DNS операционной системы или встроенный в Brave клиент DNS. Это не влияет на выбор DNS-серверов. Например, если операционная система использует корпоративный DNS-сервер, то встроенный клиент DNS будет использовать тот же сервер. Правило также не влияет на режим DNS-over-HTTPS. Brave всегда отправляет запросы по этому протоколу через встроенный преобразователь. Подробные сведения об управлении режимом DNS-over-HTTPS вы найдете в правиле DnsOverHttpsMode.\n\nЕсли правило включено или не настроено, используется встроенный клиент DNS.\n\nЕсли правило отключено, встроенный клиент DNS используется, только если включен режим DNS-over-HTTPS.";
CACertificateManagementAllowed.pfm_title = "Разрешить пользователям управлять установленными сертификатами ЦС";
CACertificateManagementAllowed.pfm_description = "0 - Разрешить пользователям управлять всеми сертификатами\n1 - Разрешить пользователям управлять сертификатами пользователей\n2 - Запретить пользователям управлять сертификатами\nЕсли выбрано значение 0 (All) или правило не настроено, пользователи смогут менять настройки доверия для всех сертификатов ЦС, удалять пользовательские сертификаты и импортировать сертификаты с помощью Менеджера сертификатов. Если выбрано значение 1 (UserOnly), пользователи смогут управлять только сертификатами пользователей, но не смогут менять настройки доверия для встроенных сертификатов. Если задано значение 2 (None), пользователи смогут только просматривать сертификаты ЦС, но не управлять ими.";
CACertificates.pfm_title = "Сертификаты TLS, которым Brave будет доверять при аутентификации серверов";
CACertificates.pfm_description = "Список сертификатов TLS, которым Brave будет доверять при аутентификации серверов.\nСертификаты должны быть закодированы в формате Base64.";
CACertificatesWithConstraints.pfm_title = "Сертификаты TLS с ограничениями, которым Brave будет доверять при аутентификации серверов";
CACertificatesWithConstraints.pfm_description = "Список сертификатов TLS, которым Brave будет доверять при аутентификации серверов, с указанием ограничений для сертификата. При отсутствии ограничений для определенного типа разрешается использовать любое название такого типа.\nСертификаты должны быть закодированы в формате Base64. Для каждого сертификата должно быть указано хотя бы одно ограничение.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints.";
CADistrustedCertificates.pfm_title = "Сертификаты TLS, которым Brave не будет доверять при аутентификации серверов";
CADistrustedCertificates.pfm_description = "Список открытых ключей сертификатов, которым Brave не будет доверять при аутентификации серверов с использованием протокола TLS.\n\nЗначением правила является список сертификатов X.509 в кодировке Base64. Доверенными не являются сертификаты с совпадающим SPKI (SubjectPublicKeyInfo).";
CAHintCertificates.pfm_title = "Сертификаты TLS, которые не являются доверенными, но могут использоваться при построении цепочки сертификатов для аутентификации серверов";
CAHintCertificates.pfm_description = "Список сертификатов, которые не являются доверенными для Brave, но могут использоваться в качестве подсказок при построении цепочки сертификатов. Сертификаты должны быть закодированы в формате Base64.";
CAPlatformIntegrationEnabled.pfm_title = "Использовать добавленные пользователями TLS-сертификаты из хранилищ доверия платформы, чтобы выполнять аутентификацию серверов";
CAPlatformIntegrationEnabled.pfm_description = "Если правило включено или не настроено, добавленные пользователями TLS-сертификаты из хранилищ доверия платформы будут применяться при построении цепочки доверенных сертификатов для аутентификации серверов с помощью протокола TLS.\n\nЕсли правило отключено, добавленные пользователями TLS-сертификаты из хранилищ доверия платформы не будут применяться в этих целях.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "Поддержка заголовков запросов CORS без подстановочных знаков";
CORSNonWildcardRequestHeadersSupport.pfm_description = "Правило позволяет включить или отключить поддержку заголовков запросов CORS без подстановочных знаков,\n\nкоторая появилась в Brave 97. Когда скрипт направляет сетевой запрос к другому источнику, используя метод fetch() и XMLHttpRequest, с добавлением заголовка Authorization, такой заголовок должен быть явно разрешен в заголовке Access-Control-Allow-Headers из предварительного ответа CORS. \"Явно\" означает, что подстановочный знак \"*\" не может заменять заголовок Authorization. Подробнее: https://chromestatus.com/feature/5742041264816128.\n\nЕсли правило не настроено или для него задано значение True, то в Brave будут поддерживаться заголовки запросов CORS без подстановочных знаков, как описано выше.\n\nЕсли задано значение False, Chrome будет допускать замену заголовка Authorization подстановочным знаком \"*\" в заголовке Access-Control-Allow-Headers из предварительного ответа CORS.\n\nЭто корпоративное правило введено на время и позже будет удалено.";
CacheEncryptionEnabled.pfm_title = "С помощью этого правила администраторы могут шифровать кеш HTTP на диске.";
CacheEncryptionEnabled.pfm_description = "С помощью этого правила администраторы могут шифровать кеш HTTP на диске.\n\nЕсли правило включено, кеш в браузере будет шифроваться.\n\nЕсли оно отключено или не настроено, этот кеш шифроваться не будет.\n\nШифрование кеша в браузере может отразиться на производительности.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "Отключить проверку сертификатов для списка хешей subjectPublicKeyInfo";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "Если правило настроено, будет отключена принудительная проверка для списка хешей subjectPublicKeyInfo. Корпоративные хосты смогут продолжить работу с ненадежными сертификатами, не прошедшими проверку безопасности. Принудительная проверка будет отключена при одном из условий:\n\n* Хеш соответствует полю subjectPublicKeyInfo сертификата сервера.\n\n* Хеш соответствует полю subjectPublicKeyInfo одного из сертификатов центра сертификации (ЦС) в цепочке. Этот сертификат ЦС составлен по правилам, которые определяются расширением nameConstraints стандарта X.509v3. При этом один или несколько параметров nameConstraints для directoryName указаны в поле permittedSubtrees, а структура directoryName содержит атрибут organizationName.\n\n* Хеш соответствует полю subjectPublicKeyInfo одного из сертификатов ЦС в цепочке. В поле Subject сертификата ЦС указаны один или несколько атрибутов organizationName. Те же атрибуты представлены в сертификате сервера в том же количестве и таком же порядке с точностью до байта.\n\nЧтобы задать хеш subjectPublicKeyInfo, следует объединить название алгоритма хеширования, символ \"/\" и представленный в кодировке Base64 результат применения алгоритма хеширования к DER-представлению subjectPublicKeyInfo нужного сертификата. Кодировка SPKI Fingerprint основана на формате Base64. Единственный алгоритм хеширования, поддерживаемый на текущий момент, – sha256.\n\nЕсли правило не настроено, то Brave будет считать ненадежными любые сертификаты, не прошедшие проверку безопасности.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "Отключение проверки сертификатов для определенных сайтов";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "Если правило настроено, то для имен хостов в указанных URL будет отключена проверка сертификатов. Хосты смогут продолжать работу с ненадежными сертификатами, не прошедшими проверку безопасности. При этом выявлять ненадежные сертификаты для таких хостов станет сложнее.\n\nЕсли правило не настроено, то Brave будет считать ненадежными любые сертификаты, не прошедшие проверку безопасности.\n\nШаблон URL нужно указывать в формате, представленном на странице https://support.google.com/chrome/a?p=url_blocklist_filter_format. Однако Brave не учитывает префикс, номер порта и путь, поскольку сертификаты выдаются непосредственно для домена. Имена хостов с подстановочными знаками не поддерживаются.";
ChromeForTestingAllowed.pfm_title = "Разрешить использование Chrome для тестирования";
ChromeForTestingAllowed.pfm_description = "Правило определяет, можно ли пользоваться Chrome для тестирования.\n\nЕсли правило включено или не настроено, пользователям разрешено устанавливать и запускать Chrome для тестирования.\n\nОтключив правило, вы запретите запускать такую версию Chrome. Пользователи все равно смогут устанавливать Chrome для тестирования, однако браузер не будет работать в профиле, где правило отключено.";
ChromeSuggestionsSettings.pfm_title = "Настройки подсказок Chrome";
ChromeSuggestionsSettings.pfm_description = "Позволяет Chrome предлагать ИИ-функции в подходящие моменты.\n\nЕсли правило не настроено или задано значение \"0\", подсказки Chrome будут включены для пользователей.\n\nЕсли установлено значение \"1\", эти подсказки будут отключены.\n\nДополнительную информацию можно найти в статье Справочного центра: https://support.google.com/chrome/a?p=chrome_suggestions.";
ChromeVariations.pfm_title = "Определение наличия вариантов";
ChromeVariations.pfm_description = "0 - Включить все варианты\n1 - Разрешить только модификации, связанные с критическими исправлениями\n2 - Отключить все варианты\nЭто правило позволяет выбрать, какие модификации можно применять к Brave.\n\nС помощью модификаций можно изменить Brave без установки новой версии, путем выборочного включения и отключения уже имеющихся функций. Дополнительную информацию об этом можно найти на странице https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework.\n\nЕсли правило не настроено или установлен параметр VariationsEnabled (значение \"0\"), к браузеру можно применять любые модификации.\n\nЕсли задан параметр CriticalFixesOnly (значение \"1\"), к Brave можно применять только модификации, содержащие критические исправления для обеспечения безопасности и стабильности.\n\nЕсли выбран параметр VariationsDisabled (значение \"2\"), к браузеру невозможно применить ни одну из модификаций. Обратите внимание, что этот режим может мешать разработчикам Brave своевременно исправлять критические проблемы безопасности, поэтому включать его не рекомендуется.";
ClearBrowsingDataOnExitList.pfm_title = "Удаление данных о работе в браузере при выходе";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - История браузера\ndownload_history - История скачиваний\ncookies_and_other_site_data - Файлы cookie и другие данные сайтов\ncached_images_and_files - Кешированные файлы и изображения\npassword_signin - Пароли для входа\nautofill - Автозаполнение\nsite_settings - Настройки сайтов\nhosted_app_data - Данные размещенных приложений\nПравило позволяет настроить список данных о работе в браузере, которые должны удаляться, когда пользователь закрывает все окна браузера.\n\nВнимание! Правило может повлиять на локальные персональные данные или привести к их удалению. Чтобы избежать этого, рекомендуем проверять настройки перед их применением.\n\nВы можете выбрать следующие типы данных: историю браузера (browsing_history), историю скачиваний (download_history), файлы cookie (cookies_and_other_site_data), кеш (cached_images_and_files), информацию для автозаполнения (autofill), пароли (password_signin), настройки сайтов (site_settings) и данные размещенных приложений (hosted_app_data). Это правило не имеет приоритета над правилом AllowDeletingBrowserHistory.\n\nПользователь не выйдет из аккаунта Google после удаления файлов cookie.\n\nВ Chrome с версиями ниже 114 правило ClearBrowsingDataOnExitList работало, только если для SyncDisabled было установлено значение True. В Chrome версии 115 и более новой правило ClearBrowsingDataOnExitList останавливает синхронизацию выбранных типов данных, если функция \"Chrome Sync\" не отключена через SyncDisabled и правило BrowserSignin работает.\n\nЕсли по какой-либо причине удаление данных началось и не завершилось, они будут удалены при следующей загрузке профиля.\n\nЕсли Brave закрывается непредвиденно, например из-за сбоя в ОС или собственных неполадок, а не из-за закрытия всех окон браузера, то данные о работе не будут удалены.";
ClipboardAllowedForUrls.pfm_title = "Разрешить буфер обмена на этих сайтах";
ClipboardAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, которым разрешено использовать буфер обмена. Это правило распространяется не на все действия с буфером обмена в источниках, совпадающих с шаблонами. Например, пользователи по-прежнему смогут вставлять текст сочетанием клавиш, поскольку эту функцию нельзя ограничить с помощью настроек разрешения для сайта на доступ к буферу обмена.\n\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultClipboardSetting. Если не задано и оно, применяются персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Разрешено использовать подстановочные знаки (*).";
ClipboardBlockedForUrls.pfm_title = "Блокировать буфер обмена на этих сайтах";
ClipboardBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым запрещено использовать буфер обмена. Это правило распространяется не на все действия с буфером обмена в источниках, соответствующих шаблонам. Например, пользователи по-прежнему смогут вставлять текст сочетанием клавиш, поскольку эта функция не ограничивается параметром доступа сайтов к буферу обмена.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultClipboardSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Допустимы подстановочные знаки (*).";
CloudManagementEnrollmentMandatory.pfm_title = "Включить обязательную регистрацию в сервисе для управления облачными данными";
CloudManagementEnrollmentMandatory.pfm_description = "Если правило включено, регистрация браузера через Chrome Enterprise Core обязательна. В случае неудачи запуск Brave блокируется.\n\nЕсли правило отключено или не задано, регистрация браузера через Chrome Enterprise Core не требуется. В случае неудачи запуск Brave не блокируется.\n\nЭто правило используется на компьютерах при регистрации браузеров, для которых настроено облачное управление. Подробнее: https://support.google.com/chrome/a/answer/9301891.";
CloudManagementEnrollmentToken.pfm_title = "Токен регистрации правил облачных сервисов";
CloudManagementEnrollmentToken.pfm_description = "Если правило настроено, Brave пытается зарегистрироваться через Chrome Enterprise Core. Значением этого правила считается токен регистрации, который можно получить через Google Admin console.\n\nПодробнее: https://support.google.com/chrome/a/answer/9301891.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "Разрешить переопределять правило платформы при помощи облачного правила Brave";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Если правило включено, правила облачных сервисов будут иметь приоритет в случае конфликта с правилами платформы.\n\nЕсли правило отключено или не настроено, правила платформы будут иметь приоритет в случае конфликта с правилами облачных сервисов.\n\nЭто обязательное правило затрагивает правила облачных сервисов, действующие на устройстве.\n\nПравило относится к Brave и не влияет на Google Update, так как они работают независимо друг от друга.\nДля Google Update есть отдельное одноименное правило.";
CloudUserPolicyMerge.pfm_title = "Разрешить объединять правила облачных сервисов на уровне пользователей с правилами на уровне устройств";
CloudUserPolicyMerge.pfm_description = "Если правило включено, правила, связанные с управляемым аккаунтом, могут быть объединены с правилами на уровне устройств.\n\nЕсли правило отключено или не настроено, правила облачных сервисов на уровне пользователей нельзя объединить с правилами из других источников.\n\nПриоритет будут иметь только правила, заданные защищенными пользователями. Пользователь считается защищенным, если его браузером управляет организация с помощью Chrome Enterprise Core. Остальные правила на уровне пользователей будут иметь приоритет по умолчанию.\n\nПравила, которые нужно объединить, необходимо указать в списке PolicyListMultipleSourceMergeList или PolicyDictionaryMultipleSourceMergeList. Если не настроить ни одно из этих двух правил, правило об объединении не будет применяться.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Разрешить правилам облачных сервисов на уровне пользователей переопределять правила Chrome Browser Cloud Management";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Если правило включено, правила, связанные с управляемым аккаунтом, будут иметь приоритет в случае конфликта с правилами браузера, зарегистрированного через Chrome Enterprise Core.\n\nЕсли правило отключено или не настроено, правила облачных сервисов на уровне пользователей будут иметь приоритет по умолчанию.\n\nЭто относится только к правилам, заданным защищенными пользователями. Пользователь считается защищенным, если его браузером управляет организация с помощью Chrome Enterprise Core. Остальные правила на уровне пользователей будут иметь приоритет по умолчанию.\n\nЭто правило можно применять совместно с правилом CloudPolicyOverridesPlatformPolicy. Если включены оба правила, правила облачных сервисов на уровне пользователей будут иметь приоритет в случае конфликта с правилами платформы.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Включить предупреждения системы безопасности для флагов командной строки";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Если правило включено или не настроено, то при запуске Chrome с использованием потенциально опасных параметров командной строки будут появляться предупреждения системы безопасности.\n\nЕсли правило отключено, то при запуске Chrome с использованием потенциально опасных параметров командной строки предупреждения появляться не будут.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе \"Chrome Enterprise Core\".";
ComponentUpdatesEnabled.pfm_title = "Разрешить обновление компонентов Brave";
ComponentUpdatesEnabled.pfm_description = "Включает обновление всех компонентов для Brave, если правило не настроено или включено.\n\nЕсли правило отключено, компоненты обновляться не будут. Исключение составляют компоненты, которые не содержат исполняемый код и отвечают за безопасность браузера.\nПримеры таких компонентов: списки отзыва сертификатов и фильтры подресурсов.";
CompressionDictionaryTransportEnabled.pfm_title = "Включить поддержку переноса словарей сжатия";
CompressionDictionaryTransportEnabled.pfm_description = "Это правило позволяет указывать в заголовке Accept-Encoding методы кодирования с использованием словарей, когда словари доступны. Допустимые значения в заголовке: sbr и zst-d.\n\nЕсли правило включено или не настроено, Brave будет принимать веб-контент, используя функцию переноса словарей сжатия.\nЕсли правило отключено, эта функция работать не будет.";
CookiesAllowedForUrls.pfm_title = "Разрешить файлы cookie на этих сайтах";
CookiesAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым разрешено сохранять файлы cookie.\n\nЕсли в списке задан один URL, сайту, на который он указывает, разрешено использовать файлы cookie на всех сайтах верхнего уровня.\n\nВ качестве шаблонов можно указать два URL через запятую. Первый обозначает сайт, которому разрешено использовать файлы cookie на сайте верхнего уровня, заданного вторым URL.\n\nВ качестве первого элемента пары (но не второго) можно указать символ *. В этом случае использовать файлы cookie разрешено всем сайтам, если вторым URL является сайт верхнего уровня.\n\nЕсли это правило не настроено, для всех сайтов используется глобальное значение по умолчанию из правила DefaultCookiesSetting или BlockThirdPartyCookies при условии, что они заданы. В противном случае применяется пользовательская конфигурация.\n\nСм. также правила CookiesBlockedForUrls и CookiesSessionOnlyForUrls. Шаблоны URL в этих трех правилах не должны конфликтовать, поскольку ни одно из правил не имеет приоритета.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Значение * не поддерживается для этого правила.";
CookiesBlockedForUrls.pfm_title = "Блокировать файлы cookie на этих сайтах";
CookiesBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым запрещено сохранять файлы cookie.\n\nЕсли это правило не настроено, то для всех сайтов действует правило DefaultCookiesSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nТак как приоритета нет ни у одного правила, изучите информацию о правилах CookiesAllowedForUrls и CookiesSessionOnlyForUrls. Шаблоны URL, указанные в этих трех правилах, не должны конфликтовать.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается.";
CookiesSessionOnlyForUrls.pfm_title = "Файлы cookie, сохраненные сайтами с URL из списка, удаляются после окончания сеанса";
CookiesSessionOnlyForUrls.pfm_description = "Если в правиле RestoreOnStartup не настроено восстановление URL из предыдущих сеансов, вы можете задать в правиле CookiesSessionOnlyForUrls список шаблонов URL сайтов, которым разрешено и запрещено сохранять файлы cookie для одного сеанса.\n\nЕсли это правило не настроено, то для всех сайтов будет действовать правило DefaultCookiesSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя. Если URL нет в списках шаблонов, для него также будут действовать значения по умолчанию.\n\nПоскольку приоритета нет ни у одного правила, изучите информацию для правил CookiesBlockedForUrls и CookiesAllowedForUrls. Шаблоны URL, указанные в этих трех правилах, не должны конфликтовать.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * не поддерживается для этого правила.";
CpuPerformanceTierOverride.pfm_title = "Переопределить уровень производительности ЦП";
CpuPerformanceTierOverride.pfm_description = "Правило позволяет компаниям переопределять значение, возвращаемое CPU Performance API (то есть\nnavigator.cpuPerformance). Подробнее: https://github.com/WICG/cpu-performance.\n\nЕсли правило настроено, значение правила navigator.cpuPerformance будет заменено указанным значением. Если правило не настроено, используется расчет уровня производительности по умолчанию.\n\nДопустимые значения для этого правила: от 0 до 4.";
CreatePasskeysInICloudKeychain.pfm_title = "Это правило определяет, используется ли по умолчанию служба \"Связка ключей iCloud\" для создания ключей доступа";
CreatePasskeysInICloudKeychain.pfm_description = "Brave может направлять относящиеся к WebAuthn запросы на создание ключей доступа напрямую в службу \"Связка ключей iCloud\" на устройствах с macOS 13.5 или более поздней версии. Если синхронизация в службе \"Связка ключей iCloud\" не включена, пользователю может быть предложено сделать это или войти в аккаунт iCloud.\n\nЕсли для правила задано значение False, служба \"Связка ключей iCloud\" не будет использоваться по умолчанию. Вместо этого может действовать предыдущее поведение, при котором учетные данные создаются в профиле Brave. У пользователей останется возможность выбирать службу \"Связка ключей iCloud\", и при входе по-прежнему могут подставляться учетные данные из нее.\n\nЕсли для правила задано значение True, служба \"Связка ключей iCloud\" будет использоваться по умолчанию для каждого совместимого запроса WebAuthn.\n\nЕсли правило не настроено, поведение по умолчанию зависит от определенных факторов. Например, учитывается, создавал или применял ли пользователь учетные данные в своем профиле Brave в последнее время, а также включен ли iCloud Drive.";
CreateThemesSettings.pfm_title = "Настройки создания тем с помощью ИИ";
CreateThemesSettings.pfm_description = "0 - Разрешить использовать функцию \"Создание тем с помощью ИИ\" с улучшением ИИ-моделей\n1 - Разрешить использовать функцию \"Создание тем с помощью ИИ\" без улучшения ИИ-моделей\n2 - Не разрешать использовать функцию \"Создание тем с помощью ИИ\"\nФункция создания тем с помощью ИИ позволяет пользователям генерировать собственные темы и обои на основе заранее выбранных параметров.\n\nЕсли установлено значение \"0\", функцией можно пользоваться и Google разрешается улучшать свои ИИ-модели с помощью определенных данных. Это могут быть запросы, входные и выходные данные, а также исходные материалы и отзывы, в зависимости от функции. Для улучшения ИИ-моделей эти данные также могут проверяться специалистами. Значение \"0\" используется по умолчанию, за исключением описанных ниже случаев.\n\nЕсли установлено значение \"1\", функцией можно пользоваться, но Google запрещается улучшать ИИ-модели с помощью контента пользователей, в том числе запросов, входных и выходных данных, исходных материалов и отзывов. Это значение используется по умолчанию для корпоративных и учебных аккаунтов, управляемых через Google Admin console и Google Workspace.\n\nЕсли установлено значение \"2\", функцией нельзя пользоваться.\n\nЕсли правило не настроено, применяется правило GenAiDefaultSettings.\n\nПодробнее о том, как обрабатываются данные при использовании функций на основе генеративного ИИ: https://support.google.com/chrome/a?p=generative_ai_settings.";
DNSInterceptionChecksEnabled.pfm_title = "Включить проверку на перехват DNS";
DNSInterceptionChecksEnabled.pfm_description = "Это правило настраивает локальный переключатель, который позволяет отключать проверки на перехват DNS. С помощью этих проверок осуществляется попытка определить, использует ли браузер прокси-сервер, который перенаправляет запросы к неизвестным именам хостов.\n\nЕсли конфигурация сети известна (например, внутри предприятия), то эти проверки могут быть лишними, так как они создают трафик DNS и HTTP при запуске и при каждом изменении конфигурации DNS.\n\nЕсли правило не настроено или включено, проводятся проверки на перехват DNS. Если правило отключено в явном виде, они не проводятся.";
DataURLWhitespacePreservationEnabled.pfm_title = "Сохранять пробельные символы в URL данных для всех MIME-типов";
DataURLWhitespacePreservationEnabled.pfm_description = "Это правило позволяет временно отказаться от нового алгоритма обработки пробельных символов в URL данных (data) в Chrome.\nРанее такие символы сохранялись, только если MIME-типом верхнего уровня был text или если он содержал строку xml.\nТеперь пробельные символы будут сохраняться во всех URL данных независимо от MIME-типа.\n\nЕсли правило не настроено или установлено значение True, используется новый алгоритм,\n\nа если выбрано значение False – старый.";
DataUrlInSvgUseEnabled.pfm_title = "Поддержка URL данных в SVGUseElement";
DataUrlInSvgUseEnabled.pfm_description = "Это правило включает поддержку URL данных в SVGUseElement, которая будет отключена по умолчанию, начиная с версии M119.\nЕсли правило включено, URL данных продолжат работать в SVGUseElement.\nЕсли правило отключено или не настроено, URL данных не будут работать в SVGUseElement.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Включить непрозрачные источники для data URL в объектах Web Worker";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Правило определяет, присваивается ли объектам Web Worker, созданным через data URL, уникальный непрозрачный источник.\n\nОбъект Web Worker можно настроить, поместив его скрипт в data URL. Ранее объекты Worker наследовали источник страницы, которая их создала, и получали доступ к ее локальному хранилищу, файлам cookie и другим данным, связанным с источником. В Chrome с версии 149 объекты Worker используют другие настройки по умолчанию. Эта мера нужна, чтобы повысить безопасность и соблюсти спецификацию HTML. Теперь у объектов Worker, созданных с помощью data URL, будет уникальный непрозрачный источник. Это позволяет изолировать их от данных со страницы создания.\n\nЕсли правило включено или не настроено, используются новые более безопасные настройки по умолчанию. У объектов Web Worker, созданных с помощью data URL, будет уникальный непрозрачный источник.\n\nЕсли правило отключено, Chrome возвращается к устаревшим настройкам. Объекты Web Worker, созданные через data URL, будут наследовать источник страницы, на которой они настроены. Благодаря этому администраторы могут временно устранить проблемы совместимости, если внутренние приложения перестанут работать из-за изменения в настройках безопасности.\n\nЭто правило будет удалено в версии 157.";
DefaultAutomaticDownloadsSetting.pfm_title = "Настройки автоматического скачивания по умолчанию";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Разрешить сайтам автоматически скачивать несколько файлов\n2 - Запретить сайтам автоматически скачивать несколько файлов\n3 - Запрашивать разрешение на автоматическое скачивание нескольких файлов\nЕсли для правила задано значение 1, сайтам разрешено автоматически скачивать несколько файлов. Если задано значение 2, разрешение не предоставляется. Вы можете настроить правило так, чтобы сайты запрашивали разрешение на автоматическое скачивание нескольких файлов.\n\nЕсли правило не настроено, действует правило AskAutomaticDownloads, но пользователи могут его изменить.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Сделать Brave браузером по умолчанию";
DefaultBrowserSettingEnabled.pfm_description = "Если для правила задано значение True, при запуске Brave будет всегда проверять, является ли он браузером по умолчанию, и если нет, автоматически регистрироваться в качестве такового. Если задано значение False, Brave не будет проверять, является ли он браузером по умолчанию, и запретит пользователям изменять этот параметр.\n\nЕсли правило не настроено, Brave разрешит пользователям управлять проверкой браузера по умолчанию и показом соответствующих уведомлений.\n\nПримечание для администраторов Microsoft®Windows®. Этот параметр можно включить только на компьютерах с Windows 7. В более поздних версиях Windows вам необходимо использовать файл с настройками приложений по умолчанию, который закрепляет за Brave обработку протоколов https и http (можно также указать протокол ftp и другие форматы файлов). Подробную информацию вы найдете на странице https://support.google.com/chrome?p=make_chrome_default_win.";
DefaultClipboardSetting.pfm_title = "Параметры буфера обмена по умолчанию";
DefaultClipboardSetting.pfm_description = "2 - Запретить сайтам использовать буфер обмена\n3 - Разрешить сайтам запрашивать у пользователей доступ к буферу обмена\nЕсли для правила установлено значение 2, то сайтам запрещено использовать буфер обмена. Если установлено значение 3 или правило не настроено, то пользователь сможет изменять этот параметр, а также разрешать или запрещать сайтам использовать API буфера обмена, когда они запрашивают доступ.\n\nЭто правило можно переопределить для отдельных шаблонов URL с помощью правил ClipboardAllowedForUrls и ClipboardBlockedForUrls.\n\nОно распространяется только на действия, управляемые параметром доступа сайтов к буферу обмена. Правило не влияет на очищенные данные в буфере обмена и доверенные операции копирования и вставки.";
DefaultCookiesSetting.pfm_title = "Настройки файлов cookie по умолчанию";
DefaultCookiesSetting.pfm_description = "1 - Разрешить всем сайтам сохранять локальные данные\n2 - Запретить сайтам сохранять данные на компьютер\n4 - Хранить файлы cookie до конца сеанса\nЕсли в правиле RestoreOnStartup не настроено восстановление URL из предыдущих сеансов, вы можете задать в правиле CookiesSessionOnlyForUrls список шаблонов URL для указания сайтов, которым разрешено и запрещено сохранять файлы cookie для одного сеанса.\n\nЕсли это правило не настроено, то для всех сайтов будет действовать правило DefaultCookiesSetting при условии, что оно задано. В противном случае действуют персональные настройки пользователя. Если URL нет в списках шаблонов, для него также будут действовать значения по умолчанию.\n\nПоскольку приоритета нет ни у одного правила, изучите информацию для правил CookiesBlockedForUrls и CookiesAllowedForUrls. Шаблоны URL, указанные в этих трех правилах, не должны конфликтовать.";
DefaultDownloadDirectory.pfm_title = "Выбор каталога для скачивания по умолчанию";
DefaultDownloadDirectory.pfm_description = "Это правило изменяет каталог, в который браузер Chrome по умолчанию скачивает файлы. Пользователи могут выбрать другой каталог.\n\nЕсли правило не настроено, браузер Chrome использует каталог, заданный по умолчанию в той или иной ОС.\n\nЭто правило не действует, если включено правило DownloadDirectory.\n\nВы также можете ознакомиться со списком переменных (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DefaultFileSystemReadGuardSetting.pfm_title = "Управлять использованием File System API для чтения";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - Не разрешать сайтам запрашивать доступ на чтение файлов и каталогов через File System API\n3 - Разрешать сайтам запрашивать у пользователей доступ для чтения к файлам и каталогам через File System API\nЕсли задано значение 3, сайтам будет разрешено запрашивать доступ для чтения к файлам и каталогам операционной системы хоста через File System API, а если задано значение 2, – запрещено.\n\nЕсли правило не настроено, сайты получат такое разрешение, но пользователи смогут его изменить.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Управлять использованием File System API для записи";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - Не разрешать сайтам запрашивать доступ на запись файлов и каталогов\n3 - Разрешать сайтам запрашивать у пользователей доступ для записи к файлам и каталогам\nЕсли задано значение 3, сайтам будет разрешено запрашивать доступ для записи к файлам и каталогам операционной системы хоста, а если задано значение 2, – запрещено.\n\nЕсли правило не настроено, сайты получат такое разрешение, но пользователи смогут его изменить.";
DefaultGeolocationSetting.pfm_title = "Настройка географического положения по умолчанию";
DefaultGeolocationSetting.pfm_description = "1 - Разрешить сайтам отслеживать местоположение пользователей\n2 - Запретить сайтам отслеживать местоположение пользователей\n3 - Спрашивать, если сайт пытается отследить местоположение пользователя\nЕсли для правила выбрано значение 1, сайтам будет по умолчанию разрешено отслеживать местоположение пользователей, а если 2, – запрещено. Вы можете настроить правило так, чтобы сайты запрашивали разрешение на отслеживание местоположения пользователя.\n\nЕсли правило не настроено, действует правило AskGeolocation, но пользователи могут изменить этот параметр.";
DefaultIdleDetectionSetting.pfm_title = "Определение бездействия";
DefaultIdleDetectionSetting.pfm_description = "1 - Разрешить сайтам определять состояние бездействия, не спрашивая пользователя\n2 - Запретить сайтам определять состояние бездействия пользователя\n3 - Спрашивать каждый раз, когда сайт запрашивает разрешение на определение состояния бездействия пользователя\nПравило позволяет разрешить или запретить сайтам использовать Idle Detection API.\n\nЕсли установлено значение 1 (AllowIdleDetection), сайты могут использовать API без запроса разрешения у пользователя.\n\nЕсли задано значение 2 (BlockIdleDetection), сайты не могут использовать API независимо от того, предоставил ли пользователь разрешение.\n\nЕсли правило не настроено или для него указано значение 3 (AskIdleDetection), сайты не могут использовать API без разрешения пользователя.";
DefaultImagesSetting.pfm_title = "Настройка изображений по умолчанию";
DefaultImagesSetting.pfm_description = "1 - Разрешить показ изображений на всех сайтах\n2 - Запретить показ изображений на всех сайтах\nЕсли для правила задано значение 1, показ изображений на любых сайтах разрешен, а если 2, – запрещен.\n\nЕсли правило не настроено, показ изображений разрешен, но пользователи могут изменить этот параметр.";
DefaultInsecureContentSetting.pfm_title = "Контроль использования исключений для небезопасного контента";
DefaultInsecureContentSetting.pfm_description = "2 - Запретить загрузку смешанного контента на всех сайтах\n3 - Разрешить пользователям добавлять исключения для смешанного контента\nПозволяет определить, могут ли пользователи добавлять исключения, разрешающие смешанный контент на определенных сайтах.\n\nЭто правило можно переопределить для нужных шаблонов URL с помощью правил InsecureContentAllowedForUrls и InsecureContentBlockedForUrls.\n\nЕсли правило не настроено, пользователи могут добавлять исключения, разрешающие блокируемый смешанный контент, и отключать автоматическое повышение уровня безопасности для опционально блокируемого смешанного контента.";
DefaultJavaScriptJitSetting.pfm_title = "Управлять использованием JIT-компилятора JavaScript";
DefaultJavaScriptJitSetting.pfm_description = "1 - Разрешить использование JIT-компилятора JavaScript на всех сайтах\n2 - Запретить использование JIT-компилятора JavaScript на всех сайтах\nПозволяет выбрать, будет ли включаться JIT-компилятор в интерпретаторе JavaScript версии 8, который используется браузером Brave.\n\nЕсли отключить JIT-компилятор JavaScript, веб-контент может загружаться медленнее в Brave, а некоторые элементы JavaScript, включая WebAssembly, могут перестать работать. Отключение JIT-компилятора JavaScript повышает безопасность отображения веб-контента в Brave.\n\nЭто правило можно переопределить для отдельных шаблонов URL с помощью правил JavaScriptJitAllowedForSites и JavaScriptJitBlockedForSites.\n\nЕсли правило не настроено, JIT-компилятор JavaScript будет включен.";
DefaultJavaScriptOptimizerSetting.pfm_title = "Использование оптимизаторов JavaScript";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Включить улучшенную оптимизацию JavaScript на всех сайтах\n2 - Отключить улучшенную оптимизацию JavaScript на всех сайтах\nПозволяет выбрать, будет ли использоваться улучшенная оптимизация JavaScript при запуске движка JavaScript V8 в Brave.\n\nЕсли отключить оптимизацию JavaScript (выбрать для правила значение \"2\"), браузер Brave может медленнее отрисовывать веб-контент.\n\nЭто правило можно переопределить для отдельных шаблонов URL с помощью правил JavaScriptOptimizerAllowedForSites и JavaScriptOptimizerBlockedForSites.\n\nЕсли правило не настроено, оптимизация JavaScript будет включена.";
DefaultJavaScriptSetting.pfm_title = "Настройки JavaScript по умолчанию";
DefaultJavaScriptSetting.pfm_description = "1 - Разрешить всем сайтам выполнять JavaScript\n2 - Запретить выполнение JavaScript на всех сайтах\nЕсли для правила выбрано значение 1, сайтам разрешено выполнять код JavaScript, а если 2, – запрещено.\n\nЕсли правило не настроено, выполнение JavaScript разрешено, но пользователи могут изменить этот параметр.";
DefaultLocalFontsSetting.pfm_title = "Параметр доступа к шрифтам на устройстве по умолчанию";
DefaultLocalFontsSetting.pfm_description = "2 - Запретить доступ к шрифтам на устройстве для всех сайтов по умолчанию\n3 - Спрашивать каждый раз, когда сайт запрашивает доступ к шрифтам на устройстве\nЕсли для правила установлено значение 2 (BlockLocalFonts), то по умолчанию сайтам запрещено использовать шрифты на устройстве. Это ограничит доступ сайтов к информации о шрифтах на устройстве.\n\nЕсли для правила установлено значение 3 (AskLocalFonts), по умолчанию пользователь решает, разрешать ли сайтам использовать шрифты на устройстве. Если разрешение предоставлено, то сайты получат доступ к информации о шрифтах на устройстве.\n\nЕсли правило не настроено, по умолчанию сайты будут запрашивать доступ, но пользователи могут это изменить.";
DefaultNotificationsSetting.pfm_title = "Настройка уведомлений по умолчанию";
DefaultNotificationsSetting.pfm_description = "1 - Разрешить сайтам показывать уведомления\n2 - Запретить показ уведомлений на всех сайтах\n3 - Спрашивать всегда, если сайт собирается отобразить уведомление\nЕсли для правила выбрано значение 1, сайтам разрешено показывать уведомления на рабочем столе, а если 2, – запрещено.\n\nЕсли правило не настроено, действует правило AskNotifications, но пользователи могут изменить этот параметр.";
DefaultPopupsSetting.pfm_title = "Параметр всплывающих окон по умолчанию";
DefaultPopupsSetting.pfm_description = "1 - Разрешить открытие всплывающих окон на всех сайтах\n2 - Блокировать всплывающие окна на всех сайтах\nЕсли для правила задано значение 1, на сайтах разрешен показ всплывающих окон, а если 2, – запрещен.\n\nЕсли правило не настроено, действует правило BlockPopups, но пользователи могут изменить этот параметр.";
DefaultPrinterSelection.pfm_title = "Правила выбора принтера по умолчанию";
DefaultPrinterSelection.pfm_description = "Переопределяет правила выбора принтера по умолчанию в Brave. При первом запуске печати Brave выполнит поиск принтера, соответствующего всем указанным атрибутам, и установит его в качестве принтера по умолчанию. Если подходящих принтеров несколько, Brave выберет тот, что был обнаружен первым.\n\nЕсли правило не настроено или атрибуты не совпадают, по умолчанию используется встроенный PDF-принтер. Если такого принтера нет, Brave не будет выбирать принтер по умолчанию.\n\nСейчас все принтеры относятся к типу \"local\". Принтеры, подключенные к сервису \"Google Cloud Print\", относятся к типу \"cloud\", но тип Google Cloud Print больше не поддерживается.\n\nПримечание. Если значение в поле не указано, то при поиске учитываются все значения этого поля. Например, если не указан атрибут idPattern, то для предварительного просмотра печати будут приняты все идентификаторы принтеров. Формат регулярных выражений должен соответствовать синтаксису JavaScript RegExp с учетом регистра.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection.";
DefaultSearchProviderAlternateURLs.pfm_title = "Список дополнительных URL для поисковой системы по умолчанию";
DefaultSearchProviderAlternateURLs.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то параметр DefaultSearchProviderAlternateURLs содержит список альтернативных URL, которые используются для извлечения запросов из поисковой системы. Для выполнения этой функции URL должен содержать строку '{searchTerms}'.\n\nЕсли правило DefaultSearchProviderAlternateURLs не настроить, то для извлечения поисковых запросов не будут использоваться альтернативные URL.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Доступ к поисковой системе по умолчанию в контекстном меню";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "Позволяет использовать поисковую систему по умолчанию в контекстном меню.\n\nЕсли правило отключено, поиск в системе по умолчанию будет недоступен в контекстном меню.\n\nЕсли правило включено или не настроено, поиск в системе по умолчанию будет доступен в контекстном меню.\n\nЗначение этого правила применяется только в том случае, если включено правило DefaultSearchProviderEnabled.";
DefaultSearchProviderEnabled.pfm_title = "Включить поисковую систему по умолчанию";
DefaultSearchProviderEnabled.pfm_description = "Если это правило включено, то при вводе в адресную строку текста (не URL) будет использоваться поисковая система, выбранная по умолчанию. Задать поисковую систему по умолчанию можно с помощью других правил. Если значения для этих правил не указаны, пользователь может сам выбрать поисковую систему по умолчанию. Если это правило отключено, то при вводе текста в адресную строку поиск не выполняется. Google Admin console не поддерживает значение \"Отключено\".\n\nЕсли правило настроено, пользователи не могут изменить этот параметр в Brave. Если оно не настроено, будет работать поиск по умолчанию и пользователи смогут самостоятельно выбирать поисковые системы.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе \"Chrome Enterprise Core\".";
DefaultSearchProviderEncodings.pfm_title = "Кодировки поисковой системы по умолчанию";
DefaultSearchProviderEncodings.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то параметр DefaultSearchProviderEncodings указывает кодировки символов, поддерживаемые поисковой системой. Они представляют собой названия кодовых страниц, например UTF-8, GB2312 или ISO-8859-1, и проверяются в заданном порядке.\n\nЕсли параметр DefaultSearchProviderEncodings не задан, используется UTF-8.";
DefaultSearchProviderImageURL.pfm_title = "Параметр функции поиска изображений для поисковой системы по умолчанию";
DefaultSearchProviderImageURL.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то с помощью правила DefaultSearchProviderImageURL можно задать URL поисковой системы, используемой для поиска картинок. (Если настроено правило DefaultSearchProviderImageURLPostParams, то запросы поиска картинок отправляются с помощью метода POST.)\n\nЕсли правило DefaultSearchProviderImageURL не настроено, поиск картинок не используется.\n\nЕсли поиск картинок выполняется с помощью метода get, параметр\nизображения в URL должен указываться с помощью допустимой комбинации следующих плейсхолдеров:\n'{google:imageURL}';\n'{google:imageOriginalHeight}';\n'{google:imageOriginalWidth}';\n'{google:processedImageDimensions}';\n'{google:imageSearchSource}';\n'{google:imageThumbnail}';\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "Параметры для запросов POST к URL-адресу поиска изображений";
DefaultSearchProviderImageURLPostParams.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то с помощью правила DefaultSearchProviderImageURLPostParams можно задать список параметров, используемых в запросах POST при поиске картинок. Список состоит из пар \"имя-значение\", разделенных запятыми. Если в качестве значения указан параметр шаблона (например, {imageThumbnail}), он заменяется фактическими данными.\n\nЕсли правило DefaultSearchProviderImageURLPostParams не настроено, для запросов поиска картинок используется метод get.\n\nПараметр изображения в URL должен указываться с помощью допустимой комбинации\nследующих плейсхолдеров, список которых зависит от поставщика услуг поиска:\n'{google:imageURL}';\n'{google:imageOriginalHeight}';\n'{google:imageOriginalWidth}';\n'{google:processedImageDimensions}';\n'{google:imageSearchSource}';\n'{google:imageThumbnail}';\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Ключевое слово для поисковой системы по умолчанию";
DefaultSearchProviderKeyword.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то параметр DefaultSearchProviderKeyword задает ключевое слово или сочетание клавиш, которое используется в адресной строке, чтобы запустить поиск в поисковой системе.\n\nЕсли параметр DefaultSearchProviderKeyword не задан, то поисковая система с помощью ключевого слова не активируется.";
DefaultSearchProviderName.pfm_title = "Название поисковой системы по умолчанию";
DefaultSearchProviderName.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то параметр DefaultSearchProviderName задает название поисковой системы по умолчанию.\n\nЕсли параметр DefaultSearchProviderName не задан, то используется имя хоста, указанное в URL поискового запроса.";
DefaultSearchProviderNewTabURL.pfm_title = "Показ URL страницы быстрого доступа в поисковой системе по умолчанию";
DefaultSearchProviderNewTabURL.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то правило DefaultSearchProviderNewTabURL указывает URL поисковой системы, используемой для страницы быстрого доступа.\n\nЕсли правило DefaultSearchProviderNewTabURL не настроено, страница быстрого доступа не будет использоваться.";
DefaultSearchProviderSearchURL.pfm_title = "URL поиска для поисковой системы по умолчанию";
DefaultSearchProviderSearchURL.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то настройка DefaultSearchProviderSearchURL содержит URL поисковой системы, используемой по умолчанию. В URL должна быть строка '{searchTerms}', которая во время отправки запроса заменяется на текст пользователя.\n\nURL поисковой системы Google можно указать так: '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "Параметры запросов POST к URL-адресу для поиска";
DefaultSearchProviderSearchURLPostParams.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то настройка DefaultSearchProviderSearchURLPostParams содержит список параметров, используемых в поисковых запросах методом POST. Список состоит из пар \"имя-значение\", разделенных запятыми. Если в качестве значения указан параметр шаблона (например, '{searchTerms}'), он заменяется фактическими данными.\n\nЕсли правило DefaultSearchProviderSearchURLPostParams не настроено, для поисковых запросов используется метод GET.";
DefaultSearchProviderSuggestURL.pfm_title = "URL используемой по умолчанию поисковой системы для запроса подсказок";
DefaultSearchProviderSuggestURL.pfm_description = "Если правило DefaultSearchProviderEnabled включено, то параметр DefaultSearchProviderSuggestURL задает URL поисковой системы, используемой для предоставления подсказок. В URL должна быть строка '{searchTerms}', которая во время отправки запроса заменяется на текст пользователя.\n\nURL поисковой системы Google можно указать так: '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "Параметры для запросов POST к URL-адресу поиска предложений";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "Если правило DefaultSearchProviderEnabled не включено, то настройка DefaultSearchProviderSuggestURLPostParams задает параметры, используемые в запросах POST при поиске вариантов поисковых запросов. Список состоит из пар \"имя-значение\", разделенных запятыми. Если в качестве значения указан параметр шаблона (например, '{searchTerms}'), он заменяется фактическими данными.\n\nЕсли правило DefaultSearchProviderSuggestURLPostParams не настроено, для поисковых запросов используется метод GET.";
DefaultSensorsSetting.pfm_title = "Действующая по умолчанию настройка доступа к датчикам";
DefaultSensorsSetting.pfm_description = "1 - Разрешить сайтам доступ к датчикам\n2 - Не разрешать сайтам доступ к датчикам\n3 - Запрашивать разрешение на доступ сайтов к датчикам\nЕсли для правила задано значение 1, то сайтам разрешено получать доступ к датчикам, таким как датчик движения или освещенности, и использовать их. Если указано значение 2, доступ к датчикам запрещен. Если для правила задано значение 3, сайты будут запрашивать разрешение на доступ к данным. Если флаг функции не включен, доступ к датчикам будет разрешен по умолчанию.\n\nЕсли правило не настроено, действует правило AllowSensors, но пользователи могут изменить этот параметр.";
DefaultSerialGuardSetting.pfm_title = "Управление использованием Serial API";
DefaultSerialGuardSetting.pfm_description = "2 - Не разрешать сайтам запрашивать доступ к серийным портам через Serial API\n3 - Разрешить сайтам запрашивать доступ к последовательным портам\nЕсли в этом правиле указано значение \"3\", то сайтам разрешено запрашивать доступ к последовательным портам, а если \"2\", то запрещено.\n\nЕсли правило не задано, запрашивать доступ разрешено, но пользователи могут изменить эту настройку.";
DefaultWebBluetoothGuardSetting.pfm_title = "Контроль использования Web Bluetooth API";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - Запретить всем сайтам запрашивать доступ к Bluetooth-устройствам через Web Bluetooth API\n3 - Разрешить сайтам запрашивать доступ к находящимся поблизости Bluetooth-устройствам\nЕсли задано значение 3, сайты могут запрашивать доступ к находящимся неподалеку устройствам Bluetooth. Если указано значение 2, доступ к находящимся неподалеку устройствам Bluetooth запрещен.\n\nЕсли правило не настроено, сайтам разрешено запрашивать доступ к устройствам, но пользователи могут изменять этот параметр.";
DefaultWebHidGuardSetting.pfm_title = "Управлять использованием WebHID API";
DefaultWebHidGuardSetting.pfm_description = "2 - Запретить сайтам запрашивать доступ к HID-устройствам через WebHID API\n3 - Разрешить сайтам запрашивать доступ к HID-устройствам\nЕсли задано значение \"3\", сайты могут запрашивать доступ к HID-устройствам. Если выбрано значение \"2\", доступ к HID-устройствам запрещен.\n\nЕсли правило не настроено, сайтам разрешено запрашивать доступ, но пользователи могут изменить этот параметр.\n\nПравило можно переопределить для отдельных шаблонов url с помощью правил WebHidAskForUrls и WebHidBlockedForUrls.";
DefaultWebUsbGuardSetting.pfm_title = "Контроль использования WebUSB API";
DefaultWebUsbGuardSetting.pfm_description = "2 - Запретить всем сайтам запрашивать доступ к USB-устройствам через WebUSB API\n3 - Разрешить сайтам запрашивать доступ к подключенному USB-устройству\nЕсли выбрано значение 3, сайтам будет разрешено запрашивать доступ к подключенным USB-устройствам, а если задано значение 2, – запрещено.\n\nЕсли правило не настроено, сайты получат такое разрешение, но пользователи смогут его изменить.";
DefaultWindowManagementSetting.pfm_title = "Настройки управления окнами по умолчанию";
DefaultWindowManagementSetting.pfm_description = "2 - Запретить управление окнами на всех сайтах по умолчанию\n3 - Спрашивать каждый раз, когда сайт запрашивает разрешение на управление окнами\nЕсли для правила задано значение 2 (BlockWindowManagement), по умолчанию сайтам автоматически запрещено управлять окнами. При этом для сайтов ограничивается доступ к информации об экране устройства, без которой они не могут открывать и размещать окна или переходить в полноэкранный режим на некоторых экранах.\n\nЕсли установлено значение 3 (AskWindowManagement), по умолчанию у пользователя запрашивается разрешение на управление окнами. Если разрешение предоставлено, у сайтов появляется доступ к информации об экране устройства, с которой они могут открывать и размещать окна или переходить в полноэкранный режим на некоторых экранах.\n\nЕсли значение не задано, действует правило AskWindowManagement, но пользователи могут его изменить.\n\nЭто правило заменяет правило DefaultWindowPlacementSetting, которое больше не поддерживается.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Включить удаление недешифруемых паролей";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Правило определяет, может ли встроенный менеджер паролей удалять недешифруемые пароли из базы данных. Это необходимо для восстановления полной функциональности встроенного менеджера паролей, но может привести к безвозвратной потере данных. Недешифруемые значения паролей не станут дешифруемыми сами по себе. Если их можно исправить, то обычно это требует сложных действий со стороны пользователя.\n\nЕсли правило включено или не настроено, то пользователи с недешифруемыми паролями, сохраненными во встроенном менеджере паролей, потеряют их. Это не относится к паролям в рабочем состоянии.\n\nЕсли отключить правило, данные менеджера паролей сохранятся, но его функциональность будет нарушена.\n\nЕсли правило настроено, пользователи не могут изменить его в Brave.";
DesktopSharingHubEnabled.pfm_title = "Включить \"Центр общего доступа к рабочему столу\" в омнибоксе и меню в виде трех точек";
DesktopSharingHubEnabled.pfm_description = "Если выбрано значение True или правило не настроено, пользователи могут сохранять текущие веб-страницы и делиться ими с помощью действий, представленных в функции \"Центр общего доступа к рабочему столу\". Эту функцию можно найти в омнибоксе или меню в виде трех точек.\n\nЕсли указано значение False, значок общего доступа удаляется из омнибокса и меню в виде трех точек.";
DevToolsGenAiSettings.pfm_title = "Настройки функций на основе генеративного ИИ в инструменте Chrome DevTools";
DevToolsGenAiSettings.pfm_description = "0 - Разрешить использовать функции на основе генеративного ИИ в инструменте Chrome DevTools и улучшать его модели\n1 - Разрешить использовать функции на основе генеративного ИИ в инструменте Chrome DevTools, но не улучшать его модели\n2 - Не разрешать использовать функции на основе генеративного ИИ в инструменте Chrome DevTools\nЭти функции в инструменте Chrome DevTools задействуют модели генеративного ИИ, чтобы предоставлять дополнительные сведения для отладки. Для использования таких функций Brave собирает сообщения об ошибках, трассировки стека, фрагменты кода, сетевые запросы и другие данные и отправляет их на сервер Google, на котором работает модель генеративного искусственного интеллекта. Тело ответа, заголовки аутентификации и файлов cookie из сетевых запросов на сервер не передаются.\n\nЕсли установлено значение \"0\", функцией можно пользоваться и Google разрешается улучшать свои ИИ-модели с помощью определенных данных. Это могут быть запросы, входные и выходные данные, а также исходные материалы и отзывы, в зависимости от функции. Для улучшения ИИ-моделей эти данные также могут проверяться специалистами. Значение \"0\" используется по умолчанию, за исключением описанных ниже случаев.\n\nЕсли установлено значение \"1\", функцией можно пользоваться, но Google запрещается улучшать ИИ-модели с помощью контента пользователей, в том числе запросов, входных и выходных данных, исходных материалов и отзывов. Это значение используется по умолчанию для корпоративных и учебных аккаунтов, управляемых через Google Admin console и Google Workspace.\n\nЕсли установлено значение \"2\", функцией нельзя пользоваться.\n\nЕсли правило не настроено, применяется правило GenAiDefaultSettings.\n\nВ инструмент Chrome DevTools входят следующие функции на основе генеративного ИИ:\n\n- Console Insights: поясняет сообщения в консоли и предлагает способы устранения ошибок.\n\n- Помощь от ИИ: генерирует подсказки по работе с CSS-стилями (доступно в версии 131 и более поздних), а также, начиная с версии 132, с сетевыми запросами, данными о производительности и файлами.\n\nПодробнее о том, как обрабатываются данные при использовании функций на основе генеративного ИИ: https://support.google.com/chrome/a?p=generative_ai_settings.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Включить профили Google Developer Program в Chrome DevTools";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Включить интеграцию Google Developer Program в Chrome DevTools\n1 - Включить интеграцию Google Developer Program в Chrome DevTools, не передавая данные об использовании инструмента (для присвоения значков)\n2 - Отключить интеграцию Google Developer Program в Chrome DevTools\nЭто правило управляет интеграцией Google Developer Program с Chrome DevTools. Профиль пользователя Google Developer Program показывается в Chrome DevTools, и за определенные действия в Chrome DevTools присваиваются значки.\n\nЕсли для правила задано значение 0 (включено) или поле оставлено пустым, включается интеграция Google Developer Program с Chrome DevTools и разрешается передача данных об использовании инструмента Chrome DevTools для присвоения значков.\n\nЕсли для правила задано значение 1 (включено, но без значков), включается интеграция Google Developer Program с Chrome DevTools, но передача данных об использовании инструмента Chrome DevTools с Google Developer Program не разрешается. Значки не присваиваются.\n\nЕсли для правила задано значение 2 (отключено), интеграция Google Developer Program с Chrome DevTools не разрешается.";
DeveloperToolsAvailability.pfm_title = "Выбрать, где можно использовать Chrome DevTools";
DeveloperToolsAvailability.pfm_description = "0 - Запретить использовать Chrome DevTools в приложениях и расширениях, которые встроены в браузер (начиная с версии 114 и при использовании управляемого аккаунта) или установлены в соответствии с корпоративными правилами. Разрешить использовать Chrome DevTools в других средах.\n1 - Разрешить использовать Chrome DevTools\n2 - Запрет на использование Chrome DevTools\nЕсли для правила задано значение \"0\" (по умолчанию), вы можете использовать Chrome DevTools и консоль JavaScript, но не в контексте расширений, которые встроены в браузер (начиная с версии 114 и при использовании управляемого аккаунта) или установлены в соответствии с корпоративными правилами. Если выбрано значение \"1\", вы можете использовать Chrome DevTools и консоль JavaScript в любых контекстах, в том числе в контексте расширений, установленных в соответствии с корпоративными правилами. Если задано значение \"2\", Chrome DevTools вам недоступны и вы не можете просматривать элементы сайтов.\n\nВам также не разрешается открывать Chrome DevTools или консоль JavaScript с помощью сочетаний клавиш и пунктов контекстного или обычного меню.\n\nВ Brave версии 99 и более поздних этот параметр также управляет точками входа для просмотра исходного кода страницы. Если указано значение \"2\" (DeveloperToolsDisallowed), пользователи не могут просматривать исходный код с помощью сочетаний клавиш или контекстного меню. Чтобы полностью запретить просмотр исходного кода, добавьте строку \"view-source:*\" в правило URLBlocklist.\n\nВ Brave версии 119 и более поздних этот параметр также определяет, можно ли включать и использовать режим разработчика для изолированных веб-приложений.\n\nВ Brave версии 128 и более поздних параметр не управляет этим режимом на странице расширений, если задано правило ExtensionDeveloperModeSettings.\n\nПравило влияет на Chrome DevTools, прямой доступ к Chrome DevTools Protocol (CDP), например при запуске с параметром --remote-debugging-port или --remote-debugging-pipe, и доступ к этому протоколу через API chrome.debugger. Правило применяется совместно с другим — RemoteDebuggingAllowed. RemoteDebuggingAllowed определяет, можно ли запускать удаленную отладку, а это — ограничивает возможность анализировать отдельные целевые объекты, даже если удаленная отладка запущена.\n\nПравила DeveloperToolsAvailabilityAllowlist и DeveloperToolsAvailabilityBlocklist имеют приоритет над данным правилом. Возможность использовать Chrome DevTools определяется следующим образом:\n\n1. Если URL соответствует шаблону в правиле DeveloperToolsAvailabilityAllowlist, использовать Chrome DevTools разрешается.\n2. Если правило DeveloperToolsAvailabilityAllowlist задано, а DeveloperToolsAvailabilityBlocklist — нет, блокируются все URL, которых нет в белом списке.\n3. Если URL соответствует шаблону в правиле DeveloperToolsAvailabilityBlocklist, Chrome DevTools блокируются.\n4. Если ни одно из правил не задано или URL нет ни в одном из списков, в качестве резервного механизма используется правило DeveloperToolsAvailability.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Список шаблонов URL, для которых разрешено открывать Chrome DevTools";
DeveloperToolsAvailabilityAllowlist.pfm_description = "С помощью этого правила можно разрешить Chrome DevTools для определенных URL.\n\nВозможность использовать Chrome DevTools оценивается на уровне целевого объекта. Шаблоны URL сверяются с URL каждого анализируемого целевого объекта (например, основного фрейма страницы, встроенного субфрейма, расширения или веб-приложения). Итоговое поведение зависит от того, задано ли правило DeveloperToolsAvailabilityBlocklist.\n\nЕсли это правило задано, а DeveloperToolsAvailabilityBlocklist — нет, то использовать Chrome DevTools для целевого объекта можно тогда, когда его URL соответствует шаблону из белого списка. Если URL целевого объекта не соответствует шаблону из белого списка, Chrome DevTools будут для него заблокированы. Например, субфрейм, URL которого нет в белом списке, нельзя анализировать, а основную страницу — можно, если ее URL там есть. Подробнее о формате URL: https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nЕсли настроено как это правило, так и правило DeveloperToolsAvailabilityBlocklist, приоритет имеет белый список из этого правила. Если URL целевого объекта соответствует шаблону из белого списка, он будет разрешен, даже если этот URL также соответствует шаблону из черного списка. Если URL целевого объекта соответствует шаблону из черного списка, но не из белого, такой URL будет заблокирован. Если URL целевого объекта не соответствует ни одному шаблону из этих списков, DeveloperToolsAvailability будет использоваться в качестве резервного правила.\n\nЕсли это правило не задано, возможность использовать Chrome DevTools определяется правилами DeveloperToolsAvailabilityBlocklist и DeveloperToolsAvailability.\n\nЗапрещено использовать общие подстановочные знаки (например, \"*\" или \"[*]\") для хостов. Чтобы включить функцию для всех URL, используйте правило DeveloperToolsAvailability.\n\nПравило влияет на Chrome DevTools, прямой доступ к Chrome DevTools Protocol (CDP), например при запуске с параметром --remote-debugging-port или --remote-debugging-pipe, и доступ к этому протоколу через API chrome.debugger. Правило применяется совместно с другим — RemoteDebuggingAllowed. RemoteDebuggingAllowed определяет, можно ли запускать удаленную отладку, а это — ограничивает возможность анализировать отдельные целевые объекты, даже если удаленная отладка запущена.\n\nВ этом правиле можно указать не более 1000 URL.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Список шаблонов URL, для которых заблокированы инструменты разработчика Chrome DevTools";
DeveloperToolsAvailabilityBlocklist.pfm_description = "С помощью этого правила можно заблокировать Chrome DevTools для определенных URL. Подробнее о формате URL: https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nВозможность использовать Chrome DevTools оценивается на уровне целевого объекта. Шаблоны URL сверяются с URL каждого анализируемого целевого объекта (например, основного фрейма страницы, встроенного субфрейма, расширения или веб-приложения). Итоговое поведение зависит от того, задано ли правило DeveloperToolsAvailabilityAllowlist.\n\nЕсли оно задано, а правило DeveloperToolsAvailabilityAllowlist — нет, то при совпадении URL целевого объекта с шаблоном в черном списке Chrome DevTools будут заблокированы для этого объекта. Например, субфрейм, URL которого соответствует шаблону в черном списке, нельзя анализировать, а основную страницу — можно, если ее URL нет в черном списке. Если URL целевого объекта не соответствует ни одному шаблону, доступность инструментов разработчика определяется правилом DeveloperToolsAvailability.\n\nЕсли настроено как это правило, так и правило DeveloperToolsAvailabilityAllowlist, приоритет имеет белый список. Если URL целевого объекта соответствует шаблону из белого списка, он будет разрешен, даже если этот URL также соответствует шаблону из черного списка. Если URL целевого объекта соответствует шаблону из черного списка, но не из белого, такой URL будет заблокирован. Если URL целевого объекта не соответствует ни одному шаблону из этих списков, DeveloperToolsAvailability будет использоваться в качестве резервного правила.\n\nЕсли это правило не задано, возможность использовать Chrome DevTools определяется правилами DeveloperToolsAvailabilityAllowlist и DeveloperToolsAvailability.\n\nПравило влияет на Chrome DevTools, прямой доступ к Chrome DevTools Protocol (CDP), например при запуске с параметром --remote-debugging-port или --remote-debugging-pipe, и доступ к этому протоколу через API chrome.debugger. Правило применяется совместно с другим — RemoteDebuggingAllowed. RemoteDebuggingAllowed определяет, можно ли запускать удаленную отладку, а это — ограничивает возможность анализировать отдельные целевые объекты, даже если удаленная отладка запущена.\n\nВ этом правиле можно указать не более 1000 URL.";
Disable3DAPIs.pfm_title = "Отключение поддержки API трехмерной графики";
Disable3DAPIs.pfm_description = "Если для правила задано значение True (или если HardwareAccelerationModeEnabled имеет значение False), веб-страницам запрещен доступ к WebGL API.\n\nЕсли правило не настроено или задано значение False, такого ограничения нет. При этом, согласно настройкам браузера по умолчанию, для доступа к этим API могут требоваться аргументы командной строки.";
DisableAuthNegotiateCnameLookup.pfm_title = "Отключить поиск записи CNAME при запросе на аутентификацию Kerberos";
DisableAuthNegotiateCnameLookup.pfm_description = "Если правило включено, поиск записи CNAME не выполняется. При создании идентификатора SPN протокола Kerberos имя сервера используется в том виде, в котором оно было указано.\n\nЕсли правило не настроено или отключено, то при создании идентификатора SPN протокола Kerberos каноническое имя сервера определяется через поиск записи CNAME.";
DisablePrintPreview.pfm_title = "Отключить предварительный просмотр";
DisablePrintPreview.pfm_description = "Если правило включено, при запросе печати вместо предварительного просмотра Brave открывает системное диалоговое окно.\n\nЕсли правило отключено или не настроено, при запросе печати будет открываться окно предварительного просмотра.";
DisableSafeBrowsingProceedAnyway.pfm_title = "Запрет перехода со страницы предупреждения Безопасного просмотра";
DisableSafeBrowsingProceedAnyway.pfm_description = "Если это правило включено, пользователи не смогут переходить на потенциально опасные сайты со страницы предупреждения, показанной сервисом \"Безопасный просмотр\". Это правило касается только предупреждений Безопасного просмотра (например, о вредоносном ПО или фишинге) и не распространяется на проблемы, связанные с сертификатами SSL, такими как истекший или недействительный сертификат.\n\nЕсли значение не задано или правило отключено, пользователи могут переходить на потенциально опасные сайты после того, как им будет показано предупреждение.\n\nПодробные сведения о Безопасном просмотре можно найти здесь: https://developers.google.com/safe-browsing.";
DisableScreenshots.pfm_title = "Запрет создания скриншотов";
DisableScreenshots.pfm_description = "Если правило включено, пользователи не могут делать скриншоты с помощью быстрых клавиш или API расширений. Если правило отключено или не настроено, пользователи могут делать скриншоты.\n\nВ версии Brave 154 и последующих включение этого правила также запрещает расширениям подключать отладчик с помощью метода chrome.debugger.attach().\n\nОбратите внимание, что на платформах Microsoft® Windows®, macOS и Linux это правило не запрещает делать скриншоты с помощью приложений операционной системы или сторонних приложений.";
DiskCacheDir.pfm_title = "Установка каталога кеша на диске";
DiskCacheDir.pfm_description = "Если правило настроено, Brave хранит кешированные файлы на диске в установленном вами каталоге независимо от того, указали ли пользователи значение экспериментального параметра --disk-cache-dir.\n\nЕсли правило не настроено, Brave использует каталог по умолчанию, однако пользователи могут его изменить с помощью экспериментального параметра --disk-cache-dir.\n\nBrave управляет содержимым корневого каталога тома, поэтому не указывайте в этом правиле корневой каталог или каталог, который используется в других целях. Это позволит избежать потери данных или возникновения ошибок. Список поддерживаемых переменных приведен здесь: https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DiskCacheSize.pfm_title = "Задать объем кеша";
DiskCacheSize.pfm_description = "Если для правила задано значение None, Brave использует объем кеша по умолчанию для хранения кешированных файлов на диске. В этом случае пользователи не могут изменить правило.\n\nЕсли вы настроите правило, Brave будет использовать установленный вами размер кеша независимо от того, указали ли пользователи значение экспериментального параметра --disk-cache-size. Значения меньше нескольких мегабайтов округляются.\n\nЕсли правило не настроено, Brave использует объем по умолчанию. В этом случае пользователи могут менять размер кеша с помощью экспериментального параметра --disk-cache-size.\n\nПримечание. Указанное в правиле значение используется различными подсистемами в браузере как справочное. Поэтому фактический объем используемого дискового пространства может превышать указанное значение, но будет иметь такой же порядок.";
DnsOverHttpsMode.pfm_title = "Настроить режим использования протокола \"DNS поверх HTTPS\"";
DnsOverHttpsMode.pfm_description = "off - Отключить режим DNS-over-HTTPS\nautomatic - Включить DNS поверх HTTPS с возможностью отката к незащищенным запросам\nsecure - Включить DNS поверх HTTPS без возможности отката к незащищенным запросам\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "Указать шаблон URI нужного преобразователя DNS поверх HTTPS";
DnsOverHttpsTemplates.pfm_description = "Шаблон URI нужного преобразователя DNS-over-HTTPS. Чтобы указать несколько таких преобразователей, разделите URI-шаблоны пробелами.\n\nЭто правило должно быть настроено (его нельзя оставлять пустым), если для правила DnsOverHttpsMode задано значение \"secure\". В Google Chrome OS DNS-преобразование невозможно, если это правило или правило DnsOverHttpsTemplatesWithIdentifiers не настроено.\n\nЕсли это правило настроено и для DnsOverHttpsMode выбрано значение \"automatic\", то будут использоваться указанные шаблоны URI. Если это правило не настроено, будут использоваться сопоставления, заданные непосредственно в программе, чтобы попытаться обновить текущий DNS-преобразователь до DoH-преобразователя того же поставщика.\n\nЕсли шаблон URI содержит переменную dns, то для отправки запросов преобразователю будет использован метод GET, в противном случае – метод POST.\n\nШаблоны с неправильным форматированием будут проигнорированы.";
DomainReliabilityAllowed.pfm_title = "Разрешить отправку данных о надежности доменов";
DomainReliabilityAllowed.pfm_description = "Если установлено значение False, отправка данных о надежности доменов отключена.\nЕсли правило не настроено или для него задано значение True, данные о надежности доменов будут передаваться в Google в зависимости от настроек правила MetricsReportingEnabled для Brave или DeviceMetricsReportingEnabled для Google Chrome OS.";
DownloadDirectory.pfm_title = "Выбор каталога для скачиваний";
DownloadDirectory.pfm_description = "В этом правиле указывается каталог, в котором браузер Chrome сохраняет скачиваемые файлы. Данный каталог используется, даже если пользователь выбрал каталог для сохранения или установил флажок, позволяющий выбирать каталог при каждом скачивании файла.\n\nЭто правило отменяет действие правила DefaultDownloadDirectory.\n\nЕсли правило не настроено, браузер Chrome скачивает файлы в каталог по умолчанию, а пользователь может его изменить.\n\nДля Google Chrome OS скачивание возможно только в каталоги на Google Диске.\n\nВы также можете ознакомиться со списком переменных ( https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables ).";
DownloadRestrictions.pfm_title = "Ограничения скачивания";
DownloadRestrictions.pfm_description = "0 - Специальных ограничений нет (по умолчанию)\n1 - Блокировать скачивание вредоносного ПО и опасных типов файлов\n2 - Блокировать скачивание вредоносных, необычных, нежелательных и опасных типов файлов\n3 - Блокировать все скачивания\n4 - Блокировать скачивание вредоносных файлов (рекомендуется)\nЕсли настроить правило, пользователи не смогут игнорировать решения о скачивании, принимаемые системой безопасности.\n\nВ браузере Chrome есть много типов предупреждений о скачивании файлов, которые условно можно разделить на три категории, описанные ниже. Подробнее о причинах блокировки при использовании Безопасного просмотра: https://support.google.com/chrome/?p=ib_download_blocked.\n\n* Вредоносный файл, отмеченный сервером Безопасного просмотра.\n* Необычный или нежелательный файл, отмеченный сервером Безопасного просмотра.\n* Файл опасного типа (например, любой SWF-файл и многие файлы в формате EXE).\n\nВ зависимости от выбранного значения правило блокирует скачивание определенных групп файлов.\n\n0 (по умолчанию): специальных ограничений нет.\n\n1: блокирует вредоносные файлы, отмеченные сервером Безопасного просмотра, и все файлы опасных типов. Рекомендуется только для организационных подразделений и пользователей, работа которых не страдает от ложноположительных блокировок.\n\n2: блокирует вредоносные файлы, отмеченные сервером Безопасного просмотра, а также необычные и нежелательные файлы, отмеченные сервером Безопасного просмотра, и все файлы опасных типов. Рекомендуется только для организационных подразделений и пользователей, работа которых не страдает от ложноположительных блокировок.\n\n3: блокирует скачивание любых файлов. Следует использовать только в особых случаях.\n\n4 (рекомендуется): блокирует вредоносные файлы, отмеченные сервером Безопасного просмотра, не блокирует файлы опасных типов.\n\nПримечание. Эти ограничения распространяются как на скачивания, запускаемые на веб-странице, так и на те, которые начинаются после нажатия \"Сохранить данные по ссылке\" в контекстном меню. Ограничения не распространяются на скачивание открытой в данный момент страницы, а также на сохранение в формате PDF из окна печати. Дополнительная информация о Безопасном просмотре приведена здесь: https://developers.google.com/safe-browsing.";
EditBookmarksEnabled.pfm_title = "Включить или отключить возможность изменения закладок";
EditBookmarksEnabled.pfm_description = "Если правило включено или не настроено, пользователи могут добавлять, удалять, изменять или загружать закладки.\n\nЕсли правило отключено, пользователи не могут добавлять, удалять, изменять или загружать закладки. При этом у них останется доступ к существующим закладкам.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Включить нестандартный порт в имя SPN Kerberos";
EnableAuthNegotiatePort.pfm_description = "Если правило включено и указан нестандартный порт (любой, кроме 80 или 443), он будет включен в создаваемый идентификатор SPN протокола Kerberos.\n\nЕсли правило отключено или не настроено, то этот порт в идентификатор не добавляется.";
EnableExperimentalPolicies.pfm_title = "Включить экспериментальные правила";
EnableExperimentalPolicies.pfm_description = "Позволяет Brave загружать экспериментальные правила.\n\nВНИМАНИЕ! Такие правила не поддерживаются и могут быть без уведомления изменены или удалены в будущей версии браузера.\n\nЭкспериментальное правило может быть не закончено или содержать известные или неизвестные ошибки, а также быть изменено или даже удалено без уведомления. Если вы используете такие правила, то можете потерять данные о работе в браузере, а также подвергнуть риску свою безопасность и конфиденциальность данных.\n\nЕсли правила нет в списке и оно ещё не выпущено официально, заданное в нем значение будет проигнорировано в бета-версии и в стабильной версии.\n\nЕсли правило есть в списке, но оно ещё не выпущено официально, будет применяться указанное в нем значение.\n\nНа уже выпущенные правила это правило не влияет.";
EnableMediaRouter.pfm_title = "Включить Google Cast";
EnableMediaRouter.pfm_description = "Если правило включено или не настроено, будет задействована технология Google Cast. Ее можно активировать через меню приложения, контекстное меню страницы, элементы управления медиаконтентом на сайтах с поддержкой Cast или при помощи значка трансляции на панели инструментов (если он есть).\n\nЕсли правило отключено, технология Google Cast использоваться не будет.";
EnableOnlineRevocationChecks.pfm_title = "Включить проверки OCSP/CRL в режиме онлайн";
EnableOnlineRevocationChecks.pfm_description = "Если задано значение True, могут выполняться онлайн-проверки OCSP/CRL.\n\nЕсли правило не настроено или указано значение False, Brave не будет выполнять онлайн-проверки отзыва сертификатов в Brave 19 и более поздних версий.\n\nПримечание. Проверки OCSP/CRL не обеспечивают существенного повышения уровня защиты.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "Это правило определяет, какие пользователи с управляемым аккаунтом могут настраивать правила ProxyOverrideRules и ProxyProvisioningDomains.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Если правило не настроено или для него установлено значение 0, ProxyOverrideRules и ProxyProvisioningDomains применяются на уровне пользователя, только если он аффилирован и использует управляемый браузер.\nЕсли указано значение 1, правила ProxyOverrideRules и ProxyProvisioningDomains применяются на уровне пользователя, даже если он не аффилирован.";
EnableUnsafeSwiftShader.pfm_title = "Разрешить использовать SwiftShader как резервный API для WebGL";
EnableUnsafeSwiftShader.pfm_description = "Правило определяет, используется ли SwiftShader в качестве резервного API для WebGL, когда аппаратное ускорение графического процессора недоступно.\n\nРанее SwiftShader API применялся для поддержки WebGL в системах без ускорения графического процессора (например, в консольных системах или виртуальных машинах), но теперь не используется из-за проблем с безопасностью. В версии M139 и более поздних, если SwiftShader необходим, при создании контекста WebGL возникнет ошибка. Это правило позволяет браузеру или администратору временно отложить прекращение поддержки SwiftShader.\n\nВключив правило, вы разрешите использовать SwiftShader как резервный API для WebGL.\n\nЕсли правило не настроено или отключено, при создании контекста WebGL на системах без аппаратного ускорения графического процессора возможны сбои. Веб-страницы, которые не обрабатывают такие сбои корректно, могут работать неправильно.\n\nЭто временное правило. В дальнейшем оно будет удалено.";
EncryptedClientHelloEnabled.pfm_title = "Включение Encrypted ClientHello для TLS";
EncryptedClientHelloEnabled.pfm_description = "Encrypted ClientHello (ECH) – это расширение для TLS, предназначенное для шифрования конфиденциальных полей ClientHello и повышения уровня конфиденциальности.\n\nЕсли правило не настроено или включено, при выпуске ECH Brave будет следовать процессу по умолчанию. Если правило отключено, Brave не запустит расширение.\n\nКогда функция включена, Brave может как использовать, так и не использовать ECH. Это зависит от статуса выпуска расширения, доступности записи DNS по HTTPS и того, поддерживает ли данную возможность сервер.\n\nНад протоколом ECH ещё ведутся работы, поэтому способ его реализации в Brave может измениться. Данное правило – временное. Оно необходимо для контроля экспериментальной версии расширения. Когда протокол будет доработан, правило заменят итоговые настройки.";
EnterpriseCustomLabel.pfm_title = "Настройка своей корпоративной метки для управляемых профилей";
EnterpriseCustomLabel.pfm_description = "Правило позволяет настроить показ пользовательской метки для обозначения управляемых профилей. Она будет располагаться рядом со значком профиля на панели инструментов. Пользовательская метка не переводится на другие языки автоматически.\n\nЕсли правило применяется, все строки длиннее 16 символов обрезаются и в конце их ставится многоточие (\"…\"). Не используйте развернутые названия.\n\nЭто правило можно настроить только как правило для пользователей.\n\nОбратите внимание, что это правило не работает, если для правила EnterpriseProfileBadgeToolbarSettings задано значение \"1\" (hide_expanded_enterprise_toolbar_badge).";
EnterpriseCustomLabelForBrowser.pfm_title = "Настройка своей корпоративной метки для управляемого браузера";
EnterpriseCustomLabelForBrowser.pfm_description = "Правило управляет показом пользовательской метки для обозначения управляемого браузера. Она появляется в нижнем колонтитуле страницы быстрого доступа. Пользовательская метка не переводится на другие языки автоматически.\n\nУчтите, что правило применяется только к управляемым браузерам. Оно не действует, если аккаунт является управляемым, а браузер – нет.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе Chrome Enterprise Core.\n\nВ macOS это правило можно настроить только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе Chrome Enterprise Core.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Разрешает управляемым расширениям использовать Enterprise Hardware Platform API";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Если задано значение True, то расширения, установленные с помощью корпоративного правила, смогут использовать Enterprise Hardware Platform API.\n\nЕсли правило не настроено или указано значение False, расширения не смогут использовать этот API.\n\nПримечание. Это правило также действует для расширений компонентов, например Hangout Services.";
EnterpriseLogoUrl.pfm_title = "Настройка URL корпоративного логотипа для управляемого профиля";
EnterpriseLogoUrl.pfm_description = "Позволяет указать URL изображения, которое будет использоваться в качестве значка предприятия в управляемом профиле. URL должен указывать на изображение.\n\nЭто правило можно настроить только как правило для пользователей.\n\nРекомендуется использовать значок сайта (например, https://www.google.com/favicon.ico) или другой значок размером не менее 48 x 48 пкс.";
EnterpriseLogoUrlForBrowser.pfm_title = "Настройка URL корпоративного логотипа для управляемого браузера";
EnterpriseLogoUrlForBrowser.pfm_description = "Позволяет задать URL изображения, которое используется в качестве корпоративного значка в управляемом браузере. URL должен указывать на изображение.\n\nРекомендуется использовать значок сайта, например https://www.google.com/favicon.ico, или другой значок размером не менее 48 x 48 пкс.\n\nОбратите внимание: правило применяется только к управляемым браузерам. Оно не действует, если аккаунт является управляемым, а браузер – нет.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе Chrome Enterprise Core.\n\nВ macOS это правило можно настроить только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе Chrome Enterprise Core.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Показ корпоративной метки профиля на панели инструментов";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Показывать развернутую корпоративную метку на панели инструментов\n1 - Скрывать развернутую корпоративную метку на панели инструментов\nРядом с аватаром на панели инструментов в управляемых аккаунтах по умолчанию показывается тип профиля – рабочий или учебный.\n\nЕсли для правила установлено значение \"1\" (hide_expanded_enterprise_toolbar_badge), эта метка будет скрыта.\n\nЕсли правило не настроено или для него задано значение \"0\" (show_expanded_enterprise_toolbar_badge), она будет показываться.\n\nМетку можно настраивать с помощью правила EnterpriseCustomLabel.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "По умолчанию сохранять данные о работе в браузере при создании корпоративного профиля";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Если правило включено, возможность сохранения существующих данных о работе в браузере при создании корпоративного профиля будет активирована по умолчанию.\n\nЕсли правило не настроено или отключено, возможность не будет активирована по умолчанию.\n\nВне зависимости от установленного значения, во время создания корпоративного профиля пользователь сможет решить, будет ли применяться эта опция.\n\nПравило не применяется, если возможность сохранения существующих данных о работе в браузере отсутствует. Это происходит, когда строго необходим отдельный корпоративный профиль или будут использоваться данные из управляемого профиля.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Настройки корпоративного поискового агрегатора";
EnterpriseSearchAggregatorSettings.pfm_description = "Это правило позволяет администраторам настроить корпоративный поисковый агрегатор, который показывает результаты поиска и подсказки в омнибоксе (адресной строке) и окне поиска на странице быстрого доступа.\n\nПо умолчанию корпоративные подсказки при поиске показываются вместе с обычными рекомендациями от Brave. Пользователи могут отфильтровать результаты, ограничив их корпоративным поисковым агрегатором. Для этого нужно набрать в омнибоксе ключевое слово, указанное в поле shortcut, с префиксом \"@\" или без него, например \"@work\", и нажать Пробел или Tab. Отфильтрованные результаты (с использованием ключевого слова) пока можно получать только через адресную строку. Они не поддерживаются в окне поиска на странице быстрого доступа.\n\nСледующие поля обязательные: name, shortcut, search_url и suggest_url.\n\nВ поле name указывается название поисковой системы, которое пользователь видит в адресной строке.\n\nВ shortcut добавляется ключевое слово, которое нужно ввести, чтобы активировать поиск. В качестве ключевого слова можно использовать обычные слова и символы. Оно не должно начинаться с \"@\" или содержать пробелы. Необходимо, чтобы все ключевые слова были уникальными.\n\nВ поле search_url указывается URL поисковой системы. Введите в нем веб-адрес страницы с результатами поиска, а вместо запроса подставьте '{searchTerms}'.\n\nВ suggest_url добавляется URL поставщика подсказок при поиске. Поисковый запрос пользователя передается в параметрах запроса POST в ключе 'query'.\n\nВ поле icon_url указывается URL изображения, которое используется в подсказках при поиске. Если значение не задано, показывается значок по умолчанию. Рекомендуем использовать значок сайта, например https://www.google.com/favicon.ico. Поддерживаются форматы JPEG, PNG и ICO.\n\nВ поле require_shortcut указывается, нужно ли в адресной строке вводить ключевое слово из shortcut, чтобы видеть подсказки. Если да, подсказки перестанут появляться в окне поиска на странице быстрого доступа. Они будут показываться только в адресной строке, когда результаты поиска отфильтрованы. Если значение не задано, ключевое слово из shortcut не требуется.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в Chrome Enterprise Core.\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в Chrome Enterprise Core.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "Отключение предупреждений при скачивании файлов с заданными расширениями с доменов из списка";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Администраторы могут включить это правило, чтобы создать словарь, в котором для каждого расширения файла перечисляется список доменов. Для заданных доменов не будут показываться предупреждения о скачивании файлов указанного типа. Например, если связать расширение JNLP с доменом website1.com, пользователи не увидят предупреждение при скачивании файла JNLP с сайта website1.com. Если попытаться скачать файл JNLP с website2.com, предупреждение появится.\n\nНастройки этого правила не влияют на показ других предупреждений, не зависящих от типов файлов, например предупреждений режима Безопасного просмотра или о скачивании смешанного контента.\n\nЕсли правило отключено или не настроено, при скачивании файлов с заданными расширениями пользователи увидят предупреждение.\n\nВо время настройки правила обратите внимание на следующее:\n\n* Шаблон URL должен соответствовать требованиям, указанным на странице https://chromeenterprise.google/policies/url-patterns/.\n\n* При вводе расширений файлов используйте только строчные ASCII-символы. Точку указывать не нужно: пишите \"jnlp\", а не \".jnlp\".\n\nПример:\n\nЕсли использовать указанные ниже настройки, предупреждения не будут показываться при скачивании файлов EXE и JNLP с доменов *.example.com и файлов SWF с любого сайта.\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nОбратите внимание, что использование приведенных выше настроек не рекомендуется. Отключение предупреждений при скачивании потенциально опасных типов файлов со всех сайтов представляет риск для пользователей. Этот пример приведен исключительно в ознакомительных целях.\n\nЕсли это правило включено вместе с DownloadRestrictions, оно имеет приоритет над DownloadRestrictions, которое блокирует скачивание потенциально опасных типов файлов. Заданные в текущем правиле исключения касаются только блокировки потенциально опасных типов файлов, которая определяется значениями \"1\" и \"2\" в правиле DownloadRestrictions.\n\nНапример, если в текущем правиле разрешено скачивать файлы EXE с сайта website1.com, а DownloadRestrictions запрещает скачивание вредоносных и потенциально опасных типов файлов (значение \"1\"), пользователь сможет скачивать файлы EXE с сайта website1.com, если система не сочтет их вредоносными.\n\nПодробнее о DownloadRestrictions: https://chromeenterprise.google/policies/?policy=DownloadRestrictions.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Явно разрешенные сетевые порты";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - порт 554 (можно разблокировать до 15.10.2021)\n10080 - порт 10080 (можно разблокировать до 01.04.2022)\n6566 - порт 6566 (можно разблокировать до 15.10.2021)\n989 - порт 989 (можно разблокировать до 01.02.2022)\n990 - порт 990 (можно разблокировать до 01.02.2022)\nВ Brave есть встроенный список запрещенных портов, к которым нельзя подключиться. Это правило позволяет обойти ограничения, заданные списком. Значение представляет собой разделенный запятыми список из нуля или более портов, на которых будут разрешены исходящие соединения.\n\nДля портов предусмотрен ограниченный доступ, чтобы через Brave нельзя было использовать различные сетевые уязвимости. Если это правило настроено, ваша сеть может подвергаться атакам. Это правило используется в качестве временного решения для ошибок с кодом ERR_UNSAFE_PORT, которые возникают при переносе сервиса, работающего на заблокированном порту, на стандартный порт (например, порт 80 или 443).\n\nВредоносные сайты могут легко определить, для каких портов настроено это правило, и использовать эту информацию для целенаправленных атак.\n\nДля каждого порта указана дата, до которой его можно разблокировать. После этой даты для порта вводится режим ограниченного доступа, независимо от значения, заданного в этом правиле.\n\nЕсли значение не задано, все порты с ограниченным доступом будут заблокированы. Если указать и действительные, и недействительные значения, применяться будут только первые.\n\nЭто правило переопределяет значение командной строки --explicitly-allowed-ports.";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Черный список поставщиков идентификационной информации, с которыми нельзя использовать Extensible Enterprise SSO в браузере";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Все поставщики идентификационной информации\nmicrosoft - Microsoft® (облачный поставщик идентификационной информации)\nokta - Okta® (облачный поставщик идентификационной информации)\nping - Облачный поставщик идентификационной информации Ping®\nЭто правило отключает указанных поставщиков идентификационной информации в системе единого входа с поддержкой технологии Extensible Enterprise SSO.\n\nЕсли установлено значение 'all', то в SSO отключаются все поддерживаемые поставщики.\n\nЕсли установлено значение 'microsoft', то в Chrome отключается вход через облачного поставщика идентификационной информации Microsoft®.\n\nЕсли правило не настроено, включаются все поставщики идентификационной информации, поддерживаемые Brave.\n\nЕсли поставщик идентификационной информации разрешен в Brave и настроен администратором на устройстве, то пользователю достаточно один раз войти через этого поставщика в любое приложение с поддержкой Extensible Enterprise SSO. Позже пользователь сможет автоматически входить в тот же аккаунт на веб-ресурсах через этого поставщика. Идентификационные данные пользователя передаются облачному поставщику идентификационной информации при каждой аутентификации.\n\nПримечания.\n\nBrave не поддерживает систему единого входа с использованием технологии Extensible Enterprise SSO в режиме инкогнито и гостевом режиме.\n\nBrave поддерживает систему единого входа с использованием технологии Extensible Enterprise SSO только для следующих поставщиков идентификационной информации: Microsoft, Okta, Ping.\n\nЭта возможность доступна в macOS 10.15 и более поздних версий.";
ExtensionAllowedTypes.pfm_title = "Типы расширений и приложений, которые разрешено устанавливать";
ExtensionAllowedTypes.pfm_description = "extension - Расширение\ntheme - Тема\nuser_script - Пользовательский скрипт\nhosted_app - Размещенное приложение\nlegacy_packaged_app - Устаревшее пакетное приложение\nplatform_app - Приложение-платформа\nЭто правило определяет, какие приложения и расширения могут быть установлены в Brave и с какими хостами они могут взаимодействовать. Кроме того, оно задает ограничения доступа к среде выполнения.\n\nЕсли это правило не настроено, допускаются все расширения и приложения.\n\nРасширения и приложения, тип которых не указан в списке, устанавливаться не будут. Каждое значение должно представлять собой одну из следующих строк:\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\nПодробная информация о типах приведена в документации по расширениям Brave.\n\nВ версиях ниже 75 не поддерживается использование нескольких идентификаторов расширений, разделенных запятыми, поэтому в них такие значения пропускаются. Остальные параметры правила применяются.\n\nЭто правило также влияет на расширения и приложения, которые принудительно устанавливаются в соответствии с правилом ExtensionInstallForcelist.\n\nЭто правило применяется только на платформах, которые поддерживают расширения.";
ExtensionDeveloperModeSettings.pfm_title = "Управление доступом к режиму разработчика на странице расширений";
ExtensionDeveloperModeSettings.pfm_description = "0 - Разрешить использовать режим разработчика на странице расширений\n1 - Запретить использовать режим разработчика на странице расширений\nВы можете указать, разрешено ли пользователям включать режим разработчика на странице chrome://extensions.\n\nЕсли правило не настроено, пользователи могут включать этот режим на странице расширений при условии, что для правила DeveloperToolsAvailability не установлено значение 2 (DeveloperToolsDisallowed).\nЕсли указано значение 0 (Allow), пользователям разрешено включать режим разработчика на странице расширений.\nЕсли задано значение 1 (Disallow), это запрещено.\n\nКогда правило настроено, DeveloperToolsAvailability не управляет режимом разработчика в расширениях.\n\nЭто правило применяется только на платформах, которые поддерживают расширения.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Настроить список источников, которые продлевают время работы подключаемых расширений в фоновом режиме";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "Расширения, подключаемые к одному из этих источников будут работать, пока подключен порт.\n\nЕсли правило не настроено, будет использоваться его значение по умолчанию. Ниже приведены источники с SDK, которые не позволяют восстановить закрытое подключение с предыдущим состоянием.\n– Smart Card Connector.\n– Citrix Receiver (бета, стабильная и резервная версии).\n– VMware Horizon (стабильная версия и бета).\n\nЕсли правило настроено, перечень по умолчанию будет дополнен указанными значениями. Как значения по умолчанию, так и заданные в правиле будут предоставлять исключение подключаемым расширениям, пока подключен порт.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Разрешить расширения, которые установлены правилами и переопределяют настройки страницы быстрого доступа или поисковой системы по умолчанию";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Определяет, разрешено ли использовать в малонадежных средах расширения, которые устанавливаются правилами принудительно или в качестве рекомендации и переопределяют настройки страницы быстрого доступа или поисковой системы по умолчанию.\n\nПравило применяется только к малонадежным средам (например, к устройствам, на которых правила настроены локально и не управляются через домен или облако). Это не относится к высоконадежным средам.\n\nВ Microsoft® Windows® правило недоступно на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в Chrome Enterprise Core.\n\nВ macOS правило недоступно на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в Chrome Enterprise Core.\n\nВ этих высоконадежных средах расширения, которые устанавливаются правилами и переопределяют настройки страницы быстрого доступа или поисковой системы по умолчанию, останутся включенными.\n\nЕсли правило включено, Brave разрешает правилам устанавливать в малонадежных средах расширения, которые переопределяют настройки страницы быстрого доступа или поисковой системы по умолчанию, а также использовать такие расширения, если они были установлены ранее.\n\nЕсли правило отключено или не настроено, Brave запрещает правилам устанавливать в малонадежных средах расширения, которые переопределяют настройки страницы быстрого доступа или поисковой системы по умолчанию, а также удаляет такие расширения, если они были установлены ранее.\n\nЕсли такое расширение перестанет переопределять эти настройки, Brave автоматически установит его в течение семи дней.\n\nЭто временное правило, которое будет удалено в одной из следующих версий.";
ExtensionInstallAllowlist.pfm_title = "Идентификаторы расширений, исключаемых из списка блокировки";
ExtensionInstallAllowlist.pfm_description = "Это правило позволяет указать исключения из списка запрещенных расширений.\n\nЕсли задано значение *, все расширения блокируются и пользователи могут устанавливать только расширения из белого списка.\n\nПо умолчанию все расширения разрешены. Если вы запретили расширения при помощи правила, его настройки можно изменить, используя список разрешенных расширений.\n\nЭто правило применяется только на платформах, которые поддерживают расширения.";
ExtensionInstallBlocklist.pfm_title = "Идентификаторы расширений, которые запрещено устанавливать пользователям (\"*\" запрещает установку всех расширений)";
ExtensionInstallBlocklist.pfm_description = "Правило позволяет указать, какие расширения запрещено устанавливать пользователям. Если вы заблокируете ранее установленное расширение, оно будет отключено. Пользователь не сможет включить его. После разблокировки расширение включится автоматически.\n\nСимвол звездочки (*) в черном списке означает, что все расширения заблокированы по умолчанию. Расширения в белом списке считаются разрешенными, если они подписаны (упакованы). Все распакованные расширения блокируются.\n\nЕсли правило не настроено, пользователь может устанавливать в Brave любые расширения.\n\nЭто правило применяется только на платформах, которые поддерживают расширения.";
ExtensionInstallForcelist.pfm_title = "Устанавливать идентификаторы расширений/приложений и URL обновлений без подтверждения пользователя";
ExtensionInstallForcelist.pfm_description = "Это правило позволяет указать список приложений и расширений, которые устанавливаются без участия пользователя и которые нельзя удалить или отключить через интерфейс Brave. Разрешения, в том числе для двух API расширений – enterprise.deviceAttributes и enterprise.platformKeys, предоставляются неявным образом. Эти API доступны только для приложений или расширений, устанавливаемых принудительно.\n\nХотя мы стараемся предотвращать удаление этих расширений из Brave, некоторые операционные системы не позволяют Brave обеспечивать стопроцентную защиту от стороннего вмешательства в работу расширений.\n\nЕсли правило не настроено, приложения и расширения не устанавливаются автоматически и пользователи могут удалять любые приложения и расширения из Brave.\n\nЭто правило имеет приоритет над правилом ExtensionInstallBlocklist. Если из списка убрать принудительно установленное приложение или расширение, оно будет автоматически удалено из Brave.\n\nИнструменты разработчика позволяют пользователям изменять код расширений, что может приводить к сбоям. Чтобы избегать таких ситуаций, используйте правило DeveloperToolsDisabled.\n\nВ каждой строке, задаваемой в правиле, указывается идентификатор расширения и может содержаться URL обновления, отделенный точкой с запятой (;). Идентификатор расширения – это строка из 32 символов, которую можно найти, например, на странице chrome://extensions, открыв ее в режиме разработчика. URL обновления (если он присутствует) должен указывать на манифест обновления в формате XML (https://developer.chrome.com/extensions/autoupdate), а также содержать одну из следующих схем: http, https или file. По умолчанию используется URL обновления интернет-магазина Chrome. Приведенный в этом правиле URL обновления используется только во время первоначальной установки. В дальнейшем применяется URL, указанный в манифесте расширения. URL для последующих обновлений можно переопределить в правиле ExtensionSettings. Подробнее: http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy.\n\nВ Microsoft® Windows® приложения и расширения не из интернет-магазина Chrome можно принудительно устанавливать только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе Chrome Enterprise Core.\n\nВ macOS приложения и расширения не из интернет-магазина Chrome можно принудительно устанавливать только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе Chrome Enterprise Core.\n\nОбратите внимание, что это правило не действует в режиме инкогнито. Чтобы ознакомиться с информацией о хостинге расширений, посетите страницу https://developer.chrome.com/extensions/hosting.\n\nЭто правило применяется только на платформах, которые поддерживают расширения.";
ExtensionInstallSources.pfm_title = "Шаблоны URL, с которых разрешается установка расширений, приложений и пользовательских скриптов";
ExtensionInstallSources.pfm_description = "Правило позволяет указать URL страниц, с которых разрешено устанавливать расширения, приложения и темы. До выпуска Brave 21 пользователю достаточно было перейти по ссылке на файл CRX и пропустить несколько предупреждений Brave. Теперь такие файлы нужно скачивать и перетаскивать на страницу настроек Brave. Это правило позволяет указать, с каких URL разрешена прежняя, более простая процедура установки.\n\nКаждый пункт списка представляет собой шаблон для сопоставления. Подробнее: https://developer.chrome.com/extensions/match_patterns. Если URL соответствует указанному шаблону, файлы устанавливаются по упрощенной схеме. Как место расположения CRX-файла, так и страница, с которой выполняется скачивание (то есть URL перехода), должны быть успешно сопоставлены с шаблонами.\n\nПравило ExtensionInstallBlocklist имеет приоритет над этим правилом. Это означает, что расширение из черного списка нельзя установить даже с сайта, адрес которого соответствует шаблону.\n\nЭто правило применяется только на платформах, которые поддерживают расширения.";
ExtensionInstallTypeBlocklist.pfm_title = "Список запрещенных способов установки расширений";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Запретить загрузку расширений из командной строки\nВ черном списке указываются запрещенные способы установки расширений.\n\nЕсли для правила задано значение command_line, расширения нельзя загружать из командной строки.";
ExtensionReviewPromptsEnabled.pfm_title = "Управление предложениями оставить отзыв и ссылками на оценку расширений";
ExtensionReviewPromptsEnabled.pfm_description = "Определяет, доступны ли в интерфейсах Chrome встроенные предложения оставить отзыв и ссылки на оценку (например, \"Оценить\") для установленных расширений Chrome.\n\nЕсли это правило включено или не задано, пользователи могут видеть встроенные элементы интерфейса для оценки и написания отзывов о поддерживаемых расширениях в контекстных меню, на панели инструментов и странице управления расширениями (chrome://extensions).\n\nЕсли правило отключено, все встроенные предложения оставить отзыв и ссылки на оценку будут скрыты и недоступны.";
ExtensionSettings.pfm_title = "Позволяет управлять расширениями";
ExtensionSettings.pfm_description = "Это правило контролирует настройки управления расширениями в Brave, включая те, которые заданы другими правилами.\n\nПравило привязывает идентификатор расширения или URL обновления только к одному конкретному параметру. Настройки по умолчанию можно указать с помощью идентификатора \"*\", и они будут применяться ко всем расширениям, для которых в правиле не задана отдельная конфигурация.\n\nЭто правило может переопределять настройки отдельных расширений из ранее действовавших правил.\n\nОбратите внимание, что во всех настройках отдельных расширений из правила ExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist или ExtensionSettings наследуются только значения installation_mode и update_url из конфигурации по умолчанию (\"*\"). Другие свойства не наследуются. Если указан URL обновления, заданная конфигурация применяется ко всем расширениям, в манифесте которых приведен этот URL (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy). Если для параметра override_update_url выбрано значение True, расширение устанавливается и обновляется с использованием URL обновления, указанного в поле update_url этого правила или в правиле ExtensionInstallForcelist. Параметр override_update_url игнорируется, если в поле update_url указан URL интернет-магазина Chrome.\n\nВ версии Brave 154 и последующих применение параметра runtime_blocked_hosts к расширению с разрешением debugger отключает метод chrome.debugger.attach() для всех целевых объектов.\n\nПриложения и расширения не из интернет-магазина Chrome можно устанавливать принудительно только на устройствах с Microsoft® Windows®, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе Chrome Enterprise Core.\n\nВ macOS приложения и расширения не из интернет-магазина Chrome можно принудительно устанавливать только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе Chrome Enterprise Core.\n\nОбратите внимание, что это правило применяется только на платформах, которые поддерживают расширения.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=ExtensionSettings.";
ExtensionUnpublishedAvailability.pfm_title = "Контролировать доступность расширений, публикация которых отменена в интернет-магазине Chrome";
ExtensionUnpublishedAvailability.pfm_description = "0 - Разрешить работу расширений с отмененной публикацией\n1 - Отключить расширения с отмененной публикацией\nЕсли правило включено, в Brave будут отключены расширения, публикация которых отменена в интернет-магазине Chrome.\nЭто правило действует только для расширений, которые установлены и обновляются через интернет-магазин Chrome.\n\nРасширения, которые не представлены в этом магазине, например распакованные и установленные в режиме разработчика или установленные с помощью параметра командной строки, игнорируются.\nПринудительно установленные автономные расширения и расширения, чья версия была закреплена, также игнорируются.\n\nЕсли правило не настроено или для него задано значение AllowUnpublished (0), расширения, публикация которых отменена в интернет-магазине Chrome, можно использовать.\nЕсли для правила задано значение DisableUnpublished (1), расширения, публикация которых отменена в интернет-магазине Chrome, будут отключены.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Показывать флажок \"Запомнить мой выбор для этого типа ссылок\" в диалоговом окне внешнего протокола";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Это правило определяет, будет ли отображаться флажок \"Запомнить мой выбор для этого типа ссылок\" в запросах о подтверждении запуска внешнего протокола.\n\n     Если правило не настроено или для него указано значение True, в окне подтверждения запуска внешнего протокола пользователь может установить флажок \"Запомнить мой выбор для этого типа ссылок\", чтобы в дальнейшем запускать протокол на этом сайте без запроса.\n\n     Если задано значение False, флажка \"Запомнить мой выбор для этого типа ссылок\" нет и пользователю необходимо каждый раз подтверждать вызов внешнего протокола.";
FeedbackSurveysEnabled.pfm_title = "Определяет, получают ли пользователи приглашения к участию в опросах при работе в Brave";
FeedbackSurveysEnabled.pfm_description = "В опросах пользователей Brave собираются отзывы о работе в выбранном браузере. Ответы не связаны с аккаунтами пользователей.\nЕсли правило включено или не настроено, пользователи могут получать приглашения к участию в опросах при работе с браузером.\nЕсли правило отключено, пользователи не получают такие приглашения.\n\nЭто правило не действует, если отключено правило MetricsReportingEnabled. При этом также отключены опросы в браузере.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Извлекать длительность сообщений keepalive при закрытии";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Управляет длительностью запросов keepalive при закрытии браузера (в секундах).\n\nПри заданных условиях закрытие браузера может быть заблокировано на несколько секунд для обработки запросов keepalive (https://fetch.spec.whatwg.org/#request-keepalive-flag).\n\nЕсли выбрано значение по умолчанию (0), функция отключена.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Разрешить вызов методов API для выбора файла или каталога без предварительного жеста пользователя";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "В целях безопасности для вызова методов showOpenFilePicker(), showSaveFilePicker() и showDirectoryPicker() веб-API пользователю нужно выполнить действия из категории \"Временная активация\" (transient activation).\n\nЕсли правило настроено, администраторы могут указывать источники, для которых разрешено вызывать эти методы API без предварительного действия.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns/. В правиле нельзя использовать подстановочный знак (*).\n\nЕсли оно не настроено, для вызова этих методов API пользователю нужно будет выполнить действие, независимо от источника.";
FileSystemReadAskForUrls.pfm_title = "Разрешить на этих сайтах доступ для чтения через File System API";
FileSystemReadAskForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым разрешено запрашивать у пользователей право на чтение файлов или каталогов в файловой системе хоста через File System API.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultFileSystemReadGuardSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nШаблоны URL не должны противоречить шаблонам в правиле FileSystemReadBlockedForUrls. Если URL совпадает с шаблонами в обоих правилах, ни одно из них не имеет приоритета.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается.";
FileSystemReadBlockedForUrls.pfm_title = "Блокировать на этих сайтах доступ для чтения через File System API";
FileSystemReadBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым запрещено запрашивать у пользователей право на чтение файлов или каталогов в файловой системе хоста через File System API.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultFileSystemReadGuardSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nШаблоны URL не должны противоречить шаблонам в правиле FileSystemReadAskForUrls. Если URL совпадает с шаблонами в обоих правилах, ни одно из них не имеет приоритета.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается.";
FileSystemWriteAskForUrls.pfm_title = "Разрешить на этих сайтах доступ для записи к файлам и каталогам";
FileSystemWriteAskForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым разрешено запрашивать у пользователей право на запись файлов или каталогов в файловой системе хоста.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultFileSystemWriteGuardSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nШаблоны URL не должны противоречить шаблонам в правиле FileSystemWriteBlockedForUrls. Если URL совпадает с шаблонами в обоих правилах, ни одно из них не имеет приоритета.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается.";
FileSystemWriteBlockedForUrls.pfm_title = "Блокировать на этих сайтах доступ для записи к файлам и каталогам";
FileSystemWriteBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым запрещено запрашивать у пользователей право на запись файлов или каталогов в файловой системе хоста.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultFileSystemWriteGuardSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nШаблоны URL не должны противоречить шаблонам в правиле FileSystemWriteAskForUrls. Если URL совпадает с шаблонами в обоих правилах, ни одно из них не имеет приоритета.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается.";
ForceEphemeralProfiles.pfm_title = "Временный профиль";
ForceEphemeralProfiles.pfm_description = "Это правило делает профиль временным. Если правило настроено в операционной системе, например как объект групповой политики Windows, его действие распространяется на все профили устройства. Если правило является облачным, оно применяется только к профилю, в который пользователь входит с помощью управляемого аккаунта.\n\nВ этом режиме данные профиля сохраняются на диске только в течение сеанса. После того как браузер будет закрыт, история просмотра, расширения и их данные, а также файлы cookie, базы данных и другие данные сайтов будут удалены. Это не помешает пользователю вручную скачивать файлы на диск, сохранять веб-страницы и распечатывать их.\n\nЕсли пользователь включит синхронизацию, все данные будут сохраняться в синхронизируемом профиле, как обычно. Режим инкогнито также будет доступен, если правило его не запрещает.\n\nКогда это правило отключено или не настроено, используется обычный профиль.";
ForceForegroundPriorityForAllTabs.pfm_title = "Принудительно установить приоритет активного режима для всех вкладок";
ForceForegroundPriorityForAllTabs.pfm_description = "Правило определяет, будет ли фоновый веб-контент принудительно выполняться в активном режиме.\n\nПо умолчанию браузер оптимизирует ресурсы, понижая приоритет контента на фоновых вкладках. Если правило включено, фоновые вкладки будут обрабатываться так же, как активные.\n\nОбратите внимание, что принудительное выполнение фонового контента в активном режиме может незначительно замедлить отклик активной вкладки.\n\nЕсли правило включено, весь веб-контент выполняется в активном режиме независимо от того, виден он или нет.\n\nЕсли правило отключено или не настроено, браузер определяет приоритет на основе стандартных эвристических алгоритмов (например, понижает приоритет контента, который не виден, в котором не воспроизводится аудио или не ведется видеовызов и т. д.).";
ForceForegroundPriorityForUrls.pfm_title = "Принудительно установить приоритет активного режима для определенных URL";
ForceForegroundPriorityForUrls.pfm_description = "Правило позволяет указать список шаблонов URL. Фоновый веб-контент, соответствующий этим шаблонам, будет принудительно выполняться в активном режиме.\n\nЕсли правило ForceForegroundPriorityForAllTabs включено, этот список игнорируется, поскольку все вкладки принудительно выполняются в активном режиме.\n\nЕсли правило ForceForegroundPriorityForAllTabs отключено или не настроено, принудительно будет выполняться только контент, соответствующий шаблонам из этого списка.\n\nПодробнее о допустимых шаблонах URL: https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nЕсли список пуст или не настроен, фоновый контент не выполняется в активном режиме.";
ForceGoogleSafeSearch.pfm_title = "Позволяет принудительно включить Безопасный поиск Google";
ForceGoogleSafeSearch.pfm_description = "Если это правило включено, то запросы в Google Поиске всегда будут выполняться с применением Безопасного поиска, и пользователи не смогут менять эту настройку.\n\nЕсли правило отключено или не настроено, Безопасный поиск в Google Поиске не будет применяться в обязательном порядке.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "Разрешить или запретить отключение обработчиков события unload";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "Поддержка обработчиков событий unload прекращается. Чтобы их использовать, нужно настроить заголовок Permissions-Policy для события unload. Сейчас эти обработчики по умолчанию разрешены, но в будущем постепенно станут запрещены. Чтобы включить их на сайте, потребуется использовать заголовки Permissions-Policy. Однако с помощью этого корпоративного правила обработчики можно оставить включенными по умолчанию.\n\nОбработчики событий unload позволяют сохранять данные на страницах и сообщать серверу об окончании сеанса пользователя. Однако использовать такие обработчики не рекомендуется, так как они ненадежны и снижают производительность сайтов, блокируя BackForwardCache. Существуют более подходящие варианты, но событие unload используется уже давно и до сих пор встречается в некоторых приложениях.\n\nЕсли правило не настроено или для него задано значение False, поддержка обработчиков событий unload будет постепенно прекращена. На сайтах, где не настроен заголовок Permissions-Policy, события unload перестанут использоваться.\n\nЕсли для правила задано значение True, то обработчики событий unload продолжат работать по умолчанию.\n\nПримечание. В этом правиле было ошибочно указано значение True в качестве параметра по умолчанию для версии M117. Событие unload не менялось и не будет меняться в M117, поэтому правило не действует в этой версии.\n";
ForceYouTubeRestrict.pfm_title = "Принудительно включать минимальный уровень Безопасного режима для YouTube";
ForceYouTubeRestrict.pfm_description = "0 - Отключить обязательное использование Безопасного режима дляYouTube\n1 - Включить принудительное использование Безопасного режима для YouTube на уровне не ниже умеренного\n2 - Включить принудительное использование строгого Безопасного режима для YouTube\nЭто правило устанавливает минимальный уровень Безопасного режима для YouTube, который пользователи не могут снизить. Если выбрано значение \"Строгий\", для YouTube всегда будет использоваться строгий Безопасный режим.\n\nЕсли выбрано значение \"Умеренный\", пользователь может выбрать умеренный или строгий Безопасный режим для YouTube, но не может отключить его.\n\nЕсли параметр отключен или значение для него не задано, то Chrome не будет использовать Безопасный режим для YouTube. Однако Безопасный режим может применяться в соответствии с внешними правилами (например, правилами YouTube).";
ForcedLanguages.pfm_title = "Настройка языковых предпочтений";
ForcedLanguages.pfm_description = "С помощью этого правила администраторы могут определять порядок предпочтительных языков в настройках Brave.\n\nНужный порядок будет установлен в разделе \"Расположите языки, исходя из своих предпочтений\" на странице chrome://settings/languages. В соответствии с правилом пользователи не смогут удалять языки или менять их порядок, но будут иметь возможность добавлять новые в конец списка. При отсутствии других правил пользователи также смогут изменять язык интерфейса браузера, настраивать перевод и проверку правописания.\n\nЕсли правило не настроено, пользователи могут сами определять языковые предпочтения.";
GeminiActOnWebAllowedForURLs.pfm_title = "Разрешить интеграциям приложения Gemini напрямую действовать на указанных сайтах";
GeminiActOnWebAllowedForURLs.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, на веб-страницах которых интеграции приложения Gemini могут действовать напрямую.\n\nДля URL, не соответствующих ни белому, ни черному списку, используется правило GeminiActOnWebSettings.\n\nЕсли URL входит в оба списка, он считается разрешенным.\n\nСведения о допустимых шаблонах URL доступны на странице https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebBlockedForURLs.pfm_title = "Запретить интеграциям приложения Gemini напрямую действовать на указанных сайтах";
GeminiActOnWebBlockedForURLs.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, на веб-страницах которых интеграции приложения Gemini не могут действовать напрямую.\n\nДля URL, не соответствующих ни белому, ни черному списку, используется правило GeminiActOnWebSettings.\n\nЕсли URL входит в оба списка, он считается разрешенным.\n\nСведения о допустимых шаблонах URL доступны на странице https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebSettings.pfm_title = "Разрешить интеграциям приложения Gemini напрямую действовать на веб-страницах";
GeminiActOnWebSettings.pfm_description = "0 - Разрешить приложению Gemini выполнять действия на веб-страницах\n1 - Запретить приложению Gemini выполнять действия на веб-страницах\nПозволяет указать, может ли приложение Gemini выполнять действия на веб-страницах от лица пользователя.\n\nЕсли правило не настроено или выбрано значение 0, приложению Gemini разрешено выполнять действия на веб-страницах.\n\nЕсли установлено значение 1, приложение Gemini не может выполнять действия на них.\n\nЭто правило не работает, если приложение Gemini отключено, например правилом GeminiSettings.\n\nПодробнее о Gemini в Chrome: https://support.google.com/chrome/a/answer/16291696.\n\nGemini доступен не во всех странах и не на всех языках. Если правило настроено, это не гарантирует, что функция будет работать. Она может быть недоступна. Подробную информацию о развертывании можно найти в примечаниях к выпуску Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=ru.";
GeminiSettings.pfm_title = "Настройки интеграции с приложением Gemini";
GeminiSettings.pfm_description = "0 - Разрешить интеграцию приложения Gemini\n1 - Запретить интеграцию приложения Gemini\nПравило определяет, разрешена ли интеграция приложения Gemini.\n\nЕсли задано значение \"0\", интеграция приложения Gemini доступна пользователям.\n\nЕсли установлено значение \"1\", интеграция недоступна.\n\nЕсли правило не настроено, применяется правило GenAiDefaultSettings.\n\nДополнительную информацию можно найти в статье Справочного центра: https://support.google.com/chrome/a?p=gemini_in_chrome.";
GeminiSparkSettings.pfm_title = "Разрешает Gemini Spark подключаться к Brave и использовать автонавигацию с помощью Gemini в Chrome";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark разрешено подключаться к автонавигации в Brave и использовать ее.\n1 - Gemini Spark запрещено подключаться к автонавигации в Brave и использовать ее\nНастройки определяют, разрешено ли агенту Gemini Spark подключаться к Brave и использовать автонавигацию. Gemini Spark может быть недоступен в вашей организации.\n\n0 — Gemini Spark разрешено подключаться к Brave и использовать автонавигацию\n\n1 — Gemini Spark запрещено подключаться к Brave и использовать автонавигацию\n\nВнимание! Если разрешить Gemini Spark подключаться к Brave и использовать автонавигацию, агент Gemini Spark сможет выполнять автономные многоэтапные действия в Brave, когда браузер запущен. При этом возможны утечка учетных данных, несанкционированный доступ к локальной сети, потеря контекстных сигналов и другие серьезные угрозы безопасности. Существующие настройки управления и безопасности могут не поддерживаться.\n\nПрежде чем включить эту функцию, рекомендуем администраторам внимательно изучить модель угроз сети организации, правила соответствия и конфиденциальности.\n\nЭто правило не действует, если приложение Google Gemini или правила автонавигации в Brave отключены. Например, правилом GeminiSettings можно отключить приложение Google Gemini. Подробнее о Google Gemini в Brave: https://support.google.com/chrome/a?p=gemini_in_chrome.\n\nGemini Spark и автонавигация в Brave доступны не во всех странах и не на всех языках. Если правило включено (значение \"0\"), это не гарантирует, что функция будет работать. Она может быть недоступна. Подробную информацию о запуске вы найдете в примечаниях к выпуску Enterprise: https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Настройки локальной базовой модели генеративного искусственного интеллекта";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Автоматически скачивать модели\n1 - Не скачивать модель\nПравило определяет, как Brave скачивает базовую модель генеративного искусственного интеллекта и локально использует ее для инференса.\n\nЕсли правило не настроено или для него указано значение Allowed (0), модель автоматически скачивается и используется.\n\nЕсли задано значение Disabled (1), новая модель не скачивается, а существующая (если есть) удаляется.\n\nОтключить скачивание модели на ПК также можно, установив для правила ComponentUpdatesEnabled значение false.";
GeolocationBlockedForUrls.pfm_title = "Блокировать доступ к геоданным на этих сайтах";
GeolocationBlockedForUrls.pfm_description = "Правило позволяет задать список шаблонов URL для указания сайтов, которым запрещено получать доступ к геоданным пользователя и запрашивать у него разрешение на это.\n\nЕсли правило не настроено, для всех сайтов применяется правило DefaultGeolocationSetting при условии, что оно задано. В противном случае действуют персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Допустимы подстановочные знаки (*).";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "Включить глобальное применение кеша авторизации HTTP";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Это правило устанавливает единый глобальный кеш для каждого профиля с учетными данными для аутентификации на HTTP-серверах.\n\nЕсли правило не настроено или отключено, браузер использует стандартное поведение для аутентификации при переходе между сайтами. Это означает, что область применения учетных данных для аутентификации на HTTP-сервере будет определяться по сайту верхнего уровня. Таким образом, если два сайта используют ресурсы из одного домена с аутентификацией, учетные данные необходимо предоставить независимо друг от друга в контексте обоих сайтов. Кешированные учетные данные прокси-сервера будут повторно использоваться на разных сайтах.\n\nЕсли правило включено, учетные данные для HTTP-аутентификации, введенные в контексте одного сайта, будут автоматически использоваться в контексте других сайтов.\n\nПри использовании этого правила в URL вставляются учетные данные для добавления записи в кеш аутентификации HTTP. Это делает сайты более уязвимыми для межсайтовых атак и дает возможность отслеживать переходы пользователей между сайтами без использования файлов cookie.\n\nЭто правило дает компаниям, использующим устаревшие механизмы, возможность обновить процедуру входа, но будет удалено в будущем.";
GoogleSearchSidePanelEnabled.pfm_title = "Google Search Side Panel: включить";
GoogleSearchSidePanelEnabled.pfm_description = "Если правило включено или не настроено, Google Search Side Panel будет работать на любых веб-страницах.\n\nЕсли оно отключено, Google Search Side Panel не поддерживается на веб-страницах.\n\nФункции на основе генеративного ИИ на этой панели недоступны для учебных и корпоративных аккаунтов.";
HSTSPolicyBypassList.pfm_title = "Имена хостов, для которых не нужно проверять использование механизма HSTS";
HSTSPolicyBypassList.pfm_description = "Правило позволяет указать список имен хостов, которые будут обходить изменения протокола http на https для сайтов из предварительно загружаемого списка HSTS.\n\nВ списке правила могут быть только одноуровневые имена. Само правило применяется к \"статичным\" предзагрузкам HSTS (например, \"app\", \"new\", \"search\", \"play\"). Правило не может предотвратить преобразования с помощью HSTS для серверов, запросивших их с помощью заголовка ответа Strict-Transport-Security.\n\nИмена хостов необходимо нормализовать: доменные имена, содержащие символы национальных алфавитов, нужно преобразовать в формат А-метки, а буквы из таблицы ASCII сделать строчными. Это правило действует только для одноуровневых имен хостов, указанных в списке. На субдомены оно не распространяется.";
HappyEyeballsV3Enabled.pfm_title = "Использование алгоритма Happy Eyeballs V3";
HappyEyeballsV3Enabled.pfm_description = "Это правило определяет, используется ли алгоритм Happy Eyeballs V3 при попытках установить связь. Более подробную информацию см. на странице https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3.\n\nЕсли правило включено, при попытках установить связь Brave использует алгоритм Happy Eyeballs V3.\n\nЕсли правило отключено, алгоритм Happy Eyeballs V3 не используется.\n\nЕсли правило не настроено, Brave использует алгоритм Happy Eyeballs V3 в соответствии со значением экспериментального параметра chrome://flags/#happy-eyeballs-v3.\n\nЭто правило поддерживает динамическое обновление.\n\nВ следующих версиях Brave правило будет удалено.";
HardwareAccelerationModeEnabled.pfm_title = "Использовать аппаратное ускорение графики, если оно доступно";
HardwareAccelerationModeEnabled.pfm_description = "Если правило включено или не настроено, на устройстве используется аппаратное ускорение графики, если оно доступно.\n\nЕсли правило отключено, аппаратное ускорение графики не применяется.";
HeadlessMode.pfm_title = "Управление использованием режима консольного браузера";
HeadlessMode.pfm_description = "1 - Разрешить использование режима консольного браузера\n2 - Запретить использование режима консольного браузера\nЕсли выбрано значение Enabled или правило не настроено, использовать режим консольного браузера будет разрешено. Если выбрано значение Disabled, использовать режим консольного браузера будет запрещено.";
HelpMeWriteSettings.pfm_title = "Настройки генератора текстов";
HelpMeWriteSettings.pfm_description = "0 - Разрешить использовать функцию \"Генератор текстов\" с улучшением ИИ-моделей\n1 - Разрешить использовать функцию \"Генератор текстов\" без улучшения ИИ-моделей\n2 - Не разрешать использовать функцию \"Генератор текстов\"\nГенератор текстов – инструмент на основе ИИ, который помогает создавать короткий текстовый контент для интернет-ресурсов. Ответы генерируются на основе запросов пользователя и содержимого веб-страниц.\n\nЕсли установлено значение \"0\", функцией можно пользоваться и Google разрешается улучшать свои ИИ-модели с помощью определенных данных. Это могут быть запросы, входные и выходные данные, а также исходные материалы и отзывы, в зависимости от функции. Для улучшения ИИ-моделей эти данные также могут проверяться специалистами. Значение \"0\" используется по умолчанию, за исключением описанных ниже случаев.\n\nЕсли установлено значение \"1\", функцией можно пользоваться, но Google запрещается улучшать ИИ-модели с помощью контента пользователей, в том числе запросов, входных и выходных данных, исходных материалов и отзывов. Это значение используется по умолчанию для корпоративных и учебных аккаунтов, управляемых через Google Admin console и Google Workspace.\n\nЕсли установлено значение \"2\", функцией нельзя пользоваться.\n\nЕсли правило не настроено, применяется правило GenAiDefaultSettings.\n\nПодробнее о том, как обрабатываются данные при использовании функций на основе генеративного ИИ: https://support.google.com/chrome/a?p=generative_ai_settings.";
HideWebStoreIcon.pfm_title = "Удалить интернет-магазин со страницы быстрого доступа и панели запуска приложений";
HideWebStoreIcon.pfm_description = "Удаляет приложение из Интернет-магазина Chrome и ссылку на него со страницы быстрого доступа и с панели запуска приложений Google Chrome OS.\n\nЕсли для правила задано значение \"true\", значки приложений будут скрыты.\n\nЕсли задано значение \"false\" или значение не задано, значки будут отображаться.";
HighEfficiencyModeEnabled.pfm_title = "Включить режим высокой эффективности";
HighEfficiencyModeEnabled.pfm_description = "Правило позволяет включать или отключать режим высокой эффективности. Он помогает освободить память, закрывая вкладки, которые некоторое время оставались неактивными.\nЕсли правило не настроено, конечный пользователь может включать или отключать этот режим на странице chrome://settings/performance.\n";
HistoryClustersVisible.pfm_title = "Показывать историю Chrome, объединяя страницы в группы";
HistoryClustersVisible.pfm_description = "Это правило определяет, доступна ли история Chrome с распределением по группам.\n\nЕсли правило включено, историю Chrome, разделенную на группы, можно найти на странице chrome://history/grouped.\n\nЕсли правило отключено, то на странице chrome://history/grouped такая история Chrome недоступна.\n\nЕсли правило не настроено, история Chrome с распределением по группам размещается на странице chrome://history/grouped по умолчанию.\n\nВнимание! Если правило ComponentUpdatesEnabled отключено, а правило HistoryClustersVisible включено или не настроено, история Chrome, разделенная на группы, доступна на странице chrome://history/grouped, но может быть менее релевантной для пользователя.\n";
HistorySearchSettings.pfm_title = "Настройки поиска в истории с помощью ИИ";
HistorySearchSettings.pfm_description = "0 - Разрешить использовать функцию \"Поиск в истории браузера с помощью ИИ\" с улучшением ИИ-моделей\n1 - Разрешить использовать функцию \"Поиск в истории браузера с помощью ИИ\" без улучшения ИИ-моделей\n2 - Не разрешать использовать функцию \"Поиск в истории браузера с помощью ИИ\"\nПоиск в истории браузера с помощью ИИ позволяет находить страницы на основе не только их заголовков и URL, но и содержимого.\n\nЕсли установлено значение \"0\", функцией можно пользоваться и Google разрешается улучшать свои ИИ-модели с помощью определенных данных. Это могут быть запросы, входные и выходные данные, а также исходные материалы и отзывы, в зависимости от функции. Для улучшения ИИ-моделей эти данные также могут проверяться специалистами. Значение \"0\" используется по умолчанию, за исключением описанных ниже случаев.\n\nЕсли установлено значение \"1\", функцией можно пользоваться, но Google запрещается улучшать ИИ-модели с помощью контента пользователей, в том числе запросов, входных и выходных данных, исходных материалов и отзывов. Это значение используется по умолчанию для корпоративных и учебных аккаунтов, управляемых через Google Admin console и Google Workspace.\n\nЕсли установлено значение \"2\", функцией нельзя пользоваться.\n\nЕсли правило не настроено, применяется правило GenAiDefaultSettings.\n\nПодробнее о том, как обрабатываются данные при использовании функций на основе генеративного ИИ: https://support.google.com/chrome/a?p=generative_ai_settings.";
HomepageIsNewTabPage.pfm_title = "Сделать страницу быстрого доступа главной";
HomepageIsNewTabPage.pfm_description = "Если правило включено, в качестве главной страницы используется страница быстрого доступа. Заданный URL главной страницы игнорируется. Если правило отключено, страница быстрого доступа открывается, только когда в качестве URL главной страницы указан путь chrome://newtab.\n\nЕсли правило настроено, пользователи не могут изменить этот параметр в Brave. Если правило не настроено, они смогут выбрать, устанавливать ли страницу быстрого доступа в качестве главной.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе \"Chrome Enterprise Core\".";
HomepageLocation.pfm_title = "URL главной страницы";
HomepageLocation.pfm_description = "Если правило настроено, то в браузере Brave задан URL главной страницы по умолчанию. Открыть ее можно, нажав кнопку \"Главная страница\". На компьютере страницы, открывающиеся при запуске браузера, определяются правилом RestoreOnStartup.\n\nОднако оно не будет работать, если пользователем или правилом HomepageIsNewTabPage в качестве главной страницы задана страница быстрого доступа.\n\nURL должен иметь стандартный вид (например, http://example.com или https://example.com). Если правило настроено, пользователи не смогут изменить главную страницу в Brave.\n\nЕсли правила HomepageLocation и HomepageIsNewTabPage не настроены, пользователи сами смогут выбрать главную страницу.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе \"Chrome Enterprise Core\".";
HttpAllowlist.pfm_title = "Список разрешенных HTTP";
HttpAllowlist.pfm_description = "В этом правиле можно задать список имен хостов или их шаблонов (например, \"[*.]example.com\"), для которых не будет использоваться протокол HTTPS. Для них также не будет показываться промежуточная страница с ошибкой, если включен режим HTTPS-First. Организации могут использовать это правило, чтобы сохранить доступ к серверам, которые не поддерживают HTTPS. При этом не нужно отключать принудительное использование протокола HTTPS и режим HTTPS-First.\n\nИмена хостов необходимо нормализовать: доменные имена, содержащие символы национальных алфавитов, нужно преобразовать в формат А-метки, а буквы из таблицы ASCII сделать строчными.\n\nЗапрещено использовать подстановочные знаки (например, \"*\" или \"[*]\") для создания массовых исключений. Вместо этого явно отключите режим HTTPS-First и принудительное использование протокола HTTPS с помощью подходящих правил.\n\nПримечание. Это правило не распространяется на принудительное использование протокола HSTS.";
HttpHeaderInjection.pfm_title = "Настроить вставку HTTP-заголовков для определенных шаблонов URL";
HttpHeaderInjection.pfm_description = "Это правило позволяет определить список условий для вставки специальных HTTP-заголовков в веб-запросы, соответствующие определенным шаблонам URL. Заголовки, заданные этим правилом, имеют приоритет над заголовками, которые изначально присутствовали в запросе, а также над изменениями, которые пытаются сделать пользователи или расширения.\n\nОбычно это правило используется, чтобы принудительно установить настройки доступа к клиенту, добавив собственные заголовки, например X-Tenant-ID.\n\nПравило принимает список условий. Каждое условие содержит:\n\n* patterns — список шаблонов URL для сопоставления. О формате шаблонов URL см. здесь: https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\n* headers — список объектов, представляющих заголовки для вставки. Каждый объект содержит:\n\n* name — название заголовка.\n\n* value — значение заголовка.\n\nЕсли запросу соответствуют несколько условий, будут применены заголовки из всех них. Если есть несколько заголовков с одинаковым названием, будет применен тот, который соответствует наиболее точному шаблону URL. Если подходящие шаблоны одинаково точные, применяется тот, который указан в списке последним.\n\nНазвания заголовков должны соответствовать стандарту RFC 2616 (https://www.rfc-editor.org/rfc/rfc2616), а значения не должны содержать символы NUL, CR или LF. Размер каждого заголовка не должен превышать 8 КБ. Недействительные заголовки и шаблоны URL будут игнорироваться.\n\nЭто правило позволяет указать не более 500 шаблонов URL для всех условий. Каждое условие может содержать не более 20 заголовков. Шаблоны и заголовки сверх этих пороговых значений будут игнорироваться.\n\nПримечание. Если шаблон URL соответствует незашифрованным схемам (http://, ws:// или при отсутствии схемы), настроенные заголовки могут передаваться в виде обычного текста по незашифрованному каналу и могут быть видны наблюдателям в сети. Чтобы защитить конфиденциальные или идентифицирующие значения заголовков, ограничьте шаблоны URL зашифрованными схемами (https:// или wss://).\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=HttpHeaderInjection.";
HttpsOnlyMode.pfm_title = "Разрешить включать режим \"Только HTTPS\"";
HttpsOnlyMode.pfm_description = "allowed - Не ограничивать для пользователей возможность включать режим \"Только HTTPS\"\ndisallowed - Отключить режим \"Только HTTPS\"\nforce_enabled - Включить режим \"Только HTTPS\" строгого типа\nforce_balanced_enabled - Принудительно включить режим \"Только HTTPS\" сбалансированного типа\nПравило определяет, могут ли пользователи включать в настройках режим \"Только HTTPS\" (функцию \"Всегда использовать безопасные подключения\"). Если этот режим активирован, используется только протокол HTTPS.\n\nЕсли правило не настроено или для него установлено значение allowed, пользователи смогут включать режим \"Только HTTPS\".\n\nЕсли выбрано значение disallowed, режим \"Только HTTPS\" отключен.\n\nЕсли установлено значение force_enabled, будет включен режим \"Только HTTPS\" строгого типа.\n\nЕсли задано значение force_balanced_enabled, будет включен режим \"Только HTTPS\" сбалансированного типа.\n\nЗначение force_enabled поддерживается в версиях M112 и более новых, а значение force_balanced_enabled – в версиях M129 и более новых.\n\nПараметры force_enabled и force_balanced_enabled также можно рекомендовать пользователям.\nИзначально устанавливается режим \"Только HTTPS\" строгого или сбалансированного типа, но пользователи смогут его изменить.\n\nЕсли вы укажете значение, не поддерживаемое в браузере Chrome, для которого предназначено правило, то по умолчанию будет использоваться значение allowed.\n\nЧтобы отключить переход на протокол HTTPS для определенных имен хостов или их шаблонов, можно настроить отдельное правило HttpAllowlist.";
HttpsUpgradesEnabled.pfm_title = "Включить принудительное использование протокола HTTPS в автоматическом режиме";
HttpsUpgradesEnabled.pfm_description = "Brave при возможности пытается использовать протокол HTTPS вместо HTTP. С помощью этого правила такой переход можно отключить. Если правило не настроено или для него задано значение True, принудительное использование протокола HTTPS будет включено по умолчанию.\n\nЧтобы отключить эту функцию для определенных хостов, укажите их имена или шаблоны имен в правиле HttpAllowlist.\n\nСм. также правило HttpsOnlyMode.";
IPv6ReachabilityOverrideEnabled.pfm_title = "Разрешить переопределять проверку доступности IPv6";
IPv6ReachabilityOverrideEnabled.pfm_description = "Если для правила задано значение True, проверка доступности IPv6 будет переопределяться. Это означает, что при разрешении имен хостов система всегда будет запрашивать записи AAAA. Правило применяется ко всем пользователям и интерфейсам на устройстве.\n\nЕсли правило не настроено или для него задано значение False, проверка доступности IPv6 не будет переопределяться.\nСистема будет запрашивать записи AAAA, только если у глобального хоста IPv6 есть к ней доступ.";
IdleDetectionAllowedForUrls.pfm_title = "Сайты, которым разрешено определять состояние бездействия";
IdleDetectionAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которые могут использовать Idle Detection API без запроса разрешения у пользователя. Записи черного списка приоритетнее записей белого списка, которые, в свою очередь, приоритетнее значения по умолчанию.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки: *. Это правило работает только с адресами сайтов-источников, поэтому пути в шаблонах URL не учитываются.\n\nЕсли правило не настроено, для всех сайтов будет использоваться глобальное значение по умолчанию, заданное в правиле DefaultIdleDetectionSetting (\"Настройка обнаружения бездействия по умолчанию\"), при условии, что оно задано. В противном случае применяется пользовательская конфигурация.";
IdleDetectionBlockedForUrls.pfm_title = "Сайты, которым запрещено определять состояние бездействия";
IdleDetectionBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым запрещено использовать Idle Detection API.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки (*). Это правило работает только с адресами сайтов-источников, поэтому пути в шаблонах URL не учитываются.\n\nЕсли правило не настроено, для всех сайтов будет использоваться глобальное значение по умолчанию, заданное в правиле DefaultIdleDetectionSetting (Настройка обнаружения бездействия по умолчанию), если оно настроено. В противном случае действует пользовательская конфигурация.";
IdleTimeout.pfm_title = "Период неактивности";
IdleTimeout.pfm_description = "Правило запускает действия, когда компьютер не используется.\n\nЕсли оно настроено, то определяет, через какое время неактивности пользователя (в минутах) браузер выполнит действия, указанные в правиле IdleTimeoutActions.\n\nЕсли правило не задано, никакие действия выполняться не будут.\n\nМинимальное настраиваемое время: 1 минута.\n\nПонятие \"активность пользователя\" определяется API операционной системы. Например, это может быть перемещение курсора мыши или ввод с клавиатуры.";
IdleTimeoutActions.pfm_title = "Действия после периода неактивности";
IdleTimeoutActions.pfm_description = "close_browsers - Закрыть браузеры\nshow_profile_picker - Показать окно выбора профиля\nclear_browsing_history - Очистить историю браузера\nclear_download_history - Очистить историю скачиваний\nclear_cookies_and_other_site_data - Удалить файлы cookie и другие данные сайтов\nclear_cached_images_and_files - Удалить кешированные изображения и файлы\nclear_password_signin - Удалить пароли для входа\nclear_autofill - Удалить данные автозаполнения\nclear_site_settings - Удалить настройки сайтов\nclear_hosted_app_data - Удалить данные размещаемых приложений\nreload_pages - Перезагрузить страницы\nsign_out - Выйти\nclose_tabs - Закрыть вкладки\nСписок действий, которые необходимо выполнить, когда истечет период, заданный в правиле IdleTimeout.\n\nВнимание! Правило может повлиять на локальные персональные данные или привести к их удалению. Чтобы избежать этого, рекомендуем проверять настройки перед их применением.\n\nЭто правило не действует, если не настроено правило IdleTimeout.\n\nКогда истечет время ожидания, установленное в правиле IdleTimeout, браузер выполнит перечисленные действия.\n\nЕсли правило IdleTimeoutActions не настроено или в качестве значения указана пустая строка, IdleTimeout работать не будет.\n\nДоступные действия:\n\nclose_browsers: закрыть все окна браузеров и современных веб-приложений в текущем профиле. Не поддерживается в Android и iOS.\n\nclose_tabs: закрыть все вкладки в открытых окнах. Работает только в iOS.\n\nshow_profile_picker: показать окно выбора профиля. Не поддерживается в Android и iOS.\n\nsign_out: выйти из аккаунта текущего пользователя. Работает только в iOS.\n\nclear_browsing_history, clear_download_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing, clear_autofill, clear_site_settings и clear_hosted_app_data: удалить определенный тип данных о работе в браузере. Подробные сведения представлены в правиле ClearBrowsingDataOnExitList. В iOS поддерживаются clear_browsing_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing и clear_autofill.\n\nreload_pages: обновить все веб-страницы. На некоторых страницах пользователь может сначала получить запрос на подтверждение действия. Не работает в iOS.\n\nПользователь не выйдет из аккаунта Google после удаления файлов cookie с помощью действия clear_cookies_and_other_site_data.\n\nclear_browsing_history, clear_password_signing, clear_autofill и clear_site_settings останавливают синхронизацию выбранных типов данных, если функция \"Chrome Sync\" не отключена через SyncDisabled и правило BrowserSignin работает.";
ImagesAllowedForUrls.pfm_title = "Разрешить показ изображений на этих сайтах";
ImagesAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, на которых могут показываться изображения.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultImagesSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Допустимы подстановочные знаки (*).\n\nОбратите внимание, что эта функция не поддерживается в Android, несмотря на то что раньше ее можно было включить.";
ImagesBlockedForUrls.pfm_title = "Блокировать изображения на этих сайтах";
ImagesBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, на которых запрещен показ изображений.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultImagesSetting. Если не задано и оно, применяются персональные настройки пользователя.\n\n Подробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Разрешено использовать подстановочные знаки (*).\n\n Обратите внимание, что это правило никогда не поддерживалось в Android в полной мере, даже если его можно было настроить для этой ОС.";
ImportAutofillFormData.pfm_title = "Импорт данных для автозаполнения форм из браузера по умолчанию при первом запуске";
ImportAutofillFormData.pfm_description = "Если правило включено, при первом запуске будут импортированы данные автозаполнения форм из браузера, который ранее был основным. Если правило выключено или не настроено, данные автозаполнения форм не импортируются при первом запуске.\n\nКогда пользователь откроет диалоговое окно импорта, флажок импорта данных автозаполнения форм будет установлен или снят в соответствии с текущей настройкой правила.";
ImportBookmarks.pfm_title = "Импорт закладок из браузера, используемого по умолчанию, при первом запуске";
ImportBookmarks.pfm_description = "Если правило включено, при первом запуске будут импортированы закладки браузера, который ранее был основным. Если правило выключено или не настроено, закладки не импортируются при первом запуске.\n\nКогда пользователь откроет диалоговое окно импорта, флажок импорта закладок будет установлен или снят в соответствии с текущей настройкой правила.";
ImportHistory.pfm_title = "Импорт истории просмотров из браузера, используемого по умолчанию, при первом запуске";
ImportHistory.pfm_description = "Если правило включено, при первом запуске будет импортирована история браузера, который ранее был основным. Если правило выключено или не настроено, история браузера не импортируется при первом запуске.\n\nКогда пользователь откроет диалоговое окно импорта, флажок импорта истории браузера будет установлен или снят в соответствии с текущей настройкой правила.";
ImportHomepage.pfm_title = "Импорт сведений о домашней странице из браузера, используемого по умолчанию, при первом запуске";
ImportHomepage.pfm_description = "Если правило включено, при первом запуске будет импортирован адрес стартовой страницы из браузера, который ранее был основным. Если правило выключено или не настроено, адрес стартовой страницы не импортируется при первом запуске.\n\nКогда пользователь откроет диалоговое окно импорта, флажок импорта адреса домашней страницы будет установлен или снят в соответствии с текущей настройкой правила.";
ImportSavedPasswords.pfm_title = "Импорт сохраненных паролей из браузера, используемого по умолчанию, при первом запуске";
ImportSavedPasswords.pfm_description = "Это правило управляет импортом только при первом запуске после установки. Оно обеспечивает более плавный переход к Brave в системах, где до этого в основном использовался другой браузер. Это правило не влияет на возможности менеджера паролей для аккаунта Google.\n\nЕсли оно включено, пароли, сохраненные в браузере, который ранее использовался по умолчанию, будут импортированы при первом запуске. Их также можно будет перенести вручную на странице настроек браузера.\nЕсли правило отключено, пароли не будут импортированы при первом запуске, а перенос вручную будет запрещен.\nЕсли правило не настроено, пароли не будут импортированы при первом запуске. Пользователи смогут сделать это позже в настройках браузера.";
ImportSearchEngine.pfm_title = "Импорт сведений о поисковых системах из браузера, используемого по умолчанию, при первом запуске.";
ImportSearchEngine.pfm_description = "Если правило включено, при первом запуске из браузера, который ранее был основным, будет импортирована поисковая система, используемая по умолчанию. Если правило выключено или не настроено, поисковая система по умолчанию не импортируется при первом запуске.\n\nКогда пользователь откроет диалоговое окно импорта, флажок импорта поисковой системы по умолчанию будет установлен или снят в соответствии с текущей настройкой правила.";
IncognitoModeAvailability.pfm_title = "Доступность режима инкогнито";
IncognitoModeAvailability.pfm_description = "0 - Режим инкогнито доступен\n1 - Режим инкогнито отключен\n2 - Принудительное использование режима инкогнито\nПравило определяет, может ли пользователь открывать страницы в Brave в режиме инкогнито.\n\nЕсли правило включено или не настроено, страницы можно открывать в режиме инкогнито.\n\nОтключив правило, вы запретите это делать.\n\nЕсли включить правило принудительно, страницы можно будет открывать ТОЛЬКО в режиме инкогнито. Обратите внимание, что принудительное включение не поддерживается для приложений Android в ChromeOS.\n\nIncognitoModeUrlAllowlist имеет приоритет над этим правилом и может снова включить режим инкогнито для определенных URL. Если режим инкогнито отключен текущим правилом и предоставлен белый список, этот режим доступен только для URL из списка, а все остальные страницы заблокированы.\n\nПримечание. Изменения в правиле на устройствах iOS во время сеанса браузера начнут действовать, только когда он будет перезагружен.";
IncognitoModeUrlAllowlist.pfm_title = "Разрешить доступ к определенным URL в режиме инкогнито";
IncognitoModeUrlAllowlist.pfm_description = "Правило позволяет предоставить доступ к указанным URL в режиме инкогнито. Вы можете настроить исключения для некоторых шаблонов URL из IncognitoModeUrlBlocklist, используя формат со страницы https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nКогда настроено это правило и IncognitoModeUrlBlocklist, то первое имеет приоритет. Если URL соответствует шаблону из белого списка, такой URL будет разрешен. Если URL соответствует шаблону из черного списка (но не из белого), такой URL будет заблокирован. Если URL не соответствует ни одному шаблону из этих списков, будет использоваться правило URLBlocklist или URLAllowlist.\n\nЕсли одно из этих правил настроено, а IncognitoModeUrlBlocklist — нет, то все URL, которых нет в белом списке, будут заблокированы в режиме инкогнито.\n\nЕсли IncognitoModeAvailability запрещает использовать режим инкогнито (указано значение 1), но текущее правило настроено, этот режим будет доступен только для URL из белого списка.\n\nЕсли правило не настроено, исключений из IncognitoModeUrlBlocklist и IncognitoModeAvailability нет.\n\nЭто правило действует только в режиме инкогнито. Чтобы разрешить доступ к URL для всех профилей пользователей, настройте правило URLAllowlist.\n\nЗапрещено использовать подстановочные знаки (например, \"*\" или \"[*]\") для создания массовых исключений. Чтобы включить функцию для всех, используйте правило IncognitoModeAvailability.\n\nВ этом правиле можно указать не более 1000 URL.";
IncognitoModeUrlBlocklist.pfm_title = "Заблокировать доступ к определенным URL в режиме инкогнито";
IncognitoModeUrlBlocklist.pfm_description = "Правило IncognitoModeUrlBlocklist позволяет заблокировать загрузку веб-страниц с запрещенными URL в режиме инкогнито. Администраторы могут указать список шаблонов URL, которые будут блокироваться. Подробнее о формате шаблонов URL: https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nКогда настроено текущее правило и IncognitoModeUrlAllowlist, то второе имеет приоритет. Если URL соответствует шаблону из белого списка, такой URL будет разрешен. Если URL соответствует шаблону из черного списка (но не из белого), такой URL будет заблокирован. Если URL не соответствует ни одному шаблону из этих списков, будет использоваться правило URLBlocklist или URLAllowlist.\n\nЕсли правило IncognitoModeUrlAllowlist настроено, а текущее – нет, то все URL, которых нет в белом списке, будут заблокированы в режиме инкогнито.\n\nЕсли IncognitoModeAvailability запрещает использовать режим инкогнито (указано значение 1), но правило IncognitoModeUrlAllowlist настроено, этот режим будет доступен только для URL из белого списка.\n\nТекущее правило действует только в режиме инкогнито. Чтобы заблокировать доступ к URL для всех профилей пользователей, настройте правило URLBlocklist.\n\nВ текущем правиле можно указать не более 1000 URL.";
InsecureContentAllowedForUrls.pfm_title = "Разрешение небезопасного контента на текущих сайтах";
InsecureContentAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, на которых разрешено показывать блокируемый (активный) смешанный контент (то есть HTTP-контент на сайтах с протоколом HTTPS) и на которых не будет изменяться протокол для опционально блокируемого смешанного контента.\n\nЕсли не настроить правило, блокируемый смешанный контент будет заблокирован, а для опционально блокируемого будет изменен протокол. При этом пользователи смогут добавлять исключения, разрешающие показ такого контента на определенных сайтах.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Разрешено использовать подстановочные знаки (*).";
InsecureContentBlockedForUrls.pfm_title = "Блокировка небезопасного контента на текущих сайтах";
InsecureContentBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, на которых запрещено показывать блокируемый (активный) смешанный контент (то есть HTTP-контент на сайтах с протоколом HTTPS) и на которых будет изменен протокол для опционально блокируемого (пассивного) смешанного контента.\n\nЕсли не настроить это правило, блокируемый смешанный контент будет недоступен, а для опционально блокируемого будет изменен протокол. Однако пользователи смогут создавать исключения, разрешающие показ такого контента на определенных сайтах.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки: *.";
IntensiveWakeUpThrottlingEnabled.pfm_title = "Управление функцией IntensiveWakeUpThrottling";
IntensiveWakeUpThrottlingEnabled.pfm_description = "Когда функция IntensiveWakeUpThrottling включена, запуск таймеров JavaScript на вкладках, работающих в фоновом режиме, ограничивается и синхронизируется. Если страницей не пользовались как минимум 5 минут, запускается не более одного таймера в минуту.\n\nХотя эта функция соответствует веб-стандартам, ее использование может привести к тому, что определенные действия на некоторых сайтах будут выполняться с задержкой до одной минуты. Однако эта функция позволяет значительно снизить нагрузку на процессор и уменьшить расход заряда батареи. Подробнее: https://bit.ly/30b1XR4.\n\nЕсли включить это правило, функция будет включена принудительно и пользователи не смогут это изменить.\n\nЕсли отключить это правило, функция будет выключена принудительно и пользователи не смогут это изменить.\n\nЕсли правило не настроено, применяется внутренний алгоритм функции, который пользователи могут настроить сами.\n\nОбратите внимание, что правило применяется к каждому процессу обработки и при запуске такого процесса действует самое последнее значение правила. Чтобы для всех загруженных вкладок действовало одно и то же значение, необходимо перезапустить браузер. Смена значения безопасна для процесса обработки.\n";
IntranetRedirectBehavior.pfm_title = "Параметры переадресации в интранете";
IntranetRedirectBehavior.pfm_description = "0 - Использовать настройки браузера по умолчанию\n1 - Отключить проверки на перехват DNS и запретить показ информационных панелей с вопросом о том, не хотел ли пользователь ввести адрес сайта в интранете\n2 - Отключить проверки на перехват DNS, но разрешить показ информационных панелей с вопросом о том, не хотел ли пользователь ввести адрес сайта в интранете\n3 - Разрешить выполнять проверки на перехват DNS и показывать информационные панели с вопросом о том, не хотел ли пользователь ввести адрес сайта в интранете\nЭто правило настраивает процесс переадресации на сайты в интранете при помощи проверок на перехват DNS. С помощью таких проверок осуществляется попытка определить, использует ли браузер прокси-сервер, который перенаправляет запросы к неизвестным именам хостов.\n\nЕсли правило не настроено, браузер использует параметры по умолчанию для проведения проверок на перехват DNS и показа информационных панелей с переадресацией на сайты в интранете. В версии M88 эти проверки и панели включены по умолчанию, но в следующем выпуске они будут отключены.\n\nСвязанное правило DNSInterceptionChecksEnabled также может отключать проверки на перехват DNS. Текущее правило является его более гибкой версией и позволяет отдельно настраивать показ информационных панелей с переадресацией на сайты в интранете, а область действия этого правила может быть расширена в будущем.\nЕсли согласно DNSInterceptionChecksEnabled или этому правилу проверки на перехват должны быть отключены, это будет сделано.";
IsolateOrigins.pfm_title = "Включить изоляцию для определенных сайтов";
IsolateOrigins.pfm_description = "Позволяет указать список источников, для которых будут запускаться отдельные процессы.\n\nВ Android это правило работает только на устройствах с достаточным объемом памяти (более 3,2 ГБ ОЗУ), поскольку изоляция слишком большого количества сайтов на устройствах с ограниченными ресурсами может вызвать проблемы с производительностью. Для устройств Android с ограниченными ресурсами используйте правило IsolateOriginsShortlist.\n\nНа устройствах с объемом памяти менее 1 ГБ не рекомендуется настраивать изоляцию процессов.\n\nКаждый процесс, запущенный для источника, будет содержать документы только из этого источника и его субдоменов. Например, если вы укажете в списке сайт https://a1.example.com/, в этом же процессе можно будет запустить https://a2.a1.example.com/, но не https://example.com или https://b.example.com.\n\nВ Brave 77 и более поздних версиях диапазон источников, которые нужно изолировать, можно задать с помощью подстановочного знака. Например, если добавить сайт https://[*.]corp.example.com, отдельный процесс будет выделяться для каждого источника, входящего в https://corp.example.com, включая сам домен https://corp.example.com, а также https://a1.corp.example.com и https://a2.a1.corp.example.com.\n\nОбратите внимание, что, согласно правилу SitePerProcess, все сайты (они описываются при помощи протокола и домена первого и второго уровня, например https://example.com) уже по умолчанию изолируются на компьютерах. Для изоляции определенных источников с более высокой степенью детализации (например, https://a.example.com) используют правило IsolateOrigins.\n\nВ Brave 77 и более поздних версиях на устройствах Android режим изоляции по умолчанию используется для определенных сайтов с конфиденциальными данными. С этим правилом режим изоляции применяется к отдельным дополнительным источникам.\n\nТакже учтите, что взаимодействие скриптов между источниками, которые изолированы в соответствии с текущим правилом, и другими источниками, принадлежащими к тому же сайту, станет невозможным. В других случаях подобное допускается (при условии, что у двух документов, которые относятся к одному сайту, будут одинаковые значения параметра document.domain). Прежде чем изолировать источник, администраторы должны убедиться, что в нем не используется такой редкий режим.\n\nЕсли правило не настроено или в качестве значения указана пустая строка, изоляция сайтов не будет требоваться для определенных источников. Пользователи смогут включать изоляцию процессов вручную с помощью параметра командной строки.";
JavaScriptAllowedForUrls.pfm_title = "Разрешить JavaScript на этих сайтах";
JavaScriptAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым разрешено запускать JavaScript.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultJavaScriptSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки: *.";
JavaScriptBlockedForUrls.pfm_title = "Блокировать JavaScript на этих сайтах";
JavaScriptBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, которым запрещено запускать код JavaScript.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultJavaScriptSetting. Если не задано и оно, применяются персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Разрешено использовать подстановочные знаки (*).\n\nКод JavaScript блокируется правилом JavaScriptBlockedForUrls, если источник документа верхнего уровня (обычно это URL страницы, который показывается в адресной строке) совпадает с одним из шаблонов. Поэтому правило не подходит для того, чтобы предотвращать веб-атаки на цепь поставок. Например, если в нем указан шаблон \"https://[*.]foo.com/\", оно не заблокирует на странице сайта https://example.com запуск скрипта, загруженного со страницы https://www.foo.com/example.js. Более того, когда в правиле указан шаблон \"https://example.com/\", оно не заблокирует запуск скриптов в документе на сайте https://example.com, если это не документ верхнего уровня, а встроенный на страницу субфрейм, размещенный на другом сайте, например https://www.bar.com.";
JavaScriptJitAllowedForSites.pfm_title = "Разрешить использование JIT-компилятора JavaScript на этих сайтах";
JavaScriptJitAllowedForSites.pfm_description = "Позволяет задать список шаблонов URL для указания сайтов, которым разрешено запускать код JavaScript с включенным JIT-компилятором.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки (*).\n\nКак для отдельных субдоменов, так и для целых сайтов можно задавать исключения. Например, правило, заданное только для subdomain.site.com, будет действовать для subdomain.site.com, но не для site.com. В некоторых случаях, когда субдомен нельзя изолировать от родительского сайта, он может наследовать правило, заданное для site.com. Исключения могут не действовать для фреймов, загруженных на существующей вкладке, пока сайт не будет открыт в новой вкладке. На устройствах Android с небольшим объемом памяти исключения для сайтов могут не применяться. В этом случае будет использоваться правило DefaultJavaScriptJitSetting (если оно настроено) или стандартные настройки JIT-компилятора JavaScript, заданные в профиле.\n\nЧтобы применить исключения, Brave может запускать сайты или субдомены, настройки которых отличаются от стандартных, в отдельных процессах. Это может увеличить использование памяти, особенно на Android или когда шаблону с подстановочным знаком соответствует множество субдоменов, так как каждый из этих ресурсов может обрабатываться отдельно. Изолированные субдомены также не могут использовать document.domain для доступа к родительскому сайту.\n\nПримечание. В версии 155 и более ранних исключения из правила применялись только на уровне сайта (домена второго уровня). Правило, настроенное только для subdomain.site.com, не действовало даже для этого субдомена. Чтобы оно применялось к site.com и subdomain.site.com, его нужно было задать для site.com.\n\nЭто правило применяется к каждому фрейму отдельно, а не только на основе URL источника верхнего уровня. Например, если сайт site-one.com указан в правиле JavaScriptJitAllowedForSites, но загружает фрейм с сайта site-two.com, то для site-one.com JIT-компилятор JavaScript будет включен, а на site-two.com будет действовать правило DefaultJavaScriptJitSetting (если оно настроено). В противном случае JIT-компилятор JavaScript будет включен. Записи черного списка приоритетнее записей белого списка, которые, в свою очередь, приоритетнее значения по умолчанию.\n\nЕсли правило не настроено, то для сайта применяется правило DefaultJavaScriptJitSetting. Если не задано и оно, JIT-компилятор JavaScript будет включен.";
JavaScriptJitBlockedForSites.pfm_title = "Запретить использование JIT-компилятора JavaScript на этих сайтах";
JavaScriptJitBlockedForSites.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, которым запрещено запускать код JavaScript с включенным JIT-компилятором.\n\nЕсли отключить его, веб-контент в Brave может загружаться медленнее, а некоторые элементы JavaScript, включая WebAssembly, могут перестать работать. Отключение JIT-компилятора JavaScript повышает безопасность отрисовки веб-контента в Brave.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки (*).\n\nКак для отдельных субдоменов, так и для целых сайтов можно задавать исключения. Например, правило, заданное только для subdomain.site.com, будет действовать для subdomain.site.com, но не для site.com. В некоторых случаях, когда субдомен нельзя изолировать от родительского сайта, он может наследовать правило, заданное для site.com. Исключения могут не действовать для фреймов, загруженных на существующей вкладке, пока сайт не будет открыт в новой вкладке. На устройствах Android с небольшим объемом памяти исключения для сайтов могут не применяться. В этом случае используется правило DefaultJavaScriptJitSetting (если оно настроено) или стандартные настройки JIT-компилятора JavaScript, заданные в профиле.\n\nЧтобы применить исключения, Brave может запускать сайты или субдомены, настройки которых отличаются от стандартных, в отдельных процессах. Это может увеличить использование памяти, особенно на Android или когда шаблону с подстановочным знаком соответствует множество субдоменов, так как каждый из этих ресурсов может обрабатываться отдельно. Изолированные субдомены также не могут использовать document.domain для доступа к родительскому сайту.\n\nПримечание. В версии 155 и более ранних исключения из правила применялись только на уровне сайта (домена второго уровня). Правило, заданное только для subdomain.site.com, не работало даже для этого субдомена. Чтобы оно применялось к site.com и subdomain.site.com, его нужно было задать для site.com.\nЭто правило применяется к каждому фрейму отдельно, а не только на основе URL источника верхнего уровня. Например, если сайт site-one.com указан в правиле JavaScriptJitBlockedForSites, но загружает фрейм с сайта site-two.com, то на первом сайте JIT-компилятор JavaScript будет отключен, а на втором будет действовать правило DefaultJavaScriptJitSetting (если оно настроено). В противном случае JIT-компилятор JavaScript будет включен. Элементы черного списка приоритетнее записей в белом списке, которые, в свою очередь, приоритетнее значения по умолчанию.\n\nЕсли это правило не задано для сайта, то к нему применяется правило DefaultJavaScriptJitSetting (если оно настроено). В противном случае для сайта будет включен JIT-компилятор JavaScript.";
JavaScriptOptimizerAllowedForSites.pfm_title = "Разрешить оптимизацию JavaScript на этих сайтах";
JavaScriptOptimizerAllowedForSites.pfm_description = "Позволяет задать список шаблонов URL сайтов, для которых включена улучшенная оптимизация JavaScript.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns.\nРазрешается использовать подстановочные знаки (*).\n\nКак для отдельных субдоменов, так и для целых сайтов можно задавать исключения.\nНапример, правило, заданное только для subdomain.site.com, будет применяться к subdomain.site.com, но не к site.com. В некоторых случаях, когда субдомен нельзя изолировать от родительского сайта, он может наследовать правило, заданное для site.com. Исключения могут не действовать для фреймов, загруженных на существующей вкладке, пока сайт не будет открыт в новой вкладке. На устройствах Android с небольшим объемом памяти исключения для сайтов могут не применяться. В этом случае будет использоваться правило DefaultJavaScriptOptimizerSetting (если оно настроено) или стандартные настройки оптимизации JavaScript, заданные в профиле.\n\nЧтобы применить исключения, Brave может запускать сайты или субдомены, настройки которых отличаются от стандартных, в отдельных процессах. Это может увеличить использование памяти, особенно на Android или когда шаблону с подстановочным знаком соответствует множество субдоменов, так как каждый из этих ресурсов может обрабатываться отдельно. Изолированные субдомены также не могут использовать document.domain для доступа к родительскому сайту.\n\nПримечание. В версии 138 и более ранних исключения из правила применялись только на уровне сайта (домена второго уровня). Правило, настроенное только для subdomain.site.com, не действовало даже для этого субдомена. Чтобы оно применялось к site.com и subdomain.site.com, его нужно было задать для site.com.\n\nЭто правило применяется к каждому фрейму отдельно, а не только на основе URL источника верхнего уровня. Например, если сайт site-one.com указан в правиле JavaScriptOptimizerAllowedForSites, но загружает фрейм с сайта site-two.com, то для site-one.com оптимизация JavaScript будет включена, а для site-two.com будет действовать правило DefaultJavaScriptOptimizerSetting (если оно настроено). В противном случае оптимизация JavaScript будет включена. Записи черного списка приоритетнее записей белого списка, которые, в свою очередь, приоритетнее значения по умолчанию.\n\nЕсли правило не настроено, то для сайта применяется правило DefaultJavaScriptOptimizerSetting. Если не задано и оно, оптимизация JavaScript будет включена.";
JavaScriptOptimizerBlockedForSites.pfm_title = "Запретить оптимизацию JavaScript на этих сайтах";
JavaScriptOptimizerBlockedForSites.pfm_description = "Позволяет задать список шаблонов URL сайтов, для которых отключена улучшенная оптимизация JavaScript.\n\nБез оптимизации JavaScript отрисовка веб-контента в Brave может выполняться медленнее.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns.\nРазрешается использовать подстановочные знаки (*).\n\nКак для отдельных субдоменов, так и для целых сайтов можно задавать исключения.\nНапример, правило, заданное только для subdomain.site.com, будет применяться к subdomain.site.com, но не к site.com. В некоторых случаях, когда субдомен нельзя изолировать от родительского сайта, он может наследовать правило, заданное для site.com. Исключения могут не действовать для фреймов, загруженных на существующей вкладке, пока сайт не будет открыт в новой вкладке. На устройствах Android с небольшим объемом памяти исключения для сайтов могут не применяться. В этом случае используется правило DefaultJavaScriptOptimizerSetting (если оно настроено) или стандартные настройки оптимизации JavaScript, заданные в профиле.\n\nЧтобы применить исключения, Brave может запускать сайты или субдомены, настройки которых отличаются от стандартных, в отдельных процессах. Это может увеличить использование памяти, особенно на Android или когда шаблону с подстановочным знаком соответствует множество субдоменов, так как каждый из этих ресурсов может обрабатываться отдельно. Изолированные субдомены также не могут использовать document.domain для доступа к родительскому сайту.\n\nПримечание. В версии 138 и более ранних исключения из правила применялись только на уровне сайта (домена второго уровня). Правило, настроенное только для subdomain.site.com, не действовало даже для этого субдомена. Чтобы оно применялось к site.com и subdomain.site.com, его нужно было настроить для site.com.\nЭто правило применяется к каждому фрейму отдельно, а не только на основе URL источника верхнего уровня. Например, если сайт site-one.com указан в правиле JavaScriptOptimizerBlockedForSites, но загружает фрейм с сайта site-two.com, то для первого сайта оптимизация JavaScript будет отключена, а для второго будет действовать правило DefaultJavaScriptOptimizerSetting (если оно настроено). В противном случае оптимизация JavaScript будет включена. Элементы черного списка приоритетнее записей в белом списке, которые, в свою очередь, приоритетнее значения по умолчанию.\n\nЕсли это правило не задано для сайта, то к нему применяется правило DefaultJavaScriptOptimizerSetting (если оно настроено). В противном случае для него будет включена оптимизация JavaScript.";
LiveCaptionEnabled.pfm_title = "Включить автоматические субтитры";
LiveCaptionEnabled.pfm_description = "Включить функцию \"Автоматические субтитры\".\n\nЕсли правило включено, автоматические субтитры доступны всегда.\n\nЕсли оно отключено, автоматические субтитры не работают.\n\nЕсли правило установлено как обязательное, пользователи не могут изменить или переопределить его.\n\nЕсли правило не настроено, автоматические субтитры отключены по умолчанию, но их можно активировать в любой момент.";
LiveTranslateEnabled.pfm_title = "Включить мгновенный перевод";
LiveTranslateEnabled.pfm_description = "Включить перевод автоматических субтитров. Субтитры будут передаваться в Google для перевода.\n\nЕсли правило включено, мгновенный перевод доступен всегда.\n\nЕсли оно отключено, мгновенный перевод не работает.\n\nЕсли правило установлено как обязательное, пользователи не могут изменить или переопределить его.\n\nЕсли оно не настроено, мгновенный перевод отключен по умолчанию, но его можно активировать в любой момент.\n\nЕсли правило LiveCaptionEnabled отключено, мгновенный перевод не будет работать при любом значении этого правила.";
LocalFontsAllowedForUrls.pfm_title = "Разрешить этим сайтам доступ к шрифтам на устройстве";
LocalFontsAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым автоматически разрешено использовать шрифты на устройстве. Такие сайты получают доступ к информации о шрифтах на устройстве.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Допустимы подстановочные знаки (*). Это правило работает только с адресами сайтов-источников, поэтому пути в шаблонах URL не учитываются.\n\nЕсли правило не настроено, то для сайта применяется правило DefaultLocalFontsSetting при условии, что оно задано. В противном случае действуют параметры браузера по умолчанию, а пользователи сами выбирают, каким сайтам предоставлять разрешение.";
LocalFontsBlockedForUrls.pfm_title = "Запретить этим сайтам доступ к шрифтам на устройстве";
LocalFontsBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL для указания сайтов, которым автоматически запрещено использовать шрифты на устройстве. Это ограничит доступ сайтов к информации о шрифтах на устройстве.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Разрешено использовать подстановочные знаки (*). Это правило работает только с адресами сайтов-источников, поэтому пути в шаблонах URL не учитываются.\n\nЕсли правило не настроено, то для сайта действует правило DefaultLocalFontsSetting при условии, что оно задано. В противном случае применяются настройки браузера по умолчанию, а пользователи сами выбирают, каким сайтам предоставлять разрешение.";
LocalNetworkAccessAllowedForUrls.pfm_title = "Разрешить сайтам отправлять сетевые запросы локальным устройствам и конечным точкам локальной сети";
LocalNetworkAccessAllowedForUrls.pfm_description = "Список шаблонов URL. Сетевые запросы с сайтов, источники которых совпадают с указанными шаблонами, не должны проходить проверки типа \"Local Network Access\".\n\nДля источников, которые не совпадают с указанными шаблонами, применяются пользовательские настройки.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns/.\n\nДополнительные сведения об ограничениях типа \"Local Network Access\" можно найти на странице https://wicg.github.io/local-network-access/.\n\nЕсть несколько правил со списками источников, которые влияют на запросы к локальному устройству и конечным точкам локальной сети. Если источник соответствует шаблонам из нескольких перечисленных ниже правил, эти правила применяются в следующем порядке:\n\n- LocalNetworkBlockedForUrls;\n- LocalNetworkAllowedForUrls;\n- LoopbackNetworkBlockedForUrls;\n- LoopbackNetworkAllowedForUrls;\n- LocalNetworkAccessBlockedForUrls;\n- LocalNetworkAccessAllowedForUrls.";
LocalNetworkAccessBlockedForUrls.pfm_title = "Запретить сайтам отправлять сетевые запросы локальным устройствам и конечным точкам локальной сети";
LocalNetworkAccessBlockedForUrls.pfm_description = "Список шаблонов URL. Правило запрещает сетевые запросы типа \"Local Network Access\" с сайтов, источники которых совпадают с указанными шаблонами.\n\nДля источников, которые не совпадают с указанными шаблонами, применяются пользовательские настройки.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns/.\n\nДополнительные сведения об ограничениях типа \"Local Network Access\" можно найти на странице https://wicg.github.io/local-network-access/.\n\nЕсть несколько правил со списками источников, которые влияют на запросы к локальному устройству и конечным точкам локальной сети. Если источник соответствует шаблонам из нескольких перечисленных ниже правил, эти правила применяются в следующем порядке:\n\n- LocalNetworkBlockedForUrls;\n- LocalNetworkAllowedForUrls;\n- LoopbackNetworkBlockedForUrls;\n- LoopbackNetworkAllowedForUrls;\n- LocalNetworkAccessBlockedForUrls;\n- LocalNetworkAccessAllowedForUrls.";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "Переопределить сопоставления адресного пространства IP-адресов";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "Позволяет отметить определенные диапазоны внутренних адресов как общедоступные, чтобы к ним не применялись проверки типа \"Local Network Access\". Также позволяет отметить определенные диапазоны общедоступных адресов, которые могут использоваться внутри компании, как локальные, чтобы они защищались проверками типа \"Local Network Access\".\n\nПереопределение адресного пространства IP-адресов может быть двух видов:\n\n[cidr]=[public|local|loopback]\n\nГде [cidr] – диапазон IP-адресов в нотации CIDR (подробные сведения можно найти в разделе 3.1 на странице https://tools.ietf.org/html/rfc4632 для IPv4 и разделе 2.3 на странице https://tools.ietf.org/html/rfc4291 для IPv6). IP-адреса IPv6 должны быть указаны в безопасном для URL формате (в скобках). Переопределения CIDR применяются ко всем портам.\n\n[ip-адрес]:[порт]=[public|local|loopback]\n\nУзнать больше о проверке типа \"Local Network Access\" можно на страницах https://wicg.github.io/local-network-access/ и https://developer.chrome.com/blog/local-network-access.\n\nЭто правило не поддерживает динамическое обновление.\n\nПереопределения, установленные с помощью параметра командной строки --ip-address-space-overrides, имеют приоритет над заданными этим правилом.";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "Разрешить запросы на доступ к локальной сети в субфреймах без явного делегирования";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "По умолчанию доступ к локальной сети можно запрашивать в субфреймах из других источников, только если соответствующие разрешения предоставлены явным образом. Это правило позволяет переопределить режим работы по умолчанию, чтобы разрешения на доступ к локальной сети по умолчанию наследовались в субфреймах, если не были явно запрещены в правиле для настройки разрешений.\n\nЕсли правило включено, субфреймы по умолчанию получают все разрешения запрашивать доступ к локальной сети и могут вызывать такой запрос.\n\nЕсли правило отключено или не настроено, субфреймам нужно явно предоставлять возможность запрашивать доступ к локальной сети и вызывать этот запрос.\n\nПравило применяется к следующим функциям правила для настройки разрешений: \"local-network-access\", \"loopback-network\" и \"local-network\".\n\nПодробнее о доступе к локальной сети: https://wicg.github.io/local-network-access/ и https://developer.chrome.com/blog/local-network-access.\n\nЧтобы узнать больше о правиле для настройки разрешений, перейдите на страницу https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy.";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "Определяет, будет ли (временно) отключен режим ограниченного доступа к локальной сети";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "Если правило включено, в ответ на запросы типа \"Local Network Access\" показываются только предупреждения в инструменте \"Chrome DevTools\", так как запросы типа \"Local Network Access\" не проходят проверку.\n\nКогда правило отключено или не настроено, запросы типа \"Local Network Access\" обрабатываются по умолчанию.\n\nДополнительные сведения об ограничениях типа \"Local Network Access\" можно найти на странице https://wicg.github.io/local-network-access/.\n\nЭто корпоративное правило введено на время и будет удалено после выхода версии M163.\n\nВ долгосрочной перспективе LocalNetworkAccessAllowedForUrls может использоваться для включения в белый список шаблонов URL, которым будет автоматически предоставляться разрешение \"Local Network Access\".";
LocalNetworkAllowedForUrls.pfm_title = "Разрешить сайтам отправлять запросы конечным точкам локальной сети";
LocalNetworkAllowedForUrls.pfm_description = "Список шаблонов URL. Сетевые запросы, отправляемые конечным точкам локальной сети с сайтов, источники которых совпадают с указанными шаблонами, не должны проходить проверки типа \"Local Network Access\".\n\nДля источников, не совпадающих с этими шаблонами, действуют пользовательские настройки.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns/.\n\nДополнительные сведения об ограничениях типа \"Local Network Access\" можно найти на странице https://wicg.github.io/local-network-access/.\n\nЕсть несколько правил со списками источников, которые влияют на запросы к конечным точкам локальной сети. Если источник соответствует шаблонам из нескольких перечисленных ниже правил, эти правила применяются в следующем порядке:\n\n- LocalNetworkBlockedForUrls;\n- LocalNetworkAllowedForUrls;\n- LocalNetworkAccessBlockedForUrls;\n- LocalNetworkAccessAllowedForUrls.";
LocalNetworkBlockedForUrls.pfm_title = "Запретить сайтам отправлять сетевые запросы конечным точкам локальной сети";
LocalNetworkBlockedForUrls.pfm_description = "Список шаблонов URL. Правило запрещает отправлять конечным точкам локальной сети сетевые запросы типа \"Local Network Access\" с сайтов, источники которых совпадают с указанными шаблонами.\n\nДля источников, не совпадающих с этими шаблонами, действуют пользовательские настройки.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns/.\n\nДополнительные сведения об ограничениях типа \"Local Network Access\" можно найти на странице https://wicg.github.io/local-network-access/.\n\nЕсть несколько правил со списками источников, которые влияют на запросы к конечным точкам локальной сети. Если источник соответствует шаблонам из нескольких перечисленных ниже правил, эти правила применяются в следующем порядке:\n\n- LocalNetworkBlockedForUrls;\n- LocalNetworkAllowedForUrls;\n- LocalNetworkAccessBlockedForUrls;\n- LocalNetworkAccessAllowedForUrls.";
LookalikeWarningAllowlistDomains.pfm_title = "Не показывать предупреждения о похожих URL на доменах из списка";
LookalikeWarningAllowlistDomains.pfm_description = "Это правило блокирует показ предупреждения о похожих URL на сайтах, указанных в списке. Такие предупреждения обычно появляются на сайтах, которые Brave считает имитирующими знакомые пользователю сайты.\n\nЕсли это правило применяется к доменам, то пользователю не будут показываться предупреждения о похожих URL, когда он просматривает какие-либо страницы в этих доменах.\n\nЕсли это правило не настроено или список доменов пуст, предупреждения могут появляться на любых посещаемых сайтах.\n\nВ настройках правила можно выбрать, должно ли имя хоста точно соответствовать указанному хосту или любому URL в домене. Например, можно заблокировать предупреждения на странице https://foo.example.com/bar, указав в списке домен foo.example.com или example.com.";
LoopbackNetworkAllowedForUrls.pfm_title = "Разрешить сайтам отправлять сетевые запросы локальному устройству";
LoopbackNetworkAllowedForUrls.pfm_description = "Список шаблонов URL. Сетевые запросы к локальному устройству с сайтов, источники которых совпадают с указанными шаблонами, не должны проходить проверки типа \"Local Network Access\".\n\nДля источников, не совпадающих с этими шаблонами, действуют пользовательские настройки.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns/.\n\nДополнительные сведения об ограничениях типа \"Local Network Access\" можно найти на странице https://wicg.github.io/local-network-access/.\n\nЕсть несколько правил со списками источников, которые влияют на запросы к локальному устройству. Если источник соответствует шаблонам из нескольких перечисленных ниже правил, эти правила применяются в следующем порядке:\n\n- LoopbackNetworkBlockedForUrls;\n- LoopbackNetworkAllowedForUrls;\n- LocalNetworkAccessBlockedForUrls;\n- LocalNetworkAccessAllowedForUrls.";
LoopbackNetworkBlockedForUrls.pfm_title = "Запретить сайтам отправлять сетевые запросы локальному устройству";
LoopbackNetworkBlockedForUrls.pfm_description = "Список шаблонов URL. Правило запрещает отправлять локальному устройству сетевые запросы типа \"Local Network Access\" с сайтов, источники которых совпадают с указанными шаблонами.\n\nДля источников, не совпадающих с этими шаблонами, действуют пользовательские настройки.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns/.\n\nДополнительные сведения об ограничениях типа \"Local Network Access\" можно найти на странице https://wicg.github.io/local-network-access/.\n\nЕсть несколько правил со списками источников, которые влияют на запросы к локальному устройству. Если источник соответствует шаблонам из нескольких перечисленных ниже правил, эти правила применяются в следующем порядке:\n\n- LoopbackNetworkBlockedForUrls;\n- LoopbackNetworkAllowedForUrls;\n- LocalNetworkAccessBlockedForUrls;\n- LocalNetworkAccessAllowedForUrls.";
ManagedBookmarks.pfm_title = "Управляемые закладки";
ManagedBookmarks.pfm_description = "Если правило настроено, будет создан список закладок, каждая из которых представляет собой словарь, где ключам name и url соответствуют значения – название закладки и URL-адрес сайта. Администраторы также могут задать подпапку для закладок. Для этого вместо ключа url следует использовать ключ children, а в качестве его значения указать список вложенных закладок или папок. Chrome дополняет неполные URL так же, как при их вводе в адресной строке. Например, адрес google.com будет преобразован в https://google.com/.\n\nПользователи не смогут изменять папки с закладками, а только скрывать их на панели. По умолчанию папка называется \"Управляемые закладки\". Чтобы изменить это название, необходимо добавить в правило дополнительный словарь с единственным ключом toplevel_name и желаемым названием папки в качестве значения. Управляемые закладки не синхронизируются с аккаунтом пользователя, а расширения не могут их изменять.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=ManagedBookmarks.";
ManagedConfigurationPerOrigin.pfm_title = "Устанавливает значения управляемой конфигурации для сайтов, соответствующих заданным источникам";
ManagedConfigurationPerOrigin.pfm_description = "Это правило определяет значение, которое Managed Configuration API возвращает для заданного источника.\n\n Managed Configuration API – это конфигурация пар \"ключ-значение\", к которой можно получить доступ, вызвав функцию JavaScript navigator.managed.getManagedConfiguration(). Этот API доступен только для источников, которые соответствуют принудительно установленным веб-приложениям, указанным в списке WebAppInstallForceList.\n\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin.";
MaxConnectionsPerProxy.pfm_title = "Максимальное количество одновременных подключений к прокси-серверу для запросов, не связанных с WebSocket";
MaxConnectionsPerProxy.pfm_description = "Правило позволяет задать максимальное количество одновременных подключений к прокси-серверу для запросов, не связанных с WebSocket.\n\nЧтобы изменить ограничения для запросов WebSocket, ознакомьтесь с правилом MaxConnectionsPerProxyForWebSocket.\n\nЕсли правило не настроено, используется значение по умолчанию – 128.\n\nНекоторые веб-приложения используют сразу несколько подключений с GET-запросами, ожидающими выполнения. Поэтому при установке значения ниже 128 возможно зависание браузера, если таких веб-приложений слишком много.\nНекоторые прокси-серверы не могут обработать множество одновременных подключений к одному клиенту. Чтобы решить эту проблему, необходимо задать более низкое значение.\n\nУстановите число не меньше 6.\nВ противном случае будет использоваться значение 6.\nЕсли выбрано число ниже значения по умолчанию (128), мы не отвечаем за последствия.\n\nУстановите число не больше 256 (или 99 в Brave 147 и более ранних версиях).\nВ противном случае будет использоваться значение 256 (или 99 в Brave 147 и более ранних версиях).\nВыбирая число больше значения по умолчанию (128), вы действуете на свой страх и риск.\n\nОбратите внимание, что на принудительные ограничения влияет правило AllowSocketPoolSizeRandomizationForProxies.";
MaxConnectionsPerProxyForWebSocket.pfm_title = "Максимальное количество одновременных подключений к прокси-серверу для запросов WebSocket";
MaxConnectionsPerProxyForWebSocket.pfm_description = "Правило позволяет задать максимальное количество одновременных подключений к прокси-серверу для запросов WebSocket.\n\nЧтобы изменить ограничения для запросов, не связанных с WebSocket, ознакомьтесь с правилом MaxConnectionsPerProxy.\n\nЕсли правило не настроено, используется значение по умолчанию – 128.\n\nНекоторые веб-приложения используют сразу несколько подключений с GET-запросами, ожидающими выполнения. Поэтому при установке значения ниже 128 возможно зависание браузера, если таких веб-приложений слишком много.\nНекоторые прокси-серверы не могут обработать множество одновременных подключений к одному клиенту. Чтобы решить эту проблему, необходимо задать более низкое значение.\n\nУстановите число не меньше 6.\nВ противном случае будет использоваться значение 6.\nЕсли выбрано число ниже значения по умолчанию (128), мы не отвечаем за последствия.\n\nУстановите число не больше 256.\nВ противном случае будет использоваться значение 256.\nВыбирая число больше значения по умолчанию (128), вы действуете на свой страх и риск.\n\nОбратите внимание, что на принудительные ограничения влияет правило AllowSocketPoolSizeRandomizationForProxies.";
MaxInvalidationFetchDelay.pfm_title = "Максимальная задержка извлечения после аннулирования политики";
MaxInvalidationFetchDelay.pfm_description = "Позволяет задать максимальную задержку в миллисекундах между получением уведомления об аннулировании правила и извлечением нового правила из службы управления устройствами. Допустимые значения: от 1000 мс (1 секунда) до 300 000 мс (5 минут). Если указано число, не входящее в диапазон, будет использоваться ближайшее предельное значение.\n\nЕсли правило не настроено, Brave использует значение по умолчанию (10 секунд).";
MediaRecommendationsEnabled.pfm_title = "Включить советы о том, что посмотреть";
MediaRecommendationsEnabled.pfm_description = "По умолчанию в браузере показываются персональные рекомендации для пользователя. Если правило отключено, персональные рекомендации скрыты от пользователя. Если правило включено или не настроено, пользователь видит советы о том, что посмотреть.";
MediaRouterCastAllowAllIPs.pfm_title = "Разрешить Google Cast подключаться к устройствам Google Cast на всех IP-адресах";
MediaRouterCastAllowAllIPs.pfm_description = "Если правило EnableMediaRouter не отключено, то включенное правило MediaRouterCastAllowAllIPs разрешает использование технологии Google Cast для Cast-устройств с любыми IP-адресами, а не только с частными адресами стандарта RFC1918/RFC4193.\n\nЕсли правило отключено, Google Cast может использоваться для Cast-устройств только с адресами стандарта RFC1918/RFC4193.\n\nЕсли правило не настроено, можно использовать Google Cast для Cast-устройств только с адресами стандарта RFC1918/RFC4193 кроме случаев, когда активирована функция CastAllowAllIPs.";
MemorySaverModeSavings.pfm_title = "Настроить режим экономии памяти";
MemorySaverModeSavings.pfm_description = "0 - Умеренная экономия памяти\n1 - Сбалансированная экономия памяти\n2 - Максимальная экономия памяти\nЭто правило позволяет настроить режим экономии памяти.\n\nОно действует, только если экономия памяти включена в настройках или правилом HighEfficiencyModeEnabled, и влияет на то, как быстро вкладки становятся неактивными. Например, если это происходит по истечении короткого периода времени, браузер эффективнее экономит память. Однако тогда вкладки перезагружаются чаще. Это может вызывать неудобства и увеличивать расход сетевого трафика.\n\nЕсли для правила установлено значение 0, используется умеренная экономия памяти. Вкладки становятся неактивными по истечении длительного времени.\n\nВыбрав значение 1, вы включите сбалансированную экономию памяти. Вкладки становятся неактивными по истечении оптимального периода времени.\n\nЕсли указано значение 2, используется максимальная экономия памяти. Вкладки становятся неактивными по истечении короткого периода времени.\n\nЕсли правило не настроено, конечный пользователь может переключать этот режим на странице chrome://settings/performance.";
MetricsReportingEnabled.pfm_title = "Включить в отчеты данные об использовании и сбоях";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "Показывать подсказки на странице быстрого доступа";
NTPCardsVisible.pfm_description = "Это правило определяет, будут ли показываться подсказки на странице быстрого доступа. В подсказках предлагаются точки входа для запуска различных сценариев с учетом действий пользователя в браузере.\n\nЕсли правило включено, на странице быстрого доступа будут показаны подсказки (при условии наличия подходящего контента).\n\nЕсли правило отключено, подсказок на странице быстрого доступа не будет.\n\nЕсли правило не настроено, пользователь может сам настраивать показ подсказок. По умолчанию они включены.\n";
NTPCustomBackgroundEnabled.pfm_title = "Разрешить пользователям менять фон на странице быстрого доступа";
NTPCustomBackgroundEnabled.pfm_description = "Если для правила установлено значение False, пользователи не смогут изменять фон страницы быстрого доступа. Уже используемые изображения удаляются без возможности восстановления даже в том случае, если позже будет выбрано значение True.\n\nЕсли правило не настроено или для него задано значение True, пользователи могут изменять фон страницы быстрого доступа.\n\nПримечание. На устройствах Android правило применяется к браузеру только после перезапуска.";
NTPFooterExtensionAttributionEnabled.pfm_title = "Показ сведений о расширении на странице быстрого доступа";
NTPFooterExtensionAttributionEnabled.pfm_description = "Правило определяет, нужно ли показывать в нижнем колонтитуле страницы быстрого доступа сведения о расширении, которое ее изменило.\n\nПо умолчанию, если стандартную страницу быстрого доступа изменило какое-то расширение, об этом сообщается в нижнем колонтитуле. Обычно текст содержит ссылку на расширение в интернет-магазине Chrome.\n\nЕсли правило не настроено или задано значение True, в нижнем колонтитуле страницы быстрого доступа указано, какое расширение ей управляет.\n\nЕсли выбрано значение False, эта информация не видна.";
NTPFooterManagementNoticeEnabled.pfm_title = "Настройка видимости уведомления об управлении на странице быстрого доступа в управляемых браузерах";
NTPFooterManagementNoticeEnabled.pfm_description = "Это правило определяет видимость уведомления об управлении в нижнем колонтитуле на странице быстрого доступа. По умолчанию в нижнем колонтитуле страницы быстрого доступа находится информация о том, что браузер управляется организацией. Там отображается значок здания и текст \"Под управлением организации [доменное имя]\". Это можно настроить с помощью правил EnterpriseCustomLabelForBrowser и EnterpriseLogoUrlForBrowser.\n\nЕсли правило не настроено или задано значение True, в управляемых браузерах будет отображаться уведомление \"Под управлением…\" и значок.\n\nЕсли указано значение False, они будут скрыты.\n\nОбратите внимание: правило применяется только к управляемым браузерам. Оно не действует, если аккаунт является управляемым, а браузер – нет.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе Chrome Enterprise Core.\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе Chrome Enterprise Core.";
NTPOutlookCardVisible.pfm_title = "Показывать карточку календаря Outlook на странице \"Новая вкладка\"";
NTPOutlookCardVisible.pfm_description = "Правило определяет, показывается ли карточка Outlook на странице быстрого доступа. Карточка будет видна, только если правило включено и ваша организация разрешила использовать в браузере данные календаря Outlook.\n\nДанные Outlook не сохраняются в браузере.\n\nВ карточке показывается следующее мероприятие из календаря и обзор остальных встреч, запланированных на день. Это позволяет быстрее изучать расписание и повышает продуктивность.\n\nАдминистратору потребуется дополнительно настроить карточку Microsoft Outlook. Подробнее о том, как подключить к Outlook карточку на странице быстрого доступа в Chrome: https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nЕсли правило NTPCardsVisible отключено, карточка Outlook не показывается. При включенном правиле NTPCardsVisible она видна, если включено правило NTPOutlookCardVisible и есть доступные данные. Когда правило NTPCardsVisible не настроено, карточка Outlook будет показываться, если пользователь активировал ее в разделе \"Настроить Chrome\", включено правило NTPOutlookCardVisible и есть доступные данные.";
NTPSharepointCardVisible.pfm_title = "Показывать на странице быстрого доступа карточку файлов SharePoint и OneDrive";
NTPSharepointCardVisible.pfm_description = "Правило определяет, показывается ли карточка файлов SharePoint и OneDrive на странице быстрого доступа. Карточка будет видна, только если правило включено и ваша организация разрешила использовать в браузере данные о файлах SharePoint и OneDrive.\n\nДанные SharePoint и OneDrive не сохраняются в браузере.\n\nВ карточке показывается список рекомендуемых файлов.  Это обеспечивает быстрый доступ к важным документам и повышает продуктивность.\n\nАдминистратору потребуется дополнительно настроить карточку SharePoint и OneDrive. Подробнее о том, как подключить к SharePoint карточку на странице быстрого доступа в Chrome: https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nЕсли правило NTPCardsVisible отключено, карточка SharePoint и OneDrive не показывается. При включенном правиле NTPCardsVisible она видна, если включено правило NTPSharepointCardVisible и есть доступные данные. Когда правило NTPCardsVisible не настроено, карточка SharePoint и OneDrive показывается, если пользователь активировал ее в разделе \"Настроить Chrome\", включено правило NTPSharepointCardVisible и есть доступные данные.";
NTPShortcuts.pfm_title = "Настройка ярлыков на странице быстрого доступа";
NTPShortcuts.pfm_description = "Это правило позволяет настроить до 10 ярлыков, которые будут по умолчанию показываться на странице быстрого доступа в Brave.\n\nЕсли правило работает, пользователи видят эти ярлыки по умолчанию вместе со своими личными ярлыками. Пользователи могут управлять видимостью ярлыков организации на панели \"Настроить Chrome\".\n\nURL ярлыков должны быть уникальными.\n\nКогда для правила allow_user_edit задано значение True, пользователи могут менять названия ярлыков. Если правило не настроено или выбрано значение False, редактировать названия нельзя.\n\nКогда для правила allow_user_delete задано значение True, пользователи могут удалять ярлыки. Если правило не настроено или указано значение False, удалять ярлыки нельзя.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=NTPShortcuts.";
NativeMessagingAllowlist.pfm_title = "Те имена хостов обмена сообщениями с оригинальными приложениями, которые следует исключить из списка запрещенных";
NativeMessagingAllowlist.pfm_description = "Правило позволяет исключить определенные хосты обмена сообщениями с оригинальными приложениями из списка запрещенных. Если значение \"*\" применено для всего списка запрещенных хостов, загружаются только явно разрешенные.\n\nПо умолчанию все эти хосты разрешены. Однако если правило запрещает все хосты обмена сообщениями с оригинальными приложениями, администратор может изменить его, создав список разрешенных хостов.";
NativeMessagingBlocklist.pfm_title = "Имена запрещенных хостов обмена сообщениями с оригинальными приложениями (используйте звездочку (*), чтобы включить все хосты)";
NativeMessagingBlocklist.pfm_description = "Правило позволяет запретить загрузку определенных хостов обмена сообщениями с оригинальными приложениями. Если значение \"*\" применено для всего списка запрещенных хостов, загружаются только явно разрешенные.\n\nЕсли это правило не настроено, Brave загружает все установленные хосты обмена сообщениями с оригинальными приложениями.";
NativeMessagingUserLevelHosts.pfm_title = "Разрешить установку хостов обмена сообщениями с оригинальными приложениями на уровне пользователей (без разрешения администратора)";
NativeMessagingUserLevelHosts.pfm_description = "Если правило включено или не настроено, Brave разрешает использование этих хостов, установленных на уровне пользователей.\n\nЕсли правило отключено, Brave может использовать хосты обмена сообщениями с оригинальными приложениями только в том случае, если они установлены на уровне системы.";
NetworkPredictionOptions.pfm_title = "Включить предварительное определение сети";
NetworkPredictionOptions.pfm_description = "0 - Всегда предопределять параметры сети\n1 - Предопределяет параметры сети только по Wi-Fi.\nПравило устарело в версии 50, удалено в версии 52. В более поздних версиях значение 1 приравнено к значению 0 (\"Всегда предопределять параметры сети\").\n2 - Никогда не предопределять параметры сети\nЭто правило позволяет настраивать предварительное определение сети в Brave. Оно управляет предзагрузкой DNS, предварительным подключением по протоколам TCP и SSL, а также предварительной визуализацией веб-страниц.\n\nЕсли правило настроено, пользователи не могут изменить его. Если правило не настроено, предварительное определение сети включено, но пользователи могут это изменить.";
NewTabPageLocation.pfm_title = "URL страницы быстрого доступа";
NewTabPageLocation.pfm_description = "Позволяет установить URL страницы быстрого доступа по умолчанию и запрещает пользователям его изменять.\n\nСтраница быстрого доступа появляется, когда пользователь открывает новую вкладку или окно.\n\nПравило не определяет, какие страницы открываются при запуске. Для этого применяется правило RestoreOnStartup. Однако если страница быстрого доступа используется в качестве главной или стартовой страницы, это правило также распространяется и на них.\n\nПо возможности укажите канонический URL. Иначе Brave будет по умолчанию использовать адрес вида https://.\n\nЕсли правило не задано или URL не указан, используется страница быстрого доступа, установленная по умолчанию.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе \"Chrome Enterprise Core\".";
NotificationsAllowedForUrls.pfm_title = "Разрешить уведомления на этих сайтах";
NotificationsAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым разрешено показывать уведомления.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultNotificationsSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки (*).";
NotificationsBlockedForUrls.pfm_title = "Блокировать уведомления на этих сайтах";
NotificationsBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, которым запрещено показывать уведомления.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultNotificationsSetting. Если не задано и оно, применяются персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Разрешено использовать подстановочные знаки (*).";
NtlmV2Enabled.pfm_title = "Включить аутентификацию NTLMv2";
NtlmV2Enabled.pfm_description = "Если правило включено или не настроено, будет включена аутентификация NTLMv2.\n\nЕсли правило отключено, аутентификация NTLMv2 будет отключена.\n\nВсе последние версии серверов Samba и Microsoft® Windows® поддерживают аутентификацию NTLMv2. В целях безопасности это правило следует отключать только для обеспечения обратной совместимости.";
OopPrintDriversAllowed.pfm_title = "Разрешено взаимодействие с драйверами принтеров в отдельном процессе";
OopPrintDriversAllowed.pfm_description = "Это правило определяет, будет ли Brave взаимодействовать с драйверами принтеров в отдельном процессе. Платформа передает запросы о доступных принтерах, получает настройки драйверов и отправляет документы на печать локальным принтерам. Когда эти задачи выполняются в отдельном от браузера процессе, повышается стабильность и ускоряется загрузка интерфейса в режиме предварительного просмотра печати.\n\nЕсли правило включено или не настроено, Brave будет запускать отдельный процесс для выполнения задач печати на платформе.\n\nЕсли правило отключено, Brave будет выполнять задачи в браузере без запуска отдельного процесса.\n\nПравило будет удалено после того, как функция взаимодействия с драйверами в отдельном процессе будет полностью внедрена.";
OriginAgentClusterDefaultEnabled.pfm_title = "Разрешает кластеризацию агента с ключом источника";
OriginAgentClusterDefaultEnabled.pfm_description = "Это правило по умолчанию разрешает кластеризацию агента с ключом источника.\n\nHTTP-заголовок Origin-Agent-Cluster определяет, изолируется ли документ в кластере агента с ключом источника или в кластере агента с ключом сайта. Это влияет на безопасность, так как кластер агента с ключом источника позволяет изолировать документы по источнику. Поэтому разработчики больше не смогут задавать метод доступа document.domain.\n\nПоведение по умолчанию: если заголовок Origin-Agent-Cluster не задан, в версии M111 вместо ключа сайта будет использоваться ключ источника.\n\nЕсли правило включено или не настроено, браузер будет использовать это новое значение по умолчанию в версии M111 и всех последующих.\n\nЕсли правило отключено, это изменение отменяется и документы без заголовка Origin-Agent-Cluster будут назначаться кластерам агента с ключом сайта. В таком случае метод доступа document.domain по-прежнему можно будет задавать по умолчанию. Это соответствует устаревшему поведению.\n\nПодробнеее: https://developer.chrome.com/blog/immutable-document-domain/.";
OriginKeyedProcessesEnabled.pfm_title = "Изоляция процессов с одним источником по умолчанию";
OriginKeyedProcessesEnabled.pfm_description = "Правило позволяет изолировать процессы с одним источником для большинства страниц (тех, которые по умолчанию назначены кластеру агентов по источнику). Это повышает безопасность, но в результате создается больше процессов. Пользователи могут переопределить установленное для правила значение с помощью параметров командной строки или на странице chrome://flags. Это касается и включения, и выключения функции.\n\nКогда правило включено, большинство источников изолируются, в том числе от других источников на том же сайте. Также изучите правила IsolateOrigins и SitePerProcess.\n\nКогда правило отключено, источники не изолируются от остальной части сайта, пока от них не поступит запрос об этом.\n\nЕсли правило не настроено, браузер сам определяет, когда и какие источники изолировать.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "Источники или шаблоны имен хостов, которые будут считаться безопасными";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "В этом правиле определяется список источников (URL) или шаблонов имен хостов (например, *.example.com), которые считаются безопасными. Использовать шаблоны можно только для обозначения имен хостов. Источники (URL) нужно указывать в точности. Организации могут составить списки источников устаревших приложений, не поддерживающих TLS, или настроить вспомогательный сервер для внутренней веб-разработки. Это позволит тестировать функции, требующие безопасного контекста, без развертывания TLS. Кроме того, указанные в этом правиле источники не будут помечаться в адресной строке как небезопасные.\n\nПравило работает так же, как и параметр командной строки --unsafely-treat-insecure-origin-as-secure со списком URL, разделенных запятыми. Если правило настроено, оно переопределяет этот параметр и правило UnsafelyTreatInsecureOriginAsSecure.\n\nПодробную информацию о безопасном контексте можно найти на странице https://www.w3.org/TR/secure-contexts.";
PartitionedBlobUrlUsage.pfm_title = "Выбрать, будут ли URL BLOB-объектов изолироваться во время загрузки и навигации";
PartitionedBlobUrlUsage.pfm_description = "Это правило определяет, будут ли URL BLOB-объектов изолироваться во время загрузки и навигации.\nЕсли оно включено или не настроено, URL BLOB-объектов изолируются.\nПри отключенном правиле этого не происходит.\n\nЕсли вам необходимо применить это правило, сообщите об ошибке на странице Brave, объяснив, как оно будет использоваться. Планируется, что правило будет доступно в Brave до версии 146, после которой старая реализация будет удалена.\n\nОбратите внимание, что, пока браузер открыт, изменения в настройках этого правила будут отражаться только в новых процессах обработки.\n\nПодробнее о разделении хранилища в сторонних контекстах: https://developers.google.com/privacy-sandbox/cookies/storage-partitioning.";
PasswordDismissCompromisedAlertEnabled.pfm_title = "Разрешить закрытие оповещений о раскрытых паролях для введенных учетных данных";
PasswordDismissCompromisedAlertEnabled.pfm_description = "Если это правило включено или не настроено, пользователи смогут закрывать и восстанавливать оповещения о раскрытых паролях.\n\nЕсли правило отключено, пользователи не смогут закрывать оповещения о раскрытых паролях. Если оно включено, пользователи смогут закрывать оповещения о раскрытых паролях.";
PasswordLeakDetectionEnabled.pfm_title = "Включить проверку учетных данных на утечку";
PasswordLeakDetectionEnabled.pfm_description = "Если правило включено, в Brave можно проверять, не произошла ли утечка введенных имен пользователей и паролей.\n\nПри отключенном правиле эта функция недоступна.\n\nЕсли правило настроено, пользователи не могут изменить его в Brave. В противном случае функция доступна, но пользователи могут ее отключить.";
PasswordManagerBlocklist.pfm_title = "Список доменов, при обращении к которым Password Manager (с функциями сохранения и автозаполнения) будет отключен";
PasswordManagerBlocklist.pfm_description = "Вы можете настроить список доменов, при обращении к которым Brave отключает функцию \"Password Manager\". Это приведет к тому, что на указанных сайтах перестанут работать функции сохранения и автозаполнения паролей в веб-формах.\n\nДля доменов, внесенных в список, Password Manager будет недоступен.\n\nPassword Manager будет работать для остальных сайтов, которые не указаны в списке.\n\nЕсли правило не настроено, Password Manager будет доступен для всех доменов.\n\nПодробнее о допустимых шаблонах URL: https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
PasswordManagerEnabled.pfm_title = "Включить сохранение паролей";
PasswordManagerEnabled.pfm_description = "Это правило определяет, может ли браузер автоматически запоминать пароли сайтов и сохранять их во встроенном менеджере паролей. С его помощью нельзя изменить пароли, которые сохранены в менеджере, в том числе синхронизированные с аккаунтом Google и Android, или ограничить доступ к ним.\n\nЕсли правило включено, Brave будет запоминать введенные пароли и предлагать их при следующих входах.\n\nЕсли отключить правило, пользователям будут доступны только ранее сохраненные пароли, а сохранить новые будет нельзя.\n\nЕсли правило настроено, пользователи не смогут изменить его в Brave. В противном случае пользователи при желании смогут отключить функцию сохранения паролей.";
PasswordManagerPasskeysEnabled.pfm_title = "Разрешить сохранение ключей доступа в менеджере паролей";
PasswordManagerPasskeysEnabled.pfm_description = "Определяет, может ли браузер сохранять ключи доступа во встроенном менеджере паролей. С помощью этого правила нельзя изменить уже сохраненные в менеджере ключи или ограничить доступ к ним. Если правило PasswordManagerEnabled отключено, сохранять пароли и ключи доступа во встроенном менеджере паролей невозможно, поэтому текущее правило неприменимо.\n\nЕсли правило включено или не настроено, пользователи, которые вошли в Brave, могут сохранять ключи доступа во встроенном менеджере паролей.\n\nЕсли правило отключено, сохранять ключи доступа во встроенном менеджере паролей нельзя, но можно использовать сохраненные ранее ключи.";
PasswordProtectionChangePasswordURL.pfm_title = "Настроить URL страницы смены пароля";
PasswordProtectionChangePasswordURL.pfm_description = "Позволяет указать URL страницы, на которой пользователи будут менять пароль после появления предупреждения в браузере. Служба защиты паролей будет перенаправлять пользователей на URL, который вы укажете в этом правиле (поддерживаются только протоколы HTTP и HTTPS). Чтобы хеш с солью для нового пароля корректно сохранялся в Brave, страница смены пароля должна соответствовать требованиям, перечисленным в этих инструкциях: https://www.chromium.org/developers/design-documents/create-amazing-password-forms.\n\nЕсли правило отключено или не настроено, для смены пароля пользователи будут перенаправляться на страницу https://myaccount.google.com.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе \"Chrome Enterprise Core\".";
PasswordProtectionLoginURLs.pfm_title = "Настроить список URL входа в корпоративный аккаунт, на которых служба защиты паролей должна записывать хеши с солью для паролей";
PasswordProtectionLoginURLs.pfm_description = "Позволяет задать список URL входа в корпоративный аккаунт (только для протоколов HTTP и HTTPS). На указанных страницах служба защиты паролей будет записывать хеши с солью, чтобы затем использовать их для определения повторного ввода паролей. Чтобы хешированные с солью пароли корректно сохранялись в Brave, страницы входа должны соответствовать требованиям, приведенным на странице https://www.chromium.org/developers/design-documents/create-amazing-password-forms.\n\nЕсли правило отключено или не настроено, служба защиты паролей сохраняет хеши с солью только на странице https://accounts.google.com.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе \"Chrome Enterprise Core\".";
PasswordProtectionWarningTrigger.pfm_title = "Триггер, при котором будет получено предупреждение от защиты паролем";
PasswordProtectionWarningTrigger.pfm_description = "0 - Предупреждения от защиты паролем отключены\n1 - Предупреждение от защиты паролем срабатывает при повторном использовании пароля\n2 - Предупреждение от защиты паролем срабатывает при повторном использовании пароля на фишинговой странице\nПравило позволяет управлять показом предупреждения от сервиса защиты паролей. Эта служба предупреждает пользователей о повторном вводе защищаемого пароля на подозрительном сайте.\n\nЧтобы указать, какой пароль должен отслеживаться сервисом, используйте правила PasswordProtectionLoginURLs и PasswordProtectionChangePasswordURL.\n\nЕсли задано значение PasswordProtectionWarningOff, предупреждения не появляются.\n\nЕсли задано значение PasswordProtectionWarningOnPasswordReuse, предупреждение от сервиса защиты паролей появляется, когда пользователь повторно вводит защищаемый пароль на сайте, которого нет в списке разрешенных.\n\nЕсли задано значение PasswordProtectionWarningOnPhishingReuse, предупреждение от сервиса защиты паролей появляется, когда пользователь повторно вводит защищаемый пароль на фишинговом сайте.\n\nЕсли значение не задано, сервис защиты паролей будет контролировать только защищаемые пароли. Пользователи могут изменить эту настройку самостоятельно.";
PasswordSharingEnabled.pfm_title = "Разрешить передачу учетных данных между пользователями";
PasswordSharingEnabled.pfm_description = "Если это правило включено, участники одной и той же семейной группы в Google могут обмениваться паролями друг с другом.\nКогда правило включено или не настроено, в Менеджере паролей видна кнопка для отправки пароля.\nПолученные пароли хранятся в аккаунте пользователя и доступны в Менеджере паролей.\n\nЕсли правило отключено, пользователи не могут обмениваться паролями из Менеджера паролей.\n\nЕсли синхронизация паролей отключена в настройках или включено правило SyncDisabled, эта функция недоступна.\n\nУправляемые аккаунты не могут присоединяться к семейным группам или создавать их, а значит, обмениваться паролями тоже.";
PaymentMethodQueryEnabled.pfm_title = "Разрешить сайтам запрашивать доступные способы оплаты";
PaymentMethodQueryEnabled.pfm_description = "Определяет, могут ли сайты проверять наличие сохраненных способов оплаты.\n\nЕсли правило отключено, сайтам, использующим API PaymentRequest.canMakePayment или PaymentRequest.hasEnrolledInstrument, будет сообщаться, что доступных способов оплаты нет.\n\nЕсли правило включено или не настроено, сайты смогут проверять наличие сохраненных способов оплаты.";
PdfAnnotationsEnabled.pfm_title = "Разрешить добавление заметок в PDF-файлах";
PdfAnnotationsEnabled.pfm_description = "Позволяет указать, можно ли в средстве просмотра PDF в Brave добавлять заметки в PDF-файлы.\n\nЕсли правило не настроено или для него задано значение True, в средстве просмотра PDF можно добавлять заметки в PDF-файлы.\n\nЕсли указано значение False, добавлять заметки в PDF-файлы в средстве просмотра PDF нельзя.";
PdfLocalFileAccessAllowedForDomains.pfm_title = "Разрешить указанным сайтам доступ к локальным файлам по URL с протоколом file:// в средстве просмотра PDF-файлов";
PdfLocalFileAccessAllowedForDomains.pfm_description = "Если правило настроено, перечисленные в нем домены получают доступ к URL со схемой file:// в средстве просмотра PDF-файлов.\nЧтобы разрешить доменам такой доступ, добавьте их в правило,\nчтобы запретить – удалите.\nЕсли правило не настроено, всем доменам запрещен доступ к URL со схемой file:// в средстве просмотра PDF-файлов.";
PdfUseSkiaRendererEnabled.pfm_title = "Использование средства обработки Skia для файлов PDF";
PdfUseSkiaRendererEnabled.pfm_description = "Правило позволяет указать, как работать с файлами PDF в Brave.\n\nЕсли оно включено, файлы PDF просматриваются с помощью средства обработки Skia.\n\nЕсли правило отключено, для просмотра PDF используется средство обработки AGG.\n\nЕсли правило не настроено, средство обработки файлов PDF выбирается браузером.";
PolicyAtomicGroupsEnabled.pfm_title = "Разрешить мини-группы правил";
PolicyAtomicGroupsEnabled.pfm_description = "Если правило включено, будут игнорироваться правила из элементарных групп, заданные не источником с максимальным приоритетом.\n\nЕсли правило отключено, правила не игнорируются по признаку источника. Они игнорируются, только если у них не окажется максимального приоритета в случае конфликта с другими правилами.\n\nЕсли правило задано из облачного источника, оно не может быть нацелено на определенного пользователя.";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "Разрешить объединять правила со словарями из разных источников";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - Исключения для URL, устанавливаемые вручную управляемыми пользователями\nDeviceLoginScreenPowerManagement - Управление питанием на экране входа\nExtensionSettings - Позволяет управлять расширениями\nKeyPermissions - Позволяет разрешать или запрещать использование ключей\nPowerManagementIdleSettings - Параметры электропитания в режиме неактивности\nScreenBrightnessPercent - Уровень яркости экрана в процентах\nScreenLockDelays - Период неактивности для блокировки экрана\nПозволяет объединять выбранные правила из разных источников с одинаковыми областями действия и уровнями. При этом объединяются ключи первого уровня словаря из каждого источника. Если у правила несколько источников, применяется ключ из источника с наивысшим приоритетом.\n\nУкажите подстановочный знак \"*\", чтобы объединить все поддерживаемые правила словаря.\n\nЕсли правило есть в списке и возникает конфликт между источниками с одинаковыми областями действия и уровнями, значения будут объединены в новый словарь.\n\nЕсли правило есть в списке и возникает конфликт между источниками с разными областями действия или уровнями, будет применяться правило с наивысшим приоритетом.\n\nЕсли правила нет в списке, то в случае конфликта между источниками, областями действия или уровнями будет применяться правило с наивысшим приоритетом.";
PolicyListMultipleSourceMergeList.pfm_title = "Разрешить объединять правила, содержащие списки значений, из нескольких источников";
PolicyListMultipleSourceMergeList.pfm_description = "Позволяет объединять выбранные правила из разных источников с одинаковыми областями действия и уровнями.\n\nУкажите подстановочный знак \"*\", чтобы объединить все правила из списка.\n\nЕсли правило есть в списке и возникает конфликт между источниками с одинаковыми областями действия и уровнями, значения будут объединены в новый список.\n\nЕсли правило есть в списке и возникает конфликт между источниками с разными областями действия или уровнями, будет применяться правило с наивысшим приоритетом.\n\nЕсли правила нет в списке, то в случае конфликта между источниками, областями действия или уровнями будет применяться правило с наивысшим приоритетом.";
PolicyRefreshRate.pfm_title = "Частота обновлений политики пользователя";
PolicyRefreshRate.pfm_description = "Задает периодичность (в миллисекундах), с которой в службу управления устройством направляются запросы о правилах для пользователей. Можно выбрать значение от 1 800 000 (30 минут) до 86 400 000 (1 сутки). Если указано число, не входящее в диапазон, будет использоваться ближайшее предельное значение.\n\nЕсли правило не настроено, используется значение по умолчанию (3 часа).\n\nПримечание. Когда правило изменяется, автоматически создается уведомление с запросом обновления, поэтому в более частых обновлениях нет необходимости. Если платформа поддерживает эти уведомления, значение будет установлено на 24 часа (все выбранные для правила значения, а также значения по умолчанию будут игнорироваться).";
PopupsAllowedForUrls.pfm_title = "Разрешить всплывающие окна на этих сайтах";
PopupsAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым разрешено открывать всплывающие окна.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultPopupsSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки (*).";
PopupsBlockedForUrls.pfm_title = "Блокировать всплывающие окна на этих сайтах";
PopupsBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым запрещено открывать всплывающие окна.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultPopupsSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Допустимы подстановочные знаки (*).";
PreciseGeolocationAllowedForUrls.pfm_title = "Разрешить точную геолокацию на этих сайтах";
PreciseGeolocationAllowedForUrls.pfm_description = "Правило позволяет задать список шаблонов URL, чтобы указать сайты, которые могут получать доступ к точной геолокации пользователя без запроса разрешения.\n\nЕсли правило не настроено, на все сайты распространяется правило DefaultGeolocationSetting при условии, что оно задано. В противном случае действуют персональные настройки пользователя.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Можно использовать подстановочные знаки (*).";
PreferSlowCiphers.pfm_title = "Предпочитать определенные алгоритмы шифрования для TLS";
PreferSlowCiphers.pfm_description = "cnsa - Предпочитать шифры, соответствующие требованиям CNSA 1.0 и 2.0\ndefault - Использовать стандартный порядок шифров Brave\nПравило настраивает Brave так, чтобы в TLS 1.3 алгоритмы шифрования упорядочивались с учетом приоритета тех, которые одобрены по определенному стандарту соответствия.\n\nЭто правило не гарантирует, что будут согласованы определенные алгоритмы.\n\nС его помощью операторы сервера могут поддерживать клиенты как с требованиями к соответствию, так и без них и применять отдельные нестандартные алгоритмы с повышенной криптографической стойкостью только для тех, которые настроены отдавать предпочтение этим алгоритмам.\n\nПравило с заданным значением \"cnsa\" настраивает Brave так, чтобы предпочтение отдавалось шифрам в соответствии с алгоритмами Commercial National Security Algorithm Suite 1.0 и 2.0 (CNSA 1.0 и 2.0).\n\nЕсли правило не настроено или установлено значение \"default\", Brave будет использовать стандартные шифры.\n\nПравило необязательно для обеспечения безопасности. Криптография, которую Brave использует по умолчанию, достаточно надежна, чтобы противостоять атаке методом подбора с максимально возможной мощностью.\n\nЕсли настроить это правило, скорость работы Brave при просмотре сайтов снизится.\n\nПравило затрагивает только TLS 1.3 и QUIC; оно не касается более ранних версий TLS.\n\nЕго можно настроить как для устройства, так и для пользователя. Если правило настроено для пользователя, оно влияет на сетевые запросы только от его профиля и может не влиять на сетевые запросы, отправленные Brave для выполнения фоновых задач в браузере. Такие запросы контролируются на уровне устройства. Если правило настроено как для устройства, так и для пользователя, применяется значение, заданное на уровне устройства (если только приоритет правил не изменен правилом CloudUserPolicyOverridesCloudMachinePolicy).\n\nВ версии 155 и более ранних это правило действует только на уровне устройства.";
PreferSlowKexAlgorithms.pfm_title = "Предпочитать определенные алгоритмы обмена ключами для TLS";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - Предпочитать методы обмена ключами, соответствующие требованиям CNSA 2.0\ndefault - Использовать стандартные поддерживаемые группы Brave\nПравило настраивает Brave так, чтобы в TLS 1.3 алгоритмы согласования ключей (поддерживаемые группы) упорядочивались с учетом приоритета тех, которые одобрены по определенному стандарту соответствия.\n\nЭто правило не гарантирует, что будут согласованы определенные алгоритмы.\n\nС его помощью операторы сервера могут поддерживать клиенты как с требованиями к соответствию, так и без них и применять отдельные нестандартные алгоритмы с повышенной криптографической стойкостью только для тех, которые настроены отдавать предпочтение этим алгоритмам.\n\nПравило с заданным значением \"cnsa2\" настраивает Brave так, чтобы предпочтение отдавалось методам обмена ключами в соответствии с алгоритмами Commercial National Security Algorithm Suite 2.0 (CNSA 2.0).\n\nЕсли правило не настроено или задано значение \"default\", Brave будет использовать стандартные методы обмена ключами.\n\nПравило необязательно для обеспечения безопасности. Криптография, которую Brave использует по умолчанию, достаточно надежна, чтобы противостоять атаке методом подбора с максимально возможной мощностью.\n\nЕсли настроить это правило, скорость работы Brave при просмотре сайтов снизится.\n\nПравило затрагивает только TLS 1.3 и QUIC; оно не касается более ранних версий TLS.\n\nЕго можно настроить как для устройства, так и для пользователя. Если правило настроено для пользователя, оно влияет на сетевые запросы только от его профиля и может не влиять на сетевые запросы, отправленные Brave для выполнения фоновых задач в браузере. Такие запросы контролируются на уровне устройства. Если правило настроено как для устройства, так и для пользователя, применяется значение, заданное на уровне устройства (если только приоритет правил не изменен правилом CloudUserPolicyOverridesCloudMachinePolicy).\n\nВ версии 155 и более ранних это правило действует только на уровне устройства.";
PrefetchWithServiceWorkerEnabled.pfm_title = "Разрешить предзагрузку SpeculationRules для URL, управляемых ServiceWorker";
PrefetchWithServiceWorkerEnabled.pfm_description = "Предзагрузка SpeculationRules может выполняться для URL, контролируемых ServiceWorker. В версиях прошлого поколения упреждающие запросы автоматически отменялись, но теперь данное правило позволяет управлять работой предзагрузки.\n\nЕсли оно включено или не настроено, предзагрузка SpeculationRules будет по умолчанию разрешена для URL, контролируемых ServiceWorker (если флаг функции PrefetchServiceWorker активирован), что соответствует текущим стандартам.\n\nЕсли правило отключено, предзагрузка SpeculationRules для этих URL блокируется. Так работали предыдущие версии.\n\nЭто правило временное и в дальнейшем будет отменено.";
PrintHeaderFooter.pfm_title = "Печатать колонтитулы";
PrintHeaderFooter.pfm_description = "Если правило включено, в диалоговом окне предварительного просмотра при печати будут отображаться колонтитулы. Если правило отключено, они не будут отображаться.\n\nЕсли правило настроено, пользователи не могут изменить его. В противном случае пользователи могут самостоятельно решить, печатать ли колонтитулы.";
PrintPdfAsImageAvailability.pfm_title = "Наличие параметра \"Печатать как изображение\" для PDF";
PrintPdfAsImageAvailability.pfm_description = "Задает наличие параметра \"Печатать как изображение\" при печати PDF через Brave в Microsoft® Windows® и macOS.\n\nЧтобы получить правильный результат при печати PDF в Microsoft® Windows® или macOS на некоторых принтерах, документ требуется преобразовать в растровое изображение.\n\nКогда правило включено, в предварительном просмотре при печати PDF в Brave отображается параметр \"Печатать как изображение\".\n\nЕсли правило отключено или не настроено, параметр \"Печатать как изображение\" в предварительном просмотре при печати PDF в Brave не отображается и документ печатается без растеризации.";
PrintPdfAsImageDefault.pfm_title = "Параметр по умолчанию \"Печатать как изображение\" для PDF";
PrintPdfAsImageDefault.pfm_description = "Определяет, выбирать ли по умолчанию параметр \"Печатать как изображение\" в предварительном просмотре при печати PDF в Brave.\n\nЕсли правило включено, в предварительном просмотре при печати PDF в Brave по умолчанию будет выбран параметр \"Печатать как изображение\".\n\nЕсли правило отключено или не настроено, параметр \"Печатать как изображение\" в Brave будет изначально не выбран.  Пользователи могут самостоятельно решать, использовать ли этот параметр для каждого отдельного задания печати PDF.\n\nВ Microsoft® Windows® и macOS это правило применяется, только если включено правило PrintPdfAsImageAvailability.";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "Использовать системный принтер по умолчанию";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "Если правило включено, Brave использует в режиме предварительного просмотра системный принтер по умолчанию.\n\nЕсли правило отключено или не настроено, Brave использует в режиме предварительного просмотра последний выбранный принтер.";
PrintRasterizePdfDpi.pfm_title = "Разрешение растрового PDF для печати";
PrintRasterizePdfDpi.pfm_description = "Определяет разрешение изображения при печати PDF в растровом формате в Brave.\n\nЕсли выбрать параметр \"Печатать как изображение\", PDF можно распечатать с разрешением, отличным от установленного в настройках принтера или заданного для PDF по умолчанию.  При высоком разрешении существенно увеличивается время обработки и печати изображения, а при низком – снижается его качество.\n\nЭто правило позволяет указать разрешение для растеризации PDF при печати.\n\nЕсли правило не настроено или для него установлено значение ноль, при растеризации картинок используется системное разрешение по умолчанию.";
PrinterTypeDenyList.pfm_title = "Отключить типы принтеров, добавленные в список недопустимых";
PrinterTypeDenyList.pfm_description = "privet - Принтеры, работающие по протоколам без конфигурации (mDNS и DNS-SD) (поддержка прекращена)\nextension - Принтеры расширений\npdf - Варианты \"Сохранить как PDF\" и \"Сохранить на Google Диске\" на устройствах Google Chrome OS\nlocal - Локальные принтеры\ncloud - Google Cloud Print (больше не поддерживается)\nТипы принтеров, добавленные в список недопустимых, станут невидимыми, и ими нельзя будет воспользоваться.\n\nЕсли добавить в список все типы принтеров, функция печати будет недоступна, так как не останется устройств, на которые можно отправить документ.\n\nВ версиях до 102-й, добавив параметр cloud в список недопустимых, вы получите тот же результат, что и при установке значения False для правила CloudPrintSubmitEnabled. Чтобы принтеры, подключенные к сервису \"Google Cloud Print\", были доступны для печати, убедитесь, что для правила CloudPrintSubmitEnabled задано значение True, а в списке недопустимых принтеров нет параметра cloud. В версии 102 и выше сервис \"Google Cloud Print\" не поддерживается. Он не будет отображаться вне зависимости от значения правила.\n\nЕсли правило не настроено или список устройств пуст, для печати доступны все типы принтеров.\n\nК принтерам расширений, то есть к сервисам печати, относятся все принтеры расширений Brave.\n\nК локальным принтерам, то есть к принтерам оригинальной печати, относятся принтеры, доступные для локального компьютера, а также принтеры общей сети.";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "Ограничить режим печати фоновых цветов и изображений";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - Разрешить печать как с фоновыми цветами и изображениями, так и без них\nenabled - Разрешить печать только с фоновыми цветами и изображениями\ndisabled - Разрешить печать только без фоновых цветов и изображений\nОграничивает режим печати фоновых цветов и изображений. Если значение не задано, ограничение не действует.";
PrintingBackgroundGraphicsDefault.pfm_title = "Режим печати фоновых цветов и изображений по умолчанию";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - Включить режим печати фоновых цветов и изображений по умолчанию\ndisabled - Отключить режим печати фоновых цветов и изображений по умолчанию\nПереопределяет режим печати фоновых цветов и изображений по умолчанию.";
PrintingEnabled.pfm_title = "Включить печать";
PrintingEnabled.pfm_description = "Если правило включено или не настроено, печать файлов из Brave разрешена, и пользователи не могут изменить эту настройку.\n\nЕсли правило отключено, пользователи не могут печатать из Brave. Печать будет запрещена в меню в виде трех вертикальных точек, разрешениях и приложениях JavaScript.";
PrintingPaperSizeDefault.pfm_title = "Размер страницы для печати по умолчанию";
PrintingPaperSizeDefault.pfm_description = "Переопределяет размеры страницы по умолчанию для печати.\n\nВ параметре name необходимо выбрать один из форматов, перечисленных в списке. Если необходимого размера страницы там нет, должно быть указано значение custom. Если выбрано значение custom, требуется задать свойство custom_size, которое описывает высоту и ширину в микрометрах. В противном случае значение свойства custom_size указывать не нужно. Правило, которое нарушает эти условия, игнорируется.\n\nЕсли указанный размер страницы недоступен на выбранном пользователем принтере, правило не будет учитываться.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault.";
ProfilePickerOnStartupAvailability.pfm_title = "Возможность выбора профиля при запуске";
ProfilePickerOnStartupAvailability.pfm_description = "0 - При запуске предлагается выбрать профиль\n1 - При запуске не предлагается выбрать профиль\n2 - При запуске необходимо выбрать профиль\nПравило позволяет указать, будет ли предлагаться или требоваться выбор профиля при запуске.\n\nПо умолчанию окно выбора профиля не появляется, если: браузер открыт в гостевом режиме или в режиме инкогнито; каталог профиля и/или URL указаны с помощью командной строки; пользователь в явной форме запросил открытие приложения; браузер запущен через нативное уведомление; на устройстве доступен только один профиль; для правила ForceBrowserSignin установлено значение True.\n\nЕсли установлено значение Enabled (0) или правило не настроено, окно выбора профиля открывается при запуске по умолчанию. Пользователи смогут изменить эту настройку.\n\nЕсли задано значение Disabled (1), окно выбора профиля никогда не будет появляться. Пользователи не смогут изменить эту настройку.\n\nЕсли установлено значение Forced (2), пользователи не смогут закрыть окно, пока не сделают выбор. Оно будет появляться, даже если доступен только один профиль.";
ProfileReauthPrompt.pfm_title = "Предлагать пройти повторную аутентификацию в профиле";
ProfileReauthPrompt.pfm_description = "0 - Не предлагать пройти повторную аутентификацию\n1 - Предлагать пройти повторную аутентификацию на вкладке\nЕсли правило не настроено или для него задано значение DoNotPrompt, пользователю не будет автоматически предлагаться пройти повторную аутентификацию в Brave.\n\nЕсли установлено значение PromptInTab, при окончании периода аутентификации сразу же открывается новая вкладка со страницей входа в аккаунт Google. Это происходит, только если используется Chrome Sync.";
ProfileSeparationDomainExceptionList.pfm_title = "Белый список дополнительных доменов для создания отдельного корпоративного профиля";
ProfileSeparationDomainExceptionList.pfm_description = "Если правило не настроено, при входе в аккаунт пользователю не придется создавать отдельный профиль.\n\nЕсли правило настроено, при входе в аккаунт из перечисленных доменов пользователю не придется создавать отдельный профиль.\n\nВ качестве значения правила можно задать пустую строку. В этом случае при каждом входе в аккаунт пользователь должен будет создавать отдельный профиль.";
PromotionsEnabled.pfm_title = "Включить показ рекламного контента";
PromotionsEnabled.pfm_description = "Если выбрано значение True или правило не настроено, Brave может показывать пользователям рекламный контент.\n\nЕсли задано значение False, Brave не показывает такие материалы.\n\nЭто правило позволяет настроить показ рекламного контента, в том числе на стартовых страницах с информацией о том, как войти в Brave, сделать Brave браузером по умолчанию и пользоваться другими функциями.";
PromptForDownloadLocation.pfm_title = "Перед скачиванием спрашивать, где сохранить файл";
PromptForDownloadLocation.pfm_description = "Если правило включено, то при скачивании каждого файла пользователь должен указать, в какой каталог его сохранить. Если правило выключено, скачивание выполняется без запроса каталога для сохранения.\n\nЕсли правило не настроено, пользователи могут выбрать каталог, в который всегда будут скачиваться файлы.";
PromptOnMultipleMatchingCertificates.pfm_title = "Запрашивать, если подходит несколько сертификатов";
PromptOnMultipleMatchingCertificates.pfm_description = "Это правило определяет, запрашивать ли выбор сертификата клиента, если AutoSelectCertificateForUrls соответствует несколько сертификатов.\nЕсли правило включено, пользователю предлагается выбрать один из сертификатов клиента, соответствующих правилу автоматического выбора.\nЕсли правило отключено или не настроено, пользователю предлагается указать сертификат, только когда нет сертификатов, соответствующих правилу автоматического выбора.";
ProxySettings.pfm_title = "Настройки прокси-сервера";
ProxySettings.pfm_description = "Правило позволяет задать настройки прокси-сервера для Chrome и ARC-приложений, игнорируя все настройки прокси, указанные с помощью командной строки.\n\nЕсли правило не задано, пользователи могут самостоятельно настраивать прокси-сервер.\n\nДля ProxySettings можно указать значения следующих полей:\n\n* ProxyMode. Позволяет задать прокси-сервер для Chrome и запретить пользователям изменять эти настройки.\n\n* ProxyPacUrl. В этом поле можно указать URL PAC-файла прокси-сервера или PAC-скрипт, закодированный как URL-адрес данных с MIME-типом application/x-ns-proxy-autoconfig.\n\n* ProxyPacMandatory. Не дает сетевому стеку выполнять прямое подключение, когда PAC-скрипт недоступен или недействителен.\n\n* ProxyServer. Здесь можно указать URL прокси-сервера.\n\n* ProxyBypassList. Позволяет задать список хостов, подключение к которым будет выполняться в обход прокси-сервера.\n\nПоле ProxyServerMode заменено полем ProxyMode. Выбор значения для ProxyMode:\n\n* direct. Прокси-сервер не используется никогда, а значения остальных полей игнорируются.\n\n* system. Действуют системные настройки прокси-сервера. Значения остальных полей игнорируются.\n\n* auto_detect. Значения остальных полей игнорируются.\n\n* fixed_servers. Используются поля ProxyServer и ProxyBypassList.\n\n* pac_script. Используются поля ProxyPacUrl, ProxyPacMandatory и ProxyBypassList.\n\nПримечание. Подробные примеры использования можно найти на странице https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=ProxySettings.";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "Включить генератор QR-кодов";
QRCodeGeneratorEnabled.pfm_description = "Это правило активирует генератор QR-кодов в Brave.\n\nЕсли правило включено или не настроено, генератор QR-кодов включен.\n\nЕсли правило отключено, генератор QR-кодов отключен.";
QuicAllowed.pfm_title = "Разрешить использование протокола QUIC";
QuicAllowed.pfm_description = "Если правило включено или не настроено, в Brave разрешено использование протокола QUIC.\n\nЕсли правило отключено, использование протокола QUIC запрещено.";
RegisteredProtocolHandlers.pfm_title = "Регистрировать обработчики протоколов";
RegisteredProtocolHandlers.pfm_description = "Правило позволяет зарегистрировать список обработчиков протоколов (только рекомендательно). Эти обработчики будут работать наряду с теми, которые зарегистрированы пользователем. Задайте свойство protocol в соответствии с протоколом (например, можно указать значение mailto) и свойство url в соответствии с шаблоном URL для приложения, которое обрабатывает протокол. Шаблон может содержать макрос %s, который заменяется обрабатываемым URL.\n\nПользователи не могут удалять обработчики протоколов, зарегистрированные в правиле, но могут менять их, устанавливая новый обработчик как вариант по умолчанию.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers.";
RelaunchFastIfOutdated.pfm_title = "Период (дни)";
RelaunchFastIfOutdated.pfm_description = "Правило определяет минимальный срок, после которого уведомления о перезапуске начинают приходить чаще. Период рассчитывается со времени последнего предоставления текущей версии клиентам.\n\nЕсли для завершения обновления нужно перезапустить браузер или устройство, а с выхода новой версии прошло больше дней, чем определено этим правилом, то значение правила RelaunchNotificationPeriod меняется на 2 часа. Если для правила RelaunchNotification выбрано значение 1 (\"Требуется\"), по истечении указанного периода браузер или устройство перезапустятся автоматически.\n\nЕсли правило не настроено или определить время выхода новой версии не удается, правило RelaunchNotificationPeriod применяется ко всем обновлениям.";
RelaunchNotification.pfm_title = "Уведомлять пользователя о том, что рекомендуется или требуется перезапустить браузер или устройство";
RelaunchNotification.pfm_description = "1 - Уведомлять пользователя о том, что рекомендуется перезапустить браузер\n2 - Уведомлять пользователя о необходимости перезапустить браузер\nУведомляет пользователя о том, что для установки обновления необходимо перезапустить браузер Brave или устройство Google Chrome OS.\n\n Это правило регулирует уведомления о том, что рекомендуется или необходимо перезапустить браузер или устройство. Если правило не настроено, узнать о необходимости перезапуска можно по небольшим изменениям в меню Brave, тогда как на устройстве Google Chrome OS для этого используются уведомления. Если задано значение \"Рекомендуется\", пользователь будет получать уведомления, но действие можно откладывать. Если задано значение \"Требуется\", пользователь будет получать предупреждение о том, что браузер перезапустится автоматически, когда истечет срок показа уведомлений. По умолчанию он равен семи дням для браузера Brave и четырем дням для устройств Google Chrome OS. Срок можно изменить в настройках правила RelaunchNotificationPeriod.\n\nПосле перезапуска сеанс пользователя восстанавливается.";
RelaunchNotificationPeriod.pfm_title = "Период времени (мс)";
RelaunchNotificationPeriod.pfm_description = "Позволяет установить период в миллисекундах, в течение которого пользователь будет получать уведомления о том, что для установки обновления нужно перезапустить браузер Brave или устройство с Google Chrome OS.\n\nНа устройстве с Google Chrome OS уведомления о необходимости перезапуска появляются в области уведомлений в соответствии с правилом RelaunchHeadsUpPeriod. В браузере Brave изменяется меню: это происходит по истечении трети заданного периода. Уведомление меняет цвет по истечении двух третей периода и в конце периода. Дополнительные уведомления, которые регулируются правилом RelaunchNotification, появляются по такой же схеме.\n\nЕсли правило не настроено, используется период по умолчанию – 604 800 000 миллисекунд (одна неделя).";
RelaunchWindow.pfm_title = "Временной интервал перезапуска";
RelaunchWindow.pfm_description = "Укажите временной интервал для окончания периода уведомления о перезапуске.\n\nПользователи будут получать уведомление о том, что требуется перезапустить браузер или устройство, на основе настроек правила RelaunchNotification и RelaunchNotificationPeriod. Если для правила RelaunchNotification задано значение \"Требуется\", то по окончании периода уведомления браузеры и устройства будут принудительно перезапущены. С помощью правила RelaunchWindow можно отложить окончание периода уведомления на определенное время.\n\nЕсли это правило не настроено, то временной интервал перезапуска по умолчанию для Google Chrome OS – с 02:00 до 04:00, а для Brave – весь день (то есть перезапуск не откладывается).\n\nПримечание. В поле entries можно указать несколько значений, но учитываться будет только первое из них.\nПредупреждение. Из-за этого правила обновления ПО могут устанавливаться дольше.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=RelaunchWindow.";
RemoteAccessHostAllowClientPairing.pfm_title = "Включает/отключает аутентификацию без PIN-кода для хостов удаленного доступа";
RemoteAccessHostAllowClientPairing.pfm_description = "Если правило включено или не настроено, пользователи могут связывать хосты с клиентами во время подключения без необходимости вводить PIN-код каждый раз.\n\nЭта функция недоступна, если правило отключено.";
RemoteAccessHostAllowFileTransfer.pfm_title = "Разрешить пользователям с удаленным доступом переносить файлы с хоста и обратно";
RemoteAccessHostAllowFileTransfer.pfm_description = "Если правило включено или не настроено, то пользователи, подключенные к хосту удаленного доступа, могут перемещать файлы между клиентом и хостом. Это правило не действует для подключений удаленной поддержки, не поддерживающих передачу файлов.\n\nЕсли правило отключено, передача файлов невозможна.";
RemoteAccessHostAllowPinAuthentication.pfm_title = "Разрешить хосту удаленного доступа использовать аутентификацию с помощью PIN-кода и сопряжения";
RemoteAccessHostAllowPinAuthentication.pfm_description = "Если правило включено, хост удаленного доступа может использовать аутентификацию с помощью PIN-кода или сопряжения при приеме подключений от клиентов.\n\nЕсли правило отключено, аутентификация с помощью PIN-кода или сопряжения запрещена.\n\nЕсли правило не настроено, хост удаленного доступа будет определять, использовать ли аутентификацию с помощью PIN-кода или сопряжения.\n\nОбратите внимание, что если у хоста и клиента нет общих поддерживаемых способов аутентификации, то подключение установлено не будет.";
RemoteAccessHostAllowRelayedConnection.pfm_title = "Разрешить использование серверов ретрансляции хостами удаленного доступа";
RemoteAccessHostAllowRelayedConnection.pfm_description = "Если правило RemoteAccessHostFirewallTraversal не выключено, то включенное или ненастроенное правило RemoteAccessHostAllowRelayedConnection позволяет удаленным клиентам устанавливать соединение с этим компьютером через серверы ретрансляции, когда не удается подключиться напрямую (например, из-за ограничений брандмауэра).\n\nЕсли правило отключено, то удаленный доступ разрешен, но подключаться можно только из той же сети. При этом ретрансляция и протокол NAT Traversal недоступны.";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "Разрешить удаленные подключения к этому устройству";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "Если правило отключено, сервис удаленного доступа невозможно запустить или настроить для того, чтобы принимать входящие подключения.  Это правило не влияет на сценарии удаленной поддержки.\n\nПравило не будет действовать, если оно включено, не настроено или для него указано пустое значение.";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "Разрешить подключения удаленной поддержки к этому устройству";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "Если правило отключено, невозможно запустить хост удаленной поддержки и разрешить в нем входящие соединения.\n\nЭто правило не влияет на сценарии удаленного доступа\n\nи не запрещает администраторам организации подключаться к управляемым устройствам Google Chrome OS.\n\nПравило не будет действовать, если оно включено, не настроено или для него указано пустое значение.";
RemoteAccessHostAllowUrlForwarding.pfm_title = "Разрешить пользователям с удаленным доступом открывать URL с хоста в браузере локального клиента";
RemoteAccessHostAllowUrlForwarding.pfm_description = "Если правило включено или не настроено, пользователи, подключенные к хосту удаленного доступа, могут открывать URL с хоста, используя браузер локального клиента.\n\nЕсли правило отключено, хост удаленного доступа не может отправлять URL клиенту.\n\nПравило не действует для подключений удаленной поддержки, так как в этом режиме указанная возможность не поддерживается.\n\nПримечание. Эта функция пока доступна не всем, поэтому после включения она может быть не видна в интерфейсе клиента.";
RemoteAccessHostClientDomainList.pfm_title = "Настроить обязательные доменные имена для клиентов удаленного доступа";
RemoteAccessHostClientDomainList.pfm_description = "Правило позволяет указать доменные имена для клиентов удаленного доступа и запрещает пользователям их менять. К хосту могут подключаться только клиенты из указанных доменов.\n\nЕсли правило не настроено или в качестве значения указан пустой список, к типу подключения применяется правило по умолчанию. При этом для удаленной поддержки к хосту могут подключаться клиенты из любых доменов. Для удаленного доступа в любое время может подключаться только владелец хоста.\n\nСм. также RemoteAccessHostDomainList.\n\nЭто правило переопределяет правило RemoteAccessHostClientDomain, если оно настроено.";
RemoteAccessHostClipboardSizeBytes.pfm_title = "Максимальный размер данных (в байтах), которые можно передавать между клиентом и хостом с помощью синхронизации буфера обмена";
RemoteAccessHostClipboardSizeBytes.pfm_description = "Если правило настроено, данные буфера обмена, передаваемые между клиентом и хостом, обрезаются в соответствии с заданным ограничением.\n\nЕсли указано значение 0, синхронизация буфера обмена отключена.\n\nЭто правило распространяется как на удаленный доступ, так и на удаленную поддержку.\n\nЕсли правило не настроено, оно не работает.\n\nЕсли вы укажете значение, выходящее за пределы допустимого диапазона, это может помешать запуску хоста.\n\nОбратите внимание, что фактическая верхняя граница для размера буфера обмена не контролируется правилом и зависит от максимального размера сообщения в канале передачи данных WebRTC.";
RemoteAccessHostDomainList.pfm_title = "Настроить доменные имена для хостов удаленного доступа";
RemoteAccessHostDomainList.pfm_description = "Правило позволяет указать доменные имена для хостов удаленного доступа и запрещает пользователям их менять. Предоставлять доступ к хостам можно только из аккаунтов, зарегистрированных в указанных доменах.\n\nЕсли правило не настроено или в качестве значения указан пустой список, доступ к хостам может быть предоставлен из любого аккаунта.\n\nСм. также RemoteAccessHostClientDomainList.\n\nЭто правило переопределяет правило RemoteAccessHostDomain, если оно настроено.";
RemoteAccessHostFirewallTraversal.pfm_title = "Включить обход брандмауэра для хоста удаленного доступа";
RemoteAccessHostFirewallTraversal.pfm_description = "Если правило включено или не задано, можно будет использовать серверы STUN. Удаленные клиенты смогут находить это устройство и подключаться к нему, даже когда используется брандмауэр.\n\nЕсли отключить правило при условии, что все исходящие UDP-подключения фильтруются брандмауэром, к этому компьютеру можно будет подключаться только с клиентских устройств в локальной сети.";
RemoteAccessHostMatchUsername.pfm_title = "Требовать, чтобы имена локального пользователя и владельца хоста удаленного доступа совпадали";
RemoteAccessHostMatchUsername.pfm_description = "Если правило включено, хост удаленного доступа сравнивает имя связанного с ним локального пользователя с названием аккаунта Google, принадлежащего владельцу хоста (например, ivanpetrov, если хост принадлежит аккаунту ivanpetrov@example.com). Хост не запустится, если имена владельца и локального пользователя не совпадут. Чтобы также связать аккаунт Google, принадлежащий владельцу хоста, с определенным доменом (например, example.com), используйте это правило вместе с правилом RemoteAccessHostDomain.\n\nЕсли правило отключено или не настроено, хост удаленного доступа может быть связан с любым локальным пользователем.";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "Максимальная длительность сеанса удаленного подключения";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "Если правило включено, удаленное подключение автоматически разъединяется по истечении определенного числа минут, указанного в правиле. Это правило не предотвращает повторное подключение пользователей по достижении максимальной длительности сеанса. Если вы укажете в правиле значение, выходящее за пределы минимального или максимального диапазона, это может помешать запуску хоста. Это правило не влияет на сценарии удаленной поддержки.\n\nЕсли правило не установлено, оно не работает. В таком случае продолжительность сеансов удаленного подключения не будет ограничена на этом компьютере.";
RemoteAccessHostRequireCurtain.pfm_title = "Блокирование хостов при удаленном доступе";
RemoteAccessHostRequireCurtain.pfm_description = "Если правило включено, физические устройства ввода и вывода хостов удаленного доступа во время соединения будут отключены.\n\nЕсли правило отключено или не задано, то и локальные, и удаленные пользователи могут взаимодействовать с хостом, когда он работает в режиме общего доступа.";
RemoteAccessHostUdpPortRange.pfm_title = "Ограничить диапазон портов UDP, используемых хостами удаленного доступа";
RemoteAccessHostUdpPortRange.pfm_description = "Правило позволяет ограничить диапазон UDP-портов, используемых хостами удаленного доступа на этом компьютере.\n\nЕсли правило не настроено или в качестве значения указана пустая строка, для удаленного доступа можно будет использовать любой доступный порт.\n\nЕсли правило RemoteAccessHostFirewallTraversal отключено, будет разрешено использование UDP-портов в диапазоне от 12 400 до 12 409.";
RemoteDebuggingAllowed.pfm_title = "Разрешить удаленную отладку";
RemoteDebuggingAllowed.pfm_description = "Определяет, могут ли пользователи выполнять удаленную отладку.\n\nЕсли правило включено или не задано, пользователи могут выполнять удаленную отладку, указав параметры командной строки --remote-debugging-port и --remote-debugging-pipe на компьютере или включив системную настройку \"Отладка по USB\" на устройстве Android.\n\nЕсли правило отключено, пользователям запрещено выполнять удаленную отладку.";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "Настроить обязательное выполнение онлайн-проверок OCSP/CRL для локальных якорей доверия";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "Если для правила задано значение True, Brave будет всегда проверять, не был ли отозван сертификат сервера, успешно прошедший проверку и подписанный локальным сертификатом ЦС. Если Brave не сможет получить сведения о статусе сертификата, то Brave будет считать его отозванным.\n\nЕсли правило не настроено или задано значение False, Brave будет использовать текущие настройки проверки.\n\nЭто правило не действует в macOS, если для правила ChromeRootStoreEnabled задано значение False.";
RestoreOnStartup.pfm_title = "Действие при запуске";
RestoreOnStartup.pfm_description = "5 - Открыть страницу быстрого доступа\n1 - Восстановить последний сеанс\n4 - Открыть одну или несколько страниц\n6 - Открыть список URL и восстановить последний сеанс\nЕсли правило задано, можно настроить процесс запуска системы. Если оно отключено, при запуске браузер Brave будет работать в стандартном режиме.\n\nЕсли правило настроено, пользователи не могут изменить этот параметр в Brave. В противном случае пользователи смогут вносить изменения.\n\nПри выборе значения RestoreOnStartupIsLastSession или RestoreOnStartupIsLastSessionAndURLs будут отключены некоторые функции, такие как удаление данных о работе в браузере или сессионных файлов cookie при завершении работы.\n\nЕсли для правила указано значение RestoreOnStartupIsLastSessionAndURLs, браузер будет восстанавливать предыдущий сеанс и открывать URL, заданные в правиле RestoreOnStartupURLs, в отдельном окне. Обратите внимание, что если пользователь не закроет страницы с этими URL, то они также будут восстановлены в новом сеансе.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе \"Chrome Enterprise Core\".";
RestoreOnStartupURLs.pfm_title = "URL, открывающиеся при запуске";
RestoreOnStartupURLs.pfm_description = "Если для правила RestoreOnStartup задано значение RestoreOnStartupIsURLs, вы можете уточнить, какие URL необходимо открывать. Для этого укажите в правиле RestoreOnStartupURLs список URL.\n\nВ противном случае при запуске будет открываться страница быстрого доступа.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе Chrome Enterprise Core.\n\nВ macOS это правило можно настроить только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе Chrome Enterprise Core.";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "Ограничить доступ к Background Fetch API при вызове из скриптов Service Worker";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "Определяет, могут ли скрипты Service Worker запрашивать фоновое извлечение. Это правило позволяет ограничивать работу функций, которые скачивают файлы в фоновом режиме.\n\nЕсли оно включено или не настроено, ограничение действует, и запросы на фоновое извлечение от скриптов Service Worker могут блокироваться.\n\nЕсли правило отключено, ограничение не действует, и все скрипты Service Worker могут запрашивать фоновое извлечение.\n\nЭто корпоративное правило введено на время и будет удалено после выхода версии M152.";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "Ограничить число аккаунтов Google, в которых PDF-файлы можно сохранять на Google Диск из Brave PDF Viewer";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "Содержит регулярное выражение, которое позволяет определить, в каких аккаунтах Google можно сохранять на Google Диск PDF-файлы из Brave PDF Viewer.\n\nПри попытке загрузить PDF-файл на Google Диск, используя аккаунт, который не соответствует указанному шаблону, появится сообщение об ошибке.\n\nЕсли правило не настроено или регулярное выражение не задано, пользователь может сохранять PDF-файлы на Google Диск через любой аккаунт Google.";
RestrictSigninToPattern.pfm_title = "Определяет, какой аккаунт Google можно назначить основным в Brave";
RestrictSigninToPattern.pfm_description = "Содержит регулярное выражение, которое позволяет определить, какой аккаунт Google можно назначить в качестве основного в Brave (т. е. аккаунта, который выбирается при включении синхронизации).\n\nЕсли имя пользователя не соответствует установленным значениям, при попытке сделать аккаунт основным будет появляться сообщение об ошибке.\n\nЕсли это правило не настроено или значения для него отсутствуют, пользователь может выбрать любой аккаунт Google и назначить его основным в Brave.";
RestrictYouTubeCookiesDeletion.pfm_title = "Ограничить удаление файлов cookie для YouTube";
RestrictYouTubeCookiesDeletion.pfm_description = "Запрещает удалять вручную файлы cookie для YouTube.\n\nЭто правило запрещает пользователям получать доступ к неавторизованным аккаунтам YouTube после того, как они вручную удалят файлы cookie для YouTube на странице настроек сайта.\n\nЕсли правило включено, файлы cookie YouTube нельзя удалить вручную.\n\nЕсли правило отключено или не настроено, файлы cookie YouTube можно удалять обычным способом.\n\nПримечание. Это правило запрещает удалять файлы cookie только вручную через настройки сайта. Оно не блокирует их автоматическое удаление в соответствии с правилами ClearBrowsingDataOnExitList или BrowsingDataLifetime. Кроме того, если правило AllowDeletingBrowserHistory включено, пользователи по-прежнему могут удалять все свои файлы cookie в диалоговом окне \"Удалить данные о работе в браузере\".";
SSLErrorOverrideAllowed.pfm_title = "Разрешить переход со страницы предупреждения SSL";
SSLErrorOverrideAllowed.pfm_description = "Если правило включено или не задано, пользователи могут пропускать страницы предупреждений, которые Brave показывает им, когда они посещают сайты с ошибками SSL.\n\nЕсли правило отключено, пропустить предупреждение нельзя.";
SSLErrorOverrideAllowedForOrigins.pfm_title = "Разрешить пропуск предупреждений об ошибках SSL на определенных страницах";
SSLErrorOverrideAllowedForOrigins.pfm_description = "Если правило SSLErrorOverrideAllowed отключено, то с помощью этого правила можно задать список шаблонов источников для сайтов, где пользователь может пропускать страницы предупреждений, которые Brave показывает, когда появляются ошибки SSL. Пользователи не смогут пропускать страницы предупреждений об ошибках SSL на сайтах, которых нет в этом списке.\n\nЕсли правило SSLErrorOverrideAllowed включено или не настроено, это правило игнорируется.\n\nЕсли правило не настроено, для всех сайтов действует правило SSLErrorOverrideAllowed.\n\nПодробнее о допустимых шаблонах: https://chromeenterprise.google/policies/url-patterns. В этом правиле нельзя использовать подстановочный знак \"*\". Оно работает только с адресами сайтов-источников, поэтому пути в шаблонах URL не учитываются.";
SafeBrowsingAllowlistDomains.pfm_title = "Настроить список доменов, в которых Безопасный просмотр не будет показывать уведомления об угрозах.";
SafeBrowsingAllowlistDomains.pfm_description = "Если правило включено, Безопасный просмотр будет доверять доменам, которые вы укажете. Они не будут проверяться на наличие фишинга, вредоносного или нежелательного ПО и других угроз. Безопасный просмотр не будет проверять файлы, скачиваемые из этих доменов, и выявлять повторное использование паролей.\n\nЕсли правило не настроено, Безопасный просмотр будет использоваться для всех ресурсов.\n\nПравило не поддерживает регулярные выражения, хотя субдомены определенных доменов можно добавить в белый список. Полные доменные имена (FQDN) не требуются.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в программе \"Chrome Enterprise Core\".";
SafeBrowsingDeepScanningEnabled.pfm_title = "Разрешить глубокую проверку скачанных файлов, когда у пользователя включен Безопасный просмотр";
SafeBrowsingDeepScanningEnabled.pfm_description = "Если это правило включено или не настроено, Brave может отправлять подозрительные скачанные файлы в Google для проверки на наличие вредоносного ПО (при условии, что у пользователя включен Безопасный просмотр) или запрашивать пароль для зашифрованных архивов.\nЕсли правило отключено, проверка выполняться не будет.\nЭто правило не влияет на анализ скачиваемого контента, настроенный через Chrome Enterprise Connectors.";
SafeBrowsingProtectionLevel.pfm_title = "Уровень защиты Безопасного просмотра";
SafeBrowsingProtectionLevel.pfm_description = "0 - Безопасный просмотр всегда отключен\n1 - Безопасный просмотр включен в режиме стандартной защиты\n2 - Безопасный просмотр включен в режиме улучшенной защиты (в Google отправляется больше данных о работе в браузере)\nПозволяет управлять настройками Безопасного просмотра в Brave и выбирать режим защиты.\n\nЕсли установлен параметр NoProtection (значение \"0\"), Безопасный просмотр всегда отключен.\n\nЕсли указан параметр StandardProtection (значение \"1\", которое используется по умолчанию), Безопасный просмотр всегда включен в режиме стандартной защиты.\n\nЕсли выбран параметр EnhancedProtection (значение \"2\"), Безопасный просмотр всегда включен в режиме улучшенной защиты, но при этом в Google передается больше данных о работе в браузере.\n\nЕсли правило настроено как обязательное, пользователи не могут менять или переопределять настройки Безопасного просмотра в Brave.\n\nЕсли правило не настроено, Безопасный просмотр работает в режиме стандартной защиты, но пользователи могут изменить этот параметр.\n\nПодробнее о Безопасном просмотре: https://support.google.com/chrome?p=safe_browsing_preferences.";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "Разрешать Безопасному просмотру проверки через прокси-сервер в режиме реального времени";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "Разрешает или запрещает Безопасному просмотру в режиме стандартной защиты отправлять частичные хеши URL в Google через прокси-сервер по протоколу Oblivious HTTP, чтобы определять безопасность URL.\n\nПрокси-сервер позволяет браузерам загружать частичные хеши URL в Google без привязки к IP-адресу пользователя. Кроме того, правило разрешает браузерам чаще загружать частичные хеши URL. Это повышает уровень защиты Безопасного просмотра.\n\nЕсли Безопасный просмотр отключен или работает в режиме улучшенной защиты, правило не применяется.\n\nЕсли правило включено или не настроено, безопасные проверки через прокси-серверы разрешены.\n\nЕсли правило отключено, такие проверки запрещены. Частичные хеши URL будут загружаться напрямую в Google значительно реже, что снизит уровень защиты.";
SafeBrowsingSurveysEnabled.pfm_title = "Разрешить опросы о функции \"Безопасный просмотр\"";
SafeBrowsingSurveysEnabled.pfm_description = "Если это правило включено или не настроено, пользователю могут приходить опросы о функции \"Безопасный просмотр\".\nЕсли правило отключено, пользователь не будет получать такие опросы.";
SafeSitesFilterBehavior.pfm_title = "Управлять фильтрацией контента только для взрослых SafeSites";
SafeSitesFilterBehavior.pfm_description = "0 - Не фильтровать сайты, содержащие контент только для взрослых\n1 - Фильтровать сайты, содержащие контент для взрослых\nЭто правило позволяет настроить URL-фильтр SafeSites. Он использует Google Safe Search API, чтобы определять, ведет ли URL на порнографический сайт.\n\nПравило работает следующим образом:\n\n– Если оно не настроено или выбран параметр \"Не фильтровать сайты, содержащие контент только для взрослых\", сайты не блокируются.\n\n– Если задан параметр \"Фильтровать сайты, содержащие контент для взрослых\", порнографические сайты блокируются.\n\nЭто правило применяется к URL, по которым переходят пользователи, и окнам iframe. Правило URLAllowlist имеет над ним приоритет и может переопределять результаты Google Safe Search API.";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "Разрешить захват вкладок одного источника этими источниками";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "Это правило позволяет задать список шаблонов URL, которые могут записывать вкладки с таким же источником.\n\nЕсли оно не настроено, сайты не будут учитываться для переопределения на этом уровне записи.\n\nОбратите внимание, что работающие в окне приложения Chrome с тем же источником, что и сайт, по-прежнему можно будет записывать.\n\nЕсли сайт соответствует шаблону URL в этом правиле, следующие правила не будут учитываться: TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins и ScreenCaptureAllowed.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns.  Это правило работает только с адресами сайтов-источников, поэтому пути в шаблонах URL не учитываются.";
SandboxExternalProtocolBlocked.pfm_title = "Разрешать Chrome блокировать переходы на внешние протоколы в изолированных окнах iframe";
SandboxExternalProtocolBlocked.pfm_description = "Chrome будет блокировать переходы на внешние протоколы в изолированном окне iframe. Подробная информация доступна на странице https://chromestatus.com/features/5680742077038592.\n\nЕсли задано значение True, Chrome будет блокировать такие переходы.\n\nЕсли установлено значение False, Chrome не сможет блокировать такие переходы.\n\nПо умолчанию выбрано значение True (функция безопасности включена).\n\nУказанную возможность могут использовать администраторы, которым нужно больше времени, чтобы обновить внутренние сайты, затронутые новым ограничением. Это корпоративное правило введено на время и будет удалено после выхода Brave версии 117.\n";
SavingBrowserHistoryDisabled.pfm_title = "Отключить сохранение истории браузера";
SavingBrowserHistoryDisabled.pfm_description = "Если это правило включено, история браузера не сохраняется, синхронизация вкладок не выполняется и пользователи не могут изменить этот параметр.\n\nЕсли правило отключено или не настроено, история браузера сохраняется.";
ScreenCaptureAllowed.pfm_title = "Разрешить или запретить показ экрана";
ScreenCaptureAllowed.pfm_description = "Если правило включено или не настроено (это значение выбрано по умолчанию), веб-страница может использовать\nAPI, предназначенные для демонстрации экрана (например, getDisplayMedia() или Desktop Capture API),\nчтобы предложить пользователю выбрать вкладку, окно или рабочий стол, который нужно показать.\n\nЕсли правило отключено, при вызове API для демонстрации экрана будет появляться\nсообщение об ошибке. Однако это правило не рассматривается (и сайт может использовать\nAPI, предназначенные для демонстрации экрана), если сайт соответствует шаблону источника в\nлюбом из следующих правил:\nScreenCaptureAllowedByOrigins,\nWindowCaptureAllowedByOrigins,\nTabCaptureAllowedByOrigins,\nSameOriginTabCaptureAllowedByOrigins.\n";
ScreenCaptureAllowedByOrigins.pfm_title = "Разрешить захват рабочего стола, окна и вкладки этими источниками";
ScreenCaptureAllowedByOrigins.pfm_description = "Правило позволяет задать список шаблонов URL, которые могут захватывать рабочий стол, окно и вкладку.\n\nЕсли правило не настроено, система не будет проверять, нужно ли переопределить значение по умолчанию для захвата выбранного типа.\n\nПравило не действует, если сайт соответствует шаблону URL в правиле WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins или SameOriginTabCaptureAllowedByOrigins.\n\nЕсли адрес сайта совпадает с шаблоном URL в ScreenCaptureAllowedByOrigins, то не учитывается правило ScreenCaptureAllowed.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns/.  При сопоставлении шаблонов с URL учитывается только название источника (путь к ресурсу на сервере игнорируется).";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "Разрешить запись экрана без предварительного жеста пользователя";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "В целях безопасности для вызова метода getDisplayMedia() веб-API пользователю нужно выполнить действие из категории \"Временная активация\" (transient activation).\n\nЕсли правило настроено, администраторы могут указывать источники, для которых разрешено вызывать этот метод API без предварительного действия.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns/. В правиле нельзя использовать подстановочный знак (*).\n\nЕсли оно не настроено, для вызова этого метода API пользователю нужно будет выполнить действие, независимо от источника.";
ScrollToTextFragmentEnabled.pfm_title = "Прокрутка до текстовых фрагментов, указанных в URL";
ScrollToTextFragmentEnabled.pfm_description = "Это правило позволяет выполнять прокрутку до определенного текста на странице при переходе по гиперссылке или URL в адресной строке.\n\nЕсли правило включено или не настроено, при переходе по URL сможет выполняться прокрутка до указанного текстового фрагмента.\n\nЕсли правило отключено, прокрутка до указанного текстового фрагмента при переходе по URL выполняться не будет.";
SearchContentSharingSettings.pfm_title = "Включить обмен контентом с интеграциями \"Google AI Mode\" и \"Lens\"";
SearchContentSharingSettings.pfm_description = "0 - Разрешить обмен контентом с интеграциями, использующими Google AI Mode\n1 - Запретить обмен контентом с интеграциями, использующими Google AI Mode\nПравило определяет, можно ли делиться с сервисами \"Google AI Mode\" и \"Lens\" содержимым страниц и файлов через боковую панель или вкладки Google Chrome.\n\nОбратите внимание, что правило не влияет на сервис \"Google AI Mode\", доступный на веб-страницах. Оно управляет только обменом данными в Google Chrome.\n\nЕсли задано значение \"0\", пользователи смогут предоставлять сервису \"Google AI Mode\" доступ к содержимому страниц и файлов.\n\nПри значении \"1\" делиться такой информацией с функцией \"Google AI Mode\" будет нельзя. Точки входа для передачи контекста и боковая панель будут отключены или скрыты.\n\nПравило игнорируется, если сервис \"Google Search\" не задан пользователем как поисковая система по умолчанию, поскольку в этом случае функция отключена.\n\nЭто правило не зависит от AIModeSettings. AIModeSettings управляет только точками входа в омнибоксе или окне поиска на странице быстрого доступа, а это правило определяет, можно ли делиться контекстом через боковую панель или вкладки.\n\nЭто правило также не влияет на интеграцию сервиса \"Google Gemini\", которая отключается с помощью GeminiSettings.\n\nЕсли это правило не настроено, применяется GenAiDefaultSettings.\n\nПодробнее о том, как обрабатываются данные при использовании функций на основе генеративного ИИ: https://support.google.com/chrome/a?p=generative_ai_settings.";
SearchSuggestEnabled.pfm_title = "Включить поисковые подсказки";
SearchSuggestEnabled.pfm_description = "Если для правила задано значение True, в адресной строке Brave при поиске будут появляться подсказки. Если указано значение False, таких подсказок не будет.\n\nЭто правило не влияет на показ в строке поиска закладок и страниц из истории просмотров.\n\nЕсли правило настроено, пользователи не могут изменить его. Если вы не настроите правило, подсказки при поиске будут включены, но пользователи смогут отключить их в любое время.";
SecurityKeyPermitAttestation.pfm_title = "URL и домены, которым разрешена автоматическая проверка электронных ключей";
SecurityKeyPermitAttestation.pfm_description = "В правиле указываются идентификаторы WebAuthn RP, для которых при запросе сертификатов подтверждения от электронных ключей не отображается диалоговое окно. Электронному ключу отправляется сигнал о том, что можно использовать корпоративное подтверждение. Если правило не настроено, пользователи Brave 65 и более поздних версий видят диалоговое окно, когда сайты запрашивают подтверждение от электронных ключей.";
SensorsAllowedForUrls.pfm_title = "Разрешение указанным сайтам доступа к датчикам";
SensorsAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL для указания сайтов, которым разрешен доступ к датчикам движения, освещенности и т. д.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultSensorsSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nЕсли определенный шаблон URL указан и в этом правиле, и в SensorsBlockedForUrls, приоритет отдается второму, а доступ к датчикам движения и освещенности блокируется.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Разрешено использовать подстановочные знаки (*).";
SensorsBlockedForUrls.pfm_title = "Запрет указанным сайтам доступа к датчикам";
SensorsBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым запрещен доступ к датчикам, отслеживающим движение, освещение и другие показатели.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultSensorsSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nЕсли определенный шаблон URL указан и в этом правиле, и в SensorsAllowedForUrls, приоритет отдается первому, а доступ к датчикам движения и освещенности блокируется.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки: *.";
SerialAllowAllPortsForUrls.pfm_title = "Автоматически разрешать сайтам подключение ко всем последовательным портам";
SerialAllowAllPortsForUrls.pfm_description = "С помощью этого правила вы можете задать список сайтов, которым будет автоматически предоставляться доступ ко всем доступным последовательным портам.\n\nНеобходимо указывать действительные URL, иначе правило будет игнорироваться. Учитывается только источник URL (схема, хост и порт).\n\nВ Google Chrome OS это правило действует только для аффилированных пользователей.\n\nПравило переопределяет правила DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls и пользовательские настройки.";
SerialAllowUsbDevicesForUrls.pfm_title = "Автоматически разрешать сайтам подключение к USB-устройствам с последовательным интерфейсом";
SerialAllowUsbDevicesForUrls.pfm_description = "С помощью этого правила вы можете задать список сайтов, которым будет автоматически предоставляться доступ к USB-устройствам с последовательным интерфейсом, в которых идентификаторы поставщика и продукта совпадают с полями vendor_id и product_id. Если не заполнить поле product_id, то сайты в списке получат разрешение на доступ к устройствам с идентификатором поставщика, указанным в поле vendor_id, и любым идентификатором продукта.\n\nНеобходимо указывать действительные URL, иначе правило будет игнорироваться. Учитывается только источник URL (схема, хост и порт).\n\nНа устройствах с Chrome OS это правило действует только для аффилированных пользователей.\n\nПравило переопределяет правила DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls и пользовательские настройки.\n\nОно влияет только на доступ к USB-устройствам через Web Serial API. Чтобы предоставить доступ к USB-устройствам через WebUSB API, понадобится правило WebUsbAllowDevicesForUrls.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls.";
SerialAskForUrls.pfm_title = "Разрешение использовать Serial API на указанных сайтах";
SerialAskForUrls.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, которым разрешено запрашивать у пользователей доступ к последовательным портам.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultSerialGuardSetting. Если не задано и оно, применяются персональные настройки пользователя.\n\nШаблоны URL, не соответствующие правилу SerialBlockedForUrls (при наличии совпадений), обрабатываются согласно правилу DefaultSerialGuardSetting или, если оно не задано, согласно персональным настройкам пользователя.\n\nШаблоны, которые противоречат шаблонам в правиле SerialBlockedForUrls, будут игнорироваться.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение \"*\" для этого правила не поддерживается.";
SerialBlockedForUrls.pfm_title = "Блокировка Serial API на указанных сайтах";
SerialBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым запрещено запрашивать у пользователей доступ к последовательным портам.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultSerialGuardSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nШаблоны URL, не соответствующие правилу SerialAskForUrls (при наличии соответствия), обрабатываются согласно правилу DefaultSerialGuardSetting или, если оно не задано, согласно персональным настройкам пользователя.\n\nЕсли шаблоны конфликтуют с правилом SerialAskForUrls, то приоритет имеет SerialBlockedForUrls.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается.";
ServiceWorkerAutoPreloadEnabled.pfm_title = "Разрешить ServiceWorker отправлять навигационные запросы до полного запуска этой функции";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nФункция ServiceWorkerAutoPreload отправляет сетевой запрос на получение основного ресурса одновременно с запуском ServiceWorker.\n\nЕсли правило включено или не настроено,\nServiceWorkerAutoPreload будет использоваться в Brave. Навигационный запрос отправляется автоматически при запуске функции ServiceWorker в ряде случаев, например если она неактивна.\n\nОтключив правило, вы запретите использовать ServiceWorkerAutoPreload в Brave. Навигационный запрос будет всегда отправляться после запуска ServiceWorker.\n\nЭто временное правило для управления функцией. Оно будет удалено в версии M154.";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "Разрешить функции ServiceWorkers управлять окнами iframe с атрибутом srcdoc";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "Пользователь в хранилище ServiceWorkers (https://github.com/w3c/ServiceWorker/issues/765) предложил использовать эту функцию, чтобы контролировать окна iframe, у которых указан атрибут sandbox со значением allow-same-origin и атрибут srcdoc.\n\nЕсли правило включено или не настроено, Brave передаст под управление функции ServiceWorkers окна iframe, использующие атрибут sandbox со значением allow-same-origin и атрибут srcdoc.\n\nПри отключенном правиле ServiceWorkers не будут контролировать окна iframe с srcdoc.\n\nЭто временное правило. Мы планируем удалить его в 2026 году.";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "Определяет, можно ли использовать SharedArrayBuffers в контексте, не изолированном от междоменных источников";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\nОпределяет, можно ли использовать объекты SharedArrayBuffer в контексте без изоляции от междоменных источников. Чтобы обеспечивать совместимость в интернете, при использовании объектов SharedArrayBuffer в Brave 91 (25.05.2021) и более поздних версиях Brave будет требоваться изоляция от междоменных источников. Дополнительную информацию можно найти на странице https://developer.chrome.com/blog/enabling-shared-array-buffer/.\n\nЕсли правило включено, сайты могут использовать объекты SharedArrayBuffer без ограничений.\n\nЕсли правило не настроено или отключено, для использования объектов SharedArrayBuffer требуется изоляция от междоменных источников.";
SharedWorkerBlobURLFixEnabled.pfm_title = "Согласовать поведение Blob URL для SharedWorker со спецификацией";
SharedWorkerBlobURLFixEnabled.pfm_description = "Согласно https://w3c.github.io/ServiceWorker/#control-and-use-worker-client, рабочие клиенты должны наследовать контроллеры для URL с BLOB-объектами.  Однако в существующем коде наследовать контроллер могут только клиенты DedicatedWorkers (не SharedWorkers).\n\nЕсли правило включено или не настроено, Brave наследует контроллер, если в URL для SharedWorker используется BLOB-объект.\n\nЕсли правило отключено, поведение не будет соответствовать прописанному в спецификации.\n\nЭто правило временное и в дальнейшем будет отменено.";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "Включить продление срока службы для SharedWorkers";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "Срок службы SharedWorkers можно продлить, если в конструкторе SharedWorker для параметра extendedLifetime установлено значение True.\n\nЕсли правило включено или не настроено, срок службы SharedWorkers может быть продлен.\n\nЕсли правило отключено, срок службы SharedWorkers не может быть продлен, при когда для параметра установлено значение True.\n\nЭто правило используется временно и будет удалено в будущем.";
ShoppingListEnabled.pfm_title = "Разрешить использовать функцию списка покупок";
ShoppingListEnabled.pfm_description = "Это правило определяет, можно ли использовать функцию списка покупок.\nЕсли оно включено, пользователям будет доступен интерфейс для отслеживания цены товара, показанного на текущей странице. Отслеживаемый товар будет отображаться в закладках на боковой панели.\nЕсли правило не настроено или включено, функция списка покупок будет доступна для пользователей.\nЕсли правило отключено, эта функция недоступна.\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "Показ ярлыков приложений в панели закладок";
ShowAppsShortcutInBookmarkBar.pfm_description = "Если для правила задано значение True, кнопка \"Сервисы\" будет видна. Если задано значение False, кнопка всегда будет скрыта.\n\nЕсли вы настроите это правило, пользователи не смогут его изменить. Если правило не настроено, пользователи смогут через контекстное меню панели закладок включать или отключать показ кнопки \"Сервисы\".";
ShowCastIconInToolbar.pfm_title = "Показывать значок Google Cast на панели инструментов";
ShowCastIconInToolbar.pfm_description = "Если правило включено, на панели инструментов или в дополнительном меню показывается значок трансляции, и пользователи не могут его убрать.\n\nЕсли правило отключено или не настроено, пользователи могут закреплять или удалять значок командами его контекстного меню.\n\nЕсли отключено правило EnableMediaRouter, то правило ShowCastIconInToolbar не действует и значок на панели инструментов не показывается.";
ShowCastSessionsStartedByOtherDevices.pfm_title = "Показывать элементы управления медиаконтентом для трансляций Google Cast, запущенных с других устройств в локальной сети";
ShowCastSessionsStartedByOtherDevices.pfm_description = "Если правило включено, для трансляций Google Cast, запущенных с других устройств в локальной сети, доступны элементы управления медиаконтентом.\n\nЕсли правило не настроено для корпоративных пользователей или отключено, для трансляций Google Cast, запущенных с других устройств в локальной сети, элементы управления медиаконтентом недоступны.\n\nЕсли выключено правило EnableMediaRouter, то это правило не действует, так как технология Google Cast полностью отключена.";
ShowFullUrlsInAddressBar.pfm_title = "Показ полных URL";
ShowFullUrlsInAddressBar.pfm_description = "Эта функция разрешает показ полного URL в адресной строке.\nЕсли у правила значение True, то в адресной строке показывается полный URL, с протоколом и субдоменами.\nЕсли значение False, то URL отображается в виде по умолчанию.\nЕсли значение не задано, URL отображается в виде по умолчанию, а пользователь может в контекстном меню выбрать вид URL в адресной строке.\n";
ShowHomeButton.pfm_title = "Отображать кнопку \"Главная страница\" на панели инструментов";
ShowHomeButton.pfm_description = "Если правило включено, кнопка главного экрана будет располагаться на панели инструментов Brave. В противном случае она будет не видна.\n\nЕсли правило задано, не удастся изменить эту настройку в Brave. В противном случае пользователи смогут добавить или скрыть кнопку главного экрана.";
SideSearchEnabled.pfm_title = "Разрешить показывать на боковой панели браузера результаты из поисковой системы по умолчанию";
SideSearchEnabled.pfm_description = "Если правило включено или не настроено, пользователи могут с помощью переключателя на панели инструментов активировать боковое окно с последними результатами из поисковой системы по умолчанию.\n\nЕсли правило отключено, этот переключатель скрыт.";
SignedHTTPExchangeEnabled.pfm_title = "Разрешить поддержку Signed HTTP Exchange (SXG)";
SignedHTTPExchangeEnabled.pfm_description = "Если правило не настроено или задано значение True, Brave загружает веб-контент, для показа которого используется технология Signed HTTP Exchange.\n\nЕсли задано значение False, такой контент не загружается.";
SigninInterceptionEnabled.pfm_title = "Включить перехват входа";
SigninInterceptionEnabled.pfm_description = "Позволяет включить или отключить перехват входа.\n\nЕсли правило включено или не настроено, диалоговое окно о перехвате входа появляется, когда пользователю может быть выгодно перенести добавленный в браузер аккаунт Google в новый или существующий профиль.\n\nЕсли правило отключено, диалоговое окно о перехвате входа не появляется.\nКогда правило отключено, диалоговое окно будет появляться, если с помощью правила ManagedAccountsSigninRestriction настроено принудительное создание отдельного профиля для управляемого аккаунта.";
SilentPrintingEnabled.pfm_title = "Включить печать в фоновом режиме";
SilentPrintingEnabled.pfm_description = "Задав для этого правила значение True, вы разрешите печать в фоновом режиме, в котором окно предпросмотра документа сразу закрывается, а файл печатается на принтере и с настройками по умолчанию. Если в качестве принтера выбран вариант \"Сохранить как PDF\", документ будет помещен в папку со скачанными файлами.\n\nЕсли правило не настроено или задано значение False, печать в фоновом режиме отключена. Окно предпросмотра не закрывается автоматически, и пользователю нужно выбрать параметры вручную.";
SitePerProcess.pfm_title = "Изолировать каждый сайт";
SitePerProcess.pfm_description = "Начиная с Brave версии 67, на всех компьютерах по умолчанию включена изоляция сайтов, в результате чего для каждого из них запускается отдельный процесс. Сайт описывается при помощи протокола и домена первого и второго уровня, например https://example.com. Если текущее правило включено, оно не влияет на такой режим работы, а только запрещает пользователям отключать эту настройку, например с помощью экспериментального параметра Disable site isolation (Отключить изоляцию сайтов) на странице chrome://flags. Начиная с Brave версии 76, если правило отключено или не настроено, изоляция сайтов остается активной, но пользователи могут отказаться от нее.\n\nДля изоляции определенных источников не на уровне сайта, а с более высокой степенью детализации (например, https://a.example.com) также можно использовать правило IsolateOrigins.\n\nВ Google Chrome OS 76 и более ранних версиях рекомендуется задавать правилу для устройств DeviceLoginScreenSitePerProcess то же значение, что и правилу SitePerProcess. В случае противоречия в начале сеанса пользователя может возникнуть задержка.\n\nПримечание. Для устройств Android используйте правило SitePerProcessAndroid.";
SiteSearchSettings.pfm_title = "Настройки поиска по сайту";
SiteSearchSettings.pfm_description = "В этом правиле задается список сайтов, по которым пользователи могут выполнять поиск. Чтобы это сделать, нужно в адресной строке ввести ключевое слово или ключевое слово с символом @ перед ним, например \"@работа\", затем нажать Пробел или Tab.\n\nДля каждого сайта необходимо заполнить следующие поля: name, shortcut, url.\n\nВ name указывается сайт или название поисковой системы, которая будет показываться в адресной строке.\n\nПоле shortcut может содержать обычные слова и символы. Оно не должно начинаться с \"@\" или содержать пробелы. Необходимо, чтобы все ключевые слова были уникальными.\n\nВ url нужно задать URL поисковой системы, которая будет использоваться при вводе определенного ключевого слова. В URL должна быть строка '{searchTerms}'. Она будет заменена на поисковый запрос пользователя. Недопустимые записи и записи с одинаковыми ключевыми словами игнорируются.\n\nВы можете выбрать до трех записей в качестве рекомендуемых. Они будут появляться в адресной строке после ввода символа @.\n\nЕсли для параметра allow_user_override записи установлено значение True, пользователи могут изменять или удалять ее. Рекомендуемые поисковые системы, перед которыми стоит символ \"@\", можно только удалять. Когда пользователь изменяет запись, созданную этим правилом, она становится пользовательским ярлыком, а правило перестает управлять ей. Если параметр allow_user_override записи не настроен или для него установлено значение False, ее нельзя изменять или удалять. Разрешить изменение записей пользователями можно только в версии M139 и более поздних, в других оно по умолчанию запрещено.\n\nНевозможно создание записей с ключевыми словами, совпадающими с указанными в правиле, кроме случаев, когда для параметра allow_user_override записи установлено значение True.\n\nЕсли в правиле задается ключевое слово, которое ранее было создано пользователем, приоритет отдается пользовательской версии. Однако выбрать вариант, указанный в правиле, также возможно. Для этого в строке поиска нужно сначала ввести \"@\". Например, пользователь ранее настроил ключевое слово \"работа\" для URL1, а в правиле это слово определяется для URL2. Тогда при вводе слова \"работа\" в строке поиска будет выполнен поиск на сайте с URL1, а при вводе \"@работа\" – на ресурсе с URL2.\n\nВ Microsoft® Windows® это правило можно настроить только на устройствах, которые входят в домен Microsoft® Active Directory®, добавлены в Microsoft® Azure® Active Directory® или зарегистрированы в программе \"Chrome Enterprise Core\".\n\nВ macOS правило доступно только на устройствах, которые контролируются с помощью ПО для управления мобильными устройствами, добавлены в домен через MCX или зарегистрированы в Chrome Enterprise Core.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=SiteSearchSettings.";
SmartTabSharingSettings.pfm_title = "Настройки умного доступа к вкладкам";
SmartTabSharingSettings.pfm_description = "0 - Разрешить умный доступ к вкладкам при интеграции сервиса \"Google AI Mode\"\n1 - Запретить умный доступ к вкладкам при интеграции сервиса \"Google AI Mode\"\nПравило определяет, можно ли предоставлять доступ к вкладкам сервису \"Google AI Mode\" через боковую панель или вкладки в Google Chrome.\n\nОбратите внимание, что правило не влияет на сервис \"Google AI Mode\", доступный на веб-страницах. Оно управляет только обменом данными в Google Chrome.\n\nЕсли задано значение \"0\", пользователи могут предоставлять сервису \"Google AI Mode\" доступ к содержимому страниц и файлов.\n\nПри значении \"1\" делиться такой информацией с сервисом \"Google AI Mode\" нельзя. Точки входа для передачи контекста и боковая панель будут отключены или скрыты.\n\nПравило игнорируется, если сервис \"Google Search\" не задан пользователем как поисковая система по умолчанию, так как в этом случае функция отключена.\n\nЭто правило не зависит от AIModeSettings. Правило AIModeSettings управляет только точками входа в омнибоксе или окне поиска на странице быстрого доступа, а это правило определяет, можно ли делиться контекстом через боковую панель или вкладки.\n\nЭто правило также не влияет на интеграцию сервиса \"Google Gemini\", которая отключается с помощью GeminiSettings.\n\nЕсли правило SearchContentSharingSettings отключено, это правило игнорируется.\n\nЕсли это правило не настроено, применяется GenAiDefaultSettings.\n\nПодробнее о том, как обрабатываются данные при использовании функций на основе генеративного ИИ: https://support.google.com/chrome/a?p=generative_ai_settings.";
SpellCheckServiceEnabled.pfm_title = "Включение и отключение веб-службы проверки правописания";
SpellCheckServiceEnabled.pfm_description = "Если правило включено, для проверки правописания используется веб-сервис Google. Это правило управляет только использованием веб-сервиса. Если правило отключено, веб-сервис не используется.\n\nЕсли правило не настроено, пользователи смогут сами выбрать, использовать веб-сервис проверки правописания или нет.\n\nЕсли это правило отключено правилом \"SpellcheckEnabled\", то можно использовать для проверки правописания скачанные в локальное хранилище словари.";
SpellcheckEnabled.pfm_title = "Включить проверку правописания";
SpellcheckEnabled.pfm_description = "Если правило включено, то проверка правописания разрешена и пользователь не может ее отключить. На устройствах с Microsoft® Windows®, Google Chrome OS и Linux® пользователи могут включить или отключить проверку правописания для отдельных языков. Таким образом, выключив проверку для всех языков, пользователи могут полностью отключить проверку правописания. Чтобы не допустить полного отключения этой функции, используйте правило \"SpellcheckLanguage\". С его помощью можно установить языки, для которых проверка правописания будет всегда включена.\n\nЕсли правило отключено, проверка правописания запрещена с использованием любых источников и пользователи не могут ее включить. В этом случае правила SpellCheckServiceEnabled, SpellcheckLanguage и SpellcheckLanguageBlocklist не действуют.\n\nЕсли правило не настроено, пользователи могут включать и отключать проверку правописания в языковых настройках.";
StandardizedBrowserZoomEnabled.pfm_title = "Включить стандартизированное масштабирование в браузере";
StandardizedBrowserZoomEnabled.pfm_description = "Это правило обеспечивает соответствие недавно принятой спецификации масштабирования CSS.\n\nЕсли включить или не настроить правило, свойство zoom будет соответствовать спецификации:\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\nЕсли отключить правило, свойство zoom будет работать так же, как до появления стандартной спецификации.\n\nМы предлагаем это правило в течение определенного периода, чтобы дать разработчикам время перевести веб-контент на новый стандарт. Существует также эксперимент с источником (DisableStandardizedBrowserZoom), который соответствует работе при отключенном правиле. В версии 134 правило будет удалено, а масштабирование начнет работать так же, как при включенном правиле.";
StaticStorageQuotaEnabled.pfm_title = "Управлять тем, будут ли API, определяющие доступное место в хранилище, возвращать статические значения";
StaticStorageQuotaEnabled.pfm_description = "Если правило включено, API, определяющие доступное место в хранилище, будут возвращать статическое значение, равное использованному объему, к которому добавляется меньшее из двух значений: 10 ГиБ или объем диска, округленный до ближайшего 1 ГиБ.\nЕсли правило отключено, такие API обычно возвращают динамическое значение, пропорциональное общему объему свободного пространства на устройстве, независимо от занятого места.\nЕсли правило не настроено, для таких API используется поведение Chrome по умолчанию.\nЭтот параметр не влияет на сайты, где доступное пространство хранения не ограничено. Доступное пространство, установленное принудительно, также не изменится.";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "Включить строгую проверку MIME-типов для скриптов Worker";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "Регулирует использование строгой проверки MIME-типов для скриптов Worker.\n\nЕсли правило включено или не настроено, скрипты Worker будут использовать строгую проверку MIME-типов для JavaScript-ресурсов (проводится по умолчанию). Скрипты Worker с устаревшими MIME-типами работать не будут.\n\nЕсли правило отключено, скрипты Worker будут использовать нестрогую проверку MIME-типов. В таком случае скрипты с устаревшими MIME-типами, например text/ascii, смогут и дальше загружаться и запускаться.\n\nТрадиционно в браузерах использовалась нестрогая проверка для поддержания работы ресурсов, которые содержат устаревшие MIME-типы. Например, text/ascii является устаревшим поддерживаемым MIME-типом для JavaScript-ресурсов. Загрузка ресурсов в качестве скриптов в случаях, когда такое использование не предусматривалось, может привести к проблемам безопасности. Скоро строгая проверка MIME-типов будет использоваться в Chrome по умолчанию. Она будет проводиться при включенном правиле. Если его отключить, администраторы смогут использовать нестрогую проверку.\n\nПодробную информацию о MIME-типах в JavaScript/ECMAScript вы найдете на странице https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage.\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "Запретить показывать диалоговые окна JavaScript, запущенные из других субфреймов";
SuppressDifferentOriginSubframeDialogs.pfm_description = "Brave блокирует модальные диалоговые окна JavaScript, вызываемые с помощью window.alert, window.confirm и window.prompt, если они запущены субфреймом, источник которого отличается от источника главного фрейма. Подробнее: https://www.chromestatus.com/feature/5148698084376576.\n\nЭто правило позволяет изменить такое поведение.\nЕсли правило включено или не настроено, диалоговые окна JavaScript, вызываемые из субфрейма с другим источником, будут блокироваться.\nЕсли правило отключено, такие окна блокироваться не будут.\n\nВ будущем это правило будет удалено из Brave.";
SuppressUnsupportedOSWarning.pfm_title = "Скрывает предупреждения о неподдерживаемой ОС";
SuppressUnsupportedOSWarning.pfm_description = "Если правило включено, то не показываются предупреждения о том, что Brave работает на компьютере или в операционной системе, которые больше не поддерживаются.\n\nЕсли правило отключено или не настроено, на неподдерживаемых системах будет показываться предупреждение.";
SyncDisabled.pfm_title = "Отключить синхронизацию данных с Google";
SyncDisabled.pfm_description = "Если правило включено, синхронизация данных в Brave с помощью сервисов, размещенных в Google, отключается.\nПолностью отключить сервис \"Chrome Sync\" можно через Google Admin console.\n\nЕсли правило отключено или не настроено, пользователи могут самостоятельно решать, использовать ли им сервис \"Chrome Sync\".\n\nПримечание. Не включайте это правило, когда включено правило RoamingProfileSupportEnabled, так как оно использует те же клиентские функции. В этом случае синхронизация через сервисы, размещенные в Google, полностью отключается.";
SyncTypesListDisabled.pfm_title = "Типы данных, для которых нужно запретить синхронизацию";
SyncTypesListDisabled.pfm_description = "Если правило настроено, для всех указанных в нем типов данных будет запрещена синхронизация как в сервисе \"Chrome Sync\", так и в перемещаемом профиле. Это позволит уменьшить объем информации в перемещаемом профиле или ограничить набор типов данных, загружаемых на серверы сервиса \"Chrome Sync\".\n\nВ настоящее время вы можете указывать в этом правиле следующие типы данных: apps, autofill, bookmarks, extensions, preferences, passwords, payments, productComparison, readingList, tabs, themes, typedUrls, wifiConfigurations. Регистр символов в перечисленных названиях имеет значение.\n\nОбратите внимание, что динамическое обновление правил поддерживается только в Brave 123 и более новых версиях. При отключении синхронизации для данных типа autofill она также отключается и для payments. Тип данных typedUrls относится ко всей истории браузера.";
TLS13EarlyDataEnabled.pfm_title = "Включить TLS 1.3 Early Data";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Early Data – это расширение протокола TLS 1.3, позволяющее отправлять HTTP-запрос одновременно с подтверждением TLS.\n\nЕсли правило не настроено, Brave будет следовать установленному по умолчанию процессу выпуска для TLS 1.3 Early Data.\n\nЕсли правило включено, Brave будет использовать TLS 1.3 Early Data.\n\nЕсли правило отключено, Brave не будет использовать TLS 1.3 Early Data.\n\nКогда функция включена, Brave может как использовать, так и не использовать TLS 1.3 Early Data. Это зависит от поддержки протокола сервером.\n\nTLS 1.3 Early Data – утвержденный протокол. Предполагается, что существующие серверы TLS, промежуточные устройства и системы безопасности будут обрабатывать или отклонять запросы TLS 1.3 Early Data без разрыва соединения.\n\nОднако на устройствах, где поддержка TLS реализована некорректно, TLS 1.3 Early Data может вызывать сбои в работе и разрывы соединения. При возникновении проблем администраторам следует обратиться за исправлением к поставщику.\n\nЭто временное правило для управления функцией. Оно будет удалено позднее. Его можно включить, чтобы проверить наличие проблем, и отключить, пока они не решены.";
TabCaptureAllowedByOrigins.pfm_title = "Разрешить захват вкладки этими источниками";
TabCaptureAllowedByOrigins.pfm_description = "Правило позволяет задать список шаблонов URL, которые могут захватывать вкладку.\n\nЕсли правило не настроено, система не будет проверять, нужно ли переопределить значение по умолчанию для захвата выбранного типа.\n\nОбратите внимание, что приложения Chrome в окне по-прежнему можно будет захватывать.\n\nПравило не действует, если сайт соответствует шаблону URL в правиле SameOriginTabCaptureAllowedByOrigins.\n\nЕсли адрес сайта совпадает с шаблоном URL в TabCaptureAllowedByOrigins, то не учитываются правила WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins и ScreenCaptureAllowed.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns/.  При сопоставлении шаблонов с URL учитывается только название источника (путь к ресурсу на сервере игнорируется).";
TabCompareSettings.pfm_title = "Настройки Tab Compare";
TabCompareSettings.pfm_description = "0 - Разрешить использовать функцию \"Сравнение вкладок\" с улучшением ИИ-моделей\n1 - Разрешить использовать функцию \"Сравнение вкладок\" без улучшения ИИ-моделей\n2 - Запретить использовать функцию \"Сравнение вкладок\"\nСравнение вкладок – это инструмент на основе ИИ, предназначенный для сравнения информации на разных вкладках. Например, пользователю может быть предложена эта функция, когда у него открыто много вкладок с товарами одной категории.\n\nЕсли установлено значение \"0\", функцией можно пользоваться и Google разрешается улучшать свои ИИ-модели с помощью определенных данных. Это могут быть запросы, входные и выходные данные, а также исходные материалы и отзывы, в зависимости от функции. Для улучшения ИИ-моделей эти данные также могут проверяться специалистами. Значение \"0\" используется по умолчанию, за исключением описанных ниже случаев.\n\nЕсли установлено значение \"1\", функцией можно пользоваться, но Google запрещается улучшать ИИ-модели с помощью контента пользователей, в том числе запросов, входных и выходных данных, исходных материалов и отзывов. Это значение используется по умолчанию для корпоративных и учебных аккаунтов, управляемых через Google Admin console и Google Workspace.\n\nЕсли установлено значение \"2\", функцией нельзя пользоваться.\n\nЕсли правило не настроено, применяется правило GenAiDefaultSettings.\n\nПодробнее о том, как обрабатываются данные при использовании функций на основе генеративного ИИ: https://support.google.com/chrome/a?p=generative_ai_settings.";
TabDiscardingExceptions.pfm_title = "Шаблоны URL для вкладок, которые не нужно отклонять";
TabDiscardingExceptions.pfm_description = "В этом правиле можно указать шаблоны с помощью формата фильтров URLBlocklist. Если URL соответствует одному или нескольким таким шаблонам, браузер не будет его отклонять.\nЭто относится к режимам недостаточного объема памяти и высокой эффективности.\nОтклоненная страница не загружается, а выделенные под нее ресурсы высвобождаются. Связанная вкладка остается доступной на панели вкладок. Если такую вкладку открыть, будет запущено полное обновление ее контента.\n";
TaskManagerEndProcessEnabled.pfm_title = "Разрешить завершение процессов в диспетчере задач";
TaskManagerEndProcessEnabled.pfm_description = "Если правило отключено, пользователи не могут завершать процессы в диспетчере задач.\n\nЕсли правило включено или не настроено, пользователи могут это делать.";
ThirdPartyAiChatSettings.pfm_title = "Настройки интеграции режима ИИ от сторонних разработчиков в адресной строке и окне поиска на странице быстрого доступа";
ThirdPartyAiChatSettings.pfm_description = "0 - Разрешить интеграцию режима ИИ от сторонних разработчиков\n1 - Запретить интеграцию режима ИИ от сторонних разработчиков\nПравило определяет возможность интеграции режима ИИ от сторонних разработчиков в адресной строке и окне поиска на странице быстрого доступа.\n\nЧтобы получить доступ к этой функции, поисковой системой по умолчанию должна быть сторонняя поисковая система с поддержкой режима ИИ.\n\nЕсли задано значение \"0\", функция доступна всем пользователям.\n\nЕсли установлено значение \"1\", она недоступна.\n\nЕсли правило не настроено, применяется правило GenAiDefaultSettings.";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "Задать ограничение для памяти, используемой экземплярами Chrome";
TotalMemoryLimitMb.pfm_description = "Устанавливает объем памяти, которую может использовать один экземпляр Brave, прежде чем браузер начнет отключать вкладки для экономии памяти (это означает, что память, использованная каждой из таких вкладок, будет освобождена, а при переходе на эти вкладки их потребуется перезагрузить).\n\nЕсли правило настроено, браузер начнет отключать вкладки для экономии памяти при превышении ограничения. Однако нельзя гарантировать, что браузер всегда будет работать в рамках указанного лимита. Любое значение менее 1024 будет округлено до 1024.\n\nЕсли правило не настроено, браузер начнет экономить память только тогда, когда определит, что объем доступной физической памяти на компьютере стал низким.";
TranslateEnabled.pfm_title = "Включить Переводчик";
TranslateEnabled.pfm_description = "Если для правила задано значение True, пользователям в случае необходимости показывается интегрированная панель переводческих инструментов в браузере Brave и пункт с командой на перевод в контекстном меню, которое открывается при нажатии правой кнопки мыши. Если задано значение False, все встроенные функции перевода отключаются.\n\nНастроив это правило, вы лишите пользователей возможности выбрать другой вариант. Если не устанавливать значение, пользователи смогут менять эту настройку.";
TranslatorAPIAllowed.pfm_title = "Разрешить использовать Translator API";
TranslatorAPIAllowed.pfm_description = "Если это правило включено или не настроено, использовать Translator API в Brave разрешено.\n\nЕсли правило отключено, использовать Translator API запрещено.";
TryOnYouSettings.pfm_title = "Настройки инструмента виртуальной примерки";
TryOnYouSettings.pfm_description = "0 - Включить инструмент виртуальной примерки с улучшением модели\n1 - Включить инструмент виртуальной примерки без улучшения модели\n2 - Отключить инструмент виртуальной примерки\nИнструмент виртуальной примерки — это функция на основе искусственного интеллекта, которая позволяет пользователям виртуально примерять одежду, найденную в интернете, и получать анализ цен и другую полезную информацию о покупках при включенном Gemini в Chrome.\n\nЕсли установлено значение \"0\", функцией разрешено пользоваться и Google может улучшать свои ИИ-модели с помощью пользовательских изображений, входных и выходных данных, исходных материалов, отзывов и т. п. Для улучшения ИИ-моделей этот контент также может проверяться специалистами. Значение \"0\" используется по умолчанию, за исключением описанных ниже случаев.\n\nЕсли установлено значение \"1\", функцией разрешено пользоваться, но Google не может улучшать ИИ-модели с помощью пользовательского контента, в том числе изображений, входных и выходных данных, исходных материалов и отзывов. Это значение по умолчанию для корпоративных пользователей, управляемых через Google Admin console, и учебных аккаунтов, управляемых через Google Workspace.\n\nЕсли установлено значение \"2\", пользоваться функцией нельзя.\n\nПримечание. Запрет на использование данных с целью улучшения модели (значение \"1\") действует, только когда инструмент виртуальной примерки запускается через Chrome. В других браузерах этот режим не применяется.\n\nЕсли правило не настроено, действует правило GenAiDefaultSettings. Подробную информацию о том, как обрабатываются данные при использовании функций на основе генеративного ИИ, можно найти на странице https://support.google.com/chrome/a?p=generative_ai_settings.\n\nИнструмент виртуальной примерки работает не во всех странах и не на всех языках. Если правило настроено, это не гарантирует, что функция будет работать. Она может быть недоступна. Подробную информацию о запуске инструмента можно найти в примечаниях к выпуску Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=ru.";
URLAllowlist.pfm_title = "Разрешить доступ к списку URL";
URLAllowlist.pfm_description = "Правило позволяет задать список URL, которые считаются исключениями из правила URLBlocklist. Формат элементов списка приведен в описании этого правила. Например, если для правила URLBlocklist установлено значение * (символ звездочки), то все запросы будут блокироваться. Чтобы разрешить доступ к определенным URL, можно задать исключения в формате, приведенном на странице https://support.google.com/chrome/a?p=url_blocklist_filter_format. Это правило позволяет настроить исключения для некоторых протоколов, субдоменов отдельных доменов, портов или путей. Определять, блокируется URL или нет, будет фильтр с самыми узкими критериями. Правило URLAllowlist имеет приоритет над правилом URLBlocklist. В этом правиле можно указать не более 1000 URL.\n\nОно также позволяет разрешить браузеру автоматически вызывать внешние приложения, зарегистрированные как обработчики указанных в списке протоколов (например, tel: или ssh:).\n\nЕсли правило не настроено, исключений из правила URLBlocklist нет.\n\nНачиная с Brave версии 92 это правило также поддерживается в режиме консольного браузера.";
URLBlocklist.pfm_title = "Блокировка доступа к списку URL.";
URLBlocklist.pfm_description = "Правило URLBlocklist блокирует загрузку веб-страниц с запрещенными URL. Администраторы могут указать список шаблонов URL, которые будут блокироваться. Если правило не настроено, все URL разрешены в браузере. В правиле URLAllowlist можно задать до 1000 исключений. Подробнее о формате шаблонов URL: https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nОбратите внимание, что правило не распространяется на URL, которые встроены в код страниц с помощью JavaScript и динамически загружают данные. Если вы заблокируете example.com/abc, сайт example.com по-прежнему сможет загрузить страницу с таким адресом, используя XMLHTTPRequest. Кроме того, правило не препятствует веб-страницам заменять URL в омнибоксе на заблокированный при помощи JavaScript History API.\n\nВ Brave 73 и более поздних версиях можно блокировать URL формата javascript://*, однако такое правило будет влиять только на код JavaScript, который пользователь вводит в адресной строке браузера, и на некоторые другие элементы, например букмарклеты.\n\nНачиная с Brave версии 92 это правило также поддерживается в режиме консольного браузера.\n\nВ Brave 147 и более поздних версиях подстановочный знак * сам по себе не применяется к внутренним URL вида chrome://. Чтобы блокировать их, необходимо явно использовать шаблон chrome://*.\n\nОбратите внимание, что блокировать внутренние URL, например chrome://* и chrome-untrusted://*, не рекомендуется – это может не сработать или привести к непредвиденным ошибкам. Вместо этого проверьте, можно ли применить более подходящее правило. Например:\n\n– chrome://settings/certificates можно заблокировать с помощью правила CACertificateManagementAllowed,\n\n– chrome-untrusted://crosh – с помощью правила SystemFeaturesDisableList;\n\n– а devtools://* можно заблокировать с помощью одного из следующих правил: DeveloperToolsAvailability, DeveloperToolsAvailabilityAllowlist, DeveloperToolsAvailabilityBlocklist.";
UpdateOnZeroWindowEnabled.pfm_title = "Управляет автоматическим перезапуском в фоновом режиме, когда закрыты все окна браузера";
UpdateOnZeroWindowEnabled.pfm_description = "Позволяет управлять автоматическим перезапуском Chrome на macOS в фоновом режиме, когда ожидается обновление системы безопасности и закрыты все окна браузера.\n\nЕсли правило не настроено или для него выбрано значение True, Brave может автоматически перезапускаться для применения обновлений.\n\nЕсли указано значение False, браузер не будет автоматически перезапускаться, когда закрыты все его окна.";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "Включить анонимный сбор данных о URL";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "Если правило включено, анонимный сбор данных о URL выполняется всегда (URL страниц, которые посещает пользователь, отправляются в Google для улучшения поиска и повышения удобства работы в браузере).\n\nЕсли правило отключено, эта информация не собирается.\n\nЕсли правило не настроено, пользователь может разрешить или запретить анонимный сбор данных о URL.\n\nДля устройств Google Chrome OS в режиме киоска нет варианта \"Предоставить выбор пользователю\". Если правило не настроено для Google Chrome OS в режиме киоска, анонимный сбор данных о URL выполняется всегда.\nЕсли же оно настроено для Google Chrome OS в режиме киоска, информация собирается для киоск-приложений.";
UserDataDir.pfm_title = "Указать каталог для пользовательских данных";
UserDataDir.pfm_description = "Определяет каталог, в котором Brave будет хранить пользовательские данные.\n\nЕсли правило настроено, Brave будет использовать выбранный каталог независимо от того, указал ли пользователь экспериментальный параметр --user-data-dir или нет. Чтобы избежать потери данных или непредвиденных ошибок, в правиле не следует указывать каталог, который также используется в других целях, поскольку его содержимым будет управлять Brave.\n\nСписок поддерживаемых переменных приведен здесь: https://support.google.com/chrome/a?p=Supported_directory_variables.\n\nЕсли правило не настроено, будет выбран путь к профилю по умолчанию и пользователь сможет перезаписать его с помощью экспериментального параметра командной строки --user-data-dir.";
UserDataSnapshotRetentionLimit.pfm_title = "Ограничение количества снимков пользовательских данных, которые хранятся для выполнения вынужденного отката версии";
UserDataSnapshotRetentionLimit.pfm_description = "После крупных обновлений Chrome будет создавать снимок определенных данных о работе пользователя в браузере для выполнения вынужденного отката версии в случае необходимости. Если выполняется вынужденный откат к версии, для которой есть соответствующий снимок, данные восстанавливаются из него. Это позволяет сохранить пользовательские настройки, например закладки и данные автозаполнения.\n\nЕсли правило не настроено, используется значение по умолчанию (3 снимка).\n\nЕсли правило настроено, соблюдается установленное ограничение и старые снимки удаляются по мере создания новых. Если задано значение 0, снимки сохраняться не будут.";
UserFeedbackAllowed.pfm_title = "Разрешить отзывы пользователей";
UserFeedbackAllowed.pfm_description = "Если правило включено или не настроено, пользователи могут отправлять отзывы в Google. Для этого нужно открыть меню и выбрать \"Справка > Сообщить о проблеме\" или нажать сочетание клавиш.\n\nЕсли правило отключено, пользователи не смогут отправлять отзывы в Google.";
VideoCaptureAllowed.pfm_title = "Включение или отключение функции захвата видео";
VideoCaptureAllowed.pfm_description = "Если правило включено или не задано, то все сайты, кроме перечисленных в списке VideoCaptureAllowedUrls, должны отправлять пользователю запрос, чтобы получить разрешение на запись.\n\nЕсли правило отключено, запросы не отправляются, а запись видео разрешается только сайтам, указанным в списке VideoCaptureAllowedUrls.\n\nПримечание. Это правило действует для всех видеовходов, а не только для встроенной камеры.";
VideoCaptureAllowedUrls.pfm_title = "URL, которым доступ к видеозаписывающим устройствам предоставляется без запроса";
VideoCaptureAllowedUrls.pfm_description = "Чтобы настроить это правило, нужно указать список URL, шаблоны которых будут сверяться с источником безопасности URL, запрашивающего доступ. В случае совпадения доступ видеозаписывающим устройствам будет предоставляться автоматически – пользователи не увидят запрос.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns/. Обратите внимание, что шаблон \"*\", соответствующий любому URL, не поддерживается для этого правила.";
VoiceTypingSettings.pfm_title = "Настройки голосового ввода";
VoiceTypingSettings.pfm_description = "0 - Разрешить голосовой ввод\n1 - Разрешить использовать голосовой ввод без сбора данных\n2 - Запретить использовать голосовой ввод\nГолосовой ввод — это функция на основе искусственного интеллекта, которая позволяет вводить и редактировать текст с помощью голоса. Используемые в ней модели генеративного ИИ обеспечивают высокое качество расшифровки и форматирования.\n\nЕсли установлено значение \"0\", функцией можно пользоваться и Google разрешается улучшать свои ИИ-модели с помощью определенных данных. Это могут быть запросы, входные и выходные данные, а также исходные материалы и отзывы, в зависимости от функции. Для улучшения ИИ-моделей эти данные также могут проверяться специалистами. Значение \"0\" используется по умолчанию, за исключением описанных ниже случаев.\n\nЕсли установлено значение \"1\", функцией можно пользоваться, но Google запрещается улучшать ИИ-модели с помощью контента пользователей, в том числе запросов, входных и выходных данных, исходных материалов и отзывов. Это значение используется по умолчанию для корпоративных и учебных аккаунтов, управляемых через Google Admin console и Google Workspace.\n\nЕсли установлено значение \"2\", функцией нельзя пользоваться.\n\nЕсли правило не настроено, применяется правило GenAiDefaultSettings.\n\nПодробнее о том, как обрабатываются данные при использовании функций на основе генеративного ИИ: https://support.google.com/chrome/a?p=generative_ai_settings.";
WPADQuickCheckEnabled.pfm_title = "Разрешить оптимизацию WPAD";
WPADQuickCheckEnabled.pfm_description = "Если правило включено или не настроено, в Brave будет работать оптимизация протокола автоматического обнаружения прокси-сервера (WPAD).\n\nЕсли правило отключено, оптимизация WPAD не будет работать. В результате в Brave будет увеличено время ожидания для WPAD-серверов на базе DNS.\n\nПользователи не могут изменить этот параметр независимо от того, настроено правило или нет.";
WarnBeforeQuittingEnabled.pfm_title = "Показывать диалоговое окно с предупреждением при закрытии браузера";
WarnBeforeQuittingEnabled.pfm_description = "Правило контролирует диалоговое окно \"Предупреждать перед выходом (⌘Q)\" при закрытии браузера.\n\nЕсли правило включено или не настроено, при закрытии браузера пользователь увидит диалоговое окно с предупреждением.\n\nЕсли правило отключено, при закрытии браузера пользователь не увидит диалоговое окно с предупреждением.";
WebAppInstallByUserEnabled.pfm_title = "Включить установку веб-приложений пользователями из браузера";
WebAppInstallByUserEnabled.pfm_description = "Это правило определяет, могут ли пользователи устанавливать веб-приложения через браузер.\nЕсли правило включено или не настроено, пользователи могут устанавливать веб-приложения через браузер.\nЕсли правило отключено, пользователи не могут устанавливать веб-приложения через браузер, а тип данных \"Приложения\" исключается из синхронизации для Chrome Sync.\nЭто правило не поддерживает динамическое обновление. Любые изменения, например включение, отключение или сброс, вступают в силу только после перезапуска браузера.\nЭто правило не влияет на правило WebAppInstallForceList.";
WebAppInstallForceList.pfm_title = "URL автоматически устанавливаемых веб-приложений";
WebAppInstallForceList.pfm_description = "Правило позволяет указать список автоматически устанавливаемых веб-приложений, которые нельзя удалить или отключить.\n\nКаждый пункт списка представляет собой объект с обязательной переменной url (URL устанавливаемого веб-приложения).\n\nТакже есть 6 необязательных:\n- default_launch_container.\nОпределяет, как открывается веб-приложение (по умолчанию – в новой вкладке).\n\n- create_desktop_shortcut.\nЕсли для переменной задано значение True, на рабочем столе компьютера с Linux\nили Microsoft® Windows® будут создаваться ярлыки.\n\n- fallback_app_name.\nВ Brave 90 и более поздних версиях\nпозволяет переопределить название приложения, если это\nне современное веб-приложение (PWA); для PWA\nпозволяет переопределить временное название, но, чтобы завершить установку,\nнеобходима аутентификация. Если одновременно настроены правила\ncustom_name и\nfallback_app_name,\nпоследнее игнорируется.\n\n- custom_name.\nВ Google Chrome OS 99 и более поздних версиях,\nа также в версии 112 и выше во всех других компьютерных операционных системах\nпозволяет безвозвратно переопределить названия для всех веб-приложений и PWA.\n\n- custom_icon.\nВ Google Chrome OS 99 и более поздних версиях,\nа также в версии 112 и выше во всех других компьютерных операционных системах\nпозволяет переопределить значки установленных приложений. Значок должен быть квадратным.\nРазмер его файла не может превышать 1 МБ. Допустимые форматы – JPEG, PNG, GIF, WebP, ICO.\nВ качестве значения хеша используется хеш SHA-256 файла значка. Чтобы значок мог использоваться\nсразу после установки приложения,\nurl должен быть доступен без аутентификации.\n\n- install_as_shortcut.\nДоступна в Brave 107\nи более поздних версиях. Если переменная включена, url\nбудет установлен в качестве ярлыка, как это происходит по команде \"Создать ярлык\"\nв интерфейсе браузера для компьютера.\nОбратите внимание, что в этом случае при изменении манифеста для url\nярлык не обновится.\nЕсли переменная отключена или не настроена, веб-приложение с указанным\nurl будет установлено в обычном режиме.\n\nБолее подробные сведения о закреплении приложений на панели запуска в Google Chrome OS приведены в правиле PinnedLauncherApps.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=WebAppInstallForceList.";
WebAppSettings.pfm_title = "Настройки управления веб-приложениями";
WebAppSettings.pfm_description = "С помощью этого правила администратор может задать настройки для установленных веб-приложений. Оно сопоставляет идентификатор веб-приложения с определенным параметром. Настройки по умолчанию можно указать с помощью идентификатора *. Он действует для всех веб-приложений, для которых в правиле не задана отдельная конфигурация.\n\nВ поле manifest_id указывается идентификатор манифеста для веб-приложения. Инструкции о том, как определить идентификатор манифеста для установленного веб-приложения, представлены на странице https://developer.chrome.com/blog/pwa-manifest-id/.\nС помощью поля run_on_os_login можно разрешить запуск веб-приложения во время входа в систему. Если в поле указано значение blocked, веб-приложение не будет запускаться во время входа в систему и пользователи не смогут изменить это поведение позднее. Если в поле указано значение run_windowed, веб-приложение будет запускаться во время входа в систему и пользователи не смогут изменить это поведение позднее. Если в поле указано значение allowed, настроить запуск веб-приложения во время входа в систему пользователи смогут самостоятельно. Настройки по умолчанию позволяют выбрать только значение allowed или blocked.\nНачиная с версии 117 в поле prevent_close_after_run_on_os_login можно указать, нужно ли предотвращать закрытие веб-приложения (например, пользователем, диспетчером задач или Web API). Такое поведение возможно, только если в поле run_on_os_login указано значение run_windowed. Если приложение уже открыто, это свойство начнет действовать после перезапуска приложения. Если значение в поле не указано, пользователи смогут закрывать приложение.\nНачиная с версии 118 в поле force_unregister_os_integration можно указать, следует ли удалять все элементы интеграции с ОС для веб-приложений, например сочетания клавиш, обработчики файлов и протоколов. Если приложение уже открыто, это свойство начнет действовать после перезапуска приложения. Используйте его с осторожностью: элементы интеграции, автоматически настраиваемые при запуске системы веб-приложений, могут быть перезаписаны. Сейчас это свойство доступно только для Windows, macOS и Linux.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=WebAppSettings.";
WebAudioOutputBufferingEnabled.pfm_title = "Включить адаптивную буферизации Web Audio";
WebAudioOutputBufferingEnabled.pfm_description = "Это правило определяет, используется ли в браузере адаптивная буферизация. Она способна сокращать количество звуковых дефектов, но может привести к увеличению задержки.\n\nЕсли правило включено, адаптивная буферизация всегда будет активна.\n\nЕсли правило отключено или не настроено, адаптивная буферизация будет использоваться в зависимости от настроек запуска функций браузера.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "Разрешенные источники для запросов WebAuthn от приложений Удаленного рабочего стола";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "Источники клиентских приложений Удаленного рабочего стола, которые могут выполнять запросы к WebAuthn API из удаленных хостов во время сеанса в браузере.\n\nЛюбой источник из списка может отправлять запросы WebAuthn, чтобы получать идентификаторы доверяющей стороны (RP ID), которые обычно нельзя запросить.\n\nДопускаются только источники с протоколом HTTPS. Подстановочные знаки не поддерживаются.\nЛюбые недопустимые записи игнорируются.\n\nЭто правило действует только для аффилированных пользователей.";
WebHidAllowAllDevicesForUrls.pfm_title = "Автоматически разрешать сайтам подключение ко всем HID-устройствам.";
WebHidAllowAllDevicesForUrls.pfm_description = "С помощью этого правила вы можете задать список сайтов, которые смогут автоматически подключаться ко всем доступным устройствам.\n\nНеобходимо указывать действительные URL, иначе правило будет игнорироваться. Учитывается только источник URL (схема, хост и порт).\n\nНа устройствах с Chrome OS это правило действует только для аффилированных пользователей.\n\nЭто правило переопределяет правила DefaultWebHidGuardSetting, WebHidAskForUrls, WebHidBlockedForUrls и пользовательские настройки.";
WebHidAllowDevicesForUrls.pfm_title = "Автоматически разрешать этим сайтам подключение к HID-устройствам с предоставленными идентификаторами поставщика и продукта.";
WebHidAllowDevicesForUrls.pfm_description = "Вы можете задать список URL для указания сайтов, которым будет автоматически предоставляться доступ к HID-устройствам с определенными идентификаторами поставщика и продукта. Для подтверждения каждый пункт списка должен включать поля devices и urls. Неподтвержденные пункты игнорируются. Для каждого пункта в поле devices нужно обязательно задать идентификатор vendor_id и по желанию – product_id. Правило с незаполненным полем product_id действует для всех устройств с указанным идентификатором поставщика. Пункт считается неверным и игнорируется, если заполнить только поле product_id, а поле vendor_id оставить пустым.\n\nЕсли это правило не настроено, применяется правило DefaultWebHidGuardSetting при условии, что оно задано. В противном случае действуют персональные настройки пользователя.\n\nURL в этом правиле не должны противоречить настройкам WebHidBlockedForUrls. При возникновении противоречия это правило считается более приоритетным, чем WebHidBlockedForUrls.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "Автоматически разрешать этим сайтам подключение к HID-устройствам, которые содержат данные верхнего уровня об использовании HID.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "Вы можете задать список URL для указания сайтов, которым будет автоматически предоставляться доступ к HID-устройствам с данными верхнего уровня об использовании HID. Чтобы правило работало, каждый пункт списка должен включать поля usages и urls. Для каждого пункта в поле usages нужно задать идентификаторы usage_page и usage. Правило с незаполненным полем usage действует для всех устройств, которые содержат данные верхнего уровня об использовании указанной страницы. Пункт считается неверным и игнорируется, если заполнить только поле usage, а поле usage_page оставить пустым.\n\nЕсли это правило не настроено, применяется правило DefaultWebHidGuardSetting при условии, что оно задано. В противном случае действуют персональные настройки пользователя.\n\nURL в этом правиле не должны противоречить настройкам WebHidBlockedForUrls. При возникновении противоречия это правило считается более приоритетным, чем WebHidBlockedForUrls.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls.";
WebHidAskForUrls.pfm_title = "Разрешить WebHID API на этих сайтах";
WebHidAskForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым разрешено запрашивать у пользователей доступ к HID-устройствам.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultWebHidGuardSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nЕсли шаблоны URL не соответствуют текущему правилу, приоритет имеют следующие правила и параметры в указанном порядке:\n\n  * WebHidBlockedForUrls (если есть совпадение);\n\n  * DefaultWebHidGuardSetting (если настроено);\n\n  * персональные настройки пользователя.\n\nШаблоны URL не должны противоречить шаблонам в правиле WebHidBlockedForUrls. Если URL совпадает с шаблонами в обоих правилах, ни одно из них не имеет приоритета.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается.";
WebHidBlockedForUrls.pfm_title = "Блокировать WebHID API на этих сайтах";
WebHidBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым запрещено запрашивать у пользователей доступ к HID-устройствам.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultWebHidGuardSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nЕсли шаблоны URL не соответствуют текущему правилу, приоритет имеют следующие правила и параметры в указанном порядке:\n\n  * WebHidAskForUrls (если есть совпадение);\n\n  * DefaultWebHidGuardSetting (если настроено);\n\n  * персональные настройки пользователя.\n\nШаблоны URL не должны противоречить шаблонам в правиле WebHidAskForUrls. Если URL совпадает с шаблонами в обоих правилах, ни одно из них не имеет приоритета.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается.";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "Включить сбор журналов диагностики WebRTC для определенных источников";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "Правило позволяет включить сбор диагностических журналов WebRTC для определенных источников.\n\nПодробнее о допустимых шаблонах: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается. Правило работает только с адресами сайтов-источников, поэтому пути в шаблонах URL не учитываются. Поддерживаются схемы и субдомены.\n\nЕсли правило настроено, журналы диагностики будут собираться для источников, соответствующих шаблонам в списке.\n\nЕсли правило не настроено, сбор журналов диагностики по умолчанию отключен.";
WebRtcEventLogCollectionAllowed.pfm_title = "Разрешить сбор журналов событий WebRTC из сервисов Google";
WebRtcEventLogCollectionAllowed.pfm_description = "Если правило включено, Brave может собирать журналы событий WebRTC из сервисов Google (например, Hangouts Meet) и загружать их в Google. В журналах содержится такая информация, как размер пакетов RTP, время их отправки и получения, данные о перегрузке сети, а также метаданные о продолжительности и качестве аудио и видео. Такая информация полезна для отладки звонков и видеовстреч в Brave. В журналах нет самого аудио- и видеоконтента. Для упрощения отладки эти журналы могут быть связаны с журналами сервисов Google с помощью идентификатора сеанса.\n\nЕсли правило отключено, сбор и загрузка журналов не выполняются.\n\nЕсли правило не настроено и используется версия не выше M76, Brave по умолчанию не может собирать и загружать эти журналы. Если используется версия не ниже M77, Brave по умолчанию может собирать и загружать эти журналы из большинства профилей, к которым применяются корпоративные облачные правила на уровне пользователя. Если используется версия от M77 до M80 включительно, Brave также по умолчанию может собирать и загружать эти журналы из профилей, которые находятся под локальным управлением Brave.";
WebRtcIPHandling.pfm_title = "Обработка IP-адресов в WebRTC";
WebRtcIPHandling.pfm_description = "default - При поиске оптимального пути WebRTC будет использовать все доступные интерфейсы.\ndefault_public_and_private_interfaces - WebRTC будет использовать интерфейс только при подключении к открытой Сети, однако может подключаться с помощью частных IP-адресов.\ndefault_public_interface_only - WebRTC будет использовать интерфейс только при подключении к открытой Сети и не будет подключаться с помощью частных IP-адресов.\ndisable_non_proxied_udp - WebRTC будет использовать протокол TCP для общедоступного интерфейса, а протокол UDP – только если он поддерживается настроенным прокси-сервером.\nПравило позволяет определить, какие IP-адреса и интерфейсы WebRTC будет использовать при поиске оптимального подключения.\n\nДопустимые значения:\n\n* default – WebRTC использует все доступные сетевые интерфейсы.\n\n* default_public_and_private_interfaces – WebRTC использует все общедоступные и частные интерфейсы.\n\n* default_public_interface_only – WebRTC использует только общедоступные интерфейсы.\n\n* disable_non_proxied_udp – WebRTC использует либо основной прокси-сервер (UDP SOCKS), либо резервный (TCP).\n\nЕсли правило не настроено, по умолчанию используются все доступные сетевые интерфейсы.\n\nБолее подробное описание значений см. в RFC 8828, раздел 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2).";
WebRtcIPHandlingUrl.pfm_title = "Обработка IP-адресов в URL с помощью WebRTC";
WebRtcIPHandlingUrl.pfm_description = "Правило позволяет определить, какие IP-адреса и интерфейсы использует WebRTC, когда ищет оптимальное подключение для определенного шаблона URL.\n\nПротокол принимает список шаблонов URL и пар типов обработки. Шаблоны проверяются по порядку, и при первом совпадении определяется, какую обработку для домена использует WebRTC. Если URL текущего документа не совпадает ни с одной записью, используется конфигурация, установленная правилом WebRtcIPHandling.\n\nПодробнее о допустимых шаблонах: https://chromeenterprise.google/policies/url-patterns/. Можно использовать подстановочные знаки (*). При сопоставлении шаблонов с URL учитывается только название источника (путь к ресурсу на сервере игнорируется).\n\nДопустимые значения:\n\n* default – WebRTC использует все доступные сетевые интерфейсы.\n\n* default_public_and_private_interfaces – WebRTC использует все общедоступные и частные интерфейсы.\n\n* default_public_interface_only – WebRTC использует только общедоступные интерфейсы.\n\n* disable_non_proxied_udp – WebRTC использует либо основной прокси-сервер (UDP SOCKS), либо резервный (TCP).\n\nБолее подробное описание значений вы найдете в RFC 8828, раздел 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2).\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl.";
WebRtcLocalIpsAllowedUrls.pfm_title = "URL, для которых локальные IP-адреса указываются в ICE-кандидатах WebRTC";
WebRtcLocalIpsAllowedUrls.pfm_description = "Шаблоны, указанные в списке, сверяются с запрашивающим URL.\nЕсли обнаружено соответствие или для функции chrome://flags/#enable-webrtc-hide-local-ips-with-mdns выбрано значение Disabled, то локальные IP-адреса отображаются в ICE-кандидатах WebRTC.\nВ противном случае локальные IP-адреса скрываются с помощью имен хоста mDNS.\nОбратите внимание, что это правило ослабляет защиту локальных IP-адресов (если это нужно администратору).";
WebRtcPostQuantumKeyAgreement.pfm_title = "Включить для WebRTC постквантовый алгоритм согласования ключей";
WebRtcPostQuantumKeyAgreement.pfm_description = "Это правило позволяет управлять постквантовым алгоритмом согласования ключей для WebRTC.\n\nЕсли правило включено, для WebRTC будет предлагаться постквантовый алгоритм согласования ключей.\n\nЕсли правило отключено, для WebRTC постквантовый алгоритм согласования ключей предлагаться не будет.\n\nЕсли правило не настроено, для WebRTC значение постквантового алгоритма согласования ключей будет задано в соответствии установленным по умолчанию процессом выпуска.\n\nТакой алгоритм поддерживает обратную совместимость. Существующие пиры DTLS и промежуточное ПО для организации сетей будут игнорировать этот алгоритм и продолжат выбирать прежние.\n\nОднако на устройствах, где поддержка DTLS реализована некорректно, предложение использовать новый алгоритм может вызывать сбои. Например, устройство может прервать соединение в ответ на неопознанный вариант или последующие объемные сообщения. Если с устройствами, не подготовленными к работе с постквантовыми алгоритмами, возникнут проблемы, администраторам следует обратиться к поставщику.\n\nЭто временное правило, которое будет удалено после ключевых этапов.";
WebRtcTextLogCollectionAllowed.pfm_title = "Разрешить сбор текстовых журналов WebRTC из сервисов Google";
WebRtcTextLogCollectionAllowed.pfm_description = "Если правило включено, Brave может собирать текстовые журналы WebRTC из сервисов Google (например, Google Meet) и загружать их в Google. В журналах содержатся сведения для отладки звонков и видеовстреч в Brave, например текстовые метаданные с описанием входящих и исходящих потоков WebRTC, записи, касающиеся WebRTC, и дополнительная информация о системе. В журналах нет самого аудио- и видеоконтента.\nЕсли правило отключено, журналы не загружаются в Google. Они по-прежнему будут сохраняться на устройстве пользователя.\nЕсли правило не настроено, Brave сможет собирать текстовые журналы и загружать их в Google.";
WebRtcUdpPortRange.pfm_title = "Ограничивать диапазон локальных портов UDP, используемых WebRTC";
WebRtcUdpPortRange.pfm_description = "Если правило задано, диапазон порта UDP, используемого WebRTC, ограничен установленным интервалом порта (включая конечные точки).\n\nЕсли правило не задано либо значением является пустая строка или недействительный диапазон портов, WebRTC будет разрешено использование любого доступного порта UDP.";
WebUsbAllowDevicesForUrls.pfm_title = "Автоматически разрешать этим сайтам подключение к USB-устройствам с предоставленными идентификаторами поставщика и продукта.";
WebUsbAllowDevicesForUrls.pfm_description = "Вы можете задать список шаблонов URL для указания сайтов, которым будет автоматически предоставляться доступ к USB-устройствам с определенными идентификаторами поставщика и продукта. Чтобы правило работало, каждый пункт списка должен включать поля devices и urls. Для каждого пункта в поле devices можно задать идентификаторы vendor_id и product_id. Если не заполнить поле vendor_id, правило будет применяться для всех устройств. Правило с незаполненным полем product_id действует для всех устройств с указанным идентификатором поставщика. Правило не будет работать, если заполнить только поле product_id, а поле vendor_id оставить пустым.\n\nМодель разрешения доступа к USB-устройству предоставит указанному URL доступ к этому устройству как источнику высшего уровня. Если доступ к USB-устройствам требуется встроенным фреймам, предоставить его нужно с помощью заголовка feature-policy (usb). Необходимо указать действительный URL, иначе правило будет игнорироваться.\n\nМодель разрешения доступа к USB-устройству, которая позволяла указывать запрашивающий и встраивающий URL, больше не поддерживается. Она может использоваться для обеспечения обратной совместимости только следующим образом: если указаны оба URL (встраивающий и запрашивающий), встраивающему URL будет предоставлено разрешение как источнику высшего уровня, а запрашивающий URL будет полностью игнорироваться.\n\nЭто правило переопределяет параметр DefaultWebUsbGuardSetting, правила WebUsbAskForUrls и WebUsbBlockedForUrls, а также пользовательские настройки.\n\nОно влияет только на доступ к USB-устройствам через WebUSB API. Чтобы предоставить доступ к USB-устройствам через Web Serial API, посмотрите правило SerialAllowUsbDevicesForUrls.\nЧтобы узнать больше о наборе атрибутов и форматировании, перейдите по ссылке https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls.";
WebUsbAskForUrls.pfm_title = "Разрешить WebUSB на этих сайтах.";
WebUsbAskForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым разрешено запрашивать у пользователей доступ к USB-устройствам.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultWebUsbGuardSetting при условии, что оно задано. В противном случае применяются персональные настройки пользователя.\n\nШаблоны URL не должны противоречить шаблонам в правиле WebUsbAskForUrls. Если URL совпадает с шаблонами в обоих правилах, ни одно из них не имеет приоритета.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение * для этого правила не поддерживается.";
WebUsbBlockedForUrls.pfm_title = "Блокировать WebUSB на этих сайтах.";
WebUsbBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL, чтобы указать сайты, которым запрещено запрашивать у пользователей доступ к USB-устройствам.\n\nЕсли правило не настроено, для всех сайтов действует правило DefaultWebUsbGuardSetting. Если не задано и оно, применяются персональные настройки пользователя.\n\nШаблоны URL не должны противоречить шаблонам в правиле WebUsbAskForUrls. Если URL совпадает с шаблонами в обоих правилах, ни одно из них не имеет приоритета.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns. Значение \"*\" для этого правила не поддерживается.";
WindowCaptureAllowedByOrigins.pfm_title = "Разрешить захват окна и вкладки этими источниками";
WindowCaptureAllowedByOrigins.pfm_description = "Правило позволяет задать список шаблонов URL, которые могут захватывать окно и вкладку.\n\nЕсли правило не настроено, система не будет проверять, нужно ли переопределить значение по умолчанию для захвата выбранного типа.\n\nПравило не действует, если сайт соответствует шаблону URL в правиле TabCaptureAllowedByOrigins или SameOriginTabCaptureAllowedByOrigins.\n\nЕсли адрес сайта совпадает с шаблоном URL в WindowCaptureAllowedByOrigins, то не учитываются правила ScreenCaptureAllowedByOrigins и ScreenCaptureAllowed.\n\nПодробнее о допустимых шаблонах url: https://chromeenterprise.google/policies/url-patterns/.  При сопоставлении шаблонов с URL учитывается только название источника (путь к ресурсу на сервере игнорируется).";
WindowManagementAllowedForUrls.pfm_title = "Разрешить управление окнами на этих сайтах";
WindowManagementAllowedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым автоматически разрешено управлять окнами. При этом у сайтов появляется доступ к информации об экране устройства, которую они могут использовать, чтобы открывать и размещать окна или переходить в полноэкранный режим на некоторых экранах.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки: *. Это правило работает только с адресами сайтов-источников, поэтому пути в шаблонах URL не учитываются.\n\nЕсли правило не настроено, то для сайта применяется правило DefaultWindowManagementSetting при условии, что оно задано. В противном случае действуют параметры браузера по умолчанию, а пользователи сами выбирают, каким сайтам предоставлять разрешение.\n\nЭто правило заменяет правило WindowPlacementAllowedForUrls, которое больше не поддерживается.";
WindowManagementBlockedForUrls.pfm_title = "Запретить управление окнами на этих сайтах";
WindowManagementBlockedForUrls.pfm_description = "Позволяет задать список шаблонов URL сайтов, которым автоматически запрещено управлять окнами. При этом для сайтов ограничивается доступ к информации об экране устройства, без которой они не могут открывать и размещать окна или переходить в полноэкранный режим на некоторых экранах.\n\nПодробнее о допустимых шаблонах URL: https://chromeenterprise.google/policies/url-patterns. Разрешается использовать подстановочные знаки (*). Это правило работает только с адресами сайтов-источников, поэтому пути в шаблонах URL не учитываются.\n\nЕсли правило не настроено, то для сайта применяется правило DefaultWindowManagementSetting при условии, что оно задано. В противном случае действуют параметры браузера по умолчанию, а пользователи сами выбирают, каким сайтам предоставлять разрешение.\n\nЭто правило заменяет правило WindowPlacementBlockedForUrls, которое больше не поддерживается.";
XSLTEnabled.pfm_title = "Управление доступностью функции XSLT";
XSLTEnabled.pfm_description = "Это правило определяет, доступна ли функция XSLT (XSLTProcessor JavaScript API и инструкция по обработке XSL).\nЕсли правило включено, функция XSLT доступна независимо от ее состояния по умолчанию в браузере.\nЕсли правило отключено, функция XSLT недоступна независимо от ее состояния по умолчанию в браузере.\nЕсли правило не настроено, доступность XSLT определяется настройками браузера по умолчанию и экспериментальными функциями.\nЭто временное правило, которое будет удалено в версии M176.";