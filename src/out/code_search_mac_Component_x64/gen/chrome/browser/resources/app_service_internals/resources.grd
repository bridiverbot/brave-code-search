<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/app_service_internals_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/app_service_internals_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/app_service_internals_resources_map.h"
            type="resource_map_header" />
    <output filename="app_service_internals_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_APP_SERVICE_INTERNALS_INDEX_HTML" file="${root_gen_dir}/chrome/browser/resources/app_service_internals/preprocessed/index.html" resource_path="index.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_APP_SERVICE_INTERNALS_APP_SERVICE_INTERNALS_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/app_service_internals/minified/app_service_internals.html.js" resource_path="app_service_internals.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_APP_SERVICE_INTERNALS_APP_SERVICE_INTERNALS_JS" file="${root_gen_dir}/chrome/browser/resources/app_service_internals/minified/app_service_internals.js" resource_path="app_service_internals.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_APP_SERVICE_INTERNALS_APP_SERVICE_INTERNALS_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/app_service_internals/minified/app_service_internals.mojom-webui.js" resource_path="app_service_internals.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
