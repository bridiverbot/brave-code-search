/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Preferencias de Brave";
AIModeSettings.pfm_title = "Configuración de las integraciones de Modo IA de Google en la barra de direcciones y en el cuadro de búsqueda de la página Nueva pestaña.";
AIModeSettings.pfm_description = "0 - Permitir integraciones de Modo IA.\n1 - No permitir integraciones de Modo IA.\nEsta política controla las integraciones del Modo IA de Google en la barra de direcciones y en el cuadro de búsqueda de una nueva pestaña.\n\nPara acceder a esta función, Google debe estar configurado como buscador predeterminado del usuario.\n\nSi se le asigna el valor 0, la función estará disponible para los usuarios.\n\nSi se le asigna el valor 1, la función no estará disponible para los usuarios.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.";
AbusiveExperienceInterventionEnforce.pfm_title = "Aplicar intervención de experiencia abusiva";
AbusiveExperienceInterventionEnforce.pfm_description = "Si no se inhabilita SafeBrowsingEnabled, habilitar AbusiveExperienceInterventionEnforce o dejarla sin definir evita que sitios web con experiencias engañosas abran ventanas o pestañas nuevas.\n\nSi se inhabilitan SafeBrowsingEnabled o AbusiveExperienceInterventionEnforce, se permitirá que los sitios web con experiencias engañosas abran nuevas ventanas o pestañas.";
AccessCodeCastDeviceDuration.pfm_title = "Especifica cuánto tiempo (en segundos) permanece un dispositivo de emisión seleccionado con un código de acceso o un código QR en la lista de dispositivos de emisión del menú de Google Cast.";
AccessCodeCastDeviceDuration.pfm_description = "Esta política especifica cuánto tiempo (en segundos) se puede ver un dispositivo de emisión seleccionado previamente con un código de acceso o un código QR en la lista de dispositivos de emisión del menú de Google Cast.\nLa duración de una entrada comienza en el momento en el que se introduce el código de acceso o se escanea el código QR por primera vez.\nDurante este periodo, el dispositivo de emisión aparecerá en la lista de dispositivos de emisión del menú de Google Cast.\nUna vez terminado el periodo de tiempo, habrá que volver a introducir el código de acceso o escanear el código QR para poder usar de nuevo el dispositivo de emisión.\nDe forma predeterminada, el periodo es de 0 segundos, por lo que los dispositivos de emisión no permanecerán en el menú de Google Cast y, por tanto, habrá que volver a introducir el código de acceso o escanear el código QR para iniciar una nueva sesión de envío.\nTen en cuenta que esta política solo afecta al tiempo que aparece un dispositivo de emisión en el menú de Google Cast, pero no tiene ningún efecto sobre una sesión de envío que esté en progreso, la cual continuará aunque termine el periodo.\nEsta política no tendrá efecto a menos que la política AccessCodeCastEnabled esté habilitada.";
AccessCodeCastEnabled.pfm_title = "Permitir que los usuarios seleccionen dispositivos de emisión con un código de acceso o un código QR desde el menú de Google Cast.";
AccessCodeCastEnabled.pfm_description = "Esta política controla si al usuario se le ofrecerá una opción en el menú de Google Cast que le permita enviar contenido a dispositivos de emisión que no aparezcan en el menú de Google Cast mediante un código de acceso o un código QR que aparezca en la pantalla del dispositivo de emisión.\nDe forma predeterminada, el usuario debe volver a introducir el código de acceso o escanear el código QR para poder iniciar otra sesión de envío. Sin embargo, si a la política AccessCodeCastDeviceDuration se le ha asignado un valor diferente a cero (el predeterminado es cero), el dispositivo de emisión permanecerá en la lista de dispositivos de emisión disponibles hasta que termine el periodo de tiempo especificado.\nSi se habilita esta política, a los usuarios se les ofrecerá la opción de seleccionar dispositivos de emisión mediante un código de acceso o un código QR.\nSi se inhabilita esta política o no se establece, a los usuarios no se les ofrecerá la opción de seleccionar dispositivos de emisión mediante un código de acceso o un código QR.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "Hacer que los Access-Control-Allow-Methods que coinciden en la solicitud preparatoria de CORS cumplan las especificaciones";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Esta política controla si los métodos de solicitud se pondrán en mayúsculas cuando coincidan con encabezados de respuesta Access-Control-Allow-Methods en la solicitud preparatoria de CORS.\n\nSi se inhabilita esta política, los métodos de solicitud se ponen en mayúsculas.\nEste es el comportamiento de la versión 108 de Brave o anteriores.\n\nSi se habilita esta política o no se establece, los métodos de solicitud no se ponen en mayúsculas, salvo que coincidan sin distinguir entre mayúsculas y minúsculas con DELETE, GET, HEAD, OPTIONS, POST o PUT.\nEsto rechazaría el encabezado de respuesta fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" y aceptaría el encabezado de respuesta fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\".\n\nNota: los métodos de solicitud \"post\" y \"put\" no se ven afectados, pero \"patch\" sí.\n\nEsta política es temporal y se eliminará más adelante.";
AccessibilityImageLabelsEnabled.pfm_title = "Habilitar Get Image Descriptions from Google";
AccessibilityImageLabelsEnabled.pfm_description = "La función de accesibilidad\nde Get Image Descriptions from Google permite que las personas con discapacidad visual que usen un lector de pantalla\nobtengan descripciones de imágenes sin etiquetar en la Web. Los usuarios que habiliten esta función\ntendrán la opción de usar un servicio anónimo de Google para proporcionar\ndescripciones automáticas de las imágenes sin etiquetar que encuentren en la Web.\n\nSi esta función está habilitada, se enviará el contenido de las imágenes a los servidores\nde Google para generar una descripción. No se enviarán cookies ni otros\ndatos del usuario. Además, Google no guardará ni registrará el contenido de las imágenes.\n\nSi se habilita esta política,\nse habilitará\nla función Get Image Descriptions from Google, aunque solo afectará a los usuarios que usen un\nlector de pantalla u otra tecnología asistencial similar.\n\nSi se inhabilita esta política, los usuarios no tendrán la opción de habilitar\nesta función.\n\nSi no se define esta política, el usuario puede decidir si quiere usar esta función o no.\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "Permitir consultas de DNS de tipos de registro DNS adicionales";
AdditionalDnsQueryTypesEnabled.pfm_description = "Esta política controla si Brave puede consultar tipos de registro DNS adicionales al hacer solicitudes DNS no seguras. Esta política no afecta a las consultas de DNS realizadas a través de la función DNS seguro, que puede consultar tipos de DNS adicionales en cualquier momento.\n\nSi se le asigna el valor Enabled a esta política o no se establece, se podrán consultar tipos adicionales, como HTTPS (tipo de DNS 65), además de A (tipo de DNS 1) y AAAA (tipo de DNS 28).\n\nSi se le asigna el valor Disabled a la política, solo se podrán consultar los tipos A (tipo de DNS 1) y AAAA (tipo de DNS 28).\n\nEsta política es una medida temporal y se eliminará en futuras versiones de Brave. Cuando se elimine, Brave podrá consultar tipos de DNS adicionales en cualquier momento.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Configuración de anuncios de sitios web con anuncios invasivos";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Permitir anuncios en todos los sitios web\n2 - No permitir anuncios en sitios web con anuncios invasivos\nSalvo que asignes el valor \"False\" a SafeBrowsingEnabled, si AdsSettingForIntrusiveAdsSites tiene un valor de 1 o ningún valor asignado, podrán aparecer anuncios en todos los sitios web.\n\nSi asignas el valor \"2\" a esta política, se bloquearán los anuncios de sitios web con anuncios invasivos.";
AdvancedProtectionAllowed.pfm_title = "Permitir que los usuarios registrados en el Programa de Protección Avanzada cuenten con más opciones de protección";
AdvancedProtectionAllowed.pfm_description = "Esta política controla si los usuarios registrados en el Programa de Protección Avanzada tienen acceso a funciones de protección adicionales. Puede que algunas de estas funciones requieran compartir datos con Google (por ejemplo, los usuarios de Protección Avanzada podrán enviar sus descargas a Google para que realice un análisis de malware). Si se asigna el valor \"True\" a esta política o no se le asigna ningún valor, los usuarios registrados tendrán acceso a funciones de protección adicionales. Si se le asigna el valor \"False\", los usuarios de Protección Avanzada solo tendrán acceso a las funciones estándar.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Lista de orígenes que permiten todas las autenticaciones de HTTP";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "Si se define esta política, se especificará desde qué orígenes se deben permitir los esquemas de autenticación HTTP admitidos por Brave, independientemente de la política AuthSchemes.\n\nA partir de la versión 161 de Brave, esta política solo se aplica a los orígenes de los servidores de destino y no a los desafíos de autenticación de los servidores proxy. Para permitir todos los esquemas de autenticación HTTP en servidores proxy, utiliza la política AllHttpAuthSchemesAllowedForProxies. Antes de la versión 161, los servidores proxy que cumplían esta política también podían usar todos los esquemas de autenticación HTTP, a menos que se definiera AllHttpAuthSchemesAllowedForProxies.\n\nEl patrón de origen debe tener el formato que se indica en esta página: https://support.google.com/chrome/a?p=url_blocklist_filter_format. Pueden definirse hasta 1000 excepciones en AllHttpAuthSchemesAllowedForOrigins.\nSe permiten comodines para el componente de host (por ejemplo, \"*:8000\" coincide con todos los hosts del puerto 8000). Para que coincida con todos los esquemas o todos los puertos, omite el componente por completo (por ejemplo, \"example.com\" coincide con cualquier esquema y cualquier puerto). Un nombre de host (por ejemplo, \"example.com\") también coincide con sus subdominios. Para que coincida exactamente con un host y excluir sus subdominios, añade un punto delante (por ejemplo, \".example.com\"). Para que coincidan todos los orígenes, usa un solo asterisco (\"*\").";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Lista de servidores proxy que permiten todos los esquemas de autenticación HTTP";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "Si se define esta política, se especificará en qué servidores proxy se deben permitir los esquemas de autenticación HTTP admitidos por Brave, independientemente de la política AuthSchemes.\n\nEl patrón del servidor proxy debe seguir el formato de filtro de la lista de URLs bloqueadas (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Se pueden definir un máximo de 1000 excepciones.\nSe permiten comodines para el componente de host (por ejemplo, \"*:8080\" coincide con todos los proxies del puerto 8080). Un nombre de host (por ejemplo, \"proxy.example.com\") también coincide con sus subdominios. Para que coincida exactamente con un host y excluir sus subdominios, añade un punto delante (por ejemplo, \".proxy.example.com\").\n\nSi no se define esta política, solo se admitirán para la autenticación de proxy los esquemas de autenticación HTTP especificados en AuthSchemes (o los esquemas predeterminados si no se han definido).";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Permitir que las páginas con el encabezado Cache-Control: no-store se guarden en la caché de páginas completas";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Esta política controla si una página con el encabezado Cache-Control: no-store se puede almacenar en la caché de páginas completas. Es posible que el sitio web que configura este encabezado no espere que se restaure la página desde la caché de páginas completas, ya que parte de la información sensible podría seguir mostrándose después de la restauración aunque ya no se pueda acceder a ella.\n\nSi se habilita esta política o no se define, es posible que la página con el encabezado Cache-Control: no-store se restaure desde la caché de páginas completas, a menos que se quite de la caché (por ejemplo, cuando haya un cambio de cookies exclusivas del protocolo HTTP en el sitio).\n\nSi se inhabilita esta política, la página con el encabezado Cache-Control: no-store no se almacenará en la caché de páginas completas.";
AllowCrossOriginAuthPrompt.pfm_title = "Solicitudes de autenticación HTTP de origen cruzado";
AllowCrossOriginAuthPrompt.pfm_description = "Si se habilita esta política, se permite que las imágenes de terceros de una página muestren una solicitud de autenticación.\n\nSi se inhabilita la política o no se define, las imágenes de terceros no podrán mostrar una solicitud de autenticación.\n\nEsta política suele estar inhabilitada para ofrecer protección contra phishing.";
AllowDeletingBrowserHistory.pfm_title = "Habilitar eliminación de historial de navegación y de descargas";
AllowDeletingBrowserHistory.pfm_description = "Si la política se habilita o no se define, el historial de navegación y el historial de descargas se podrán eliminar en Chrome, y los usuarios no podrán cambiar este ajuste.\n\nSi la política se inhabilita, el historial de navegación y el de descargas no se podrán eliminar. Aunque la política esté desactivada, no se garantiza que los historiales de navegación y de descargas se puedan conservar. Es posible que los usuarios puedan editar o eliminar directamente los archivos de la base de datos del historial. Además, el propio navegador puede archivar o clasificar como caducados elementos del historial en cualquier momento.";
AllowDinosaurEasterEgg.pfm_title = "Permitir el juego del huevo de pascua de dinosaurio";
AllowDinosaurEasterEgg.pfm_description = "Si se asigna el valor true a esta política, los usuarios podrán jugar al juego del dinosaurio. Si se le asigna el valor false, los usuarios no podrán jugar al juego del huevo de pascua del dinosaurio cuando el dispositivo no tenga conexión.\n\nSi no se define esta política, los usuarios no podrán jugar al juego del dinosaurio en dispositivos Google Chrome OS registrados, pero podrán hacerlo en otras circunstancias.";
AllowFileSelectionDialogs.pfm_title = "Permitir solicitud de cuadros de diálogo de selección de archivos";
AllowFileSelectionDialogs.pfm_description = "Si se habilita esta política o no se le asigna ningún valor, Chrome podrá mostrar cuadros de diálogo de selección de archivos, y los usuarios podrán abrirlos.\n\nSi se inhabilita esta política, cuando un usuario ejecute una acción que abra un cuadro de diálogo de selección de archivos (por ejemplo, importar marcadores, subir archivos, guardar enlaces, etc.), aparecerá un mensaje en su lugar. Se asume que el usuario habrá hecho clic en Cancelar en el cuadro de diálogo de selección de archivos.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Permitir la aleatorización del tamaño del grupo de sockets para proxies";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "La aleatorización del tamaño del grupo de sockets es un mecanismo de seguridad que impide que los atacantes aprovechen los límites de capacidad deterministas para obtener información entre sitios.\nSi la capacidad de un grupo es normalmente de 128 sockets, este mecanismo limita aleatoriamente el grupo entre 128 y 256.\nEsto puede permitir hasta el doble de conexiones al proxy, pero en la práctica el valor esperado es más bien 1,2 veces.\n\nEsto afecta a los ajustes de MaxConnectionsPerProxy y MaxConnectionsPerProxyForWebSocket.\nEn lugar de definir el límite superior, este es el doble de sus valores (aunque, en la práctica, el valor esperado suele ser 1,2 veces superior).\n\nEsta opción está habilitada de forma predeterminada en todos los grupos, pero esta política permite inhabilitarla específicamente en los grupos de proxies.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Permitir solicitudes de Web Authentication en sitios con certificados TLS rotos.";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Si se habilita esta política, Brave permitirá las solicitudes de Web Authentication de los sitios web que tengan certificados TLS con errores (por ejemplo, sitios web que no se consideren seguros).\n\nSi se inhabilita esta política o no se define, se aplicará el comportamiento predeterminado de bloquear dichas solicitudes.";
AllowedDomainsForApps.pfm_title = "Definir dominios con permiso para acceder a Google Workspace";
AllowedDomainsForApps.pfm_description = "Si se define esta política, se activará la función de inicio de sesión restringido de Chrome en Google Workspace. Los usuarios no podrán cambiar este ajuste. Los usuarios solo podrán acceder a las herramientas de Google desde cuentas de los dominios especificados. Si quieres dar permiso a cuentas gmail o googlemail, añade consumer_accounts a la lista de dominios. Este ajuste impide que los usuarios inicien sesión y añadan una cuenta secundaria en un dispositivo gestionado que requiera autenticación de Google si esa cuenta no pertenece a uno de los dominios explícitamente permitidos.\n\nSi este ajuste se deja vacío o sin definir, los usuarios podrán acceder a Google Workspace con cualquier cuenta.\n\nLos usuarios no podrán modificar ni anular este ajuste.\n\nNota: Esta política provoca que el encabezado X-GoogApps-Allowed-Domains se añada a todas las solicitudes HTTP y HTTPS en todos los dominios de google.com, como se describe en https://support.google.com/a/answer/1668854.";
AlternateErrorPagesEnabled.pfm_title = "Habilitar páginas de error alternativas";
AlternateErrorPagesEnabled.pfm_description = "Si se asigna el valor true a esta política, Brave usará páginas de error alternativas que vienen incorporadas (como \"No se encuentra la página\"). Si se le asigna el valor false, Brave nunca usará páginas de error alternativas.\n\nSi se define esta política, los usuarios no podrán modificarla. Si no se define, la política estará activada, pero los usuarios podrán cambiar este ajuste.";
AlternativeBrowserParameters.pfm_title = "Parámetros de línea de comandos correspondientes al navegador alternativo.";
AlternativeBrowserParameters.pfm_description = "Si se define esta política como una lista de cadenas, cada cadena se pasará al navegador alternativo como parámetros de línea de comandos separados. En Microsoft® Windows®, los parámetros se unen con espacios. En macOS y Linux®, un parámetro puede contener espacios y procesarse como un solo parámetro.\n\nSi un parámetro contiene la variable ${url}, ${url} se sustituirá por la URL de la página que se vaya a abrir. Si ningún parámetro contiene la variable ${url}, la URL se añadirá al final de la línea de comandos.\n\nLas variables de entorno se expanden. En Microsoft® Windows®, %ABC% se sustituirá por el valor de la variable de entorno ABC. En macOS y Linux®, ${ABC} se sustituirá por el valor de la variable de entorno ABC.\n\nSi no se asigna ningún valor a esta política, solo la URL se pasará como parámetro de línea de comandos.";
AlternativeBrowserPath.pfm_title = "Navegador alternativo donde se abren los sitios web configurados.";
AlternativeBrowserPath.pfm_description = "Esta política controla el comando que se utilizará para abrir URLs en un navegador alternativo. Se le puede asignar uno de estos valores: ${ie}, ${firefox}, ${safari}, ${opera}, ${edge} o una ruta de archivo. Si se asigna una ruta de archivo a esta política, el archivo se usará como ejecutable. ${ie} solo está disponible en Microsoft® Windows®. ${safari} y ${edge} solo están disponibles en Microsoft® Windows® y macOS.\n\nSi no se asigna ningún valor a esta política, se usará el navegador predeterminado según el sistema operativo: Internet Explorer® en Microsoft® Windows® o Safari® en macOS. No se podrá abrir ningún navegador alternativo en Linux®.";
AlwaysOpenPdfExternally.pfm_title = "Abrir siempre los archivos PDF de forma externa";
AlwaysOpenPdfExternally.pfm_description = "Si se habilita esta política, se desactivará el visor interno de PDF en Brave, los archivos PDF se tratarán como descargas y los usuarios podrán abrir PDFs con la aplicación predeterminada.\n\nSi se inhabilita, se abrirán los archivos PDF, a menos que los usuarios desactiven el complemento de PDF.\n\nSi se define esta política, los usuarios no podrán modificarla en Brave. Si no se define, los usuarios podrán elegir si se abren o no los PDFs de forma externa.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Habilita la autenticación pasiva para tipos de perfil.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Habilita la autenticación pasiva solo en sesiones normales.\n1 - Habilita la autenticación pasiva en sesiones normales y de incógnito.\n2 - Habilita la autenticación pasiva en sesiones normales y de invitado.\n3 - Habilita la autenticación pasiva en sesiones normales, de incógnito y de invitado.\nAl configurar esta política, se habilita o inhabilita la autenticación pasiva para los perfiles de incógnito y de invitado en Brave.\n\nLa autenticación pasiva permite realizar la autenticación HTTP con credenciales predeterminadas si no se proporcionan credenciales explícitas a través de estructuras de desafío-respuesta de NTLM, Kerberos o Negotiate.\n\nSi se establece la opción RegularOnly (valor 0), se permite la autenticación pasiva únicamente en las sesiones normales. Las sesiones de incógnito y de invitado no podrán usar la autenticación pasiva.\n\nSi se establece la opción IncognitoAndRegular (valor 1), se permite la autenticación pasiva en las sesiones normales y de incógnito. Las sesiones de invitado no podrán usar la autenticación pasiva.\n\nSi se establece la opción GuestAndRegular (valor 2), se permite la autenticación pasiva en las sesiones normales y de invitado. Las sesiones de incógnito no podrán usar la autenticación pasiva.\n\nSi se establece la opción All (valor 3), se permite la autenticación pasiva en todas las sesiones.\n\nTen en cuenta que la autenticación pasiva siempre está permitida en los perfiles normales.\n\nEn la versión 81 y versiones posteriores de Brave, si no se establece la política, la autenticación pasiva se habilitará únicamente en las sesiones normales.";
AudioCaptureAllowed.pfm_title = "Permitir o denegar captura de audio";
AudioCaptureAllowed.pfm_description = "Si se asigna el valor \"Habilitada\" a esta política o no se le asigna ninguno, significa que, con la excepción de las URL que se hayan incluido en la lista AudioCaptureAllowedUrls, se solicitará a los usuarios acceso a la captura de audio.\n\nSi se le asigna el valor \"Inhabilitada\", se desactivarán los mensajes de solicitud de acceso y la captura de audio solo estará disponible para las URL incluidas en la lista AudioCaptureAllowedUrls.\n\nNota: Esta política afecta a todas las entradas de audio, no solo al micrófono integrado.";
AudioCaptureAllowedUrls.pfm_title = "URLs a las que se concederá acceso a dispositivos de captura de audio sin confirmación";
AudioCaptureAllowedUrls.pfm_description = "Si se define esta política, se especificará la lista de URLs cuyos patrones se compararán con el origen de seguridad de la URL solicitante. Si se encuentra una coincidencia, se concederá acceso a dispositivos de captura de audio sin solicitarlo.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/. Sin embargo, ten en cuenta que esta política no admite el patrón \"*\", que coincide con cualquier URL.";
AudioSandboxEnabled.pfm_title = "Permite ejecutar el entorno aislado de audio";
AudioSandboxEnabled.pfm_description = "Esta política controla el entorno aislado de audio.\nSi la política se habilita, el proceso de audio se ejecutará en un entorno aislado.\nSi se inhabilita, el proceso de audio se ejecutará fuera del entorno aislado, y el módulo WebRTC de procesamiento de audio se ejecutará en el proceso de renderización.\nLos usuarios quedarán expuestos a riesgos de seguridad relacionados con la ejecución del subsistema de audio fuera del entorno aislado.\nSi no se define esta política, se usará la configuración predeterminada del entorno aislado de audio, que puede variar según la plataforma.\nEl objetivo de esta política es ofrecer a las empresas la posibilidad de inhabilitar el entorno aislado de audio si usan configuraciones de software de seguridad que interfieren con el entorno aislado.";
AuthNegotiateDelegateAllowlist.pfm_title = "Lista de permitidos de servidores de delegación Kerberos";
AuthNegotiateDelegateAllowlist.pfm_description = "Si se define esta política, asignará los servidores en los que puede delegar Brave. Si hay varios nombres de servidores, se deben separar con comas. Se permite el uso de caracteres comodín (*).\n\nSi no se define esta política, Brave no delegará las credenciales de usuario aunque se detecte una intranet como servidor.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Usa la política del centro de distribución de llaves (KDC) para delegar credenciales.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Si se habilita esta política, la autenticación HTTP respetará la aprobación por parte de la política del centro de distribución de claves (KDC). Es decir, Brave delegará las credenciales de usuario al servicio al que se esté accediendo si el KDC define el valor OK-AS-DELEGATE en el ticket de servicio. Consulta la RFC 5896 (https://tools.ietf.org/html/rfc5896.html). También es necesario que AuthNegotiateDelegateAllowlist permita este servicio.\n\nSi se inhabilita esta política o no se define, se ignorará la política del KDC en las plataformas admitidas y solo se respetará la política AuthNegotiateDelegateAllowlist.\n\nEn Microsoft® Windows®, la política del KDC se respeta siempre.";
AuthSchemes.pfm_title = "Esquemas de autenticación admitidos";
AuthSchemes.pfm_description = "Si se define esta política, especificará los esquemas de autenticación HTTP admitidos por Brave.\n\nSi no se define, se utilizarán los cuatro esquemas.\n\nLos valores válidos son los siguientes:\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nNota: Si hay varios valores, se deben separar con comas.";
AuthServerAllowlist.pfm_title = "Lista de permitidos de servidores de autenticación";
AuthServerAllowlist.pfm_description = "Si se define esta política, especificará qué servidores deberían tener permiso para la autenticación integrada. La autenticación integrada solo se activará cuando Brave reciba una solicitud de autenticación de un proxy o un servidor que esté incluido en la lista de permitidos.\n\nSi no se define esta política, Brave intentará detectar si un servidor está en la intranet y solo en ese caso responderá a las solicitudes de IWA. Si se detecta que un servidor está en Internet, Brave ignorará las solicitudes de IWA que procedan de dicho servidor.\n\nNota: Si hay varios nombres de servidores, se deben separar con comas. Se permite el uso de caracteres comodín (*).";
AutoLaunchProtocolsFromOrigins.pfm_title = "Definir una lista de protocolos que pueden abrir una aplicación externa de orígenes autorizados sin pedir permiso al usuario";
AutoLaunchProtocolsFromOrigins.pfm_description = "Permite definir una lista de protocolos y una lista asociada de patrones de origen permitidos para cada uno de los protocolos que pueden abrir una aplicación externa sin pedir permiso al usuario. No se debe incluir el separador del final al añadir el protocolo a la lista, así que añade \"skype\" en lugar de \"skype:\" o \"skype://\".\n\nSi se define esta política, un protocolo solo podrá abrir una aplicación externa sin pedir permiso (por política) si está en la lista y si el origen del sitio que intenta iniciar el protocolo coincide con uno de los patrones de origen de la lista allowed_origins del protocolo. Si no se cumple alguna de estas condiciones, esta política no omitirá la solicitud para iniciar el protocolo externo.\n\nSi no se define esta política, no se podrá iniciar ningún protocolo sin pedir permiso (de forma predeterminada). Los usuarios pueden rechazar las solicitudes por protocolo o por sitio, a menos que la política ExternalProtocolDialogShowAlwaysOpenCheckbox se inhabilite. Esta política no tiene ningún efecto sobre las exenciones de solicitudes por protocolos o por sitios establecidas por los usuarios.\n\nLos patrones que coinciden con el origen tienen un formato similar a los de la política URLBlocklist, tal y como se indica en la página https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSin embargo, los patrones de esta política que coinciden con el origen no pueden contener los elementos \"/path\" ni \"@query\". Se ignorarán todos los patrones que contengan un elemento \"/path\" o \"@query\".\nConsulta la página https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins para obtener más información sobre el esquema y el formato.";
AutoOpenAllowedForURLs.pfm_title = "URL a las que se puede aplicar AutoOpenFileTypes";
AutoOpenAllowedForURLs.pfm_description = "Lista de URLs que especifica a qué URLs se aplicará AutoOpenFileTypes. Esta política no afecta a los valores abiertos automáticamente por los usuarios.\n\nSi se establece esta política, los archivos se abrirán automáticamente solo si la URL está incluida en la lista y el tipo de archivo aparece en AutoOpenFileTypes. Si no se cumple alguna de estas condiciones, la política no abrirá automáticamente el archivo descargado.\n\nSi no se establece esta política, todos los archivos descargados de los tipos incluidos en AutoOpenFileTypes se abrirán automáticamente.\n\nLos patrones de URL deben tener el formato que se indica en https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
AutoOpenFileTypes.pfm_title = "Lista de tipos de archivo que deberían abrirse automáticamente al descargarse";
AutoOpenFileTypes.pfm_description = "Lista de tipos de archivo que deberían abrirse automáticamente al descargarse. No se debe incluir el separador inicial al añadir un tipo de archivo a la lista, así que añade \"txt\" en lugar de \".txt\".\n\nLos archivos de los tipos que se deben abrir automáticamente seguirán estando sujetos a las comprobaciones de Navegación segura y no se abrirán si no las superan.\n\nSi no se establece esta política, solo se abrirán automáticamente al descargarse los tipos de archivo que haya especificado el usuario.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
AutoSelectCertificateForUrls.pfm_title = "Seleccionar automáticamente certificados de cliente de estos sitios";
AutoSelectCertificateForUrls.pfm_description = "Si configuras esta política, podrás crear una lista de patrones de URL donde se especifique en qué sitios web podrá usar Chrome un certificado de cliente de forma automática. El valor debe ser un conjunto de diccionarios JSON de tipo string, cada uno con el formato { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER }, donde $URL_PATTERN es un patrón de configuración de contenido. $FILTER restringe los certificados de cliente entre los que puede elegir automáticamente el navegador. Independientemente del filtro, solo se seleccionarán los certificados que coincidan con la solicitud de certificado del servidor. En Android y iOS, Chrome solo puede seleccionar certificados de cliente que haya aprovisionado él mismo; no puede acceder a los certificados instalados a nivel de sistema operativo.\n\nEjemplos del uso de la sección $FILTER:\n\n* Si se asigna el valor { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } } a $FILTER, solo se seleccionarán los certificados de cliente emitidos por un certificado en el que CommonName tenga el valor $ISSUER_CN.\n\n* Si $FILTER contiene las secciones \"ISSUER\" y \"SUBJECT\", solo se seleccionarán los certificados de cliente que cumplan ambas condiciones.\n\n* Si $FILTER contiene una sección \"SUBJECT\" con el valor \"O\", el certificado debe contener al menos una organización que coincida con el valor especificado para que se pueda seleccionar.\n\n* Si $FILTER contiene una sección \"SUBJECT\" con un valor \"OU\", el certificado debe contener al menos una unidad organizativa que coincida con el valor especificado para que se pueda seleccionar.\n\n* Si se asigna el valor {} a $FILTER, no se aplicarán más restricciones a la selección de certificados de cliente. Ten en cuenta que seguirán aplicándose los filtros proporcionados por el servidor web.\n\nSi no se asigna ningún valor a esta política, no se aplicará la selección automática en ningún sitio web.\nConsulta la página https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls para obtener más información sobre el esquema y el formato.";
AutofillGenAiSettings.pfm_title = "Configuración de las funciones de IA generativa en Autocompletar";
AutofillGenAiSettings.pfm_description = "0 - Permitir funciones de IA generativa en Autocompletar y mejorar los modelos de IA.\n1 - Permitir funciones de IA generativa en Autocompletar sin mejorar los modelos de IA.\n2 - No permitir funciones de IA generativa en Autocompletar.\nEstas funciones de Brave utilizan modelos de IA generativa para ayudar a los usuarios a rellenar formularios en la Web. Para usar estas funciones, Brave tiene que recoger datos como la estructura de los formularios con los que interactúa un usuario y, en el caso de Buscar y rellenar con Gemini, las consultas de texto libre que introduce un usuario para buscar en las aplicaciones de Gemini conectadas, y enviar esos datos a un servidor que pertenece a Google y ejecuta un modelo de IA generativa.\n\nSi se le asigna el valor 0 (Permitir funciones de IA generativa en Autocompletar y mejorar los modelos de IA) a la política, se permite usar las funciones y que Google utilice datos pertinentes para mejorar sus modelos de IA. Según la función, los datos pertinentes pueden ser peticiones, entradas, resultados, fuentes y comentarios escritos. 0 es el valor predeterminado, excepto en los casos indicados abajo.\n\nSi se le asigna el valor 1 (Permitir funciones de IA generativa en Autocompletar sin mejorar los modelos de IA) a la política, se permite usar las funciones, pero no se permite que Google mejore los modelos con el contenido de los usuarios (incluyendo peticiones, entradas, resultados, fuentes y comentarios escritos). 1 es el valor predeterminado de los usuarios de empresa que se gestionan en la Google Admin console y de las cuentas de centro educativo que se gestionan en Google Workspace.\n\nSi se le asigna el valor 2 (No permitir funciones de IA generativa en Autocompletar) a la política, no se permitirán las funciones.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nLas funciones de IA generativa en Autocompletar incluyen:\n\n- Comprensión de formularios más inteligente: usa la IA para identificar y clasificar los campos de un formulario, de modo que se puedan rellenar más.\n\n- Buscar y rellenar con Gemini: busca información en las aplicaciones que un usuario ha conectado a Gemini y la ofrece para rellenar, ya sea como sugerencias proactivas en un formulario o en respuesta a una consulta que escriba el usuario.\n\nEsta política sustituye a la política AutofillPredictionSettings, que se seguirá aplicando si esta no se define. La función \"Buscar y rellenar con Gemini\" también requiere que la política GeminiSettings no esté inhabilitada.\n\nEsta política no controla las funciones de Autocompletar que no usan IA generativa.\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
AutofillSettings.pfm_title = "Bloquear tipos de datos de Autocompletar en sitios específicos";
AutofillSettings.pfm_description = "Si se define esta política, podrás especificar qué tipos de datos de Autocompletar se bloquean en patrones de URL concretos.\n\nLa política se estructura como una lista de diccionarios. Cada diccionario debe contener:\n* \"url_pattern\": un patrón de URL de configuración de contenido para el marco principal (por ejemplo, \"https://[*.]example.com\").\n* \"blocked_types\": lista de cadenas que representan las categorías de datos de Autocompletar que se deben bloquear.\n\nLos valores admitidos para \"blocked_types\" son:\n* \"contact_info\": impide que se rellene y se guarde la información de contacto.\n* \"payments\": impide que se rellenen y se guarden tarjetas de crédito y métodos de pago.\n* \"identity_docs\": impide rellenar y guardar documentos de identidad (por ejemplo, pasaporte, carné de conducir o documento nacional de identidad).\n* \"travel\": impide rellenar y guardar información de viajes (por ejemplo, reservas de vuelos o matrículas de vehículos).\n* \"shopping\": impide rellenar y guardar información de compras (por ejemplo, pedidos online o envíos).\n* \"all\": impide rellenar y guardar todos los tipos de datos de Autocompletar.\n\nSi un tipo de datos está bloqueado en un sitio, se inhabilitan tanto la generación de sugerencias como la petición para guardar o importar nuevos datos de ese tipo en ese sitio.\n\nSi una URL coincide con varias entradas de patrón de la lista, los tipos bloqueados de todas las entradas coincidentes se combinan (se fusionan en unión). Los patrones de URL no válidos de la lista se ignoran.\n\nSi no se define esta política, no se bloqueará ningún tipo de datos de Autocompletar por dominio.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta:\nhttps://chromeenterprise.google/policies/url-patterns. Se admite el comodín *. Este patrón coincide con cualquier URL, con cualquier esquema, puerto y ruta.\nConsulta la página https://chromeenterprise.google/policies/?policy=AutofillSettings para obtener más información sobre el esquema y el formato.";
AutomatedPasswordChangeSettings.pfm_title = "Habilitar el cambio de contraseña automatizado";
AutomatedPasswordChangeSettings.pfm_description = "0 - Permitir el uso de la función y mejorar los modelos de IA\n1 - Permitir el uso de la función sin mejorar los modelos de IA\n2 - No permitir la función\nEsta política controla la disponibilidad de la función de cambio de contraseña automatizado de Brave.\n\nSi se habilita esta política, los usuarios podrán activar un proceso en el que el navegador intentará cambiar automáticamente su contraseña en un sitio web. Este proceso está gestionado por la IA generativa. La nueva contraseña se guardará en el gestor de contraseñas del navegador.\n\nSi se asigna el valor 0, permite que se use la función y que Google utilice datos relevantes para mejorar sus modelos de IA. Según la función, los datos relevantes pueden ser peticiones, datos de entrada, resultados, fuentes y comentarios escritos. También puede que un equipo de personas revise los datos relevantes para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los casos indicados abajo.\n\nSi se asigna el valor 1, permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (incluyendo peticiones, datos de entrada, resultados, fuentes y comentarios escritos). 1 es el valor predeterminado de los usuarios de empresa que se gestionan en la consola de administración de Google y de las cuentas de centro educativo que se gestionan en Google Workspace.\n\nSi se asigna el valor 2, no se permite la función.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Permitir descargas automáticas en estos sitios";
AutomaticDownloadsAllowedForUrls.pfm_description = "Permite definir una lista de patrones de URL donde se especifica qué sitios web pueden descargar varios archivos automáticamente.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\n\nSi una URL coincide con AutomaticDownloadsAllowedForUrls y AutomaticDownloadsBlockedForUrls, AutomaticDownloadsBlockedForUrls tendrá prioridad.\n\nSi no se define esta política, se aplicará DefaultAutomaticDownloadsSetting a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Bloquear descargas automáticas en estos sitios";
AutomaticDownloadsBlockedForUrls.pfm_description = "Permite definir una lista de patrones de URL donde se especifica qué sitios web no pueden descargar varios archivos automáticamente.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\n\nSi una URL coincide con AutomaticDownloadsAllowedForUrls y AutomaticDownloadsBlockedForUrls, AutomaticDownloadsBlockedForUrls tendrá prioridad.\n\nSi no se define esta política, se aplicará DefaultAutomaticDownloadsSetting a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Permitir la activación automática de la pantalla completa en estos sitios";
AutomaticFullscreenAllowedForUrls.pfm_description = "Por motivos de seguridad, para llamar a la API web requestFullscreen() se requiere un gesto previo del usuario (\"activación temporal\"). De lo contrario, se producirá un error. La configuración personal del usuario podría permitir que algunos orígenes llamen a esta API sin un gesto previo del usuario, tal como se describe en https://chromestatus.com/feature/6218822004768768.\n\nEsta política prevalece sobre la configuración personal de los usuarios y permite que los orígenes coincidentes llamen a la API sin un gesto previo del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\nSe permite el uso de caracteres comodín (*).\n\nSe bloquearán los orígenes que coincidan con los patrones de política bloqueados y permitidos.\nLos orígenes no especificados en la política ni en la configuración del usuario requerirán un gesto previo del usuario para llamar a esta API.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Bloquear la activación automática de la pantalla completa en estos sitios";
AutomaticFullscreenBlockedForUrls.pfm_description = "Por motivos de seguridad, para llamar a la API web requestFullscreen() se requiere un gesto previo del usuario (\"activación temporal\"). De lo contrario, se producirá un error. La configuración personal del usuario podría permitir que algunos orígenes llamen a esta API sin un gesto previo del usuario, tal como se describe en https://chromestatus.com/feature/6218822004768768.\n\nEsta política prevalece sobre la configuración personal del usuario e impide que los orígenes coincidentes llamen a la API sin un gesto previo del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\nSe permite el uso de caracteres comodín (*).\n\nSe bloquearán los orígenes que coincidan con los patrones de política bloqueados y permitidos.\nLos orígenes no especificados en la política ni en la configuración del usuario requerirán un gesto previo del usuario para llamar a esta API.";
AutoplayAllowed.pfm_title = "Permitir reproducción automática de contenido multimedia";
AutoplayAllowed.pfm_description = "Si se asigna el valor True a esta política, Brave reproducirá automáticamente el contenido multimedia. Si se le asigna el valor False, Brave no podrá reproducir automáticamente el contenido multimedia.\n\nSi no se establece esta política, Brave no reproducirá automáticamente el contenido multimedia. Sin embargo, en determinados patrones de URL, puedes usar la política AutoplayAllowlist para cambiar este ajuste.\n\nSi se realizan cambios en esta política mientras Brave está en ejecución, solo se aplicarán al abrir pestañas nuevas.";
AutoplayAllowlist.pfm_title = "Permitir la reproducción automática de contenido multimedia en una lista de patrones de URL permitidos";
AutoplayAllowlist.pfm_description = "Si se define esta política, los vídeos podrán reproducirse automáticamente (sin el consentimiento del usuario) con contenido de audio en Brave. Si se asigna el valor \"True\" a AutoplayAllowed, esta política no tendrá efecto. Si se asigna el valor \"False\" a AutoplayAllowed, todos los patrones de URL establecidos en esta política podrán reproducir contenido. Si se realizan cambios en esta política mientras Brave está abierto, solo se aplicarán al abrir pestañas nuevas.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.";
BackgroundTabFreezingEnabled.pfm_title = "Habilitar la inmovilización de pestañas abiertas en segundo plano";
BackgroundTabFreezingEnabled.pfm_description = "Controla si Brave congela las pestañas inactivas en segundo plano para ahorrar CPU y memoria.\n\nCuando la congelación de pestañas en segundo plano está activa, las pestañas que lleven un tiempo inactivas se congelarán pausando la ejecución de JavaScript y las tareas de temporizador. Las pestañas congeladas permanecerán cargadas en la memoria y se reanudarán al instante cuando el usuario las seleccione. No se pueden congelar las pestañas con tareas en segundo plano activas, como las que reproducen audio o vídeo, las que capturan emisiones de pantalla o de cámara, las que mantienen conexiones WebRTC activas o las que tienen bloqueos web. Estas pestañas seguirán funcionando activamente. Tampoco se congelarán los sitios configurados en la política TabDiscardingExceptions o en las excepciones de descarte de pestañas del usuario.\n\nSi se habilita esta política, se activará la congelación automática de pestañas en segundo plano para las pestañas en segundo plano aptas. Los usuarios no pueden cambiar este ajuste.\n\nSi se inhabilita esta política, se impedirá que se congelen las pestañas en segundo plano. Los usuarios no pueden cambiar este ajuste.\n\nSi no se define esta política, la congelación de pestañas en segundo plano estará habilitada de forma predeterminada, pero los usuarios podrán activarla o desactivarla en la configuración de Brave.";
BasicAuthOverHttpEnabled.pfm_title = "Permitir la autenticación Basic para conexiones HTTP";
BasicAuthOverHttpEnabled.pfm_description = "Si se habilita la política o no se establece, se permitirán las solicitudes de autenticación Basic recibidas desde conexiones HTTP no seguras.\n\nSi se inhabilita la política, las solicitudes HTTP no seguras tendrán prohibido el uso del esquema de autenticación Basic; solo se permitirán solicitudes HTTPS.\n\nSi se habilita la política AuthSchemes y esta no incluye Basic, se ignorará este ajuste de la política (y se prohibirá Basic de forma permanente).";
BatterySaverModeAvailability.pfm_title = "Habilitar el modo Ahorro de batería";
BatterySaverModeAvailability.pfm_description = "0 - El modo Ahorro de batería se inhabilitará.\n1 - El modo Ahorro de batería se habilitará cuando el dispositivo funcione con batería y el nivel de la batería sea bajo.\n2 - Este valor no está disponible desde la versión M121. En la versión M121 y en versiones posteriores, los valores se tratarán como EnabledBelowThreshold.\nEsta política habilita o inhabilita el ajuste Modo Ahorro de batería.\nEn Chrome, este ajuste limita la velocidad de fotogramas para reducir el consumo de energía. Si no se define esta política, el usuario final podrá controlar este ajuste en chrome://settings/performance.\nEn ChromeOS, este ajuste limita la velocidad de fotogramas y la frecuencia de la CPU, atenúa la retroiluminación y activa el modo Ahorro de batería de Android. En los dispositivos con varias CPUs, algunas se desactivarán.\nLos diferentes niveles son:\nDisabled (0): el modo Ahorro de batería se inhabilitará.\nEnabledBelowThreshold (1): el modo Ahorro de batería se habilitará cuando el dispositivo funcione con batería y el nivel de la batería sea bajo.\nEnabledOnBattery (2): este valor no está disponible desde la versión M121. A partir de la versión M121, los valores se tratarán como EnabledBelowThreshold.\n";
BlockExternalExtensions.pfm_title = "Bloquea las extensiones externas para que no puedan instalarse";
BlockExternalExtensions.pfm_description = "Controla la instalación de extensiones externas.\n\nSi se habilita esta política, se impedirá que se instalen extensiones externas.\n\nSi se inhabilita esta política o no se define, se podrán instalar extensiones externas.\n\nLa documentación sobre las extensiones externas y sobre cómo instalarlas está disponible en https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions.\n\nNota: Esta política solo se aplica a las plataformas compatibles con extensiones.";
BlockThirdPartyCookies.pfm_title = "Bloquear cookies de terceros";
BlockThirdPartyCookies.pfm_description = "Si se habilita esta política, los elementos de páginas web que no pertenezcan al dominio que aparece en la barra de direcciones del navegador no podrán establecer cookies. Si se inhabilita esta política, esos elementos podrán establecer cookies y los usuarios no podrán cambiar esta opción.\n\nSi no se establece, se permitirán las cookies de terceros, pero los usuarios podrán cambiar esta opción.\n\nNota: Esta política no se aplica en el modo Incógnito, donde las cookies de terceros están bloqueadas y solo se pueden permitir a nivel de sitio. Para permitir las cookies a nivel de sitio, usa la política CookiesAllowedForUrls.";
BookmarkBarEnabled.pfm_title = "Habilitar barra de marcadores";
BookmarkBarEnabled.pfm_description = "Si se asigna el valor \"Verdadero\" a esta política, se mostrará una barra de marcadores en Brave. Si se le asigna el valor \"Falso\", los usuarios no verán nunca la barra de marcadores.\n\nSi le asignas un valor a esta política, los usuarios no podrán cambiarlo. Si no se le asigna ningún valor, los usuarios decidirán si usan esta función.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "Habilitar Añadir persona en el administrador de usuarios";
BrowserAddPersonEnabled.pfm_description = "Si se le asigna el valor true a esta política o no se configura, Brave y Lacros permitirán añadir una nueva persona del Administrador de usuarios.\n\nSi se le asigna el valor false, Brave y Lacros no permitirán añadir una nueva persona del Administrador de usuarios.";
BrowserGuestModeEnabled.pfm_title = "Habilitar el modo Invitado en el navegador";
BrowserGuestModeEnabled.pfm_description = "Si se habilita esta política o si no se configura, Brave habilitará los inicios de sesión como invitado. Los inicios de sesión como invitado son perfiles de Brave en los que todas las ventanas están en modo Incógnito.\n\nSi se inhabilita esta política, Brave no permitirá que se inicien los perfiles de invitado.";
BrowserGuestModeEnforced.pfm_title = "Forzar el modo Invitado en el navegador";
BrowserGuestModeEnforced.pfm_description = "Si se habilita la política, Brave usará sesiones de invitado e impedirá inicios de sesión de perfiles. Las sesiones de invitado son perfiles de Brave en los que las ventanas están en modo Incógnito.\n\nSi se inhabilita la política, no se establece o se inhabilita el modo Invitado del navegador (mediante BrowserGuestModeEnabled), se permitirá el uso de perfiles nuevos y de perfiles ya existentes.";
BrowserLabsEnabled.pfm_title = "Icono de experimentos del navegador en la barra de herramientas";
BrowserLabsEnabled.pfm_description = "Si se habilita esta política o no se le asigna ningún valor, significa que los usuarios pueden acceder a las funciones experimentales de navegación mediante un icono en la barra de herramientas.\n\nSi se inhabilita, se elimina el icono de funciones experimentales de la barra de herramientas.\n\nchrome://flags y cualquier otro medio de activar o desactivar las funciones del navegador se seguirán comportando como se espera independientemente de si esta política está habilitada o inhabilitada.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Permitir consultas a un servicio de hora de Google";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Si se habilita la política o no se establece, Brave enviará consultas ocasionales a un servidor de Google para obtener una marca de tiempo precisa.\n\nSi se inhabilita la política, Brave no podrá enviar esas consultas.";
BrowserSignin.pfm_title = "Configuración de inicio de sesión en el navegador";
BrowserSignin.pfm_description = "0 - Inhabilitar inicio de sesión en el navegador\n1 - Habilitar inicio de sesión en el navegador\n2 - Forzar a los usuarios a iniciar sesión para usar el navegador\nEsta política controla el comportamiento del navegador cuando se inicia sesión. Permite definir si los usuarios pueden iniciar sesión en Brave con su cuenta y usar los servicios asociados, como la función Sincronización de Brave.\n\nSi se asigna el valor \"Inhabilitar inicio de sesión en el navegador\" a esta política, el usuario no podrá iniciar sesión en el navegador ni utilizar los servicios asociados a su cuenta. Además, las funciones del navegador, como Sincronización de Brave, no se podrán usar ni estarán disponibles. En iOS, si el usuario ha iniciado sesión y la política está inhabilitada, se cerrará la sesión inmediatamente. En otras plataformas, se cerrará sesión la próxima vez que ejecuten Brave. En todas las plataformas, se conservarán y se podrán seguir usando los datos del perfil local, como los marcadores, las contraseñas, etc. Además, el usuario podrá iniciar sesión en servicios web de Google y usarlos (por ejemplo, Gmail).\n\nSi se asigna el valor \"Habilitar inicio de sesión en el navegador\" a esta política, el usuario podrá iniciar sesión en el navegador. En todas las plataformas excepto iOS, cuando el usuario inicie sesión en servicios web de Google, como Gmail, también iniciará sesión automáticamente en el navegador. Si el usuario ha iniciado sesión en el navegador, la información de la cuenta del usuario se conservará en el navegador. Sin embargo, la función Sincronización de Brave no se activará de forma predeterminada; el usuario deberá activar esta función por separado. Si se habilita esta política, se impedirá que el usuario desactive la opción que permite iniciar sesión en el navegador. Para controlar la disponibilidad de Sincronización de Brave, usa la política SyncDisabled.\n\nSi se selecciona que se fuerce el inicio de sesión en esta política, se mostrará un cuadro de diálogo de selección de cuenta al usuario para que elija una e inicie sesión en el navegador. De este modo, se asegura de que, en el caso de las cuentas gestionadas, se apliquen y se cumplan las políticas asociadas a la cuenta. De forma predeterminada, la política BrowserGuestModeEnabled estará inhabilitada. Ten en cuenta que, después de habilitar esta política, los perfiles con los que no se haya iniciado sesión se bloquearán y no se podrá acceder a ellos. Para obtener más información, consulta este artículo del Centro de Ayuda: https://support.google.com/chrome/?p=force_browser_signin. Esta opción no es compatible con Google Chrome OS ni Android, donde volverá a asignarse el valor \"Habilitar inicio de sesión en el navegador\" si se usa.\n\nSi no se asigna ningún valor a esta política, el usuario podrá decidir si quiere habilitar el inicio de sesión en el navegador en la configuración de Brave y usar esta opción cuando lo crea oportuno.";
BrowserSwitcherDelay.pfm_title = "Retraso antes de iniciar un navegador alternativo (en milisegundos)";
BrowserSwitcherDelay.pfm_description = "Si a esta política se le asigna un número como valor, Brave mostrará un mensaje durante ese número de milisegundos y después abrirá un navegador alternativo.\n\nSi la política no se define o el valor es 0, al ir a una URL designada se abrirá inmediatamente en un navegador alternativo.";
BrowserSwitcherEnabled.pfm_title = "Habilitar la función de compatibilidad con navegadores antiguos.";
BrowserSwitcherEnabled.pfm_description = "Si se asigna el valor Habilitada a esta política, Brave intentará abrir algunas URL en un navegador alternativo, como Internet Explorer®. Esta función se configura a través de las políticas del grupo de Legacy Browser support.\n\nSi se le asigna el valor Inhabilitada o no se le asigna ninguno, Brave no intentará abrir las URL designadas en un navegador alternativo.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "URL de un archivo XML que contiene URLs que nunca deben activar un cambio de navegador.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Si se define esta política como una URL válida, Brave descargará la lista de sitios web de esa URL y aplicará las reglas como si se hubieran configurado con la política BrowserSwitcherUrlGreylist. Estas políticas evitarán que Brave y el navegador alternativo se abran entre sí.\n\nSi no se asigna ningún valor a esta política o se le asigna una URL no válida, Brave no la usará como fuente de reglas para no cambiar de navegador.\n\nNota: Esta política dirige a un archivo XML con el mismo formato que la política SiteList de Internet Explorer®. Se cargarán las reglas de un archivo XML, sin compartirlas con Internet Explorer®. Puedes consultar más información sobre la política SiteList de Internet Explorer® en https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL de un archivo XML que contiene las URL que se cargarán en un navegador alternativo.";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Si se define esta política como una URL válida, Brave descargará la lista de sitios web de esa URL y aplicará las reglas como si se hubieran configurado con la política BrowserSwitcherUrlList.\n\nSi no se asigna ningún valor a esta política o se le asigna una URL no válida, Brave no usará la política como fuente de reglas para cambiar de navegador.\n\nNota: Esta política dirige a un archivo XML con el mismo formato que la política SiteList de Internet Explorer®. Se cargarán las reglas de un archivo XML, sin compartirlas con Internet Explorer®. Puedes consultar más información sobre la política SiteList de Internet Explorer® en https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Mantener abierta la última pestaña en Chrome.";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Si se habilita esta política o no se establece, Brave mantendrá al menos una pestaña abierta después de cambiar a un navegador alternativo.\n\nSi se inhabilita, Brave cerrará la pestaña después de cambiar a un navegador alternativo, aunque esta sea la última. Esto hará que Brave se cierre por completo.";
BrowserSwitcherParsingMode.pfm_title = "Modo de análisis de la lista de sitios";
BrowserSwitcherParsingMode.pfm_description = "0 - Comportamiento predeterminado para el LBS.\n1 - Más compatibles con las listas de sitios del modo empresarial de Microsoft IE/Edge.\nEsta política controla cómo interpreta Google Chrome las políticas de listas de sitios y las políticas de listas de sospechosos en el caso de la función de compatibilidad con navegadores antiguos. Afecta a las siguientes políticas: BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl y BrowserSwitcherExternalGreylistUrl.\n\nSi se le asigna el valor Default (0) o no se establece, la coincidencia de URLs será menos estricta. Las reglas que no contengan \"/\" buscarán una cadena secundaria en cualquier lugar del nombre de host de la URL. Al buscar coincidencias con el componente de ruta de una URL, se distingue entre mayúsculas y minúsculas.\n\nSi se asigna el valor IESiteListMode (1), la coincidencia de URLs será más estricta. Las reglas que no contengan \"/\" buscarán coincidencias únicamente al final del nombre de host. Además, deben estar al lado del nombre del dominio. Al buscar coincidencias con el componente de ruta de una URL, no se distingue entre mayúsculas y minúsculas. Esta opción es más compatible con Microsoft® Internet Explorer® y Microsoft® Edge®.\n\nPor ejemplo, con las reglas \"example.com\" y \"acme.com/abc\":\n\n\"http://example.com/\", \"http://subdomain.example.com/\" y \"http://acme.com/abc\" serían coincidencias independientemente del modo de análisis.\n\n\"http://notexample.com/\", \"http://example.com.invalid.com/\" y \"http://example.comabc/\" solo serían coincidencias si se usa el modo Default.\n\n\"http://acme.com/ABC\" solo sería coincidencia en IESiteListMode.";
BrowserSwitcherUrlGreylist.pfm_title = "Sitios web que nunca deben activar un cambio de navegador.";
BrowserSwitcherUrlGreylist.pfm_description = "Si se define esta política, controlará la lista de sitios web que nunca provocarán que se cambie de navegador. Cada elemento se tratará como una regla. Las reglas para las que se encuentre una coincidencia no abrirán un navegador alternativo. A diferencia de la política BrowserSwitcherUrlList, estas reglas se aplicarán en ambas direcciones. Si el complemento de Internet Explorer® está activado, también controlará si Internet Explorer® debe abrir esas URL en Brave.\n\nSi no se asigna ningún valor a esta política, no se añadirá ningún sitio web a la lista.\n\nNota: También se pueden añadir elementos a la lista a través de la política BrowserSwitcherExternalGreylistUrl.";
BrowserSwitcherUrlList.pfm_title = "Sitios web que se abren en el navegador alternativo";
BrowserSwitcherUrlList.pfm_description = "Esta política controla la lista de sitios web que se abrirán en un navegador alternativo. Cada elemento se trata como una regla para que los sitios web se abran en un navegador alternativo. Brave usará esas reglas al determinar si una URL debe abrirse en un navegador alternativo. Si el complemento de Internet Explorer® está activado, Internet Explorer® cambiará de nuevo a Brave si las reglas no coinciden. Si las reglas se contradicen entre ellas, Brave usará la más específica.\n\nSi no se asigna ningún valor a esta política, no se añadirá ningún sitio web a la lista.\n\nNota: También se pueden añadir elementos a la lista a través de las políticas BrowserSwitcherUseIeSitelist y BrowserSwitcherExternalSitelistUrl.";
BrowserThemeColor.pfm_title = "Configurar el color del tema del navegador";
BrowserThemeColor.pfm_description = "Esta política permite a los administradores configurar el color del tema de Brave. La cadena de entrada debe ser un color hexadecimal válido que coincida con el formato \"#RRGGBB\".\n\nSi se asigna un color hexadecimal válido a esta política, se generará y se aplicará de forma automática un tema basado en ese color al navegador. Los usuarios no podrán cambiar el tema definido por la política.\n\nSi no se asigna ningún valor a la política, los usuarios podrán cambiar al tema que prefieran en su navegador.";
BrowsingDataLifetime.pfm_title = "Ajustes del periodo de vida de los datos de navegación";
BrowsingDataLifetime.pfm_description = "Configura los ajustes del periodo de vida de los datos de navegación de Brave. Esta política permite a los administradores configurar (por tipo de dato) cuándo eliminará el navegador los datos. Es útil para las personas que trabajan con datos sensibles de clientes.\n\nAdvertencia: Si se establece esta política, los datos personales locales pueden verse afectados y eliminarse de forma permanente. Te recomendamos probar la configuración antes de implementarla para evitar la eliminación accidental de datos personales.\n\nLos tipos de datos disponibles son 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' y 'hosted_app_data'. 'download_history' y 'hosted_app_data' no se admiten en Android.\n\nEl navegador eliminará automáticamente los datos de los tipos seleccionados que tengan una antigüedad superior a 'time_to_live_in_hours'. El valor mínimo que se puede definir es 1 hora.\n\nLos datos caducados se eliminarán 15 segundos después de iniciarse el navegador y, después, cada 30 minutos mientras se esté ejecutando el navegador.\n\nSe mantendrá la sesión iniciada del usuario en su cuenta de Google al eliminar las cookies.\n\nHasta Chrome 114, esta política requería que se asignara el valor true a la política SyncDisabled. A partir de Chrome 115, si se define esta política, se inhabilitará la sincronización de los tipos de datos correspondientes si no se define la política SyncDisabled para inhabilitar Chrome Sync ni tampoco se inhabilita BrowserSignin.\nConsulta la página https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime para obtener más información sobre el esquema y el formato.";
BuiltInAIAPIsEnabled.pfm_title = "Permitir que las páginas usen las APIs de IA integradas.";
BuiltInAIAPIsEnabled.pfm_description = "Esta política controla si una página puede usar las APIs de IA integradas (como LanguageModel API, Summarization API, Writer API y Rewriter API).\n\nSi la política está habilitada o no se ha establecido, las APIs se pueden usar.\n\nSi se inhabilita la política, se producirá un error al intentar usar las APIs.";
BuiltInDnsClientEnabled.pfm_title = "Utilizar cliente DNS integrado";
BuiltInDnsClientEnabled.pfm_description = "Esta política controla qué pila de software se utiliza para comunicarse con el servidor DNS: el cliente DNS del sistema operativo o el cliente DNS integrado de Brave. Esta política no afecta a qué servidores DNS se utilizan. Por ejemplo, si el sistema operativo está configurado para utilizar un servidor DNS de empresa, el cliente DNS integrado usará ese mismo servidor. Tampoco controla si se usará DNS‑over‑HTTPS; Brave siempre utilizará la resolución integrada para solicitudes DNS‑over‑HTTPS. Consulta la política DnsOverHttpsMode para obtener información sobre los controles de DNS‑over‑HTTPS.\n\nSi se habilita esta política o no se define, se usará el cliente DNS integrado.\n\nSi se inhabilita esta política, solo se utilizará el cliente DNS integrado cuando se esté utilizando DNS‑over‑HTTPS.";
CACertificateManagementAllowed.pfm_title = "Permite que los usuarios gestionen los certificados AC instalados.";
CACertificateManagementAllowed.pfm_description = "0 - Permitir que los usuarios gestionen todos los certificados\n1 - Permitir que los usuarios gestionen certificados de usuario\n2 - No permitir que los usuarios gestionen certificados\nSi se asigna el valor All (0) a esta política o no se establece, los usuarios podrán editar la configuración de confianza de todos los certificados AC, quitar certificados importados por el usuario e importar certificados mediante el administrador de certificados. Si se le asigna el valor UserOnly (1), los usuarios podrán gestionar únicamente certificados importados por usuarios, pero no podrán cambiar la configuración de confianza de los certificados integrados. Si se le asigna el valor None (2), los usuarios podrán ver los certificados AC, pero no gestionarlos.";
CACertificates.pfm_title = "Certificados TLS en los que Brave debería confiar para autenticar el servidor";
CACertificates.pfm_description = "Una lista de certificados TLS en los que Brave debería confiar para autenticar el servidor.\nLos certificados deben estar codificados en Base64.";
CACertificatesWithConstraints.pfm_title = "Certificados TLS en los que Brave debería confiar para autenticar el servidor con restricciones";
CACertificatesWithConstraints.pfm_description = "Una lista de certificados TLS en los que Brave debería confiar para autenticar el servidor, con restricciones añadidas fuera del certificado. Si no existe ninguna restricción de un determinado tipo, se permitirá cualquier nombre de ese tipo.\nLos certificados deben estar codificados en Base64. Se debe especificar al menos una restricción para cada certificado.\nConsulta la página https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints para obtener más información sobre el esquema y el formato.";
CADistrustedCertificates.pfm_title = "Certificados TLS en los que Brave no debería confiar para autenticar el servidor";
CADistrustedCertificates.pfm_description = "Una lista de claves públicas de certificados en las que Brave no debería confiar para autenticar el servidor TLS.\n\nEl valor de la política es una lista de certificados X.509 codificados en Base64. Cualquier certificado que tenga una SPKI (SubjectPublicKeyInfo) incluida en la lista ya no se considerará de confianza.";
CAHintCertificates.pfm_title = "Certificados TLS que no son de confianza, pero que se pueden usar al crear rutas para autenticar el servidor";
CAHintCertificates.pfm_description = "Lista de certificados que no son de confianza en Brave,\npero que se pueden usar como sugerencias para la creación de rutas. Los certificados deben estar codificados en Base64.";
CAPlatformIntegrationEnabled.pfm_title = "Usar certificados TLS añadidos por el usuario de almacenes de confianza de plataformas para la autenticación del servidor";
CAPlatformIntegrationEnabled.pfm_description = "Si se habilita (o no se define) esta política, se usarán certificados TLS añadidos por el usuario de almacenes de confianza de la plataforma al crear rutas para autenticar el servidor TLS.\n\nSi se inhabilita, los certificados TLS añadidos por el usuario de almacenes de confianza de la plataforma no se usarán al crear rutas para autenticar el servidor TLS.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "Compatibilidad con encabezados de solicitud CORS sin comodín";
CORSNonWildcardRequestHeadersSupport.pfm_description = "Configura la compatibilidad con encabezados de solicitud CORS sin comodín.\n\nLa versión 97 de Brave introduce la compatibilidad con encabezados de solicitud CORS sin comodín. Cuando un script realiza una solicitud de red de varios orígenes mediante fetch() y XMLHttpRequest con un encabezado Authorization añadido en script, este encabezado debe estar permitido explícitamente por el encabezado Access-Control-Allow-Headers en la respuesta de solicitud preparatoria CORS. Con \"explícitamente\", nos referimos a que el carácter comodín (\"*\") no incluye el encabezado Authorization. Consulta https://chromestatus.com/feature/5742041264816128 para obtener más información.\n\nSi no se establece esta política o se le asigna el valor True, Brave admitirá los encabezados de solicitud CORS sin comodín y funcionará como se indica arriba.\n\nSi se asigna el valor False a esta política, Chrome permitirá el carácter comodín (\"*\") en el encabezado Access-Control-Allow-Headers de la respuesta de solicitud preparatoria CORS. Así, se incluirá el encabezado Authorization.\n\nEsta política de Enterprise es temporal. Está previsto que se retire en el futuro.";
CacheEncryptionEnabled.pfm_title = "Esta política permite a los administradores cifrar la caché HTTP en el disco.";
CacheEncryptionEnabled.pfm_description = "Esta política permite a los administradores cifrar la caché HTTP del navegador en el disco.\n\nSi se habilita esta política, se cifrará la caché del navegador.\n\nSi se inhabilita esta política o no se define, no se cifrará la memoria caché del navegador.\n\nEl cifrado de la memoria caché del navegador puede afectar al rendimiento.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "Inhabilitar los requisitos de la transparencia en los certificados en una lista de hashes subjectPublicKeyInfo";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "Si se establece la política, se desactivará la implementación obligatoria de los requisitos de comunicación de la transparencia en los certificados para una lista de hashes subjectPublicKeyInfo. Los hosts empresariales podrán seguir usando certificados que, de lo contrario, no serían de confianza (por no haberse comunicado públicamente de forma correcta). Para desactivar la implementación obligatoria, el hash debe cumplir una de estas condiciones:\n\n* Ser del subjectPublicKeyInfo del certificado del servidor.\n\n* Ser de un subjectPublicKeyInfo que aparezca en el certificado de una autoridad de certificación (CA) de la cadena de certificados. Ese certificado AC debe estar restringido por la extensión X.509v3 nameConstraints; tienen que aparecer uno o más directoryName nameConstraints en los permittedSubtrees, y directoryName debe contener un atributo organizationName.\n\n* Ser de un subjectPublicKeyInfo que aparezca en un certificado AC de la cadena de certificados; el certificado AC debe tener uno o más atributos organizationName en el Subject del certificado, y el certificado del servidor debe contener el mismo número de atributos organizationName, en el mismo orden y con los mismos valores byte por byte.\n\nPara especificar un hash subjectPublicKeyInfo, se vinculan el nombre del algoritmo de hash, una barra y la codificación Base64 de ese algoritmo de hash aplicado al subjectPublicKeyInfo en codificación DER del certificado especificado. La codificación Base64 tiene el mismo formato que el de una huella digital SPKI. El único algoritmo de hash reconocido es sha256; los demás se ignorarán.\n\nSi no se asigna ningún valor a esta política, los certificados que se deban comunicar a través de la transparencia en los certificados no serán de confianza para Brave si no se comunican.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "No permite que se aplique la Transparencia en Certificados a una lista de URLs";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "Si se establece esta política, se desactivarán los requisitos de divulgación de transparencia en los certificados para los nombres de host de las URLs especificadas. Aunque resulte más difícil detectar certificados que se hayan publicado incorrectamente, los hosts pueden seguir usando certificados que, de lo contrario, no serían de confianza (por no haberse comunicado públicamente de forma correcta).\n\nSi no se asigna ningún valor a esta política, los certificados que se deban comunicar a través de la transparencia en los certificados no serán de confianza para Brave si no se comunican.\n\nLos patrones de URL tienen este formato: https://support.google.com/chrome/a?p=url_blocklist_filter_format. Sin embargo, la validez de los certificados de un determinado nombre de host es independiente del esquema, puerto o ruta, así que Brave solo tiene en cuenta el nombre del host que aparece en la URL. No se admiten hosts comodín.";
ChromeForTestingAllowed.pfm_title = "Permitir Chrome for Testing";
ChromeForTestingAllowed.pfm_description = "Controla si los usuarios pueden usar Chrome for Testing.\n\nSi se habilita esta política o no se define, los usuarios podrán instalar y ejecutar Chrome for Testing.\n\nSi se inhabilita, los usuarios no podrán ejecutar Chrome for Testing. Los usuarios podrán seguir instalando Chrome for Testing, pero no se ejecutará con los perfiles en los que la política esté inhabilitada.";
ChromeSuggestionsSettings.pfm_title = "Configuración de ChromeSuggestions";
ChromeSuggestionsSettings.pfm_description = "Esta opción permite que Chrome sugiera funciones de IA en momentos pertinentes.\n\n0/sin definir: Las sugerencias de Chrome estarán habilitadas para los usuarios.\n\n1: Las sugerencias de Chrome se inhabilitarán para los usuarios.\n\nPara obtener más información, consulta este artículo del Centro de Ayuda: https://support.google.com/chrome/a?p=chrome_suggestions.";
ChromeVariations.pfm_title = "Determinar la disponibilidad de variaciones";
ChromeVariations.pfm_description = "0 - Habilitar todas las variaciones\n1 - Habilitar variaciones referentes solo a correcciones críticas\n2 - Inhabilitar todas las variaciones\nConfigurar esta política permite especificar qué variaciones pueden aplicarse a Brave.\n\nCon las variaciones puede modificarse Brave sin enviar una nueva versión del navegador, ya que permiten habilitar o inhabilitar de forma selectiva las funciones existentes. Para consultar más información, visita https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework.\n\nSi se establece la opción VariationsEnabled (valor 0) o no se define la política, se permitirá que se apliquen todas las variaciones al navegador.\n\nSi se establece la opción CriticalFixesOnly (valor 1), solo se permitirá que se apliquen a Brave las variaciones que se consideren correcciones críticas de seguridad o de estabilidad.\n\nSi se establece la opción VariationsDisabled (valor 2), no se permitirá aplicar ninguna variación al navegador. Ten en cuenta que este modo puede evitar que los desarrolladores de Brave proporcionen correcciones críticas de seguridad a su debido tiempo y, por lo tanto, no se recomienda su uso.";
ClearBrowsingDataOnExitList.pfm_title = "Borrar datos de navegación al salir";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - Historial de navegación\ndownload_history - Historial de descargas\ncookies_and_other_site_data - Cookies y otros datos de sitios\ncached_images_and_files - Archivos e imágenes almacenados en caché\npassword_signin - Inicio de sesión con contraseña\nautofill - Autocompletar\nsite_settings - Configuración de sitios\nhosted_app_data - Datos de aplicaciones alojadas\nConfigura una lista de los tipos de datos de navegación que se deben eliminar cuando el usuario cierra todas las ventanas del navegador.\n\nAdvertencia: Si se establece esta política, los datos personales locales pueden verse afectados y eliminarse de forma permanente. Te recomendamos probar la configuración antes de implementarla para evitar la eliminación accidental de datos personales.\n\nLos tipos de datos disponibles son los siguientes: historial de navegación (browsing_history), historial de descargas (download_history), cookies (cookies_and_other_site_data), caché (cached_images_and_files), Autocompletar (autofill), contraseñas (password_signin), configuración de sitios (site_settings) y datos de apps alojadas (hosted_app_data). Esta política no prevalece sobre AllowDeletingBrowserHistory.\n\nSe mantendrá la sesión iniciada del usuario en su cuenta de Google al eliminar las cookies.\n\nHasta Chrome 114, esta política requería que se asignara el valor true a la política SyncDisabled. A partir de Chrome 115, si se define esta política, se inhabilitará la sincronización de los tipos de datos correspondientes si no se define la política SyncDisabled para inhabilitar Chrome Sync ni tampoco se inhabilita BrowserSignin.\n\nSi por algún motivo se ha iniciado la eliminación de datos y no se ha completado, los datos de navegación se borrarán la próxima vez que se cargue el perfil.\n\nSi Brave no se cierra correctamente (por ejemplo, si el navegador o el SO fallan), los datos de navegación no se borrarán, ya que el navegador no se ha cerrado porque el usuario haya cerrado todas las ventanas del navegador.";
ClipboardAllowedForUrls.pfm_title = "Permitir portapapeles en estos sitios";
ClipboardAllowedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios pueden usar el permiso de portapapeles de sitios. Esto no incluye todas las operaciones de portapapeles que se realicen en orígenes que coincidan con esos patrones. Por ejemplo, los usuarios seguirán pudiendo pegar mediante combinaciones de teclas, ya que esta acción está fuera del ámbito del permiso de portapapeles de sitios.\n\n\nSi no se establece la política, DefaultClipboardSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
ClipboardBlockedForUrls.pfm_title = "Bloquear portapapeles en estos sitios";
ClipboardBlockedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios no pueden usar el permiso de portapapeles de sitios. Esto no incluye todas las operaciones de portapapeles que se realicen en orígenes que coincidan con esos patrones. Por ejemplo, los usuarios seguirán pudiendo pegar mediante combinaciones de teclas, ya que esta acción está fuera del ámbito del permiso de portapapeles de sitios.\n\nSi no se establece la política, DefaultClipboardSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
CloudManagementEnrollmentMandatory.pfm_title = "Activar el registro obligatorio en la gestión en la nube";
CloudManagementEnrollmentMandatory.pfm_description = "Si se habilita esta política, se ordena el registro del navegador en Chrome Enterprise Core y, si no se puede hacer, se bloquea el proceso de inicio de Brave.\n\nSi se inhabilita esta política o no se le asigna ningún valor, el registro del navegador en Chrome Enterprise Core será opcional y, si no se puede hacer, no se bloqueará el proceso de inicio de Brave.\n\nEn ordenadores, el registro de políticas de permisos de nube utiliza esta política. Para obtener más información, consulta https://support.google.com/chrome/a/answer/9301891.";
CloudManagementEnrollmentToken.pfm_title = "El token de registro de la política relativa a la nube";
CloudManagementEnrollmentToken.pfm_description = "Si se asigna un valor a esta política, Brave intentará registrarse con la gestión del navegador de Chrome Enterprise Core. El valor de esta política es un token de registro que puedes obtener desde la Google Admin console.\n\nPara obtener más información, consulta https://support.google.com/chrome/a/answer/9301891.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "La política relativa a la nube de Brave anula la política de la plataforma.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Si se habilita esta política, la política de nube prevalecerá si entra en conflicto con la política de plataforma.\n\nSi se inhabilita esta política o no se define, la política de plataforma prevalecerá si entra en conflicto con la política de nube.\n\nEsta política obligatoria afecta a las políticas de permisos de nube.\n\nEsta política es específica de Brave y no afecta a Google Update porque son aplicaciones independientes.\nGoogle Update tiene una política independiente con el mismo nombre.";
CloudUserPolicyMerge.pfm_title = "Habilita la fusión de políticas basadas en la nube a nivel de usuario con políticas a nivel de ordenador";
CloudUserPolicyMerge.pfm_description = "Si se habilita esta política, se permitirá que las políticas asociadas con una cuenta gestionada se fusionen con políticas a nivel de ordenador.\n\nSi se inhabilita esta política o no se establece, las políticas basadas en la nube a nivel de usuario no se podrán fusionar con las políticas de ninguna otra fuente.\n\nSolo las políticas procedentes de usuarios seguros pueden tener preferencia. Los usuarios seguros son los que están afiliados a la organización que gestiona su navegador mediante Chrome Enterprise Core. El resto de las políticas a nivel de usuario tendrán el nivel de preferencia predeterminado.\n\nLas políticas que deban fusionarse tendrán que establecerse en PolicyListMultipleSourceMergeList o en PolicyDictionaryMultipleSourceMergeList. Esta política se ignorará si no se configura ninguna de las dos políticas mencionadas anteriormente.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Permitir que las políticas basadas en la nube a nivel de usuario anulen las políticas de Chrome Browser Cloud Management";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Si se habilita esta política, las políticas asociadas a una cuenta gestionada tendrán preferencia si entran en conflicto con las políticas de navegador de Chrome Enterprise Core.\n\nSi se inhabilita esta política o no se establece, las políticas de nube de nivel de usuario tendrán el nivel de prioridad predeterminado.\n\nSolo las políticas procedentes de usuarios seguros pueden tener preferencia. Los usuarios seguros son los que están afiliados a la organización que gestiona su navegador mediante Chrome Enterprise Core. El resto de las políticas a nivel de usuario tendrán el nivel de preferencia predeterminado.\n\nEsta política se puede combinar con CloudPolicyOverridesPlatformPolicy. Si se habilitan ambas políticas, las políticas de nube de nivel de usuario también tendrán preferencia si entran en conflicto con las políticas de plataforma.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Habilita las advertencias de seguridad en las instrucciones de línea de comandos";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Si la política se habilita o no se define, se mostrarán advertencias de seguridad cuando se usen marcas de línea de comandos potencialmente peligrosas para iniciar Chrome.\n\nSi se inhabilita esta política, no se mostrará ninguna advertencia de seguridad cuando se inicie Chrome con marcas de línea de comandos potencialmente peligrosas.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
ComponentUpdatesEnabled.pfm_title = "Habilitar las actualizaciones de componentes en Brave";
ComponentUpdatesEnabled.pfm_description = "Si se habilita o no se establece, se habilitarán las actualizaciones de todos los componentes de Brave.\n\nSi se inhabilita, se desactivarán las actualizaciones de los componentes. Sin embargo, algunos componentes quedan exentos de esta política: las actualizaciones de los componentes que no contengan código ejecutable o que sean esenciales para proteger la seguridad del navegador no se inhabilitarán.\nEntre los ejemplos de estos componentes se incluyen las listas de revocación de certificados y los filtros de subrecursos.";
CompressionDictionaryTransportEnabled.pfm_title = "Habilitar compatibilidad con el transporte de diccionarios de compresión";
CompressionDictionaryTransportEnabled.pfm_description = "Esta función permite el uso de codificaciones de contenido específicas del diccionario en el encabezado de solicitud de la codificación de aceptación (\"sbr\" y \"zst-d\") cuando hay diccionarios disponibles.\n\nSi se habilita esta política o no se define, Brave aceptará los contenidos web que usen la función de transporte de diccionarios de compresión.\nSi se inhabilita esta política, se desactivará la función de transporte de diccionarios de compresión.";
CookiesAllowedForUrls.pfm_title = "Permitir cookies en estos sitios";
CookiesAllowedForUrls.pfm_description = "Permite definir una lista de patrones de URL donde se especifica qué sitios pueden establecer cookies.\n\nLos patrones de URL pueden ser una sola URL que indique que el sitio puede usar cookies en todos los sitios de nivel superior.\n\nEstos patrones también pueden ser dos URLs delimitadas por una coma. La primera URL especifica el sitio en el que se debe permitir el uso de cookies. La segunda URL especifica el sitio de nivel superior en el que debe aplicarse el primer valor.\n\nSi usas dos URLs, puedes utilizar un asterisco (*) como primer valor del par, pero no como segundo valor. Si utilizas un asterisco (*) como primer valor, todos los sitios podrán usar cookies cuando la segunda URL sea el sitio de nivel superior.\n\nSi no se asigna ningún valor a esta política, se usará para todos los sitios el valor predeterminado global especificado en las políticas DefaultCookiesSetting o BlockThirdPartyCookies (si se han definido dichas políticas) o en la configuración personal del usuario (si no se han definido dichas políticas).\n\nConsulta también las políticas CookiesBlockedForUrls y CookiesSessionOnlyForUrls. Ten en cuenta que no puede haber patrones de URL en conflicto entre estas políticas, ya que no se especifica qué política prevalece.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
CookiesBlockedForUrls.pfm_title = "Bloquear cookies en estos sitios";
CookiesBlockedForUrls.pfm_description = "Si asignas un valor a esta política, podrás crear una lista de patrones de URL donde se especifique qué sitios no podrán establecer cookies.\n\nSi no se le asigna ningún valor, se utilizará DefaultCookiesSetting en todos los sitios, si se ha definido previamente. Si no, se aplicará la configuración personal del usuario.\n\nSi ninguna política prevalece sobre las otras, consulta CookiesAllowedForUrls y CookiesSessionOnlyForUrls. Los patrones de URL de estas tres políticas no deben interferir entre sí.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
CookiesSessionOnlyForUrls.pfm_title = "Limitar las cookies de las URL coincidentes de la sesión actual";
CookiesSessionOnlyForUrls.pfm_description = "A menos que la política RestoreOnStartup se configure para que siempre restaure las URLs de sesiones anteriores, podrás asignarle el valor CookiesSessionOnlyForUrls para crear una lista de patrones de URL que especifique qué sitios pueden establecer cookies en una sesión y cuáles no.\n\nSi no se le asigna ningún valor, se utilizará DefaultCookiesSetting en todos los sitios, si se ha definido previamente. Si no, se aplicará la configuración personal del usuario. También se utilizarán valores predeterminados para aquellas URL que no se vean afectadas por los patrones especificados.\n\nAunque ninguna política específica prevalece sobre las otras, consulta CookiesBlockedForUrls y CookiesAllowedForUrls. Los patrones de URL de estas tres políticas no deben interferir entre sí.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
CpuPerformanceTierOverride.pfm_title = "Anulación del nivel de rendimiento de la CPU";
CpuPerformanceTierOverride.pfm_description = "Si se define esta política, las empresas podrán anular el valor que devuelve la CPU Performance API (es decir,\nnavigator.cpuPerformance).\nConsulta https://github.com/WICG/cpu-performance para obtener más información.\n\nSi se define esta política, el valor de navigator.cpuPerformance se anulará y se le asignará el valor especificado. Si no se define esta política, se usará el cálculo predeterminado del nivel de rendimiento.\n\nLos valores posibles de esta política son del 0 al 4.";
CreatePasskeysInICloudKeychain.pfm_title = "Controlar si las llaves de acceso se crearán de forma predeterminada en el llavero de iCloud";
CreatePasskeysInICloudKeychain.pfm_description = "Brave puede dirigir las solicitudes de creación de llaves de acceso o de WebAuthn directamente al llavero de iCloud en macOS 13.5 o versiones posteriores. Si la sincronización mediante el llavero de iCloud todavía no se ha habilitado, se le pedirá al usuario que inicie sesión con iCloud, o bien puede que se le solicite que habilite la sincronización de llaveros de iCloud.\n\nSi se le asigna el valor false a esta política, el llavero de iCloud no se usará de forma predeterminada y, en su lugar, se podrá usar el comportamiento anterior (es decir, se creará la credencial en el perfil de Brave). Los usuarios seguirán teniendo la opción de elegir el llavero de iCloud y podrán seguir viendo las credenciales del llavero de iCloud cuando inicien sesión.\n\nSi se asigna el valor true a esta política, el llavero de iCloud se usará de forma predeterminada siempre que la solicitud de WebAuthn sea compatible con esa opción.\n\nSi no se define esta política, la configuración predeterminada dependerá de factores como si se ha habilitado iCloud Drive y si el usuario ha usado o creado una credencial en su perfil de Brave recientemente.";
CreateThemesSettings.pfm_title = "Ajustes de Crear temas con IA";
CreateThemesSettings.pfm_description = "0 - Permitir la función Crear temas y mejorar los modelos de IA.\n1 - Permitir Crear temas sin mejorar los modelos de IA.\n2 - No permitir Crear temas.\nCon la opción de crear temas con IA, los usuarios pueden crear temas o fondos de pantalla personalizados seleccionando previamente opciones de una lista.\n\nSi se asigna el valor 0, permite que se use la función y que Google utilice datos relevantes para mejorar sus modelos de IA. Según la función, los datos pertinentes pueden ser peticiones, entradas, resultados, materiales de origen y comentarios escritos. También es posible que los revisen un equipo de personas para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los casos indicados abajo.\n\nSi se asigna el valor 1, permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (incluyendo peticiones, entradas, resultados, materiales de origen y comentarios escritos). 1 es el valor predeterminado de los usuarios de empresa que se gestionan en la Google Admin console y de las cuentas de centro educativo que se gestionan en Google Workspace.\n\nSi se asigna el valor 2, no se permite la función.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
DNSInterceptionChecksEnabled.pfm_title = "Comprobaciones de interceptación de DNS habilitadas";
DNSInterceptionChecksEnabled.pfm_description = "Esta política configura un interruptor local que puede usarse para inhabilitar las comprobaciones de interceptación de DNS. Con las comprobaciones, se intenta averiguar si el navegador está detrás de un proxy que redirige nombres de host desconocidos.\n\nEs posible que la detección no sea necesaria en un entorno empresarial en el que se conoce la configuración de la red, ya que causa cierta cantidad de tráfico DNS y HTTP al iniciar el navegador y con cada cambio en la configuración de DNS.\n\nSi esta política se habilita o no se establece, se realizarán las comprobaciones de interceptación de DNS. Si se inhabilita, no se realizarán las comprobaciones.";
DataURLWhitespacePreservationEnabled.pfm_title = "Conservación de espacios en las URLs de datos de todos los tipos de contenido";
DataURLWhitespacePreservationEnabled.pfm_description = "Esta política inhabilita temporalmente los cambios en la forma en que Chrome gestiona los espacios en las URLs de data. Anteriormente, los espacios se conservaban solo si el tipo de contenido de nivel superior era text o contenía la cadena de tipo de contenido xml.\nAhora los espacios se conservarán en todas las URLs de datos, independientemente del tipo de contenido.\n\nSi no se define esta política o se le asigna el valor True, se habilitará el nuevo comportamiento.\n\nSi se le asigna el valor False, se habilitará el comportamiento anterior.";
DataUrlInSvgUseEnabled.pfm_title = "Compatibilidad de URLs de datos con SVGUseElement";
DataUrlInSvgUseEnabled.pfm_description = "Esta política habilita la compatibilidad de las URLs de datos con SVGUseElement, que se inhabilitará de forma predeterminada a partir de la versión M119.\nSi se habilita esta política, las URLs de datos seguirán funcionando en SVGUseElement.\nSi se inhabilita esta política o no se establece, las URLs de datos no funcionarán en SVGUseElement.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Habilitar orígenes opacos para URLs de datos en Web Workers";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Controla si a los Web Workers creados a partir de URLs de datos se les asigna un origen opaco único.\n\nLos Web Workers se pueden crear mediante una URL de datos que contenga la secuencia de comandos del worker. Anteriormente, estos workers heredaban el origen de la página que los había creado, lo que les permitía acceder al mismo almacenamiento local, a las cookies y a otros datos vinculados al origen. Para mejorar la seguridad y cumplir la especificación HTML, Chrome cambiará su comportamiento predeterminado en la versión 149 para que ahora los workers creados a partir de URLs de datos tengan un origen único y opaco. De esta forma, se aíslan de los datos de la página del creador.\n\nSi se habilita esta política o no se define, se usará el nuevo comportamiento predeterminado (más seguro) y los Web Workers creados a partir de URLs de datos tendrán un origen opaco único.\n\nSi se inhabilita esta política, Chrome volverá al comportamiento antiguo y los Web Workers creados a partir de URLs de datos heredarán el origen de su creador. Esto permite a los administradores resolver temporalmente problemas de compatibilidad si las aplicaciones internas dejan de funcionar debido al cambio de seguridad.\n\nEsta política es temporal y se eliminará en la versión 157.";
DefaultAutomaticDownloadsSetting.pfm_title = "Configuración predeterminada de descargas automáticas";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Permitir que los sitios descarguen varios archivos automáticamente\n2 - No permitir que ningún sitio descargue varios archivos automáticamente\n3 - Preguntar siempre que un sitio quiera descargar varios archivos automáticamente\nSi se le asigna el valor 1 a esta política, los sitios web podrán descargar varios archivos automáticamente. Si se le asigna el valor 2, se denegará este permiso. Puedes configurar esta política para que pregunte siempre que un sitio web quiera descargar varios archivos automáticamente.\n\nSi no se establece, se aplicará la política AskAutomaticDownloads, pero los usuarios podrán cambiar esta opción.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Establecer Brave como navegador predeterminado";
DefaultBrowserSettingEnabled.pfm_description = "Si se asigna el valor \"Verdadero\" a esta política, Brave siempre comprobará al iniciarse si es el navegador predeterminado y, si es posible, se registrará a sí mismo automáticamente. Si se le asigna el valor \"Falso\", Brave dejará de comprobar si es el navegador predeterminado y desactivará los controles del usuario correspondientes a esta opción.\n\nSi no se le asigna ningún valor, Brave permitirá a los usuarios controlar si es el navegador predeterminado y, en caso contrario, si deberían aparecer las notificaciones de usuario.\n\nNota para los administradores de Microsoft®Windows®: Si se activa este ajuste, solo funcionará en dispositivos con Windows 7. Para versiones de Windows posteriores, tendrás que implementar un archivo de \"asociaciones de aplicaciones predeterminadas\" que haga que Brave gestione los protocolos https y http (y, opcionalmente, el protocolo ftp y otros formatos de archivo). Consulta la Ayuda de Chrome (https://support.google.com/chrome?p=make_chrome_default_win).";
DefaultClipboardSetting.pfm_title = "Configuración de portapapeles predeterminada";
DefaultClipboardSetting.pfm_description = "2 - No permitir que ningún sitio utilice el permiso de portapapeles de sitios\n3 - Permitir a los sitios que soliciten al usuario utilizar el permiso de portapapeles de sitios\nSi se le asigna el valor 2 a esta política, se impedirá que los sitios usen el permiso de portapapeles de sitios. Si se le asigna el valor 3 o no se le asigna ningún valor, el usuario podrá cambiar este ajuste y decidir si las APIs de portapapeles estarán disponibles cuando un sitio quiera usar una.\n\nEsta política se puede anular para patrones de URL específicos usando las políticas ClipboardAllowedForUrls y ClipboardBlockedForUrls.\n\nEsta política solo afecta a las operaciones de portapapeles controladas por el permiso de portapapeles de sitios. No afecta a las operaciones de copiar y pegar depuradas o de confianza.";
DefaultCookiesSetting.pfm_title = "Configuración de cookies predeterminada";
DefaultCookiesSetting.pfm_description = "1 - Permitir que todos los sitios establezcan datos locales\n2 - No permitir que ningún sitio establezca datos locales\n4 - Guardar las cookies durante la duración de la sesión\nA menos que la política RestoreOnStartup se configure para que siempre restaure las URLs de sesiones anteriores, podrás asignarle el valor CookiesSessionOnlyForUrls para crear una lista de patrones de URL que especifique qué sitios pueden establecer cookies en una sesión y cuáles no.\n\nSi no se le asigna ningún valor, se utilizará DefaultCookiesSetting en todos los sitios, si se ha definido previamente. Si no, se aplicará la configuración personal del usuario. También se utilizarán valores predeterminados para aquellas URLs que no se vean afectadas por los patrones especificados.\n\nAunque ninguna política específica prevalece sobre las otras, consulta CookiesBlockedForUrls y CookiesAllowedForUrls. Los patrones de URL de estas tres políticas no deben interferir entre sí.";
DefaultDownloadDirectory.pfm_title = "Establecer directorio de descargas predeterminado";
DefaultDownloadDirectory.pfm_description = "Si se le asigna un valor a esta política, se modificará el directorio predeterminado donde Chrome descarga los archivos, pero los usuarios podrán cambiarlo.\n\nSi no se le asigna ningún valor, Chrome usará su directorio predeterminado específico de la plataforma.\n\nEsta política no tendrá efecto si se establece la política DownloadDirectory.\n\nNota: Consulta una lista de las variables que puedes utilizar en esta página: https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DefaultFileSystemReadGuardSetting.pfm_title = "Controlar el uso de la API File System para lectura";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - No permitir que ningún sitio web solicite acceso de lectura a archivos y directorios a través de la API File System\n3 - Permitir que los sitios pidan al usuario que otorgue permiso de lectura a archivos y directorios a través de la API File System\nSi se asigna el valor \"3\" a esta política, los sitios web podrán solicitar acceso de lectura a los archivos y directorios del sistema de archivos del sistema operativo del host a través de la API File System. Si se le asigna el valor \"2\", se denegará el acceso.\n\nSi no se le asigna ningún valor, los sitios web podrán solicitar acceso, pero los usuarios podrán cambiar esta opción.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Controlar el uso de la API File System para escritura";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - No permitir que ningún sitio web solicite acceso de escritura a archivos y directorios\n3 - Permitir que los sitios pidan al usuario que otorgue permiso de escritura a archivos y directorios\nSi se asigna el valor \"3\" a esta política, los sitios web podrán solicitar acceso de escritura a los archivos y directorios del sistema de archivos del sistema operativo del host. Si se le asigna el valor \"2\", se denegará el acceso.\n\nSi no se le asigna ningún valor, los sitios web podrán solicitar acceso, pero los usuarios podrán cambiar esta opción.";
DefaultGeolocationSetting.pfm_title = "Configuración de ubicación geográfica predeterminada";
DefaultGeolocationSetting.pfm_description = "1 - Permitir que los sitios puedan hacer un seguimiento de la ubicación física de los usuarios\n2 - No permitir que ningún sitio haga un seguimiento de la ubicación física de los usuarios\n3 - Preguntar siempre que un sitio quiera hacer un seguimiento de la ubicación física de los usuarios\nSi se asigna el valor 1 a esta política, los sitios web podrán hacer un seguimiento de la ubicación física de los usuarios de forma predeterminada. Si se le asigna el valor 2, se bloqueará este seguimiento de forma predeterminada. Puedes configurar esta política para que pregunte siempre que un sitio quiera hacer un seguimiento de la ubicación física de los usuarios.\n\nSi no se establece, se aplicará la política AskGeolocation, pero los usuarios podrán cambiar esta opción.";
DefaultIdleDetectionSetting.pfm_title = "Detección de inactividad";
DefaultIdleDetectionSetting.pfm_description = "1 - Permitir que los sitios detecten el estado de inactividad sin preguntar al usuario\n2 - No permitir que ningún sitio detecte el estado de inactividad del usuario\n3 - Preguntar siempre que un sitio quiera detectar el estado de inactividad del usuario\nPermite definir si los sitios web tienen permiso para usar la API Idle Detection.\n\nSi se le asigna el valor 1 (AllowIdleDetection) a esta política, los sitios web podrán usar la API sin pedir permiso al usuario.\n\nSi se le asigna el valor 2 (BlockIdleDetection), los sitios web no podrán usar la API, independientemente del permiso del usuario.\n\nSi se le asigna el valor 3 (AskIdleDetection) o no se define esta política, los sitios web no podrán usar la API sin el permiso del usuario.";
DefaultImagesSetting.pfm_title = "Configuración de imágenes predeterminada";
DefaultImagesSetting.pfm_description = "1 - Permitir que todos los sitios muestren todas las imágenes\n2 - No permitir que todos los sitios muestren imágenes\nSi se asigna el valor 1 a esta política, todos los sitios web podrán mostrar imágenes. Si se le asigna el valor 2, no se permitirá la visualización de imágenes.\n\nSi no se establece, podrán mostrarse imágenes, pero los usuarios podrán cambiar esta opción.";
DefaultInsecureContentSetting.pfm_title = "Permite controlar el uso de las excepciones de contenido no seguro";
DefaultInsecureContentSetting.pfm_description = "2 - No permitir que los sitios puedan cargar contenido mixto\n3 - Permitir que los usuarios añadan excepciones para permitir contenido mixto\nPermite especificar si los usuarios pueden añadir excepciones para permitir el contenido mixto en determinados sitios.\n\nEsta política se puede anular para patrones de URL concretos mediante las políticas \"InsecureContentAllowedForUrls\" e \"InsecureContentBlockedForUrls\".\n\nSi no se establece esta política, los usuarios podrán añadir excepciones para permitir contenido mixto bloqueable e inhabilitar actualizaciones automáticas de contenido mixto bloqueable opcionalmente.";
DefaultJavaScriptJitSetting.pfm_title = "Controlar el uso de JavaScript con JIT";
DefaultJavaScriptJitSetting.pfm_description = "1 - Permitir que JavaScript use JIT en cualquier sitio\n2 - No permitir que JavaScript use JIT en ningún sitio\nTe permite definir si Brave ejecutará el motor V8 de JavaScript con un compilador en tiempo de ejecución (JIT) habilitado o no.\n\nSi se inhabilita el uso de JavaScript con JIT, es posible que Brave renderice contenido web de forma más lenta y que también se inhabiliten algunas partes de JavaScript, como WebAssembly. Al inhabilitarse el uso de JavaScript con JIT, es posible que Brave renderice contenido web con una configuración más segura.\n\nEsta política se puede anular para patrones de URL específicos usando las políticas JavaScriptJitAllowedForSites y JavaScriptJitBlockedForSites.\n\nSi no se establece esta política, se habilitará el uso de JavaScript con JIT.";
DefaultJavaScriptOptimizerSetting.pfm_title = "Controlar el uso de optimizadores de JavaScript";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Habilitar optimizaciones avanzadas de JavaScript en todos los sitios\n2 - Inhabilitar optimizaciones avanzadas de JavaScript en todos los sitios\nTe permite definir si Brave ejecutará el motor V8 de JavaScript con más optimizaciones avanzadas de JavaScript habilitadas.\n\nSi se inhabilitan las optimizaciones de JavaScript (asignando el valor 2 a esta política), es posible que Brave renderice el contenido web más lentamente.\n\nEsta política se puede anular para patrones de URL específicos usando las políticas JavaScriptOptimizerAllowedForSites y JavaScriptOptimizerBlockedForSites.\n\nSi no se define esta política, se habilitarán las optimizaciones de JavaScript.";
DefaultJavaScriptSetting.pfm_title = "Configuración de JavaScript predeterminada";
DefaultJavaScriptSetting.pfm_description = "1 - Permitir que todos los sitios ejecuten JavaScript\n2 - No permitir que ningún sitio ejecute JavaScript\nSi se asigna el valor 1 a esta política, los sitios web podrán ejecutar JavaScript. Si se le asigna el valor 2, no se permitirá el uso de JavaScript.\n\nSi no se establece, podrá ejecutarse JavaScript, pero los usuarios podrán cambiar esta opción.";
DefaultLocalFontsSetting.pfm_title = "Ajuste predeterminado del permiso de fuentes locales";
DefaultLocalFontsSetting.pfm_description = "2 - Negar el permiso de fuentes locales en todos los sitios de forma predeterminada\n3 - Preguntar cada vez que un sitio quiera obtener el permiso de fuentes locales\nSi a esta política se le asigna el valor BlockLocalFonts (valor 2), se negará automáticamente el permiso de fuentes locales en los sitios de forma predeterminada. Esto limitará la capacidad de los sitios para ver información sobre fuentes locales.\n\nSi a la política se le asigna el valor AskLocalFonts (valor 3), se avisará al usuario cuando el permiso de fuentes locales se pida de forma predeterminada. Si los usuarios dan permiso, se ampliará la capacidad de los sitios para ver información sobre fuentes locales.\n\nSi la política no se establece, se aplicará el comportamiento predeterminado, que consiste en avisar al usuario, pero los usuarios podrán cambiar esta opción.";
DefaultNotificationsSetting.pfm_title = "Configuración de notificación predeterminada";
DefaultNotificationsSetting.pfm_description = "1 - Permitir que los sitios muestren notificaciones de escritorio\n2 - No permitir que ningún sitio muestre notificaciones de escritorio\n3 - Preguntar siempre que un sitio quiera mostrar notificaciones de escritorio\nSi se asigna el valor 1 a esta política, los sitios web podrán mostrar notificaciones de escritorio. Si se le asigna el valor 2, no se permitirán las notificaciones de escritorio.\n\nSi no se establece, se aplicará la política AskNotifications, pero los usuarios podrán cambiar esta opción.";
DefaultPopupsSetting.pfm_title = "Configuración de ventanas emergentes predeterminada";
DefaultPopupsSetting.pfm_description = "1 - Permitir que todos los sitios muestren ventanas emergentes\n2 - No permitir que ningún sitio muestre ventanas emergentes\nSi se asigna el valor 1 a esta política, los sitios web podrán mostrar ventanas emergentes. Si se le asigna el valor 2, no se permitirán las ventanas emergentes.\n\nSi no se establece, se aplicará la política BlockPopups, pero los usuarios podrán cambiar esta opción.";
DefaultPrinterSelection.pfm_title = "Reglas para la selección de la impresora predeterminada";
DefaultPrinterSelection.pfm_description = "Si se define esta política, se establecerán las reglas de selección de impresora predeterminada de Brave y se anularán las reglas predeterminadas. La impresora se seleccionará la primera vez que los usuarios intenten imprimir, cuando Brave busque una impresora que tenga los atributos especificados. Si no se encuentra una coincidencia exacta, se puede configurar Brave para que seleccione cualquier impresora que coincida, según el orden en el que se detecten.\n\nSi no se define esta política o se le asignan atributos para los que no hay coincidencias, la impresora de PDF integrada será la predeterminada. Si no hay impresora de PDF, Brave no seleccionará ninguna como predeterminada.\n\nActualmente, todas las impresoras están clasificadas como \"local\". Las impresoras conectadas a Google Cloud Print se consideran \"cloud\", pero Google Cloud Print ya no se admite.\n\nNota: Si se omite un campo, todos los valores coincidirán con ese campo concreto. Por ejemplo, si no se especifica idPattern, la vista previa de impresión aceptará todos los IDs de impresoras. Los patrones de expresión regular deben seguir la sintaxis de expresiones regulares de JavaScript y las coincidencias distinguen entre mayúsculas y minúsculas.\nConsulta la página https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection para obtener más información sobre el esquema y el formato.";
DefaultSearchProviderAlternateURLs.pfm_title = "Lista de URL alternativas para el proveedor de búsquedas predeterminado";
DefaultSearchProviderAlternateURLs.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderAlternateURLs, se especificará una lista con URL alternativas para extraer términos de búsqueda del buscador. Las URL deben incluir la cadena '{searchTerms}'.\n\nSi no se asigna ningún valor a DefaultSearchProviderAlternateURLs, no se usará ninguna URL alternativa para extraer términos de búsqueda.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Permitir el acceso a la búsqueda a través del menú contextual con el proveedor predeterminado";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "Habilita el uso de un proveedor de búsqueda predeterminado en el menú contextual.\n\nSi se inhabilita esta política, no se mostrará la opción de búsqueda del menú contextual que depende de tu proveedor de búsqueda predeterminado.\n\nSi se habilita esta política o no se establece, la opción de menú contextual de tu proveedor de búsqueda predeterminado estará disponible.\n\nEl valor de la política solo se aplica cuando la política DefaultSearchProviderEnabled está habilitada y no es aplicable en caso contrario.";
DefaultSearchProviderEnabled.pfm_title = "Habilitar proveedor de búsquedas predeterminadas";
DefaultSearchProviderEnabled.pfm_description = "Si se habilita esta política, se realiza una búsqueda predeterminada cuando un usuario introduce en la barra de direcciones texto que no es una URL. Para especificar el buscador predeterminado, configura el resto de las políticas de búsqueda predeterminadas. Si no configuras esas políticas, el usuario podrá elegir el proveedor predeterminado. Si se inhabilita esta política, no se realizará ninguna búsqueda cuando el usuario introduzca texto que no es una URL en la barra de direcciones. Google Admin console no admite que se defina esta política como inhabilitada.\n\nSi se le asigna un valor a esta política, los usuarios no podrán cambiarlo en Brave. Si no se le asigna ninguno, el buscador predeterminado estará activado y los usuarios podrán crear la lista de buscadores.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
DefaultSearchProviderEncodings.pfm_title = "Codificaciones del proveedor de búsquedas predeterminadas";
DefaultSearchProviderEncodings.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderEncodings, se especificarán las codificaciones de caracteres admitidas por el proveedor de búsquedas. Las codificaciones son nombres de páginas de códigos, como UTF‑8, GB2312 o ISO-8859‑1. Se intentarán utilizar siguiendo el orden especificado.\n\nSi no se asigna ningún valor a DefaultSearchProviderEncodings, se utilizará la codificación UTF‑8.";
DefaultSearchProviderImageURL.pfm_title = "Parámetro que proporciona una función de búsqueda por imágenes para el proveedor de búsquedas predeterminado";
DefaultSearchProviderImageURL.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderImageURL, se especificará la URL del buscador que se usará para la búsqueda de imágenes (si se asigna un valor a DefaultSearchProviderImageURLPostParams, las solicitudes de búsqueda de imágenes usarán el método POST).\n\nSi no se asigna ningún valor a DefaultSearchProviderImageURL, no se utilizará la búsqueda de imágenes.\n\nSi la búsqueda de imágenes usa el método GET, la URL deberá especificar parámetros\nde imagen mediante una combinación válida de los siguientes marcadores de posición:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "Parámetros para URL de imagen que utiliza POST";
DefaultSearchProviderImageURLPostParams.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderImageURLPostParams, se especificarán los parámetros que se usarán para la búsqueda de imágenes con POST. Se compone de pares de nombre-valor separados por comas. Si un valor es un parámetro de plantilla, como {imageThumbnail}, se sustituirá por datos de imágenes en miniatura reales.\n\nSi no se asigna ningún valor a DefaultSearchProviderImageURLPostParams, la solicitud de búsqueda de imágenes se enviará mediante el método GET.\n\nLa URL deberá especificar parámetros de imagen mediante una combinación válida de\n los siguientes marcadores de posición según lo que admita el proveedor de búsqueda:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Palabra clave de proveedor de búsquedas predeterminadas";
DefaultSearchProviderKeyword.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderKeyword, se especificarán la palabra clave y el acceso directo que se utilizan en la barra de direcciones para activar una búsqueda con este proveedor.\n\nSi no se asigna ningún valor a DefaultSearchProviderKeyword, el proveedor de búsqueda no se activará con ninguna palabra clave.";
DefaultSearchProviderName.pfm_title = "Nombre del proveedor de búsquedas predeterminadas";
DefaultSearchProviderName.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderName, se especificará el nombre del proveedor de búsquedas predeterminado.\n\nSi no se asigna ningún valor a DefaultSearchProviderName, se usará el nombre de host especificado por la URL de búsqueda.";
DefaultSearchProviderNewTabURL.pfm_title = "URL de la página Nueva pestaña del proveedor de búsqueda predeterminado";
DefaultSearchProviderNewTabURL.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderNewTabURL, se especificará la URL que utilizará el buscador para mostrar la página Nueva pestaña.\n\nSi no se asigna ningún valor a DefaultSearchProviderNewTabURL, no se mostrará ninguna página Nueva pestaña.";
DefaultSearchProviderSearchURL.pfm_title = "URL de búsqueda del proveedor de búsquedas predeterminadas";
DefaultSearchProviderSearchURL.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderSearchURL, se especificará la URL del buscador usada durante una búsqueda predeterminada. La URL debe incluir la cadena '{searchTerms}', que en la consulta se sustituirá por los términos de búsqueda del usuario.\n\nPuedes especificar la URL de la Búsqueda de Google introduciendo lo siguiente: '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "Parámetros para URL de búsqueda que utiliza POST";
DefaultSearchProviderSearchURLPostParams.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderSearchURLPostParams, se especificarán los parámetros utilizados al buscar una URL con POST. Se compone de pares de nombre-valor separados por comas. Si un valor es un parámetro de plantilla, como '{searchTerms}', se sustituirá por datos de términos de búsqueda reales.\n\nSi no se asigna ningún valor a DefaultSearchProviderSearchURLPostParams, las solicitudes de búsqueda se enviarán mediante el método GET.";
DefaultSearchProviderSuggestURL.pfm_title = "URL de sugerencia del proveedor de búsquedas predeterminadas";
DefaultSearchProviderSuggestURL.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderSuggestURL, se especificará la URL que utilizará el buscador para mostrar sugerencias de búsqueda. La URL debe incluir la cadena '{searchTerms}', que en la consulta se sustituirá por los términos de búsqueda del usuario.\n\nPuedes especificar la URL de la Búsqueda de Google introduciendo lo siguiente: '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "Parámetros para URL sugerida que utiliza POST";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "Si DefaultSearchProviderEnabled está activada y se asigna un valor a DefaultSearchProviderSuggestURLPostParams, se especificarán los parámetros utilizados al buscar sugerencias con POST. Se compone de pares de nombre-valor separados por comas. Si un valor es un parámetro de plantilla, como '{searchTerms}', se sustituirá por datos de términos de búsqueda reales.\n\nSi no se asigna ningún valor a DefaultSearchProviderSuggestURLPostParams, las solicitudes de búsqueda de sugerencias se enviarán mediante el método GET.";
DefaultSensorsSetting.pfm_title = "Configuración predeterminada de los sensores";
DefaultSensorsSetting.pfm_description = "1 - Permitir a los sitios web acceder a los sensores\n2 - No permitir a ningún sitio web acceder a los sensores\n3 - Preguntar siempre que un sitio quiera acceder a los sensores\nSi se le asigna el valor 1 a esta política, los sitios web podrán usar y acceder a los sensores, como los de luz o movimiento. Si se le asigna el valor 2 a esta política, se denegará el acceso a los sensores. Si se le asigna el valor 3 a esta política y la marca de función de tres estados está habilitada, se preguntará al usuario cuando un sitio solicite acceso a los sensores. Si no, se permitirá el acceso a los sensores de forma predeterminada.\n\nSi no se establece, se aplicará la política AllowSensors, pero los usuarios podrán cambiar esta opción.";
DefaultSerialGuardSetting.pfm_title = "Controlar el uso de la API Serial";
DefaultSerialGuardSetting.pfm_description = "2 - No permitir a ningún sitio web solicitar acceso a puertos serie a través de la API Serial\n3 - Dejar que los sitios web pidan permiso al usuario para acceder a un puerto serie\nSi se asigna el valor 3 a esta política, los sitios web podrán solicitar acceso a los puertos serie. Si se le asigna el valor 2, se denegará el acceso a los puertos serie.\n\nSi no se le asigna ningún valor, los sitios web podrán solicitar acceso, pero los usuarios podrán cambiar esta opción.";
DefaultWebBluetoothGuardSetting.pfm_title = "Controlar el uso de la API Bluetooth web";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - No permitir que los sitios soliciten acceso a los dispositivos Bluetooth a través de la API Bluetooth web\n3 - Permitir que los sitios le pidan permiso al usuario para acceder a dispositivos Bluetooth cercanos\nSi se asigna el valor 3 a esta política, los sitios web podrán pedir acceso a los dispositivos Bluetooth cercanos. Si se le asigna el valor 2, se denegará el acceso a los dispositivos Bluetooth cercanos.\n\nSi no se le asigna ningún valor, los sitios web podrán pedir acceso, pero los usuarios podrán cambiar esta opción.";
DefaultWebHidGuardSetting.pfm_title = "Controla el uso de la API WebHID";
DefaultWebHidGuardSetting.pfm_description = "2 - No permite que ningún sitio solicite acceso a los dispositivos HID a través de la API WebHID\n3 - Permite que los sitios pidan permiso al usuario para acceder a un dispositivo HID\nSi se asigna el valor 3 a esta política, los sitios web podrán solicitar acceso a los dispositivos HID. Si se le asigna el valor 2, se denegará el acceso a los dispositivos HID.\n\nSi no se le asigna ningún valor, los sitios web podrán solicitar acceso, pero los usuarios podrán cambiar esta opción.\n\nEsta política se puede anular para patrones de url específicos usando las políticas WebHidAskForUrls y WebHidBlockedForUrls.";
DefaultWebUsbGuardSetting.pfm_title = "Controlar el uso de la API WebUSB";
DefaultWebUsbGuardSetting.pfm_description = "2 - No permitir que los sitios soliciten acceso a dispositivos USB a través de la API WebUSB\n3 - Permitir que los sitios pidan permiso al usuario para acceder a un dispositivo USB conectado\nSi se asigna el valor 3 a esta política, los sitios web podrán solicitar acceso a los dispositivos conectados por USB. Si se le asigna el valor 2, se bloqueará el acceso a los dispositivos conectados por USB.\n\nSi no se le asigna ningún valor, los sitios web podrán solicitar acceso, pero los usuarios podrán cambiar esta opción.";
DefaultWindowManagementSetting.pfm_title = "Configuración predeterminada del permiso de gestión de ventanas";
DefaultWindowManagementSetting.pfm_description = "2 - Niega el permiso de gestión de ventanas en todos los sitios de forma predeterminada\n3 - Preguntar siempre que un sitio quiera obtener el permiso de gestión de ventanas\nSi se le asigna el valor BlockWindowManagement (valor 2) a esta política, automáticamente se niega a los sitios el permiso de gestión de ventanas de forma predeterminada. Esto limitará la capacidad de los sitios de ver información sobre las pantallas de los dispositivos y usarla para abrir y colocar ventanas, o solicitar la pantalla completa en pantallas específicas.\n\nSi se le asigna el valor AskWindowManagement (valor 3), se avisará al usuario cuando el permiso de gestión de ventanas se pida de forma predeterminada. Si los usuarios dan permiso, se extenderá la capacidad de los sitios para ver información sobre las pantallas de los dispositivos y usarla para abrir y colocar ventanas, o solicitar la pantalla completa en pantallas específicas.\n\nSi la política no se establece, se aplicará la política AskWindowManagement, pero los usuarios podrán cambiar esta opción.\n\nEsta política sustituye a la obsoleta de DefaultWindowPlacementSetting.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Habilitar la eliminación de contraseñas que no se pueden descifrar";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Esta política controla si el Gestor de contraseñas integrado puede eliminar de su base de datos las contraseñas que no se pueden descifrar. Esto es necesario para restaurar la funcionalidad completa del Gestor de contraseñas integrado, pero puede implicar la pérdida permanente de datos. Los valores de contraseña que no se pueden descifrar no se convertirán en descifrables por sí solos y, si es posible corregirlos, normalmente se requiere que el usuario realice acciones complejas.\n\nSi se habilita esta política o no se define, los usuarios que tengan contraseñas que no se puedan descifrar guardadas en el Gestor de contraseñas integrado las perderán. Las contraseñas que aún estén operativas no se eliminarán.\n\nSi se inhabilita esta política, los usuarios conservarán los datos de su Gestor de contraseñas, pero su funcionalidad no estará operativa.\n\nSi se define esta política, los usuarios no podrán modificarla en Brave.";
DesktopSharingHubEnabled.pfm_title = "Habilitar la opción de compartir escritorio en el omnibox y el menú de 3 puntos";
DesktopSharingHubEnabled.pfm_description = "Si se asigna el valor True a esta política o no se establece, los usuarios podrán compartir o guardar la página web actual usando acciones proporcionadas por el centro para compartir escritorio. Se puede acceder al centro para compartir desde un icono del omnibox o desde el menú de 3 puntos.\n\nSi se le asigna el valor False, se eliminará el icono para compartir del omnibox y el acceso del menú de 3 puntos.";
DevToolsGenAiSettings.pfm_title = "Configuración de las funciones de IA generativa de Chrome DevTools";
DevToolsGenAiSettings.pfm_description = "0 - Permitir las funciones de IA generativa de Chrome DevTools y mejorar los modelos de IA.\n1 - Permitir funciones de IA generativa de Chrome DevTools sin mejorar los modelos de IA.\n2 - No permitir funciones de IA generativa de Chrome DevTools.\nEstas funciones de Chrome DevTools emplean modelos de IA generativa para proporcionar información de depuración adicional. Para usar estas funciones, Brave tiene que recoger datos como mensajes de error, rastreos de la pila, fragmentos de código y solicitudes de red, y enviarlos a un servidor que pertenece a Google y ejecuta un modelo de IA generativa. En los datos enviados al servidor no se incluyen el cuerpo de las respuestas ni los encabezados de autenticación y cookies de las solicitudes de red.\n\nSi se asigna el valor 0, permite que se use la función y que Google utilice datos relevantes para mejorar sus modelos de IA. Según la función, los datos pertinentes pueden ser peticiones, entradas, resultados, materiales de origen y comentarios escritos. También es posible que los revisen un equipo de personas para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los casos indicados abajo.\n\nSi se asigna el valor 1, permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (incluyendo peticiones, entradas, resultados, materiales de origen y comentarios escritos). 1 es el valor predeterminado de los usuarios de empresa que se gestionan en la Google Admin console y de las cuentas de centro educativo que se gestionan en Google Workspace.\n\nSi se asigna el valor 2, no se permite la función.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nEntre las funciones de IA generativa de Chrome DevTools se incluyen las siguientes:\n\n- Console Insights: explica los mensajes de la consola y ofrece sugerencias sobre cómo solucionar errores de la consola.\n\n- Asistencia de IA: recibe ayuda para entender los estilos de CSS (desde la versión 131), las solicitudes de red, el rendimiento y los archivos (todos ellos desde la versión 132).\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Habilitar los perfiles de Google Developer Program en Chrome DevTools";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Habilitar la integración de Google Developer Program en Chrome DevTools.\n1 - Habilitar la integración de Google Developer Program en Chrome DevTools, pero sin compartir el uso de herramientas (para conceder insignias).\n2 - No habilitar la integración de Google Developer Program en Chrome DevTools.\nEsta política controla la integración de Google Developer Program con Chrome DevTools. El perfil del usuario en Google Developer Program se muestra en Chrome DevTools, y los usuarios reciben insignias por realizar acciones específicas en Chrome DevTools.\n\nSi se asigna el valor 0 (habilitada) a la política o no se define ningún valor, se permitirá la integración de Google Developer Program con Chrome DevTools y se podrá compartir el uso de la herramienta Chrome DevTools para poder conceder insignias.\n\nSi se asigna el valor 1 (habilitada sin insignias) a la política, se permitirá la integración de Google Developer Program con Chrome DevTools, pero no se permitirá compartir el uso de la herramienta Chrome DevTools con Google Developer Program. No se concederán insignias.\n\nSi se le asigna el valor 2 (inhabilitada) a la política, no se permitirá la integración de Google Developer Program con Chrome DevTools.";
DeveloperToolsAvailability.pfm_title = "Controlar dónde se puede usar Chrome DevTools";
DeveloperToolsAvailability.pfm_description = "0 - No permitir el uso de Chrome DevTools en aplicaciones ni extensiones instaladas por políticas de empresa o, desde la versión 114 y si se trata de un usuario gestionado, no permitir su uso en extensiones integradas en el navegador. Permitir el uso de Chrome DevTools en otros contextos.\n1 - Permitir el uso de Chrome DevTools\n2 - No permitir el uso de Chrome DevTools\nSi se le asigna el valor \"0\" (predeterminado) a esta política, podrás acceder a Chrome DevTools y a la consola de JavaScript, pero no en extensiones instaladas por políticas de empresa o, desde la versión 114 y si se trata de un usuario gestionado, no podrás acceder a ni a la consola de JavaScript en extensiones integradas en el navegador. Si se le asigna el valor \"1\", podrás acceder a Chrome DevTools y a la consola de JavaScript sin excepciones, incluso en extensiones instaladas por políticas de empresa. Si se le asigna el valor \"2\", no podrás acceder a Chrome DevTools ni tampoco podrás inspeccionar elementos de sitios web.\n\nEste ajuste también desactiva las combinaciones de teclas y las entradas de menús o menús contextuales que permiten abrir Chrome DevTools y la consola de JavaScript.\n\nA partir de la versión 99 de Brave, este ajuste también controla los puntos de entrada de la función Ver código fuente de la página. Si se asigna el valor \"DeveloperToolsDisallowed\" (valor 2) a esta política, los usuarios no podrán visualizar el código fuente a través de una combinación de teclas ni mediante el menú contextual. Para bloquear completamente la visualización del código fuente, también debes añadir \"view-source:*\" a la política URLBlocklist.\n\nA partir de la versión 119 de Brave, este ajuste también controla si se puede activar y usar el modo Desarrollador para aplicaciones web aisladas.\n\nA partir de la versión 128 de Brave, este ajuste no controlará el modo Desarrollador en la página de extensiones si se define la política ExtensionDeveloperModeSettings.\n\nEsta política afecta a Chrome DevTools, al acceso directo al protocolo de Chrome DevTools (CDP) (por ejemplo, cuando se inicia con --remote-debugging-port o --remote-debugging-pipe) y al acceso al protocolo de Chrome DevTools (CDP) a través de las APIs de chrome.debugger. Se aplican tanto esta política como la política RemoteDebuggingAllowed: RemoteDebuggingAllowed controla si se puede iniciar la depuración remota, mientras que esta política restringe si se pueden inspeccionar objetivos concretos incluso cuando la depuración remota está en curso.\n\nLas políticas DeveloperToolsAvailabilityAllowlist y DeveloperToolsAvailabilityBlocklist prevalecen sobre esta política. La disponibilidad de Chrome DevTools se determina según este orden de prioridad:\n\n1. Si una URL coincide con un patrón de la política DeveloperToolsAvailabilityAllowlist, se permitirá el uso de Chrome DevTools.\n2. Si se define DeveloperToolsAvailabilityAllowlist y no se define DeveloperToolsAvailabilityBlocklist, se bloquearán todas las URLs que no estén incluidas en la lista de permitidas.\n3. Si una URL coincide con un patrón de la política DeveloperToolsAvailabilityBlocklist, se bloqueará el uso de Chrome DevTools.\n4. Si no se define ninguna de las dos políticas o si una URL no coincide con ninguna de las listas, se usará esta política (DeveloperToolsAvailability) como mecanismo de respaldo.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Lista de patrones de URL para los que se permite abrir las Chrome DevTools";
DeveloperToolsAvailabilityAllowlist.pfm_description = "Esta política se puede usar para permitir las Chrome DevTools en URLs específicas.\n\nLa disponibilidad de las Chrome DevTools se evalúa a nivel de destino. Los patrones de URL se comparan con la URL de cada objetivo que se inspecciona (como el marco principal de una página, un submarco insertado, una extensión o una aplicación web). El comportamiento resultante dependerá de si también se ha definido la política DeveloperToolsAvailabilityBlocklist.\n\nSi se define esta política y no se define DeveloperToolsAvailabilityBlocklist, la URL de un destino debe coincidir con un patrón de esta lista de permitidas para que se puedan usar las Chrome DevTools en ese destino. Si la URL de un destino no coincide con esta lista de permitidas, se bloquearán las Chrome DevTools en ese destino (por ejemplo, no se podrá inspeccionar un subframe cuya URL no esté en la lista de permitidas, pero la página principal sí se podrá inspeccionar si su URL está en la lista de permitidas). Para obtener información sobre el formato de URL, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSi se definen tanto esta política como la política DeveloperToolsAvailabilityBlocklist, prevalecerá esta lista de permitidas. Si la URL de un destino coincide con un patrón de esta lista de permitidas, se podrá usar, aunque también coincida con un patrón de la lista de bloqueadas. Si la URL de un destino coincide con un patrón de esta lista de bloqueadas (pero no con uno de la lista de permitidas), se bloqueará. Si la URL de un destino no coincide con ninguna de las dos, se usará la política DeveloperToolsAvailability como alternativa.\n\nSi no se define esta política, la disponibilidad de Chrome DevTools se determinará según las políticas DeveloperToolsAvailabilityBlocklist y DeveloperToolsAvailability.\n\nNo se admiten comodines de host generales (por ejemplo, \"*\" ni \"[*]\"). Usa la política DeveloperToolsAvailability para habilitar la función de forma global.\n\nEsta política afecta a Chrome DevTools, al acceso directo al protocolo de Chrome DevTools (CDP) (por ejemplo, cuando se inicia con --remote-debugging-port o --remote-debugging-pipe) y al acceso al protocolo de Chrome DevTools (CDP) a través de las APIs de chrome.debugger. Se aplican tanto esta política como la política RemoteDebuggingAllowed: RemoteDebuggingAllowed controla si se puede iniciar la depuración remota, mientras que esta política restringe si se pueden inspeccionar objetivos concretos incluso cuando la depuración remota está en curso.\n\nEsta política está limitada a 1000 entradas.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Lista de patrones de URL para los que se bloquean las Chrome DevTools";
DeveloperToolsAvailabilityBlocklist.pfm_description = "Esta política se puede usar para bloquear Chrome DevTools en URLs concretas. Para obtener información sobre el formato de URL, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nLa disponibilidad de Chrome DevTools se evalúa a nivel de destino. Los patrones de URL se comparan con la URL de cada objetivo que se inspecciona (como el marco principal de una página, un submarco insertado, una extensión o una aplicación web). El comportamiento resultante dependerá de si también se ha definido la política DeveloperToolsAvailabilityAllowlist.\n\nSi se define esta política y no se define DeveloperToolsAvailabilityAllowlist, cualquier coincidencia en la URL de un destino con un patrón de esta lista de bloqueadas conllevará el bloqueo de Chrome DevTools en ese destino (por ejemplo, no se podrá inspeccionar un subframe cuya URL coincida con esta lista de bloqueadas, pero la página principal se podrá seguir inspeccionando si su URL no está en la lista de bloqueadas). Si la URL de un destino no coincide con ningún patrón, la disponibilidad se determinará según la política DeveloperToolsAvailability.\n\nSi se definen tanto esta política como la política DeveloperToolsAvailabilityAllowlist, prevalecerá la lista de permitidas. Si la URL de un destino coincide con un patrón de la lista de permitidas, se podrá usar, aunque también coincida con un patrón de esta lista de bloqueadas. Si la URL de un destino coincide con un patrón de esta lista de bloqueadas (pero no con uno de la lista de permitidas), se bloqueará. Si la URL de un destino no coincide con ninguna de las dos, se usará la política DeveloperToolsAvailability como alternativa.\n\nSi no se define esta política, la disponibilidad de Chrome DevTools se determinará según las políticas DeveloperToolsAvailabilityAllowlist y DeveloperToolsAvailability.\n\nEsta política afecta a Chrome DevTools, al acceso directo al protocolo de Chrome DevTools (CDP) (por ejemplo, cuando se inicia con --remote-debugging-port o --remote-debugging-pipe) y al acceso al protocolo de Chrome DevTools (CDP) a través de las APIs de chrome.debugger. Se aplican tanto esta política como la política RemoteDebuggingAllowed: RemoteDebuggingAllowed controla si se puede iniciar la depuración remota, mientras que esta política restringe si se pueden inspeccionar objetivos concretos incluso cuando la depuración remota está en curso.\n\nEsta política está limitada a 1000 entradas.";
Disable3DAPIs.pfm_title = "Inhabilitar compatibilidad con API de gráficos 3D";
Disable3DAPIs.pfm_description = "Si se le asigna el valor True a esta política (o se le asigna el valor False a HardwareAccelerationModeEnabled), las páginas web no podrán acceder a la API de WebGL.\n\nSi se le asigna el valor False o no se le asigna ningún valor, las páginas web podrán usar la API de WebGL, pero es posible que la configuración predeterminada del navegador requiera el uso de argumentos de línea de comandos para utilizar estas APIs.";
DisableAuthNegotiateCnameLookup.pfm_title = "Inhabilitar la consulta de nombre canónico en negociación de autenticación Kerberos";
DisableAuthNegotiateCnameLookup.pfm_description = "Si se habilita esta política, se omitirá la consulta de CNAME. El nombre del servidor se usará tal como se haya introducido al generar el SPN de Kerberos.\n\nSi se inhabilita esta política o no se define, se hará una consulta de CNAME para determinar el nombre canónico del servidor al generar el SPN de Kerberos.";
DisablePrintPreview.pfm_title = "Inhabilitar vista previa de impresión";
DisablePrintPreview.pfm_description = "Si se habilita la política, Brave abre el cuadro de diálogo de impresión del sistema en lugar de la vista previa de impresión integrada cuando los usuarios solicitan que se imprima.\n\nSi se inhabilita la política o no se establece, los comandos de impresión muestran la pantalla de vista previa de impresión";
DisableSafeBrowsingProceedAnyway.pfm_title = "Inhabilitar seguir navegando desde la página de advertencia sobre Navegación segura";
DisableSafeBrowsingProceedAnyway.pfm_description = "Si se habilita esta política, se evita que los usuarios puedan pasar de la página de advertencia que muestra el servicio Navegación segura antes de acceder a un sitio web malicioso. Esta política solo evita que los usuarios continúen si aparece una advertencia de Navegación segura (por ejemplo, por malware o suplantación de identidad), pero no si se trata de un problema relacionado con un certificado SSL (por ejemplo, si no es válido o ha caducado).\n\nSi se inhabilita o no se le asigna ningún valor, los usuarios podrán decidir si quieren acceder al sitio web denunciado después de ver la advertencia.\n\nConsulta más información sobre Navegación segura en https://developers.google.com/safe-browsing.";
DisableScreenshots.pfm_title = "Inhabilitar la realización de capturas de pantalla";
DisableScreenshots.pfm_description = "Si se habilita esta política, no se permitirá hacer capturas de pantalla mediante combinaciones de teclas ni APIs de extensión. Si se inhabilita esta política o no se establece, se permitirán las capturas de pantalla.\n\nA partir de la versión 154 de Brave, si se habilita esta política, también se impedirá que las extensiones adjunten el depurador mediante \"chrome.debugger.attach()\".\n\nTen en cuenta que en Microsoft® Windows®, macOS y Linux, esta política no impedirá que se hagan capturas de pantalla mediante aplicaciones del sistema operativo o de terceros.";
DiskCacheDir.pfm_title = "Establecer directorio de caché de disco";
DiskCacheDir.pfm_description = "Si se le asigna un valor a la política, Brave utilizará el directorio proporcionado para guardar archivos almacenados en caché en el disco independientemente de si los usuarios han especificado el indicador \"--disk-cache-dir\" o no.\n\nSi no se le asigna ningún valor, Brave usa el directorio de caché predeterminado, pero lo usuarios podrán cambiar el ajuste con el indicador de línea de comandos \"--disk-cache-dir\".\n\nBrave gestiona el contenido del directorio raíz de un volumen. Para evitar que se pierdan datos o que se produzcan otros errores, esta política no se debe asignar al directorio raíz ni a ningún otro directorio que se use para otros propósitos. Consulta las variables que puedes usar en esta página: https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DiskCacheSize.pfm_title = "Establecer tamaño de caché de disco";
DiskCacheSize.pfm_description = "Si se asigna el valor None a la política, Brave usará el tamaño de caché predeterminado para guardar archivos almacenados en caché en el disco. Los usuarios no pueden cambiar la configuración.\n\nSi se establece esta política, Brave usará el tamaño de caché indicado aunque el usuario no haya especificado la marca \"--disk-cache-size\" (se redondearán los valores inferiores a algunos megabytes).\n\nSi no se establece esta política, Brave usará el tamaño predeterminado. Los usuarios podrán cambiar el ajuste usando la marca \"--disk-cache-size\".\n\nNota: El valor especificado en esta política se utilizará como sugerencia en varios subsistemas de caché del navegador. Por ello, el consumo total real de disco de todas las cachés será mayor, pero se mantendrá en el mismo orden de magnitud que el valor especificado.";
DnsOverHttpsMode.pfm_title = "Controla el modo DNS-over-HTTPS";
DnsOverHttpsMode.pfm_description = "off - Inhabilitar DNS-over-HTTPS\nautomatic - Habilitar DNS-over-HTTPS con alternativa no segura\nsecure - Habilitar DNS-over-HTTPS sin alternativa no segura\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "Especifica la plantilla URI de resolución de DNS-over-HTTPS deseada";
DnsOverHttpsTemplates.pfm_description = "La plantilla URI de la resolución de DNS-over-HTTPS deseada. Para especificar varias resoluciones de DNS-over-HTTPS, separa las plantillas URI correspondientes con espacios.\n\nSi se asigna el valor \"secure\" a DnsOverHttpsMode, esta política debe establecerse y no dejarse vacía. Solo en Google Chrome OS, se debe definir esta política o DnsOverHttpsTemplatesWithIdentifiers. De lo contrario, la resolución de DNS no se podrá completar.\n\nSi se asigna el valor \"automatic\" a DnsOverHttpsMode y esta política se establece, se usarán las plantillas URI especificadas. Si la política no se establece, se usarán las asignaciones codificadas para intentar cambiar la resolución de DNS actual del usuario a una resolución de DoH operada por el mismo proveedor.\n\nSi la plantilla URI contiene una variable dns, las solicitudes para la resolución usarán GET; de lo contrario, las solicitudes usarán POST.\n\nLas plantillas con formato incorrecto se ignorarán.";
DomainReliabilityAllowed.pfm_title = "Permitir informes de datos relacionados con la fiabilidad de dominios";
DomainReliabilityAllowed.pfm_description = "Si se asigna el valor false a esta política, se inhabilitarán los informes de datos de diagnóstico sobre la fiabilidad de dominios y no se enviarán datos a Google.\nSi se asigna el valor true a esta política o no se define, los informes de datos de diagnóstico sobre la fiabilidad de dominios seguirán el comportamiento de MetricsReportingEnabled en el caso de Brave o el comportamiento DeviceMetricsReportingEnabled en el caso de Google Chrome OS.";
DownloadDirectory.pfm_title = "Establecer directorio de descargas";
DownloadDirectory.pfm_description = "Si se define esta política, se configurará el directorio donde Chrome guardará los archivos descargados. Chrome usará este directorio aunque los usuarios especifiquen otro o activen la marca para que siempre se les pregunte dónde quieren guardar los archivos descargados.\n\nEsta política anula la política DefaultDownloadDirectory.\n\nSi no se define esta política, Chrome usará el directorio de descargas predeterminado y los usuarios podrán cambiarlo.\n\nEn Google Chrome OS solo se pueden especificar directorios de Google Drive.\n\nNota: Consulta una lista de variables que puedes usar en https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DownloadRestrictions.pfm_title = "Restricciones de descarga";
DownloadRestrictions.pfm_description = "0 - Sin restricciones especiales. Predeterminado.\n1 - Bloquea las descargas maliciosas y los tipos de archivos peligrosos.\n2 - Bloquear las descargas maliciosas, poco frecuentes o no deseadas, así como los tipos de archivos peligrosos.\n3 - Bloquear todas las descargas.\n4 - Bloquea las descargas maliciosas. Recomendado.\nSi se establece la política, los usuarios no podrán sortear las medidas de seguridad de las descargas.\n\nHay muchos tipos de advertencias de descarga en Chrome. En general, pueden dividirse en las siguientes categorías (consulta más información sobre los resultados de Navegación segura en https://support.google.com/chrome/?p=ib_download_blocked):\n\n* Contenido malicioso: como lo marca el servidor de Navegación segura\n* Contenido poco frecuente o no deseado: como lo marca el servidor de Navegación segura\n* Tipo de archivo peligroso: por ejemplo, todas las descargas de archivos SWF y muchas descargas de archivos EXE\n\nCuando se establece la política, se bloquean distintos subconjuntos de estas categorías en función de su valor:\n\n0: sin restricciones especiales. Predeterminado.\n\n1: bloquea archivos maliciosos marcados por el servidor de Navegación segura Y todos los tipos de archivos peligrosos. Se recomienda exclusivamente en el caso de UOs/navegadores/usuarios que tengan tolerancia alta a los falsos positivos.\n\n2: bloquea archivos maliciosos marcados por el servidor de Navegación segura Y archivos poco frecuentes o no deseados marcados por el servidor de Navegación segura Y todos los tipos de archivos peligrosos. Se recomienda exclusivamente en el caso de UOs/navegadores/usuarios que tengan tolerancia alta a los falsos positivos.\n\n3: bloquea todas las descargas. No recomendado (excepto en casos especiales).\n\n4: bloquea archivos maliciosos marcados por el servidor de Navegación segura, pero no bloquea los tipos de archivos peligrosos. Recomendado.\n\nNota: Estas restricciones se aplican a las descargas activadas desde el contenido de las páginas web o mediante la opción del menú Descargar enlace. No se aplican a la opción de descargar de la página que se esté mostrando ni a la opción de guardar como PDF de las opciones de impresión. Consulta más información sobre Navegación segura en https://developers.google.com/safe-browsing.";
EditBookmarksEnabled.pfm_title = "Habilitar o inhabilitar la edición de marcadores";
EditBookmarksEnabled.pfm_description = "Si se habilita esta política o no se define, los usuarios podrán añadir, quitar, modificar o subir marcadores.\n\nSi se inhabilita esta política, los usuarios no podrán añadir, quitar, modificar ni subir marcadores. Sin embargo, podrán usar los marcadores existentes.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Incluir un puerto no estándar en SPN de Kerberos";
EnableAuthNegotiatePort.pfm_description = "Si se habilita esta política y se introduce un puerto no estándar (es decir, cualquier puerto que no sea el 80 ni el 443), ese puerto se incluirá en el SPN de Kerberos generado.\n\nSi se inhabilita o no se define, el SPN de Kerberos no incluirá ningún puerto.";
EnableExperimentalPolicies.pfm_title = "Habilita las políticas experimentales";
EnableExperimentalPolicies.pfm_description = "Permite a Brave cargar políticas experimentales.\n\nADVERTENCIA: No se ofrece asistencia para las políticas experimentales. Además, estas pueden modificarse o eliminarse sin previo aviso en futuras versiones del navegador.\n\nLas políticas experimentales pueden no haberse completado o tener defectos conocidos o desconocidos. Pueden también modificarse o eliminarse sin notificación previa. Si habilitas las políticas experimentales, podrías perder datos de navegación o poner en peligro tu seguridad o privacidad.\n\nSi una política no está en la lista y no se ha publicado oficialmente, su valor se ignorará en los canales beta y estable.\n\nSi una política está en la lista, pero no se ha publicado oficialmente, su valor sí se aplicará.\n\nEsta política no tiene ningún efecto en las políticas ya publicadas.";
EnableMediaRouter.pfm_title = "Habilitar Google Cast";
EnableMediaRouter.pfm_description = "Si se habilita esta política o no se establece, se activará Google Cast. Los usuarios pueden iniciarlo desde el menú de la aplicación, los menús contextuales de páginas, los controles multimedia de sitios web compatibles con Google Cast y, si aparece, con el icono de Cast en la barra de herramientas.\n\nSi se inhabilita esta política, se desactivará Google Cast.";
EnableOnlineRevocationChecks.pfm_title = "Habilita las comprobaciones de OCSP/CRL online";
EnableOnlineRevocationChecks.pfm_description = "Si se le asigna el valor \"True\" a esta política, se realizarán comprobaciones de OCSP/CRL online.\n\nSi se le asigna el valor \"False\" o no se le asigna ningún valor, Brave no realizará comprobaciones de revocación online en Brave 19 y versiones posteriores.\n\nNota: Las comprobaciones de OCSP/CRL no proporcionan una seguridad efectiva.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "Controla qué usuarios gestionados pueden definir las políticas ProxyOverrideRules y ProxyProvisioningDomains.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Si se le asigna el valor 0 a esta política o no se define, las políticas ProxyOverrideRules y ProxyProvisioningDomains solo se aplicarán al permiso de usuario para los usuarios afiliados en un navegador gestionado.\nSi se le asigna el valor 1 a esta política, las políticas ProxyOverrideRules y ProxyProvisioningDomains se aplicarán al permiso de usuario, aunque ese usuario no esté afiliado.";
EnableUnsafeSwiftShader.pfm_title = "Permitir la alternativa de WebGL por software con SwiftShader";
EnableUnsafeSwiftShader.pfm_description = "Política que controla si SwiftShader se usará como alternativa de WebGL cuando la aceleración por hardware de la GPU no esté disponible.\n\nSwiftShader se ha usado para admitir WebGL en sistemas sin aceleración de GPU, como sistemas sin cabezales o máquinas virtuales, pero se ha dejado de usar debido a problemas de seguridad. A partir de la versión M139, la creación de contexto de WebGL fallará cuando, de otro modo, se habría usado SwiftShader. Esta política permite al navegador o al administrador posponer temporalmente la discontinuación.\n\nSi se habilita esta política, SwiftShader se usará como alternativa de software de WebGL.\n\nSi se inhabilita esta política o no se define, es posible que no se pueda crear el contexto de WebGL si la aceleración por hardware de la GPU no está disponible. Las páginas web pueden comportarse mal si no gestionan correctamente el error de creación de contexto de WebGL.\n\nEsta es una política temporal que se eliminará en el futuro.";
EncryptedClientHelloEnabled.pfm_title = "Habilitar Encrypted ClientHello de TLS";
EncryptedClientHelloEnabled.pfm_description = "Encrypted ClientHello (ECH) es una extensión de TLS para cifrar campos sensibles de ClientHello y mejorar la privacidad.\n\nSi esta política se habilita o no se configura, Brave seguirá el proceso de lanzamiento predeterminado de ECH. Si se inhabilita, Brave no habilitará ECH.\n\nCuando esta función esté habilitada, Brave podrá usar o no ECH en función de la compatibilidad del servidor, de la disponibilidad del registro DNS HTTPS o del estado de lanzamiento.\n\nECH es un protocolo en constante evolución. Esto implica que la implementación de Brave está sujeta a cambios. Por lo tanto, esta política es una medida temporal para controlar la implementación experimental inicial. Se sustituirá por unos controles finales cuando se complete el protocolo.";
EnterpriseCustomLabel.pfm_title = "Definir una etiqueta de empresa personalizada para un perfil gestionado";
EnterpriseCustomLabel.pfm_description = "Esta política controla una etiqueta personalizada que se utiliza para identificar perfiles gestionados. En los perfiles gestionados, esta etiqueta se mostrará junto al avatar en la barra de herramientas. La etiqueta personalizada no se traducirá.\n\nCuando se aplique esta política, las cadenas que superen los 16 caracteres se truncarán con \"...\". No uses nombres muy largos.\n\nEsta política solo se puede establecer como política de usuarios.\n\nTen en cuenta que esta política no tendrá efecto si se asigna el valor hide_expanded_enterprise_toolbar_badge (valor 1) a la política EnterpriseProfileBadgeToolbarSettings.";
EnterpriseCustomLabelForBrowser.pfm_title = "Definir una etiqueta de empresa personalizada para un navegador gestionado";
EnterpriseCustomLabelForBrowser.pfm_description = "Esta política controla una etiqueta personalizada que se utiliza para indicar que un navegador está gestionado. En los navegadores gestionados, esta etiqueta se mostrará en un aviso de gestión en el pie de la página Nueva pestaña. La etiqueta personalizada no se traducirá.\n\nTen en cuenta que esta política solo se aplica a los navegadores gestionados, por lo que no afectará a los usuarios gestionados que usen navegadores no gestionados.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Permite que las extensiones gestionadas usen la API Enterprise Hardware Platform";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Si se le asigna el valor \"True\" a esta política, las extensiones instaladas por política de empresa podrán usar la API Enterprise Hardware Platform.\n\nSi se le asigna el valor \"False\" o si no se le asigna ningún valor, las extensiones no podrán usar esta API.\n\nNota: Esta política también se aplica a las extensiones de componentes, como la extensión Hangout Services.";
EnterpriseLogoUrl.pfm_title = "URL del logotipo de la empresa de un perfil gestionado";
EnterpriseLogoUrl.pfm_description = "La URL de una imagen que se usará como insignia de la empresa en un perfil gestionado. La URL debe dirigir a una imagen.\n\nEsta política solo se puede establecer como política de usuarios.\n\nSe recomienda usar el icono de página (por ejemplo, https://www.google.com/favicon.ico) o un icono de al menos 48x48 px.";
EnterpriseLogoUrlForBrowser.pfm_title = "URL del logotipo de la empresa de un navegador gestionado";
EnterpriseLogoUrlForBrowser.pfm_description = "La URL de una imagen que se usará como insignia de la empresa en un navegador gestionado. La URL debe dirigir a una imagen.\n\nSe recomienda usar el icono de página (por ejemplo, https://www.google.com/favicon.ico) o un icono de al menos 48x48 px.\n\nTen en cuenta que esta política solo se aplica a los navegadores gestionados, por lo que no afectará a los usuarios gestionados que usen navegadores no gestionados.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Controlar la visibilidad de la insignia del perfil de empresa en la barra de herramientas";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Mostrar insignia de empresa desplegada en la barra de herramientas\n1 - Ocultar insignia de empresa desplegada en la barra de herramientas\nEn los perfiles de trabajo y de centro educativo, la barra de herramientas mostrará una etiqueta de \"Trabajo\" o \"Centro educativo\" junto al avatar de la barra de herramientas de forma predeterminada. La etiqueta solo se mostrará si la cuenta con la que se ha iniciado sesión está gestionada.\n\nSi se le asigna el hide_expanded_enterprise_toolbar_badge (valor 1) a esta política, se ocultará la insignia de empresa de un perfil gestionado en la barra de herramientas.\n\nSi no se define esta política o se le asigna el valor show_expanded_enterprise_toolbar_badge (valor 0), se mostrará la insignia de empresa.\n\nLa etiqueta se puede personalizar mediante la política EnterpriseCustomLabel.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "Conservar datos de navegación de forma predeterminada al crear un perfil de empresa";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Si se habilita esta política, la opción de conservar los datos de navegación previos al crear un perfil de empresa estará marcada de forma predeterminada.\n\nSi esta política se inhabilita o no se establece, la opción de conservar los datos de navegación previos al crear un perfil de empresa no estará marcada de forma predeterminada.\n\nIndependientemente del valor que se asigne, el usuario podrá decidir si quiere conservar o no los datos de navegación previos al crear un perfil de empresa.\n\nEsta política no tendrá efecto si la opción de conservar los datos de navegación no está disponible. Esto ocurre si la separación de perfiles de empresa es estrictamente obligatoria o si los datos proceden de un perfil que ya está gestionado.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Configuración del agregador de búsquedas para empresas";
EnterpriseSearchAggregatorSettings.pfm_description = "Esta política permite a los administradores definir un agregador empresarial de búsqueda determinado que proporcionará recomendaciones y resultados de búsqueda en el omnibox (barra de direcciones) y en el cuadro de búsqueda de la página Nueva pestaña.\n\nDe forma predeterminada, las sugerencias de búsqueda empresariales se combinarán y se mostrarán junto con las recomendaciones normales de Brave. Los usuarios pueden limitar explícitamente su búsqueda solo al agregador de búsqueda empresarial escribiendo la palabra clave especificada en el campo shortcut con o sin el prefijo @ (por ejemplo, @work) y, después, pulsando la barra espaciadora o Tabulador en el omnibox. Las búsquedas empresariales limitadas (activadas por una palabra clave) solo se admiten en el omnibox y no en el cuadro de búsqueda de la página Nueva pestaña.\n\nLos siguientes campos son obligatorios: name, shortcut, search_url, suggest_url.\n\nEl campo name corresponde al nombre del buscador que se muestra al usuario en la barra de direcciones.\n\nEl campo shortcut corresponde a la palabra clave que introduce el usuario para activar la búsqueda. El acceso directo puede incluir palabras y caracteres sin formato, pero no puede incluir espacios ni empezar por el símbolo @. Los accesos directos deben ser únicos.\n\nEl campo search_url especifica la URL en la que se va a buscar. Introduce la dirección web de la página de resultados del buscador y utiliza '{searchTerms}' en lugar de la consulta.\n\nEl campo suggest_url especifica la URL que proporciona sugerencias de búsqueda. Se hará una solicitud POST y la consulta del usuario se pasará en los parámetros POST con la clave 'query'.\n\nEl campo icon_url especifica la URL de una imagen que se usará en las sugerencias de búsqueda. Si no se define este campo, se usará un icono predeterminado. Se recomienda usar un icono de página (por ejemplo, https://www.google.com/favicon.ico). Formatos de archivo de imagen admitidos: JPEG, PNG e ICO.\n\nEl campo require_shortcut especifica si se requiere el shortcut de la barra de direcciones para ver recomendaciones de búsqueda. Si es necesario, las sugerencias no se mostrarán en el cuadro de búsqueda de la página Nueva pestaña, pero seguirán apareciendo en el omnibox (barra de direcciones) en el modo de búsqueda limitada. Si no se define este campo, no se requiere el shortcut de la barra de direcciones.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.\nConsulta la página https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings para obtener más información sobre el esquema y el formato.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "Inhabilitar las advertencias de descarga de tipos de archivo asociados a dominios";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Puedes habilitar esta política para crear un diccionario de extensiones de archivo con una lista de dominios en los que no se mostrarán advertencias de descarga. De este modo, los administradores de empresas pueden bloquear las advertencias de descarga basadas en extensiones de tipos de archivo que estén asociados a un dominio de la lista. Por ejemplo, si la extensión \"jnlp\" se asociara con \"sitioweb1.com\", los usuarios no verían una advertencia al descargar archivos \"jnlp\" desde \"sitioweb1.com\", pero sí la verían al descargar archivos \"jnlp\" desde \"sitioweb2.com\".\n\nLos archivos con extensiones de archivo incluidas en los dominios que identifique esta política seguirán estando sujetos a otros tipos de advertencias de seguridad, como las de descarga de contenido mixto y las de Navegación segura.\n\nSi inhabilitas esta política o no la configuras, los usuarios seguirán viendo advertencias con los tipos de archivo que activan las advertencias de descarga basadas en extensiones.\n\nSi habilitas esta política:\n\n* El patrón de URL debería seguir el formato indicado en https://chromeenterprise.google/policies/url-patterns/.\n\n* La extensión de archivo introducida debe estar escrita en minúsculas con caracteres ASCII. No se debe incluir el separador inicial al añadir una extensión de archivo a la lista, así que deberías añadir \"jnlp\" en lugar de \".jnlp\".\n\nEjemplo:\n\nEl siguiente valor de ejemplo evitaría que se mostraran advertencias de descarga basadas en extensiones de archivos \"exe\" y \"jnlp\" en dominios *.example.com, y en extensiones \"swf\" en todos los dominios. En cualquier otro dominio, el usuario vería una advertencia de descarga basada en extensiones de tipos de archivo \"exe\" y \"jnlp\", pero no de \"swf\".\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nTen en cuenta que, aunque en el ejemplo anterior estén desactivadas las advertencias de descarga basadas en extensiones de archivos \"swf\" en todos los dominios, por motivos de seguridad, no se recomienda hacer esto con los tipos de archivo peligrosos. En el ejemplo se ha hecho solo para demostrar que puede hacerse.\n\nSi esta política se habilita junto a DownloadRestrictions, las excepciones a las advertencias basadas en extensiones de archivos especificadas en esta política tendrán prioridad sobre la configuración de DownloadRestrictions que bloquearía los tipos de archivo peligrosos. Las exenciones especificadas en esta política solo se aplican al comportamiento \"bloquear tipos de archivo peligrosos\" especificado por los valores 1 y 2 de DownloadRestrictions.\n\nPor ejemplo, si esta política especifica una exención para las descargas de archivos \"exe\" de \"sitioweb1.com\" y DownloadRestrictions se configura para bloquear descargas maliciosas y tipos de archivo peligrosos (valor 1), las descargas de archivos \"exe\" de \"sitioweb1.com\" estarán exentas del bloqueo basado en extensiones de archivos, pero se bloquearán si son maliciosas.\n\nPuedes consultar más información sobre DownloadRestrictions en https://chromeenterprise.google/policies/?policy=DownloadRestrictions.\nConsulta la página https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings para obtener más información sobre el esquema y el formato.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Puertos de red con permiso explícito";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - puerto 554 (puede desbloquearse hasta el 15/10/2021)\n10080 - puerto 10080 (puede desbloquearse hasta el 01/04/2022)\n6566 - puerto 6566 (puede desbloquearse hasta el 15/10/2021)\n989 - puerto 989 (puede desbloquearse hasta el 01/02/2022)\n990 - puerto 990 (puede desbloquearse hasta el 01/02/2022)\nHay una lista de puertos restringidos integrada en Brave. No se pueden establecer conexiones con estos puertos. Este ajuste permite eludir dicha lista. El valor es una lista separada por comas de cero o más puertos en los que se permitirán las conexiones salientes.\n\nLos puertos están restringidos para evitar que Brave se use como vector explotador de vulnerabilidades de la red. Si se establece esta política, tu red podría verse expuesta a ataques. El objetivo de esta política es ofrecer una solución temporal para los errores con el código \"ERR_UNSAFE_PORT\" cuando se migra un servicio que se está ejecutando en un puerto bloqueado a un puerto estándar (por ejemplo, el puerto 80 o el 443).\n\nLos sitios web maliciosos pueden detectar fácilmente si se ha definido esta política y para qué puertos, y usar esta información para dirigir ataques.\n\nCada puerto de esta lista tiene una etiqueta que indica la fecha hasta la que puede desbloquearse. Después de esa fecha, el puerto quedará restringido independientemente de cómo se defina este ajuste.\n\nSi el valor se deja vacío o sin definir, se bloquearán todos los puertos restringidos. Si hay tanto valores válidos como no válidos, se aplicarán los válidos.\n\nEsta política anula la opción de la línea de comandos \"--explicitly-allowed-ports\".";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Lista de proveedores de identidades bloqueados que no pueden usar Extensible Enterprise SSO en el navegador";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Todos los proveedores de identidades\nmicrosoft - Proveedor de identidades en la nube de Microsoft®\nokta - Proveedor de identidades en la nube de Okta®\nping - Proveedor de identidades en la nube de Ping®\nInhabilita el inicio de sesión único con Extensible Enterprise SSO para los proveedores de identidades que se indican.\n\nSi añades el valor 'all', se inhabilitarán todos los proveedores de identidades admitidos para el inicio de sesión único.\n\nSi añades el valor 'microsoft', se inhabilitará la compatibilidad de Chrome con el inicio de sesión único para el proveedor de identidades en la nube de Microsoft®.\n\nSi no se define esta política, se habilitarán todos los proveedores de identidades admitidos por Brave.\n\nEn el caso de los proveedores de identidades que se han habilitado en Brave y que ha configurado el administrador en el dispositivo, los usuarios que inicien sesión una vez con su cuenta usando ese proveedor de identidades (en cualquier aplicación que admita Extensible Enterprise SSO) podrán iniciar sesión automáticamente en propiedades web usando ese proveedor de identidades. La información relativa a la autenticación del usuario se transmite al proveedor de identidades en la nube del usuario en cada evento de autenticación.\n\nNotas:\n\nBrave no admite el inicio de sesión único con Extensible Enterprise SSO en los modos Incógnito o Invitado.\n\nBrave solo admite el inicio de sesión único con Extensible Enterprise SSO para los siguientes proveedores de identidades: Microsoft, Okta, Ping.\n\nEsta función está disponible a partir de macOS 10.15.";
ExtensionAllowedTypes.pfm_title = "Tipos de extensiones o aplicaciones que se pueden instalar";
ExtensionAllowedTypes.pfm_description = "extension - Extensión\ntheme - Tema\nuser_script - Script de usuario\nhosted_app - Aplicación alojada\nlegacy_packaged_app - Aplicación empaquetada antigua\nplatform_app - Aplicación de una plataforma\nSi se define esta política, controlará qué aplicaciones y extensiones pueden instalarse en Brave y con qué hosts podrán interactuar, y establecerá los límites de acceso del entorno de ejecución.\n\nSi no se define, no se aplicará ninguna restricción a los tipos aceptables de extensiones y aplicaciones.\n\nNo se instalarán las extensiones ni las aplicaciones cuyo tipo no esté en la lista. Cada valor debe ser una de estas cadenas:\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\nPara obtener más información sobre estos tipos, consulta la documentación sobre extensiones de Brave.\n\nLas versiones anteriores a la 75 que usen IDs de extensión separados por comas no son compatibles y se omitirán. El resto de la política seguirá siendo aplicable.\n\nNota: Esta política también afecta a las extensiones y aplicaciones que se deban instalar de manera forzada mediante ExtensionInstallForcelist.\n\nNota: Esta política solo se aplica a las plataformas compatibles con extensiones.";
ExtensionDeveloperModeSettings.pfm_title = "Controlar la disponibilidad del modo Desarrollador en la página de extensiones";
ExtensionDeveloperModeSettings.pfm_description = "0 - Permitir el uso del modo Desarrollador en la página de extensiones\n1 - No permitir el uso del modo Desarrollador en la página de extensiones\nControla si los usuarios pueden activar el modo Desarrollador en chrome://extensions.\n\nSi no se define esta política, los usuarios podrán activar el modo Desarrollador en la página de extensiones, a menos que se le asigne el valor (2) DeveloperToolsDisallowed a la política DeveloperToolsAvailability.\nSi se le asigna el valor Allow (0) a esta política, los usuarios podrán activar el modo Desarrollador en la página de extensiones.\nSi se le asigna el valor Disallow (1) a esta política, los usuarios no podrán activar el modo Desarrollador en la página de extensiones.\n\nSi se define esta política, DeveloperToolsAvailability ya no podrá controlar el modo Desarrollador de extensiones.\n\nNota: Esta política solo se aplica a las plataformas compatibles con extensiones.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Configurar una lista de orígenes que conceden una duración ampliada en segundo plano a las extensiones de conexión.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "Las extensiones que se conecten a uno de estos orígenes se seguirán ejecutando mientras el puerto esté conectado.\n\nSi no se establece la política, se usarán los valores predeterminados. Se trata de orígenes de aplicaciones que ofrecen SDKs que no dan la posibilidad de reiniciar una conexión cerrada a un estado anterior:\n- Smart Card Connector\n- Citrix Receiver (estable, beta y copia de seguridad)\n- VMware Horizon (estable, beta)\n\nSi se define, la lista de valores predeterminados se amplía con los valores configurados recientemente. Tanto los valores predeterminados como las entradas proporcionadas por la política concederán la excepción a las extensiones de conexión, siempre que el puerto esté conectado.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Habilitar las extensiones instaladas por políticas que anulan la configuración de búsqueda predeterminada o de la página Nueva pestaña";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Controla si se permiten las extensiones instaladas por políticas (instalación forzada o recomendada) que anulan la configuración del buscador predeterminado o de la página Nueva pestaña en entornos de baja confianza.\n\nEsta política solo se aplica a entornos de baja confianza (como dispositivos en los que las políticas se configuran de forma local sin gestión de dominios ni de la nube). Los entornos de alta confianza no se ven afectados:\n\nEn Microsoft® Windows®, esta política no está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política no está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.\n\nLas extensiones instaladas por políticas que anulen la configuración del buscador predeterminado o de la página Nueva pestaña seguirán habilitadas en estas instancias de alta confianza.\n\nSi se habilita, Brave permitirá que las extensiones instaladas por políticas que anulen la configuración del buscador predeterminado o de la página Nueva pestaña se instalen y permanezcan habilitadas en entornos de baja confianza.\n\nSi se inhabilita o no se configura, Brave impedirá que se instalen en entornos de baja confianza las extensiones instaladas por políticas que anulen la configuración del buscador predeterminado o de la página Nueva pestaña, y las eliminará si ya se han instalado.\n\nSi se actualiza una extensión afectada para que deje de anular estos ajustes, Brave la instalará automáticamente en un plazo de 7 días.\n\nEsta política es temporal y se eliminará en una versión futura.";
ExtensionInstallAllowlist.pfm_title = "ID de extensiones excluidas de la lista de bloqueados";
ExtensionInstallAllowlist.pfm_description = "Si se define esta política, se especificarán las extensiones que no están sujetas a la lista de bloqueadas.\n\nSi el valor de una lista de extensiones bloqueadas es *, se bloquearán todas las extensiones y los usuarios solo podrán instalar extensiones de la lista de permitidas.\n\nDe forma predeterminada, se permiten todas las extensiones. Sin embargo, si has prohibido las extensiones mediante una política, usa la lista de extensiones permitidas para cambiar esa política.\n\nNota: Esta política solo se aplica a las plataformas compatibles con extensiones.";
ExtensionInstallBlocklist.pfm_title = "ID de extensiones que el usuario no debe poder instalar (o * para incluirlas todas)";
ExtensionInstallBlocklist.pfm_description = "Permite especificar las extensiones que los usuarios no pueden instalar. Si se bloquea una extensión ya instalada, se inhabilitará y el usuario no podrá habilitarla. Si una extensión que se había inhabilitado porque estaba en la lista de bloqueados se quita de esa lista, volverá a habilitarse automáticamente.\n\nSi el valor de una lista de bloqueados es un asterisco (*), se bloquearán todas las extensiones de forma predeterminada. Las extensiones que se incluyen explícitamente en la lista de permitidas se permiten si están firmadas (comprimidas). Todas las extensiones descomprimidas están bloqueadas.\n\nSi no se define esta política, el usuario podrá instalar cualquier extensión en Brave.\n\nNota: Esta política solo se aplica a las plataformas compatibles con extensiones.";
ExtensionInstallForcelist.pfm_title = "IDs de extensiones/aplicaciones y URLs de actualización que se instalan automáticamente";
ExtensionInstallForcelist.pfm_description = "Si se define esta política, se especificará una lista de aplicaciones y extensiones que se instalarán de forma silenciosa, sin interacción del usuario, y que los usuarios no podrán desinstalar ni desactivar a través de la interfaz de Brave. Los permisos se concederán de forma implícita, incluidas las APIs de extensiones enterprise.deviceAttributes y enterprise.platformKeys. Estas dos APIs no estarán disponibles para las aplicaciones y extensiones que no se instalen de manera forzada.\n\nAunque el objetivo de Brave es evitar que los usuarios desinstalen estas extensiones, algunos sistemas operativos hacen imposible que Brave ofrezca una protección eficaz frente a las extensiones que se modifican externamente. Por lo tanto, esta prevención es la mejor solución.\n\nSi no se define esta política, no se instalará automáticamente ninguna aplicación ni extensión y los usuarios podrán desinstalar cualquier aplicación o extensión en Brave.\n\nEsta política sustituye a la política ExtensionInstallBlocklist. Si una aplicación o extensión que se haya instalado anteriormente de manera forzada se quita de esta lista, Brave la desinstalará automáticamente.\n\nLos usuarios pueden modificar el código fuente de las extensiones mediante las herramientas para desarrolladores, lo que podría provocar que la extensión no funcione correctamente. Si te preocupa, configura la política DeveloperToolsDisabled.\n\nCada elemento de la lista de la política es una cadena que contiene un ID de extensión y, opcionalmente, una URL de actualización separados por punto y coma (;). El ID de extensión es la cadena de 32 letras que aparece, por ejemplo, en chrome://extensions si está habilitado el modo Desarrollador. Si se especifica, la URL de actualización debe dirigir a un documento XML de un archivo de manifiesto de actualización (https://developer.chrome.com/extensions/autoupdate). La URL de actualización debería usar uno de los siguientes esquemas: http, https o file. De forma predeterminada, se usa la URL de actualización de Chrome Web Store. La URL de actualización definida en esta política solo se usará en la instalación inicial. Las actualizaciones posteriores de la extensión usarán la URL de actualización indicada en el archivo de manifiesto de la extensión. La URL de actualización de las actualizaciones posteriores se puede anular con la política ExtensionSettings. Consulta http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy.\n\nEn instancias de Microsoft® Windows®, las aplicaciones y extensiones que no estén alojadas en Chrome Web Store solo se podrán instalar de manera forzada si la instancia está vinculada a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o si se ha registrado en Chrome Enterprise Core.\n\nEn las instancias de macOS, las aplicaciones y extensiones externas a Chrome Web Store solo se podrán instalar de manera forzada si la instancia se gestiona mediante MDM, está vinculada a un dominio a través de MCX o se ha registrado en Chrome Enterprise Core.\n\nNota: Esta política no se aplica al modo Incógnito. Consulta más información sobre el alojamiento de extensiones en https://developer.chrome.com/extensions/hosting.\n\nNota: Esta política solo se aplica a las plataformas compatibles con extensiones.";
ExtensionInstallSources.pfm_title = "Patrones de URL desde los que se puede instalar secuencias de comandos de usuario, aplicaciones y extensiones";
ExtensionInstallSources.pfm_description = "Si se define esta política, se especificarán las URL que pueden instalar extensiones, aplicaciones y temas. Antes de la versión 21 de Brave, los usuarios podían hacer clic en un enlace a un archivo .crx y Brave les ofrecería la opción de instalar el archivo después de mostrar algunas advertencias. A continuación, esos archivos debían descargarse y arrastrarse a la página de configuración de Brave. Esta opción permite que determinadas URL sigan utilizando el proceso de instalación anterior, que era más sencillo.\n\nTodos los elementos de esta lista son patrones que coinciden con el estilo de las extensiones. Para obtener más información, visita https://developer.chrome.com/extensions/match_patterns. Los usuarios pueden instalar fácilmente elementos procedentes de cualquier URL que coincida con un elemento de esta lista. Estos patrones deben permitir tanto la ubicación del archivo .crx como la página en la que se inicia la descarga (la URL referente).\n\nExtensionInstallBlocklist prevalece frente a esta política. Esto significa que las extensiones incluidas en la lista de bloqueadas no se instalarán, aunque procedan de un sitio web incluido en esta lista.\n\nNota: Esta política solo se aplica a las plataformas compatibles con extensiones.";
ExtensionInstallTypeBlocklist.pfm_title = "Lista de bloqueados de tipos de instalación de extensiones";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Impide que las extensiones se carguen desde la línea de comandos\nLa lista de bloqueados controla qué tipos de instalación de extensiones no están permitidos.\n\nSi se asigna el valor \"command_line\" a una extensión, se impedirá que se cargue\ndicha extensión desde la línea de comandos.";
ExtensionReviewPromptsEnabled.pfm_title = "Controlar las peticiones de reseñas y los enlaces de valoración de extensiones";
ExtensionReviewPromptsEnabled.pfm_description = "Controla si las peticiones de reseñas y los enlaces de valoración nativos (como Valorar) de las extensiones de Chrome instaladas están disponibles en las interfaces de usuario de Chrome.\n\nSi se habilita o no se define esta política, los usuarios podrán ver puntos de entrada nativos para reseñar y valorar las extensiones aptas en la barra de herramientas, los menús contextuales y la página de gestión de extensiones (chrome://extensions).\n\nSi se inhabilita esta política, se suprimirán y no estarán disponibles todas las peticiones de reseñas y los enlaces de valoración nativos.";
ExtensionSettings.pfm_title = "Configuración de administración de extensiones";
ExtensionSettings.pfm_description = "Si se define esta política, se controlará la configuración de gestión de extensiones de Brave, incluidas las que controlen las políticas existentes relacionadas con las extensiones.\n\nEsta política asociará un ID de extensión o una URL de actualización únicamente a su configuración específica. Se puede definir una configuración predeterminada para el ID especial \"*\", que se aplicará a todas las extensiones para las que no se haya definido una configuración personalizada en esta política.\n\nEsta política puede anular los ajustes por extensión de las políticas antiguas.\n\nTen en cuenta que cualquier ajuste por ID de extensión de ExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist o ExtensionSettings solo heredará \"installation_mode\" y \"update_url\" de los valores predeterminados de \"*\". No heredará ninguna otra propiedad. Si se usa una URL de actualización, la configuración se aplicará a las extensiones que incluyan la misma URL de actualización en su archivo de manifiesto (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy). Si a la marca \"override_update_url\" se le asigna el valor true, la extensión se instalará y se actualizará mediante la URL de actualización que se especifique en la política ExtensionInstallForcelist o en el campo \"update_url\" de esta política. Se ignorará el indicador \"override_update_url\" si el valor de \"update_url\" es una URL de Chrome Web Store.\n\nA partir de la versión 154 de Brave, si se aplica \"runtime_blocked_hosts\" a una extensión con el permiso \"debugger\", se inhabilitará por completo \"chrome.debugger.attach()\" en todos los destinos.\n\nEn las instancias de Microsoft® Windows®, las aplicaciones y extensiones que no estén alojadas en Chrome Web Store solo se podrán instalar de manera forzada si la instancia está vinculada a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o si se ha registrado en Chrome Enterprise Core.\n\nEn las instancias de macOS, las aplicaciones y extensiones que no estén alojadas en Chrome Web Store solo se podrán instalar de manera forzada si la instancia se gestiona mediante MDM, está vinculada a un dominio a través de MCX o se ha registrado en Chrome Enterprise Core.\n\nNota: Esta política solo se aplica a las plataformas compatibles con extensiones.\nConsulta la página https://chromeenterprise.google/policies/?policy=ExtensionSettings para obtener más información sobre el esquema y el formato.";
ExtensionUnpublishedAvailability.pfm_title = "Controlar la disponibilidad de las extensiones cuya publicación se ha anulado en Chrome Web Store";
ExtensionUnpublishedAvailability.pfm_description = "0 - Permitir extensiones cuya publicación se ha anulado\n1 - Inhabilitar extensiones no publicadas\nSi se habilita esta política, las extensiones cuya publicación se haya anulado en Chrome Web Store se inhabilitarán en Brave.\nEsta política solo se aplica a las extensiones que se instalan y actualizan desde Chrome Web Store.\n\nSe ignoran las extensiones no incluidas en la tienda, como las que se descomprimen en el modo Desarrollador o las que se instalan mediante el interruptor de la línea de comandos.\nLas extensiones de instalación forzada que estén alojadas en servidores propios se ignorarán. También se ignoran todas las extensiones con una versión fija.\n\nSi se le asigna el valor AllowUnpublished (0) a esta política o no se define, se permitirán las extensiones no publicadas en Chrome Web Store.\nSi se le asigna el valor DisableUnpublished (1) a esta política, se inhabilitarán las extensiones que no estén publicadas en Chrome Web Store.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Permite mostrar la casilla Siempre abierto en el cuadro de diálogo de un protocolo externo.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Esta política controla si se muestra la casilla \"Abrir siempre\" en los mensajes de confirmación de lanzamiento de protocolos externos.\n\n     Si se asigna el valor \"True\" a esta política o no se le asigna ninguno, cuando aparezca un mensaje de confirmación de un protocolo externo, el usuario podrá elegir la opción \"Permitir siempre\" para omitir todos los mensajes de confirmación futuros en este sitio web para el protocolo.\n\n     Si se le asigna el valor \"False\", no aparecerá la casilla \"Permitir siempre\" y el usuario verá un mensaje de confirmación cada vez que se invoque un protocolo externo.";
FeedbackSurveysEnabled.pfm_title = "Especifica si se muestran encuestas en el producto de Brave a los usuarios.";
FeedbackSurveysEnabled.pfm_description = "Las encuestas en el producto de Brave recogen comentarios de los usuarios para el navegador. Las respuestas de las encuestas no están asociadas a cuentas de usuario.\nSi esta política se habilita o no se define, puede que las encuestas en el producto se muestren a los usuarios.\nSi se inhabilita esta política, las encuestas en el producto no se mostrarán a los usuarios.\n\nEsta política no tendrá efecto si se inhabilita MetricsReportingEnabled, lo que también inhabilita las encuestas en el producto.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Obtener duración de keepalive al cerrar";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Controla la duración (en segundos) permitida para las solicitudes keepalive al cerrar el navegador.\n\nSi se especifica un valor, se podrá bloquear el cierre del navegador durante el número de segundos\nindicado para procesar las solicitudes keepalive (https://fetch.spec.whatwg.org/#request-keepalive-flag).\n\nEl valor predeterminado (0) significa que esta función está inhabilitada.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Permitir llamar a las APIs de selección de archivos o directorios sin un gesto previo del usuario";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "Por motivos de seguridad, para llamar a las APIs web showOpenFilePicker(), showSaveFilePicker() y showDirectoryPicker(), se requiere un gesto previo del usuario (\"activación temporal\"). De lo contrario, se producirá un error.\n\nSi se define esta política, los administradores pueden especificar los orígenes desde los que se puede llamar a estas APIs sin ningún gesto previo del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Esta política no acepta el valor *.\n\nSi no se define esta política, se requerirá un gesto previo del usuario para llamar a estas APIs desde todos los orígenes.";
FileSystemReadAskForUrls.pfm_title = "Permitir el acceso de lectura a través de la API File System en estos sitios web";
FileSystemReadAskForUrls.pfm_description = "Si se establece esta política, podrás definir una lista de patrones de URL donde se especifique qué sitios pueden pedir a los usuarios que les concedan acceso de lectura a archivos o directorios del sistema de archivos del sistema operativo del host a través de la API File System.\n\nSi no se establece la política, DefaultFileSystemReadGuardSetting se aplicará a todos los sitios, si se ha definido. Si no se ha definido, se aplicará la configuración personal del usuario.\n\nLos patrones de URL no deben entrar en conflicto con FileSystemReadBlockedForUrls. Si una URL está incluida en ambas políticas, no tendrá preferencia ninguna política.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
FileSystemReadBlockedForUrls.pfm_title = "Bloquear el acceso de lectura a través de la API File System en estos sitios web";
FileSystemReadBlockedForUrls.pfm_description = "Si se establece esta política, podrás definir una lista de patrones de URL donde se especifique qué sitios no pueden pedir a los usuarios que les concedan acceso de lectura a archivos o directorios del sistema de archivos del sistema operativo del host a través de la API File System.\n\nSi no se establece la política, DefaultFileSystemReadGuardSetting se aplicará a todos los sitios, si se ha definido. Si no se ha definido, se aplicará la configuración personal del usuario.\n\nLos patrones de URL no pueden entrar en conflicto con la política FileSystemReadAskForUrls. Si una URL está incluida en ambas políticas, no tendrá preferencia ninguna política.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
FileSystemWriteAskForUrls.pfm_title = "Permitir el acceso de escritura a archivos y directorios en estos sitios web";
FileSystemWriteAskForUrls.pfm_description = "Si se le asigna un valor a esta política, podrás establecer una lista de patrones de URL donde se especifique qué sitios pueden pedir a los usuarios que les concedan acceso de escritura a archivos o directorios en el sistema de archivos del sistema operativo del host.\n\nSi no se establece la política, DefaultFileSystemWriteGuardSetting se aplicará a todos los sitios, si se ha definido. Si no se ha definido, se aplicará la configuración personal del usuario.\n\nLos patrones de URL no deben entrar en conflicto con FileSystemWriteBlockedForUrls. Si una URL está incluida en ambas políticas, no tendrá preferencia ninguna política.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
FileSystemWriteBlockedForUrls.pfm_title = "Bloquear el acceso de escritura a archivos y directorios en estos sitios web";
FileSystemWriteBlockedForUrls.pfm_description = "Si se le asigna un valor a esta política, podrás establecer una lista de patrones de URL donde se especifique qué sitios no pueden pedir a los usuarios que les concedan acceso de escritura a archivos o directorios en el sistema de archivos del sistema operativo del host.\n\nSi no se establece la política, DefaultFileSystemWriteGuardSetting se aplicará a todos los sitios, si se ha definido. Si no se ha definido, se aplicará la configuración personal del usuario.\n\nLos patrones de URL no pueden entrar en conflicto con la política FileSystemWriteAskForUrls. Si una URL está incluida en ambas políticas, no tendrá preferencia ninguna política.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
ForceEphemeralProfiles.pfm_title = "Perfil efímero";
ForceEphemeralProfiles.pfm_description = "Si se habilita, esta política fuerza el cambio del perfil al modo Efímero. Si se especifica como política del sistema operativo (p. ej., GPO en Windows), se aplicará a todos los perfiles del sistema; si se establece como política de la nube, solo se aplicará a un perfil en el que se inicie sesión con una cuenta gestionada.\n\nEn este modo, los datos de perfil solo se mantienen en el disco mientras dura la sesión del usuario. Una vez que se cierra el navegador, no se conservan ciertas funciones, como las extensiones y sus datos o el historial web, datos de Internet como las cookies ni las bases de datos web. Sin embargo, esto no impide que el usuario pueda descargar datos en el disco manualmente, guardar páginas o imprimirlas.\n\nSi el usuario habilita la sincronización, todos estos datos se conservan en su perfil de sincronización, al igual que ocurre con los perfiles normales. El modo Incógnito también está disponible (a menos que se inhabilite expresamente mediante esta política).\n\nSi esta política no se establece o no se habilita, se accederá a los perfiles normales al iniciar sesión.";
ForceForegroundPriorityForAllTabs.pfm_title = "Forzar la prioridad de primer plano de todas las pestañas";
ForceForegroundPriorityForAllTabs.pfm_description = "Esta política controla si se fuerza que el contenido web en segundo plano se ejecute con prioridad de primer plano.\n\nDe forma predeterminada, el navegador optimiza los recursos dando menos prioridad al contenido de las pestañas en segundo plano. Si se habilita esta política, se anulará ese comportamiento y las pestañas en segundo plano se programarán de la misma forma que la pestaña activa.\n\nTen en cuenta que forzar que el contenido en segundo plano se ejecute con prioridad de primer plano puede afectar ligeramente a la capacidad de respuesta de la pestaña activa.\n\nSi se habilita esta política, todo el contenido web se ejecutará con prioridad de primer plano, sea cual sea su estado de visibilidad.\n\nSi se inhabilita esta política o no se define, el navegador determinará la prioridad en función de métodos heurísticos estándar (por ejemplo, se dará menos prioridad al contenido que no esté visible, no reproduzca audio o no participe en videollamadas).";
ForceForegroundPriorityForUrls.pfm_title = "Forzar la prioridad de primer plano para URLs concretas";
ForceForegroundPriorityForUrls.pfm_description = "Esta política te permite especificar una lista de patrones de URL. El contenido web en segundo plano que coincida con estos patrones se forzará a ejecutarse con prioridad de primer plano.\n\nSi se habilita la política ForceForegroundPriorityForAllTabs, se ignorará esta lista, ya que se forzará que todas las pestañas tengan prioridad de primer plano.\n\nSi se inhabilita ForceForegroundPriorityForAllTabs o no se define, solo se forzará el contenido que coincida con los patrones de esta lista.\n\nPara obtener información detallada sobre los patrones válidos de URL, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSi esta lista está vacía o no se define, no se forzará la prioridad de primer plano para ningún contenido en segundo plano.";
ForceGoogleSafeSearch.pfm_title = "Forzar Google Búsqueda Segura";
ForceGoogleSafeSearch.pfm_description = "Si la política se habilita, Búsqueda Segura estará siempre activa en la Búsqueda de Google. Los usuarios no pueden cambiar esta opción.\n\nSi esta política se inhabilita o no se define, no se aplicará Búsqueda Segura en la Búsqueda de Google.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "Controla si se pueden inhabilitar los gestores de eventos unload.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "Los gestores de eventos unload van a dejar de estar disponibles. Permissions-Policy de unload determina si se activan o no. Actualmente, la política los permite de forma predeterminada. En el futuro, pasarán a desactivarse de forma predeterminada progresivamente, y los sitios deberán habilitarlos expresamente mediante los encabezados de Permissions-Policy. Esta política de empresa se puede usar para inhabilitar esta desactivación gradual al forzar que permanezcan habilitados de forma predeterminada.\n\nPuede que las páginas dependan de gestores de eventos unload para guardar datos o indicar el final de una sesión de usuario al servidor. Esto no es recomendable, ya que no es fiable y afecta al rendimiento al bloquear el uso de BackForwardCache. Hay alternativas recomendadas, pero se ha usado el evento unload durante mucho tiempo. Aun así, es posible que algunas aplicaciones puedan usarlas.\n\nSi se le asigna el valor false a esta política o no se define, los gestores de eventos unload dejarán de estar disponibles progresivamente de acuerdo con el lanzamiento de la desactivación, y los sitios que no tengan definido un encabezado de Permissions-Policy dejarán de activar eventos \"unload\".\n\nSi se le asigna el valor true a esta política, los gestores de eventos unload seguirán funcionando de forma predeterminada.\n\nNOTA: Esta política tenía un valor predeterminado true documentado de forma incorrecta en la versión M117. El evento \"unload\" no había cambiado ni cambiará en la versión M117, por lo que esta política no afecta a esa versión.\n";
ForceYouTubeRestrict.pfm_title = "Forzar el modo Restringido en YouTube como mínimo";
ForceYouTubeRestrict.pfm_description = "0 - No forzar el modo Restringido en YouTube\n1 - Implementar obligatoriamente como mínimo el modo Restringido moderado en YouTube\n2 - Implementar obligatoriamente el modo Restringido estricto en YouTube\nSi se define la política, se implementa obligatoriamente un modo Restringido mínimo en YouTube y se evita que los usuarios seleccionen un modo menos restringido. Cuando se asignan estos valores:\n\n* Estricto: el modo Restringido estricto siempre está activo en YouTube.\n\n* Moderado: el usuario solo puede seleccionar los modos Restringidos moderado y estricto en YouTube, pero no puede desactivar el modo Restringido.\n\n* Desactivado, o si no se define: Chrome no implementa obligatoriamente el modo Restringido en YouTube. Las políticas externas, como las de YouTube, pueden seguir implementando obligatoriamente el modo Restringido.";
ForcedLanguages.pfm_title = "Permite configurar el contenido y el orden de los idiomas preferidos";
ForcedLanguages.pfm_description = "Esta política permite a los administradores establecer el orden de los idiomas preferidos en la configuración de Brave.\n\nLa lista aparecerá en el mismo orden en la sección \"Ordena los idiomas según tus preferencias\" (en chrome://settings/languages). Los usuarios no podrán eliminar los idiomas establecidos por la política ni cambiar su orden, pero podrán añadir idiomas al final de la lista. Los usuarios tendrán el control total de los ajustes de traducción, del corrector ortográfico y del idioma de la interfaz del navegador, a menos que otras políticas los definan.\n\nSi no se establece esta política, los usuarios podrán gestionar la lista completa de idiomas preferidos.";
GeminiActOnWebAllowedForURLs.pfm_title = "Permitir que las integraciones de la aplicación Gemini actúen directamente en los sitios especificados";
GeminiActOnWebAllowedForURLs.pfm_description = "Permite definir una lista de patrones de URL que especifiquen en qué sitios las integraciones de la aplicación Gemini pueden actuar directamente en páginas web.\n\nLas URLs que no estén en la lista de permitidas ni en la de bloqueadas usarán GeminiActOnWebSettings.\n\nSe permiten las URLs que coincidan con la lista de permitidas y con la de bloqueadas.\n\nPara obtener información detallada sobre los patrones válidos de URL, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebBlockedForURLs.pfm_title = "Bloquear las integraciones de la aplicación Gemini para que no actúen directamente en los sitios especificados";
GeminiActOnWebBlockedForURLs.pfm_description = "Permite definir una lista de patrones de URL que especifiquen en qué sitios las integraciones de la aplicación Gemini no pueden actuar directamente en páginas web.\n\nLas URLs que no estén en la lista de permitidas ni en la de bloqueadas usarán GeminiActOnWebSettings.\n\nSe permiten las URLs que coincidan con la lista de permitidas y con la de bloqueadas.\n\nPara obtener información detallada sobre los patrones válidos de URL, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebSettings.pfm_title = "Permite que las integraciones de la aplicación Gemini actúen directamente en páginas web";
GeminiActOnWebSettings.pfm_description = "0 - Permite que la aplicación Gemini realice acciones en páginas web.\n1 - No permite que la aplicación Gemini realice acciones en páginas web.\nControla si la aplicación Gemini puede realizar acciones en las páginas web en nombre del usuario.\n\n0/sin definir = la aplicación Gemini puede realizar acciones en las páginas web.\n\n1 = la app Gemini no puede realizar acciones en las páginas web.\n\nEsta política no tiene efecto cuando la app Gemini está inhabilitada. Por ejemplo, la app Gemini se puede inhabilitar mediante la política GeminiSettings.\n\nPara obtener más información sobre Gemini en Chrome, accede a https://support.google.com/chrome/a/answer/16291696.\n\nLa activación de Gemini no está disponible en todos los países ni en todos los idiomas. Aunque se defina esta política, no se garantiza que la función se habilite, ya que sigue sujeta a disponibilidad. Para obtener más información sobre su lanzamiento, consulta las notas de la versión de Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=es";
GeminiSettings.pfm_title = "Ajustes de la integración de Gemini";
GeminiSettings.pfm_description = "0 - Permitir integraciones de Gemini.\n1 - No permitir integraciones de Gemini.\nEste ajuste permite las integraciones de la aplicación Gemini.\n\nSi se le asigna el valor 0, la integración de Gemini estará disponible para los usuarios.\n\nSi se le asigna el valor 1, la integración de Gemini no estará disponible para los usuarios.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nPara obtener más información, consulta el artículo del Centro de Ayuda https://support.google.com/chrome/a?p=gemini_in_chrome.";
GeminiSparkSettings.pfm_title = "Permite que Gemini Spark se conecte a Brave y use Navegación automática a través de Gemini en Chrome";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark tiene permiso para conectarse y usar la Navegación automática de Brave.\n1 - Gemini Spark no tiene permiso para conectarse ni usar la Navegación automática de Brave.\nControla si el agente Gemini Spark puede conectarse a Brave y usar la Navegación automática. Puede que Gemini Spark no esté disponible para tu organización.\n\n0 = Gemini Spark puede conectarse y usar la Navegación automática de Brave\n\n1 = Gemini Spark no puede conectarse ni usar la Navegación automática de Brave\n\nAdvertencia: Si permites que Gemini Spark se conecte a Brave y use Navegación automática, el agente Gemini Spark podrá realizar acciones autónomas de varios pasos en los clientes de Brave mediante la sesión de navegador activa. Esto conlleva riesgos de seguridad significativos, como riesgos de credenciales, entrada de red local y pérdida de señales contextuales. Puede que no se respeten los controles de gestión y seguridad actuales.\n\nSe recomienda a los administradores que evalúen cuidadosamente el modelo de amenazas de red, las directrices de cumplimiento y las directrices de privacidad de su organización antes de habilitar esta función.\n\nEsta política no tiene efecto cuando la aplicación Google Gemini o las políticas de Navegación automática de Brave están inhabilitadas. Por ejemplo, la aplicación Google Gemini se puede inhabilitar mediante la política GeminiSettings. Para obtener más información sobre Google Gemini en Brave, consulta https://support.google.com/chrome/a?p=gemini_in_chrome.\n\nGemini Spark y la Navegación automática de Brave no están disponibles en todos los países ni en todos los idiomas. Aunque se le asigne el valor 0 (Habilitado) a esta política, no se garantiza que la función se habilite, ya que sigue sujeta a disponibilidad. Para obtener más información sobre su lanzamiento, consulta las notas de la versión de Enterprise: https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Configuración del modelo fundacional local de IA generativa";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Descarga el modelo automáticamente\n1 - No descargar modelo\nConfigura cómo descarga Brave el modelo fundacional de IA generativa y lo usa para la inferencia de forma local.\n\nSi se permite esta política (valor 0) o no se define, el modelo se descargará automáticamente y se usará para la inferencia.\n\nSi se inhabilita esta política (valor 1), el modelo no se descargará y el modelo ya descargado (si lo hay) se eliminará.\n\nEn las plataformas de escritorio, también se puede inhabilitar la descarga del modelo asignando el valor false a ComponentUpdatesEnabled.";
GeolocationBlockedForUrls.pfm_title = "Bloquear geolocalización en estos sitios";
GeolocationBlockedForUrls.pfm_description = "Si se define esta política, podrás establecer una lista de patrones de URL que especifiquen qué sitios no pueden acceder a la geolocalización del usuario ni solicitarle permiso para hacerlo.\n\nSi no se define esta política, se aplicará DefaultGeolocationSetting a todos los sitios (si se ha definido). Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "Habilita la caché de autenticación de HTTP con alcance global";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Esta política configura una caché única global por perfil con credenciales de autenticación del servidor HTTP.\n\nSi esta política se inhabilita o no se define, el navegador utilizará el comportamiento predeterminado de autenticación entre sitios. Este comportamiento consistirá en definir el alcance de las credenciales de autenticación del servidor HTTP según el sitio de nivel superior, por lo que, si dos sitios web utilizan recursos del mismo dominio de autenticación, tendrán que facilitarse las credenciales de forma independiente en el contexto de ambos sitios. Las credenciales proxy almacenadas en caché se reutilizarán entre los sitios.\n\nSi se habilita esta política, las credenciales de autenticación de HTTP que se introduzcan en el contexto de un sitio se utilizarán automáticamente en el contexto de otro.\n\nAl habilitar esta política, los sitios quedan expuestos a algunos tipos de ataques entre sitios y se permite que los usuarios sean rastreados entre sitios, incluso sin cookies, añadiendo entradas a la caché de autenticación de HTTP utilizando credenciales insertadas en URLs.\n\nEl objetivo de esta política es ofrecer a las empresas que dependen de un comportamiento antiguo la oportunidad de actualizar sus procedimientos de inicio de sesión. Esta política se eliminará en el futuro.";
GoogleSearchSidePanelEnabled.pfm_title = "Habilitar Google Search Side Panel";
GoogleSearchSidePanelEnabled.pfm_description = "Si se habilita o no se le asigna ningún valor, Google Search Side Panel se permitirá en todas las páginas web.\n\nSi se inhabilita, Google Search Side Panel no estará disponible en ninguna página web.\n\nLas capacidades de IA generativa que forman parte de esta función no están disponibles en cuentas de centros educativos ni de empresas.";
HSTSPolicyBypassList.pfm_title = "Lista de nombres que omitirán la comprobación de la política de HSTS";
HSTSPolicyBypassList.pfm_description = "Si se establece la política, se especifica una lista de nombres de host que evita las actualizaciones de HSTS precargadas (de http a https).\n\nEn esta política, solo se permiten nombres de host de una sola etiqueta. Esta política solo se aplica a entradas estáticas precargadas por HSTS (por ejemplo, \"app\", \"new\", \"search\", \"play\"). Esta política no evita las actualizaciones de HSTS en el caso de los servidores que hayan solicitado dinámicamente actualizaciones de HSTS usando un encabezado de respuesta Strict-Transport-Security.\n\nLos nombres de host especificados deben canonicalizarse, es decir, cada IDN debe convertirse a su formato de etiqueta A, y todas las letras ASCII deben ser minúsculas. Esta política solo se aplica a los nombres de host de una sola etiqueta incluidos en la lista, no a sus subdominios.";
HappyEyeballsV3Enabled.pfm_title = "Usar el algoritmo Happy Eyeballs V3";
HappyEyeballsV3Enabled.pfm_description = "Esta función permite que el algoritmo Happy Eyeballs V3 intente conectarse. Consulta https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3 para obtener más información.\n\nSi se habilita esta política, Brave usará el algoritmo Happy Eyeballs V3 para los intentos de conexión.\n\nSi se inhabilita esta política, se desactivará el algoritmo Happy Eyeballs V3.\n\nSi no se define la política, Brave activará o desactivará el algoritmo Happy Eyeballs V3 en función de chrome://flags/#happy-eyeballs-v3.\n\nEsta política admite la actualización dinámica.\n\nEsta política es una medida temporal y se eliminará en futuras versiones de Brave.";
HardwareAccelerationModeEnabled.pfm_title = "Usar la aceleración de gráficos cuando esté disponible";
HardwareAccelerationModeEnabled.pfm_description = "Si se habilita esta política o no se le asigna ningún valor, se activará la aceleración de gráficos en caso de que esté disponible.\n\nSi se inhabilita esta política, se desactivará la aceleración de gráficos.";
HeadlessMode.pfm_title = "Controla el uso del modo sin interfaz gráfica";
HeadlessMode.pfm_description = "1 - Permite el uso del modo sin interfaz gráfica\n2 - No permite utilizar el modo sin interfaz gráfica\nSi a esta política se le asigna el valor Enabled o no se le asigna ninguno, se podrá utilizar el modo sin interfaz gráfica. Si se le asigna el valor Disabled, no se podrá utilizar el modo sin interfaz gráfica.";
HelpMeWriteSettings.pfm_title = "Ajustes de Ayúdame a escribir";
HelpMeWriteSettings.pfm_description = "0 - Permitir la función Ayúdame a escribir y mejorar los modelos de IA.\n1 - Permitir la función Ayúdame a escribir sin mejorar los modelos de IA.\n2 - No permitir la función Ayúdame a escribir.\nAyúdame a escribir es un asistente de escritura basado en IA para contenido breve en la Web. El contenido sugerido se basa en las peticiones que introduce el usuario y en el contenido de la página web.\n\nSi se asigna el valor 0, permite que se use la función y que Google utilice datos relevantes para mejorar sus modelos de IA. Según la función, los datos pertinentes pueden ser peticiones, entradas, resultados, materiales de origen y comentarios escritos. También es posible que los revisen un equipo de personas para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los casos indicados abajo.\n\nSi se asigna el valor 1, permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (incluyendo peticiones, entradas, resultados, materiales de origen y comentarios escritos). 1 es el valor predeterminado de los usuarios de empresa que se gestionan en la Google Admin console y de las cuentas de centro educativo que se gestionan en Google Workspace.\n\nSi se asigna el valor 2, no se permite la función.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
HideWebStoreIcon.pfm_title = "Oculta tienda web en página Nueva pestaña y en menú de aplicaciones";
HideWebStoreIcon.pfm_description = "Permite ocultar la aplicación Chrome Web Store y el enlace de la parte inferior de la página en la página Nueva pestaña y en el menú de aplicaciones de Google Chrome OS.\n\nCuando se establece el valor true en esta política, se ocultan los iconos.\n\nCuando se establece el valor false o no se configura la política, aparecen los iconos.";
HighEfficiencyModeEnabled.pfm_title = "Habilitar el modo Alta eficiencia";
HighEfficiencyModeEnabled.pfm_description = "Esta política habilita o inhabilita la configuración del modo Alta eficiencia. Este ajuste hace que las pestañas se cierren tras un periodo de tiempo en segundo plano para recuperar la memoria.\nSi no se establece esta política, el usuario final podrá controlar la configuración en chrome://settings/performance.\n";
HistoryClustersVisible.pfm_title = "Mostrar una vista del historial de Chrome con grupos de páginas";
HistoryClustersVisible.pfm_description = "Esta política controla la visibilidad de la página del historial de Chrome organizada en grupos de páginas.\n\nSi se habilita esta política, se mostrará la página del historial de Chrome organizada en grupos en chrome://history/grouped.\n\nSi se inhabilita esta política, no se mostrará la página del historial de Chrome organizada en grupos en chrome://history/grouped.\n\nSi no se establece esta política, se mostrará la página del historial de Chrome organizada en grupos en chrome://history/grouped de forma predeterminada.\n\nTen en cuenta que, si la política ComponentUpdatesEnabled se inhabilita y HistoryClustersVisible se habilita o no se establece, la página del historial de Chrome organizada en grupos seguirá estando disponible en chrome://history/grouped, pero puede que sea menos relevante para el usuario.\n";
HistorySearchSettings.pfm_title = "Configuración de la búsqueda en el historial basada en IA";
HistorySearchSettings.pfm_description = "0 - Permitir la búsqueda en el historial basada en IA y mejorar los modelos de IA.\n1 - Permitir la búsqueda en el historial basada en IA sin mejorar los modelos de IA\n2 - No permitir la búsqueda en el historial basada en IA.\nLa búsqueda en el historial basada en IA es una función que permite a los usuarios buscar en su historial de navegación y recibir respuestas generadas en función del contenido de las páginas, no solo de su título y URL.\n\nSi se asigna el valor 0, permite que se use la función y que Google utilice datos relevantes para mejorar sus modelos de IA. Según la función, los datos pertinentes pueden ser peticiones, entradas, resultados, materiales de origen y comentarios escritos. También es posible que los revisen un equipo de personas para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los casos indicados abajo.\n\nSi se asigna el valor 1, permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (incluyendo peticiones, entradas, resultados, materiales de origen y comentarios escritos). 1 es el valor predeterminado de los usuarios de empresa que se gestionan en la Google Admin console y de las cuentas de centro educativo que se gestionan en Google Workspace.\n\nSi se asigna el valor 2, no se permite la función.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
HomepageIsNewTabPage.pfm_title = "Utilizar página Nueva pestaña como página principal";
HomepageIsNewTabPage.pfm_description = "Si se habilita esta política, se establecerá la página Nueva pestaña como la página principal del usuario, independientemente de la ubicación de la URL de la página principal. Si se inhabilita esta política, la página principal del usuario nunca será la página Nueva pestaña, a menos que se defina chrome://newtab como la URL de su página principal.\n\nSi se define esta política, los usuarios no podrán cambiar su tipo de página principal en Brave. Si no se define, los usuarios podrán elegir si quieren establecer la página Nueva pestaña como su página principal.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
HomepageLocation.pfm_title = "URL de la página de inicio";
HomepageLocation.pfm_description = "Si se define esta política, se establecerá la URL de página principal de Brave. La página principal se abre con el botón de página principal. En ordenadores, las políticas RestoreOnStartup controlan las páginas que se abren al iniciar el navegador.\n\nSi el usuario o HomepageIsNewTabPage establecen la página Nueva pestaña como página principal, esta política no tendrá efecto.\n\nLa URL debe tener una estructura estándar, como http://example.com o https://example.com. Si se define esta política, los usuarios no podrán cambiar la URL de su página principal en Brave.\n\nSi no se definen HomepageLocation ni HomepageIsNewTabPage, los usuarios podrán elegir su página principal.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
HttpAllowlist.pfm_title = "Lista de URLs de HTTP permitidas";
HttpAllowlist.pfm_description = "Si se define esta política, se especificará una lista o patrones de nombre de host (como \"'[*.]example.com\") que no se actualizarán a HTTPS. Si el modo Solo HTTPS está habilitado, no se mostrará un intersticial de error. Las organizaciones pueden usar esta política para mantener el acceso a los servidores que no admiten HTTPS sin necesidad de inhabilitar las actualizaciones a HTTPS ni el modo Solo HTTPS.\n\nLos nombres de host especificados deben canonicalizarse, es decir, cada IDN debe convertirse a su formato de etiqueta A, y todas las letras ASCII deben ser minúsculas.\n\nNo se admiten comodines de host generales (por ejemplo, \"*\" ni \"[*]\"). En su lugar, el modo Solo HTTPS y las actualizaciones a HTTPS deben inhabilitarse explícitamente a través de sus políticas específicas.\n\nNota: Esta política no se aplica a las actualizaciones de HSTS.";
HttpHeaderInjection.pfm_title = "Configurar la inyección de encabezados HTTP para patrones de URL específicos";
HttpHeaderInjection.pfm_description = "Esta política permite definir una lista de reglas para inyectar encabezados HTTP personalizados en las solicitudes web que coincidan con patrones de URL específicos. Los encabezados definidos por esta política tienen prioridad sobre los que estaban presentes inicialmente en la solicitud, así como sobre las modificaciones que intenten hacer los usuarios o las extensiones.\n\nUn caso práctico habitual de esta política es aplicar obligatoriamente controles de acceso de cliente inyectando encabezados personalizados (por ejemplo, X-Tenant-ID).\n\nLa política acepta una lista de reglas. Cada regla contiene:\n\n* patterns: una lista de patrones de URL con los que se debe coincidir. Consulta cómo aplicar formato a un patrón de URL (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\n* headers: una lista de objetos que representan los encabezados que se van a inyectar. Cada uno de ellos contiene lo siguiente:\n\n* name: el nombre del encabezado que se va a inyectar.\n\n* value: el valor del encabezado que se va a inyectar.\n\nSi varias reglas coinciden con una solicitud, se aplicarán los encabezados de todas las reglas que coincidan. Si hay varios encabezados con el mismo nombre, se aplicará el que tenga el patrón de URL más específico. Si los patrones son igual de específicos, se aplicará el que aparezca en último lugar en la lista.\n\nLos nombres de encabezado deben cumplir el protocolo RFC 2616 (https://www.rfc-editor.org/rfc/rfc2616). Los valores de encabezado no deben contener símbolos NUL, CR ni LF. Los encabezados individuales no deben superar los 8 KB de tamaño. Los encabezados y patrones de URL no válidos se ignorarán.\n\nEsta política está limitada a un total de 500 patrones de URL en todas las reglas. Cada regla puede contener un máximo de 20 encabezados. Los patrones y encabezados que superen estos umbrales se ignorarán.\n\nNota: Si un patrón de URL coincide con esquemas no cifrados (http://, ws:// o cuando se omite el esquema), los encabezados configurados pueden transmitirse en texto sin formato a través de un canal no cifrado y pueden quedar expuestos a observadores de la red. Para proteger los valores de encabezado sensibles o identificativos, restringe los patrones de URL a esquemas cifrados (https:// o wss://).\nConsulta la página https://chromeenterprise.google/policies/?policy=HttpHeaderInjection para obtener más información sobre el esquema y el formato.";
HttpsOnlyMode.pfm_title = "Permitir que se habilite el modo Solo HTTPS";
HttpsOnlyMode.pfm_description = "allowed - No restringir el ajuste del modo Solo HTTPS de los usuarios\ndisallowed - Inhabilitar el modo Solo HTTPS\nforce_enabled - Habilitar el modo Solo HTTPS en el modo Estricto\nforce_balanced_enabled - Habilitar el modo Solo HTTPS en el modo Equilibrado\nEsta política controla si los usuarios pueden habilitar el modo Solo HTTPS (Usar siempre conexiones seguras) en Configuración. El modo Solo HTTPS cambia todos los accesos a páginas al protocolo HTTPS.\n\nSi esta opción no se establece o se le asigna el valor allowed, los usuarios podrán habilitar el modo Solo HTTPS.\n\nSi se le asigna el valor disallowed, se inhabilitará el modo Solo HTTPS.\n\nSi se le asigna el valor force_enabled, se habilitará el modo Solo HTTPS en el modo Estricto.\n\nSi se le asigna el valor force_balanced_enabled, se habilitará el modo Solo HTTPS en el modo Equilibrado.\n\nEl valor force_enabled se admite a partir de la versión M112. El valor force_balanced_enabled se admite a partir de la versión M129.\n\nforce_enabled y force_balanced_enabled también se pueden recomendar a los usuarios.\nEl modo Solo HTTPS se definirá como Estricto o Equilibrado inicialmente, pero los usuarios podrán cambiarlo.\n\nSi se asigna a esta política un valor incompatible con la versión de Chrome que reciba la política, Chrome usará de forma predeterminada el valor permitido.\n\nLa política independiente HttpAllowlist puede usarse para impedir que esta función cambie a HTTPS algunos nombres de host o patrones de nombre de host concretos.";
HttpsUpgradesEnabled.pfm_title = "Habilitar los cambios automáticos a HTTPS";
HttpsUpgradesEnabled.pfm_description = "Brave intentará cambiar de HTTP a HTTPS algunos accesos a páginas cuando sea posible. Esta política se puede usar para inhabilitar este comportamiento. Si se le asigna el valor \"true\" o no se le asigna ningún valor, esta función se habilitará de forma predeterminada.\n\nLa política independiente HttpAllowlist puede usarse para impedir que esta función cambie a HTTPS algunos nombres de host o patrones de nombre de host concretos.\n\nConsulta también la política HttpsOnlyMode.";
IPv6ReachabilityOverrideEnabled.pfm_title = "Habilitar la anulación de la comprobación de alcanzabilidad de IPv6";
IPv6ReachabilityOverrideEnabled.pfm_description = "Si se asigna el valor true a esta política, se anulará la comprobación de alcanzabilidad de IPv6. Esto significa que el sistema siempre consultará los registros AAAA al resolver nombres de host. Este ajuste se aplicará a todos los usuarios e interfaces del dispositivo.\n\nSi se asigna el valor false a esta política o no se define, no se anulará la comprobación de alcanzabilidad de IPv6.\nEl sistema solo consultará los registros AAAA cuando sea alcanzable para un host IPv6 global.";
IdleDetectionAllowedForUrls.pfm_title = "Sitios con la detección de inactividad permitida";
IdleDetectionAllowedForUrls.pfm_description = "Permite definir una lista de patrones de URL que especifiquen los sitios que pueden usar la API Idle Detection sin pedir permiso al usuario. Las entradas de la lista de bloqueadas tienen más prioridad que las de la lista de permitidas, que a su vez tienen más prioridad que el valor predeterminado configurado.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.\n\nSi no se establece esta política, se usará en todos los sitios el valor predeterminado global especificado en la política DefaultIdleDetectionSetting (configuración predeterminada de detección de inactividad) si se ha definido o, en caso contrario, en la configuración personal del usuario.";
IdleDetectionBlockedForUrls.pfm_title = "Sitios con la detección de inactividad bloqueada";
IdleDetectionBlockedForUrls.pfm_description = "Permite crear una lista de patrones de URL que especifiquen los sitios que no pueden usar la API Idle Detection.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.\n\nSi no se establece esta política, se usará en todos los sitios el valor predeterminado global especificado en la política DefaultIdleDetectionSetting (configuración predeterminada de detección de inactividad) si se ha definido o, en caso contrario, en la configuración personal del usuario.";
IdleTimeout.pfm_title = "Retraso antes de ejecutar acciones por inactividad";
IdleTimeout.pfm_description = "Activa una acción cuando el ordenador está inactivo.\n\nSi se establece, esta política especifica el tiempo (en minutos) que debe transcurrir sin ninguna entrada del usuario antes de que el navegador ejecute las acciones configuradas a través de la política IdleTimeoutActions.\n\nSi no se establece esta política, no se ejecutará ninguna acción.\n\nEl umbral mínimo es 1 minuto.\n\nLas APIs del sistema operativo definen qué es una \"entrada del usuario\" (por ejemplo, mover el ratón o escribir con el teclado).";
IdleTimeoutActions.pfm_title = "Acciones que se ejecutarán cuando el ordenador esté inactivo";
IdleTimeoutActions.pfm_description = "close_browsers - Cerrar navegadores\nshow_profile_picker - Mostrar selector de perfil\nclear_browsing_history - Borrar historial de navegación\nclear_download_history - Borrar historial de descargas\nclear_cookies_and_other_site_data - Borrar cookies y otros datos de sitios\nclear_cached_images_and_files - Borrar archivos e imágenes almacenados en caché\nclear_password_signin - Borrar datos de inicio de sesión con contraseña\nclear_autofill - Borrar datos de Autocompletar\nclear_site_settings - Borrar configuración de sitios\nclear_hosted_app_data - Borrar datos de aplicaciones alojadas\nreload_pages - Volver a cargar páginas\nsign_out - Cerrar sesión\nclose_tabs - Cerrar pestañas\nLista de acciones que se ejecutarán cuando se agote el tiempo de espera de la política IdleTimeout.\n\nAdvertencia: Si se establece esta política, los datos personales locales pueden verse afectados y eliminarse de forma permanente. Te recomendamos probar la configuración antes de implementarla para evitar la eliminación accidental de datos personales.\n\nEsta política no tendrá efecto si no se define la política IdleTimeout.\n\nCuando se agote el tiempo de espera de la política IdleTimeout, el navegador ejecutará las acciones configuradas en esta política.\n\nSi esta política se deja vacía o no se establece, la política IdleTimeout no tendrá efecto.\n\nEstas son las acciones que se pueden realizar:\n\nclose_browsers: cierra todas las ventanas del navegador y PWAs de este perfil. No se admite en Android ni en iOS.\n\nclose_tabs: cierra todas las pestañas abiertas en las ventanas abiertas. Solo se admite en iOS.\n\nshow_profile_picker: muestra la ventana del selector de perfil. No se admite en Android ni en iOS.\n\nsign_out: cierra la sesión del usuario que tiene la sesión iniciada. Solo se admite en iOS.\n\nclear_browsing_history, clear_download_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing, clear_autofill, clear_site_settings y clear_hosted_app_data: borran los datos de navegación correspondientes. Consulta la política ClearBrowsingDataOnExitList para obtener más información. Los tipos admitidos en iOS son clear_browsing_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing y clear_autofill\n\nreload_pages: vuelve a cargar todas las páginas web. En algunas páginas, es posible que primero se solicite la confirmación del usuario. No se admite en iOS.\n\nEl usuario seguirá teniendo la sesión iniciada en su cuenta de Google al eliminar las cookies con clear_cookies_and_other_site_data.\n\nSi se asignan los valores clear_browsing_history, clear_password_signing, clear_autofill y clear_site_settings, se inhabilitará la sincronización de los tipos de datos correspondientes si no se define la política SyncDisabled para inhabilitar Chrome Sync ni tampoco se inhabilita BrowserSignin.";
ImagesAllowedForUrls.pfm_title = "Permitir imágenes en estos sitios";
ImagesAllowedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios podrían mostrar imágenes.\n\nSi no se establece la política, DefaultImagesSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\nTen en cuenta que esta política se habilitó anteriormente en Android por error, pero la función nunca ha sido totalmente compatible con Android.";
ImagesBlockedForUrls.pfm_title = "Bloquear imágenes en estos sitios web";
ImagesBlockedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios no pueden mostrar imágenes.\n\nSi no se establece la política, DefaultImagesSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\n Para obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\n Ten en cuenta que esta política se habilitó anteriormente en Android por error, pero la función nunca ha sido totalmente compatible con Android.";
ImportAutofillFormData.pfm_title = "Importar los datos autocompletados del navegador predeterminado en la primera ejecución";
ImportAutofillFormData.pfm_description = "Si se asigna el valor \"Habilitada\" a esta política, se importarán los datos de formularios para la función Autocompletar del navegador predeterminado anterior al ejecutarse por primera vez. Si se le asigna el valor \"Inhabilitada\" o no se le asigna ninguno, no se importarán estos datos al ejecutarse por primera vez.\n\nLos usuarios pueden abrir un cuadro de diálogo de importación y la casilla de datos de formularios para la función Autocompletar aparecerá marcada o desmarcada en función del valor de esta política.";
ImportBookmarks.pfm_title = "Importa los marcadores desde el navegador predeterminado en la primera ejecución.";
ImportBookmarks.pfm_description = "Si se asigna el valor \"Habilitada\" a esta política, se importarán los marcadores del navegador predeterminado anterior al ejecutarse por primera vez. Si se le asigna el valor \"Inhabilitada\" o no se le asigna ninguno, no se importará ningún marcador al ejecutarse por primera vez.\n\nLos usuarios pueden abrir un cuadro de diálogo de importación y la casilla de marcadores aparecerá marcada o desmarcada en función del valor de esta política.";
ImportHistory.pfm_title = "Importar el historial de navegación desde el navegador predeterminado en la primera ejecución";
ImportHistory.pfm_description = "Si se asigna el valor \"Habilitada\" a esta política, se importará el historial de navegación del navegador predeterminado anterior al ejecutarse por primera vez. Si se le asigna el valor \"Inhabilitada\" o no se le asigna ninguno, no se importará el historial de navegación al ejecutarse por primera vez.\n\nLos usuarios pueden abrir un cuadro de diálogo de importación y la casilla del historial de navegación aparecerá marcada o desmarcada en función del valor de esta política.";
ImportHomepage.pfm_title = "Importar la página de inicio desde el navegador predeterminado en la primera ejecución";
ImportHomepage.pfm_description = "Si se asigna el valor \"Habilitada\" a esta política, se importará la página principal del navegador predeterminado anterior al ejecutarse por primera vez. Si se le asigna el valor \"Deshabilitada\" o no se le asigna ninguno, no se importará la página principal al ejecutarse por primera vez.\n\nLos usuarios pueden abrir un cuadro de diálogo de importación y la casilla de la página principal aparecerá marcada o desmarcada en función del valor de esta política.";
ImportSavedPasswords.pfm_title = "Importar las contraseñas guardadas desde el navegador predeterminado en la primera ejecución";
ImportSavedPasswords.pfm_description = "Esta política solo controla el comportamiento de importación al ejecutar el navegador por primera vez después de instalarlo. Permite una transición más fluida a Brave en entornos donde se ha usado mucho otro navegador antes de instalarlo. Esta política no afecta a las funciones del gestor de contraseñas en las cuentas de Google.\n\nSi se habilita esta política, se importarán las contraseñas guardadas del navegador predeterminado anterior al ejecutar el nuevo navegador por primera vez. También se podrán importar manualmente desde la página de configuración.\nSi se inhabilita esta política, no se importará ninguna contraseña guardada al ejecutar el nuevo navegador por primera vez y no se podrán importar manualmente desde la página de configuración.\nSi la política no se define, no se importará ninguna contraseña guardada al ejecutar el nuevo navegador por primera vez, pero el usuario podrá hacerlo desde la página de configuración.";
ImportSearchEngine.pfm_title = "Importa los motores de búsqueda desde el navegador predeterminado en la primera ejecución.";
ImportSearchEngine.pfm_description = "Si se asigna el valor \"Habilitada\" a esta política, se importará el buscador predeterminado del anterior navegador predeterminado al ejecutarse por primera vez. Si se le asigna el valor \"Inhabilitada\" o no se le asigna ninguno, no se importará el buscador predeterminado al ejecutarse por primera vez.\n\nLos usuarios pueden abrir un cuadro de diálogo de importación y la casilla del buscador predeterminado aparecerá marcada o desmarcada en función del valor de esta política.";
IncognitoModeAvailability.pfm_title = "Disponibilidad del modo Incógnito";
IncognitoModeAvailability.pfm_description = "0 - Modo Incógnito disponible\n1 - Modo Incógnito inhabilitado\n2 - Modo Incógnito forzado\nEspecifica si el usuario podrá abrir páginas en modo Incógnito en Brave.\n\nSi se habilita esta política o no se establece ningún valor, se podrán abrir páginas en modo Incógnito.\n\nSi se deshabilita, no se podrán abrir páginas en modo Incógnito.\n\nSi se fuerza, solo se podrán abrir páginas en modo Incógnito. Ten en cuenta que forzar esta política no funciona en dispositivos con Android en Chrome.\n\nLa política IncognitoModeUrlAllowlist tiene prioridad sobre esta política y puede volver a habilitar el modo Incógnito en URLs específicas. Cuando esta política inhabilita el modo Incógnito y se proporciona una lista de permitidas, el modo Incógnito solo está disponible en las URLs incluidas en la lista de permitidas, mientras que todas las demás páginas se bloquean.\n\nNota: En iOS, si se cambia esta política durante una sesión, los cambios se aplicarán después de reiniciar.";
IncognitoModeUrlAllowlist.pfm_title = "Permite el acceso a una lista de URLs en modo Incógnito.";
IncognitoModeUrlAllowlist.pfm_description = "Si se define esta política, se permite acceder en modo Incógnito a las URLs incluidas en la lista. Úsala para permitir excepciones de determinados patrones de URL definidos en IncognitoModeUrlBlocklist, con el formato especificado en https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSi se definen tanto esta política como IncognitoModeUrlBlocklist, la lista de permitidas tendrá prioridad. Si una URL coincide con un patrón de la lista de permitidas, se permitirá. Si coincide con un patrón de la lista de bloqueadas (pero no con la lista de permitidas), se bloqueará. Si una URL no coincide con ninguna de las dos, se usarán las políticas generales URLBlocklist o URLAllowlist como alternativa.\n\nSi se define esta política y no se define IncognitoModeUrlBlocklist, se bloquearán todas las URLs que no estén incluidas en la lista de permitidas en el modo Incógnito.\n\nSi se define la política IncognitoModeAvailability para no permitirlo (valor 1), pero se configura esta política, el modo Incógnito solo estará disponible para las URLs que estén incluidas en la lista de permitidas.\n\nSi no se define esta política, no se permitirán excepciones de IncognitoModeUrlBlocklist ni de IncognitoModeAvailability.\n\nEsta política solo afecta al modo Incógnito. Para permitir URLs en todos los perfiles de usuario, usa la política URLAllowlist.\n\nNo se admiten comodines de host generales (por ejemplo, \"*\" ni \"[*]\"). Usa la política IncognitoModeAvailability para habilitar la función de forma global.\n\nEsta política está limitada a 1000 entradas.";
IncognitoModeUrlBlocklist.pfm_title = "Bloquea el acceso a una lista de URLs en modo Incógnito.";
IncognitoModeUrlBlocklist.pfm_description = "Si se define la política IncognitoModeUrlBlocklist, se impedirá que se carguen las páginas web con URLs prohibidas en modo Incógnito. Los administradores pueden especificar una lista con patrones de URL que quieran bloquear. Consulta cómo aplicar formato a un patrón de URL (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nSi se definen tanto esta política como la política IncognitoModeUrlAllowlist, la lista de permitidas tendrá prioridad. Si una URL coincide con un patrón de la lista de permitidas, se permitirá. Si coincide con un patrón de la lista de bloqueadas, pero no con la lista de permitidas, se bloqueará. Si una URL no coincide con ninguna de las dos, se usarán las políticas generales URLBlocklist o URLAllowlist como alternativa.\n\nSi esta política no se define y se define la política IncognitoModeUrlAllowlist, se bloquearán todas las URLs que no estén incluidas en la lista de permitidas en el modo Incógnito.\n\nSi se define la política IncognitoModeAvailability para no permitirlo (valor 1), pero se configura la política IncognitoModeUrlAllowlist, el modo Incógnito solo estará disponible para las URLs que estén incluidas en la lista de permitidas.\n\nEsta política solo afecta al modo Incógnito. Para bloquear URLs en todos los perfiles de usuario, usa la política URLBlocklist.\n\nEsta política está limitada a 1000 entradas.";
InsecureContentAllowedForUrls.pfm_title = "Permite el contenido no seguro en estos sitios web";
InsecureContentAllowedForUrls.pfm_description = "Permite crear una lista de patrones de URL donde se especifique qué sitios pueden mostrar contenido mixto (es decir, contenido HTTP en sitios HTTPS) bloqueable (es decir, activo), y para qué contenido mixto opcionalmente bloqueable se inhabilitarán las actualizaciones.\n\nSi no se establece esta política, el contenido mixto bloqueable se bloqueará y el contenido mixto opcionalmente bloqueable se actualizará, y los usuarios podrán establecer excepciones para permitir este contenido en sitios concretos.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
InsecureContentBlockedForUrls.pfm_title = "Permite bloquear el contenido no seguro en estos sitios web";
InsecureContentBlockedForUrls.pfm_description = "Permite crear una lista de patrones de URL donde se especifique qué sitios no pueden mostrar contenido mixto (es decir, contenido HTTP en sitios HTTPS) bloqueable (es decir, activo), y qué contenido mixto opcionalmente bloqueable (es decir, pasivo) se actualizará.\n\nSi no se establece esta política, el contenido mixto bloqueable se bloqueará y el contenido mixto opcionalmente bloqueable se actualizará, pero los usuarios podrán establecer excepciones para permitir este contenido en sitios concretos.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
IntensiveWakeUpThrottlingEnabled.pfm_title = "Controlar la función IntensiveWakeUpThrottling.";
IntensiveWakeUpThrottlingEnabled.pfm_description = "Cuando se habilita, la función IntensiveWakeUpThrottling hace que los temporizadores de JavaScript de las pestañas que están en segundo plano se limiten considerablemente y se fusionen. Se ejecutan como máximo una vez por minuto después de que una página haya estado en segundo plano durante 5 minutos o más.\n\n Esta función cumple los estándares web, pero es posible que afecte a la funcionalidad\n de algunos sitios web al causar que determinadas acciones se retrasen hasta un\n minuto. Sin embargo, cuando se habilita se consigue un ahorro de batería y de CPU\n significativo. Consulta https://bit.ly/30b1XR4 para obtener más información.\n\n Si se habilita esta política, se habilitará la función de forma forzosa y\nlos usuarios no podrán anular esa acción.\n\n Si se inhabilita, entonces la función se inhabilitará de forma forzosa y\n los usuarios no podrán anular esa acción.\n\n Si no se define esta política, la función la controlará su\n propia lógica interna y los usuarios podrán configurarla manualmente.\n\n Ten en cuenta que la política se aplica por proceso de renderizado, aplicando el valor\n de configuración de política más reciente que esté en vigor al empezar un proceso de renderizado. Es necesario\n un reinicio completo para asegurar que todas las pestañas que están cargadas reciben una configuración\n de política coherente. Ejecutar los procesos con diferentes valores de esta política no les afecta\n de forma negativa.\n";
IntranetRedirectBehavior.pfm_title = "Comportamiento de redirección de una intranet";
IntranetRedirectBehavior.pfm_description = "0 - Usar el comportamiento predeterminado del navegador.\n1 - Inhabilitar las comprobaciones de interceptación de DNS y las barras de información aclaratorias \"http://intranetsite/\".\n2 - Inhabilitar las comprobaciones de interceptación de DNS y permitir las barras de información aclaratorias \"http://intranetsite/\".\n3 - Permitir las comprobaciones de interceptación de DNS y las barras de información aclaratorias \"http://intranetsite/\".\nEsta política configura el comportamiento de la redirección de una intranet mediante comprobaciones de interceptación de DNS. Con las comprobaciones, se intenta averiguar si el navegador está detrás de un proxy que redirige nombres de host desconocidos.\n\nSi no se define esta política, el navegador usará el comportamiento predeterminado de las comprobaciones de interceptación de DNS y las sugerencias de redirección de una intranet. Estas opciones están habilitadas por defecto en la versión M88, pero se inhabilitarán de forma predeterminada en la siguiente versión.\n\nDNSInterceptionChecksEnabled es una política relacionada que también puede inhabilitar las comprobaciones de interceptación de DNS. Se trata de una versión más flexible que puede controlar las barras de información de redirección de una intranet de forma independiente, y es posible que se amplíe más adelante.\nLas comprobaciones de interceptaciones se inhabilitarán si lo solicitan DNSInterceptionChecksEnabled o esta política.";
IsolateOrigins.pfm_title = "Habilitar el aislamiento de sitios web específicos";
IsolateOrigins.pfm_description = "Especifica una lista de orígenes que se ejecutan en un proceso dedicado.\n\nEn Android, esta política solo funciona en dispositivos con suficiente memoria (más de 3,2 GB de RAM), ya que aislar demasiados sitios en dispositivos con recursos limitados puede causar problemas de rendimiento. En el caso de los dispositivos Android con recursos limitados, usa IsolateOriginsShortlist.\n\nNo se recomienda configurar el aislamiento de procesos específicamente en dispositivos con menos de 1 GB de memoria.\n\nEl proceso de cada origen especificado solo podrá contener documentos de ese origen y de sus subdominios. Por ejemplo, si se especifica https://a1.example.com/, se permite https://a2.a1.example.com/ en el mismo proceso, pero no https://example.com o https://b.example.com.\n\nDesde Brave 77, también puedes especificar un rango de orígenes para aislar usando un comodín. Por ejemplo, al especificar https://[*.]corp.example.com, se otorgará a cada origen inferior a https://corp.example.com su propio proceso dedicado, incluidos https://corp.example.com, https://a1.corp.example.com y https://a2.a1.corp.example.com.\n\nTen en cuenta que todos los sitios (es decir, el esquema más el eTLD+1, como https://example.com) ya están aislados de forma predeterminada en las versiones para ordenador, tal y como se indica en la política SitePerProcess. Esta política IsolateOrigins ayuda a aislar orígenes específicos con una mayor granularidad (por ejemplo, https://a.example.com).\n\nTen en cuenta que Android aísla algunos sitios sensibles de forma predeterminada a partir de la versión 77 de Brave. Además, esta política amplía el modo para aislar orígenes adicionales específicos.\n\nTen en cuenta también que los orígenes aislados por esta política no podrán usar secuencias de comandos de otros orígenes en el mismo sitio. Esto es posible, sin embargo, si dos documentos del mismo sitio modifican sus valores de \"document.domain\" para que coincidan. Los administradores deben confirmar que no se usa este comportamiento inusual en un origen antes de aislarlo.\n\nSi se le asigna una cadena vacía o no se le asigna ningún valor, no se requerirá el aislamiento de sitio web para ningún origen específico. Si lo desean, los usuarios podrán activar el aislamiento de procesos de forma manual a través de la marca de línea de comandos.";
JavaScriptAllowedForUrls.pfm_title = "Permitir JavaScript en estos sitios";
JavaScriptAllowedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios pueden ejecutar JavaScript.\n\nSi no se establece la política, DefaultJavaScriptSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
JavaScriptBlockedForUrls.pfm_title = "Bloquear JavaScript en estos sitios";
JavaScriptBlockedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios no pueden ejecutar JavaScript.\n\nSi no se establece la política, DefaultJavaScriptSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\nTen en cuenta que esta política bloquea JavaScript en función de si el origen del documento de nivel superior (normalmente, la URL de la página que también aparece en la barra de direcciones) coincide con alguno de los patrones. Por lo tanto, esta política no es adecuada para mitigar los ataques de la cadena de suministro web. Por ejemplo, si se proporciona el patrón \"https://[*.]foo.com/\", no se impedirá que una página alojada en https://example.com ejecute un script cargada desde https://www.foo.com/example.js. Además, si se proporciona el patrón \"https://example.com/\", no se evitará que un documento de https://example.com ejecute secuencias de comandos si no es el documento de nivel superior, sino que se inserta como submarco en una página alojada en otro origen, como https://www.bar.com.";
JavaScriptJitAllowedForSites.pfm_title = "Permitir que JavaScript use JIT en estos sitios";
JavaScriptJitAllowedForSites.pfm_description = "Te permite definir una lista con patrones de URL de sitios donde se especifique qué sitios pueden ejecutar JavaScript con un compilador justo a tiempo (JIT) habilitado.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\nSe pueden definir excepciones de políticas para subdominios específicos, así como para sitios enteros. Por ejemplo, una política definida únicamente para subdominio.sitio.com se aplica a subdominio.sitio.com sin afectar a sitio.com. En algunos casos en los que un subdominio no se puede aislar de su sitio superior, puede heredar la política definida en sitio.com. Es posible que las excepciones no se apliquen a los marcos cargados en una pestaña existente hasta que el sitio se abra en una pestaña nueva. En los dispositivos Android con poca memoria, es posible que no se apliquen las excepciones específicas de sitios y que, en su lugar, los sitios usen la política de DefaultJavaScriptJitSetting si se ha definido, o la configuración de JavaScript con JIT predeterminada del perfil.\n\nPara aplicar excepciones, Brave puede asignar sitios o subdominios cuya configuración difiera de la predeterminada a procesos específicos. Esto puede aumentar el uso de memoria, especialmente en Android o cuando un patrón de comodín coincide con muchos subdominios, ya que cada origen coincidente se puede aislar por separado. Los subdominios aislados tampoco pueden usar document.domain para acceder a su sitio superior.\n\nNota: En las versiones 155 y anteriores, las excepciones de la política solo se aplicaban obligatoriamente a nivel de sitio (eTLD+1). Una política definida únicamente para subdominio.sitio.com no se aplicaba, ni siquiera a subdominio.sitio.com. Tenía que definirse en sitio.com para que se aplicase tanto a sitio.com como a subdominio.sitio.com.\n\nEsta política se aplica marco a marco y no basándose únicamente en la URL de origen de nivel superior. Por ejemplo, si se ha incluido sitio-uno.com en la política JavaScriptJitAllowedForSites, pero sitio-uno.com carga un marco que contiene sitio-dos.com, se habilitará el uso de JavaScript con JIT en sitio-uno.com, pero sitio-dos.com usará la política de DefaultJavaScriptJitSetting si se ha definido. Si no se ha definido, se habilitará el uso de JavaScript con JIT de forma predeterminada. Las entradas de la lista de bloqueadas tienen más prioridad que las de la lista de permitidas, que a su vez tienen más prioridad que el valor predeterminado configurado.\n\nSi no se establece esta política para un sitio, se le aplicará la política de DefaultJavaScriptJitSetting si se ha definido. Si no se ha definido esta política, se habilitará el uso de JavaScript con JIT en ese sitio.";
JavaScriptJitBlockedForSites.pfm_title = "Impedir que JavaScript use JIT en estos sitios";
JavaScriptJitBlockedForSites.pfm_description = "Te permite definir una lista con patrones de URL de sitios donde se especifique qué sitios no pueden ejecutar JavaScript con un compilador en tiempo de ejecución (JIT) habilitado.\n\nSi se inhabilita el uso de JavaScript con JIT, es posible que Brave renderice contenido web de forma más lenta y que también se inhabiliten algunas partes de JavaScript, como WebAssembly. Al inhabilitarse el uso de JavaScript con JIT, es posible que Brave renderice contenido web con una configuración más segura.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\nSe pueden definir excepciones de políticas para subdominios específicos, así como para sitios enteros. Por ejemplo, una política definida únicamente para subdominio.sitio.com se aplica a subdominio.sitio.com sin afectar a sitio.com. En algunos casos en los que un subdominio no se puede aislar de su sitio superior, puede heredar la política definida en sitio.com. Es posible que las excepciones no se apliquen a los marcos cargados en una pestaña existente hasta que el sitio se abra en una pestaña nueva. En los dispositivos Android con poca memoria, es posible que no se apliquen las excepciones específicas de sitios y que, en su lugar, los sitios usen la política de DefaultJavaScriptJitSetting si se ha definido, o la configuración de JavaScript con JIT predeterminada del perfil.\n\nPara aplicar excepciones, Brave puede asignar sitios o subdominios cuya configuración difiera de la predeterminada a procesos específicos. Esto puede aumentar el uso de memoria, especialmente en Android o cuando un patrón de comodín coincide con muchos subdominios, ya que cada origen coincidente se puede aislar por separado. Los subdominios aislados tampoco pueden usar document.domain para acceder a su sitio superior.\n\nNota: En las versiones 155 y anteriores, las excepciones de la política solo se aplicaban obligatoriamente a nivel de sitio (eTLD+1). Una política definida únicamente para subdominio.sitio.com no se aplicaba, ni siquiera a subdominio.sitio.com. Tenía que definirse en sitio.com para que se aplicase tanto a sitio.com como a subdominio.sitio.com.\n\nEsta política se aplica marco a marco y no basándose únicamente en la URL de origen de nivel superior. Por ejemplo, si se ha incluido sitio-uno.com en la política JavaScriptJitBlockedForSites, pero sitio-uno.com carga un marco que contiene sitio-dos.com, se inhabilitará el uso de JavaScript con JIT en sitio-uno.com, pero sitio-dos.com usará la política de DefaultJavaScriptJitSetting si se ha definido. Si no se ha definido, se habilitará el uso de JavaScript con JIT de forma predeterminada. Las entradas de la lista de bloqueadas tienen más prioridad que las de la lista de permitidas, que a su vez tienen más prioridad que el valor predeterminado configurado.\n\nSi no se establece esta política para un sitio, se le aplicará la política de DefaultJavaScriptJitSetting si se ha definido. Si no se ha definido esta política, se habilitará el uso de JavaScript con JIT en ese sitio.";
JavaScriptOptimizerAllowedForSites.pfm_title = "Permitir la optimización de JavaScript en estos sitios";
JavaScriptOptimizerAllowedForSites.pfm_description = "Te permite definir una lista de patrones de URL donde se especifican los sitios en los que se han habilitado las optimizaciones avanzadas de JavaScript.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\nSe permite el uso de caracteres comodín (*).\n\nSe pueden definir excepciones de políticas para subdominios específicos, así como para sitios enteros.\nPor ejemplo, una política definida únicamente para subdominio.sitio.com se aplica a\nsubdominio.sitio.com sin afectar a sitio.com. En algunos casos en los que un\nsubdominio no se puede aislar de su sitio superior, puede heredar la política\ndefinida en sitio.com. Es posible que las excepciones no se apliquen a los marcos cargados en una\npestaña existente hasta que el sitio se abra en una pestaña nueva. En los\ndispositivos Android con poca memoria, es posible que\nno se apliquen las excepciones específicas de sitios y que, en su lugar, los sitios usen la política de\nDefaultJavaScriptOptimizerSetting,\nsi se ha definido, o la configuración de JavaScript con JIT predeterminada del perfil.\n\nPara aplicar excepciones, Brave\npuede asignar sitios o subdominios cuya configuración difiera de la predeterminada\na procesos específicos. Esto puede aumentar el uso de memoria, especialmente en\nAndroid o cuando un patrón de comodín coincide con muchos\nsubdominios, ya que cada origen coincidente se puede aislar por separado. Los subdominios aislados\ntampoco pueden usar document.domain para acceder a su sitio superior.\n\nNota: En las versiones 138 y anteriores, las excepciones de la política solo se implementaban obligatoriamente en\nuna granularidad de sitios (eTLD+1). Una política definida únicamente para subdominio.sitio.com no\nse aplicaba, ni siquiera a subdominio.sitio.com. Tenía que definirse\nen sitio.com para que se aplicase tanto a sitio.com como a subdominio.sitio.com.\n\nEsta política se aplica marco a marco y no basándose únicamente en la URL de\norigen de nivel superior. Por ejemplo, si se ha incluido sitio-uno.com en la política JavaScriptOptimizerAllowedForSites, pero sitio-uno.com carga un marco\nque contiene sitio-dos.com, sitio-uno.com habilitará las\noptimizaciones de JavaScript, pero sitio-dos.com usará la política de DefaultJavaScriptOptimizerSetting si se ha definido. Si no se ha definido esta política, se habilitarán las\noptimizaciones de JavaScript de forma predeterminada. Las entradas de la lista de bloqueadas tienen más prioridad que las de la lista de permitidas, que a su vez tienen más prioridad que el valor predeterminado configurado.\n\nSi no se establece esta política para un sitio, se le aplicará la política de DefaultJavaScriptOptimizerSetting si se ha definido. Si no se ha definido,\nse habilitará la optimización de JavaScript.";
JavaScriptOptimizerBlockedForSites.pfm_title = "Bloquear optimizaciones de JavaScript en estos sitios";
JavaScriptOptimizerBlockedForSites.pfm_description = "Te permite definir una lista de patrones de URL donde se especifican los sitios en los que se han inhabilitado las optimizaciones avanzadas de JavaScript.\n\nSi se inhabilitan las optimizaciones de JavaScript, es posible que Brave renderice el contenido web de forma más lenta.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\nSe permite el uso de caracteres comodín (*).\n\nSe pueden definir excepciones de políticas para subdominios específicos, así como para sitios enteros.\nPor ejemplo, una política definida únicamente para subdominio.sitio.com se aplica a\nsubdominio.sitio.com sin afectar a sitio.com. En algunos casos en los que un\nsubdominio no se puede aislar de su sitio superior, puede heredar la política\ndefinida en sitio.com. Es posible que las excepciones no se apliquen a los marcos cargados en una\npestaña existente hasta que el sitio se abra en una pestaña nueva. En los\ndispositivos Android con poca memoria, es posible que\nno se apliquen las excepciones específicas de sitios y que, en su lugar, los sitios usen la política de\nDefaultJavaScriptOptimizerSetting,\nsi se ha definido, o la configuración de JavaScript con JIT predeterminada del perfil.\n\nPara aplicar excepciones, Brave\npuede asignar sitios o subdominios cuya configuración difiera de la predeterminada\na procesos específicos. Esto puede aumentar el uso de memoria, especialmente en\nAndroid o cuando un patrón de comodín coincide con muchos\nsubdominios, ya que cada origen coincidente se puede aislar por separado. Los subdominios aislados\ntampoco pueden usar document.domain para acceder a su sitio superior.\n\nNota: En las versiones 138 y anteriores, las excepciones de la política solo se implementaban obligatoriamente en\nuna granularidad de sitios (eTLD+1). Una política definida únicamente para subdominio.sitio.com no\nse aplicaba, ni siquiera a subdominio.sitio.com. Tenía que definirse\nen sitio.com para que se aplicase tanto a sitio.com como a subdominio.sitio.com.\n\nEsta política se aplica marco a marco y no basándose únicamente en la URL de\norigen de nivel superior. Por ejemplo, si se ha incluido sitio-uno.com en la política JavaScriptOptimizerBlockedForSites, pero sitio-uno.com carga un marco\nque contiene sitio-dos.com, sitio-uno.com inhabilitará las\noptimizaciones de JavaScript, pero sitio-dos.com usará la política de DefaultJavaScriptOptimizerSetting si se ha definido. Si no se ha definido esta política, se habilitarán las\noptimizaciones de JavaScript de forma predeterminada. Las entradas de la lista de bloqueadas tienen más prioridad que las de la lista de permitidas, que a su vez tienen más prioridad que el valor predeterminado configurado.\n\nSi no se establece esta política para un sitio, se le aplicará la política de DefaultJavaScriptOptimizerSetting si se ha definido. Si no se ha definido, se habilitará la optimización de JavaScript.";
LiveCaptionEnabled.pfm_title = "Habilitar Subtítulos instantáneos";
LiveCaptionEnabled.pfm_description = "Habilita la función Subtítulos automáticos.\n\nSi se habilita esta política, esta función siempre estará activada.\n\nSi se inhabilita esta política, la función siempre estará desactivada.\n\nSi se define esta política como obligatoria, los usuarios no podrán cambiarla ni anularla.\n\nSi no se le asigna ningún valor, Subtítulos automáticos se inhabilitará inicialmente, pero los usuarios podrán habilitarla en cualquier momento.";
LiveTranslateEnabled.pfm_title = "Habilitar Traducción instantánea";
LiveTranslateEnabled.pfm_description = "Habilita la traducción de subtítulos automáticos. Los subtítulos se enviarán a Google para que se traduzcan.\n\nSi se habilita esta política, Traducción instantánea siempre estará activada.\n\nSi se inhabilita esta política, la función siempre estará desactivada.\n\nSi se define esta política como obligatoria, los usuarios no podrán cambiarla ni anularla.\n\nSi no se le asigna ningún valor, Traducción instantánea se inhabilitará inicialmente, pero los usuarios podrán habilitarla en cualquier momento.\n\nSi se inhabilita LiveCaptionEnabled, Traducción instantánea se inhabilitará independientemente de la configuración de esta política.";
LocalFontsAllowedForUrls.pfm_title = "Permitir el permiso de fuentes locales en estos sitios";
LocalFontsAllowedForUrls.pfm_description = "Define una lista de patrones de URL de sitio donde se especifica qué sitios otorgarán automáticamente el permiso de fuentes locales. Esto ampliará la capacidad de los sitios para ver información sobre fuentes locales.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.\n\nSi esta política no se establece para un sitio, se le aplicará la de DefaultLocalFontsSetting (si se ha definido). En caso contrario, el permiso se ajustará a los valores predeterminados del navegador y los usuarios podrán elegir este permiso en función del sitio.";
LocalFontsBlockedForUrls.pfm_title = "Bloquear el permiso de fuentes locales en estos sitios";
LocalFontsBlockedForUrls.pfm_description = "Define una lista de patrones de URL de sitio donde se especifica qué sitios denegarán automáticamente el permiso de fuentes locales. Esto limitará la capacidad de los sitios para ver información sobre fuentes locales.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.\n\nSi esta política no se establece para un sitio, se le aplicará la de DefaultLocalFontsSetting (si se ha definido). En caso contrario, el permiso se ajustará a los valores predeterminados del navegador y los usuarios podrán elegir este permiso en función del sitio.";
LocalNetworkAccessAllowedForUrls.pfm_title = "Permitir que los sitios envíen solicitudes de red a dispositivos locales y endpoints de la red local.";
LocalNetworkAccessAllowedForUrls.pfm_description = "Lista de patrones de URL. Las solicitudes de red iniciadas desde sitios web servidos por orígenes coincidentes no están sujetas a comprobaciones de Local Network Access.\n\nEn el caso de los orígenes no incluidos en los patrones aquí indicados, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\n\nConsulta https://wicg.github.io/local-network-access/ para conocer las restricciones de Local Network Access.\n\nVarias políticas indican orígenes que afectan a las solicitudes al dispositivo local y a endpoints de la red local. Si un origen coincide con más de una de las siguientes políticas, estas tendrán prioridad en el siguiente orden:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "Impedir que los sitios envíen solicitudes de red a dispositivos locales y endpoints de la red local.";
LocalNetworkAccessBlockedForUrls.pfm_description = "Lista de patrones de URL. Las solicitudes de red iniciadas desde sitios web servidos por orígenes coincidentes no pueden enviar solicitudes de Local Network Access.\n\nEn el caso de los orígenes no incluidos en los patrones aquí indicados, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\n\nConsulta https://wicg.github.io/local-network-access/ para conocer las restricciones de Local Network Access.\n\nVarias políticas indican orígenes que afectan a las solicitudes al dispositivo local y a endpoints de la red local. Si un origen coincide con más de una de las siguientes políticas, estas tendrán prioridad en el siguiente orden:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "Anular asignaciones de espacio de direcciones IP";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "Esto se puede usar para tratar determinados intervalos de direcciones internas como públicos y, por lo tanto, no estarán sujetos a comprobaciones de Local Network Access. Sin embargo, también se puede usar para tratar determinados intervalos de direcciones públicos que se podrían utilizar internamente como locales para que estén protegidos por las comprobaciones de Local Network Access.\n\nLas anulaciones de espacio de direcciones IP tienen dos formatos:\n\n[cidr]=[público|local|bucle invertido]\n\n[cidr] es un intervalo de direcciones IP en notación CIDR (consulta la sección 3.1 de https://tools.ietf.org/html/rfc4632 para IPv4 y la sección 2.3 de https://tools.ietf.org/html/rfc4291 para IPv6). Las direcciones IPv6 deben especificarse en formato seguro para URLs (entre corchetes). Las anulaciones de CIDR se aplican a todos los puertos.\n\no\n\n[dirección IP]:[puerto]=[público|local|bucle invertido]\n\nPara obtener más información sobre Local Network Access, consulta https://wicg.github.io/local-network-access/ y https://developer.chrome.com/blog/local-network-access.\n\nEsta política no admite la actualización dinámica.\n\nLas anulaciones del interruptor de la línea de comandos --ip-address-space-overrides tienen prioridad sobre las anulaciones definidas por esta política.";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "Permitir solicitudes de acceso a la red local (LNA) en subframes sin delegación explícita";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "De forma predeterminada, solo se pueden solicitar permisos de acceso a la red local (LNA) en subframes de origen cruzado si se delegan explícitamente. Esta política se puede usar para anular este comportamiento predeterminado de forma que los permisos de LNA se hereden de forma predeterminada en los subframes, a menos que se deniegue explícitamente en la política de permisos.\n\nSi se habilita esta política, se delegarán de forma predeterminada todas las funciones de la política de permisos de LNA a los subframes, que podrán hacer solicitudes de red local (lo que activará la solicitud de permiso).\n\nSi se inhabilita esta política o no se define, los subframes deberán tener delegada explícitamente la función de política de permisos para poder hacer solicitudes de red local y activar la solicitud de permiso.\n\nEsta política se aplica a las funciones \"local-network-access\", \"loopback-network\" y \"local-network\" de la política de permisos.\n\nPara obtener más información sobre el acceso a la red local, consulta https://wicg.github.io/local-network-access/ y https://developer.chrome.com/blog/local-network-access.\n\nPara obtener más información sobre la política de permisos, consulta https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy.";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "Especifica si se deben inhabilitar (temporalmente) las restricciones de acceso a la red local";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "Si se habilita esta política, las solicitudes de Local Network Access solo mostrarán advertencias en Chrome DevTools debido a un error en las comprobaciones de Local Network Access.\n\nSi se inhabilita esta política o no se define, las solicitudes de Local Network Access usarán la gestión predeterminada de estas solicitudes.\n\nConsulta https://wicg.github.io/local-network-access/ para conocer las restricciones de Local Network Access.\n\nEsta política de empresa es temporal y se eliminará a partir de la versión M163.\n\nA largo plazo, la política LocalNetworkAccessAllowedForUrls se podrá usar para añadir a una lista de permitidos patrones de URL a los que se debe conceder automáticamente el permiso de Local Network Access.";
LocalNetworkAllowedForUrls.pfm_title = "Permitir que los sitios envíen solicitudes de red a endpoints de la red local.";
LocalNetworkAllowedForUrls.pfm_description = "Lista de patrones de URL. Las solicitudes de red iniciadas desde sitios web servidos por orígenes coincidentes a endpoints de la red local no están sujetas a comprobaciones de Local Network Access.\n\nEn el caso de los orígenes no incluidos en los patrones aquí indicados, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\n\nConsulta https://wicg.github.io/local-network-access/ para conocer las restricciones de Local Network Access.\n\nVarias políticas indican orígenes que afectan a las solicitudes a endpoints de la red local. Si un origen coincide con más de una de las siguientes políticas, estas tendrán prioridad en el siguiente orden:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkBlockedForUrls.pfm_title = "Impedir que los sitios envíen solicitudes de red a endpoints de la red local.";
LocalNetworkBlockedForUrls.pfm_description = "Lista de patrones de URL. Las solicitudes de red iniciadas desde sitios web servidos por orígenes coincidentes a endpoints de la red local no pueden enviar solicitudes de Local Network Access.\n\nEn el caso de los orígenes no incluidos en los patrones aquí indicados, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\n\nConsulta https://wicg.github.io/local-network-access/ para conocer las restricciones de Local Network Access.\n\nVarias políticas indican orígenes que afectan a las solicitudes a endpoints de la red local. Si un origen coincide con más de una de las siguientes políticas, estas tendrán prioridad en el siguiente orden:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LookalikeWarningAllowlistDomains.pfm_title = "Eliminar las advertencias de dominio similares en dominios";
LookalikeWarningAllowlistDomains.pfm_description = "Esta política evita que aparezcan advertencias URL similares en los sitios incluidos en la lista. Normalmente, estas advertencias aparecen en sitios que Brave considera que podrían tratar de falsificar mediante spoofing otro sitio conocido por el usuario.\n\nSi se habilita esta política y se le asignan uno o varios dominios, no se mostrarán páginas de advertencia similares cuando el usuario visite páginas de esos dominios.\n\nSi no se habilita esta política o se le asigna una lista vacía, es posible que aparezcan advertencias en cualquier sitio que visite el usuario.\n\nSe puede permitir un nombre de host con una coincidencia completa o cualquier coincidencia con el dominio. Por ejemplo, es posible que se eliminen las advertencias en una URL como \"https://foo.example.com/bar\" si la lista incluye \"foo.example.com\" o \"example.com\".";
LoopbackNetworkAllowedForUrls.pfm_title = "Permitir que los sitios envíen solicitudes de red al dispositivo local.";
LoopbackNetworkAllowedForUrls.pfm_description = "Lista de patrones de URL. Las solicitudes de red iniciadas desde sitios web servidos por orígenes coincidentes al dispositivo local no están sujetas a comprobaciones de Local Network Access.\n\nEn el caso de los orígenes no incluidos en los patrones aquí indicados, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\n\nConsulta https://wicg.github.io/local-network-access/ para conocer las restricciones de Local Network Access.\n\nVarias políticas indican orígenes que afectan a las solicitudes al dispositivo local. Si un origen coincide con más de una de las siguientes políticas, estas tendrán prioridad en el siguiente orden:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LoopbackNetworkBlockedForUrls.pfm_title = "Impedir que los sitios envíen solicitudes de red al dispositivo local.";
LoopbackNetworkBlockedForUrls.pfm_description = "Lista de patrones de URL. Las solicitudes de red iniciadas desde sitios web servidos por orígenes coincidentes al dispositivo local no pueden enviar solicitudes de Local Network Access.\n\nEn el caso de los orígenes no incluidos en los patrones aquí indicados, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns.\n\nConsulta https://wicg.github.io/local-network-access/ para conocer las restricciones de Local Network Access.\n\nVarias políticas indican orígenes que afectan a las solicitudes al dispositivo local. Si un origen coincide con más de una de las siguientes políticas, estas tendrán prioridad en el siguiente orden:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
ManagedBookmarks.pfm_title = "Marcadores administrados";
ManagedBookmarks.pfm_description = "Si se establece esta política, se definirá una lista de marcadores en la que cada uno es un diccionario con las claves \"name\" y \"url\". Estas claves contienen el nombre y la URL de destino del marcador. Los administradores podrán configurar una subcarpeta definiendo un marcador sin una clave \"url\", pero con una clave \"children\" adicional. Esta clave también contiene una lista de marcadores, algunos de los cuales también pueden ser carpetas. Chrome modifica las URL incompletas como si se enviasen mediante la barra de direcciones. Por ejemplo, \"google.com\" se convierte en \"https://google.com/\".\n\nLos usuarios no podrán cambiar las carpetas en las que están colocados los marcadores, pero podrán ocultarlas de la barra de marcadores. El nombre predeterminado de la carpeta de marcadores administrados es \"Marcadores administrados\", pero se puede cambiar si se añade un nuevo subdiccionario a la política con una única clave llamada \"toplevel_name\" que tenga asignado como valor el nombre que se quiera asignar a la carpeta. Los marcadores administrados no se sincronizan con la cuenta de usuario y las extensiones no pueden modificarlos.\nConsulta la página https://chromeenterprise.google/policies/?policy=ManagedBookmarks para obtener más información sobre el esquema y el formato.";
ManagedConfigurationPerOrigin.pfm_title = "Establece valores de la configuración administrada aplicados a sitios web para orígenes determinados";
ManagedConfigurationPerOrigin.pfm_description = "Si se asigna un valor a esta política, se definirá el valor de retorno de la API Managed Configuration para un origen determinado.\n\n La API Managed Configuration es una configuración clave-valor a la que se puede acceder llamando a la función de JavaScript navigator.device.getManagedConfiguration(). Esta API solo está disponible para orígenes que se correspondan con aplicaciones web de instalación forzada mediante WebAppInstallForceList.\n\nConsulta la página https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin para obtener más información sobre el esquema y el formato.";
MaxConnectionsPerProxy.pfm_title = "Número máximo de conexiones simultáneas por servidor proxy para solicitudes que no son de WebSocket";
MaxConnectionsPerProxy.pfm_description = "Definir esta política permite especificar el número máximo de conexiones simultáneas por servidor proxy para solicitudes que no son de WebSocket.\n\nPara modificar los límites de solicitudes de WebSocket, consulta MaxConnectionsPerProxyForWebSocket.\n\nSi no se establece esta política, se utilizará el valor predeterminado (128).\n\nAlgunas aplicaciones web consumen muchas conexiones con las solicitudes GET pendientes, por lo que un valor inferior a 128 puede hacer que la red del navegador se bloquee si se abren muchas aplicaciones web de este tipo.\nAlgunos servidores proxy no son capaces de gestionar un número elevado de conexiones simultáneas por cliente, lo que se puede solucionar estableciendo un valor inferior para esta política.\n\nEl valor debe ser igual o superior a 6.\nSi defines un valor inferior a ese límite, se usará 6.\nSi estableces un valor inferior al predeterminado (128), debes hacerlo bajo tu propia responsabilidad.\n\nEl valor debe ser igual o inferior a 256 (99 en Brave 147 y versiones anteriores).\nSi defines un valor superior a ese límite, se usará 256 (99 en Brave 147 y versiones anteriores).\nSi defines un valor superior al predeterminado (128), lo haces bajo tu propia responsabilidad.\n\nTen en cuenta que los límites implementados se ven afectados por AllowSocketPoolSizeRandomizationForProxies.";
MaxConnectionsPerProxyForWebSocket.pfm_title = "Número máximo de conexiones simultáneas por servidor proxy para solicitudes de WebSocket";
MaxConnectionsPerProxyForWebSocket.pfm_description = "Definir esta política permite especificar el número máximo de conexiones simultáneas por servidor proxy para solicitudes de WebSocket.\n\nPara modificar los límites de solicitudes que no son de WebSocket, consulta MaxConnectionsPerProxy.\n\nSi no se establece esta política, se utilizará el valor predeterminado (128).\n\nAlgunas aplicaciones web consumen muchas conexiones con las solicitudes GET pendientes, por lo que un valor inferior a 128 puede hacer que la red del navegador se bloquee si se abren muchas aplicaciones web de este tipo.\nAlgunos servidores proxy no son capaces de gestionar un número elevado de conexiones simultáneas por cliente, lo que se puede solucionar estableciendo un valor inferior para esta política.\n\nEl valor debe ser igual o superior a 6.\nSi defines un valor inferior a ese límite, se usará 6.\nSi estableces un valor inferior al predeterminado (128), debes hacerlo bajo tu propia responsabilidad.\n\nEl valor debe ser igual o inferior a 256.\nSi defines un valor superior a ese límite, se usará 256.\nSi defines un valor superior al predeterminado (128), lo haces bajo tu propia responsabilidad.\n\nTen en cuenta que los límites implementados se ven afectados por AllowSocketPoolSizeRandomizationForProxies.";
MaxInvalidationFetchDelay.pfm_title = "Retraso de recuperación máximo después de validar una política";
MaxInvalidationFetchDelay.pfm_description = "Si se asigna un valor a esta política, se especificará el retraso máximo (en milisegundos) entre la recepción de la invalidación de una política y la obtención de la nueva política desde el servicio de gestión del dispositivo. Los valores válidos están comprendidos entre 1000 (1 segundo) y 300.000 (5 minutos). Cualquier valor fuera de este intervalo se redondeará al límite correspondiente.\n\nSi no se le asigna ningún valor a esta política, Brave usará el valor predeterminado (10 segundos).";
MediaRecommendationsEnabled.pfm_title = "Habilitar recomendaciones de contenido multimedia";
MediaRecommendationsEnabled.pfm_description = "De forma predeterminada, el navegador mostrará recomendaciones de contenido multimedia personalizadas al usuario. Si se inhabilita esta política, no se mostrarán estas recomendaciones al usuario. Si se habilita esta política o no se establece, se mostrarán recomendaciones de contenido multimedia al usuario.";
MediaRouterCastAllowAllIPs.pfm_title = "Permitir que Google Cast se conecte a dispositivos de transmisión de todas las direcciones IP.";
MediaRouterCastAllowAllIPs.pfm_description = "A menos que la política EnableMediaRouter se haya inhabilitado, si se habilita MediaRouterCastAllowAllIPs,Google Cast se conectará con los dispositivos de emisión de todas las direcciones IP, no solo con las direcciones privadas de RFC1918/RFC4193.\n\nSi se inhabilita esta política, Google Cast solo se conectará con dispositivos de emisión en direcciones de RFC1918/RFC4193.\n\nSi esta política no se establece, Google Cast solo se conectará con dispositivos de emisión de direcciones de RFC1918/RFC4193, a menos que la función CastAllowAllIPs esté activada.";
MemorySaverModeSavings.pfm_title = "Cambiar el ahorro del modo Ahorro de memoria";
MemorySaverModeSavings.pfm_description = "0 - Ahorro de memoria moderado.\n1 - Ahorro de memoria equilibrado.\n2 - Ahorro de memoria máximo.\nEsta política cambia el nivel de ahorro de la función Ahorro de memoria.\n\nEsta política solo tendrá efecto si la función Ahorro de memoria se habilita a través de la configuración o de la política HighEfficiencyModeEnabled y afectará a la forma en que se usan métodos heurísticos para determinar cuándo se deben descartar las pestañas. Por ejemplo, reducir el tiempo que tardarán en descartarse las pestañas inactivas puede ahorrar memoria, pero las pestañas se volverán a cargar con más frecuencia, lo cual puede afectar negativamente a la experiencia de usuario y provocar un aumento del consumo de tráfico de red.\n\nSi se asigna el valor 0 a esta política, Ahorro de memoria proporcionará un ahorro de memoria moderado. Las pestañas se desactivarán cuando haya transcurrido un periodo más largo.\n\nSi se asigna el valor 1 a esta política, Ahorro de memoria proporcionará un ahorro de memoria equilibrado. Las pestañas se desactivarán cuando haya transcurrido un periodo óptimo.\n\nSi se asigna el valor 2 a esta política, Ahorro de memoria proporcionará el máximo ahorro de memoria. Las pestañas se desactivarán cuando haya transcurrido un periodo más breve.\n\nSi no se define esta política, el usuario final podrá controlar este ajuste en chrome://settings/performance.";
MetricsReportingEnabled.pfm_title = "Habilitar informes de uso y de datos sobre fallos";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "Mostrar tarjetas en la página Nueva pestaña";
NTPCardsVisible.pfm_description = "Esta política controla la visibilidad de las tarjetas en la página Nueva pestaña. Las tarjetas muestran puntos de entrada para lanzar contenido consultado frecuentemente por el usuario en función de sus hábitos de navegación.\n\nSi se habilita esta política, la página Nueva pestaña mostrará tarjetas si hay contenido disponible.\n\nSi se inhabilita, la página Nueva pestaña no mostrará ninguna tarjeta.\n\nSi no se le asigna ningún valor, el usuario podrá controlar la visibilidad de las tarjetas. Las tarjetas serán visibles de forma predeterminada.\n";
NTPCustomBackgroundEnabled.pfm_title = "Permite a los usuarios personalizar la imagen de fondo de la página Nueva pestaña";
NTPCustomBackgroundEnabled.pfm_description = "Si se asigna el valor \"false\" a esta política, la página Nueva pestaña no permitirá a los usuarios personalizar la imagen de fondo. Aunque se cambie el valor a \"true\" posteriormente, las imágenes de fondo personalizadas se eliminarán de forma permanente.\n\nSi se asigna el valor \"true\" a esta política o no se define, los usuarios podrán personalizar la imagen de fondo en la página Nueva pestaña.\n\nNota: En Android, se deberá reiniciar el navegador para que se aplique la política.";
NTPFooterExtensionAttributionEnabled.pfm_title = "Controlar la visibilidad de la atribución de la extensión en la página Nueva pestaña";
NTPFooterExtensionAttributionEnabled.pfm_description = "Esta política determina si se muestra una atribución de la extensión que modifica la página Nueva pestaña en el pie de la página Nueva pestaña.\n\nDe forma predeterminada, si una extensión ha anulado la página Nueva pestaña estándar, en el pie de página aparecerá un mensaje que atribuye este cambio a la extensión en cuestión. Esta atribución suele incluir un enlace a la extensión correspondiente en Chrome Web Store.\n\nSi no se establece esta política o se le asigna el valor true, la atribución de la extensión se mostrará en el pie de la página Nueva pestaña cuando una extensión controle la página Nueva pestaña.\n\nSi se le asigna el valor false a esta política, se suprimirá la atribución a la extensión en el pie de la página Nueva pestaña.";
NTPFooterManagementNoticeEnabled.pfm_title = "Controlar la visibilidad del aviso de gestión en la página Nueva pestaña de los navegadores gestionados";
NTPFooterManagementNoticeEnabled.pfm_description = "Esta política controla la visibilidad del aviso de gestión en el pie de página de la página Nueva pestaña. De forma predeterminada, el pie de página de la Nueva pestaña muestra información cuando el navegador lo gestiona una organización (lo indica un icono de un edificio y el texto \"Gestionado por [nombre de dominio]\"). Se puede personalizar con las políticas EnterpriseCustomLabelForBrowser y EnterpriseLogoUrlForBrowser.\n\nSi no se establece esta política o se le asigna el valor true, los navegadores gestionados mostrarán el aviso \"Gestionado por\" con un icono.\n\nSi se le asigna el valor false, el aviso de gestión se ocultará.\n\nTen en cuenta que esta política solo se aplica a los navegadores gestionados, por lo que no afectará a los usuarios gestionados que usen navegadores no gestionados.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
NTPOutlookCardVisible.pfm_title = "Mostrar tarjeta de calendario de Outlook en la página Nueva pestaña";
NTPOutlookCardVisible.pfm_description = "Esta política controla la visibilidad de la tarjeta de Outlook en la página Nueva pestaña. La tarjeta solo se mostrará en la página Nueva pestaña si la política está habilitada y tu organización ha autorizado el uso de los datos del calendario de Outlook en el navegador.\n\nEl navegador no almacenará los datos de Outlook.\n\nLa tarjeta de Outlook muestra el próximo evento del calendario, junto con una vista general del resto de las reuniones del día. Su objetivo es abordar el problema del cambio de contexto y mejorar la productividad ofreciendo a los usuarios un acceso directo a su próxima reunión.\n\nLa tarjeta de Microsoft Outlook requerirá una configuración adicional por parte del administrador. Para obtener información detallada sobre cómo conectar la tarjeta de la página Nueva pestaña de Chrome a Outlook, consulta https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nSi se inhabilita NTPCardsVisible, no se mostrará la tarjeta de Outlook. Si se habilita NTPCardsVisible, se mostrará la tarjeta de Outlook si esta política también está habilitada y hay datos que mostrar. Si no se define NTPCardsVisible, la tarjeta de Outlook se mostrará si esta política también está habilitada, el usuario tiene habilitada la tarjeta en Personalizar Chrome y hay datos que mostrar.";
NTPSharepointCardVisible.pfm_title = "Mostrar la tarjeta de archivo de SharePoint y OneDrive en la página Nueva pestaña";
NTPSharepointCardVisible.pfm_description = "Esta política controla la visibilidad de la tarjeta de archivo de SharePoint y OneDrive en la página Nueva pestaña. La tarjeta solo se mostrará en la página Nueva pestaña si la política está habilitada y tu organización ha autorizado el uso de los datos de los archivos de SharePoint y OneDrive en el navegador.\n\nEl navegador no almacenará los datos de SharePoint ni OneDrive.\n\nLa tarjeta de recomendación de archivos de SharePoint y OneDrive muestra una lista de archivos recomendados.  Su objetivo es abordar el problema del cambio de contexto y mejorar la productividad ofreciendo a los usuarios un acceso directo a sus documentos más importantes.\n\nLa tarjeta de Microsoft SharePoint y OneDrive requerirá una configuración adicional por parte del administrador. Para obtener información detallada sobre cómo conectar la tarjeta de la página Nueva pestaña de Chrome a SharePoint, consulta https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nSi se inhabilita NTPCardsVisible, no se mostrará la tarjeta de SharePoint y OneDrive. Si se habilita NTPCardsVisible, se mostrará la tarjeta de SharePoint y OneDrive si esta política también está habilitada y hay datos que mostrar. Si no se define NTPCardsVisible, la tarjeta de SharePoint y OneDrive se mostrará si esta política también está habilitada, el usuario tiene habilitada la tarjeta en Personalizar Chrome y hay datos que mostrar.";
NTPShortcuts.pfm_title = "Configurar accesos directos en la página Nueva pestaña";
NTPShortcuts.pfm_description = "Si se establece esta política, se preconfigurarán hasta 10 accesos directos personalizados en la página Nueva pestaña de Brave.\n\nSi se establece, los usuarios verán estos accesos directos de forma predeterminada, además de sus accesos directos personales. Los usuarios pueden controlar la visibilidad de los accesos directos de su organización en el panel Personalizar Chrome.\n\nLas URLs de acceso directo deben ser únicas.\n\nSi se asigna el valor true a allow_user_edit, los usuarios podrán cambiar el nombre del acceso directo. Si se asigna el valor false o no se establece, los usuarios no podrán cambiar el nombre.\n\nSi se asigna el valor true a allow_user_delete, los usuarios podrán quitar el acceso directo. Si se asigna el valor false o no se establece, los usuarios no podrán quitar el acceso directo.\nConsulta la página https://chromeenterprise.google/policies/?policy=NTPShortcuts para obtener más información sobre el esquema y el formato.";
NativeMessagingAllowlist.pfm_title = "Nombres de hosts de mensajería nativa que se deben excluir de la lista de bloqueados";
NativeMessagingAllowlist.pfm_description = "Si se establece esta política, se especificará qué hosts de mensajería nativa no están sujetos a la lista de bloqueados. Un valor de lista de bloqueados de * significa que todos los hosts de mensajería nativa han sido denegados, excepto los que estén permitidos explícitamente.\n\nTodos los hosts de mensajería nativa están permitidos de forma predeterminada. Sin embargo, si la política deniega todos los hosts de mensajería nativa, el administrador podrá usar la lista de permitidos para anular dicha política.";
NativeMessagingBlocklist.pfm_title = "Nombres de hosts de mensajería nativa no permitidos (o * para todos)";
NativeMessagingBlocklist.pfm_description = "Si se establece esta política, se especificará qué hosts de mensajería nativa no se deben cargar. Un valor de lista de bloqueados de * significa que todos los hosts de mensajería nativa han sido denegados, excepto los que estén permitidos explícitamente.\n\nSi no se le asigna un valor a la política, Brave cargará todos los hosts de mensajería nativa instalados.";
NativeMessagingUserLevelHosts.pfm_title = "Permitir hosts de mensajería nativa en el nivel de usuario (instalados sin permisos de administrador)";
NativeMessagingUserLevelHosts.pfm_description = "Si se habilita esta política o no se le asigna ningún valor, Brave puede usar los hosts de mensajería nativa instalados a nivel de usuario.\n\nSi se inhabilita, Brave solo podrá usar estos hosts si han sido instalados a nivel de sistema.";
NetworkPredictionOptions.pfm_title = "Habilitar predicción de red";
NetworkPredictionOptions.pfm_description = "0 - Predecir las acciones de red en cualquier conexión de red\n1 - Predecir las acciones de la red en cualquier red que no sea móvil.\n(Obsoleto en 50, eliminado en 52. Si se le asigna el valor 1 después de 52, se tratará como si fuese 0 - predecir las acciones de red en cualquier conexión de red).\n2 - No predecir las acciones de red en ninguna conexión de red\nEsta política controla la predicción de red en Brave. Permite controlar tanto la precarga de DNS como la conexión previa de SSL y TCP, así como la carga previa de páginas web.\n\nSi le asignas un valor a esta política, los usuarios no podrán cambiarlo. Si no se define, se habilita la predicción de red, pero el usuario puede cambiarlo.";
NewTabPageLocation.pfm_title = "URL de la página Nueva pestaña";
NewTabPageLocation.pfm_description = "Si se define esta política, se configurará la URL predeterminada de la página Nueva pestaña y se evitará que los usuarios la cambien.\n\nLa página Nueva pestaña se abrirá con ventanas y pestañas nuevas.\n\nEsta política no determina qué páginas se abren al iniciar el navegador. Esas páginas las controlan las políticas RestoreOnStartup. Esta política no se aplicará a la página principal si se ha definido que abra la página Nueva pestaña, ni tampoco a la página de inicio si se ha definido que abra la página Nueva pestaña.\n\nSe recomienda proporcionar una URL totalmente canónica. En caso de que la URL no sea totalmente canónica, Brave se establecerá como https:// de forma predeterminada.\n\nSi no se le asigna ningún valor a esta política o se deja en blanco, se utilizará la página Nueva pestaña predeterminada.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
NotificationsAllowedForUrls.pfm_title = "Permitir notificaciones en estos sitios";
NotificationsAllowedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios pueden mostrar notificaciones.\n\nSi no se establece la política, DefaultNotificationsSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
NotificationsBlockedForUrls.pfm_title = "Bloquear notificaciones en estos sitios";
NotificationsBlockedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios no pueden mostrar notificaciones.\n\nSi no se establece la política, DefaultNotificationsSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
NtlmV2Enabled.pfm_title = "Habilita la autenticación NTLMv2.";
NtlmV2Enabled.pfm_description = "Si se asigna el valor \"Enabled\" a esta política o no se le asigna ninguno, se activará la autenticación NTLMv2.\n\nSi se le asigna el valor \"Disabled\", se desactivará la autenticación NTLMv2.\n\nTodas las versiones recientes de los servidores Microsoft® Windows® y Samba admiten la autenticación NTLMv2. Esta política solo debería desactivarse para obtener retrocompatibilidad, ya que reduce la seguridad a la hora de autenticarse.";
OopPrintDriversAllowed.pfm_title = "Controladores de impresión independientes permitidos";
OopPrintDriversAllowed.pfm_description = "Controla si Brave interactúa con controladores de impresión desde un proceso de servicio independiente. Las solicitudes de impresión de plataforma para consultar impresoras disponibles, obtener configuración de controladores de impresión y enviar documentos para imprimirlos en impresoras locales se realizan mediante un proceso de servicio. Retirar estas solicitudes del proceso del navegador, ayuda a mejorar la estabilidad y reducir los bloqueos de la interfaz de usuario en la vista previa de impresión.\n\nSi se habilita esta política o no se define, Brave usará el proceso de un servicio independiente para las tareas de impresión de plataforma.\n\nSi se inhabilita esta política, Brave usará el proceso del navegador para las tareas de impresión de plataforma.\n\nEsta política se eliminará en el futuro, cuando se haya lanzado por completo la función de los controladores de impresión independientes.";
OriginAgentClusterDefaultEnabled.pfm_title = "Permite los clústeres de agentes con clave de origen de forma predeterminada.";
OriginAgentClusterDefaultEnabled.pfm_description = "Esta política permite los clústeres de agentes con clave de origen de forma predeterminada.\n\nEl encabezado HTTP Origin-Agent-Cluster controla si un documento se aísla en un clúster de agentes con clave de origen o en un clúster de agentes con clave de sitio. Esto afecta a la seguridad, ya que un clúster de agentes con clave de origen permite aislar los documentos según el origen. La consecuencia que tiene para el desarrollador es que el descriptor de acceso document.domain ya no se podrá establecer.\n\nEl comportamiento predeterminado (cuando no hay ningún encabezado Origin-Agent-Cluster definido) cambia en M111 de clave de sitio a clave de origen.\n\nSi esta política se habilita o no se establece, el navegador adoptará este nuevo comportamiento predeterminado a partir de esa versión.\n\nSi esta política se inhabilita, el cambio se revertirá y los documentos sin encabezados Origin-Agent-Cluster se asignarán a clústeres de agentes con clave de sitio. Como consecuencia, el descriptor de acceso document.domain podrá establecerse de manera predeterminada. Esto coincide con el comportamiento anterior.\n\nConsulta https://developer.chrome.com/blog/immutable-document-domain/ para obtener más información.";
OriginKeyedProcessesEnabled.pfm_title = "Habilitar el aislamiento de procesos con clave de origen de forma predeterminada.";
OriginKeyedProcessesEnabled.pfm_description = "Habilita el aislamiento de procesos con clave de origen para la mayoría de las páginas (es decir, las que se asignan a un clúster de agentes con clave de origen de forma predeterminada). Esto mejora la seguridad, pero también aumenta el número de procesos creados. Los usuarios pueden anular el valor de la política definida mediante las marcas de línea de comandos o chrome://flags (tanto para activar como para desactivar esta función).\n\nSi se habilita esta política, la mayoría de los orígenes se aislarán, incluso de otros orígenes del mismo sitio. Consulta también las políticas IsolateOrigins y SitePerProcess.\n\nSi se inhabilita esta política, no se aislará ningún origen del resto de su sitio, a menos que un origen lo solicite explícitamente.\n\nSi no se establece esta política, el navegador determinará qué orígenes se deben aislar y cuándo.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "Orígenes o patrones de nombres de host en los que no se deben aplicar restricciones de orígenes no seguros";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "Si se define esta política, se especificará una lista de orígenes (URLs) o de patrones de nombre de host (como *.example.com) para los que no se aplicarán las restricciones de seguridad de orígenes no seguros. Los patrones solo se aceptan para nombres de host. Las URLs o los orígenes con esquemas deben ser cadenas exactas. Las organizaciones pueden especificar orígenes para aplicaciones antiguas que no pueden implementar TLS o configurar un servidor provisional para el desarrollo web interno, de manera que los desarrolladores puedan probar las funciones que necesiten contextos seguros sin tener que implementar TLS en el servidor provisional. Esta política también evita que el origen aparezca con la etiqueta \"No es seguro\" en la barra de direcciones.\n\nDefinir la lista de URLs de esta política tiene el mismo resultado que asignar la marca de línea de comandos --unsafely-treat-insecure-origin-as-secure a una lista con las mismas URLs separadas por comas. Esta política anula tanto la marca de línea de comandos como UnsafelyTreatInsecureOriginAsSecure si está presente.\n\nPara obtener más información sobre contextos seguros, consulta la página Secure Contexts (https://www.w3.org/TR/secure-contexts).";
PartitionedBlobUrlUsage.pfm_title = "Elegir si las URLs blob se particionan durante la obtención y la navegación";
PartitionedBlobUrlUsage.pfm_description = "Esta política controla si las URLs blob se particionan durante la obtención y la navegación.\nSi se habilita esta política o no se define, las URLs blob se particionarán.\nSi se inhabilita esta política, las URLs blob no se particionarán.\n\nSi tienes que usar esta política, registra un error en Brave y explica cómo la quieres usar. Se prevé que esta política esté disponible en la versión 146 de Brave. Después, la antigua implementación se eliminará.\n\nNOTA: Solo los procesos de renderizado que se hayan iniciado recientemente reflejarán los cambios de esta política mientras se esté ejecutando el navegador.\n\nPara obtener información detallada sobre la partición del almacenamiento de terceros, consulta https://developers.google.com/privacy-sandbox/cookies/storage-partitioning.";
PasswordDismissCompromisedAlertEnabled.pfm_title = "Habilitar la opción de cerrar alertas de contraseñas vulneradas para credenciales introducidas";
PasswordDismissCompromisedAlertEnabled.pfm_description = "Si esta política se habilita o no se establece, el usuario tiene la opción de cerrar o restaurar las alertas de contraseñas vulneradas.\n\nSi se inhabilita este ajuste, los usuarios no podrán cerrar las alertas de contraseñas vulneradas. Si se habilita, los usuarios podrán cerrar las alertas de contraseñas vulneradas.";
PasswordLeakDetectionEnabled.pfm_title = "Habilita la detección de filtraciones de datos para las credenciales introducidas";
PasswordLeakDetectionEnabled.pfm_description = "Si se habilita esta política, se permitirá que los usuarios hagan que Brave compruebe si los nombres de usuario y las contraseñas que han escrito forman parte de alguna filtración de datos.\n\nSi se inhabilita esta política, los usuarios no podrán usar esta función.\n\nSi se asigna un valor a esta política, los usuarios no podrán cambiarla en Brave. Si no se le asigna ningún valor, se permitirá la comprobación de filtraciones de credenciales, pero el usuario podrá desactivarla.";
PasswordManagerBlocklist.pfm_title = "Configurar la lista de dominios en los que se inhabilitará Password Manager (guardar y rellenar)";
PasswordManagerBlocklist.pfm_description = "Configura la lista de dominios en los que Brave debe inhabilitar Password Manager. Esto significa que los flujos de trabajo de guardar y rellenar se desactivarán, lo que asegura que las contraseñas de esos sitios web no se puedan guardar ni rellenar automáticamente en formularios web.\n\nSi un dominio está en la lista, se inhabilitará Password Manager en dicho dominio.\n\nSi no aparece en la lista, Password Manager estará disponible en el dominio en cuestión.\n\nSi no se define esta política, Password Manager estará disponible en todos los dominios.\n\nPara obtener información detallada sobre los patrones válidos de URL, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
PasswordManagerEnabled.pfm_title = "Habilitar el almacenamiento de contraseñas en el gestor de contraseñas";
PasswordManagerEnabled.pfm_description = "Esta política controla la capacidad del navegador de recordar automáticamente contraseñas en sitios web y de guardarlas en el gestor de contraseñas integrado. No restringe el acceso ni cambia el contenido de las contraseñas que se han guardado en el gestor de contraseñas y que posiblemente se hayan sincronizado con el perfil de la cuenta de Google y con Android.\n\nSi se habilita esta política, los usuarios podrán hacer que Brave recuerde las contraseñas y se las proporcione la próxima vez que inicien sesión en un sitio.\n\nSi se inhabilita, los usuarios no podrán guardar las nuevas contraseñas, pero las contraseñas guardadas anteriormente seguirán funcionando.\n\nSi se define esta política, los usuarios no podrán modificarla en Brave. Si no se define, los usuarios podrán desactivar el guardado de contraseñas.";
PasswordManagerPasskeysEnabled.pfm_title = "Habilitar el almacenamiento de llaves de acceso en el Gestor de contraseñas";
PasswordManagerPasskeysEnabled.pfm_description = "Esta política controla la capacidad del navegador de almacenar llaves de acceso en el Gestor de contraseñas integrado. No restringe el acceso ni cambia el contenido de las llaves de acceso que ya se han guardado en el Gestor de contraseñas. Si la política PasswordManagerEnabled se inhabilita, se inhabilitará el almacenamiento en el Gestor de contraseñas integrado en general, incluidas las llaves de acceso y las contraseñas, por lo que esta política no se aplicará.\n\nSi se habilita esta política o no se define, los usuarios podrán guardar llaves de acceso en el Gestor de contraseñas integrado si han iniciado sesión en Brave.\n\nSi se inhabilita esta política, los usuarios no podrán guardar llaves de acceso en el Gestor de contraseñas integrado, pero las llaves de acceso guardadas anteriormente seguirán funcionando.";
PasswordProtectionChangePasswordURL.pfm_title = "Configura la URL de cambio de contraseñas.";
PasswordProtectionChangePasswordURL.pfm_description = "Si se define esta política, se configurará la URL donde los usuarios podrán cambiar sus contraseñas después de ver una advertencia en el navegador. El servicio de protección de contraseñas envía a los usuarios a la URL que designes (únicamente con protocolos HTTP y HTTPS) a través de esta política. Para que Brave capture correctamente el hash con salt de la nueva contraseña en esta página de cambio de contraseña, la página debe seguir las directrices incluidas en https://www.chromium.org/developers/design-documents/create-amazing-password-forms.\n\nSi la política se desactiva o no se define, el servicio enviará a los usuarios a https://myaccount.google.com para cambiar su contraseña.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
PasswordProtectionLoginURLs.pfm_title = "Configurar la lista de las URL de acceso de empresa en las que el servicio de protección de contraseñas debería capturar los hashes con salt de las contraseñas.";
PasswordProtectionLoginURLs.pfm_description = "Si se define esta política, se configurará la lista de las URLs de acceso empresarial (únicamente con protocolos HTTP y HTTPS). El servicio de protección de contraseñas capturará los hashes con salt de las contraseñas en estas URL y las usará para detectar si la contraseña se reutiliza. Para que Brave capture correctamente los hashes con salt de las contraseñas, tus páginas de inicio de sesión deben seguir las directrices incluidas en https://www.chromium.org/developers/design-documents/create-amazing-password-forms.\n\nSi se desactiva esta opción o no se define, el servicio de protección de contraseñas solo capturará los hashes con salt de las contraseñas en https://accounts.google.com.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
PasswordProtectionWarningTrigger.pfm_title = "Activar advertencia de protección de contraseña";
PasswordProtectionWarningTrigger.pfm_description = "0 - La advertencia de protección de contraseña está desactivada\n1 - La advertencia de protección de contraseña se activa al reutilizar la contraseña\n2 - La advertencia de protección de contraseña se activa al reutilizar la contraseña en una página de phishing\nSi se establece esta política, podrás controlar la activación de la advertencia de protección de contraseñas. La protección de contraseñas avisa a los usuarios cuando reutilizan su contraseña protegida en sitios potencialmente sospechosos.\n\nUsa PasswordProtectionLoginURLs y PasswordProtectionChangePasswordURL para indicar qué contraseñas quieres proteger.\n\nSi a esta política se le asigna:\n\n* PasswordProtectionWarningOff: no se mostrará ninguna advertencia de protección de contraseñas.\n\n* PasswordProtectionWarningOnPasswordReuse: se mostrará la advertencia de protección de contraseñas cuando el usuario reutilice la contraseña protegida en sitios no permitidos.\n\n* PasswordProtectionWarningOnPhishingReuse: se mostrará la advertencia de protección de contraseñas cuando el usuario reutilice la contraseña protegida en sitios de suplantación de identidad (phishing).\n\nSi no se establece esta política, el servicio de protección de contraseñas solo protegerá las contraseñas de Google, pero el usuario podrá cambiar esta opción.";
PasswordSharingEnabled.pfm_title = "Habilitar que se puedan compartir credenciales de usuario con otros usuarios";
PasswordSharingEnabled.pfm_description = "Si se habilita esta política, los usuarios podrán recibir contraseñas de miembros de la familia y enviarles las suyas (según el servicio para familias).\nSi se habilita esta política o no se define, aparecerá un botón en el Gestor de contraseñas con el que se podrá enviar una contraseña.\nLas contraseñas recibidas se almacenan en la cuenta del usuario y están disponibles en el Gestor de contraseñas.\n\nSi se inhabilita esta política, los usuarios no podrán enviar contraseñas a otros usuarios desde el Gestor de contraseñas ni recibir las de otros usuarios.\n\nLa función no está disponible si la sincronización de contraseñas está desactivada (ya sea mediante la configuración del usuario o porque la política SyncDisabled esté habilitada).\n\nLas cuentas gestionadas no pueden unirse ni crear grupos familiares, por lo que no pueden compartir contraseñas.";
PaymentMethodQueryEnabled.pfm_title = "Permite a los sitios web consultar los métodos de pago disponibles.";
PaymentMethodQueryEnabled.pfm_description = "Permite establecer si los sitios web pueden comprobar si el usuario tiene algún método de pago guardado.\n\nSi se inhabilita esta política, se informa a los sitios web que usen la API PaymentRequest.canMakePayment o PaymentRequest.hasEnrolledInstrument de que no hay ningún método de pago disponible.\n\nSi se habilita este ajuste o no se configura, los sitios web pueden comprobar si el usuario tiene algún método de pago guardado.";
PdfAnnotationsEnabled.pfm_title = "Habilitar anotaciones en PDF";
PdfAnnotationsEnabled.pfm_description = "Controla si el visor de PDF de Brave puede anotar PDFs.\n\nSi no se define esta política o se le asigna el valor true, el visor de PDF podrá anotar PDFs.\n\nSi se le asigna el valor false, el visor de PDF no podrá anotar PDFs.";
PdfLocalFileAccessAllowedForDomains.pfm_title = "Permitir que estos sitios accedan a archivos locales mediante URLs file:// en el lector de PDFs";
PdfLocalFileAccessAllowedForDomains.pfm_description = "Si se establece esta política, los dominios indicados podrán acceder a URLs file:// en el lector de PDFs.\nSi se añaden dominios a la política, podrán acceder a URLs file:// en el lector de PDFs.\nSi se quitan dominios de la política, no podrán acceder a URLs file:// en el lector de PDFs.\nSi no se establece la política, ningún dominio podrá acceder a URLs file:// en el lector de PDFs.";
PdfUseSkiaRendererEnabled.pfm_title = "Usar el renderizador de Skia para renderizar PDFs";
PdfUseSkiaRendererEnabled.pfm_description = "Controla si el visor de PDFs de Brave usa el renderizador de Skia.\n\nSi se habilita esta política, el visor de PDFs usará el renderizador de Skia.\n\nSi se inhabilita esta política, el visor de PDFs usará el renderizador de AGG actual.\n\nSi no se establece esta política, el navegador seleccionará el renderizador de PDFs.";
PolicyAtomicGroupsEnabled.pfm_title = "Habilitar el concepto de grupos atómicos de políticas";
PolicyAtomicGroupsEnabled.pfm_description = "Si se habilita esta política, se ignorarán las políticas procedentes de un grupo atómico que no compartan la fuente con mayor prioridad del grupo.\n\nSi se inhabilita la política, no se ignorará ninguna política a causa de su fuente. Las políticas solo se ignoran si hay un conflicto y no tienen la prioridad más alta.\n\nSi esta política se configura desde la nube, no se podrá aplicar a un usuario concreto.";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "Permite combinar políticas de diccionario de fuentes distintas";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - URLs de excepción manual de usuario administrado\nDeviceLoginScreenPowerManagement - Administración de energía en la pantalla de inicio de sesión\nExtensionSettings - Configuración de administración de extensiones\nKeyPermissions - Permisos clave\nPowerManagementIdleSettings - Configuración de la administración de energía cuando el usuario está inactivo\nScreenBrightnessPercent - Porcentaje de brillo de la pantalla\nScreenLockDelays - Retrasos de bloqueo de pantalla\nSi se establece la política, se permitirá la combinación de las políticas seleccionadas cuando procedan de fuentes distintas, con los mismos permisos y el mismo nivel. Esta combinación está en las claves de primer nivel del diccionario de cada fuente. La clave procedente de la fuente con más prioridad prevalecerá.\n\nUsa el carácter comodín \"*\" para permitir la combinación de todas las políticas de diccionarios admitidas.\n\nSi una política está en la lista y hay conflicto entre fuentes con:\n\n* Los mismos permisos y niveles: los valores se combinarán en un nuevo diccionario de políticas.\n\n* Distintos permisos o niveles: la política con más prioridad se aplicará.\n\nSi una política no está en la lista y hay conflicto entre fuentes, permisos o niveles, la política con más prioridad se aplicará.";
PolicyListMultipleSourceMergeList.pfm_title = "Permite combinar listas de políticas de fuentes distintas";
PolicyListMultipleSourceMergeList.pfm_description = "Si se establece la política, se permitirá la combinación de las políticas seleccionadas cuando procedan de fuentes distintas, con los mismos permisos y el mismo nivel.\n\nUsa el carácter comodín \"*\" para permitir la combinación de todas las políticas de la lista.\n\nSi una política está en la lista y hay conflicto entre fuentes con:\n\n* Los mismos permisos y niveles: los valores se combinarán en una nueva lista de políticas.\n\n* Distintos permisos o niveles: la política con más prioridad se aplicará.\n\nSi una política no está en la lista y hay conflicto entre fuentes, permisos o niveles, la política con más prioridad se aplicará.";
PolicyRefreshRate.pfm_title = "Frecuencia con la que se actualiza la política de usuario";
PolicyRefreshRate.pfm_description = "Si se asigna un valor a esta política, se especificará el tiempo (en milisegundos) que tardará el servicio de gestión en solicitar información de la política de usuarios. Los valores válidos están comprendidos entre 1.800.000 (30 minutos) y 86.400.000 (1 día). Cualquier valor fuera de este intervalo se redondeará al límite correspondiente.\n\nSi no se le asigna ningún valor, se utilizará el valor predeterminado (3 horas).\n\nNota: Las notificaciones acerca de políticas forzarán una actualización cuando se produzca algún cambio en la política. De esta manera, no será necesario realizar actualizaciones frecuentemente. Si la plataforma admite estas notificaciones, el periodo entre actualizaciones se establecerá en 24 horas (se ignorarán los valores predeterminados y el valor de esta política).";
PopupsAllowedForUrls.pfm_title = "Permitir ventanas emergentes en estos sitios";
PopupsAllowedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios pueden abrir ventanas emergentes.\n\nSi no se establece la política, DefaultPopupsSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
PopupsBlockedForUrls.pfm_title = "Bloquear ventanas emergentes en estos sitios";
PopupsBlockedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios no pueden abrir ventanas emergentes.\n\nSi no se establece la política, DefaultPopupsSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
PreciseGeolocationAllowedForUrls.pfm_title = "Permitir la geolocalización precisa en estos sitios";
PreciseGeolocationAllowedForUrls.pfm_description = "Si se define esta política, podrás establecer una lista de patrones de URL que especifiquen qué sitios pueden acceder a la geolocalización de alta precisión del usuario sin tener que solicitar primero su permiso para hacerlo.\n\nSi no se define esta política, se aplicará DefaultGeolocationSetting a todos los sitios (si se ha definido). Si no, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
PreferSlowCiphers.pfm_title = "Dar prioridad a los algoritmos de cifrado específicos para TLS";
PreferSlowCiphers.pfm_description = "cnsa - Dar prioridad a los algoritmos de cifrado que cumplan los requisitos de CNSA 1.0 y 2.0\ndefault - Usar el orden del algoritmo de cifrado predeterminado de Brave\nEsta política configura Brave para que ordene sus algoritmos de cifrado preferidos en TLS 1.3, de forma que se refleje una preferencia por los algoritmos que se hayan aprobado conforme a un régimen de cumplimiento específico.\n\nSi se define esta política, no se garantiza que se negocien algoritmos específicos.\n\nEsta política permite que los operadores de servidores que quieran admitir clientes con y sin requisitos de cumplimiento normativo distingan entre esos clientes y solo usen determinados algoritmos no predeterminados con mayor potencia criptográfica para aquellos clientes que estén configurados explícitamente para preferirlos.\n\nSi se asigna el valor cnsa a esta política, se configura Brave para que prefiera los algoritmos de cifrado necesarios para cumplir los requisitos de las versiones 1.0 y 2.0 del Commercial National Security Algorithm Suite (CNSA 1.0 y 2.0).\n\nSi no se define esta política o se le asigna el valor default, Brave se configurará para que use sus algoritmos de cifrado predeterminados.\n\nNo es necesario definir esta política por motivos de seguridad. La criptografía predeterminada que usa Brave es lo suficientemente potente como para resistir un ataque de fuerza bruta que utilice toda la energía del Sol.\n\nSi se define esta política, Brave será más lento al acceder a sitios web.\n\nEsta política solo afecta a TLS 1.3 y QUIC, no a versiones anteriores de TLS.\n\nEsta política se puede definir para el equipo y para el usuario. Si se define para el usuario, la política solo afectará a las solicitudes de red iniciadas por el perfil de usuario y puede que no afecte a las solicitudes de red realizadas por Brave para llevar a cabo tareas en segundo plano en todo el navegador; esas las controla el valor a nivel de equipo. Si esta política se define tanto a nivel de equipo como de usuario, se aplicará el valor a nivel de equipo, a menos que la política CloudUserPolicyOverridesCloudMachinePolicy haya cambiado el orden de prioridad de las políticas.\n\nEn las versiones 155 y anteriores, esta política se aplica exclusivamente a todo el equipo.";
PreferSlowKexAlgorithms.pfm_title = "Dar prioridad a los algoritmos de intercambio de claves específicos para TLS";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - Dar prioridad a los métodos de intercambio de claves que cumplan los requisitos de CNSA 2.0\ndefault - Usar los grupos admitidos predeterminados de Brave\nEsta política configura Brave para que ordene sus algoritmos de acuerdo de claves preferidos (grupos admitidos) en TLS 1.3, de forma que se refleje una preferencia por los algoritmos que se hayan aprobado conforme a un régimen de cumplimiento específico.\n\nSi se define esta política, no se garantiza que se negocien algoritmos específicos.\n\nEsta política permite que los operadores de servidores que quieran admitir clientes con y sin requisitos de cumplimiento normativo distingan entre esos clientes y solo usen determinados algoritmos no predeterminados con mayor potencia criptográfica para aquellos clientes que estén configurados explícitamente para preferirlos.\n\nSi se asigna el valor cnsa2 a esta política, se configura Brave para que prefiera los métodos de intercambio de claves necesarios para cumplir los requisitos del Commercial National Security Algorithm Suite 2.0 (CNSA 2.0).\n\nSi no se define esta política o se le asigna el valor default, Brave se configura para que use sus métodos predeterminados de intercambio de claves.\n\nNo es necesario definir esta política por motivos de seguridad. La criptografía predeterminada que usa Brave es lo suficientemente potente como para resistir un ataque de fuerza bruta que utilice toda la energía del Sol.\n\nSi se define esta política, Brave será más lento al acceder a sitios web.\n\nEsta política solo afecta a TLS 1.3 y QUIC, no a versiones anteriores de TLS.\n\nEsta política se puede definir para el equipo y para el usuario. Si se define para el usuario, la política solo afectará a las solicitudes de red iniciadas por el perfil de usuario y puede que no afecte a las solicitudes de red realizadas por Brave para llevar a cabo tareas en segundo plano en todo el navegador; esas las controla el valor a nivel de equipo. Si esta política se define tanto a nivel de equipo como de usuario, se aplicará el valor a nivel de equipo, a menos que la política CloudUserPolicyOverridesCloudMachinePolicy haya cambiado el orden de prioridad de las políticas.\n\nEn las versiones 155 y anteriores, esta política se aplica exclusivamente a todo el equipo.";
PrefetchWithServiceWorkerEnabled.pfm_title = "Permitir que la precarga de SpeculationRules se envíe a las URLs controladas por ServiceWorker";
PrefetchWithServiceWorkerEnabled.pfm_description = "La precarga de SpeculationRules se puede enviar a las URLs controladas por ServiceWorker. Sin embargo, el código antiguo no lo permitía y cancelaba las solicitudes de precarga. Esta política permite controlar el comportamiento.\n\nSi se habilita esta política o no se define, se permite que la precarga de SpeculationRules se envíe a las URLs controladas por ServiceWorker (si la marca de función PrefetchServiceWorker está habilitada). Este es el comportamiento predeterminado actual y está alineado con las especificaciones.\n\nSi se inhabilita esta política, no se permite que la precarga de SpeculationRules se envíe a las URLs controladas por ServiceWorker. Este es el comportamiento anterior.\n\nEsta política es temporal y se eliminará más adelante.";
PrintHeaderFooter.pfm_title = "Imprimir encabezados y pies de página";
PrintHeaderFooter.pfm_description = "Si se habilita la política, activa los encabezados y pies de página en la vista previa de impresión. Si se inhabilita la política, los desactiva en la vista previa de impresión.\n\nSi se le asigna un valor a esta política, los usuarios no podrán cambiarlo. Si no se establece, los usuarios deciden si se muestran o no los encabezados y pies de página.";
PrintPdfAsImageAvailability.pfm_title = "Imprimir PDF como imagen disponible";
PrintPdfAsImageAvailability.pfm_description = "Controla cómo Brave permite la opción Imprimir como imagen en Microsoft® Windows® y macOS al imprimir PDFs.\n\nAl imprimir un PDF en Microsoft® Windows® o macOS, a veces es necesario rasterizar trabajos de impresión a una imagen para que determinadas impresoras los impriman con el aspecto correcto.\n\nSi se habilita esta política, Brave hará que la opción Imprimir como imagen esté disponible en la vista previa de impresión al imprimir un PDF.\n\nSi se inhabilita la política o no se establece, Brave hará que la opción Imprimir como imagen no esté disponible para los usuarios en la vista previa de impresión. De este modo, los PDFs se imprimirán como siempre, sin rasterizarse a una imagen antes de enviarse al destino.";
PrintPdfAsImageDefault.pfm_title = "Imprimir PDF como imagen de forma predeterminada";
PrintPdfAsImageDefault.pfm_description = "Controla si Brave hace que la opción Imprimir como imagen esté definida de forma predeterminada al imprimir PDFs.\n\nSi se habilita esta política, Brave definirá la opción Imprimir como imagen de forma predeterminada en la vista previa de impresión al imprimir un PDF.\n\nSi se inhabilita esta política o no se le asigna ningún valor, la selección del usuario para la opción Imprimir como imagen no estará definida inicialmente en Brave.  Si la opción está disponible, el usuario podrá seleccionarla para cada trabajo de impresión de PDF individual.\n\nEn Microsoft® Windows® o macOS, esta política solo tiene efecto si también se ha habilitado PrintPdfAsImageAvailability.";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "Usar impresora predeterminada del sistema como opción predeterminada";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "Si se habilita la política, Brave utiliza la impresora predeterminada del SO como destino predeterminado de la vista previa de impresión.\n\nSi se inhabilita o no se establece, Brave utiliza la impresora que se usó por última vez como destino predeterminado de la vista previa de impresión.";
PrintRasterizePdfDpi.pfm_title = "PPP al rasterizar PDF para imprimir";
PrintRasterizePdfDpi.pfm_description = "Controla la resolución de impresión de imágenes cuando Brave imprime PDFs con rasterización.\n\nCuando imprimes un PDF con la opción Imprimir como imagen, puede ser útil especificar una resolución de impresión distinta a los ajustes de impresión del dispositivo o a la configuración predeterminada de PDF.  Una resolución alta aumentará notablemente el tiempo de procesamiento y de impresión, mientras que una resolución baja puede reducir la calidad de la imagen.\n\nEsta política permite especificar una resolución determinada que se usará cuando se rastericen PDFs para imprimir.\n\nSi se le asigna el valor cero a esta política o no se establece, se usará la resolución predeterminada del sistema durante la rasterización de las imágenes de la página.";
PrinterTypeDenyList.pfm_title = "Inhabilitar tipos de impresora en la lista de denegación";
PrinterTypeDenyList.pfm_description = "privet - Destinos de protocolo basados en Zeroconf, como mDNS y DNS‑SD (opción obsoleta)\nextension - Destinos basados en extensiones\npdf - El destino de Guardar como PDF y de Guardar en Google Drive en dispositivos Google Chrome OS\nlocal - Destinos en impresoras locales\ncloud - Google Cloud Print (obsoleto)\nLas impresoras de los tipos incluidos en la lista de denegación no serán visibles, y sus funciones no se podrán utilizar.\n\nSi se incluyen todos los tipos de impresora en la lista de denegación, en la práctica se inhabilitará la impresión, ya que no habrá ninguna impresora disponible a la que enviar los documentos para imprimirlos.\n\nEn las versiones anteriores a la 102, incluir cloud en la lista de denegación dará el mismo resultado que asignarle el valor false a la política CloudPrintSubmitEnabled. Para que los destinos de Google Cloud Print sigan siendo visibles, a la política CloudPrintSubmitEnabled se le debe asignar el valor true y no se debe incluir cloud en la lista de denegación. A partir de la versión 102, los destinos de Google Cloud Print no estarán disponibles ni se mostrarán, independientemente de los valores de la política.\n\nSi la política no se establece o se le asigna una lista vacía, todos los tipos de impresora serán visibles.\n\nLas impresoras de extensión, también llamadas \"destinos de proveedor de impresión\", incluyen cualquier destino que pertenezca a una extensión de Brave.\n\nLas impresoras locales, que también se denominan \"destinos de impresión nativos\", incluyen los destinos que están disponibles para los equipos locales y las impresoras compartidas de la red.";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "Restringir el modo de impresión con gráficos de fondo";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - Permitir imprimir con y sin gráficos de fondo\nenabled - Permitir imprimir solo con gráficos de fondo\ndisabled - Permitir imprimir solo sin gráficos de fondo\nRestringe el modo de impresión de gráficos de fondo. Si no se asigna ningún valor a esta política, no se aplicará ninguna restricción.";
PrintingBackgroundGraphicsDefault.pfm_title = "Modo de impresión de gráficos de fondo predeterminado";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - Habilitar el modo de impresión de gráficos de fondo de forma predeterminada\ndisabled - Inhabilitar el modo de impresión de gráficos de fondo de forma predeterminada\nAnula el modo de impresión de gráficos de fondo predeterminado.";
PrintingEnabled.pfm_title = "Habilitar impresión";
PrintingEnabled.pfm_description = "Si se habilita esta política o no se le asigna ningún valor, los usuarios podrán imprimir en Brave y no podrán cambiar este ajuste.\n\nSi se inhabilita esta política, los usuarios no podrán imprimir desde Brave. La opción de imprimir estará desactivada en el menú de tres puntos, las extensiones y las aplicaciones de JavaScript.";
PrintingPaperSizeDefault.pfm_title = "Tamaño predeterminado de impresión de página";
PrintingPaperSizeDefault.pfm_description = "Anula el tamaño predeterminado de la página de impresión.\n\nname debe contener uno de los formatos incluidos en la lista, o \"personalizado\" si el tamaño del papel necesario no está en la lista. Si se proporciona un valor \"personalizado\", se debe especificar la propiedad custom_size. Describe el ancho y altura deseados en micrómetros. De lo contrario, no se debe especificar la propiedad custom_size. Se ignorará la política que infrinja estas reglas.\n\nSi el tamaño de la página no está disponible en la impresora que elija el usuario, se ignorará esta política.\nConsulta la página https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault para obtener más información sobre el esquema y el formato.";
ProfilePickerOnStartupAvailability.pfm_title = "Disponibilidad del selector de perfil al iniciar";
ProfilePickerOnStartupAvailability.pfm_description = "0 - Selector de perfil disponible al iniciar\n1 - Selector de perfil inhabilitado al iniciar\n2 - Forzar selector de perfil al iniciar\nEspecifica si el selector de perfil se habilita, se inhabilita o se fuerza al iniciar el navegador.\n\nDe forma predeterminada no se muestra el selector de perfil si se dan las siguientes situaciones: el navegador se inicia en el modo Invitado o de incógnito, se especifica un directorio de perfil o URLs en línea de comandos, se solicita explícitamente abrir una aplicación, una notificación nativa abre el navegador, solo hay un perfil disponible o se le asigna el valor \"true\" a la política ForceBrowserSignin.\n\nSi se selecciona \"Habilitado\" (0) o no se establece la política, el selector de perfil se mostrará de forma predeterminada al inicio, pero los usuarios podrán habilitarlo o inhabilitarlo.\n\nSi se selecciona \"Inhabilitado\" (1), no se mostrará nunca el selector de perfil, y los usuarios no podrán cambiar la configuración.\n\nSi se selecciona \"Forzado\" (2), el usuario no podrá eliminar el selector de perfil. El selector de perfil se mostrará aunque solo haya un perfil disponible.";
ProfileReauthPrompt.pfm_title = "Solicitar a los usuarios que vuelvan a autenticarse en el perfil";
ProfileReauthPrompt.pfm_description = "0 - No solicitar reautenticación\n1 - Solicitar reautenticación en una pestaña\nSi a esta política se le asigna el valor \"DoNotPrompt\" o no se define, Brave no solicitará automáticamente al usuario que se vuelva a autenticar en el navegador.\n\nSi se le asigna el valor \"PromptInTab\", cuando la autenticación del usuario caduque, se abrirá inmediatamente una nueva pestaña con la página de inicio de sesión de Google. Esto solo ocurre si se usa Chrome Sync.";
ProfileSeparationDomainExceptionList.pfm_title = "Lista de dominios secundarios de separación de perfiles de empresa permitidos";
ProfileSeparationDomainExceptionList.pfm_description = "Si no se define esta política, los inicios de sesión en la cuenta no serán necesarios para crear un nuevo perfil separado.\n\nSi se define la política, los inicios de sesión en la cuenta de los dominios de la lista no serán necesarios para crear un nuevo perfil separado.\n\nA esta política se le puede asignar una cadena vacía para que se requieran todos los inicios de sesión de cuenta a la hora de crear un nuevo perfil separado.";
PromotionsEnabled.pfm_title = "Habilitar que se muestre contenido promocional";
PromotionsEnabled.pfm_description = "Si se le asigna el valor True a esta política o no se establece, Brave podrá mostrar a los usuarios contenido promocional de productos.\n\nSi se le asigna el valor False, Brave no podrá mostrar contenido promocional de productos.\n\nSi se establece esta política, controlará la presentación de contenido promocional, incluidas las páginas de bienvenida que ayudan a los usuarios a iniciar sesión en Brave, establecerá Brave como navegador predeterminado de los usuarios o les informará sobre funciones del producto.";
PromptForDownloadLocation.pfm_title = "Preguntar dónde guardar cada archivo antes de descargarlo";
PromptForDownloadLocation.pfm_description = "Si se asigna el valor \"Habilitada\" a esta política, los usuarios tendrán que indicar dónde quieren guardar cada archivo antes de descargarlo. Si se le asigna el valor \"Inhabilitada\", las descargas empezarán de inmediato, sin preguntar a los usuarios dónde quieren guardar el archivo.\n\nSi no se le asigna ningún valor, los usuarios podrán cambiar esta opción.";
PromptOnMultipleMatchingCertificates.pfm_title = "Pedir cuando varios certificados coincidan";
PromptOnMultipleMatchingCertificates.pfm_description = "Esta política controla si al usuario se le pedirá que seleccione un certificado de cliente cuando haya más de un certificado que coincida con AutoSelectCertificateForUrls.\nSi se habilita esta política, se le pedirá al usuario que seleccione un certificado de cliente cuando la política de selección automática coincida con varios certificados.\nSi se inhabilita esta política o no se establece, solo se le podrá pedir al usuario que realice una acción cuando no haya ningún certificado que coincida con la selección automática.";
ProxySettings.pfm_title = "Configuración de proxy";
ProxySettings.pfm_description = "Si se establece la política, se definirá la configuración de proxy aplicable a Chrome y a las aplicaciones ARC, que ignoran todas las opciones relacionadas con el proxy especificadas en la línea de comandos.\n\nSi no se establece la política, los usuarios podrán elegir su configuración de proxy.\n\nSi se establece la política ProxySettings, se aceptarán los siguientes campos:\n\n* ProxyMode: te permite especificar el servidor proxy que usa Chrome y evita que los usuarios cambien la configuración del proxy\n\n* ProxyPacUrl: una URL a un archivo .pac de proxy o un script PAC codificada como una URL de datos con el tipo de MIME application/x-ns-proxy-autoconfig\n\n* ProxyPacMandatory: evita que la pila de red recurra a conexiones directas con un script PAC no válida o no disponible\n\n* ProxyServer: una URL del servidor proxy\n\n* ProxyBypassList: una lista de hosts para los que se omitirá el proxy\n\nEl campo ProxyServerMode está obsoleto y se ha sustituido por el campo ProxyMode. Si en el campo ProxyMode eliges el valor:\n* direct: nunca se utiliza un proxy y se ignoran los demás campos.\n\n* system: se usa el proxy del sistema y se ignoran los demás campos.\n\n* auto_detect: se ignoran los demás campos.\n\n* fixed_servers: se usan los campos ProxyServer y ProxyBypassList.\n\n* pac_script: se usan los campos ProxyPacUrl, ProxyPacMandatory y ProxyBypassList.\n\nNota: Puedes consultar más ejemplos detallados en The Chromium Projects: https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings.\nConsulta la página https://chromeenterprise.google/policies/?policy=ProxySettings para obtener más información sobre el esquema y el formato.";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "Habilitar el generador de códigos QR";
QRCodeGeneratorEnabled.pfm_description = "Esta política habilita la función de generador de códigos QR en Brave.\n\nSi habilitas esta política o no la configuras, se habilitará la función de generador de códigos QR.\n\nSi inhabilitas esta política, se inhabilitará la función de generador de códigos QR.";
QuicAllowed.pfm_title = "Permitir protocolo QUIC";
QuicAllowed.pfm_description = "Si se habilita la política o no se establece, se permitirá que se use el protocolo QUIC en Brave.\n\nSi se inhabilita la política, no se permitirá el uso del protocolo QUIC.";
RegisteredProtocolHandlers.pfm_title = "Registrar controladores de protocolos";
RegisteredProtocolHandlers.pfm_description = "Si se establece esta política (solo según lo recomendado), podrás registrar una lista de controladores de protocolo, la cual se combinará con las listas que registre el usuario (se usarán ambos conjuntos). Establece la propiedad protocol según el esquema (por ejemplo, mailto) y la propiedad URL según el patrón de URL de la aplicación que controla el esquema especificado en el campo protocol. El patrón puede incluir un marcador de posición %s, que se sustituye por la URL controlada.\n\nLos usuarios no pueden quitar un controlador de protocolo registrado por la política. Sin embargo, si instalan un controlador predeterminado nuevo, podrán cambiar los controladores de protocolo instalados por la política.\nConsulta la página https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers para obtener más información sobre el esquema y el formato.";
RelaunchFastIfOutdated.pfm_title = "Periodo (días)";
RelaunchFastIfOutdated.pfm_description = "Especifica la antigüedad mínima de lanzamiento más allá de la cual las notificaciones de reinicio son más frecuentes. La antigüedad se calcula desde la última vez que se entregó la versión en ejecución a los clientes.\n\nSi se debe reiniciar el navegador o el dispositivo para finalizar una actualización pendiente y ha pasado más tiempo que el número de días especificado en este ajuste desde la actualización de la versión actual, a la política RelaunchNotificationPeriod se le asignará un valor de 2 horas. Si se asigna el valor 1 (\"Requerido\") a la política RelaunchNotification, los usuarios tendrán que reiniciar al final del periodo.\n\nSi no se define o si no se puede determinar la antigüedad de lanzamiento, se usará la política RelaunchNotificationPeriod para todas las actualizaciones.";
RelaunchNotification.pfm_title = "Informar al usuario de que es necesario o recomendable reiniciar el navegador o el dispositivo";
RelaunchNotification.pfm_description = "1 - Mostrar un mensaje periódico al usuario indicando que se recomienda reiniciar el navegador\n2 - Mostrar un mensaje periódico al usuario indicando que es necesario reiniciar el navegador\nInformar a los usuarios de que deben reiniciar Brave o Google Chrome OS para aplicar una actualización pendiente.\n\nEste ajuste de la política habilita las notificaciones para informar al usuario de que es necesario o recomendable reiniciar el navegador o el dispositivo. Si no se define, Brave indica al usuario que es necesario reiniciarlo mediante pequeños cambios en el menú, mientras que Google Chrome OS lo indica mediante una notificación en la bandeja del sistema. Si se le asigna el valor \"Recomendada\", se muestra una advertencia al usuario de forma periódica indicando que se recomienda reiniciar, aunque el usuario puede ignorarla y reiniciar más tarde. Si se le asigna el valor \"Obligatoria\", se muestra una advertencia al usuario de forma periódica indicando que se reiniciará el navegador cuando haya transcurrido el periodo de notificación. De forma predeterminada, este periodo dura siete días para Brave y cuatro días para Google Chrome OS, pero se puede cambiar mediante el ajuste RelaunchNotificationPeriod de la política.\n\nLa sesión del usuario se restaurará tras el reinicio.";
RelaunchNotificationPeriod.pfm_title = "Periodo de tiempo (milisegundos)";
RelaunchNotificationPeriod.pfm_description = "Permite establecer el periodo (en milisegundos) durante el cual los usuarios reciben una notificación informándoles de que deben reiniciar Brave o un dispositivo Google Chrome OS para aplicar una actualización pendiente.\n\nDurante este periodo, se informa de forma reiterada al usuario de que la actualización es necesaria. En el caso de los dispositivos Google Chrome OS, se muestra una notificación de reinicio en la bandeja del sistema de acuerdo con la política RelaunchHeadsUpPeriod. En el caso de los navegadores Brave, el menú de aplicaciones cambia para indicar que es necesario reiniciar cuando ha transcurrido un tercio del periodo de notificación. Esta notificación cambia de color cuando han transcurrido dos tercios del periodo de notificación y, de nuevo, cuando este periodo finaliza. Las notificaciones adicionales habilitadas por la política RelaunchNotification siguen esta misma programación.\n\nSi no se asigna ningún valor, se usa el periodo predeterminado de 604.800.000 milisegundos (una semana).";
RelaunchWindow.pfm_title = "Periodo de reinicio";
RelaunchWindow.pfm_description = "Especifica un periodo objetivo para el final del periodo de notificación de reinicio.\n\nA los usuarios se les notifica que es necesario reiniciar el navegador o el dispositivo en función de los ajustes de la políticas RelaunchNotification y RelaunchNotificationPeriod. Si se asigna el valor Required a la política RelaunchNotification, se forzará el reinicio de los navegadores y los dispositivos cuando termine el periodo de notificación. La política RelaunchWindow puede utilizarse para retrasar el final del periodo de notificación y hacer que coincida con un espacio de tiempo concreto.\n\nSi esta política no se establece, el periodo objetivo predeterminado de Google Chrome OS será de 2:00 a 4:00. El periodo objetivo predeterminado de Brave será todo el día (es decir, el final del periodo de notificación no se retrasará nunca).\n\nNota: Aunque la política pueda aceptar varios elementos en entries, se ignorarán todos menos el primero.\nAdvertencia: Si se establece esta política, es posible que se retrase la aplicación de actualizaciones de software.\nConsulta la página https://chromeenterprise.google/policies/?policy=RelaunchWindow para obtener más información sobre el esquema y el formato.";
RemoteAccessHostAllowClientPairing.pfm_title = "Habilitar o inhabilitar la autenticación sin PIN para host de acceso remoto";
RemoteAccessHostAllowClientPairing.pfm_description = "Si se habilita esta política o no se le asigna ningún valor, se permitirá que los usuarios sincronicen los clientes y los hosts en el momento de la conexión, y no será necesario introducir un PIN cada vez que los sincronicen.\n\nSi se inhabilita esta política, esta función no estará disponible.";
RemoteAccessHostAllowFileTransfer.pfm_title = "Permite que los usuarios con acceso remoto transfieran archivos al host y desde el host";
RemoteAccessHostAllowFileTransfer.pfm_description = "Si se habilita esta política o no se le asigna ningún valor, los usuarios conectados a un host de acceso remoto podrán transferir archivos entre el cliente y el host. Esto no se aplica a las conexiones de asistencia remota, ya que no admiten la transferencia de archivos.\n\nSi se inhabilita esta política, no se permitirá la transferencia de archivos.";
RemoteAccessHostAllowPinAuthentication.pfm_title = "Permitir métodos de autenticación con PIN y con emparejamiento para los hosts de acceso remoto";
RemoteAccessHostAllowPinAuthentication.pfm_description = "Si se habilita esta política, el host de acceso remoto podrá usar autenticaciones con PIN y con emparejamiento al aceptar conexiones de cliente.\n\nSi se inhabilita esta política, no se permitirán las autenticaciones con PIN ni con emparejamiento.\n\nSi no se define la política, el host podrá decidir si se pueden usar autenticaciones con PIN o emparejamiento.\n\nNota: Si el ajuste implica que ni el host ni el cliente admitan métodos de autenticación que no son compatibles mutuamente, la conexión se rechazará.";
RemoteAccessHostAllowRelayedConnection.pfm_title = "Habilita el uso de servidores de retransmisión por parte del host de acceso remoto";
RemoteAccessHostAllowRelayedConnection.pfm_description = "Si se habilita RemoteAccessHostFirewallTraversal, siempre y cuando se habilite RemoteAccessHostAllowRelayedConnection o no se le asigne ningún valor, los clientes remotos podrán utilizar servidores de retransmisión para conectarse a este equipo cuando no haya disponible una conexión directa (por ejemplo, debido a restricciones del cortafuegos).\n\nSi se le asigna el valor Disabled a esta política, el acceso remoto no se desactivará, pero solo se permitirán las conexiones procedentes de la misma red (sin NAT transversal ni retransmisión).";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "Permitir conexiones de acceso remoto a este equipo";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "Si se inhabilita esta política, el servicio de host de acceso remoto no se podrá iniciar ni configurar para que acepte conexiones entrantes.  Esta política no afecta a las situaciones de asistencia remota.\n\nEsta política no tendrá efecto si se habilita, se deja vacía o no se define.";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "Permitir conexiones de asistencia remota a este equipo";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "Si se inhabilita esta política, el host de asistencia remota no se podrá iniciar ni configurar para aceptar conexiones entrantes.\n\nEsta política no afecta a los accesos remotos.\n\nEsta política no impide a los administradores de empresa conectarse a dispositivos Google Chrome OS gestionados.\n\nEsta política no tendrá efecto si se habilita, se deja vacía o no se establece.";
RemoteAccessHostAllowUrlForwarding.pfm_title = "Permitir que los usuarios con acceso remoto abran URLs del host en su navegador de cliente local";
RemoteAccessHostAllowUrlForwarding.pfm_description = "Si se habilita esta política o no se define, es posible que los usuarios conectados a un host de acceso remoto puedan abrir URLs del host en su navegador de cliente local.\n\nSi se inhabilita esta política, el host de acceso remoto no podrá enviar URLs al cliente.\n\nEste ajuste no se aplica a las conexiones de asistencia remota, ya que la función no es compatible con ese modo de conexión.\n\nNota: Esta función aún no está disponible de forma general, por lo que habilitarla no implica que vaya a aparecer en la interfaz del cliente.";
RemoteAccessHostClientDomainList.pfm_title = "Configurar los nombres de dominio requeridos para los clientes de acceso remoto";
RemoteAccessHostClientDomainList.pfm_description = "Si se le asigna un valor a esta política, se especificarán los nombres de dominio del cliente que se aplicarán a los clientes de acceso remoto, y los usuarios no podrán cambiarlos. Solo se podrán conectar al host los clientes de uno de los dominios especificados.\n\nSi no se le asigna ningún valor a esta política o se le asigna una lista vacía, se aplicará la política predeterminada para el tipo de conexión. Para la asistencia remota, esta opción permite que los clientes de cualquier dominio puedan conectarse al host. En el caso del acceso remoto en cualquier momento, solo puede conectarse el propietario del host.\n\nConsulta también RemoteAccessHostDomainList.\n\nNota: Esta opción anula la política RemoteAccessHostClientDomain (si está presente).";
RemoteAccessHostClipboardSizeBytes.pfm_title = "Tamaño máximo (en bytes) que se puede transferir entre el cliente y el host mediante la sincronización del portapapeles";
RemoteAccessHostClipboardSizeBytes.pfm_description = "Si se establece esta política, los datos del portapapeles que se envíen al host y desde él se truncarán para que cumplan el límite definido por esta política.\n\nSi se asigna un valor de 0, se inhabilita la sincronización del portapapeles.\n\nEsta política afecta tanto a las situaciones de acceso remoto como a las de asistencia remota.\n\nEsta política no tendrá efecto si no se le asigna ningún valor.\n\nLa asignación de un valor que no esté dentro del intervalo mínimo/máximo puede evitar que el host se inicie.\n\nTen en cuenta que el límite superior real del tamaño del portapapeles se basa en el tamaño máximo del mensaje del canal de datos webRTC, y esta política no lo controla.";
RemoteAccessHostDomainList.pfm_title = "Configurar los nombres de dominio obligatorios para hosts de acceso remoto";
RemoteAccessHostDomainList.pfm_description = "Si se le asigna un valor a esta política, se especificarán los nombres de dominio del host que se aplicarán a los hosts de acceso remoto, y los usuarios no podrán cambiarlos. Los hosts solo se podrán compartir con cuentas registradas en uno de los nombres de dominio especificados.\n\nSi no se le asigna ningún valor a esta política o se le asigna una lista vacía, los hosts se podrán compartir con cualquier cuenta.\n\nConsulta también RemoteAccessHostClientDomainList.\n\nNota: Esta opción anulará RemoteAccessHostDomain (si está presente).";
RemoteAccessHostFirewallTraversal.pfm_title = "Habilita que se pueda pasar a través de un cortafuegos desde un host de acceso remoto.";
RemoteAccessHostFirewallTraversal.pfm_description = "Si se habilita esta política o no se le asigna ningún valor, se permitirá el uso de servidores STUN, los clientes remotos podrán detectar estos equipos y establecer conexión con ellos aunque haya un cortafuegos.\n\nSi se inhabilita esta política y hay un cortafuegos que filtre las conexiones UDP salientes, este equipo solo permitirá las conexiones de equipos cliente que se encuentren en la red local.";
RemoteAccessHostMatchUsername.pfm_title = "Requerir que el nombre del usuario local y el propietario del host de acceso remoto coincidan";
RemoteAccessHostMatchUsername.pfm_description = "Si se habilita esta política, el host de acceso remoto comparará el nombre del usuario local al que está asociado el host con el nombre de la cuenta de Google registrado como el propietario del host; por ejemplo, \"juanmartinez\" si el host pertenece a la cuenta de Google juanmartinez@example.com. Este host no se iniciará si el nombre del propietario del host es diferente al nombre del usuario local al que está asociado el host. Para establecer que la cuenta de Google del propietario se asocie a un dominio específico, usa esta política junto a RemoteAccessHostDomain.\n\nSi se inhabilita esta política o no se le asigna ningún valor, el host de acceso remoto podrá asociarse a cualquier usuario local.";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "Duración máxima permitida de la sesión para conexiones de acceso remoto";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "Si esta política se habilita, las conexiones de acceso remoto se desconectarán automáticamente después de que hayan pasado el número de minutos definido en la política. Esto no evita que el cliente pueda volver a conectarse después de que se haya alcanzado la duración máxima de la sesión. La asignación de un valor que no esté dentro del intervalo mínimo/máximo puede evitar que el host se inicie. Esta política no afecta a las situaciones de asistencia remota.\n\nEsta política no tendrá efecto si no se le asigna ningún valor. En este caso, las conexiones de acceso remoto no tendrán duración máxima en este equipo.";
RemoteAccessHostRequireCurtain.pfm_title = "Activar modo de cortina en hosts de acceso remoto";
RemoteAccessHostRequireCurtain.pfm_description = "Si se habilita esta política, los dispositivos físicos de entrada y salida del host de acceso remoto se inhabilitarán durante la conexión remota.\n\nSi se inhabilita esta política o no se le asigna ningún valor, los usuarios locales y los remotos podrán interactuar con el host cuando este se encuentre en modo compartido.";
RemoteAccessHostUdpPortRange.pfm_title = "Restringe el intervalo de puertos UDP utilizado por el host de acceso remoto";
RemoteAccessHostUdpPortRange.pfm_description = "Esta política restringe el intervalo de puertos UDP utilizado por el host de acceso remoto en este equipo.\n\nSi no se le asigna ningún valor a esta política o se le asigna una cadena vacía, el host de acceso remoto podrá utilizar cualquier puerto disponible.\n\nNota: Si se inhabilita RemoteAccessHostFirewallTraversal, el host de acceso remoto utilizará los puertos UDP del intervalo 12400‑12409.";
RemoteDebuggingAllowed.pfm_title = "Permitir depuración remota";
RemoteDebuggingAllowed.pfm_description = "Controla si los usuarios pueden usar la depuración remota.\n\nSi se habilita esta política o no se define, los usuarios podrán usar la depuración remota especificando los modificadores de línea de comandos --remote-debugging-port y --remote-debugging-pipe en ordenadores de escritorio, o habilitando el ajuste del sistema de depuración por USB en Android.\n\nSi se inhabilita esta política, los usuarios no podrán usar la depuración remota.";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "Requiere comprobaciones de OCSP/CRL online para los anclajes de veracidad locales";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "Si se asigna el valor True a esta política, Brave siempre comprobará la revocación de los certificados del servidor validados correctamente y firmados por certificados AC instalados de forma local. Si Brave no puede obtener información sobre el estado de la revocación, Brave considerará que estos certificados están revocados (modo estricto).\n\nSi se asigna el valor False a esta política o no se define, Brave usará la configuración que se esté aplicando en ese momento para comprobar la revocación online.\n\nEn macOS, esta política no tendrá efecto si se asigna el valor False a la política ChromeRootStoreEnabled.";
RestoreOnStartup.pfm_title = "Acción al iniciar";
RestoreOnStartup.pfm_description = "5 - Abrir página Nueva pestaña\n1 - Restaurar la última sesión\n4 - Abrir una lista de URLs\n6 - Abrir una lista de URLs y restaurar la última sesión\nSi se le asigna un valor a esta política, se especificará el comportamiento del sistema al iniciar el navegador. Si se desactiva esta opción, no se le asignará ningún valor, ya que Brave debe tener un comportamiento definido para iniciar el navegador.\n\nSi se le asigna un valor a esta política, los usuarios no podrán cambiarlo en Brave. Si no se le asigna ningún valor, los usuarios podrán cambiarlo.\n\nSi se le asigna el valor RestoreOnStartupIsLastSession o RestoreOnStartupIsLastSessionAndURLs a esta política, se desactivarán algunas opciones que se basan en sesiones o realizan acciones al salir, como borrar los datos de navegación o las cookies de una sola sesión.\n\nSi se le asigna el valor RestoreOnStartupIsLastSessionAndURLs a esta política, el navegador restaurará la sesión anterior y abrirá otra ventana para mostrar las URLs establecidas en RestoreOnStartupURLs. Ten en cuenta que los usuarios pueden elegir mantener esas URLs abiertas. En ese caso, esas URLs también se restaurarán en la siguiente sesión.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
RestoreOnStartupURLs.pfm_title = "URL que se deben abrir al inicio";
RestoreOnStartupURLs.pfm_description = "Si se asigna el valor RestoreOnStartupIsURLs a RestoreOnStartup, al establecer RestoreOnStartupURLs en una lista de URLs, se especificarán las URLs que se abren.\n\nSi no se le asigna ningún valor, la página Nueva pestaña se abrirá al iniciar el navegador.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "Restringir la API Background Fetch cuando se llama desde un service worker";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "Esta política controla si las solicitudes de recuperación en segundo plano de los service workers están restringidas. Si se ve afectada una función que descarga archivos en segundo plano, esta política puede ser pertinente.\n\nSi se habilita esta política o no se define, la restricción estará activa y las solicitudes de recuperación en segundo plano de contextos de service worker podrían bloquearse.\n\nSi se inhabilita esta política, se omitirá la restricción y todos los service workers podrán hacer solicitudes de recuperación en segundo plano.\n\nEsta política de empresa es temporal y se eliminará a partir de la versión M152.";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "Restringir las cuentas de Google aptas para guardar archivos PDF en Google Drive desde el visor de PDFs de Brave";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "Contiene una expresión regular para determinar qué cuentas de Google pueden guardar archivos PDF en Google Drive desde el visor de PDFs de Brave.\n\nSi un usuario intenta subir un archivo PDF a Google Drive con una cuenta que no coincida con este patrón, se mostrará un error.\n\nSi no se define esta política o se deja en blanco, el usuario podrá usar cualquier cuenta de Google para guardar archivos PDF en Google Drive.";
RestrictSigninToPattern.pfm_title = "Restringir las cuentas de Google que se pueden establecer como cuentas principales de navegador en Brave";
RestrictSigninToPattern.pfm_description = "Contiene una expresión regular que se usa para determinar qué cuentas de Google pueden establecerse como cuentas principales de navegador en Brave (por ejemplo, la cuenta elegida durante el proceso de activación de la sincronización).\n\nSi el usuario intenta establecer una cuenta principal de navegador con un nombre de usuario que no coincide con este patrón, se muestra un error.\n\nSi la política no se configura o no se le asigna ningún valor, el usuario puede establecer cualquier cuenta de Google como la cuenta principal de navegador en Brave.";
RestrictYouTubeCookiesDeletion.pfm_title = "Restringir la eliminación de cookies de YouTube";
RestrictYouTubeCookiesDeletion.pfm_description = "Impide la eliminación manual de cookies de YouTube.\n\nEsta política está pensada para evitar que los usuarios accedan a YouTube sin autorización después de borrar manualmente sus cookies de YouTube desde la página de configuración del sitio.\n\nSi se habilita esta política, las cookies de YouTube no se podrán eliminar manualmente.\n\nSi se inhabilita esta política o no se define, las cookies de YouTube se podrán eliminar con normalidad.\n\nNota: Esta política solo impide la eliminación manual desde la interfaz de usuario de la configuración del sitio. No impide que las políticas ClearBrowsingDataOnExitList o BrowsingDataLifetime eliminen automáticamente el contenido. Además, si se habilita la política AllowDeletingBrowserHistory, los usuarios podrán seguir borrando todas sus cookies mediante el cuadro de diálogo Borrar datos de navegación.";
SSLErrorOverrideAllowed.pfm_title = "Permitir que se continúe desde la página de advertencia de SSL";
SSLErrorOverrideAllowed.pfm_description = "Si la política se habilita o no se define, los usuarios podrán hacer clic para ignorar las páginas de advertencia que muestra Brave cuando intentan acceder a sitios web con errores SSL.\n\nSi la política se inhabilita, los usuarios no podrán hacer clic para ignorar las páginas de advertencia.";
SSLErrorOverrideAllowedForOrigins.pfm_title = "Permitir seguir navegando desde la página de advertencia de SSL en orígenes concretos";
SSLErrorOverrideAllowedForOrigins.pfm_description = "Si se inhabilita la política SSLErrorOverrideAllowed, al definirla podrás establecer una lista de patrones de origen que especifiquen los sitios en los que el usuario puede hacer clic para ignorar las páginas de advertencia que mostrará Brave cuando el usuario intente acceder a sitios con errores de SSL. Los usuarios no podrán hacer clic para ignorar las páginas de advertencia de SSL en los orígenes que no estén incluidos en esa lista.\n\nSi se habilita SSLErrorOverrideAllowed o no se define, esta política no tendrá ningún efecto.\n\nSi no se define esta política, SSLErrorOverrideAllowed se aplicará a todos los sitios.\n\nPara obtener información detallada sobre los patrones de entrada válidos, consulta https://chromeenterprise.google/policies/url-patterns/. * no es un valor aceptado para esta política. Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.";
SafeBrowsingAllowlistDomains.pfm_title = "Configura la lista de dominios en los que la Navegación segura no activará advertencias.";
SafeBrowsingAllowlistDomains.pfm_description = "Si se habilita esta política, Navegación segura confiará en los dominios que indiques. No comprobará si contienen recursos peligrosos, como phishing, malware o software no deseado. El servicio de protección de descargas de Navegación segura no comprobará las descargas alojadas en estos dominios. Su servicio de protección de contraseñas no comprobará si se reutilizan contraseñas.\n\nSi no se define la política, se aplicará la protección predeterminada de Navegación segura a todos los recursos.\n\nEsta política no admite expresiones regulares, pero los subdominios de un dominio determinado se añaden a la lista de permitidos. No es obligatorio indicar los nombres de dominios completos.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.";
SafeBrowsingDeepScanningEnabled.pfm_title = "Permitir el análisis profundo de las descargas a los usuarios con la Navegación segura habilitada";
SafeBrowsingDeepScanningEnabled.pfm_description = "Si esta política se habilita o no se define, Brave podrá enviar a Google las descargas sospechosas de usuarios con la Navegación segura habilitada para analizarlas en busca de malware o pedir a los usuarios que proporcionen una contraseña para los archivos cifrados.\nSi se inhabilita la política, no se realizará este análisis.\nEsta política no afecta al análisis del contenido de las descargas configurado por Chrome Enterprise Connectors.";
SafeBrowsingProtectionLevel.pfm_title = "Nivel de protección de Navegación segura";
SafeBrowsingProtectionLevel.pfm_description = "0 - Navegación segura nunca está activa.\n1 - La función Navegación segura está activa en modo estándar.\n2 - Navegación segura está activa en modo mejorado. Este modo proporciona mayor seguridad, pero requiere compartir más información de navegación con Google.\nTe permite controlar si la función Navegación segura de Brave está habilitada y el modo en el que funciona.\n\nSi se le asigna el valor NoProtection (valor 0) a esta política, Navegación segura no estará activa nunca.\n\nSi se le asigna el valor StandardProtection (valor 1, que es el predeterminado), Navegación segura estará siempre activa en modo Estándar.\n\nSi se le asigna el valor EnhancedProtection (valor 2), Navegación segura estará siempre activa en modo Mejorado, que aunque proporciona mayor seguridad, requiere compartir más información de navegación con Google.\n\nSi defines esta política como obligatoria, los usuarios no podrán cambiar ni anular el ajuste Navegación segura en Brave.\n\nSi no se define esta política, Navegación segura funcionará en modo Protección estándar, pero los usuarios podrán cambiar este ajuste.\n\nConsulta https://support.google.com/chrome?p=safe_browsing_preferences para obtener más información sobre Navegación segura.";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "Permitir comprobaciones mediante proxy en tiempo real de Navegación segura";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "Controla si el modo Protección estándar de Navegación segura puede enviar hashes parciales de URLs a Google mediante un proxy, a través de Oblivious HTTP, para determinar si es seguro visitar las URLs.\n\nEl proxy permite que los navegadores suban hashes parciales de URLs a Google sin vincularlos con la dirección IP del usuario. La política también permite que los navegadores suban hashes parciales de URLs con más frecuencia para mejorar la calidad de la protección de Navegación segura.\n\nEsta política se ignorará si se desactiva Navegación segura o si se le asigna el modo de protección mejorada.\n\nSi se habilita esta política o no se establece, se permitirán las consultas de mayor protección mediante proxy.\n\nSi se inhabilita esta política, no se permitirán las consultas de mayor protección mediante proxy. Los hashes parciales de las URLs se subirán directamente a Google con mucha menos frecuencia, lo que disminuirá la protección.";
SafeBrowsingSurveysEnabled.pfm_title = "Permitir encuestas sobre Navegación segura";
SafeBrowsingSurveysEnabled.pfm_description = "Si se habilita esta política o no se define, el usuario podrá recibir encuestas relacionadas con Navegación segura.\nSi se inhabilita esta política, el usuario no recibirá encuestas relacionadas con Navegación segura.";
SafeSitesFilterBehavior.pfm_title = "Controlar el filtrado de contenido para adultos de SafeSites.";
SafeSitesFilterBehavior.pfm_description = "0 - No filtrar el contenido para adultos de los sitios web\n1 - Filtrar el contenido para adultos de los sitios\nSi se define la política, controla el filtro de URL SafeSites, que usa la API Google Safe Search para clasificar las URL como pornográficas o no.\n\nCuando se asignan estos valores:\n\n* No filtrar el contenido para adultos de los sitios, o no se le asigna ningún valor a la política: los sitios no se filtran.\n\n* Filtrar el contenido para adultos de los sitios: los sitios pornográficos se filtran.\n\nLa política se aplica tanto a la URL a la que va el usuario como a los iframes. La política URLAllowlist prevalece sobre esta política y se puede usar para anular los veredictos de la API Google Safe Search.";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "Permitir la captura de pestañas con el mismo origen de estos orígenes";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "Si se define la política, se podrá establecer una lista de los patrones de URL que pueden hacer capturas de pestañas con el mismo origen.\n\nSi no se define la política, no se tendrán en cuenta los sitios para una anulación a este nivel de captura.\n\nSe seguirá permitiendo la captura en las aplicaciones de Chrome con ventanas que tengan el mismo origen que el sitio en cuestión.\n\nSi un sitio coincide con un patrón de URL en esta política, no se tendrán en cuenta las siguientes políticas: TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/.  Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.";
SandboxExternalProtocolBlocked.pfm_title = "Permitir que Chrome bloquee el acceso a protocolos externos dentro de iframes en entornos aislados";
SandboxExternalProtocolBlocked.pfm_description = "Chrome bloqueará el acceso a protocolos externos dentro de iframes\nen entornos aislados. Consulta https://chromestatus.com/features/5680742077038592.\n\nSi se le asigna el valor True, Chrome podrá bloquear esos accesos.\n\nSi se le asigna el valor False, Chrome no podrá bloquear esos accesos.\n\nEl valor predeterminado es True (función de seguridad habilitada).\n\nEsta opción la pueden utilizar los administradores que necesitan más tiempo para actualizar su sitio web interno afectado por esta nueva restricción. Esta política de Enterprise es temporal. Está previsto que se retire después de la versión 117 de Brave.\n";
SavingBrowserHistoryDisabled.pfm_title = "Inhabilitar almacenamiento del historial de navegación";
SavingBrowserHistoryDisabled.pfm_description = "Si la política se habilita, no se almacenará el historial de navegación y se inhabilitará la sincronización de pestañas. Los usuarios no pueden cambiar esta opción.\n\nSi esta política se inhabilita o no se define, se guardará el historial de navegación.";
ScreenCaptureAllowed.pfm_title = "Permitir o denegar capturas de pantalla";
ScreenCaptureAllowed.pfm_description = "Si se habilita o no se configura (opción predeterminada), una página web puede usar\nAPIs de pantalla compartida (como getDisplayMedia() o la API de extensión de captura de pantalla en ordenadores)\npara pedir al usuario que elija de qué pestaña, ventana o escritorio quiere hacer una captura de pantalla.\n\nCuando esta política esté inhabilitada, aparecerá un error en las llamadas de las\nAPIs de pantalla compartida. Sin embargo, esta política no se tendrá en cuenta (y se permitirá que un sitio\nuse APIs de pantalla compartida) si el sitio coincide con un patrón de origen en\ncualquiera de las siguientes políticas:\nScreenCaptureAllowedByOrigins,\nWindowCaptureAllowedByOrigins,\nTabCaptureAllowedByOrigins,\nSameOriginTabCaptureAllowedByOrigins.\n";
ScreenCaptureAllowedByOrigins.pfm_title = "Permitir la captura de escritorios, ventanas y pestañas de estos orígenes";
ScreenCaptureAllowedByOrigins.pfm_description = "Si se define la política, se podrá definir una lista de los patrones de URL que pueden usar la captura de escritorios, ventanas y pestañas.\n\nSi no se define la política, no se tendrán en cuenta los sitios para una anulación a este nivel de captura.\n\nEsta política no se tendrá en cuenta si un sitio coincide con un patrón de URL en cualquiera de las siguientes políticas: WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nSi un sitio coincide con un patrón de URL en esta política, no se tendrá en cuenta ScreenCaptureAllowed.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/.  Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "Permitir captura de pantalla sin gesto previo del usuario";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "Por motivos de seguridad, para llamar a la API web getDisplayMedia(), se requiere un gesto previo del usuario (\"activación temporal\"). De lo contrario, se producirá un error.\n\nSi se define esta política, los administradores pueden especificar los orígenes desde los que se puede llamar a esta API sin ningún gesto previo del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Esta política no acepta el valor *.\n\nSi no se define esta política, se requerirá un gesto previo del usuario para llamar a esta API desde todos los orígenes.";
ScrollToTextFragmentEnabled.pfm_title = "Habilitar el desplazamiento a texto especificado en fragmentos de URL";
ScrollToTextFragmentEnabled.pfm_description = "Esta función permite que la navegación a través de los hiperenlaces y las URL de la barra de direcciones se centre en un texto específico dentro de una página web, al cual se desplazará una vez que esta se haya cargado por completo.\n\nSi habilitas esta política o no la configuras, se habilitará el desplazamiento de una página web a un texto específico a través de la URL.\n\nSi inhabilitas esta política, se inhabilitará el desplazamiento de una página web a un texto específico a través de la URL.";
SearchContentSharingSettings.pfm_title = "Habilitar que se comparta contenido con integraciones de Google AI Mode y Lens";
SearchContentSharingSettings.pfm_description = "0 - Permitir que se comparta contenido con integraciones de Google AI Mode.\n1 - No permitir que se comparta contenido con integraciones de Google AI Mode.\nEsta política controla el uso compartido de contenido de páginas y archivos con el Google AI Mode y Lens mediante el panel lateral o las pestañas de Google Chrome.\n\nTen en cuenta que esta política no afecta al Google AI Mode en la Web. Solo controla cómo pueden los usuarios compartir información con la función cuando usan Google Chrome.\n\nSi se le asigna el valor 0, los usuarios pueden compartir contenido de páginas o archivos con el Google AI Mode.\n\nSi se le asigna el valor 1, los usuarios no pueden compartir contenido de páginas ni archivos con el Google AI Mode. Los puntos de entrada para compartir contexto y el panel lateral se inhabilitarán u ocultarán.\n\nEsta política se ignorará cuando la Google Search no sea el buscador predeterminado de los usuarios, ya que la función está inhabilitada.\n\nEsta política es independiente de la política AIModeSettings. La política AIModeSettings solo controla los puntos de entrada en el omnibox o en el cuadro de búsqueda de una nueva pestaña, mientras que esta política controla el uso compartido de contexto mediante el panel lateral o de las pestañas.\n\nEsta política tampoco controla la integración de Google Gemini, que se puede inhabilitar mediante GeminiSettings.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
SearchSuggestEnabled.pfm_title = "Habilitar sugerencias de búsqueda";
SearchSuggestEnabled.pfm_description = "Si se le asigna el valor True a esta política, se activarán las sugerencias de búsqueda en la barra de direcciones de Brave. Si se le asigna el valor False, se desactivarán esas sugerencias de búsqueda.\n\nEsta política no afecta a las sugerencias basadas en los marcadores o en el historial.\n\nSi le asignas un valor a esta política, los usuarios no podrán cambiarlo. Si no le asignas ningún valor, las sugerencias de búsqueda estarán activadas inicialmente, pero los usuarios podrán desactivarlas en cualquier momento.";
SecurityKeyPermitAttestation.pfm_title = "Las URL y los dominios han permitido automáticamente la confirmación directa de la llave de seguridad";
SecurityKeyPermitAttestation.pfm_description = "Si se define esta política, se especificarán los IDs RP de WebAuthn para los que no se mostrará ningún mensaje cuando se soliciten certificados de atestación de llaves de seguridad. Asimismo, se enviará una señal a la llave de seguridad para indicar que es posible que se utilice esa atestación empresarial. Sin esta política, cuando los sitios web soliciten la atestación de las llaves de seguridad, los usuarios de la versión 65 y versiones posteriores de Brave verán un mensaje.";
SensorsAllowedForUrls.pfm_title = "Permitir el acceso a los sensores en estos sitios web";
SensorsAllowedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios pueden acceder a los sensores, como los de luz o movimiento.\n\nSi no se establece la política, DefaultSensorsSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nSi se incluye el mismo patrón de URL en esta política y en la política SensorsBlockedForUrls, tendrá preferencia esta última y se bloqueará el acceso a los sensores de luz o de movimiento.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
SensorsBlockedForUrls.pfm_title = "Bloquear el acceso a los sensores en estos sitios web";
SensorsBlockedForUrls.pfm_description = "Si se establece la política, podrás definir una lista de patrones de URL donde se especifique qué sitios no pueden acceder a los sensores, como los de luz o movimiento.\n\nSi no se establece la política, DefaultSensorsSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nSi se incluye el mismo patrón de URL en esta política y en la política SensorsAllowedForUrls, tendrá preferencia esta política y se bloqueará el acceso a los sensores de luz o de movimiento.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
SerialAllowAllPortsForUrls.pfm_title = "Permite conceder permiso automáticamente a sitios para conectarse a todos los puertos serie.";
SerialAllowAllPortsForUrls.pfm_description = "Establecer esta política permite definir una lista de sitios a los que se les concederá permiso automáticamente para acceder a todos los puertos serie disponibles.\n\nLas URLs deben ser válidas; si no, se ignorará la política. Solo se tiene en cuenta el origen de la URL (esquema, host y puerto).\n\nEn Google Chrome OS, esta política solo se aplica a usuarios afiliados.\n\nEsta política anula las políticas DefaultSerialGuardSetting, SerialAskForUrls y SerialBlockedForUrls, así como las preferencias del usuario.";
SerialAllowUsbDevicesForUrls.pfm_title = "Permite conceder permiso automáticamente a sitios para conectarse a dispositivos serie USB.";
SerialAllowUsbDevicesForUrls.pfm_description = "Establecer esta política permite definir una lista de sitios a los que se les concederá permiso automáticamente para acceder a dispositivos serie USB que tengan IDs de proveedor y de producto coincidentes con los campos vendor_id y product_id. Si se omite el campo product_id, los sitios establecidos obtendrán permiso para acceder a los dispositivos que tengan un ID de proveedor coincidente con el campo vendor_id y con cualquier ID de producto.\n\nLas URLs deben ser válidas; si no, se ignorará la política. Solo se tiene en cuenta el origen de la URL (esquema, host y puerto).\n\nEn ChromeOS, esta política solo se aplica a usuarios afiliados.\n\nEsta política anula las políticas DefaultSerialGuardSetting, SerialAskForUrls y SerialBlockedForUrls, así como las preferencias del usuario.\n\nEsta política solo afecta al acceso a los dispositivos USB a través de la API Web Serial. Para conceder acceso a dispositivos USB a través de la API WebUSB, consulta la política WebUsbAllowDevicesForUrls.\nConsulta la página https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls para obtener más información sobre el esquema y el formato.";
SerialAskForUrls.pfm_title = "Permitir la API Serial en estos sitios web";
SerialAskForUrls.pfm_description = "Si estableces esta política, podrás definir una lista de patrones de URL donde se especifique qué sitios pueden pedir a los usuarios que les permitan acceder a un puerto serie.\n\nSi no se establece la política, DefaultSerialGuardSetting se aplicará a todos los sitios, si se ha definido. Si no se ha definido, se aplicará la configuración personal del usuario.\n\nEn el caso de los patrones de URL que no se incluyan en la política, tendrá preferencia la política SerialBlockedForUrls (si esta los incluye), la política DefaultSerialGuardSetting (si se ha establecido) o los ajustes personales de los usuarios, en ese orden.\n\nSi los patrones de URL entran en conflicto con la política SerialBlockedForUrls, estos se ignorarán.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
SerialBlockedForUrls.pfm_title = "Bloquear la API Serial en estos sitios web";
SerialBlockedForUrls.pfm_description = "Si estableces esta política, podrás definir una lista de patrones de URL donde se especifique qué sitios no pueden pedir a los usuarios que les permitan acceder a un puerto serie.\n\nSi no se establece la política, DefaultSerialGuardSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nEn el caso de los patrones de URL que no se incluyan en la política, tendrá preferencia la política SerialAskForUrls (si esta los incluye), la política DefaultSerialGuardSetting (si se ha establecido) o los ajustes personales de los usuarios, en ese orden.\n\nSi los patrones de URL entran en conflicto con la política SerialAskForUrls, esta política tendrá prioridad.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
ServiceWorkerAutoPreloadEnabled.pfm_title = "Permitir que ServiceWorker envíe solicitudes de navegación sin esperar a que se inicie";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nLa función ServiceWorkerAutoPreload envía una solicitud de red de un recurso principal al mismo tiempo que inicia el proceso de arranque de ServiceWorker.\n\nSi se habilita esta política o no se define, Brave habilitará ServiceWorkerAutoPreload. La solicitud de navegación se envía automáticamente al iniciar el ServiceWorker en algunos casos, como cuando el ServiceWorker no se está ejecutando.\n\nSi está inhabilitada, Brave no habilitará ServiceWorkerAutoPreload. La solicitud de navegación se envía siempre después de iniciar el ServiceWorker.\n\nEsta política es una medida temporal para controlar la función y se eliminará en la versión M154.";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "Permitir que los ServiceWorkers controlen los iframes srcdoc";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "https://github.com/w3c/ServiceWorker/issues/765 pide que el iframe srcdoc con el atributo de entorno aislado \"allow-same-origin\" esté bajo el control de un ServiceWorker.\n\nSi se habilita esta política o no se define, Brave hará que los iframes srcdoc con atributos de entorno aislado \"allow-same-origin\" estén bajo el control de un ServiceWorker.\n\nSi se inhabilita esta política, el iframe srcdoc no estará controlado por un ServiceWorker.\n\nEsta política es temporal y se eliminará en el 2026.";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "Especifica si SharedArrayBuffers se puede usar en un contexto que no está aislado en orígenes cruzados";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\nEspecifica si SharedArrayBuffers se puede usar en un contexto no aislado de otros orígenes. Brave requerirá el aislamiento de otros orígenes cuando se use SharedArrayBuffers en Brave 91 o posterior (25-05-2021) por motivos de compatibilidad con la Web. Información adicional disponible en: https://developer.chrome.com/blog/enabling-shared-array-buffer/.\n\nSi se habilita, los sitios podrán usar SharedArrayBuffer sin restricciones.\n\nSi se inhabilita o no se le asigna ningún valor, los sitios solo podrán usar SharedArrayBuffers si están aislados de otros orígenes.";
SharedWorkerBlobURLFixEnabled.pfm_title = "Hacer que el comportamiento de las URLs de blobs de SharedWorker se ajuste a la especificación";
SharedWorkerBlobURLFixEnabled.pfm_description = "Según https://w3c.github.io/ServiceWorker/#control-and-use-worker-client,\nlos trabajadores deben heredar controladores para la URL de blob.  Sin embargo, el código actual solo permite que los DedicatedWorkers hereden el controlador y los SharedWorkers no heredan el controlador.\n\nSi se habilita esta política o no se define, Brave heredará el controlador si se usa una URL de blob como URL de SharedWorker.\n\nSi se inhabilita esta política, el comportamiento no se ajustará a la especificación.\n\nEsta política es temporal y se eliminará más adelante.";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "Habilitar la duración ampliada de los SharedWorkers";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "Los SharedWorkers pueden tener una duración ampliada si la opción \"extendedLifetime\" se define como true en el constructor de SharedWorker.\n\nSi se habilita esta política o no se define, los SharedWorkers podrán tener una duración ampliada.\n\nSi se inhabilita esta política, los SharedWorkers no podrán tener una duración ampliada aunque la opción se haya definido como true.\n\nEsta política es temporal y se eliminará más adelante.";
ShoppingListEnabled.pfm_title = "Permitir que se habilite la función de lista de la compra";
ShoppingListEnabled.pfm_description = "Esta política controla la disponibilidad de la función de lista de la compra.\nSi se habilita, se mostrará una interfaz a los usuarios para hacer un seguimiento del precio del producto que aparezca en la página actual. El producto seguido se mostrará en el panel lateral de marcadores.\nSi se habilita esta política o no se define, la función de lista de la compra estará disponible para los usuarios.\nSi se inhabilita esta política, la función de lista de la compra no estará disponible.\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "Mostrar el acceso directo de aplicaciones en la barra de marcadores";
ShowAppsShortcutInBookmarkBar.pfm_description = "Si se asigna el valor \"Verdadero\" a esta política, se mostrarán los accesos directos a aplicaciones. Si se le asigna el valor \"Falso\", no se mostrarán nunca estos accesos directos.\n\nSi le asignas un valor a esta política, los usuarios no podrán cambiarlo. Si no se le asigna ninguno, los usuarios decidirán si se muestran o se ocultan los accesos directos a aplicaciones en el menú contextual de la barra de marcadores.";
ShowCastIconInToolbar.pfm_title = "Mostrar el icono de la barra de herramientas de Google Cast";
ShowCastIconInToolbar.pfm_description = "Si se habilita esta política, se mostrará el icono de la barra de herramientas para enviar contenido en la barra de herramientas o en el menú adicional, y los usuarios no podrán quitarlo.\n\nSi se inhabilita o no se define, los usuarios podrán fijar o quitar el icono a través del menú contextual.\n\nSi se inhabilita la política EnableMediaRouter, el valor de esta política no tendrá efecto y el icono de la barra de herramientas no se mostrará.";
ShowCastSessionsStartedByOtherDevices.pfm_title = "Mostrar controles multimedia para las sesiones de Google Cast iniciadas por otros dispositivos en la red local";
ShowCastSessionsStartedByOtherDevices.pfm_description = "Si se habilita esta política, la UI de controles de reproducción multimedia estará disponible para las sesiones de Google Cast iniciadas por otros dispositivos en la red local.\n\nSi esta política no se establece para los usuarios de empresa o se inhabilita, la UI de controles de reproducción multimedia no estará disponible para las sesiones de Google Cast iniciadas por otros dispositivos en la red local.\n\nSi la política EnableMediaRouter se inhabilita, el valor de esta política no tendrá efecto, ya que se inhabilitará toda la funcionalidad de Google Cast.";
ShowFullUrlsInAddressBar.pfm_title = "Mostrar URL completas";
ShowFullUrlsInAddressBar.pfm_description = "Esta función permite mostrar la URL completa en la barra de direcciones.\nSi se asigna el valor \"True\" a esta política, se mostrará la URL completa en la barra de direcciones, incluidos los esquemas y subdominios.\nSi se le asigna el valor \"False\", se mostrará la URL predeterminada.\nSi no se le asigna ningún valor, se mostrará la URL de forma predeterminada y el usuario podrá alternar entre esta opción y la de mostrar la URL completa usando un menú contextual.\n";
ShowHomeButton.pfm_title = "Mostrar botón de página principal en la barra de herramientas";
ShowHomeButton.pfm_description = "Si se habilita esta política, se mostrará el botón de página principal en la barra de herramientas de Brave. Si se inhabilita esta política, no se mostrará el botón de página principal.\n\nSi se le asigna un valor a esta política, los usuarios no podrán cambiarlo en Brave. Si no se le asigna ningún valor, los usuarios podrán decidir si quieren que se muestre el botón de página principal.";
SideSearchEnabled.pfm_title = "Permitir que se muestre la página más reciente de resultados del buscador predeterminado en un panel lateral del navegador";
SideSearchEnabled.pfm_description = "Si se habilita esta política o no se establece, los usuarios podrán mostrar su página más reciente de resultados del buscador predeterminado en un panel lateral mediante la activación de un icono en la barra de herramientas.\n\nSi se inhabilita esta política, se quitará de la barra de herramientas el icono que abre el panel lateral con la página de resultados del buscador predeterminado.";
SignedHTTPExchangeEnabled.pfm_title = "Habilitar compatibilidad con Signed HTTP Exchange (SXG)";
SignedHTTPExchangeEnabled.pfm_description = "Si se le asigna el valor \"Habilitada\" a esta política o no se le asigna ninguno, Brave aceptará contenidos web de tipo Signed HTTP Exchanges.\n\nSi se le asigna el valor \"Inhabilitada\", los Signed HTTP Exchanges no se podrán cargar.";
SigninInterceptionEnabled.pfm_title = "Habilitar interceptación de inicio de sesión";
SigninInterceptionEnabled.pfm_description = "Este ajuste habilita o inhabilita la interceptación de inicio de sesión.\n\nSi esta política se habilita o no se define, el cuadro de diálogo de interceptación de inicio de sesión se activará cuando se añada una cuenta de Google en la web, y el usuario tendrá la opción de mover esa cuenta a otro perfil (nuevo o ya creado).\n\nSi se inhabilita, no se activará el cuadro de diálogo de interceptación de inicio de sesión.\nCuando esté inhabilitada, se seguirá mostrando un cuadro de diálogo si la separación de perfiles de cuentas gestionadas se aplica mediante ManagedAccountsSigninRestriction.";
SilentPrintingEnabled.pfm_title = "Habilitar la impresión silenciosa";
SilentPrintingEnabled.pfm_description = "Si se asigna el valor true a esta política, se habilitará la impresión silenciosa, que cerrará inmediatamente la ventana de vista previa de impresión cuando se abra e imprimirá en la impresora predeterminada con las opciones prefijadas. Si la opción predeterminada de impresión es \"Guardar como PDF\", el archivo se guardará en la carpeta Descargas.\n\nSi no se define esta política o se le asigna el valor false, se inhabilitará la impresión silenciosa, por lo que no se cerrará automáticamente la ventana de vista previa de impresión y se pedirá al usuario que seleccione una opción.";
SitePerProcess.pfm_title = "Requerir aislamiento de sitio web para todos los sitios";
SitePerProcess.pfm_description = "Desde Brave 67, el aislamiento de sitios web ha estado habilitado de forma predeterminada en todas las versiones para ordenador, lo que hace que todos los sitios se ejecuten en su propio proceso. Un sitio consiste en un esquema más el eTLD+1 (por ejemplo, https://example.com). Si se habilita esta política, no cambia ese comportamiento. Solo evita que los usuarios cambien esta opción (por ejemplo, inhabilitando el aislamiento de sitio web de chrome://flags). Desde Brave 76, si se inhabilita la política o no se establece, no se desactiva el aislamiento de sitios web, pero los usuarios pueden inhabilitar esta opción.\n\nEs posible que IsolateOrigins también ayude a aislar orígenes específicos con una mayor granularidad que un sitio (por ejemplo, https://a.example.com).\n\nDefine la política de dispositivos DeviceLoginScreenSitePerProcess con el mismo valor en la versión 76 de Google Chrome OS y versiones anteriores. Si los valores de las dos políticas no coinciden, es posible que se produzca un retraso al acceder a una sesión de usuario.\n\nNota: En Android, usa la política SitePerProcessAndroid.";
SiteSearchSettings.pfm_title = "Configuración de búsquedas en el sitio";
SiteSearchSettings.pfm_description = "Esta política proporciona una lista de sitios en los que los usuarios pueden hacer búsquedas rápidamente mediante los accesos directos de la barra de direcciones. Los usuarios pueden iniciar la búsqueda escribiendo el acceso directo o @acceso_directo (por ejemplo, @trabajo), seguido de un espacio o un tabulador, en la barra de direcciones.\n\nLos siguientes campos son obligatorios para cada sitio: name, shortcut, url.\n\nEl campo name corresponde al nombre del sitio o del buscador que se mostrará al usuario en la barra de direcciones.\n\nshortcut puede incluir palabras y caracteres sin formato, pero no puede incluir espacios ni empezar por el símbolo \"@\". Los accesos directos también deben ser únicos.\n\nPara cada entrada, el campo url especifica la URL del buscador utilizado durante una búsqueda con la palabra clave correspondiente. La URL debe incluir la cadena '{searchTerms}', que en la consulta se sustituirá por los términos de búsqueda del usuario. Las entradas no válidas y las que tengan accesos directos duplicados se ignoran.\n\nLas entradas de búsquedas en el sitio marcadas como destacadas se muestran en la barra de direcciones cuando el usuario escribe \"@\". Se pueden seleccionar hasta tres entradas como destacadas.\n\nEn una entrada de búsqueda en el sitio en la que allow_user_override sea verdadero, los usuarios podrán editar o inhabilitar esa entrada. Sin embargo, los buscadores destacados (que empiezan por \"@\") solo se pueden inhabilitar. Si un usuario modifica una entrada creada inicialmente por esta política, dejará de estar gestionada por la política y se tratará como un acceso directo creado por el usuario. Si a allow_user_override se le aplica el valor false o no se le especifica uno en una entrada de búsqueda en sitios, los usuarios no podrán editar ni inhabilitar esa entrada. La opción para permitir la anulación por parte del usuario solo se admite en la versión M139 y posteriores. En las versiones anteriores, se inhabilitará de forma predeterminada.\n\nLos usuarios no podrán crear nuevas entradas de búsqueda en el sitio con un acceso directo creado anteriormente mediante esta política a menos que allow_user_override se configure como verdadero para la entrada de búsqueda en el sitio.\n\nEn caso de conflicto con un acceso directo creado por el usuario con anterioridad, tendrá prioridad la configuración del usuario. Sin embargo, los usuarios seguirán pudiendo activar la opción creada por la política escribiendo \"@\" en la barra de búsqueda. Por ejemplo, si el usuario ya ha definido \"trabajo\" como acceso directo a URL1 y la política define \"trabajo\" como acceso directo a URL2, al escribir \"trabajo\" en la barra de búsqueda se iniciará la búsqueda en URL1 y al escribir \"@trabajo\" la iniciará en URL2.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que estén vinculadas a un dominio de Microsoft® Active Directory® o a Microsoft® Azure® Active Directory®, o que se hayan registrado en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias que se gestionen mediante MDM, que estén vinculadas a un dominio a través de MCX o que se hayan registrado en Chrome Enterprise Core.\nConsulta la página https://chromeenterprise.google/policies/?policy=SiteSearchSettings para obtener más información sobre el esquema y el formato.";
SmartTabSharingSettings.pfm_title = "Configuración para compartir pestañas de forma inteligente";
SmartTabSharingSettings.pfm_description = "0 - Permitir que se compartan pestañas de forma inteligente con integraciones de Google AI Mode.\n1 - No permitir que se compartan pestañas de forma inteligente con integraciones de Google AI Mode.\nEsta política controla la función inteligente de compartir pestañas del Google AI Mode mediante el panel lateral o las pestañas de Google Chrome.\n\nTen en cuenta que esta política no afecta al Google AI Mode en la Web. Solo controla cómo pueden los usuarios compartir información con la función cuando usan Google Chrome.\n\nSi se le asigna el valor 0, los usuarios pueden compartir contenido de páginas o archivos con el Google AI Mode.\n\nSi se le asigna el valor 1, los usuarios no pueden compartir contenido de páginas ni archivos con el Google AI Mode. Los puntos de entrada para compartir contexto y el panel lateral se inhabilitarán u ocultarán.\n\nEsta política se ignorará cuando Google Search no sea el buscador predeterminado de los usuarios, ya que la función está inhabilitada.\n\nEsta política es independiente de la política AIModeSettings. La política AIModeSettings solo controla los puntos de entrada en el omnibox o en el cuadro de búsqueda de una nueva pestaña, mientras que esta política controla el uso compartido de contexto mediante el panel lateral o de las pestañas.\n\nEsta política tampoco controla la integración de Google Gemini, que se puede inhabilitar mediante GeminiSettings.\n\nTen en cuenta que si se inhabilita SearchContentSharingSettings, se ignorará esta política.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
SpellCheckServiceEnabled.pfm_title = "Habilitar o inhabilitar el servicio web de corrección ortográfica";
SpellCheckServiceEnabled.pfm_description = "Si se habilita esta política, se usará un servicio web de Google para ayudar a corregir errores ortográficos. Esta política solo controla el uso del servicio online. Si se inhabilita esta política, no se podrá usar este servicio.\n\nSi no se asigna ningún valor a esta política, los usuarios podrán decidir si quieren usar el servicio de corrector ortográfico.\n\nEl corrector ortográfico siempre puede usar un diccionario descargado en el almacenamiento local a no ser que esta función se haya inhabilitado con la política SpellcheckEnabled. En ese caso, esta política no tendrá ningún efecto.";
SpellcheckEnabled.pfm_title = "Habilitar corrector ortográfico";
SpellcheckEnabled.pfm_description = "Si se habilita la política, se activará el corrector ortográfico y los usuarios no podrán desactivarlo. En Microsoft® Windows®, Google Chrome OS y Linux®, los idiomas del corrector ortográfico se pueden activar o desactivar de forma individual, por lo que los usuarios podrán desactivar el corrector ortográfico inhabilitando idiomas del corrector ortográfico. Para evitarlo, usa la política SpellcheckLanguage para forzar idiomas específicos del corrector ortográfico.\n\nSi se inhabilita esta política, se inhabilitará el corrector ortográfico desde todas las fuentes y los usuarios no podrán activarlo. Las políticas SpellCheckServiceEnabled, SpellcheckLanguage y SpellcheckLanguageBlocklist no tendrán ningún efecto si se asigna el valor False a esta política.\n\nSi no se asigna ningún valor a esta política, los usuarios podrán activar o desactivar el corrector ortográfico en los ajustes de idioma.";
StandardizedBrowserZoomEnabled.pfm_title = "Habilitar el comportamiento estandarizado de zoom del navegador";
StandardizedBrowserZoomEnabled.pfm_description = "Esta política permite cumplir la especificación de zoom de CSS recientemente adoptada.\n\nSi se habilita esta política o no se define, la propiedad \"zoom\" de CSS se ajustará a la especificación:\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\nSi se inhabilita, la propiedad \"zoom\" de CSS volverá a su comportamiento antiguo anterior a la estandarización.\n\nEsta política es una tregua temporal para dar tiempo a la adaptación del contenido web al nuevo comportamiento. También hay una prueba de origen (\"DisableStandardizedBrowserZoom\") que corresponde al comportamiento cuando esta política está inhabilitada. Esta política se eliminará y el comportamiento \"Habilitado\" se hará permanente en el hito 134.";
StaticStorageQuotaEnabled.pfm_title = "Controlar si las APIs de cuota de almacenamiento devolverán valores estáticos";
StaticStorageQuotaEnabled.pfm_description = "Si se habilita, las APIs de cuota de almacenamiento devolverán un valor estático igual al uso más un mínimo (10 GiB, espacio en disco redondeado al alza en tramos de 1 GiB).\nSi se inhabilita, las APIs de cuota de almacenamiento suelen devolver un valor dinámico proporcional al espacio total disponible en el dispositivo, independientemente del uso.\nSi no se define, las APIs de cuota de almacenamiento usarán el comportamiento predeterminado de Chrome.\nLos sitios con permisos de almacenamiento ilimitado no se ven afectados por este ajuste. Tampoco se verá afectada la cuota obligatoria.";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "Habilitar la comprobación estricta de tipos de MIME para secuencias de comandos de workers";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "Esta política habilita la comprobación estricta de tipos de MIME para secuencias de comandos de workers.\n\nSi la política se habilita o no se establece, las secuencias de comandos de workers utilizarán la comprobación estricta de tipos de MIME para JavaScript, que es el nuevo comportamiento predeterminado. Las secuencias de comandos de workers con tipos de MIME antiguos se rechazarán.\n\nSi se inhabilita la política, las secuencias de comandos de workers utilizarán una comprobación poco estricta de tipos de MIME, de manera que las secuencias de comandos de workers con tipos de MIME antiguos, como text/ascii, se seguirán cargando y ejecutando.\n\nTradicionalmente, los navegadores han utilizado la comprobación poco estricta de tipos de MIME, por lo que se admitían recursos con varios tipos de MIME antiguos. Por ejemplo, en los recursos de JavaScript, text/ascii es un tipo de MIME antiguo compatible. Esto puede ocasionar problemas de seguridad, ya que permite que se carguen recursos como secuencias de comandos que nunca se han concebido para utilizarse como tales. Chrome empezará a utilizar la comprobación estricta de tipos de MIME próximamente. Si la política está habilitada, se hará un seguimiento del comportamiento predeterminado. Si está inhabilitada, los administradores podrán conservar el comportamiento antiguo si así lo desean.\n\nConsulta https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage para obtener información sobre los tipos de medios JavaScript/ECMAScript.\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "Impedir que se activen cuadros de diálogo de JavaScript desde submarcos de origen diferente";
SuppressDifferentOriginSubframeDialogs.pfm_description = "Tal como se describe en la página https://www.chromestatus.com/feature/5148698084376576, los cuadros de diálogo modales de JavaScript, activados por window.alert, window.confirm y window.prompt, se bloquearán en Brave si se activan desde un submarco cuyo origen sea diferente al del marco principal.\n\nEsta política permite anular ese cambio.\nSi se habilita esta política o no se define, se bloquearán los cuadros de diálogo de JavaScript que se activen desde un submarco de origen diferente.\nSi se inhabilita esta política, no se bloquearán los cuadros de diálogo de JavaScript que se activen desde un submarco de origen diferente.\n\nEsta política se eliminará de Brave en el futuro.";
SuppressUnsupportedOSWarning.pfm_title = "Eliminar la advertencia de SO no admitido";
SuppressUnsupportedOSWarning.pfm_description = "Si se habilita la política, se suprime la advertencia que aparece cuando Brave se ejecuta en un ordenador o en un sistema operativo que ya no es compatible.\n\nSi esta política se inhabilita o no se define, se mostrarán advertencias en sistemas no compatibles.";
SyncDisabled.pfm_title = "Inhabilitar sincronización de datos con Google";
SyncDisabled.pfm_description = "Si se le asigna el valor Enabled a esta política, se desactivará la sincronización de datos en Brave al usar los servicios de sincronización alojados por Google.\nPara desactivar los servicios de Chrome Sync por completo, te recomendamos que desactives el servicio en Google Admin console.\n\nSi se inhabilita esta política o no se le asigna ningún valor, los usuarios podrán elegir si quieren usar Chrome Sync.\n\nNota: No actives esta política si se ha habilitado RoamingProfileSupportEnabled, ya que ambas comparten la misma funcionalidad del cliente. La sincronización alojada por Google se desactivará por completo en este caso.";
SyncTypesListDisabled.pfm_title = "Lista de tipos que se deben excluir de la sincronización";
SyncTypesListDisabled.pfm_description = "Si se define esta política, todos los tipos de datos especificados se excluirán de la sincronización de Chrome Sync y de la sincronización del perfil itinerante. Esto puede ser útil para reducir el tamaño del perfil itinerante o para limitar los tipos de datos que se podrán subir a los servidores de Chrome Sync.\n\nLos tipos de datos actuales para esta política son los siguientes: \"apps\", \"autofill\", \"bookmarks\", \"extensions\", \"preferences\", \"passwords\", \"payments\", \"productComparison\", \"readingList\", \"tabs\", \"themes\", \"typedUrls\" y \"wifiConfigurations\". Estos nombres distinguen entre mayúsculas y minúsculas.\n\nNota: La actualización dinámica de esta política solo se admite en la versión 123 y posteriores de Brave. Si inhabilitas \"autofill\", también se inhabilitará \"payments\". \"typedUrls\" hace referencia a todo el historial de navegación.";
TLS13EarlyDataEnabled.pfm_title = "Habilitar TLS 1.3 Early Data";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Early Data es una extensión de TLS 1.3 para enviar una solicitud HTTP al mismo tiempo que el handshake TLS.\n\nSi esta política no se configura, Brave seguirá el proceso de lanzamiento predeterminado de TLS 1.3 Early Data.\n\nSi se habilita, Brave habilitará TLS 1.3 Early Data.\n\nSi se inhabilita, Brave no habilitará TLS 1.3 Early Data.\n\nCuando se habilite esta función, Brave podrá usar o no TLS 1.3 Early Data en función de la compatibilidad del servidor.\n\nTLS 1.3 Early Data es un protocolo establecido. Se espera que los servidores TLS, los middleboxes y el software de seguridad establecidos gestionen o rechacen TLS 1.3 Early Data sin que se pierda la conexión.\n\nSin embargo, es posible que los dispositivos que no implementen correctamente TLS no funcionen bien y se desconecten cuando se use TLS 1.3 Early Data. Si eso ocurre, los administradores deben ponerse en contacto con el proveedor para solucionarlo.\n\nEsta política es una medida temporal para controlar la función y se eliminará más adelante. La política se puede habilitar para permitirte hacer pruebas y detectar problemas, o inhabilitar mientras se resuelven problemas.";
TabCaptureAllowedByOrigins.pfm_title = "Permitir la captura de pestañas de estos orígenes";
TabCaptureAllowedByOrigins.pfm_description = "Si se define la política, se podrá definir una lista de los patrones de URL que pueden usar la captura de pestañas.\n\nSi no se define la política, no se tendrán en cuenta los sitios para una anulación a este nivel de captura.\n\nSe seguirá permitiendo la captura en las aplicaciones de Chrome con ventanas.\n\nEsta política no se tendrá en cuenta si un sitio coincide con un patrón de URL en la política SameOriginTabCaptureAllowedByOrigins.\n\nSi un sitio coincide con un patrón de URL en esta política, no se tendrán en cuenta las siguientes políticas: WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/.  Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.";
TabCompareSettings.pfm_title = "Configuración de Comparación de pestañas";
TabCompareSettings.pfm_description = "0 - Permitir la función Comparación de pestañas y mejorar los modelos de IA.\n1 - Permitir la función Comparación de pestañas sin mejorar los modelos de IA.\n2 - No permitir la función Comparación de pestañas.\nComparación de pestañas es una herramienta basada en IA para comparar la información de las pestañas de un usuario. Por ejemplo, la función se puede ofrecer al usuario cuando se abran varias pestañas con productos de una categoría similar.\n\nSi se asigna el valor 0, permite que se use la función y que Google utilice datos relevantes para mejorar sus modelos de IA. Según la función, los datos pertinentes pueden ser peticiones, entradas, resultados, materiales de origen y comentarios escritos. También es posible que los revisen un equipo de personas para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los casos indicados abajo.\n\nSi se asigna el valor 1, permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (incluyendo peticiones, entradas, resultados, materiales de origen y comentarios escritos). 1 es el valor predeterminado de los usuarios de empresa que se gestionan en la Google Admin console y de las cuentas de centro educativo que se gestionan en Google Workspace.\n\nSi se asigna el valor 2, no se permite la función.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
TabDiscardingExceptions.pfm_title = "Excepciones de patrones de URL para descartar pestañas";
TabDiscardingExceptions.pfm_description = "Esta política impide que el navegador descarte cualquier URL que coincida con uno o varios de los patrones que se especifiquen (usando el formato de filtro URLBlocklist).\nEsto se aplica al descarte de la presión de memoria y del modo Alta eficiencia.\nSe descargarán las páginas descartadas y se recuperarán todos sus recursos. Las pestañas asociadas a dichas páginas permanecerán en la barra de pestañas, pero, si las haces visibles, se volverán a cargar completamente.\n";
TaskManagerEndProcessEnabled.pfm_title = "Habilitar la finalización de procesos en el administrador de tareas";
TaskManagerEndProcessEnabled.pfm_description = "Si se inhabilita esta política, los usuarios no podrán finalizar procesos en el administrador de tareas.\n\nSi se habilita esta política o no se le asigna ningún valor, los usuarios podrán finalizar procesos en el administrador de tareas.";
ThirdPartyAiChatSettings.pfm_title = "Configuración de las integraciones del Modo IA de terceros en la barra de direcciones y en el cuadro de búsqueda de la página Nueva pestaña.";
ThirdPartyAiChatSettings.pfm_description = "0 - Permitir integraciones del Modo IA de terceros.\n1 - No permitir integraciones del Modo IA de terceros.\nEsta política controla las integraciones del Modo IA de terceros en la barra de direcciones y en el cuadro de búsqueda de una nueva pestaña.\n\nPara acceder a esta función, se debe configurar un buscador de terceros que admita el Modo IA como buscador predeterminado del usuario.\n\nSi se le asigna el valor 0, la función estará disponible para los usuarios.\n\nSi se le asigna el valor 1, la función no estará disponible para los usuarios.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "Define el límite de memoria de las instancias de Chrome";
TotalMemoryLimitMb.pfm_description = "Configura la cantidad de memoria que una única instancia de Brave puede usar antes de que se empiecen a descartar pestañas (es decir, se liberará la memoria que usa una pestaña y esta se tendrá que volver a cargar cuando se vuelva a acceder a ella) para ahorrar memoria.\n\nSi se define esta política, el navegador empezará a descartar pestañas para ahorrar memoria cuando se supere el límite de memoria. Sin embargo, no se garantiza que el navegador se ejecute siempre por debajo de ese límite. Cualquier valor que sea inferior a 1024 se establecerá como 1024.\n\nSi no se define esta política, el navegador solo intentará ahorrar memoria cuando detecte que la cantidad de memoria física del equipo es baja.";
TranslateEnabled.pfm_title = "Habilitar el Traductor";
TranslateEnabled.pfm_description = "Si se le asigna el valor \"True\" a esta política, se proporcionará a los usuarios la posibilidad de traducir mediante una barra de herramientas de traducción integrada en Brave, si procede, y una opción para traducir en el menú contextual que aparece al hacer clic con el botón derecho. Si se le asigna el valor \"Inhabilitada\", se desactivarán todas las funciones de traducción integradas.\n\nSi se configura la política, los usuarios no podrán cambiar esta función. Si no se le asigna ningún valor, podrán cambiar esta opción.";
TranslatorAPIAllowed.pfm_title = "Permitir la API Translator";
TranslatorAPIAllowed.pfm_description = "Si se habilita esta política o no se define, se permitirá el uso de la API Translator en Brave.\n\nSi se inhabilita esta política, no se permitirá el uso de la API Translator.";
TryOnYouSettings.pfm_title = "Ajustes de Probador virtual.";
TryOnYouSettings.pfm_description = "0 - Habilitar Probador virtual con mejora del modelo.\n1 - Habilitar Probador virtual sin mejorar el modelo.\n2 - Inhabilitar Probador virtual.\nProbador virtual es una función basada en IA que permite a los usuarios probarse virtualmente imágenes de ropa de la Web y que proporcionará información útil sobre compras en Gemini en Chrome, si Gemini en Chrome está habilitado.\n\nSi se asigna el valor 0, permite que se use la función y que Google utilice datos relevantes para mejorar sus modelos de IA. Según la función, los datos pertinentes pueden ser imágenes, entradas, resultados, fuentes y comentarios. También es posible que los revisen un equipo de personas para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los casos indicados abajo.\n\nSi se asigna el valor 1, permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (incluyendo imágenes, entradas, resultados, fuentes y comentarios). 1 es el valor predeterminado de los usuarios de empresa que se gestionan en la Google Admin console y de las cuentas de centro educativo que se gestionan en Google Workspace.\n\nSi se asigna el valor 2, no se permite la función.\n\nNota: La restricción de las mejoras del modelo (valor 1) solo se aplica cuando se activa Probador virtual mediante el flujo del navegador Chrome. No se aplica cuando la función se usa mediante otros flujos.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings. Para obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.\n\nProbador virtual no está disponible en todos los países ni en todos los idiomas. Aunque se defina esta política, no se garantiza que la función se habilite, ya que sigue sujeta a disponibilidad. Para obtener más información sobre su lanzamiento, consulta las notas de la versión de Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=es";
URLAllowlist.pfm_title = "Permitir el acceso a una lista de URLs";
URLAllowlist.pfm_description = "Si se define esta política, se permite acceder a las URLs incluidas en la lista, las cuales se consideran excepciones de URLBlocklist. Consulta la descripción de la política para conocer el formato de las entradas de esta lista. Por ejemplo, si se le asigna el valor comodín (*) a URLBlocklist, se bloquearán todas las solicitudes, y esta política se podrá usar para permitir el acceso a una lista limitada de URLs. También se puede usar para abrir excepciones de determinados esquemas, subdominios de otros dominios, puertos o rutas específicas usando el formato especificado en https://support.google.com/chrome/a?p=url_blocklist_filter_format. El filtro más específico determinará si una URL está bloqueada o permitida. La política URLAllowlist prevalece frente a URLBlocklist. Esta política está limitada a 1000 entradas.\n\nEsta política también permite habilitar la invocación automática que realiza el navegador de aplicaciones externas registradas como controladores de los protocolos incluidos en la lista, como \"tel:\" o \"ssh:\".\n\nSi no se define esta política, no se permitirán excepciones de URLBlocklist.\n\nA partir de la versión 92 de Brave, también se admite esta política en el modo sin interfaz gráfica.";
URLBlocklist.pfm_title = "Bloquear el acceso a una lista de URLs";
URLBlocklist.pfm_description = "Si se define la política URLBlocklist, se impedirá que se carguen las páginas web con URLs prohibidas. Los administradores pueden especificar una lista con patrones de URL que quieran bloquear. Si no se asigna ningún valor, no se bloqueará ninguna URL en el navegador. Se pueden definir un máximo de 1000 excepciones en URLAllowlist. Consulta cómo aplicar formato a un patrón de URL (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nNota: Esta política no se aplica a las URLs de JavaScript dentro de la página con datos cargados dinámicamente. Si has bloqueado example.com/abc, la página example.com podría cargarlo igualmente con XMLHTTPRequest. Además, esta política no evita que las páginas web actualicen la URL mostrada en el omnibox con una URL bloqueada usando la API History de JavaScript.\n\nPuedes bloquear las URLs javascript://* a partir de la versión 73 de Brave. Sin embargo, esto solo afecta al código JavaScript que se introduce en la barra de direcciones o, por ejemplo, a bookmarklets.\n\nA partir de la versión 92 de Brave, también se admite esta política en el modo sin interfaz gráfica.\n\nA partir de la versión 147 de Brave, el comodín * por sí solo no se aplica a las URLs internas con chrome://. Para bloquearlas, debes usar explícitamente el patrón chrome://*.\n\nNota: Bloquear las URLs internas chrome://* y chrome-untrusted://* podría provocar errores inesperados o dichos bloqueos pueden eludirse en algunos casos. En lugar de bloquear determinadas URLs internas, comprueba si hay políticas más específicas disponibles. Por ejemplo:\n\n- En lugar de bloquear chrome://settings/certificates, usa CACertificateManagementAllowed.\n\n- En lugar de bloquear chrome-untrusted://crosh, usa SystemFeaturesDisableList.\n\n- En lugar de bloquear devtools://*, usa una de estas políticas: DeveloperToolsAvailability, DeveloperToolsAvailabilityAllowlist o DeveloperToolsAvailabilityBlocklist.";
UpdateOnZeroWindowEnabled.pfm_title = "Controla el reinicio automático en segundo plano cuando se cierran todas las ventanas del navegador";
UpdateOnZeroWindowEnabled.pfm_description = "Controla el comportamiento de reinicio automático en segundo plano en macOS cuando hay una actualización de seguridad pendiente y se han cerrado todas las ventanas del navegador.\n\nSi se le asigna el valor True a esta política o no se define, Brave podrá reiniciarse automáticamente para aplicar las actualizaciones pendientes cuando se cierren todas las ventanas del navegador.\n\nSi se le asigna el valor False, se inhabilitarán los reinicios automáticos cuando se cierren todas las ventanas del navegador.";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "Habilitar la recogida de datos anónima con clave de URL";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "Si se habilita esta política, siempre estará activa la recogida de datos anónima con clave de URL, que enviará las URLs de las páginas que el usuario visite a Google para mejorar las búsquedas y la navegación.\n\nSi se inhabilita esta política, no se activará la recogida de datos anónima con clave de URL.\n\nSi no se define la política, el usuario podrá cambiar este ajuste manualmente.\n\nEn Google Chrome OS Kiosk, esta política no ofrece la opción \"Permitir que el usuario decida\". Si no se define esta política para Google Chrome OS Kiosk, la recogida de datos anónima con clave de URL siempre estará activa.\nCuando se define para Google Chrome OS Kiosk, esta política habilita la recogida de métricas con clave de URL en las aplicaciones de kiosco.";
UserDataDir.pfm_title = "Establecer directorio de datos de usuarios";
UserDataDir.pfm_description = "Configura el directorio que Brave utilizará para almacenar los datos de usuario.\n\nSi se establece esta política, Brave utilizará el directorio proporcionado, aunque el usuario no haya especificado la instrucción \"--user-data-dir\". Para evitar la pérdida de datos u otros errores inesperados, esta política no debería establecerse en un directorio que se utilice para otros propósitos, dado que Brave gestiona su contenido.\n\nPara consultar una lista con las variables que se pueden utilizar, visita https://support.google.com/chrome/a?p=Supported_directory_variables.\n\nSi no se establece esta política, se utilizará la ruta de perfil predeterminada y el usuario podrá anularla mediante la instrucción de línea de comandos \"--user-data-dir\".";
UserDataSnapshotRetentionLimit.pfm_title = "Limita el número de instantáneas de datos de usuario retenidas para usarlas en caso de restauración de emergencia.";
UserDataSnapshotRetentionLimit.pfm_description = "Después de cada actualización importante de versión, Chrome creará una instantánea de algunos datos de navegación del usuario para usarla en caso de que se realice una restauración de versión de emergencia posteriormente. Si se realiza una restauración de emergencia y se instala una versión de la que el usuario tiene la instantánea correspondiente, se restaurarán los datos de dicha instantánea. Esto permite a los usuarios conservar ajustes como los marcadores y los datos de Autocompletar.\n\nSi no se establece esta política, se usará el valor predeterminado, que es \"3\".\n\nSi se establece, las instantáneas antiguas se eliminarán según sea necesario para respetar el límite. Si se asigna el valor \"0\" a esta política, no se realizarán instantáneas.";
UserFeedbackAllowed.pfm_title = "Permitir comentarios de los usuarios";
UserFeedbackAllowed.pfm_description = "Si se habilita la política o no se establece, los usuarios podrán enviar comentarios a Google usando una combinación de teclas o mediante la opción que está en Menú > Ayuda > Notificar un problema.\n\nSi se inhabilita la política, los usuarios no podrán enviar comentarios a Google.";
VideoCaptureAllowed.pfm_title = "Permitir o denegar captura de vídeo";
VideoCaptureAllowed.pfm_description = "Si se asigna el valor \"Habilitada\" a esta política o no se le asigna ninguno, significa que, con la excepción de las URL que se hayan incluido en la lista VideoCaptureAllowedUrls, se preguntará a los usuarios si requieren acceso a la captura de vídeo.\n\nSi se le asigna el valor \"Inhabilitada\", se desactivarán los mensajes de solicitud de acceso y la captura de vídeo solo estará disponible para las URL incluidas en la lista VideoCaptureAllowedUrls.\n\nNota: La política afecta a todos los dispositivos de entrada de vídeo, no solo a la cámara integrada.";
VideoCaptureAllowedUrls.pfm_title = "URLs a las que se concederá acceso a dispositivos de captura de vídeo sin confirmación";
VideoCaptureAllowedUrls.pfm_description = "Si se define esta política, se especificará la lista de URLs cuyos patrones se compararán con el origen de seguridad de la URL solicitante. Si se encuentra una coincidencia, se concederá acceso a dispositivos de captura de vídeo sin solicitarlo.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/. Sin embargo, ten en cuenta que esta política no admite el patrón \"*\", que coincide con cualquier URL.";
VoiceTypingSettings.pfm_title = "Configuración de Escribir por voz";
VoiceTypingSettings.pfm_description = "0 - Permitir que se use Escribir por voz.\n1 - Permitir Escribir por voz sin recogida de datos.\n2 - No permitir Escribir por voz.\nEscribir por voz es una función basada en IA que permite a los usuarios introducir y editar texto con la voz. Se basa en modelos de IA generativa para ofrecer transcripciones y formato de alta calidad.\n\nSi se asigna el valor 0, permite que se use la función y que Google utilice datos relevantes para mejorar sus modelos de IA. Según la función, los datos pertinentes pueden ser peticiones, entradas, resultados, fuentes y comentarios escritos. También es posible que los revisen un equipo de personas para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los casos indicados abajo.\n\nSi se asigna el valor 1, permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (incluyendo peticiones, entradas, resultados, fuentes y comentarios escritos). 1 es el valor predeterminado de los usuarios de empresa que se gestionan en la Google Admin console y de las cuentas de centro educativo que se gestionan en Google Workspace.\n\nSi se asigna el valor 2, no se permite la función.\n\nSi no se define esta política, su comportamiento lo determinará la política GenAiDefaultSettings.\n\nPara obtener más información sobre el tratamiento de datos en las funciones de IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
WPADQuickCheckEnabled.pfm_title = "Habilitar optimización de WPAD";
WPADQuickCheckEnabled.pfm_description = "Si se habilita la política o no se establece, se habilitará la optimización de WPAD (detección automática de proxy web) en Brave.\n\nSi se inhabilita la política, se inhabilitará la optimización de WPAD, lo que hará que Brave tenga que esperar más tiempo la respuesta de los servidores WPAD basados en DNS.\n\nIndependientemente de si se establece o no esta política, los usuarios no podrán cambiar la opción de configuración de WPAD.";
WarnBeforeQuittingEnabled.pfm_title = "Mostrar un cuadro de diálogo de advertencia cuando el usuario intenta salir";
WarnBeforeQuittingEnabled.pfm_description = "Controla el cuadro de diálogo Avisar antes de salir (⌘Q) cuando el usuario intenta salir del navegador.\n\nSi esta política se habilita o no se establece, se mostrará un cuadro de diálogo de advertencia cuando el usuario intente salir.\n\nSi esta política se inhabilita, no se mostrará un cuadro de diálogo de advertencia cuando el usuario intente salir.";
WebAppInstallByUserEnabled.pfm_title = "Habilitar la instalación de aplicaciones web de usuario desde el navegador";
WebAppInstallByUserEnabled.pfm_description = "Esta política controla si los usuarios pueden instalar aplicaciones web mediante el navegador.\nSi habilitas esta política o no la configuras, los usuarios podrán instalar aplicaciones web mediante el navegador.\nSi inhabilitas esta política, los usuarios no podrán instalar aplicaciones web mediante el navegador y el tipo de datos \"aplicaciones\" se excluirá de la sincronización de Chrome Sync.\nEsta política no admite la actualización dinámica. Los cambios, ya sean para habilitar, inhabilitar o anular la configuración, solo se aplicarán después de reiniciar el navegador.\nEsta política no afecta a la política WebAppInstallForceList.";
WebAppInstallForceList.pfm_title = "URLs de aplicaciones web que se tienen que instalar de forma silenciosa.";
WebAppInstallForceList.pfm_description = "Si se establece esta política, se especifica una lista de aplicaciones web que se instalarán de forma silenciosa y sin intervención del usuario, y qué usuarios no podrán desinstalarlas ni desactivarlas.\n\nCada elemento de la lista de esta política es un objeto con un miembro obligatorio:\nurl (la URL de la aplicación web que se va a instalar)\n\ny 6 miembros opcionales:\n- default_launch_container\n(define cómo se abre la aplicación web; la opción predeterminada es que lo haga en una pestaña nueva)\n\n- create_desktop_shortcut\n(selecciona True si quieres crear accesos directos del escritorio\nde Linux y Microsoft® Windows®).\n\n- fallback_app_name\nA partir de la versión 90 de Brave,\nte permite anular el nombre de la aplicación si no es una\naplicación web progresiva (PWA), o el nombre de la aplicación instalada\ntemporalmente si es una PWA, pero se requiere autenticación para que la\ninstalación pueda completarse. Si se proporcionan tanto\ncustom_name como\nfallback_app_name,\nesta última se ignorará.\n\n- custom_name\nA partir de la versión 99\nde Google Chrome OS y de la versión 112 en el resto de los sistemas operativos para ordenadores, te permite anular\nde forma permanente el nombre de todas las aplicaciones web y PWAs.\n\n- custom_icon\nA partir de la versión 99\nde Google Chrome OS y de la versión 112 en el resto de los sistemas operativos para ordenadores,\nte permite anular el icono de las aplicaciones instaladas. Los iconos deben ser cuadrados,\n con un tamaño máximo de 1 MB, y deben tener uno de los siguientes formatos: jpeg, png, gif, webp o ico.\nEl valor de hash debe ser el hash SHA256 del archivo de icono. Se debe poder acceder a url\nsin autenticación para que el icono se pueda usar\nal instalar la aplicación.\n\n- install_as_shortcut\nA partir de la versión 107\nde Brave. Si se habilita esta política, la url especificada\nse instalará como un acceso directo, igual que si se hiciera mediante la opción \"Crear acceso directo...\"\nde la GUI del navegador para ordenadores.\nTen en cuenta que, si se instala como acceso directo, no se actualizará si\ncambia el archivo de manifiesto de url.\nSi esta política se inhabilita o no se establece, la aplicación web de la\nurl especificada se instalará de forma normal.\n\nConsulta PinnedLauncherApps para fijar aplicaciones en la estantería de Google Chrome OS.\nConsulta la página https://chromeenterprise.google/policies/?policy=WebAppInstallForceList para obtener más información sobre el esquema y el formato.";
WebAppSettings.pfm_title = "Configuración de gestión de aplicaciones web";
WebAppSettings.pfm_description = "Esta política permite que un administrador especifique la configuración de las aplicaciones web instaladas. Esta política asocia un ID de aplicación web a su configuración concreta. Se puede definir una configuración predeterminada usando el ID especial *, que se aplicará a todas las aplicaciones web para las que no se haya definido una configuración personalizada en esta política.\n\nEl campo manifest_id es el ID del archivo de manifiesto de la aplicación web. En https://developer.chrome.com/blog/pwa-manifest-id/ encontrarás las instrucciones para determinar el ID del archivo de manifiesto de una aplicación web instalada.\nEl campo run_on_os_login especifica si una aplicación web puede ejecutarse durante el inicio de sesión en el SO. Si a este campo se le asigna el valor blocked, la aplicación web no se ejecutará durante el inicio de sesión en el SO y el usuario no podrá habilitar esta opción después. Si a este campo se le asigna el valor run_windowed, la aplicación web se ejecutará durante el inicio de sesión en el SO y el usuario no podrá inhabilitar esta opción después. Si a este campo se le asigna el valor allowed, el usuario podrá configurar la aplicación web para que se ejecute durante el inicio de sesión en el SO. La configuración predeterminada solo permite los valores allowed y blocked.\nDesde la versión 117, en el campo prevent_close_after_run_on_os_login se especifica si se debe impedir todo tipo de cierres de aplicaciones web (por ejemplo, por parte del usuario, el administrador de tareas o las APIs web). Este comportamiento solo se puede habilitar si se asigna el valor run_windowed a run_on_os_login. Si la aplicación ya se estaba ejecutando, esta propiedad solo se hará efectiva después de reiniciar la aplicación. Si este campo no se define, los usuarios podrán cerrar las aplicaciones.\nDesde la versión 118, en el campo force_unregister_os_integration se especifica si se eliminará o no toda la integración del SO en una aplicación web, es decir, los accesos directos, los controladores de archivos o de protocolo, etc. Si una aplicación ya se está ejecutando, esta propiedad se hará efectiva después de reiniciar la aplicación. Esta opción se debe utilizar con precaución, ya que puede prevalecer sobre cualquier integración del SO que se haya establecido automáticamente durante el inicio del sistema de la aplicación web. Por el momento, solo funciona en las plataformas Windows, Mac y Linux.\nConsulta la página https://chromeenterprise.google/policies/?policy=WebAppSettings para obtener más información sobre el esquema y el formato.";
WebAudioOutputBufferingEnabled.pfm_title = "Habilitar el almacenamiento en búfer adaptable para Web Audio";
WebAudioOutputBufferingEnabled.pfm_description = "Esta política controla si el navegador usa el almacenamiento en búfer adaptable para Web Audio, lo que puede reducir los fallos de audio, pero también puede aumentar la latencia en una cantidad variable.\n\nSi se habilita esta política, siempre se usará el almacenamiento en búfer adaptable.\n\nSi se inhabilita esta política o no se define, el proceso de lanzamiento de funciones del navegador decidirá si se usa el almacenamiento en búfer adaptable.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "Orígenes permitidos para las solicitudes WebAuthn con proxy desde aplicaciones de Escritorio Remoto.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "Una lista de orígenes de aplicaciones de cliente de escritorio remoto que pueden realizar solicitudes a la API WebAuthn que se originan en una sesión de navegador en un host remoto.\n\nCualquier origen configurado en esta política puede hacer solicitudes WebAuthn para obtener IDs de entidad de confianza que normalmente no podría solicitar.\n\nSolo se permiten orígenes HTTPS válidos. No se admiten comodines.\nLas entradas no válidas se ignoran.\n\nEsta política solo se aplica a usuarios afiliados.";
WebHidAllowAllDevicesForUrls.pfm_title = "Concede permiso automáticamente a sitios para que se conecten a cualquier dispositivo HID.";
WebHidAllowAllDevicesForUrls.pfm_description = "Establecer esta política permite definir una lista de sitios a los que se les concederá permiso automáticamente para acceder a todos los dispositivos disponibles.\n\nLas URLs deben ser válidas; si no, se ignorará la política. Solo se tiene en cuenta el origen de la URL (esquema, host y puerto).\n\nEn ChromeOS, esta política solo se aplica a usuarios afiliados.\n\nEsta política anula las políticas DefaultWebHidGuardSetting, WebHidAskForUrls y WebHidBlockedForUrls, así como las preferencias del usuario.";
WebHidAllowDevicesForUrls.pfm_title = "Concede permiso automáticamente a estos sitios para que se conecten a dispositivos HID con los IDs de proveedor y producto facilitados.";
WebHidAllowDevicesForUrls.pfm_description = "Habilitar esta política permite definir una lista de URLs que especifica qué sitios obtendrán permiso automáticamente para acceder a un dispositivo HID que tenga los IDs de proveedor y de producto establecidos. Cada elemento de la lista debe tener los campos devices y urls para ser válido. De lo contrario, el elemento se ignorará. Cada elemento del campo devices debe tener un campo vendor_id y puede tener un campo product_id. Si se omite el campo product_id, se creará una política referida a todos los dispositivos con el ID de proveedor especificado. Un elemento que tenga un campo product_id, pero que no tenga un campo vendor_id, no se considerará válido y se ignorará.\n\nSi no se le asigna un valor a la política, se aplicará DefaultWebHidGuardSetting si se ha definido previamente. Si no, se aplicará la configuración personal del usuario.\n\nLas URLs de esta política no deben entrar en conflicto con las de la política WebHidBlockedForUrls. En caso de conflicto, esta política prevalece sobre WebHidBlockedForUrls.\nConsulta la página https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls para obtener más información sobre el esquema y el formato.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "Concede permiso automáticamente a estos sitios para que se conecten a dispositivos HID que contengan colecciones de alto nivel con el uso de HID indicado.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "Habilitar esta política permite definir una lista de URLs que especifican qué sitios obtendrán permiso automáticamente para acceder a un dispositivo HID que contenga una colección de alto nivel con el uso de HID indicado. Para que la política sea válida, cada elemento de la lista debe tener los campos usages y urls. Cada elemento del campo usages debe tener un campo usage_page y puede tener un campo usage. Si se omite el campo usage, se creará una política referida a todos los dispositivos que contengan una colección de alto nivel con un uso especificado en la página correspondiente. Un elemento que tenga un campo usage, pero que no tenga un campo usage_page, no se considerará válido y se ignorará.\n\nSi no se le asigna un valor a la política, se aplicará DefaultWebHidGuardSetting si se ha definido previamente. Si no, se aplicará la configuración personal del usuario.\n\nLas URLs de esta política no deben entrar en conflicto con las de la política WebHidBlockedForUrls. En caso de conflicto, esta política prevalece sobre WebHidBlockedForUrls.\nConsulta la página https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls para obtener más información sobre el esquema y el formato.";
WebHidAskForUrls.pfm_title = "Permite la API WebHID en estos sitios";
WebHidAskForUrls.pfm_description = "Si estableces esta política, podrás definir una lista de patrones de URL donde se especifique qué sitios pueden pedir a los usuarios que les permitan acceder a un dispositivo HID.\n\nSi no se establece la política, DefaultWebHidGuardSetting se aplicará a todos los sitios, si se ha definido. Si no se ha definido, se aplicará la configuración personal del usuario.\n\nEn el caso de los patrones de URL que no se incluyan en la política, se aplicará este orden de preferencia:\n\n  * La política WebHidBlockedForUrls (si esta los incluye)\n\n  * La política DefaultWebHidGuardSetting (si se ha establecido)\n\n  * Los ajustes personales de los usuarios\n\nLos patrones de URL no deben entrar en conflicto con WebHidBlockedForUrls. Si una URL está incluida en ambas políticas, no tendrá preferencia ninguna política.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
WebHidBlockedForUrls.pfm_title = "Bloquea la API WebHID en estos sitios";
WebHidBlockedForUrls.pfm_description = "Si estableces esta política, podrás definir una lista de patrones de URL donde se especifique qué sitios no pueden pedir a los usuarios que les permitan acceder a un dispositivo HID.\n\nSi no se establece la política, DefaultWebHidGuardSetting se aplicará a todos los sitios, si se ha definido. Si no se ha definido, se aplicará la configuración personal del usuario.\n\nEn el caso de los patrones de URL que no se incluyan en la política, se aplicará este orden de preferencia:\n\n  * La política WebHidAskForUrls (si esta los incluye)\n\n  * La política DefaultWebHidGuardSetting (si se ha establecido)\n\n  * Los ajustes personales de los usuarios\n\nLos patrones de URL no pueden entrar en conflicto con la política WebHidAskForUrls. Si una URL está incluida en ambas políticas, no tendrá preferencia ninguna política.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "Habilitar la recogida de registros de diagnóstico de WebRTC en orígenes específicos";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "Esta política permite habilitar la recogida de registros de diagnóstico de WebRTC para orígenes específicos.\n\nPara obtener información detallada sobre los patrones de entrada válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política. Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL. Se admiten esquemas y subdominios.\n\nSi se define esta política, se habilitará la recogida de registros de diagnóstico de los orígenes que coincidan con los patrones de la lista.\n\nSi no se define esta política, la recogida de registros de diagnóstico se inhabilitará de forma predeterminada.";
WebRtcEventLogCollectionAllowed.pfm_title = "Permitir la recogida de registros de eventos WebRTC de servicios de Google";
WebRtcEventLogCollectionAllowed.pfm_description = "Si se habilita esta política, Brave podrá recoger registros de eventos WebRTC procedentes de servicios de Google como Hangouts Meet y enviarlos a Google. Esos registros tienen información de diagnóstico para depurar errores de llamadas de audio o videollamadas en Brave, como la hora y el tamaño de los paquetes RTP, datos sobre la congestión de la red y metadatos del tiempo y la calidad de los frames de audio y vídeo. Estos registros no tienen contenido de audio ni de vídeo de la reunión. Para facilitar la depuración, Google podría asociar estos registros, mediante un ID de sesión, a otros registros recogidos por el propio servicio de Google.\n\nSi se inhabilita esta política, no se recogerán ni se enviarán dichos registros.\n\nSi no se establece esta política en las versiones hasta la M76 (incluida), Brave no podrá recoger ni enviar esos registros de forma predeterminada. A partir de la versión M77, Brave puede recoger y enviar esos registros de forma predeterminada de la mayoría de los perfiles afectados por políticas de empresa a nivel de usuario basadas en la nube. Desde la versión M77 hasta la M80 (incluida), Brave también puede recoger y enviar esos registros de forma predeterminada de los perfiles afectados por la gestión on-premise de Brave.";
WebRtcIPHandling.pfm_title = "Gestión de IPs de WebRTC";
WebRtcIPHandling.pfm_description = "default - WebRTC usará todas las interfaces disponibles al buscar la mejor ruta.\ndefault_public_and_private_interfaces - WebRTC solo usará la interfaz al conectarse a una red pública, pero podrá conectarse a través de direcciones IP privadas.\ndefault_public_interface_only - WebRTC solo usará la interfaz al conectarse a una red pública, y no se conectará a través de direcciones IP privadas.\ndisable_non_proxied_udp - WebRTC usará TCP en la interfaz pública y solo usará UDP si lo admite un proxy configurado.\nEsta política permite restringir el uso de direcciones IP e interfaces por parte de WebRTC al intentar buscar la mejor conexión disponible.\n\nValores válidos:\n\n* default: WebRTC usa todas las interfaces de red disponibles.\n\n* default_public_and_private_interfaces: WebRTC usa todas las interfaces públicas y privadas.\n\n* default_public_interface_only: WebRTC usa todas las interfaces públicas, pero no las privadas.\n\n* disable_non_proxied_udp: WebRTC usa el proxy SOCKS de UDP o recurrirá al proxy TCP como alternativa.\n\nSi no se le asigna ningún valor, utilizará de forma predeterminada todas las interfaces de red disponibles.\n\nConsulta la sección 5.2 del RFC 8828 (https://tools.ietf.org/html/rfc8828.html#section-5.2) para obtener una descripción detallada de todos los valores de gestión.";
WebRtcIPHandlingUrl.pfm_title = "Gestión de IPs por URL de WebRTC";
WebRtcIPHandlingUrl.pfm_description = "Esta política permite restringir el uso de direcciones IP e interfaces por parte de WebRTC al intentar buscar la mejor conexión disponible por cada patrón de URL específico.\n\nAcepta una lista de patrones de URL y pares de tipos de gestión. Los patrones de URL se comprueban en orden, y la primera coincidencia configurará el modo de gestión que usará WebRTC para el dominio. Si la URL del documento actual no coincide con ninguna entrada, se usa la configuración definida en la política WebRtcIPHandling.\n\nPara obtener información detallada sobre los patrones de entrada válidos, consulta https://chromeenterprise.google/policies/url-patterns/. Se permite el uso de caracteres comodín (*). Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.\n\nValores de gestión válidos:\n\n* default: WebRTC usa todas las interfaces de red.\n\n* default_public_and_private_interfaces: WebRTC usa todas las interfaces públicas y privadas.\n\n* default_public_interface_only: WebRTC usa todas las interfaces públicas, pero no las privadas.\n\n* disable_non_proxied_udp: WebRTC usa el proxy SOCKS de UDP o recurrirá al proxy TCP como alternativa.\n\nConsulta la sección 5.2 del RFC 8828 (https://tools.ietf.org/html/rfc8828.html#section-5.2) para obtener una descripción detallada de todos los valores de gestión.\nConsulta la página https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl para obtener más información sobre el esquema y el formato.";
WebRtcLocalIpsAllowedUrls.pfm_title = "URLs cuyas IP locales se exponen en candidatos ICE WebRTC";
WebRtcLocalIpsAllowedUrls.pfm_description = "Los patrones de esta lista se compararán con el origen de seguridad de la URL solicitante.\nSi se encuentra alguna coincidencia o chrome://flags/#enable-webrtc-hide-local-ips-with-mdns está inhabilitado, las direcciones IP locales se mostrarán en candidatos ICE WebRTC.\nDe lo contrario, las direcciones IP locales se ocultarán con nombres de host mDNS.\nTen en cuenta que esta política debilita la protección de las IP locales si así lo necesitan los administradores.";
WebRtcPostQuantumKeyAgreement.pfm_title = "Habilitar acuerdo de claves poscuántico para WebRTC";
WebRtcPostQuantumKeyAgreement.pfm_description = "Esta política permite controlar el acuerdo de claves poscuántico para WebRTC.\n\nSi se habilita esta política, se suministrará un acuerdo de claves poscuántico para WebRTC.\n\nSi se inhabilita esta política, no se suministrará un acuerdo de claves poscuántico para WebRTC.\n\nSi no se define esta política, el valor se establecerá mediante el proceso de lanzamiento predeterminado del acuerdo de claves poscuántico ofrecido para WebRTC.\n\nEl suministro de un acuerdo de claves poscuántico es retrocompatible. Se espera que los pares de DTLS y el middleware de red actuales ignoren la nueva opción y sigan seleccionando las anteriores.\n\nSin embargo, es posible que los dispositivos que no implementen correctamente DTLS no funcionen correctamente cuando se ofrezca la nueva opción. Por ejemplo, puede que se desconecten en respuesta a opciones no reconocidas o a los mensajes resultantes de mayor tamaño. Esos dispositivos no están preparados para los sistemas poscuánticos e interferirán en la transición empresarial hacia esos sistemas. Si se detecta este problema, los administradores deben ponerse en contacto con el proveedor para solucionarlo.\n\nEsta política es una medida temporal y se eliminará tras algunos logros.";
WebRtcTextLogCollectionAllowed.pfm_title = "Permitir que se recojan registros de texto WebRTC de los servicios de Google";
WebRtcTextLogCollectionAllowed.pfm_description = "Si se habilita esta política, Brave podrá recoger registros de texto WebRTC procedentes de servicios de Google como Google Meet y enviarlos a Google. Estos registros incluyen información de diagnóstico para solucionar problemas de depuración de videollamadas o audios en Brave, como los metadatos de texto que describen flujos de entrada y salida de WebRTC, entradas de registro específicas de WebRTC e información adicional del sistema. Estos registros no tienen contenido de audio ni de vídeo de la reunión.\nSi se inhabilita esta política, no se subirán esos registros a Google. Los registros seguirán acumulándose de forma local en el dispositivo del usuario.\nSi no se define esta política, Brave recogerá y subirá estos registros de forma predeterminada.";
WebRtcUdpPortRange.pfm_title = "Restringe el intervalo de puertos UDP locales utilizado por WebRTC";
WebRtcUdpPortRange.pfm_description = "Si esta política se configura, el intervalo de puertos UDP utilizado por WebRTC estará restringido al intervalo de puertos especificado (incluidos los extremos).\n\nSi esta política no se configura o si se le asigna una cadena vacía o un intervalo de puertos no válido, WebRTC podrá utilizar cualquier puerto UDP local disponible.";
WebUsbAllowDevicesForUrls.pfm_title = "Conceder permiso automáticamente a estos sitios web para conectarse a dispositivos USB con los ID de proveedor y producto facilitados.";
WebUsbAllowDevicesForUrls.pfm_description = "Habilitar esta política permite definir una lista de patrones de URL que especifica qué sitios obtendrán permiso automáticamente para acceder a un dispositivo USB que tenga el ID de proveedor y de producto establecidos. Para que la política sea válida, cada elemento de la lista debe tener los campos devices y urls. Cada elemento del campo devices puede tener un campo vendor_id y un campo product_id. Si se omite el campo vendor_id, se creará una política referida a todos los dispositivos. Si se omite el campo product_id, se creará una política referida a todos los dispositivos con el ID de proveedor proporcionado. Una política que tenga un campo product_id, pero que no tenga un campo vendor_id, no es válida.\n\nEl modelo de permisos USB otorgará a la URL especificada el permiso de acceso al dispositivo USB como origen de nivel destacado. Si los marcos insertados requieren acceder a dispositivos USB, se deberá usar el encabezado \"usb\" feature-policy para otorgar acceso. La URL debe ser válida; si no, se ignorará la política.\n\nObsoleto: El modelo de permisos USB permitía especificar la URL solicitante y la URL de inserción. Esta opción, aunque ya no está disponible, es retrocompatible: si se especifica una URL solicitante y una URL de inserción, esta última obtendrá el permiso como origen destacado, y la URL solicitante se ignorará por completo.\n\nEsta política anula las políticas DefaultWebUsbGuardSetting, WebUsbAskForUrls y WebUsbBlockedForUrls, así como las preferencias del usuario.\n\nEsta política solo afecta al acceso a los dispositivos USB a través de la API WebUSB. Para conceder acceso a dispositivos USB a través de la API Web Serial, consulta la política SerialAllowUsbDevicesForUrls.\nConsulta la página https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls para obtener más información sobre el esquema y el formato.";
WebUsbAskForUrls.pfm_title = "Permitir WebUSB en estos sitios web";
WebUsbAskForUrls.pfm_description = "Si le asignas un valor a esta política, podrás establecer una lista de patrones de URL donde se especifique qué sitios pueden pedir a los usuarios que les permitan acceder a un dispositivo USB.\n\nSi no se establece la política, DefaultWebUsbGuardSetting se aplicará a todos los sitios, si se ha definido. Si no se ha definido, se aplicará la configuración personal del usuario.\n\nLos patrones de URL no deben entrar en conflicto con WebUsbAskForUrls. Si una URL está incluida en ambas políticas, no tendrá preferencia ninguna política.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
WebUsbBlockedForUrls.pfm_title = "Bloquear WebUSB en estos sitios web";
WebUsbBlockedForUrls.pfm_description = "Si le asignas un valor a esta política, podrás establecer una lista de patrones de URL donde se especifique qué sitios no pueden pedir a los usuarios que les permitan acceder a un dispositivo USB.\n\nSi no se establece la política, DefaultWebUsbGuardSetting se aplicará a todos los sitios, si se ha definido. Si no, se aplicará la configuración personal del usuario.\n\nLos patrones de URL no pueden entrar en conflicto con la política WebUsbAskForUrls. Si una URL está incluida en ambas políticas, no tendrá preferencia ninguna política.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
WindowCaptureAllowedByOrigins.pfm_title = "Permitir la captura de ventanas y pestañas de estos orígenes";
WindowCaptureAllowedByOrigins.pfm_description = "Si se define la política, se podrá definir una lista de los patrones de URL que pueden usar la captura de ventanas y pestañas.\n\nSi no se define la política, no se tendrán en cuenta los sitios para una anulación a este nivel de captura.\n\nEsta política no se tendrá en cuenta si un sitio coincide con un patrón de URL en cualquiera de las siguientes políticas: TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nSi un sitio coincide con un patrón de URL en esta política, no se tendrán en cuenta las siguientes políticas: ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/.  Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.";
WindowManagementAllowedForUrls.pfm_title = "Permitir permiso de gestión de ventanas en estos sitios";
WindowManagementAllowedForUrls.pfm_description = "Te permite definir una lista de patrones de URL donde se especifique qué sitios otorgarán automáticamente el permiso de gestión de ventanas. Esto extenderá la capacidad de los sitios de ver información sobre las pantallas de los dispositivos y usarla para abrir y colocar ventanas, o solicitar la pantalla completa en pantallas específicas.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.\n\nSi esta política no se establece para un sitio, se le aplicará la de DefaultWindowManagementSetting (si se ha definido). En caso contrario, el permiso se ajustará a los valores predeterminados del navegador y los usuarios podrán elegir este permiso en función del sitio.\n\nEsta política sustituye a la obsoleta de WindowPlacementAllowedForUrls.";
WindowManagementBlockedForUrls.pfm_title = "Bloquear el permiso de gestión de ventanas en estos sitios";
WindowManagementBlockedForUrls.pfm_description = "Te permite definir una lista de patrones de URL donde se especifique qué sitios negarán automáticamente el permiso de gestión de ventanas. Esto limitará la capacidad de los sitios de ver información sobre las pantallas de los dispositivos y usarla para abrir y colocar ventanas, o solicitar la pantalla completa en pantallas específicas.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo detecta coincidencias basadas en el origen, así que se ignora cualquier ruta del patrón de URL.\n\nSi esta política no se establece para un sitio, se le aplicará la de DefaultWindowManagementSetting (si se ha definido). En caso contrario, el permiso se ajustará a los valores predeterminados del navegador y los usuarios podrán elegir este permiso en función del sitio.\n\nEsta política sustituye a la obsoleta de WindowPlacementBlockedForUrls.";
XSLTEnabled.pfm_title = "Controlar la disponibilidad de la función XSLT";
XSLTEnabled.pfm_description = "Esta política controla la disponibilidad de la función XSLT (la API de JavaScript XSLTProcessor y la instrucción de procesamiento de XSL).\nSi se habilita esta política, XSLT estará disponible, independientemente del estado predeterminado de la función en el navegador.\nSi se inhabilita esta política, XSLT no estará disponible, independientemente del estado predeterminado de la función en el navegador.\nSi no se define esta política, la disponibilidad de XSLT se determinará según la configuración predeterminada del navegador y las pruebas de campo.\nEsta política es una medida temporal y se eliminará en la versión M176.";