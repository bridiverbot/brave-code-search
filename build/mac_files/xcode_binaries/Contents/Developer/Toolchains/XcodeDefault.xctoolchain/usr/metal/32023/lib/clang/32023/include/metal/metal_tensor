  template <class, class> friend struct __tensor_accessor;
  template <class, class, class, class...> friend struct tensor;
  friend bool metal::is_null_tensor(const thread  tensor &);
  friend bool metal::is_null_tensor(const device  tensor &);
#if defined(__HAVE_COHERENT__)
