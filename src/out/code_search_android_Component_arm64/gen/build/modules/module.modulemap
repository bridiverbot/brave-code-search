      header "../../../../../third_party/libc++/src/include/__cstddef/max_align_t.h"
      export *
    }
    module nullptr_t    { header "../../../../../third_party/libc++/src/include/__cstddef/nullptr_t.h" }
    module ptrdiff_t    { header "../../../../../third_party/libc++/src/include/__cstddef/ptrdiff_t.h" }
    module size_t       { header "../../../../../third_party/libc++/src/include/__cstddef/size_t.h" }
  }

  module cstdint {
