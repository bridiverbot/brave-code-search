-Copt-level=3
-Cllvm-args=-pick-merged-source-locations
-g
-Cdebug-assertions
-Ccontrol-flow-guard
-Ctarget-feature=+crt-static
-Dwarnings
--sysroot=win_clang_x64_with_system_allocator/local_rustc_sysroot
-Ldependency=win_clang_x64_with_system_allocator/local_rustc_sysroot/lib/rustlib/x86_64-pc-windows-msvc/lib
