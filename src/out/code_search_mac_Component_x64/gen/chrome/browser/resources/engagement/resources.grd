<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/engagement_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/engagement_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/engagement_resources_map.h"
            type="resource_map_header" />
    <output filename="engagement_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_ENGAGEMENT_SITE_ENGAGEMENT_HTML" file="${root_gen_dir}/chrome/browser/resources/engagement/preprocessed/site_engagement.html" resource_path="site_engagement.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ENGAGEMENT_APP_JS" file="${root_gen_dir}/chrome/browser/resources/engagement/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ENGAGEMENT_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/engagement/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ENGAGEMENT_SITE_ENGAGEMENT_DETAILS_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/engagement/minified/site_engagement_details.mojom-webui.js" resource_path="site_engagement_details.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
