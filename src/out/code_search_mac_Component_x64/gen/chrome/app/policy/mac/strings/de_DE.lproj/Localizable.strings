/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Einstellungen für Brave";
AIModeSettings.pfm_title = "Einstellungen für die KI‑Modus-Integrationen von Google in der Adressleiste und im Suchfeld der Seite „Neuer Tab“.";
AIModeSettings.pfm_description = "0 - KI‑Modus-Integrationen zulassen.\n1 - KI‑Modus-Integrationen nicht zulassen.\nMit dieser Richtlinie werden die KI-Modus-Integrationen von Google in der Adressleiste und im Suchfeld auf der Seite „Neuer Tab“ gesteuert.\n\nFür den Zugriff auf diese Funktion muss die Google Suche als Standardsuchmaschine des Nutzers festgelegt sein.\n\n0 = Die Funktion ist für Nutzer verfügbar.\n\n1 = Die Funktion ist für Nutzer nicht verfügbar.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.";
AbusiveExperienceInterventionEnforce.pfm_title = "Zwingende Maßnahmen bei irreführenden Inhalten";
AbusiveExperienceInterventionEnforce.pfm_description = "Wenn die Richtlinie \"SafeBrowsingEnabled\" nicht deaktiviert ist und \"AbusiveExperienceInterventionEnforce\" aktiviert oder nicht konfiguriert wird, werden Websites mit irreführenden Inhalten daran gehindert, neue Fenster oder Tabs zu öffnen.\n\nIst \"SafeBrowsingEnabled\" oder \"AbusiveExperienceInterventionEnforce\" deaktiviert, können Websites mit irreführenden Inhalten neue Fenster oder Tabs öffnen.";
AccessCodeCastDeviceDuration.pfm_title = "Gibt an, wie lange (in Sekunden) ein Übertragungsgerät, das mit einem Zugriffscode oder QR-Code ausgewählt wurde, im Google Cast-Menü für Übertragungsgeräte angezeigt wird.";
AccessCodeCastDeviceDuration.pfm_description = "Diese Richtlinie gibt an, wie lange (in Sekunden) ein Übertragungsgerät, das über einen Zugriffscode oder QR-Code ausgewählt wurde, im Google Cast-Menü für Übertragungsgeräte zu sehen ist.\nDie Lebensdauer eines Eintrags beginnt mit der ersten Eingabe des Zugriffscodes oder dem ersten Scannen des QR-Codes.\nWährend dieses Zeitraums erscheint das Übertragungsgerät im Google Cast-Menü für Übertragungsgeräte.\nNach Ablauf dieses Zeitraums muss der Zugriffscode noch einmal eingegeben oder der QR-Code noch einmal gescannt werden, um das Übertragungsgerät wieder zu verwenden.\nStandardmäßig ist der Zeitraum auf null Sekunden eingestellt. Übertragungsgeräte bleiben also nicht im Google Cast-Menü. Der Zugriffscode muss daher noch einmal eingegeben oder der QR-Code noch einmal gescannt werden, um eine neue Übertragung zu starten.\nDiese Richtlinie wirkt sich nur auf die Dauer aus, für die ein Übertragungsgerät im Google Cast-Menü angezeigt wird. Sie hat keine Auswirkung auf laufende Übertragungen. Diese werden auch nach Ablauf des festgelegten Zeitraums fortgesetzt.\nDiese Richtlinie hat keine Auswirkung, es sei denn, die Richtlinie AccessCodeCastEnabled ist aktiviert.";
AccessCodeCastEnabled.pfm_title = "Zulassen, dass Nutzer im Google Cast-Menü Übertragungsgeräte mit einem Zugriffscode oder einem QR-Code auswählen.";
AccessCodeCastEnabled.pfm_description = "Diese Richtlinie legt fest, ob Nutzern im Google Cast-Menü eine Option angezeigt wird, über die sie eine Verbindung zu Übertragungsgeräten herstellen können, die nicht im Google Cast-Menü aufgeführt sind. Dazu können sie einen Zugriffscode eingeben oder den QR-Code scannen, der auf dem Bildschirm des Übertragungsgeräts angezeigt wird.\nStandardmäßig müssen Nutzer den Zugriffscode noch einmal eingeben oder den QR-Code noch einmal scannen, um eine weitere Übertragung zu starten. Wenn die Richtlinie AccessCodeCastDeviceDuration jedoch auf einen Wert ungleich Null gesetzt wurde (der Standardwert ist Null), bleibt das Übertragungsgerät in der Liste der verfügbaren Übertragungsgeräte, bis der angegebene Zeitraum abgelaufen ist.\nWenn diese Richtlinie aktiviert ist, können Nutzer Übertragungsgeräte mit einem Zugriffscode oder durch Scannen eines QR-Codes auswählen.\nIst diese Richtlinie deaktiviert oder nicht konfiguriert, haben Nutzer nicht die Möglichkeit, Übertragungsgeräte mit einem Zugriffscode oder durch Scannen eines QR-Codes auszuwählen.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "Access-Control-Allow-Methods-Abgleich in CORS-Preflight richtlinienkonform machen";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Diese Richtlinie legt fest, ob Anfragemethoden groß geschrieben werden, wenn sie mit Access-Control-Allow-Methods-Antwortheadern in CORS-Preflight abgeglichen werden.\n\nWenn die Richtlinie deaktiviert ist, werden Anfragemethoden groß geschrieben.\nDies ist das Verhalten von Brave 108 oder Versionen davor.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, werden Anfragemethoden nicht groß geschrieben, es sei denn, es erfolgt ein die Groß-/Kleinschreibung nicht berücksichtigender Abgleich mit DELETE, GET, HEAD, OPTIONS, POST oder PUT.\nDadurch würde der Antwortheader fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" abgelehnt und der Antwortheader fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\" akzeptiert.\n\nHinweis: Die Anfragemethoden \"post\" und \"put\" sind nicht betroffen, während \"patch\" betroffen ist.\n\nDiese Richtlinie ist vorübergehend und wird zukünftig entfernt.";
AccessibilityImageLabelsEnabled.pfm_title = "\"Get Image Descriptions from Google\" aktivieren";
AccessibilityImageLabelsEnabled.pfm_description = "Über die Bedienungshilfe „Get Image Descriptions from Google“ erhalten sehbehinderte Screenreader-Nutzer Beschreibungen für unbeschriftete Bilder im Internet. Nutzer, die diese Funktion aktivieren, können einen anonymen Google-Dienst verwenden, um automatische Beschreibungen für unbeschriftete Bilder im Internet zu erhalten.\n\nWenn diese Funktion aktiviert ist, werden die Bildinhalte an Google-Server gesendet, um Beschreibungen zu erstellen. Es werden keine Cookies oder anderen Nutzerdaten gesendet und Google speichert oder protokolliert keine Bildinhalte.\n\nWenn diese Richtlinie aktiviert ist, wird die Funktion „Get Image Descriptions from Google“ aktiviert. Sie betrifft jedoch nur Nutzer, die einen Screenreader oder ähnliche Hilfstechnologien verwenden.\n\nIst sie deaktiviert, können Nutzer diese Funktion nicht aktivieren.\n\nIst die Richtlinie nicht festgelegt, können Nutzer auswählen, ob sie diese Funktion verwenden möchten oder nicht.\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "DNS-Abfragen für zusätzliche DNS-Eintragstypen erlauben";
AdditionalDnsQueryTypesEnabled.pfm_description = "Diese Richtlinie bestimmt, ob Brave zusätzliche DNS-Eintragstypen abfragen darf, wenn der Browser unsichere DNS-Anfragen sendet. Diese Richtlinie hat keine Auswirkungen auf DNS-Abfragen, die über die Funktion „Sicheres DNS“ getätigt werden, die immer zusätzliche DNS-Typen abfragen darf.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, können zusätzliche Typen wie HTTPS (DNS-Typ 65) abgefragt werden, zusätzlich zu A (DNS-Typ 1) und AAAA (DNS-Typ 28).\n\nIst die Richtlinie deaktiviert, wird das DNS nur für A (DNS-Typ 1) und/oder AAAA (DNS-Typ 28) abgefragt.\n\nDiese Richtlinie ist eine vorübergehende Maßnahme. Sie wird aus künftigen Versionen von Brave entfernt. Nachdem sie entfernt wurde, kann Brave zusätzliche DNS-Typen immer abfragen.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Einstellungen für Werbung für Websites mit aufdringlichen Werbeanzeigen";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Werbung auf allen Websites zulassen\n2 - Werbung auf Websites mit aufdringlichen Werbeanzeigen nicht zulassen\nWenn SafeBrowsingEnabled nicht auf \"False\" gesetzt ist, wird auf allen Websites Werbung zugelassen, sofern AdsSettingForIntrusiveAdsSites auf 1 gesetzt oder nicht konfiguriert ist.\n\nIst die Richtlinie auf 2 gesetzt, wird Werbung auf Websites mit aufdringlichen Werbeanzeigen blockiert.";
AdvancedProtectionAllowed.pfm_title = "Erweiterte Sicherheitsfunktionen für Teilnehmer des erweiterten Sicherheitsprogramms aktivieren";
AdvancedProtectionAllowed.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob Teilnehmer am erweiterten Sicherheitsprogramm zusätzlich geschützt werden. Bei manchen dieser Funktionen werden unter Umständen Daten mit Google geteilt. Teilnehmer am erweiterten Sicherheitsprogramm können beispielsweise ihre heruntergeladenen Dateien für einen Malware-Scan an Google senden. Wird die Richtlinie auf \"true\" gesetzt oder nicht konfiguriert, werden entsprechende Nutzer zusätzlich geschützt. Wird die Richtlinie auf \"false\" gesetzt, stehen ihnen nur die Standardfunktionen für Privatnutzer zur Verfügung.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Liste der Ursprünge, für die alle HTTP-Authentifizierungsschemas zulässig sind";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "Mit dieser Richtlinie wird festgelegt, für welche Ursprünge alle HTTP-Authentifizierungsschemas zulässig sind, die von Brave unterstützt werden, unabhängig von der Richtlinie „AuthSchemes“.\n\nAb Brave-Version 161 gilt diese Richtlinie nur für Zielserverursprünge und nicht für Authentifizierungsherausforderungen von Proxyservern. Wenn du alle HTTP-Authentifizierungsschemas für Proxyserver zulassen möchtest, verwende stattdessen die Richtlinie „AllHttpAuthSchemesAllowedForProxies“. Vor Version 161 dürfen Proxyserver, die dieser Richtlinie entsprechen, auch alle HTTP-Authentifizierungsschemas verwenden, es sei denn, „AllHttpAuthSchemesAllowedForProxies“ ist festgelegt.\n\nFür das Ursprungsmuster muss folgendes Format verwendet werden: https://support.google.com/chrome/a?p=url_blocklist_filter_format. In „AllHttpAuthSchemesAllowedForOrigins“ können bis zu 1.000 Ausnahmen definiert werden.\nFür die Hostkomponente sind Platzhalter zulässig (z. B. „*:8000“ passt für alle Hosts auf Port 8000). Wenn alle Schemas oder alle Ports passen sollen, kannst du die Komponente vollständig weglassen (z. B. passt „beispiel.de“ für jedes Schema und jeden Port). Ein Hostname (z. B. „beispiel.de“) stimmt auch mit seinen Subdomains überein. Wenn ein Host genau passen soll und seine Subdomains ausgeschlossen werden sollen, stell ihm einen Punkt voran (z. B. „.beispiel.de“). Verwende ein einzelnes Sternchen („*“), damit alle Ursprünge passen.";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Liste der Proxyserver, für die alle HTTP-Authentifizierungsschemas zulässig sind";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "Mit dieser Richtlinie wird festgelegt, für welche Proxyserver alle HTTP-Authentifizierungsschemas zulässig sind, die von Brave unterstützt werden, unabhängig von der Richtlinie „AuthSchemes“.\n\nFormatiere das Proxyserver-Muster gemäß dem Filterformat der URL-Sperrliste (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Es können bis zu 1.000 Ausnahmen definiert werden.\nFür die Hostkomponente sind Platzhalter zulässig (z. B. „*:8080“ passt für alle Proxys auf Port 8080). Ein Hostname (z. B. „proxy.beispiel.de“) stimmt auch mit seinen Subdomains überein. Wenn ein Host genau passen soll und seine Subdomains ausgeschlossen werden sollen, stell ihm einen Punkt voran (z. B. „.proxy.beispiel.de“).\n\nWenn diese Richtlinie nicht konfiguriert ist, werden für die Proxy-Authentifizierung nur die in „AuthSchemes“ angegebenen HTTP-Authentifizierungsschemas unterstützt (oder die Standardschemas, falls nicht konfiguriert).";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Seiten mit dem Header „Cache-Control: no-store“ dürfen im Back-Forward-Cache gespeichert werden";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Diese Richtlinie legt fest, ob eine Seite mit dem Header „Cache-Control: no-store“ im Back-Forward-Cache gespeichert werden kann. Es wird möglicherweise nicht erwartet, dass die Seite aus dem Back-Forward-Cache wiederhergestellt wird, da einige vertrauliche Daten auch nach der Wiederherstellung angezeigt werden können, selbst wenn die Seite nicht mehr zugänglich ist.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, kann die Seite mit dem Header „Cache-Control: no-store“ aus dem Back-Forward-Cache wiederhergestellt werden, es sei denn, die Cache-Bereinigung wird ausgelöst (z. B. wenn es eine reine HTTP-Cookie-Änderung auf der Website gibt).\n\nIst die Richtlinie deaktiviert, wird die Seite mit dem Header „Cache-Control: no-store“ nicht im Back-Forward-Cache gespeichert.";
AllowCrossOriginAuthPrompt.pfm_title = "Ursprungsübergreifende HTTP-Authentifizierungsaufforderungen";
AllowCrossOriginAuthPrompt.pfm_description = "Wenn die Richtlinie aktiviert ist, kann in Bildern von Drittanbietern auf einer Seite eine Authentifizierungsaufforderung angezeigt werden.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, kann in Bildern von Drittanbietern keine Authentifizierungsaufforderung angezeigt werden.\n\nDiese Richtlinie ist normalerweise zum Schutz vor Phishing deaktiviert.";
AllowDeletingBrowserHistory.pfm_title = "Löschen des Browserverlaufs und des Downloadverlaufs aktivieren";
AllowDeletingBrowserHistory.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, können der Browser‑ und der Downloadverlauf in Chrome gelöscht werden und Nutzer können diese Einstellung nicht ändern.\n\nIst die Richtlinie deaktiviert, können der Browser‑ und der Downloadverlauf nicht gelöscht werden. Dies bedeutet jedoch nicht unbedingt, dass die Verläufe erhalten bleiben. Möglicherweise sind Nutzer berechtigt, die Dateien der Verlaufsdatenbanken direkt zu bearbeiten oder zu löschen. Außerdem kann der Browser jederzeit selbst einige oder alle Verlaufselemente archivieren oder nach deren Ablaufdatum löschen.";
AllowDinosaurEasterEgg.pfm_title = "Easter Egg-Dinosaurierspiel zulassen";
AllowDinosaurEasterEgg.pfm_description = "Wenn die Richtlinie auf „True“ gesetzt ist, können Nutzer das Dinosaurierspiel spielen. Ist sie auf „False“ gesetzt, können Nutzer das Easter-Egg-Dinosaurierspiel nicht spielen, wenn das Gerät offline ist.\n\nWenn die Richtlinie nicht konfiguriert ist, können Nutzer das Dinosaurierspiel nicht auf registrierten Google Chrome OS-Geräten spielen, auf anderen aber schon.";
AllowFileSelectionDialogs.pfm_title = "Aufrufen von Dialogfeldern zur Dateiauswahl zulassen";
AllowFileSelectionDialogs.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, kann Chrome Dialogfelder zur Dateiauswahl anzeigen und Nutzer können diese öffnen.\n\nWird die Richtlinie deaktiviert, erscheint stattdessen eine Meldung, wenn Nutzer mit einer Aktion ein Dialogfeld zur Dateiauswahl öffnen würden, etwa beim Importieren von Lesezeichen, Hochladen von Dateien und Speichern von Links. Es wird angenommen, dass der Nutzer im Dialogfeld zur Dateiauswahl auf „Abbrechen“ geklickt hat.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Randomisierung der Socket-Poolgröße für Proxys zulassen";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "Die Randomisierung der Socket-Poolgröße ist ein Sicherheitsmechanismus, der verhindert, dass Angreifer deterministische Kapazitätslimits ausnutzen, um websiteübergreifende Informationen zu erhalten.\nWenn die Kapazität eines Pools normalerweise 128 Sockets beträgt, wird der Pool durch diesen Mechanismus zufällig auf einen Wert zwischen 128 und 256 begrenzt.\nDadurch können bis zu 2-mal so viele Verbindungen zum Proxy hergestellt werden, in der Praxis liegt der erwartete Wert jedoch eher bei 1,2-mal so vielen Verbindungen.\n\nDies wirkt sich auf die Einstellungen von „MaxConnectionsPerProxy“ und „MaxConnectionsPerProxyForWebSocket“ aus.\nAnstatt dass die Obergrenze durch diese Einstellungen festgelegt wird, beträgt sie das Zweifache ihrer Werte (auch wenn der tatsächliche Wert in der Praxis eher dem 1,2-Fachen entspricht).\n\nDies ist standardmäßig für alle Pools aktiviert, aber mit dieser Richtlinie kann die Funktion speziell für Proxy-Pools deaktiviert werden.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Webauthentifizierungsanfragen auf Websites mit fehlerhaften TLS-Zertifikaten zulassen.";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Wenn die Richtlinie aktiviert ist, erlaubt Brave Webauthentifizierungsanfragen auf Websites mit fehlerhaften TLS-Zertifikaten (d. h. Websites, die als nicht sicher eingestuft werden).\n\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist, gilt das Standardverhalten zum Blockieren solcher Anfragen.";
AllowedDomainsForApps.pfm_title = "Domains festlegen, die auf Google Workspace zugreifen dürfen";
AllowedDomainsForApps.pfm_description = "Wenn die Richtlinie konfiguriert ist, sind in Google Workspace die eingeschränkten Anmeldefunktionen von Chrome aktiviert und es wird verhindert, dass Nutzer diese Einstellung ändern. Nutzer können nur über Konten der angegebenen Domains auf Tools von Google zugreifen. Möchtest du gmail.com- oder googlemail.com-Konten zulassen, musst du der Domainliste „consumer_accounts“ (ohne Anführungszeichen) hinzufügen. Diese Einstellung verhindert, dass Nutzer sich auf einem verwalteten Gerät, für das eine Authentifizierung durch Google notwendig ist, anmelden und ein zweites Konto hinzufügen können, wenn dieses Konto nicht zu einer der Domains in der Zulassungsliste gehört.\n\nWenn du diese Einstellung leer lässt oder nicht konfigurierst, können Nutzer über beliebige Konten auf Google Workspace zugreifen.\n\nNutzer können diese Einstellung weder ändern noch überschreiben.\n\nHinweis: Durch diese Richtlinie wird allen HTTP- und HTTPS-Anfragen, die an google.com-Domains gesendet werden, der Header „X-GoogApps-Allowed-Domains“ angehängt (siehe https://support.google.com/a/answer/1668854).";
AlternateErrorPagesEnabled.pfm_title = "Alternative Fehlerseiten aktivieren";
AlternateErrorPagesEnabled.pfm_description = "Wenn die Richtlinie auf „True“ gesetzt ist, verwendet Brave alternative Fehlerseiten (z. B. „Seite nicht gefunden“). Ist sie auf „False“ gesetzt, verwendet Brave niemals alternative Fehlerseiten.\n\nWenn die Richtlinie konfiguriert ist, kann sie von Nutzern nicht geändert werden. Wird die Richtlinie nicht konfiguriert, ist sie aktiviert, aber Nutzer können die Einstellung ändern.";
AlternativeBrowserParameters.pfm_title = "Befehlszeilenparameter für den alternativen Browser.";
AlternativeBrowserParameters.pfm_description = "Wenn für die Richtlinie eine Liste von Strings festgelegt ist, wird jeder String als separater Befehlszeilenparameter an den alternativen Browser weitergegeben. Unter Microsoft® Windows® werden die Parameter durch Leerzeichen verbunden. Unter macOS und Linux® werden auch Parameter mit Leerzeichen als einzelne Parameter behandelt.\n\nIst in einem Parameter ${url} enthalten, wird ${url} durch die URL der Seite ersetzt, die geöffnet werden soll. Wenn kein Parameter ${url} enthält, wird die URL an das Ende der Befehlszeile angehängt.\n\nUmgebungsvariablen werden erweitert. Unter Microsoft® Windows® wird %ABC% durch den Wert der ABC-Umgebungsvariablen ersetzt. Unter macOS und Linux® wird ${ABC} durch den Wert der ABC-Umgebungsvariablen ersetzt.\n\nIst die Richtlinie nicht konfiguriert, wird nur die URL als Befehlszeilenparameter weitergegeben.";
AlternativeBrowserPath.pfm_title = "Für konfigurierte Websites soll ein alternativer Browser geöffnet werden.";
AlternativeBrowserPath.pfm_description = "Mit dieser Richtlinie wird festgelegt, welcher Befehl zum Öffnen von URLs in einem alternativen Browser verwendet werden soll. Die Richtlinie kann mit ${ie}, ${firefox}, ${safari}, ${opera}, ${edge} oder einem Dateipfad konfiguriert werden. Wenn für die Richtlinie ein Dateipfad festgelegt ist, wird diese Datei als ausführbare Datei verwendet. ${ie} ist nur für Microsoft® Windows® verfügbar. ${safari} und ${edge} sind nur für Microsoft® Windows® und macOS verfügbar.\n\nIst die Richtlinie nicht konfiguriert, wird eine plattformspezifische Standardeinstellung verwendet: Internet Explorer® für Microsoft® Windows® oder Safari® für macOS. Unter Linux® wird kein alternativer Browser geöffnet.";
AlwaysOpenPdfExternally.pfm_title = "PDF-Dateien immer extern öffnen";
AlwaysOpenPdfExternally.pfm_description = "Wenn die Richtlinie aktiviert ist, wird der interne PDF-Viewer in Brave ausgeschaltet und PDF-Dateien werden als Download behandelt. Nutzer können sie dann mit der Standardanwendung öffnen.\n\nIst die Richtlinie deaktiviert, werden PDF-Dateien mit dem PDF-Plug‑in geöffnet, sofern es nicht von den Nutzern deaktiviert wird.\n\nWenn diese Richtlinie konfiguriert ist, kann sie von Nutzern in Brave nicht geändert werden. Ist die Richtlinie nicht konfiguriert, können Nutzer entscheiden, ob das PDF extern geöffnet werden soll.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Aktiviert die passive Authentifizierung für Profiltypen.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Aktiviert die passive Authentifizierung nur für reguläre Sitzungen.\n1 - Aktiviert die passive Authentifizierung für Inkognito- und reguläre Sitzungen.\n2 - Aktiviert die passive Authentifizierung für Gast- und reguläre Sitzungen.\n3 - Aktiviert die passive Authentifizierung für reguläre, Inkognito- und Gastsitzungen.\nÜber diese Richtlinie kannst du festlegen, ob die passive Authentifizierung für Inkognito- und Gastprofile in Brave zulässig ist.\n\nEine passive Authentifizierung ist eine HTTP-Authentifizierung mit Standardanmeldedaten. Sie wird durchgeführt, wenn keine spezifischen Anmeldedaten über ein Challenge-Response-Verfahren (NTLM, Kerberos oder Negotiate) angegeben werden.\n\nWenn du die Option \"RegularOnly\" festlegst (Wert: 0), ist die passive Authentifizierung ausschließlich für reguläre Sitzungen zulässig. Inkognito- und Gastsitzungen dürfen dann nicht passiv authentifiziert werden.\n\nWenn du die Option \"IncognitoAndRegular\" festlegst (Wert: 1), ist die passive Authentifizierung für Inkognito- und reguläre Sitzungen zulässig. Gastsitzungen dürfen dann nicht passiv authentifiziert werden.\n\nWenn du die Option \"GuestAndRegular\" festlegst (Wert: 2), ist die passive Authentifizierung für Gast- und reguläre Sitzungen zulässig. Inkognitositzungen dürfen dann nicht passiv authentifiziert werden.\n\nWenn du die Option \"All\" festlegst (Wert: 3), ist die passive Authentifizierung für alle Sitzungen zulässig.\n\nFür reguläre Profile ist die passive Authentifizierung immer zulässig.\n\nWenn diese Richtlinie in Brave (Version 81 oder neuer) nicht konfiguriert ist, wird die passive Authentifizierung nur für reguläre Sitzungen aktiviert.";
AudioCaptureAllowed.pfm_title = "Audioaufzeichnung gestatten oder ablehnen";
AudioCaptureAllowed.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, wird beim Zugriff für Audioaufnahmen beim Nutzer nachgefragt. Ausgenommen sind URLs in der Liste \"AudioCaptureAllowedUrls\".\n\nIst diese Richtlinie deaktiviert, wird nie beim Nutzer nachgefragt und die Möglichkeit für Audioaufnahmen steht nur URLs in der Liste \"AudioCaptureAllowedUrls\" zur Verfügung.\n\nHinweis: Die Richtlinie gilt für jegliche Form der Audioeingabe, nicht nur für das integrierte Mikrofon.";
AudioCaptureAllowedUrls.pfm_title = "URLs, denen ohne Nachfrage Zugriff auf Audioaufnahmegeräte gestattet wird";
AudioCaptureAllowedUrls.pfm_description = "Wenn du diese Richtlinie konfigurierst, gibst du eine Liste von URLs an, deren Muster mit dem SecurityOrigin-Objekt der anfragenden URL abgeglichen werden. Bei einer Übereinstimmung wird ohne Nachfrage Zugriff auf Audioaufnahmegeräte gewährt.\n\nAusführliche Informationen zu gültigen url-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/. Das Muster *, das bei jeder URL zu einer Übereinstimmung führt, wird von dieser Richtlinie jedoch nicht unterstützt.";
AudioSandboxEnabled.pfm_title = "Ausführen der Audio-Sandbox zulassen";
AudioSandboxEnabled.pfm_description = "Mit dieser Richtlinie kann die Sandbox für den Audioprozess konfiguriert werden.\nWenn die Richtlinie aktiviert ist, wird der Audioprozess in einer Sandbox ausgeführt.\nWird sie deaktiviert, erfolgt die Ausführung nicht in einer Sandbox und das WebRTC-Audioverarbeitungsmodul wird im Renderer-Prozess ausgeführt.\nDadurch entstehen Sicherheitsrisiken für den Nutzer, die auf die Ausführung des Audiosubsystems ohne Sandbox zurückzuführen sind.\nWenn die Richtlinie nicht konfiguriert wird, kommt die Standardkonfiguration für die Audio-Sandbox zum Einsatz, die je nach Plattform variiert.\nMit dieser Richtlinie sollen Unternehmen die Möglichkeit erhalten, die Audio-Sandbox zu deaktivieren, falls sie Softwarekonfigurationen für die Sicherheit einsetzen, die mit der Sandbox in Konflikt stehen könnten.";
AuthNegotiateDelegateAllowlist.pfm_title = "Zulassungsliste für Kerberos-Bevollmächtigungs-Server";
AuthNegotiateDelegateAllowlist.pfm_description = "Wenn diese Richtlinie konfiguriert ist, werden Server zugewiesen, an die Brave Anmeldedaten von Nutzern weiterleiten kann. Trenne mehrere Servernamen durch Kommas. Platzhalter wie * sind zulässig.\n\nWenn die Richtlinie nicht konfiguriert ist, leitet Brave keine Anmeldedaten von Nutzern weiter, auch nicht an Server innerhalb eines Intranets.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Mit der KDC-Richtlinie können Anmeldedaten delegiert werden.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Wenn die Richtlinie aktiviert ist, wird bei der HTTP-Authentifizierung die Genehmigung durch die KDC-Richtlinie berücksichtigt. Das heißt, Brave leitet nur dann Nutzeranmeldedaten an den verwendeten Dienst weiter, wenn KDC „OK-AS-DELEGATE“ für das Dienst-Ticket festlegt. Weitere Informationen findest du unter RFC 5896 (https://tools.ietf.org/html/rfc5896.html). Der Dienst sollte auch durch „AuthNegotiateDelegateAllowlist“ zugelassen sein.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, wird die KDC-Richtlinie auf unterstützten Plattformen ignoriert und nur die Richtlinie „AuthNegotiateDelegateAllowlist“ berücksichtigt.\n\nUnter Microsoft® Windows® wird die KDC-Richtlinie immer umgesetzt.";
AuthSchemes.pfm_title = "Unterstützte Authentifizierungsschemas";
AuthSchemes.pfm_description = "Wenn diese Richtlinie konfiguriert ist, wird festgelegt, welche HTTP Authentifizierungsschemas Brave unterstützt.\n\nWenn die Richtlinie nicht konfiguriert ist, kommen alle 4 Schemas zum Einsatz.\n\nGültige Werte:\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nHinweis: Trenne mehrere Werte durch Kommas.";
AuthServerAllowlist.pfm_title = "Zulassungsliste für Authentifizierungsserver";
AuthServerAllowlist.pfm_description = "Wenn diese Richtlinie konfiguriert ist, wird festgelegt, welche Server für die integrierte Authentifizierung zulässig sind. Die integrierte Authentifizierung wird nur dann aktiviert, wenn Brave eine Authentifizierungsaufforderung von einem Proxy oder einem Server erhält, der sich in dieser Liste zulässiger Programme befindet.\n\nWenn die Richtlinie nicht konfiguriert ist, versucht Brave zu ermitteln, ob sich ein Server im Intranet befindet. Es reagiert nur dann auf IWA-Anfragen. Wenn der Server sich dagegen im Internet befindet, werden dessen IWA-Anfragen von Brave ignoriert.\n\nTrenne mehrere Servernamen durch Kommas. Platzhalter wie * sind zulässig.";
AutoLaunchProtocolsFromOrigins.pfm_title = "Eine Liste mit Protokollen festlegen, über die eine externe App aus aufgeführten Quellen gestartet werden kann, ohne beim Nutzer nachzufragen";
AutoLaunchProtocolsFromOrigins.pfm_description = "Ermöglicht das Erstellen einer Liste mit Protokollen. Außerdem kannst du mit jedem Protokoll eine Liste mit zugelassenen Quellmustern verknüpfen, durch die eine externe App gestartet werden kann, ohne beim Nutzer nachzufragen. Das abschließende Trennzeichen darf nicht gemeinsam mit dem Protokoll angegeben werden. Gib also beispielsweise „skype“ ein statt „skype:“ oder „skype://“.\n\nWenn diese Richtlinie konfiguriert ist, darf ein Protokoll nur dann ohne Nachfrage eine externe App starten, wenn es auf der Liste aufgeführt ist und die Quelle der Website, durch die das Protokoll gestartet werden soll, mit einem der Muster in der Liste „allowed_origins“ des jeweiligen Protokolls übereinstimmt. Wenn eine der Bedingungen nicht erfüllt ist, wird die Nachfrage beim Starten externer Protokolle nicht durch die Richtlinie übersprungen.\n\nWenn diese Richtlinie nicht konfiguriert ist, können standardmäßig keine Protokolle ohne Nachfrage gestartet werden. Nutzer können für einzelne Protokolle oder Websites auf die Aufforderung verzichten, es sei denn, die Richtlinie ExternalProtocolDialogShowAlwaysOpenCheckbox ist deaktiviert. Diese Richtlinie hat keine Auswirkung auf vom Nutzer festgelegte Ausnahmen für einzelne Protokolle oder Websites.\n\nEs werden ähnliche URL-Muster wie in der Richtlinie URLBlocklist verwendet. Sie sind unter https://support.google.com/chrome/a?p=url_blocklist_filter_format beschrieben.\n\nDie Muster für diese Richtlinie dürfen allerdings keine „/path“- oder „@query“-Elemente enthalten. Muster, die „/path“- oder „@query“-Elemente enthalten, werden ignoriert.\nUnter https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins erhältst du weitere Informationen zu Schema und Formatierung.";
AutoOpenAllowedForURLs.pfm_title = "URLs, auf die AutoOpenFileTypes angewendet werden können";
AutoOpenAllowedForURLs.pfm_description = "Eine Liste von URLs, die angibt, auf welche URLs die Richtlinie AutoOpenFileTypes angewendet wird. Diese Richtlinie hat keine Auswirkung auf automatisch geöffnete Werte, die von Nutzern festgelegt werden.\n\nWenn diese Richtlinie konfiguriert ist, werden Dateien nur automatisch von ihr geöffnet, wenn die URL Teil dieses Satzes ist und der Dateityp in AutoOpenFileTypes aufgelistet ist. Ist eine dieser Bedingungen nicht erfüllt, wird der Download nicht automatisch von der Richtlinie geöffnet.\n\nIst sie nicht konfiguriert, werden alle Downloads, für die der Dateityp in AutoOpenFileTypes aufgelistet ist, automatisch geöffnet.\n\nEin URL-Muster muss dem unter https://support.google.com/chrome/a?p=url_blocklist_filter_format beschriebenen Format entsprechen.";
AutoOpenFileTypes.pfm_title = "Liste von Dateitypen, die nach dem Download automatisch geöffnet werden sollen";
AutoOpenFileTypes.pfm_description = "Liste von Dateitypen, die nach dem Download automatisch geöffnet werden sollen. Das vorangestellte Trennzeichen sollte beim Aufführen der Dateitypen nicht mit angegeben werden. Gib also beispielsweise „txt“ und nicht „.txt“ an.\n\nDateitypen, die automatisch geöffnet werden sollen, unterliegen dennoch den aktivierten Safe Browsing-Überprüfungen und werden nicht geöffnet, falls sie diese nicht bestehen.\n\nWenn diese Richtlinie nicht konfiguriert ist, werden nach dem Download nur die Dateitypen automatisch geöffnet, die der Nutzer bereits angegeben hat.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
AutoSelectCertificateForUrls.pfm_title = "Client-Zertifikate für diese Websites automatisch auswählen";
AutoSelectCertificateForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste von URL-Mustern erstellen, durch die Websites angegeben werden, für die Chrome automatisch ein Clientzertifikat auswählen kann. Der Wert ist ein Array von String-JSON-Wörterbüchern. Jedes Wörterbuch muss das Format { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER } haben, wobei $URL_PATTERN ein Muster zum Festlegen der Inhalte ist. $FILTER schränkt ein, aus welchen Clientzertifikaten der Browser automatisch auswählt. Unabhängig vom Filter werden nur Zertifikate ausgewählt, die mit der Zertifizierungsanforderung des Servers übereinstimmen. Unter Android und iOS kann Chrome nur Clientzertifikate auswählen, die Chrome selbst bereitgestellt hat. Chrome kann nicht auf Zertifikate zugreifen, die auf Betriebssystemebene installiert sind.\n\nBeispiele für die Verwendung des Abschnitts $FILTER:\n\n* Wenn für $FILTER { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } } festgelegt ist, werden nur Clientzertifikate ausgewählt, die über ein Zertifikat mit dem CommonName $ISSUER_CN ausgestellt wurden.\n\n* Wenn $FILTER sowohl den Abschnitt \"ISSUER\" als auch den Abschnitt \"SUBJECT\" enthält, werden nur Clientzertifikate ausgewählt, die beide Bedingungen erfüllen.\n\n* Wenn $FILTER einen \"SUBJECT\"-Abschnitt mit dem Wert \"O\" enthält, muss ein Zertifikat mindestens eine Organisation haben, die mit dem angegebenen Wert übereinstimmt, um ausgewählt zu werden.\n\n* Wenn $FILTER einen \"SUBJECT\"-Abschnitt mit einem \"OU\"-Wert enthält, muss ein Zertifikat mindestens eine Organisationseinheit haben, die mit dem angegebenen Wert übereinstimmt, um ausgewählt zu werden.\n\n* Wenn für $FILTER {} festgelegt ist, wird die Auswahl der Clientzertifikate nicht zusätzlich eingeschränkt. Beachte, dass vom Webserver bereitgestellte Filter weiterhin gelten.\n\nWenn die Richtlinie nicht konfiguriert ist, findet für keine Website eine automatische Auswahl statt.\nUnter https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls erhältst du weitere Informationen zu Schema und Formatierung.";
AutofillGenAiSettings.pfm_title = "Einstellungen für auf generativer KI basierende Funktionen in Autofill";
AutofillGenAiSettings.pfm_description = "0 - Auf generativer KI basierende Funktionen in Autofill zulassen und KI-Modelle verbessern.\n1 - Auf generativer KI basierende Funktionen in Autofill zulassen, ohne KI-Modelle zu verbessern.\n2 - Auf generativer KI basierende Funktionen in Autofill nicht zulassen.\nBei diesen Funktionen in Brave werden generative KI-Modelle eingesetzt, um Nutzern beim Ausfüllen von Formularen im Web zu helfen. Zur Verwendung dieser Funktionen muss Brave Daten wie die Struktur der Formulare, mit denen ein Nutzer interagiert, und für „Mit Gemini ausfüllen“ die Freitextabfragen, die ein Nutzer zur Suche in verbundenen Gemini-Apps eingibt, erheben und an einen Google-Server senden, auf dem ein generatives KI-Modell ausgeführt wird.\n\nWenn die Richtlinie auf „0“ (Auf generativer KI basierende Funktionen in Autofill zulassen und KI-Modelle verbessern) gesetzt ist, dürfen die Funktionen verwendet werden und Google darf relevante Daten nutzen, um seine KI-Modelle zu verbessern. Relevante Daten können je nach Funktion Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftliches Feedback sein. „0“ ist der Standardwert, sofern unten nicht anders angegeben.\n\nWenn die Richtlinie auf „1“ (Auf generativer KI basierende Funktionen in Autofill zulassen, ohne KI-Modelle zu verbessern) gesetzt ist, dürfen die Funktionen verwendet werden, Google darf aber keine Modelle mithilfe von Nutzerinhalten (einschließlich Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftlichen Feedbacks) verbessern. „1“ ist der Standardwert für Unternehmensnutzer, die über die Google Admin console verwaltet werden, und für Konten einer Bildungseinrichtung, die über Google Workspace verwaltet werden.\n\nWenn die Richtlinie auf „2“ (Auf generativer KI basierende Funktionen in Autofill nicht zulassen) gesetzt ist, sind die Funktionen nicht zulässig.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nZu den Funktionen der generativen KI in Autofill gehören:\n\n– Optimierte Formularbearbeitung: Verwendet KI, um die Felder eines Formulars zu identifizieren und zu klassifizieren, sodass mehr Felder ausgefüllt werden können.\n\n– Mit Gemini suchen und ausfüllen: Sucht Informationen in den Apps, die ein Nutzer mit Gemini verknüpft hat, und bietet sie zum Ausfüllen an, entweder als proaktive Vorschläge in einem Formular oder als Antwort auf eine Anfrage, die der Nutzer schreibt.\n\nDiese Richtlinie überschreibt die Richtlinie „AutofillPredictionSettings“, die weiterhin gilt, wenn diese Richtlinie nicht konfiguriert ist. Für die Funktion „Mit Gemini suchen und ausfüllen“ muss außerdem die Richtlinie „GeminiSettings“ aktiviert sein.\n\nDiese Richtlinie steuert keine Autofill-Funktionen, die keine generative KI verwenden.\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
AutofillSettings.pfm_title = "Autofill-Datentypen für bestimmte Websites blockieren";
AutofillSettings.pfm_description = "Wenn du diese Richtlinie konfigurierst, kannst du angeben, welche Autofill-Datentypen für bestimmte URL-Muster blockiert werden.\n\nDie Richtlinie ist als Liste von Wörterbüchern strukturiert. Jedes Wörterbuch muss Folgendes enthalten:\n* „url_pattern“: Ein URL-Muster für die Inhaltseinstellungen des Hauptframes (z. B. „https://[*.]beispiel.de“).\n* „blocked_types“: Eine Liste von Strings, die die Kategorien von Autofill-Daten darstellen, die blockiert werden sollen.\n\nDie unterstützten Werte für „blocked_types“ sind:\n* „contact_info“: Das Ausfüllen und Speichern von Kontaktdaten wird blockiert.\n* „payments“: Das Ausfüllen und Speichern von Kreditkarten und Zahlungsmethoden wird blockiert.\n* „identity_docs“: Das Ausfüllen und Speichern von Identitätsdokumenten (z. B. Reisepass, Führerschein, Personalausweis) wird blockiert.\n* „travel“: Das Ausfüllen und Speichern von Reiseinformationen (z. B. Flugreservierungen, Fahrzeugkennzeichen) wird blockiert.\n* „shopping“: Das Ausfüllen und Speichern von Shopping-Informationen (z. B. Onlinebestellungen, Sendungen) wird blockiert.\n* „all“: Das Ausfüllen und Speichern aller Autofill-Datentypen wird blockiert.\n\nWenn ein Datentyp für eine Website blockiert ist, sind sowohl das Erstellen von Vorschlägen als auch die Aufforderung zum Speichern/Importieren neuer Daten dieses Typs auf dieser Website deaktiviert.\n\nWenn eine URL mit mehreren Mustereinträgen in der Liste übereinstimmt, werden die blockierten Typen aus allen übereinstimmenden Einträgen zusammengeführt. Ungültige URL-Muster in der Liste werden ignoriert.\n\nWenn diese Richtlinie nicht konfiguriert ist, werden keine Autofill-Datentypen nach Domain blockiert.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter * wird unterstützt. Dieses Muster entspricht jeder URL mit beliebigem Schema, Port und Pfad.\nUnter https://chromeenterprise.google/policies/?policy=AutofillSettings erhältst du weitere Informationen zu Schema und Formatierung.";
AutomatedPasswordChangeSettings.pfm_title = "Automatische Passwortänderung aktivieren";
AutomatedPasswordChangeSettings.pfm_description = "0 - Nutzung der Funktion mit Verbesserung von KI‑Modellen zulassen\n1 - Nutzung der Funktion ohne Verbesserung von KI‑Modellen zulassen\n2 - Funktion nicht zulassen\nMit dieser Richtlinie wird die Verfügbarkeit der Funktion zur automatischen Passwortänderung von Brave festgelegt.\n\nWenn diese Option aktiviert ist, kann ein Nutzer einen Prozess auslösen, bei dem der Browser automatisch versucht, sein Passwort auf einer Website zu ändern. Dieser Prozess wird von generativer KI gesteuert. Das neue Passwort wird im Passwortmanager des Browsers gespeichert.\n\n„0“ = Die Funktion darf verwendet werden und Google darf relevante Daten nutzen, um seine KI‑Modelle zu verbessern. Relevante Daten können je nach Funktion Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftliches Feedback sein. Sie werden möglicherweise auch manuell geprüft, um KI‑Modelle zu verbessern. „0“ ist der Standardwert, außer in den unten angegebenen Fällen.\n\n„1“ = Die Funktion darf verwendet werden, Google darf aber keine Modelle mithilfe von Nutzerinhalten (einschließlich Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftlichem Feedback) verbessern. „1“ ist der Standardwert für Unternehmensnutzer, die über die Admin-Konsole verwaltet werden, sowie für Konten von Bildungseinrichtungen, die über Google Workspace verwaltet werden.\n\n„2“ = Die Funktion darf nicht verwendet werden.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Automatische Downloads auf diesen Websites zulassen";
AutomaticDownloadsAllowedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL-Mustern festlegen und so angeben, welche Websites automatisch mehrere Dateien herunterladen dürfen.\n\nAusführliche Informationen zu gültigen URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns.\n\nWenn eine URL mit den Optionen „AutomaticDownloadsAllowedForUrls“ und „AutomaticDownloadsBlockedForUrls“ übereinstimmt, hat „AutomaticDownloadsBlockedForUrls“ Vorrang.\n\nWenn diese Richtlinie nicht konfiguriert ist, gilt „DefaultAutomaticDownloadsSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Automatische Downloads auf diesen Websites blockieren";
AutomaticDownloadsBlockedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL-Mustern festlegen und so angeben, welche Websites nicht automatisch mehrere Dateien herunterladen dürfen.\n\nAusführliche Informationen zu gültigen URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns.\n\nWenn eine URL mit den Optionen „AutomaticDownloadsAllowedForUrls“ und „AutomaticDownloadsBlockedForUrls“ übereinstimmt, hat „AutomaticDownloadsBlockedForUrls“ Vorrang.\n\nWenn diese Richtlinie nicht konfiguriert ist, gilt „DefaultAutomaticDownloadsSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Automatischen Vollbildmodus auf diesen Websites zulassen";
AutomaticFullscreenAllowedForUrls.pfm_description = "Aus Sicherheitsgründen erfordert das Aufrufen der Web-API „requestFullscreen()“ eine vorherige Nutzergeste („vorübergehende Aktivierung“), andernfalls tritt ein Fehler auf. Durch die persönlichen Einstellungen von Nutzern kann es bestimmten Ursprüngen erlaubt sein, diese API ohne vorherige Nutzergeste aufzurufen, wie unter https://chromestatus.com/feature/6218822004768768 beschrieben.\n\nDiese Richtlinie ersetzt die persönlichen Einstellungen der Nutzer und lässt zu, dass übereinstimmende Ursprünge die API ohne vorherige Nutzergeste aufrufen.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns.\nPlatzhalter wie * sind zulässig.\n\nUrsprünge, die sowohl mit blockierten als auch mit zulässigen Richtlinienmustern übereinstimmen, werden blockiert.\nFür Ursprünge, die nicht durch eine Richtlinie oder Nutzereinstellungen angegeben sind, ist zum Aufrufen dieser API eine vorherige Nutzergeste erforderlich.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Automatischen Vollbildmodus auf diesen Websites blockieren";
AutomaticFullscreenBlockedForUrls.pfm_description = "Aus Sicherheitsgründen erfordert die Web‑API „requestFullscreen()“ die vorherige Ausführung einer Geste zur vorübergehenden Aktivierung durch den Nutzer; andernfalls tritt ein Fehler auf. Durch die persönlichen Einstellungen von Nutzern kann es bestimmten Ursprüngen erlaubt sein, diese API ohne vorherige Nutzergeste aufzurufen, wie unter https://chromestatus.com/feature/6218822004768768 beschrieben.\n\nDiese Richtlinie ersetzt die persönlichen Einstellungen der Nutzer und verhindert, dass übereinstimmende Ursprünge die API ohne vorherige Nutzergeste aufrufen.\n\nAusführliche Informationen zu gültigen URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns.\nPlatzhalter wie „*“ sind zulässig.\n\nUrsprünge, die sowohl mit blockierten als auch mit zulässigen Richtlinienmustern übereinstimmen, werden blockiert.\nFür Ursprünge, die nicht durch eine Richtlinie oder Nutzereinstellungen angegeben sind, ist zum Aufrufen dieser API eine vorherige Nutzergeste erforderlich.";
AutoplayAllowed.pfm_title = "Autoplay von Medien erlauben";
AutoplayAllowed.pfm_description = "Wenn die Richtlinie auf „True“ gesetzt ist, kann Brave Medien automatisch abspielen. Wenn die Richtlinie auf „False“ gesetzt ist, kann Brave Medien nicht mehr automatisch abspielen.\n\nWenn diese Richtlinie nicht konfiguriert ist, spielt Brave Medien nicht automatisch ab. Aber für bestimmte URL-Muster kannst du diese Einstellung über die Richtlinie „AutoplayAllowlist“ ändern.\n\nWird die Richtlinie während der Ausführung von Brave geändert, wird sie nur auf neu geöffnete Tabs angewendet.";
AutoplayAllowlist.pfm_title = "Autoplay von Medien für eine Zulassungsliste mit URL-Mustern erlauben";
AutoplayAllowlist.pfm_description = "Wenn diese Richtlinie konfiguriert ist, können in Brave ohne Einwilligung des Nutzers automatisch Videos mit Ton abgespielt werden. Wenn die Richtlinie „AutoplayAllowed“ auf „True“ gesetzt ist, hat diese Richtlinie keine Auswirkungen. Ist die Richtlinie „AutoplayAllowed“ auf „False“ gesetzt, können alle in dieser Richtlinie festgelegten URL-Muster weiterhin wiedergegeben werden. Wird die Richtlinie während der Ausführung von Brave geändert, wird sie nur auf neu geöffnete Tabs angewendet.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.";
BackgroundTabFreezingEnabled.pfm_title = "„Tabs im Hintergrund deaktivieren“ aktivieren";
BackgroundTabFreezingEnabled.pfm_description = "Mit dieser Richtlinie kann festgelegt werden, ob Brave inaktive Hintergrundtabs deaktiviert, um CPU und Arbeitsspeicher zu schonen.\n\nWenn das Deaktivieren von Tabs im Hintergrund aktiv ist, werden Tabs, die eine Zeit lang im Hintergrund inaktiv waren, deaktiviert. Dazu werden JavaScript-Ausführung und Timer-Aufgaben pausiert. Deaktivierte Tabs bleiben im Arbeitsspeicher und werden sofort fortgesetzt, wenn sie vom Nutzer ausgewählt werden. Tabs mit aktiven Hintergrundaufgaben, z. B. solche, die Audio- oder Videoinhalte wiedergeben, Bildschirm- oder Kamerastreams aufzeichnen, aktive WebRTC-Verbindungen aufrechterhalten oder Web Locks anwenden, können nicht deaktiviert werden und werden weiter ausgeführt. Websites, die in der Richtlinie „TabDiscardingExceptions“ oder in den Ausnahmen des Nutzers für das Verwerfen von Tabs konfiguriert sind, sind ebenfalls vom Deaktivieren ausgenommen.\n\nWenn die Richtlinie aktiviert ist, wird das automatische Deaktivieren von Tabs im Hintergrund für passende Tabs im Hintergrund aktiviert. Nutzer können diese Einstellung nicht ändern.\n\nIst die Richtlinie deaktiviert, werden Tabs im Hintergrund nicht deaktiviert. Nutzer können diese Einstellung nicht ändern.\n\nWenn die Richtlinie nicht konfiguriert ist, ist das Deaktivieren von Hintergrundtabs standardmäßig aktiviert, Nutzer können die Funktion aber in den Brave-Einstellungen aktivieren oder deaktivieren.";
BasicAuthOverHttpEnabled.pfm_title = "Basic die Authentifizierung für HTTP erlauben";
BasicAuthOverHttpEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, sind Basic-Authentifizierungsherausforderungen zulässig, die über nicht sicheres HTTP empfangen wurden.\n\nIst diese Richtlinie deaktiviert, dürfen nicht sichere HTTP-Anfragen das Basic-Authentifizierungsschema nicht verwenden; nur HTTPS ist zulässig.\n\nDiese Richtlinieneinstellung wird ignoriert (und Basic ist immer verboten), wenn die Richtlinie AuthSchemes konfiguriert ist und das Basic-Schema nicht enthält.";
BatterySaverModeAvailability.pfm_title = "Energiesparmodus aktivieren";
BatterySaverModeAvailability.pfm_description = "0 - Der Energiesparmodus wird deaktiviert.\n1 - Der Energiesparmodus wird aktiviert, wenn das Gerät über den Akku betrieben wird und der Akkustand niedrig ist.\n2 - Dieser Wert wird ab M121 eingestellt. Ab M121 werden Werte als „EnabledBelowThreshold“ behandelt.\nMit dieser Richtlinie wird der Energiesparmodus aktiviert oder deaktiviert.\nIn Chrome wird mit dieser Einstellung die Framerate gedrosselt, um den Energieverbrauch zu reduzieren. Wenn die Richtlinie nicht konfiguriert ist, kann der Endnutzer diese Einstellung unter chrome://settings/performance verwalten.\nUnter ChromeOS bewirkt diese Einstellung, dass die Framerate und CPU-Frequenz gedrosselt, die Hintergrundbeleuchtung gedimmt und Android in den Energiesparmodus versetzt werden. Auf Geräten mit mehreren CPUs werden einige CPUs deaktiviert.\nDie verschiedenen Stufen sind:\nDisabled (0): Der Energiesparmodus wird deaktiviert.\nEnabledBelowThreshold (1): Der Energiesparmodus wird aktiviert, wenn das Gerät über den Akku betrieben wird und der Akkustand niedrig ist.\nEnabledOnBattery (2): Dieser Wert wird ab M121 eingestellt. Ab M121 werden Werte als „EnabledBelowThreshold“ behandelt.\n";
BlockExternalExtensions.pfm_title = "Installation externer Erweiterungen blockieren";
BlockExternalExtensions.pfm_description = "Hiermit kann die Installation externer Erweiterungen verwaltet werden.\n\nWenn diese Richtlinie aktiviert ist, können externe Erweiterungen nicht installiert werden.\n\nIst sie deaktiviert oder nicht konfiguriert, können externe Erweiterungen installiert werden.\n\nInformationen zu externen Erweiterungen und ihrer Installation sind unter https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions verfügbar.\n\nHinweis: Diese Richtlinie gilt nur für Plattformen, die Erweiterungen unterstützen.";
BlockThirdPartyCookies.pfm_title = "Drittanbieter-Cookies blockieren";
BlockThirdPartyCookies.pfm_description = "Wenn diese Richtlinie aktiviert ist, können Websiteelemente, die nicht von der Domain in der Adressleiste des Browsers stammen, keine Cookies setzen. Wenn die Richtlinie deaktiviert ist, können diese Elemente Cookies setzen und Nutzer können diese Einstellung nicht ändern.\n\nWird die Richtlinie nicht konfiguriert, werden Drittanbieter-Cookies zugelassen, aber Nutzer können diese Einstellung ändern.\n\nHinweis: Diese Richtlinie gilt nicht für den Inkognitomodus, in dem Drittanbieter-Cookies blockiert werden und nur auf Websiteebene zugelassen werden können. Wenn du Cookies auf Websiteebene zulassen möchtest, verwende die Richtlinie „CookiesAllowedForUrls“.";
BookmarkBarEnabled.pfm_title = "Lesezeichenleiste aktivieren";
BookmarkBarEnabled.pfm_description = "Wenn die Richtlinie auf \"True\" gesetzt ist, wird eine Lesezeichenleiste in Brave angezeigt. Ist sie auf \"False\" gesetzt, sehen Nutzer keine Lesezeichenleiste.\n\nWenn du diese Richtlinie konfigurierst, kann sie von Nutzern nicht geändert werden. Ist die Richtlinie nicht konfiguriert, können Nutzer entscheiden, ob sie diese Funktion verwenden möchten.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "\"Person hinzufügen\" im Nutzermanager aktivieren";
BrowserAddPersonEnabled.pfm_description = "Wenn diese Richtlinie auf „true“ gesetzt oder nicht konfiguriert ist, können neue Nutzer in Brave und Lacros über die Nutzerverwaltung hinzugefügt werden.\n\nIst sie auf „false“ gesetzt, können keine neuen Nutzer in Brave und Lacros über die Nutzerverwaltung hinzugefügt werden.";
BrowserGuestModeEnabled.pfm_title = "Gastmodus im Browser aktivieren";
BrowserGuestModeEnabled.pfm_description = "Wenn diese Richtlinie aktiviert oder nicht konfiguriert ist, sind Gastanmeldungen in Brave möglich. Gastanmeldungen sind Brave-Profile, bei denen sich alle Fenster im Inkognitomodus befinden.\n\nIst die Richtlinie deaktiviert, sind in Brave keine Gastanmeldungen möglich.";
BrowserGuestModeEnforced.pfm_title = "Gastmodus im Browser erzwingen";
BrowserGuestModeEnforced.pfm_description = "Wenn die Richtlinie aktiviert ist, erzwingt Brave Gastsitzungen und verhindert die Anmeldung über Nutzerprofile. Gastsitzungen sind Brave-Profile, bei denen die Fenster im Inkognitomodus ausgeführt werden.\n\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist bzw. der Gastmodus des Browsers durch BrowserGuestModeEnabled deaktiviert ist, können sowohl neue als auch vorhandene Profile verwendet werden.";
BrowserLabsEnabled.pfm_title = "Symbol für experimentelle Browserfunktionen auf der Symbolleiste";
BrowserLabsEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer auf experimentelle Browserfunktionen über ein Symbol auf der Symbolleiste zugreifen.\n\nWird die Richtlinie deaktiviert, wird das Symbol für den Zugriff auf experimentelle Browserfunktionen von der Symbolleiste entfernt.\n\n„chrome://flags“ und alle weiteren Möglichkeiten zum Aktivieren oder Deaktivieren von Browserfunktionen funktionieren weiter wie gewohnt, unabhängig davon, ob diese Richtlinie aktiviert oder deaktiviert ist.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Abfragen an einen Google-Dienst für die Zeiteinstellung zulassen";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, sendet Brave gelegentlich Abfragen an einen Google-Server, um einen korrekten Zeitstempel abzurufen.\n\nWird die Richtlinie deaktiviert, sendet Brave solche Abfragen nicht mehr.";
BrowserSignin.pfm_title = "Einstellungen für die Anmeldung im Browser";
BrowserSignin.pfm_description = "0 - Browseranmeldung deaktivieren\n1 - Browseranmeldung aktivieren\n2 - Erzwingen, dass Nutzer sich im Browser anmelden müssen\nMit dieser Richtlinie wird gesteuert, wie sich Nutzer im Browser anmelden. Du kannst damit festlegen, ob sich der Nutzer über sein Konto in Brave anmelden und Kontodienste wie die Brave-Synchronisierung verwenden kann.\n\nWenn die Richtlinie auf „Browseranmeldung deaktivieren“ gesetzt ist, kann der Nutzer sich nicht im Browser anmelden und keine Kontodienste nutzen. Funktionen auf Browserebene wie die Brave-Synchronisierung können dann nicht verwendet werden und sind auch nicht verfügbar. Unter iOS gilt: Falls ein Nutzer bereits angemeldet ist und die Richtlinie deaktiviert wird, wird er sofort abgemeldet. Bei anderen Plattformen wird der Nutzer automatisch abgemeldet, wenn er Brave das nächste Mal verwendet. Bei allen Plattformen bleiben seine lokalen Profildaten wie z. B. Lesezeichen und Passwörter jedoch erhalten. Der Nutzer kann sich auch weiterhin in Google-Webdiensten wie Gmail anmelden und diese verwenden.\n\nWenn die Richtlinie auf „Browseranmeldung aktivieren“ gesetzt ist, kann sich der Nutzer im Browser anmelden. Bei allen Plattformen außer iOS wird der Nutzer automatisch im Browser angemeldet, wenn er in Google-Webdiensten wie Gmail angemeldet ist. Solange er im Browser angemeldet ist, werden seine Kontoinformationen dort gespeichert. Das bedeutet aber nicht, dass die Brave-Synchronisierung standardmäßig aktiviert wird. Der Nutzer muss diese Funktion separat aktivieren. Wird diese Richtlinie aktiviert, kann der Nutzer die Einstellung für die Browseranmeldung nicht mehr deaktivieren. Die Verfügbarkeit der Brave-Synchronisierung lässt sich mithilfe der Richtlinie „SyncDisabled“ steuern.\n\nWenn die Richtlinie auf „Erzwingen, dass Nutzer sich im Browser anmelden müssen“ gesetzt ist, wird dem Nutzer ein Dialogfeld zur Kontoauswahl angezeigt. Er muss dann ein Konto auswählen und sich anmelden, um den Browser verwenden zu können. Dadurch wird bei verwalteten Konten sichergestellt, dass die entsprechenden Richtlinien erzwungen und angewendet werden. Der Standardwert für „BrowserGuestModeEnabled“ wird auf „deaktiviert“ gesetzt. Nach dem Aktivieren dieser Richtlinie sind Profile ohne angemeldeten Nutzer gesperrt und nicht mehr zugänglich. Weitere Informationen findest du im Hilfeartikel unter https://support.google.com/chrome/?p=force_browser_signin. Diese Option wird unter Google Chrome OS und Android nicht unterstützt. Dort wird sie bei Verwendung auf „Browseranmeldung aktivieren“ festgelegt.\n\nWenn diese Richtlinie nicht konfiguriert ist, kann der Nutzer selbst entscheiden, ob er die Option zur Browseranmeldung in den Brave-Einstellungen aktivieren und verwenden möchte.";
BrowserSwitcherDelay.pfm_title = "Verzögerung vor dem Starten eines alternativen Browsers (Millisekunden)";
BrowserSwitcherDelay.pfm_description = "Wenn für die Richtlinie eine Zahl festgelegt ist, zeigt Brave für genau diese Anzahl von Millisekunden eine Nachricht an und öffnet dann den alternativen Browser.\n\nIst die Richtlinie nicht konfiguriert oder auf 0 gesetzt, wird eine bestimmte aufgerufene URL sofort in einem alternativen Browser geöffnet.";
BrowserSwitcherEnabled.pfm_title = "Funktion für die Unterstützung älterer Browser aktivieren.";
BrowserSwitcherEnabled.pfm_description = "Ist die Richtlinie aktiviert, versucht Brave, einige URLs in einem alternativen Browser, z. B. Internet Explorer®, zu öffnen. Diese Funktion wird mithilfe der Richtlinien in der Gruppe „Legacy Browser support“ festgelegt.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, versucht Brave nicht, bestimmte URLs in einem alternativen Browser zu öffnen.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "Die URL einer XML-Datei mit URLs, die grundsätzlich keinen Browserwechsel auslösen sollen.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Ist für die Richtlinie eine gültige URL angegeben, lädt Brave die Websiteliste von dieser URL herunter und wendet die Regeln so an, als wären sie mit der Richtlinie \"BrowserSwitcherUrlGreylist\" konfiguriert worden. Diese Richtlinien verhindern, dass sich Brave und der alternative Browser gegenseitig öffnen.\n\nWenn die Richtlinie nicht konfiguriert oder keine gültige URL angegeben ist, wird sie von Brave nicht als Quelle für Regeln verwendet, die einen Browserwechsel verhindern.\n\nHinweis: Diese Richtlinie verweist auf eine XML-Datei im selben Format wie die Richtlinie \"SiteList\" von Internet Explorer®. Sie lädt Regeln aus einer XML-Datei, ohne diese Regeln mit Internet Explorer® zu teilen. Weitere Informationen zur Richtlinie \"SiteList\" von Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL einer XML-Datei, die URLs enthält, mit denen ein alternativer Browser geladen werden kann.";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Ist für die Richtlinie eine gültige URL angegeben, lädt Brave die Websiteliste von dieser URL herunter und wendet die Regeln so an, als wären sie mit der Richtlinie \"BrowserSwitcherUrlList\" konfiguriert worden.\n\nWenn die Richtlinie nicht konfiguriert oder keine gültige URL angegeben ist, wird sie von Brave nicht als Regelquelle für den Browserwechsel verwendet.\n\nHinweis: Diese Richtlinie verweist auf eine XML-Datei im selben Format wie die Richtlinie \"SiteList\" von Internet Explorer®. Sie lädt Regeln aus einer XML-Datei, ohne diese Regeln mit Internet Explorer® zu teilen. Weitere Informationen zur Richtlinie \"SiteList\" von Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Letzten in Chrome geöffneten Tab beibehalten.";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, hält Brave mindestens einen Tab offen, nachdem zu einem alternativen Browser gewechselt wurde.\n\nIst die Richtlinie deaktiviert, schließt Brave den Tab nach dem Wechsel zu einem alternativen Browser, selbst wenn es der letzte Tab war. Dadurch wird Brave vollständig beendet.";
BrowserSwitcherParsingMode.pfm_title = "Parsing-Modus für Websiteliste";
BrowserSwitcherParsingMode.pfm_description = "0 - Standardverhalten für die Unterstützung älterer Browser.\n1 - Bessere Kompatibilität mit der Richtlinie „Microsoft IE/Edge Enterprise Mode Sitelists“.\nDiese Richtlinie legt fest, wie Google Chrome Richtlinien zu Websitelisten/Greylists für die Funktion zur Unterstützung älterer Browser interpretiert. Die folgenden Richtlinien sind betroffen: BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl und BrowserSwitcherExternalGreylistUrl.\n\nWenn die Richtlinie auf „Default“ (0) gesetzt oder nicht konfiguriert ist, ist der URL-Abgleich weniger streng. Bei Regeln, die „/“ nicht enthalten, wird nach einem Teilstring im Hostnamen der URL gesucht. Bei der Zuordnung der Pfadkomponente einer URL wird die Groß- und Kleinschreibung beachtet.\n\nWenn die Richtlinie auf „IESiteListMode“ (1) gesetzt ist, ist der URL-Abgleich strenger. Bei Regeln, die „/“ nicht enthalten, wird nur der letzte Abschnitt des Hostnamens berücksichtigt. Sie müssen außerdem innerhalb des Bereichs für Domainnamen liegen. Bei der Zuordnung der Pfadkomponente einer URL wird die Groß- und Kleinschreibung nicht berücksichtigt. Dies bietet eine bessere Kompatibilität mit Microsoft® Internet Explorer® und Microsoft® Edge®.\n\nBeispielsweise mit den Regeln „beispiel.de“ und „acme.de/abc“:\n\n„http://beispiel.de“; „http://subdomain.beispiel.de“ und „http://acme.de/abc“ stimmen unabhängig von Parsingmodus überein.\n\n„http://keinbeispiel.de/“, „http://beispiel.de.ungültig.com/“ und „http://beispiel.deabc/“ stimmen nur im Modus „Default“ überein.\n\n„http://acme.de/ABC“ stimmt nur in „IESiteListMode“ überein.";
BrowserSwitcherUrlGreylist.pfm_title = "Websites, die unter keinen Umständen einen Browserwechsel auslösen sollten.";
BrowserSwitcherUrlGreylist.pfm_description = "Mithilfe dieser Richtlinie wird die Liste der Websites verwaltet, die unter keinen Umständen einen Browserwechsel auslösen. Jedes Element wird als Regel angesehen. Wenn es eine Übereinstimmung mit der Regel gibt, wird kein alternativer Browser geöffnet. Im Gegensatz zur Richtlinie \"BrowserSwitcherUrlList\" gelten die Regeln in beide Richtungen. Wenn das Internet Explorer®-Add-in aktiviert ist, wird damit auch gesteuert, ob Internet Explorer® diese URLs in Brave öffnen soll.\n\nIst die Richtlinie nicht konfiguriert, werden der Liste keine Websites hinzugefügt.\n\nHinweis: Dieser Liste können auch über die Richtlinie \"BrowserSwitcherExternalGreylistUrl\" Elemente hinzugefügt werden.";
BrowserSwitcherUrlList.pfm_title = "Websites, die in einem alternativen Browser geöffnet werden sollen";
BrowserSwitcherUrlList.pfm_description = "Mithilfe dieser Richtlinie wird die Liste der Websites verwaltet, die in einem alternativen Browser geöffnet werden sollen. Jedes Element wird als Regel zum Aufrufen der jeweiligen Inhalte in einem alternativen Browser angesehen. Anhand dieser Regeln kann Brave feststellen, ob eine URL in einem alternativen Browser geöffnet werden soll. Wenn das Internet Explorer®-Add-in aktiviert ist, wechselt Internet Explorer® bei Nichtübereinstimmung der Regeln zurück zu Brave. Falls sich Regeln widersprechen, verwendet Brave die Regel, die am spezifischsten ist.\n\nIst die Richtlinie nicht konfiguriert, werden der Liste keine Websites hinzugefügt.\n\nHinweis: Dieser Liste können auch über die Richtlinien \"BrowserSwitcherUseIeSitelist\" und \"BrowserSwitcherExternalSitelistUrl\" Elemente hinzugefügt werden.";
BrowserThemeColor.pfm_title = "Farbe des Browserdesigns ändern";
BrowserThemeColor.pfm_description = "Mit dieser Richtlinie können Administratoren die Farbe des Designs von Brave konfigurieren. Der Eingabestring muss ein gültiger Hex-Farbcode mit dem Format „#RRGGBB“ sein.\n\nWenn für die Richtlinie ein gültiger Hex-Farbcode festgelegt ist, wird automatisch ein entsprechendes Design erstellt und auf den Browser angewendet. Nutzer können das Design, das durch diese Richtlinie festgelegt ist, nicht ändern.\n\nWird die Richtlinie nicht konfiguriert, können Nutzer das Design nach Belieben ändern.";
BrowsingDataLifetime.pfm_title = "Einstellungen für die Lebensdauer von Browserdaten";
BrowsingDataLifetime.pfm_description = "Konfiguriert die Einstellungen für die Lebensdauer von Browserdaten für Brave. Mit dieser Richtlinie können Administratoren (nach Datentyp) festlegen, wann Daten vom Browser gelöscht werden. Das bietet Vorteile für Kunden, die mit sensiblen Kundendaten arbeiten.\n\nWarnung: Das Festlegen dieser Richtlinie kann sich auf lokale private Daten auswirken und diese dauerhaft entfernen. Wir empfehlen, die Einstellungen vor der Bereitstellung zu testen, um das versehentliche Löschen von privaten Daten zu verhindern.\n\nDie folgenden Datentypen sind verfügbar: 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' und 'hosted_app_data'. „'download_history'“ und „'hosted_app_data'“ werden unter Android nicht unterstützt.\n\nDaten der ausgewählten Typen, die älter sind als 'time_to_live_in_hours', werden automatisch aus dem Browser entfernt. Als kleinster Wert kann eine Stunde festgelegt werden.\n\nAbgelaufene Daten werden 15 Sekunden, nachdem der Browser gestartet wurde, und anschließend alle 30 Minuten gelöscht, während der Browser geöffnet ist.\n\nDer Nutzer bleibt in seinem Google-Konto angemeldet, wenn Cookies gelöscht werden.\n\nBis Chrome 114 musste für diese Richtlinie die Richtlinie „SyncDisabled“ auf „True“ gesetzt werden. Ab Chrome 115 wird mit dieser Richtlinie die Synchronisierung für die jeweiligen Datentypen deaktiviert, wenn weder „Chrome Sync“ durch Festlegen der Richtlinie „SyncDisabled“ noch „BrowserSignin“ deaktiviert ist.\nUnter https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime erhältst du weitere Informationen zu Schema und Formatierung.";
BuiltInAIAPIsEnabled.pfm_title = "Zulassen, dass Seiten die integrierten KI-APIs verwenden.";
BuiltInAIAPIsEnabled.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob eine Seite die integrierten KI-APIs (wie LanguageModel API, Summarization API, Writer API und Rewriter API) verwenden kann.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, können die APIs verwendet werden.\n\nWenn diese Richtlinie deaktiviert ist, führt der Versuch, die APIs zu verwenden, zu einem Fehler.";
BuiltInDnsClientEnabled.pfm_title = "Integrierten DNS-Client verwenden";
BuiltInDnsClientEnabled.pfm_description = "Mit dieser Richtlinie wird festgelegt, welcher Software-Stack zur Kommunikation mit dem DNS-Server verwendet wird: der DNS-Client des Betriebssystems oder der integrierte DNS-Client von Brave. Sie beeinflusst nicht, welche DNS-Server verwendet werden. Wenn beispielsweise das Betriebssystem für die Verwendung eines Unternehmens-DNS-Servers konfiguriert ist, verwendet der integrierte DNS-Client genau diesen Server. Mit der Richtlinie wird auch nicht gesteuert, ob DNS-over-HTTPS verwendet wird. Brave nutzt immer den integrierten Resolver für DNS-over-HTTPS-Anfragen. Weitere Informationen zum Steuern von DNS-over-HTTPS findest du in der Richtlinie „DnsOverHttpsMode“.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, wird der integrierte DNS-Client verwendet.\n\nWenn die Richtlinie deaktiviert ist, wird der integrierte DNS-Client nur bei Nutzung von DNS-over-HTTPS verwendet.";
CACertificateManagementAllowed.pfm_title = "Nutzern erlauben, installierte CA-Zertifikate zu verwalten.";
CACertificateManagementAllowed.pfm_description = "0 - Nutzern erlauben, alle Zertifikate zu verwalten\n1 - Nutzern erlauben, Nutzerzertifikate zu verwalten\n2 - Nutzern nicht erlauben, Zertifikate zu verwalten\nWenn die Richtlinie auf „Alle“ (0) gesetzt oder nicht konfiguriert ist, können Nutzer Vertrauenseinstellungen für alle CA-Zertifikate bearbeiten, von Nutzern importierte Zertifikate entfernen und Zertifikate mit dem Zertifikat-Manager importieren. Wenn die Richtlinie auf „Nur Nutzer“ (1) gesetzt ist, können Nutzer zwar von Nutzern importierte Zertifikate verwalten, aber die Vertrauenseinstellungen integrierter Zertifikate nicht ändern. Ist sie auf „Keine“ (2) gesetzt, können Nutzer CA-Zertifikate ansehen, aber nicht verwalten.";
CACertificates.pfm_title = "TLS-Zertifikate, die von Brave für die Serverauthentifizierung als vertrauenswürdig eingestuft werden sollen";
CACertificates.pfm_description = "Eine Liste von TLS-Zertifikaten, die von Brave für die Serverauthentifizierung als vertrauenswürdig eingestuft werden sollen.\nZertifikate müssen mit Base64 codiert sein.";
CACertificatesWithConstraints.pfm_title = "TLS-Zertifikate, die von Brave für die Serverauthentifizierung mit Einschränkungen als vertrauenswürdig eingestuft werden sollen";
CACertificatesWithConstraints.pfm_description = "Eine Liste von TLS-Zertifikaten, die von Brave für die Serverauthentifizierung mit außerhalb des Zertifikats hinzugefügten Einschränkungen als vertrauenswürdig eingestuft werden sollen. Wenn keine Einschränkung eines bestimmten Typs vorhanden ist, ist jeder Name dieses Typs zulässig.\nZertifikate müssen mit Base64 codiert sein. Für jedes Zertifikat muss mindestens eine Einschränkung angegeben werden.\nUnter https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints erhältst du weitere Informationen zu Schema und Formatierung.";
CADistrustedCertificates.pfm_title = "TLS-Zertifikate, die von Brave für die Serverauthentifizierung als nicht vertrauenswürdig eingestuft werden sollen";
CADistrustedCertificates.pfm_description = "Eine Liste der öffentlichen Zertifikatschlüssel, die von Brave für die TLS-Serverauthentifizierung als nicht vertrauenswürdig eingestuft werden sollen.\n\nDer Richtlinienwert ist eine Liste von base64-codierten X.509-Zertifikaten. Alle Zertifikate mit einer übereinstimmenden SPKI (SubjectPublicKeyInfo) werden als nicht vertrauenswürdig eingestuft.";
CAHintCertificates.pfm_title = "TLS-Zertifikate, die nicht vertrauenswürdig sind, aber bei der Pfaderstellung für die Serverauthentifizierung verwendet werden können";
CAHintCertificates.pfm_description = "Eine Liste von Zertifikaten, die in Brave als nicht vertrauenswürdig eingestuft werden sollen, jedoch als Hinweise für die Pfaderstellung verwendet werden können. Zertifikate müssen mit Base64 codiert sein.";
CAPlatformIntegrationEnabled.pfm_title = "Vom Nutzer hinzugefügte TLS-Zertifikate aus Plattform-Trust Stores für die Serverauthentifizierung verwenden";
CAPlatformIntegrationEnabled.pfm_description = "Wenn diese Richtlinie aktiviert (oder nicht konfiguriert) ist, werden vom Nutzer hinzugefügte TLS-Zertifikate aus Plattform-Trust Stores bei der Pfaderstellung für die TLS-Serverauthentifizierung verwendet.\n\nWenn diese Richtlinie deaktiviert ist, werden vom Nutzer hinzugefügte TLS-Zertifikate aus Plattform-Trust Stores nicht bei der Pfaderstellung für die TLS-Serverauthentifizierung verwendet.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "Unterstützung für CORS-Anfrageheader ohne Platzhalter";
CORSNonWildcardRequestHeadersSupport.pfm_description = "Damit wird die Unterstützung für CORS-Anfrageheader ohne Platzhalter konfiguriert.\n\nMit der Version 97 von Brave wird die Unterstützung für CORS-Anfrageheader ohne Platzhalter eingeführt. Wenn in Scripts eine ursprungsübergreifende Netzwerkanfrage per fetch() und XMLHttpRequest mit einem per Script hinzugefügten Autorisierungsheader gestellt wird, muss der Header durch den Header „Access-Control-Allow-Headers“ in der CORS-Preflight-Antwort explizit zugelassen werden. „Explizit“ bedeutet hier, dass sich das Platzhaltersymbol „*“ nicht auf den Autorisierungsheader beziehen darf. Nähere Informationen findest du unter https://chromestatus.com/feature/5742041264816128.\n\nWenn diese Richtlinie nicht festgelegt bzw. auf „Wahr“ gesetzt wird, unterstützt Brave die CORS-Anfrageheader ohne Platzhalter und verhält sich wie oben beschrieben.\n\nWird diese Richtlinie auf „Falsch“ gesetzt, darf sich das Platzhaltersymbol „*“ im Header „Access-Control-Allow-Headers“ in der CORS-Preflight-Antwort auf den Autorisierungsheader beziehen.\n\nDiese Unternehmensrichtlinie ist vorübergehend. In Zukunft wird sie voraussichtlich entfernt.";
CacheEncryptionEnabled.pfm_title = "Mit dieser Richtlinie können Administratoren den HTTP-Cache auf dem Datenträger verschlüsseln.";
CacheEncryptionEnabled.pfm_description = "Mit dieser Richtlinie können Administratoren den HTTP-Cache des Browsers auf dem Datenträger verschlüsseln.\n\nWenn diese Richtlinie aktiviert ist, wird der Browser-Cache verschlüsselt.\n\nWenn diese Richtlinie deaktiviert oder nicht konfiguriert ist, wird der Browser-Cache nicht verschlüsselt.\n\nDie Verschlüsselung des Browser-Caches kann sich auf die Leistung auswirken.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "Erzwingung der Zertifikatstransparenz für eine Liste mit subjectPublicKeyInfo-Hashes deaktivieren";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "Wenn diese Richtlinie konfiguriert ist, wird das Erzwingen von Certificate Transparency-Offenlegungsanforderungen für eine Liste von subjectPublicKeyInfo-Hashes deaktiviert. Unternehmenshosts können dann weiterhin Zertifikate verwenden, die andernfalls nicht vertrauenswürdig wären, weil sie nicht ordnungsgemäß öffentlich offengelegt wurden. Um die Erzwingung zu deaktivieren, muss der Hash eine der folgenden Bedingungen erfüllen:\n\n* Der Hash gehört zu einem subjectPublicKeyInfo des Serverzertifikats.\n\n* Der Hash gehört zu einem subjectPublicKeyInfo, das in einem CA-Zertifikat in der Zertifikatskette erscheint. Dieses CA-Zertifikat wird durch die Erweiterung \"X.509v3 nameConstraints\" beschränkt, es liegen ein oder mehrere directoryName nameConstraints in permittedSubtrees vor und der directoryName enthält ein organizationName-Attribut.\n\n* Der Hash gehört zu einem subjectPublicKeyInfo, das in einem CA-Zertifikat in der Zertifikatskette erscheint, das CA-Zertifikat hat ein oder mehrere organizationName-Attribute im Zertifikat-Subject und das Zertifikat des Servers enthält dieselbe Anzahl organizationName-Attribute in derselben Reihenfolge und mit in jedem Byte identischen Werten.\n\nGib einen subjectPublicKeyInfo-Hash an, indem du Folgendes verkettest: den Hash-Algorithmusnamen, das Zeichen \"/\" sowie die Base64-Codierung dieses Hash-Algorithmus, die auf das DER-codierte subjectPublicKeyInfo des angegebenen Zertifikats angewendet wird. Die Base64-Codierung hat dasselbe Format wie ein SPKI-Fingerabdruck. Der einzige erkannte Hash-Algorithmus ist \"sha256\". Alle anderen werden ignoriert.\n\nWenn die Richtlinie nicht konfiguriert ist, werden alle Zertifikate, für die eine Certificate Transparency-Offenlegung erforderlich ist und die nicht offengelegt werden, von Brave als nicht vertrauenswürdig behandelt.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "Erzwingung der Zertifikatstransparenz für eine Liste von URLs deaktivieren";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "Wenn die Richtlinie konfiguriert ist, werden die Certificate Transparency-Offenlegungspflichten für die Hostnamen in den angegebenen URLs deaktiviert. Dadurch sind Zertifikate weiterhin zulässig, die andernfalls nicht vertrauenswürdig wären, weil sie nicht ordnungsgemäß offengelegt wurden. Es ist aber schwerer, fehlerhaft ausgestellte Zertifikate für diese Hosts zu erkennen.\n\nWenn die Richtlinie nicht konfiguriert ist, werden alle Zertifikate, für die eine Certificate Transparency-Offenlegung erforderlich ist und die nicht offengelegt werden, von Brave als nicht vertrauenswürdig behandelt.\n\nEin URL-Muster folgt diesem Format ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ). Weil die Gültigkeit von Zertifikaten für einen bestimmten Hostnamen aber nicht vom Schema, Port oder Pfad abhängig ist, wird von Brave nur der Hostname der URL berücksichtigt. Platzhalter-Hosts werden nicht unterstützt.";
ChromeForTestingAllowed.pfm_title = "Chrome for Testing zulassen";
ChromeForTestingAllowed.pfm_description = "Damit wird festgelegt, ob Nutzer Chrome for Testing verwenden dürfen.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, dürfen Nutzer Chrome for Testing installieren und ausführen.\n\nIst die Richtlinie deaktiviert, dürfen Nutzer Chrome for Testing nicht ausführen. Nutzer können Chrome for Testing dennoch installieren, aber diese Chrome-Version wird nicht mit den Profilen ausgeführt, für die diese Richtlinie deaktiviert ist.";
ChromeSuggestionsSettings.pfm_title = "Einstellungen für Vorschläge in Chrome";
ChromeSuggestionsSettings.pfm_description = "Mit dieser Einstellung kann Chrome KI-Funktionen vorschlagen, wenn ihre Nutzung relevant ist.\n\n0 / nicht festgelegt = Vorschläge in Chrome werden für Nutzer aktiviert.\n\n1 = Vorschläge in Chrome sind für Nutzer deaktiviert.\n\nWeitere Informationen findest du im Hilfeartikel unter https://support.google.com/chrome/a?p=chrome_suggestions.";
ChromeVariations.pfm_title = "Die Verfügbarkeit von Variationen bestimmen";
ChromeVariations.pfm_description = "0 - Alle Variationen aktivieren\n1 - Nur Variationen für wichtige Fehlerbehebungen aktivieren\n2 - Alle Variationen deaktivieren\nÜber diese Richtlinie kannst du festlegen, welche Variationen in Brave zulässig sind.\n\nMit Variationen sind kleine Konfigurationsänderungen an Brave möglich, ohne dass eine neue Version veröffentlicht werden muss. Dazu werden bestehende Funktionen aktiviert oder deaktiviert. Weitere Informationen findest du unter https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework.\n\nWenn du \"VariationsEnabled\" (Wert: 0) festlegst oder die Richtlinie nicht konfigurierst, können alle Variationen für den Browser angewendet werden.\n\nWenn du \"CriticalFixesOnly\" festlegst (Wert: 1), werden nur Variationen für Brave angewendet, die als wichtige Sicherheits- oder Stabilitätskorrekturen gewertet werden.\n\nWenn du \"VariationsDisabled\" festlegst (Wert: 2), werden keine Variationen auf den Browser angewendet. Dieser Modus kann die Brave-Entwickler möglicherweise daran hindern, wichtige Sicherheitskorrekturen zeitnah durchzuführen. Er wird daher nicht empfohlen.";
ClearBrowsingDataOnExitList.pfm_title = "Browserdaten beim Beenden löschen";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - Browserverlauf\ndownload_history - Downloadverlauf\ncookies_and_other_site_data - Cookies und andere Websitedaten\ncached_images_and_files - Bilder und Dateien im Cache\npassword_signin - Passwortanmeldung\nautofill - Autofill\nsite_settings - Website-Einstellungen\nhosted_app_data - Daten für gehostete Apps\nKonfiguriert eine Liste von Browserdatentypen, die beim Schließen aller Browserfenster gelöscht werden sollen.\n\nWarnung: Das Festlegen dieser Richtlinie kann sich auf lokale private Daten auswirken und diese dauerhaft entfernen. Wir empfehlen, die Einstellungen vor der Bereitstellung zu testen, um das versehentliche Löschen von privaten Daten zu verhindern.\n\nDie folgenden Datentypen sind verfügbar: Browserverlauf (browsing_history), Downloadverlauf (download_history), Cookies (cookies_and_other_site_data), Cache ((cached_images_and_files)), die Funktion „Autofill“ (autofill), Passwörter (password_signin), Website-Einstellungen (site_settings) und Daten von gehosteten Apps (hosted_app_data). Diese Richtlinie hat keinen Vorrang vor AllowDeletingBrowserHistory.\n\nDer Nutzer bleibt in seinem Google-Konto angemeldet, wenn Cookies gelöscht werden.\n\nBis Chrome 114 musste für diese Richtlinie die Richtlinie „SyncDisabled“ auf „True“ gesetzt werden. Ab Chrome 115 wird mit dieser Richtlinie die Synchronisierung für die jeweiligen Datentypen deaktiviert, wenn weder „Chrome Sync“ durch Festlegen der Richtlinie „SyncDisabled“ noch „BrowserSignin“ deaktiviert ist.\n\nWenn die Datenlöschung gestartet, aber aus irgendeinem Grund nicht abgeschlossen wurde, werden die Browserdaten beim nächsten Laden des Profils gelöscht.\n\nWenn Brave nicht ordnungsgemäß beendet wird, z. B. beim Absturz des Browsers oder Betriebssystems, werden die Browserdaten nicht gelöscht, da der Browser nicht durch das Schließen aller Browserfenster durch den Nutzer geschlossen wurde.";
ClipboardAllowedForUrls.pfm_title = "Zwischenablage für diese Websites zulassen";
ClipboardAllowedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, durch die angegeben wird, welchen Websites die Berechtigung zur Verwendung der Zwischenablage gewährt wird. Das umfasst nicht alle Aktionen in der Zwischenablage, die in Ursprüngen erfolgen, deren URL-Muster mit den angegebenen übereinstimmen. Nutzer können z. B. trotzdem Inhalte über Tastenkombinationen einfügen, weil sich die Berechtigung zur Verwendung der Zwischenablage nicht auf diesen Vorgang bezieht.\n\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultClipboardSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig.";
ClipboardBlockedForUrls.pfm_title = "Zwischenablage für diese Websites blockieren";
ClipboardBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welchen Websites die Berechtigung zur Verwendung der Zwischenablage nicht gewährt wird. Das umfasst nicht alle Aktionen in der Zwischenablage, die in Ursprüngen erfolgen, deren URL‑Muster mit den angegebenen übereinstimmen. Nutzer können zum Beispiel trotzdem Inhalte über Tastenkombinationen einfügen, weil sich die Berechtigung zur Verwendung der Zwischenablage nicht auf diesen Vorgang bezieht.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultClipboardSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig.";
CloudManagementEnrollmentMandatory.pfm_title = "Erforderliche Registrierung für Cloud Management aktivieren";
CloudManagementEnrollmentMandatory.pfm_description = "Wenn die Richtlinie aktiviert ist, muss der Browser Chrome Enterprise Core registriert werden, und bei Nichterfüllung wird der Startprozess von Brave blockiert.\n\nBei deaktivierter oder nicht konfigurierter Richtlinie ist die Browserregistrierung für Chrome Enterprise Core optional und bei Nichterfüllung wird der Startprozess von Brave nicht blockiert.\n\nDiese Richtlinie wird im Rahmen der Registrierung von Cloud-Richtlinien auf Computern verwendet. Weitere Informationen dazu findest du unter https://support.google.com/chrome/a/answer/9301891.";
CloudManagementEnrollmentToken.pfm_title = "Das Registrierungstoken der Cloud-Richtlinie";
CloudManagementEnrollmentToken.pfm_description = "Wenn diese Richtlinie konfiguriert ist, versucht Brave, sich bei der Chrome Enterprise Core-Browserverwaltung zu registrieren. Der Wert dieser Richtlinie ist ein Registrierungstoken, das über die Google Admin console abgerufen werden kann.\n\nWeitere Informationen dazu findest du unter https://support.google.com/chrome/a/answer/9301891.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "Cloud-Richtlinie von Brave überschreibt Plattformrichtlinie.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Wenn die Richtlinie aktiviert ist, hat die Cloud-Richtlinie Vorrang, wenn sie mit der Plattformrichtlinie in Konflikt steht.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, hat die Plattformrichtlinie Vorrang, wenn sie mit der Cloud-Richtlinie in Konflikt steht.\n\nDiese obligatorische Richtlinie wirkt sich auf Cloud-Richtlinien auf Computern aus.\n\nDiese Richtlinie gilt nur für Brave und hat keine Auswirkungen auf Google Update, da es sich um unabhängige Anwendungen handelt.\nFür Google Update gilt eine separate Richtlinie mit demselben Namen.";
CloudUserPolicyMerge.pfm_title = "Ermöglicht das Zusammenführen von Nutzer-Cloud-Richtlinien zu Richtlinien auf Maschinenebene";
CloudUserPolicyMerge.pfm_description = "Wenn die Richtlinie aktiviert ist, dürfen Richtlinien, die mit einem verwalteten Konto verknüpft sind, zu Richtlinien auf Computerebene zusammengeführt werden.\n\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist, können Cloud-Richtlinien auf Nutzerebene nicht mit Richtlinien aus anderen Quellen zusammengeführt werden.\n\nNur Richtlinien, die von sicheren Nutzern stammen, dürfen priorisiert werden. Ein sicherer Nutzer ist mit der Organisation verknüpft, die seinen Browser mithilfe von Chrome Enterprise Core verwaltet. Alle anderen Richtlinien auf Nutzerebene haben standardmäßig Vorrang.\n\nRichtlinien, die zusammengeführt werden müssen, müssen außerdem entweder in PolicyListMultipleSourceMergeList oder PolicyDictionaryMultipleSourceMergeList eingerichtet sein. Diese Richtlinie wird ignoriert, wenn keine der beiden zuvor erwähnten Richtlinien konfiguriert ist.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Zulassen, dass Cloud-Richtlinien auf Nutzerebene Chrome Browser Cloud Management-Richtlinien überschreiben.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Wenn diese Richtlinie aktiviert ist, haben Richtlinien, die mit einem verwalteten Konto verknüpft sind, Vorrang, wenn sie im Widerspruch zu Chrome Enterprise Core-Browserrichtlinien stehen.\n\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist, werden Cloud-Richtlinien auf Nutzerebene standardmäßig priorisiert.\n\nNur Richtlinien, die von sicheren Nutzern stammen, dürfen priorisiert werden. Ein sicherer Nutzer ist mit der Organisation verknüpft, die seinen Browser mithilfe von Chrome Enterprise Core verwaltet. Alle anderen Richtlinien auf Nutzerebene haben standardmäßig Vorrang.\n\nDie Richtlinie kann mit CloudPolicyOverridesPlatformPolicy kombiniert werden. Sind beide Richtlinien aktiviert, haben Cloud-Richtlinien auf Nutzerebene auch Vorrang vor widersprüchlichen Plattformrichtlinien.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Sicherheitswarnungen für Befehlszeilen-Flags aktivieren";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, werden Sicherheitswarnungen angezeigt, wenn Chrome mit potenziell schädlichen Befehlszeilen-Flags gestartet wird.\n\nIst diese Richtlinie deaktiviert, werden keine Sicherheitswarnungen angezeigt, wenn Chrome mit potenziell schädlichen Befehlszeilen-Flags gestartet wird.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
ComponentUpdatesEnabled.pfm_title = "Komponentenupdates in Brave aktivieren";
ComponentUpdatesEnabled.pfm_description = "Mit der Richtlinie werden Komponentenupdates für alle Komponenten in Brave aktiviert, sofern sie nicht festgelegt oder auf „Aktiviert“ gesetzt ist.\n\nWenn sie auf „Deaktiviert“ gesetzt ist, werden die Komponenten nicht aktualisiert. Für einige Komponenten gelten jedoch Ausnahmen: Updates von Komponenten, die keinen ausführbaren Code enthalten und wesentlich für die Sicherheit des Browsers sind, werden nicht deaktiviert.\nBeispiele für solche Komponenten sind Zertifikatssperrlisten und Unterressourcenfilter.";
CompressionDictionaryTransportEnabled.pfm_title = "Unterstützung für komprimierten Wörterbuchtransport aktivieren";
CompressionDictionaryTransportEnabled.pfm_description = "Diese Funktion aktiviert die Verwendung wörterbuchspezifischer Inhaltscodierungen im „Accept-Codierung“-Anfrageheader („sbr“ und „zst-d“), wenn Wörterbücher zur Nutzung verfügbar sind.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, akzeptiert Brave Webinhalte, die mithilfe der Funktion für den komprimierten Wörterbuchtransport übertragen wurden.\nIst die Richtlinie deaktiviert, wird die Funktion für den komprimierten Wörterbuchtransport deaktiviert.";
CookiesAllowedForUrls.pfm_title = "Cookies auf diesen Websites zulassen";
CookiesAllowedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL‑Mustern festlegen, durch die angegeben wird, welche Websites Cookies setzen dürfen.\n\nURL‑Muster können eine einzelne URL sein. Diese gibt dann an, dass die Website Cookies auf allen Websites der obersten Ebene verwenden darf.\n\nMuster können auch zwei durch ein Komma getrennte URLs sein. Die erste gibt die Website an, die Cookies verwenden darf. Die zweite gibt die Website der obersten Ebene an, auf die der erste Wert angewendet werden soll.\n\nWenn du ein URL‑Paar verwendest, wird für den ersten Wert das Sternchen (*) unterstützt, für den zweiten jedoch nicht. Die Verwendung des Sternchens als ersten Wert bedeutet, dass alle Websites Cookies verwenden dürfen, wenn die zweite URL die Website der obersten Ebene ist.\n\nIst diese Richtlinie nicht konfiguriert, wird für alle Websites der globale Standardwert verwendet, entweder aus der Richtlinie „DefaultCookiesSetting“ oder aus der Richtlinie „BlockThirdPartyCookies“, sofern diese konfiguriert sind, oder aus der persönlichen Konfiguration des Nutzers.\n\nSiehe auch die Richtlinien „CookiesBlockedForUrls“ und „CookiesSessionOnlyForUrls“. In diesen drei Richtlinien darf es keine URL‑Muster geben, die miteinander im Konflikt stehen – welche Richtlinie Vorrang hat, ist nicht festgelegt.\n\nAusführliche Informationen zu gültigen URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
CookiesBlockedForUrls.pfm_title = "Cookies auf diesen Websites blockieren";
CookiesBlockedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste von URL‑Mustern erstellen, durch die angegeben wird, welche Websites keine Cookies setzen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, wird für alle Websites „DefaultCookiesSetting“ verwendet, sofern diese Einstellung konfiguriert ist. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nWeder die Richtlinie mit Standardwerten noch eine der beiden folgenden Richtlinien, also CookiesAllowedForUrls oder CookiesSessionOnlyForUrls, hat automatisch Vorrang. Es darf nur hinsichtlich der URL‑Muster keine Konflikte zwischen diesen drei Richtlinien geben.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
CookiesSessionOnlyForUrls.pfm_title = "Cookies von übereinstimmenden URLs auf die aktuelle Sitzung beschränken";
CookiesSessionOnlyForUrls.pfm_description = "Wenn die Richtlinie „RestoreOnStartup“ nicht so konfiguriert ist, dass URLs aus vorherigen Sitzungen dauerhaft wiederhergestellt werden, lässt sich durch die Konfiguration von „CookiesSessionOnlyForUrls“ eine Liste von URL-Mustern erstellen, mit denen angegeben wird, welche Websites Cookies für eine Sitzung setzen dürfen oder nicht.\n\nWenn die Richtlinie nicht konfiguriert ist, wird für alle Websites „DefaultCookiesSetting“ verwendet, sofern diese Einstellung konfiguriert ist. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet. Bei URLs, die nicht zu den angegebenen Mustern gehören, werden ebenfalls die Standardeinstellungen verwendet.\n\nWeder die Richtlinie mit Standardwerten noch eine der beiden folgenden Richtlinien, also CookiesBlockedForUrls oder CookiesAllowedForUrls, hat automatisch Vorrang. Es darf nur hinsichtlich der URL‑Muster keine Konflikte zwischen diesen drei Richtlinien geben.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
CpuPerformanceTierOverride.pfm_title = "Überschreibung für die CPU-Leistungsstufe";
CpuPerformanceTierOverride.pfm_description = "Wenn du diese Richtlinie festlegst, können Unternehmen den von CPU Performance API zurückgegebenen Wert überschreiben (d. h. navigator.cpuPerformance; weitere Informationen findest du unter https://github.com/WICG/cpu-performance).\n\nWenn diese Richtlinie konfiguriert ist, wird der Wert von navigator.cpuPerformance durch den angegebenen Wert überschrieben. Wenn die Richtlinie nicht konfiguriert ist, wird die Standardberechnung der Leistungsstufe verwendet.\n\nDie möglichen Werte für diese Richtlinie sind 0 bis 4.";
CreatePasskeysInICloudKeychain.pfm_title = "Festlegen, ob Passkeys standardmäßig im iCloud-Schlüsselbund erstellt werden sollen.";
CreatePasskeysInICloudKeychain.pfm_description = "Brave kann Passkey-/WebAuthn-Erstellungsanfragen unter macOS 13.5 oder höher direkt an den iCloud-Schlüsselbund weiterleiten. Wenn die iCloud-Schlüsselbundsynchronisierung noch nicht aktiviert ist, wird der Nutzer dadurch gebeten, sich über die iCloud anzumelden. Eventuell wird er stattdessen aufgefordert, die iCloud-Schlüsselbundsynchronisierung zu aktivieren.\n\nIst diese Richtlinie auf „false“ gesetzt, wird der iCloud-Schlüsselbund nicht standardmäßig verwendet. Stattdessen kann das vorherige Verhalten zum Einsatz kommen, also die Erstellung von Anmeldedaten im Brave-Profil. Nutzer können den iCloud-Schlüsselbund weiter als Option auswählen und bei der Anmeldung möglicherweise weiterhin die Anmeldedaten des iCloud-Schlüsselbunds sehen.\n\nWenn diese Richtlinie auf „true“ gesetzt ist, wird der iCloud-Schlüsselbund standardmäßig verwendet, wenn die WebAuthn-Anfrage mit dieser Auswahl kompatibel ist.\n\nIst diese Richtlinie nicht konfiguriert, hängt der Standardwert von verschiedenen Faktoren ab, etwa davon, ob iCloud Drive aktiviert ist und ob der Nutzer vor Kurzem Anmeldedaten in seinem Brave-Profil verwendet oder erstellt hat.";
CreateThemesSettings.pfm_title = "Einstellungen für „Design mit KI erstellen“";
CreateThemesSettings.pfm_description = "0 - „Designs mit KI erstellen“ zulassen und KI‑Modelle verbessern.\n1 - „Designs mit KI erstellen“ zulassen, ohne KI‑Modelle zu verbessern.\n2 - „Designs mit KI erstellen“ nicht zulassen.\nMit „Designs mit KI erstellen“ können Nutzer individuelle Designs und Hintergründe erstellen, indem sie aus einer Liste von Optionen eine Vorauswahl treffen.\n\n„0“ = Die Funktion darf verwendet werden und Google darf relevante Daten nutzen, um seine KI‑Modelle zu verbessern. Relevante Daten können je nach Funktion Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftliches Feedback sein. Sie werden möglicherweise auch manuell geprüft, um KI‑Modelle zu verbessern. „0“ ist der Standardwert, außer in den unten angegebenen Fällen.\n\n„1“ = Die Funktion darf verwendet werden, Google darf aber keine Modelle mithilfe von Nutzerinhalten (einschließlich Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftlichen Feedbacks) verbessern. „1“ ist der Standardwert für Unternehmensnutzer, die über die Google Admin console verwaltet werden, sowie für Konten von Bildungseinrichtungen, die über Google Workspace verwaltet werden.\n\n„2“ = Die Funktion darf nicht verwendet werden.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
DNSInterceptionChecksEnabled.pfm_title = "DNS-Abfangprüfungen aktiviert";
DNSInterceptionChecksEnabled.pfm_description = "Mit dieser Richtlinie kann ein lokaler Parameter konfiguriert werden, der dazu dient, DNS-Abfangprüfungen zu deaktivieren. Durch die Prüfungen wird ermittelt, ob sich der Browser hinter einem Proxy befindet, der unbekannte Hostnamen weiterleitet.\n\nDiese Erkennung ist in einer Enterprise-Umgebung, in der die Netzwerkkonfiguration bekannt ist, möglicherweise nicht erforderlich, denn sie verursacht einen gewissen DNS- und HTTP-Datenverkehr beim Start und bei jeder Änderung der DNS-Konfiguration.\n\nWenn diese Richtlinie nicht konfiguriert oder aktiviert ist, werden die DNS-Abfangprüfungen durchgeführt. Nur wenn sie ausdrücklich deaktiviert ist, finden sie nicht statt.";
DataURLWhitespacePreservationEnabled.pfm_title = "Beibehaltung von Leerzeichen in Daten-URLs unabhängig vom Medientyp";
DataURLWhitespacePreservationEnabled.pfm_description = "Durch diese Richtlinie wird vorübergehend die Zustimmung zu Änderungen am Umgang von Chrome mit Leerzeichen in data-URLs widerrufen.\nZuvor wurden Leerzeichen nur beibehalten, wenn der Medientyp der obersten Ebene „text“ war oder den Medientyp-String „xml“ enthielt.\nJetzt werden Leerzeichen in allen Daten-URLs beibehalten, unabhängig vom Medientyp.\n\nWenn diese Richtlinie nicht konfiguriert oder auf „true“ gesetzt ist, ist das neue Verhalten aktiviert.\n\nWenn diese Richtlinie auf „false“ gesetzt ist, ist das alte Verhalten aktiviert.";
DataUrlInSvgUseEnabled.pfm_title = "Unterstützung von Daten-URLs für SVGUseElement.";
DataUrlInSvgUseEnabled.pfm_description = "Diese Richtlinie ermöglicht die Unterstützung von Daten-URLs für SVGUseElement – diese wird ab M119 standardmäßig deaktiviert.\nWenn diese Richtlinie aktiviert ist, funktionieren Daten-URLs weiterhin in SVGUseElement.\nWenn diese Richtlinie deaktiviert oder nicht konfiguriert ist, funktionieren Daten-URLs in SVGUseElement nicht.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Intransparente Ursprünge für Daten-URLs in Web Workern aktivieren";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Diese Richtlinie legt fest, ob Web Workern, die aus Daten-URLs erstellt wurden, ein eindeutiger intransparenter Ursprung zugewiesen wird.\n\nWeb Worker können mithilfe einer Daten-URL erstellt werden, die das Script des Web Workers enthält. Bisher haben diese Web Worker den Ursprung der Seite übernommen, von der sie erstellt wurden, sodass sie auf denselben lokalen Speicher, dieselben Cookies und andere ursprungsgebundene Daten zugreifen konnten. Um die Sicherheit zu verbessern und die HTML-Spezifikation einzuhalten, ändert Chrome in Version 149 das Standardverhalten, sodass Web Worker, die aus Daten-URLs erstellt wurden, jetzt einen eindeutigen, intransparenten Ursprung haben. Dadurch werden sie von den Daten der Seite, die sie erstellt hat, getrennt.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, wird das neue und sicherere Standardverhalten verwendet und Web Worker, die aus Daten-URLs erstellt wurden, haben einen eindeutigen intransparenten Ursprung.\n\nWenn diese Richtlinie deaktiviert ist, stellt Chrome das alte Verhalten wieder her und Web Worker, die aus Daten-URLs erstellt wurden, übernehmen den Ursprung der jeweiligen Seite. So können Administratoren Kompatibilitätsprobleme vorübergehend beheben, wenn interne Anwendungen aufgrund der Änderung an den Sicherheitsmaßnahmen nicht mehr funktionieren.\n\nDiese Richtlinie gilt vorübergehend und wird in Version 157 entfernt.";
DefaultAutomaticDownloadsSetting.pfm_title = "Standardeinstellung für automatische Downloads";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Websites gestatten, automatisch mehrere Dateien herunterzuladen\n2 - Keiner Website gestatten, automatisch mehrere Dateien herunterzuladen\n3 - Jedes Mal nachfragen, wenn eine Website mehrere Dateien automatisch herunterladen möchte\nWenn die Richtlinie auf „1“ gesetzt ist, können Websites automatisch mehrere Dateien herunterladen. Wenn die Richtlinie auf „2“ gesetzt ist, wird diese Berechtigung verweigert. Du kannst festlegen, dass nachgefragt wird, wenn eine Website automatisch mehrere Dateien herunterladen möchte.\n\nWenn die Richtlinie nicht konfiguriert ist, wird die Richtlinie „AskAutomaticDownloads“ angewandt, aber Nutzer können diese Einstellung ändern.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Brave als Standardbrowser festlegen";
DefaultBrowserSettingEnabled.pfm_description = "Wenn die Richtlinie auf \"True\" gesetzt ist, prüft Brave beim Start immer, ob es der Standardbrowser ist. Nach Möglichkeit legt sich die Anwendung dann automatisch als Standard fest. Ist die Richtlinie auf \"False\" gesetzt, prüft Brave nie, ob es der Standardbrowser ist. Außerdem werden alle Nutzersteuerelemente zum Einstellen dieser Option deaktiviert.\n\nWenn die Richtlinie nicht konfiguriert ist, kann der Nutzer festlegen, ob Brave der Standardbrowser ist und ob (falls nicht) entsprechende Benachrichtigungen angezeigt werden sollen.\n\nHinweis für Microsoft®Windows®-Administratoren: Diese Einstellung funktioniert nur auf Computern mit Windows 7. Bei neueren Versionen musst du eine Datei mit \"Standardanwendungszuordnungen\" angeben, die Brave zum Handler für die https- und http-Protokolle sowie optional für das ftp-Protokoll und weitere Dateiformate macht. Weitere Informationen findest du in der Chrome-Hilfe (https://support.google.com/chrome?p=make_chrome_default_win).";
DefaultClipboardSetting.pfm_title = "Standardmäßige Einstellung für die Zwischenablage";
DefaultClipboardSetting.pfm_description = "2 - Keiner Website erlauben, die Zwischenablage zu verwenden\n3 - Websites erlauben, den Nutzer zu bitten, die Zwischenablage verwenden zu dürfen\nWenn die Richtlinie auf „2“ gesetzt ist, sind die Websites nicht dazu berechtigt, die Zwischenablage zu nutzen. Wenn die Richtlinie auf „3“ gesetzt oder nicht konfiguriert ist, kann der Nutzer die Einstellung ändern und entscheiden, ob die Clipboard APIs verfügbar sein sollen, wenn eine Website versucht, darauf zuzugreifen.\n\nDie Richtlinie kann für bestimmte URL-Muster überschrieben werden. Hierfür stehen die Richtlinien „ClipboardAllowedForUrls“ und „ClipboardBlockedForUrls“ zur Verfügung.\n\nDiese Richtlinie bezieht sich nur auf Aktionen in der Zwischenablage, die in der entsprechenden Websiteberechtigung konfiguriert werden. Sie hat keinerlei Auswirkung auf unformatierte Inhalte in der Zwischenablage oder vertrauenswürdige Kopieren/Einfügen-Vorgänge.";
DefaultCookiesSetting.pfm_title = "Standardeinstellungen für Cookies";
DefaultCookiesSetting.pfm_description = "1 - Speichern von lokalen Daten für alle Websites zulassen\n2 - Speichern von lokalen Daten für keine Website zulassen\n4 - Cookies für die Dauer der Sitzung beibehalten\nWenn die Richtlinie RestoreOnStartup nicht so konfiguriert ist, dass URLs aus vorherigen Sitzungen dauerhaft wiederhergestellt werden, lässt sich durch die Konfiguration von CookiesSessionOnlyForUrls eine Liste von URL-Mustern erstellen, die angeben, welche Websites Cookies für eine Sitzung setzen dürfen oder nicht.\n\nWenn die Richtlinie nicht konfiguriert ist, wird für alle Websites DefaultCookiesSetting verwendet, sofern diese Einstellung konfiguriert ist. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet. Bei URLs, die nicht zu den angegebenen Mustern gehören, werden ebenfalls die Standardeinstellungen verwendet.\n\nWeder die Richtlinie mit Standardwerten noch eine der beiden folgenden Richtlinien, d. h. CookiesBlockedForUrls oder CookiesAllowedForUrls,  hat automatisch Vorrang. Es darf nur hinsichtlich der URL-Muster keine Konflikte zwischen diesen drei Richtlinien geben.";
DefaultDownloadDirectory.pfm_title = "Standard-Downloadverzeichnis festlegen";
DefaultDownloadDirectory.pfm_description = "Wenn die Richtlinie konfiguriert ist, wird das Standardverzeichnis festgelegt, das Chrome zum Herunterladen von Dateien verwendet. Nutzer können das Verzeichnis jedoch ändern.\n\nIst die Richtlinie nicht konfiguriert, verwendet Chrome das plattformspezifische Standardverzeichnis.\n\nDiese Richtlinie hat keine Auswirkungen, wenn die Richtlinie DownloadDirectory konfiguriert ist.\n\nHinweis: Unter https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables findest du eine Liste der Variablen, die verwendet werden können.";
DefaultFileSystemReadGuardSetting.pfm_title = "Verwendung der File System API zum Lesen steuern";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - Websites dürfen den Nutzer nicht um Lesezugriff auf Dateien und Verzeichnisse über die File System API bitten\n3 - Websites dürfen den Nutzer um Lesezugriff auf Dateien und Verzeichnisse über die File System API bitten\nWenn die Richtlinie auf \"3\" gesetzt ist, dürfen Websites um Lesezugriff auf Dateien und Verzeichnisse im Dateisystem des Host-Betriebssystems über die File System API bitten. Ist sie auf \"2\" gesetzt, wird der Zugriff verweigert.\n\nWenn sie nicht konfiguriert ist, können Websites den Zugriff erfragen, aber Nutzer können diese Einstellung ändern.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Verwendung der File System API zum Schreiben steuern";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - Websites nicht erlauben, um Schreibzugriff auf Dateien und Verzeichnisse zu bitten\n3 - Websites dürfen den Nutzer um Schreibzugriff auf Dateien und Verzeichnisse bitten\nWenn die Richtlinie auf \"3\" gesetzt ist, dürfen Websites um Schreibzugriff auf Dateien und Verzeichnisse im Dateisystem des Host-Betriebssystems bitten. Ist sie auf \"2\" gesetzt, wird der Zugriff verweigert.\n\nWenn sie nicht konfiguriert ist, können Websites den Zugriff erfragen, aber Nutzer können diese Einstellung ändern.";
DefaultGeolocationSetting.pfm_title = "Standardeinstellung für \"Standortbestimmung\"";
DefaultGeolocationSetting.pfm_description = "1 - Ermittlung des physischen Standorts des Nutzers durch Websites zulassen\n2 - Verfolgung des physischen Standorts der Nutzer für keine Website zulassen\n3 - Nachfragen, wenn eine Website den physischen Standort der Nutzer verfolgen möchte\nWenn die Richtlinie auf „1“ gesetzt ist, können Websites standardmäßig den physischen Standort der Nutzer verfolgen. Wenn die Richtlinie auf „2“ gesetzt ist, wird die Standortermittlung standardmäßig verweigert. Sie können festlegen, dass nachgefragt wird, wenn eine Website den physischen Standort der Nutzer verfolgen möchte.\n\nWenn die Richtlinie nicht konfiguriert ist, wird die Richtlinie AskGeolocation angewandt, aber Nutzer können diese Einstellung ändern.";
DefaultIdleDetectionSetting.pfm_title = "Inaktivitätserkennung";
DefaultIdleDetectionSetting.pfm_description = "1 - Websites erlauben, den Inaktivitätsstatus zu erkennen, ohne den Nutzer fragen zu müssen\n2 - Keiner Website erlauben, den Inaktivitätsstatus des Nutzers zu erkennen\n3 - Jedes Mal nachfragen, wenn eine Website den Inaktivitätsstatus des Nutzers ermitteln möchte\nMit dieser Richtlinie kannst du festlegen, ob Websites die Idle Detection API verwenden dürfen.\n\nWenn diese Richtlinie auf „1“ (AllowIdleDetection) festgelegt ist, können Websites die API verwenden, ohne den Nutzer um Erlaubnis zu bitten.\n\nWenn diese Richtlinie auf „2“ (BlockIdleDetection) festgelegt ist, können Websites die API nicht verwenden, unabhängig von der Berechtigung des Nutzers.\n\nWenn diese Richtlinie auf „3“ (AskIdleDetection) festgelegt oder nicht konfiguriert ist, können Websites die API nicht ohne die Erlaubnis des Nutzers verwenden.";
DefaultImagesSetting.pfm_title = "Standardeinstellung für Bilder";
DefaultImagesSetting.pfm_description = "1 - Anzeige aller Bilder auf allen Websites zulassen\n2 - Anzeige von Bildern für alle Websites blockieren\nWenn die Richtlinie auf „1“ gesetzt ist, dürfen alle Websites Bilder anzeigen. Ist die Richtlinie auf „2“ gesetzt, wird das Anzeigen von Bildern blockiert.\n\nWird die Richtlinie nicht konfiguriert, werden Bilder zugelassen, aber Nutzer können diese Einstellung ändern.";
DefaultInsecureContentSetting.pfm_title = "Ausnahmen bei unsicheren Inhalten verwalten";
DefaultInsecureContentSetting.pfm_description = "2 - Keiner Website das Laden von gemischten Inhalten erlauben\n3 - Nutzern erlauben, Ausnahmen hinzuzufügen, um gemischte Inhalte zuzulassen\nMit dieser Richtlinie können Sie festlegen, ob Nutzer mithilfe von Ausnahmen gemischte Inhalte auf bestimmten Websites zulassen dürfen.\n\nDie Richtlinie kann für bestimmte URL-Muster überschrieben werden. Hierfür stehen die Richtlinien „InsecureContentAllowedForUrls“ und „InsecureContentBlockedForUrls“ zur Verfügung.\n\nIst diese Richtlinie nicht konfiguriert, dürfen Nutzer Ausnahmen hinzufügen, um blockierbare gemischte Inhalte zuzulassen und das automatische Upgrade auf HTTPS von optional blockierbaren gemischten Inhalten zu deaktivieren.";
DefaultJavaScriptJitSetting.pfm_title = "Verwendung von JavaScript JIT steuern";
DefaultJavaScriptJitSetting.pfm_description = "1 - Ausführung von JavaScript JIT für alle Websites zulassen\n2 - Ausführung von JavaScript JIT für keine Website zulassen\nMit dieser Richtlinie kannst du festlegen, ob Brave die JavaScript-Engine V8 mit aktiviertem JIT-Compiler (Just In Time) ausführt oder nicht.\n\nWenn JavaScript JIT deaktiviert ist, rendert Brave möglicherweise Webinhalte langsamer und Teile von JavaScript, einschließlich WebAssembly, werden eventuell deaktiviert. Außerdem darf Brave Webinhalte möglicherweise in einer sichereren Konfiguration rendern, sollte JavaScript JIT deaktiviert sein.\n\nDie Richtlinie kann für bestimmte URL-Muster überschrieben werden. Hierfür stehen die Richtlinien JavaScriptJitAllowedForSites und JavaScriptJitBlockedForSites zur Verfügung.\n\nIst diese Richtlinie nicht konfiguriert, ist JavaScript JIT aktiviert.";
DefaultJavaScriptOptimizerSetting.pfm_title = "Verwendung von JavaScript-Optimierungen steuern";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Erweiterte JavaScript-Optimierungen für alle Websites aktivieren\n2 - Erweiterte JavaScript-Optimierungen auf allen Websites blockieren\nMit dieser Richtlinie kannst du festlegen, ob Brave die JavaScript-Engine V8 mit erweiterten JavaScript-Optimierungen ausführt.\n\nWenn JavaScript-Optimierungen deaktiviert sind (indem du den Wert dieser Richtlinie auf 2 setzt), rendert Brave Webinhalte möglicherweise langsamer.\n\nDie Richtlinie kann für bestimmte URL‑Muster überschrieben werden. Hierfür stehen die Richtlinien „JavaScriptOptimizerAllowedForSites“ und „JavaScriptOptimizerBlockedForSites“ zur Verfügung.\n\nIst diese Richtlinie nicht konfiguriert, sind JavaScript-Optimierungen aktiviert.";
DefaultJavaScriptSetting.pfm_title = "JavaScript-Standardeinstellung";
DefaultJavaScriptSetting.pfm_description = "1 - Ausführung von JavaScript für alle Websites zulassen\n2 - Ausführung von JavaScript für keine Website zulassen\nWenn die Richtlinie auf „1“ gesetzt ist, können Websites JavaScript ausführen. Wenn sie auf „2“ gesetzt ist, wird die Ausführung von JavaScript verweigert.\n\nWird die Richtlinie nicht konfiguriert, können Websites JavaScript ausführen, aber Nutzer können diese Einstellung ändern.";
DefaultLocalFontsSetting.pfm_title = "Standardmäßige Berechtigungseinstellung für lokale Schriftarten";
DefaultLocalFontsSetting.pfm_description = "2 - Lehnt die Berechtigung für lokale Schriftarten auf allen Websites standardmäßig ab\n3 - Immer fragen, wenn eine Website die Berechtigung für lokale Schriftarten haben möchte\nWenn die Richtlinie auf BlockLocalFonts (Wert 2) gesetzt ist, wird Websites die Berechtigung für lokale Schriftarten standardmäßig verweigert. Dadurch wird die Fähigkeit von Websites eingeschränkt, Informationen zu lokalen Schriftarten zu sehen.\n\nWenn die Richtlinie auf AskLocalFonts (Wert 3) gesetzt ist, wird dem Nutzer standardmäßig eine Benachrichtigung angezeigt, wenn die Berechtigung für lokale Schriftarten angefragt wird. Wenn Nutzer die Berechtigung gewähren, erweitert das die Fähigkeit von Websites, Informationen zu lokalen Schriftarten zu sehen.\n\nWenn diese Richtlinie nicht konfiguriert ist, sieht der Nutzer standardmäßig eine Benachrichtigung, kann die Einstellung aber ändern.";
DefaultNotificationsSetting.pfm_title = "Standardeinstellung für Benachrichtigungen";
DefaultNotificationsSetting.pfm_description = "1 - Anzeige von Desktop-Benachrichtigungen durch Websites zulassen\n2 - Anzeige von Desktop-Benachrichtigungen für keine Website zulassen\n3 - Nachfragen, wenn eine Website Desktop-Benachrichtigungen anzeigen will\nWenn die Richtlinie auf „1“ gesetzt ist, können Websites Desktop-Benachrichtigungen anzeigen. Ist die Richtlinie auf „2“ gesetzt, werden Desktop-Benachrichtigungen blockiert.\n\nWenn sie nicht konfiguriert ist, gilt die Richtlinie AskNotifications, aber Nutzer können diese Einstellung ändern.";
DefaultPopupsSetting.pfm_title = "Standardeinstellung für Pop-ups";
DefaultPopupsSetting.pfm_description = "1 - Anzeige von Pop-ups für alle Websites zulassen\n2 - Einblenden von Pop-ups auf keiner Website zulassen\nWenn die Richtlinie auf „1“ gesetzt ist, können Websites Pop-ups anzeigen. Wenn die Richtlinie auf „2“ gesetzt ist, werden Pop-ups blockiert.\n\nWenn sie nicht konfiguriert ist, gilt die Richtlinie BlockPopups, aber Nutzer können diese Einstellung ändern.";
DefaultPrinterSelection.pfm_title = "Regeln zur Auswahl des Standarddruckers";
DefaultPrinterSelection.pfm_description = "Durch diese Richtlinie werden die Regeln für die Auswahl des Standarddruckers in Brave festgelegt. Die Standardregeln werden dadurch überschrieben. Die Druckerauswahl wird angezeigt, wenn die Nutzer zum ersten Mal einen Druckauftrag ausführen und Brave einen Drucker sucht, der den angegebenen Attributen entspricht. Falls kein Drucker gefunden wird, der allen Attributen entspricht, kann in Brave eingestellt werden, dass ein beliebiger übereinstimmender Drucker ausgewählt werden soll. Die Auswahl hängt dann von der Reihenfolge ab, in der die Drucker gefunden werden.\n\nWenn die Richtlinie nicht konfiguriert ist oder auf Attribute eingestellt wird, für die keine Übereinstimmungen vorliegen, wird als Standardeinstellung der integrierte PDF-Drucker verwendet. Sollte kein PDF-Drucker vorhanden sein, wählt Brave gar keinen Drucker aus.\n\nMomentan werden alle Drucker als \"local\" klassifiziert. Mit Google Cloud Print verbundene Drucker werden als \"cloud\" betrachtet, aber Google Cloud Print wird nicht mehr unterstützt.\n\nHinweis: Wenn du ein Feld auslässt, gelten alle Werte für dieses Feld als übereinstimmend. Wenn du z. B. „idPattern“ nicht spezifizierst, akzeptiert die Druckvorschau alle Drucker-IDs. Reguläre Ausdrücke müssen in der RegExp-Syntax von JavaScript angegeben werden und es wird zwischen Groß- und Kleinschreibung unterschieden.\nUnter https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection erhältst du weitere Informationen zu Schema und Formatierung.";
DefaultSearchProviderAlternateURLs.pfm_title = "Liste alternativer URLs für den Standardsuchanbieter";
DefaultSearchProviderAlternateURLs.pfm_description = "Wenn \"DefaultSearchProviderEnabled\" aktiviert ist, gibt \"DefaultSearchProviderAlternateURLs\" eine Liste alternativer URLs an, die verwendet werden, um Suchbegriffe aus der Suchmaschine zu extrahieren. Die URLs sollten den String '{searchTerms}' enthalten.\n\nWenn \"DefaultSearchProviderAlternateURLs\" nicht konfiguriert ist, werden keine alternativen URLs verwendet, um Suchbegriffe aus der Suchmaschine zu extrahieren.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Zugriff auf die Suche mit dem Standardsuchanbieter über das Kontextmenü erlauben";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "Aktiviert die Verwendung eines Standardsuchanbieters im Kontextmenü.\n\nWenn diese Richtlinie deaktiviert ist, ist die Suche mit deinem Standardsuchanbieter im Kontextmenü nicht verfügbar.\n\nWenn sie aktiviert oder nicht konfiguriert ist, ist dein Standardsuchanbieter im Kontextmenü verfügbar.\n\nDer Richtlinienwert wird ausschließlich angewendet, wenn die Richtlinie DefaultSearchProviderEnabled aktiviert ist.";
DefaultSearchProviderEnabled.pfm_title = "Standardsuchmaschine aktivieren";
DefaultSearchProviderEnabled.pfm_description = "Ist diese Richtlinie aktiviert, wird eine Standardsuche durchgeführt, wenn der Nutzer Text in die Adressleiste eingibt, bei dem es sich nicht um eine URL handelt. Wenn du den Standardsuchanbieter angeben möchtest, lege die restlichen Richtlinien für die Standardsuche fest. Andernfalls kann der Nutzer den Standardanbieter selbst auswählen. Ist diese Richtlinie deaktiviert, wird keine Suche durchgeführt, wenn der Nutzer Text in die Adressleiste eingibt, bei dem es sich nicht um eine URL handelt. Der Wert „Deaktiviert“ wird von Google Admin console nicht unterstützt.\n\nWenn du diese Richtlinie konfigurierst, kann sie von Nutzern in Brave nicht geändert werden. Ist die Richtlinie nicht konfiguriert, wird der Standardsuchanbieter aktiviert und Nutzer können die Suchanbieterliste selbst zusammenstellen.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
DefaultSearchProviderEncodings.pfm_title = "Standardsuchmaschinen-Codierungen";
DefaultSearchProviderEncodings.pfm_description = "Wenn \"DefaultSearchProviderEnabled\" aktiviert ist, gibt \"DefaultSearchProviderEncodings\" die Zeichencodierungen an, die vom Suchanbieter unterstützt werden. Dazu werden Codeseiten-Namen wie \"UTF-8\", \"GB2312\" oder \"ISO-8859-1\" verwendet. Sie werden in der angegebenen Reihenfolge ausprobiert\n\nWenn \"DefaultSearchProviderEncodings\" nicht konfiguriert ist, wird \"UTF-8\" verwendet.";
DefaultSearchProviderImageURL.pfm_title = "Parameter für Funktion zur bildgesteuerten Suche für Standardsuchanbieter";
DefaultSearchProviderImageURL.pfm_description = "Wenn „DefaultSearchProviderEnabled“ aktiviert ist, wird durch die Konfiguration von „DefaultSearchProviderImageURL“ die URL der Suchmaschine angegeben, die für die Bildersuche verwendet wird. (Ist „DefaultSearchProviderImageURLPostParams“ konfiguriert, wird bei Bildsuchanfragen stattdessen die POST-Methode verwendet.)\n\nWenn „DefaultSearchProviderImageURL“ nicht konfiguriert ist, wird keine Bildersuche verwendet.\n\nWenn für die Bildersuche die GET-Methode verwendet wird, müssen Bildparameter\nin der URL mit einer gültigen Kombination aus folgenden Platzhaltern angegeben werden:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}' ,\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "Parameter für URL der Bildsuche, die POST verwendet";
DefaultSearchProviderImageURLPostParams.pfm_description = "Wenn „DefaultSearchProviderEnabled“ aktiviert ist, werden durch die Konfiguration von „DefaultSearchProviderImageURLPostParams“ die Parameter für die Bildersuche mit POST angegeben. Die Richtlinie besteht aus kommagetrennten Name-Wert-Paaren. Wenn ein Wert ein Vorlagenparameter wie „{imageThumbnail}“ ist, wird er durch echte Vorschaubilddaten ersetzt.\n\nWenn „DefaultSearchProviderImageURLPostParams“ nicht konfiguriert ist, wird die Bildsuchanfrage mithilfe der GET-Methode gesendet.\n\nIn der URL muss der Bildparameter mit einer gültigen Kombination aus folgenden\nPlatzhaltern angegeben werden, je nachdem, was vom Suchanbieter unterstützt wird:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Suchbegriff der Standardsuchmaschine";
DefaultSearchProviderKeyword.pfm_description = "Wenn \"DefaultSearchProviderEnabled\" aktiviert ist, gibt \"DefaultSearchProviderKeyword\" den Suchbegriff oder die Verknüpfung an, die in der Adressleiste zum Starten der Suche für diesen Anbieter verwendet wird.\n\nWenn \"DefaultSearchProviderKeyword\" nicht konfiguriert ist, lässt sich der Suchanbieter nicht durch einen Suchbegriff aktivieren.";
DefaultSearchProviderName.pfm_title = "Name der Standardsuchmaschine";
DefaultSearchProviderName.pfm_description = "Wenn \"DefaultSearchProviderEnabled\" aktiviert ist, gibt \"DefaultSearchProviderName\" den Namen des Standardsuchanbieters an.\n\nWenn \"DefaultSearchProviderName\" nicht konfiguriert ist, wird der von der Such-URL angegebene Hostname verwendet.";
DefaultSearchProviderNewTabURL.pfm_title = "Standardsuchanbieter-URL für die \"Neuer Tab\"-Seite";
DefaultSearchProviderNewTabURL.pfm_description = "Wenn \"DefaultSearchProviderEnabled\" aktiviert ist, gibt \"DefaultSearchProviderNewTabURL\" die URL an, die eine Suchmaschine zum Bereitstellen der \"Neuer Tab\"-Seite verwendet.\n\nIst \"DefaultSearchProviderNewTabURL\" nicht konfiguriert, wird keine \"Neuer Tab\"-Seite bereitgestellt.";
DefaultSearchProviderSearchURL.pfm_title = "Such-URL der Standardsuchmaschine";
DefaultSearchProviderSearchURL.pfm_description = "Wenn \"DefaultSearchProviderEnabled\" aktiviert ist, gibt \"DefaultSearchProviderSearchURL\" die URL der Standardsuchmaschine an. Die URL sollte den String '{searchTerms}' enthalten, der während des Suchvorgangs durch die Suchbegriffe des Nutzers ersetzt wird.\n\nDu kannst die Such-URL von Google so angeben: '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "Parameter für URL der Suche, die POST verwendet";
DefaultSearchProviderSearchURLPostParams.pfm_description = "Wenn \"DefaultSearchProviderEnabled\" aktiviert ist, gibt \"DefaultSearchProviderSearchURLPostParams\" die Parameter für die Suche nach einer URL mit POST an. Die Richtlinie besteht aus kommagetrennten Name/Wert-Paaren. Wenn ein Wert ein Vorlagenparameter wie '{searchTerms}' ist, wird er durch echte Suchbegriffsdaten ersetzt.\n\nIst \"DefaultSearchProviderSearchURLPostParams\" nicht konfiguriert, werden Suchanfragen mithilfe der GET-Methode gesendet.";
DefaultSearchProviderSuggestURL.pfm_title = "Vorschlags-URL für die Standardsuchmaschine";
DefaultSearchProviderSuggestURL.pfm_description = "Wenn \"DefaultSearchProviderEnabled\" aktiviert ist, gibt \"DefaultSearchProviderSuggestURL\" die URL der Suchmaschine für Suchvorschläge an. Die URL sollte den String '{searchTerms}' enthalten, der während des Suchvorgangs durch die Suchbegriffe des Nutzers ersetzt wird.\n\nDu kannst die Such-URL von Google so angeben: '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "Parameter für URL der Vorschlagsuche, die POST verwendet";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "Wenn \"DefaultSearchProviderEnabled\" aktiviert ist, gibt \"DefaultSearchProviderSuggestURLPostParams\" die Parameter für die Vorschlagsuche mit POST an. Die Richtlinie besteht aus kommagetrennten Name/Wert-Paaren. Wenn ein Wert ein Vorlagenparameter wie '{searchTerms}' ist, wird er durch echte Suchbegriffsdaten ersetzt.\n\nIst \"DefaultSearchProviderSuggestURLPostParams\" nicht konfiguriert, wird die Vorschlagsuchanfrage mithilfe der GET-Methode gesendet.";
DefaultSensorsSetting.pfm_title = "Standardeinstellung für Sensoren";
DefaultSensorsSetting.pfm_description = "1 - Websites den Zugriff auf Sensoren erlauben\n2 - Keiner Website erlauben, auf Sensoren zuzugreifen\n3 - Nachfragen, wenn eine Website auf Sensoren zugreifen möchte\nWenn die Richtlinie auf 1 gesetzt ist, dürfen Websites auf Sensoren wie Bewegungs- und Lichtsensoren zugreifen und diese nutzen. Ist sie auf 2 gesetzt, wird der Zugriff auf alle Sensoren verweigert. Wenn die Richtlinie auf 3 gesetzt ist, wird der Nutzer gefragt, wenn eine Website Zugriff auf Sensoren anfordert und das Tri-State-Funktions-Flag aktiviert ist. Anderenfalls wird der Zugriff auf Sensoren standardmäßig gewährt.\n\nWenn sie nicht konfiguriert ist, gilt die Richtlinie AllowSensors, aber Nutzer können diese Einstellung ändern.";
DefaultSerialGuardSetting.pfm_title = "Verwendung der Serial API steuern";
DefaultSerialGuardSetting.pfm_description = "2 - Websites nicht erlauben, den Nutzer über die Serial API um Zugriff auf serielle Ports zu bitten\n3 - Websites erlauben, den Nutzer um Zugriff auf einen seriellen Port zu bitten\nWenn die Richtlinie auf \"3\" gesetzt ist, dürfen Websites um Zugriff auf serielle Ports bitten. Ist die Richtlinie auf \"2\" gesetzt, wird der Zugriff auf serielle Ports blockiert.\n\nWenn sie nicht konfiguriert ist, können Websites den Zugriff erfragen, aber Nutzer können diese Einstellung ändern.";
DefaultWebBluetoothGuardSetting.pfm_title = "Verwendung der Web Bluetooth API steuern";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - Keine Website darf Zugriff auf Bluetooth-Geräte über die Web Bluetooth API anfordern\n3 - Websites dürfen den Nutzer um Zugriff auf ein Bluetooth-Gerät in der Nähe bitten\nWenn die Richtlinie auf \"3\" gesetzt ist, können Websites den Zugriff auf Bluetooth-Geräte in der Nähe anfragen. Wenn die Richtlinie auf \"2\" gesetzt ist, wird der Zugriff auf Bluetooth-Geräte in der Nähe verweigert.\n\nWird sie nicht konfiguriert, können Websites den Zugriff anfragen, Nutzer können diese Einstellung jedoch ändern.";
DefaultWebHidGuardSetting.pfm_title = "Verwendung der WebHID API verwalten";
DefaultWebHidGuardSetting.pfm_description = "2 - Websites nicht erlauben, den Nutzer über die WebHID API um Zugriff auf HID-Geräte zu bitten\n3 - Websites dürfen den Nutzer um Zugriff auf HID-Geräte bitten\nWenn die Richtlinie auf 3 gesetzt ist, dürfen Websites um Zugriff auf HID-Geräte bitten. Ist sie auf 2 gesetzt, wird der Zugriff auf HID-Geräte verweigert.\n\nWenn sie nicht konfiguriert ist, können Websites um Zugriff bitten, aber Nutzer können diese Einstellung ändern.\n\nDie Richtlinie kann für bestimmte url-Muster überschrieben werden. Hierfür stehen die Richtlinien WebHidAskForUrls und WebHidBlockedForUrls zur Verfügung.";
DefaultWebUsbGuardSetting.pfm_title = "Verwendung der WebUSB API steuern";
DefaultWebUsbGuardSetting.pfm_description = "2 - Websites dürfen nie Zugriff auf USB-Geräte über die WebUSB API anfordern\n3 - Websites dürfen den Nutzer um Zugriff auf ein angeschlossenes USB-Gerät bitten\nWenn die Richtlinie auf \"3\" gesetzt ist, können Websites den Zugriff auf angeschlossene USB-Geräte erfragen. Wenn die Richtlinie auf \"2\" gesetzt ist, wird der Zugriff auf angeschlossene USB-Geräte verweigert.\n\nWenn sie nicht konfiguriert ist, können Websites den Zugriff erfragen, aber Nutzer können diese Einstellung ändern.";
DefaultWindowManagementSetting.pfm_title = "Standardeinstellung für die Berechtigung „Fensterverwaltung“";
DefaultWindowManagementSetting.pfm_description = "2 - Die Berechtigung für die Fensterverwaltung wird standardmäßig auf allen Websites verweigert\n3 - Jedes Mal nachfragen, wenn eine Website um die Berechtigung für die Fensterverwaltung bittet\nWenn die Richtlinie auf BlockWindowManagement (Wert 2) gesetzt ist, wird die Berechtigung für die Fensterverwaltung automatisch auf allen Websites verweigert. Dadurch wird die Fähigkeit von Websites eingeschränkt, Informationen zum Bildschirm des Geräts abzurufen und zu nutzen, um Fenster zu öffnen und zu platzieren oder auf bestimmten Bildschirmen den Vollbildmodus anzufordern.\n\nWenn die Richtlinie auf AskWindowManagement (Wert 3) gesetzt ist, wird dem Nutzer eine Benachrichtigung angezeigt, wenn standardmäßig die Berechtigung für die Fensterverwaltung angefragt wird. Wenn Nutzer die Berechtigung gewähren, können Websites Informationen zum Bildschirm des Geräts abrufen und nutzen, um Fenster zu öffnen und zu platzieren oder auf bestimmten Bildschirmen den Vollbildmodus anzufordern.\n\nWenn die Richtlinie nicht konfiguriert ist, wird die Richtlinie AskWindowManagement angewandt, aber Nutzer können diese Einstellung ändern.\n\nDies ersetzt die eingestellte Richtlinie DefaultWindowPlacementSetting.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Löschen nicht entschlüsselbarer Passwörter aktivieren";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob der integrierte Passwortmanager nicht entschlüsselbare Passwörter aus seiner Datenbank löschen kann. Dies ist erforderlich, um die volle Funktionalität des integrierten Passwortmanagers wiederherzustellen. Es kann jedoch dadurch zu einem dauerhaften Datenverlust kommen. Nicht entschlüsselbare Passwörter können dann nicht automatisch entschlüsselt werden. Wenn sie überhaupt entschlüsselt werden können, sind dafür in der Regel komplexe Nutzeraktionen erforderlich.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, gehen nicht entschlüsselbare Passwörter, die Nutzer im integrierten Passwortmanager gespeichert haben, verloren. Passwörter, die sich noch verwenden lassen, bleiben unverändert.\n\nIst die Richtlinie deaktiviert, bleiben die Daten des Passwortmanagers für Nutzer erhalten, die Passwortmanager-Funktionalität ist jedoch fehlerhaft.\n\nIst die Richtlinie konfiguriert, können Nutzer sie in Brave nicht ändern.";
DesktopSharingHubEnabled.pfm_title = "Desktop-Freigabe in der Omnibox und im Dreipunkt-Menü aktivieren";
DesktopSharingHubEnabled.pfm_description = "Wenn die Richtlinie auf „True“ gesetzt oder nicht konfiguriert ist, können Nutzer die aktuelle Webseite anhand der über den Desktop-Freigabe-Hub verfügbaren Aktionen teilen oder speichern. Auf den Freigabe-Hub wird über ein Omnibox-Symbol oder das Dreipunkt-Menü zugegriffen.\n\nWenn die Richtlinie auf „False“ gesetzt ist, wird das Freigabesymbol aus der Omnibox und der Eintrag aus dem Dreipunkt-Menü entfernt.";
DevToolsGenAiSettings.pfm_title = "Einstellungen für die auf generativer KI basierenden Funktionen der Chrome DevTools";
DevToolsGenAiSettings.pfm_description = "0 - Auf generativer KI basierende Funktionen der Chrome DevTools zulassen und KI‑Modelle verbessern.\n1 - Auf generativer KI basierende Funktionen der Chrome DevTools zulassen, ohne KI‑Modelle zu verbessern.\n2 - Auf generativer KI basierende Funktionen der Chrome DevTools nicht zulassen.\nBei diesen Funktionen in den Chrome DevTools werden generative KI-Modelle eingesetzt, um zusätzliche Debugging-Informationen bereitzustellen. Zur Verwendung dieser Funktionen muss Brave Daten wie Fehlermeldungen, Stacktraces, Code-Snippets und Netzwerkanfragen erheben und an einen Google-Server senden, auf dem ein generatives KI-Modell ausgeführt wird. Antworttext oder Authentifizierungs- und Cookie-Header in Netzwerkanfragen sind nicht in den Daten enthalten, die an den Server gesendet werden.\n\n„0“ = Die Funktion darf verwendet werden und Google darf relevante Daten nutzen, um seine KI‑Modelle zu verbessern. Relevante Daten können je nach Funktion Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftliches Feedback sein. Sie werden möglicherweise auch manuell geprüft, um KI‑Modelle zu verbessern. „0“ ist der Standardwert, außer in den unten angegebenen Fällen.\n\n„1“ = Die Funktion darf verwendet werden, Google darf aber keine Modelle mithilfe von Nutzerinhalten (einschließlich Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftlichen Feedbacks) verbessern. „1“ ist der Standardwert für Unternehmensnutzer, die über die Google Admin console verwaltet werden, sowie für Konten von Bildungseinrichtungen, die über Google Workspace verwaltet werden.\n\n„2“ = Die Funktion darf nicht verwendet werden.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nZu den auf generativer KI basierenden Funktionen der Chrome DevTools gehören folgende:\n\n– Console Insights: erklärt Konsolenmeldungen und bietet Vorschläge zum Beheben von Konsolenfehlern.\n\n– KI‑Unterstützung: bietet Hilfe beim Verständnis von CSS-Stilen (ab Version 131), Netzwerkanfragen, Leistung und Dateien (alles ab Version 132).\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Google Developer Program-Profile in „Chrome DevTools“ aktivieren";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Einbindung des Google Developer Program in „Chrome DevTools“ aktivieren.\n1 - Einbindung des Google Developer Program in „Chrome DevTools“ aktivieren, jedoch ohne die Nutzung von Tools freizugeben (zur Vergabe von Logos).\n2 - Einbindung des Google Developer Program in „Chrome DevTools“ nicht aktivieren.\nMit dieser Richtlinie wird die Einbindung des Google Developer Program in „Chrome DevTools“ gesteuert. Das Google Developer Program-Profil des Nutzers wird in „Chrome DevTools“ angezeigt und Nutzer erhalten Logos für die Ausführung bestimmter Aktionen in „Chrome DevTools“.\n\nWenn die Richtlinie auf „0“ (Aktiviert) festgelegt oder kein Richtlinienwert festgelegt wird, ist die Einbindung des Google Developer Program in „Chrome DevTools“ möglich und die Nutzung des Tools „Chrome DevTools“ wird freigegeben, damit Logos vergeben werden können.\n\nWenn die Richtlinie auf „1“ (Aktiviert ohne Logos) festgelegt wird, ist die Einbindung des Google Developer Program in „Chrome DevTools“ möglich, aber die Nutzung des Tools „Chrome DevTools“ wird für das Google Developer Program nicht freigegeben. Es werden keine Logos vergeben.\n\nWenn die Richtlinie auf „2“ (Deaktiviert) festgelegt wird, ist die Einbindung des Google Developer Program in „Chrome DevTools“ nicht möglich.";
DeveloperToolsAvailability.pfm_title = "Festlegen, wo die Chrome DevTools verwendet werden können";
DeveloperToolsAvailability.pfm_description = "0 - Die Nutzung der Chrome DevTools in Apps und Erweiterungen, die über die Unternehmensrichtlinie oder ab Version 114 installiert wurden oder in den Browser eines verwalteten Nutzers eingebunden sind, ist nicht zulässig. Ist dies ein verwalteter Nutzer, sind in den Browser integrierte Erweiterungen nicht zulässig. Nutzung der Chrome DevTools in anderen Kontexten zulassen\n1 - Verwendung der Chrome DevTools zulassen\n2 - Verwendung von Chrome DevTools nicht zulassen\nWenn die Richtlinie auf 0 gesetzt ist (Standardeinstellung), kannst du auf die Chrome DevTools und die JavaScript-Konsole zugreifen. Für Erweiterungen, die über die Unternehmensrichtlinie installiert wurden, oder ab Version 114 für Erweiterungen, die in den Browser eines verwalteten Nutzers eingebunden sind, ist der Zugriff aber nicht möglich. Ist die Richtlinie auf 1 gesetzt, kannst du die Chrome DevTools und die JavaScript-Konsole in allen Kontexten aufrufen, also auch bei Erweiterungen, die über die Unternehmensrichtlinie installiert wurden. Wenn die Richtlinie auf 2 gesetzt ist, kann nicht auf die Chrome DevTools zugegriffen werden und Websiteelemente können nicht geprüft werden.\n\nAlle Tastenkombinationen und Einträge im Menü oder Kontextmenü, mit denen die Chrome DevTools oder die JavaScript-Konsole aufgerufen werden, werden deaktiviert.\n\nSeit Version 99 von Brave werden durch diese Einstellung auch Einstiegspunkte für die Funktion „Seiten-Quelltext anzeigen“ bestimmt. Wenn diese Richtlinie auf „DeveloperToolsDisallowed“ (Wert 2) festgelegt ist, können Nutzer sich den Quelltext nicht über Tastenkombinationen oder das Kontextmenü anzeigen lassen. Soll die Anzeige des Quelltexts komplett blockiert werden, ist es auch erforderlich, der Richtlinie „URLBlocklist“ den Eintrag „view-source:*“ hinzuzufügen.\n\nSeit Version 119 von Brave wird durch diese Einstellung außerdem bestimmt, ob der Entwicklermodus für isolierte Web-Apps aktiviert und verwendet werden kann.\n\nSeit Version 128 von Brave lässt sich der Entwicklermodus auf der Seite „Erweiterungen“ nicht mehr mit dieser Einstellung steuern, wenn die Richtlinie „ExtensionDeveloperModeSettings“ konfiguriert ist.\n\nDiese Richtlinie wirkt sich auf die Chrome DevTools, den direkten Zugriff auf das Chrome-Entwicklertools-Protokoll (Chrome DevTools Protocol, CDP), z. B. beim Starten mit „--remote-debugging-port“ oder „--remote-debugging-pipe“, und den Zugriff auf das CDP über chrome.debugger-APIs aus. Sowohl diese Richtlinie als auch die Richtlinie „RemoteDebuggingAllowed“ gelten: „RemoteDebuggingAllowed“ bestimmt, ob das Remote-Debugging gestartet werden kann, während diese Richtlinie einschränkt, ob einzelne Ziele auch dann geprüft werden können, wenn das Remote-Debugging ausgeführt wird.\n\nDie Richtlinien „DeveloperToolsAvailabilityAllowlist“ und „DeveloperToolsAvailabilityBlocklist“ haben Vorrang vor dieser Richtlinie. Die Verfügbarkeit der Chrome DevTools wird in der folgenden Rangfolge bestimmt:\n1. Wenn eine URL mit einem Muster in der Richtlinie „DeveloperToolsAvailabilityAllowlist“ übereinstimmt, sind die Chrome DevTools zulässig.\n2. Wenn die Richtlinie „DeveloperToolsAvailabilityAllowlist“ konfiguriert ist und „DeveloperToolsAvailabilityBlocklist“ nicht, wird jede URL blockiert, die nicht auf der Zulassungsliste steht.\n3. Wenn eine URL mit einem Muster in der Richtlinie „DeveloperToolsAvailabilityBlocklist“ übereinstimmt, werden die Chrome DevTools blockiert.\n4. Wenn keine der beiden Richtlinien konfiguriert ist oder eine URL mit keiner der beiden Listen übereinstimmt, wird diese Richtlinie (DeveloperToolsAvailability) als Fallback-Mechanismus verwendet.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Liste der URL-Muster, für die das Öffnen von Chrome DevTools zulässig ist";
DeveloperToolsAvailabilityAllowlist.pfm_description = "Mit dieser Richtlinie kannst die Chrome DevTools für bestimmte URLs zulassen.\n\nDie Verfügbarkeit der Chrome DevTools wird auf Zielebene bewertet. URL-Muster werden mit der URL jedes geprüften Ziels abgeglichen (z. B. dem Hauptframe einer Seite, einem eingebetteten Subframe, einer Erweiterung oder einer Webanwendung). Das daraus resultierende Verhalten hängt davon ab, ob die Richtlinie „DeveloperToolsAvailabilityBlocklist“ ebenfalls konfiguriert ist.\n\nWenn diese Richtlinie konfiguriert ist und „DeveloperToolsAvailabilityBlocklist“ nicht, muss die URL eines Ziels mit einem Muster auf dieser Zulassungsliste übereinstimmen, damit die Chrome DevTools für dieses Ziel zulässig sind. Wenn die URL eines Ziels nicht mit dieser Zulassungsliste übereinstimmt, werden die Chrome DevTools für dieses Ziel blockiert. Beispielsweise kann ein Subframe, dessen URL nicht auf der Zulassungsliste steht, nicht geprüft werden, die Hauptseite kann jedoch geprüft werden, wenn ihre URL auf der Zulassungsliste steht. Informationen zum URL-Format findest du unter https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nWenn sowohl diese Richtlinie als auch „DeveloperToolsAvailabilityBlocklist“ festgelegt sind, hat diese Zulassungsliste Vorrang. Wenn die URL eines Ziels mit einem Muster auf dieser Zulassungsliste übereinstimmt, ist sie zulässig, auch wenn sie ebenfalls mit einem Muster auf der Sperrliste übereinstimmt. Stimmt die URL eines Ziels mit einem Muster überein, das auf dieser Sperrliste (aber nicht auf der Zulassungsliste) steht, wird sie blockiert. Falls die URL eines Ziels mit keinem Muster der beiden Listen übereinstimmt, wird die Richtlinie „DeveloperToolsAvailability“ als Fallback verwendet.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird die Verfügbarkeit der Chrome DevTools durch die Richtlinien „DeveloperToolsAvailabilityBlocklist“ und „DeveloperToolsAvailability“ bestimmt.\n\nAlles einschließende Platzhalter für den Host (z. B. „*“ oder „[*]“) sind nicht zulässig. Verwende die Richtlinie „DeveloperToolsAvailability“, um die Funktion global zu aktivieren.\n\nDiese Richtlinie wirkt sich auf die Chrome DevTools, den direkten Zugriff auf das Chrome-Entwicklertools-Protokoll (Chrome DevTools Protocol, CDP), z. B. beim Starten mit „--remote-debugging-port“ oder „--remote-debugging-pipe“, und den Zugriff auf das CDP über chrome.debugger-APIs aus. Sowohl diese Richtlinie als auch die Richtlinie „RemoteDebuggingAllowed“ gelten: „RemoteDebuggingAllowed“ bestimmt, ob das Remote-Debugging gestartet werden kann, während diese Richtlinie einschränkt, ob einzelne Ziele auch dann geprüft werden können, wenn das Remote-Debugging ausgeführt wird.\n\nDiese Richtlinie ist auf 1.000 Einträge beschränkt.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Liste der URL-Muster, für die Chrome DevTools blockiert sind";
DeveloperToolsAvailabilityBlocklist.pfm_description = "Mit dieser Richtlinie kannst du die Chrome DevTools für bestimmte URLs blockieren. Informationen zum URL-Format findest du unter https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nDie Verfügbarkeit der Chrome DevTools wird auf Zielebene bewertet. URL-Muster werden mit der URL jedes geprüften Ziels abgeglichen (z. B. dem Hauptframe einer Seite, einem eingebetteten Subframe, einer Erweiterung oder einer Webanwendung). Das daraus resultierende Verhalten hängt davon ab, ob die Richtlinie „DeveloperToolsAvailabilityAllowlist“ ebenfalls konfiguriert ist.\n\nWenn diese Richtlinie konfiguriert ist und „DeveloperToolsAvailabilityAllowlist“ nicht, werden die Chrome DevTools für ein Ziel blockiert, wenn die URL des Ziels mit einem Muster auf dieser Sperrliste übereinstimmt. Beispielsweise kann ein Subframe, dessen URL mit dieser Sperrliste übereinstimmt, nicht geprüft werden, aber die Hauptseite kann weiterhin geprüft werden, wenn ihre URL nicht auf der Sperrliste steht. Wenn die URL eines Ziels mit keinem Muster übereinstimmt, wird die Verfügbarkeit von der Richtlinie „DeveloperToolsAvailability“ bestimmt.\n\nSind sowohl diese Richtlinie als auch „DeveloperToolsAvailabilityAllowlist“ festgelegt, hat die Zulassungsliste Vorrang. Wenn die URL eines Ziels mit einem Muster auf der Zulassungsliste übereinstimmt, ist sie zulässig, auch wenn sie ebenfalls mit einem Muster auf dieser Sperrliste übereinstimmt. Stimmt die URL eines Ziels mit einem Muster überein, das auf dieser Sperrliste (aber nicht auf der Zulassungsliste) steht, wird sie blockiert. Falls die URL eines Ziels mit keinem Muster der beiden Listen übereinstimmt, wird die Richtlinie „DeveloperToolsAvailability“ als Fallback verwendet.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird die Verfügbarkeit der Chrome DevTools durch die Richtlinien „DeveloperToolsAvailabilityAllowlist“ und „DeveloperToolsAvailability“ bestimmt.\n\nDiese Richtlinie wirkt sich auf die Chrome DevTools, den direkten Zugriff auf das Chrome-Entwicklertools-Protokoll (Chrome DevTools Protocol, CDP), z. B. beim Starten mit „--remote-debugging-port“ oder „--remote-debugging-pipe“, und den Zugriff auf das CDP über chrome.debugger-APIs aus. Sowohl diese Richtlinie als auch die Richtlinie „RemoteDebuggingAllowed“ gelten: „RemoteDebuggingAllowed“ bestimmt, ob das Remote-Debugging gestartet werden kann, während diese Richtlinie einschränkt, ob einzelne Ziele auch dann geprüft werden können, wenn das Remote-Debugging ausgeführt wird.\n\nDiese Richtlinie ist auf 1.000 Einträge beschränkt.";
Disable3DAPIs.pfm_title = "Unterstützung für 3D-Grafik-APIs deaktivieren";
Disable3DAPIs.pfm_description = "Wenn die Richtlinie auf „True“ (oder „HardwareAccelerationModeEnabled“ auf „False“) gesetzt ist, können Webseiten nicht auf die WebGL API zugreifen.\n\nIst die Richtlinie auf „False“ gesetzt oder nicht konfiguriert, können Webseiten die WebGL API nutzen, doch bei den Standardeinstellungen des Browsers kann es weiterhin erforderlich sein, dass zur Verwendung dieser APIs Argumente über die Befehlszeile eingegeben werden müssen.";
DisableAuthNegotiateCnameLookup.pfm_title = "CNAME-Suche bei der Aushandlung der Kerberos-Authentifizierung deaktivieren";
DisableAuthNegotiateCnameLookup.pfm_description = "Wenn die Richtlinie aktiviert ist, wird die CNAME-Suche übersprungen. Der Servername wird so wie eingegeben verwendet, wenn der Kerberos-SPN generiert wird.\n\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist, bestimmt die CNAME-Suche den kanonischen Namen des Servers, wenn der Kerberos-SPN generiert wird.";
DisablePrintPreview.pfm_title = "Druckvorschau deaktivieren";
DisablePrintPreview.pfm_description = "Wenn die Richtlinie aktiviert ist, öffnet Brave nicht die integrierte Druckvorschau, sondern das Druckdialogfeld des Systems, wenn ein Nutzer die Druckfunktion verwendet.\n\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist, führen Druckbefehle zur Anzeige der Druckvorschau.";
DisableSafeBrowsingProceedAnyway.pfm_title = "Fortfahren von der Safe Browsing-Hinweisseite deaktivieren";
DisableSafeBrowsingProceedAnyway.pfm_description = "Wenn diese Richtlinie aktiviert ist, können Nutzer von einer durch Safe Browsing angezeigten Hinweisseite nicht zur entsprechenden schädlichen Website weitergehen. Durch diese Richtlinie werden Nutzer nur bei Safe Browsing-Warnungen (etwa wegen Malware oder Phishing) am Fortfahren gehindert, nicht jedoch bei Problemen mit SSL-Zertifikaten, z. B. wenn diese ungültig oder abgelaufen sind.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, können Nutzer sich entscheiden, die gekennzeichnete Website dennoch aufzurufen.\n\nWeitere Informationen zu Safe Browsing findest du unter https://developers.google.com/safe-browsing.";
DisableScreenshots.pfm_title = "Aufnahme von Screenshots deaktivieren";
DisableScreenshots.pfm_description = "Wenn die Richtlinie aktiviert ist, können keine Screenshots über Tastenkombinationen oder Erweiterungs-APIs aufgenommen werden. Ist die Richtlinie deaktiviert oder nicht konfiguriert, sind Screenshots zulässig.\n\nAb Brave-Version 154 verhindert das Aktivieren dieser Richtlinie auch, dass Erweiterungen den Debugger über „chrome.debugger.attach()“ anhängen.\n\nBeachte, dass Screenshots, die mit Betriebssystem- oder Drittanbieter-Apps aufgenommen wurden, unter Microsoft® Windows®, macOS und Linux weiterhin zulässig sind.";
DiskCacheDir.pfm_title = "Datenträger-Cache-Verzeichnis festlegen";
DiskCacheDir.pfm_description = "Wird die Richtlinie festgelegt, dann verwendet Brave das von dir angegebenen Verzeichnis zum Speichern von im Cache gespeicherten Dateien auf dem Laufwerk unabhängig davon, ob der Nutzer das Flag \"--disk-cache-dir\" angegeben hat.\n\nWurde die Richtlinie nicht festgelegt, dann verwendet Brave das Cachestandardverzeichnis. Diese Einstellung können Nutzer jedoch mit dem Befehlszeilen-Flag \"--disk-cache-dir\" ändern.\n\nBrave verwaltet die Inhalte des Stammverzeichnisses eines Volumes. Daher darfst du zur Vermeidung von Datenverlust und sonstigen Fehlern diese Richtlinie nicht auf das Stammverzeichnis oder ein anderes Verzeichnis festlegen, das für andere Zwecke verwendet wird. Informationen zu den Variablen, die du verwenden kannst, findest du unter https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DiskCacheSize.pfm_title = "Datenträger-Cache-Größe festlegen";
DiskCacheSize.pfm_description = "Wenn die Richtlinie auf „Keine“ festgelegt ist, verwendet Brave die Cachestandardgröße zum Speichern von Dateien im Cache auf dem Laufwerk. Dies kann vom Nutzer nicht geändert werden.\n\nWenn du die Richtlinie konfigurierst, verwendet Brave die von dir angegebene Cachegröße unabhängig davon, ob Nutzer das Flag „--disk-cache-size“ angeben oder nicht. Werte, die kleiner als einige Megabyte sind, werden aufgerundet.\n\nWenn die Richtlinie nicht konfiguriert ist, verwendet Brave die Standardgröße. Nutzer können diese Einstellung mit dem Flag „--disk-cache-size“ ändern.\n\nHinweis: Der in dieser Richtlinie angegebene Wert wird als Hinweis für verschiedene Cache-Subsysteme des Browsers verwendet. Daher ist der tatsächliche Speicherplatzverbrauch aller Caches insgesamt größer, der angegebene Wert trifft aber in etwa zu.";
DnsOverHttpsMode.pfm_title = "Steuert den DoH-Modus (DNS over HTTPS)";
DnsOverHttpsMode.pfm_description = "off - DoH deaktivieren\nautomatic - DoH-Modus mit unsicherem Fallback-Verhalten aktivieren\nsecure - DoH-Modus ohne unsicheres Fallback-Verhalten aktivieren\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "Die URI-Vorlage des gewünschten DoH-Resolvers (DNS over HTTPS) angeben";
DnsOverHttpsTemplates.pfm_description = "Die URI-Vorlage des gewünschten DoH-Resolvers (DNS-over-HTTPS). Wenn Sie mehrere DoH-Resolver angeben möchten, trennen Sie die dazugehörigen URI-Vorlagen durch Leerzeichen.\n\nWenn „DnsOverHttpsMode“ auf \"secure\" gesetzt ist, muss diese Richtlinie konfiguriert werden und darf nicht leer sein. Nur für Google Chrome OS muss entweder diese Richtlinie oder „DnsOverHttpsTemplatesWithIdentifiers“ festgelegt sein. Andernfalls schlägt die DNS-Auflösung fehl.\n\nWenn „DnsOverHttpsMode“ auf \"automatic\" gesetzt und diese Richtlinie konfiguriert ist, werden die angegebenen URI-Vorlagen verwendet. Wenn diese Richtlinie nicht konfiguriert ist, werden hartcodierte Verknüpfungen verwendet, um vom aktuellen DNS-Resolver des Nutzers ein Upgrade auf einen DoH-Resolver durchzuführen, der von demselben Anbieter ausgeführt wird.\n\nWenn die URI-Vorlage eine dns-Variable enthält, verwenden Anfragen an den Resolver GET; andernfalls verwenden Anfragen POST.\n\nInkorrekt formatierte Vorlagen werden ignoriert.";
DomainReliabilityAllowed.pfm_title = "Berichterstellung zur Domainzuverlässigkeit zulassen";
DomainReliabilityAllowed.pfm_description = "Wenn diese Richtlinie auf „false“ gesetzt ist, sind Berichte zur Diagnose der Domainzuverlässigkeit deaktiviert und es werden keine Daten an Google gesendet.\nWenn diese Richtlinie auf „true“ gesetzt oder nicht konfiguriert ist, gilt für Diagnoseberichte zur Domainzuverlässigkeit bei Brave das Verhalten von „MetricsReportingEnabled“ und bei Google Chrome OS das von „DeviceMetricsReportingEnabled“.";
DownloadDirectory.pfm_title = "Downloadverzeichnis festlegen";
DownloadDirectory.pfm_description = "Wenn die Richtlinie konfiguriert ist, wird das Verzeichnis festgelegt, das Chrome zum Herunterladen von Dateien verwendet. Das angegebene Verzeichnis wird unabhängig davon verwendet, ob der Nutzer selbst eines angegeben oder festgelegt hat, dass er den Downloadpfad jedes Mal selbst angeben möchte.\n\nDiese Richtlinie überschreibt die Richtlinie DefaultDownloadDirectory.\n\nIst die Richtlinie nicht konfiguriert, verwendet Chrome das Standard-Downloadverzeichnis, wobei dieses vom Nutzer geändert werden kann.\n\nUnter Google Chrome OS ist es möglich, die Richtlinie auf Google Drive-Verzeichnisse einzuschränken.\n\nHinweis: Unter https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables findest du eine Liste der Variablen, die verwendet werden können.";
DownloadRestrictions.pfm_title = "Download-Einschränkungen";
DownloadRestrictions.pfm_description = "0 - Keine besonderen Einschränkungen. Standard.\n1 - Schädliche Downloads und gefährliche Dateitypen blockieren.\n2 - Blockiert schädliche, ungewöhnliche und unerwünschte Downloads sowie gefährliche Dateitypen.\n3 - Alle Downloads blockieren.\n4 - Schädliche Downloads blockieren. Empfohlen.\nWenn diese Richtlinie konfiguriert ist, können Nutzer keine Sicherheitsentscheidungen für Downloads umgehen.\n\nIn Chrome gibt es verschiedene Arten von Warnungen zu Downloads, die sich in die folgenden Kategorien unterteilen lassen (weitere Informationen über Safe Browsing-Ergebnisse findest du unter https://support.google.com/chrome/?p=ib_download_blocked):\n\n* Schädlich, wie vom Safe Browsing-Server gemeldet\n* Ungewöhnlich oder unerwünscht, wie vom Safe Browsing-Server gemeldet\n* Gefährlicher Dateityp (z. B. alle Downloads von SWF-Dateien und manche Downloads von EXE-Dateien)\n\nJe nachdem, auf welchen Wert die Richtlinie festgelegt ist, werden manche dieser Kategorien blockiert:\n\n0: Keine besonderen Einschränkungen. Standard.\n\n1: Schädliche Dateien, die vom Safe Browsing-Server gemeldet wurden, UND alle gefährlichen Dateitypen werden blockiert. Nur für OEs/Browser/Nutzer empfohlen, die eine hohe Toleranz für falsch positive Ergebnisse haben.\n\n2: Schädliche Dateien UND ungewöhnliche oder unerwünschte Dateien, die vom Safe Browsing-Server gemeldet wurden, SOWIE alle gefährlichen Dateitypen werden blockiert. Nur für OEs/Browser/Nutzer empfohlen, die eine hohe Toleranz für falsch positive Ergebnisse haben.\n\n3: Alle Downloads werden blockiert. Nur für spezielle Anwendungsfälle empfohlen.\n\n4: Schädliche Dateien, die vom Safe Browsing-Server gemeldet wurden, werden blockiert. Gefährliche Dateitypen werden nicht blockiert. Empfohlen.\n\nHinweis: Diese Einschränkungen gelten für Downloads, die durch Webseiteninhalte ausgelöst werden, sowie für die Menüoption „Link herunterladen“. Die Einschränkungen gelten aber weder für das Herunterladen der gerade angezeigten Seite noch für das Speichern als PDF in den Druckoptionen. Weitere Informationen zu Safe Browsing findest du unter https://developers.google.com/safe-browsing.";
EditBookmarksEnabled.pfm_title = "Bearbeitung von Lesezeichen aktivieren oder deaktivieren";
EditBookmarksEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer Lesezeichen hinzufügen, entfernen, ändern oder hochladen.\n\nIst sie deaktiviert, können Nutzer keine Lesezeichen hinzufügen, entfernen, ändern oder hochladen. Sie können aber weiterhin bestehende Lesezeichen verwenden.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Nicht-Standard-Port in Kerberos-SPN einschließen";
EnableAuthNegotiatePort.pfm_description = "Wenn die Richtlinie aktiviert ist und ein Nicht-Standard-Port, d. h. ein anderer Port als 80 oder 443, eingegeben wird, wird dieser in den generierten Kerberos-SPN aufgenommen.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, umfasst der generierte Kerberos-SPN keinen Port.";
EnableExperimentalPolicies.pfm_title = "Aktiviert experimentelle Richtlinien";
EnableExperimentalPolicies.pfm_description = "Gestattet Brave das Laden experimenteller Richtlinien.\n\nWARNUNG: Experimentelle Richtlinien werden nicht unterstützt und können ohne vorherige Bekanntgabe in künftigen Versionen des Browsers geändert oder entfernt werden!\n\nDie Entwicklung einer experimentellen Richtlinie ist möglicherweise noch nicht abgeschlossen. Auch kann sie bekannte oder unbekannte Mängel haben. Sie kann unangekündigt geändert oder entfernt werden. Wenn du experimentelle Richtlinien aktivierst, besteht die Gefahr, dass du Browserdaten verlierst oder deine Sicherheit und Privatsphäre gefährdest.\n\nSteht eine Richtlinie nicht auf der Liste und wurde sie nicht offiziell veröffentlicht, dann wird ihr Wert in Beta- und stabilen Versionen ignoriert.\n\nSteht eine Richtlinie auf der Liste, dann wird ihr Wert angewendet, auch wenn sie noch nicht offiziell veröffentlicht wurde.\n\nDiese Richtlinie hat keine Auswirkung auf bereits veröffentlichte Richtlinien.";
EnableMediaRouter.pfm_title = "Google Cast aktivieren";
EnableMediaRouter.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, wird Google Cast aktiviert und kann von Nutzern über das App-Menü, Kontextmenüs von Seiten, Mediensteuerelemente auf für Google Cast optimierten Websites und das Symbol von Cast in der Symbolleiste (falls angezeigt) gestartet werden.\n\nIst die Richtlinie deaktiviert, wird Google Cast deaktiviert.";
EnableOnlineRevocationChecks.pfm_title = "OCSP/CRL-Online-Prüfungen aktivieren";
EnableOnlineRevocationChecks.pfm_description = "Wenn die Richtlinie auf \"True\" gesetzt ist, werden online OCSP/CRL-Prüfungen durchgeführt.\n\nWenn die Richtlinie auf \"False\" gesetzt oder nicht konfiguriert ist, werden von Brave keine Online-Sperrüberprüfungen in Brave 19 oder neuer durchgeführt.\n\nHinweis: OCSP/CRL-Prüfungen bieten keinen wirkungsvollen Sicherheitseffekt.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "Bestimmt, welche verwalteten Nutzer die Richtlinien „ProxyOverrideRules“ und „ProxyProvisioningDomains“ festlegen können.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Wenn diese Richtlinie auf „0“ festgelegt oder nicht konfiguriert ist, werden die Richtlinien „ProxyOverrideRules“ und „ProxyProvisioningDomains“ nur auf Nutzerebene für mit einer Organisation verknüpfte Nutzer in einem verwalteten Browser angewendet.\nWenn diese Richtlinie auf „1“ festgelegt ist, werden die Richtlinien „ProxyOverrideRules“ und „ProxyProvisioningDomains“ auf Nutzerebene angewendet, auch wenn der Nutzer nicht mit einer Organisation verknüpft ist.";
EnableUnsafeSwiftShader.pfm_title = "WebGL-Fallback für Software mit SwiftShader zulassen";
EnableUnsafeSwiftShader.pfm_description = "Diese Richtlinie legt fest, ob SwiftShader als WebGL-Fallback verwendet wird, wenn die GPU-Beschleunigung für Hardware nicht verfügbar ist.\n\nSwiftShader wurde verwendet, um WebGL auf Systemen ohne GPU-Beschleunigung wie monitorlosen Systemen oder virtuellen Maschinen zu unterstützen, wurde aber aufgrund von Sicherheitsproblemen verworfen. Ab M139 schlägt die Erstellung von WebGL-Kontexten fehl, wenn ansonsten SwiftShader verwendet worden wäre. Mit dieser Richtlinie kann der Browser oder Administrator die Einstellung der Unterstützung vorübergehend verschieben.\n\nWenn die Richtlinie aktiviert ist, wird SwiftShader als WebGL-Fallback für Software verwendet.\n\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist, kann die Erstellung des WebGL-Kontexts fehlschlagen, wenn die GPU-Beschleunigung für Hardware nicht verfügbar ist. Webseiten funktionieren möglicherweise nicht richtig, wenn sie mit Problemen beim Erstellen des WebGL-Kontexts nicht umgehen können.\n\nDiese Richtlinie ist vorübergehend und wird in Zukunft entfernt.";
EncryptedClientHelloEnabled.pfm_title = "TLS Encrypted ClientHello aktivieren";
EncryptedClientHelloEnabled.pfm_description = "Encrypted ClientHello (ECH) ist eine Erweiterung für TLS, um vertrauliche Felder von ClientHello zu verschlüsseln und den Datenschutz zu verbessern.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, folgt Brave dem standardmäßigen Einführungsprozess für ECH. Ist die Richtlinie deaktiviert, wird ECH von Brave nicht aktiviert.\n\nWenn die Funktion aktiviert ist, kann Brave je nach Serversupport, Verfügbarkeit des HTTPS-DNS-Eintrags oder Einführungsstatus ECH verwenden.\n\nECH ist ein Protokoll, das ständig weiterentwickelt wird. Die Implementierung von Brave kann sich also ändern. Diese Richtlinie ist daher eine vorübergehende Maßnahme, um die ursprüngliche experimentelle Implementierung zu steuern. Sie wird durch eine endgültige Lösung ersetzt, wenn die Entwicklung des Protokolls abgeschlossen ist.";
EnterpriseCustomLabel.pfm_title = "Benutzerdefiniertes Unternehmenslabel für ein verwaltetes Profil festlegen";
EnterpriseCustomLabel.pfm_description = "Über diese Richtlinie wird ein benutzerdefiniertes Label gesteuert, mit dem verwaltete Profile identifiziert werden können. Bei verwalteten Profilen wird dieses Label neben dem Avatar in der Symbolleiste angezeigt. Das benutzerdefinierte Label wird nicht übersetzt.\n\nWenn diese Richtlinie angewendet wird, werden alle Zeichenfolgen, die länger als 16 Zeichen sind, mit „…“ abgeschnitten. Verwende daher keine langen Namen.\n\nDiese Richtlinie kann nur als Nutzerrichtlinie konfiguriert werden.\n\nHinweis: Diese Richtlinie hat keine Auswirkungen, wenn die Richtlinie „EnterpriseProfileBadgeToolbarSettings“ auf „hide_expanded_enterprise_toolbar_badge“ (Wert 1) festgelegt ist.";
EnterpriseCustomLabelForBrowser.pfm_title = "Benutzerdefiniertes Unternehmenslabel für einen verwalteten Browser festlegen";
EnterpriseCustomLabelForBrowser.pfm_description = "Über diese Richtlinie wird ein benutzerdefiniertes Label konfiguriert, mit dem ein verwalteter Browser gekennzeichnet wird. Bei verwalteten Browsern wird dieses Label in einem Haftungsausschluss für die Verwaltung in der Fußzeile der Seite „Neuer Tab“ angezeigt. Das benutzerdefinierte Label wird nicht übersetzt.\n\nDiese Richtlinie wird nur auf verwaltete Browser angewendet. Sie hat also keine Auswirkungen auf verwaltete Nutzer von nicht verwalteten Browsern.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Ermöglicht verwalteten Erweiterungen, die Enterprise Hardware Platform API zu verwenden";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Wenn die Richtlinie auf \"True\" gesetzt ist, können Erweiterungen, die über die Unternehmensrichtlinie installiert wurden, die Enterprise Hardware Platform API verwenden.\n\nWenn die Richtlinie auf \"False\" gesetzt oder nicht konfiguriert ist, können Erweiterungen diese API nicht verwenden.\n\nHinweis: Diese Richtlinie gilt auch für Komponentenerweiterungen, zum Beispiel die Hangout Services-Erweiterung.";
EnterpriseLogoUrl.pfm_title = "URL des Unternehmenslogos für ein verwaltetes Profil";
EnterpriseLogoUrl.pfm_description = "Eine URL zu einem Bild, das als Unternehmenslogo für ein verwaltetes Profil verwendet wird. Die URL muss auf ein Bild verweisen.\n\nDiese Richtlinie kann nur als Nutzerrichtlinie konfiguriert werden.\n\nWir empfehlen, das Favicon (Beispiel: https://www.google.com/favicon.ico) oder ein Symbol mit mindestens 48 × 48 Pixeln zu verwenden.";
EnterpriseLogoUrlForBrowser.pfm_title = "URL des Unternehmenslogos für einen verwalteten Browser";
EnterpriseLogoUrlForBrowser.pfm_description = "Eine URL zu einem Bild, das als Unternehmenslogo für einen verwalteten Browser verwendet wird. Die URL muss auf ein Bild verweisen.\n\nWir empfehlen, das Favicon (Beispiel: https://www.google.com/favicon.ico) oder ein Symbol mit mindestens 48 × 48 Pixeln zu verwenden.\n\nDiese Richtlinie wird nur auf verwaltete Browser angewendet. Sie hat also keine Auswirkungen auf verwaltete Nutzer von nicht verwalteten Browsern.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Steuert die Sichtbarkeit des Unternehmensprofillogos auf der Symbolleiste";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Unternehmenslogo auf der Symbolleiste maximiert anzeigen\n1 - Maximiertes Unternehmenslogo auf der Symbolleiste ausblenden\nBei einigen Arbeitsprofilen und Profilen von Bildungseinrichtungen wird auf der Symbolleiste neben dem Avatar der Symbolleiste standardmäßig das Label „Arbeit“ oder „Schule“ angezeigt. Es wird nur angezeigt, wenn das angemeldete Konto verwaltet wird.\n\nWenn diese Richtlinie auf „hide_expanded_enterprise_toolbar_badge“ (Wert 1) gesetzt ist, wird das Unternehmenslogo für ein verwaltetes Profil auf der Symbolleiste ausgeblendet.\n\nIst diese Richtlinie nicht konfiguriert oder auf „show_expanded_enterprise_toolbar_badge“ (Wert 0) gesetzt, wird das Unternehmenslogo angezeigt.\n\nDas Label kann über die Richtlinie „EnterpriseCustomLabel“ angepasst werden.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "Beim Erstellen eines Unternehmensprofils Browserdaten standardmäßig beibehalten";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Wenn die Richtlinie aktiviert ist, ist die Option zum Beibehalten bestehender Browserdaten beim Erstellen eines Unternehmensprofils standardmäßig aktiviert.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, ist die Option zum Beibehalten bestehender Browserdaten beim Erstellen eines Unternehmensprofils standardmäßig deaktiviert.\n\nUnabhängig davon, ob die Option aktiviert oder deaktiviert ist, kann der Nutzer beim Erstellen eines Unternehmensprofils entscheiden, ob vorhandene Browserdaten beibehalten werden sollen.\n\nDiese Richtlinie hat keine Auswirkungen, wenn die Option zum Beibehalten von bestehenden Browserdaten nicht verfügbar ist. Dies ist der Fall, wenn die Trennung von Unternehmensprofilen streng durchgesetzt wird oder die Daten aus einem bereits verwalteten Profil stammen.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Einstellungen für den Suchaggregator für Unternehmen";
EnterpriseSearchAggregatorSettings.pfm_description = "Mit dieser Richtlinie können Administratoren einen bestimmten Suchaggregator für Unternehmen festlegen, der Suchvorschläge und ‑ergebnisse in der Omnibox (Adressleiste) und im Suchfeld auf der Seite „Neuer Tab“ einblendet.\n\nStandardmäßig werden Suchvorschläge für Unternehmen mit den normalen Empfehlungen von Brave kombiniert und zusammen angezeigt. Nutzer können ihre Suche explizit auf den Suchaggregator für Unternehmen beschränken, indem sie den im Feld „shortcut“ angegebene Suchbegriff mit oder ohne das Präfix „@“ (z. B. „@work“) gefolgt von einem Leerzeichen oder Tabulatorzeichen in die Omnibox eingeben. Die eingeschränkten Suchvorschläge für Unternehmen (ausgelöst durch einen Suchbegriff) wird derzeit nur in der Omnibox und nicht im Suchfeld auf der Seite „Neuer Tab“ unterstützt.\n\nDie folgenden Felder sind Pflichtfelder: „name“, „shortcut“, „search_url“ und „suggest_url“.\n\nDas Feld „name“ entspricht dem Namen der Suchmaschine, der dem Nutzer in der Adressleiste angezeigt werden soll.\n\nDas Feld „shortcut“ entspricht dem Suchbegriff, den der Nutzer eingibt, um die Suche zu starten. Das Kürzel kann einfache Wörter und Zeichen enthalten, darf jedoch keine Leerzeichen enthalten und nicht mit dem @‑Symbol beginnen. Kürzel müssen eindeutig sein.\n\nIm Feld „search_url“ wird die URL angegeben, unter der gesucht werden soll. Gib die Webadresse für die Ergebnisseite der Suchmaschine ein und verwende '{searchTerms}' als Platzhalter für die Suchanfrage.\n\nDurch das Feld „suggest_url“ wird die URL angegeben, die Suchvorschläge bereitstellt. Eine POST-Anfrage wird gesendet und die Anfrage des Nutzers wird in den POST-Parametern unter dem Schlüssel „'query'“ übergeben.\n\nDurch das Feld „icon_url“ wird die URL eines Bildes angegeben, das für die Suchvorschläge verwendet wird. Wenn dieses Feld nicht konfiguriert ist, wird ein Standardsymbol verwendet. Es wird empfohlen, ein Favicon (Beispiel: https://www.google.com/favicon.ico) zu verwenden. Unterstützte Formate für Bilddateien: JPEG, PNG und ICO.\n\nDas Feld „require_shortcut“ gibt an, ob die Adressleiste „shortcut“ erforderlich ist, um Suchvorschläge zu sehen. Wenn erforderlich, werden Vorschläge nicht im Suchfeld auf der Seite „Neuer Tab“ angezeigt, sondern weiterhin im eingeschränkten Suchmodus in der Omnibox (Adressleiste). Wenn dieses Feld nicht festgelegt ist, ist die Adressleiste „shortcut“ nicht erforderlich.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.\nUnter https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings erhältst du weitere Informationen zu Schema und Formatierung.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "Erweiterungsbasierte Warnungen beim Herunterladen bestimmter Dateitypen von bestimmten Domains deaktivieren";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Du kannst diese Richtlinie aktivieren, um ein Wörterbuch der Dateityperweiterungen mit einer entsprechenden Liste der Domains zu erstellen, für die keine erweiterungsbasierten Downloadwarnungen angezeigt werden sollen. Unternehmensadministratoren haben so die Möglichkeit, erweiterungsbasierte Downloadwarnungen für Dateien zu blockieren, die einer Domain in der Liste zugewiesen sind. Ist die Erweiterung „jnlp“ beispielsweise website1.com zugewiesen, sehen Nutzer keine Warnung, wenn sie „jnlp“-Dateien von website1.com herunterladen. Es wird aber eine angezeigt, wenn sie „jnlp“-Dateien von website2.com herunterladen.\n\nFür Dateien mit Dateierweiterungen, die nach dieser Richtlinie für Domains festgelegt wurden, werden weiter Sicherheitswarnungen angezeigt, die nicht auf Dateierweiterungen beruhen. Das können z. B. Warnungen beim Herunterladen von gemischten Inhalten und Safe Browsing-Warnungen sein.\n\nWenn du diese Richtlinie deaktivierst oder nicht konfigurierst, werden für Dateitypen, bei denen erweiterungsbasierte Downloadwarnungen ausgelöst werden, Warnungen für den Nutzer angezeigt.\n\nWenn du diese Richtlinie aktivierst:\n\n* muss das URL-Muster entsprechend https://chromeenterprise.google/policies/url-patterns/ formatiert sein.\n\n* muss die Dateityperweiterung in Kleinbuchstaben (ASCII) angegeben werden. Das vorangestellte Trennzeichen muss beim Angeben der Dateityperweiterung ausgelassen werden. Gib also z. B. „jnlp“ und nicht „.jnlp“ an.\n\nBeispiel:\n\nDurch den folgenden Beispielwert würden erweiterungsbasierte Downloadwarnungen bei „exe“- und „jnlp“-Erweiterungen von *.beispiel.de-Domains und von „swf“-Dateien von allen Domains blockiert. Nutzer sehen aber entsprechende Warnungen, wenn sie versuchen, „exe“- und „jnlp“-Dateien von einer anderen Domain herunterzuladen. Auf „swf“-Dateien trifft das nicht zu.\n\n[\n  { \"file_extension\": \"jnlp\", \"domains\": [\"beispiel.de\"] },\n  { \"file_extension\": \"exe\", \"domains\": [\"beispiel.de\"] },\n  { \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nWichtig: Im Beispiel oben werden erweiterungsbasierte Downloadwarnungen für „.swf“-Dateien domainübergreifend blockiert. Im Fall von gefährlichen Dateierweiterungen ist es aus Sicherheitsgründen jedoch nicht empfehlenswert, die entsprechenden Warnungen für alle Domains zu blockieren. Das Beispiel soll nur zeigen, dass dies im Grunde möglich ist.\n\nWenn diese Richtlinie zusammen mit „DownloadRestrictions“ aktiviert ist, haben die Ausnahmen von erweiterungsbasierten Warnungen beim Herunterladen, die durch diese Richtlinie festgelegt werden, Vorrang vor einer Einstellung in „DownloadRestrictions“, die gefährliche Dateitypen blockieren würde. Die in dieser Richtlinie festgelegten Ausnahmen gelten nur für das Verhalten „Gefährliche Dateitypen blockieren“, das durch die Werte 1 und 2 von „DownloadRestrictions“ festgelegt wird.\n\nWenn diese Richtlinie beispielsweise eine Ausnahme für Downloads von „exe“-Dateien von website1.com vorsieht und „DownloadRestrictions“ so konfiguriert ist, dass schädliche Downloads und gefährliche Dateitypen blockiert werden (Wert 1), werden Downloads von „exe“-Dateien von website1.com von der blockbasierten Dateityperweiterung ausgenommen, aber weiterhin blockiert, wenn sie schädlich sind.\n\nWeitere Informationen zur Richtlinie „DownloadRestrictions“ findest du unter https://chromeenterprise.google/policies/?policy=DownloadRestrictions.\nUnter https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings erhältst du weitere Informationen zu Schema und Formatierung.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Ausdrücklich erlaubte Netzwerkports";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - Port 554 (Blockierung kann bis 15.10.2021 aufgehoben werden)\n10080 - Port 10080 (Blockierung kann bis 01.04.2022 aufgehoben werden)\n6566 - Port 6566 (Blockierung kann bis 15.10.2021 aufgehoben werden)\n989 - Port 989 (Blockierung kann bis 01.02.2022 aufgehoben werden)\n990 - Port 990 (Blockierung kann bis 01.02.2022 aufgehoben werden)\nEs gibt eine in Brave integrierte Liste beschränkter Ports. Verbindungen zu diesen Ports schlagen fehl. Mit dieser Einstellung wird das Umgehen dieser Liste erlaubt. Der Wert ist eine durch Kommas getrennte Liste von null oder mehr Ports, an denen ausgehende Verbindungen erlaubt werden.\n\nPorts sind beschränkt, um zu verhindern, dass Brave als Vektor für die Ausnutzung verschiedener Netzwerk-Sicherheitslücken verwendet wird. Wird diese Richtlinie konfiguriert, kann dein Netzwerk dadurch dem Risiko von Angriffen ausgesetzt sein. Diese Richtlinie dient der vorübergehenden Problemumgehung bei Fehlern mit dem Code „ERR_UNSAFE_PORT“, die während der Migration eines Dienstes auftreten, wenn der Dienst an einem gesperrten Port läuft und an einen Standardport migriert wird (z. B. Port 80 oder 443).\n\nSchädliche Websites können schnell erkennen, ob und für welche Ports diese Richtlinie konfiguriert ist, und diese Informationen für gezielte Angriffe nutzen.\n\nFür jeden Port in Google Chrome ist ein Datum angegeben, bis zu dem die Blockierung aufgehoben werden kann. Nach diesem Datum wird der Port unabhängig von dieser Einstellung beschränkt.\n\nWenn dieser Wert leer gelassen oder nicht konfiguriert wird, werden alle beschränkten Ports blockiert. Wenn gültige und ungültige Werte vorhanden sind, werden die gültigen angewendet.\n\nDiese Richtlinie überschreibt die Befehlszeilenoption „--explicitly-allowed-ports“.";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Sperrliste von Identitätsanbietern, die nicht die erweiterbare Enterprise-SSO für den Browser verwenden können";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Alle Identitätsanbieter\nmicrosoft - Microsoft®-Cloud-Identitätsanbieter\nokta - Okta®-Cloud-Identitätsanbieter\nping - Ping®-Cloud-Identitätsanbieter\nDeaktiviere die Einmalanmeldung (SSO) über Extensible Enterprise SSO für die aufgeführten Identitätsanbieter.\n\nWenn du den Wert „'all'“ hinzufügst, werden alle unterstützten Identitätsanbieter für die Einmalanmeldung deaktiviert.\n\nWenn du den Wert „'microsoft'“ hinzufügst, wird die Unterstützung für die Einmalanmeldung für den Microsoft®-Cloud-Identitätsanbieter in Chrome deaktiviert.\n\nWenn du diese Richtlinie nicht konfigurierst, werden alle Identitätsanbieter aktiviert, die von Brave unterstützt werden.\n\nFür Identitätsanbieter, die in Brave aktiviert und von Admins auf dem Gerät konfiguriert sind, können Nutzer, die sich über diesen Identitätsanbieter einmal in einer Anwendung anmelden, die Extensible Enterprise SSO unterstützt, über diesen Identitätsanbieter automatisch in Web-Properties angemeldet werden. Informationen zu den Authentifizierungsdaten des Nutzers werden bei jedem Authentifizierungsereignis an den Cloud-Identitätsanbieter des Nutzers gesendet.\n\nHinweise:\n\nBrave unterstützt nicht die Einmalanmeldung über Extensible Enterprise SSO im Inkognito- oder Gastmodus.\n\nBrave unterstützt die Einmalanmeldung über Extensible Enterprise SSO nur für die folgenden Identitätsanbieter: Microsoft, Okta und Ping.\n\nDiese Funktion ist unter macOS 10.15 und höher verfügbar.";
ExtensionAllowedTypes.pfm_title = "Typen von Erweiterungen bzw. Apps, die installiert werden können";
ExtensionAllowedTypes.pfm_description = "extension - Erweiterung\ntheme - Design\nuser_script - Nutzerskript\nhosted_app - Gehostete App\nlegacy_packaged_app - Gepackte Legacy-App\nplatform_app - Plattform-App\nMit dieser Richtlinie wird gesteuert, welche Apps und Erweiterungen in Brave installiert werden dürfen, mit welchen Hosts sie interagieren können und welche Einschränkungen für den Laufzeitzugriff gelten.\n\nWenn die Richtlinie nicht konfiguriert ist, gelten für die zulässigen Erweiterungs- und App-Typen keine Einschränkungen.\n\nErweiterungen und Apps, deren Typ nicht auf der Liste steht, werden nicht installiert. Jeder Wert sollte mit einem der folgenden Strings angegeben werden:\n\n* „extension“\n\n* „theme“\n\n* „user_script“\n\n* „hosted_app“\n\n* „legacy_packaged_app“\n\n* „platform_app“\n\nWeitere Informationen zu diesen Typen sind der Dokumentation zu den Brave-Erweiterungen zu entnehmen.\n\nVor Version 75 wird die Angabe mehrerer durch Kommas getrennter Erweiterungs-IDs nicht unterstützt und wird deswegen übersprungen. Der verbleibende Teil der Richtlinie wird trotzdem angewendet.\n\nHinweis: Diese Richtlinie betrifft auch solche Erweiterungen und Apps, die über die Richtlinie „ExtensionInstallForcelist“ zwangsweise installiert werden.\n\nHinweis: Diese Richtlinie gilt nur für Plattformen, die Erweiterungen unterstützen.";
ExtensionDeveloperModeSettings.pfm_title = "Verfügbarkeit des Entwicklermodus auf der Seite „Erweiterungen“ steuern";
ExtensionDeveloperModeSettings.pfm_description = "0 - Verwendung des Entwicklermodus auf der Seite „Erweiterungen“ zulassen\n1 - Verwendung des Entwicklermodus auf der Seite „Erweiterungen“ nicht zulassen\nHiermit wird festgelegt, ob Nutzer den Entwicklermodus unter chrome://extensions aktivieren können.\n\nWenn die Richtlinie nicht konfiguriert ist, können Nutzer den Entwicklermodus auf der Seite „Erweiterungen“ aktivieren, es sei denn, die DeveloperToolsAvailability-Richtlinie ist auf DeveloperToolsDisallowed (2) festgelegt.\nWenn die Richtlinie auf „Allow“ (0) gesetzt ist, können Nutzer den Entwicklermodus auf der Seite „Erweiterungen“ aktivieren.\nWenn die Richtlinie auf „Disallow“ (1) gesetzt ist, können Nutzer den Entwicklermodus auf der Seite „Erweiterungen“ nicht aktivieren.\n\nWenn diese Richtlinie konfiguriert ist, kann DeveloperToolsAvailability den Entwicklermodus nicht mehr über die Seite „Erweiterungen“ steuern.\n\nHinweis: Diese Richtlinie gilt nur für Plattformen, die Erweiterungen unterstützen.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Eine Liste von Ursprüngen konfigurieren, von denen die Verlängerung der Hintergrundlebensdauer der verbundenen Erweiterungen gewährt wird.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "Erweiterungen, die mit einem dieser Ursprünge verbunden sind, werden ausgeführt, solange der Port verbunden ist.\n\nWenn die Richtlinie nicht konfiguriert ist, werden die Standardwerte verwendet. Im Folgenden sind App-Ursprünge aufgeführt, die SDKs bereitstellen, die bekanntermaßen keine Möglichkeit bieten, eine geschlossene Verbindung zu einem früheren Zustand neu zu starten:\n– Smart Card Connector\n– Citrix Receiver (stabil, Betaversion, Sicherung)\n– VMware Horizon (stabil, Betaversion)\n\nWenn diese Richtlinie festgelegt ist, wird die Liste der Standardwerte um die neu konfigurierten Werte erweitert. Sowohl von den Standardeinstellungen als auch den von der Richtlinie vorgegebenen Einträgen wird die Ausnahme für die verbundenen Erweiterungen gewährt, solange der Port verbunden ist.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Per Richtlinie installierte Erweiterungen aktivieren, die die Einstellungen für die standardmäßige Suche oder Seite „Neuer Tab“ überschreiben";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob per Richtlinie installierte Erweiterungen (mit erzwungener Installation oder als Empfehlung), die die Einstellungen für die standardmäßige Suchmaschine oder Seite „Neuer Tab“ überschreiben, in wenig vertrauenswürdigen Umgebungen zulässig sind.\n\nDiese Richtlinie gilt nur für wenig vertrauenswürdige Umgebungen (z. B. Geräte, auf denen Richtlinien lokal ohne Domain- oder Cloudverwaltung konfiguriert sind). Umgebungen mit hoher Vertrauenswürdigkeit sind nicht betroffen:\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nicht bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.\n\nPer Richtlinie installierte Erweiterungen, die die Einstellungen für die standardmäßige Suchmaschine oder Seite „Neuer Tab“ überschreiben, bleiben in diesen Umgebungen mit hoher Vertrauenswürdigkeit aktiviert.\n\nWenn diese Richtlinie aktiviert ist, können in Brave per Richtlinie installierte Erweiterungen, die die Einstellungen für die standardmäßige Suchmaschine oder Seite „Neuer Tab“ überschreiben, in wenig vertrauenswürdigen Umgebungen installiert und aktiviert bleiben.\n\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist, verhindert Brave, dass per Richtlinie installierte Erweiterungen, die die Einstellungen für die standardmäßige Suchmaschine oder Seite „Neuer Tab“ überschreiben, in wenig vertrauenswürdigen Umgebungen installiert werden. Wenn sie bereits installiert sind, werden sie entfernt.\n\nWenn eine betroffene Erweiterung dahingehend aktualisiert wird, dass diese Einstellungen nicht mehr überschrieben werden, wird sie von Brave innerhalb von 7 Tagen automatisch installiert.\n\nDiese Richtlinie ist vorübergehend verfügbar und wird in einer zukünftigen Version entfernt.";
ExtensionInstallAllowlist.pfm_title = "Aus der Sperrliste auszuschließende Erweiterungs-IDs";
ExtensionInstallAllowlist.pfm_description = "Wenn die Richtlinie konfiguriert ist, wird festgelegt, welche Erweiterungen nicht von der Sperrliste betroffen sind.\n\nDer Wert „*“ in der Sperrliste gibt an, dass alle Erweiterungen gesperrt sind und Nutzer nur die in der Zulassungsliste angegebenen Erweiterungen installieren können.\n\nStandardmäßig können alle Erweiterungen installiert werden. Wurden jedoch alle Erweiterungen durch eine Richtlinie auf die Sperrliste gesetzt, kann diese Richtlinie mithilfe der Zulassungsliste außer Kraft gesetzt werden.\n\nHinweis: Diese Richtlinie gilt nur für Plattformen, die Erweiterungen unterstützen.";
ExtensionInstallBlocklist.pfm_title = "Erweiterungs-IDs, die der Nutzer nicht installieren darf (\"*\" für alle)";
ExtensionInstallBlocklist.pfm_description = "Mit dieser Richtlinie kannst du festlegen, welche Erweiterungen Nutzer NICHT installieren dürfen. Bereits installierte Erweiterungen, die gesperrt sind, werden deaktiviert und Nutzer haben keine Möglichkeit, sie zu aktivieren. Sollte eine aufgrund der Sperrliste deaktivierte Erweiterung aus der Liste entfernt werden, wird sie automatisch wieder aktiviert.\n\nDer Wert „*“ in der Sperrliste gibt an, dass alle Erweiterungen standardmäßig blockiert sind. Erweiterungen, die ausdrücklich in der Zulassungsliste aufgeführt sind, sind zulässig, wenn sie signiert (verpackt) sind. Alle entpackten Erweiterungen sind blockiert.\n\nWenn diese Richtlinie nicht konfiguriert ist, kann der Nutzer jede Erweiterung in Brave installieren.\n\nHinweis: Diese Richtlinie gilt nur für Plattformen, die Erweiterungen unterstützen.";
ExtensionInstallForcelist.pfm_title = "Ohne Nutzereingriff zu installierende Erweiterungs-/App-IDs und Aktualisierungs-URLs";
ExtensionInstallForcelist.pfm_description = "Wenn die Richtlinie konfiguriert ist, wird eine Liste von Apps und Erweiterungen festgelegt, die automatisch installiert werden, also ohne Interaktion des Nutzers, und die vom Nutzer über die Brave-Benutzeroberfläche weder deinstalliert noch deaktiviert werden können. Berechtigungen, auch für die Erweiterungs-APIs „enterprise.deviceAttributes“ und „enterprise.platformKeys“, werden automatisch im Hintergrund gewährt. Diese beiden APIs stehen bei Apps oder Erweiterungen ohne erzwungene Installation nicht zur Verfügung.\n\nBrave versucht zwar zu verhindern, dass Nutzer diese Erweiterungen deinstallieren, aber bei einigen Betriebssystemen kann Brave nicht verhindern, dass Erweiterungen extern geändert werden. Diese Schutzmaßnahme funktioniert also nicht immer.\n\nWenn die Richtlinie nicht konfiguriert ist, werden Apps und Erweiterungen nicht automatisch installiert und Nutzer können jede App oder Erweiterung in Brave deinstallieren.\n\nDiese Richtlinie hat Vorrang vor der Richtlinie „ExtensionInstallBlocklist“. Wenn eine App oder Erweiterung mit erzwungener Installation aus dieser Liste entfernt wird, wird sie von Brave automatisch deinstalliert.\n\nNutzer können den Quellcode jeder Erweiterung mithilfe von Entwicklertools ändern. Danach funktioniert die entsprechende Erweiterung eventuell nicht mehr. Wenn du das verhindern möchtest, kannst du die Richtlinie „DeveloperToolsDisabled“ festlegen.\n\nJedes Listenelement der Richtlinie ist ein String mit einer Erweiterungs-ID und einer optionalen Update-URL, die durch ein Semikolon (;) getrennt sind. Die Erweiterungs-ID ist der String mit 32 Buchstaben, den du beispielsweise im Entwicklermodus unter chrome://extensions siehst. Die Update-URL sollte, sofern festgelegt, auf ein XML-Dokument mit einem Update-Manifest verweisen (https://developer.chrome.com/extensions/autoupdate). Außerdem sollte sie einem der folgenden Schemas entsprechen: http, https oder file. Standardmäßig kommt die Update-URL des Chrome Web Store zum Einsatz. Die in dieser Richtlinie festgelegte Update-URL wird nur für die Erstinstallation verwendet. In nachfolgenden Updates der Erweiterung kommt die Update-URL zum Einsatz, die im Manifest der Erweiterung angegeben wurde. Die Update-URL für nachfolgende Updates kann mit der Richtlinie „ExtensionSettings“ überschrieben werden (siehe http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy).\n\nBei Microsoft® Windows®-Instanzen kann die Installation von Apps und Erweiterungen, die nicht aus dem Chrome Web Store stammen, nur auf solchen Instanzen erzwungen werden, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nBei macOS-Instanzen kann die Installation von Apps und Erweiterungen, die nicht aus dem Chrome Web Store stammen, nur auf solchen Instanzen erzwungen werden, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.\n\nHinweis: Diese Richtlinie gilt nicht für den Inkognitomodus. Informationen zum Hosting von Erweiterungen findest du unter https://developer.chrome.com/extensions/hosting.\n\nHinweis: Diese Richtlinie gilt nur für Plattformen, die Erweiterungen unterstützen.";
ExtensionInstallSources.pfm_title = "URL-Muster für die Installation von Erweiterungen, Apps und Nutzerskripten von";
ExtensionInstallSources.pfm_description = "Wenn diese Richtlinie konfiguriert ist, wird festgelegt, über welche URLs Erweiterungen, Apps und Designs installiert werden dürfen. Vor Brave-Version 21 konnten Nutzer auf den Link zu einer CRX-Datei klicken und die Datei nach einigen Hinweisen in Brave installieren. In allen nachfolgenden Versionen müssen solche Dateien zuerst heruntergeladen und dann auf die Seite „Einstellungen“ in Brave gezogen werden. Anhand dieser Einstellung kann bei bestimmten URLs der alte, einfachere Installationsvorgang angewendet werden.\n\nBei den Einträgen in dieser Liste handelt es sich um auf die Erweiterung angepasste Übereinstimmungsmuster (siehe https://developer.chrome.com/extensions/match_patterns). Wenn eine URL mit einem Eintrag in dieser Liste übereinstimmt, können Nutzer eine Datei ganz einfach über diese URL installieren. Sowohl der Speicherort der CRX-Datei als auch die Seite, über die der Download gestartet wird, also die verweisende URL, müssen durch diese Muster zugelassen sein.\n\n„ExtensionInstallBlocklist“ hat Vorrang vor dieser Richtlinie. Eine Erweiterung auf der Sperrliste wird folglich nicht installiert, auch wenn sie von einer Website auf dieser Liste stammt.\n\nHinweis: Diese Richtlinie gilt nur für Plattformen, die Erweiterungen unterstützen.";
ExtensionInstallTypeBlocklist.pfm_title = "Sperrliste für Installationstypen von Erweiterungen";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Das Laden von Erweiterungen über die Befehlszeile wird verhindert\nÜber die Sperrliste wird festgelegt, welche Installationstypen für Erweiterungen unzulässig sind.\n\nWenn du „command_line“ festlegst, wird das Laden von Erweiterungen über die Befehlszeile blockiert.";
ExtensionReviewPromptsEnabled.pfm_title = "Rezensionsaufforderungen und Bewertungslinks für Erweiterungen steuern";
ExtensionReviewPromptsEnabled.pfm_description = "Legt fest, ob native Rezensionsaufforderungen und Bewertungslinks (z. B. „Bewerten“) für installierte Chrome-Erweiterungen auf allen Chrome-Benutzeroberflächen verfügbar sind.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, sehen Nutzer möglicherweise native Einstiegspunkte, um berechtigte Erweiterungen in der Symbolleiste, in Kontextmenüs und auf der Seite zur Verwaltung von Erweiterungen (chrome://extensions) zu rezensieren und zu bewerten.\n\nWenn diese Richtlinie deaktiviert ist, werden alle nativen Rezensionsaufforderungen und alle Bewertungslinks unterdrückt und sind nicht verfügbar.";
ExtensionSettings.pfm_title = "Verwaltungseinstellungen für Erweiterungen";
ExtensionSettings.pfm_description = "Mit dieser Richtlinie werden Einstellungen zur Erweiterungsverwaltung für Brave festgelegt, darunter Einstellungen, die von anderen auf Erweiterungen bezogenen Richtlinien geregelt werden.\n\nMit dieser Richtlinie wird eine Erweiterungs-ID oder eine Update-URL nur ihrer bestimmten Einstellung zugeordnet. Eine Standardkonfiguration kann für die Spezial-ID „\"*\"“ festgelegt werden, die auf alle Erweiterungen angewendet wird, für die keine benutzerdefinierte Konfiguration in dieser Richtlinie festgelegt ist.\n\nDiese Richtlinie kann die Konfiguration einzelner Erweiterungen aus älteren Richtlinien überschreiben.\n\nErweiterungsspezifische Einstellungen pro ID aus „ExtensionInstallForcelist“, „ExtensionInstallAllowlist“, „ExtensionInstallBlocklist“ oder „ExtensionSettings“ übernehmen nur „installation_mode“ und „update_url“ aus den Standardwerten von \"*\". Es werden keine anderen Attribute übernommen. Bei einer Update-URL wird die Konfiguration auf alle Erweiterungen mit genau der im Manifest dieser Erweiterung angegebenen Update-URL angewendet (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy). Wenn das Flag „override_update_url“ auf „true“ gesetzt ist, wird die Erweiterung über die in der Richtlinie „ExtensionInstallForcelist“ oder im Feld „update_url“ dieser Richtlinie angegebene Update-URL installiert und aktualisiert. Das Flag „override_update_url“ wird ignoriert, wenn „update_url“ eine URL für den Chrome Web Store ist.\n\nAb Brave-Version 154 wird durch die Anwendung von „runtime_blocked_hosts“ auf eine Erweiterung mit der Berechtigung „debugger“ die Funktion „chrome.debugger.attach()“ für alle Ziele vollständig deaktiviert.\n\nBei Microsoft® Windows®-Instanzen kann die Installation von Apps und Erweiterungen, die nicht aus dem Chrome Web Store stammen, nur auf solchen Instanzen erzwungen werden, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nBei macOS-Instanzen kann die Installation von Apps und Erweiterungen, die nicht aus dem Chrome Web Store stammen, nur auf solchen Instanzen erzwungen werden, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.\n\nHinweis: Diese Richtlinie gilt nur für Plattformen, die Erweiterungen unterstützen.\nUnter https://chromeenterprise.google/policies/?policy=ExtensionSettings erhältst du weitere Informationen zu Schema und Formatierung.";
ExtensionUnpublishedAvailability.pfm_title = "Verfügbarkeit von Erweiterungen steuern, die nicht im Chrome Web Store veröffentlicht sind";
ExtensionUnpublishedAvailability.pfm_description = "0 - Nicht veröffentlichte Erweiterungen zulassen\n1 - Erweiterungen, deren Veröffentlichung zurückgezogen wurde, deaktivieren\nWenn diese Richtlinie aktiviert ist, werden Erweiterungen, die nicht im Chrome Web Store veröffentlicht sind, für Brave deaktiviert.\nDiese Richtlinie gilt nur für Erweiterungen, die über den Chrome Web Store installiert und aktualisiert werden.\n\nErweiterungen aus anderen Quellen, z. B. entpackte Erweiterungen, die im Entwicklermodus installiert wurden, oder Erweiterungen, die über die Befehlszeile installiert wurden, sind nicht betroffen.\nAuch Erweiterungen mit erzwungener Installation, die selbst gehostet sind, sowie alle an eine bestimmte Version angepinnten Erweiterungen, sind nicht betroffen.\n\nIst die Richtlinie auf AllowUnpublished (0) gesetzt oder nicht konfiguriert, sind nicht im Chrome Web Store veröffentlichte Erweiterungen zulässig.\nWenn die Richtlinie auf DisableUnpublished (1) gesetzt ist, sind nicht im Chrome Web Store veröffentlichte Erweiterungen deaktiviert.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Kästchen für \"Immer öffnen\" auf Bestätigungsaufforderung anzeigen";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Mit dieser Richtlinie kann festgelegt werden, ob das Kästchen für \"Immer öffnen\" auf Bestätigungsaufforderungen beim Start externer Protokolle angezeigt werden soll. Hiermit kann der Nutzer angeben, ob ein Link immer mit dem gewählten externen Protokoll geöffnet werden soll.\n\n     Wenn diese Richtlinie auf \"true\" gesetzt oder nicht konfiguriert ist und eine Bestätigungsaufforderung für ein externes Protokoll angezeigt wird, kann der Nutzer \"Immer zulassen\" auswählen und das Protokoll auf dieser Website so in Zukunft ohne die Bestätigung öffnen.\n\n     Wird sie auf \"false\" gesetzt, wird das Kästchen für \"Immer zulassen\" nicht angezeigt und der Nutzer jedes Mal, wenn ein externes Protokoll aufgerufen wird, zur Bestätigung aufgefordert.";
FeedbackSurveysEnabled.pfm_title = "Gibt an, ob Nutzern produktinterne Brave-Umfragen angezeigt werden.";
FeedbackSurveysEnabled.pfm_description = "Mit produktinternen Umfragen für Brave wird Nutzerfeedback zum Browser erfasst. Umfrageantworten sind nicht mit Nutzerkonten verknüpft.\nIst diese Richtlinie aktiviert oder nicht konfiguriert, können Nutzern produktinterne Umfragen angezeigt werden.\nIst diese Richtlinie deaktiviert, werden Nutzern keine produktinternen Umfragen angezeigt.\n\nDiese Richtlinie ist nicht wirksam, wenn „MetricsReportingEnabled“ deaktiviert ist. Dadurch werden auch produktinterne Umfragen deaktiviert.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Fetch-Keepalive-Dauer beim Herunterfahren";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Steuert die Dauer in Sekunden, die für Keepalive-Anfragen beim Schließen des Browsers zugelassen ist.\n\nWenn die Richtlinie festgelegt ist, kann das Schließen des Browsers während der angegebenen Dauer in Sekunden blockiert werden, um Keepalive-Anfragen zu verarbeiten (https://fetch.spec.whatwg.org/#request-keepalive-flag).\n\nDer Standardwert (0) bedeutet, dass diese Funktion deaktiviert ist.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Aufrufen von APIs für Datei- oder Verzeichnisauswahl ohne vorherige Nutzergeste zulassen";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "Aus Sicherheitsgründen erfordert das Aufrufen der Web-APIs „showOpenFilePicker()“, „showSaveFilePicker()“ und „showDirectoryPicker()“ eine vorherige Nutzergeste („vorübergehende Aktivierung“), andernfalls tritt ein Fehler auf.\n\nWenn diese Richtlinie konfiguriert ist, können Administratoren Ursprünge festlegen, von denen diese APIs ohne vorherige Nutzergeste aufgerufen werden können.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/. * ist kein akzeptierter Wert für diese Richtlinie.\n\nWenn diese Richtlinie nicht konfiguriert ist, muss vor dem Aufrufen dieser APIs unabhängig vom Ursprung eine Nutzergeste ausgeführt werden.";
FileSystemReadAskForUrls.pfm_title = "Lesezugriff über die File System API auf diesen Websites erlauben";
FileSystemReadAskForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Nutzer um Lesezugriff auf Dateien oder Verzeichnisse im Dateisystem des Host-Betriebssystems über die File System API bitten dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultFileSystemReadGuardSetting“ für alle Websites, sofern konfiguriert. Ist dies nicht der Fall, werden die persönlichen Einstellungen des Nutzers verwendet.\n\nURL‑Muster dürfen nicht im Konflikt mit „FileSystemReadBlockedForUrls“ stehen. Keine Richtlinie hat Vorrang, falls eine URL mit beiden übereinstimmt.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
FileSystemReadBlockedForUrls.pfm_title = "Lesezugriff über die File System API auf diesen Websites blockieren";
FileSystemReadBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Nutzer nicht um Lesezugriff auf Dateien oder Verzeichnisse im Dateisystem des Host-Betriebssystems über die File System API bitten dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultFileSystemReadGuardSetting“ für alle Websites, sofern konfiguriert. Falls dies nicht der Fall ist, werden die persönlichen Einstellungen des Nutzers verwendet.\n\nURL‑Muster dürfen nicht im Konflikt mit „FileSystemReadAskForUrls“ stehen. Keine Richtlinie hat Vorrang, falls eine URL mit beiden übereinstimmt.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
FileSystemWriteAskForUrls.pfm_title = "Schreibzugriff auf Dateien und Verzeichnisse auf diesen Websites erlauben";
FileSystemWriteAskForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Nutzer um Schreibzugriff auf Dateien oder Verzeichnisse im Dateisystem des Host-Betriebssystems bitten dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultFileSystemWriteGuardSetting“ für alle Websites, sofern konfiguriert. Ist dies nicht der Fall, werden die persönlichen Einstellungen des Nutzers verwendet.\n\nURL‑Muster dürfen nicht im Konflikt mit „FileSystemWriteBlockedForUrls“ stehen. Keine Richtlinie hat Vorrang, falls eine URL mit beiden übereinstimmt.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
FileSystemWriteBlockedForUrls.pfm_title = "Schreibzugriff auf Dateien und Verzeichnisse auf diesen Websites blockieren";
FileSystemWriteBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Nutzer nicht um Schreibzugriff auf Dateien oder Verzeichnisse im Dateisystem des Host-Betriebssystems bitten dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultFileSystemWriteGuardSetting“ für alle Websites, sofern konfiguriert. Ist dies nicht der Fall, werden die persönlichen Einstellungen des Nutzers verwendet.\n\nURL‑Muster dürfen nicht im Konflikt mit „FileSystemWriteAskForUrls“ stehen. Keine Richtlinie hat Vorrang, falls eine URL mit beiden übereinstimmt.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
ForceEphemeralProfiles.pfm_title = "Sitzungsspezifisches Profil";
ForceEphemeralProfiles.pfm_description = "Bei Aktivierung erzwingt diese Richtlinie die Nutzung des flüchtigen Modus. Falls diese Richtlinie als BS-Richtlinie angegeben wird (wie GPO unter Windows), gilt sie für jedes Profil im System. Wird sie hingegen als Cloud-Richtlinie festgelegt, gilt sie nur für ein bei einem verwalteten Konto angemeldetes Profil.\n\nIn diesem Modus werden die Profildaten nur für die Dauer der Nutzersitzung auf der Festplatte behalten. Elemente wie der Browserverlauf, Erweiterungen und ihre Daten, Webdaten wie Cookies und Webdatenbanken werden nach dem Schließen des Browsers nicht beibehalten. Dies hindert den Nutzer jedoch nicht daran, Daten manuell auf die Festplatte herunterzuladen, Seiten zu speichern oder zu drucken.\n\nWenn der Nutzer die Synchronisierung aktiviert hat, werden alle diese Daten wie bei regulären Profilen in seinem Synchronisierungsprofil beibehalten. Der Inkognitomodus ist ebenfalls verfügbar, sofern er nicht durch die Richtlinie explizit deaktiviert wird.\n\nFalls die Richtlinie deaktiviert oder nicht eingestellt wird, werden bei einer Anmeldung reguläre Profile erstellt.";
ForceForegroundPriorityForAllTabs.pfm_title = "Vordergrundpriorität für alle Tabs erzwingen";
ForceForegroundPriorityForAllTabs.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob im Hintergrund ausgeführte Webinhalte mit Vordergrundpriorität ausgeführt werden müssen.\n\nStandardmäßig optimiert der Browser Ressourcen, indem er Inhalte von im Hintergrund ausgeführten Tabs weniger priorisiert. Wenn du diese Richtlinie aktivierst, wird dieses Verhalten überschrieben und Tabs im Hintergrund werden genauso geplant wie der aktive Tab.\n\nBeachte, dass das Erzwingen der Vordergrundpriorität für im Hintergrund ausgeführte Inhalte die Reaktionsfähigkeit des aktiven Tabs leicht beeinträchtigen kann.\n\nWenn diese Richtlinie aktiviert ist, werden alle Webinhalte mit Vordergrundpriorität ausgeführt, unabhängig von ihrem Sichtbarkeitsstatus.\n\nWenn diese Richtlinie deaktiviert oder nicht konfiguriert ist, bestimmt der Browser die Priorität anhand der Standardheuristik (z. B. indem Inhalte weniger priorisiert werden, die nicht sichtbar sind, keinen Ton wiedergeben oder nicht an Videoanrufen beteiligt sind).";
ForceForegroundPriorityForUrls.pfm_title = "Vordergrundpriorität für bestimmte URLs erzwingen";
ForceForegroundPriorityForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste von URL-Mustern festlegen. Für im Hintergrund ausgeführte Webinhalte, die mit diesen Mustern übereinstimmen, wird die Vordergrundpriorität erzwungen.\n\nWenn die Richtlinie „ForceForegroundPriorityForAllTabs“ aktiviert ist, wird diese Liste ignoriert, da für alle Tabs die Vordergrundpriorität erzwungen wird.\n\nWenn „ForceForegroundPriorityForAllTabs“ deaktiviert oder nicht konfiguriert ist, wird die Vordergrundpriorität nur für Inhalte erzwungen, die mit den Mustern in dieser Liste übereinstimmen.\n\nWeitere Informationen zu gültigen URL-Mustern findest du unter https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nWenn diese Liste leer oder nicht konfiguriert ist, wird für keine im Hintergrund ausgeführten Inhalte die Vordergrundpriorität erzwungen.";
ForceGoogleSafeSearch.pfm_title = "Google SafeSearch erzwingen";
ForceGoogleSafeSearch.pfm_description = "Bei aktivierter Richtlinie ist SafeSearch in der Google Suche immer aktiv und Nutzer können diese Einstellung nicht ändern.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, wird SafeSearch in der Google Suche nicht erzwungen.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "Steuert, ob unload-Event-Handler deaktiviert werden können.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "unload-Event-Handler werden nicht mehr unterstützt. Ob sie ausgelöst werden, hängt von unload-Permissions-Policy ab. Derzeit sind sie standardmäßig durch die Richtlinie zugelassen. Zukünftig werden sie schrittweise standardmäßig deaktiviert. Websites müssen sie dann mithilfe von Permissions-Policy-Headern explizit aktivieren. Mit dieser Unternehmensrichtlinie kann diese schrittweise Einstellung deaktiviert werden. Dabei wird die Aktivierung als Standardeinstellung erzwungen.\n\nSeiten können auf unload-Event-Handler angewiesen sein, um Daten zu speichern oder dem Server das Ende einer Nutzersitzung zu signalisieren. Dies wird nicht empfohlen, da es unzuverlässig ist und die Leistung durch die Blockierung von BackForwardCache beeinträchtigt. Es gibt zwar empfohlene Alternativen, allerdings wird das unload-Ereignis schon seit Langem verwendet. Daher wird es von einigen Anwendungen möglicherweise noch immer genutzt.\n\nWenn die Richtlinie auf „false“ gesetzt oder nicht konfiguriert ist, werden unload-Event-Handler nach Beginn der Einstellung schrittweise nicht mehr unterstützt und Websites, für die der Permissions-Policy-Header nicht festgelegt ist, stellen das Auslösen von „unload“-Ereignissen ein.\n\nIst diese Richtlinie dagegen auf „true“ gesetzt, funktionieren unload-Event-Handler standardmäßig weiter.\n\nHINWEIS: Diese Richtlinie hatte in M117 den falsch dokumentierten Standardwert „true“. Das unload-Ereignis hat sich in M117 nicht geändert und wird in M117 auch nicht geändert, sodass diese Richtlinie in dieser Version keine Auswirkungen hat.\n";
ForceYouTubeRestrict.pfm_title = "Minimalen eingeschränkten Modus in YouTube erzwingen";
ForceYouTubeRestrict.pfm_description = "0 - Eingeschränkten Modus in YouTube nicht erzwingen\n1 - Mindestens den moderaten eingeschränkten Modus in YouTube erzwingen\n2 - Strikt eingeschränkten Modus in YouTube erzwingen\nWenn die Richtlinie konfiguriert ist, wird ein minimaler eingeschränkter Modus in YouTube erzwungen und es wird verhindert, dass Nutzer einen weniger eingeschränkten Modus auswählen. Wird diese Richtlinie\n\n* auf „Strikt“ festgelegt, ist der strikt eingeschränkte Modus in YouTube immer aktiv.\n\n* auf „Moderat“ festgelegt, kann der Nutzer in YouTube nur den moderaten eingeschränkten Modus und den strikt eingeschränkten Modus auswählen, jedoch den eingeschränkten Modus nicht deaktivieren.\n\n* auf „Aus“ festgelegt oder nicht konfiguriert, wird der eingeschränkte Modus in YouTube nicht durch Chrome erzwungen. Der eingeschränkte Modus wird jedoch möglicherweise trotzdem durch externe Richtlinien wie YouTube-Richtlinien erzwungen.";
ForcedLanguages.pfm_title = "Inhalt und Reihenfolge der bevorzugten Sprachen konfigurieren";
ForcedLanguages.pfm_description = "Mit dieser Richtlinie können Administratoren die Reihenfolge der bevorzugten Sprachen in den Einstellungen von Brave konfigurieren.\n\nDie Reihenfolge der Liste entspricht derjenigen im Bereich „Ordne Sprachen in der gewünschten Reihenfolge an“ unter chrome://settings/languages. Nutzer können Sprachen, die durch die Richtlinie festgelegt sind, nicht entfernen oder neu anordnen, sie haben aber die Möglichkeit, unter den durch diese Richtlinie vorgegebenen Sprachen weitere Sprachen hinzuzufügen. Darüber hinaus haben Nutzer die volle Kontrolle über die Sprache der Benutzeroberfläche und die Übersetzungs- und Rechtschreibprüfungseinstellungen des Browsers, sofern diese nicht durch andere Richtlinien zwingend vorgegeben sind.\n\nWenn die Richtlinie nicht konfiguriert ist, können Nutzer die gesamte Liste bevorzugter Sprachen beliebig anpassen.";
GeminiActOnWebAllowedForURLs.pfm_title = "Gemini-App-Integrationen erlauben, Aktionen direkt auf bestimmten Websites auszuführen";
GeminiActOnWebAllowedForURLs.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL-Mustern festlegen, die angeben, auf welchen Websites Gemini-App-Integrationen direkte Aktionen auf Webseiten ausführen dürfen.\n\nURLs, die weder mit der Zulassungs- noch mit der Sperrliste übereinstimmen, verwenden GeminiActOnWebSettings.\n\nURLs, die sowohl mit der Zulassungs- als auch mit der Sperrliste übereinstimmen, sind zulässig.\n\nWeitere Informationen zu gültigen URL-Mustern findest du unter https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebBlockedForURLs.pfm_title = "Gemini-App-Integrationen blockieren, damit sie keine Aktionen direkt auf bestimmten Websites ausführen können";
GeminiActOnWebBlockedForURLs.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL-Mustern festlegen, die angeben, auf welchen Websites Gemini-App-Integrationen keine direkten Aktionen auf Webseiten ausführen dürfen.\n\nURLs, die weder mit der Zulassungs- noch mit der Sperrliste übereinstimmen, verwenden GeminiActOnWebSettings.\n\nURLs, die sowohl mit der Zulassungs- als auch mit der Sperrliste übereinstimmen, sind zulässig.\n\nWeitere Informationen zu gültigen URL-Mustern findest du unter https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebSettings.pfm_title = "Ermöglicht es Gemini-App-Integrationen, Aktionen direkt auf Webseiten auszuführen";
GeminiActOnWebSettings.pfm_description = "0 - Zulassen, dass die Gemini App Aktionen auf Webseiten ausführt.\n1 - Nicht zulassen, dass die Gemini App Aktionen auf Webseiten ausführt.\nDiese Richtlinie legt fest, ob die Gemini App im Namen des Nutzers Aktionen auf Webseiten ausführen darf.\n\n0 / nicht festgelegt = Die Gemini App darf Aktionen auf Webseiten ausführen.\n\n1 = Die Gemini App darf keine Aktionen auf Webseiten ausführen.\n\nDiese Richtlinie hat keine Auswirkungen, wenn die Gemini App deaktiviert ist. Beispielsweise kann die Gemini App durch die Richtlinie „GeminiSettings“ deaktiviert werden.\n\nUnter https://support.google.com/chrome/a/answer/16291696 findest du weitere Informationen zu Gemini in Chrome.\n\nGemini kann nicht in allen Ländern und Sprachen Aktionen ausführen. Auch wenn du diese Richtlinie festlegst, kann die Funktion möglicherweise nicht aktiviert werden, da sie von der Verfügbarkeit abhängig ist. Weitere Informationen zur Einführung der Funktion findest du in den Versionshinweisen für Chrome Enterprise: https://support.google.com/chrome/a/answer/7679408?";
GeminiSettings.pfm_title = "Einstellungen für die Gemini-Integration";
GeminiSettings.pfm_description = "0 - Gemini-Integrationen zulassen.\n1 - Gemini-Integrationen nicht zulassen.\nMit dieser Einstellung werden Gemini-App-Integrationen zugelassen.\n\n0 = Gemini-Integration ist für Nutzer verfügbar.\n\n1 = Gemini-Integration ist für Nutzer nicht verfügbar.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nWeitere Informationen findest du im Hilfeartikel unter https://support.google.com/chrome/a?p=gemini_in_chrome.";
GeminiSparkSettings.pfm_title = "Ermöglicht Gemini Spark, sich mit Brave zu verbinden und das automatische Browsen über Gemini in Chrome zu verwenden";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark darf sich mit dem automatischen Browsen in Brave verbinden und es verwenden.\n1 - Gemini Spark darf sich nicht mit dem automatischen Browsen in Brave verbinden oder es verwenden.\nLegt fest, ob der Gemini Spark-KI-Agent eine Verbindung zu Brave herstellen und das automatische Browsen verwenden darf. Gemini Spark ist für Ihre Organisation möglicherweise nicht verfügbar.\n\n0 = Gemini Spark darf sich mit dem automatischen Browsen in Brave verbinden und es verwenden\n\n1 = Gemini Spark darf sich nicht mit dem automatischen Browsen in Brave verbinden und es nicht verwenden\n\nWarnung: Wenn du Gemini Spark erlaubst, sich mit Brave zu verbinden und das automatische Browsen zu verwenden, kann der Gemini Spark-KI-Agent autonome Aktionen mit mehreren Schritten auf Brave-Clients über die aktive Browsersitzung ausführen. Dies birgt erhebliche Sicherheitsrisiken, darunter Risiken im Zusammenhang mit Anmeldedaten, dem im lokalen Netzwerk eingehenden Traffic und dem Verlust kontextsensitiver Signale. Vorhandene Verwaltungs- und Sicherheitsmechanismen werden möglicherweise nicht berücksichtigt.\n\nAdministratoren sollten das Netzwerkbedrohungsmodell sowie die Compliance- und Datenschutzrichtlinien ihrer Organisation sorgfältig prüfen, bevor sie diese Funktion aktivieren.\n\nDiese Richtlinie hat keine Auswirkungen, wenn die Google Gemini App oder die Richtlinien für das automatische Browsen in Brave deaktiviert sind. Beispielsweise kann die Google Gemini App durch die Richtlinie „GeminiSettings“ deaktiviert werden. Weitere Informationen zu Google Gemini in Brave findest du unter https://support.google.com/chrome/a?p=gemini_in_chrome.\n\nAutomatisches Browsen in Brave und Gemini Spark sind nicht in allen Ländern und Sprachen verfügbar. Auch wenn du für diese Richtlinie „0 – Aktiviert“ festlegst, kann die Funktion möglicherweise nicht aktiviert werden, da sie von der Verfügbarkeit abhängig ist. Weitere Informationen zur Einführung der Funktion findest du in den Versionshinweisen für Chrome Enterprise: https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Einstellungen für lokales Foundation Model für generative KI";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Modell wird automatisch heruntergeladen\n1 - Modell nicht herunterladen\nMit dieser Richtlinie kann konfiguriert werden, wie Brave das Foundation Model für generative KI herunterlädt und lokal für die Inferenz verwendet.\n\nWenn die Richtlinie auf „Zulässig (0)“ gesetzt oder nicht konfiguriert ist, wird das Modell automatisch heruntergeladen und für die Inferenz verwendet.\n\nIst die Richtlinie auf „Deaktiviert (1)“ gesetzt, wird das Modell nicht heruntergeladen und das vorhandene Modell (sofern bereits heruntergeladen) gelöscht.\n\nAuf Desktop-Plattformen kann das Herunterladen von Modellen auch deaktiviert werden, indem „ComponentUpdatesEnabled“ auf „false“ gesetzt wird.";
GeolocationBlockedForUrls.pfm_title = "Standortbestimmung auf diesen Websites blockieren";
GeolocationBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, die Websites angeben, die nicht auf den Standort des Nutzers zugreifen dürfen und auch keine Nutzerberechtigung dafür anfordern können.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt die Einstellung „DefaultGeolocationSetting“ für alle Websites, sofern sie festgelegt ist. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig.";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "Globales HTTP-Auth-Cache aktivieren";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Diese Richtlinie konfiguriert einen einzelnen globalen Profil-Cache mit HTTP-Server-Auth-Anmeldedaten.\n\nWenn diese Richtlinie nicht konfiguriert oder deaktiviert ist, wendet der Browser das Standardverhalten Cross-Site-Auth an. Dieses umfasst die HTTP-Server-Anmeldedaten durch die Top-Level-Website. Wenn also zwei Websites Ressourcen derselben Authentifizierungs-Domain verwenden, müssen die Anmeldedaten unabhängig voneinander im Kontext beider Websites bereitgestellt werden. Im Cache gespeicherte Proxy-Anmeldedaten werden für alle Websites wiederverwendet.\n\nWenn die Richtlinie aktiviert ist, werden im Kontext einer Website eingegebene HTTP-Auth-Anmeldedaten automatisch auch im Kontext einer anderen verwendet.\n\nDas Aktivieren dieser Richtlinie lässt einige Arten von Cross-Site-Angriffen offen. Nutzer können außerdem durch die Eingaben in den HTTP-Auth-Cache mit in URLs eingebetteten Anmeldedaten über mehrere Websites erfasst werden, selbst wenn sie keine Cookies zulassen.\n\nDiese Richtlinie soll Unternehmen anhand des vergangenen Verhaltens die Möglichkeit geben, ihre Log‑in-Abläufe zu aktualisieren. Sie wird demnächst entfernt.";
GoogleSearchSidePanelEnabled.pfm_title = "Google Search Side Panel aktivieren";
GoogleSearchSidePanelEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, ist die Google Search Side Panel auf allen Webseiten zulässig.\n\nIst sie deaktiviert, ist die Google Search Side Panel auf keiner Webseite verfügbar.\n\nZugehörige Funktionen mit generativer KI sind für Konten von Bildungseinrichtungen oder Unternehmenskonten nicht verfügbar.";
HSTSPolicyBypassList.pfm_title = "Liste der Namen, die vom HSTS-Richtliniencheck ausgenommen sind";
HSTSPolicyBypassList.pfm_description = "Wenn die Richtlinie konfiguriert ist, wird eine Liste mit Hostnamen angegeben, die vorab geladene HSTS-Upgrades von http auf https umgehen.\n\nFür diese Richtlinie sind nur Single-Label-Hostnamen zulässig und sie gilt nur für „statische“ HSTS-Preloaded-Eingaben (beispielsweise \"app\", \"new\", \"search\", \"play\"). Diese Richtlinie verhindert keine HSTS-Upgrades für Server, die diese „dynamisch“ mit einem Strict-Transport-Security-Antwortheader anfragen.\n\nBereitgestellte Hostnamen müssen kanonisiert werden: Alle IDNs müssen in ihr A-Label-Format konvertiert und alle ASCII-Buchstaben kleingeschrieben werden. Diese Richtlinie gilt nur für die angegebenen Single-Label-Hostnamen, aber nicht für Subdomains der angegebenen Namen.";
HappyEyeballsV3Enabled.pfm_title = "Happy Eyeballs V3-Algorithmus verwenden";
HappyEyeballsV3Enabled.pfm_description = "Durch diese Funktion kann der Happy Eyeballs V3-Algorithmus Verbindungsversuche ausführen. Weitere Informationen findest du unter https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3.\n\nWenn die Richtlinie aktiviert ist, verwendet Brave den Happy Eyeballs V3-Algorithmus für Verbindungsversuche.\n\nWenn die Richtlinie deaktiviert ist, wird der Happy Eyeballs V3-Algorithmus deaktiviert.\n\nWenn die Richtlinie nicht konfiguriert ist, aktiviert oder deaktiviert Brave den Happy Eyeballs V3-Algorithmus basierend auf chrome://flags/#happy-eyeballs-v3.\n\nDiese Richtlinie unterstützt die dynamische Aktualisierung.\n\nSie ist eine vorübergehende Maßnahme und wird aus künftigen Versionen von Brave entfernt.";
HardwareAccelerationModeEnabled.pfm_title = "Grafikbeschleunigung verwenden, falls verfügbar";
HardwareAccelerationModeEnabled.pfm_description = "Wenn diese Richtlinie aktiviert oder nicht konfiguriert ist, wird die Grafikbeschleunigung aktiviert (sofern verfügbar).\n\nIst die Richtlinie deaktiviert, wird die Grafikbeschleunigung deaktiviert.";
HeadlessMode.pfm_title = "Verwendung des monitorlosen Modus verwalten";
HeadlessMode.pfm_description = "1 - Verwendung des monitorlosen Modus erlauben\n2 - Verwendung des monitorlosen Modus nicht erlauben\nWenn die Richtlinie auf Enabled gesetzt oder nicht konfiguriert ist, kann der monitorlose Modus verwendet werden. Ist sie auf Disabled gesetzt ist, kann der monitorlose Modus nicht verwendet werden.";
HelpMeWriteSettings.pfm_title = "Einstellungen für „Formuliere für mich“";
HelpMeWriteSettings.pfm_description = "0 - „Formuliere für mich“ zulassen und KI‑Modelle verbessern.\n1 - „Formuliere für mich“ zulassen, ohne KI‑Modelle zu verbessern.\n2 - „Formuliere für mich“ nicht zulassen.\n„Formuliere für mich“ ist ein KI‑basierter Schreibassistent für Kurzinhalte im Web. Vorgeschlagene Inhalte basieren auf den vom Nutzer eingegebenen Prompts und dem Inhalt auf der Webseite.\n\n„0“ = Die Funktion darf verwendet werden und Google darf relevante Daten nutzen, um seine KI‑Modelle zu verbessern. Relevante Daten können je nach Funktion Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftliches Feedback sein. Sie werden möglicherweise auch manuell geprüft, um KI‑Modelle zu verbessern. „0“ ist der Standardwert, außer in den unten angegebenen Fällen.\n\n„1“ = Die Funktion darf verwendet werden, Google darf aber keine Modelle mithilfe von Nutzerinhalten (einschließlich Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftlichen Feedbacks) verbessern. „1“ ist der Standardwert für Unternehmensnutzer, die über die Google Admin console verwaltet werden, sowie für Konten von Bildungseinrichtungen, die über Google Workspace verwaltet werden.\n\n„2“ = Die Funktion darf nicht verwendet werden.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
HideWebStoreIcon.pfm_title = "Web Store auf der \"Neuer Tab\"-Seite und im App Launcher ausblenden";
HideWebStoreIcon.pfm_description = "Hiermit werden die Chrome Web Store App und der zugehörige Fußzeilenlink auf der \"Neuer Tab\"-Seite und im App Launcher von Google Chrome OS ausgeblendet.\n\nIst diese Richtlinie auf \"true\" gesetzt, werden die Symbole ausgeblendet.\n\nIst diese Richtlinie auf \"false\" gesetzt oder nicht konfiguriert, sind die Symbole sichtbar.";
HighEfficiencyModeEnabled.pfm_title = "Modus für hohe Effizienz aktivieren";
HighEfficiencyModeEnabled.pfm_description = "Mit dieser Richtlinie wird die Einstellung „Modus für hohe Effizienz“ aktiviert oder deaktiviert. Die Einstellung bewirkt, dass Tabs nach einer bestimmten Zeit im Hintergrund geschlossen werden, um Arbeitsspeicher freizugeben.\nWenn die Richtlinie nicht konfiguriert ist, kann der Endnutzer diese Einstellung unter chrome://settings/performance verwalten.\n";
HistoryClustersVisible.pfm_title = "Ansicht des Chrome-Verlaufs in Seitengruppen";
HistoryClustersVisible.pfm_description = "Diese Richtlinie legt die Sichtbarkeit der in Seitengruppen eingeteilten Chrome-Verlaufsseite fest.\n\nWenn die Richtlinie aktiviert ist, ist die in Gruppen eingeteilte Chrome-Verlaufsseite unter chrome://history/grouped sichtbar.\n\nWenn die Richtlinie deaktiviert ist, ist die in Gruppen eingeteilte Chrome-Verlaufsseite unter chrome://history/grouped nicht sichtbar.\n\nWenn die Richtlinie nicht konfiguriert ist, ist die in Gruppen eingeteilte Chrome-Verlaufsseite standardmäßig unter chrome://history/grouped sichtbar.\n\nHinweis: Wenn die Richtlinie ComponentUpdatesEnabled deaktiviert, HistoryClustersVisible jedoch aktiviert oder nicht konfiguriert ist, ist die in Gruppen eingeteilte Chrome-Verlaufsseite trotzdem unter chrome://history/grouped verfügbar, auch wenn sie möglicherweise weniger relevant für den Nutzer ist.\n";
HistorySearchSettings.pfm_title = "Einstellungen für die KI‑basierte Verlaufssuche";
HistorySearchSettings.pfm_description = "0 - KI‑basierte Verlaufssuche zulassen und KI‑Modelle verbessern.\n1 - KI‑basierte Verlaufssuche zulassen, ohne KI‑Modelle zu verbessern.\n2 - KI‑basierte Verlaufssuche nicht zulassen.\nDie KI‑basierte Verlaufssuche ist eine Funktion, mit der Nutzer auch anhand von Seiteninhalten statt nur anhand von Seitentitel und URL ihren Browserverlauf durchsuchen und generierte Antworten erhalten können.\n\n„0“ = Die Funktion darf verwendet werden und Google darf relevante Daten nutzen, um seine KI‑Modelle zu verbessern. Relevante Daten können je nach Funktion Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftliches Feedback sein. Sie werden möglicherweise auch manuell geprüft, um KI‑Modelle zu verbessern. „0“ ist der Standardwert, außer in den unten angegebenen Fällen.\n\n„1“ = Die Funktion darf verwendet werden, Google darf aber keine Modelle mithilfe von Nutzerinhalten (einschließlich Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftlichen Feedbacks) verbessern. „1“ ist der Standardwert für Unternehmensnutzer, die über die Google Admin console verwaltet werden, sowie für Konten von Bildungseinrichtungen, die über Google Workspace verwaltet werden.\n\n„2“ = Die Funktion darf nicht verwendet werden.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
HomepageIsNewTabPage.pfm_title = "\"Neuer Tab\"-Seite als Startseite verwenden";
HomepageIsNewTabPage.pfm_description = "Wenn die Richtlinie aktiviert ist, wird die „Neuer Tab“-Seite als Startseite des Nutzers verwendet und die Startseiten-URL wird ignoriert. Ist diese Richtlinie deaktiviert, wird die „Neuer Tab“-Seite nie als Startseite verwendet, es sei denn, die Startseiten-URL des Nutzers ist chrome://newtab.\n\nWenn du diese Richtlinie konfigurierst, können Nutzer den Typ ihrer Startseite in Brave nicht ändern. Wenn die Richtlinie nicht konfiguriert ist, können Nutzer auswählen, ob die „Neuer Tab“-Seite als Startseite verwendet werden soll.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
HomepageLocation.pfm_title = "Startseiten-URL";
HomepageLocation.pfm_description = "Ist die Richtlinie konfiguriert, wird die standardmäßige Startseiten-URL in Brave festgelegt. Die Startseite wird über den Button „Startseite“ geöffnet. Auf dem Computer werden die Seiten, die beim Hochfahren geöffnet werden, über die „RestoreOnStartup“-Richtlinien gesteuert.\n\nWenn die „Neuer Tab“-Seite durch den Nutzer oder „HomepageIsNewTabPage“ als Startseite festgelegt ist, hat diese Richtlinie keine Auswirkung.\n\nDie URL benötigt ein Standardschema wie http://beispiel.de oder https://beispiel.de. Wenn diese Richtlinie konfiguriert ist, können Nutzer ihre Startseiten-URL in Brave nicht ändern.\n\nSind weder „HomepageLocation“ noch „HomepageIsNewTabPage“ konfiguriert, können Nutzer ihre Startseite auswählen.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
HttpAllowlist.pfm_title = "HTTP-Zulassungsliste";
HttpAllowlist.pfm_description = "Mit dieser Richtlinie kann eine Liste mit Hostnamen oder Hostnamenmustern (z. B. „[*.]beispiel.de“) angelegt werden, die nicht auf HTTPS umgestellt werden und für die kein Fehler-Interstitial angezeigt wird, wenn der HTTPS-First-Modus aktiviert ist. Organisationen können diese Richtlinie verwenden, um den Zugriff auf Server aufrechtzuerhalten, die HTTPS nicht unterstützen, ohne HTTPS-Umstellungen und/oder den HTTPS-First-Modus zu deaktivieren.\n\nBereitgestellte Hostnamen müssen kanonisiert werden: Alle IDNs müssen in ihr A-Label-Format konvertiert und alle ASCII-Buchstaben kleingeschrieben werden.\n\nAlles einschließende Platzhalter für den Host (z. B. „*“ oder „[*]“) sind nicht zulässig. Stattdessen sollten der HTTPS-First-Modus und HTTPS-Umstellungen explizit über die jeweiligen Richtlinien deaktiviert werden.\n\nHinweis: Diese Richtlinie gilt nicht für HSTS-Umstellungen.";
HttpHeaderInjection.pfm_title = "HTTP-Header-Einschleusung für bestimmte URL-Muster konfigurieren";
HttpHeaderInjection.pfm_description = "Mit dieser Richtlinie lässt sich eine Liste von Regeln definieren, um benutzerdefinierte HTTP-Header in Webanfragen einzuschleusen, die mit bestimmten URL-Mustern übereinstimmen. Header, die durch diese Richtlinie festgelegt werden, haben Vorrang vor Headern, die ursprünglich bereits in der Anfrage vorhanden waren, sowie vor Änderungen, die von Nutzern oder Erweiterungen vorgenommen werden.\n\nEin häufiger Anwendungsfall für diese Richtlinie ist die Durchsetzung von Mandanten-Zugriffskontrollen durch das Einschleusen benutzerdefinierter Header (z. B. X-Tenant-ID).\n\nDie Richtlinie akzeptiert eine Liste von Regeln. Jede Regel enthält:\n\n* patterns: Eine Liste von URL-Mustern, die abgeglichen werden sollen. Wie ein URL-Muster formatiert wird, erfährst du unter https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\n* headers: Eine Liste von Objekten, die die einzufügenden Header repräsentieren. Jedes Objekt enthält:\n\n* name: Den Namen des einzuschleusenden Headers.\n\n* value: Den Wert des einzuschleusenden Headers.\n\nWenn mehrere Regeln auf eine Anfrage zutreffen, werden Header aus allen übereinstimmenden Regeln angewendet. Falls mehrere Header denselben Namen haben, wird der Header mit dem spezifischsten URL-Muster angewendet. Sind die Muster gleich spezifisch, wird der Header angewendet, der zuletzt in der Liste erscheint.\n\nHeadernamen müssen RFC 2616 (https://www.rfc-editor.org/rfc/rfc2616) entsprechen. Headerwerte dürfen keine NUL-, CR- oder LF-Zeichen enthalten. Einzelne Header dürfen eine Größe von 8 KB nicht überschreiten. Ungültige Header und URL-Muster werden ignoriert.\n\nDiese Richtlinie ist auf insgesamt 500 URL-Muster über alle Regeln hinweg begrenzt. Jede Regel darf maximal 20 Header enthalten. Muster und Header, die diese Grenzwerte überschreiten, werden ignoriert.\n\nHinweis: Wenn ein URL-Muster mit unverschlüsselten Schemas übereinstimmt (http://, ws:// oder kein Schema), werden die konfigurierten Header möglicherweise als Nur-Text über einen unverschlüsselten Kanal übertragen und können von Netzwerkbeobachtern eingesehen werden. Beschränke URL-Muster auf verschlüsselte Schemas (https:// oder wss://), um vertrauliche oder identifizierende Headerwerte zu schützen.\nUnter https://chromeenterprise.google/policies/?policy=HttpHeaderInjection erhältst du weitere Informationen zu Schema und Formatierung.";
HttpsOnlyMode.pfm_title = "Aktivieren des Nur-HTTPS-Modus erlauben";
HttpsOnlyMode.pfm_description = "allowed - Einstellung für den Nur-HTTPS-Modus von Nutzern nicht einschränken\ndisallowed - Nur-HTTPS-Modus deaktivieren\nforce_enabled - Nur-HTTPS-Modus im strikten Modus aktivieren\nforce_balanced_enabled - Nur-HTTPS-Modus im ausgewogenen Modus aktivieren\nMit dieser Richtlinie wird festgelegt, ob Nutzer den Nur-HTTPS-Modus („Immer verschlüsselte Verbindungen verwenden“) in den Einstellungen aktivieren können. Über den Nur-HTTPS-Modus werden alle Aufrufe von Websites auf HTTPS umgestellt.\n\nWenn diese Einstellung nicht konfiguriert oder auf „Zugelassen“ festgelegt ist, dürfen Nutzer den Nur-HTTPS-Modus aktivieren.\n\nIst sie auf „Nicht zugelassen“ festgelegt, wird der Nur-HTTPS-Modus deaktiviert.\n\nWenn diese Einstellung auf „force_enabled“ festgelegt ist, wird der Nur-HTTPS-Modus im strikten Modus aktiviert.\n\nIst sie auf „force_balanced_enabled“ festgelegt, wird der Nur-HTTPS-Modus im ausgewogenen Modus aktiviert.\n\n„force_enabled“ wird ab M112 unterstützt, „force_balanced_enabled“ ab M129.\n\n„force_enabled“ und „force_balanced_enabled“ können Nutzern ebenfalls empfohlen werden.\nDer Nur-HTTPS-Modus wird anfänglich auf „Strikt“ oder „Ausgewogen“ festgelegt, aber Nutzer dürfen ihn ändern.\n\nWird die Richtlinie auf einen Wert festgelegt, der von der Chrome-Version, die diese Richtlinie erhält, nicht unterstützt wird, wird in Chrome standardmäßig die Einstellung auf „Zugelassen“ gesetzt.\n\nDie separate Richtlinie „HttpAllowlist“ kann verwendet werden, um bestimmte Hostnamen oder Hostnamenmuster von der Aktualisierung auf HTTPS durch diese Funktion auszuschließen.";
HttpsUpgradesEnabled.pfm_title = "Automatische HTTPS-Upgrades aktivieren";
HttpsUpgradesEnabled.pfm_description = "Brave versucht nach Möglichkeit, einige Navigationen von HTTP auf HTTPS zu aktualisieren. Diese Richtlinie kann verwendet werden, um dieses Verhalten zu deaktivieren. Wenn sie auf „true“ gesetzt oder nicht konfiguriert ist, ist diese Funktion standardmäßig aktiviert.\n\nDie separate Richtlinie HttpAllowlist kann verwendet werden, um bestimmte Hostnamen oder Hostnamenmuster von der Aktualisierung auf HTTPS durch diese Funktion auszuschließen.\n\nWeitere Informationen findest du in der Richtlinie HttpsOnlyMode.";
IPv6ReachabilityOverrideEnabled.pfm_title = "Überschreiben des IPv6-Erreichbarkeitstests aktivieren";
IPv6ReachabilityOverrideEnabled.pfm_description = "Wenn die Richtlinie auf „true“ gesetzt ist, wird der IPv6-Erreichbarkeitstest überschrieben. Das bedeutet, dass das System beim Auflösen von Hostnamen immer AAAA-Einträge abfragt. Sie gilt für alle Nutzer und alle Oberflächen auf diesem Gerät.\n\nWenn die Richtlinie auf „false“ gesetzt oder nicht konfiguriert ist, wird der IPv6-Erreichbarkeitstest nicht überschrieben.\nDas System fragt AAAA-Einträge nur dann ab, wenn es für einen globalen IPv6-Host erreichbar ist.";
IdleDetectionAllowedForUrls.pfm_title = "Zulässige Websites für die Inaktivitätserkennung";
IdleDetectionAllowedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL‑Mustern festlegen, durch die angegeben wird, welche Websites die Idle Detection API verwenden dürfen, ohne den Nutzer vorher fragen zu müssen. Einträge auf der Sperrliste haben eine höhere Priorität als Einträge auf der Zulassungsliste, die wiederum eine höhere Priorität als der konfigurierte Standardwert haben.\n\nAusführliche Informationen zu gültigen Website-URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig. Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL‑Musters ignoriert.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird für alle Websites der globale Standardwert verwendet, der durch die Richtlinie „DefaultIdleDetectionSetting“ (Standardeinstellung für die Inaktivitätserkennung) konfiguriert wird, sofern diese konfiguriert ist, oder andernfalls durch die persönliche Konfiguration des Nutzers.";
IdleDetectionBlockedForUrls.pfm_title = "Für die Inaktivitätserkennung blockierte Websites";
IdleDetectionBlockedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites die Idle Detection API nicht verwenden dürfen.\n\nAusführliche Informationen zu gültigen Website-URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig. Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL‑Musters ignoriert.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird für alle Websites der globale Standardwert verwendet, der durch die Richtlinie „DefaultIdleDetectionSetting“ (Standardeinstellung für die Inaktivitätserkennung) konfiguriert wird, sofern diese konfiguriert ist, oder andernfalls durch die persönliche Konfiguration des Nutzers.";
IdleTimeout.pfm_title = "Verzögerung vor Ausführung von Aktionen bei Inaktivität";
IdleTimeout.pfm_description = "Löst eine Aktion aus, wenn der Computer inaktiv ist.\n\nWenn diese Richtlinie konfiguriert ist, gibt sie die Dauer ohne Nutzereingabe (in Minuten) vor, nach der der Browser Aktionen ausführt, die in der Richtlinie IdleTimeoutActions konfiguriert sind.\n\nIst die Richtlinie nicht konfiguriert, wird keine Aktion ausgeführt.\n\nDer kleinstmögliche Grenzwert beträgt 1 Minute.\n\nDie Nutzereingabe wird von den Betriebssystem‑APIs definiert. Hierzu zählen beispielsweise das Bewegen der Maus oder die Eingabe über die Tastatur.";
IdleTimeoutActions.pfm_title = "Aktionen, die ausgeführt werden sollen, wenn der Computer inaktiv ist";
IdleTimeoutActions.pfm_description = "close_browsers - Browser schließen\nshow_profile_picker - Profilauswahl anzeigen\nclear_browsing_history - Browserverlauf löschen\nclear_download_history - Download-Verlauf löschen\nclear_cookies_and_other_site_data - Cookies und andere Websitedaten löschen\nclear_cached_images_and_files - Im Cache gespeicherte Bilder und Dateien löschen\nclear_password_signin - Passwortanmeldung löschen\nclear_autofill - Autofill-Daten löschen\nclear_site_settings - Website-Einstellungen löschen\nclear_hosted_app_data - Daten aus gehosteten Apps löschen\nreload_pages - Seiten neu laden\nsign_out - Abmelden\nclose_tabs - Tabs schließen\nListe der Aktionen, die ausgeführt werden sollen, wenn das Zeitlimit in der Richtlinie „IdleTimeout“ erreicht ist.\n\nWarnung: Das Festlegen dieser Richtlinie kann sich auf lokale private Daten auswirken und diese dauerhaft entfernen. Wir empfehlen, die Einstellungen vor der Bereitstellung zu testen, um das versehentliche Löschen von privaten Daten zu verhindern.\n\nWenn die Richtlinie „IdleTimeout“ nicht konfiguriert ist, hat diese Richtlinie keine Auswirkungen.\n\nWird das Zeitlimit in der Richtlinie „IdleTimeout“ erreicht, werden die in dieser Richtlinie konfigurierten Aktionen im Browser ausgeführt.\n\nWenn diese Richtlinie leer oder nicht konfiguriert ist, hat die Richtlinie „IdleTimeout“ keine Auswirkungen.\n\nUnterstützte Aktionen:\n\n„close_browsers“: Alle Browserfenster und PWAs für dieses Profil werden geschlossen. Diese Aktion wird auf Android- und iOS‑Geräten nicht unterstützt.\n\n„close_tabs“: Alle geöffneten Tabs in geöffneten Fenstern werden geschlossen. Diese Aktion wird nur auf iOS‑Geräten unterstützt.\n\n„show_profile_picker“: Das Fenster mit der Profilauswahl wird angezeigt. Diese Aktion wird auf Android- und iOS‑Geräten nicht unterstützt.\n\n„sign_out“: Der aktuell angemeldete Nutzer wird abgemeldet. Diese Aktion wird nur auf iOS‑Geräten unterstützt.\n\n„clear_browsing_history“, „clear_download_history“, „clear_cookies_and_other_site_data“, „clear_cached_images_and_files“, „clear_password_signing“, „clear_autofill“, „clear_site_settings“, „clear_hosted_app_data“: Die entsprechenden Browserdaten werden gelöscht. Weitere Informationen findest du in der Richtlinie „ClearBrowsingDataOnExitList“. Auf iOS‑Geräten werden folgende Typen unterstützt: „clear_browsing_history“, „clear_cookies_and_other_site_data“, „clear_cached_images_and_files“, „clear_password_signing“ und „clear_autofill“'\n\n„reload_pages“: Alle Webseiten werden neu geladen. Bei einigen Seiten wird der Nutzer eventuell zuerst um Bestätigung gebeten. Diese Funktion wird auf iOS‑Geräten nicht unterstützt.\n\nDer Nutzer bleibt in seinem Google-Konto angemeldet, wenn über „clear_cookies_and_other_site_data“ Cookies gelöscht werden.\n\nWenn du „clear_browsing_history“, „clear_password_signing“, „clear_autofill“ und „clear_site_settings“ festlegst, wird die Synchronisierung für die entsprechenden Datentypen deaktiviert, sofern weder „Chrome Sync“ durch Festlegen der Richtlinie „SyncDisabled“ noch „BrowserSignin“ deaktiviert ist.";
ImagesAllowedForUrls.pfm_title = "Bilder auf diesen Websites zulassen";
ImagesAllowedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Bilder anzeigen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultImagesSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig.\n\nBeachte, dass diese Richtlinie unter Android zuvor fälschlicherweise aktiviert war, sie von Android aber nie vollständig unterstützt wurde.";
ImagesBlockedForUrls.pfm_title = "Bilder auf diesen Websites blockieren";
ImagesBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, durch die angegeben wird, welche Websites keine Bilder anzeigen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultImagesSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\n Ausführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig.\n\n Beachte, dass diese Richtlinie unter Android zuvor fälschlicherweise aktiviert war, sie von Android aber nie vollständig unterstützt wurde.";
ImportAutofillFormData.pfm_title = "Bei erstmaliger Ausführung Autofill-Formulardaten aus Standardbrowser importieren";
ImportAutofillFormData.pfm_description = "Wenn die Richtlinie aktiviert ist, werden bei der ersten Ausführung Autofill-Kreditkartendaten aus dem Standardbrowser importiert. Ist die Richtlinie deaktiviert oder nicht konfiguriert, werden bei der ersten Ausführung keine Autofill-Formulardaten importiert.\n\nNutzer können einen Importdialog öffnen. Das Kästchen für die Autofill-Formulardaten wird je nach Konfiguration dieser Richtlinie aktiviert oder deaktiviert.";
ImportBookmarks.pfm_title = "Lesezeichen bei erster Ausführung aus Standardbrowser importieren";
ImportBookmarks.pfm_description = "Wenn die Richtlinie aktiviert ist, werden Lesezeichen bei der ersten Ausführung aus dem vorherigen Standardbrowser importiert. Ist die Richtlinie deaktiviert oder nicht konfiguriert, werden bei der ersten Ausführung keine Lesezeichen importiert.\n\nNutzer können einen Importdialog öffnen. Das Kästchen für Lesezeichen wird je nach Konfiguration dieser Richtlinie aktiviert oder deaktiviert.";
ImportHistory.pfm_title = "Browserverlauf bei erster Ausführung aus Standardbrowser importieren";
ImportHistory.pfm_description = "Wenn die Richtlinie aktiviert ist, wird der Browserverlauf bei der ersten Ausführung aus dem vorherigen Standardbrowser importiert. Ist die Richtlinie deaktiviert oder nicht konfiguriert, wird der Browserverlauf bei der ersten Ausführung nicht importiert.\n\nNutzer können einen Importdialog öffnen. Das Kästchen für den Browserverlauf wird je nach Konfiguration dieser Richtlinie aktiviert oder deaktiviert.";
ImportHomepage.pfm_title = "Startseite bei erster Ausführung aus Standardbrowser importieren";
ImportHomepage.pfm_description = "Wenn die Richtlinie aktiviert ist, wird bei der ersten Ausführung die Startseite des vorherigen Standardbrowsers importiert. Ist die Richtlinie deaktiviert oder nicht konfiguriert, wird bei der ersten Ausführung keine Startseite importiert.\n\nNutzer können einen Importdialog öffnen. Das Kästchen für die Startseite wird je nach Konfiguration dieser Richtlinie aktiviert oder deaktiviert.";
ImportSavedPasswords.pfm_title = "Gespeicherte Passwörter bei erster Ausführung aus Standardbrowser importieren";
ImportSavedPasswords.pfm_description = "Diese Richtlinie steuert nur das Verhalten für den ersten Import nach der Installation. Sie ermöglicht einen problemloseren Übergang zu Brave in Umgebungen, in denen vor der Installation des Browsers ein anderer Browser intensiv genutzt wurde. Diese Richtlinie wirkt sich nicht auf die Funktionen des Passwortmanagers für Google-Konten aus.\n\nWenn die Richtlinie aktiviert ist, werden gespeicherte Passwörter bei der ersten Ausführung aus dem vorherigen Standardbrowser importiert. Auch ein manueller Import über die Seite „Einstellungen“ ist möglich.\nIst die Richtlinie deaktiviert, werden bei der ersten Ausführung keine gespeicherten Passwörter importiert und der manuelle Import über die Seite „Einstellungen“ wird blockiert.\nWenn die Richtlinie nicht konfiguriert ist, werden bei der ersten Ausführung keine gespeicherten Passwörter importiert. Der Nutzer kann dies jedoch über die Seite „Einstellungen“ tun.";
ImportSearchEngine.pfm_title = "Suchmaschinen bei erster Ausführung aus Standardbrowser importieren";
ImportSearchEngine.pfm_description = "Wenn die Richtlinie aktiviert ist, wird die Standardsuchmaschine bei der ersten Ausführung aus dem vorherigen Standardbrowser importiert. Ist die Richtlinie deaktiviert oder nicht konfiguriert, wird die Standardsuchmaschine bei der ersten Ausführung nicht importiert.\n\nNutzer können einen Importdialog öffnen. Das Kästchen für die Standardsuchmaschine wird je nach Konfiguration dieser Richtlinie aktiviert oder deaktiviert.";
IncognitoModeAvailability.pfm_title = "Inkognitomodus - Verfügbarkeit";
IncognitoModeAvailability.pfm_description = "0 - Inkognitomodus verfügbar\n1 - Inkognitomodus deaktiviert\n2 - Inkognitomodus erzwungen\nGibt an, ob der Nutzer Seiten in Brave im Inkognitomodus öffnen kann.\n\nIst diese Richtlinie aktiviert oder nicht konfiguriert, können Seiten im Inkognitomodus geöffnet werden.\n\nWenn sie deaktiviert ist, können Seiten nicht im Inkognitomodus geöffnet werden.\n\nWenn die Option „Erzwungen“ ausgewählt ist, können Seiten ausschließlich im Inkognitomodus geöffnet werden. Die Option „Erzwungen“ funktioniert nicht bei Android-Apps, die auf Chrome ausgeführt werden.\nDie Richtlinie „IncognitoModeUrlAllowlist“ hat Vorrang vor dieser Richtlinie und kann den Inkognitomodus für bestimmte URLs wieder aktivieren. Wenn der Inkognitomodus durch diese Richtlinie deaktiviert wird, während eine Zulassungsliste angegeben ist, ist der Inkognitomodus nur für URLs verfügbar, die mit der Zulassungsliste übereinstimmen. Alle anderen Seiten werden blockiert.\n\nHinweis: Wenn die Richtlinie unter iOS während einer Sitzung geändert wird, gilt sie erst beim Neustart.";
IncognitoModeUrlAllowlist.pfm_title = "Zugriff auf eine Liste von URLs im Inkognitomodus erlauben.";
IncognitoModeUrlAllowlist.pfm_description = "Mit dieser Richtlinie kann im Inkognitomodus auf die aufgeführten URLs zugegriffen werden. Mit dieser Richtlinie lassen sich bei Verwendung des unter https://support.google.com/chrome/a?p=url_blocklist_filter_format angegebenen Formats Ausnahmen für bestimmte in „IncognitoModeUrlBlocklist“ definierte URL-Muster festlegen.\n\nWenn sowohl diese Richtlinie als auch „IncognitoModeUrlBlocklist“ konfiguriert sind, hat die Zulassungsliste Vorrang. Wenn eine URL mit einem Muster auf der Zulassungsliste übereinstimmt, wird sie zugelassen. Wenn eine URL mit einem Muster übereinstimmt, das auf der Sperrliste (aber nicht auf der Zulassungsliste) steht, wird sie blockiert. Wenn eine URL mit keinem Muster der beiden Listen übereinstimmt, werden die allgemeinen Richtlinien „URLBlocklist“ / „URLAllowlist“ als Fallback verwendet.\n\nWenn diese Richtlinie konfiguriert ist und „IncognitoModeUrlBlocklist“ nicht, werden alle URLs, die nicht auf der Zulassungsliste stehen, im Inkognitomodus blockiert.\n\nWenn „IncognitoModeAvailability“ auf „Nicht zulassen“ (Wert 1) festgelegt ist, diese Richtlinie aber konfiguriert ist, ist der Inkognitomodus nur für die URLs verfügbar, die mit der Zulassungsliste übereinstimmen.\n\nWenn sie nicht konfiguriert ist, sind keine Ausnahmen zu „IncognitoModeUrlBlocklist“ und „IncognitoModeAvailability“ möglich.\n\nDiese Richtlinie wirkt sich nur auf den Inkognitomodus aus. Wenn du URLs für alle Nutzerprofile zulassen möchtest, verwende die Richtlinie „URLAllowlist“.\n\nAlles einschließende Platzhalter für den Host (z. B. „*“ oder „[*]“ sind nicht zulässig. Verwende die Richtlinie „IncognitoModeAvailability“, um die Funktion global zu aktivieren.\n\nDiese Richtlinie ist auf 1.000 Einträge beschränkt.";
IncognitoModeUrlBlocklist.pfm_title = "Zugriff auf eine Liste von URLs im Inkognitomodus blockieren.";
IncognitoModeUrlBlocklist.pfm_description = "Wenn die Richtlinie „IncognitoModeUrlBlocklist“ konfiguriert ist, wird verhindert, dass Webseiten mit unzulässigen URLs im Inkognitomodus geladen werden. Administratoren können eine Liste mit URL-Mustern angeben, die blockiert werden sollen. Wie ein URL-Muster formatiert wird, erfährst du unter https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nWenn sowohl diese Richtlinie als auch „IncognitoModeUrlAllowlist“ festgelegt sind, hat die Zulassungsliste Vorrang. Wenn eine URL mit einem Muster auf der Zulassungsliste übereinstimmt, wird sie zugelassen. Wenn eine URL mit einem Muster übereinstimmt, das auf der Sperrliste (aber nicht auf der Zulassungsliste) steht, wird sie blockiert. Wenn eine URL mit keinem Muster der beiden Listen übereinstimmt, werden die allgemeinen Richtlinien „URLBlocklist“ / „URLAllowlist“ als Fallback verwendet.\n\nWenn die Richtlinie „IncognitoModeUrlAllowlist“ konfiguriert ist und diese Richtlinie nicht, werden alle URLs, die nicht auf der Zulassungsliste stehen, im Inkognitomodus blockiert.\n\nWenn „IncognitoModeAvailability“ auf „Nicht zulassen“ (Wert 1) festgelegt ist, aber die Richtlinie „IncognitoModeUrlAllowlist“ konfiguriert ist, ist der Inkognitomodus nur für die URLs verfügbar, die mit der Zulassungsliste übereinstimmen.\n\nDiese Richtlinie wirkt sich nur auf den Inkognitomodus aus. Verwende die Richtlinie „URLBlocklist“, um URLs für alle Nutzerprofile zu blockieren.\n\nDiese Richtlinie ist auf 1.000 Einträge beschränkt.";
InsecureContentAllowedForUrls.pfm_title = "Unsichere Inhalte auf diesen Websites zulassen";
InsecureContentAllowedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL-Mustern festlegen, durch die angegeben wird, welche Websites blockierbare (aktive) gemischte Inhalte (HTTP-Inhalte auf HTTPS-Websites) anzeigen dürfen und auf denen HTTPS-Upgrades für optional blockierbare gemischte Inhalte deaktiviert werden.\n\nIst diese Richtlinie nicht konfiguriert, werden blockierbare gemischte Inhalte gesperrt und optional blockierbare gemischte Inhalte auf HTTPS umgestellt. Nutzer können Ausnahmen für bestimmte Websites festlegen.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig.";
InsecureContentBlockedForUrls.pfm_title = "Unsichere Inhalte auf diesen Websites blockieren";
InsecureContentBlockedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, auf welchen Websites blockierbare (aktive) gemischte Inhalte (HTTP-Inhalte auf HTTPS-Websites) nicht angezeigt werden dürfen und auf welchen Websites optional blockierbare (passive) gemischte Inhalte auf HTTPS geändert werden.\n\nWenn du diese Richtlinie nicht konfigurierst, werden blockierbare gemischte Inhalte gesperrt und optional blockierbare gemischte Inhalte auf HTTPS geändert. Nutzer können jedoch Ausnahmen für bestimmte Websites festlegen.\n\nAusführliche Informationen zu gültigen URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig.";
IntensiveWakeUpThrottlingEnabled.pfm_title = "Die Funktion IntensiveWakeUpThrottling steuern.";
IntensiveWakeUpThrottlingEnabled.pfm_description = "Wenn die Funktion IntensiveWakeUpThrottling aktiviert ist, sorgt sie dafür, dass JavaScript-Timer auf Tabs im Hintergrund aktiv gedrosselt und zusammengeschlossen werden. Sie können nicht öfter als einmal pro Minute ausgeführt werden, nachdem eine Seite für 5 Minuten oder mehr in den Hintergrund verschoben wurde.\n\nDiese Funktion ist mit Webstandards kompatibel, kann jedoch einige Websites beeinträchtigen, da bestimmte Aktionen möglicherweise bis zu einer Minute verspätet erfolgen. Allerdings schont diese Funktion CPU und Akku erheblich, wenn sie aktiviert ist. Weitere Informationen findest du unter https://bit.ly/30b1XR4.\n\nWenn diese Richtlinie aktiviert ist, ist die Funktion standardmäßig aktiviert. Nutzer können dann keine andere Einstellung vornehmen.\n\nWenn diese Richtlinie deaktiviert ist, ist die Funktion standardmäßig deaktiviert. Nutzer können dann keine andere Einstellung vornehmen.\n\nWenn die Richtlinie nicht konfiguriert ist, folgt die Funktion ihrer eigenen internen Logik und kann von Nutzern manuell konfiguriert werden.\n\nBitte beachte, dass die Richtlinie pro Renderer-Prozess angewendet wird. Dabei wird der letzte Wert der Richtlinie angewendet, wenn ein Renderer-Prozess startet. Wenn du dafür sorgen möchtest, dass alle geladenen Tabs die gleiche Richtlinieneinstellung erhalten, ist ein kompletter Neustart nötig. Allerdings ist es kein Problem, wenn einzelne Prozesse mit unterschiedlichen Werten für diese Richtlinie laufen.\n";
IntranetRedirectBehavior.pfm_title = "Verhalten zur Intranet-Weiterleitung";
IntranetRedirectBehavior.pfm_description = "0 - Standard-Browserverhalten verwenden.\n1 - DNS-Abfangprüfungen und „Meintest du: http://intranetsite/“-Infoleisten deaktivieren.\n2 - DNS-Abfangprüfungen deaktivieren; „Meintest du: http://intranetsite/“-Infoleisten erlauben.\n3 - DNS-Abfangprüfungen und „Meintest du: http://intranetsite/“-Infoleisten erlauben.\nMit dieser Richtlinie wird das Verhalten für die Intranet-Weiterleitung durch DNS-Abfangprüfungen konfiguriert. Durch die Prüfungen wird ermittelt, ob sich der Browser hinter einem Proxy befindet, der unbekannte Hostnamen weiterleitet.\n\nWenn diese Richtlinie nicht konfiguriert ist, verwendet der Browser das Standardverhalten für DNS-Abfangprüfungen und Vorschläge zu Intranet-Weiterleitungen. In M88 sind diese Prüfungen standardmäßig aktiviert. In zukünftigen Versionen werden sie jedoch standardmäßig deaktiviert sein.\n\nDNSInterceptionChecksEnabled ist eine ähnliche Richtlinie, mit der sich DNS-Abfangprüfungen deaktivieren lassen. Darüber hinaus ist sie flexibler und bietet die Möglichkeit, Infoleisten für Intranet-Weiterleitungen separat zu steuern. Möglicherweise werden wir den Funktionsumfang dieser Richtlinie in Zukunft noch erweitern.\nAbfangprüfungen werden deaktiviert, sollte das von DNSInterceptionChecksEnabled oder dieser Richtlinie angefordert werden.";
IsolateOrigins.pfm_title = "Website-Isolierung für angegebene Ursprünge aktivieren";
IsolateOrigins.pfm_description = "Gib eine Liste von Ursprüngen an, die in einem eigenen Prozess ausgeführt werden.\n\nUnter Android funktioniert diese Richtlinie nur auf Geräten mit ausreichend Arbeitsspeicher (mehr als 3,2 GB RAM), da die Isolierung zu vieler Websites auf Geräten mit begrenzten Ressourcen Leistungsprobleme verursachen kann. Verwende für Android-Geräte mit begrenzten Ressourcen stattdessen IsolateOriginsShortlist.\n\nEs wird nicht empfohlen, die Prozessisolation speziell für Geräte mit weniger als 1 GB Arbeitsspeicher zu konfigurieren.\n\nJeder Prozess darf nur Dokumente aus diesem Ursprung und den zugehörigen Subdomains enthalten. Wird zum Beispiel https://a1.beispiel.de/ angegeben, ist https://a2.a1.beispiel.de/ im selben Prozess zulässig, https://beispiel.de oder https://b.beispiel.de aber nicht.\n\nSeit Brave-Version 77 kann auch ein Ursprungsbereich für die Isolierung angegeben werden. Dazu wird ein Platzhalter verwendet. Wenn du z. B. https://[*.]firma.beispiel.de angibst, wird für jeden Ursprung unter https://firma.beispiel.de ein eigener Prozess ausgeführt, einschließlich https://firma.beispiel.de selbst, https://a1.firma.beispiel.de und https://a2.a1.firma.beispiel.de.\n\nAlle Websites (also Protokoll plus eTLD+1, z. B. https://beispiel.de) auf Desktop-Plattformen werden bereits standardmäßig isoliert, wie in der Richtlinie SitePerProcess angegeben. Die Richtlinie IsolateOrigins bietet sich auch für die Isolierung spezifischer Ursprünge bei höherer Granularität an (z. B. https://a.beispiel.de).\n\nAb Brave-Version 77 werden unter Android bestimmte sensible Websites standardmäßig isoliert. Diese Richtlinie weitet diesen Modus auf die Isolierung zusätzlicher Ursprünge aus.\n\nUrsprünge, die durch diese Richtlinie isoliert werden, können keine anderen Ursprünge auf derselben Website skripten. Das ist sonst möglich, wenn zwei SameSite-Dokumente ihre „document.domain“-Werte so verändern, dass sie übereinstimmen. Administratoren sollten sicherstellen, dass dieses ungewöhnliche Verhalten nicht für einen Ursprung verwendet wird, bevor er isoliert wird.\n\nWenn die Richtlinie auf einen leeren String festgelegt oder nicht konfiguriert ist, ist die Website-Isolierung für keine bestimmten Ursprünge erforderlich. Nutzer können aber weiter das Befehlszeilen-Flag verwenden, um die Prozessisolation manuell zu aktivieren.";
JavaScriptAllowedForUrls.pfm_title = "JavaScript auf diesen Websites zulassen";
JavaScriptAllowedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites JavaScript ausführen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultJavaScriptSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig.";
JavaScriptBlockedForUrls.pfm_title = "JavaScript auf diesen Websites blockieren";
JavaScriptBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, durch die angegeben wird, welche Websites kein JavaScript ausführen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultJavaScriptSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig.\n\nBeachte, dass diese Richtlinie JavaScript blockiert, wenn der Ursprung des obersten Dokuments (normalerweise die URL der Seite, die auch in der Adressleiste angezeigt wird) mit einem der Muster übereinstimmt. Daher ist diese Richtlinie nicht geeignet, um Web‑Lieferkettenangriffe zu verhindern. Wenn du beispielsweise das Muster „https://[*.]foo.de/“ angibst, wird nicht verhindert, dass eine Seite, die unter https://beispiel.de gehostet wird, ein Script ausführt, das von https://www.foo.de/beispiel.js geladen wird. Außerdem verhindert das Muster „https://beispiel.de/“ nicht, dass ein Dokument von https://beispiel.de Scripts ausführt, wenn es nicht das übergeordnete Dokument ist, sondern als Subframe in eine Seite eingebettet ist, die auf einem anderen Ursprung gehostet wird, z. B. https://www.bar.de.";
JavaScriptJitAllowedForSites.pfm_title = "Verwendung von JIT durch JavaScript auf diesen Websites zulassen";
JavaScriptJitAllowedForSites.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL-Mustern für Websites erstellen, durch die angegeben wird, welche Websites JavaScript mit aktiviertem JIT-Compiler (Just In Time) ausführen dürfen.\n\nAusführliche Informationen zu gültigen Website-URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig.\n\nRichtlinienausnahmen können sowohl für bestimmte Subdomains als auch für ganze Websites festgelegt werden. Eine nur für subdomain.beispiel.de konfigurierte Richtlinie gilt beispielsweise für subdomain.beispiel.de, ohne dass sich dies auf beispiel.de auswirkt. In einigen Fällen, in denen eine Subdomain nicht von ihrer übergeordneten Website isoliert werden kann, übernimmt sie möglicherweise die für beispiel.de konfigurierte Richtlinie. Ausnahmen werden eventuell erst dann für Frames wirksam, die in einem vorhandenen Tab geladen werden, wenn die Website in einem neuen Tab geöffnet wird. Auf Android-Geräten mit wenig Arbeitsspeicher werden websitespezifische Ausnahmen möglicherweise nicht erzwungen. Stattdessen wird die Richtlinie aus DefaultJavaScriptJitSetting, falls konfiguriert, oder die JavaScript JIT-Einstellung des Profils verwendet.\n\nUm Ausnahmen zu erzwingen, kann Brave Websites oder Subdomains, deren Einstellung von der Standardeinstellung abweicht, in dedizierten Prozessen platzieren. Dies kann die Arbeitsspeichernutzung erhöhen, insbesondere unter Android oder wenn ein Platzhaltermuster mit vielen Subdomains übereinstimmt, da jeder übereinstimmende Ursprung separat isoliert werden kann. Isolierte Subdomains können auch nicht „document.domain“ verwenden, um auf ihre übergeordnete Website zuzugreifen.\n\nHinweis: In Version 155 und früheren Versionen wurden Richtlinienausnahmen nur für die jeweilige Website (eTLD+1) erzwungen. Eine nur für subdomain.beispiel.de konfigurierte Richtlinie wurde nicht wirksam, auch nicht für subdomain.beispiel.de. Sie musste für beispiel.de konfiguriert werden, damit sie sowohl für beispiel.de als auch für subdomain.beispiel.de gilt.\n\nDiese Richtlinie wird Frame für Frame angewendet und nicht nur auf Grundlage der Ursprungs-URL auf oberster Ebene. Wenn also beispielsweise beispiel-eins.de in der Richtlinie „JavaScriptJitAllowedForSites“ aufgeführt ist, aber beispiel-eins.de einen Frame mit beispiel-zwei.de lädt, ist JavaScript JIT für beispiel-eins.de aktiviert. Für beispiel-zwei.de wird jedoch die Richtlinie aus „DefaultJavaScriptJitSetting“ verwendet, falls konfiguriert, oder standardmäßig JavaScript JIT aktiviert. Einträge auf der Sperrliste haben eine höhere Priorität als Einträge auf der Zulassungsliste, die wiederum eine höhere Priorität als der konfigurierte Standardwert haben.\n\nWenn diese Richtlinie für eine Website nicht konfiguriert ist, gilt die Richtlinie aus „DefaultJavaScriptJitSetting“ für die Website, falls konfiguriert. Andernfalls ist JavaScript JIT für die Website aktiviert.";
JavaScriptJitBlockedForSites.pfm_title = "Verwendung von JIT durch JavaScript auf diesen Websites blockieren";
JavaScriptJitBlockedForSites.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL-Mustern für Websites erstellen, durch die angegeben wird, welche Websites JavaScript mit aktiviertem JIT-Compiler (Just In Time) nicht ausführen dürfen.\n\nWenn JavaScript JIT deaktiviert ist, rendert Brave Webinhalte möglicherweise langsamer und Teile von JavaScript, einschließlich WebAssembly, werden eventuell deaktiviert. Außerdem kann Brave Webinhalte möglicherweise in einer sichereren Konfiguration rendern, sollte JavaScript JIT deaktiviert sein.\n\nAusführliche Informationen zu gültigen URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig.\n\nRichtlinienausnahmen können sowohl für bestimmte Subdomains als auch für ganze Websites festgelegt werden. Eine nur für subdomain.beispiel.de konfigurierte Richtlinie gilt beispielsweise für subdomain.beispiel.de, ohne dass sich dies auf beispiel.de auswirkt. In einigen Fällen, in denen eine Subdomain nicht von ihrer übergeordneten Website isoliert werden kann, übernimmt sie möglicherweise die für beispiel.de konfigurierte Richtlinie. Ausnahmen werden eventuell erst dann für Frames wirksam, die in einem vorhandenen Tab geladen werden, wenn die Website in einem neuen Tab geöffnet wird. Auf Android-Geräten mit wenig Arbeitsspeicher werden websitespezifische Ausnahmen möglicherweise nicht erzwungen. Stattdessen wird die Richtlinie aus DefaultJavaScriptJitSetting, falls konfiguriert, oder die JavaScript JIT-Einstellung des Profils verwendet.\n\nUm Ausnahmen zu erzwingen, kann Brave Websites oder Subdomains, deren Einstellung von der Standardeinstellung abweicht, in dedizierten Prozessen platzieren. Dies kann die Arbeitsspeichernutzung erhöhen, insbesondere unter Android oder wenn ein Platzhaltermuster mit vielen Subdomains übereinstimmt, da jeder übereinstimmende Ursprung separat isoliert werden kann. Isolierte Subdomains können auch nicht „document.domain“ verwenden, um auf ihre übergeordnete Website zuzugreifen.\n\nHinweis: In Version 155 und früheren Versionen wurden Richtlinienausnahmen nur für die jeweilige Website (eTLD+1) erzwungen. Eine nur für subdomain.beispiel.de konfigurierte Richtlinie wurde nicht wirksam, auch nicht für subdomain.beispiel.de. Sie musste für beispiel.de konfiguriert werden, damit sie sowohl für beispiel.de als auch für subdomain.beispiel.de gilt.\n\nDiese Richtlinie wird Frame für Frame angewendet und nicht nur auf Grundlage der Ursprungs-URL auf oberster Ebene. Wenn also beispielsweise beispiel-eins.de in der Richtlinie „JavaScriptJitBlockedForSites“ aufgeführt ist, aber beispiel-eins.de einen Frame mit beispiel-zwei.de lädt, ist JavaScript JIT für beispiel-eins.de deaktiviert. Für beispiel-zwei.de wird jedoch die Richtlinie aus DefaultJavaScriptJitSetting verwendet, falls konfiguriert, oder standardmäßig JavaScript JIT aktiviert. Einträge auf der Sperrliste haben eine höhere Priorität als Einträge auf der Zulassungsliste, die wiederum eine höhere Priorität als der konfigurierte Standardwert haben.\n\nWenn diese Richtlinie für eine Website nicht konfiguriert ist, gilt die Richtlinie aus DefaultJavaScriptJitSetting für die Website, falls konfiguriert. Andernfalls ist JavaScript JIT für die Website aktiviert.";
JavaScriptOptimizerAllowedForSites.pfm_title = "JavaScript-Optimierung auf diesen Websites zulassen";
JavaScriptOptimizerAllowedForSites.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL-Mustern festlegen, die angeben, für welche Websites erweiterte JavaScript-Optimierungen aktiviert werden.\n\nAusführliche Informationen zu gültigen Website-URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns.\nPlatzhalter wie „*“ sind zulässig.\n\nRichtlinienausnahmen können sowohl für bestimmte Subdomains als auch für ganze Websites festgelegt werden.\nEine nur für subdomain.beispiel.de konfigurierte Richtlinie gilt beispielsweise für subdomain.beispiel.de, ohne dass sich dies auf beispiel.de auswirkt. In einigen Fällen, in denen eine Subdomain nicht von ihrer übergeordneten Website isoliert werden kann, übernimmt sie möglicherweise die für beispiel.de konfigurierte Richtlinie. Ausnahmen werden eventuell erst dann für Frames wirksam, die in einem vorhandenen Tab geladen werden, wenn die Website in einem neuen Tab geöffnet wird. Auf Android-Geräten mit wenig Arbeitsspeicher werden websitespezifische Ausnahmen möglicherweise nicht erzwungen. Stattdessen wird die Richtlinie aus „DefaultJavaScriptOptimizerSetting“, falls konfiguriert, oder die JavaScript-Optimierungseinstellung des Profils verwendet.\n\nUm Ausnahmen zu erzwingen, kann Brave Websites oder Subdomains, deren Einstellung von der Standardeinstellung abweicht, in dedizierten Prozessen platzieren. Dies kann die Arbeitsspeichernutzung erhöhen, insbesondere unter Android oder wenn ein Platzhaltermuster mit vielen Subdomains übereinstimmt, da jeder übereinstimmende Ursprung separat isoliert werden kann. Isolierte Subdomains können auch nicht „document.domain“ verwenden, um auf ihre übergeordnete Website zuzugreifen.\n\nHinweis: In Version 138 und früheren Versionen wurden Richtlinienausnahmen nur für die jeweilige Website (eTLD+1) erzwungen. Eine nur für subdomain.beispiel.de konfigurierte Richtlinie wurde nicht wirksam, auch nicht für subdomain.beispiel.de. Sie musste für beispiel.de konfiguriert werden, damit sie sowohl für beispiel.de als auch für subdomain.beispiel.de gilt.\n\nDiese Richtlinie wird Frame für Frame angewendet und nicht nur auf Grundlage der Ursprungs-URL auf oberster Ebene. Wenn also beispielsweise beispiel-eins.de in der Richtlinie „JavaScriptOptimizerAllowedForSites“ aufgeführt ist, aber beispiel-eins.de einen Frame mit beispiel-zwei.de lädt, sind JavaScript-Optimierungen für beispiel-eins.de aktiviert. Für beispiel-zwei.de wird jedoch die Richtlinie aus „DefaultJavaScriptOptimizerSetting“ verwendet, falls konfiguriert. Andernfalls sind JavaScript-Optimierungen standardmäßig aktiviert. Einträge in der Sperrliste haben eine höhere Priorität als Einträge in der Zulassungsliste, die wiederum eine höhere Priorität als der konfigurierte Standardwert haben.\n\nWenn diese Richtlinie für eine Website nicht konfiguriert ist, gilt die Richtlinie aus „DefaultJavaScriptOptimizerSetting“ für die Website, falls konfiguriert. Andernfalls ist die JavaScript-Optimierung für die Website aktiviert.";
JavaScriptOptimizerBlockedForSites.pfm_title = "JavaScript-Optimierungen auf diesen Websites blockieren";
JavaScriptOptimizerBlockedForSites.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL‑Mustern festlegen, durch die angegeben wird, für welche Websites erweiterte JavaScript-Optimierungen deaktiviert werden.\n\nWenn JavaScript-Optimierungen deaktiviert sind, rendert Brave Webinhalte möglicherweise langsamer.\n\nAusführliche Informationen zu gültigen URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns.\nPlatzhalter wie * sind zulässig.\n\nRichtlinienausnahmen können sowohl für bestimmte Subdomains als auch für ganze Websites festgelegt werden.\nEine nur für subdomain.beispiel.de konfigurierte Richtlinie gilt beispielsweise für subdomain.beispiel.de, ohne dass sich dies auf beispiel.de auswirkt. In einigen Fällen, in denen eine Subdomain nicht von ihrer übergeordneten Website isoliert werden kann, übernimmt sie möglicherweise die für beispiel.de konfigurierte Richtlinie. Ausnahmen werden eventuell erst dann für Frames wirksam, die in einem vorhandenen Tab geladen werden, wenn die Website in einem neuen Tab geöffnet wird. Auf Android-Geräten mit wenig Arbeitsspeicher werden websitespezifische Ausnahmen möglicherweise nicht erzwungen. Stattdessen wird die Richtlinie aus DefaultJavaScriptOptimizerSetting, falls konfiguriert, oder die JavaScript-Optimierungseinstellung des Profils verwendet.\n\nUm Ausnahmen zu erzwingen, kann Brave Websites oder Subdomains, deren Einstellung von der Standardeinstellung abweicht, in dedizierten Prozessen platzieren. Dies kann die Arbeitsspeichernutzung erhöhen, insbesondere unter Android oder wenn ein Platzhaltermuster mit vielen Subdomains übereinstimmt, da jeder übereinstimmende Ursprung separat isoliert werden kann. Isolierte Subdomains können auch nicht „document.domain“ verwenden, um auf ihre übergeordnete Website zuzugreifen.\n\nHinweis: In Version 138 und früheren Versionen wurden Richtlinienausnahmen nur für die jeweilige Website (eTLD+1) erzwungen. Eine nur für subdomain.beispiel.de konfigurierte Richtlinie wurde nicht wirksam, auch nicht für subdomain.beispiel.de. Sie musste für beispiel.de konfiguriert werden, damit sie sowohl für beispiel.de als auch für subdomain.beispiel.de gilt.\n\nDiese Richtlinie wird Frame für Frame angewendet und nicht nur auf Grundlage der Ursprungs-URL auf oberster Ebene. Wenn also beispielsweise beispiel-eins.de in der Richtlinie „JavaScriptOptimizerBlockedForSites“ aufgeführt ist, aber beispiel-eins.de einen Frame mit beispiel-zwei.de lädt, sind JavaScript-Optimierungen für beispiel-eins.de deaktiviert. Für beispiel-zwei.de wird jedoch die Richtlinie aus DefaultJavaScriptOptimizerSetting verwendet, falls konfiguriert. Andernfalls sind JavaScript-Optimierungen standardmäßig aktiviert. Einträge in der Sperrliste haben eine höhere Priorität als Einträge in der Zulassungsliste, die wiederum eine höhere Priorität als der konfigurierte Standardwert haben.\n\nWenn diese Richtlinie für eine Website nicht konfiguriert ist, gilt die Richtlinie aus DefaultJavaScriptOptimizerSetting für die Website, falls konfiguriert. Andernfalls ist die JavaScript-Optimierung für die Website aktiviert.";
LiveCaptionEnabled.pfm_title = "„Automatische Untertitel“ aktivieren";
LiveCaptionEnabled.pfm_description = "Funktion „Automatische Untertitel“ aktivieren.\n\nWenn diese Richtlinie aktiviert ist, ist „Automatische Untertitel“ immer aktiviert.\n\nIst die Richtlinie deaktiviert, ist „Automatische Untertitel“ immer deaktiviert.\n\nWird die Richtlinie als verbindlich konfiguriert, kann sie vom Nutzer nicht geändert oder überschrieben werden.\n\nIst die Richtlinie nicht konfiguriert, ist „Automatische Untertitel“ anfangs deaktiviert, kann jedoch vom Nutzer jederzeit aktiviert werden.";
LiveTranslateEnabled.pfm_title = "Live-Übersetzung aktivieren";
LiveTranslateEnabled.pfm_description = "Übersetzung von automatischen Untertiteln aktivieren. Die Untertitel werden zur Übersetzung an Google gesendet.\n\nWenn diese Richtlinie aktiviert ist, ist die Funktion „Live-Übersetzung“ immer aktiviert.\n\nIst die Richtlinie deaktiviert, ist „Live-Übersetzung“ immer deaktiviert.\n\nWird die Richtlinie als verbindlich konfiguriert, kann sie vom Nutzer nicht geändert oder überschrieben werden.\n\nIst die Richtlinie nicht konfiguriert, ist „Live-Übersetzung“ anfangs deaktiviert, kann jedoch vom Nutzer jederzeit aktiviert werden.\n\nWenn die Richtlinie „LiveCaptionEnabled“ deaktiviert ist, ist „Live-Übersetzung“ unabhängig von dieser Richtlinieneinstellung deaktiviert.";
LocalFontsAllowedForUrls.pfm_title = "Berechtigung für lokale Schriftarten auf diesen Websites zulassen";
LocalFontsAllowedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit Website-URL‑Mustern festlegen, durch die Websites angegeben werden, denen automatisch die Berechtigung für lokale Schriftarten gewährt wird. Dadurch wird die Fähigkeit von Websites erweitert, Informationen zu lokalen Schriftarten abzurufen.\n\nAusführliche Informationen zu gültigen Website-URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig. Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL‑Musters ignoriert.\n\nWenn die Richtlinie für eine Website nicht konfiguriert ist, gilt die Richtlinie aus „DefaultLocalFontsSetting“ für die Website, falls konfiguriert. Andernfalls werden die Standardeinstellungen des Browsers verwendet und Nutzer können auswählen, für welche Websites sie die Berechtigung gewähren möchten.";
LocalFontsBlockedForUrls.pfm_title = "Berechtigung für lokale Schriftarten auf diesen Websites blockieren";
LocalFontsBlockedForUrls.pfm_description = "Legt eine Liste mit Website-URL-Mustern fest, die Websites angeben, denen automatisch die Berechtigung für lokale Schriftarten verweigert wird. Dadurch wird die Fähigkeit von Websites eingeschränkt, Informationen zu lokalen Schriftarten zu sehen.\n\nAusführliche Informationen zu gültigen Website-URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig. Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL-Musters ignoriert.\n\nWenn die Richtlinie für eine Website nicht konfiguriert ist, gilt die Richtlinie aus DefaultLocalFontsSetting für die Website, falls konfiguriert. Andernfalls werden die Standardeinstellungen des Browsers verwendet und Nutzer können auswählen, für welche Websites sie die Berechtigung gewähren möchten.";
LocalNetworkAccessAllowedForUrls.pfm_title = "Websites erlauben, Netzwerkanfragen an lokale Geräte und lokale Netzwerkendpunkte zu senden.";
LocalNetworkAccessAllowedForUrls.pfm_description = "Liste der URL-Muster. Netzwerkanfragen von Websites, die durch übereinstimmende Ursprünge bereitgestellt werden, unterliegen keinen Local Network Access-Prüfungen.\n\nBei Ursprüngen, die durch die hier angegebenen Muster nicht abgedeckt sind, kommt die persönliche Konfiguration des Nutzers zum Einsatz.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.\n\nInformationen zu Einschränkungen für Local Network Access findest du unter https://wicg.github.io/local-network-access/.\n\nEs gibt mehrere Richtlinien, in denen Ursprünge aufgeführt sind, die sich auf Anfragen an lokale Geräte und lokale Netzwerkendpunkte auswirken. Wenn ein Ursprung mit mehr als einer der folgenden Richtlinien übereinstimmt, haben die Richtlinien in der folgenden Reihenfolge Vorrang:\n\n– LocalNetworkBlockedForUrls\n– LocalNetworkAllowedForUrls\n– LoopbackNetworkBlockedForUrls\n– LoopbackNetworkAllowedForUrls\n– LocalNetworkAccessBlockedForUrls\n– LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "Websites daran hindern, Netzwerkanfragen an lokale Geräte und lokale Netzwerkendpunkte zu senden.";
LocalNetworkAccessBlockedForUrls.pfm_description = "Liste der URL-Muster. Netzwerkanfragen von Websites, die durch übereinstimmende Ursprünge bereitgestellt werden, können keine Local Network Access-Anfragen senden.\n\nBei Ursprüngen, die durch die hier angegebenen Muster nicht abgedeckt sind, kommt die persönliche Konfiguration des Nutzers zum Einsatz.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.\n\nInformationen zu Einschränkungen für Local Network Access findest du unter https://wicg.github.io/local-network-access/.\n\nEs gibt mehrere Richtlinien, in denen Ursprünge aufgeführt sind, die sich auf Anfragen an lokale Geräte und lokale Netzwerkendpunkte auswirken. Wenn ein Ursprung mit mehr als einer der folgenden Richtlinien übereinstimmt, haben die Richtlinien in der folgenden Reihenfolge Vorrang:\n\n– LocalNetworkBlockedForUrls\n– LocalNetworkAllowedForUrls\n– LoopbackNetworkBlockedForUrls\n– LoopbackNetworkAllowedForUrls\n– LocalNetworkAccessBlockedForUrls\n– LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "Zuordnungen von IP-Adressbereichen überschreiben";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "Damit können bestimmte interne Adressbereiche als „öffentlich“ behandelt und somit nicht Local Network Access-Prüfungen unterzogen werden. Umgekehrt kann dies verwendet werden, um bestimmte öffentliche Adressbereiche, die möglicherweise intern verwendet werden, als „lokal“ zu behandeln, sodass sie durch Local Network Access-Prüfungen geschützt sind.\n\nÜberschreibungen des IP-Adressbereichs haben zwei Formen:\n\n[cidr]=[public|local|loopback]\n\nDabei ist [cidr] ein IP-Adressbereich in CIDR-Notation (siehe Abschnitt 3.1 von https://tools.ietf.org/html/rfc4632 für IPv4 und Abschnitt 2.3 von https://tools.ietf.org/html/rfc4291 für IPv6). IPv6-Adressen müssen im URL-sicheren Format (in Klammern) angegeben werden. CIDR-Überschreibungen gelten für alle Ports.\n\noder\n\n[ip-address]:[port]=[public|local|loopback]\n\nWeitere Informationen zu Local Network Access findest du unter https://wicg.github.io/local-network-access/ und https://developer.chrome.com/blog/local-network-access.\n\nDiese Richtlinie unterstützt die dynamische Aktualisierung nicht.\n\nÜberschreibungen über die Befehlszeilenoption „--ip-address-space-overrides“ haben Vorrang vor Überschreibungen, die durch diese Richtlinie festgelegt werden.";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "Anfragen für den Zugriff auf das lokale Netzwerk (Local Network Access, LNA) in Unterframes ohne explizite Delegierung zulassen";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "Standardmäßig dürfen Berechtigungen für den Zugriff auf das lokale Netzwerk (Local Network Access, LNA) nur in Unterframes mit unterschiedlicher Herkunft angefordert werden, wenn sie explizit delegiert wurden. Mit dieser Richtlinie kann dieses Standardverhalten überschrieben werden, sodass LNA-Berechtigungen standardmäßig in Unterframes übernommen werden, es sei denn, dies wird in der Berechtigungsrichtlinie explizit abgelehnt.\n\nWenn diese Richtlinie aktiviert ist, werden standardmäßig alle Funktionen der LNA-Berechtigungsrichtlinien an Unterframes delegiert und sie können Anfragen an das lokale Netzwerk senden (wodurch die Berechtigungsaufforderung ausgelöst wird).\n\nWenn diese Richtlinie deaktiviert oder nicht konfiguriert ist, muss die Funktion der Berechtigungsrichtlinie explizit an Unterframes delegiert werden, damit sie lokale Netzwerkanfragen stellen und die Berechtigungsaufforderung auslösen können.\n\nDiese Richtlinie gilt für die Funktionen „\"local-network-access\"“, „\"loopback-network\"“ und „\"local-network\"“ der Berechtigungsrichtlinie.\n\nWeitere Informationen zum Zugriff auf das lokale Netzwerk findest du unter https://wicg.github.io/local-network-access/ und https://developer.chrome.com/blog/local-network-access.\n\nWeitere Informationen zur Berechtigungsrichtlinie findest du unter https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy.";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "Legt fest, ob Einschränkungen für den Zugriff auf das lokale Netzwerk (vorübergehend) deaktiviert werden sollen";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "Wenn diese Richtlinie aktiviert ist, werden bei Anfragen vom Typ „Local Network Access“ in den Chrome DevTools nur Warnungen aufgrund fehlgeschlagener „Local Network Access“-Prüfungen angezeigt.\n\nIst diese Richtlinie deaktiviert oder nicht konfiguriert, werden Anfragen vom Typ „Local Network Access“ gemäß dem standardmäßigen Verarbeitungsprozess für diesen Anfragetyp verarbeitet.\n\nInformationen zu Einschränkungen für den Local Network Access findest du unter https://wicg.github.io/local-network-access/.\n\nDiese Unternehmensrichtlinie ist nur vorübergehend verfügbar und wird nach M163 entfernt.\n\nLangfristig kann die Richtlinie „LocalNetworkAccessAllowedForUrls“ verwendet werden, um URL-Muster auf die Zulassungsliste zu setzen, für die automatisch die Berechtigung „Local Network Access“ gewährt werden soll.";
LocalNetworkAllowedForUrls.pfm_title = "Websites erlauben, Netzwerkanfragen an lokale Netzwerkendpunkte zu senden.";
LocalNetworkAllowedForUrls.pfm_description = "Liste der URL-Muster. Netzwerkanfragen, die von Websites initiiert werden, die durch übereinstimmende Ursprünge bereitgestellt werden, und an lokale Netzwerkendpunkte gerichtet sind, unterliegen keinen Local Network Access-Prüfungen.\n\nBei Ursprüngen, die durch die hier angegebenen Muster nicht abgedeckt sind, kommt die persönliche Konfiguration des Nutzers zum Einsatz.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.\n\nInformationen zu Einschränkungen für Local Network Access findest du unter https://wicg.github.io/local-network-access/.\n\nEs gibt mehrere Richtlinien, die Ursprünge auflisten, die sich auf Anfragen an lokale Netzwerkendpunkte auswirken. Wenn ein Ursprung mit mehr als einer der folgenden Richtlinien übereinstimmt, haben die Richtlinien in der folgenden Reihenfolge Vorrang:\n\n– LocalNetworkBlockedForUrls\n– LocalNetworkAllowedForUrls\n– LocalNetworkAccessBlockedForUrls\n– LocalNetworkAccessAllowedForUrls";
LocalNetworkBlockedForUrls.pfm_title = "Websites daran hindern, Netzwerkanfragen an lokale Netzwerkendpunkte zu senden.";
LocalNetworkBlockedForUrls.pfm_description = "Liste der URL-Muster. Netzwerkanfragen, die von Websites initiiert werden, die durch übereinstimmende Ursprünge bereitgestellt werden, und an lokale Netzwerkendpunkte gerichtet sind, können keine Local Network Access-Anfragen senden.\n\nBei Ursprüngen, die durch die hier angegebenen Muster nicht abgedeckt sind, kommt die persönliche Konfiguration des Nutzers zum Einsatz.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.\n\nInformationen zu Einschränkungen für Local Network Access findest du unter https://wicg.github.io/local-network-access/.\n\nEs gibt mehrere Richtlinien, die Ursprünge auflisten, die sich auf Anfragen an lokale Netzwerkendpunkte auswirken. Wenn ein Ursprung mit mehr als einer der folgenden Richtlinien übereinstimmt, haben die Richtlinien in der folgenden Reihenfolge Vorrang:\n\n– LocalNetworkBlockedForUrls\n– LocalNetworkAllowedForUrls\n– LocalNetworkAccessBlockedForUrls\n– LocalNetworkAccessAllowedForUrls";
LookalikeWarningAllowlistDomains.pfm_title = "Warnungen zu nachgeahmten URLs auf Domains unterdrücken";
LookalikeWarningAllowlistDomains.pfm_description = "Die Richtlinie verhindert, dass für die aufgeführten Websites Warnungen zu nachgeahmten URLs angezeigt werden. Diese Warnungen werden normalerweise dann eingeblendet, wenn Brave feststellt, dass sich eine Website als eine dem Nutzer bekannte Website ausgeben könnte.\n\nIst die Richtlinie aktiviert und für eine oder mehrere Domains konfiguriert, werden keine Warnungen zu nachgeahmten URLs angezeigt, wenn Nutzer Seiten auf der jeweiligen Domain aufrufen.\n\nWenn diese Richtlinie nicht konfiguriert oder auf eine leere Liste festgelegt ist, können jederzeit Warnungen zu nachgeahmten URLs erscheinen.\n\nEin Hostname kann bei vollständiger Host- oder beliebiger Domainübereinstimmung erlaubt sein. Beispiel: Für die URL „https://foo.beispiel.de/bar“ werden Warnungen möglicherweise unterdrückt, wenn „foo.beispiel.de“ oder „beispiel.de“ zur Liste hinzugefügt wurden.";
LoopbackNetworkAllowedForUrls.pfm_title = "Websites erlauben, Netzwerkanfragen an das lokale Gerät zu senden.";
LoopbackNetworkAllowedForUrls.pfm_description = "Liste der URL-Muster. Netzwerkanfragen, die von Websites initiiert werden, die durch übereinstimmende Ursprünge bereitgestellt werden, und an das lokale Gerät gerichtet sind, unterliegen keinen Local Network Access-Prüfungen.\n\nBei Ursprüngen, die durch die hier angegebenen Muster nicht abgedeckt sind, kommt die persönliche Konfiguration des Nutzers zum Einsatz.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.\n\nInformationen zu Einschränkungen für Local Network Access findest du unter https://wicg.github.io/local-network-access/.\n\nEs gibt mehrere Richtlinien, die Ursprünge auflisten, die sich auf Anfragen an das lokale Gerät auswirken. Wenn ein Ursprung mit mehr als einer der folgenden Richtlinien übereinstimmt, haben die Richtlinien in der folgenden Reihenfolge Vorrang:\n\n– LoopbackNetworkBlockedForUrls\n– LoopbackNetworkAllowedForUrls\n– LocalNetworkAccessBlockedForUrls\n– LocalNetworkAccessAllowedForUrls";
LoopbackNetworkBlockedForUrls.pfm_title = "Websites daran hindern, Netzwerkanfragen an das lokale Gerät zu senden.";
LoopbackNetworkBlockedForUrls.pfm_description = "Liste der URL-Muster. Netzwerkanfragen, die von Websites initiiert werden, die durch übereinstimmende Ursprünge bereitgestellt werden, und an das lokale Gerät gerichtet sind, können keine Local Network Access-Anfragen senden.\n\nBei Ursprüngen, die durch die hier angegebenen Muster nicht abgedeckt sind, kommt die persönliche Konfiguration des Nutzers zum Einsatz.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.\n\nInformationen zu Einschränkungen für Local Network Access findest du unter https://wicg.github.io/local-network-access/.\n\nEs gibt mehrere Richtlinien, die Ursprünge auflisten, die sich auf Anfragen an das lokale Gerät auswirken. Wenn ein Ursprung mit mehr als einer der folgenden Richtlinien übereinstimmt, haben die Richtlinien in der folgenden Reihenfolge Vorrang:\n\n– LoopbackNetworkBlockedForUrls\n– LoopbackNetworkAllowedForUrls\n– LocalNetworkAccessBlockedForUrls\n– LocalNetworkAccessAllowedForUrls";
ManagedBookmarks.pfm_title = "Verwaltete Lesezeichen";
ManagedBookmarks.pfm_description = "Wenn die Richtlinie konfiguriert ist, wird eine Lesezeichenliste erstellt, bei der jedes Lesezeichen ein Wörterbuch mit den Schlüsseln \"name\" und \"url\" ist. Diese Schlüssel enthalten den Namen und das Ziel des jeweiligen Lesezeichens. Administratoren können einen Unterordner konfigurieren, indem ein Lesezeichen ohne den Schlüssel \"url\", dafür aber mit dem zusätzlichen Schlüssel \"children\" festgelegt wird. Dieser Schlüssel enthält wiederum eine Lesezeichenliste. Einige davon können auch Ordner sein. Chrome ergänzt unvollständige URLs, als würden sie über die Adressleiste eingegeben werden. Beispielsweise wird aus \"google.com\" dann \"https://google.com/\".\n\nNutzer können nicht ändern, in welchem Ordner die Lesezeichen abgelegt werden. Aber sie haben die Möglichkeit, den Ordner in der Lesezeichenleiste auszublenden. Der Standardname des Ordners für verwaltete Lesezeichen lautet \"Verwaltete Lesezeichen\", kann jedoch angepasst werden. Dazu muss der Richtlinie ein neues untergeordnetes Wörterbuch mit einem einfachen Schlüssel namens \"toplevel_name\" hinzugefügt werden, wobei der gewünschte Ordnername der Wert ist. Verwaltete Lesezeichen werden nicht mit dem Nutzerkonto synchronisiert und können nicht von Erweiterungen geändert werden.\nUnter https://chromeenterprise.google/policies/?policy=ManagedBookmarks erhältst du weitere Informationen zu Schema und Formatierung.";
ManagedConfigurationPerOrigin.pfm_title = "Mit dieser Richtlinie legst du für bestimmte Ursprünge die Werte für die verwaltete Konfiguration fest";
ManagedConfigurationPerOrigin.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du den Rückgabewert der Managed Configuration API für einen bestimmten Ursprung definieren.\n\n Die Managed Configuration API ist eine Schlüssel/Wert-Konfiguration, die sich über den JavaScript-Aufruf „navigator.managed.getManagedConfiguration()“ abrufen lässt. Diese API ist nur für Ursprünge verfügbar, die zu Webanwendungen gehören, deren Installation über WebAppInstallForceList erzwungen wurde.\n\nUnter https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin erhältst du weitere Informationen zu Schema und Formatierung.";
MaxConnectionsPerProxy.pfm_title = "Maximale Anzahl gleichzeitiger Verbindungen pro Proxyserver für Nicht-WebSocket-Anfragen";
MaxConnectionsPerProxy.pfm_description = "Mit dieser Richtlinie wird die maximale Anzahl gleichzeitiger Verbindungen pro Proxyserver für Nicht-WebSocket-Anfragen festgelegt.\n\nInformationen zum Ändern von WebSocket-Anfragelimits findest du unter MaxConnectionsPerProxyForWebSocket.\n\nIst diese Richtlinie nicht konfiguriert, so kommt der Standardwert von 128 zum Einsatz.\n\nEinige Webanwendungen nutzen viele Verbindungen mit „hängenden“ GET-Anfragen. Wird ein Wert unter 128 festgelegt, kann dies zu Netzwerkblockaden im Browser führen, wenn zu viele solcher Verbindungen gleichzeitig offen sind.\nEinige Proxyserver können eine hohe Anzahl gleichzeitiger Verbindungen pro Client nicht verarbeiten. Dieses Problem kann umgangen werden, indem für diese Richtlinie ein niedrigerer Wert festgelegt wird.\n\nDer Wert sollte mindestens 6 betragen.\nWird ein niedrigerer Wert festgelegt, wird stattdessen 6 verwendet.\nWenn du deinen Wert unter dem Standardwert (128) festlegst, geschieht dies auf eigenes Risiko.\n\nDer Wert sollte höchstens 256 (99 in Brave 147 und früher) betragen.\nWird ein höherer Wert festgelegt, wird stattdessen 256 (99 in Brave 147 und früher) verwendet.\nDas Erhöhen über den Standardwert (128) erfolgt auf eigenes Risiko.\n\nBeachte, dass die erzwungenen Limits durch „AllowSocketPoolSizeRandomizationForProxies“ beeinflusst werden.";
MaxConnectionsPerProxyForWebSocket.pfm_title = "Maximale Anzahl gleichzeitiger Verbindungen pro Proxyserver für WebSocket-Anfragen";
MaxConnectionsPerProxyForWebSocket.pfm_description = "Mit dieser Richtlinie wird die maximale Anzahl gleichzeitiger Verbindungen pro Proxyserver für WebSocket-Anfragen festgelegt.\n\nInformationen zum Ändern von Nicht-WebSocket-Anfragelimits findest du unter MaxConnectionsPerProxy.\n\nIst diese Richtlinie nicht konfiguriert, so kommt der Standardwert von 128 zum Einsatz.\n\nEinige Webanwendungen nutzen viele Verbindungen mit „hängenden“ GET-Anfragen. Wird ein Wert unter 128 festgelegt, kann dies zu Netzwerkblockaden im Browser führen, wenn zu viele solcher Verbindungen gleichzeitig offen sind.\nEinige Proxyserver können eine hohe Anzahl gleichzeitiger Verbindungen pro Client nicht verarbeiten. Dieses Problem kann umgangen werden, indem für diese Richtlinie ein niedrigerer Wert festgelegt wird.\n\nDer Wert sollte mindestens 6 betragen.\nWird ein niedrigerer Wert festgelegt, wird stattdessen 6 verwendet.\nWenn du deinen Wert unter dem Standardwert (128) festlegst, geschieht dies auf eigenes Risiko.\n\nDer Wert sollte höchstens 256 betragen.\nWird ein höherer Wert festgelegt, wird stattdessen 256 verwendet.\nDas Erhöhen über den Standardwert (128) erfolgt auf eigenes Risiko.\n\nBeachte, dass die erzwungenen Limits durch „AllowSocketPoolSizeRandomizationForProxies“ beeinflusst werden.";
MaxInvalidationFetchDelay.pfm_title = "Maximale Abrufverzögerung nach der Außerkraftsetzung einer Richtlinie";
MaxInvalidationFetchDelay.pfm_description = "Wenn diese Richtlinie konfiguriert ist, wird die maximale Verzögerung zwischen dem Empfang der Information, dass eine Richtlinie ungültig ist, und dem Abrufen der neuen Richtlinie vom Geräteverwaltungsdienst in Millisekunden angegeben. Gültige Werte für diese Richtlinie liegen im Bereich zwischen 1.000 (1 Sekunde) und 300.000 (5 Minuten). Alle Werte, die nicht in diesem Bereich liegen, werden auf den jeweiligen Grenzwert gesetzt.\n\nIst diese Richtlinie nicht konfiguriert, verwendet Brave den Standardwert von 10 Sekunden.";
MediaRecommendationsEnabled.pfm_title = "Empfehlungen zu Medien aktivieren";
MediaRecommendationsEnabled.pfm_description = "Der Browser zeigt standardmäßig für den Nutzer personalisierte Empfehlungen zu Medien an. Wenn diese Richtlinie deaktiviert ist, sind diese Empfehlungen für den Nutzer nicht sichtbar. Wenn sie aktiviert oder nicht konfiguriert ist, werden dem Nutzer die Empfehlungen zu Medien angezeigt.";
MediaRouterCastAllowAllIPs.pfm_title = "Google Cast erlauben, eine Verbindung zu Übertragungsgeräten unter allen IP-Adressen herzustellen.";
MediaRouterCastAllowAllIPs.pfm_description = "Wenn EnableMediaRouter aktiviert und MediaRouterCastAllowAllIPs konfiguriert ist, wird Google Cast unter allen IP-Adressen und nicht nur unter privaten RFC1918-/RFC4193-Adressen mit Übertragungsgeräten verbunden.\n\nIst die Richtlinie deaktiviert, wird Google Cast nur unter RFC1918-/RFC4193-Adressen mit Cast-Geräten verbunden.\n\nWenn die Richtlinie nicht konfiguriert und die Funktion „CastAllowAllIPs“ deaktiviert ist, wird Google Cast nur unter RFC1918-/RFC4193-Adressen mit Übertragungsgeräten verbunden.";
MemorySaverModeSavings.pfm_title = "Einsparungen im Arbeitsspeicher-Sparmodus ändern";
MemorySaverModeSavings.pfm_description = "0 - Moderate Arbeitsspeichereinsparungen.\n1 - Ausgewogene Arbeitsspeichereinsparungen.\n2 - Maximale Arbeitsspeichereinsparungen.\nMit dieser Richtlinie wird der Arbeitsspeicher-Sparmodus reguliert.\n\nSie ist nur wirksam, wenn der Arbeitsspeicher-Sparmodus über die Einstellungen oder die Richtlinie „HighEfficiencyModeEnabled“ aktiviert wurde. Außerdem wirkt sie sich darauf aus, wie anhand von Heuristiken bestimmt wird, wann Tabs verworfen werden. Wenn du beispielsweise die Lebensdauer eines inaktiven Tabs reduzierst, bevor du ihn verwirfst, wird Arbeitsspeicher gespart. Allerdings werden Tabs dann auch häufiger aktualisiert, was sich negativ auf die Nutzerfreundlichkeit auswirken und zu mehr Netzwerkverkehr führen kann.\n\nWenn du die Richtlinie auf „0“ setzt, sorgt der Arbeitsspeicher-Sparmodus für mäßige Arbeitsspeichereinsparungen. Tabs werden nach längerer Zeit inaktiv.\n\nWenn du die Richtlinie auf „1“ setzt, sorgt der Arbeitsspeicher-Sparmodus für ausgewogene Arbeitsspeichereinsparungen. Tabs werden nach einer optimalen Zeitspanne inaktiv.\n\nWenn du die Richtlinie auf „2“ setzt, sorgt der Arbeitsspeicher-Sparmodus für maximale Arbeitsspeichereinsparungen. Tabs werden nach kürzerer Zeit inaktiv.\n\nWenn die Richtlinie nicht konfiguriert ist, kann der Endnutzer diese Einstellung unter chrome://settings/performance verwalten.";
MetricsReportingEnabled.pfm_title = "Berichte mit Nutzungs- und Absturzdaten erstellen";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "Karten auf der „Neuer Tab“-Seite anzeigen";
NTPCardsVisible.pfm_description = "Diese Richtlinie legt die Sichtbarkeit von Karten auf der „Neuer Tab“-Seite fest. Karten bringen Zugangspunkte hervor, die allgemeine Nutzerabläufe starten, abhängig vom Browserverhalten des Nutzers.\n\nWenn die Richtlinie aktiviert ist, zeigt die „Neuer Tab“-Seite Karten an, sofern Inhalte vorhanden sind.\n\nIst die Richtlinie deaktiviert, zeigt die „Neuer Tab“-Seite keine Karten an.\n\nWenn die Richtlinie nicht konfiguriert ist, können Nutzer die Sichtbarkeit von Karten steuern. Standardmäßig sind Karten sichtbar.\n";
NTPCustomBackgroundEnabled.pfm_title = "Nutzern erlauben, den Hintergrund auf der \"Neuer Tab\"-Seite anzupassen";
NTPCustomBackgroundEnabled.pfm_description = "Wenn diese Richtlinie auf „false“ gesetzt ist, können Nutzer auf der Seite „Neuer Tab“ den Hintergrund nicht anpassen. Falls bereits ein benutzerdefinierter Hintergrund vorhanden ist, wird er dauerhaft entfernt, auch wenn die Richtlinie später auf „true“ gesetzt wird.\n\nWenn die Richtlinie auf „true“ gesetzt oder nicht konfiguriert ist, können Nutzer den Hintergrund auf der Seite „Neuer Tab“ anpassen.\n\nHinweis: Unter Android wird die Richtlinie erst nach dem Neustart auf den Browser angewendet.";
NTPFooterExtensionAttributionEnabled.pfm_title = "Sichtbarkeit der Namensnennung für Erweiterungen auf der Seite „Neuer Tab“ steuern";
NTPFooterExtensionAttributionEnabled.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob in der Fußzeile der Seite „Neuer Tab“ eine Namensnennung für die Erweiterung angezeigt wird, die die Seite „Neuer Tab“ ändert.\n\nWenn eine Erweiterung die Standardseite „Neuer Tab“ überschreibt, wird standardmäßig eine Meldung in der Fußzeile angezeigt, die diese Änderung der entsprechenden Erweiterung zuordnet. Die Meldung enthält in der Regel einen Link zu der Erweiterung im Chrome Web Store.\n\nIst diese Richtlinie auf „true“ gesetzt oder nicht konfiguriert, wird die Namensnennung für die Erweiterung in der Fußzeile der Seite „Neuer Tab“ angezeigt, wenn diese Seite von einer Erweiterung gesteuert wird.\n\nIst die Richtlinie auf „false“ gesetzt, wird keine Namensnennung für die Erweiterung in der Fußzeile der Seite „Neuer Tab“ angezeigt.";
NTPFooterManagementNoticeEnabled.pfm_title = "Sichtbarkeit des Verwaltungshinweises auf der Seite „Neuer Tab“ für verwaltete Browser steuern";
NTPFooterManagementNoticeEnabled.pfm_description = "Mit dieser Richtlinie wird die Sichtbarkeit des Verwaltungshinweises in der Fußzeile der Seite „Neuer Tab“ festgelegt. Standardmäßig werden in dieser Fußzeile Informationen angezeigt, wenn der Browser von einer Organisation verwaltet wird (angegeben durch ein Gebäudesymbol und „Verwaltet von [Domainname]“). Dies kann mithilfe der Richtlinien „EnterpriseCustomLabelForBrowser“ und „EnterpriseLogoUrlForBrowser“ angepasst werden.\n\nWenn diese Richtlinie nicht konfiguriert oder auf „true“ gesetzt ist, werden in verwalteten Browsern der Hinweis „Verwaltet von…“ und ein Symbol angezeigt.\n\nIst sie auf „false“ gesetzt, wird der Verwaltungshinweis ausgeblendet.\n\nDiese Richtlinie wird nur auf verwaltete Browser angewendet. Sie hat also keine Auswirkungen auf verwaltete Nutzer von nicht verwalteten Browsern.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
NTPOutlookCardVisible.pfm_title = "Karte mit Outlook-Kalender auf der Seite „Neuer Tab“ anzeigen";
NTPOutlookCardVisible.pfm_description = "Mit dieser Richtlinie wird die Sichtbarkeit der Outlook-Karte auf der Seite „Neuer Tab“ festgelegt. Die Karte wird nur auf der Seite „Neuer Tab“ angezeigt, wenn die Richtlinie aktiviert ist und deine Organisation die Verwendung der Outlook-Kalenderdaten im Browser zulässt.\n\nOutlook-Daten werden nicht vom Browser gespeichert.\n\nAuf der Outlook-Karte werden der nächste Kalendertermin sowie eine Übersicht zu den verbleibenden Besprechungen des Tages angezeigt. Sie dient dazu, den Kontextwechsel zu erleichtern und die Produktivität zu steigern, indem Nutzer eine Verknüpfung zu ihrer nächsten Besprechung erhalten.\n\nDie Microsoft Outlook-Karte muss von einem Administrator konfiguriert werden. Detaillierte Informationen zum Verknüpfen der Chrome-Karte für die Seite „Neuer Tab“ mit Outlook findest du unter https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nWenn die Richtlinie NTPCardsVisible deaktiviert ist, wird die Outlook-Karte nicht angezeigt. Ist NTPCardsVisible aktiviert, wird die Outlook-Karte angezeigt, wenn diese Richtlinie ebenfalls aktiviert ist und Daten vorhanden sind, die angezeigt werden können. Wenn NTPCardsVisible nicht konfiguriert ist, wird die Outlook-Karte angezeigt, wenn diese Richtlinie ebenfalls aktiviert ist, der Nutzer die Karte in „Chrome anpassen“ aktiviert hat und Daten vorhanden sind, die angezeigt werden können.";
NTPSharepointCardVisible.pfm_title = "Karte mit SharePoint- und OneDrive-Dateien auf der Seite „Neuer Tab“ anzeigen";
NTPSharepointCardVisible.pfm_description = "Mit dieser Richtlinie wird die Sichtbarkeit der Karte mit SharePoint- und OneDrive-Dateien auf der Seite „Neuer Tab“ festgelegt. Die Karte wird nur auf der Seite „Neuer Tab“ angezeigt, wenn die Richtlinie aktiviert ist und deine Organisation die Verwendung der SharePoint- und OneDrive-Daten im Browser zulässt.\n\nSharePoint- und OneDrive-Daten werden nicht vom Browser gespeichert.\n\nDie Karte mit Empfehlungen für SharePoint- und OneDrive-Dateien enthält eine Liste empfohlener Dateien.  Sie dient dazu, den Kontextwechsel zu erleichtern und die Produktivität zu steigern, indem Nutzer eine Verknüpfung zu ihren wichtigsten Dokumenten erhalten.\n\nDie Microsoft SharePoint- und OneDrive-Karte muss von einem Administrator konfiguriert werden. Detaillierte Informationen zum Verknüpfen der Chrome-Karte für die Seite „Neuer Tab“ mit SharePoint findest du unter https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nWenn die Richtlinie NTPCardsVisible deaktiviert ist, wird die SharePoint- und OneDrive-Karte nicht angezeigt. Ist NTPCardsVisible aktiviert, wird die SharePoint- und OneDrive-Karte angezeigt, wenn diese Richtlinie ebenfalls aktiviert ist und Daten vorhanden sind, die angezeigt werden können. Wenn NTPCardsVisible nicht konfiguriert ist, wird die SharePoint- und OneDrive-Karte angezeigt, wenn diese Richtlinie ebenfalls aktiviert ist, der Nutzer die Karte in „Chrome anpassen“ aktiviert hat und Daten vorhanden sind, die angezeigt werden können.";
NTPShortcuts.pfm_title = "Verknüpfungen auf der Seite „Neuer Tab“ einrichten";
NTPShortcuts.pfm_description = "Wenn du diese Richtlinie festlegst, werden in Brave auf der Seite „Neuer Tab“ bis zu 10 benutzerdefinierte Verknüpfungen vorkonfiguriert.\n\nWenn diese Richtlinie festgelegt ist, sehen Nutzer diese Verknüpfungen standardmäßig zusätzlich zu ihren persönlichen Verknüpfungen. Nutzer können die Sichtbarkeit der Verknüpfungen ihrer Organisation im Bereich „Chrome anpassen“ steuern.\n\nURLs von Verknüpfungen müssen eindeutig sein.\n\nWenn die Richtlinie „allow_user_edit“ auf „true“ festgelegt ist, können Nutzer den Namen der Verknüpfung ändern. Wenn die Richtlinie auf „false“ oder nicht festgelegt ist, können Nutzer den Namen nicht bearbeiten.\n\nWenn die Richtlinie „allow_user_delete“ auf „true“ festgelegt ist, können Nutzer die Verknüpfung entfernen. Wenn die Richtlinie auf „false“ oder nicht festgelegt ist, können Nutzer die Verknüpfung nicht entfernen.\nUnter https://chromeenterprise.google/policies/?policy=NTPShortcuts erhältst du weitere Informationen zu Schema und Formatierung.";
NativeMessagingAllowlist.pfm_title = "Namen der Hosts für natives Messaging, die von der Sperrliste ausgenommen werden sollen";
NativeMessagingAllowlist.pfm_description = "Wenn diese Richtlinie konfiguriert ist, wird festgelegt, welche nativen Nachrichtenhosts nicht der Liste der blockierten nativen Hosts unterliegen. Der Wert * in der Liste der blockierten nativen Hosts gibt an, dass alle nativen Nachrichtenhosts gesperrt sind, sofern sie nicht ausdrücklich zugelassen wurden.\n\nStandardmäßig sind alle nativen Nachrichtenhosts zulässig. Wurden jedoch alle nativen Nachrichtenhosts durch eine Richtlinie gesperrt, kann der Administrator diese Richtlinie mithilfe der Zulassungsliste ändern.";
NativeMessagingBlocklist.pfm_title = "Namen der unzulässigen Hosts für natives Messaging (oder \"*\" für alle)";
NativeMessagingBlocklist.pfm_description = "Wenn diese Richtlinie konfiguriert ist, wird festgelegt, welche nativen Nachrichtenhosts nicht geladen werden dürfen. Der Wert * in der Liste der blockierten nativen Hosts gibt an, dass alle nativen Nachrichtenhosts gesperrt sind, sofern sie nicht ausdrücklich zugelassen wurden.\n\nWenn die Richtlinie nicht konfiguriert ist, werden alle installierten nativen Nachrichtenhosts von Brave geladen.";
NativeMessagingUserLevelHosts.pfm_title = "Hosts für natives Messaging, die ohne Berechtigung des Administrators installiert wurden, auf Nutzerebene zulassen";
NativeMessagingUserLevelHosts.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, kann Brave auf Nutzerebene installierte native Nachrichtenhosts verwenden.\n\nIst die Richtlinie deaktiviert, kann Brave diese Hosts nur verwenden, wenn sie auf Systemebene installiert wurden.";
NetworkPredictionOptions.pfm_title = "Netzwerkvorhersage aktivieren";
NetworkPredictionOptions.pfm_description = "0 - Netzwerkaktionen über alle Netzwerkverbindungen vervollständigen\n1 - Netzwerkaktionen in allen Netzwerken außer Mobilfunknetzen vorhersagen.\n(Eingestellt in 50, entfernt in 52. Wird nach 52 der Wert 1 konfiguriert, wird er als 0 – \"Netzwerkaktionen über alle Netzwerkverbindungen vervollständigen\" behandelt.)\n2 - Netzwerkaktionen nicht über Netzwerkverbindungen vervollständigen\nMit dieser Richtlinie wird die Netzwerkvorhersage bei Brave gesteuert. Mit ihr werden der DNS-Vorabruf, die TCP- und SSL-Vorverbindung sowie das Pre-Rendering von Webseiten gesteuert.\n\nWenn du diese Richtlinie konfigurierst, kann sie von Nutzern nicht geändert werden. Wenn sie nicht konfiguriert ist, wird die Netzwerkvorhersage aktiviert, aber sie kann von Nutzern nicht geändert werden.";
NewTabPageLocation.pfm_title = "URL für \"Neuer Tab\"-Seite";
NewTabPageLocation.pfm_description = "Konfiguriert die standardmäßige URL für die „Neuer Tab“-Seite und hindert Nutzer daran, sie zu ändern.\n\nDie „Neuer Tab“-Seite wird geöffnet, wenn ein neuer Tab erstellt oder ein neues Fenster geöffnet wird.\n\nDiese Richtlinie legt nicht fest, welche Seiten beim Start geöffnet werden. Diese werden von den Richtlinien „RestoreOnStartup“ festgelegt. Die Richtlinie hat auch Auswirkungen auf die Startseite und auf die „Beim Start“-Seite, falls für diese festgelegt wurde, dass die „Neuer Tab“-Seite geöffnet werden soll.\n\nAls Best Practice hat es sich bewährt, ausschließlich kanonische URLs zu verwenden. Falls die URL nicht kanonisch ist, öffnet Brave standardmäßig https://.\n\nWird die Richtlinie nicht konfiguriert oder leer gelassen, wird die standardmäßige „Neuer Tab“-Seite verwendet.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
NotificationsAllowedForUrls.pfm_title = "Benachrichtigungen auf diesen Websites zulassen";
NotificationsAllowedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Benachrichtigungen anzeigen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultNotificationsSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig.";
NotificationsBlockedForUrls.pfm_title = "Benachrichtigungen auf diesen Websites blockieren";
NotificationsBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, die angeben, welche Websites keine Benachrichtigungen anzeigen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultNotificationsSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig.";
NtlmV2Enabled.pfm_title = "NTLMv2-Authentifizierung aktivieren.";
NtlmV2Enabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, wird NTLMv2 aktiviert.\n\nWenn die Richtlinie deaktiviert ist, wird NTLMv2 deaktiviert.\n\nAlle aktuellen Versionen der Samba- und Microsoft® Windows®-Server unterstützen NTLMv2. Eine Deaktivierung sollte nur zum Zweck der Abwärtskompatibilität erfolgen und verringert die Sicherheit der Authentifizierung.";
OopPrintDriversAllowed.pfm_title = "Out-of-Process-Druckertreiber zulässig";
OopPrintDriversAllowed.pfm_description = "Legt fest, ob Brave mit Druckertreibern aus einem separaten Dienstprozess interagiert. Aufrufe zum Drucken über die Plattform, um verfügbare Drucker abzufragen, Druckertreiber-Einstellungen abzurufen und Dokumente zum Druck an lokale Drucker zu übermitteln, erfolgen über einen Dienstprozess. Wenn man solche Aufrufe aus dem Browserprozess hinaus verschiebt, verbessert dies die Stabilität und reduziert das Einfrieren der Benutzeroberfläche in der Druckvorschau.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, verwendet Brave einen separaten Dienstprozess für das Drucken über die Plattform.\n\nWenn diese Richtlinie deaktiviert ist, verwendet Brave den Browserprozess für das Drucken über die Plattform.\n\nDiese Richtlinie wird entfernt, nachdem die Funktion für Out-of-Process-Druckertreiber vollständig eingeführt wurde.";
OriginAgentClusterDefaultEnabled.pfm_title = "Diese Richtlinie erlaubt standardmäßig das an Ursprünge gebundene Agent-Clustering.";
OriginAgentClusterDefaultEnabled.pfm_description = "Diese Richtlinie erlaubt standardmäßig das an Ursprünge gebundene Agent-Clustering.\n\nDer HTTP-Header „Origin-Agent-Cluster“ legt fest, ob ein Dokument in einem an Ursprünge gebundenen Agent-Cluster oder einem an Websites gebundenen Agent-Cluster isoliert wird. Dies hat Auswirkungen auf die Sicherheit, da an Ursprünge gebundene Agent-Cluster die Isolation von Dokumenten nach Ursprung erlauben. Die Folge für Entwickler ist, dass die Zugriffsfunktion „document.domain“ nicht mehr festgelegt werden kann.\n\nDas Standardverhalten – wenn der Header „Origin-Agent-Cluster“ nicht konfiguriert ist – ändert sich in M111 von „an Websites gebunden“ zu „an Ursprünge gebunden“.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, folgt der Browser ab dieser Version dem neuen Standardverhalten.\n\nWenn diese Richtlinie deaktiviert ist, wird die Änderung rückgängig gemacht und Dokumente ohne den Header „Origin-Agent-Cluster“ werden Agent-Clustern zugewiesen, die an Websites gebunden sind. Die Zugriffsfunktion „document.domain“ lässt sich dann standardmäßig konfigurieren. Dies entspricht dem Verhalten älterer Versionen.\n\nWeitere Informationen findest du unter https://developer.chrome.com/blog/immutable-document-domain/.";
OriginKeyedProcessesEnabled.pfm_title = "Die an Ursprünge gebundene Prozessisolierung wird standardmäßig aktiviert.";
OriginKeyedProcessesEnabled.pfm_description = "Aktiviert die an Ursprünge gebundene Prozessisolierung für die meisten Seiten (d. h. für die, die standardmäßig einem an Ursprünge gebundenen Agent-Cluster zugewiesen sind). Dies verbessert die Sicherheit, erhöht aber auch die Anzahl der erstellten Prozesse. Nutzer können den festgelegten Richtlinienwert über die Befehlszeilen-Flags oder chrome://flags überschreiben (sowohl zum Aktivieren als auch zum Deaktivieren dieser Funktion).\n\nWenn die Richtlinie aktiviert ist, werden die meisten Ursprünge isoliert, auch von anderen Ursprüngen auf derselben Website. Siehe auch die Richtlinien „IsolateOrigins“ und „SitePerProcess“.\n\nWenn die Richtlinie deaktiviert ist, werden keine Ursprünge vom Rest der Website isoliert, es sei denn, dies wird von einem Ursprung ausdrücklich gefordert.\n\nWird die Richtlinie nicht konfiguriert, legt der Browser fest, welche Ursprünge wann isoliert werden.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "Ursprünge oder Hostnamenmuster, für die Einschränkungen für unsichere Ursprünge nicht gelten sollen";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "Mit dieser Richtlinie wird eine Liste von Ursprüngen (URLs) oder Hostnamenmustern wie „*.beispiel.de“ festgelegt, für die keine Sicherheitsbeschränkungen für unsichere Ursprünge gelten. Muster werden nur für Hostnamen akzeptiert. URLs/Ursprünge mit Schemas müssen exakte Strings sein. Organisationen können Ursprünge für ältere Anwendungen, die kein TLS bereitstellen können, angeben oder einen Testserver für die interne Webentwicklung einrichten, damit die Entwickler Funktionen testen können, die einen sicheren Kontext erfordern, ohne TLS auf dem Testserver bereitstellen zu müssen. Außerdem wird mit dieser Richtlinie verhindert, dass der Ursprung in der Adressleiste als „Nicht sicher“ gekennzeichnet wird.\n\nDas Festlegen einer Liste von URLs in dieser Richtlinie hat den gleichen Effekt wie das Festlegen des Befehlszeilen-Flags „--unsafely-treat-insecure-origin-as-secure“ für eine durch Kommas getrennte Liste mit denselben URLs. Die Richtlinie überschreibt das Befehlszeilen-Flag und „UnsafelyTreatInsecureOriginAsSecure“, sofern vorhanden.\n\nWeitere Informationen zu sicheren Kontexten findest du unter https://www.w3.org/TR/secure-contexts.";
PartitionedBlobUrlUsage.pfm_title = "Legt fest, ob Blob-URLs beim Abrufen und Navigieren partitioniert werden";
PartitionedBlobUrlUsage.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob Blob-URLs beim Abrufen und Navigieren partitioniert werden.\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, werden Blob-URLs partitioniert.\nIst die Richtlinie deaktiviert, werden Blob-URLs nicht partitioniert.\n\nFalls du die Richtlinie verwenden musst, melde auf Brave einen Fehler unter Angabe deines Anwendungsfalls. Die Richtlinie kann bis zum Ende von Version 146 von Brave verwendet werden. Danach wird die alte Implementierung entfernt.\n\nHINWEIS: Während der Browser ausgeführt wird, werden Änderungen an dieser Richtlinie nur für neu gestartete Rendererprozesse übernommen.\n\nAusführliche Informationen zur Drittanbieter-Speicherpartitionierung findest du unter https://developers.google.com/privacy-sandbox/cookies/storage-partitioning.";
PasswordDismissCompromisedAlertEnabled.pfm_title = "Schließen von Warnungen zu gehackten Passwörtern für eingegebene Anmeldedaten aktivieren";
PasswordDismissCompromisedAlertEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, haben Nutzer die Möglichkeit, Warnungen zu kompromittierten Passwörtern zu schließen und wiederherzustellen.\n\nWird die Richtlinie deaktiviert, können Nutzer Warnungen zu kompromittierten Passwörtern nicht schließen. Ist sie aktiv, können Nutzer Warnungen zu kompromittierten Passwörtern schließen.";
PasswordLeakDetectionEnabled.pfm_title = "Datenleck-Erkennung für eingegebene Anmeldedaten aktivieren";
PasswordLeakDetectionEnabled.pfm_description = "Wenn die Richtlinie aktiviert ist, können Nutzer von Brave prüfen lassen, ob die eingegebenen Nutzernamen und Passwörter Teil eines Datenlecks sind.\n\nIst die Richtlinie deaktiviert, können Nutzer diese Funktion nicht verwenden.\n\nIst die Richtlinie konfiguriert, können Nutzer sie in Brave nicht ändern. Ist die Richtlinie nicht konfiguriert, ist die Datenleckprüfung für Anmeldedaten zulässig, kann jedoch vom Nutzer deaktiviert werden.";
PasswordManagerBlocklist.pfm_title = "Liste der Domains konfigurieren, für die der Password Manager und das Speichern und Ausfüllen deaktiviert werden soll";
PasswordManagerBlocklist.pfm_description = "Konfiguriere die Liste der Domains, in denen Brave den Password Manager deaktivieren soll. Dadurch werden die Workflows „Speichern“ und „Ausfüllen“ deaktiviert, sodass Passwörter für diese Websites nicht gespeichert oder automatisch in Webformularen ausgefüllt werden.\n\nWenn eine Domain in der Liste aufgeführt ist, wird der Password Manager für diese deaktiviert.\n\nIst eine Domain nicht in der Liste enthalten, ist der Password Manager für diese verfügbar.\n\nWenn die Richtlinie nicht konfiguriert ist, ist der Password Manager für alle Domains verfügbar.\n\nWeitere Informationen zu gültigen URL-Mustern findest du unter https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
PasswordManagerEnabled.pfm_title = "Aktiviert das Speichern von Passwörtern im Passwortmanager";
PasswordManagerEnabled.pfm_description = "Diese Richtlinie legt fest, ob der Browser Passwörter auf Websites und im integrierten Passwortmanager automatisch speichert. Der Zugriff auf Passwörter, die im Passwortmanager gespeichert und möglicherweise mit dem Profil des Google-Kontos und mit Android synchronisiert wurden, wird dadurch nicht eingeschränkt. Passwörter werden auch nicht geändert.\n\nWenn die Richtlinie aktiviert ist, können Nutzer anfordern, dass Brave Passwörter speichert und sie bei der nächsten Anmeldung auf einer Website bereitstellt.\n\nIst die Richtlinie deaktiviert, können Nutzer keine neuen Passwörter speichern lassen. Zuvor gespeicherte Passwörter funktionieren aber weiterhin.\n\nIst die Richtlinie festgelegt, können Nutzer sie in Brave nicht ändern. Wenn die Richtlinie nicht konfiguriert ist, können Nutzer das Speichern von Passwörtern deaktivieren.";
PasswordManagerPasskeysEnabled.pfm_title = "Speichern von Passkeys im Passwortmanager aktivieren";
PasswordManagerPasskeysEnabled.pfm_description = "Diese Richtlinie legt fest, ob der Browser Passkeys im integrierten Passwortmanager speichern kann. Der Zugriff auf Passkeys, die bereits im Passwortmanager gespeichert sind, wird dadurch nicht eingeschränkt. Passkeys werden auch nicht geändert. Wenn die Richtlinie „PasswordManagerEnabled“ deaktiviert ist, ist das Speichern im integrierten Passwortmanager generell deaktiviert, auch für Passkeys und Passwörter. Diese Richtlinie ist dann nicht anwendbar.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer Passkeys im integrierten Passwortmanager speichern, wenn sie in Brave angemeldet sind.\n\nIst die Richtlinie deaktiviert, können Nutzer keine Passkeys im integrierten Passwortmanager speichern. Zuvor gespeicherte Passkeys funktionieren aber weiterhin.";
PasswordProtectionChangePasswordURL.pfm_title = "Hiermit wird die URL zur Passwortänderung konfiguriert.";
PasswordProtectionChangePasswordURL.pfm_description = "Wenn diese Richtlinie konfiguriert ist, wird die URL für Nutzer festgelegt, über die sie ihr Passwort ändern können, nachdem ihnen im Browser eine Warnung angezeigt wurde. Der Passwortschutzdienst leitet Nutzer weiter zu der URL (nur HTTP- und HTTPS-Protokolle), die du mit dieser Richtlinie festlegst. Die Seite zum Ändern des Passworts muss den Richtlinien unter https://www.chromium.org/developers/design-documents/create-amazing-password-forms entsprechen, damit der Salted-Hash-Wert des neuen Passworts in Brave richtig erfasst werden kann.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, werden Nutzer durch den Dienst an https://myaccount.google.com weitergeleitet, um ihr Passwort zu ändern.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
PasswordProtectionLoginURLs.pfm_title = "Hiermit wird die Liste der URLs für die Unternehmensanmeldung konfiguriert, auf denen der Passwortschutzdienst den Salted-Hash-Wert von Passwörtern erfassen soll.";
PasswordProtectionLoginURLs.pfm_description = "Mit dieser Richtlinie kannst du die Liste der URLs für die Unternehmensanmeldung festlegen (nur HTTP- und HTTPS-Protokolle). Der Passwortschutzdienst erfasst auf diesen URLs den Salted-Hash-Wert von Passwörtern und verwendet ihn, um zu prüfen, ob Passwörter wiederverwendet werden. Deine Anmeldeseiten müssen den Richtlinien unter https://www.chromium.org/developers/design-documents/create-amazing-password-forms entsprechen, damit Salted-Hash-Werte von Passwörtern in Brave richtig erfasst werden können.\n\nIst diese Einstellung deaktiviert oder nicht konfiguriert, erfasst der Passwortschutzdienst die Salted-Hash-Werte von Passwörtern nur unter https://accounts.google.com.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
PasswordProtectionWarningTrigger.pfm_title = "Auslöser für Passwortschutzwarnung";
PasswordProtectionWarningTrigger.pfm_description = "0 - Passwortschutzwarnung ist ausgeschaltet\n1 - Die Passwortschutzwarnung wird durch die Wiederverwendung eines Passworts ausgelöst\n2 - Die Passwortschutzwarnung wird durch die Wiederverwendung eines Passworts auf einer Phishingseite ausgelöst\nMit dieser Richtlinie kannst du das Auslösen der Passwortschutzwarnung steuern. Durch diese Meldung werden Nutzer gewarnt, wenn sie ihr geschütztes Passwort auf potenziell verdächtigen Websites wiederverwenden.\n\nAnhand der Richtlinien PasswordProtectionLoginURLs und PasswordProtectionChangePasswordURL kannst du konfigurieren, welche Passwörter geschützt werden sollen.\n\nWenn die Richtlinie auf\n\n* PasswordProtectionWarningOff festgelegt ist, wird keine Passwortschutzwarnung angezeigt.\n\n* PasswordProtectionWarningOnPasswordReuse festgelegt ist, wird die Passwortschutzwarnung angezeigt, wenn der Nutzer sein geschütztes Passwort auf einer Website wiederverwendet, die nicht auf der Zulassungsliste steht.\n\n* PasswordProtectionWarningOnPhishingReuse festgelegt ist, wird die Passwortschutzwarnung angezeigt, wenn der Nutzer sein geschütztes Passwort auf einer Phishing-Website wiederverwendet.\n\nWenn die Richtlinie nicht konfiguriert ist, werden ausschließlich Google-Passwörter geschützt. Der Nutzer kann diese Einstellung jedoch ändern.";
PasswordSharingEnabled.pfm_title = "Teilen von Nutzeranmeldedaten mit anderen Nutzern aktivieren";
PasswordSharingEnabled.pfm_description = "Wenn die Richtlinie aktiviert ist, können Nutzer ihre Passwörter gemäß den Familiendiensten an Familienmitglieder senden und von ihnen empfangen.\nIst sie aktiviert oder nicht konfiguriert, gibt es im Passwortmanager einen Button, über die ein Passwort gesendet werden kann.\nEmpfangene Passwörter werden im Konto des Nutzers gespeichert und sind im Passwortmanager verfügbar.\n\nIst die Richtlinie deaktiviert, können Nutzer keine Passwörter vom Passwortmanager aus an andere Nutzer senden und auch keine Passwörter von anderen Nutzern empfangen.\n\nDie Funktion ist nicht verfügbar, wenn die Synchronisierung von Passwörtern deaktiviert ist (entweder über die Nutzereinstellungen oder wenn die Richtlinie „SyncDisabled“ aktiviert ist).\n\nVerwaltete Konten können keiner Familiengruppe beitreten oder eine erstellen und können daher keine Passwörter teilen.";
PaymentMethodQueryEnabled.pfm_title = "Websites erlauben, verfügbare Zahlungsmethoden abzufragen.";
PaymentMethodQueryEnabled.pfm_description = "Mit dieser Richtlinie kannst du Websites erlauben zu prüfen, ob ein Nutzer Zahlungsmethoden gespeichert hat.\n\nWenn sie deaktiviert ist, werden Websites, die die APIs \"PaymentRequest.canMakePayment\" oder \"PaymentRequest.hasEnrolledInstrument\" verwenden, informiert, dass keine Zahlungsmethoden verfügbar sind.\n\nWenn die Einstellung aktiviert oder nicht konfiguriert ist, dürfen Websites prüfen, ob ein Nutzer Zahlungsmethoden gespeichert hat.";
PdfAnnotationsEnabled.pfm_title = "PDF-Anmerkungen aktivieren";
PdfAnnotationsEnabled.pfm_description = "Legt fest, ob mit dem PDF-Viewer PDFs in Brave mit Anmerkungen versehen werden können.\n\nWenn diese Richtlinie nicht konfiguriert oder auf „true“ gesetzt ist, können mit dem PDF-Viewer PDFs mit Anmerkungen versehen werden.\n\nWenn diese Richtlinie auf „false“ gesetzt ist, können mit dem PDF-Viewer PDFs nicht mit Anmerkungen versehen werden.";
PdfLocalFileAccessAllowedForDomains.pfm_title = "Lokalen Dateizugriff auf „file://“-URLs auf diesen Websites im PDF-Viewer zulassen";
PdfLocalFileAccessAllowedForDomains.pfm_description = "Wenn diese Richtlinie konfiguriert ist, können die aufgeführten Domains auf „file://“-URLs im PDF-Viewer zugreifen.\nWird der Richtlinie eine Domain hinzugefügt, kann diese auf „file://“-URLs im PDF-Viewer zugreifen.\nWird eine Domain aus der Richtlinie entfernt, kann diese nicht mehr auf „file://“-URLs im PDF-Viewer zugreifen.\nWenn die Richtlinie nicht konfiguriert ist, können keine Domains auf „file://“-URLs im PDF-Viewer zugreifen.";
PdfUseSkiaRendererEnabled.pfm_title = "Skia-Renderer für PDF-Rendering verwenden";
PdfUseSkiaRendererEnabled.pfm_description = "Legt fest, ob der PDF-Viewer in Brave den Skia-Renderer verwendet.\n\nWenn diese Richtlinie aktiviert ist, verwendet der PDF-Viewer den Skia-Renderer.\n\nWenn diese Richtlinie deaktiviert ist, verwendet er den aktuellen AGG-Renderer.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird der PDF-Renderer vom Browser ausgewählt.";
PolicyAtomicGroupsEnabled.pfm_title = "Gruppen aus Einzelrichtlinien aktivieren";
PolicyAtomicGroupsEnabled.pfm_description = "Ist diese Richtlinie aktiviert, werden Richtlinien aus atomischen Gruppen, die eine andere Quelle als die Quelle mit der höchsten Priorität der entsprechenden Gruppe haben, ignoriert.\n\nWenn die Richtlinie deaktiviert ist, wird keine Richtlinie aufgrund ihrer Quelle ignoriert. Richtlinien werden dann nur ignoriert, wenn ein Konflikt besteht und sie nicht die höchste Priorität haben.\n\nWird diese Richtlinie von einer cloudbasierten Quelle konfiguriert, kann sie nicht auf bestimmte einzelne Nutzer ausgerichtet werden.";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "Zusammenführen von Wörterbuchrichtlinien aus unterschiedlichen Quellen erlauben";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - Manuell festgelegte Ausnahme-URLs für verwalteten Nutzer\nDeviceLoginScreenPowerManagement - Energieverwaltung auf dem Anmeldebildschirm\nExtensionSettings - Verwaltungseinstellungen für Erweiterungen\nKeyPermissions - Hauptberechtigungen\nPowerManagementIdleSettings - Einstellungen für die Energieverwaltung bei Inaktivität des Nutzers\nScreenBrightnessPercent - Displayhelligkeit in %\nScreenLockDelays - Verzögerungen für die Bildschirmsperre\nWenn die Richtlinie konfiguriert ist, ermöglicht sie das Zusammenführen der ausgewählten Richtlinien, wenn diese aus unterschiedlichen Quellen stammen, mit gleichem Bereich und gleicher Ebene. Dabei werden die Schlüssel des Wörterbuchs auf der ersten Ebene aus jeder Quelle zusammengeführt. Der Schlüssel aus der Quelle mit der höchsten Priorität hat Vorrang.\n\nMit dem Platzhalterzeichen * kann das Zusammenführen aller unterstützten Wörterbuchrichtlinien erlaubt werden.\n\nWenn sich eine Richtlinie in der Liste befindet und ein Konflikt zwischen Quellen entsteht mit:\n\n* identischem Bereich und identischer Ebene: In diesem Fall werden die Werte zu einem neuen Richtlinienwörterbuch zusammengeführt.\n\n* unterschiedlichem Bereich und unterschiedlicher Ebene: In diesem Fall wird die Richtlinie mit der höchsten Priorität angewendet.\n\nSteht eine Richtlinie nicht auf der Liste und entsteht dadurch ein Konflikt zwischen Quellen, Bereichen oder Ebene, wird die Richtlinie mit der höchsten Priorität angewendet.";
PolicyListMultipleSourceMergeList.pfm_title = "Zusammenführen von Listenrichtlinien aus unterschiedlichen Quellen erlauben";
PolicyListMultipleSourceMergeList.pfm_description = "Wenn die Richtlinie konfiguriert ist, ermöglicht sie das Zusammenführen der ausgewählten Richtlinien, wenn diese aus unterschiedlichen Quellen stammen, mit gleichem Bereich und gleicher Ebene.\n\nMit dem Platzhalterzeichen * kann das Zusammenführen aller unterstützten Listenrichtlinien erlaubt werden.\n\nWenn sich eine Richtlinie auf der Liste befindet und dadurch ein Konflikt zwischen Quellen entsteht mit:\n\n* gleichem Bereich und gleicher Ebene: In diesem Fall werden die Werte zu einer neuen Richtlinienliste zusammengeführt.\n\n* unterschiedlichem Bereich und unterschiedlicher Ebene: In diesem Fall wird die Richtlinie mit der höchsten Priorität angewendet.\n\nSteht eine Richtlinie nicht auf der Liste und entsteht dadurch ein Konflikt zwischen Quellen, Bereichen oder Ebene, wird die Richtlinie mit der höchsten Priorität angewendet.";
PolicyRefreshRate.pfm_title = "Aktualisierungsrate für Nutzerrichtlinien";
PolicyRefreshRate.pfm_description = "Wenn die Richtlinie konfiguriert ist, wird der Zeitraum in Millisekunden angegeben, in dem Nutzerrichtlinieninformationen vom Geräteverwaltungsdienst abgefragt werden. Gültige Werte für diese Richtlinie liegen im Bereich zwischen 1.800.000 (30 Minuten) und 86.400.000 (1 Tag). Alle Werte, die nicht in diesem Bereich liegen, werden auf den jeweiligen Grenzwert gesetzt.\n\nIst diese Richtlinie nicht konfiguriert, gilt der Standardwert von 3 Stunden.\n\nHinweis: Richtlinienbenachrichtigungen erzwingen eine Aktualisierung, wenn sich die Richtlinie ändert. Häufige Aktualisierungen sind also nicht nötig. Wenn die Plattform Richtlinienbenachrichtigungen unterstützt, wird daher für die Verzögerung der Aktualisierung 24 Stunden festgelegt und alle Standardwerte der Richtlinie werden ignoriert.";
PopupsAllowedForUrls.pfm_title = "Pop-ups auf diesen Websites zulassen";
PopupsAllowedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Pop‑ups öffnen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultPopupsSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig.";
PopupsBlockedForUrls.pfm_title = "Pop-ups auf diesen Websites blockieren";
PopupsBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites keine Pop‑ups öffnen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultPopupsSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig.";
PreciseGeolocationAllowedForUrls.pfm_title = "Genaue Standortbestimmung auf diesen Websites zulassen";
PreciseGeolocationAllowedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, durch die angegeben wird, welchen Websites der Zugriff auf den im Modus „Hohe Genauigkeit“ ermittelten Standort des Nutzers erlaubt ist, ohne dass sie zuerst die Erlaubnis des Nutzers dafür einholen müssen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt für alle Websites die Einstellung „DefaultGeolocationSetting“, sofern sie festgelegt ist. Ist sie nicht festgelegt, wird die persönliche Einstellung des Nutzers verwendet.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig.";
PreferSlowCiphers.pfm_title = "Bestimmte Algorithmen für Verschlüsselungschiffren für TLS bevorzugen";
PreferSlowCiphers.pfm_description = "cnsa - Chiffren bevorzugen, die die Anforderungen von CNSA 1.0 und 2.0 erfüllen\ndefault - Standardreihenfolge von Brave für Chiffren verwenden\nDiese Richtlinie konfiguriert Brave so, dass die bevorzugten Verschlüsselungschiffren in TLS 1.3 so angeordnet werden, dass nach einer bestimmten Compliance-Regelung genehmigte Algorithmen bevorzugt werden.\n\nDurch das Festlegen dieser Richtlinie wird nicht garantiert, dass bestimmte Algorithmen ausgehandelt werden.\n\nDiese Richtlinie ermöglicht es Serverbetreibern, die Clients mit und ohne Compliance-Anforderungen unterstützen möchten, zwischen diesen Clients zu unterscheiden. Bestimmte nicht-standardmäßige Algorithmen mit erhöhter kryptografischer Stärke werden nur für diejenigen Clients verwendet, die ausdrücklich dazu konfiguriert wurden, diese Algorithmen zu bevorzugen.\n\nWird die Richtlinie auf „cnsa“ festgelegt, wird Brave so konfiguriert, dass die für die Compliance mit der Commercial National Security Algorithm Suite 1.0 und 2.0 (CNSA 1.0 und 2.0) erforderlichen Chiffren bevorzugt werden.\n\nWenn die Richtlinie nicht konfiguriert oder auf „default“ gesetzt ist, verwendet Brave seine standardmäßigen Chiffren.\n\nDas Festlegen dieser Richtlinie ist für die Sicherheit nicht erforderlich. Die Standardkryptografie, die von Brave verwendet wird, ist stark genug, um einem Brute-Force-Angriff mit der gesamten Energie der Sonne standzuhalten.\n\nIst diese Richtlinie festgelegt, wird Brave beim Zugriff auf Websites langsamer.\n\nDiese Richtlinie wirkt sich nur auf TLS 1.3 und QUIC aus, nicht jedoch auf frühere Versionen von TLS.\n\nDiese Richtlinie kann auf Geräteebene und auf Nutzerebene festgelegt werden. Wenn diese Richtlinie auf Nutzerebene festgelegt ist, wirkt sie sich nur auf Netzwerkanfragen aus, die vom Nutzerprofil initiiert werden. Sie wirkt sich möglicherweise nicht auf Netzwerkanfragen aus, die von Brave gestellt werden, um browserweite Hintergrundaufgaben auszuführen. Diese werden durch den Wert auf Computerebene gesteuert. Wenn diese Richtlinie sowohl auf Geräte- als auch auf Nutzerebene festgelegt ist, gilt der Wert auf Geräteebene, es sei denn, die Rangfolge der Richtlinien wurde durch die Richtlinie „CloudUserPolicyOverridesCloudMachinePolicy“ geändert.\n\nIn Version 155 und niedriger gilt diese Richtlinie nur geräteweit.";
PreferSlowKexAlgorithms.pfm_title = "Bestimmte Algorithmen zum Schlüsselaustausch für TLS bevorzugen";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - Schlüsselaustauschmethoden bevorzugen, die die Anforderungen von CNSA 2.0 erfüllen\ndefault - Standardmäßig unterstützte Gruppen von Brave verwenden\nDiese Richtlinie konfiguriert Brave so, dass die bevorzugten Algorithmen für Schlüsselvereinbarungen (unterstützte Gruppen) in TLS 1.3 so angeordnet werden, dass nach einer bestimmten Compliance-Regelung genehmigte Algorithmen bevorzugt werden.\n\nDurch das Festlegen dieser Richtlinie wird nicht garantiert, dass bestimmte Algorithmen ausgehandelt werden.\n\nDiese Richtlinie ermöglicht es Serverbetreibern, die Clients mit und ohne Compliance-Anforderungen unterstützen möchten, zwischen diesen Clients zu unterscheiden. Bestimmte nicht-standardmäßige Algorithmen mit erhöhter kryptografischer Stärke werden nur für diejenigen Clients verwendet, die ausdrücklich dazu konfiguriert wurden, diese Algorithmen zu bevorzugen.\n\nWird die Richtlinie auf „cnsa2“ festgelegt, wird Brave so konfiguriert, dass die für die Compliance mit der Commercial National Security Algorithm Suite 2.0 (CNSA 2.0) erforderlichen Methoden zum Schlüsselaustausch bevorzugt werden.\n\nWenn die Richtlinie nicht konfiguriert oder auf „default“ gesetzt ist, verwendet Brave seine standardmäßigen Methoden für den Schlüsselaustausch.\n\nDas Festlegen dieser Richtlinie ist für die Sicherheit nicht erforderlich. Die Standardkryptografie, die von Brave verwendet wird, ist stark genug, um einem Brute-Force-Angriff mit der gesamten Energie der Sonne standzuhalten.\n\nIst diese Richtlinie festgelegt, wird Brave beim Zugriff auf Websites langsamer.\n\nDiese Richtlinie wirkt sich nur auf TLS 1.3 und QUIC aus, nicht jedoch auf frühere Versionen von TLS.\n\nDiese Richtlinie kann auf Geräteebene und auf Nutzerebene festgelegt werden. Wenn diese Richtlinie auf Nutzerebene festgelegt ist, wirkt sie sich nur auf Netzwerkanfragen aus, die vom Nutzerprofil initiiert werden. Sie wirkt sich möglicherweise nicht auf Netzwerkanfragen aus, die von Brave gestellt werden, um browserweite Hintergrundaufgaben auszuführen. Diese werden durch den Wert auf Computerebene gesteuert. Wenn diese Richtlinie sowohl auf Geräte- als auch auf Nutzerebene festgelegt ist, gilt der Wert auf Geräteebene, es sei denn, die Rangfolge der Richtlinien wurde durch die Richtlinie „CloudUserPolicyOverridesCloudMachinePolicy“ geändert.\n\nIn Version 155 und niedriger gilt diese Richtlinie nur geräteweit.";
PrefetchWithServiceWorkerEnabled.pfm_title = "„SpeculationRules“-Prefetch für von ServiceWorkers gesteuerte URLs zulassen";
PrefetchWithServiceWorkerEnabled.pfm_description = "„SpeculationRules-Prefetch“ kann für URLs ausgegeben werden, die von ServiceWorkers gesteuert werden. Der alte Code erlaubte dies jedoch nicht und brach die Prefetch-Anfragen ab. Mit dieser Richtlinie lässt sich das Verhalten steuern.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, ist der „SpeculationRules“-Prefetch für von ServiceWorkers gesteuerte URLs zulässig. Dies gilt, wenn das Funktions-Flag „PrefetchServiceWorker“ aktiviert ist. Dies ist das aktuelle Standardverhalten und entspricht den Spezifikationen.\n\nWenn diese Richtlinie deaktiviert ist, wird der „SpeculationRules“-Prefetch für von ServiceWorkers gesteuerte URLs nicht zugelassen. Dies entspricht dem alten Verhalten.\n\nDiese Richtlinie ist vorübergehend und wird zukünftig entfernt.";
PrintHeaderFooter.pfm_title = "Kopf- und Fußzeilen drucken";
PrintHeaderFooter.pfm_description = "Wenn die Richtlinie aktiviert ist, werden Kopf- und Fußzeilen in der Druckvorschau angezeigt. Ist die Richtlinie deaktiviert, werden sie in der Druckvorschau ausgeblendet.\n\nWenn du diese Richtlinie konfigurierst, kann sie von Nutzern nicht geändert werden. Ist sie nicht konfiguriert, können die Nutzer festlegen, ob Kopf- und Fußzeilen angezeigt werden sollen.";
PrintPdfAsImageAvailability.pfm_title = "„PDF als Bild drucken“ verfügbar";
PrintPdfAsImageAvailability.pfm_description = "Steuert, wie Brave beim Drucken von PDFs die Option „Als Bild drucken“ unter Microsoft® Windows® und macOS verfügbar macht.\n\nWenn du unter Microsoft® Windows® oder macOS eine PDF-Datei druckst, müssen Druckaufträge manchmal als Bild gerastert werden, damit bestimmte Drucker eine optisch korrekte Ausgabe generieren.\n\nWenn diese Richtlinie aktiviert ist, macht Brave beim Drucken von PDFs die Option „Als Bild drucken“ in der Druckvorschau verfügbar.\n\nWenn diese Richtlinie deaktiviert oder nicht konfiguriert ist, macht Brave beim Drucken von PDFs die Option „Als Bild drucken“ nicht in der Druckvorschau verfügbar. In diesem Fall werden PDFs ganz normal gedruckt, d. h. es erfolgt vor dem Versenden an das Druckziel keine Rasterung als Bild.";
PrintPdfAsImageDefault.pfm_title = "Standardeinstellung „PDF als Bild drucken“";
PrintPdfAsImageDefault.pfm_description = "Legt fest, ob die Option „Als Bild drucken“ beim Drucken von PDFs in Brave die Standardeinstellung sein soll.\n\nWenn diese Richtlinie aktiviert ist, macht Brave beim Drucken von PDFs die Option „Als Bild drucken“ in der Druckvorschau verfügbar.\n\nWenn diese Richtlinie deaktiviert oder nicht konfiguriert ist, dann ist die Nutzerauswahl für die Option „Als Bild drucken“ in Brave erst einmal nicht aktiviert.  Der Nutzer kann sie für einzelne PDF-Druckaufträge auswählen, wenn die Option verfügbar ist.\n\nFür Microsoft® Windows® oder macOS gilt diese Richtlinie nur, wenn PrintPdfAsImageAvailability ebenfalls aktiviert ist.";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "Standarddrucker des Betriebssystems als Standardeinstellung verwenden";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "Wenn die Richtlinie aktiviert ist, verwendet Brave den Standarddrucker des Betriebssystems als Standardziel für die Druckvorschau.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, verwendet Brave den zuletzt genutzten Drucker als Standardziel für die Druckvorschau.";
PrintRasterizePdfDpi.pfm_title = "DPI für Druck gerasteter PDFs";
PrintRasterizePdfDpi.pfm_description = "Steuert beim Drucken gerasteter PDFs in Brave die Druckbildauflösung.\n\nBeim Drucken eines PDF mit der Option „Als Bild drucken“ kann es hilfreich sein, eine andere Druckauflösung anzugeben als in den Druckereinstellungen des Geräts oder für PDFs standardmäßig festgelegt.  Eine hohe Auflösung verlängert die Bearbeitungs- und Druckdauer deutlich, während bei einer niedrigen Auflösung mit einer beeinträchtigten Bildqualität zu rechnen ist.\n\nDiese Richtlinie gestattet die Angabe einer bestimmten Auflösung beim Rastern von PDFs für den Druck.\n\nWenn diese Richtlinie auf null gesetzt oder nicht konfiguriert ist, wird beim Rastern von Seitenbildern die Standardauflösung des Systems verwendet.";
PrinterTypeDenyList.pfm_title = "Druckertypen auf der \"Deny\"-Liste deaktivieren";
PrinterTypeDenyList.pfm_description = "privet - Zeroconf-basierte (mDNS + DNS-SD) Protokollziele (veraltet)\nextension - Erweiterungsbasierte Ziele\npdf - Das Ziel von „Als PDF speichern“ und das Ziel von „In Google Drive speichern“ auf Google Chrome OS-Geräten\nlocal - Lokale Druckziele\ncloud - Google Cloud Print (eingestellt)\nDruckertypen auf der Verweigerungsliste können nicht gefunden und die entsprechenden Eigenschaften nicht abgerufen werden.\n\nWenn alle Druckertypen auf die Verweigerungsliste gesetzt werden, sind keine Druckziele mehr verfügbar und es kann daher nicht mehr gedruckt werden.\n\nFür Versionen vor 102 gilt: Wird „cloud“ auf die Liste gesetzt, hat dies denselben Effekt, wie wenn die Richtlinie „CloudPrintSubmitEnabled“ auf „false“ gesetzt wird. Damit Google Cloud Print-Ziele sichtbar sind, muss die Richtlinie „CloudPrintSubmitEnabled“ auf „true“ gesetzt sein und „cloud“ darf nicht auf der Verweigerungsliste stehen. Ab Version 102 werden Google Cloud Print-Ziele nicht mehr unterstützt und unabhängig von den Richtlinienwerten nicht mehr angezeigt.\n\nWenn diese Richtlinie nicht konfiguriert oder eine leere Liste festgelegt ist, sind alle Druckertypen sichtbar.\n\nErweiterungsdrucker werden auch als Druckanbieterziele bezeichnet – hierzu zählen alle Druckziele, die zu einer Brave-Erweiterung gehören.\n\nLokale Drucker werden auch native Druckziele genannt – hierzu zählen Druckziele, die für lokale Geräte verfügbar sind, sowie freigegebene Netzwerkdrucker.";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "Druckmodus mit Hintergrundgrafiken einschränken";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - Drucken mit und ohne Hintergrundgrafiken zulassen\nenabled - Drucken nur mit Hintergrundgrafiken zulassen\ndisabled - Drucken nur ohne Hintergrundgrafiken zulassen\nSchränkt den Druckmodus mit Hintergrundgrafiken ein. Wenn die Richtlinie nicht konfiguriert ist, gelten keine Einschränkungen.";
PrintingBackgroundGraphicsDefault.pfm_title = "Standarddruckmodus mit Hintergrundgrafiken";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - Standardmäßig Druckmodus mit Hintergrundgrafiken aktivieren\ndisabled - Standardmäßig Druckmodus mit Hintergrundgrafiken deaktivieren\nÜberschreibt den Standarddruckmodus mit Hintergrundgrafiken.";
PrintingEnabled.pfm_title = "Drucken aktivieren";
PrintingEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer in „Brave“ drucken. Nutzer können diese Einstellung nicht ändern.\n\nIst die Richtlinie deaktiviert, können die Nutzer in „Brave“ nicht drucken. Im Dreipunkt-Menü, in den Erweiterungen und in JavaScript-Anwendungen ist die Option zum Drucken deaktiviert.";
PrintingPaperSizeDefault.pfm_title = "Standardmäßige Druckseitengröße";
PrintingPaperSizeDefault.pfm_description = "Überschreibt die standardmäßige Druckseitengröße.\n\nname sollte eines der aufgelisteten Formate oder \"custom\" enthalten, wenn sich die erforderliche Papiergröße nicht in der Liste befindet. Wenn der Wert \"custom\" angegeben wird, sollte die Property \"custom_size\" festgelegt werden. Sie beschreibt die gewünschte Höhe und Breite in Mikrometern. In anderen Fällen sollte die Property \"custom_size\" nicht verwendet werden. Richtlinien, die gegen diese Regeln verstoßen, werden ignoriert.\n\nWenn die Seitengröße auf dem vom Nutzer gewählten Drucker nicht verfügbar ist, wird diese Richtlinie ignoriert.\nUnter https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault erhältst du weitere Informationen zu Schema und Formatierung.";
ProfilePickerOnStartupAvailability.pfm_title = "Verfügbarkeit von Profil-Picker beim Start";
ProfilePickerOnStartupAvailability.pfm_description = "0 - Profil-Picker beim Start verfügbar\n1 - Profil-Picker beim Start deaktiviert\n2 - Profil-Picker beim Start erzwungen\nGibt an, ob der Profil-Picker beim Browser-Start aktiviert, deaktiviert oder erzwungen wird.\n\nStandardmäßig wird der Profil-Picker nicht angezeigt, wenn der Browser im Gast- oder Inkognitomodus gestartet wird, ein Profilverzeichnis und/oder URLs durch die Befehlszeile vorgegeben werden, das Öffnen einer App ausdrücklich angefordert wird, der Browser durch eine native Benachrichtigung gestartet wird, nur ein Profil verfügbar ist oder die Richtlinie „ForceBrowserSignin“ auf „True“ gesetzt ist.\n\nWenn „Aktiviert“ (0) ausgewählt ist oder die Richtlinie nicht konfiguriert wurde, wird der Profil-Picker standardmäßig beim Start angezeigt, kann jedoch durch den Nutzer aktiviert/deaktiviert werden.\n\nWenn „Deaktiviert“ (1) ausgewählt ist, wird der Profil-Picker nie angezeigt und die Einstellung kann nicht durch den Nutzer geändert werden.\n\nWenn „Erzwungen“ (2) ausgewählt ist, kann der Profil-Picker nicht durch den Nutzer unterdrückt werden. Der Profil-Picker wird auch dann angezeigt, wenn nur ein Profil verfügbar ist.";
ProfileReauthPrompt.pfm_title = "Nutzer auffordern, sich noch einmal für das Profil zu authentifizieren";
ProfileReauthPrompt.pfm_description = "0 - Nicht zur erneuten Authentifizierung auffordern\n1 - Zur erneuten Authentifizierung in einem Tab auffordern\nIst die Richtlinie auf „DoNotPrompt“ gesetzt oder nicht konfiguriert, fordert Brave den Nutzer nicht automatisch auf, sich noch einmal im Browser zu authentifizieren.\n\nWenn „PromptInTab“ festgelegt ist und die Authentifizierung des Nutzers abläuft, wird sofort ein neuer Tab mit der Google-Anmeldeseite geöffnet. Dies geschieht nur bei Verwendung von Chrome Sync.";
ProfileSeparationDomainExceptionList.pfm_title = "Zulassungsliste für die Unternehmensprofiltrennung bei sekundären Domains";
ProfileSeparationDomainExceptionList.pfm_description = "Ist diese Richtlinie konfiguriert, müssen Nutzer nach der Anmeldung im Konto kein neues, separates Profil erstellen.\n\nIst sie nicht konfiguriert, ist nach der Anmeldung im Konto über die aufgeführten Domains keine Erstellung eines neuen, separaten Profils erforderlich.\n\nFür diese Richtlinie kann ein leerer String festgelegt werden, sodass alle Nutzer nach der Anmeldung im Konto ein neues, separates Profil anlegen müssen.";
PromotionsEnabled.pfm_title = "Anzeigen von Werbeinhalten aktivieren";
PromotionsEnabled.pfm_description = "Wenn die Richtlinie auf „True“ gesetzt oder nicht konfiguriert ist, dürfen Nutzern in Brave Werbeinhalte zu Produkten angezeigt werden.\n\nIst sie auf „False“ gesetzt, dürfen in Brave keine Werbeinhalte zu Produkten angezeigt werden.\n\nDiese Einstellung steuert die Darstellung von Werbeinhalten, einschließlich Begrüßungsseiten, die Nutzern Hilfe bei der Anmeldung in Brave bieten, Brave als Standardbrowser des Nutzers festlegen oder Nutzer auf andere Weise über Produktfunktionen informieren.";
PromptForDownloadLocation.pfm_title = "Vor dem Download von Dateien nach dem Speicherort fragen";
PromptForDownloadLocation.pfm_description = "Wenn die Richtlinie aktiviert ist, werden Nutzer vor jedem Download nach dem gewünschten Speicherort gefragt. Ist die Richtlinie deaktiviert, beginnt der Download sofort und Nutzer werden nicht nach dem gewünschten Speicherort gefragt.\n\nIst diese Richtlinie nicht konfiguriert, können Nutzer diese Einstellung ändern.";
PromptOnMultipleMatchingCertificates.pfm_title = "Aufforderung, wenn mehrere Zertifikate passen";
PromptOnMultipleMatchingCertificates.pfm_description = "Diese Richtlinie legt fest, ob Nutzer aufgefordert werden, ein Clientzertifikat auszuwählen, wenn mehrere Zertifikate zu AutoSelectCertificateForUrls passen.\nIst die Richtlinie aktiviert, werden Nutzer aufgefordert, immer dann ein Clientzertifikat auszuwählen, wenn die Richtlinie für die automatische Auswahl zu mehreren Zertifikaten passt.\nWenn diese Richtlinie deaktiviert oder nicht konfiguriert ist, dürfen Nutzer nur dann aufgefordert werden, wenn kein Zertifikat zur automatischen Auswahl passt.";
ProxySettings.pfm_title = "Proxy-Einstellungen";
ProxySettings.pfm_description = "Durch Festlegen der Richtlinie werden die Proxy-Einstellungen für Chrome- und ARC-Apps so konfiguriert, dass alle Proxyoptionen, die über die Befehlszeile eingegeben werden, ignoriert werden.\n\nWird die Richtlinie nicht festgelegt, können Nutzer die Proxy-Einstellungen auswählen.\n\nDurch Festlegen der Richtlinie „ProxySettings“ werden die folgenden Felder übernommen:\n\n* „ProxyMode“ legt fest, welcher Proxyserver von Chrome verwendet werden soll, und verhindert, dass Nutzer die Proxy-Einstellungen ändern\n\n* „ProxyPacUrl“, eine URL zu einer .pac-Proxydatei oder ein PAC-Script, das als Daten-URL mit dem MIME-Typ „application/x-ns-proxy-autoconfig“ codiert ist\n\n* „ProxyPacMandatory“ sorgt dafür, dass der Netzwerkstapel auch bei ungültigem oder nicht verfügbarem PAC-Script keine direkten Verbindungen nutzt\n\n* „ProxyServer“, eine URL des Proxyservers\n\n* „ProxyBypassList“, eine Liste mit Hosts, für die der Proxy umgangen wird\n\nDas Feld „ProxyServerMode“ wurde zugunsten des Felds „ProxyMode“ eingestellt. Für „ProxyMode“ können folgende Werte festgelegt werden:\n\n* direct – kein Proxy wird verwendet und alle anderen Felder werden ignoriert.\n\n* system – der Proxy des Systems wird verwendet und alle anderen Felder werden ignoriert.\n\n* auto_detect – alle anderen Felder werden ignoriert.\n\n* fixed_servers – die Felder „ProxyServer“ und „ProxyBypassList“ werden verwendet.\n\n* pac_script – die Felder „ProxyPacUrl“, „ProxyPacMandatory“ und „ProxyBypassList“ werden verwendet.\n\nHinweis: Ausführliche Beispiele findest du in den Chromium-Projekten unter https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings.\nUnter https://chromeenterprise.google/policies/?policy=ProxySettings erhältst du weitere Informationen zu Schema und Formatierung.";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "QR‑Code‑Generator aktivieren";
QRCodeGeneratorEnabled.pfm_description = "Mit dieser Richtlinie wird die Funktion „QR‑Code‑Generator“ in Brave aktiviert.\n\nWenn du diese Richtlinie aktivierst oder nicht konfigurierst, wird die Funktion „QR‑Code‑Generator“ aktiviert.\n\nWenn du diese Richtlinie deaktivierst, wird die Funktion „QR‑Code‑Generator“ deaktiviert.";
QuicAllowed.pfm_title = "QUIC-Protokoll zulassen";
QuicAllowed.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, ermöglicht sie die Nutzung des QUIC-Protokolls in Brave.\n\nWenn die Richtlinie deaktiviert ist, ist die Nutzung des QUIC-Protokolls nicht möglich.";
RegisteredProtocolHandlers.pfm_title = "Protokoll-Handler registrieren";
RegisteredProtocolHandlers.pfm_description = "Wenn diese Richtlinie konfiguriert ist – jedoch nur wie empfohlen –, kannst du eine Liste mit Protokoll-Handlern registrieren, die mit den vom Nutzer registrierten zusammengeführt werden. Nachfolgend werden beide Handler-Gruppen verwendet. Setze die Eigenschaft \"protocol\" auf das Schema, z. B. \"mailto\", und die Eigenschaft \"URL\" auf das URL-Muster der Anwendung, die das im Feld \"protocol\" angegebene Schema bearbeitet. In dem Muster kann es einen \"%s\"-Platzhalter geben, der von der verarbeiteten URL ersetzt wird.\n\nEin von der Richtlinie registrierter Protokoll-Handler kann vom Nutzer nicht entfernt werden. Allerdings können durch Installation eines neuen Standard-Handlers die von der Richtlinie installierten Protokoll-Handler geändert werden.\nUnter https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers erhältst du weitere Informationen zu Schema und Formatierung.";
RelaunchFastIfOutdated.pfm_title = "Zeitraum (Tage)";
RelaunchFastIfOutdated.pfm_description = "Gibt das Mindestalter für einen Release an, bei dessen Überschreitung die Benachrichtigungen zum Neustart aufdringlicher werden. Das Alter wird ab dem Zeitpunkt berechnet, zu dem die aktuell ausgeführte Version zuletzt an Clients ausgeliefert wurde.\n\nWenn ein Browser oder ein Gerät neu gestartet werden muss, um ein ausstehendes Update abzuschließen, und die aktuelle Version länger als die in dieser Einstellung angegebene Anzahl von Tagen veraltet ist, wird die Richtlinie „RelaunchNotificationPeriod“ überschrieben und auf 2 Stunden gesetzt. Wenn die Richtlinie „RelaunchNotification“ auf 1 (erforderlich) festgelegt ist, müssen Nutzer am Ende des Zeitraums einen Neustart durchführen.\n\nWenn die Richtlinie nicht konfiguriert ist oder das Alter des Release nicht ermittelt werden kann, wird die Richtlinie „RelaunchNotificationPeriod“ für alle Updates verwendet.";
RelaunchNotification.pfm_title = "Nutzer benachrichtigen, dass ein Neustart des Browsers oder des Geräts empfohlen wird oder erforderlich ist";
RelaunchNotification.pfm_description = "1 - Dem Nutzer eine wiederkehrende Aufforderung anzeigen, dass ein Neustart empfohlen wird\n2 - Dem Nutzer eine wiederkehrende Aufforderung anzeigen, dass ein Neustart erforderlich ist\nNutzer benachrichtigen, dass Brave neu gestartet werden muss oder ein Google Chrome OS-Gerät neu gestartet werden muss, um ein ausstehendes Update durchzuführen.\n\nMit dieser Richtlinieneinstellung kann der Nutzer durch Benachrichtigungen informiert werden, dass ein Neustart des Browsers oder des Geräts empfohlen wird oder erforderlich ist. Wenn die Richtlinie nicht festgelegt ist, wird dem Nutzer in Brave durch kleinere Menüänderungen angezeigt, dass ein Neustart erforderlich ist. In Google Chrome OS wird dies über eine Benachrichtigung in der Taskleiste angezeigt. Wenn die Richtlinie auf \"Recommended\" (Empfohlen) festgelegt ist, wird dem Nutzer in einer wiederkehrenden Warnung angezeigt, dass ein Neustart empfohlen wird. Der Nutzer kann diese Warnung schließen, um den Neustart zu verschieben. Wenn die Richtlinie auf \"Required\" (Erforderlich) festgelegt ist, wird dem Nutzer in einer wiederkehrenden Warnung angezeigt, dass nach Ablauf des Benachrichtigungszeitraums ein Neustart des Browsers erzwungen wird. Dieser Zeitraum beträgt standardmäßig sieben Tage für Brave und vier Tage für Google Chrome OS und kann über die RelaunchNotificationPeriod-Richtlinieneinstellung konfiguriert werden.\n\nNach dem Neustart wird die Sitzung des Nutzers wiederhergestellt.";
RelaunchNotificationPeriod.pfm_title = "Zeitraum (Millisekunden)";
RelaunchNotificationPeriod.pfm_description = "Mit dieser Richtlinie kann der Zeitraum in Millisekunden festgelegt werden, in dem Nutzer eine Benachrichtigung erhalten, dass Brave oder ein Gerät mit Google Chrome OS für ein Update neu gestartet werden muss.\n\nIn diesem Zeitraum werden Nutzer wiederholt darüber informiert, dass ein Update erforderlich ist. Auf Google Chrome OS-Geräten erscheint entsprechend der Richtlinie \"RelaunchHeadsUpPeriod\" eine Neustartbenachrichtigung in der Taskleiste. In Brave-Browsern ändert sich das App-Menü, sobald ein Drittel des Benachrichtigungszeitraums abgelaufen ist, um zu zeigen, dass ein Neustart nötig ist. Die Farbe dieser Benachrichtigung ändert sich, sobald zwei Drittel des Benachrichtigungszeitraums vergangen sind. Wenn der ganze Zeitraum abgelaufen ist, ändert sich die Farbe erneut. Für die zusätzlichen Benachrichtigungen, die über die Richtlinie \"RelaunchNotification\" aktiviert werden, gilt derselbe Zeitplan.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt der standardmäßige Zeitraum von 604.800.000 Millisekunden (eine Woche).";
RelaunchWindow.pfm_title = "Zeitfenster für Neustart";
RelaunchWindow.pfm_description = "Du kannst ein Zeitfenster für das Ende des Benachrichtigungszeitraums für den Neustart festlegen.\n\nNutzer werden abhängig von den Richtlinieneinstellungen für RelaunchNotification und RelaunchNotificationPeriod benachrichtigt, dass der Neustart des Browsers oder Geräts erforderlich ist. Wenn die Richtlinie RelaunchNotification auf „Required“ festgelegt ist, wird der Neustart für Browser und Geräte am Ende des Benachrichtigungszeitraums erzwungen. Die Richtlinie RelaunchWindow kann verwendet werden, um das Ende des Benachrichtigungszeitraums zu verzögern, sodass es in ein bestimmtes Zeitfenster fällt.\n\nWenn diese Richtlinie nicht konfiguriert ist, liegt das Zeitfenster für Google Chrome OS standardmäßig zwischen 2:00 und 4:00 Uhr. Das Zeitfenster für Brave ist standardmäßig der ganze Tag (das Ende des Benachrichtigungszeitraums wird also nicht verschoben).\n\nHinweis: Auch wenn die Richtlinie mehrere Elemente unter entries erlaubt, werden alle Elemente außer dem ersten ignoriert.\nHinweis: Durch das Konfigurieren dieser Richtlinie kann sich die Anwendung von Softwareupdates verzögern.\nUnter https://chromeenterprise.google/policies/?policy=RelaunchWindow erhältst du weitere Informationen zu Schema und Formatierung.";
RemoteAccessHostAllowClientPairing.pfm_title = "Authentifizierung ohne PIN für Hosts für den Remote-Zugriff aktivieren oder deaktivieren";
RemoteAccessHostAllowClientPairing.pfm_description = "Wenn diese Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer beim Herstellen der Verbindung Clients und Hosts koppeln. Es ist nicht erforderlich, jedes Mal eine PIN einzugeben.\n\nIst diese Richtlinie deaktiviert, ist diese Funktion nicht verfügbar.";
RemoteAccessHostAllowFileTransfer.pfm_title = "Nutzern mit Remote-Zugriff die Übertragung von Dateien vom/zum Host gestatten";
RemoteAccessHostAllowFileTransfer.pfm_description = "Wenn diese Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer, die mit einem Host für den Remote-Zugriff verbunden sind, Dateien zwischen Client und Host übertragen. Verbindungen zur Remote-Unterstützung sind hiervon ausgenommen, da sie keine Dateiübertragung unterstützen.\n\nIst diese Richtlinie deaktiviert, können keine Dateien übertragen werden";
RemoteAccessHostAllowPinAuthentication.pfm_title = "PIN- und Kopplungsauthentifizierung für Hosts für den Remote-Zugriff zulassen";
RemoteAccessHostAllowPinAuthentication.pfm_description = "Wenn die Richtlinie aktiviert ist, kann der Host für den Remote-Zugriff eine PIN- und Kopplungsauthentifizierung verwenden, wenn er Clientverbindungen akzeptiert.\n\nWenn die Richtlinie deaktiviert ist, ist keine PIN- oder Kopplungsauthentifizierung möglich.\n\nWenn die Richtlinie nicht konfiguriert ist, kann der Host entscheiden, ob eine PIN- und/oder Kopplungsauthentifizierung verwendet werden kann.\n\nHinweis: Wenn in den Einstellungen keine gegenseitig unterstützten Authentifizierungsmethoden vom Host und vom Client gefunden werden, wird die Verbindung abgelehnt.";
RemoteAccessHostAllowRelayedConnection.pfm_title = "Verwendung von Relayservern durch den Host für den Remote-Zugriff gestatten";
RemoteAccessHostAllowRelayedConnection.pfm_description = "Wenn „RemoteAccessHostFirewallTraversal“ aktiviert ist, kann es Remote-Clients durch Aktivieren oder Nichtkonfigurieren von „RemoteAccessHostAllowRelayedConnection“ ermöglicht werden, über Relayserver eine Verbindung zu diesem Computer herzustellen, falls keine direkte Verbindung verfügbar ist, z. B. aufgrund von Firewallbeschränkungen.\n\nIst diese Richtlinie deaktiviert, wird dadurch nicht der Remote-Zugriff deaktiviert. Stattdessen werden nur Verbindungen desselben Netzwerks zugelassen (nicht NAT-Traversal oder Relay).";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "Verbindungen zu diesem Computer per Remote-Zugriff erlauben";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "Wenn diese Richtlinie deaktiviert ist, kann der Host für den Remote-Zugriff keine eingehenden Verbindungen annehmen.  Diese Richtlinien wirkt sich nicht auf die Remote-Unterstützung aus.\n\nDiese Richtlinie ist nicht wirksam, wenn sie aktiviert ist, leer gelassen oder nicht konfiguriert wird.";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "Verbindungen zu diesem Computer per Remote-Unterstützung erlauben";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "Wenn diese Richtlinie deaktiviert ist, kann der Host für die Remote-Unterstützung keine eingehenden Verbindungen annehmen.\n\nDiese Richtlinie wirkt sich nicht auf den Remote-Zugriff aus.\n\nSie hindert Unternehmensadministratoren nicht daran, eine Verbindung zu verwalteten Google Chrome OS-Geräten herzustellen.\n\nDiese Richtlinie ist nicht wirksam, wenn sie aktiviert, leer gelassen oder nicht konfiguriert wird.";
RemoteAccessHostAllowUrlForwarding.pfm_title = "Nutzern mit Remote-Zugriff erlauben, URLs auf Hostseite in ihrem lokalen Clientbrowser zu öffnen";
RemoteAccessHostAllowUrlForwarding.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer, die mit einem Host für den Remote-Zugriff verbunden sind, hostseitige URLs möglicherweise in ihrem lokalen Clientbrowser öffnen.\n\nIst die Richtlinie deaktiviert, kann der Host für den Remote-Zugriff keine URLs an den Client senden.\n\nDiese Einstellung gilt nicht für Verbindungen zur Remote-Unterstützung, da die Funktion für diesen Verbindungsmodus nicht unterstützt wird.\n\nHinweis: Diese Funktion ist noch nicht allgemein verfügbar. Wenn du sie aktivierst, bedeutet das also nicht, dass sie auf der Client-Benutzeroberfläche sichtbar ist.";
RemoteAccessHostClientDomainList.pfm_title = "Erforderliche Domainnamen für Remote-Zugriff-Clients konfigurieren";
RemoteAccessHostClientDomainList.pfm_description = "Wird diese Richtlinie konfiguriert, werden die Domainnamen der Clients für den Remote-Zugriff angegeben und Nutzer können sie nicht ändern. Nur Clients aus einer der angegebenen Domains können eine Verbindung zum Host herstellen.\n\nIst diese Richtlinie nicht konfiguriert oder ist eine leere Liste festgelegt, wird die Standardrichtlinie für den Verbindungstyp angewendet. Zu Zwecken der Remote-Unterstützung können Clients aus jeder beliebigen Domain eine Verbindung zum Host herstellen. Bei einem stetigen Remote-Zugriff kann nur der Hosteigentümer eine Verbindung herstellen.\n\nSiehe auch RemoteAccessHostDomainList.\n\nHinweis: Diese Einstellung überschreibt RemoteAccessHostClientDomain, sofern vorhanden.";
RemoteAccessHostClipboardSizeBytes.pfm_title = "Die maximale Größe in Byte, die zwischen dem Client und dem Host über die Synchronisierung der Zwischenablage übertragen werden kann";
RemoteAccessHostClipboardSizeBytes.pfm_description = "Wenn diese Richtlinie konfiguriert ist, werden Daten in der Zwischenablage, die an den Host gesendet und von diesem empfangen werden, je nach der durch diese Richtlinie festgelegten Begrenzung abgeschnitten.\n\nBei einem Wert von 0 ist die Synchronisierung der Zwischenablage deaktiviert.\n\nDie Richtlinie betrifft sowohl Szenarien mit Remote-Zugriff als auch solche mit Remotesupport.\n\nSie hat keine Auswirkungen, wenn sie nicht konfiguriert ist.\n\nWird die Richtlinie auf einen Wert festgelegt, der nicht zwischen dem Höchst- und dem Mindestwert liegt, kann der Host möglicherweise nicht starten.\n\nBeachte: Die tatsächliche Obergrenze für die Größe der Zwischenablage hängt von der maximalen Nachrichtengröße für den WebRTC-Datenkanal ab, die nicht durch diese Richtlinie gesteuert wird.";
RemoteAccessHostDomainList.pfm_title = "Erforderliche Domainnamen für Remote-Zugriff-Hosts konfigurieren";
RemoteAccessHostDomainList.pfm_description = "Wenn diese Richtlinie konfiguriert ist, werden Domainnamen der Hosts für den Remote-Zugriff festgelegt und Nutzer können sie nicht ändern. Hosts können nur über Konten gemeinsam genutzt werden, die unter einem der angegebenen Domainnamen registriert sind.\n\nIst diese Richtlinie nicht konfiguriert oder eine leere Liste festgelegt, können Hosts über beliebige Konten gemeinsam genutzt werden.\n\nSiehe auch RemoteAccessHostClientDomainList.\n\nHinweis: Sofern vorhanden, wird RemoteAccessHostDomain mit dieser Einstellung überschrieben.";
RemoteAccessHostFirewallTraversal.pfm_title = "Firewallausnahme über Host für Remote-Zugriff aktivieren";
RemoteAccessHostFirewallTraversal.pfm_description = "Wenn diese Richtlinie aktiviert wird oder nicht konfiguriert ist, wird der Einsatz von STUN-Servern aktiviert und Remote-Clients können diesen Computer finden und eine Verbindung herstellen, selbst wenn er sich hinter einer Firewall befindet.\n\nIst diese Richtlinie deaktiviert und ausgehende UDP-Verbindungen werden von einer Firewall gefiltert, lässt dieser Computer Verbindungen von Client-Computern ausschließlich innerhalb des lokalen Netzwerks zu.";
RemoteAccessHostMatchUsername.pfm_title = "Verlangen, dass der Name des lokalen Nutzers und des Host-Inhabers des Remotezugriffs übereinstimmen";
RemoteAccessHostMatchUsername.pfm_description = "Wenn diese Richtlinie aktiviert ist, vergleicht der Host für den Remote-Zugriff den Namen des mit dem Host verknüpften lokalen Nutzers mit dem Namen des Google-Kontos, das als Hosteigentümer registriert ist (z. B. „maxmustermann“, wenn der Hosteigentümer das Google-Konto „maxmustermann@beispiel.de“ ist). Dieser Host wird nicht gestartet, wenn der Name des Hosteigentümers vom Namen des mit dem Host verknüpften lokalen Nutzers abweicht. Wenn du erzwingen möchtest, dass das Google-Konto des Eigentümers mit einer bestimmten Domain verknüpft ist, verwende die Richtlinie mit RemoteAccessHostDomain.\n\nIst diese Richtlinie deaktiviert oder nicht konfiguriert, kann der Host für den Remote-Zugriff mit jedem lokalen Nutzer verknüpft sein.";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "Maximal zulässige Sitzungsdauer für Verbindungen per Remote-Zugriff";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "Wenn diese Richtlinie konfiguriert wird, werden Verbindungen per Remote-Zugriff automatisch nach Ablauf der in der Richtlinie festgelegten Dauer (in Minuten) getrennt. Der Client wird nicht daran gehindert, eine neue Verbindung herzustellen, nachdem die maximale Sitzungsdauer überschritten wurde. Wird die Richtlinie auf einen Wert festgelegt, der nicht zwischen dem Höchst- und dem Mindestwert liegt, kann der Host möglicherweise nicht starten. Diese Richtlinie wirkt sich nicht auf die Remote-Unterstützung aus.\n\nSie hat keine Auswirkungen, wenn sie nicht konfiguriert ist. In diesem Fall gilt für Verbindungen per Remote-Zugriff keine maximale Dauer auf diesem Computer.";
RemoteAccessHostRequireCurtain.pfm_title = "Zugangsbeschränkung für Remote-Zugriff-Hosts aktivieren";
RemoteAccessHostRequireCurtain.pfm_description = "Wenn diese Richtlinie aktiviert ist, werden die physischen Ein- und Ausgabegeräte des Hosts für den Remote-Zugriff bei bestehender Remote-Verbindung deaktiviert.\n\nIst diese Richtlinie deaktiviert oder nicht konfiguriert, können lokale und Remote-Nutzer mit dem Host interagieren, sofern dieser freigegeben ist.";
RemoteAccessHostUdpPortRange.pfm_title = "Vom Host für den Remote-Zugriff verwendeten UDP-Portbereich einschränken";
RemoteAccessHostUdpPortRange.pfm_description = "Wenn diese Richtlinie konfiguriert ist, wird der vom Host für den Remote-Zugriff verwendete UDP-Portbereich auf diesem Computer eingeschränkt.\n\nWenn diese Richtlinie nicht konfiguriert oder auf einen leeren String festgelegt wird, kann der Host für den Remote-Zugriff alle verfügbaren Ports nutzen.\n\nHinweis: Falls RemoteAccessHostFirewallTraversal deaktiviert ist, verwendet der Host für den Remote-Zugriff jedoch nur die UDP-Ports im Bereich 12400–12409.";
RemoteDebuggingAllowed.pfm_title = "Remote-Debugging zulassen";
RemoteDebuggingAllowed.pfm_description = "Damit wird festgelegt, ob Nutzer Remote-Debugging verwenden können.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer Remote-Debugging verwenden, indem sie auf Desktop-Plattformen die Befehlszeilenoptionen „--remote-debugging-port“ und „--remote-debugging-pipe“ angeben oder unter Android die Systemeinstellung für USB-Debugging aktivieren.\n\nWenn diese Richtlinie deaktiviert ist, ist die Verwendung von Remote-Debugging für Nutzer nicht zulässig.";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "OCSP/CRL-Online-Prüfungen für lokale Vertrauensanker als erforderlich festlegen";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "Wenn die Richtlinie auf „True“ gesetzt ist, führt Brave immer eine Widerrufsprüfung für Serverzertifikate durch, die erfolgreich bestätigt und von lokal installierten CA-Zertifikaten signiert wurden. Kann Brave keine Informationen zum Widerrufsstatus abrufen, werden solche Zertifikate von Brave als widerrufen behandelt („hard-fail“).\n\nWenn diese Richtlinie nicht konfiguriert oder auf „False“ gesetzt ist, verwendet Brave die vorhandenen Online-Einstellungen zur Widerrufsprüfung.\n\nUnter macOS hat diese Richtlinie keine Auswirkungen, wenn die Richtlinie ChromeRootStoreEnabled auf „False“ gesetzt ist.";
RestoreOnStartup.pfm_title = "Aktion beim Start";
RestoreOnStartup.pfm_description = "5 - \"Neuer Tab\"-Seite öffnen\n1 - Letzte Sitzung wiederherstellen\n4 - URL-Liste öffnen\n6 - Liste mit URLs öffnen und die letzte Sitzung wiederherstellen\nMit dieser Richtlinie kannst du festlegen, wie sich das System beim Start verhält. Wenn diese Einstellung deaktiviert ist, hat das den gleichen Effekt, als wäre sie nicht konfiguriert, da Brave ein festgelegtes Verhalten beim Start benötigt.\n\nIst diese Richtlinie konfiguriert, kann sie von Nutzern in Brave nicht geändert werden. Wenn du sie nicht konfigurierst, können Nutzer sie ändern.\n\nIst diese Richtlinie auf „RestoreOnStartupIsLastSession“ oder „RestoreOnStartupIsLastSessionAndURLs“ gesetzt, werden einige Einstellungen deaktiviert, die von Sitzungen abhängig sind oder beim Verlassen einer Sitzung Aktionen ausführen, wie das Löschen der Browserdaten beim Schließen oder der Sitzungscookies.\n\nWenn sie auf „RestoreOnStartupIsLastSessionAndURLs“ gesetzt ist, wird im Browser die vorherige Sitzung wiederhergestellt und ein separates Fenster für URLs geöffnet, die in „RestoreOnStartupURLs“ festgelegt sind. Nutzer können diese URLs geöffnet lassen. In diesem Fall werden sie in der nächsten Sitzung ebenfalls wiederhergestellt.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
RestoreOnStartupURLs.pfm_title = "Beim Start zu öffnende URLs";
RestoreOnStartupURLs.pfm_description = "Ist die Richtlinie „RestoreOnStartup“ auf „RestoreOnStartupIsURLs“ gesetzt, wird durch das Festlegen von „RestoreOnStartupURLs“ auf eine Liste von URLs angegeben, welche URLs geöffnet werden.\n\nIst die Richtlinie nicht konfiguriert, öffnet sich die „Neuer Tab“-Seite beim Start.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "Hintergrundabruf-API einschränken, wenn sie von einem Service Worker aufgerufen wird";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob Anfragen für Hintergrundabrufe durch Service Workers eingeschränkt werden. Diese Richtlinie ist möglicherweise relevant, wenn eine Funktion betroffen ist, die Dateien im Hintergrund herunterlädt.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, ist die Einschränkung aktiv und Anfragen für Hintergrundabrufe aus Service Worker-Kontexten können blockiert werden.\n\nWenn diese Richtlinie deaktiviert ist, wird die Einschränkung umgangen und alle Service Workers können Hintergrundabrufe anfragen.\n\nDiese Unternehmensrichtlinie ist nur vorübergehend verfügbar und wird nach M152 entfernt.";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "Das Speichern von PDF-Dateien in Google Drive über den PDF-Viewer von Brave auf zulässige Google-Konten beschränken";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "Enthält einen regulären Ausdruck, um die zulässigen Google-Konten zu bestimmen, die zum Speichern von PDF-Dateien in Google Drive über den PDF-Viewer von Brave berechtigt sind.\n\nWenn ein Nutzer versucht, eine PDF-Datei mit einem Konto, das nicht diesem Muster entspricht, in Google Drive hochzuladen, wird ein Fehler angezeigt.\n\nWenn diese Richtlinie nicht konfiguriert oder leer ist, kann der Nutzer jedes Google-Konto verwenden, um PDF-Dateien in Google Drive zu speichern.";
RestrictSigninToPattern.pfm_title = "Einschränken, welche Google-Konten als primäre Browserkonten in Brave festgelegt werden können";
RestrictSigninToPattern.pfm_description = "Enthält einen regulären Ausdruck, der festlegt, welche Google-Konten in Brave als primäre Browserkonten eingerichtet werden können, also als das Konto, das bei der Zustimmung zur Synchronisierung ausgewählt wurde.\n\nWenn ein Nutzer ein primäres Browserkonto mit einem Nutzernamen einrichten will, der diesem Muster nicht entspricht, wird ein entsprechender Fehler ausgegeben.\n\nWenn diese Richtlinie nicht festgelegt ist oder absichtlich leer gelassen wird, kann der Nutzer in Brave jedes Google-Konto als primäres Browserkonto festlegen.";
RestrictYouTubeCookiesDeletion.pfm_title = "Löschen von YouTube-Cookies einschränken";
RestrictYouTubeCookiesDeletion.pfm_description = "Verhindert das manuelle Löschen von YouTube-Cookies.\n\nDiese Richtlinie soll verhindern, dass Nutzer nach dem manuellen Löschen ihrer YouTube-Cookies über die Seite mit den Websiteeinstellungen ohne Autorisierung auf YouTube zugreifen.\n\nWenn die Richtlinie aktiviert ist, können YouTube-Cookies nicht manuell gelöscht werden.\n\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist, können YouTube-Cookies normal gelöscht werden.\n\nHinweis: Diese Richtlinie verhindert nur das manuelle Löschen über die Benutzeroberfläche der Websiteeinstellungen. Sie verhindert nicht das automatische Löschen durch die Richtlinien „ClearBrowsingDataOnExitList“ oder „BrowsingDataLifetime“. Wenn die Richtlinie „AllowDeletingBrowserHistory“ aktiviert ist, können Nutzer außerdem alle ihre Cookies über das Dialogfeld „Browserdaten löschen“ löschen.";
SSLErrorOverrideAllowed.pfm_title = "Fortfahren von SSL-Hinweisseite erlauben";
SSLErrorOverrideAllowed.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer Warnseiten schließen, die in Brave angezeigt werden, wenn sie Websites mit SSL-Fehlern aufrufen.\n\nIst die Richtlinie deaktiviert, ist das nicht möglich.";
SSLErrorOverrideAllowedForOrigins.pfm_title = "Fortfahren von SSL-Warnseiten für bestimmte Quellen erlauben";
SSLErrorOverrideAllowedForOrigins.pfm_description = "Wenn SSLErrorOverrideAllowed deaktiviert ist, kannst du durch Konfigurieren dieser Richtlinie eine Liste mit Ursprungsmustern festlegen, die Websites angeben, auf denen Nutzer Warnseiten schließen können. Diese Warnseiten werden in Brave angezeigt, wenn Nutzer Seiten mit SSL-Fehlern besuchen. Für Ursprünge mit SSL-Fehlern, die nicht auf dieser Liste stehen, können Nutzer keine Warnseiten schließen.\n\nWenn SSLErrorOverrideAllowed aktiviert oder nicht konfiguriert ist, hat diese Richtlinie keine Auswirkung.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt SSLErrorOverrideAllowed für alle Websites.\n\nAusführliche Informationen zu gültigen Eingabemustern findest du unter https://chromeenterprise.google/policies/url-patterns/. * ist kein akzeptierter Wert für diese Richtlinie. Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL-Musters ignoriert.";
SafeBrowsingAllowlistDomains.pfm_title = "Hiermit wird die Liste der Domains konfiguriert, auf denen durch Safe Browsing keine Warnungen ausgelöst werden.";
SafeBrowsingAllowlistDomains.pfm_description = "Wenn die Richtlinie aktiviert ist, vertraut Safe Browsing den Domains, die du festlegst. Es findet keine Prüfung auf gefährliche Ressourcen wie Phishing, Malware oder unerwünschte Software statt. Es findet auch keine Prüfung von in diesen Domains gehosteten Downloads durch den Downloadschutzdienst statt. Eine Wiederverwendung von Passwörtern wird nicht durch den Passwortschutzdienst geprüft.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird der Safe Browsing-Standardschutz auf alle Ressourcen angewendet.\n\nDiese Richtlinie unterstützt keine regulären Ausdrücke. Subdomains bestimmter Domains werden jedoch auf die Zulassungsliste gesetzt. Voll qualifizierte Domainnamen (fully qualified domain names, FQDNs) sind nicht erforderlich.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.";
SafeBrowsingDeepScanningEnabled.pfm_title = "Bei Nutzern, die Safe Browsing aktiviert haben, detailliertere Scans von heruntergeladenen Dateien zulassen";
SafeBrowsingDeepScanningEnabled.pfm_description = "Wenn diese Richtlinie aktiviert oder nicht konfiguriert ist, kann Brave verdächtige Downloads von Nutzern, die Safe Browsing aktiviert haben, zur Prüfung auf Malware an Google senden oder Nutzer auffordern, ein Passwort für verschlüsselte Archive anzugeben.\nIst diese Richtlinie deaktiviert, wird keine Prüfung durchgeführt.\nDiese Richtlinie wirkt sich nicht auf die von Chrome Enterprise Connectors konfigurierte Analyse von heruntergeladenen Inhalten aus.";
SafeBrowsingProtectionLevel.pfm_title = "Schutzniveau für Safe Browsing";
SafeBrowsingProtectionLevel.pfm_description = "0 - Safe Browsing ist nie aktiv.\n1 - Safe Browsing ist im Standardmodus aktiv.\n2 - Safe Browsing ist im erweiterten Modus aktiv. Dieser bietet einen besseren Schutz. Es müssen jedoch mehr Browserdaten mit Google geteilt werden.\nMit dieser Richtlinie wird festgelegt, ob die Safe Browsing-Funktion von Brave aktiviert ist und in welchem Modus sie ausgeführt werden soll.\n\nIst die Richtlinie auf „NoProtection“ (Wert 0) gesetzt, ist Safe Browsing nie aktiv.\n\nIst sie auf „StandardProtection“ (Wert 1, die Standardeinstellung) gesetzt, ist Safe Browsing immer im Standardmodus aktiv.\n\nIst die Richtlinie auf „EnhancedProtection“ (Wert 2) gesetzt, ist Safe Browsing immer im erweiterten Modus aktiv. Dieser bietet einen besseren Schutz, es müssen jedoch mehr Browserdaten mit Google geteilt werden.\n\nIst sie als verbindlich konfiguriert, können Nutzer die Safe Browsing-Einstellung in Brave nicht ändern oder überschreiben.\n\nIst die Richtlinie nicht konfiguriert, ist Safe Browsing im Standardschutzmodus aktiv, Nutzer können diese Einstellung jedoch ändern.\n\nWeitere Informationen zu Safe Browsing findest du unter https://support.google.com/chrome?p=safe_browsing_preferences.";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "Weitergeleitete Safe Browsing-Echtzeitprüfungen zulassen";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "Hiermit wird festgelegt, ob im Standardschutzmodus von Safe Browsing Teil-Hashes von URLs über einen Proxy und Oblivious HTTP an Google gesendet werden dürfen, um festzustellen, ob sie sicher aufgerufen werden können.\n\nÜber den Proxy können Browser Teil-Hashes von URLs bei Google hochladen, ohne dass sie mit der IP-Adresse des Nutzers verknüpft werden. Außerdem können Browser mit der Richtlinie auch die Teil-Hashes von URLs mit höherer Häufigkeit hochladen, um den Schutz von Safe Browsing zu verbessern.\n\nDiese Richtlinie wird ignoriert, wenn Safe Browsing deaktiviert oder der Modus für erweiterten Schutz aktiviert ist.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, werden Suchanfragen per Proxy mit erhöhter Sicherheit zugelassen.\n\nIst die Richtlinie deaktiviert, sind Suchanfragen per Proxy mit erhöhter Sicherheit nicht zulässig. Teil-Hashes von URLs werden viel seltener direkt bei Google hochgeladen, wodurch der Schutz reduziert wird.";
SafeBrowsingSurveysEnabled.pfm_title = "Safe Browsing-Umfragen zulassen";
SafeBrowsingSurveysEnabled.pfm_description = "Wenn diese Richtlinie aktiviert ist oder nicht konfiguriert wird, erhält der Nutzer möglicherweise Umfragen zu Safe Browsing.\nIst die Richtlinie deaktiviert, erhält der Nutzer keine Umfragen zu Safe Browsing.";
SafeSitesFilterBehavior.pfm_title = "Filterung von Inhalten nur für Erwachsene durch \"SafeSites\" konfigurieren.";
SafeSitesFilterBehavior.pfm_description = "0 - Websites mit Inhalten nur für Erwachsene nicht filtern\n1 - Websites mit Inhalten nur für Erwachsene filtern\nMit dieser Richtlinie wird die Anwendung des URL‑Filters „SafeSites“ konfiguriert. Der Filter greift auf die Google Safe Search API zurück, um URLs als pornografisch oder nicht pornografisch einzustufen.\n\nWenn diese Richtlinie\n\n* auf „Websites mit Inhalten nur für Erwachsene nicht filtern“ festgelegt oder nicht konfiguriert ist, werden Websites nicht gefiltert.\n\n* auf „Websites mit Inhalten nur für Erwachsene filtern“ festgelegt ist, werden als pornografisch eingestufte Websites gefiltert.\n\nDie Richtlinie gilt sowohl für die vom Nutzer aufgerufene URL als auch für iFrames. Die Richtlinie „URLAllowlist“ hat Vorrang vor dieser Richtlinie und kann verwendet werden, um Ergebnisse der Google Safe Search API zu überschreiben.";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "Same-Origin-Tabaufnahme für diese Ursprünge zulassen";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, die Tabs mit demselben Ursprung aufnehmen können.\n\nIst sie nicht konfiguriert, können Websites diese Aufnahmefunktion nicht nutzen.\n\nBitte beachte, dass auch Chrome-Apps im Fenstermodus, die denselben Ursprung haben wie diese Website, aufgenommen werden können.\n\nWenn eine Website mit einem URL-Muster in dieser Richtlinie übereinstimmt, werden die folgenden Richtlinien nicht berücksichtigt: TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nAusführliche Informationen zu gültigen url-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.  Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL-Musters ignoriert.";
SandboxExternalProtocolBlocked.pfm_title = "Chrome erlauben, das Aufrufen externer Protokolle in einem Sandbox-iFrame zu blockieren";
SandboxExternalProtocolBlocked.pfm_description = "Chrome blockiert das Aufrufen externer Protokolle in einem Sandbox-iFrame. Weitere Informationen findest du unter https://chromestatus.com/features/5680742077038592.\n\nWenn die Richtlinie auf „true“ gesetzt wird, blockiert Chrome diese Aufrufe.\n\nWird die Richtlinie auf „false“ gesetzt, kann Chrome diese Aufrufe nicht blockieren.\n\nStandardmäßig ist der Wert auf „true“ gesetzt, womit die Sicherheitsfunktion aktiviert ist.\n\nDies kann von Administratoren genutzt werden, die mehr Zeit für die Aktualisierung ihrer internen Website benötigen, die von dieser neuen Einschränkung betroffen ist. Diese Unternehmensrichtlinie ist vorübergehend. Nach Version 117 von Brave wird sie voraussichtlich entfernt.\n";
SavingBrowserHistoryDisabled.pfm_title = "Speichern des Browserverlaufs deaktivieren";
SavingBrowserHistoryDisabled.pfm_description = "Wenn die Richtlinie aktiviert ist, wird der Browserverlauf nicht gespeichert, die Tab-Synchronisierung ist deaktiviert und Nutzer können diese Einstellung nicht ändern.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, wird der Browserverlauf gespeichert.";
ScreenCaptureAllowed.pfm_title = "Bildschirmaufnahme gestatten oder ablehnen";
ScreenCaptureAllowed.pfm_description = "Wenn diese Richtlinie aktiviert oder nicht konfiguriert ist (Standard), können Webseiten\nBildschirmfreigabe-APIs (z. B. \"getDisplayMedia()\" oder die Desktop Capture-Erweiterungs-API) verwenden,\num den Nutzer aufzufordern, einen Tab, ein Fenster oder einen Desktop für die Aufnahme auszuwählen.\n\nWenn diese Richtlinie deaktiviert ist, treten beim Aufrufen von Bildschirmfreigabe-APIs\nFehler auf. Diese Richtlinie wird nicht berücksichtigt (und die jeweilige Website kann die\nAPIs zur Bildschirmfreigabe verwenden), wenn die Website mit einem Ursprungsmuster in\neiner der folgenden Richtlinien übereinstimmt:\nScreenCaptureAllowedByOrigins,\nWindowCaptureAllowedByOrigins,\nTabCaptureAllowedByOrigins,\nSameOriginTabCaptureAllowedByOrigins.\n";
ScreenCaptureAllowedByOrigins.pfm_title = "Desktop-, Fenster- und Tabaufnahme für diese Ursprünge zulassen";
ScreenCaptureAllowedByOrigins.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, die die Desktop-, Fenster- und Tabaufnahme verwenden können.\n\nIst sie nicht konfiguriert, können Websites diese Aufnahmefunktionen nicht nutzen.\n\nDiese Richtlinie wird nicht berücksichtigt, wenn eine Website mit einem URL-Muster in einer der folgenden Richtlinien übereinstimmt: „WindowCaptureAllowedByOrigins“, „TabCaptureAllowedByOrigins“ oder „SameOriginTabCaptureAllowedByOrigins“.\n\nWenn eine Website mit einem URL-Muster in dieser Richtlinie übereinstimmt, wird „ScreenCaptureAllowed“ nicht berücksichtigt.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.  Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL-Musters ignoriert.";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "Bildschirmaufnahme ohne vorherige Nutzergeste zulassen";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "Aus Sicherheitsgründen erfordert das Aufrufen der Web-API „getDisplayMedia()“ eine vorherige Nutzergeste („vorübergehende Aktivierung“), andernfalls tritt ein Fehler auf.\n\nMithilfe dieser Richtlinie können Administratoren Ursprünge festlegen, von denen diese API ohne vorherige Nutzergeste aufgerufen werden kann.\n\nAusführliche Informationen zu gültigen URL-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/. * ist kein akzeptierter Wert für diese Richtlinie.\n\nWenn diese Richtlinie nicht konfiguriert ist, muss vor dem Aufrufen dieser API unabhängig vom Ursprung eine Nutzergeste ausgeführt werden.";
ScrollToTextFragmentEnabled.pfm_title = "Scrollen zu in URL-Fragmenten angegebenem Text aktivieren";
ScrollToTextFragmentEnabled.pfm_description = "Diese Funktion ermöglicht es Hyperlinks und URL-Navigationen in der Adressleiste, zu bestimmten Textfragmenten auf einer Webseite zu scrollen, sobald die Seite geladen ist.\n\nWenn du diese Richtlinie aktivierst oder nicht konfigurierst, wird das Scrollen zu bestimmten Textfragmenten auf Webseiten via URL aktiviert.\n\nWenn du diese Richtlinie deaktivierst, wird das Scrollen zu bestimmten Textfragmenten auf Webseiten via URL deaktiviert.";
SearchContentSharingSettings.pfm_title = "Teilen von Inhalten mit Google AI Mode- und Lens-Integrationen aktivieren";
SearchContentSharingSettings.pfm_description = "0 - Teilen von Inhalten mit Google AI Mode-Integrationen zulassen.\n1 - Teilen von Inhalten mit Google AI Mode-Integrationen nicht zulassen.\nMit dieser Richtlinie wird das Teilen von Seiten- und Dateiinhalten mit Google AI Mode und Lens über die Seitenleiste oder Tabs von Google Chrome gesteuert.\n\nDiese Richtlinie wirkt sich nicht auf die Webversion von Google AI Mode aus. Sie legt nur fest, wie Nutzer Informationen teilen können, wenn sie Google Chrome verwenden.\n\n0 = Nutzer können Seiten- oder Dateiinhalte mit Google AI Mode teilen.\n\n1 = Nutzer können keine Seiten- oder Dateiinhalte mit Google AI Mode teilen. Die Zugangspunkte zum Teilen von Kontext und die Seitenleiste werden deaktiviert oder ausgeblendet.\n\nDiese Richtlinie wird ignoriert, wenn Google Search nicht die Standardsuchmaschine der Nutzer ist, da die Funktion deaktiviert ist.\n\nDiese Richtlinie ist unabhängig von der Richtlinie „AIModeSettings“. Die Richtlinie „AIModeSettings“ steuert nur Zugangspunkte in der Omnibox oder im Suchfeld auf der Seite „Neuer Tab“, während diese Richtlinie das Teilen von Kontext über die Seitenleiste oder Tabs steuert.\n\nDiese Richtlinie steuert auch nicht die Google Gemini-Integration, die von GeminiSettings deaktiviert werden kann.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
SearchSuggestEnabled.pfm_title = "Suchvorschläge aktivieren";
SearchSuggestEnabled.pfm_description = "Wenn die Richtlinie auf „True“ gesetzt ist, werden die Suchvorschläge in der Adressleiste von Brave aktiviert. Ist sie auf „False“ gesetzt, werden die Suchvorschläge deaktiviert.\n\nDie Richtlinie wirkt sich nicht auf Vorschläge aus, die auf Lesezeichen oder Verlauf beruhen.\n\nWenn du die Richtlinie konfigurierst, kann sie von Nutzern nicht geändert werden. Wird sie nicht konfiguriert, sind die Suchvorschläge standardmäßig aktiviert, können aber jederzeit von Nutzern deaktiviert werden.";
SecurityKeyPermitAttestation.pfm_title = "Automatischer Nachweis des Sicherheitsschlüssels durch URLs/Domains";
SecurityKeyPermitAttestation.pfm_description = "Wenn die Richtlinie konfiguriert ist, werden WebAuthn-RP-IDs festgelegt, für die keine Aufforderung angezeigt wird, wenn Nachweiszertifikate von Sicherheitsschlüsseln angefordert werden. Zusätzlich wird ein Signal an den Sicherheitsschlüssel gesendet, das angibt, dass geschäftliche Nachweise verwendet werden können. Andernfalls erhalten Nutzer in Brave ab Version 65 eine Eingabeaufforderung, wenn Websites einen Nachweis für Sicherheitsschlüssel anfordern.";
SensorsAllowedForUrls.pfm_title = "Diesen Websites den Zugriff auf Sensoren erlauben";
SensorsAllowedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, durch die angegeben wird, welche Websites auf Sensoren wie Bewegungs- und Lichtsensoren zugreifen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultSensorsSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nSollte das URL-Muster sowohl in dieser Richtlinie als auch in der Richtlinie „SensorsBlockedForUrls“ enthalten sein, hat letztere Vorrang und der Zugriff auf Bewegungs- und Lichtsensoren wird blockiert.\n\nAusführliche Informationen zu gültigen url-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie * sind zulässig.";
SensorsBlockedForUrls.pfm_title = "Den Zugriff auf Sensoren für diese Websites sperren";
SensorsBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites nicht auf Sensoren wie Bewegungs- und Lichtsensoren zugreifen dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultSensorsSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nSollte das URL‑Muster sowohl in dieser Richtlinie als auch in der Richtlinie „SensorsAllowedForUrls“ enthalten sein, hat diese Richtlinie Vorrang und der Zugriff auf Bewegungs- und Lichtsensoren wird blockiert.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig.";
SerialAllowAllPortsForUrls.pfm_title = "Websites automatisch die Berechtigung erteilen, eine Verbindung zu allen seriellen Ports herzustellen.";
SerialAllowAllPortsForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit Websites erstellen, die automatisch die Berechtigung für den Zugriff auf alle verfügbaren seriellen Ports erhalten.\n\nDie URLs müssen gültig sein, da die Richtlinie andernfalls ignoriert wird. Es wird nur der Ursprung (Schema, Host und Port) der URL berücksichtigt.\n\nIn Google Chrome OS gilt diese Richtlinie nur für verknüpfte Nutzer.\n\nDiese Richtlinie überschreibt DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls und die Nutzereinstellungen.";
SerialAllowUsbDevicesForUrls.pfm_title = "Websites automatisch die Berechtigung erteilen, eine Verbindung zu seriellen USB-Geräten herzustellen.";
SerialAllowUsbDevicesForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit Websites erstellen, die automatisch die Berechtigung für den Zugriff auf serielle USB-Geräte erhalten, deren Anbieter- und Produkt-IDs mit den Feldern „vendor_id“ und „product_id“ übereinstimmen. Bei Weglassen des Felds „product_id“ wird den entsprechenden Websites die Berechtigung zum Zugriff auf Geräte gegeben, deren Anbieter-ID mit dem Feld „vendor_id“ übereinstimmt und die ansonsten eine beliebige Produkt-ID haben.\n\nDie URLs müssen gültig sein, da die Richtlinie andernfalls ignoriert wird. Es wird nur der Ursprung (Schema, Host und Port) der URL berücksichtigt.\n\nIn Chrome OS gilt diese Richtlinie nur für verknüpfte Nutzer.\n\nDiese Richtlinie überschreibt DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls und die Nutzereinstellungen.\n\nSie wirkt sich nur auf den Zugriff auf USB-Geräte über die Web Serial API aus. Sieh dir für die Gewährung des Zugriffs auf USB-Geräte über die WebUSB API die Richtlinie WebUsbAllowDevicesForUrls an.\nUnter https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls erhältst du weitere Informationen zu Schema und Formatierung.";
SerialAskForUrls.pfm_title = "Serial API auf diesen Seiten erlauben";
SerialAskForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, die angeben, welche Websites Nutzer um Zugriff auf einen seriellen Port bitten dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultSerialGuardSetting“ für alle Websites, sofern konfiguriert. Falls nicht, werden die persönlichen Einstellungen des Nutzers verwendet.\n\nBei URL-Mustern, die nicht der Richtlinie entsprechen, haben „SerialBlockedForUrls“ (falls eine Übereinstimmung besteht), „DefaultSerialGuardSetting“ (falls konfiguriert) oder die persönlichen Einstellungen des Nutzers Vorrang – in dieser Reihenfolge.\n\nWenn URL-Muster im Konflikt mit „SerialBlockedForUrls“ stehen, werden sie ignoriert.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. * ist kein akzeptierter Wert für diese Richtlinie.";
SerialBlockedForUrls.pfm_title = "Serial API auf diesen Websites blockieren";
SerialBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, die angeben, welche Websites Nutzer nicht um Zugriff auf einen seriellen Port bitten dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultSerialGuardSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nBei URL‑Mustern, die nicht der Richtlinie entsprechen, haben „SerialAskForUrls“ (falls eine Übereinstimmung besteht), „DefaultSerialGuardSetting“ (falls konfiguriert) oder die persönlichen Einstellungen des Nutzers Vorrang – in dieser Reihenfolge.\n\nWenn URL‑Muster im Konflikt mit „SerialAskForUrls“ stehen, hat diese Richtlinie Vorrang.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
ServiceWorkerAutoPreloadEnabled.pfm_title = "Zulassen, dass der ServiceWorker Navigationsanfragen sendet, ohne zu warten, bis er gestartet wird";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nDie Funktion „ServiceWorkerAutoPreload“ sendet eine Netzwerkanfrage für eine Hauptressource, während sie gleichzeitig den Bootstrap-Prozess für den ServiceWorker startet.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, wird in Brave „ServiceWorkerAutoPreload“ aktiviert. Die Navigationsanfrage wird in einigen Szenarien automatisch gesendet, während der ServiceWorker gestartet wird, z. B. wenn der ServiceWorker nicht ausgeführt wird.\n\nWenn die Richtlinie deaktiviert ist, wird in Brave „ServiceWorkerAutoPreload“ nicht aktiviert. Die Navigationsanfrage wird immer gesendet, nachdem der ServiceWorker gestartet wurde.\n\nDiese Richtlinie ist eine vorübergehende Maßnahme zur Steuerung der Funktion und wird in M154 entfernt.";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "Zulassen, dass ServiceWorkers srcdoc-iFrames steuern kann";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "https://github.com/w3c/ServiceWorker/issues/765 fordert an, dass srcdoc-iFrames mit dem Sandbox-Attribut „allow-same-origin“ unter der Kontrolle von ServiceWorkers stehen.\n\nWenn die Richtlinie aktiviert oder nicht konfiguriert ist, werden srcdoc-iFrames mit Sandbox-Attributen „allow-same-origin“ von Brave unter die Kontrolle von ServiceWorkers gestellt.\n\nIst die Richtlinie deaktiviert, wird der srcdoc-iFrame nicht von ServiceWorkers gesteuert.\n\nDiese Richtlinie gilt vorübergehend und wird 2026 entfernt.";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "Legt fest, ob „SharedArrayBuffers“ in einem nicht ursprungsübergreifend isolierten Kontext verwendet werden kann";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "Legt fest, ob „SharedArrayBuffers“ in einem nicht ursprungsübergreifend isolierten Kontext verwendet werden kann. Brave setzt bei der Verwendung von „SharedArrayBuffers“ aus Gründen der Webkompatibilität ab Brave 91 (25.05.2021) die ursprungsübergreifende Isolierung voraus. Weitere Informationen findest du hier: https://developer.chrome.com/blog/enabling-shared-array-buffer/.\n\nBei Auswahl von „Enabled“ können Websites „SharedArrayBuffers“ ohne Einschränkungen verwenden.\n\nWenn du die Richtlinie auf „Disabled“ setzt oder nicht konfigurierst, können Websites „SharedArrayBuffers“ nur in einem ursprungsübergreifend isolierten Kontext verwenden.";
SharedWorkerBlobURLFixEnabled.pfm_title = "Verhalten der SharedWorker-Blob-URL an die Vorgaben anpassen";
SharedWorkerBlobURLFixEnabled.pfm_description = "Gemäß https://w3c.github.io/ServiceWorker/#control-and-use-worker-client sollten Worker Controller für die Blob-URL übernehmen.  Basierend auf dem vorhandenen Code kann der Controller aber nur von DedicatedWorker übernommen werden. SharedWorker übernehmen den Controller nicht.\n\nIst die Richtlinie aktiviert oder nicht konfiguriert, übernimmt Brave den Controller, wenn eine Blob-URL als SharedWorker-URL verwendet wird.\n\nWenn die Richtlinie deaktiviert ist, entspricht das Verhalten nicht den Vorgaben.\n\nDiese Richtlinie ist vorübergehend und wird in Zukunft entfernt.";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "Verlängerte Lebensdauer für SharedWorker aktivieren";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "SharedWorker können eine verlängerte Lebensdauer haben, wenn die Option „extendedLifetime“ im SharedWorker-Konstruktor auf „true“ gesetzt ist.\n\nIst diese Richtlinie aktiviert oder nicht konfiguriert, können SharedWorker eine verlängerte Lebensdauer haben.\n\nIst diese Richtlinie deaktiviert, können SharedWorker keine verlängerte Lebensdauer haben, selbst wenn die Option auf „true“ gesetzt ist.\n\nDiese Richtlinie ist vorübergehend und wird zukünftig entfernt.";
ShoppingListEnabled.pfm_title = "Aktivieren der Funktion „Einkaufsliste“ erlauben";
ShoppingListEnabled.pfm_description = "Mit dieser Richtlinie wird die Verfügbarkeit der Funktion „Einkaufsliste“ gesteuert.\nWenn diese Option aktiviert ist, sehen Nutzer eine Benutzeroberfläche, über die sie den Preis des auf der aktuellen Seite angezeigten Produkts verfolgen können. Das beobachtete Produkt wird in der Seitenleiste für Lesezeichen angezeigt.\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, ist die Einkaufsliste für Nutzer verfügbar.\nIst die Richtlinie deaktiviert, ist die Funktion „Einkaufsliste“ nicht verfügbar.\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "App-Verknüpfung in der Lesezeichenleiste anzeigen";
ShowAppsShortcutInBookmarkBar.pfm_description = "Wenn die Richtlinie auf \"True\" gesetzt ist, wird die Apps-Verknüpfung eingeblendet. Ist sie auf \"False\" gesetzt, wird die Verknüpfung nie eingeblendet.\n\nWenn du diese Richtlinie konfigurierst, kann sie von Nutzern nicht geändert werden. Wenn die Richtlinie nicht konfiguriert ist, können Nutzer die Apps-Verknüpfung über das Kontextmenü der Lesezeichenleiste ein- und ausblenden.";
ShowCastIconInToolbar.pfm_title = "Symbol von Google Cast in der Symbolleiste anzeigen";
ShowCastIconInToolbar.pfm_description = "Wenn die Richtlinie aktiviert ist, erscheint das Google Cast-Symbol in der Symbolleiste oder im Dreipunkt-Menü und Nutzer können es nicht entfernen.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, können Nutzer das Symbol über das Kontextmenü anpinnen oder entfernen.\n\nWenn die Richtlinie „EnableMediaRouter“ deaktiviert ist, hat der Richtlinienwert keine Auswirkungen und das Symbol wird nicht angezeigt.";
ShowCastSessionsStartedByOtherDevices.pfm_title = "Mediensteuerelemente für Google Cast-Sitzungen anzeigen, die von anderen Geräten im lokalen Netzwerk gestartet wurden";
ShowCastSessionsStartedByOtherDevices.pfm_description = "Wenn diese Richtlinie aktiviert ist, steht die Benutzeroberfläche mit Elementen zur Steuerung der Medienwiedergabe für Google Cast-Sitzungen, die von anderen Geräten im lokalen Netzwerk gestartet wurden, zur Verfügung.\n\nIst die Richtlinie für Unternehmensnutzer nicht konfiguriert oder deaktiviert, steht die Benutzeroberfläche zur Steuerung der Medienwiedergabe für Google Cast-Sitzungen, die von anderen Geräten im lokalen Netzwerk gestartet wurden, nicht zur Verfügung.\n\nWenn die Richtlinie EnableMediaRouter deaktiviert ist, hat der Wert dieser Richtlinie keine Auswirkungen, da die gesamte Google Cast-Funktion deaktiviert ist.";
ShowFullUrlsInAddressBar.pfm_title = "Vollständige URLs anzeigen";
ShowFullUrlsInAddressBar.pfm_description = "Durch diese Funktion wird die vollständige URL in der Adressleiste angezeigt.\nWenn diese Richtlinie auf \"True\" gesetzt ist, wird die vollständige URL in der Adressleiste angezeigt, einschließlich Schemas und Subdomains.\nIst diese Richtlinie auf \"False\" gesetzt, wird die standardmäßige URL angezeigt.\nWenn die Richtlinie nicht konfiguriert ist, wird die standardmäßige URL angezeigt und Nutzer können über ein Kontextmenü zwischen der standardmäßigen und vollständigen URL wechseln.\n";
ShowHomeButton.pfm_title = "Startseiten-Button auf Symbolleiste anzeigen";
ShowHomeButton.pfm_description = "Wenn die Richtlinie aktiviert ist, wird die Startbildschirmtaste in der Symbolleiste von Brave angezeigt. Ist die Richtlinie deaktiviert, erscheint die Startbildschirmtaste nicht.\n\nWenn du diese Richtlinie konfigurierst, kann sie von Nutzern in Brave nicht geändert werden. Wenn die Richtlinie nicht konfiguriert ist, können Nutzer selbst entscheiden, ob die Startbildschirmtaste angezeigt werden soll.";
SideSearchEnabled.pfm_title = "Zulassen, dass die neuesten Ergebnisse der Standardsuchmaschine in der Seitenleiste eines Browsers angezeigt werden";
SideSearchEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer ihre neuesten Ergebnisse der Standardsuchmaschine in einer Seitenleiste anzeigen, indem sie ein Symbol in der Symbolleiste ein- oder ausschalten.\n\nWird die Richtlinie deaktiviert, wird das Symbol, das die Seitenleiste mit den Ergebnissen der Standardsuchmaschine öffnet, aus der Symbolleiste entfernt.";
SignedHTTPExchangeEnabled.pfm_title = "Unterstützung für Signed HTTP Exchange (SXG) aktivieren";
SignedHTTPExchangeEnabled.pfm_description = "Wenn die Richtlinie auf \"True\" gesetzt oder nicht konfiguriert ist, werden von Brave Webinhalte akzeptiert, die als Signed HTTP Exchanges implementiert sind.\n\nWenn die Richtlinie auf \"False\" gesetzt ist, werden die Signed HTTP Exchanges nicht geladen.";
SigninInterceptionEnabled.pfm_title = "Anmeldungsabfangen aktivieren";
SigninInterceptionEnabled.pfm_description = "Mit diesen Einstellungen wird das Anmeldungsabfangen aktiviert oder deaktiviert.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, wird das Dialogfeld für das Anmeldungsabfangen geöffnet, wenn im Internet ein Google-Konto hinzugefügt wird. Möglicherweise lohnt es sich für den Nutzer, das Konto in ein anderes neues oder bestehendes Profil zu verschieben.\n\nIst die Richtlinie deaktiviert, wird das Dialogfeld für das Anmeldungsabfangen nicht geöffnet.\nBei einer Deaktivierung wird trotzdem ein Dialogfeld angezeigt, wenn durch „ManagedAccountsSigninRestriction“ eine Profiltrennung für verwaltete Konten erzwungen wird.";
SilentPrintingEnabled.pfm_title = "Stummes Drucken aktivieren";
SilentPrintingEnabled.pfm_description = "Wird diese Richtlinie auf „True“ gesetzt, wird das stumme Drucken aktiviert. Dabei wird das Druckvorschaufenster nach dem Öffnen sofort geschlossen und der Druckvorgang wird mit den Standardeinstellungen auf dem Standarddrucker gestartet. Wenn unter „Standarddrucker“ die Option „Als PDF speichern“ ausgewählt ist, wird die Datei im Ordner „Downloads“ gespeichert.\n\nWird diese Richtlinie nicht konfiguriert oder auf „False“ festgelegt, wird das stumme Drucken deaktiviert. In diesem Fall wird das Druckvorschaufenster nicht automatisch geschlossen und der Nutzer muss wie gewohnt eine Auswahl treffen.";
SitePerProcess.pfm_title = "Website-Isolierung für jede Website erzwingen";
SitePerProcess.pfm_description = "Seit Brave-Version 67 ist die Website-Isolierung auf allen Desktop-Plattformen standardmäßig aktiviert. Dadurch wird jede Website in einem eigenen Prozess ausgeführt. Eine Website ist ein Protokoll plus eTLD+1 (z. B. https://beispiel.de). Wenn diese Richtlinie aktiviert ist, verändert sich dieses Verhalten nicht. Es wird lediglich verhindert, dass Nutzer die Einstellung ändern können und z. B. „Disable site isolation“ in chrome://flags verwenden. Seit Brave-Version 76 wird die Website-Isolierung nicht deaktiviert, wenn die Richtlinie deaktiviert oder nicht konfiguriert wird. Nutzer können sie stattdessen selbst deaktivieren.\n\nIsolateOrigins bietet sich auch für die Isolierung spezifischer Ursprünge bei höherer Granularität als der Websiteebene an (z. B. https://a.beispiel.de).\n\nSetze unter Google Chrome OS-Version 76 oder niedriger die Geräterichtlinie DeviceLoginScreenSitePerProcess auf denselben Wert. Wenn die Werte nicht übereinstimmen, kann es beim Beginn von Nutzersitzungen zu einer Verzögerung kommen.\n\nHinweis: Nutze unter Android stattdessen die Richtlinie SitePerProcessAndroid.";
SiteSearchSettings.pfm_title = "Einstellungen für die Websitesuche";
SiteSearchSettings.pfm_description = "Mit dieser Richtlinie wird eine Liste von Websites bereitgestellt, auf denen Nutzer mithilfe von Kürzeln in der Adressleiste schnell suchen können. Nutzer können eine Suche starten, indem sie das Kürzel oder @Kürzel (z. B. @Arbeit), gefolgt von einem Leerzeichen oder Tabulatorzeichen, in die Adressleiste eingeben.\n\nDie folgenden Felder sind für jede Website Pflichtfelder: „name“, „shortcut“ und „url“.\n\nDas Feld „name“ entspricht dem Namen der Website oder der Suchmaschine, der dem Nutzer in der Adressleiste angezeigt werden soll.\n\n„shortcut“ kann einfache Wörter und Zeichen enthalten, darf jedoch keine Leerzeichen enthalten und nicht mit dem @‑Symbol beginnen. Kürzel müssen außerdem eindeutig sein.\n\nDurch das Feld „url“ wird für jeden Eintrag die URL der Suchmaschine angegeben, die bei einer Suchanfrage mit dem entsprechenden Suchbegriff verwendet wird. Die URL muss den String '{searchTerms}' enthalten, der während des Suchvorgangs durch die Suchbegriffe des Nutzers ersetzt wird. Ungültige Einträge und Einträge mit doppelten Kürzeln werden ignoriert.\n\nWebsitesucheinträge, bei denen das Feld „featured“ auf „true“ gesetzt wurde, werden in der Adressleiste angezeigt, wenn der Nutzer „@“ eingibt. Es können bis zu drei Einträge als „featured“ ausgewählt werden.\n\nWenn bei einem Eintrag für die Websitesuche „allow_user_override“ „true“ ist, können Nutzer diesen Eintrag bearbeiten oder deaktivieren. Als „featured“ gekennzeichnete Suchmaschinen (beginnend mit „@“) können jedoch nur deaktiviert werden. Wenn ein Nutzer einen Eintrag ändert, der ursprünglich durch diese Richtlinie erstellt wurde, wird er nicht mehr durch die Richtlinie verwaltet und stattdessen wie ein vom Nutzer erstelltes Kürzel behandelt. Wenn „allow_user_override“ für einen Eintrag in der Websuche auf „false“ gesetzt oder nicht konfiguriert ist, können Nutzer diesen Eintrag nicht bearbeiten oder deaktivieren. Die Einstellung, die es Nutzern erlaubt, einen Eintrag zu überschreiben, wird nur ab M139 unterstützt. Bei früheren Versionen ist diese Möglichkeit standardmäßig deaktiviert.\n\nNutzer können keine neuen Websitesucheinträge mit einem zuvor über diese Richtlinie erstellten Kürzel erstellen – es sei denn, „allow_user_override“ ist für den Websitesucheintrag auf „true“ festgelegt.\n\nBei Konflikten mit einem zuvor vom Nutzer erstellten Kürzel hat die Nutzereinstellung Vorrang. Nutzer können die von der Richtlinie erstellte Option jedoch trotzdem auslösen, indem sie „@“ in der Suchleiste eingeben. Wenn der Nutzer beispielsweise „Arbeit“ bereits als Kürzel für URL1 definiert hat und die Richtlinie „Arbeit“ als Kürzel für URL2 definiert, löst die Eingabe von „Arbeit“ in der Suchleiste eine Suche nach URL1 aus, aber die Eingabe von „@Arbeit“ in der Suchleiste eine Suche nach URL2.\n\nUnter Microsoft® Windows® steht diese Richtlinie nur bei Instanzen zur Verfügung, die Teil einer Microsoft® Active Directory®-Domain oder von Microsoft® Azure® Active Directory® sind oder die in Chrome Enterprise Core angemeldet sind.\n\nUnter macOS steht diese Richtlinie nur bei Instanzen zur Verfügung, die über die Mobilgeräteverwaltung verwaltet werden, die über MCX Teil einer Domain sind oder die in Chrome Enterprise Core angemeldet sind.\nUnter https://chromeenterprise.google/policies/?policy=SiteSearchSettings erhältst du weitere Informationen zu Schema und Formatierung.";
SmartTabSharingSettings.pfm_title = "Einstellungen für das intelligente Teilen von Tabs";
SmartTabSharingSettings.pfm_description = "0 - Intelligentes Teilen von Tabs mit Google AI Mode-Integrationen zulassen.\n1 - Intelligentes Teilen von Tabs mit Google AI Mode-Integrationen nicht zulassen.\nMit dieser Richtlinie wird die Verwendung der Funktion „Intelligente Tabfreigabe“ des Google AI Mode über die Seitenleiste oder die Tabs in Google Chrome gesteuert.\n\nDiese Richtlinie wirkt sich nicht auf die Webversion von Google AI Mode aus. Sie legt nur fest, wie Nutzer Informationen teilen können, wenn sie Google Chrome verwenden.\n\n0 = Nutzer können Seiten- oder Dateiinhalte mit Google AI Mode teilen.\n\n1 = Nutzer können keine Seiten- oder Dateiinhalte mit Google AI Mode teilen. Die Zugangspunkte zum Teilen von Kontext und die Seitenleiste werden deaktiviert oder ausgeblendet.\n\nDiese Richtlinie wird ignoriert, wenn Google Search nicht die Standardsuchmaschine der Nutzer ist, da die Funktion deaktiviert ist.\n\nDiese Richtlinie ist unabhängig von der Richtlinie „AIModeSettings“. Die Richtlinie „AIModeSettings“ steuert nur Zugangspunkte in der Omnibox oder im Suchfeld auf der Seite „Neuer Tab“, während diese Richtlinie das Teilen von Kontext über die Seitenleiste oder Tabs steuert.\n\nDiese Richtlinie steuert auch nicht die Google Gemini-Integration, die von GeminiSettings deaktiviert werden kann.\n\nWenn „SearchContentSharingSettings“ deaktiviert ist, wird diese Richtlinie ignoriert.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
SpellCheckServiceEnabled.pfm_title = "Webdienst für die Rechtschreibprüfung aktivieren oder deaktivieren";
SpellCheckServiceEnabled.pfm_description = "Wenn diese Richtlinie aktiviert ist, wird die Rechtschreibung mithilfe eines Google-Webdienstes geprüft. Diese Richtlinie steuert nur die Verwendung des Onlinedienstes. Ist die Richtlinie deaktiviert, kommt der Dienst nie zum Einsatz.\n\nWenn die Richtlinie nicht konfiguriert wird, kann der Nutzer bestimmen, ob der Rechtschreibprüfungsdienst genutzt werden soll.\n\nDie Rechtschreibprüfung kann immer lokal auf ein heruntergeladenes Wörterbuch zugreifen, außer die Funktion wurde über SpellcheckEnabled deaktiviert. In diesem Fall hat diese Richtlinie keine Auswirkungen.";
SpellcheckEnabled.pfm_title = "Rechtschreibprüfung aktivieren";
SpellcheckEnabled.pfm_description = "Wenn die Richtlinie aktiviert ist, ist die Rechtschreibprüfung an und Nutzer können sie nicht deaktivieren. Unter Microsoft® Windows®, Google Chrome OS und Linux® können die Sprachen für die Rechtschreibprüfung einzeln aktiviert und deaktiviert werden. Dadurch haben Nutzer die Möglichkeit, die Rechtschreibprüfung durch Deaktivieren aller Sprachen auszuschalten. Soll diese Möglichkeit nicht zur Verfügung stehen, kann die Richtlinie SpellcheckLanguage verwendet dazu werden, die Aktivierung bestimmter Sprachen für die Rechtschreibprüfung zu erzwingen.\n\nWenn die Richtlinie deaktiviert ist, ist die Rechtschreibprüfung aus allen Quellen deaktiviert und Nutzer können sie nicht aktivieren. Die Richtlinien SpellCheckServiceEnabled, SpellcheckLanguage und SpellcheckLanguageBlocklist haben keine Auswirkungen, wenn diese Richtlinie auf „Falsch“ eingestellt ist.\n\nWird die Richtlinie nicht konfiguriert, können Nutzer die Rechtschreibprüfung in den Spracheinstellungen aktivieren oder deaktivieren.";
StandardizedBrowserZoomEnabled.pfm_title = "Standardisiertes Browser-Zoomverhalten aktivieren";
StandardizedBrowserZoomEnabled.pfm_description = "Diese Richtlinie ermöglicht die Konformität mit der neu eingeführten Spezifikation des CSS‑Zooms.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, entspricht die CSS‑Property „zoom“ der Spezifikation:\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\nIst die Richtlinie deaktiviert, wird die CSS‑Property „zoom“ auf das alte Verhalten zurückgesetzt.\n\nDiese Richtlinie ist eine vorübergehende Lösung, damit genug Zeit ist, Webinhalte auf das neue Verhalten umzustellen. Es gibt auch einen Ursprungstest („DisableStandardizedBrowserZoom“), der dem Verhalten entspricht, wenn diese Richtlinie deaktiviert ist. In Version 134 wird diese Richtlinie entfernt und „Aktiviert“ wird zum permanenten Verhalten.";
StaticStorageQuotaEnabled.pfm_title = "Steuern, ob Speicherkontingent-APIs statische Werte zurückgeben";
StaticStorageQuotaEnabled.pfm_description = "Wenn diese Richtlinie aktiviert ist, geben die Speicherkontingent-APIs einen statischen Wert zurück, der dem belegten Speicherplatz + mindestens 10 GiB (Laufwerk wird auf das nächste GiB aufgerundet) entspricht.\nWenn diese Richtlinie deaktiviert ist, geben die Speicherkontingent-APIs in der Regel einen dynamischen Wert zurück, der proportional zum auf dem Gerät verfügbaren Gesamtspeicherplatz berechnet wird, unabhängig davon, wie viel Speicherplatz belegt ist.\nIst diese Richtlinie nicht konfiguriert, verwenden die Speicherkontingent-APIs das Standardverhalten von Chrome.\nWebsites mit der Berechtigung zur unbegrenzten Speicherung sind von dieser Einstellung nicht betroffen. Auch das erzwungene Kontingent ist davon nicht betroffen.";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "Strikte MIME-Typprüfung für Worker-Skripts aktivieren";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "Mit dieser Richtlinie wird die strikte MIME-Typprüfung für Worker-Skripts aktiviert.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, werden bei Worker-Skripts strikte MIME-Typprüfungen für JavaScript durchgeführt. Das ist das neue Standardverhalten. Worker-Skripts mit älteren MIME-Typen werden abgelehnt.\n\nWenn diese Richtlinie deaktiviert ist, wird bei Worker-Skripts die laxe MIME-Typprüfung durchgeführt, sodass Worker-Skripts mit älteren MIME-Typen wie text/ascii weiterhin geladen und ausgeführt werden.\n\nIn Browsern wurde bisher die laxe MIME-Typprüfung verwendet, sodass Ressourcen mit einer Reihe von älteren MIME-Typen unterstützt wurden. Für JavaScript-Ressourcen ist zum Beispiel text/ascii ein alter unterstützter MIME-Typ. Dies kann zu Sicherheitsproblemen führen, da Ressourcen so als Skripts geladen werden können, die nie als solche gedacht waren. Chrome wird in naher Zukunft auf eine strikte MIME-Typprüfung umgestellt. Wenn die Richtlinie aktiviert ist, wird das Standardverhalten angewendet. Wenn die Richtlinie deaktiviert ist, können Administratoren das bisherige Verhalten beibehalten.\n\nWeitere Informationen zu den Medientypen JavaScript/ECMAScript findest du unter https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage.\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "JavaScript-Dialogfelder unterdrücken, die von anderen Quell-Subframes ausgelöst wurden";
SuppressDifferentOriginSubframeDialogs.pfm_description = "Wie unter https://www.chromestatus.com/feature/5148698084376576 beschrieben, werden von window.alert, window.confirm und window.prompt ausgelöste modale JavaScript-Dialogfelder in Brave blockiert, wenn sie von einem Subframe ausgelöst werden, dessen Quelle sich von der Quelle des Hauptframes unterscheidet.\n\nMit dieser Richtlinie kann diese Änderung überschrieben werden.\nIst die Richtlinie aktiviert oder nicht konfiguriert, werden JavaScript-Dialogfelder, die von einem anderen Quell-Subframe ausgelöst wurden, blockiert.\nIst die Richtlinie deaktiviert, werden JavaScript-Dialogfelder, die von einem anderen Quell-Subframe ausgelöst wurden, nicht blockiert.\n\nDiese Richtlinie wird in Zukunft aus Brave entfernt.";
SuppressUnsupportedOSWarning.pfm_title = "Warnung für nicht unterstützte Betriebssysteme unterdrücken";
SuppressUnsupportedOSWarning.pfm_description = "Wenn die Richtlinie aktiviert ist, wird keine Warnung angezeigt, wenn Brave auf einem nicht unterstützten Computer oder unter einem nicht unterstützten Betriebssystem ausgeführt wird.\n\nIst die Richtlinie deaktiviert oder nicht konfiguriert, wird die Warnung auf nicht unterstützten Systemen angezeigt.";
SyncDisabled.pfm_title = "Synchronisierung der Daten mit Google deaktivieren";
SyncDisabled.pfm_description = "Wenn diese Richtlinie aktiviert ist, wird die Datensynchronisierung in Brave über von Google gehostete Synchronisierungsdienste deaktiviert.\nMöchtest du die Chrome Sync-Dienste vollständig deaktivieren, empfehlen wir dir, den Dienst in der Google Admin console zu deaktivieren.\n\nWenn diese Richtlinie deaktiviert oder nicht konfiguriert ist, dürfen Nutzer selbst entscheiden, ob sie die Chrome Sync verwenden möchten.\n\nHinweis: Aktiviere diese Richtlinie nicht, wenn „RoamingProfileSupportEnabled“ aktiviert ist, da diese Funktion über dieselbe clientseitige Funktion verfügt. Die von Google gehostete Synchronisierung ist in diesem Fall vollständig deaktiviert.";
SyncTypesListDisabled.pfm_title = "Liste von Typen, die von der Synchronisierung ausgeschlossen werden sollen";
SyncTypesListDisabled.pfm_description = "Wenn du diese Richtlinie konfigurierst, werden alle angegebenen Datentypen von der Synchronisierung ausgeschlossen. Dies gilt sowohl für die Chrome Sync als auch für die Synchronisierung von Roaming-Profilen. Dadurch lässt sich die Größe von Roaming-Profilen reduzieren und du kannst einschränken, welche Arten von Daten auf die Chrome Sync-Server hochgeladen werden.\n\nAktuell werden folgende Datentypen unterstützt: „apps“, „autofill“, „bookmarks“, „extensions“, „preferences“, „passwords“, „payments“, „productComparison“, „readingList“, „tabs“, „themes“, „typedUrls“, „wifiConfigurations“. Bei diesen Namen muss die Groß- und Kleinschreibung beachtet werden.\n\nHinweis: Die dynamische Richtlinienaktualisierung wird nur in Brave-Version 123 oder höher unterstützt. Wenn du „autofill“ deaktivierst, wird auch „payments“ deaktiviert. „typedUrls“ bezieht sich auf den gesamten Browserverlauf.";
TLS13EarlyDataEnabled.pfm_title = "TLS 1.3 Early Data aktivieren";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Early Data ist eine Erweiterung von TLS 1.3, mit der eine HTTP-Anfrage gleichzeitig mit dem TLS‑Handshake gesendet werden kann.\n\nWenn diese Richtlinie nicht konfiguriert ist, folgt Brave dem standardmäßigen Einführungsprozess für TLS 1.3 Early Data.\n\nWenn sie aktiviert ist, wird TLS 1.3 Early Data von Brave aktiviert.\n\nIst die Richtlinie deaktiviert, wird TLS 1.3 Early Data nicht von Brave aktiviert.\n\nWenn aktiviert, kann Brave je nach Serversupport TLS 1.3 Early Data verwenden oder nicht.\n\nTLS 1.3 Early Data ist ein etabliertes Protokoll. Bestehende TLS‑Server, Zwischengeräte und Sicherheitssoftware sollten TLS 1.3 Early Data ohne Verbindungsabbruch verarbeiten oder ablehnen.\n\nAuf Geräten, auf denen TLS nicht korrekt implementiert wird, kann es jedoch zu Fehlfunktionen und Verbindungsabbrüchen kommen, wenn TLS 1.3 Early Data verwendet wird. Administratoren sollten in solchen Fällen den Anbieter fragen, wie sich das Problem beheben lässt.\n\nDiese Richtlinie ist eine vorübergehende Maßnahme zur Steuerung der Funktion und wird danach entfernt. Sie kann aktiviert werden, um zu prüfen, ob Probleme auftreten, und lässt sich zum Beheben etwaiger Probleme deaktivieren.";
TabCaptureAllowedByOrigins.pfm_title = "Tabaufnahme für diese Ursprünge zulassen";
TabCaptureAllowedByOrigins.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, die die Tabaufnahme verwenden können.\n\nIst sie nicht konfiguriert, können Websites diese Aufnahmefunktion nicht nutzen.\n\nBitte beachte, dass Chrome-Apps im Fenstermodus trotzdem aufgenommen werden können.\n\nDiese Richtlinie wird nicht berücksichtigt, wenn eine Website mit einem URL-Muster in der Richtlinie „SameOriginTabCaptureAllowedByOrigins“ übereinstimmt.\n\nWenn eine Website mit einem URL-Muster in dieser Richtlinie übereinstimmt, werden die folgenden Richtlinien nicht berücksichtigt: „WindowCaptureAllowedByOrigins“, „ScreenCaptureAllowedByOrigins“ und „ScreenCaptureAllowed“.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.  Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL-Musters ignoriert.";
TabCompareSettings.pfm_title = "Einstellungen für „Tab Compare“";
TabCompareSettings.pfm_description = "0 - Tab Compare zulassen und KI‑Modelle verbessern.\n1 - Tabs Compare zulassen, ohne KI‑Modelle zu verbessern.\n2 - Tab Compare nicht zulassen.\n„Tab Compare“ ist ein KI‑basiertes Tool, mit dem Informationen auf Tabs verglichen werden können. Beispielsweise kann diese Funktion dem Nutzer angeboten werden, wenn mehrere Tabs mit Produkten einer ähnlichen Kategorie geöffnet sind.\n\n„0“ = Die Funktion darf verwendet werden und Google darf relevante Daten nutzen, um seine KI‑Modelle zu verbessern. Relevante Daten können je nach Funktion Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftliches Feedback sein. Sie werden möglicherweise auch manuell geprüft, um KI‑Modelle zu verbessern. „0“ ist der Standardwert, außer in den unten angegebenen Fällen.\n\n„1“ = Die Funktion darf verwendet werden, Google darf aber keine Modelle mithilfe von Nutzerinhalten (einschließlich Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftlichen Feedbacks) verbessern. „1“ ist der Standardwert für Unternehmensnutzer, die über die Google Admin console verwaltet werden, sowie für Konten von Bildungseinrichtungen, die über Google Workspace verwaltet werden.\n\n„2“ = Die Funktion darf nicht verwendet werden.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
TabDiscardingExceptions.pfm_title = "URL-Muster-Ausnahmen für das Verwerfen von Tabs";
TabDiscardingExceptions.pfm_description = "Mit dieser Richtlinie wird jede URL, die mit einem oder mehreren der angegebenen Muster (im URLBlocklist-Filterformat) übereinstimmt, nie vom Browser verworfen.\nDies gilt für das Verwerfen bei hoher Speicherauslastung und bei der Verwendung des Modus für hohe Effizienz.\nVerworfene Seiten werden entfernt und die zugehörigen Ressourcen vollständig freigegeben. Der Tab, mit dem sie verknüpft sind, bleibt im Tabstreifen. Wird er jedoch sichtbar, wird eine vollständige Aktualisierung ausgelöst.\n";
TaskManagerEndProcessEnabled.pfm_title = "Beenden von Prozessen im Task-Manager erlauben";
TaskManagerEndProcessEnabled.pfm_description = "Wenn diese Richtlinie deaktiviert ist, können Nutzer Prozesse nicht im Task-Manager beenden.\n\nWenn die Richtlinie aktiviert ist oder nicht konfiguriert wird, können Nutzer Prozesse im Task-Manager beenden.";
ThirdPartyAiChatSettings.pfm_title = "Einstellungen für KI-Modus-Integrationen von Drittanbietern in der Adressleiste und im Suchfeld auf der Seite „Neuer Tab“.";
ThirdPartyAiChatSettings.pfm_description = "0 - KI-Modus-Integrationen von Drittanbietern zulassen.\n1 - KI-Modus-Integrationen von Drittanbietern nicht zulassen.\nMit dieser Richtlinie werden die KI-Modus-Integrationen von Drittanbietern in der Adressleiste und im Suchfeld auf der Seite „Neuer Tab“ gesteuert.\n\nFür den Zugriff auf diese Funktion muss eine Drittanbieter-Suchmaschine, die den KI-Modus unterstützt, als Standardsuchmaschine des Nutzers festgelegt sein.\n\n0 = Die Funktion ist für Nutzer verfügbar.\n\n1 = Die Funktion ist für Nutzer nicht verfügbar.\n\nWenn die Richtlinie nicht konfiguriert ist, wird ihr Verhalten durch die Richtlinie „GenAiDefaultSettings“ bestimmt.";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "Mit dieser Richtlinie kannst du ein Limit für die Arbeitsspeichernutzung von Chrome festlegen";
TotalMemoryLimitMb.pfm_description = "Diese Richtlinie legt fest, wie viel Arbeitsspeicher eine einzelne Instanz von Brave verbrauchen darf, bevor Tabs verworfen werden, um Arbeitsspeicher zu leeren. Der vom jeweiligen Tab verbrauchte Arbeitsspeicher wird freigegeben und der Tab muss neu geladen werden, wenn er wieder aufgerufen wird.\n\nWenn diese Richtlinie konfiguriert wird, verwirft der Browser Tabs, um Arbeitsspeicher zu leeren, sobald das Limit überschritten wird. Es gibt jedoch keine Garantie dafür, dass der Browser immer unterhalb des Limits bleibt. Jeder Wert unter 1024 wird auf 1024 aufgerundet.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird der Browser versuchen, Arbeitsspeicher zu leeren, wenn der verfügbare Arbeitsspeicher auf dem jeweiligen Gerät gering ist.";
TranslateEnabled.pfm_title = "Übersetzung aktivieren";
TranslateEnabled.pfm_description = "Wenn du diese Richtlinie auf \"True\" setzt, wird eine Übersetzungsfunktion implementiert, wenn dies für Nutzer angemessen ist. In diesem Fall werden in Brave eine integrierte Übersetzungssymbolleiste sowie eine Übersetzungsfunktion im Kontextmenü angezeigt, das mit einem Rechtsklick geöffnet werden kann. Wird die Richtlinie auf \"False\" gesetzt, werden alle integrierten Übersetzungsfunktionen ausgeschaltet.\n\nNach dem Konfigurieren der Richtlinie kann diese Funktion von den Nutzern nicht mehr geändert werden. Ist sie dagegen nicht konfiguriert, kann der Nutzer die Einstellung ändern.";
TranslatorAPIAllowed.pfm_title = "Translator API zulassen";
TranslatorAPIAllowed.pfm_description = "Wenn diese Richtlinie aktiviert oder nicht konfiguriert ist, darf die Translator API in Brave verwendet werden.\n\nIst die Richtlinie deaktiviert, darf die Translator API nicht verwendet werden.";
TryOnYouSettings.pfm_title = "Einstellungen für „Anprobieren“.";
TryOnYouSettings.pfm_description = "0 - „Anprobieren“ mit Modellverbesserung aktivieren.\n1 - „Anprobieren“ ohne Modellverbesserung aktivieren.\n2 - „Anprobieren“ deaktivieren.\n„Anprobieren“ ist eine KI-basierte Funktion, mit der Nutzer Kleidung, die sie im Web finden, virtuell anprobieren können. Wenn Gemini in Chrome aktiviert ist, erhalten sie außerdem hilfreiche Shopping-Informationen.\n\n„0“ = Die Nutzung der Funktion wird zugelassen, wobei Google relevante Daten zur Verbesserung seiner KI-Modelle verwenden darf. Relevante Daten können je nach Funktion Bilder, Eingaben, Ausgaben, Quellenmaterial und Feedback sein. Diese Daten werden möglicherweise auch manuell überprüft, um KI-Modelle zu verbessern. „0“ ist der Standardwert, sofern unten nicht anders angegeben.\n\n„1“ = Die Nutzung der Funktion wird zugelassen, Google darf die Modelle jedoch nicht mithilfe von Nutzerinhalten (einschließlich Bildern, Eingaben, Ausgaben, Quellenmaterial und Feedback) verbessern. „1“ ist der Standardwert für Unternehmensnutzer, die über die Google Admin console verwaltet werden, und für Konten von Bildungseinrichtungen, die über Google Workspace verwaltet werden.\n\n„2“ = Die Nutzung der Funktion wird nicht zugelassen.\n\nHinweis: Die Einschränkung von Modellverbesserungen (Wert „1“) gilt nur, wenn „Anprobieren“ über den Chrome-Browser-Flow ausgelöst wird. Sie gilt nicht, wenn die Funktion über andere Flows verwendet wird.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt. Weitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen sind unter https://support.google.com/chrome/a?p=generative_ai_settings verfügbar.\n\n„Anprobieren“ ist nicht in allen Ländern und Sprachen verfügbar. Das Festlegen dieser Richtlinie garantiert nicht, dass die Funktion aktiviert wird. Sie ist weiterhin von der Verfügbarkeit abhängig. Weitere Informationen zur Einführung der Funktion sind in den Versionshinweisen für Chrome Enterprise unter https://support.google.com/chrome/a/answer/7679408 verfügbar.";
URLAllowlist.pfm_title = "Zugriff auf eine Liste mit URLs erlauben";
URLAllowlist.pfm_description = "Mit dieser Richtlinie kann auf die aufgeführten URLs zugegriffen werden (als Ausnahmen von „URLBlocklist“). Informationen zum Format der Einträge in der Liste findest du in der Beschreibung der Richtlinie. Beispielsweise werden alle Anfragen blockiert, wenn du „URLBlocklist“ auf * setzt. Du kannst diese Richtlinie verwenden, um den Zugriff auf eine eingeschränkte Liste mit URLs zu erlauben. Mit ihr lassen sich bei Verwendung des unter https://support.google.com/chrome/a?p=url_blocklist_filter_format angegebenen Formats Ausnahmen für bestimmte Schemas, Subdomains anderer Domains, Ports oder bestimmte Pfade festlegen. Mit dem spezifischsten Filter wird festgelegt, ob eine URL blockiert oder zulässig ist. Die Richtlinie „URLAllowlist“ hat Vorrang vor „URLBlocklist“. Diese Richtlinie ist auf 1.000 Einträge beschränkt.\n\nMit ihr lässt sich außerdem das automatische Aufrufen durch Browser externer Anwendungen aktivieren, die als Handler für die aufgeführten Protokolle registriert sind, z. B. „tel:“ oder „ssh:“.\n\nWenn die Richtlinie nicht konfiguriert ist, sind keine Ausnahmen zu „URLBlocklist“ möglich.\n\nAb Version 92 von Brave wird diese Richtlinie auch im monitorlosen Modus unterstützt.";
URLBlocklist.pfm_title = "Zugriff auf aufgelistete URLs blockieren";
URLBlocklist.pfm_description = "Wenn die Richtlinie „URLBlocklist“ konfiguriert ist, wird verhindert, dass Webseiten mit unzulässigen URLs geladen werden. Administratoren können eine Liste mit URL-Mustern angeben, die blockiert werden sollen. Ist die Richtlinie nicht konfiguriert, werden keine URLs im Browser blockiert. In der Richtlinie „URLAllowlist“ können bis zu 1.000 Ausnahmen definiert werden. Wie ein URL-Muster formatiert wird, siehst du unter https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nHinweis: Diese Richtlinie gilt nicht für In-Page-JavaScript-URLs mit dynamisch geladenen Daten. Wenn du etwa „beispiel.de/abc“ blockierst, kann „beispiel.de“ diese URL trotzdem über „XMLHTTPRequest“ laden. Außerdem hindert diese Richtlinie Webseiten nicht daran, die in der Omnibox angezeigte URL über die JavaScript History API in eine blockierte URL zu ändern.\n\nAb Version 73 von Brave kannst du „javascript://*“-URLs blockieren. Das betrifft jedoch nur JavaScript, das in die Adressleiste eingegeben wird, oder beispielsweise Bookmarklets.\n\nAb Version 92 von Brave wird diese Richtlinie auch im monitorlosen Modus unterstützt.\n\nAb Version 147 von Brave gilt der Platzhalter „*“ allein nicht für interne chrome://-URLs. Wenn du diese blockieren möchtest, musst du explizit das Muster „chrome://*“ verwenden.\n\nHinweis: Wenn interne URLs von „chrome://*“ und „chrome-untrusted://*“ blockiert werden, kann dies zu unerwarteten Fehlern führen oder in einigen Fällen umgangen werden. Statt bestimmte interne URLs zu blockieren, solltest du nachsehen, ob es spezifischere Richtlinien gibt. Beispiel:\n\n– Anstatt „chrome://settings/certificates“ zu blockieren, verwende „CACertificateManagementAllowed“.\n\n– Anstatt „chrome-untrusted://crosh“ zu blockieren, verwende „SystemFeaturesDisableList“.\n\n– Anstatt „devtools://*“ zu blockieren, verwende die Richtlinie „DeveloperToolsAvailability“, „DeveloperToolsAvailabilityAllowlist“ oder „DeveloperToolsAvailabilityBlocklist“.";
UpdateOnZeroWindowEnabled.pfm_title = "Steuert den automatischen Neustart im Hintergrund, wenn alle Browserfenster geschlossen sind";
UpdateOnZeroWindowEnabled.pfm_description = "Steuert das Verhalten beim automatischen Neustart im Hintergrund unter macOS, wenn ein Sicherheitsupdate aussteht und alle Browserfenster geschlossen sind.\n\nIst diese Richtlinie auf „True“ gesetzt oder nicht konfiguriert, darf Brave automatisch neu gestartet werden, um ausstehende Updates anzuwenden, wenn alle Browserfenster geschlossen sind.\n\nIst diese Richtlinie auf „False“ gesetzt, werden automatische Neustarts deaktiviert, wenn alle Browserfenster geschlossen sind.";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "Anonymisierte URL-Datenerfassung aktivieren";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "Ist diese Richtlinie aktiviert, ist die anonymisierte URL-Datenerfassung immer aktiv. Das heißt, URLs der von Nutzern besuchten Seiten werden an Google gesendet, um Suchanfragen und das Surfen zu verbessern.\n\nWenn die Richtlinie deaktiviert ist, erfolgt keine anonymisierte URL-Datenerfassung.\n\nWenn die Richtlinie nicht konfiguriert ist, können die Nutzer diese Einstellung manuell ändern.\n\nIn Google Chrome OS Kiosk bietet diese Richtlinie nicht die Option „Nutzer kann entscheiden“. Wenn diese Richtlinie für Google Chrome OS Kiosk nicht festgelegt ist, ist die anonymisierte URL-Datenerfassung immer aktiv.\nWenn diese Richtlinie für Google Chrome OS Kiosk festgelegt ist, wird die URL-Messwerterfassung für Kiosk-Apps aktiviert.";
UserDataDir.pfm_title = "Verzeichnis für Nutzerdaten festlegen";
UserDataDir.pfm_description = "Hiermit wird das Verzeichnis konfiguriert, in dem Brave die Nutzerdaten speichert.\n\nWenn du diese Richtlinie festlegst, verwendet Brave das bereitgestellte Verzeichnis unabhängig davon, ob der Nutzer das Argument \"--user-data-dir\" angegeben hat. Um Datenverluste oder andere unerwartete Fehler zu vermeiden, darf diese Richtlinie nicht auf ein Verzeichnis festgelegt werden, das für andere Zwecke verwendet wird, weil Brave die entsprechenden Inhalte verwaltet.\n\nUnter https://support.google.com/chrome/a?p=Supported_directory_variables findest du eine Liste mit Variablen, aus denen du wählen kannst.\n\nSollte diese Richtlinie nicht konfiguriert sein, kommt der Standardprofilpfad zum Einsatz, wobei der Nutzer dies mit dem Befehlszeilenparameter \"--user-data-dir\" ändern kann.";
UserDataSnapshotRetentionLimit.pfm_title = "Begrenzt die Anzahl der Snapshots von Nutzerdaten, die für den Fall eines Notfall-Rollbacks aufbewahrt werden.";
UserDataSnapshotRetentionLimit.pfm_description = "Nach jedem größeren Versionsupdate erstellt Chrome für den Fall eines Notfall-Rollbacks einen Snapshot bestimmter Browserdaten des Nutzers. Falls ein Notfall-Rollback für eine Version durchgeführt wird, für die der Nutzer einen passenden Snapshot hat, werden die darin gespeicherten Daten wiederhergestellt. Hierdurch verliert der Nutzer seine Einstellungen wie beispielsweise Lesezeichen und Autofill-Daten nicht.\n\nIst diese Richtlinie nicht konfiguriert, wird der Standardwert \"3\" verwendet.\n\nIst sie konfiguriert, werden ältere Snapshots bei Bedarf gelöscht, um das Limit einzuhalten. Ist sie auf \"0\" gesetzt ist, werden keine Snapshots erstellt.";
UserFeedbackAllowed.pfm_title = "Nutzerfeedback zulassen";
UserFeedbackAllowed.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, können Nutzer über das Menü > „Hilfe“ > „Problem melden“ oder die entsprechende Tastenkombination Feedback an Google senden.\n\nIst die Richtlinie deaktiviert, können Nutzer kein Feedback an Google senden.";
VideoCaptureAllowed.pfm_title = "Videoaufzeichnung gestatten oder ablehnen";
VideoCaptureAllowed.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, wird beim Zugriff für Videoaufnahmen beim Nutzer nachgefragt. Ausgenommen sind URLs in der Liste \"VideoCaptureAllowedUrls\".\n\nIst diese Richtlinie deaktiviert, wird nie beim Nutzer nachgefragt und die Möglichkeit für Videoaufnahmen steht nur URLs in der Liste \"VideoCaptureAllowedUrls\" zur Verfügung.\n\nHinweis: Diese Richtlinie gilt für jegliche Form der Videoeingabe, nicht nur für die integrierte Kamera.";
VideoCaptureAllowedUrls.pfm_title = "URLs, denen ohne Nachfrage Zugriff auf Videoaufnahmegeräte gestattet wird";
VideoCaptureAllowedUrls.pfm_description = "Wenn du diese Richtlinie konfigurierst, gibst du eine Liste von URLs an, deren Muster mit dem Sicherheits-Ursprung der anfragenden URL abgeglichen werden. Bei einer Übereinstimmung wird ohne Nachfrage Zugriff auf Videoaufnahmegeräte gewährt.\n\nAusführliche Informationen zu gültigen url-Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/. Das Muster „*“, das bei jeder URL zu einer Übereinstimmung führt, wird von dieser Richtlinie jedoch nicht unterstützt.";
VoiceTypingSettings.pfm_title = "Einstellungen für die Spracheingabe";
VoiceTypingSettings.pfm_description = "0 - Spracheingabe zulassen.\n1 - Spracheingabe ohne Datenerhebung zulassen.\n2 - Spracheingabe nicht zulassen.\nDie Spracheingabe ist eine KI-basierte Funktion, mit der Nutzer durch Sprechen Text eingeben und bearbeiten können. Sie basiert auf generativen KI-Modellen, die eine hochwertige Transkription und Formatierung ermöglichen.\n\n„0“ = Die Funktion darf verwendet werden und Google darf relevante Daten nutzen, um seine KI‑Modelle zu verbessern. Relevante Daten können je nach Funktion Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftliches Feedback sein. Sie werden möglicherweise auch manuell überprüft, um KI‑Modelle zu verbessern. „0“ ist der Standardwert, sofern unten nicht anders angegeben.\n\n„1“ = Die Funktion darf verwendet werden, Google darf aber keine Modelle mithilfe von Nutzerinhalten (einschließlich Prompts, Eingaben, Ausgaben, Quellmaterialien und schriftlichen Feedbacks) verbessern. „1“ ist der Standardwert für Unternehmensnutzer, die über die Google Admin console verwaltet werden, und für Konten einer Bildungseinrichtung, die über Google Workspace verwaltet werden.\n\n„2“ = Die Funktion darf nicht verwendet werden.\n\nWenn die Richtlinie nicht konfiguriert ist, wird das Verhalten der Funktion durch die Richtlinie „GenAiDefaultSettings“ bestimmt.\n\nWeitere Informationen zur Datenverarbeitung bei auf generativer KI basierenden Funktionen findest du unter https://support.google.com/chrome/a?p=generative_ai_settings.";
WPADQuickCheckEnabled.pfm_title = "WPAD-Optimierung aktivieren";
WPADQuickCheckEnabled.pfm_description = "Wenn die Richtlinie aktiviert oder nicht konfiguriert ist, wird die WPAD (Web Proxy Auto-Discovery)-Optimierung in Brave aktiviert.\n\nIst sie deaktiviert, ist die WPAD-Optimierung deaktiviert, sodass Brave länger auf DNS-basierte WPAD-Server warten muss.\n\nUnabhängig davon, ob die Richtlinie konfiguriert ist, kann die WPAD-Optimierung nicht von Nutzern geändert werden.";
WarnBeforeQuittingEnabled.pfm_title = "Warnung anzeigen, wenn der Nutzer versucht, den Browser zu schließen";
WarnBeforeQuittingEnabled.pfm_description = "Steuert das Dialogfeld „Vor Beenden warnen (⌘ + Q)“, wenn der Nutzer versucht, den Browser zu schließen.\n\nWenn diese Richtlinie aktiviert oder nicht konfiguriert ist, wird eine Warnung angezeigt, wenn der Nutzer versucht, den Browser zu schließen.\n\nIst die Richtlinie deaktiviert, wird keine Warnung angezeigt, wenn der Nutzer versucht, den Browser zu schließen.";
WebAppInstallByUserEnabled.pfm_title = "Installation von Web-Apps durch Nutzer über den Browser aktivieren";
WebAppInstallByUserEnabled.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob Nutzer Web-Apps über den Browser installieren können.\nWenn du diese Richtlinie aktivierst oder nicht konfigurierst, können Nutzer Web-Apps über den Browser installieren.\nWenn du diese Richtlinie deaktivierst, können Nutzer keine Web-Apps über den Browser installieren und der Datentyp „Apps“ wird für Chrome Sync von der Synchronisierung ausgeschlossen.\nDiese Richtlinie unterstützt die dynamische Aktualisierung nicht. Änderungen, z. B. das Aktivieren, Deaktivieren oder Nichtkonfigurieren, werden erst nach einem Neustart des Browsers wirksam.\nDiese Richtlinie hat keine Auswirkungen auf die Richtlinie „WebAppInstallForceList“.";
WebAppInstallForceList.pfm_title = "Ohne Nutzereingriff zu installierende URLs für Web-Apps.";
WebAppInstallForceList.pfm_description = "Wenn die Richtlinie konfiguriert ist, wird eine Liste von Web-Apps festgelegt, die automatisch – also ohne Interaktion des Nutzers – installiert werden und vom Nutzer weder deinstalliert noch deaktiviert werden können.\n\nJedes Listenelement der Richtlinie ist ein Objekt, das aus der erforderlichen Komponente\n„url“ (der URL der Web-App, die installiert werden soll)\n\nund sechs optionalen Komponenten besteht:\n– „default_launch_container“\n(legt fest, wie die Web-App geöffnet wird – standardmäßig auf einem neuen Tab)\n\n– „create_desktop_shortcut“\n(auf „True“ setzen, wenn du Desktopverknüpfungen für Linux und\nMicrosoft® Windows® erstellen möchtest)\n\n„fallback_app_name“\n(Ab Brave Version 90 –\nermöglicht, den App-Namen zu überschreiben, wenn es keine\nprogressive Web-App (PWA) ist oder es eine temporär installierte PWA ist,\nfür die vor Abschluss der Installation\neine Authentifizierung erforderlich ist. Wenn sowohl\n„custom_name“ als auch\n„fallback_app_name“ angegeben sind,\nwird Letzteres ignoriert.)\n\n– „custom_name“\n(Ab Google Chrome OS\nVersion 99 und Version 112 unter allen anderen Desktop-Betriebssystemen – ermöglicht,\nden App-Namen für alle Web-Apps und PWAs dauerhaft zu überschreiben.\n\n– „custom_icon“\n(Ab Google Chrome OS\nVersion 99 und Version 112 unter allen anderen Desktop-Betriebssystemen – ermöglicht,\ndas App-Symbol installierter Apps zu überschreiben. Die\nSymbole müssen quadratisch und maximal 1 MB groß sein und in einem der folgenden\nFormate vorliegen: JPEG, PNG, GIF, WEBP, ICO.\nDer Hashwert muss der SHA256-Hash der Symboldatei sein. Die URL „url“\nsollte ohne Authentifizierung zugänglich sein, damit das Symbol bei der\nApp-Installation verwendet werden kann.\n\n– „install_as_shortcut“\n(Ab Brave\nVersion 107.) Bei Aktivierung wird die jeweilige URL „url“\nals Verknüpfung – wie bei Verwendung der Option „Verknüpfung erstellen…“ –\nauf dem GUI des Desktop-Browsers installiert.\nHinweis: Wenn sie als Verknüpfung installiert wird, wird sie nicht aktualisiert, wenn sich das\nManifest in „url“ ändert.\nWenn die Richtlinie deaktiviert oder nicht konfiguriert ist, wird die Web-App bei der jeweiligen URL\n(„url“) normal installiert.\n\nIn „PinnedLauncherApps“ wird beschrieben, wie du Apps an die Google Chrome OS-Ablage anpinnen kannst.\nUnter https://chromeenterprise.google/policies/?policy=WebAppInstallForceList erhältst du weitere Informationen zu Schema und Formatierung.";
WebAppSettings.pfm_title = "Einstellungen zur Verwaltung der Web-App";
WebAppSettings.pfm_description = "Mit dieser Richtlinie kann ein Administrator Einstellungen für installierte Web-Apps angeben. Diese Richtlinie ordnet die ID einer Web-App einer bestimmten Einstellung zu. Mit der spezifischen ID * kannst du eine Standardkonfiguration festlegen, die für alle Web-Apps angewendet wird, die keine benutzerdefinierte Konfiguration in dieser Richtlinie haben.\n\nDas Feld manifest_id ist die Manifest-ID der Web-App. Unter https://developer.chrome.com/blog/pwa-manifest-id/ findest du eine Anleitung dazu, wie du die Manifest-ID einer installierten Web-App herausfindest.\nDas Feld run_on_os_login gibt an, ob eine Web-App während OS Login verwendet werden kann. Wenn dieses Feld auf blocked gesetzt ist, funktioniert die Web-App während OS Login nicht. Nutzer können dies später nicht aktivieren. Ist es auf run_windowed gesetzt, funktioniert die Web-App während OS Login. Nutzer können dies später nicht deaktivieren. Wenn das Feld auf allowed gesetzt ist, können Nutzer die Web-App so konfigurieren, dass sie während OS Login funktioniert. Die Standardkonfiguration lässt nur die Werte allowed und blocked zu.\n(Seit Version 117) Mit dem Feld prevent_close_after_run_on_os_login wird angegeben, ob verhindert werden soll, dass eine Web-App geschlossen wird, z. B. durch den Nutzer, den Task-Manager oder Web-APIs. Dieses Verhalten kann nur aktiviert werden, wenn run_on_os_login auf run_windowed gesetzt ist. Wenn die App gerade ausgeführt wird, wird diese Einstellung erst nach dem Neustart der App wirksam. Ist dieses Feld nicht definiert, können Apps von Nutzern geschlossen werden.\n(Seit Version 118) Im Feld force_unregister_os_integration wird angegeben, ob die gesamte Betriebssystemintegration für eine Web-App entfernt wird, z. B. Verknüpfungen, Datei-Handler und Protokoll-Handler. Wenn eine App bereits ausgeführt wird, wird diese Eigenschaft nach dem Neustart der App wirksam. Dieses Feld sollte mit Vorsicht verwendet werden, da dadurch jegliche Betriebssystemintegration überschrieben werden kann, die automatisch beim Start des Web-App-Systems festgelegt wird. Es funktioniert derzeit nur auf Windows-, Mac- und Linux-Plattformen.\nUnter https://chromeenterprise.google/policies/?policy=WebAppSettings erhältst du weitere Informationen zu Schema und Formatierung.";
WebAudioOutputBufferingEnabled.pfm_title = "Adaptives Zwischenspeichern für Web Audio aktivieren";
WebAudioOutputBufferingEnabled.pfm_description = "Mit dieser Richtlinie wird festgelegt, ob der Browser adaptives Zwischenspeichern für Web Audio verwendet. Durch diese Funktion können Audiofehler reduziert werden, jedoch erhöht sich dabei möglicherweise die Latenz in variablem Umfang.\n\nWenn die Richtlinie aktiviert ist, wird immer adaptives Zwischenspeichern verwendet.\n\nIst sie deaktiviert oder nicht konfiguriert, wird über den Funktionseinführungsprozess des Browsers entschieden, ob adaptives Zwischenspeichern verwendet wird.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "Zulässige Ursprünge für WebAuthn-Anfragen über einen Proxy von Remote-Desktop-Anwendungen.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "Eine Liste von Ursprüngen von Remote-Desktop-Client-Apps, die WebAuthn API-Anfragen ausführen können, die aus einer Browsersitzung auf einem Remote-Host stammen.\n\nJeder in dieser Richtlinie konfigurierte Ursprung kann WebAuthn-Anfragen für Relying-Party-IDs (RP-IDs) stellen, die normalerweise nicht zulässig wären.\n\nNur gültige HTTPS-Ursprünge sind zulässig. Platzhalter werden nicht unterstützt.\nUngültige Einträge werden ignoriert.\n\nDiese Richtlinie gilt nur für verknüpfte Nutzer.";
WebHidAllowAllDevicesForUrls.pfm_title = "Websites automatisch die Berechtigung erteilen, eine Verbindung zu allen HID-Geräten herzustellen.";
WebHidAllowAllDevicesForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit Websites erstellen, denen automatisch die Zugriffsberechtigung auf alle verfügbaren Geräte gewährt wird.\n\nDie URLs müssen gültig sein, da die Richtlinie andernfalls ignoriert wird. Es wird nur der Ursprung (Schema, Host und Port) der URL berücksichtigt.\n\nIn Chrome OS gilt diese Richtlinie nur für verknüpfte Nutzer.\n\nDiese Richtlinie überschreibt DefaultWebHidGuardSetting, WebHidAskForUrls, WebHidBlockedForUrls und die Nutzereinstellungen.";
WebHidAllowDevicesForUrls.pfm_title = "Websites automatisch die Berechtigung erteilen, eine Verbindung zu HID-Geräten mit den angegebenen Anbieter- und Produkt-IDs herzustellen.";
WebHidAllowDevicesForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit den URLs der Websites erstellen, denen automatisch die Zugriffsberechtigung auf ein HID mit den angegebenen Anbieter- und Produkt-IDs gewährt wird. Für jeden Eintrag sind die Felder „devices“ und „urls“ erforderlich, damit er gültig ist. Sonst wird er ignoriert. Für jeden Eintrag im Feld „devices“ ist das Feld „vendor_id“ erforderlich. „product_id“ ist optional. Wird das Feld „product_id“ weggelassen, wird eine Richtlinie erstellt, die für jedes Gerät mit der angegebenen Anbieter-ID gilt. Einträge, für die das Feld „product_id“ angegeben ist, „vendor_id“ aber fehlt, sind ungültig und werden ignoriert.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultWebHidGuardSetting“, sofern sie konfiguriert ist. Andernfalls wird die persönliche Einstellung des Nutzers verwendet.\n\nURLs in dieser Richtlinie dürfen nicht im Widerspruch zu denen stehen, die über „WebHidBlockedForUrls“ konfiguriert wurden. Sonst hat diese Richtlinie Vorrang vor „WebHidBlockedForUrls“.\nUnter https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls erhältst du weitere Informationen zu Schema und Formatierung.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "Websites automatisch die Berechtigung erteilen, eine Verbindung zu HID-Geräten mit Sammlungen auf oberster Ebene mit der angegebenen HID-Nutzung herzustellen.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit den URLs der Websites erstellen, denen automatisch die Zugriffsberechtigung auf ein HID mit einer Sammlung auf oberster Ebene mit der angegebenen HID-Nutzung gewährt wird. Damit die Richtlinie gültig ist, sind für jeden Eintrag in der Liste die Felder „usages“ und „urls“ erforderlich. Für jeden Eintrag im Feld „usages“ ist das Feld „usage_page“ erforderlich. „usage“ ist optional. Wird das Feld „usage“ weggelassen, wird eine Richtlinie erstellt, die für jedes Gerät mit einer Sammlung auf oberster Ebene mit einer Nutzung von der angegebenen Nutzungsseite gilt. Einträge, für die das Feld „usage“ angegeben ist, „usage_page“ aber fehlt, sind ungültig und werden ignoriert.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultWebHidGuardSetting“, sofern sie konfiguriert ist. Andernfalls wird die persönliche Einstellung des Nutzers verwendet.\n\nURLs in dieser Richtlinie dürfen nicht im Widerspruch zu denen stehen, die über „WebHidBlockedForUrls“ konfiguriert wurden. Sonst hat diese Richtlinie Vorrang vor „WebHidBlockedForUrls“.\nUnter https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls erhältst du weitere Informationen zu Schema und Formatierung.";
WebHidAskForUrls.pfm_title = "WebHID API auf diesen Websites erlauben";
WebHidAskForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Nutzer auffordern dürfen, ihnen Zugriff auf ein HID‑Gerät zu gewähren.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultWebHidGuardSetting“ für alle Websites, sofern konfiguriert. Falls dies nicht der Fall ist, werden die persönlichen Einstellungen des Nutzers verwendet.\n\nBei URL‑Mustern, die nicht der Richtlinie entsprechen, hat Folgendes Vorrang (in dieser Reihenfolge):\n\n  * WebHidBlockedForUrls (falls eine Übereinstimmung besteht)\n\n  * DefaultWebHidGuardSetting (falls konfiguriert)\n\n  * Die persönlichen Einstellungen des Nutzers\n\nURL‑Muster dürfen nicht im Konflikt mit „WebHidBlockedForUrls“ stehen. Keine Richtlinie hat Vorrang, falls eine URL mit beiden übereinstimmt.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
WebHidBlockedForUrls.pfm_title = "WebHID API auf diesen Websites blockieren";
WebHidBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Nutzer nicht um Zugriff auf ein HID‑Gerät bitten dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultWebHidGuardSetting“ für alle Websites, sofern konfiguriert. Falls dies nicht der Fall ist, werden die persönlichen Einstellungen des Nutzers verwendet.\n\nBei URL‑Mustern, die nicht der Richtlinie entsprechen, hat Folgendes Vorrang (in dieser Reihenfolge):\n\n  * WebHidAskForUrls (falls eine Übereinstimmung besteht)\n\n  * DefaultWebHidGuardSetting (falls konfiguriert)\n\n  * Die persönlichen Einstellungen des Nutzers\n\nURL‑Muster dürfen nicht im Konflikt mit „WebHidAskForUrls“ stehen. Keine Richtlinie hat Vorrang, falls eine URL mit beiden übereinstimmt.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "Erhebung von WebRTC-Diagnoseprotokollen für bestimmte Ursprünge aktivieren";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "Mit dieser Richtlinie kannst du die Erhebung von WebRTC-Diagnoseprotokollen für bestimmte Ursprünge aktivieren.\n\nAusführliche Informationen zu gültigen Eingabemustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie. Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL-Musters ignoriert. Schema und Subdomains werden unterstützt.\n\nWenn die Richtlinie konfiguriert ist, wird die Erhebung von Diagnoseprotokollen für die Ursprünge aktiviert, die mit den Mustern in der Liste übereinstimmen.\n\nIst die Richtlinie nicht konfiguriert, ist die Erhebung von Diagnoseprotokollen standardmäßig deaktiviert.";
WebRtcEventLogCollectionAllowed.pfm_title = "Speichern von WebRTC-Ereignisprotokollen aus Google-Diensten zulassen";
WebRtcEventLogCollectionAllowed.pfm_description = "Wenn diese Richtlinie aktiviert ist, darf Brave WebRTC-Ereignisprotokolle aus Google-Diensten wie Hangouts Meet speichern und die Protokolle bei Google hochladen. Diese Protokolle enthalten Diagnoseinformationen, die für die Fehlerbehebung bei Audioanrufen oder Videokonferenzen in Brave hilfreich sein können. Dazu zählen die Sende- und Empfangszeit sowie die Größe von RTP-Paketen, Feedback zur Auslastung des Netzwerks und Metadaten zur Länge und Qualität von Audio- und Videoframes. Audio- oder Videoinhalte von Anrufen bzw. Konferenzen gehören nicht dazu. Damit Fehler leichter behoben werden können, verknüpft Google diese Protokolle anhand einer Sitzungs-ID unter Umständen mit anderen Protokollen, die vom Google-Dienst selbst erfasst wurden.\n\nWenn die Richtlinie deaktiviert ist, werden solche Protokolle weder erfasst noch hochgeladen.\n\nIst diese Richtlinie nicht konfiguriert (bis einschließlich Version M76), kann Brave diese Protokolle standardmäßig weder erfassen noch hochladen. Ab Version M77 kann Brave diese Protokolle standardmäßig von den meisten Profilen erfassen und hochladen, für die cloudbasierte Unternehmensrichtlinien auf Nutzerebene gelten. Ab Version M77 bis einschließlich M80 kann Brave diese Protokolle außerdem standardmäßig von Profilen erfassen und hochladen, die mit Brave lokal verwaltet werden.";
WebRtcIPHandling.pfm_title = "WebRTC-IP-Handling";
WebRtcIPHandling.pfm_description = "default - WebRTC verwendet bei der Suche nach dem besten Pfad alle verfügbaren Schnittstellen.\ndefault_public_and_private_interfaces - WebRTC verwendet nur die Schnittstelle, die mit dem öffentlichen Internet verbunden ist, kann aber über private IP-Adressen eine Verbindung herstellen.\ndefault_public_interface_only - WebRTC verwendet nur die Schnittstelle, die mit dem öffentlichen Internet verbunden ist, und stellt keine Verbindung über private IP-Adressen her.\ndisable_non_proxied_udp - WebRTC verwendet die öffentliche TCP-Schnittstelle und nutzt nur dann UDP, wenn dies von einem konfigurierten Proxy unterstützt wird.\nMit dieser Richtlinie kannst du einschränken, welche IP-Adressen und Schnittstellen WebRTC bei der Suche nach der bestmöglichen Verbindung verwenden kann.\n\nGültige Werte:\n\n* default: WebRTC verwendet alle verfügbaren Netzwerkschnittstellen.\n\n* default_public_and_private_interfaces: WebRTC verwendet alle öffentlichen und privaten Schnittstellen.\n\n* default_public_interface_only: WebRTC verwendet alle öffentlichen Schnittstellen, aber keine privaten.\n\n* disable_non_proxied_udp: WebRTC verwendet entweder einen UDP-SOCKS-Proxy oder einen TCP-Proxy als Fallback.\n\nWenn diese Richtlinie nicht konfiguriert ist, werden standardmäßig alle verfügbaren Netzwerkschnittstellen verwendet.\n\nEine ausführliche Beschreibung aller Werte findest du unter RFC 8828, Abschnitt 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2).";
WebRtcIPHandlingUrl.pfm_title = "WebRTC per URL-IP-Handling";
WebRtcIPHandlingUrl.pfm_description = "Mit dieser Richtlinie kannst du einschränken, welche IP-Adressen und Schnittstellen WebRTC bei der Suche nach der bestmöglichen Verbindung für bestimmte URL-Muster verwenden kann.\n\nDu kannst eine Liste von URL-Mustern und Handling-Typ-Paaren festlegen. Die URL-Muster werden der Reihe nach geprüft und die erste Übereinstimmung bestimmt, welches Handling von WebRTC für die Domain verwendet wird. Wenn die URL des aktuellen Dokuments mit keinem Eintrag übereinstimmt, wird die Konfiguration verwendet, die in der Richtlinie „WebRtcIPHandling“ festgelegt wurde.\n\nAusführliche Informationen zu gültigen Eingabemustern findest du unter https://chromeenterprise.google/policies/url-patterns/. Platzhalter wie * sind zulässig. Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL-Musters ignoriert.\n\nGültige Werte für das Handling:\n\n* default: WebRTC verwendet alle Netzwerkschnittstellen.\n\n* default_public_and_private_interfaces: WebRTC verwendet alle öffentlichen und privaten Schnittstellen.\n\n* default_public_interface_only: WebRTC verwendet alle öffentlichen Schnittstellen, aber keine privaten.\n\n* disable_non_proxied_udp: WebRTC verwendet entweder einen UDP-SOCKS-Proxy oder als Fallback einen TCP-Proxy.\n\nEine ausführliche Beschreibung aller Werte findest du unter RFC 8828, Abschnitt 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2).\nUnter https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl erhältst du weitere Informationen zu Schema und Formatierung.";
WebRtcLocalIpsAllowedUrls.pfm_title = "URLs, für die lokale IPs in WebRTC ICE Candidates offengelegt sind";
WebRtcLocalIpsAllowedUrls.pfm_description = "Muster in dieser Liste werden mit der Sicherheitsherkunft der anfragenden URL abgeglichen.\nWenn Übereinstimmungen gefunden werden oder chrome://flags/#enable-webrtc-hide-local-ips-with-mdns deaktiviert ist, werden die lokalen IP-Adressen in WebRTC ICE-Kandidaten angezeigt.\nAndernfalls werden lokale IP-Adressen mit mDNS-Hostnamen verborgen.\nBeachte bitte, dass diese Richtlinie den Schutz lokaler IPs schwächt, sofern Administratoren diese benötigen.";
WebRtcPostQuantumKeyAgreement.pfm_title = "Post-Quanten-Algorithmus für Schlüsselvereinbarungen mit WebRTC aktivieren";
WebRtcPostQuantumKeyAgreement.pfm_description = "Mit dieser Richtlinie lässt sich die Post-Quanten-Schlüsselvereinbarung mit WebRTC verwalten.\n\nWenn diese Richtlinie aktiviert ist, wird die Post-Quanten-Schlüsselvereinbarung mit WebRTC angeboten.\n\nWenn diese Richtlinie deaktiviert ist, wird keine Post-Quanten-Schlüsselvereinbarung mit WebRTC angeboten.\n\nWenn diese Richtlinie nicht konfiguriert ist, wird der Wert durch den standardmäßigen Einführungsprozess für die Post-Quanten-Schlüsselvereinbarung mit WebRTC festgelegt.\n\nDas Anbieten einer Post-Quanten-Schlüsselvereinbarung ist abwärtskompatibel. Bei vorhandenen DTLS-Peers und Netzwerk-Middleware wird voraussichtlich die neue Option ignoriert und eine frühere ausgewählt.\n\nAuf Geräten, auf denen DTLS nicht korrekt implementiert ist, kann eine Fehlfunktion auftreten, wenn die neue Option angeboten wird. Beispielsweise kann bei unbekannten Optionen oder den resultierenden umfangreicheren Nachrichten die Verbindung dieser Geräte unterbrochen werden. Solche Geräte sind nicht post-quanten-kompatibel und beeinträchtigen die Post-Quanten-Umstellung von Unternehmen. Administratoren sollten in solchen Fällen den Anbieter fragen, wie sich das Problem beheben lässt.\n\nDiese Richtlinie ist eine vorübergehende Maßnahme und wird nach einigen Meilensteinen entfernt.";
WebRtcTextLogCollectionAllowed.pfm_title = "Erfassen von WebRTC-Textprotokollen aus Google-Diensten zulassen";
WebRtcTextLogCollectionAllowed.pfm_description = "Wenn diese Richtlinie aktiviert ist, darf Brave WebRTC-Textprotokolle aus Google-Diensten wie Google Meet speichern und bei Google hochladen. Diese Protokolle enthalten Diagnoseinformationen, die für die Fehlerbehebung bei Audioanrufen oder Videokonferenzen in Brave hilfreich sein können. Dazu zählen Textmetadaten, die eingehende und ausgehende WebRTC-Streams beschreiben, WebRTC-spezifische Protokolleinträge und zusätzliche Systeminformationen. Audio- oder Videoinhalte von Anrufen bzw. Konferenzen gehören nicht dazu.\nIst die Richtlinie deaktiviert, werden solche Protokolle nicht bei Google hochgeladen. Die Protokolle werden dann lokal auf dem Gerät des Nutzers gesammelt.\nWenn die Richtlinie nicht konfiguriert ist, kann Brave diese Protokolle standardmäßig erfassen und hochladen.";
WebRtcUdpPortRange.pfm_title = "Den von WebRTC verwendeten Bereich lokaler UDP-Ports einschränken";
WebRtcUdpPortRange.pfm_description = "Wenn die Richtlinie konfiguriert ist, wird der von WebRTC verwendete UDP-Port-Bereich auf den festgelegten Portintervall, einschließlich der Endpunkte, beschränkt.\n\nWenn die Richtlinie nicht konfiguriert ist oder sie auf den leeren String oder einen ungültigen Portbereich eingestellt ist, kann von WebRTC jeder beliebige verfügbare lokale UDP-Port verwendet werden.";
WebUsbAllowDevicesForUrls.pfm_title = "Websites automatisch die Berechtigung erteilen, eine Verbindung zu USB-Geräten mit der angegebenen Anbieter-ID und Produkt-ID herzustellen.";
WebUsbAllowDevicesForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, die die Websites angeben, denen automatisch die Berechtigung für den Zugriff auf ein USB-Gerät mit den angegebenen Anbieter- und Produkt-IDs gewährt wird. Damit die Richtlinie gültig ist, müssen für jeden Eintrag auf der Liste die Felder „devices“ und „urls“ angegeben sein. Jeder Eintrag im Feld „devices“ kann das Feld „vendor_id“ und das Feld „product_id“ haben. Bei Weglassen des Felds „vendor_id“ wird eine Richtlinie erstellt, die für jedes Gerät gilt. Bei Weglassen des Felds „product_id“ wird eine Richtlinie erstellt, die für jedes Gerät mit der angegebenen Anbieter-ID gilt. Eine Richtlinie, die das Feld „product_id“ ohne das Feld „vendor_id“ hat, ist ungültig.\n\nDas USB-Berechtigungsmodell erteilt der angegebenen URL die Berechtigung für den Zugriff auf das USB-Gerät als eine Quelle der obersten Ebene. Wenn eingebettete Frames auf USB-Geräte zugreifen müssen, sollte der feature-policy-Header für USB verwendet werden, um Zugriff zu gewähren. Die URL muss gültig sein, da die Richtlinie andernfalls ignoriert wird.\n\nEingestellt: Es war zuvor möglich, beim USB-Berechtigungsmodell sowohl die anfragende URL als auch die einbettende URL anzugeben. Dies wurde verworfen und wird aus Gründen der Abwärtskompatibilität nur noch folgendermaßen unterstützt: Wenn sowohl eine anfragende als auch eine einbettende URL angegeben ist, wird der einbettenden URL die Berechtigung als Quelle der obersten Ebene gegeben und die anfragende URL wird vollständig ignoriert.\n\nDiese Richtlinie überschreibt DefaultWebUsbGuardSetting, WebUsbAskForUrls, WebUsbBlockedForUrls und die Nutzereinstellungen.\n\nSie wirkt sich nur auf den Zugriff auf USB-Geräte über die WebUSB API aus. Für die Gewährung des Zugriffs auf USB-Geräte über die Web Serial API siehe Richtlinie SerialAllowUsbDevicesForUrls.\nUnter https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls erhältst du weitere Informationen zu Schema und Formatierung.";
WebUsbAskForUrls.pfm_title = "WebUSB auf diesen Websites zulassen";
WebUsbAskForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL‑Mustern erstellen, durch die angegeben wird, welche Websites Nutzer auffordern dürfen, ihnen Zugriff auf ein USB‑Gerät zu gewähren.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultWebUsbGuardSetting“ für alle Websites, sofern konfiguriert. Ist dies nicht der Fall, werden die persönlichen Einstellungen des Nutzers verwendet.\n\nURL‑Muster dürfen nicht im Konflikt mit „WebUsbAskForUrls“ stehen. Keine Richtlinie hat Vorrang, falls eine URL mit beiden übereinstimmt.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Der Platzhalter „*“ ist kein akzeptierter Wert für diese Richtlinie.";
WebUsbBlockedForUrls.pfm_title = "WebUSB auf diesen Websites blockieren";
WebUsbBlockedForUrls.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, die angeben, welche Websites Nutzer nicht um Zugriff auf ein USB-Gerät bitten dürfen.\n\nWenn die Richtlinie nicht konfiguriert ist, gilt „DefaultWebUsbGuardSetting“ für alle Websites, sofern konfiguriert. Falls nicht, wird die persönliche Einstellung des Nutzers verwendet.\n\nURL-Muster dürfen nicht im Konflikt mit WebUsbAskForUrls stehen. Keine Richtlinie hat Vorrang, falls eine URL mit beiden übereinstimmt.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. * ist kein akzeptierter Wert für diese Richtlinie.";
WindowCaptureAllowedByOrigins.pfm_title = "Fenster- und Tabaufnahme für diese Ursprünge zulassen";
WindowCaptureAllowedByOrigins.pfm_description = "Wenn diese Richtlinie konfiguriert ist, kannst du eine Liste mit URL-Mustern erstellen, die die Fenster- und Tabaufnahme verwenden können.\n\nIst sie nicht konfiguriert, können Websites diese Aufnahmefunktionen nicht nutzen.\n\nDiese Richtlinie wird nicht berücksichtigt, wenn eine Website mit einem URL-Muster in einer der folgenden Richtlinien übereinstimmt: „TabCaptureAllowedByOrigins“ oder „SameOriginTabCaptureAllowedByOrigins“.\n\nWenn eine Website mit einem URL-Muster in dieser Richtlinie übereinstimmt, werden die folgenden Richtlinien nicht berücksichtigt: „ScreenCaptureAllowedByOrigins“ und „ScreenCaptureAllowed“.\n\nAusführliche Informationen zu gültigen url‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns/.  Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL-Musters ignoriert.";
WindowManagementAllowedForUrls.pfm_title = "Berechtigung für die Fensterverwaltung auf diesen Websites zulassen";
WindowManagementAllowedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL‑Mustern festlegen, durch die angegeben wird, auf welchen Websites die Berechtigung zur Fensterverwaltung automatisch gewährt wird. Dadurch können Websites Informationen zum Bildschirm des Geräts abrufen und nutzen, um Fenster zu öffnen und zu platzieren oder auf bestimmten Bildschirmen den Vollbildmodus anzufordern.\n\nAusführliche Informationen zu gültigen Website-URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig. Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL‑Musters ignoriert.\n\nWenn die Richtlinie für eine Website nicht konfiguriert ist, gilt die Richtlinie aus „DefaultWindowManagementSetting“ für die Website, falls konfiguriert. Andernfalls werden die Standardeinstellungen des Browsers verwendet und Nutzer können auswählen, für welche Websites sie die Berechtigung gewähren möchten.\n\nDiese Richtlinie ersetzt die nicht mehr unterstützte Richtlinie „WindowPlacementAllowedForUrls“.";
WindowManagementBlockedForUrls.pfm_title = "Berechtigung für die Fensterverwaltung auf diesen Websites blockieren";
WindowManagementBlockedForUrls.pfm_description = "Mit dieser Richtlinie kannst du eine Liste mit URL‑Mustern festlegen, durch die angegeben wird, auf welchen Websites die Berechtigung zur Fensterverwaltung automatisch verweigert wird. Dadurch wird die Fähigkeit von Websites eingeschränkt, Informationen zum Bildschirm des Geräts abzurufen und zu nutzen, um Fenster zu öffnen und zu platzieren oder auf bestimmten Bildschirmen den Vollbildmodus anzufordern.\n\nAusführliche Informationen zu gültigen Website-URL‑Mustern findest du unter https://chromeenterprise.google/policies/url-patterns. Platzhalter wie „*“ sind zulässig. Diese Richtlinie gleicht nur anhand des Ursprungs ab, daher werden alle Pfade des URL‑Musters ignoriert.\n\nWenn die Richtlinie für eine Website nicht konfiguriert ist, gilt die Richtlinie aus „DefaultWindowManagementSetting“ für die Website, falls konfiguriert. Andernfalls werden die Standardeinstellungen des Browsers verwendet und Nutzer können auswählen, für welche Websites sie die Berechtigung gewähren möchten.\n\nDiese Richtlinie ersetzt die nicht mehr unterstützte Richtlinie „WindowPlacementBlockedForUrls“.";
XSLTEnabled.pfm_title = "Verfügbarkeit der XSLT-Funktion steuern";
XSLTEnabled.pfm_description = "Mit dieser Richtlinie wird die Verfügbarkeit der XSLT-Funktion (XSLTProcessor JavaScript API und XSL-Verarbeitungsanweisung) gesteuert.\nWenn diese Richtlinie aktiviert ist, ist XSLT unabhängig vom Standardstatus der Funktion im Browser verfügbar.\nWenn diese Richtlinie deaktiviert ist, ist XSLT unabhängig vom Standardstatus der Funktion im Browser nicht verfügbar.\nWenn diese Richtlinie nicht konfiguriert ist, wird die Verfügbarkeit von XSLT durch die Standardeinstellungen des Browsers und Field Trials bestimmt.\nDiese Richtlinie ist eine vorübergehende Maßnahme und wird in M176 entfernt.";