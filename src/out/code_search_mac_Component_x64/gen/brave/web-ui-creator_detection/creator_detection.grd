  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_CREATOR_DETECTION_REDDIT_BUNDLE_JS" file="${root_gen_dir}/brave/web-ui-creator_detection/reddit.bundle.js" resource_path="reddit.bundle.js" use_base_dir="false" type="BINDATA" />
      <include name="IDR_CREATOR_DETECTION_TWITCH_BUNDLE_JS" file="${root_gen_dir}/brave/web-ui-creator_detection/twitch.bundle.js" resource_path="twitch.bundle.js" use_base_dir="false" type="BINDATA" />
