/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Préférences de Brave";
AIModeSettings.pfm_title = "Paramètres des intégrations du Mode IA de Google dans la barre d'adresse et le champ de recherche de la page \"Nouvel onglet\".";
AIModeSettings.pfm_description = "0 - Autoriser les intégrations du Mode IA.\n1 - Ne pas autoriser les intégrations du Mode IA.\nCette règle contrôle les intégrations du Mode IA de Google dans la barre d'adresse et le champ de recherche de la page \"Nouvel onglet\".\n\nPour accéder à cette fonctionnalité, l'utilisateur doit avoir défini Google comme moteur de recherche par défaut.\n\n0 : les utilisateurs auront accès à la fonctionnalité.\n\n1 : les utilisateurs n'auront pas accès à la fonctionnalité.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.";
AbusiveExperienceInterventionEnforce.pfm_title = "Application de l'intervention en cas d'expérience abusive";
AbusiveExperienceInterventionEnforce.pfm_description = "Si la règle AbusiveExperienceInterventionEnforce est activée ou n'est pas configurée et que la règle SafeBrowsingEnabled n'est pas désactivée, les sites aux expériences abusives visant à tromper les utilisateurs ne peuvent pas ouvrir de nouvelles fenêtres ni de nouveaux onglets.\n\nSi les règles AbusiveExperienceInterventionEnforce ou SafeBrowsingEnabled sont désactivées, ces sites peuvent ouvrir de nouvelles fenêtres ou de nouveaux onglets.";
AccessCodeCastDeviceDuration.pfm_title = "Définir la durée d'affichage (en secondes) d'un appareil Cast sélectionné via un code d'accès ou un QR code dans la liste des appareils Cast du menu Google Cast.";
AccessCodeCastDeviceDuration.pfm_description = "Cette règle permet de définir la durée d'affichage (en secondes) d'un appareil Cast, auparavant sélectionné via un code d'accès ou un QR code, dans la liste des appareils Cast du menu Google Cast.\nCette durée est à compter du moment où l'utilisateur a saisi le code d'accès ou scanné le QR code pour la première fois.\nL'appareil Cast sera affiché dans la liste des appareils Cast du menu Google Cast pendant toute cette durée.\nUne fois celle-ci écoulée, l'utilisateur devra ressaisir le code d'accès ou rescanner le QR code pour réutiliser l'appareil Cast.\nLa durée par défaut est nulle. Les appareils Cast ne restent donc pas affichés dans la liste du menu Google Cast, et l'utilisateur doit ressaisir le code d'accès ou rescanner le QR code pour lancer une nouvelle session de diffusion.\nNotez que cette règle ne concerne que la durée d'affichage d'un appareil Cast dans la liste dédiée du menu Google Cast, et n'a aucune incidence sur les sessions de diffusion en cours qui se poursuivront même si la durée définie est écoulée.\nElle n'a aucune incidence non plus, sauf si la règle AccessCodeCastEnabled est activée.";
AccessCodeCastEnabled.pfm_title = "Autoriser les utilisateurs à sélectionner des appareils Cast avec un code d'accès ou un QR code dans la liste dédiée du menu Google Cast.";
AccessCodeCastEnabled.pfm_description = "Cette règle détermine si l'utilisateur se verra proposer ou non une option dans le menu Google Cast, qui lui permet de caster du contenu sur des appareils Cast ne figurant pas dans la liste du menu Google Cast, en utilisant soit le code d'accès ou le QR code affiché sur l'écran de l'appareil Cast.\nPar défaut, l'utilisateur doit ressaisir le code d'accès ou rescanner le QR code pour lancer une nouvelle session de diffusion. Toutefois, si la valeur de la règle AccessCodeCastDeviceDuration n'est pas nulle (sachant qu'elle l'est par défaut), l'appareil Cast reste alors dans la liste des appareils Cast disponibles tant que la durée d'affichage définie n'est pas écoulée.\nSi cette règle est activée, les utilisateurs auront la possibilité de sélectionner des appareils Cast en utilisant un code d'accès ou en scannant un QR code.\nSi cette règle est désactivée ou n'est pas configurée, les utilisateurs n'auront pas cette possibilité.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "Rendre la mise en correspondance Access-Control-Allow-Methods conforme dans les spécifications de la requête préliminaire CORS";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Cette règle détermine si les méthodes de requête sont en majuscules lors de la mise en correspondance avec les en-têtes de réponse Access-Control-Allow-Methods dans la requête préliminaire CORS.\n\nSi elle est désactivée, les méthodes de requête sont en majuscules.\nCe comportement est en vigueur dans Brave 108 et les versions antérieures.\n\nSi cette règle est activée ou qu'elle n'est pas configurée, les méthodes de requête ne sont pas en majuscules, sauf si elles correspondent à DELETE, GET, HEAD, OPTIONS, POST ou PUT sans tenir compte de la casse.\nCette opération refuserait l'en-tête de réponse fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" et accepterait l'en-tête de réponse fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\".\n\nRemarque : Les méthodes de requête \"post\" et \"put\" ne sont pas concernées, contrairement à \"patch\".\n\nCette règle est provisoire et sera supprimée prochainement.";
AccessibilityImageLabelsEnabled.pfm_title = "Activer Get Image Descriptions from Google.";
AccessibilityImageLabelsEnabled.pfm_description = "La fonctionnalité d'accessibilité Get Image Descriptions from Google\npermet aux personnes malvoyantes qui utilisent un lecteur d'écran\n d'obtenir une description des images sans libellé descriptif sur le Web. Les utilisateurs ayant activé\n cette fonctionnalité peuvent accéder à des descriptions fournies automatiquement\n par un service Google anonyme lorsqu'ils rencontrent une image sans libellé descriptif sur le Web.\n\n Si cette fonctionnalité est activée, le contenu des images est transmis aux serveurs de Google\n afin qu'une description puisse être générée. Elle n'envoie aucun cookie ni aucune information sur l'utilisateur.\n Google n'enregistre pas le contenu des images et n'en conserve aucune trace.\n\n Si cette règle est activée, la fonctionnalité\n Get Image Descriptions from Google\n est activée. Toutefois, elle ne s'applique qu'aux utilisateurs\n d'un lecteur d'écran ou d'une autre technologie d'assistance similaire.\n\n Si cette règle est désactivée, aucun utilisateur ne peut activer\n la fonctionnalité.\n\n Si elle n'est pas configurée, l'utilisateur peut choisir de recourir ou non à cette fonctionnalité.";
AdditionalDnsQueryTypesEnabled.pfm_title = "Autorise les requêtes DNS pour d'autres types d'enregistrements DNS";
AdditionalDnsQueryTypesEnabled.pfm_description = "Cette règle permet d'autoriser Brave à demander d'autres types d'enregistrements DNS en cas d'envois de requêtes DNS à risque, ou de l'en empêcher. Cette règle n'a aucune incidence sur les requêtes DNS envoyées via DNS sécurisé, qui peut toujours envoyer d'autres types de requêtes DNS.\n\nSi cette règle n'est pas configurée ou si elle est activée, d'autres types de requêtes, par exemple HTTPS (type de DNS 65), peuvent être demandés en plus des types A (type de DNS 1) et AAAA (type de DNS 28).\n\nSi cette règle est désactivée, seuls les types de requêtes DNS A (type de DNS 1) et/ou AAAA (type de DNS 28) seront envoyés.\n\nCette règle est une mesure temporaire qui sera supprimée dans les futures versions de Brave. Après la suppression de cette règle, il sera toujours possible d'envoyer d'autres types de requêtes DNS avec Brave.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Paramètre des annonces pour les sites présentant des annonces intrusives";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Autoriser les annonces sur tous les sites\n2 - Ne pas autoriser les annonces sur les sites présentant des annonces intrusives\nÀ moins que la règle SafeBrowsingEnabled soit définie sur \"False\", si la règle AdsSettingForIntrusiveAdsSites est définie sur \"1\" ou qu'elle n'est pas configurée, les annonces sont autorisées sur tous les sites.\n\nSi cette règle est définie sur 2, les annonces sont bloquées sur les sites présentant des annonces intrusives.";
AdvancedProtectionAllowed.pfm_title = "Activer les protections supplémentaires pour les utilisateurs inscrits au Programme Protection Avancée";
AdvancedProtectionAllowed.pfm_description = "Cette règle détermine si les utilisateurs inscrits au Programme Protection Avancée bénéficient de protections supplémentaires. Ces fonctionnalités peuvent impliquer le partage de données avec Google (par exemple, les utilisateurs du programme Protection Avancée peuvent envoyer leurs téléchargements à Google pour les faire analyser afin de détecter d'éventuels logiciels malveillants). Si cette règle est définie sur \"True\" ou si elle n'est pas configurée, les utilisateurs inscrits bénéficieront de protections supplémentaires. Si elle est définie sur \"False\", les utilisateurs du programme Protection Avancée ne bénéficieront que des fonctionnalités grand public standards.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Liste des origines autorisant toutes les authentifications HTTP";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "Cette règle permet de lister les origines devant autoriser tous les schémas d'authentification HTTP pris en charge par Brave, indépendamment de la règle AuthSchemes.\n\nÀ partir de la version 161 de Brave, cette règle ne s'applique qu'aux origines du serveur de destination et ne s'applique plus aux demandes d'authentification du serveur proxy. Pour autoriser tous les schémas d'authentification HTTP pour les serveurs proxy, utilisez plutôt la règle AllHttpAuthSchemesAllowedForProxies. Avant la version 161, les serveurs proxy correspondant à cette règle sont également autorisés à utiliser tous les schémas d'authentification HTTP, sauf si AllHttpAuthSchemesAllowedForProxies est définie.\n\nIndiquez l'origine en respectant le format suivant : https://support.google.com/chrome/a?p=url_blocklist_filter_format. Vous pouvez définir jusqu'à 1 000 exceptions dans AllHttpAuthSchemesAllowedForOrigins.\nLes caractères génériques sont autorisés pour le composant hôte (par exemple, \"*:8000\" correspond à tous les hôtes sur le port 8000). Pour faire correspondre tous les schémas ou tous les ports, omettez entièrement le composant (par exemple, \"example.com\" correspond à n'importe quel schéma et n'importe quel port). Un nom d'hôte (par exemple, \"example.com\") correspond également à ses sous-domaines. Pour faire correspondre un hôte exactement et exclure ses sous-domaines, ajoutez un point devant (par exemple, \".example.com\"). Pour faire correspondre toutes les origines, utilisez un astérisque unique (\"*\").";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Liste des serveurs proxy autorisant tous les schémas d'authentification HTTP";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "Cette règle permet de lister les serveurs proxy devant autoriser tous les schémas d'authentification HTTP pris en charge par Brave, indépendamment de la règle AuthSchemes.\n\nLe format du serveur proxy doit être le même que celui des filtres de la liste de blocage d'URL (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Vous pouvez définir jusqu'à 1 000 exceptions.\nLes caractères génériques sont autorisés pour le composant hôte (par exemple, \"*:8080\" correspond à tous les proxys sur le port 8080). Un nom d'hôte (par exemple, \"proxy.example.com\") correspond également à ses sous-domaines. Pour faire correspondre un hôte exactement et exclure ses sous-domaines, ajoutez un point devant (par exemple, \".proxy.example.com\").\n\nSi cette règle n'est pas configurée, seuls les schémas d'authentification HTTP spécifiés dans AuthSchemes (ou les schémas par défaut, s'ils ne sont pas définis) sont acceptés pour l'authentification par proxy.";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Autoriser les pages avec un en-tête Cache-Control: no-store à accéder au cache back/forward";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Cette règle détermine si une page avec un en-tête Cache-Control: no-store peut être stockée dans le cache back/forward. Le paramètre de site Web défini pour cet en-tête ne prévoit peut-être pas que la page soit restaurée à partir du cache back/forward, car certaines informations sensibles peuvent rester affichées après la restauration, même si elles ne sont plus accessibles.\n\nSi cette règle est activée ou n'est pas configurée, la page avec un en-tête Cache-Control: no-store pourrait être restaurée à partir du cache back/forward, sauf si l'éviction du cache est déclenchée (par exemple, en cas de modification du cookie HttpOnly sur le site).\n\nSi cette règle est désactivée, la page avec un en-tête Cache-Control: no-store ne sera pas stockée dans le cache back/forward.";
AllowCrossOriginAuthPrompt.pfm_title = "Commandes d'authentification HTTP multi-domaines";
AllowCrossOriginAuthPrompt.pfm_description = "Si cette règle est activée, les images tierces d'une page sont autorisées à afficher une commande d'authentification.\n\nSi cette règle est désactivée ou n'est pas configurée, les images tierces ne sont pas autorisées à afficher une commande d'authentification.\n\nCette règle est habituellement désactivée pour protéger les utilisateurs contre l'hameçonnage.";
AllowDeletingBrowserHistory.pfm_title = "Activer la suppression de l'historique du navigateur et de l'historique des téléchargements";
AllowDeletingBrowserHistory.pfm_description = "Si cette règle est activée ou n'est pas configurée, les historiques de navigation et de téléchargements peuvent être supprimés dans Chrome, sans que les utilisateurs puissent modifier ce paramètre.\n\nSi cette règle est désactivée, ces deux historiques ne peuvent pas être supprimés. Même si cette règle est désactivée, cela ne garantit pas que ces historiques soient conservés. En effet, les utilisateurs peuvent modifier ou supprimer directement les fichiers de ces historiques. De même, le navigateur peut arriver à expiration ou archiver l'historique partiellement ou intégralement à tout moment.";
AllowDinosaurEasterEgg.pfm_title = "Autoriser le jeu Easter Egg du dinosaure";
AllowDinosaurEasterEgg.pfm_description = "Si cette règle est définie sur \"True\", les utilisateurs peuvent jouer au jeu du dinosaure. Si cette règle est définie sur \"False\", les utilisateurs ne peuvent pas jouer à ce jeu lorsque l'appareil est hors connexion.\n\nSi cette règle n'est pas configurée, les utilisateurs ne peuvent pas jouer à ce jeu sur les appareils Google Chrome OS enregistrés, mais ils le peuvent dans d'autres circonstances.";
AllowFileSelectionDialogs.pfm_title = "Autoriser l'appel des boîtes de dialogue de sélection de fichiers";
AllowFileSelectionDialogs.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, Chrome est autorisé à afficher des boîtes de dialogue de sélection de fichiers, et l'utilisateur peut ouvrir ces boîtes de dialogue normalement.\n\nSi cette règle est désactivée, chaque fois que l'utilisateur effectue une action qui devrait entraîner l'ouverture d'une boîte de dialogue de sélection de fichiers (par exemple, pour enregistrer des liens, ou importer des favoris ou des fichiers), un message s'affiche à la place. L'utilisateur est supposé avoir cliqué sur \"Annuler\" dans la boîte de dialogue de sélection de fichiers.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Autoriser la randomisation de la taille du pool de sockets pour les proxys";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "La randomisation de la taille du pool de sockets est un mécanisme de sécurité qui empêche les pirates informatiques d'exploiter les limites de capacité déterministes pour obtenir des informations intersites.\nSi la capacité d'un pool est normalement de 128 sockets, ce mécanisme limite aléatoirement le pool entre 128 et 256.\nCela peut permettre jusqu'à deux fois plus de connexions au proxy, mais en pratique, la valeur attendue est plutôt de 1,2 fois.\n\nCela a une incidence sur les paramètres MaxConnectionsPerProxy et MaxConnectionsPerProxyForWebSocket.\nAu lieu que ces paramètres ne définissent la limite supérieure, celle-ci correspond à deux fois leurs valeurs (bien que, dans la pratique, la valeur attendue soit plutôt égale à 1,2 fois leurs valeurs).\n\nCette fonctionnalité est activée par défaut pour tous les pools, mais cette règle permet de la désactiver spécifiquement pour les pools de proxy.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Autoriser les requêtes d'authentification Web sur les sites avec des certificats TLS non fonctionnels.";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Si cette règle est activée, Brave autorise les requêtes d'authentification Web sur les sites dont les certificats TLS comportent des erreurs (c'est-à-dire les sites Web considérés comme non sécurisés).\n\nSi la règle est désactivée ou n'est pas configurée, le comportement par défaut s'applique et ces requêtes sont bloquées.";
AllowedDomainsForApps.pfm_title = "Définir les domaines autorisés à accéder à Google Workspace";
AllowedDomainsForApps.pfm_description = "Cette règle permet d'activer la fonctionnalité de connexion limitée de Chrome dans Google Workspace et d'empêcher les utilisateurs de modifier ce paramètre. Les utilisateurs ne peuvent accéder aux outils Google que via des comptes des domaines spécifiés (pour autoriser des comptes Gmail ou Googlemail, ajoutez \"consumer_accounts\" à la liste des domaines). Ce paramètre empêche les utilisateurs de se connecter et d'ajouter un compte secondaire sur un appareil géré qui exige l'authentification Google, si ce compte n'appartient pas à l'un des domaines explicitement autorisés.\n\nSi ce paramètre est vide ou qu'il n'est pas configuré, les utilisateurs peuvent accéder à Google Workspace avec n'importe quel compte.\n\nLes utilisateurs ne peuvent ni modifier, ni ignorer ce paramètre.\n\nRemarque : Cette règle entraîne l'ajout de l'en-tête \"X-GoogApps-Allowed-Domains\" à toutes les requêtes HTTP et HTTPS sur tous les domaines google.com (comme indiqué sur https://support.google.com/a/answer/1668854).";
AlternateErrorPagesEnabled.pfm_title = "Activer les pages d'erreur alternatives";
AlternateErrorPagesEnabled.pfm_description = "Si cette règle est définie sur \"True\", Brave utilise les variantes de pages d'erreur intégrées (telles que \"Page introuvable\"). Si cette règle est définie sur \"False\", Brave n'utilise jamais les variantes de pages d'erreur.\n\nSi cette règle est configurée, les utilisateurs ne peuvent pas la modifier. Si cette règle n'est pas configurée, elle est activée. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
AlternativeBrowserParameters.pfm_title = "Paramètres de ligne de commande pour le navigateur secondaire.";
AlternativeBrowserParameters.pfm_description = "Si cette règle est définie sur une liste de chaînes, chaque chaîne est transmise au navigateur secondaire comme paramètre de ligne de commande distinct. Sous Microsoft® Windows®, les paramètres sont reliés par des espaces. Sous macOS et Linux®, un paramètre peut contenir des espaces tout en étant quand même traité comme un seul et même paramètre.\n\nSi un paramètre contient ${url}, l'URL ${url} est remplacée par l'URL de la page à ouvrir. Si aucun paramètre ne contient l'URL ${url}, celle-ci est ajoutée à la fin de la ligne de commande.\n\nLes variables d'environnement sont développées. Sous Microsoft® Windows®, la variable %ABC% est remplacée par la valeur de la variable d'environnement ABC. Sous macOS et Linux®, la variable ${ABC} est remplacée par la valeur de la variable d'environnement ABC.\n\nSi cette règle n'est pas configurée, seule l'URL est transmise comme paramètre de ligne de commande.";
AlternativeBrowserPath.pfm_title = "Navigateur secondaire à lancer pour les sites Web configurés.";
AlternativeBrowserPath.pfm_description = "Permet de spécifier la commande à utiliser pour ouvrir les URL dans un navigateur secondaire. Cette règle peut être définie sur le navigateur ${ie}, ${firefox}, ${safari}, ${opera} ou ${edge}, ou sur le chemin d'accès à un fichier. Si elle est définie sur le chemin d'accès à un fichier, celui-ci est utilisé comme fichier exécutable. ${ie} n'est disponible que sur Microsoft® Windows®. ${safari} et ${edge} ne sont disponibles que sur Microsoft® Windows® et macOS.\n\nSi cette règle n'est pas définie, l'URL s'ouvre par défaut dans un navigateur spécifique à la plate-forme : Internet Explorer® sous Microsoft® Windows® ou Safari® sous macOS. Sous Linux®, le lancement d'un navigateur secondaire entraîne une erreur.";
AlwaysOpenPdfExternally.pfm_title = "Toujours ouvrir les fichiers PDF en externe";
AlwaysOpenPdfExternally.pfm_description = "Si cette règle est activée, la visionneuse de PDF interne est désactivée dans Brave, les fichiers PDF sont téléchargés, et les utilisateurs peuvent les ouvrir avec l'application par défaut.\n\nSi cette règle est désactivée, les fichiers PDF sont ouverts, sauf si les utilisateurs ont désactivé le plug-in PDF.\n\nSi cette règle est configurée, les utilisateurs ne peuvent pas la modifier dans Brave. Si cette règle n'est pas configurée, les utilisateurs peuvent choisir d'ouvrir le PDF en externe ou non.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Activer l'authentification ambiante en fonction du type de profil.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Activer l'authentification ambiante seulement pour les sessions standards.\n1 - Activer l'authentification ambiante pour les sessions standards et de navigation privée.\n2 - Activer l'authentification ambiante pour les sessions Invité et standards.\n3 - Activer l'authentification ambiante pour les sessions standards, Invité et de navigation privée.\nLa configuration de cette règle autorise/interdit l'authentification ambiante pour les profils Invité et de navigation privée dans Brave.\n\nL'authentification ambiante est une authentification HTTP qui utilise des identifiants par défaut si aucun identifiant explicite n'est fourni via les systèmes de défi-réponse NTLM/Kerberos/Negotiate.\n\nLe paramètre RegularOnly (valeur 0) permet d'activer l'authentification ambiante uniquement pour les sessions standards. Elle reste désactivée pour les sessions Invité et de navigation privée.\n\nLe paramètre IncognitoAndRegular (valeur 1) permet d'activer l'authentification ambiante pour les sessions standards et de navigation privée. Elle reste désactivée pour les sessions Invité.\n\nLe paramètre GuestAndRegular (valeur 2) permet d'activer l'authentification ambiante pour les sessions standards et Invité. Elle reste désactivée pour les sessions de navigation privée.\n\nLe paramètre All (valeur 3) permet d'activer l'authentification ambiante pour toutes les sessions.\n\nNotez que l'authentification ambiante est toujours activée pour les profils standards.\n\nDans Brave 81 et les versions ultérieures, si la règle n'est pas définie, l'authentification ambiante sera activée pour les sessions standards uniquement.";
AudioCaptureAllowed.pfm_title = "Autoriser ou interdire la capture audio";
AudioCaptureAllowed.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, l'utilisateur est invité à autoriser ou non l'accès à la capture audio, sauf si l'URL concernée figure dans la liste AudioCaptureAllowedUrls.\n\nSi cette règle est désactivée, aucune invite ne s'affiche à ce sujet, et la capture audio n'est possible que si l'URL concernée figure dans la liste AudioCaptureAllowedUrls.\n\nRemarque : Cette règle concerne toutes les entrées audio (pas seulement le micro intégré).";
AudioCaptureAllowedUrls.pfm_title = "URL autorisées à accéder aux appareils de capture audio sans avis préalable";
AudioCaptureAllowedUrls.pfm_description = "Cette règle permet de lister les URL dont les formats sont mis en correspondance avec la source de sécurité de l'URL à l'origine de la demande. En cas de correspondance, l'accès aux appareils de capture audio est autorisé sans invite.\n\nPour en savoir plus sur les formats d‘url valides, consultez https://chromeenterprise.google/policies/url-patterns/. Notez toutefois que le format \"*\", qui correspond à n'importe quelle URL, n'est pas pris en charge par cette règle.";
AudioSandboxEnabled.pfm_title = "Autoriser l'exécution en bac à sable du processus audio";
AudioSandboxEnabled.pfm_description = "Cette règle permet de contrôler l'exécution en bac à sable du processus audio.\nSi cette règle est activée, le processus audio s'exécute en bac à sable.\nSi cette règle est désactivée, le processus audio s'exécute hors bac à sable, et le module WebRTC de traitement de l'audio s'exécute dans le processus de rendu.\nLes utilisateurs sont alors exposés à des risques de sécurité liés à l'exécution du sous-système audio hors bac à sable.\nSi cette règle n'est pas configurée, la valeur par défaut du bac à sable est appliquée pour le processus audio (laquelle peut varier en fonction des plates-formes).\nCette règle vise à donner aux entreprises la possibilité de désactiver le bac à sable audio si la configuration des logiciels de sécurité qu'elles utilisent interfère avec le bac à sable.";
AuthNegotiateDelegateAllowlist.pfm_title = "Liste d'autorisation des serveurs de délégation Kerberos";
AuthNegotiateDelegateAllowlist.pfm_description = "Permet de spécifier les serveurs que Brave est susceptible d'utiliser. S'il y a plusieurs serveurs, séparez leur nom par une virgule. Les caractères génériques (*) sont autorisés.\n\nSi cette règle n'est pas configurée, Brave ne délègue pas les identifiants de l'utilisateur, même si le serveur est identifié comme faisant partie de l'intranet.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Utiliser la règle KDC pour déléguer les identifiants.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Si cette règle est activée, le système d'authentification HTTP respecte l'approbation par la règle KDC. Autrement dit, Brave ne délègue les identifiants de l'utilisateur au service sollicité que si la règle KDC indique OK-AS-DELEGATE sur un ticket de service. Consultez le document RFC 5896 sur https://tools.ietf.org/html/rfc5896.html. Le service doit également être autorisé par la règle AuthNegotiateDelegateAllowlist.\n\nSi cette règle est désactivée ou n'est pas configurée, la règle KDC est ignorée sur les plates-formes compatibles, et seule la règle AuthNegotiateDelegateAllowlist est respectée.\n\nSous Microsoft® Windows®, la règle KDC est toujours respectée.";
AuthSchemes.pfm_title = "Modèles d'authentification compatibles";
AuthSchemes.pfm_description = "Permet de spécifier les schémas d'authentification HTTP compatibles avec Brave.\n\nSi cette règle n'est pas configurée, les quatre schémas sont employés.\n\nLes valeurs valides sont les suivantes :\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nRemarque : S'il y a plusieurs valeurs, séparez-les par une virgule.";
AuthServerAllowlist.pfm_title = "Liste d'autorisation des serveurs d'authentification";
AuthServerAllowlist.pfm_description = "Permet de spécifier les serveurs autorisés pour l'authentification intégrée qui n'est activée que lorsque Brave reçoit une demande d'authentification d'un proxy ou d'un serveur figurant sur la liste des serveurs autorisés.\n\nSi cette règle n'est pas configurée, Brave essaie de détecter si un serveur se trouve sur l'intranet et répond aux requêtes IWA seulement si c'est le cas. Si un serveur est détecté sur Internet, Brave ignore alors les requêtes IWA.\n\nRemarque : S'il y a plusieurs serveurs, séparez leur nom par une virgule. Les caractères génériques (*) sont autorisés.";
AutoLaunchProtocolsFromOrigins.pfm_title = "Établir la liste des protocoles pouvant lancer une application externe à partir d'origines répertoriées sans afficher d'invite";
AutoLaunchProtocolsFromOrigins.pfm_description = "Permet d'établir la liste des protocoles (et pour chacun d'eux, une liste associée de formats d'origines autorisées) qui peuvent lancer une appli externe sans afficher d'invite. Lorsqu'un protocole est répertorié, le séparateur de fin ne doit pas être inclus. Par exemple, il convient de garder \"skype\" et non \"skype:\" ou \"skype://\".\n\nSi cette règle est configurée, un protocole n'est autorisé à lancer une application externe sans afficher d'invite que si ce protocole est répertorié dans la liste établie, et si l'origine du site qui essaie de lancer le protocole correspond à l'un des formats d'origines figurant dans la liste des origines autorisées de ce protocole. Si l'une des deux conditions est fausse, la règle n'omet pas l'invite de lancement du protocole externe.\n\nSi cette règle n'est pas configurée, aucun protocole ne peut être lancé sans invite par défaut. Les utilisateurs peuvent désactiver les invites selon le protocole ou le site, sauf si la règle ExternalProtocolDialogShowAlwaysOpenCheckbox est désactivée. Cette règle n'a aucune incidence sur les exceptions définies par les utilisateurs concernant les invites selon le protocole ou le site.\n\nLes formats correspondant à l'origine dans la liste sont semblables à ceux de la règle URLBlocklist décrite sur https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nToutefois, dans le cadre de cette règle, ces formats ne doivent pas inclure les éléments \"/path\" ni \"@query\". Tout format qui inclut l'élément \"/path\" ou \"@query\" est ignoré.\nConsultez la page https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins pour en savoir plus sur le schéma et le formatage.";
AutoOpenAllowedForURLs.pfm_title = "URL pour lesquelles la règle AutoOpenFileTypes peut s'appliquer";
AutoOpenAllowedForURLs.pfm_description = "Liste d'URL indiquant les URL pour lesquelles la règle AutoOpenFileTypes s'applique. Cette règle n'a aucune incidence sur les valeurs définies par les utilisateurs pour l'ouverture automatique.\n\nSi cette règle est configurée, les fichiers seront ouverts automatiquement à condition que la règle s'applique à l'URL et que le type de fichier figure dans AutoOpenFileTypes. Si l'une des deux conditions est fausse, le fichier téléchargé ne s'ouvrira pas automatiquement suivant cette règle.\n\nSi cette règle n'est pas configurée, tous les fichiers téléchargés qui concernent un type de fichier figurant dans AutoOpenFileTypes seront ouverts automatiquement.\n\nUn format d'URL doit respecter les conditions suivantes : https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
AutoOpenFileTypes.pfm_title = "Liste des types de fichier à ouvrir automatiquement après leur téléchargement";
AutoOpenFileTypes.pfm_description = "Cette règle permet de lister les types de fichiers à ouvrir automatiquement une fois téléchargés. Les types de fichiers doivent être indiqués sans le séparateur qui les précède (par exemple, \"txt\" et non \".txt\").\n\nCes fichiers à ouvrir automatiquement restent soumis aux vérifications de la navigation sécurisée (si activée) et ne seront ouverts que si le résultat est concluant.\n\nSi cette règle n'est pas configurée, les seuls types de fichiers qui s'ouvriront automatiquement une fois téléchargés sont ceux que l'utilisateur aura spécifiés auparavant.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
AutoSelectCertificateForUrls.pfm_title = "Sélectionner automatiquement des certificats client pour ces sites";
AutoSelectCertificateForUrls.pfm_description = "Permet de définir une liste de formats d'URL indiquant les sites pour lesquels Chrome peut sélectionner automatiquement un certificat client. Cette valeur doit être un ensemble de dictionnaires convertis en chaînes JSON, chacun d'entre eux se présentant sous la forme { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER }, où $URL_PATTERN correspond à un schéma de paramètre de contenu. Le filtre $FILTER limite les certificats client parmi lesquels le navigateur effectue une sélection automatique. Indépendamment du filtre, seuls les certificats correspondant à la demande de certificat du serveur sont sélectionnés. Sur Android et iOS, Chrome ne peut sélectionner que les certificats client qu'il a lui-même provisionnés. Il ne peut pas accéder aux certificats installés au niveau du système d'exploitation.\n\nExemples pour l'utilisation de la section $FILTER :\n\n* Lorsque le filtre $FILTER est défini sur { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } }, seuls les certificats client émis par un certificat dont la valeur CommonName est $ISSUER_CN sont sélectionnés.\n\n* Lorsque le filtre $FILTER contient à la fois une section \"ISSUER\" et une section \"SUBJECT\", le certificat client doit satisfaire les deux conditions pour être sélectionné.\n\n* Lorsque le filtre $FILTER contient une section \"SUBJECT\" avec la valeur \"O\", le certificat doit contenir au moins une organisation correspondant à la valeur spécifiée pour être sélectionné.\n\n* Lorsque le filtre $FILTER contient une section \"SUBJECT\" avec la valeur \"OU\", le certificat doit contenir au moins une unité organisationnelle correspondant à la valeur spécifiée pour être sélectionné.\n\n* Lorsque le filtre $FILTER est défini sur {}, la sélection de certificats client ne fait pas l'objet de restrictions supplémentaires. Notez que les filtres fournis par le serveur Web restent appliqués.\n\nSi cette règle n'est pas configurée, aucune sélection automatique n'est effectuée pour aucun site.\nConsultez la page https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls pour en savoir plus sur le schéma et le formatage.";
AutofillGenAiSettings.pfm_title = "Paramètres des fonctionnalités d'IA générative dans la Saisie automatique";
AutofillGenAiSettings.pfm_description = "0 - Autoriser les fonctionnalités d'IA générative dans la Saisie automatique et améliorer les modèles d'IA.\n1 - Autoriser les fonctionnalités d'IA générative dans la Saisie automatique sans améliorer les modèles d'IA.\n2 - Ne pas autoriser les fonctionnalités d'IA générative dans la Saisie automatique.\nCes fonctionnalités de Brave utilisent des modèles d'IA générative pour aider les utilisateurs à remplir des formulaires sur le Web. Pour utiliser ces fonctionnalités, Brave doit collecter des données (comme la structure des formulaires avec lesquels un utilisateur interagit et, pour Rechercher et remplir avec Gemini, les requêtes en texte libre qu'un utilisateur saisit pour effectuer des recherches dans les applications Gemini connectées), puis envoyer ces données à un serveur appartenant à Google qui exécute un modèle d'IA générative.\n\nSi vous définissez la règle sur 0 (Autoriser les fonctionnalités d'IA générative dans la Saisie automatique et améliorer les modèles d'IA), les fonctionnalités peuvent être utilisées, et Google peut utiliser les données pertinentes pour améliorer ses modèles d'IA. Selon la fonctionnalité, les données pertinentes peuvent inclure des prompts, des entrées, des sorties, des sources et des retours écrits. 0 est la valeur par défaut, sauf pour les exceptions ci-dessous.\n\nSi vous définissez la règle sur 1 (Autoriser les fonctionnalités d'IA générative dans la Saisie automatique sans améliorer les modèles d'IA), les fonctionnalités peuvent être utilisées, mais Google n'est pas autorisé à utiliser le contenu des utilisateurs (y compris les prompts, les entrées, les sorties, les sources et les commentaires écrits) pour améliorer ses modèles. 1 est la valeur par défaut pour les utilisateurs de la version Enterprise gérés par la Google Admin console et pour les comptes Education gérés par Google Workspace.\n\nSi la règle est définie sur 2 (Ne pas autoriser les fonctionnalités d'IA générative dans la Saisie automatique), les fonctionnalités ne sont pas autorisées.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nLes fonctionnalités d'IA générative dans la Saisie automatique incluent :\n\n– Analyse intelligente des formulaires : utilise l'IA pour identifier et classer les champs d'un formulaire, afin de pouvoir en remplir davantage.\n\n– Rechercher et remplir avec Gemini : recherche des informations dans les applications qu'un utilisateur a connectées à Gemini et les propose pour remplir un formulaire, sous forme de suggestions proactives ou en réponse à une requête de l'utilisateur.\n\nCette règle remplace la règle AutofillPredictionSettings, qui s'applique toujours lorsque cette règle n'est pas définie. La fonctionnalité Rechercher et remplir avec Gemini nécessite également que la règle GeminiSettings ne soit pas désactivée.\n\nCette règle ne contrôle pas les fonctionnalités de Saisie automatique qui n'utilisent pas l'IA générative.\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
AutofillSettings.pfm_title = "Bloquer les types de données utilisés par la saisie automatique pour des sites spécifiques";
AutofillSettings.pfm_description = "Cette règle vous permet de spécifier les types de données utilisés par la saisie automatique qui sont bloqués sur des formats d'URL spécifiques.\n\nLa règle prend la forme d'une liste de dictionnaires. Chaque dictionnaire doit contenir :\n* \"url_pattern\" : format d'URL de paramètre de contenu pour le frame principal (par exemple, \"https://[*.]example.com\").\n* \"blocked_types\" : liste de chaînes représentant les catégories de données utilisées par la saisie automatique à bloquer.\n\nLes valeurs acceptées pour \"blocked_types\" sont les suivantes :\n* \"contact_info\" : bloque la saisie et l'enregistrement des coordonnées.\n* \"payments\" : bloque la saisie et l'enregistrement des cartes de crédit et des modes de paiement.\n* \"identity_docs\" : bloque la saisie et l'enregistrement des pièces d'identité (par exemple, passeport, permis de conduire, pièce d'identité nationale).\n* \"travel\" : bloque la saisie et l'enregistrement des informations de voyage (par exemple, réservation de vol, numéro d'immatriculation de véhicule).\n* \"shopping\" : bloque la saisie et l'enregistrement des informations d'achat (par exemple, commandes en ligne et livraisons).\n* \"all\" : bloque la saisie et l'enregistrement de tous les types de données utilisés par la saisie automatique.\n\nSi un type de données est bloqué pour un site, la génération de suggestions et l'invite d'enregistrement/d'importation de nouvelles données de ce type sont désactivées sur ce site.\n\nSi une URL correspond à plusieurs entrées de format dans la liste, les types bloqués de toutes les entrées correspondantes sont combinés (fusion par union). Les formats d'URL non valides de la liste sont ignorés.\n\nSi cette règle n'est pas configurée, aucun type de données utilisé par la saisie automatique n'est bloqué par domaine.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter :\nhttps://chromeenterprise.google/policies/url-patterns. Le caractère générique * est pris en charge. Ce format correspond à n'importe quelle URL, avec n'importe quel schéma, port ou chemin.\nConsultez la page https://chromeenterprise.google/policies/?policy=AutofillSettings pour en savoir plus sur le schéma et le formatage.";
AutomatedPasswordChangeSettings.pfm_title = "Activer la modification automatique du mot de passe";
AutomatedPasswordChangeSettings.pfm_description = "0 - Autoriser l'utilisation de la fonctionnalité et l'amélioration des modèles d'IA\n1 - Autoriser l'utilisation de la fonctionnalité sans améliorer les modèles d'IA\n2 - Ne pas autoriser la fonctionnalité\nCette règle contrôle la disponibilité de la fonctionnalité de changement automatique de mot de passe de Brave.\n\nSi elle est activée, un utilisateur peut déclencher un processus lors duquel le navigateur tente de modifier automatiquement son mot de passe sur un site Web. Ce processus est géré par l'IA générative. Le nouveau mot de passe est enregistré dans le gestionnaire de mots de passe du navigateur.\n\n0 = Permettre d'utiliser la fonctionnalité tout en autorisant Google à utiliser des données pertinentes pour améliorer ses modèles d'IA. Selon la fonctionnalité, les données pertinentes peuvent inclure des prompts, des entrées, des sorties, des sources et des retours écrits. Elles pourront également être examinées par des réviseurs humains afin d'améliorer les modèles d'IA. 0 est la valeur par défaut, sauf pour les exceptions ci-dessous.\n\n1 = Permettre d'utiliser la fonctionnalité, mais ne pas autoriser Google à améliorer ses modèles à l'aide du contenu des utilisateurs (y compris les prompts, les entrées, les sorties, les sources et les retours écrits). 1 est la valeur par défaut pour les utilisateurs de la version Enterprise gérés par la console d'administration Google et pour les comptes Education gérés par Google Workspace.\n\n2 = Ne pas autoriser la fonctionnalité.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Autoriser les téléchargements automatiques sur ces sites";
AutomaticDownloadsAllowedForUrls.pfm_description = "Vous permet de définir une liste de formats d'URL indiquant les sites autorisés à télécharger automatiquement plusieurs fichiers.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns.\n\nSi une URL correspond à la fois à AutomaticDownloadsAllowedForUrls et à AutomaticDownloadsBlockedForUrls, AutomaticDownloadsBlockedForUrls est prioritaire.\n\nSi cette règle n'est pas configurée, la règle DefaultAutomaticDownloadsSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Bloquer les téléchargements automatiques sur ces sites";
AutomaticDownloadsBlockedForUrls.pfm_description = "Vous permet de définir une liste de formats d'URL indiquant les sites non autorisés à télécharger automatiquement plusieurs fichiers.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns.\n\nSi une URL correspond à la fois à AutomaticDownloadsAllowedForUrls et à AutomaticDownloadsBlockedForUrls, AutomaticDownloadsBlockedForUrls est prioritaire.\n\nSi cette règle n'est pas configurée, la règle DefaultAutomaticDownloadsSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Autoriser le plein écran automatique sur ces sites";
AutomaticFullscreenAllowedForUrls.pfm_description = "Pour des raisons de sécurité, l'API Web requestFullscreen() nécessite un geste préalable de l'utilisateur (\"activation temporaire\"). Sinon, une erreur se produit. Les paramètres personnels des utilisateurs peuvent autoriser certaines origines à appeler cette API sans geste préalable de l'utilisateur, comme décrit sur https://chromestatus.com/feature/6218822004768768.\n\nCette règle remplace les paramètres personnels des utilisateurs et permet aux origines correspondantes d'appeler l'API sans geste préalable de l'utilisateur.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns.\nLes caractères génériques (*) sont autorisés.\n\nLes origines correspondant à la fois aux formats de règle bloqués et autorisés seront bloquées.\nLes origines non spécifiées par la règle ni par les paramètres utilisateur nécessitent un geste préalable de l'utilisateur pour appeler cette API.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Bloquer le plein écran automatique sur ces sites";
AutomaticFullscreenBlockedForUrls.pfm_description = "Pour appeler l'API Web requestFullscreen() sans générer d'erreur, l'utilisateur doit effectuer, pour des raisons de sécurité, un geste préalable (\"activation temporaire\"). Il peut autoriser dans ses paramètres personnels certaines origines à appeler cette API sans geste préalable de sa part, comme décrit sur https://chromestatus.com/feature/6218822004768768.\n\nCette règle remplace ces paramètres personnels et empêche les origines correspondantes d'appeler l'API sans geste préalable de l'utilisateur.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns.\nLes caractères génériques (*) sont autorisés.\n\nLes origines correspondant à la fois aux formats de règle bloqués et autorisés seront bloquées.\nLes origines non spécifiées par la règle ni par les paramètres utilisateur nécessitent un geste préalable de l'utilisateur pour appeler cette API.";
AutoplayAllowed.pfm_title = "Autoriser la lecture automatique de contenus multimédias";
AutoplayAllowed.pfm_description = "Si cette règle est définie sur \"True\", Brave est autorisé à lire automatiquement du contenu multimédia. Si elle est définie sur \"False\", Brave n'est pas autorisé à lire automatiquement du contenu multimédia.\n\nSi cette règle n'est pas configurée, Brave ne lit pas automatiquement ce type de contenu. Toutefois, pour certains formats d'URL, la règle AutoplayAllowlist permet de modifier ce paramètre.\n\nSi Brave est en cours d'utilisation lorsque le paramètre de cette règle change, la modification ne s'applique qu'aux nouveaux onglets ouverts.";
AutoplayAllowlist.pfm_title = "Autoriser la lecture automatique des contenus multimédias pour les formats d'URL sur liste d'autorisation";
AutoplayAllowlist.pfm_description = "Cette règle permet la lecture automatique des vidéos (sans accord de l'utilisateur) avec leur contenu audio dans Brave. Si la règle AutoplayAllowed est définie sur \"True\", cette règle n'a aucune incidence. Si AutoplayAllowed est définie sur \"False\", la lecture automatique est toujours activée pour les formats d'URL inclus dans cette règle. Si Brave est en cours d'exécution lorsque cette règle est modifiée, la modification n'affectera que les nouveaux onglets ouverts.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.";
BackgroundTabFreezingEnabled.pfm_title = "Activer le figement des onglets en arrière-plan";
BackgroundTabFreezingEnabled.pfm_description = "Permet de déterminer si Brave fige les onglets inactifs en arrière-plan pour économiser la mémoire et les ressources processeur.\n\nLorsque le figement des onglets en arrière-plan est actif, les onglets qui sont restés inactifs en arrière-plan pendant un certain temps sont figés en mettant en pause l'exécution de JavaScript et les tâches programmées. Les onglets figés restent chargés en mémoire et reprennent instantanément lorsque l'utilisateur les sélectionne. Les onglets avec des tâches en arrière-plan actives (par exemple, ceux qui lisent du contenu audio ou vidéo, capturent des flux d'écran ou de caméra, maintiennent des connexions WebRTC actives ou détiennent des Web Locks) ne peuvent pas être figés et continuent de fonctionner. Les sites configurés dans la règle TabDiscardingExceptions ou dans les exceptions de suppression d'onglets définies par l'utilisateur ne sont pas non plus figés.\n\nSi cette règle est activée, les onglets en arrière-plan éligibles sont automatiquement figés. Les utilisateurs ne peuvent pas modifier ce paramètre.\n\nSi cette règle est désactivée, les onglets en arrière-plan ne sont pas figés. Les utilisateurs ne peuvent pas modifier ce paramètre.\n\nSi cette règle n'est pas configurée, le figement des onglets en arrière-plan est activé par défaut, mais les utilisateurs peuvent l'activer ou le désactiver dans les paramètres de Brave.";
BasicAuthOverHttpEnabled.pfm_title = "Autoriser l'authentification Basic pour HTTP";
BasicAuthOverHttpEnabled.pfm_description = "Si cette règle est activée ou si elle n'est pas définie, l'authentification Basic sera autorisée sur les connexions HTTP non sécurisées.\n\nSi cette règle est désactivée, l'authentification Basic ne sera pas autorisée sur les connexions HTTP non sécurisées (elle le sera uniquement sur les connexions HTTPS sécurisées).\n\nCette règle est ignorée (et l'authentification Basic est toujours interdite) si la règle AuthSchemes est définie et n'inclut pas l'authentification Basic.";
BatterySaverModeAvailability.pfm_title = "Activer le mode Économiseur de batterie";
BatterySaverModeAvailability.pfm_description = "0 - Le mode Économiseur de batterie sera désactivé.\n1 - Le Mode Économiseur de batterie est activé quand l'appareil est sur batterie et que le niveau de la batterie est faible.\n2 - Cette valeur a été abandonnée dans la version M121. Dans M121 et les versions ultérieures, les valeurs seront traitées comme EnabledUnderThreshold.\nCette règle active ou désactive le mode Économiseur de batterie.\nDans Chrome, ce paramètre limite la fréquence d'images afin de réduire la consommation d'énergie. Si cette règle n'est pas configurée, l'utilisateur final peut contrôler ce paramètre dans chrome://settings/performance.\nSous ChromeOS, ce paramètre limite la fréquence d'images et la fréquence du processeur, diminue la luminosité des rétroéclairages et active le mode Économiseur de batterie d'Android. Sur les appareils dotés de plusieurs processeurs, certains processeurs sont désactivés.\nVoici les différents niveaux :\nDisabled (0) : le mode Économiseur de batterie est désactivé.\nEnabledBelowThreshold (1) : le mode Économiseur de batterie est activé quand l'appareil est sur batterie et que le niveau de la batterie est faible.\nEnabledOnBattery (2) : cette valeur a été abandonnée dans la version M121. Dans M121 et les versions ultérieures, les valeurs seront traitées comme EnabledUnderThreshold.\n";
BlockExternalExtensions.pfm_title = "Empêche que des extensions externes soient installées";
BlockExternalExtensions.pfm_description = "Permet de contrôler l'installation d'extensions externes.\n\nSi cette règle est activée, les extensions externes ne pourront pas être installées.\n\nSi cette règle est désactivée ou si elle n'est pas configurée, les extensions externes pourront être installées.\n\nLes extensions externes et leur installation sont décrites sur https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions.\n\nRemarque : Cette règle ne s'applique qu'aux plates-formes compatibles avec les extensions.";
BlockThirdPartyCookies.pfm_title = "Bloquer les cookies tiers";
BlockThirdPartyCookies.pfm_description = "Si cette règle est activée, les éléments de page Web qui ne font pas partie du domaine indiqué dans la barre d'adresse du navigateur ne peuvent pas placer de cookies. Si cette règle est désactivée, ces éléments sont autorisés à placer des cookies, et les utilisateurs ne peuvent pas modifier ce paramètre.\n\nSi cette règle n'est pas configurée, les cookies tiers sont autorisés, mais les utilisateurs peuvent modifier ce paramètre.\n\nRemarque : cette règle ne s'applique pas en mode navigation privée, où les cookies tiers sont bloqués et ne peuvent être autorisés qu'au niveau du site. Pour autoriser les cookies au niveau du site, utilisez la règle CookiesAllowedForUrls.";
BookmarkBarEnabled.pfm_title = "Activer le barre de favoris";
BookmarkBarEnabled.pfm_description = "Si cette règle est définie sur \"True\", une barre de favoris est affichée dans Brave. Si cette règle est définie sur \"False\", cette barre de favoris n'est jamais affichée.\n\nSi vous configurez cette règle, les utilisateurs ne peuvent pas la modifier. Si cette règle n'est pas configurée, les utilisateurs choisissent d'utiliser ou non cette fonction.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "Autoriser l'ajout de personnes dans le gestionnaire d'utilisateurs";
BrowserAddPersonEnabled.pfm_description = "Si cette règle est définie sur \"true\" ou si elle n'est pas configurée, Brave et Lacros autorisent l'ajout d'une personne depuis le gestionnaire d'utilisateurs.\n\nSi elle est définie sur \"false\", Brave et Lacros n'autorisent pas l'ajout d'une personne depuis le gestionnaire d'utilisateurs.";
BrowserGuestModeEnabled.pfm_title = "Activer le mode Invité dans le navigateur";
BrowserGuestModeEnabled.pfm_description = "Si cette règle est activée ou si elle n'est pas configurée, Brave autorise les connexions en mode Invité. Les connexions en mode Invité sont des profils Brave où toutes les fenêtres s'ouvrent en mode navigation privée.\n\nSi cette règle est désactivée, Brave n'autorise pas l'utilisation de profils invité.";
BrowserGuestModeEnforced.pfm_title = "Activer le mode Invité du navigateur";
BrowserGuestModeEnforced.pfm_description = "Si cette règle est activée, Brave force l'ouverture des sessions Invité et empêche les connexions de profils. Les connexions en mode Invité sont des profils Brave où les fenêtres s'ouvrent en mode navigation privée.\n\nSi cette règle est désactivée ou qu'elle n'est pas configurée, ou si le mode Invité du navigateur est désactivé (via BrowserGuestModeEnabled), l'utilisation de nouveaux profils ou de profils existants est autorisée.";
BrowserLabsEnabled.pfm_title = "Icône des fonctionnalités expérimentales du navigateur dans la barre d'outils";
BrowserLabsEnabled.pfm_description = "Si cette règle est activée ou n'est pas configurée, les utilisateurs peuvent accéder aux fonctionnalités expérimentales du navigateur via une icône de la barre d'outils.\n\nSi cette règle est désactivée, l'icône des fonctionnalités expérimentales du navigateur ne s'affiche pas dans la barre d'outils.\n\nL'activation ou la désactivation de cette règle ne change rien au fonctionnement de la page chrome://flags ni à celui de tout autre moyen d'activer ou désactiver des fonctionnalités du navigateur.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Autoriser l'envoi de requêtes à un service de temps de Google";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, Brave envoie des requêtes occasionnelles à un serveur Google pour récupérer un horodatage précis.\n\nSi cette règle est désactivée, Brave cesse d'envoyer ces requêtes.";
BrowserSignin.pfm_title = "Paramètres de connexion au navigateur";
BrowserSignin.pfm_description = "0 - Désactiver la connexion au navigateur\n1 - Activer la connexion au navigateur\n2 - Obliger les utilisateurs à se connecter pour se servir du navigateur\nCette règle contrôle la connexion au navigateur. Elle vous permet de spécifier si l'utilisateur peut se connecter à Brave à l'aide de son compte et utiliser les services associés à ce compte, comme la synchronisation Brave.\n\nSi elle est définie sur \"Désactiver la connexion au navigateur\", l'utilisateur ne peut pas se connecter au navigateur ni utiliser les services associés au compte. Dans ce cas, les fonctionnalités du navigateur, comme la synchronisation Brave, sont indisponibles. Sur iOS, si l'utilisateur est connecté au moment où la règle est désactivée, il sera déconnecté immédiatement. Sur d'autres plates-formes, il sera déconnecté la prochaine fois qu'il lancera Brave. En revanche, quelle que soit la plate-forme, ses données de profil locales (favoris, mots de passe, etc.) seront conservées et resteront utilisables. Il pourra toujours se connecter aux services Web Google, comme Gmail, et s'en servir.\n\nSi la règle est définie sur \"Activer la connexion au navigateur\", l'utilisateur peut se connecter au navigateur. Sur toutes les plates-formes, sauf iOS, la connexion se fait automatiquement lorsque l'utilisateur accède à des services Web Google, comme Gmail. Lorsque l'utilisateur est connecté au navigateur, ses informations de compte sont conservées par le navigateur. Cependant, cela ne signifie pas que la synchronisation Brave est activée par défaut : l'utilisateur doit explicitement accepter d'utiliser cette fonctionnalité. En activant cette règle, vous empêchez l'utilisateur de désactiver le paramètre qui autorise la connexion au navigateur. Pour contrôler la disponibilité de la synchronisation Brave, utilisez la règle SyncDisabled.\n\nSi la règle est définie sur \"Obliger la connexion au navigateur\", une boîte de dialogue s'affiche pour demander à l'utilisateur de choisir un compte auquel se connecter pour utiliser le navigateur. Cette mesure permet de s'assurer que dans le cas de comptes gérés, les règles qui les régissent sont bien appliquées. La règle BrowserGuestModeEnabled est désactivée par défaut. Sachez que les profils existants non connectés seront verrouillés et inaccessibles une fois cette règle activée. Pour en savoir plus, consultez cet article du centre d'aide : https://support.google.com/chrome/?p=force_browser_signin. Cette option n'est pas prise en charge sur Google Chrome OS ni sur Android. L'option \"Activer la connexion au navigateur\" est alors utilisée.\n\nSi la règle n'est pas définie, l'utilisateur peut décider d'activer ou non l'option de connexion au navigateur dans les paramètres de Brave, et l'utiliser à sa convenance.";
BrowserSwitcherDelay.pfm_title = "Délai avant le lancement du navigateur secondaire (en millisecondes)";
BrowserSwitcherDelay.pfm_description = "Si cette règle est définie sur un nombre, Brave affiche un message pendant le nombre de millisecondes défini, puis ouvre un navigateur secondaire.\n\nSi cette règle n'est pas configurée ou qu'elle est définie sur 0, l'URL sélectionnée s'ouvre automatiquement dans un navigateur secondaire.";
BrowserSwitcherEnabled.pfm_title = "Activer la fonctionnalité Legacy Browser Support.";
BrowserSwitcherEnabled.pfm_description = "Si cette règle est activée, Brave tente d'ouvrir certaines URL dans un autre navigateur (par exemple, Internet Explorer®). Cette fonctionnalité est configurée à l'aide des règles du groupe Legacy Browser support.\n\nSi cette règle est désactivée ou qu'elle n'est pas configurée, Brave ne tente pas d'ouvrir les URL indiquées dans un autre navigateur.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "URL d'un fichier XML qui contient des URL qui ne doivent jamais déclencher un changement de navigateur.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Si cette règle est définie sur une URL valide, Brave télécharge la liste des sites à partir de cette URL, puis applique les instructions comme si elles avaient été configurées avec la règle BrowserSwitcherUrlGreylist. Ces instructions empêchent Brave et le navigateur secondaire de s'ouvrir l'un l'autre.\n\nSi cette règle n'est pas configurée ou qu'elle est définie sur une URL non valide, Brave n'utilise pas cette règle comme source d'instructions pour ne pas changer de navigateur.\n\nRemarque : Cette règle renvoie vers un fichier XML au même format que celui de la règle SiteList d'Internet Explorer®. Les instructions sont ainsi chargées à partir d'un fichier XML, sans être partagées avec Internet Explorer®. Pour en savoir plus sur la règle SiteList d'Internet Explorer®, consultez la page https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL d'un fichier XML qui contient des URL à charger dans un navigateur secondaire.";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Si cette règle est définie sur une URL valide, Brave télécharge la liste des sites à partir de cette URL, puis applique les instructions comme si elles avaient été configurées avec la règle BrowserSwitcherUrlList.\n\nSi cette règle n'est pas configurée ou qu'elle est définie sur une URL non valide, Brave n'utilise pas cette règle comme source d'instructions pour changer de navigateur.\n\nRemarque : Cette règle renvoie vers un fichier XML au même format que celui de la règle SiteList d'Internet Explorer®. Les instructions sont ainsi chargées à partir d'un fichier XML, sans être partagées avec Internet Explorer®. Pour en savoir plus sur la règle SiteList d'Internet Explorer®, consultez la page https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Laisser le dernier onglet ouvert dans Chrome.";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, Brave laisse au moins un onglet ouvert après avoir basculé vers un navigateur secondaire.\n\nSi cette règle est désactivée, Brave ferme l'onglet après avoir basculé vers un navigateur secondaire, même s'il s'agit du dernier onglet. Brave est alors fermé complètement.";
BrowserSwitcherParsingMode.pfm_title = "Mode d'analyse de la liste des sites";
BrowserSwitcherParsingMode.pfm_description = "0 - Comportement par défaut de LBS.\n1 - Meilleure compatibilité avec les listes des sites Microsoft IE/Edge en mode Entreprise.\nCette règle contrôle la façon dont Google Chrome interprète les règles des listes grises/de sites pour la fonctionnalité Legacy Browser Support. Cela concerne ces règles : BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl et BrowserSwitcherExternalGreylistUrl.\n\nSi cette règle est définie sur \"Par défaut\" (0) ou qu'elle n'est pas configurée, la mise en correspondance d'URL est moins stricte. Les instructions qui n'incluent pas \"/\" recherchent une sous-chaîne dans le nom d'hôte de l'URL. La mise en correspondance du composant de chemin d'une URL est sensible à la casse.\n\nSi cette règle est définie sur \"IESiteListMode\" (1), la mise en correspondance d'URL est plus stricte. Les instructions qui n'incluent pas \"/\" n'établissent une correspondance qu'à la fin du nom d'hôte. Elles doivent aussi être associées à la limite d'un nom de domaine. La mise en correspondance du composant de chemin d'une URL n'est pas sensible à la casse. La compatibilité est meilleure avec Microsoft® Internet Explorer® et Microsoft® Edge®.\n\nPar exemple, avec les instructions \"example.com\" et \"acme.com/abc\" :\n\n\"http://example.com/\", \"http://subdomain.example.com/\" et \"http://acme.com/abc\" correspondent quel que soit le mode d'analyse.\n\n\"http://notexample.com/\", \"http://example.com.invalid.com/\" et \"http://example.comabc/\" correspondent uniquement en mode \"Par défaut\".\n\n\"http://acme.com/ABC\" ne correspond qu'en \"IESiteListMode\".";
BrowserSwitcherUrlGreylist.pfm_title = "Sites Web qui ne doivent jamais déclencher un changement de navigateur.";
BrowserSwitcherUrlGreylist.pfm_description = "Permet d'établir la liste des sites Web qui ne déclencheront jamais de changement de navigateur. Chaque élément est traité comme une instruction. Les instructions pour lesquelles il y a une correspondance ne déclenchent pas l'ouverture d'un navigateur secondaire. Contrairement à la règle BrowserSwitcherUrlList, les instructions s'appliquent dans les deux sens. Lorsque le module complémentaire d'Internet Explorer® est activé, il contrôle également si Internet Explorer® doit ouvrir ou non ces URL dans Brave.\n\nSi cette règle n'est pas configurée, aucun site Web n'est ajouté à la liste.\n\nRemarque : Vous pouvez également utiliser la règle BrowserSwitcherExternalGreylistUrl pour ajouter des éléments à cette liste.";
BrowserSwitcherUrlList.pfm_title = "Sites Web à ouvrir dans le navigateur secondaire";
BrowserSwitcherUrlList.pfm_description = "Permet d'établir la liste des sites Web à ouvrir dans un navigateur secondaire. Chaque élément est traité comme une instruction pour un élément à ouvrir dans un navigateur secondaire. Brave utilise ces instructions pour décider si une URL doit être ouverte dans un navigateur secondaire ou non. Si le module complémentaire d'Internet Explorer® est activé, Internet Explorer® bascule de nouveau vers Brave lorsque les instructions ne rencontrent pas de correspondance. Si les instructions se contredisent, Brave utilise la plus spécifique.\n\nSi cette règle n'est pas configurée, aucun site Web n'est ajouté à la liste.\n\nRemarque : Vous pouvez également utiliser les règles BrowserSwitcherUseIeSitelist et BrowserSwitcherExternalSitelistUrl pour ajouter des éléments à cette liste.";
BrowserThemeColor.pfm_title = "Configurer la couleur du thème du navigateur";
BrowserThemeColor.pfm_description = "Cette règle permet aux administrateurs de configurer la couleur du thème de Brave. La chaîne saisie doit être une couleur hexadécimale valide, comme \"#RRGGBB\".\n\nSi tel est le cas, un thème basé sur cette couleur est automatiquement généré et appliqué au navigateur. Les utilisateurs ne peuvent pas modifier le thème défini dans cette règle.\n\nEn revanche, ils peuvent appliquer le thème de leur choix au navigateur si la règle n'est pas configurée.";
BrowsingDataLifetime.pfm_title = "Paramètres de durée de conservation des données de navigation";
BrowsingDataLifetime.pfm_description = "Permet de configurer les paramètres de durée de conservation des données de navigation dans Brave. Cette règle permet aux administrateurs de définir (selon le type de données) quand le navigateur supprime ces données. C'est utile pour les clients qui utilisent des données sensibles.\n\nAvertissement : La définition de cette règle peut affecter les données personnelles locales et entraîner leur suppression définitive. Nous vous recommandons de tester vos paramètres avant de les déployer pour éviter toute suppression accidentelle de données personnelles.\n\nTypes de données disponibles : 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' et 'hosted_app_data'. 'download_history' et 'hosted_app_data' ne sont pas compatibles avec Android.\n\nLe navigateur supprimera automatiquement les données des types sélectionnés qui datent de plus de 'time_to_live_in_hours'. Vous ne pouvez pas définir une valeur inférieure à une heure.\n\nLa suppression des données expirées se fera 15 secondes après le démarrage du navigateur, puis toutes les 30 minutes lorsque le navigateur sera en cours d'exécution.\n\nL'utilisateur restera connecté à son compte Google lorsqu'il supprimera les cookies.\n\nJusqu'à Chrome 114, cette règle exigeait que la règle SyncDisabled soit définie sur \"true\". À partir de Chrome 115, si vous configurez cette règle, la synchronisation sera désactivée pour les types de données respectifs si Chrome Sync n'est pas désactivé en définissant la règle SyncDisabled et que BrowserSignin n'est pas désactivé.\nConsultez la page https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime pour en savoir plus sur le schéma et le formatage.";
BuiltInAIAPIsEnabled.pfm_title = "Autoriser les pages à utiliser les API d'IA intégrées.";
BuiltInAIAPIsEnabled.pfm_description = "Cette règle détermine si une page peut utiliser les API d'IA intégrées (LanguageModel API, Summarization API, Writer API et Rewriter API, par exemple).\n\nSi la règle est activée ou si elle n'est pas configurée, les API sont activées et peuvent être utilisées.\n\nSi la règle est désactivée, toute tentative d'utilisation des API entraînera une erreur.";
BuiltInDnsClientEnabled.pfm_title = "Utiliser le client DNS intégré";
BuiltInDnsClientEnabled.pfm_description = "Cette règle détermine la pile logicielle utilisée pour communiquer avec le serveur DNS, c'est-à-dire soit le client DNS du système d'exploitation, soit le client DNS intégré de Brave. Elle n'a aucune incidence sur les serveurs DNS utilisés : si, par exemple, le système d'exploitation est configuré pour utiliser un serveur DNS d'entreprise, ce même serveur sera utilisé par le client DNS intégré. Elle ne contrôle pas non plus l'utilisation du protocole DNS-over-HTTPS. Brave utilisera toujours le résolveur intégré pour les requêtes DNS-over-HTTPS. Pour en savoir plus sur le contrôle du protocole DNS-over-HTTPS, veuillez consulter la règle DnsOverHttpsMode.\n\nSi cette règle est activée ou n'est pas configurée, le client DNS intégré est utilisé.\n\nSi vous la désactivez, le client DNS intégré n'est utilisé que si le protocole DNS-over-HTTPS est utilisé.";
CACertificateManagementAllowed.pfm_title = "Autoriser les utilisateurs à gérer les certificats CA installés.";
CACertificateManagementAllowed.pfm_description = "0 - Autoriser les utilisateurs à gérer tous les certificats\n1 - Autoriser les utilisateurs à gérer les certificats utilisateur\n2 - Ne pas autoriser les utilisateurs à gérer les certificats\nSi la règle est définie sur \"All (0)\" (Tous (0)) ou qu'elle n'est pas configurée, les utilisateurs peuvent modifier les paramètres de confiance de tous les certificats CA, importer des certificats et supprimer ceux qu'ils ont importés via le gestionnaire de certificats. Si elle est définie sur \"UserOnly (1)\" (UtilisateurUniquement (1)), les utilisateurs ne peuvent gérer que les certificats qu'ils ont importés, et ils ne sont pas autorisés à modifier les paramètres de confiance des certificats intégrés. Si cette règle est définie sur \"None (2)\" (Aucun (2)), les utilisateurs peuvent uniquement consulter les certificats CA (sans pouvoir les gérer).";
CACertificates.pfm_title = "Certificats TLS qui devraient être approuvés par Brave pour l'authentification du serveur";
CACertificates.pfm_description = "Liste des certificats TLS qui devraient être approuvés par Brave pour l'authentification du serveur.\nLes certificats doivent être encodés en base64.";
CACertificatesWithConstraints.pfm_title = "Certificats TLS qui devraient être approuvés par Brave pour l'authentification du serveur avec des contraintes";
CACertificatesWithConstraints.pfm_description = "Liste des certificats TLS qui devraient être approuvés par Brave pour l'authentification du serveur, avec des contraintes ajoutées en dehors du certificat. Si aucune contrainte d'un certain type n'est présente, n'importe quel nom de ce type est autorisé.\nLes certificats doivent être encodés en base64. Vous devez spécifier au moins une contrainte pour chaque certificat.\nConsultez la page https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints pour en savoir plus sur le schéma et le formatage.";
CADistrustedCertificates.pfm_title = "Certificats TLS qui ne devraient plus être approuvés par Brave pour l'authentification du serveur";
CADistrustedCertificates.pfm_description = "Liste de clés publiques de certificat qui ne devraient plus être approuvées par Brave pour l'authentification du serveur TLS.\n\nLa valeur de la règle est une liste de certificats X.509 encodés en base64. Les certificats associés à un SPKI (SubjectPublicKeyInfo) correspondant ne seront plus approuvés.";
CAHintCertificates.pfm_title = "Certificats TLS non approuvés ou qui ne sont plus approuvés, mais qui peuvent être utilisés pour la création de chemins pour l'authentification du serveur";
CAHintCertificates.pfm_description = "Liste de certificats non approuvés ou qui ne sont plus approuvés dans Brave, mais qui peuvent être utilisés comme des indications pour la création de chemins. Les certificats doivent être encodés en base64.";
CAPlatformIntegrationEnabled.pfm_title = "Utiliser les certificats TLS ajoutés par l'utilisateur depuis des magasins de confiance de la plate-forme pour l'authentification du serveur";
CAPlatformIntegrationEnabled.pfm_description = "Si cette règle est activée (ou n'est pas configurée), les certificats TLS ajoutés par l'utilisateur depuis les magasins de confiance de la plate-forme seront utilisés pour la création de chemins pour l'authentification du serveur TLS.\n\nSi elle est désactivée, les certificats TLS ajoutés par l'utilisateur depuis les magasins de confiance de la plate-forme ne seront pas utilisés pour la création de chemins pour l'authentification du serveur TLS.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "Prise en charge des en-têtes de requêtes CORS sans caractères génériques";
CORSNonWildcardRequestHeadersSupport.pfm_description = "Permet de configurer la prise en charge des en-têtes de requêtes CORS sans caractères génériques.\n\nLa prise en charge des en-têtes de requêtes CORS sans caractères génériques est une nouveauté de Brave version 97. Lorsque des scripts établissent une requête de réseau multi-origine via fetch() et XMLHttpRequest avec un en-tête Authorization ajouté par script, l'en-tête doit être explicitement autorisé par l'en-tête Access-Control-Allow-Headers de la réponse à la requête préliminaire CORS. \"Explicitement\" signifie que le caractère générique \"*\" ne couvre pas l'en-tête Authorization. Consultez https://chromestatus.com/feature/5742041264816128 pour plus de détails.\n\nSi cette règle n'est pas définie ou qu'elle est définie sur \"True\", Brave prendra en charge les en-têtes de requêtes CORS sans caractères génériques et se comportera comme décrit ci-dessus.\n\nSi cette règle est définie sur \"False\", Chrome autorisera le caractère générique (\"*\") dans l'en-tête Access-Control-Allow-Headers de la réponse à la requête préliminaire CORS pour couvrir l'en-tête Authorization.\n\nCette règle d'entreprise est temporaire et sera normalement supprimée à l'avenir.";
CacheEncryptionEnabled.pfm_title = "Cette règle permet aux administrateurs de chiffrer le cache HTTP sur le disque.";
CacheEncryptionEnabled.pfm_description = "Cette règle permet aux administrateurs de chiffrer le cache HTTP du navigateur sur le disque.\n\nLorsque cette règle est activée, le cache du navigateur est chiffré.\n\nSi elle est désactivée ou qu'elle n'est pas configurée, le cache du navigateur n'est pas chiffré.\n\nLe chiffrement du cache du navigateur peut avoir un impact sur les performances.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "Désactiver l'application des règles de transparence des certificats pour une liste de hachages subjectPublicKeyInfo";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "Permet de désactiver l'application des exigences de divulgation stipulées dans les règles de transparence des certificats pour une liste de hachages subjectPublicKeyInfo. Les hôtes Enterprise peuvent ainsi continuer d'utiliser des certificats qui ne seraient sinon pas jugés fiables (pour ne pas avoir été communiqués au public comme il se doit). Pour procéder à cette désactivation, l'une des conditions suivantes doit être remplie :\n\n* Le hachage doit être au format subjectPublicKeyInfo dans le certificat du serveur.\n\n* Le hachage doit être au format subjectPublicKeyInfo figurant dans un certificat CA de la chaîne des certificats. Ce certificat CA est limité via l'extension nameConstraints X.509v3. Un ou plusieurs éléments directoryName nameConstraints figurent dans permittedSubtrees, et l'élément directoryName contient un attribut organizationName.\n\n* Le hachage doit être au format subjectPublicKeyInfo figurant dans un certificat CA de la chaîne des certificats. Le certificat CA possède un ou plusieurs attributs organizationName dans l'élément Subject du certificat. Le certificat du serveur contient le même nombre d'attributs organizationName, dans le même ordre, et avec des valeurs octet par octet identiques.\n\nSpécifiez un hachage subjectPublicKeyInfo en concaténant le nom de l'algorithme de hachage, une barre oblique et l'encodage Base64 de cet algorithme de hachage appliqué à l'élément subjectPublicKeyInfo encodé en DER du certificat spécifié. Le format d'encodage Base64 correspond à celui d'une empreinte SPKI. SHA-256 est le seul algorithme de hachage reconnu (les autres sont ignorés).\n\nSi cette règle n'est pas configurée, cela signifie que si les certificats ne sont pas communiqués tel que le prévoient les règles de transparence des certificats, Brave considère alors qu'ils ne sont pas fiables.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "Désactiver l'application des règles de transparence des certificats pour une liste d'URL";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "Permet de désactiver l'application des exigences de divulgation stipulées dans les règles de transparence des certificats pour les noms d'hôte dans la liste d'URL spécifiées. Même si cela complique la détection des certificats qui ne sont pas émis correctement, les hôtes peuvent continuer d'utiliser des certificats qui ne seraient sinon pas jugés fiables (pour ne pas avoir été communiqués au public comme il se doit).\n\nSi cette règle n'est pas configurée, cela signifie que si les certificats ne sont pas communiqués tel que le prévoient les règles de transparence des certificats, Brave considère alors qu'ils ne sont pas fiables.\n\nLe format d'URL doit respecter les conditions indiquées à la page https://support.google.com/chrome/a?p=url_blocklist_filter_format. Toutefois, la validité des certificats pour un nom d'hôte donné étant indépendante du schéma, du port ou du chemin d'accès, Brave ne prend en compte que la partie du nom d'hôte de l'URL. Les hôtes génériques ne sont pas acceptés.";
ChromeForTestingAllowed.pfm_title = "Autoriser Chrome for Testing";
ChromeForTestingAllowed.pfm_description = "Détermine si les utilisateurs peuvent utiliser ou non Chrome for Testing.\n\nSi cette règle est activée ou n'est pas configurée, les utilisateurs peuvent installer et exécuter Chrome for Testing.\n\nSi cette règle est désactivée, les utilisateurs ne sont pas autorisés à exécuter Chrome for Testing. Ils pourront quand même installer Chrome for Testing, mais cette version ne s'exécutera pas avec les profils pour lesquels cette règle est désactivée.";
ChromeSuggestionsSettings.pfm_title = "Paramètres pour ChromeSuggestions";
ChromeSuggestionsSettings.pfm_description = "Ce paramètre permet à Chrome de suggérer des fonctionnalités d'IA aux moments opportuns.\n\n0/Non configuré = Les suggestions Chrome sont activées pour les utilisateurs.\n\n1 = Les suggestions Chrome sont désactivées pour les utilisateurs.\n\nPour en savoir plus, veuillez consulter l'article du centre d'aide https://support.google.com/chrome/a?p=chrome_suggestions.";
ChromeVariations.pfm_title = "Déterminer la disponibilité des variantes";
ChromeVariations.pfm_description = "0 - Activer toutes les variantes\n1 - Activer uniquement les variantes concernant les correctifs critiques\n2 - Désactiver toutes les variantes\nPermet de définir quelles variantes peuvent être appliquées dans Brave.\n\nLes variantes offrent un moyen de proposer des modifications concernant Brave sans envoyer de nouvelle version du navigateur, en activant ou en désactivant des fonctionnalités déjà disponibles. Pour en savoir plus, consultez cette page : https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework.\n\nSi vous définissez VariationsEnabled sur \"0\" ou si cette règle n'est pas configurée, toutes les variantes peuvent alors être appliquées au navigateur.\n\nSi vous définissez CriticalFixesOnly sur \"1\", seules les variantes considérées comme des correctifs essentiels de sécurité ou de stabilité peuvent être appliquées à Brave.\n\nSi vous définissez VariationsDisabled sur \"2\", aucune variante ne peut être appliquée au navigateur. Veuillez noter que ce mode n'est pas recommandé, car il est susceptible d'empêcher les développeurs Brave de fournir des correctifs de sécurité critiques en temps voulu.";
ClearBrowsingDataOnExitList.pfm_title = "Effacer les données de navigation en fin de session";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - Historique de navigation\ndownload_history - Historique des téléchargements\ncookies_and_other_site_data - Cookies et autres données des sites\ncached_images_and_files - Images et fichiers en cache\npassword_signin - Connexion avec un mot de passe\nautofill - Saisie automatique\nsite_settings - Paramètres des sites\nhosted_app_data - Données des applications hébergées\nConfigure une liste des types de données de navigation devant être supprimés lorsque l'utilisateur ferme toutes les fenêtres du navigateur.\n\nAvertissement : La définition de cette règle peut affecter les données personnelles locales et entraîner leur suppression définitive. Nous vous recommandons de tester vos paramètres avant de les déployer pour éviter toute suppression accidentelle de données personnelles.\n\nLes types de données disponibles sont les suivants : historique de navigation (browsing_history), historique des téléchargements (download_history), cookies (cookies_and_other_site_data), cache ((cached_images_and_files)), saisie automatique (autofill), mots de passe (password_signin), paramètres des sites (site_settings) et données des applis hébergées (hosted_app_data). Cette règle ne prévaut pas sur AllowDeletingBrowserHistory.\n\nL'utilisateur restera connecté à son compte Google lorsqu'il supprimera les cookies.\n\nJusqu'à Chrome 114, cette règle exigeait que la règle SyncDisabled soit définie sur \"true\". À partir de Chrome 115, si vous configurez cette règle, la synchronisation sera désactivée pour les types de données respectifs si Chrome Sync n'est pas désactivé en définissant la règle SyncDisabled et que BrowserSignin n'est pas désactivé.\n\nSi, pour une raison quelconque, la suppression des données a commencé, mais ne s'est pas terminée, les données de navigation seront effacées lors du prochain chargement du profil.\n\nSi Brave ne se ferme pas correctement (par exemple, si le navigateur ou l'OS plante), les données de navigation ne sont pas effacées, car l'utilisateur n'a pas causé la fermeture du navigateur en fermant toutes ses fenêtres.";
ClipboardAllowedForUrls.pfm_title = "Autoriser le presse-papiers sur ces sites";
ClipboardAllowedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites peuvent utiliser l'autorisation d'accéder au presse-papiers. Cette règle n'affecte pas la totalité des opérations dont la provenance correspond à ces formats. Par exemple, il restera possible d'utiliser le raccourci clavier pour coller, cette opération n'étant pas contrôlée par l'autorisation d'utiliser le presse-papiers.\n\n\nSi cette règle n'est pas configurée, la règle DefaultClipboardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
ClipboardBlockedForUrls.pfm_title = "Bloquer le presse-papiers sur ces sites";
ClipboardBlockedForUrls.pfm_description = "Permet de lister les formats d'URL indiquant quels sites ne peuvent pas utiliser l'autorisation d'accès au presse-papiers. Cette règle n'affecte pas la totalité des opérations dont la provenance correspond à ces formats. Par exemple, il restera possible d'utiliser le raccourci clavier pour coller, cette opération n'étant pas contrôlée par l'autorisation d'utiliser le presse-papiers.\n\nSi cette règle n'est pas configurée, la règle DefaultClipboardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
CloudManagementEnrollmentMandatory.pfm_title = "Activer l'inscription obligatoire à la gestion cloud";
CloudManagementEnrollmentMandatory.pfm_description = "Si cette règle est activée, l'enregistrement du navigateur à Chrome Enterprise Core est obligatoire. En cas d'échec, le processus de lancement de Brave est bloqué.\n\nSi cette règle est désactivée ou si elle n'est pas configurée, l'enregistrement du navigateur à Chrome Enterprise Core est facultatif. En cas d'échec, le processus de lancement de Brave n'est pas bloqué.\n\nCette règle est utilisée pour l'enregistrement de la règle cloud s'appliquant aux ordinateurs de bureau. Pour en savoir plus, consultez https://support.google.com/chrome/a/answer/9301891.";
CloudManagementEnrollmentToken.pfm_title = "Jeton d'enregistrement des règles relatives au cloud";
CloudManagementEnrollmentToken.pfm_description = "Si cette règle est configurée, Brave tente de s'enregistrer auprès de la gestion des navigateurs Chrome Enterprise Core. Elle a pour valeur un jeton d'inscription que vous pouvez récupérer dans la Google Admin console.\n\nPour en savoir plus, consultez https://support.google.com/chrome/a/answer/9301891.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "Les règles relatives au cloud de Brave sont prioritaires sur les règles relatives à la plate-forme.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Si cette règle est activée, la règle cloud prévaut en cas de conflit avec la règle de plate-forme.\n\nSi cette règle est désactivée ou si elle n'est pas configurée, la règle de plate-forme prévaut en cas de conflit avec la règle cloud.\n\nCette règle obligatoire a une incidence sur les règles cloud s'appliquant à l'ordinateur.\n\nCette règle est spécifique à Brave et n'affecte pas Google Update, car ce sont des applications indépendantes.\nGoogle Update comporte une règle distincte portant le même nom.";
CloudUserPolicyMerge.pfm_title = "Permet de fusionner les règles cloud utilisateurs avec les règles au niveau des machines.";
CloudUserPolicyMerge.pfm_description = "Si cette règle est activée, les règles associées à un compte géré sont autorisées à fusionner avec des règles au niveau de l'ordinateur.\n\nSi cette règle est désactivée ou si elle n'est pas configurée, les règles cloud utilisateur ne peuvent pas être fusionnées avec les règles provenant d'autres sources.\n\nSeules les règles provenant d'utilisateurs sécurisés peuvent être prioritaires. Un utilisateur sécurisé est affilié à une organisation qui gère son navigateur en utilisant Chrome Enterprise Core. Toutes les autres règles utilisateur prévalent par défaut.\n\nLes règles à fusionner doivent aussi être définies dans PolicyListMultipleSourceMergeList ou PolicyDictionaryMultipleSourceMergeList. Cette règle sera ignorée si aucune des règles mentionnées ci-dessus n'est configurée.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Autoriser les règles cloud utilisateur à ignorer les règles Chrome Browser Cloud Management.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Si cette règle est activée, les règles associées à un compte géré prévalent en cas de conflit avec les règles de navigateur Chrome Enterprise Core.\n\nSi cette règle est désactivée ou si elle n'est pas configurée, les règles cloud utilisateur prévalent par défaut.\n\nSeules les règles provenant d'utilisateurs sécurisés peuvent être prioritaires. Un utilisateur sécurisé est affilié à une organisation qui gère son navigateur en utilisant Chrome Enterprise Core. Toutes les autres règles utilisateur prévalent par défaut.\n\nCette règle peut être combinée avec CloudPolicyOverridesPlatformPolicy. Si les deux règles sont activées, les règles cloud utilisateur prévalent aussi sur les règles de la plate-forme en conflit.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Activer les alertes de sécurité pour les indicateurs de ligne de commande.";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Si cette règle est activée ou n'est pas configurée, des avertissements de sécurité s'affichent lorsque des flags de ligne de commande potentiellement dangereux sont utilisés pour lancer Chrome.\n\nSi cette règle est désactivée, ces avertissements ne s'affichent pas quand Chrome est lancé à l'aide de flags de ligne de commande potentiellement dangereux.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
ComponentUpdatesEnabled.pfm_title = "Activer la mise à jour des composants de Brave";
ComponentUpdatesEnabled.pfm_description = "Active la mise à jour de tous les composants de Brave si la règle n'est pas configurée ou qu'elle est activée.\n\nSi elle est désactivée, la mise à jour des composants l'est aussi. Toutefois, certains composants échappent à cette règle : les mises à jour des composants sans code exécutable et qui sont essentiels à la sécurité du navigateur ne seront pas désactivées.\nCes composants peuvent inclure les listes de révocation de certificats et les filtres de sous-ressource.";
CompressionDictionaryTransportEnabled.pfm_title = "Activer la prise en charge de la compression par dictionnaire";
CompressionDictionaryTransportEnabled.pfm_description = "Cette fonctionnalité permet d'utiliser des encodages de contenu spécifiques au dictionnaire dans l'en-tête de requête Accept-Encoding (\"sbr\" et \"zst-d\") lorsque des dictionnaires sont disponibles.\n\nSi cette règle est activée ou qu'elle n'est pas configurée, Brave accepte les contenus Web qui utilisent la fonctionnalité de transport de compression par dictionnaire.\nSi elle est désactivée, la fonctionnalité de transport de compression par dictionnaire est désactivée.";
CookiesAllowedForUrls.pfm_title = "Autoriser les cookies sur ces sites";
CookiesAllowedForUrls.pfm_description = "Permet de lister les formats d'URL pour lesquels les sites sont autorisés à placer des cookies.\n\nLes formats d'URL peuvent correspondre à une URL unique, indiquant que le site peut utiliser des cookies sur tous les sites de premier niveau.\n\nLes formats peuvent aussi être constitués de deux URL séparées par une virgule. La première correspond à celle du site qui doit être autorisé à utiliser des cookies. La seconde est celle du site de premier niveau auquel la première valeur doit être appliquée.\n\nSi vous utilisez une paire d'URL, la première valeur de la paire accepte le caractère *, mais pas la seconde. Si vous vous servez de * pour la première valeur, cela signifie que tous les sites peuvent utiliser des cookies lorsque la seconde URL est celle du site de premier niveau.\n\nSi cette règle n'est pas configurée, la valeur globale par défaut est utilisée pour tous les sites à partir des règles DefaultCookiesSetting ou BlockThirdPartyCookies si celles-ci sont définies, ou à défaut, à partir de la configuration personnelle de l'utilisateur.\n\nConsultez aussi les règles CookiesBlockedForUrls et CookiesSessionOnlyForUrls. Notez que les formats d'URL définis dans ces trois règles ne doivent pas entrer en conflit. Il n'est pas précisé quelle règle prévaut en cas de conflit.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
CookiesBlockedForUrls.pfm_title = "Bloquer les cookies sur ces sites";
CookiesBlockedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites ne peuvent pas placer de cookies.\n\nSi cette règle n'est pas configurée, la règle DefaultCookiesSetting est utilisée pour tous les sites (à condition qu'elle soit configurée). Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nMême si aucune règle spécifique ne prévaut, consultez les règles CookiesAllowedForUrls et CookiesSessionOnlyForUrls. Les formats d'URL parmi ces trois règles ne doivent pas être en conflit.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
CookiesSessionOnlyForUrls.pfm_title = "Limiter les cookies des URL correspondantes à la session en cours";
CookiesSessionOnlyForUrls.pfm_description = "La règle CookiesSessionOnlyForUrls vous permet de lister les formats d'URL pour lesquels les sites sont autorisés ou non à placer des cookies lors d'une session, à moins que la règle RestoreOnStartup soit définie pour restaurer définitivement les URL des sessions précédentes.\n\nSi cette règle n'est pas configurée, la règle DefaultCookiesSetting est utilisée pour tous les sites (à condition qu'elle soit configurée). Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique. Si le format d'URL concerné ne figure pas dans la liste établie, le paramètre par défaut est utilisé.\n\nLorsqu'aucune règle spécifique ne prévaut, consultez CookiesBlockedForUrls et CookiesAllowedForUrls. Les formats d'URL parmi ces trois règles ne doivent pas être en conflit.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
CpuPerformanceTierOverride.pfm_title = "Remplacement du niveau de performances du processeur";
CpuPerformanceTierOverride.pfm_description = "La définition de cette règle permet aux entreprises de remplacer la valeur renvoyée par l‘CPU Performance API (c'est-à-dire navigator.cpuPerformance). Veuillez consulter https://github.com/WICG/cpu-performance pour en savoir plus.\n\nSi cette règle est configurée, la valeur de navigator.cpuPerformance est remplacée par la valeur spécifiée. Si la règle n'est pas définie, le calcul du niveau de performances par défaut est utilisé.\n\nLes valeurs possibles pour cette règle sont comprises entre 0 et 4.";
CreatePasskeysInICloudKeychain.pfm_title = "Contrôler si la création de clés d'accès se fera par défaut dans le trousseau iCloud.";
CreatePasskeysInICloudKeychain.pfm_description = "Brave peut diriger les requêtes de création de clé d'accès/WebAuthn directement vers le trousseau iCloud sous macOS 13.5 ou version ultérieure. Si la synchronisation du trousseau iCloud n'a pas encore été activée, l'utilisateur sera invité à se connecter avec iCloud ou, peut-être, à activer la synchronisation du trousseau iCloud.\n\nSi cette règle est définie sur \"False\", le trousseau iCloud n'est pas utilisé par défaut, mais le comportement précédent (la création des identifiants dans le profil Brave) peut être utilisé à la place. Les utilisateurs pourront toujours sélectionner l'option \"Trousseau iCloud\", et ils sont susceptibles de voir les identifiants du trousseau iCloud lors de la connexion.\n\nSi cette règle est définie sur \"True\", le trousseau iCloud est utilisé par défaut chaque fois que la requête WebAuthn est compatible avec ce choix.\n\nSi cette règle n'est pas définie, la valeur par défaut dépend de divers facteurs, par exemple si iCloud Drive est activé ou non, et si l'utilisateur a récemment utilisé ou créé des identifiants dans son profil Brave.";
CreateThemesSettings.pfm_title = "Paramètres de Créer des thèmes avec l'IA";
CreateThemesSettings.pfm_description = "0 - Autoriser Créer des thèmes avec l'IA et améliorer les modèles d'IA.\n1 - Autoriser Créer des thèmes avec l'IA sans améliorer les modèles d'IA.\n2 - Ne pas autoriser Créer des thèmes avec l'IA.\nCréer des thèmes avec l'IA permet aux utilisateurs de créer des thèmes/fonds d'écran personnalisés en présélectionnant des options depuis une liste.\n\n0 = Permettre d'utiliser la fonctionnalité tout en autorisant Google à utiliser des données pertinentes pour améliorer ses modèles d'IA. Selon la fonctionnalité, les données pertinentes peuvent inclure des prompts, des entrées, des sorties, des documents source et des commentaires écrits. Elles pourront également être examinées par des réviseurs humains dans le seul but d'améliorer les modèles d'IA. 0 est la valeur par défaut, sauf pour les exceptions ci-dessous.\n\n1 = Permettre d'utiliser la fonctionnalité, mais ne pas autoriser Google à améliorer ses modèles à l'aide du contenu des utilisateurs (y compris les prompts, les entrées, les sorties, les documents source et les commentaires écrits). 1 est la valeur par défaut pour les utilisateurs de la version Enterprise gérés par Google Admin console et pour les comptes Education gérés par Google Workspace.\n\n2 = Ne pas autoriser la fonctionnalité.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
DNSInterceptionChecksEnabled.pfm_title = "Contrôles d'interception des requêtes DNS activés";
DNSInterceptionChecksEnabled.pfm_description = "Cette règle configure un interrupteur local pouvant être utilisé pour désactiver les contrôles d'interception des requêtes DNS. Ces contrôles ont pour but de déterminer si le navigateur est situé derrière un proxy qui redirige les noms d'hôte inconnus.\n\nIls ne sont pas forcément nécessaires dans un environnement d'entreprise où la configuration réseau est connue, car cela engendre un certain volume de trafic DNS et HTTP au démarrage, et chaque fois que la configuration DNS change.\n\nSi cette règle n'est pas configurée ou qu'elle est activée, les contrôles d'interception des requêtes DNS ont lieu. Si elle est explicitement désactivée, les contrôles n'ont pas lieu.";
DataURLWhitespacePreservationEnabled.pfm_title = "Conservation des espaces blancs dans les URL de données pour tous les types de contenus";
DataURLWhitespacePreservationEnabled.pfm_description = "Cette règle permet de désactiver temporairement les modifications apportées à la façon dont Chrome traite les espaces blancs dans les URL de data.\nAuparavant, les espaces blancs n'étaient conservés que si le type de contenu de niveau supérieur était text ou qu'il contenait la chaîne de type de contenu xml.\nLes espaces blancs sont désormais conservés dans toutes les URL de données, quel que soit le type de contenu.\n\nSi cette règle n'est pas configurée ou qu'elle est définie sur \"True\", le nouveau comportement est activé.\n\nSi elle est définie sur \"False\", l'ancien comportement est activé.";
DataUrlInSvgUseEnabled.pfm_title = "Prise en charge de l'URL des données pour SVGUseElement.";
DataUrlInSvgUseEnabled.pfm_description = "Cette règle permet la prise en charge des URL de données avec SVGUseElement, qui sera désactivée par défaut à partir de M119.\nSi cette règle est activée, les URL de données continuent de fonctionner dans SVGUseElement.\nSi cette règle est désactivée ou n'est pas configurée, les URL de données ne fonctionnent pas dans SVGUseElement.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Activer les origines opaques pour les URL de données dans les scripts Web Worker";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Détermine si les scripts Web Worker créés à partir d'URL de données se voient attribuer une origine opaque unique.\n\nIls peuvent être créés à l'aide d'une URL de données contenant le script du Worker. Auparavant, ces scripts héritaient de l'origine de la page qui les avait créés, ce qui leur permettait d'accéder au même stockage local, aux mêmes cookies et à d'autres données liées à l'origine. Pour améliorer la sécurité et respecter la spécification HTML, Chrome modifie son comportement par défaut dans la version 149 afin que les scripts créés à partir d'URL de données aient désormais une origine unique et opaque. Cela les isole des données issues de la page du créateur.\n\nSi cette règle est activée ou n'est pas configurée, le nouveau comportement par défaut (plus sécurisé) est utilisé, et les scripts Web Worker créés à partir d'URL de données ont une origine opaque unique.\n\nSi cette règle est désactivée, Chrome rétablit l'ancien comportement et les scripts Web Worker créés à partir d'URL de données héritent de l'origine de leur créateur. Cela permet aux administrateurs de résoudre temporairement les problèmes de compatibilité si les applications internes ne fonctionnent plus en raison des modifications de la sécurité.\n\nCette règle est provisoire et sera supprimée dans la version 157.";
DefaultAutomaticDownloadsSetting.pfm_title = "Paramètre des téléchargements automatiques par défaut";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Autoriser les sites à télécharger automatiquement plusieurs fichiers\n2 - N'autoriser aucun site à télécharger automatiquement plusieurs fichiers\n3 - Demander l'autorisation chaque fois qu'un site veut télécharger automatiquement plusieurs fichiers\nSi cette règle est définie sur \"1\", les sites Web peuvent télécharger automatiquement plusieurs fichiers. Si cette règle est définie sur \"2\", cette autorisation est refusée. Vous pouvez définir cette règle afin qu'un site Web demande systématiquement l'autorisation de télécharger automatiquement plusieurs fichiers.\n\nSi cette règle n'est pas configurée, la règle AskAutomaticDownloads s'applique. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Définir Brave comme navigateur par défaut";
DefaultBrowserSettingEnabled.pfm_description = "Si cette règle est définie sur \"True\", Brave vérifie toujours au démarrage s'il est le navigateur par défaut et, si possible, s'enregistre automatiquement. Si cette règle est définie sur \"False\", Brave ne vérifie jamais s'il est le navigateur par défaut et désactive les commandes utilisateur concernant cette option.\n\nSi cette règle n'est pas configurée, les utilisateurs peuvent contrôler si Brave est le navigateur par défaut et, dans le cas contraire, si une notification doit être affichée pour les en informer.\n\nRemarque (pour les administrateurs Microsoft®Windows®) : Ce paramètre ne peut être activé que pour les ordinateurs sous Windows 7. Pour les versions ultérieures, vous devez déployer un fichier d'associations d'applications par défaut qui définisse Brave comme le gestionnaire des protocoles https et http (et éventuellement du protocole ftp ainsi que d'autres formats de fichiers). Pour en savoir plus, consultez l'aide de Chrome à l'adresse https://support.google.com/chrome?p=make_chrome_default_win.";
DefaultClipboardSetting.pfm_title = "Paramètre de presse-papiers par défaut";
DefaultClipboardSetting.pfm_description = "2 - Interdire à tous les sites d'utiliser l'autorisation d'accès au presse-papiers\n3 - Autoriser les sites à demander aux utilisateurs l'accès au presse-papiers\nSi cette règle est définie sur \"2\", les sites ne sont jamais autorisés à utiliser le presse-papiers. Si cette règle est définie sur \"3\", les utilisateurs peuvent modifier ce paramètre et décider si les API de presse-papier sont accessibles aux sites souhaitant en utiliser une.\n\nPour les formats d'URL spécifiques, cette règle peut être remplacée par les règles ClipboardAllowedForUrls et ClipboardBlockedForUrls.\n\nCette règle affecte uniquement les opérations contrôlées par l'autorisation accordée à un site d'utiliser le presse-papiers. Elle n'affecte pas les écritures nettoyées dans le presse-papiers ni les opérations copier et coller sécurisées.";
DefaultCookiesSetting.pfm_title = "Paramètre de cookies par défaut";
DefaultCookiesSetting.pfm_description = "1 - Autoriser tous les sites à définir des données locales\n2 - Interdire à tous les sites de définir des données locales\n4 - Conserver les cookies pendant toute la durée de la session\nLa règle CookiesSessionOnlyForUrls vous permet de dresser la liste des formats d'URL indiquant les sites autorisés ou non à placer des cookies lors d'une session, à moins que la règle RestoreOnStartup soit définie pour restaurer définitivement les URL des sessions précédentes.\n\nSi cette règle n'est pas configurée, DefaultCookiesSetting est utilisé pour tous les sites (si configuré). Sinon, le paramètre défini par l'utilisateur s'applique. Si le format d'URL concerné ne figure pas dans la liste établie, le paramètre par défaut est utilisé.\n\nLorsqu'aucune règle spécifique ne prévaut, consultez CookiesBlockedForUrls et CookiesAllowedForUrls. Les formats d'URL entre ces trois règles ne doivent pas être en conflit.";
DefaultDownloadDirectory.pfm_title = "Définir le répertoire de téléchargement par défaut";
DefaultDownloadDirectory.pfm_description = "Cette règle définit le répertoire par défaut utilisé par Chrome pour le téléchargement de fichiers, mais permet aux utilisateurs d'indiquer un autre emplacement.\n\nSi cette règle n'est pas configurée, Chrome utilise le répertoire par défaut correspondant à la plate-forme.\n\nCette règle n'a aucun effet si la règle DownloadDirectory est définie.\n\nRemarque : Pour savoir quelles variables vous pouvez utiliser, consultez la page https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DefaultFileSystemReadGuardSetting.pfm_title = "Contrôler l'utilisation de l'API File System pour l'accès en lecture";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - Interdire à tous les sites de demander l'accès en lecture aux fichiers et répertoires via l'API File System\n3 - Autoriser les sites à demander aux utilisateurs l'accès en lecture aux fichiers et répertoires via l'API File System\nSi cette règle est définie sur \"3\", les sites Web peuvent demander l'accès en lecture aux fichiers et répertoires qui figurent dans le système de fichiers du système d'exploitation hôte via l'API File System. Si cette règle est définie sur \"2\", l'accès est refusé.\n\nSi cette règle n'est pas configurée, les sites Web peuvent demander l'accès. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Contrôler l'utilisation de l'API File System pour l'accès en écriture";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - Interdire à tous les sites de demander l'accès en écriture aux fichiers et répertoires\n3 - Autoriser les sites à demander aux utilisateurs l'accès en écriture aux fichiers et répertoires\nSi cette règle est définie sur \"3\", les sites Web peuvent demander l'accès en écriture aux fichiers et répertoires qui figurent dans le système de fichiers du système d'exploitation hôte. Si cette règle est définie sur \"2\", l'accès est refusé.\n\nSi cette règle n'est pas configurée, les sites Web peuvent demander l'accès. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultGeolocationSetting.pfm_title = "Paramètre de géolocalisation par défaut";
DefaultGeolocationSetting.pfm_description = "1 - Autoriser les sites à suivre la position géographique des utilisateurs\n2 - Interdire à tous les sites de suivre la position géographique des utilisateurs\n3 - Demander chaque fois qu'un site veut suivre la position géographique des utilisateurs\nSi cette règle est définie sur \"1\", les sites peuvent suivre la position géographique des utilisateurs (état par défaut). Si cette règle est définie sur \"2\", les sites ne sont pas autorisés à suivre la position par défaut. Vous pouvez définir cette règle de façon qu'un site demande systématiquement l'autorisation de suivre la position des utilisateurs.\n\nSi cette règle n'est pas configurée, la règle AskGeolocation s'applique. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultIdleDetectionSetting.pfm_title = "Détection d'inactivité";
DefaultIdleDetectionSetting.pfm_description = "1 - Autoriser les sites à détecter l'état d'inactivité sans demander l'autorisation de l'utilisateur\n2 - Interdire à tous les sites de détecter l'état d'inactivité de l'utilisateur\n3 - Demander chaque fois qu'un site souhaite détecter l'état d'inactivité de l'utilisateur\nPermet de définir si les sites Web sont autorisés à utiliser l'API Idle Detection.\n\nSi cette règle est définie sur \"1 - AllowIdleDetection\", les sites Web peuvent utiliser l'API sans demander l'autorisation de l'utilisateur.\n\nSi cette règle est définie sur 2 : BlockIdleDetection, les sites Web ne peuvent pas utiliser l'API, même si l'utilisateur a donné son autorisation.\n\nSi cette règle est définie sur \"3 - AskIdleDetection\" ou n'est pas configurée, les sites Web ne peuvent pas utiliser l'API sans l'autorisation de l'utilisateur.";
DefaultImagesSetting.pfm_title = "Paramètres d'images par défaut";
DefaultImagesSetting.pfm_description = "1 - Autoriser tous les sites à afficher toutes les images\n2 - Interdire à tous les sites d'afficher des images\nSi cette règle est définie sur \"1\", tous les sites Web peuvent afficher des images. Si cette règle est définie sur \"2\", les sites ne sont pas autorisés à afficher d'images.\n\nSi cette règle n'est pas configurée, l'affichage d'images est autorisé, mais les utilisateurs peuvent modifier ce paramètre.";
DefaultInsecureContentSetting.pfm_title = "Contrôler l'utilisation des exceptions liées au contenu non sécurisé";
DefaultInsecureContentSetting.pfm_description = "2 - Interdire à tous les sites de charger un contenu mixte\n3 - Autoriser les utilisateurs à ajouter des exceptions afin de permettre l'affichage de contenu mixte\nPermet de définir si les utilisateurs peuvent ajouter ou non des exceptions qui autorisent l'affichage de contenu mixte sur des sites spécifiques.\n\nPour les formats d'URL spécifiques, les règles \"InsecureContentAllowedForUrls\" et \"InsecureContentBlockedForUrls\" peuvent être utilisées à la place de cette règle.\n\nSi cette règle n'est pas configurée, les utilisateurs peuvent ajouter des exceptions qui autorisent l'affichage de contenu mixte blocable, et désactiver les mises à niveau automatiques pour le contenu mixte blocable en option.";
DefaultJavaScriptJitSetting.pfm_title = "Contrôler l'utilisation du JIT pour JavaScript";
DefaultJavaScriptJitSetting.pfm_description = "1 - Autoriser tous les sites à exécuter le JIT pour JavaScript\n2 - Interdire à tous les sites d'exécuter le JIT pour JavaScript\nPermet de définir si Brave exécutera le moteur JavaScript V8 avec le compilateur JIT (Just In Time, juste à temps) activé ou non.\n\nSi le JIT pour JavaScript est désactivé, Brave peut afficher le contenu Web plus lentement et aussi désactiver des parties de JavaScript, y compris WebAssembly. Cette désactivation peut également permettre à Brave d'afficher le contenu Web dans une configuration plus sûre.\n\nPour les formats d'URL spécifiques, cette règle peut être remplacée par les règles JavaScriptJitAllowedForSites et JavaScriptJitBlockedForSites.\n\nSi cette règle n'est pas configurée, le JIT pour JavaScript est activé.";
DefaultJavaScriptOptimizerSetting.pfm_title = "Contrôler l'utilisation des optimiseurs JavaScript";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Activer les optimisations JavaScript avancées sur tous les sites\n2 - Désactiver les optimisations JavaScript avancées sur tous les sites\nPermet de définir si Brave exécutera le moteur JavaScript V8 avec des optimisations JavaScript plus avancées activées.\n\nSi vous désactivez les optimisations JavaScript (en définissant la valeur de cette règle sur 2), Brave peut afficher le contenu Web plus lentement.\n\nPour les formats d'URL spécifiques, cette règle peut être remplacée par les règles JavaScriptOptimizerAllowedForSites et JavaScriptOptimizerBlockedForSites.\n\nSi cette règle n'est pas configurée, les optimisations JavaScript sont activées.";
DefaultJavaScriptSetting.pfm_title = "Paramètre JavaScript par défaut";
DefaultJavaScriptSetting.pfm_description = "1 - Autoriser tous les sites à exécuter JavaScript\n2 - Interdire à tous les sites d'exécuter JavaScript\nSi cette règle est définie sur \"1\", les sites Web peuvent exécuter JavaScript. Si cette règle est définie sur \"2\", les sites ne sont pas autorisés à exécuter ce langage.\n\nSi cette règle n'est pas configurée, les sites peuvent exécuter JavaScript. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultLocalFontsSetting.pfm_title = "Paramètres de l'autorisation des polices locales par défaut";
DefaultLocalFontsSetting.pfm_description = "2 - Par défaut, refuse l'autorisation d'utiliser des polices locales pour tous les sites\n3 - Demander chaque fois qu'un site souhaite obtenir l'autorisation d'utiliser des polices locales\nSi cette règle est définie sur BlockLocalFonts (valeur 2), l'autorisation d'utiliser des polices locales est par défaut automatiquement refusée aux sites. Cela limite la capacité des sites à voir les informations sur les polices locales.\n\nSi cette règle est définie sur AskLocalFonts (valeur 3), l'utilisateur reçoit par défaut une invite lorsque l'autorisation d'utiliser des polices locales est demandée. Si les utilisateurs accordent l'autorisation, cela étend la capacité des sites à voir les informations sur les polices locales.\n\nSi cette règle n'est pas configurée, le comportement par défaut (invite envoyée à l'utilisateur) s'applique. Les utilisateurs peuvent toutefois modifier ce paramètre.";
DefaultNotificationsSetting.pfm_title = "Paramètre de notification par défaut";
DefaultNotificationsSetting.pfm_description = "1 - Autoriser les sites à afficher des notifications sur le bureau\n2 - Interdire à tous les sites d'afficher des notifications sur le bureau\n3 - Demander confirmation chaque fois qu'un site veut afficher des notifications sur le bureau\nSi cette règle est définie sur \"1\", les sites Web peuvent afficher des notifications sur le bureau. Si cette règle est définie sur \"2\", les sites ne sont pas autorisés à afficher ces notifications.\n\nSi cette règle n'est pas configurée, la règle AskNotifications s'applique. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultPopupsSetting.pfm_title = "Paramètre de pop-up par défaut";
DefaultPopupsSetting.pfm_description = "1 - Autoriser tous les sites à afficher des fenêtres pop-up\n2 - Interdire à tous les sites d'afficher des pop-up\nSi cette règle est définie sur \"1\", les sites Web peuvent afficher des pop-ups. Si cette règle est définie sur \"2\", les sites ne sont pas autorisés à afficher de pop-ups.\n\nSi cette règle n'est pas configurée, la règle BlockPopups s'applique. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultPrinterSelection.pfm_title = "Instructions de sélection de l'imprimante par défaut";
DefaultPrinterSelection.pfm_description = "Cette règle permet de définir les règles de sélection de l'imprimante par défaut dans Brave, ignorant ainsi les règles par défaut. La sélection de l'imprimante est effectuée la première fois que l'utilisateur lance une impression, lorsque Brave cherche une imprimante correspondant aux attributs spécifiés. Si la correspondance n'est pas parfaite, Brave peut être configuré de manière à sélectionner toute imprimante correspondante, selon l'ordre dans lequel les imprimantes sont découvertes.\n\nSi cette règle n'est pas configurée ou qu'elle est définie sur des attributs pour lesquels il n'existe aucune correspondance, l'imprimante PDF intégrée est sélectionnée par défaut. En l'absence d'imprimante PDF, la valeur par défaut de Brave est \"Aucun\".\n\nActuellement, toutes les imprimantes sont considérées comme étant de type \"local\". Les imprimantes connectées à Google Cloud Print sont considérées comme étant de type \"cloud\", mais Google Cloud Print n'est plus compatible.\n\nRemarque : Si vous ne renseignez pas un champ, toutes les valeurs seront prises en compte pour ce champ. Par exemple, si vous ne spécifiez pas idPattern, l'aperçu avant impression acceptera tous les ID d'imprimante. Les structures d'expressions régulières doivent suivre la syntaxe JavaScript RegExp, et les correspondances sont sensibles à la casse.\nConsultez la page https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection pour en savoir plus sur le schéma et le formatage.";
DefaultSearchProviderAlternateURLs.pfm_title = "Liste d'URL alternatives pour le moteur de recherche par défaut";
DefaultSearchProviderAlternateURLs.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderAlternateURLs vous permet d'établir la liste des URL alternatives pour extraire des termes de recherche du moteur de recherche. Ces URL doivent inclure la chaîne '{searchTerms}'.\n\nSi la règle DefaultSearchProviderAlternateURLs n'est pas configurée, aucune URL alternative n'est utilisée pour extraire les termes de recherche.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Autoriser l'accès par défaut au menu contextuel du moteur de recherche";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "Permet d'utiliser un moteur de recherche par défaut dans le menu contextuel.\n\nSi vous désactivez cette règle, l'élément de menu contextuel de recherche qui dépend de votre moteur de recherche par défaut ne sera pas disponible.\n\nSi cette règle est activée ou si elle n'est pas configurée, l'élément de menu contextuel de votre moteur de recherche par défaut sera disponible.\n\nLa valeur de la règle ne s'applique que si la règle DefaultSearchProviderEnabled est activée, et pas autrement.";
DefaultSearchProviderEnabled.pfm_title = "Activer le moteur de recherche par défaut";
DefaultSearchProviderEnabled.pfm_description = "Si cette règle est activée et que l'utilisateur saisit autre chose qu'une URL dans la barre d'adresse, une recherche est alors lancée par défaut. Pour spécifier le moteur de recherche par défaut, définissez le reste des règles de recherche par défaut. Si vous ne configurez pas ces règles, l'utilisateur peut choisir le moteur par défaut. Si cette règle est désactivée et que l'utilisateur saisit autre chose qu'une URL dans la barre d'adresse, aucune recherche n'est lancée. La Google Admin console ne prend pas en charge la valeur \"Désactivé\".\n\nSi cette règle est configurée, les utilisateurs ne peuvent pas la modifier dans Brave. Si cette règle n'est pas configurée, le moteur de recherche par défaut est activé, et les utilisateurs peuvent configurer la liste des moteurs de recherche.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
DefaultSearchProviderEncodings.pfm_title = "Codages du moteur de recherche par défaut";
DefaultSearchProviderEncodings.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderEncodings vous permet de spécifier les encodages de caractères compatibles avec le moteur de recherche. Ces encodages sont des noms de page de codes, comme UTF-8, GB2312 et ISO-8859-1, qui sont testés dans l'ordre dans lequel ils sont indiqués.\n\nSi la règle DefaultSearchProviderEncodings n'est pas configurée, l'encodage UTF-8 est alors utilisé.";
DefaultSearchProviderImageURL.pfm_title = "Paramètre qui active la fonctionnalité de recherche par image pour le moteur de recherche par défaut";
DefaultSearchProviderImageURL.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderImageURL permet de spécifier l'URL du moteur de recherche utilisé pour la recherche dans des images. (Si la règle DefaultSearchProviderImageURLPostParams est configurée, les requêtes de recherche dans des images utilisent à la place la méthode POST.)\n\nSi la règle DefaultSearchProviderImageURL n'est pas configurée, aucune recherche dans des images n'est effectuée.\n\nSi la recherche dans des images utilise la méthode get, l'URL doit spécifier des paramètres d'image\nà l'aide d'une combinaison valide des espaces réservés suivants :\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "Paramètres pour l'URL d'image utilisant POST";
DefaultSearchProviderImageURLPostParams.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderImageURLPostParams permet de définir les paramètres d'une recherche dans des images à l'aide de la méthode POST. Il s'agit de paires de noms et de valeurs séparées par une virgule. Si une valeur correspond à un paramètre modèle, comme {imageThumbnail}, elle est remplacée par des miniatures d'images réelles.\n\nSi la règle DefaultSearchProviderImageURLPostParams n'est pas configurée, la requête de recherche dans des images est envoyée à l'aide de la méthode get.\n\nL'URL doit spécifier le paramètre d'image à l'aide d'une combinaison valide des espaces réservés suivants,\nen fonction de ce que le moteur de recherche accepte :\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Mot clé du moteur de recherche par défaut";
DefaultSearchProviderKeyword.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderKeyword vous permet de spécifier le mot clé ou le raccourci utilisé dans la barre d'adresse pour déclencher la recherche avec ce moteur de recherche.\n\nSi la règle DefaultSearchProviderKeyword n'est pas configurée, aucun mot clé n'active le moteur de recherche.";
DefaultSearchProviderName.pfm_title = "Nom du moteur de recherche par défaut";
DefaultSearchProviderName.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderName vous permet de spécifier le nom du moteur de recherche par défaut.\n\nSi la règle DefaultSearchProviderName n'est pas configurée, le nom d'hôte indiqué par l'URL de recherche est utilisé.";
DefaultSearchProviderNewTabURL.pfm_title = "URL de la page Nouvel onglet du moteur de recherche par défaut";
DefaultSearchProviderNewTabURL.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderNewTabURL vous permet de spécifier l'URL du moteur de recherche utilisé pour afficher une page Nouvel onglet.\n\nSi la règle DefaultSearchProviderNewTabURL n'est pas configurée, aucune page Nouvel onglet n'est proposée.";
DefaultSearchProviderSearchURL.pfm_title = "URL de recherche du moteur de recherche par défaut";
DefaultSearchProviderSearchURL.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderSearchURL vous permet de spécifier l'URL du moteur de recherche utilisé lors d'une recherche par défaut. L'URL doit inclure la chaîne '{searchTerms}', qui sera remplacée dans la requête par les termes de recherche de l'utilisateur.\n\nVous pouvez spécifier cette URL comme suit : '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "Paramètres pour l'URL de recherche utilisant POST";
DefaultSearchProviderSearchURLPostParams.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderSearchURLPostParams vous permet de définir les paramètres d'une recherche d'URL à l'aide de la méthode POST. Il s'agit de paires de noms et de valeurs séparées par une virgule. Si une valeur correspond à un paramètre modèle, comme '{searchTerms}', elle est remplacée par des termes de recherches réels.\n\nSi la règle DefaultSearchProviderSearchURLPostParams n'est pas configurée, les requêtes de recherche sont envoyées à l'aide de la méthode GET.";
DefaultSearchProviderSuggestURL.pfm_title = "URL de suggestions de recherche du moteur de recherche par défaut";
DefaultSearchProviderSuggestURL.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderSuggestURL vous permet de spécifier l'URL du moteur de recherche pour fournir des suggestions de recherche. L'URL doit inclure la chaîne '{searchTerms}', qui sera remplacée dans la requête par les termes de recherche de l'utilisateur.\n\nVous pouvez spécifier cette URL comme suit : '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "Paramètres pour l'URL de suggestion utilisant POST";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "Si la règle DefaultSearchProviderEnabled est activée, la règle DefaultSearchProviderSuggestURLPostParams vous permet de définir les paramètres d'une recherche suggérée à l'aide de la méthode POST. Il s'agit de paires de noms et de valeurs séparées par une virgule. Si une valeur correspond à un paramètre modèle, comme '{searchTerms}', elle est remplacée par des termes de recherches réels.\n\nSi la règle DefaultSearchProviderSuggestURLPostParams n'est pas configurée, les requêtes de recherche suggérée sont envoyées à l'aide de la méthode GET.";
DefaultSensorsSetting.pfm_title = "Paramètre par défaut des capteurs";
DefaultSensorsSetting.pfm_description = "1 - Autoriser les sites à accéder aux capteurs\n2 - Interdire à tous les sites d'accéder aux capteurs\n3 - Demander chaque fois qu'un site veut accéder aux capteurs\nSi cette règle est définie sur \"1\", les sites Web peuvent accéder aux capteurs (de mouvement et de lumière, par exemple) et les utiliser. Si elle est définie sur \"2\", l'accès aux capteurs est refusé. Si elle est définie sur \"3\", l'utilisateur reçoit une invite lorsqu'un site demande l'accès aux capteurs si le flag de fonctionnalité à trois états est activé. Sinon, l'accès aux capteurs est autorisé par défaut.\n\nSi cette règle n'est pas configurée, AllowSensors s'applique. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultSerialGuardSetting.pfm_title = "Contrôler l'utilisation de l'API Serial";
DefaultSerialGuardSetting.pfm_description = "2 - Interdire à tous les sites de demander l'accès aux ports série via l'API Serial\n3 - Autoriser les sites à demander à l'utilisateur d'accorder l'accès à un port série\nSi cette règle est définie sur \"3\", les sites Web peuvent demander à accéder aux ports série. Si elle est définie sur \"2\", l'accès aux ports série est refusé.\n\nSi cette règle n'est pas configurée, les sites Web peuvent demander l'accès. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultWebBluetoothGuardSetting.pfm_title = "Contrôler l'utilisation de l'API Web Bluetooth";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - Interdire à tous les sites de demander l'accès à des appareils Bluetooth via l'API Web Bluetooth\n3 - Autoriser les sites à demander à l'utilisateur d'accorder l'accès à un appareil Bluetooth à proximité\nSi cette règle est définie sur \"3\", les sites Web peuvent demander l'accès aux appareils Bluetooth à proximité. Si cette règle est définie sur \"2\", la demande d'accès à ces appareils est refusée.\n\nSi cette règle n'est pas configurée, les sites Web peuvent demander l'accès. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultWebHidGuardSetting.pfm_title = "Contrôler l'utilisation de l'API WebHID";
DefaultWebHidGuardSetting.pfm_description = "2 - Interdire à tous les sites de demander l'accès aux appareils HID via l'API WebHID\n3 - Autoriser les sites à demander aux utilisateurs d'accorder l'accès à un appareil HID\nSi cette règle est définie sur \"3\", les sites Web peuvent demander l'accès aux appareils HID. Si cette règle est définie sur \"2\", l'accès aux appareils HID est refusé.\n\nSi cette règle n'est pas configurée, les sites Web peuvent demander l'accès. Toutefois, les utilisateurs peuvent modifier ce paramètre.\n\nPour les formats url spécifiques, cette règle peut être remplacée par les règles WebHidAskForUrls et WebHidBlockedForUrls.";
DefaultWebUsbGuardSetting.pfm_title = "Contrôler l'utilisation de l'API WebUSB";
DefaultWebUsbGuardSetting.pfm_description = "2 - Interdire à tous les sites de demander l'accès à des appareils USB via l'API WebUSB\n3 - Autoriser les sites à demander à l'utilisateur d'accorder l'accès à un appareil USB connecté\nSi cette règle est définie sur \"3\", les sites Web peuvent demander à accéder aux appareils USB connectés. Si cette règle est définie sur \"2\", l'accès à ces appareils est refusé.\n\nSi cette règle n'est pas configurée, les sites Web peuvent demander l'accès. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
DefaultWindowManagementSetting.pfm_title = "Paramètre d'autorisation par défaut de la gestion des fenêtres";
DefaultWindowManagementSetting.pfm_description = "2 - Refuse par défaut l'autorisation de gestion des fenêtres sur tous les sites\n3 - Demander chaque fois qu'un site souhaite obtenir l'autorisation de gestion des fenêtres\nSi cette règle est définie sur BlockWindowManagement (valeur 2), l'autorisation de gestion des fenêtres est par défaut automatiquement refusée aux sites. Cela limite la capacité des sites à voir les informations concernant les écrans de l'appareil, ainsi qu'à utiliser ces informations pour ouvrir et positionner des fenêtres, ou demander le passage en plein écran sur certains écrans.\n\nSi cette règle est définie sur AskWindowManagement (valeur 3), l'utilisateur reçoit par défaut une invite lorsque l'autorisation de gestion des fenêtres est demandée. Si les utilisateurs accordent l'autorisation, cela étend la capacité des sites à voir les informations concernant les écrans de l'appareil, ainsi qu'à utiliser ces informations pour ouvrir et positionner des fenêtres, ou demander le passage en plein écran sur certains écrans.\n\nSi cette règle n'est pas définie, la règle AskWindowManagement s'applique. Toutefois, les utilisateurs peuvent modifier ce paramètre.\n\nCette règle remplace la règle DefaultWindowPlacementSetting, obsolète.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Activer la suppression des mots de passe indéchiffrables";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Cette règle détermine si le gestionnaire de mots de passe intégré peut ou non supprimer les mots de passe indéchiffrables de sa base de données. C'est nécessaire pour restaurer toutes les fonctionnalités de ce gestionnaire, mais cela peut entraîner une perte de données définitive. Les valeurs de mots de passe indéchiffrables ne deviendront pas déchiffrables d'elles-mêmes. S'il est possible de les corriger, cela nécessite généralement des actions complexes de la part des utilisateurs.\n\nSi cette règle est activée ou qu'elle n'est pas configurée, les utilisateurs qui ont des mots de passe indéchiffrables enregistrés dans le gestionnaire de mots de passe intégré les perdront. Cela ne concerne pas les mots de passe toujours opérationnels.\n\nSi cette règle est désactivée, les données du gestionnaire de mots de passe seront inchangées, mais les fonctionnalités du gestionnaire seront interrompues.\n\nSi cette règle est configurée, les utilisateurs ne peuvent pas la modifier dans Brave.";
DesktopSharingHubEnabled.pfm_title = "Activer le partage du bureau dans l'omnibox et le menu à trois points";
DesktopSharingHubEnabled.pfm_description = "Si cette règle est définie sur \"True\" ou si elle n'est pas configurée, les utilisateurs peuvent partager ou enregistrer la page Web actuelle à l'aide d'actions réalisables dans le hub de partage du bureau. Le hub de partage est accessible via l'icône de l'omnibox ou le menu à trois points.\n\nSi la règle est définie sur \"False\", l'icône de partage est supprimée de l'omnibox et l'entrée est supprimée du menu à trois points.";
DevToolsGenAiSettings.pfm_title = "Paramètres des fonctionnalités d'IA générative des Chrome DevTools";
DevToolsGenAiSettings.pfm_description = "0 - Autoriser les fonctionnalités d'IA générative des Chrome DevTools et améliorer les modèles d'IA.\n1 - Autoriser les fonctionnalités d'IA générative des Chrome DevTools sans améliorer les modèles d'IA.\n2 - Ne pas autoriser les fonctionnalités d'IA générative des Chrome DevTools\nCes fonctionnalités des Chrome DevTools utilisent des modèles d'IA générative pour fournir des informations de débogage supplémentaires. Pour utiliser ces fonctionnalités, Brave doit collecter des données telles que les messages d'erreur, les traces de la pile, les extraits de code et les requêtes réseau, puis les envoyer à un serveur de Google qui exécute un modèle d'IA générative. Le corps de la réponse ou les en-têtes d'authentification et de cookies dans les requêtes réseau ne sont pas inclus dans les données envoyées au serveur.\n\n0 = Permettre d'utiliser la fonctionnalité tout en autorisant Google à utiliser les données pertinentes pour améliorer ses modèles d'IA. Selon la fonctionnalité, les données pertinentes peuvent inclure des prompts, des entrées, des sorties, des sources et des retours écrits. Elles pourront également être examinées par des réviseurs humains afin d'améliorer les modèles d'IA. 0 est la valeur par défaut, sauf pour les exceptions ci-dessous.\n\n1 = Permettre d'utiliser la fonctionnalité, mais ne pas autoriser Google à améliorer ses modèles à l'aide du contenu des utilisateurs (y compris les prompts, les entrées, les sorties, les sources et les retours écrits). 1 est la valeur par défaut pour les utilisateurs de la version Enterprise gérés par Google Admin console et pour les comptes Education gérés par Google Workspace.\n\n2 = Ne pas autoriser la fonctionnalité.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nLes fonctionnalités d'IA générative des Chrome DevTools incluent les suivantes :\n\n- Console Insights : décrit les messages de la console et propose des suggestions pour corriger les erreurs dans la console.\n\n- Assistance IA : obtenez de l'aide pour mieux comprendre les styles CSS (depuis la version 131), les requêtes réseau, les performances et les fichiers (tous depuis la version 132).\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Activer les profils Google Developer Program dans Chrome DevTools";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Activer l'intégration du Google Developer Program dans Chrome DevTools.\n1 - Activer l'intégration du Google Developer Program dans Chrome DevTools, mais sans partager l'utilisation de l'outil (pour l'attribution de badges).\n2 - Ne pas activer l'intégration du Google Developer Program dans Chrome DevTools.\nCette règle contrôle l'intégration du Google Developer Program à Chrome DevTools. Le profil Google Developer Program de l'utilisateur s'affiche dans Chrome DevTools, et les utilisateurs reçoivent des badges lorsqu'ils effectuent des actions spécifiques dans Chrome DevTools.\n\nSi la règle est définie sur 0 (activée) ou si aucune valeur n'est définie pour la règle, l'intégration du Google Developer Program à Chrome DevTools est autorisée, et l'utilisation des Chrome DevTools peut être partagée afin de pouvoir attribuer des badges.\n\nSi la règle est définie sur 1 (activée sans badges), l'intégration du Google Developer Program à Chrome DevTools est autorisée, mais le partage de l'utilisation des Chrome DevTools avec le Google Developer Program ne l'est pas. Aucun badge ne sera attribué.\n\nSi la règle est définie sur 2 (désactivée), l'intégration du Google Developer Program à Chrome DevTools n'est pas autorisée.";
DeveloperToolsAvailability.pfm_title = "Gérer où les Chrome DevTools peuvent être utilisés";
DeveloperToolsAvailability.pfm_description = "0 - Interdire l'utilisation des Chrome DevTools avec les extensions intégrées au navigateur (à partir de la version 114 et s'il s'agit d'un utilisateur géré) ou avec les applis et les extensions installées conformément à une règle Enterprise. Autoriser l'utilisation des Chrome DevTools dans les autres cas.\n1 - Autoriser l'utilisation des Chrome DevTools\n2 - Interdire l'utilisation des Chrome DevTools\nSi cette règle est définie sur 0 (valeur par défaut), vous pouvez accéder aux Chrome DevTools et à la Console JavaScript, sauf dans le cas d'extensions intégrées au navigateur (à partir de la version 114 et s'il s'agit d'un utilisateur géré) ou d'extensions installées conformément à une règle Enterprise. Si cette règle est définie sur 1, vous pouvez accéder aux Chrome DevTools et à la Console JavaScript dans tous les cas, y compris si des extensions ont été installées conformément à une règle Enterprise. Si cette règle est définie sur 2, vous ne pouvez pas accéder aux Chrome DevTools ni examiner des éléments de sites Web.\n\nEn outre, les raccourcis clavier, ainsi que les options de menu ou de menu contextuel permettant d'ouvrir les Chrome DevTools ou la Console JavaScript sont désactivés.\n\nDepuis la version 99 de Brave, ce paramètre contrôle également les points d'entrée de la fonctionnalité \"Afficher le code source de la page\". Si cette règle est définie sur \"DeveloperToolsDisallowed\" (valeur 2), les utilisateurs ne peuvent pas accéder à l'affichage du code source via le raccourci clavier ou le menu contextuel. Pour empêcher complètement l'affichage du code source, vous devez également ajouter \"view-source:*\" à la règle URLBlocklist.\n\nDepuis la version 119 de Brave, ce paramètre contrôle également si le mode développeur peut être activé et utilisé pour les applications Web isolées.\n\nDepuis la version 128 de Brave, ce paramètre ne contrôle plus le mode développeur sur la page des extensions si la règle ExtensionDeveloperModeSettings est configurée.\n\nCette règle affecte les Chrome DevTools, l'accès direct au protocole Chrome DevTools (par exemple, lorsque Chrome est lancé avec --remote-debugging-port ou --remote-debugging-pipe) ainsi que l'accès à ce protocole via les API chrome.debugger. Cette règle et la règle RemoteDebuggingAllowed s'appliquent toutes les deux : RemoteDebuggingAllowed détermine si le débogage à distance peut démarrer, tandis que cette règle limite l'examen de cibles individuelles même lorsque le débogage à distance est en cours d'exécution.\n\nLes règles DeveloperToolsAvailabilityAllowlist et DeveloperToolsAvailabilityBlocklist prévalent sur cette règle. La disponibilité des Chrome DevTools est déterminée selon l'ordre de priorité suivant :\n\n1. Si une URL correspond à un format dans la règle DeveloperToolsAvailabilityAllowlist, les Chrome DevTools sont autorisés.\n2. Si la règle DeveloperToolsAvailabilityAllowlist est configurée et que la règle DeveloperToolsAvailabilityBlocklist ne l'est pas, toute URL ne figurant pas dans la liste d'autorisation est bloquée.\n3. Si une URL correspond à un format dans la règle DeveloperToolsAvailabilityBlocklist, les Chrome DevTools sont bloqués.\n4. Si aucune règle n'est configurée ou si une URL n'a de correspondance dans aucune des deux listes, la règle DeveloperToolsAvailability est utilisée comme règle de remplacement.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Liste des formats d'URL pour lesquels les Chrome DevTools peuvent être ouverts";
DeveloperToolsAvailabilityAllowlist.pfm_description = "Cette règle peut être utilisée pour autoriser les Chrome DevTools sur des URL spécifiques.\n\nLa disponibilité des Chrome DevTools est évaluée au niveau de la cible. Les formats d'URL sont mis en correspondance avec l'URL de chaque cible inspectée (par exemple, le frame principal d'une page, un sous-frame intégré, une extension ou une application Web). Le comportement qui en résulte dépend de la configuration ou non de la règle DeveloperToolsAvailabilityBlocklist.\n\nSi cette règle est configurée et que DeveloperToolsAvailabilityBlocklist ne l'est pas, l'URL d'une cible doit correspondre à un format de cette liste d'autorisation pour que les Chrome DevTools soient autorisés pour cette cible. Si l'URL d'une cible ne correspond pas à un format de cette liste d'autorisation, les Chrome DevTools seront bloqués pour cette cible (par exemple, un sous-frame dont l'URL ne figure pas dans la liste d'autorisation ne peut pas être inspecté, alors que la page principale peut l'être si son URL y figure). Pour en savoir plus sur le format d'URL, consultez https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSi cette règle et la règle DeveloperToolsAvailabilityBlocklist sont toutes deux configurées, cette liste d'autorisation prévaut. Si l'URL d'une cible correspond à un format de cette liste d'autorisation, elle est autorisée, même si elle correspond aussi à un format de la liste de blocage. Si l'URL d'une cible correspond à un format de cette liste de blocage (mais pas à un format de la liste d'autorisation), elle est bloquée. Si l'URL d'une cible ne correspond à aucun format des deux listes, la règle DeveloperToolsAvailability est utilisée comme règle de remplacement.\n\nSi cette règle n'est pas configurée, la disponibilité des Chrome DevTools est déterminée par les règles DeveloperToolsAvailabilityBlocklist et DeveloperToolsAvailability.\n\nLes caractères génériques d'hôte globaux (par exemple, \"*\" ou \"[*]\") ne sont pas autorisés. Utilisez la règle DeveloperToolsAvailability pour activer la fonctionnalité à l'échelle mondiale.\n\nCette règle affecte les Chrome DevTools, l'accès direct au protocole Chrome DevTools (par exemple, lorsque Chrome est lancé avec --remote-debugging-port ou --remote-debugging-pipe) ainsi que l'accès à ce protocole via les API chrome.debugger. Cette règle et la règle RemoteDebuggingAllowed s'appliquent toutes les deux : RemoteDebuggingAllowed détermine si le débogage à distance peut démarrer, tandis que cette règle limite l'examen de cibles individuelles même lorsque le débogage à distance est en cours d'exécution.\n\nCette règle est limitée à 1 000 entrées.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Liste des formats d'URL pour lesquels les Chrome DevTools sont bloqués";
DeveloperToolsAvailabilityBlocklist.pfm_description = "Cette règle peut être utilisée pour bloquer les Chrome DevTools sur des URL spécifiques. Pour en savoir plus sur le format d'URL, consultez https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nLa disponibilité des Chrome DevTools est évaluée au niveau de la cible. Les formats d'URL sont mis en correspondance avec l'URL de chaque cible inspectée (par exemple, le frame principal d'une page, un sous-frame intégré, une extension ou une application Web). Le comportement qui en résulte dépend de la configuration ou non de la règle DeveloperToolsAvailabilityAllowlist.\n\nSi cette règle est configurée et que DeveloperToolsAvailabilityAllowlist ne l'est pas, l'URL d'une cible correspondant à un format de cette liste de blocage bloquera les Chrome DevTools pour cette cible (par exemple, un sous-frame dont l'URL correspond à un format de cette liste de blocage ne peut pas être inspecté, alors que la page principale peut l'être si son URL ne figure pas sur la liste de blocage). Si l'URL d'une cible ne correspond à aucun format, la disponibilité est déterminée par la règle DeveloperToolsAvailability.\n\nSi cette règle et la règle DeveloperToolsAvailabilityAllowlist sont toutes deux configurées, la liste d'autorisation prévaut. Si l'URL d'une cible correspond à un format de la liste d'autorisation, elle est autorisée, même si elle correspond aussi à un format de cette liste de blocage. Si l'URL d'une cible correspond à un format de cette liste de blocage (mais pas à un format de la liste d'autorisation), elle est bloquée. Si l'URL d'une cible ne correspond à aucun format des deux listes, la règle DeveloperToolsAvailability est utilisée comme règle de remplacement.\n\nSi cette règle n'est pas configurée, la disponibilité des Chrome DevTools est déterminée par les règles DeveloperToolsAvailabilityAllowlist et DeveloperToolsAvailability.\n\nCette règle affecte les Chrome DevTools, l'accès direct au protocole Chrome DevTools (par exemple, lorsque Chrome est lancé avec --remote-debugging-port ou --remote-debugging-pipe) ainsi que l'accès à ce protocole via les API chrome.debugger. Cette règle et la règle RemoteDebuggingAllowed s'appliquent toutes les deux : RemoteDebuggingAllowed détermine si le débogage à distance peut démarrer, tandis que cette règle limite l'examen de cibles individuelles même lorsque le débogage à distance est en cours d'exécution.\n\nCette règle est limitée à 1 000 entrées.";
Disable3DAPIs.pfm_title = "Désactiver la prise en charge des API 3D graphics";
Disable3DAPIs.pfm_description = "Si cette règle est définie sur \"True\" (ou que HardwareAccelerationModeEnabled est définie sur \"False\"), les pages Web ne peuvent pas accéder à l'API WebGL.\n\nSi cette règle est définie sur \"False\" ou qu'elle n'est pas configurée, les pages Web peuvent accéder à l'API WebGL. Toutefois, il peut quand même être nécessaire d'ajouter des arguments de ligne de commande aux paramètres par défaut du navigateur pour utiliser ces API.";
DisableAuthNegotiateCnameLookup.pfm_title = "Désactiver la consultation CNAME lors de la négociation de l'authentification Kerberos";
DisableAuthNegotiateCnameLookup.pfm_description = "Si cette règle est activée, la recherche du CNAME est ignorée. Le nom du serveur est utilisé tel qu'il a été saisi lors de la génération du SPN Kerberos.\n\nSi cette règle est désactivée ou n'est pas configurée, la recherche du CNAME détermine le nom canonique du serveur lors de la génération du SPN Kerberos.";
DisablePrintPreview.pfm_title = "Désactiver l'aperçu avant impression";
DisablePrintPreview.pfm_description = "Lorsque cette règle est activée, Brave ouvre la boîte de dialogue d'impression du système au lieu de l'aperçu avant impression intégré lorsqu'un utilisateur souhaite imprimer une page.\n\nSi vous désactivez cette règle, ou si vous ne la configurez pas, les commandes d'impression génèrent un aperçu avant impression.";
DisableSafeBrowsingProceedAnyway.pfm_title = "Désactiver l'accès au site lors de l'affichage de la page d'avertissement par le service de navigation sécurisée";
DisableSafeBrowsingProceedAnyway.pfm_description = "Si cette règle est activée, les utilisateurs ne peuvent pas aller au-delà de la page d'avertissement du service de navigation sécurisée qui leur indique que le site sur lequel ils souhaitent se rendre est un site malveillant. Cette règle ne bloque les utilisateurs que si cet avertissement concerne, par exemple, un site malveillant ou d'hameçonnage, et non en cas de problème de certificat SSL (tel qu'un certificat non valide ou arrivé à expiration).\n\nSi cette règle est désactivée ou qu'elle n'est pas configurée, les utilisateurs peuvent choisir d'accéder au site malveillant signalé malgré l'avertissement affiché.\n\nPour en savoir plus sur la navigation sécurisée, consultez la page https://developers.google.com/safe-browsing.";
DisableScreenshots.pfm_title = "Désactiver les captures d'écran";
DisableScreenshots.pfm_description = "Si cette règle est activée, les utilisateurs ne peuvent pas faire de captures d'écran avec des raccourcis clavier ni avec des API d'extension. Si elle est désactivée ou qu'elle n'est pas configurée, les captures d'écran sont autorisées.\n\nÀ partir de la version 154 de Brave, l'activation de cette règle empêche également les extensions d'associer le débogueur via \"chrome.debugger.attach()\".\n\nNotez que sur Microsoft® Windows®, macOS et Linux, cela n'empêche pas d'effectuer des captures d'écran avec des applis tierces ou des applis du système d'exploitation.";
DiskCacheDir.pfm_title = "Définir le répertoire du cache disque";
DiskCacheDir.pfm_description = "Si cette règle est configurée, Brave utilise le répertoire que vous indiquez pour stocker les fichiers mis en cache sur le disque, que l'utilisateur spécifie ou non le flag \"--disk-cache-dir\".\n\nSi cette règle n'est pas configurée, Brave utilise le répertoire de cache par défaut. Toutefois, l'utilisateur peut modifier ce paramètre avec le flag de ligne de commande \"--disk-cache-dir\".\n\nBrave gère le contenu du répertoire racine d'un volume. Ainsi, pour éviter de perdre des données ou de générer d'autres erreurs, ne définissez pas cette règle sur le répertoire racine ni sur un autre répertoire utilisé à d'autres fins. Pour savoir quelles variables vous pouvez utiliser, consultez la page https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DiskCacheSize.pfm_title = "Définir la taille du cache disque";
DiskCacheSize.pfm_description = "Si cette règle est définie sur \"None\", Brave utilise la taille de cache par défaut pour stocker les fichiers mis en cache sur le disque. L'utilisateur ne peut pas la modifier.\n\nSi vous configurez cette règle, Brave utilise la taille de cache de votre choix, que l'utilisateur ait spécifié ou non le flag \"--disk-cache-size\". (Toute valeur inférieure à quelques mégaoctets est arrondie.)\n\nSi cette règle n'est pas configurée, Brave utilise la taille de cache par défaut. L'utilisateur peut modifier ce paramètre via le flag \"--disk-cache-size\".\n\nRemarque : La valeur spécifiée dans cette règle aide à optimiser divers sous-systèmes de cache dans le navigateur. La consommation totale réelle de tous les caches sur le disque sera ainsi plus élevée, mais dans le même ordre de grandeur que la valeur spécifiée.";
DnsOverHttpsMode.pfm_title = "Contrôle le mode DNS-over-HTTPS";
DnsOverHttpsMode.pfm_description = "off - Désactiver DNS-over-HTTPS\nautomatic - Activer DNS-over-HTTPS avec solution de secours à risque\nsecure - Activer DNS-over-HTTPS sans solution de secours à risque\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "Permet de définir le modèle URI du résolveur DNS-over-HTTPS souhaité";
DnsOverHttpsTemplates.pfm_description = "Modèle URI du résolveur DNS-over-HTTPS souhaité. Pour définir plusieurs résolveurs DNS-over-HTTPS, vous devez séparer les modèles URI correspondants à l'aide d'espaces.\n\nVous devez configurer cette règle si vous avez défini \"DnsOverHttpsMode\" sur \"secure\". Elle ne peut pas rester vide. Sous Google Chrome OS uniquement, cette règle (ou la règle DnsOverHttpsTemplatesWithIdentifiers) doit être configurée, sans quoi la résolution DNS échouera.\n\nSi vous avez configuré cette règle et défini \"DnsOverHttpsMode\" sur \"automatic\", les modèles URI définis sont appliqués. Si vous n'avez pas défini cette règle, des correspondances codées en dur sont appliquées pour tenter de passer du résolveur DNS actuel de l'utilisateur à un résolveur DoH géré par le même fournisseur.\n\nSi le modèle URI contient une variable dns, les requêtes envoyées au résolveur utilisent la méthode GET. Sinon, elles utilisent la méthode POST.\n\nLes modèles dont le format est incorrect sont ignorés.";
DomainReliabilityAllowed.pfm_title = "Autoriser la création de rapports sur les données liées à la fiabilité du domaine";
DomainReliabilityAllowed.pfm_description = "Si cette règle est définie sur \"False\", les rapports sur les données de diagnostic de fiabilité du domaine sont désactivés et aucune donnée n'est envoyée à Google.\nSi cette règle est définie sur \"True\" ou si elle n'est pas définie, les rapports sur les données de diagnostic de fiabilité du domaine suivront le comportement de MetricsReportingEnabled pour Brave ou de DeviceMetricsReportingEnabled pour Google Chrome OS.";
DownloadDirectory.pfm_title = "Définir le répertoire de téléchargement";
DownloadDirectory.pfm_description = "Cette règle définit le répertoire utilisé par Chrome pour le téléchargement de fichiers. Ce répertoire sera utilisé même si l'utilisateur en indique un autre ou s'il a activé l'option permettant de choisir un emplacement cible à chaque téléchargement.\n\nCette règle remplace la règle DefaultDownloadDirectory.\n\nSi cette règle n'est pas configurée, Chrome utilise le répertoire de téléchargement par défaut, que les utilisateurs peuvent modifier.\n\nSur Google Chrome OS, vous pouvez uniquement le définir sur un répertoire Google Drive.\n\nRemarque : Pour savoir quelles variables vous pouvez utiliser, consultez la page https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DownloadRestrictions.pfm_title = "Restrictions de téléchargement";
DownloadRestrictions.pfm_description = "0 - Aucune restriction particulière. Par défaut.\n1 - Bloquer les téléchargements malveillants et les types de fichiers dangereux.\n2 - Bloquer les téléchargements malveillants, peu courants ou indésirables, ainsi que les types de fichiers dangereux.\n3 - Bloquer tous les téléchargements.\n4 - Bloquer les téléchargements malveillants. Recommandé.\nSi cette règle est activée, les utilisateurs ne peuvent pas contourner les décisions de sécurité concernant les téléchargements.\n\nIl y a de nombreux types d'avertissements concernant les téléchargements dans Chrome. Les catégories sont les suivantes (consultez https://support.google.com/chrome/?p=ib_download_blocked pour en savoir plus sur les alertes de la navigation sécurisée) :\n\n* Téléchargements malveillants, tels qu'identifiés par le serveur de navigation sécurisée\n* Téléchargements peu courants ou indésirables, tels qu'identifiés par le serveur de navigation sécurisée\n* Types de fichiers dangereux (par exemple, tous les téléchargements SWF et la plupart des téléchargements EXE)\n\nLes catégories bloquées diffèrent selon la valeur définie pour la règle :\n\n0 : pas de restrictions particulières. Par défaut.\n\n1 : blocage des fichiers malveillants identifiés par le serveur de navigation sécurisée ET de tous les types de fichiers dangereux. Recommandé uniquement pour les UO/navigateurs/utilisateurs avec une haute tolérance aux faux positifs.\n\n2 : blocage des fichiers malveillants identifiés par le serveur de navigation sécurisée ET des fichiers peu courants ou indésirables identifiés par le serveur de navigation sécurisée ET de tous les types de fichiers dangereux. Recommandé uniquement pour les UO/navigateurs/utilisateurs avec une haute tolérance aux faux positifs.\n\n3 : blocage de tous les téléchargements. Non recommandé, sauf pour les cas d'utilisation spéciaux.\n\n4 : blocage des fichiers malveillants identifiés par le serveur de navigation sécurisée ; les types de fichiers dangereux ne sont pas bloqués. Recommandé.\n\nRemarque : Ces restrictions s'appliquent aux téléchargements déclenchés à partir du contenu d'une page Web et de l'option de menu \"Télécharger le lien\". Elles ne s'appliquent pas au téléchargement de la page actuellement affichée ni à l'enregistrement au format PDF depuis les options d'impression. Pour en savoir plus sur la navigation sécurisée, consultez https://developers.google.com/safe-browsing.";
EditBookmarksEnabled.pfm_title = "Activer ou désactiver la modification des favoris";
EditBookmarksEnabled.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, les utilisateurs peuvent ajouter, supprimer, modifier ou importer des favoris.\n\nSi elle est désactivée, les utilisateurs ne peuvent pas ajouter, supprimer, modifier ni importer de favoris. En revanche, ils peuvent utiliser les favoris déjà disponibles.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Inclure un port non standard dans le SPN Kerberos";
EnableAuthNegotiatePort.pfm_description = "Si cette règle est activée et qu'un port non standard est indiqué (c'est-à-dire un port autre que 80 ou 443), ce port est inclus dans le SPN Kerberos généré.\n\nSi cette règle est désactivée ou n'est pas configurée, le SPN Kerberos généré ne comprend aucun port.";
EnableExperimentalPolicies.pfm_title = "Activer les règles expérimentales";
EnableExperimentalPolicies.pfm_description = "Permet à Brave de charger des règles expérimentales.\n\nAVERTISSEMENT : Les règles expérimentales ne sont pas prises en charge et peuvent être modifiées ou supprimées sans préavis dans la future version du navigateur.\n\nUne règle expérimentale peut ne pas être terminée ou encore présenter des défauts connus ou inconnus. Elle peut être modifiée ou même supprimée sans aucune notification. En activant des règles expérimentales, vous pouvez perdre des données de navigateur, ou compromettre votre sécurité ou la confidentialité de vos données.\n\nSi une règle ne figure pas dans la liste et qu'elle n'est pas officiellement publiée, sa valeur est alors ignorée dans les versions bêta et stable de Chrome.\n\nSi une règle figure dans la liste et qu'elle n'est pas officiellement publiée, sa valeur est alors appliquée.\n\nCette règle n'a aucune incidence sur les règles déjà publiées.";
EnableMediaRouter.pfm_title = "Activer Google Cast";
EnableMediaRouter.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, Google Cast est activé. Les utilisateurs pourront le lancer depuis le menu de l'application, les menus contextuels des pages, les commandes multimédias sur les sites Web compatibles Cast et l'icône Cast de la barre d'outils (si elle est affichée).\n\nSi cette règle est désactivée, Google Cast le sera également.";
EnableOnlineRevocationChecks.pfm_title = "Activer les contrôles OCSP/CRL en ligne";
EnableOnlineRevocationChecks.pfm_description = "Si cette règle est définie sur \"True\", des contrôles OCSP/CRL en ligne sont effectués.\n\nSi cette règle est définie sur \"False\" ou qu'elle n'est pas configurée, Brave ne procède à aucun contrôle de révocation en ligne (notez que cela ne concerne que les versions 19 et ultérieures de Brave).\n\nRemarque : Les contrôles OCSP/CRL ne présentent aucun avantage concret en termes de sécurité.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "Contrôle les utilisateurs gérés autorisés à définir les règles ProxyOverrideRules et ProxyProvisioningDomains.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Si cette règle est définie sur 0 ou n'est pas configurée, les règles ProxyOverrideRules et ProxyProvisioningDomains ne s'appliquent qu'au niveau de l'utilisateur à condition que celui-ci soit affilié et qu'il utilise un navigateur géré.\nSi cette règle est définie sur 1, les règles ProxyOverrideRules et ProxyProvisioningDomains s'appliquent au niveau de l'utilisateur, même si celui-ci n'est pas affilié.";
EnableUnsafeSwiftShader.pfm_title = "Autoriser le remplacement WebGL logiciel avec SwiftShader";
EnableUnsafeSwiftShader.pfm_description = "Règle qui détermine si SwiftShader est utilisé comme remplacement WebGL lorsque l'accélération GPU matérielle n'est pas disponible.\n\nSwiftShader était utilisé pour prendre en charge WebGL sur les systèmes sans accélération GPU, tels que les systèmes headless ou les machines virtuelles, mais il a été abandonné en raison de problèmes de sécurité. À partir de M139, la création d'un contexte WebGL échouera dans les cas où il aurait utilisé SwiftShader. Cette règle permet au navigateur ou à l'administrateur de différer temporairement l'abandon.\n\nSi cette règle est activée, SwiftShader est utilisé comme remplacement logiciel WebGL.\n\nSi elle est désactivée ou qu'elle n'est pas configurée, la création de contexte WebGL peut échouer si l'accélération GPU matérielle n'est pas disponible. Les pages Web peuvent dysfonctionner si elles ne gèrent pas correctement l'échec de la création du contexte WebGL.\n\nIl s'agit d'une règle temporaire qui sera supprimée à l'avenir.";
EncryptedClientHelloEnabled.pfm_title = "Activer TLS Encrypted ClientHello";
EncryptedClientHelloEnabled.pfm_description = "Encrypted ClientHello (ECH) est une extension TLS qui permet de chiffrer les champs sensibles de ClientHello et de renforcer la confidentialité.\n\nSi cette règle est activée ou si elle n'est pas configurée, Brave suivra le processus de déploiement par défaut pour ECH. Si elle est désactivée, Brave n'activera pas ECH.\n\nLorsque cette fonctionnalité est activée, Brave peut ou non utiliser ECH en fonction de la compatibilité du serveur, de la disponibilité de l'enregistrement DNS HTTPS ou de l'état du déploiement.\n\nECH est un protocole qui évolue. L'implémentation de Brave est donc susceptible d'être modifiée. Par conséquent, cette règle est une mesure temporaire pour contrôler l'implémentation expérimentale initiale. Elle sera remplacée par les commandes finales à la fin du protocole.";
EnterpriseCustomLabel.pfm_title = "Définir un libellé d'entreprise personnalisé pour un profil géré";
EnterpriseCustomLabel.pfm_description = "Cette règle permet de définir un libellé personnalisé servant à identifier les profils gérés. Pour les profils gérés, ce libellé s'affichera à côté de l'avatar dans la barre d'outils. Le libellé personnalisé ne sera pas traduit.\n\nLorsque cette règle est appliquée, les chaînes de plus de 16 caractères sont tronquées par un \"...\". Veuillez éviter d'utiliser des noms étendus.\n\nCette règle ne peut être configurée que comme règle relative aux utilisateurs.\n\nNotez que cette règle n'aura aucun effet si la règle EnterpriseProfileBadgeToolbarSettings est définie sur hide_expanded_enterprise_toolbar_badge (valeur 1).";
EnterpriseCustomLabelForBrowser.pfm_title = "Définir un libellé d'entreprise personnalisé pour un navigateur géré";
EnterpriseCustomLabelForBrowser.pfm_description = "Cette règle permet de définir un libellé personnalisé servant à indiquer un navigateur géré. Pour les navigateurs gérés, ce libellé sera affiché dans un avis de non-responsabilité de gestion, dans le pied de page de la page \"Nouvel onglet\". Le libellé personnalisé ne sera pas traduit.\n\nNotez que cette règle ne s'applique qu'aux navigateurs gérés. Elle n'aura donc aucune incidence pour les utilisateurs gérés sur les navigateurs non gérés.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de la Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Autorise les extensions gérées à utiliser l'API Enterprise Hardware Platform";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Si cette règle est définie sur \"True\", les extensions installées dans le cadre des règles de l'entreprise peuvent utiliser l'API Enterprise Hardware Platform.\n\nSi cette règle est définie sur \"False\" ou qu'elle n'est pas configurée, les extensions ne peuvent pas utiliser cette API.\n\nRemarque : Cette règle s'applique également aux extensions de composant telles que l'extension Hangout Services.";
EnterpriseLogoUrl.pfm_title = "URL du logo de l'entreprise pour un profil géré";
EnterpriseLogoUrl.pfm_description = "URL d'une image qui servira de badge d'entreprise pour un profil géré. L'URL doit renvoyer vers une image.\n\nCette règle ne peut être configurée que comme règle relative aux utilisateurs.\n\nNous vous recommandons d'utiliser le favicon (exemple : https://www.google.com/favicon.ico) ou une icône d'au moins 48 x 48 px.";
EnterpriseLogoUrlForBrowser.pfm_title = "URL du logo de l'entreprise pour un navigateur géré";
EnterpriseLogoUrlForBrowser.pfm_description = "URL d'une image qui servira de badge d'entreprise pour un navigateur géré. L'URL doit renvoyer vers une image.\n\nNous vous recommandons d'utiliser le favicon (exemple : https://www.google.com/favicon.ico) ou une icône d'au moins 48 x 48 px.\n\nNotez que cette règle ne s'applique qu'aux navigateurs gérés. Elle n'aura donc aucune incidence pour les utilisateurs gérés sur les navigateurs non gérés.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de la Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de la Chrome Enterprise Core.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Contrôle la visibilité du badge du profil d'entreprise dans la barre d'outils";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Afficher la version développée du badge d'entreprise dans la barre d'outils\n1 - Masquer la version développée du badge d'entreprise dans la barre d'outils\nPour les profils professionnels et scolaires, un libellé \"Professionnel\" ou \"Scolaire\" s'affichera par défaut à côté de l'avatar dans la barre d'outils. Le libellé ne s'affichera que si le compte connecté est géré.\n\nSi cette règle est définie sur hide_expanded_enterprise_toolbar_badge (valeur 1), le badge d'entreprise d'un profil géré sera masqué dans la barre d'outils.\n\nSi cette règle n'est pas configurée ou qu'elle est définie sur show_expanded_enterprise_toolbar_badge (valeur 0), le badge d'entreprise sera affiché.\n\nLe libellé est personnalisable avec la règle EnterpriseCustomLabel.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "Conserver les données de navigation lors de la création d'un profil d'entreprise par défaut";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Si cette règle est activée, l'option permettant de conserver les données de navigation existantes lors de la création d'un profil d'entreprise sera cochée par défaut.\n\nSi cette règle n'est pas définie ou est désactivée, l'option permettant de conserver les données de navigation existantes lors de la création d'un profil d'entreprise ne sera pas cochée par défaut.\n\nQuelle que soit la valeur, l'utilisateur pourra décider de conserver ou non les données de navigation existantes lors de la création d'un profil d'entreprise.\n\nCette règle n'a aucun effet si l'option permettant de conserver les données de navigation existantes n'est pas disponible. Cela se produit si la séparation des profils d'entreprise est strictement appliquée, ou si les données proviennent d'un profil déjà géré.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Paramètres de l'agrégateur de recherche d'entreprise";
EnterpriseSearchAggregatorSettings.pfm_description = "Cette règle permet aux administrateurs de définir un agrégateur de recherche d'entreprise dédié qui fournira des recommandations et des résultats de recherche dans l'omnibox (barre d'adresse) et le champ de recherche de la page \"Nouvel onglet\".\n\nPar défaut, les suggestions de recherche d'entreprise seront mélangées et affichées avec les recommandations Brave habituelles. Les utilisateurs peuvent limiter explicitement leur recherche à l'agrégateur de recherche d'entreprise en saisissant le mot clé indiqué dans le champ shortcut, avec ou sans le préfixe @ (par exemple, @work), puis en appuyant sur la barre d'espace ou la touche Tabulation dans l'omnibox. Les recherches d'entreprise ciblées (déclenchées par un mot clé) ne sont actuellement compatibles que dans l'omnibox et non dans le champ de recherche de la page \"Nouvel onglet\".\n\nLes champs suivants sont obligatoires : name, shortcut, search_url et suggest_url.\n\nLe champ name correspond au nom du moteur de recherche que l'utilisateur verra dans la barre d'adresse.\n\nLe champ shortcut correspond au mot clé que l'utilisateur saisit pour déclencher la recherche. Le raccourci peut contenir des mots et caractères bruts, mais il ne peut pas inclure d'espaces ni commencer par le symbole @. Les raccourcis doivent être uniques.\n\nLe champ search_url spécifie l'URL sur laquelle effectuer la recherche. Saisissez l'adresse Web de la page de résultats du moteur de recherche, et utilisez '{searchTerms}' à la place de la requête.\n\nLe champ suggest_url indique l'URL qui fournit des suggestions de recherche. Une requête POST sera envoyée et la requête de l'utilisateur sera transmise dans les paramètres POST sous la clé 'query'.\n\nLe champ icon_url indique l'URL d'une image qui sera utilisée dans les suggestions de recherche. Si ce champ n'est pas défini, une icône par défaut sera utilisée. Nous vous recommandons d'utiliser un favicon (exemple : https://www.google.com/favicon.ico). Formats de fichiers image acceptés : JPEG, PNG et ICO.\n\nLe champ require_shortcut indique si le shortcut de la barre d'adresse est requis pour afficher les recommandations de recherche. Si nécessaire, les suggestions ne s'afficheront pas dans le champ de recherche de la page \"Nouvel onglet\", mais continueront de s'afficher dans l'omnibox (barre d'adresse) en mode de recherche ciblée. Si ce champ n'est pas défini, le shortcut de la barre d'adresse n'est pas requis.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.\nConsultez la page https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings pour en savoir plus sur le schéma et le formatage.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "Désactiver les avertissements de téléchargement basés sur l'extension pour les types de fichier spécifiés selon le domaine";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Vous pouvez activer cette règle afin de créer un dictionnaire d'extensions de fichier et une liste correspondante de domaines qui seront exemptés d'avertissements de téléchargement basés sur l'extension. Cela permet aux administrateurs de l'entreprise de bloquer ces avertissements pour les fichiers associés à un domaine listé. Par exemple, si l'extension \"jnlp\" est associée à \"website1.com\", les utilisateurs verront un avertissement s'ils téléchargent des fichiers \"jnlp\" depuis \"website2.com\". En revanche, ils n'en verront pas s'ils téléchargent des fichiers \"jnlp\" depuis \"website1.com\".\n\nLe téléchargement, depuis les domaines identifiés par cette règle, de fichiers dont l'extension est spécifiée fera toutefois l'objet d'avertissements de sécurité (non basés sur l'extension) pour signaler, par exemple, un contenu mixte ou une navigation sécurisée.\n\nSi vous désactivez cette règle, ou que vous ne la configurez pas, les utilisateurs verront des avertissements s'ils téléchargent des fichiers des types spécifiés.\n\nSi vous activez cette règle :\n\n* Les URL doivent avoir le format décrit sur https://chromeenterprise.google/policies/url-patterns/.\n\n* L'extension doit être saisie au format ASCII, en minuscules. Les extensions doivent être listées sans le séparateur qui les précède (par exemple, indiquez \"jlnp\" et non \".jlnp\").\n\nExemple :\n\nLa configuration suivante empêche que des avertissements s'affichent en cas de téléchargement de fichiers de type \"exe\" et \"jnlp\" depuis le domaine *.example.com, et de fichiers de type \"swf\" depuis tous les domaines. L'utilisateur voit un avertissement s'il télécharge un fichier exe ou jnlp depuis un autre domaine, mais pas s'il télécharge un fichier swf.\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nNotez que même si les avertissements basés sur l'extension sont ici supprimés en cas de téléchargement d'un fichier swf depuis n'importe quel domaine, il n'est pas recommandé d'appliquer ce type de configuration aux extensions dangereuses, pour des raisons de sécurité. Cet exemple ne vise qu'à montrer qu'il est possible de le faire.\n\nSi cette règle est activée en même temps que DownloadRestrictions, les exemptions aux avertissements basés sur l'extension spécifiées par cette règle prévalent sur un paramètre DownloadRestrictions qui bloquerait les types de fichiers dangereux. Les exemptions spécifiées par cette règle ne s'appliquent qu'au comportement \"bloquer les types de fichiers dangereux\" spécifié par les valeurs 1 et 2 de DownloadRestrictions.\n\nPar exemple, si cette règle spécifie une exemption pour les téléchargements \"exe\" depuis \"website1.com\" et que DownloadRestrictions est configurée pour bloquer les téléchargements malveillants et les types de fichiers dangereux (valeur 1), les téléchargements \"exe\" depuis \"website1.com\" seront exemptés du blocage basé sur l'extension, mais seront quand même bloqués s'ils sont malveillants.\n\nPour en savoir plus sur DownloadRestrictions, consultez https://chromeenterprise.google/policies/?policy=DownloadRestrictions.\nConsultez la page https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings pour en savoir plus sur le schéma et le formatage.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Ports réseau explicitement autorisés";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - port 554 (peut être débloqué jusqu'au 15/10/2021)\n10080 - port 10080 (peut être débloqué jusqu'au 01/04/2022)\n6566 - port 6566 (peut être débloqué jusqu'au 15/10/2021)\n989 - port 989 (peut être débloqué jusqu'au 01/02/2022)\n990 - port 990 (peut être débloqué jusqu'au 01/02/2022)\nUne liste de ports restreints est intégrée à Brave. Toute connexion à ces ports échouera. Ce paramètre permet de contourner cette liste. Il s'agit d'une liste d'éléments séparés par une virgule contenant zéro port ou plus sur lesquels les connexions sortantes seront autorisées.\n\nLes ports sont restreints afin d'éviter l'utilisation de Brave en tant que vecteur pour exploiter différentes failles réseau. Définir cette règle peut exposer votre réseau aux attaques. Elle est conçue comme solution de contournement temporaire pour les erreurs avec le code \"ERR_UNSAFE_PORT\" qui surviennent lors de la migration d'un service, d'un port bloqué vers un port standard (port 80 ou 443, par exemple).\n\nLes sites malveillants peuvent facilement détecter que cette règle est définie (et pour quels ports) et utiliser cette info pour cibler des attaques.\n\nIci, le libellé de chaque port contient une date jusqu'à laquelle il peut être débloqué. Après cette date, le port sera restreint quel que soit ce paramètre.\n\nSi vous laissez la valeur vide ou non définie, tous les ports restreints seront bloqués. Dans le cas d'un mélange de valeurs valides et non valides, les valeurs valides seront appliquées.\n\nCette règle remplace l'option de ligne de commande \"--explicitly-allowed-ports\".";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Liste de blocage des fournisseurs d'identité qui ne peuvent pas utiliser l'extension SSO d'entreprise pour le navigateur";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Tous les fournisseurs d'identité\nmicrosoft - Fournisseur d'identité cloud Microsoft®\nokta - Fournisseur d'identité cloud Okta®\nping - Fournisseur d'identité cloud Ping®\nDésactivez l'authentification unique utilisant Extensible Enterprise SSO pour les fournisseurs d'identité listés.\n\nSi vous ajoutez la valeur 'all', tous les fournisseurs d'identité pris en charge pour l'authentification unique sont désactivés.\n\nSi vous ajoutez la valeur 'microsoft', la prise en charge de l'authentification unique pour le fournisseur d'identité cloud Microsoft® dans Chrome sera désactivée.\n\nSi vous ne configurez pas cette règle, tous les fournisseurs d'identité pris en charge par Brave seront activés.\n\nPour les fournisseurs d'identité activés dans Brave et configurés sur l'appareil par l'administrateur, les utilisateurs qui se connectent une fois via ce fournisseur d'identité, sur n'importe quelle appli compatible avec Extensible Enterprise SSO, peuvent être connectés automatiquement aux propriétés Web utilisant ce fournisseur d'identité. Les informations concernant l'authentification de l'utilisateur sont transmises au fournisseur d'identité cloud de l'utilisateur pour chaque événement d'authentification.\n\nRemarques :\n\nBrave ne prend pas en charge l'authentification unique utilisant Extensible Enterprise SSO en mode navigation privée ou Invité.\n\nBrave ne prend en charge l'authentification unique utilisant Extensible Enterprise SSO que pour les fournisseurs d'identité suivants : Microsoft, Okta, Ping.\n\nCette fonctionnalité est disponible à partir de macOS 10.15.";
ExtensionAllowedTypes.pfm_title = "Types d'extensions ou d'applications autorisés à être installés";
ExtensionAllowedTypes.pfm_description = "extension - Extension\ntheme - Thème\nuser_script - Script utilisateur\nhosted_app - Application hébergée\nlegacy_packaged_app - Ancienne application empaquetée\nplatform_app - Application de plate-forme\nCette règle permet de déterminer quelles applis et extensions peuvent être installées dans Brave, de définir les hôtes avec lesquels elles peuvent interagir et de limiter l'accès pendant l'exécution.\n\nSi cette règle n'est pas configurée, aucune restriction n'est imposée concernant les types d'extensions ou d'applis pouvant être installées.\n\nSi le type d'une extension ou d'une appli ne figure pas dans la liste, celle-ci n'est pas installée. Chaque valeur doit correspondre à l'une des chaînes suivantes :\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\nPour en savoir plus sur ces types, consultez la documentation sur les extensions Brave.\n\nAvant la version 75, la spécification de plusieurs ID d'extension séparés par une virgule n'est pas possible et est donc ignorée. En revanche, le reste de la règle est appliqué.\n\nRemarque : Cette règle concerne également les extensions et les applis à installer d'office via ExtensionInstallForcelist.\n\nRemarque : Cette règle ne s'applique qu'aux plates-formes compatibles avec les extensions.";
ExtensionDeveloperModeSettings.pfm_title = "Contrôler la disponibilité du mode développeur sur la page des extensions";
ExtensionDeveloperModeSettings.pfm_description = "0 - Autoriser l'utilisation du mode développeur sur la page des extensions\n1 - Ne pas autoriser l'utilisation du mode développeur sur la page des extensions\nDétermine si les utilisateurs peuvent activer le mode développeur sur chrome://extensions.\n\nSi la règle n'est pas configurée, les utilisateurs peuvent activer le mode développeur sur la page des extensions, sauf si la règle DeveloperToolsAvailability est définie sur DeveloperToolsDisallowed (2).\nSi la règle est définie sur Allow (0), les utilisateurs peuvent activer le mode développeur sur la page des extensions.\nSi elle est définie sur Disallow (1), les utilisateurs ne peuvent pas activer le mode développeur sur la page des extensions.\n\nSi cette règle est configurée, la règle DeveloperToolsAvailability ne peut plus contrôler le mode développeur des extensions.\n\nRemarque : Cette règle ne s'applique qu'aux plates-formes compatibles avec les extensions.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Configurez une liste d'origines qui accordent une durée de vie étendue en arrière-plan aux extensions connectées.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "Les extensions qui se connectent à l'une de ces origines resteront en fonctionnement tant que le port sera connecté.\n\nSi cette règle n'est pas configurée, les valeurs par défaut de la règle sont utilisées. Voici les origines des applis qui proposent des SDK ne permettant pas de redémarrer une connexion fermée à un état antérieur :\n- Smart Card Connector\n- Citrix Receiver (stable, bêta, sauvegarde)\n- VMware Horizon (stable, bêta)\n\nSi cette règle est définie, la liste de valeurs par défaut est complétée par les nouvelles valeurs configurées. Les entrées par défaut et les entrées fournies par les règles accordent l'exception aux extensions connectées, à condition que le port soit connecté.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Activer les extensions installées par le biais de règles qui remplacent les paramètres du moteur de recherche par défaut ou de la page \"Nouvel onglet\"";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Détermine si les extensions installées par le biais de règles (installées d'office ou recommandées) qui remplacent les paramètres du moteur de recherche par défaut ou de la page \"Nouvel onglet\" sont autorisées dans les environnements peu fiables.\n\nCette règle ne s'applique qu'aux environnements peu fiables (comme les appareils sur lesquels les règles sont configurées localement sans gestion de domaine ou cloud). Les environnements de confiance élevée ne sont pas concernés :\n\nSous Microsoft® Windows®, cette règle n'est pas disponible sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est pas disponible sur les instances gérées par MDM, associées à un domaine au moyen de MCX ou qui bénéficient de Chrome Enterprise Core.\n\nLes extensions installées par le biais de règles qui remplacent les paramètres du moteur de recherche par défaut ou de la page \"Nouvel onglet\" resteront activées sur ces instances de confiance élevée.\n\nSi cette règle est activée, Brave autorisera l'installation d'extensions par le biais de règles qui remplacent les paramètres du moteur de recherche par défaut ou de la page \"Nouvel onglet\", et leur permettra de rester activées dans les environnements peu fiables.\n\nSi cette règle est désactivée ou n'est pas configurée, Brave empêchera l'installation d'extensions par le biais de règles qui remplacent les paramètres du moteur de recherche par défaut ou de la page \"Nouvel onglet\" dans les environnements peu fiables, et les supprimera si elles sont déjà installées.\n\nSi une extension concernée est mise à jour de manière à ne plus remplacer ces paramètres, Brave l'installera automatiquement dans un délai de sept jours.\n\nIl s'agit d'une règle temporaire qui sera supprimée dans une prochaine version.";
ExtensionInstallAllowlist.pfm_title = "Identifiants d'extension à exclure de la liste de blocage";
ExtensionInstallAllowlist.pfm_description = "Cette règle permet de spécifier les extensions à exclure de la liste de blocage.\n\nSi vous saisissez la valeur \"*\" dans la liste de blocage, toutes les extensions sont bloquées, et les utilisateurs ne peuvent alors installer que les extensions figurant dans la liste d'autorisation.\n\nPar défaut, toutes les extensions sont autorisées. Toutefois, si vous avez interdit les extensions via une règle, utilisez la liste des extensions autorisées pour modifier cette règle.\n\nRemarque : Cette règle ne s'applique qu'aux plates-formes compatibles avec les extensions.";
ExtensionInstallBlocklist.pfm_title = "Identifiants d'extension que l'utilisateur ne doit pas être autorisé à installer (ou * pour tous)";
ExtensionInstallBlocklist.pfm_description = "Cette règle permet de déterminer quelles extensions les utilisateurs ne peuvent PAS installer. Les extensions déjà installées, mais qui sont bloquées, sont désactivées sans que l'utilisateur puisse les activer. Elles sont automatiquement réactivées dès que vous les retirez de la liste de blocage.\n\nSi vous saisissez la valeur \"*\" dans la liste de blocage, toutes les extensions sont bloquées par défaut. Les extensions explicitement listées dans la liste d'autorisation sont autorisées si elles sont signées (empaquetées). Toutes les extensions non empaquetées sont bloquées.\n\nSi cette règle n'est pas configurée, les utilisateurs peuvent installer n'importe quelle extension dans Brave.\n\nRemarque : Cette règle ne s'applique qu'aux plates-formes compatibles avec les extensions.";
ExtensionInstallForcelist.pfm_title = "Identifiants d'extension ou d'application et URL de mise à jour à installer en arrière-plan";
ExtensionInstallForcelist.pfm_description = "Cette règle permet de lister les applis et extensions qui s'installent de manière autonome, sans intervention de l'utilisateur, et que celui-ci ne peut pas désinstaller ni désactiver via l'interface Brave. Les autorisations sont accordées implicitement, y compris pour les API d'extension enterprise.deviceAttributes et enterprise.platformKeys (ces deux API ne sont pas disponibles pour les applis et extensions non installées d'office).\n\nBien que l'objectif de Brave soit d'empêcher l'utilisateur de désinstaller ces extensions, certains systèmes d'exploitation ne permettent pas à Brave d'empêcher efficacement que des modifications externes soient apportées aux extensions. Cette prévention n'est donc pas parfaite.\n\nSi cette règle n'est pas configurée, aucune appli ni extension n'est installée automatiquement, et l'utilisateur peut désinstaller n'importe quelle appli ou extension dans Brave.\n\nCette règle remplace la règle ExtensionInstallBlocklist. Si une appli ou extension installée d'office est supprimée de cette liste, Brave la désinstalle automatiquement.\n\nLe code source de toute extension peut être modifié par les utilisateurs à l'aide des outils pour les développeurs, ce qui peut entraîner des dysfonctionnements. Si cela pose problème, configurez la règle DeveloperToolsDisabled.\n\nChaque élément listé de la règle est une chaîne comprenant un ID d'extension et éventuellement une URL de mise à jour séparés par un point-virgule (;). L'ID d'extension est la chaîne de 32 lettres figurant, par exemple, sur chrome://extensions, quand le mode développeur est activé. Si indiquée, l'URL de mise à jour doit renvoyer vers un fichier manifeste au format XML (https://developer.chrome.com/extensions/autoupdate) et utiliser l'un des schémas suivants : http, https ou file. Par défaut, l'URL de mise à jour du Chrome Web Store est utilisée. L'URL de mise à jour spécifiée dans cette règle ne sert que pour l'installation initiale. Toute mise à jour ultérieure de l'extension utilise l'URL de mise à jour indiquée dans le fichier manifeste de l'extension. L'URL de mise à jour peut être remplacée à l'aide de la règle ExtensionSettings (voir http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy).\n\nPour les instances Microsoft® Windows®, les applis et extensions non issues du Chrome Web Store ne peuvent être installées d'office que si l'instance est associée à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou bénéficie de Chrome Enterprise Core.\n\nPour les instances macOS, les applis et extensions non issues du Chrome Web Store ne peuvent être installées d'office que si l'instance est gérée via MDM, associée à un domaine via MCX ou bénéficie de Chrome Enterprise Core.\n\nRemarque : Cette règle ne s'applique pas en mode navigation privée. Pour en savoir plus sur l'hébergement des extensions, consultez https://developer.chrome.com/extensions/hosting.\n\nRemarque : Cette règle ne s'applique qu'aux plates-formes compatibles avec les extensions.";
ExtensionInstallSources.pfm_title = "Formats d'URL à partir desquelles autoriser les sources d'installation des extensions, des applications et des scripts d'utilisateur";
ExtensionInstallSources.pfm_description = "Cette règle permet de déterminer quelles URL peuvent installer des extensions, des applis et des thèmes. Avant Brave 21, les utilisateurs pouvaient cliquer sur un lien qui renvoyait vers un fichier *.crx, et Brave leur proposait d'installer ce fichier après quelques avertissements. Depuis, les fichiers de ce type doivent être téléchargés et glissés vers la page des paramètres Brave. Cette règle permet d'appliquer à des URL spécifiques l'ancienne procédure d'installation, plus facile à suivre.\n\nChaque élément de cette liste est un format d'identification de style extension (voir https://developer.chrome.com/extensions/match_patterns). Les utilisateurs peuvent facilement installer des éléments depuis n'importe quelle URL correspondant à un élément de cette liste. L'emplacement du fichier *.crx et la page de téléchargement (l'URL de provenance) doivent tous deux être autorisés par ces formats.\n\nLa règle ExtensionInstallBlocklist prévaut sur celle-ci. Autrement dit, une extension figurant dans la liste de blocage ne sera pas installée, même si elle provient d'un site mentionné dans cette liste.\n\nRemarque : Cette règle ne s'applique qu'aux plates-formes compatibles avec les extensions.";
ExtensionInstallTypeBlocklist.pfm_title = "Liste de blocage pour les types d'installations d'extensions";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Empêche le chargement des extensions depuis la ligne de commande\nLa liste de blocage contrôle les types d'installations d'extensions qui ne sont pas autorisés.\n\nDéfinir \"command_line\" empêche le chargement de l'extension à partir de la ligne de commande.";
ExtensionReviewPromptsEnabled.pfm_title = "Contrôler les invites d'avis et les liens d'évaluation des extensions";
ExtensionReviewPromptsEnabled.pfm_description = "Détermine si les invites d'avis et les liens d'évaluation natifs (comme \"Évaluer\") pour les extensions Chrome installées sont accessibles dans les interfaces utilisateur de Chrome.\n\nSi cette règle est activée ou n'est pas configurée, les utilisateurs peuvent voir des points d'entrée natifs pour examiner et évaluer les extensions éligibles dans la barre d'outils, les menus contextuels et la page de gestion des extensions (chrome://extensions).\n\nSi cette règle est désactivée, les invites d'avis et les liens d'évaluation natifs sont tous supprimés et indisponibles.";
ExtensionSettings.pfm_title = "Paramètres de gestion des extensions";
ExtensionSettings.pfm_description = "Cette règle permet de contrôler les paramètres de gestion des extensions pour Brave, y compris ceux contrôlés par des règles existantes liées aux extensions.\n\nElle fait correspondre un ID d'extension ou une URL de mise à jour uniquement avec sa configuration spécifique. Une configuration par défaut peut être définie pour l'ID spécial \"*\", lequel s'applique à toutes les extensions pour lesquelles aucune configuration personnalisée n'est définie dans cette règle.\n\nCette règle peut remplacer la configuration par extension des anciennes règles.\n\nNotez que tout paramètre d'extension par ID provenant de ExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist ou ExtensionSettings n'héritera que de \"installation_mode\" et \"update_url\" à partir des valeurs par défaut de \"*\". Il n'héritera d'aucune autre propriété. Avec une URL de mise à jour, la configuration s'applique aux extensions avec l'URL de mise à jour telle qu'elle est indiquée dans le fichier manifeste de ces extensions ( http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy ). Si le flag \"override_update_url\" est défini sur \"True\", l'extension est installée et mise à jour à l'aide de l'URL spécifiée dans la règle \"ExtensionInstallForcelist\" ou dans le champ \"update_url\" de cette règle. Le flag \"override_update_url\" est ignoré si le champ \"update_url\" contient une URL du Chrome Web Store.\n\nÀ partir de la version 154 de Brave, l'application de \"runtime_blocked_hosts\" à une extension disposant de l'autorisation \"debugger\" désactivera complètement \"chrome.debugger.attach()\" sur toutes les cibles.\n\nPour les instances Microsoft® Windows®, les applis et extensions non issues du Chrome Web Store ne peuvent être installées d'office que si l'instance est associée à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou bénéficie de Chrome Enterprise Core.\n\nPour les instances macOS, les applis et extensions non issues du Chrome Web Store ne peuvent être installées d'office que si l'instance est gérée via MDM, associée à un domaine via MCX ou bénéficie de la Chrome Enterprise Core.\n\nRemarque : Cette règle ne s'applique qu'aux plates-formes compatibles avec les extensions.\nConsultez la page https://chromeenterprise.google/policies/?policy=ExtensionSettings pour en savoir plus sur le schéma et le formatage.";
ExtensionUnpublishedAvailability.pfm_title = "Contrôlez la disponibilité des extensions dont la publication a été annulée sur le Chrome Web Store.";
ExtensionUnpublishedAvailability.pfm_description = "0 - Autoriser les extensions dont la publication a été annulée\n1 - Désactiver les extensions dont la publication est annulée\nSi cette règle est activée, les extensions dont la publication est annulée sur le Chrome Web Store sont désactivées dans Brave.\nElle ne s'applique qu'aux extensions installées et mises à jour à partir du Chrome Web Store.\n\nLes extensions non issues du Chrome Web Store, telles que celles non empaquetées installées en mode développeur et celles installées avec le commutateur de ligne de commande, sont ignorées.\nLes extensions installées d'office et auto-hébergées sont ignorées. Toutes les extensions dont la version est fixe sont aussi ignorées.\n\nSi la règle est définie sur AllowUnpublished (0) ou n'est pas configurée, les extensions dont la publication est annulée sur le Chrome Web Store sont autorisées.\nSi la règle est définie sur DisableUnpublished (1), les extensions dont la publication est annulée sur le Chrome Web Store sont désactivées.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Afficher une case \"Toujours ouvrir\" dans une boîte de dialogue de protocole externe.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Cette règle permet de spécifier si la case \"Toujours ouvrir\" doit être affichée ou non dans une invite de confirmation du lancement d'un protocole externe.\n\n     Si cette règle est définie sur \"True\", lorsqu'une invite de confirmation de lancement d'un protocole externe s'affiche, l'utilisateur peut sélectionner l'option \"Toujours autoriser\" pour ignorer par la suite les invites de confirmation concernant son lancement.\n\n     Si cette règle est définie sur \"False\", la case \"Toujours autoriser\" n'est pas affichée, et l'utilisateur est invité à confirmer à chaque fois le lancement d'un protocole externe.";
FeedbackSurveysEnabled.pfm_title = "Spécifie si les enquêtes intégrées Brave sont présentées aux utilisateurs.";
FeedbackSurveysEnabled.pfm_description = "Les enquêtes intégrées Brave permettent de recueillir les commentaires des utilisateurs concernant le navigateur. Les réponses à l'enquête ne sont pas associées à des comptes utilisateur.\nSi cette règle est activée ou n'est pas configurée, les enquêtes intégrées peuvent être présentées aux utilisateurs.\nSi cette règle est désactivée, les enquêtes intégrées ne sont pas présentées aux utilisateurs.\n\nCette règle n'a aucun effet si la règle MetricsReportingEnabled est désactivée, ce qui désactive également les enquêtes intégrées.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Durée de traitement des demandes keepalive à la fermeture";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Permet de contrôler la durée (en secondes) pendant laquelle la fermeture du navigateur sera bloquée le temps de traiter les demandes keepalive (https://fetch.spec.whatwg.org/#request-keepalive-flag).\n\nUtilisez la valeur par défaut (0) pour désactiver cette fonctionnalité.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Autoriser l'appel d'API de sélection de fichiers ou répertoires sans geste préalable de l'utilisateur";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "Pour des raisons de sécurité, les API Web showOpenFilePicker() ,showSaveFilePicker() et showDirectoryPicker() nécessitent un geste préalable de l'utilisateur (\"activation temporaire\") pour être appelées, sans quoi l'appel échouera.\n\nLorsque cette règle est configurée, les administrateurs peuvent préciser les origines sur lesquelles ces API peuvent être appelées sans geste préalable de l'utilisateur.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/. La valeur * n'est pas acceptée pour cette règle.\n\nSi cette règle n'est pas configurée, toutes les origines nécessitent un geste préalable de l'utilisateur pour appeler ces API.";
FileSystemReadAskForUrls.pfm_title = "Autoriser l'accès en lecture via l'API File System pour ces sites";
FileSystemReadAskForUrls.pfm_description = "Permet de dresser la liste des formats d'URL pour lesquels les sites sont autorisés à demander aux utilisateurs l'accès en lecture aux fichiers ou répertoires figurant dans le système de fichiers du système d'exploitation hôte via l'API File System.\n\nSi cette règle n'est pas configurée, la règle DefaultFileSystemReadGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, les paramètres spécifiés par les utilisateurs s'appliquent.\n\nLes formats d'URL ne doivent pas entrer en conflit avec ceux de FileSystemReadBlockedForUrls. Aucune règle ne prévaut si un format d'URL est listé dans les deux règles.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
FileSystemReadBlockedForUrls.pfm_title = "Bloquer l'accès en lecture via l'API File System pour ces sites";
FileSystemReadBlockedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites ne peuvent pas demander aux utilisateurs l'accès en lecture aux fichiers ou répertoires figurant dans le système de fichiers du système d'exploitation hôte via l'API File System.\n\nSi cette règle n'est pas configurée, la règle DefaultFileSystemReadGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, les paramètres spécifiés par les utilisateurs s'appliquent.\n\nLes formats d'URL ne peuvent pas entrer en conflit avec ceux de la règle FileSystemReadAskForUrls. Aucune règle ne prévaut si un format d'URL figure dans les deux règles.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
FileSystemWriteAskForUrls.pfm_title = "Autoriser l'accès en écriture aux fichiers et répertoires pour ces sites";
FileSystemWriteAskForUrls.pfm_description = "Permet de dresser la liste des formats d'URL pour lesquels les sites sont autorisés à demander aux utilisateurs un accès en écriture aux fichiers ou répertoires figurant dans le système de fichiers du système d'exploitation hôte.\n\nSi cette règle n'est pas configurée, la règle DefaultFileSystemWriteGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, les paramètres spécifiés par les utilisateurs s'appliquent.\n\nLes formats d'URL ne doivent pas entrer en conflit avec ceux de FileSystemWriteBlockedForUrls. Aucune règle ne prévaut si un format d'URL est listé dans les deux règles.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
FileSystemWriteBlockedForUrls.pfm_title = "Bloquer l'accès en écriture aux fichiers et répertoires pour ces sites";
FileSystemWriteBlockedForUrls.pfm_description = "Permet de dresser la liste des formats d'URL pour lesquels les sites ne sont pas autorisés à demander aux utilisateurs un accès en écriture aux fichiers ou répertoires figurant dans le système de fichiers du système d'exploitation hôte.\n\nSi cette règle n'est pas configurée, la règle DefaultFileSystemWriteGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, les paramètres spécifiés par les utilisateurs s'appliquent.\n\nLes formats d'URL ne peuvent pas entrer en conflit avec ceux de la règle FileSystemWriteAskForUrls. Aucune règle ne prévaut si un format d'URL est listé dans les deux règles.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
ForceEphemeralProfiles.pfm_title = "Profil éphémère";
ForceEphemeralProfiles.pfm_description = "Si cette règle est activée, elle contraint le profil à basculer en mode éphémère. Si elle est spécifiée en tant que règle OS (par exemple, GPO sous Windows), elle s'applique à tous les profils présents sur le système. Si elle est paramétrée en tant que règle de cloud, elle s'applique uniquement aux profils connectés avec un compte géré.\n\nDans ce mode, les données de profil ne sont stockées sur le disque que pour la durée de la session utilisateur. Certaines fonctionnalités, telles que l'historique du navigateur, les extensions et leurs données, les données Web comme les cookies et les bases de données Web, ne sont pas conservées après la fermeture du navigateur. L'utilisateur peut toutefois continuer à télécharger manuellement des données sur son disque, enregistrer des pages ou les imprimer.\n\nSi l'utilisateur a activé la synchronisation, toutes ces données sont conservées dans son profil de synchronisation, comme pour les profils standards. Le mode navigation privée est également disponible s'il n'est pas explicitement désactivé par la règle.\n\nSi la règle est désactivée ou si elle n'est pas paramétrée, les profils standards sont activés au moment de la connexion.";
ForceForegroundPriorityForAllTabs.pfm_title = "Forcer la priorité au premier plan pour tous les onglets";
ForceForegroundPriorityForAllTabs.pfm_description = "Cette règle permet de définir si le contenu Web en arrière-plan doit être exécuté avec la priorité au premier plan.\n\nPar défaut, le navigateur optimise les ressources en réduisant la priorité du contenu des onglets en arrière-plan. L'activation de cette règle remplace ce comportement. Les onglets en arrière-plan sont donc traités de la même manière que l'onglet actif.\n\nSachez que forcer l'exécution du contenu en arrière-plan avec la priorité au premier plan peut légèrement affecter la réactivité de l'onglet actif.\n\nSi cette règle est activée, tout le contenu Web s'exécute avec la priorité au premier plan, quel que soit son état de visibilité.\n\nSi cette règle est désactivée ou n'est pas configurée, le navigateur détermine la priorité en fonction de paramètres standards (par exemple, en réduisant la priorité du contenu qui n'est pas visible, qui ne lit pas de contenu audio, qui ne participe pas à des appels vidéo, etc.).";
ForceForegroundPriorityForUrls.pfm_title = "Forcer la priorité au premier plan pour des URL spécifiques";
ForceForegroundPriorityForUrls.pfm_description = "Cette règle vous permet de spécifier une liste de formats d'URL. Le contenu Web en arrière-plan correspondant à ces formats sera forcé de s'exécuter avec la priorité au premier plan.\n\nSi la règle ForceForegroundPriorityForAllTabs est activée, cette liste est ignorée, car tous les onglets seront forcés en priorité au premier plan.\n\nSi ForceForegroundPriorityForAllTabs est désactivée ou n'est pas définie, seul le contenu correspondant aux formats de cette liste sera forcé.\n\nPour en savoir plus sur les formats URL valides, veuillez consulter https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSi cette liste est vide ou n'est pas définie, aucun contenu en arrière-plan n'est forcé en priorité au premier plan.";
ForceGoogleSafeSearch.pfm_title = "Forcer Google SafeSearch";
ForceGoogleSafeSearch.pfm_description = "Si cette règle est activée, SafeSearch est toujours activé dans la recherche Google, et les utilisateurs ne peuvent pas modifier ce paramètre.\n\nSi cette règle est désactivée ou qu'elle n'est pas configurée, SafeSearch n'est pas appliqué d'office dans la recherche Google.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "Détermine si les gestionnaires d'événements unload peuvent être désactivés.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "Les gestionnaires d'événements unload seront bientôt obsolètes. Leur déclenchement dépend de la règle Permissions-Policy unload. Actuellement, ils sont autorisés par la règle par défaut. À l'avenir, ils seront progressivement interdits par défaut et les sites devront explicitement les activer à l'aide des en-têtes Permissions-Policy. Cette règle d'entreprise peut être utilisée pour refuser cet abandon progressif en forçant la valeur par défaut à rester activée.\n\nLes pages peuvent dépendre de gestionnaires d'événements unload pour enregistrer les données sur le serveur ou signaler à celui-ci la fin d'une session utilisateur. Ce n'est pas recommandé, car cela n'est pas fiable et affecte les performances en bloquant l'utilisation de BackForwardCache. Il existe des alternatives recommandées, mais l'événement unload est utilisé depuis longtemps. Certaines applis peuvent toujours s'appuyer dessus.\n\nSi cette règle est définie sur \"False\" ou n'est pas configurée, les gestionnaires d'événements unload seront progressivement obsolètes conformément au processus d'abandon. En outre, les sites qui ne définissent pas l'en-tête Permissions-Policy cesseront de déclencher des événements \"unload\".\n\nSi cette règle est définie sur \"True\", les gestionnaires d'événements unload continueront de fonctionner par défaut.\n\nREMARQUE : Cette règle avait une valeur par défaut (\"True\") incorrectement documentée dans M117. L'événement \"unload\" n'a pas été modifié et ne changera pas dans M117. Cette règle n'a donc aucune incidence dans cette version.\n";
ForceYouTubeRestrict.pfm_title = "Appliquer le mode restreint minimal sur YouTube";
ForceYouTubeRestrict.pfm_description = "0 - Ne pas appliquer le mode restreint sur YouTube\n1 - Appliquer au moins le mode restreint modéré sur YouTube\n2 - Appliquer le mode restreint strict sur YouTube\nCette règle permet d'appliquer le mode restreint minimal sur YouTube et d'empêcher les utilisateurs de choisir un mode moins restreint. Principe de cette règle :\n\n* Si vous la définissez sur \"Strict\", le mode restreint strict sur YouTube est toujours activé.\n\n* Si vous la définissez sur \"Modéré\", l'utilisateur ne peut choisir que le mode restreint modéré ou le mode restreint strict sur YouTube (il ne peut pas désactiver le mode restreint).\n\n* Si cette règle est désactivée ou qu'aucune valeur n'est définie, le mode restreint sur YouTube n'est pas appliqué par Chrome. Toutefois, des règles externes, comme les règles de YouTube, peuvent quand même appliquer le mode restreint.";
ForcedLanguages.pfm_title = "Configurer les langues préférées et leur ordre";
ForcedLanguages.pfm_description = "Cette règle permet aux administrateurs de configurer l'ordre des langues préférées dans les paramètres de Brave.\n\nLa liste apparaîtra dans le même ordre dans la section \"Classer les langues selon vos préférences\" dans chrome://settings/languages. Les utilisateurs ne pourront pas supprimer ni réorganiser les langues définies par la règle, mais pourront en ajouter sous celles définies. Les utilisateurs auront un contrôle total de la langue de l'UI du navigateur et des paramètres de traduction/du correcteur orthographique, sauf si d'autres règles s'appliquent.\n\nSi cette règle n'est pas définie, les utilisateurs peuvent manipuler toute la liste des langues préférées.";
GeminiActOnWebAllowedForURLs.pfm_title = "Autoriser les intégrations de l'appli Gemini à agir directement sur les sites spécifiés";
GeminiActOnWebAllowedForURLs.pfm_description = "Permet de définir une liste de formats d'URL indiquant les sites sur lesquels les intégrations de l'appli Gemini peuvent agir directement sur les pages Web.\n\nLes URL qui ne correspondent ni à la liste d'autorisation, ni à la liste de blocage utilisent GeminiActOnWebSettings.\n\nLes URL correspondant à la fois à la liste d'autorisation et à la liste de blocage sont autorisées.\n\nPour en savoir plus sur les formats d‘URL valides, veuillez consulter https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebBlockedForURLs.pfm_title = "Empêcher les intégrations de l'appli Gemini d'agir directement sur les sites spécifiés";
GeminiActOnWebBlockedForURLs.pfm_description = "Permet de définir une liste de formats d'URL indiquant les sites sur lesquels les intégrations de l'appli Gemini ne peuvent pas agir directement sur les pages Web.\n\nLes URL qui ne correspondent ni à la liste d'autorisation, ni à la liste de blocage utilisent GeminiActOnWebSettings.\n\nLes URL correspondant à la fois à la liste d'autorisation et à la liste de blocage sont autorisées.\n\nPour en savoir plus sur les formats d‘URL valides, veuillez consulter https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebSettings.pfm_title = "Autorise les intégrations de l'appli Gemini à agir directement sur les pages Web";
GeminiActOnWebSettings.pfm_description = "0 - Autoriser l'appli Gemini à effectuer des actions sur les pages Web.\n1 - Interdire à l'appli Gemini d'effectuer des actions sur les pages Web.\nDétermine si l'appli Gemini est autorisée à effectuer des actions sur les pages Web au nom de l'utilisateur.\n\n0/Non définie = L'appli Gemini est autorisée à effectuer des actions sur les pages Web.\n\n1 = L'appli Gemini n'est pas autorisée à effectuer des actions sur les pages Web.\n\nCette règle n'a aucun effet lorsque l'appli Gemini est désactivée. Par exemple, l'appli Gemini peut être désactivée par la règle GeminiSettings.\n\nPour en savoir plus sur Gemini dans Chrome, veuillez consulter https://support.google.com/chrome/a/answer/16291696.\n\nL'activation de Gemini n'est pas disponible dans tous les pays ni dans toutes les langues. La configuration de cette règle ne garantit pas que la fonctionnalité sera activée. Elle reste soumise à disponibilité. Pour en savoir plus sur le déploiement, consultez les notes de version Enterprise : https://support.google.com/chrome/a/answer/7679408?hl=fr";
GeminiSettings.pfm_title = "Paramètres pour l'intégration de Gemini";
GeminiSettings.pfm_description = "0 - Autoriser les intégrations de Gemini.\n1 - Ne pas autoriser les intégrations de Gemini.\nCe paramètre autorise les intégrations de l'appli Gemini.\n\n0 : les utilisateurs auront accès à l'intégration de Gemini.\n\n1 : les utilisateurs n'auront pas accès à l'intégration de Gemini.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nPour en savoir plus, veuillez consulter l'article du centre d'aide https://support.google.com/chrome/a?p=gemini_in_chrome.";
GeminiSparkSettings.pfm_title = "Autorise Gemini Spark à se connecter à Brave et à utiliser la navigation automatique via Gemini dans Chrome";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark est autorisé à se connecter à la navigation automatique de Brave et à l'utiliser.\n1 - Gemini Spark n'est pas autorisé à se connecter à la navigation automatique de Brave ni à l'utiliser.\nDétermine si l'agent Gemini Spark est autorisé à se connecter à Brave et à utiliser la navigation automatique. Gemini Spark n'est peut-être pas disponible pour votre organisation.\n\n0 = Gemini Spark est autorisé à se connecter à la navigation automatique de Brave et à l'utiliser\n\n1 = Gemini Spark n'est pas autorisé à se connecter à la navigation automatique de Brave ni à l'utiliser\n\nAvertissement : Autoriser Gemini Spark à se connecter à Brave et à utiliser la navigation automatique permet à l'agent Gemini Spark d'effectuer des actions autonomes en plusieurs étapes sur les clients Brave depuis la session de navigateur active. Cela implique des risques de sécurité importants, y compris liés aux identifiants, à l'accès au réseau local et à la perte de signaux contextuels. Il se pourrait que les contrôles de gestion et de sécurité existants ne soient pas respectés.\n\nLes administrateurs sont invités à évaluer attentivement le modèle de menace réseau, ainsi que les consignes en matière de conformité et de confidentialité de leur organisation avant d'activer cette fonctionnalité.\n\nCette règle n'a aucun effet lorsque les règles de navigation automatique de l'appli Google Gemini ou Brave sont désactivées. Par exemple, l'appli Google Gemini peut être désactivée par la règle GeminiSettings. Pour en savoir plus sur Google Gemini dans Brave, veuillez consulter https://support.google.com/chrome/a?p=gemini_in_chrome.\n\nGemini Spark et la navigation automatique de Brave ne sont pas disponibles dans tous les pays ni dans toutes les langues. Définir cette règle sur 0 - Activée ne garantit pas que la fonctionnalité sera activée. Elle reste soumise à disponibilité. Pour en savoir plus sur le déploiement, consultez les notes de version d'Enterprise : https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Paramètres du modèle de fondation local de l'IA générative";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Télécharge automatiquement le modèle\n1 - Ne pas télécharger le modèle\nConfigurez la manière dont Brave télécharge le modèle de fondation de la GenAI et l'utilise pour l'inférence en local.\n\nSi cette règle est définie sur \"Autorisé\" (0) ou qu'elle n'est pas configurée, le modèle est téléchargé automatiquement et est utilisé pour l'inférence.\n\nSi elle est définie sur \"Désactivé\" (1), le modèle n'est pas téléchargé, et le modèle existant (s'il a déjà été téléchargé) est supprimé.\n\nSur les plates-formes de bureau, le téléchargement du modèle peut également être désactivé en définissant ComponentUpdatesEnabled sur \"false\".";
GeolocationBlockedForUrls.pfm_title = "Bloquer la géolocalisation sur ces sites";
GeolocationBlockedForUrls.pfm_description = "Définir cette règle vous permet de définir une liste de formats d'URL indiquant les sites non autorisés à accéder à la géolocalisation de l'utilisateur et qui ne peuvent pas demander l'autorisation de le faire à l'utilisateur.\n\nSi cette règle n'est pas configurée, la règle DefaultGeolocationSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "Permet d'activer un cache d'authentification HTTP à portée globale";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Cette règle permet de définir un cache unique global pour chaque profil avec des identifiants d'authentification de serveur HTTP.\n\nSi cette règle n'est pas définie ou si elle est désactivée, le navigateur applique le comportement par défaut pour l'authentification sur plusieurs sites. Ce comportement par défaut consiste à limiter la portée des identifiants d'authentification de serveur HTTP au site de premier niveau. Autrement dit, si deux sites utilisent des ressources en provenance d'un même domaine d'authentification, des identifiants devront être fournis séparément pour chaque site. Les identifiants de proxy mis en cache sont réutilisés sur tous les sites.\n\nSi cette règle est définie, les identifiants d'authentification HTTP saisis pour un site donné seront automatiquement utilisés dans le contexte d'un autre site.\n\nSi vous activez cette règle, vous exposez les sites à certaines attaques ciblant plusieurs sites et autorisez le suivi des utilisateurs d'un site à l'autre même sans cookies, grâce à l'ajout d'entrées au cache d'authentification HTTP par le biais d'identifiants intégrés aux URL.\n\nCette règle a pour but de donner l'opportunité aux entreprises tributaires de l'ancien comportement de mettre à jour leur processus de connexion. Elle sera prochainement supprimée.";
GoogleSearchSidePanelEnabled.pfm_title = "Activer Google Search Side Panel";
GoogleSearchSidePanelEnabled.pfm_description = "Si cette règle est activée ou n'est pas configurée, Google Search Side Panel est autorisé sur toutes les pages Web.\n\nSi elle est désactivée, Google Search Side Panel n'est disponible sur aucune page Web.\n\nLes capacités d'IA générative de cette fonctionnalité ne sont pas disponibles pour les comptes Education ou Enterprise.";
HSTSPolicyBypassList.pfm_title = "Liste des noms qui seront exemptés de la vérification de la règle HSTS";
HSTSPolicyBypassList.pfm_description = "Cette règle permet de dresser une liste de noms d'hôte qui ignorent les mises à niveau HSTS préchargées entre http et https.\n\nSeuls les noms d'hôte sans extension sont autorisés dans cette règle. Elle ne s'applique qu'aux entrées préchargées HSTS \"statiques\" (par exemple, \"app\", \"new\", \"search\", \"play\"). Elle n'empêche pas les mises à niveau HSTS pour les serveurs qui ont demandé \"dynamiquement\" des mises à niveau HSTS à l'aide d'un en-tête de réponse Strict-Transport-Security.\n\nLes noms d'hôte fournis doivent être indiqués sous forme canonique : tous les noms de domaine internationalisés (IDN) doivent être convertis dans leur format d'étiquette A, et toutes les lettres ASCII doivent être en minuscules. Cette règle ne s'applique qu'aux noms d'hôte sans extension spécifiques indiqués. Elle ne s'applique pas à leurs sous-domaines.";
HappyEyeballsV3Enabled.pfm_title = "Utiliser l'algorithme Happy Eyeballs V3";
HappyEyeballsV3Enabled.pfm_description = "Cette fonctionnalité permet à l'algorithme Happy Eyeballs V3 d'effectuer des tentatives de connexion. Pour en savoir plus, consultez https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3.\n\nSi cette règle est activée, Brave utilisera l'algorithme Happy Eyeballs V3 pour les tentatives de connexion.\n\nSi cette règle est désactivée, l'algorithme Happy Eyeballs V3 l'est également.\n\nSi vous ne configurez pas cette règle, Brave activera ou désactivera l'algorithme Happy Eyeballs V3 en fonction de chrome://flags/#happy-eyeballs-v3.\n\nCette règle est compatible avec l'actualisation dynamique.\n\nCette règle est une mesure temporaire qui sera supprimée dans les futures versions de Brave.";
HardwareAccelerationModeEnabled.pfm_title = "Utiliser l'accélération graphique si disponible";
HardwareAccelerationModeEnabled.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, l'accélération graphique est activée si elle est disponible.\n\nSi cette règle est désactivée, l'accélération graphique l'est également.";
HeadlessMode.pfm_title = "Contrôler l'utilisation du mode headless";
HeadlessMode.pfm_description = "1 - Autoriser le mode headless\n2 - Ne pas autoriser le mode headless\nSi cette règle est définie sur Enabled ou si elle n'est pas configurée, le mode headless est autorisé. Si elle est définie sur Disabled, ce mode est refusé.";
HelpMeWriteSettings.pfm_title = "Paramètres de Aide-moi à écrire";
HelpMeWriteSettings.pfm_description = "0 - Autoriser Aide-moi à écrire et améliorer les modèles d'IA.\n1 - Autoriser Aide-moi à écrire sans améliorer les modèles d'IA.\n2 - Ne pas autoriser Aide-moi à écrire.\nAide-moi à écrire est un assistant de rédaction basé sur l'IA pour les contenus courts sur le Web. Le contenu suggéré dépend des prompts saisis par l'utilisateur et du contenu de la page Web.\n\n0 = Permettre d'utiliser la fonctionnalité tout en autorisant Google à utiliser des données pertinentes pour améliorer ses modèles d'IA. Selon la fonctionnalité, les données pertinentes peuvent inclure des prompts, des entrées, des sorties, des documents source et des commentaires écrits. Elles pourront également être examinées par des réviseurs humains dans le seul but d'améliorer les modèles d'IA. 0 est la valeur par défaut, sauf pour les exceptions ci-dessous.\n\n1 = Permettre d'utiliser la fonctionnalité, mais ne pas autoriser Google à améliorer ses modèles à l'aide du contenu des utilisateurs (y compris les prompts, les entrées, les sorties, les documents source et les commentaires écrits). 1 est la valeur par défaut pour les utilisateurs de la version Enterprise gérés par Google Admin console et pour les comptes Education gérés par Google Workspace.\n\n2 = Ne pas autoriser la fonctionnalité.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
HideWebStoreIcon.pfm_title = "Masquer le Chrome Web Store sur la page Nouvel onglet et dans le lanceur d'applications";
HideWebStoreIcon.pfm_description = "Masque l'application Chrome Web Store et le lien de bas de page sur la page Nouvel onglet et dans le lanceur d'applications de Google Chrome OS.\n\nLorsque cette règle est définie sur \"True\", les icônes sont masquées.\n\nLorsque cette règle est définie sur \"False\", ou si elle n'est pas configurée, les icônes sont visibles.";
HighEfficiencyModeEnabled.pfm_title = "Active le mode Haute efficacité";
HighEfficiencyModeEnabled.pfm_description = "Cette règle active ou désactive le mode Haute efficacité. Avec ce paramètre, les onglets sont supprimés en arrière-plan après un certain temps afin de récupérer de la mémoire.\nSi cette règle n'est pas configurée, l'utilisateur final peut contrôler ce paramètre dans chrome://settings/performance.\n";
HistoryClustersVisible.pfm_title = "Affiche une vue de l'historique Chrome avec des groupes d'onglets.";
HistoryClustersVisible.pfm_description = "Cette règle contrôle la visibilité de la page de l'historique Chrome organisée par groupes de pages.\n\nSi la règle est activée, une page de l'historique Chrome organisée par groupes sera visible sur chrome://history/grouped.\n\nSi la règle est désactivée, une page de l'historique Chrome organisée par groupes ne sera pas visible sur chrome://history/grouped.\n\nSi la règle n'est pas configurée, une page de l'historique Chrome organisée par groupes sera visible par défaut sur chrome://history/grouped.\n\nNotez que si la règle ComponentUpdatesEnabled est désactivée, mais que la règle HistoryClustersVisible est activée ou n'est pas configurée, une page de l'historique Chrome organisée par groupes sera disponible sur chrome://history/grouped, mais pourra être moins pertinente pour l'utilisateur.\n";
HistorySearchSettings.pfm_title = "Paramètres de la recherche dans l'historique optimisée par l'IA";
HistorySearchSettings.pfm_description = "0 - Autoriser la recherche dans l'historique optimisée par l'IA et améliorer les modèles d'IA.\n1 - Autoriser la recherche dans l'historique optimisée par l'IA sans améliorer les modèles d'IA.\n2 - Ne pas autoriser la recherche dans l'historique optimisée par l'IA.\nLa fonctionnalité de recherche dans l'historique optimisée par l'IA permet aux utilisateurs d'effectuer des recherches dans leur historique de navigation et de recevoir des réponses générées en fonction du contenu (et pas seulement du titre et de l'URL) des pages.\n\n0 = Permettre d'utiliser la fonctionnalité tout en autorisant Google à utiliser des données pertinentes pour améliorer ses modèles d'IA. Selon la fonctionnalité, les données pertinentes peuvent inclure des prompts, des entrées, des sorties, des documents source et des commentaires écrits. Elles pourront également être examinées par des réviseurs humains dans le seul but d'améliorer les modèles d'IA. 0 est la valeur par défaut, sauf pour les exceptions ci-dessous.\n\n1 = Permettre d'utiliser la fonctionnalité, mais ne pas autoriser Google à améliorer ses modèles à l'aide du contenu des utilisateurs (y compris les prompts, les entrées, les sorties, les documents source et les commentaires écrits). 1 est la valeur par défaut pour les utilisateurs de la version Enterprise gérés par Google Admin console et pour les comptes Education gérés par Google Workspace.\n\n2 = Ne pas autoriser la fonctionnalité.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
HomepageIsNewTabPage.pfm_title = "Utiliser la page \"Nouvel onglet\" comme page d'accueil";
HomepageIsNewTabPage.pfm_description = "Si cette règle est activée, la page \"Nouvel onglet\" est définie comme page d'accueil de l'utilisateur. Toute URL de page d'accueil est ignorée. Si cette règle est désactivée, la page d'accueil de l'utilisateur ne sera jamais la page \"Nouvel onglet\", sauf si l'URL de la page d'accueil est définie sur \"chrome://newtab\".\n\nSi cette règle est configurée, l'utilisateur ne peut pas changer de type de page d'accueil dans Brave. Si cette règle n'est pas configurée, l'utilisateur choisit d'utiliser ou non la page \"Nouvel onglet\" comme page d'accueil.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
HomepageLocation.pfm_title = "URL de la page d'accueil";
HomepageLocation.pfm_description = "Cette règle permet de définir l'URL de la page d'accueil par défaut de Brave. La page d'accueil s'ouvre quand l'utilisateur clique sur le bouton d'accueil. Sur ordinateur, les pages qui s'affichent au démarrage sont gérées par la règle RestoreOnStartup.\n\nSi la page d'accueil est définie sur la page \"Nouvel onglet\", par l'utilisateur ou par HomepageIsNewTabPage, cette règle n'a aucune incidence.\n\nVous devez saisir une URL avec un schéma standard, comme http://example.com ou https://example.com. Si cette règle est configurée, les utilisateurs ne peuvent pas modifier l'URL de la page d'accueil dans Brave.\n\nSi les règles HomepageLocation et HomepageIsNewTabPage ne sont pas configurées, les utilisateurs peuvent choisir leur page d'accueil.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
HttpAllowlist.pfm_title = "Liste d'autorisation HTTP";
HttpAllowlist.pfm_description = "Cette règle permet d'établir une liste de noms d'hôte ou de modèles de nom d'hôte (tels que \"[*.]example.com\") qui ne seront pas mis à niveau vers le protocole HTTPS et n'afficheront pas d'interstitiel d'erreur si le mode HTTPS-First est activé. Les organisations peuvent utiliser cette règle pour maintenir l'accès aux serveurs non compatibles avec HTTPS, sans avoir à désactiver les mises à niveau HTTPS et/ou le mode HTTPS-First.\n\nLes noms d'hôte fournis doivent être indiqués sous forme canonique : tous les noms de domaine internationalisés (IDN) doivent être convertis dans leur format d'étiquette A, et toutes les lettres ASCII doivent être en minuscules.\n\nLes caractères génériques d'hôte globaux (par exemple, \"*\" ou \"[*]\") ne sont pas autorisés. À la place, le mode HTTPS-First et les mises à niveau HTTPS doivent être explicitement désactivés via leurs règles spécifiques.\n\nRemarque : Cette règle ne s'applique pas aux mises à niveau HSTS.";
HttpHeaderInjection.pfm_title = "Configurer l'injection d'en-tête HTTP pour des formats d'URL spécifiques";
HttpHeaderInjection.pfm_description = "Cette règle permet de définir une liste de règles pour l'injection d'en-têtes HTTP personnalisés dans les requêtes Web correspondant à des formats d'URL spécifiques. Les en-têtes définis par cette règle prévalent sur ceux qui étaient initialement présents dans la requête, ainsi que sur les modifications tentées par les utilisateurs ou les extensions.\n\nUn cas d'utilisation courant de cette règle consiste à appliquer des contrôles d'accès aux locataires en injectant des en-têtes personnalisés (par exemple, X-Tenant-ID).\n\nCette règle accepte une liste de règles. Chaque règle contient :\n\n* patterns : une liste de formats d'URL à mettre en correspondance. Découvrez les formats d'URL à respecter (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\n* headers : liste d'objets représentant les en-têtes à injecter, chacun contenant :\n\n* name : nom de l'en-tête à injecter.\n\n* value : valeur de l'en-tête à injecter.\n\nSi une requête est concernée par plusieurs règles, les en-têtes de toutes les règles correspondantes seront appliqués. Si plusieurs en-têtes portent le même nom, celui dont le format d'URL est le plus spécifique sera appliqué. Si aucun format n'est plus spécifique qu'un autre, celui qui apparaît en dernier dans la liste sera appliqué.\n\nLes noms d'en-tête doivent être conformes à la norme RFC 2616 (https://www.rfc-editor.org/rfc/rfc2616). Les valeurs d'en-tête ne doivent pas contenir les symboles NUL, CR ni LF. La taille des en-têtes individuels ne doit pas dépasser 8 ko. Les en-têtes et les formats d'URL non valides seront ignorés.\n\nCette règle est limitée à un total de 500 formats d'URL pour l'ensemble des règles. Chaque règle peut contenir au maximum 20 en-têtes. Les formats et les en-têtes au-delà de ces seuils seront ignorés.\n\nRemarque : Si un format d'URL correspond à des schémas non chiffrés (http://, ws:// ou lorsque le schéma est omis), les en-têtes configurés pourraient être transmis en texte brut sur un canal non chiffré et être exposés aux observateurs sur le réseau. Pour protéger les valeurs d'en-tête sensibles ou permettant une identification, limitez les formats d'URL aux schémas chiffrés (https:// ou wss://).\nConsultez la page https://chromeenterprise.google/policies/?policy=HttpHeaderInjection pour en savoir plus sur le schéma et le formatage.";
HttpsOnlyMode.pfm_title = "Autoriser l'activation du mode HTTPS uniquement";
HttpsOnlyMode.pfm_description = "allowed - Ne pas restreindre le paramètre du mode HTTPS uniquement pour les utilisateurs\ndisallowed - Désactiver le mode HTTPS uniquement\nforce_enabled - Activer le mode HTTPS uniquement en mode strict\nforce_balanced_enabled - Activer le mode HTTPS uniquement en mode équilibré\nCette règle détermine si les utilisateurs peuvent activer ou non le mode HTTPS uniquement (toujours utiliser une connexion sécurisée) dans les paramètres. Ce mode fait passer toutes les navigations en HTTPS.\n\nSi ce paramètre n'est pas défini ou s'il est défini sur \"allowed\", les utilisateurs seront autorisés à activer le mode HTTPS uniquement.\n\nSi ce paramètre est défini sur \"disallowed\", le mode HTTPS uniquement sera désactivé.\n\nSi ce paramètre est défini sur \"force_enabled\", le mode HTTPS uniquement sera activé en mode strict.\n\nSi ce paramètre est défini sur \"force_balanced_enabled\", le mode HTTPS uniquement sera activé en mode équilibré.\n\n\"force_enabled\" est pris en charge à partir de M112 et \"force_balanced_enabled\" à partir de M129.\n\n\"force_enabled\" et \"force_balanced_enabled\" peuvent aussi être recommandés aux utilisateurs.\nLe mode HTTPS uniquement sera initialement défini sur \"Strict\" ou \"Équilibré\", mais les utilisateurs pourront le modifier.\n\nSi vous définissez cette règle sur une valeur non prise en charge par la version de Chrome qui la reçoit, Chrome utilisera le paramètre autorisé par défaut.\n\nLa règle HttpAllowlist distincte permet d'éviter que cette fonctionnalité mette à niveau des noms d'hôte ou des modèles du nom d'hôte spécifiques vers HTTPS.";
HttpsUpgradesEnabled.pfm_title = "Activer les mises à niveau automatiques vers HTTPS";
HttpsUpgradesEnabled.pfm_description = "Brave essaie de mettre à niveau une partie de la navigation de HTTP vers HTTPS, lorsque cela est possible. Cette règle peut servir à désactiver ce comportement. Si elle est définie sur \"True\" ou n'est pas configurée, cette fonctionnalité est activée par défaut.\n\nLa règle HttpAllowlist distincte permet d'éviter que cette fonctionnalité mette à niveau des noms d'hôte ou des modèles du nom d'hôte spécifiques vers HTTPS.\n\nVoir également la règle HttpsOnlyMode.";
IPv6ReachabilityOverrideEnabled.pfm_title = "Activer l'annulation du contrôle de joignabilité IPv6";
IPv6ReachabilityOverrideEnabled.pfm_description = "Si cette règle est définie sur \"True\", le contrôle d'accessibilité IPv6 est ignoré. Cela signifie que le système interroge toujours les enregistrements AAAA lors de la résolution des noms d'hôte. Cela s'applique à l'ensemble des utilisateurs et des interfaces de l'appareil.\n\nSi cette règle n'est pas définie ou si elle est définie sur \"False\", le contrôle de joignabilité IPv6 n'est pas ignoré.\nLe système n'interroge les enregistrements AAAA que si un hôte IPv6 global peut y accéder.";
IdleDetectionAllowedForUrls.pfm_title = "Sites autorisés pour la détection d'inactivité";
IdleDetectionAllowedForUrls.pfm_description = "Permet de lister les formats d'URL pour lesquels les sites sont autorisés à utiliser l'API Idle Detection sans demander l'autorisation de l'utilisateur. Les entrées de la liste de blocage ont une priorité plus élevée que celles de la liste d'autorisation, qui ont une priorité plus élevée que la valeur configurée par défaut.\n\nPour en savoir plus sur les formats d'URL de site valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés. Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.\n\nSi cette règle n'est pas configurée, la valeur globale par défaut est utilisée pour tous les sites. Cette valeur est configurée par la règle DefaultIdleDetectionSetting (Paramètre de détection d'inactivité par défaut) si celle-ci est définie ou, à défaut, par la configuration personnelle de l'utilisateur.";
IdleDetectionBlockedForUrls.pfm_title = "Sites bloqués pour la détection d'inactivité";
IdleDetectionBlockedForUrls.pfm_description = "Permet de lister les formats d'URL pour lesquels les sites ne sont pas autorisés à utiliser l'API Idle Detection.\n\nPour en savoir plus sur les formats d'URL de sites valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés. Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.\n\nSi cette règle n'est pas configurée, la valeur globale par défaut est utilisée pour tous les sites. Cette valeur est configurée par la règle DefaultIdleDetectionSetting (Paramètre de détection d'inactivité par défaut) si celle-ci est définie ou, à défaut, par la configuration personnelle de l'utilisateur.";
IdleTimeout.pfm_title = "Délai avant exécution des actions en cas d'inactivité";
IdleTimeout.pfm_description = "Déclenche une action lorsque l'ordinateur est inactif.\n\nSi cette règle est définie, elle spécifie le délai (en minutes) sans entrée utilisateur avant que le navigateur exécute les actions configurées dans la règle IdleTimeoutActions.\n\nSi elle n'est pas configurée, aucune action n'est exécutée.\n\nLe délai minimal est d'une minute.\n\nUne \"entrée utilisateur\" est définie par les API du système d'exploitation et inclut, par exemple, un déplacement de la souris ou une saisie au clavier.";
IdleTimeoutActions.pfm_title = "Actions à exécuter lorsque l'ordinateur est inactif";
IdleTimeoutActions.pfm_description = "close_browsers - Fermer les navigateurs\nshow_profile_picker - Affichez le sélecteur de profil\nclear_browsing_history - Effacer l'historique de navigation\nclear_download_history - Effacer l'historique des téléchargements\nclear_cookies_and_other_site_data - Effacer les cookies et autres données de sites\nclear_cached_images_and_files - Effacer les images et les fichiers mis en cache\nclear_password_signin - Effacer la connexion par mot de passe\nclear_autofill - Effacer la saisie automatique\nclear_site_settings - Effacer les paramètres des sites\nclear_hosted_app_data - Effacer les données d'application hébergée\nreload_pages - Actualiser les pages\nsign_out - Déconnexion\nclose_tabs - Fermer les onglets\nListe des actions à exécuter lorsque le délai d'inactivité de la règle IdleTimeout est atteint.\n\nAvertissement : La définition de cette règle peut affecter les données personnelles locales et entraîner leur suppression définitive. Nous vous recommandons de tester vos paramètres avant de les déployer pour éviter toute suppression accidentelle de données personnelles.\n\nCette règle n'a aucune incidence si la règle IdleTimeout n'est pas configurée.\n\nLorsque le délai d'inactivité de la règle IdleTimeout est atteint, le navigateur exécute les actions configurées dans celle-ci.\n\nLa règle IdleTimeout n'a aucune incidence si elle est vide ou si elle n'est pas configurée.\n\nActions acceptées :\n\nclose_browsers : ferme toutes les fenêtres de navigateur et les PWA pour ce profil. Non disponible sur Android et iOS.\n\nclose_tabs : ferme tous les onglets ouverts dans les fenêtres ouvertes. Uniquement disponible sur iOS.\n\nshow_profile_picker : affiche la fenêtre de sélection des profils. Non disponible sur Android et iOS.\n\nsign_out : déconnecte l'utilisateur actuellement connecté. Uniquement disponible sur iOS.\n\nclear_browsing_history, clear_download_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing, clear_autofill, clear_site_settings, clear_hosted_app_data : efface les données de navigation correspondantes. Pour en savoir plus, consultez la règle ClearBrowsingDataOnExitList. Les types compatibles avec iOS sont clear_browsing_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing et clear_autofill.\n\nreload_pages : actualise toutes les pages Web. L'utilisateur peut d'abord être invité à confirmer l'opération pour certaines pages. Non disponible sur iOS.\n\nL'utilisateur restera connecté à son compte Google lorsqu'il supprimera les cookies à l'aide de clear_cookies_and_other_site_data.\n\nSi vous configurez clear_browsing_history, clear_password_signing, clear_autofill et clear_site_settings, la synchronisation sera désactivée pour les types de données respectifs si Chrome Sync n'est pas désactivé en définissant la règle SyncDisabled et si BrowserSignin n'est pas désactivé.";
ImagesAllowedForUrls.pfm_title = "Autoriser les images sur ces sites";
ImagesAllowedForUrls.pfm_description = "Permet de dresser la liste des formats d'URL pour lesquels les sites peuvent afficher des images.\n\nSi cette règle n'est pas configurée, la règle DefaultImagesSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.\n\nNotez que cette règle était auparavant activée par erreur pour Android. Toutefois, cette fonctionnalité n'a jamais été parfaitement compatible avec Android.";
ImagesBlockedForUrls.pfm_title = "Bloquer les images sur ces sites";
ImagesBlockedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites ne peuvent pas afficher d'images.\n\nSi cette règle n'est pas configurée, la règle DefaultImagesSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\n Pour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.\n\n Notez que cette règle était auparavant activée par erreur pour Android. Toutefois, cette fonctionnalité n'a jamais été parfaitement compatible avec Android.";
ImportAutofillFormData.pfm_title = "Importer les données de saisie automatique du navigateur par défaut à la première exécution";
ImportAutofillFormData.pfm_description = "Si cette règle est activée, les données de saisie automatique enregistrées dans le précédent navigateur par défaut sont importées lors de la première exécution. Si cette règle est désactivée ou qu'elle n'est pas configurée, les données de saisie automatique ne sont pas importées lors de la première exécution.\n\nLes utilisateurs peuvent ouvrir une boîte de dialogue d'importation. La case correspondant aux données de saisie automatique sera ou ne sera pas cochée, suivant la configuration de cette règle.";
ImportBookmarks.pfm_title = "Importer les favoris du navigateur par défaut à la première exécution";
ImportBookmarks.pfm_description = "Si cette règle est activée, les favoris enregistrés dans le précédent navigateur par défaut sont importés lors de la première exécution. Si cette règle est désactivée ou qu'elle n'est pas configurée, les favoris ne sont pas importés lors de la première exécution.\n\nLes utilisateurs peuvent ouvrir une boîte de dialogue d'importation. La case correspondant aux favoris sera ou ne sera pas cochée, suivant la configuration de cette règle.";
ImportHistory.pfm_title = "Importer l'historique de navigation du navigateur par défaut à la première exécution";
ImportHistory.pfm_description = "Si cette règle est activée, l'historique de navigation du précédent navigateur par défaut est importé lors de la première exécution. Si cette règle est désactivée ou qu'elle n'est pas configurée, l'historique de navigation n'est pas importé lors de la première exécution.\n\nLes utilisateurs peuvent ouvrir une boîte de dialogue d'importation. La case correspondant à l'historique de navigation sera ou ne sera pas cochée, suivant la configuration de cette règle.";
ImportHomepage.pfm_title = "Importer la page d'accueil du navigateur par défaut à la première exécution";
ImportHomepage.pfm_description = "Si cette règle est activée, la page d'accueil configurée dans le précédent navigateur par défaut sera importée lors de la première exécution. Si cette règle est désactivée ou qu'elle n'est pas configurée, la page d'accueil n'est pas importée lors de la première exécution.\n\nLes utilisateurs peuvent ouvrir une boîte de dialogue d'importation. La case correspondant à la page d'accueil sera cochée ou non selon la configuration de cette règle.";
ImportSavedPasswords.pfm_title = "Importer les mots de passe enregistrés du navigateur par défaut à la première exécution";
ImportSavedPasswords.pfm_description = "Cette règle ne contrôle que le comportement d'importation à la première exécution après l'installation. Elle permet une transition plus fluide vers Brave dans les environnements où un autre navigateur était souvent utilisé avant l'installation de celui-ci. Cette règle n'affecte pas les fonctionnalités du gestionnaire de mots de passe pour les comptes Google.\n\nSi cette règle est activée, les mots de passe enregistrés sont importés à la première exécution à partir du navigateur par défaut précédent. Ils peuvent aussi être importés manuellement depuis la page des paramètres.\nSi cette règle est désactivée, aucun mot de passe enregistré n'est importé à la première exécution, et l'importation manuelle depuis la page des paramètres est bloquée.\nSi cette règle n'est pas configurée, aucun mot de passe enregistré n'est importé à la première exécution, mais l'utilisateur peut en décider autrement depuis la page des paramètres.";
ImportSearchEngine.pfm_title = "Importer les moteurs de recherche du navigateur par défaut à la première exécution";
ImportSearchEngine.pfm_description = "Si cette règle est activée, le moteur de recherche par défaut du précédent navigateur par défaut est importé lors de la première exécution. Si cette règle est désactivée ou qu'elle n'est pas configurée, le moteur de recherche par défaut n'est pas importé lors de la première exécution.\n\nLes utilisateurs peuvent ouvrir une boîte de dialogue d'importation. La case correspondant au moteur de recherche par défaut sera ou ne sera pas cochée, suivant la configuration de cette règle.";
IncognitoModeAvailability.pfm_title = "Disponibilité du mode navigation privée";
IncognitoModeAvailability.pfm_description = "0 - Mode navigation privée disponible\n1 - Mode navigation privée désactivé\n2 - Mode navigation privée forcé\nIndique si l'utilisateur est autorisé à ouvrir des pages en mode navigation privée dans Brave.\n\nSi la règle est activée ou n'est pas définie, l'utilisateur peut ouvrir des pages en mode navigation privée.\n\nSi elle est désactivée, l'utilisateur ne peut pas le faire.\n\nSi elle est imposée, l'utilisateur peut ouvrir des pages UNIQUEMENT en mode navigation privée. Cette dernière option ne fonctionne pas sur Android dans Chrome.\n\nLa règle IncognitoModeUrlAllowlist est prioritaire sur cette règle et peut réactiver le mode navigation privée pour des URL spécifiques. Lorsque le mode navigation privée est désactivé par cette règle et qu'une liste d'autorisation est fournie, le mode navigation privée n'est disponible que pour les URL correspondant à la liste d'autorisation, tandis que toutes les autres pages sont bloquées.\n\nRemarque : Sur iOS, si cette règle est modifiée en cours de session, la modification ne prend effet qu'au redémarrage du navigateur.";
IncognitoModeUrlAllowlist.pfm_title = "Autoriser l'accès à une liste d'URL en mode navigation privée.";
IncognitoModeUrlAllowlist.pfm_description = "Cette règle permet d'autoriser l'accès en mode navigation privée aux URL de la liste. Utilisez-la pour définir des exceptions à certains formats d'URL définis dans IncognitoModeUrlBlocklist, à l'aide du format spécifié sur ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ).\n\nSi cette règle et IncognitoModeUrlBlocklist sont toutes deux configurées, la liste d'autorisation prévaut. Si une URL correspond à un format de la liste d'autorisation, elle est autorisée. Si elle correspond à un format de la liste de blocage (mais pas à un format de la liste d'autorisation), elle est bloquée. Si une URL ne correspond à aucun format des deux listes, les règles générales URLBlocklist/URLAllowlist sont utilisées comme règles de remplacement.\n\nSi cette règle est configurée et que IncognitoModeUrlBlocklist ne l'est pas, toute URL ne figurant pas dans la liste d'autorisation est bloquée en mode navigation privée.\n\nSi IncognitoModeAvailability est défini sur \"Interdire\" (valeur 1), mais que cette règle est configurée, le mode navigation privée n'est disponible que pour les URL correspondant à la liste d'autorisation.\n\nSi cette règle n'est pas configurée, aucune exception à IncognitoModeUrlBlocklist et IncognitoModeAvailability n'est autorisée.\n\nCette règle ne concerne que le mode navigation privée. Pour autoriser les URL pour tous les profils utilisateur, veuillez utiliser la règle URLAllowlist.\n\nLes caractères génériques d'hôte globaux (par exemple, \"*\" ou \"[*]\") ne sont pas autorisés. Utilisez la règle IncognitoModeAvailability pour activer la fonctionnalité à l'échelle mondiale.\n\nCette règle est limitée à 1 000 entrées.";
IncognitoModeUrlBlocklist.pfm_title = "Bloquer l'accès à une liste d'URL en mode navigation privée.";
IncognitoModeUrlBlocklist.pfm_description = "Si vous définissez la règle IncognitoModeUrlBlocklist, les pages Web dont les URL sont interdites ne peuvent pas se charger en mode navigation privée. Les administrateurs peuvent spécifier la liste des formats d'URL à bloquer. Découvrez les formats d'URL à respecter ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ).\n\nSi cette règle et la règle IncognitoModeUrlAllowlist sont toutes deux configurées, la liste d'autorisation prévaut. Si une URL correspond à un format de la liste d'autorisation, elle est autorisée. Si elle correspond à un format de la liste de blocage, mais pas à un format de la liste d'autorisation, elle est bloquée. Si une URL ne correspond à aucun format des deux listes, les règles générales URLBlocklist/URLAllowlist sont utilisées comme règles de remplacement.\n\nSi la règle IncognitoModeUrlAllowlist est configurée et que cette règle ne l'est pas, toute URL ne figurant pas sur la liste d'autorisation est bloquée en mode navigation privée.\n\nSi la règle IncognitoModeAvailability est définie sur \"Interdire\" (valeur 1), mais que la règle IncognitoModeUrlAllowlist est configurée, le mode navigation privée n'est disponible que pour les URL correspondant à la liste d'autorisation.\n\nCette règle ne concerne que le mode navigation privée. Pour bloquer des URL pour tous les profils utilisateur, veuillez utiliser la règle URLBlocklist.\n\nCette règle est limitée à 1 000 entrées.";
InsecureContentAllowedForUrls.pfm_title = "Autoriser le contenu non sécurisé sur ces sites";
InsecureContentAllowedForUrls.pfm_description = "Permet de lister les formats d'URL pour les sites autorisés à afficher du contenu mixte blocable (actif) (c'est-à-dire du contenu HTTP affiché sur des sites HTTPS) et pour lesquels la mise à niveau du contenu mixte blocable de manière facultative est désactivée.\n\nSi cette règle n'est pas configurée, le contenu mixte blocable est bloqué, et le contenu mixte blocable de manière facultative est mis à niveau. Les utilisateurs peuvent définir des exceptions autorisant l'affichage de ce contenu sur des sites spécifiques.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
InsecureContentBlockedForUrls.pfm_title = "Bloquer le contenu non sécurisé sur ces sites";
InsecureContentBlockedForUrls.pfm_description = "Permet de lister les formats d'URL pour les sites qui ne sont pas autorisés à afficher du contenu mixte blocable (actif) (c'est-à-dire du contenu HTTP sur des sites HTTPS) et pour lesquels le contenu mixte blocable de manière facultative (passif) sera mis à niveau.\n\nSi cette règle n'est pas configurée, le contenu mixte blocable sera bloqué, et le contenu mixte blocable de manière facultative sera mis à niveau. Toutefois, les utilisateurs pourront définir des exceptions autorisant l'affichage de ce contenu sur des sites spécifiques.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
IntensiveWakeUpThrottlingEnabled.pfm_title = "Contrôler la fonctionnalité IntensiveWakeUpThrottling.";
IntensiveWakeUpThrottlingEnabled.pfm_description = "Si elle est activée, la fonctionnalité IntensiveWakeUpThrottling limite et regroupe de façon agressive les minuteurs JavaScript dans les onglets en arrière-plan. Par conséquent, ceux-ci ne s'exécutent pas plus d'une fois par minute après la mise en arrière-plan d'une page pendant au moins cinq minutes.\n\nBien que conforme aux normes Web, cette fonctionnalité peut perturber le fonctionnement\nde certains sites Web en retardant des actions (jusqu'à une\nminute). Cependant, son activation permet de réduire de manière significative la consommation du processeur et de la\nbatterie. Pour en savoir plus, consultez https://bit.ly/30b1XR4.\n\nSi cette règle est activée, l'activation de la fonctionnalité est forcée. Les utilisateurs ne peuvent pas ignorer\nce paramètre.\n\nSi cette règle est désactivée, la désactivation de la fonctionnalité est forcée. Les utilisateurs ne peuvent pas ignorer\nce paramètre.\n\nSi cette règle n'est pas définie, le contrôle de la fonctionnalité s'opérera selon\nsa propre logique interne, que les utilisateurs peuvent configurer manuellement.\n\nNotez que la règle est appliquée individuellement pour chaque processus de moteur de rendu. La dernière valeur du paramètre de règle s'applique\nau démarrage du processus d'un moteur de rendu. Un redémarrage complet\nest requis pour garantir que le même paramètre de règle s'applique à l'ensemble des\nonglets chargés. L'exécution de processus basés sur des valeurs différentes pour cette règle\nest sans danger.\n";
IntranetRedirectBehavior.pfm_title = "Comportement de redirection vers un intranet";
IntranetRedirectBehavior.pfm_description = "0 - Utiliser le comportement par défaut du navigateur.\n1 - Désactiver les contrôles d'interception des requêtes DNS et les barres d'infos \"Essayez avec http://siteintranet/\".\n2 - Désactiver les contrôles d'interception des requêtes DNS ; autoriser les barres d'infos \"Essayez avec http://siteintranet/\".\n3 - Autoriser les contrôles d'interception des requêtes DNS et les barres d'infos \"Essayez avec http://siteintranet/\".\nCette règle configure le comportement des redirections vers un intranet via les contrôles d'interception des requêtes DNS. Ces contrôles ont pour but de déterminer si le navigateur est situé derrière un proxy qui redirige les noms d'hôte inconnus.\n\nSi cette règle n'est pas configurée, le navigateur suit le comportement par défaut des contrôles d'interception des requêtes DNS et des suggestions de redirection vers un intranet. Dans la version M88, ces contrôles sont activés par défaut, mais ils seront désactivés par défaut dans la release à venir.\n\nDNSInterceptionChecksEnabled est une règle associée pouvant également désactiver les contrôles d'interception des requêtes DNS. Elle est plus flexible, peut contrôler séparément les barres d'infos de redirection vers un intranet et pourrait être développée à l'avenir.\nSi DNSInterceptionChecksEnabled ou cette règle l'exige, les contrôles d'interception seront désactivés.";
IsolateOrigins.pfm_title = "Activer l'isolation des sites pour des origines définies";
IsolateOrigins.pfm_description = "Indique une liste d'origines qui s'exécutent dans un processus dédié.\n\nSur Android, cette règle ne fonctionne que sur les appareils disposant d'une mémoire suffisante (strictement plus de 3,2 Go de RAM), car isoler trop de sites sur des appareils limités en ressources peut entraîner des problèmes de performances. Pour les appareils Android aux ressources limitées, veuillez plutôt utiliser IsolateOriginsShortlist.\n\nIl n'est pas recommandé de configurer spécifiquement l'isolation des processus sur les appareils disposant de moins de 1 Go de mémoire.\n\nLe processus de chaque origine définie ne pourra contenir que des documents de cette origine et de ses sous-domaines. Par exemple, spécifier https://a1.example.com/ autorise https://a2.a1.example.com/ dans le même processus, mais pas https://example.com ni https://b.example.com.\n\nDepuis Brave 77, vous pouvez aussi spécifier une plage d'origines à isoler à l'aide d'un caractère générique. Par exemple, spécifier https://[*.]corp.example.com attribuera à chaque origine sous https://corp.example.com son propre processus dédié, y compris https://corp.example.com, https://a1.corp.example.com et https://a2.a1.corp.example.com.\n\nNotez que tous les sites (c'est-à-dire le schéma avec eTLD+1 tel que https://example.com) sont déjà isolés par défaut sur les plates-formes de bureau, comme indiqué dans la règle SitePerProcess. La règle IsolateOrigins est utile pour isoler des origines spécifiques plus précisément (ex. : https://a.example.com).\n\nSachez qu‘Android isole certains sites sensibles par défaut depuis Brave 77. Cette règle étend ce mode d'isolation aux sites d'autres origines en particulier.\n\nNotez aussi que les origines isolées par cette règle ne pourront pas scripter d'autres origines dans le même site, ce qui est sinon possible lorsque deux documents du même site modifient leurs valeurs document.domain pour qu'elles correspondent. Les administrateurs doivent vérifier que ce comportement inhabituel n'est pas utilisé sur une origine avant de l'isoler.\n\nSi cette règle est définie sur une chaîne vide ou qu'elle n'est pas configurée, l'isolation de sites n'est pas requise pour les origines spécifiques. Les utilisateurs peuvent quand même activer manuellement l'isolation des processus via le flag de ligne de commande.";
JavaScriptAllowedForUrls.pfm_title = "Autoriser JavaScript sur ces sites";
JavaScriptAllowedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites peuvent exécuter JavaScript.\n\nSi cette règle n'est pas configurée, la règle DefaultJavaScriptSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
JavaScriptBlockedForUrls.pfm_title = "Bloquer JavaScript sur ces sites";
JavaScriptBlockedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites ne peuvent pas exécuter JavaScript.\n\nSi cette règle n'est pas configurée, la règle DefaultJavaScriptSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.\n\nNotez que cette règle bloque JavaScript selon que l'origine du document de premier niveau (généralement l'URL de la page qui s'affiche également dans la barre d'adresse) correspond ou non à l'un des formats. Par conséquent, cette règle n'est pas adaptée pour limiter les attaques de la chaîne d'approvisionnement Web. Par exemple, si vous indiquez le format \"https://[*.]foo.com/\", cela n'empêchera pas une page hébergée sur https://example.com d'exécuter un script chargé à partir de https://www.foo.com/example.js. De plus, si vous indiquez le format \"https://example.com/\", cela n'empêchera pas un document provenant de https://example.com d'exécuter des scripts, même s'il ne s'agit pas du document de premier niveau, mais d'un sous-cadre intégré dans une page hébergée sur une autre origine, par exemple https://www.bar.com.";
JavaScriptJitAllowedForSites.pfm_title = "Autoriser JavaScript à utiliser le JIT sur ces sites";
JavaScriptJitAllowedForSites.pfm_description = "Permet de lister les formats d'URL pour lesquels les sites sont autorisés à exécuter JavaScript avec le compilateur JIT (Just In Time) activé.\n\nPour en savoir plus sur les formats d'URL de site valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.\n\nDes exceptions à la règle peuvent être définies pour certains sous-domaines, ainsi que pour des sites entiers. Par exemple, une règle configurée uniquement pour sous-domaine.site.com s'applique à sous-domaine.site.com sans affecter site.com. Dans certains cas où un sous-domaine ne peut pas être isolé de son site parent, il peut hériter de la règle configurée sur site.com. Il est également possible que les exceptions ne prennent pas effet pour les frames chargés dans un onglet existant tant que le site n'a pas été ouvert dans un nouvel onglet. Sur les appareils Android disposant de peu de mémoire, il est possible que les exceptions propres à un site ne soient pas appliquées. Les sites utiliseront alors la règle DefaultJavaScriptJitSetting (si elle est définie) ou, par défaut, le paramètre JIT pour JavaScript du profil.\n\nPour appliquer des exceptions, Brave peut placer les sites ou sous-domaines dont le paramètre diffère de celui par défaut dans des processus dédiés. Cela peut augmenter l'utilisation de mémoire, en particulier sur Android ou lorsqu'un format de caractères génériques correspond à de nombreux sous-domaines, car chaque origine correspondante peut être isolée séparément. Les sous-domaines isolés ne peuvent pas non plus utiliser document.domain pour accéder à leur site parent.\n\nRemarque : Dans les versions 155 et antérieures, les exceptions aux règles n'étaient appliquées qu'au niveau des sites (eTLD+1). Une règle définie uniquement pour sous-domaine.site.com ne prenait pas effet, même pour sous-domaine.site.com. Elle devait être définie sur site.com pour s'appliquer à la fois à site.com et à sous-domaine.site.com.\nCette règle s'applique frame par frame et pas uniquement en fonction de l'URL d'origine de premier niveau. Par exemple, si site-1.com est listé dans la règle JavaScriptJitAllowedForSites, mais que site-1.com charge un frame contenant site-2.com, le JIT pour JavaScript est activé pour site-1.com, mais site-2.com utilise la règle DefaultJavaScriptJitSetting (si elle est définie) ou active le JIT pour JavaScript par défaut. Les entrées de la liste de blocage ont une priorité plus élevée que celles de la liste d'autorisation, qui ont une priorité plus élevée que la valeur configurée par défaut.\n\nSi cette règle n'est pas configurée pour un site, alors la règle DefaultJavaScriptJitSetting s'applique au site (si elle est configurée). Sinon, le JIT pour JavaScript est activé pour le site.";
JavaScriptJitBlockedForSites.pfm_title = "Empêcher JavaScript d'utiliser le JIT sur ces sites";
JavaScriptJitBlockedForSites.pfm_description = "Permet d'établir une liste de formats d'URL indiquant quels sites ne sont pas autorisés à exécuter JavaScript avec le compilateur JIT (Just In Time) activé.\n\nSi le JIT pour JavaScript est désactivé, Brave peut afficher le contenu Web plus lentement et aussi désactiver des parties de JavaScript, y compris WebAssembly. Cette désactivation peut également permettre à Brave d'afficher le contenu Web dans une configuration plus sûre.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.\n\nDes exceptions à la règle peuvent être définies pour certains sous-domaines, ainsi que pour des sites entiers. Par exemple, une règle configurée uniquement pour sous-domaine.site.com s'applique à sous-domaine.site.com sans affecter site.com. Dans certains cas où un sous-domaine ne peut pas être isolé de son site parent, il peut hériter de la règle configurée sur site.com. Il est également possible que les exceptions ne prennent pas effet pour les frames chargés dans un onglet existant tant que le site n'a pas été ouvert dans un nouvel onglet. Sur les appareils Android disposant de peu de mémoire, il est possible que les exceptions propres à un site ne soient pas appliquées. Les sites utiliseront alors la règle DefaultJavaScriptJitSetting (si elle est définie) ou, par défaut, le paramètre JIT pour JavaScript du profil.\n\nPour appliquer des exceptions, Brave peut placer les sites ou sous-domaines dont le paramètre diffère de celui par défaut dans des processus dédiés. Cela peut augmenter l'utilisation de mémoire, en particulier sur Android ou lorsqu'un format de caractères génériques correspond à de nombreux sous-domaines, car chaque origine correspondante peut être isolée séparément. Les sous-domaines isolés ne peuvent pas non plus utiliser document.domain pour accéder à leur site parent.\n\nRemarque : Dans les versions 155 et antérieures, les exceptions aux règles n'étaient appliquées qu'au niveau des sites (eTLD+1). Une règle définie uniquement pour sous-domaine.site.com ne prenait pas effet, même pour sous-domaine.site.com. Elle devait être définie sur site.com pour s'appliquer à la fois à site.com et à sous-domaine.site.com.\nCette règle s'applique frame par frame et pas uniquement en fonction de l'URL d'origine de premier niveau. Par exemple, si site-1.com est répertorié dans la règle JavaScriptJitBlockedForSites, mais que site-1.com charge un frame contenant site-2.com, le JIT pour JavaScript est désactivé pour site-1.com, mais site-2.com utilise la règle de DefaultJavaScriptJitSetting (si elle est définie) ou active le JIT pour JavaScript par défaut. Les entrées de la liste de blocage ont une priorité plus élevée que celles de la liste d'autorisation, qui ont une priorité plus élevée que la valeur configurée par défaut.\n\nSi cette règle n'est pas configurée pour un site, la règle DefaultJavaScriptJitSetting s'applique au site (si elle est configurée). Sinon, le JIT pour JavaScript est activé pour le site.";
JavaScriptOptimizerAllowedForSites.pfm_title = "Autoriser les optimisations JavaScript sur ces sites";
JavaScriptOptimizerAllowedForSites.pfm_description = "Permet de lister les formats d'URL des sites pour lesquels les optimisations JavaScript avancées sont activées.\n\nPour en savoir plus sur les formats d'URL de site valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns.\nLes caractères génériques (*) sont autorisés.\n\nDes exceptions à la règle peuvent être définies pour certains sous-domaines, ainsi que pour des sites entiers.\nPar exemple, une règle configurée uniquement pour sous-domaine.site.com s'applique à sous-domaine.site.com sans affecter site.com. Dans certains cas où un sous-domaine ne peut pas être isolé de son site parent, il peut hériter de la règle configurée sur site.com. Il est également possible que les exceptions ne prennent pas effet pour les frames chargés dans un onglet existant tant que le site n'a pas été ouvert dans un nouvel onglet. Sur les appareils Android disposant de peu de mémoire, il est possible que les exceptions propres à un site ne soient pas appliquées. Les sites utiliseront alors la règle DefaultJavaScriptOptimizerSetting (si elle est définie) ou, par défaut, le paramètre d'optimisation JavaScript du profil.\n\nPour appliquer des exceptions, Brave peut placer les sites ou sous-domaines dont le paramètre diffère de celui par défaut dans des processus dédiés. Cela peut augmenter l'utilisation de mémoire, en particulier sur Android ou lorsqu'un format de caractères génériques correspond à de nombreux sous-domaines, car chaque origine correspondante peut être isolée séparément. Les sous-domaines isolés ne peuvent pas non plus utiliser document.domain pour accéder à leur site parent.\n\nRemarque : Dans les versions 138 et antérieures, les exceptions aux règles n'étaient appliquées qu'au niveau des sites (eTLD+1). Une règle définie uniquement pour sous-domaine.site.com ne prenait pas effet, même pour sous-domaine.site.com. Elle devait être définie sur site.com pour s'appliquer à la fois à site.com et à sous-domaine.site.com. Cette règle s'applique frame par frame et pas uniquement en fonction de l'URL d'origine de premier niveau. Par exemple, si site-1.com est listé dans la règle JavaScriptOptimizerAllowedForSites, mais que site-1.com charge un frame contenant site-2.com, les optimisations JavaScript sont activées pour site-1.com, mais site-2.com utilise la règle DefaultJavaScriptOptimizerSetting (si elle est définie) ou active les optimisations JavaScript par défaut. Les entrées de la liste de blocage ont une priorité plus élevée que celles de la liste d'autorisation, qui ont une priorité plus élevée que la valeur configurée par défaut.\n\nSi cette règle n'est pas configurée pour un site, alors la règle DefaultJavaScriptOptimizerSetting s'applique au site (si elle est configurée). Sinon, les optimisations JavaScript sont activées pour le site.";
JavaScriptOptimizerBlockedForSites.pfm_title = "Bloquer les optimisations JavaScript sur ces sites";
JavaScriptOptimizerBlockedForSites.pfm_description = "Permet d'établir une liste de formats d'URL indiquant les sites pour lesquels les optimisations JavaScript avancées sont désactivées.\n\nSi les optimisations JavaScript sont désactivées, Brave peut afficher le contenu Web plus lentement.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns.\nLes caractères génériques (*) sont autorisés.\n\nDes exceptions à la règle peuvent être définies pour certains sous-domaines, ainsi que pour des sites entiers.\nPar exemple, une règle configurée uniquement pour sous-domaine.site.com s'applique à sous-domaine.site.com sans affecter site.com. Dans certains cas où un sous-domaine ne peut pas être isolé de son site parent, il peut hériter de la règle configurée sur site.com. Il est également possible que les exceptions ne prennent pas effet pour les frames chargés dans un onglet existant tant que le site n'a pas été ouvert dans un nouvel onglet. Sur les appareils Android disposant de peu de mémoire, il est possible que les exceptions propres à un site ne soient pas appliquées. Les sites utiliseront alors la règle DefaultJavaScriptOptimizerSetting (si elle est définie) ou, par défaut, le paramètre d'optimisation JavaScript du profil.\n\nPour appliquer des exceptions, Brave peut placer les sites ou sous-domaines dont le paramètre diffère de celui par défaut dans des processus dédiés. Cela peut augmenter l'utilisation de mémoire, en particulier sur Android ou lorsqu'un format de caractères génériques correspond à de nombreux sous-domaines, car chaque origine correspondante peut être isolée séparément. Les sous-domaines isolés ne peuvent pas non plus utiliser document.domain pour accéder à leur site parent.\n\nRemarque : Dans les versions 138 et antérieures, les exceptions aux règles n'étaient appliquées qu'au niveau des sites (eTLD+1). Une règle définie uniquement pour sous-domaine.site.com ne prenait pas effet, même pour sous-domaine.site.com. Elle devait être définie sur site.com pour s'appliquer à la fois à site.com et à sous-domaine.site.com. Cette règle s'applique frame par frame et pas uniquement en fonction de l'URL d'origine de premier niveau. Par exemple, si site-1.com est répertorié dans la règle JavaScriptOptimizerBlockedForSites, mais que site-1.com charge un frame contenant site-2.com, les optimisations JavaScript sont désactivées pour site-1.com, mais site-2.com utilise la règle de DefaultJavaScriptOptimizerSetting (si elle est définie) ou active les optimisations JavaScript par défaut. Les entrées de la liste de blocage ont une priorité plus élevée que celles de la liste d'autorisation, qui ont une priorité plus élevée que la valeur configurée par défaut.\n\nSi cette règle n'est pas configurée pour un site, alors la règle DefaultJavaScriptOptimizerSetting s'applique au site (si elle est configurée). Sinon, les optimisations JavaScript sont activées pour le site.";
LiveCaptionEnabled.pfm_title = "Activer les Sous-titres instantanés";
LiveCaptionEnabled.pfm_description = "Activer la fonctionnalité Sous-titres instantanés.\n\nSi cette règle est activée, les Sous-titres instantanés seront toujours activés.\n\nSi cette règle est désactivée, ils seront toujours désactivés.\n\nSi vous définissez cette règle comme obligatoire, les utilisateurs ne pourront ni la modifier, ni l'ignorer.\n\nSi cette règle n'est pas définie, les Sous-titres instantanés seront initialement désactivés, mais les utilisateurs pourront les activer à tout moment.";
LiveTranslateEnabled.pfm_title = "Activer la traduction instantanée";
LiveTranslateEnabled.pfm_description = "Activer la traduction instantanée de sous-titres. Les sous-titres seront envoyés à Google pour être traduits.\n\nSi cette règle est activée, la traduction instantanée sera toujours activée.\n\nSi cette règle est désactivée, la traduction instantanée sera toujours désactivée.\n\nSi vous définissez cette règle comme obligatoire, les utilisateurs ne pourront ni la modifier, ni l'ignorer.\n\nSi cette règle n'est pas définie, la traduction instantanée sera initialement désactivée, mais les utilisateurs pourront l'activer à tout moment.\n\nSi LiveCaptionEnabled est désactivée, la traduction instantanée sera désactivée, quel que soit le paramètre de cette règle.";
LocalFontsAllowedForUrls.pfm_title = "Accorder l'autorisation des polices locales pour ces sites";
LocalFontsAllowedForUrls.pfm_description = "Permet de dresser la liste des formats d'URL des sites qui accordent automatiquement l'autorisation d'utiliser des polices locales. Cela étend la capacité des sites à voir les informations sur les polices locales.\n\nPour en savoir plus sur les formats d'URL de site valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés. Cette règle ne tient compte que de l'origine. Tout chemin d'accès dans le format d'URL est donc ignoré.\n\nSi cette règle n'est pas définie pour un site, alors la règle DefaultLocalFontsSetting s'applique au site (si elle est définie). Sinon, les paramètres par défaut du navigateur s'appliquent, et les utilisateurs peuvent définir l'autorisation pour chaque site.";
LocalFontsBlockedForUrls.pfm_title = "Bloquer l'autorisation des polices locales pour ces sites";
LocalFontsBlockedForUrls.pfm_description = "Permet de dresser la liste des formats d'URL des sites qui refusent automatiquement l'autorisation d'utiliser des polices locales. Cela limite la capacité des sites à voir les informations sur les polices locales.\n\nPour en savoir plus sur les formats d'URL de site valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés. Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.\n\nSi cette règle n'est pas définie pour un site, alors la règle DefaultLocalFontsSetting s'applique au site (si elle est définie). Sinon, les paramètres par défaut du navigateur s'appliquent, et les utilisateurs peuvent définir l'autorisation pour chaque site.";
LocalNetworkAccessAllowedForUrls.pfm_title = "Autoriser les sites à adresser des requêtes réseau aux appareils locaux et aux points de terminaison du réseau local.";
LocalNetworkAccessAllowedForUrls.pfm_description = "Liste de formats d'URL. Les requêtes réseau initiées à partir de sites desservis par des origines qui figurent sur la liste ne sont pas soumises aux vérifications de l‘Local Network Access.\n\nPour les origines autres que celles représentées par les formats spécifiés ici, la configuration personnelle de l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.\n\nPour connaître les restrictions concernant l’Local Network Access, consultez https://wicg.github.io/local-network-access/.\n\nPlusieurs règles listent des origines qui ont un impact sur les requêtes adressées à des points de terminaison du réseau local et à l'appareil local. Ces règles s'appliquent selon l'ordre de priorité suivant si une origine figure sur la liste de formats d'URL de plusieurs d'entre elles :\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "Empêcher les sites d'adresser des requêtes réseau à des appareils locaux et à des points de terminaison du réseau local.";
LocalNetworkAccessBlockedForUrls.pfm_description = "Liste de formats d'URL. Les requêtes réseau initiées à partir de sites Web desservis par des origines qui figurent sur la liste ne sont pas autorisées à émettre de requêtes d‘Local Network Access.\n\nPour les origines autres que celles représentées par les formats spécifiés ici, la configuration personnelle de l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.\n\nPour connaître les restrictions concernant l’Local Network Access, consultez https://wicg.github.io/local-network-access/.\n\nPlusieurs règles listent des origines qui ont un impact sur les requêtes adressées à des points de terminaison du réseau local et à l'appareil local. Ces règles s'appliquent selon l'ordre de priorité suivant si une origine figure sur la liste de formats d'URL de plusieurs d'entre elles :\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "Remplacer les mappages d'espace d'adressage IP";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "Vous pouvez utiliser cette option pour traiter certaines plages d'adresses internes comme \"publiques\", afin qu'elles ne soient pas soumises aux vérifications de l‘Local Network Access. Inversement, cette option peut être utilisée pour traiter certaines plages d'adresses publiques susceptibles d'être utilisées en interne comme \"locales\", afin qu'elles soient protégées par des vérifications de l‘Local Network Access.\n\nLes remplacements d'espace d'adressage IP prennent deux formes :\n\n[cidr]=[public|local|loopback]\n\noù [cidr] est une plage d'adresses IP au format CIDR (voir la section 3.1 sur https://tools.ietf.org/html/rfc4632 pour IPv4 et la section 2.3 sur https://tools.ietf.org/html/rfc4291 pour IPv6). Les adresses IPv6 doivent être spécifiées au format URL-safe (entre crochets). Les remplacements CIDR s'appliquent à tous les ports.\n\nou\n\n[adresse IP]:[port]=[public|local|bouclage]\n\nPour en savoir plus sur l‘Local Network Access, consultez https://wicg.github.io/local-network-access/ et https://developer.chrome.com/blog/local-network-access.\n\nCette règle ne prend pas en charge l'actualisation dynamique.\n\nLes remplacements du commutateur de ligne de commande --ip-address-space-overrides prévalent sur les remplacements définis par cette règle.";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "Autoriser les demandes d'accès au réseau local (LNA) dans les sous-frames sans délégation explicite";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "Par défaut, les autorisations d'accès au réseau local (LNA) ne peuvent être demandées dans les sous-frames multi-origine que si elles sont explicitement déléguées. Cette règle peut être utilisée pour remplacer ce comportement par défaut afin que les autorisations LNA soient héritées par défaut dans les sous-frames, sauf si elles sont explicitement refusées dans la règle sur les autorisations.\n\nSi cette règle est activée, toutes les fonctionnalités de la règle sur les autorisations LNA sont déléguées par défaut aux sous-frames, qui peuvent envoyer des requêtes réseau locales (ce qui déclenche l'invite d'autorisation).\n\nSi cette règle est désactivée ou n'est pas configurée, la fonctionnalité de la règle sur les autorisations doit être déléguée explicitement aux sous-frames pour qu'ils puissent envoyer des requêtes réseau locales et déclencher l'invite d'autorisation.\n\nCette règle s'applique aux fonctionnalités \"local-network-access\", \"loopback-network\" et \"local-network\" de la règle sur les autorisations.\n\nPour en savoir plus sur l'accès au réseau local, consultez https://wicg.github.io/local-network-access/ et https://developer.chrome.com/blog/local-network-access.\n\nPour en savoir plus sur la règle sur les autorisations, consultez https://developer.mozilla.org/fr/docs/Web/HTTP/Guides/Permissions_Policy.";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "Indique si les restrictions d'accès au réseau local doivent être (temporairement) désactivées";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "Si cette règle est activée, les requêtes d’Local Network Access n'afficheront des avertissements dans les Chrome DevTools qu'en cas d'échec des vérifications d’Local Network Access.\n\nSi cette règle est désactivée ou n'est pas configurée, les requêtes d’Local Network Access utiliseront le traitement par défaut.\n\nPour connaître les restrictions concernant l’Local Network Access, consultez https://wicg.github.io/local-network-access/.\n\nCette règle d'entreprise est temporaire et sera supprimée après M163.\n\nÀ long terme, la règle LocalNetworkAccessAllowedForUrls\npeut être utilisée pour ajouter à la liste d'autorisation les formats d'URL auxquels l'autorisation d’Local Network Access doit être automatiquement accordée.";
LocalNetworkAllowedForUrls.pfm_title = "Autoriser les sites à envoyer des requêtes réseau à des points de terminaison du réseau local.";
LocalNetworkAllowedForUrls.pfm_description = "Liste de formats d'URL. Les requêtes réseau initiées à partir de sites desservis par des origines qui figurent sur la liste et adressées à des points de terminaison du réseau local ne sont pas soumises aux vérifications de Local Network Access.\n\nPour les origines autres que celles représentées par les formats spécifiés ici, la configuration personnelle de l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.\n\nPour connaître les restrictions concernant Local Network Access, consultez https://wicg.github.io/local-network-access/.\n\nPlusieurs règles listent des origines qui ont un impact sur les requêtes adressées à des points de terminaison du réseau local. Ces règles s'appliquent selon l'ordre de priorité suivant si une origine figure sur la liste de formats d'URL de plusieurs d'entre elles :\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkBlockedForUrls.pfm_title = "Empêcher les sites d'adresser des requêtes réseau à des points de terminaison du réseau local.";
LocalNetworkBlockedForUrls.pfm_description = "Liste de formats d'URL. Les requêtes réseau initiées à partir de sites Web desservis par des origines qui figurent sur la liste et adressées à des points de terminaison du réseau local ne sont pas autorisées à émettre de requêtes Local Network Access.\n\nPour les origines autres que celles représentées par les formats spécifiés ici, la configuration personnelle de l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.\n\nPour connaître les restrictions concernant Local Network Access, consultez https://wicg.github.io/local-network-access/.\n\nPlusieurs règles listent des origines qui ont un impact sur les requêtes adressées à des points de terminaison du réseau local. Ces règles s'appliquent selon l'ordre de priorité suivant si une origine figure sur la liste de formats d'URL de plusieurs d'entre elles :\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LookalikeWarningAllowlistDomains.pfm_title = "Supprimer les avertissements concernant des domaines similaires";
LookalikeWarningAllowlistDomains.pfm_description = "Cette règle empêche l'affichage d'avertissements concernant des URL similaires sur les sites répertoriés. Ces avertissements s'affichent généralement sur un site suspecté par Brave d'imiter frauduleusement un autre site connu de l'utilisateur.\n\nSi cette règle est activée et définie sur un ou plusieurs domaines, aucun avertissement ne s'affiche lorsque l'utilisateur consulte des pages sur ce ou ces domaines.\n\nSi la règle n'est pas définie ou si elle est définie sur une liste vide, ces avertissements peuvent s'afficher sur n'importe quel site consulté par l'utilisateur.\n\nUn nom d'hôte peut être autorisé dans le cadre d'une correspondance d'hôte exacte ou de toute correspondance de domaine. Par exemple, les avertissements peuvent être supprimés pour l'URL \"https://foo.example.com/bar\" si la liste inclut \"foo.example.com\" ou \"example.com\".";
LoopbackNetworkAllowedForUrls.pfm_title = "Autoriser les sites à adresser des requêtes réseau à l'appareil local.";
LoopbackNetworkAllowedForUrls.pfm_description = "Liste de formats d'URL. Les requêtes réseau initiées à partir de sites desservis par des origines qui figurent sur la liste et adressées à l'appareil local ne sont pas soumises aux vérifications de Local Network Access.\n\nPour les origines autres que celles représentées par les formats spécifiés ici, la configuration personnelle de l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.\n\nPour connaître les restrictions concernant Local Network Access, consultez https://wicg.github.io/local-network-access/.\n\nPlusieurs règles listent des origines qui ont un impact sur les requêtes adressées à l'appareil local. Ces règles s'appliquent selon l'ordre de priorité suivant si une origine figure sur la liste de formats d'URL de plusieurs d'entre elles :\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LoopbackNetworkBlockedForUrls.pfm_title = "Empêcher les sites d'adresser des requêtes réseau à l'appareil local.";
LoopbackNetworkBlockedForUrls.pfm_description = "Liste de formats d'URL. Les requêtes réseau initiées à partir de sites Web desservis par des origines qui figurent sur la liste et adressées à l'appareil local ne sont pas autorisées à émettre de requêtes Local Network Access.\n\nPour les origines autres que celles représentées par les formats spécifiés ici, la configuration personnelle de l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.\n\nPour connaître les restrictions concernant Local Network Access, consultez https://wicg.github.io/local-network-access/.\n\nPlusieurs règles listent des origines qui ont un impact sur les requêtes adressées à l'appareil local. Ces règles s'appliquent selon l'ordre de priorité suivant si une origine figure sur la liste de formats d'URL de plusieurs d'entre elles :\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
ManagedBookmarks.pfm_title = "Favoris gérés";
ManagedBookmarks.pfm_description = "Permet d'établir une liste des favoris où chacun d'eux est un dictionnaire comprenant les clés \"name\" et \"url\". Ces clés contiennent le nom et la cible du favori. Les administrateurs peuvent configurer un sous-dossier en définissant un favori sans clé \"url\", mais avec une clé \"children\" supplémentaire. Cette clé contient également une liste de favoris, dont certains peuvent être aussi des dossiers. Chrome modifie les URL incomplètes comme si elles avaient été soumises via la barre d'adresse. Par exemple, \"google.com\" devient \"https://google.com/\".\n\nLes utilisateurs ne peuvent pas modifier les dossiers dans lesquels les favoris sont placés (bien qu'ils puissent les masquer dans la barre de favoris). Le nom du dossier par défaut est \"Favoris gérés\", mais vous pouvez le modifier en ajoutant à la règle un sous-dictionnaire contenant la clé unique \"toplevel_name\" avec le nom de dossier souhaité comme valeur. Les favoris gérés ne sont pas synchronisés avec le compte utilisateur, et les extensions ne peuvent pas les modifier.\nConsultez la page https://chromeenterprise.google/policies/?policy=ManagedBookmarks pour en savoir plus sur le schéma et le formatage.";
ManagedConfigurationPerOrigin.pfm_title = "Définit des valeurs de configuration gérée pour des sites Web aux origines spécifiques.";
ManagedConfigurationPerOrigin.pfm_description = "Cette règle permet de définir la valeur de retour de l'API Managed Configuration pour l'origine donnée.\n\n L'API Managed Configuration est une configuration de type clé-valeur accessible via un appel JavaScript navigator.managed.getManagedConfiguration(). Cette API est uniquement disponible pour les origines qui correspondent aux appls Web installées d'office via WebAppInstallForceList.\n\nConsultez la page https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin pour en savoir plus sur le schéma et le formatage.";
MaxConnectionsPerProxy.pfm_title = "Nombre maximal de connexions simultanées par serveur proxy pour les requêtes non WebSocket";
MaxConnectionsPerProxy.pfm_description = "Cette règle permet de préciser le nombre maximal de connexions simultanées par serveur proxy pour les requêtes non WebSocket.\n\nPour modifier les limites de requêtes WebSocket, consultez MaxConnectionsPerProxyForWebSocket.\n\nSi cette règle n'est pas configurée, la valeur par défaut (128) est utilisée.\n\nCertaines applications Web sont connues pour utiliser de nombreuses connexions avec des requêtes GET en attente. Par conséquent, si vous définissez une valeur inférieure à 128, le réseau du navigateur pourrait se bloquer si trop d'applications Web avec des connexions de ce type sont ouvertes.\nToutefois, certains serveurs proxy ne peuvent pas gérer un nombre élevé de connexions simultanées par client. Pour résoudre ce problème, il suffit de définir cette règle sur une valeur inférieure.\n\nLa valeur doit être supérieure ou égale à 6.\nSi vous définissez une valeur inférieure à cette limite, la valeur limite (6) sera utilisée.\nToute diminution de la valeur par défaut (128) est effectuée à vos propres risques.\n\nLa valeur doit être inférieure ou égale à 256 (99 dans Brave 147 et versions antérieures).\nSi vous définissez une valeur supérieure à cette limite, la valeur limite (256, ou 99 dans Brave 147 et versions antérieures) sera utilisée.\nToute augmentation de la valeur par défaut (128) est effectuée à vos propres risques.\n\nVeuillez noter que les limites appliquées sont affectées par AllowSocketPoolSizeRandomizationForProxies.";
MaxConnectionsPerProxyForWebSocket.pfm_title = "Nombre maximal de connexions simultanées par serveur proxy pour les requêtes WebSocket";
MaxConnectionsPerProxyForWebSocket.pfm_description = "Cette règle permet de préciser le nombre maximal de connexions simultanées par serveur proxy pour les requêtes WebSocket.\n\nPour modifier les limites des requêtes non-WebSocket, consultez MaxConnectionsPerProxy.\n\nSi cette règle n'est pas configurée, la valeur par défaut (128) est utilisée.\n\nCertaines applications Web sont connues pour utiliser de nombreuses connexions avec des requêtes GET en attente. Par conséquent, si vous définissez une valeur inférieure à 128, le réseau du navigateur pourrait se bloquer si trop d'applications Web avec des connexions de ce type sont ouvertes.\nToutefois, certains serveurs proxy ne peuvent pas gérer un nombre élevé de connexions simultanées par client. Pour résoudre ce problème, il suffit de définir cette règle sur une valeur inférieure.\n\nLa valeur doit être supérieure ou égale à 6.\nSi vous définissez une valeur inférieure à cette limite, la valeur limite (6) sera utilisée.\nToute diminution de la valeur par défaut (128) est effectuée à vos propres risques.\n\nLa valeur doit être inférieure ou égale à 256.\nSi vous définissez une valeur supérieure à cette limite, la valeur limite (256) sera utilisée.\nToute augmentation de la valeur par défaut (128) est effectuée à vos propres risques.\n\nVeuillez noter que les limites appliquées sont affectées par AllowSocketPoolSizeRandomizationForProxies.";
MaxInvalidationFetchDelay.pfm_title = "Délai maximal de récupération après le rejet d'une règle";
MaxInvalidationFetchDelay.pfm_description = "Cette règle permet de spécifier, en millisecondes, le délai maximal entre la réception du rejet d'une règle et la récupération de la nouvelle règle auprès du service de gestion de l'appareil. Les valeurs valides sont comprises entre 1 000 (1 seconde) et 300 000 (5 minutes). Toute valeur en dehors de cette plage sera remplacée par la valeur minimale ou maximale la plus proche autorisée.\n\nSi cette règle n'est pas configurée, Brave utilise la valeur par défaut (10 secondes).";
MediaRecommendationsEnabled.pfm_title = "Activer les recommandations de contenus multimédias";
MediaRecommendationsEnabled.pfm_description = "Par défaut, le navigateur propose à l'utilisateur des recommandations personnalisées de contenus multimédias. Si cette règle est désactivée, l'utilisateur ne bénéficie pas de ces recommandations. Si cette règle est activée ou qu'elle n'est pas configurée, l'utilisateur peut voir ces recommandations.";
MediaRouterCastAllowAllIPs.pfm_title = "Autoriser Google Cast à se connecter aux appareils Cast sur toutes les adresses IP.";
MediaRouterCastAllowAllIPs.pfm_description = "Tant que la règle EnableMediaRouter n'est pas désactivée, l'activation de la règle MediaRouterCastAllowAllIPs connecte Google Cast aux appareils Cast pour toutes les adresses IP, et pas seulement les adresses privées décrites dans la RFC 1918 ou la RFC 4193.\n\nSi cette règle est désactivée, Google Cast ne se connecte aux appareils Cast que sur les adresses privées décrites dans la RFC 1918 ou la RFC 4193.\n\nSi cette règle n'est pas définie, Google Cast ne se connecte aux appareils Cast que sur les adresses privées décrites dans la RFC 1918 ou la RFC 4193, sauf si la fonctionnalité CastAllowAllIPs est activée.";
MemorySaverModeSavings.pfm_title = "Modifier le niveau d'économies de l'économiseur de mémoire";
MemorySaverModeSavings.pfm_description = "0 - Économies de mémoire modérées.\n1 - Économies de mémoire équilibrées.\n2 - Économies de mémoire maximales.\nCette règle modifie le niveau d'économies de l'économiseur de mémoire.\n\nCela n'est appliqué que lorsque l'économiseur de mémoire est activé via les paramètres ou la règle HighEfficiencyModeEnabled. Cela affecte aussi la façon dont les heuristiques sont utilisées pour déterminer quand supprimer les onglets. Par exemple, réduire la durée de vie d'un onglet inactif avant de le supprimer peut permettre d'économiser de la mémoire, mais cela signifie aussi que les onglets seront actualisés plus fréquemment, ce qui peut entraîner une mauvaise expérience utilisateur et un trafic réseau plus élevé.\n\nSi cette règle est définie sur 0, l'économiseur de mémoire permet d'obtenir des économies de mémoire modérées. Les onglets deviennent inactifs après une longue période.\n\nSi cette règle est définie sur 1, l'économiseur de mémoire permet d'obtenir des économies de mémoire équilibrées. Les onglets deviennent inactifs après une période optimale.\n\nSi cette règle est définie sur 2, l'économiseur de mémoire permet d'obtenir des économies de mémoire maximales. Les onglets deviennent inactifs après une courte période.\n\nSi cette règle n'est pas configurée, l'utilisateur final peut contrôler ce paramètre dans chrome://settings/performance.";
MetricsReportingEnabled.pfm_title = "Autoriser l'envoi de statistiques d'utilisation et de rapports d'erreur";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "Afficher les fiches sur la page Nouvel onglet";
NTPCardsVisible.pfm_description = "Cette règle permet d'afficher ou non des fiches sur la page Nouvel onglet. Ces fiches offrent des points d'accès pour lancer le parcours courant de l'utilisateur en fonction des habitudes de navigation de celui-ci.\n\nSi cette règle est activée, les fiches sont affichées sur la page Nouvel onglet à condition que du contenu soit disponible.\n\nSi cette règle est désactivée, les fiches ne sont pas affichées sur la page Nouvel onglet.\n\nSi cette règle n'est pas configurée, l'utilisateur peut contrôler l'affichage des fiches. Par défaut, les fiches sont affichées.\n";
NTPCustomBackgroundEnabled.pfm_title = "Autoriser les utilisateurs à personnaliser l'arrière-plan sur la page \"Nouvel onglet\"";
NTPCustomBackgroundEnabled.pfm_description = "Si cette règle est définie sur \"False\", les utilisateurs ne peuvent pas personnaliser l'arrière-plan sur la page \"Nouvel onglet\". Tout arrière-plan personnalisé actuel sera définitivement supprimé, même si la règle est définie sur \"True\" par la suite.\n\nSi celle-ci est définie sur \"True\" ou si elle n'est pas configurée, les utilisateurs peuvent personnaliser l'arrière-plan sur la page \"Nouvel onglet\".\n\nRemarque : Sur Android, la règle n'est appliquée au navigateur qu'après un redémarrage.";
NTPFooterExtensionAttributionEnabled.pfm_title = "Contrôler la visibilité de l'attribution à l'extension sur la page \"Nouvel onglet\"";
NTPFooterExtensionAttributionEnabled.pfm_description = "Cette règle détermine si une attribution à l'extension modifiant la page \"Nouvel onglet\" s'affiche dans le pied de cette page.\n\nPar défaut, si une extension a remplacé la page \"Nouvel onglet\" standard, un message attribuant ce changement à l'extension spécifique s'affiche dans le pied de page. Cette attribution inclut généralement un lien vers l'extension correspondante dans le Chrome Web Store.\n\nSi cette règle n'est pas configurée ou si elle est définie sur \"True\", l'attribution à l'extension est visible dans le pied de la page \"Nouvel onglet\" lorsqu'une extension contrôle cette page.\n\nSi cette règle est définie sur \"False\", l'attribution à l'extension dans le pied de la page \"Nouvel onglet\" est supprimée.";
NTPFooterManagementNoticeEnabled.pfm_title = "Contrôler la visibilité de l'avis de gestion sur la page \"Nouvel onglet\" des navigateurs gérés";
NTPFooterManagementNoticeEnabled.pfm_description = "Cette règle contrôle la visibilité de l'avis de gestion dans le pied de la page \"Nouvel onglet\". Par défaut, le pied de la page \"Nouvel onglet\" affiche des informations lorsque le navigateur est géré par une organisation (indiqué par une icône représentant un bâtiment et la mention \"Géré par [nom de domaine]\"). Vous pouvez personnaliser cette règle à l'aide des règles EnterpriseCustomLabelForBrowser et EnterpriseLogoUrlForBrowser.\n\nSi cette règle n'est pas configurée ou si elle est définie sur \"True\", les navigateurs gérés affichent un avertissement indiquant \"Géré par…\" accompagné d'une icône.\n\nSi cette règle est définie sur \"False\", l'avis de gestion est masqué.\n\nNotez que cette règle ne s'applique qu'aux navigateurs gérés. Elle n'aura donc aucune incidence pour les utilisateurs gérés sur les navigateurs non gérés.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de la Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de la Chrome Enterprise Core.";
NTPOutlookCardVisible.pfm_title = "Afficher la carte Agenda Outlook sur la page \"Nouvel onglet\"";
NTPOutlookCardVisible.pfm_description = "Cette règle contrôle la visibilité de la carte Outlook sur la page \"Nouvel onglet\". La carte ne s'affiche sur la page \"Nouvel onglet\" que si la règle est activée et si votre organisation a autorisé l'utilisation des données de l'agenda Outlook dans le navigateur.\n\nLes données Outlook ne seront pas stockées par le navigateur.\n\nLa carte Outlook affiche le prochain événement d'agenda, ainsi qu'un aperçu des autres réunions de la journée. Elle vise à résoudre le problème de changement de contexte et à améliorer la productivité en donnant aux utilisateurs un raccourci vers leur prochaine réunion.\n\nLa carte Microsoft Outlook nécessite une configuration supplémentaire par l'administrateur. Pour en savoir plus sur la connexion de la carte de la page \"Nouvel onglet\" de Chrome à Outlook, veuillez consulter https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nSi NTPCardsVisible est désactivé, la carte Outlook ne s'affiche pas. Si NTPCardsVisible est activé, la carte Outlook s'affiche si cette règle est également activée et s'il y a des données à afficher. Si NTPCardsVisible n'est pas défini, la carte Outlook s'affiche si cette règle est également activée, si l'utilisateur a activé la carte dans \"Personnaliser Chrome\" et s'il y a des données à afficher.";
NTPSharepointCardVisible.pfm_title = "Afficher la carte des fichiers SharePoint et OneDrive sur la page \"Nouvel onglet\"";
NTPSharepointCardVisible.pfm_description = "Cette règle contrôle la visibilité de la carte des fichiers SharePoint et OneDrive sur la page \"Nouvel onglet\". La carte ne s'affiche sur la page \"Nouvel onglet\" que si la règle est activée et si votre organisation a autorisé l'utilisation des données de fichiers SharePoint et OneDrive dans le navigateur.\n\nLes données SharePoint et OneDrive ne seront pas stockées par le navigateur.\n\nLa carte de recommandation de fichiers SharePoint et OneDrive affiche une liste de fichiers recommandés.  Elle vise à résoudre le problème de changement de contexte et à améliorer la productivité en donnant aux utilisateurs un raccourci vers leurs documents les plus importants.\n\nLa carte Microsoft SharePoint et OneDrive nécessite une configuration supplémentaire par l'administrateur. Pour en savoir plus sur la connexion de la carte de la page \"Nouvel onglet\" de Chrome à SharePoint, veuillez consulter https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nSi NTPCardsVisible est désactivé, la carte SharePoint et OneDrive ne s'affiche pas. Si NTPCardsVisible est activé, la carte SharePoint et OneDrive s'affiche si cette règle est également activée et s'il y a des données à afficher. Si NTPCardsVisible n'est pas défini, la carte SharePoint et OneDrive s'affiche si cette règle est également activée, si l'utilisateur a activé la carte dans \"Personnaliser Chrome\" et s'il y a des données à afficher.";
NTPShortcuts.pfm_title = "Définir des raccourcis sur la page \"Nouvel onglet\"";
NTPShortcuts.pfm_description = "Cette règle permet de préconfigurer jusqu'à 10 raccourcis personnalisés sur la page \"Nouvel onglet\" de Brave.\n\nSi cette règle est configurée, les utilisateurs verront ces raccourcis par défaut, en plus de leurs raccourcis personnels. Les utilisateurs peuvent contrôler la visibilité des raccourcis de leur organisation dans le panneau \"Personnaliser Chrome\".\n\nLes URL de raccourci doivent être uniques.\n\nSi allow_user_edit est définie sur \"True\", les utilisateurs peuvent modifier le nom du raccourci. Si la valeur est définie sur \"False\" ou n'est pas configurée, les utilisateurs ne peuvent pas modifier le nom.\n\nSi allow_user_delete est définie sur \"True\", les utilisateurs peuvent supprimer le raccourci. Si la valeur est définie sur \"False\" ou n'est pas configurée, les utilisateurs ne peuvent pas supprimer le raccourci.\nConsultez la page https://chromeenterprise.google/policies/?policy=NTPShortcuts pour en savoir plus sur le schéma et le formatage.";
NativeMessagingAllowlist.pfm_title = "Noms des hôtes de messagerie native à exclure de la liste de blocage";
NativeMessagingAllowlist.pfm_description = "Cette règle permet de spécifier les hôtes de messagerie native à exclure de la liste noire. Si vous définissez la valeur liée à la liste noire sur *, tous les hôtes de messagerie native sont refusés, sauf s'ils sont explicitement autorisés.\n\nTous les hôtes de messagerie native sont autorisés par défaut. Cependant, si tous sont refusés par la règle, l'administrateur peut utiliser la liste d'autorisation pour modifier cette règle.";
NativeMessagingBlocklist.pfm_title = "Noms des hôtes de messagerie native non autorisés (ou \"*\" pour tous)";
NativeMessagingBlocklist.pfm_description = "Cette règle permet de spécifier les hôtes de messagerie native qui ne doivent pas être chargés. Si vous définissez la valeur liée à la liste noire sur *, tous les hôtes de messagerie native sont refusés, sauf s'ils sont explicitement autorisés.\n\nSi cette règle n'est pas configurée, Brave charge tous les hôtes de messagerie native qui sont installés.";
NativeMessagingUserLevelHosts.pfm_title = "Autoriser les hôtes de messagerie natifs au niveau de l'utilisateur (installés sans l'autorisation d'un administrateur)";
NativeMessagingUserLevelHosts.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, Brave peut utiliser les hôtes de messagerie native installés au niveau de l'utilisateur.\n\nSi elle est désactivée, Brave ne peut utiliser ces hôtes que s'ils sont installés au niveau du système.";
NetworkPredictionOptions.pfm_title = "Activer la prédiction réseau";
NetworkPredictionOptions.pfm_description = "0 - Prédire les actions réseau lors d'une connexion au réseau\n1 - Prédire les actions réseau sur tous les réseaux, sauf les réseaux mobiles\n(Option abandonnée dans la version 50 et supprimée dans la version 52. Au-delà de la version 52, si la valeur 1 est définie, elle est traitée comme la valeur 0 : Prédire les actions réseau lors d'une connexion au réseau.)\n2 - Ne pas prédire d'actions réseau lors d'une connexion au réseau\nCette règle permet de contrôler la prédiction réseau dans Brave. Elle contrôle la prélecture des DNS, ainsi que la préconnexion et le prérendu TCP et SSL des pages Web.\n\nSi vous configurez cette règle, les utilisateurs ne peuvent pas la modifier. Si cette règle n'est pas configurée, la prédiction réseau est activée. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
NewTabPageLocation.pfm_title = "URL de la page \"Nouvel onglet\"";
NewTabPageLocation.pfm_description = "Cette règle permet de configurer l'URL de la page \"Nouvel onglet\" par défaut et d'empêcher les utilisateurs de la modifier.\n\nLa page \"Nouvel onglet\" s'affiche à l'ouverture de nouveaux onglets et de nouvelles fenêtres.\n\nCette règle ne détermine pas quelles pages seront ouvertes au démarrage. Celles-ci sont en effet gérées par les règles RestoreOnStartup. Cette règle concerne la page d'accueil et la page de démarrage si elle est configurée pour ouvrir la page \"Nouvel onglet\".\n\nIl est recommandé d'indiquer l'URL canonique. Si elle n'est pas totalement canonique, Brave utilise https:// par défaut.\n\nSi cette règle n'est pas configurée, ou si elle est vide, la page \"Nouvel onglet\" par défaut est utilisée.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
NotificationsAllowedForUrls.pfm_title = "Autoriser les notifications sur ces sites";
NotificationsAllowedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites peuvent afficher des notifications.\n\nSi cette règle n'est pas configurée, la règle DefaultNotificationsSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
NotificationsBlockedForUrls.pfm_title = "Bloquer les notifications sur ces sites";
NotificationsBlockedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites ne peuvent pas afficher de notifications.\n\nSi cette règle n'est pas configurée, la règle DefaultNotificationsSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
NtlmV2Enabled.pfm_title = "Activer l'authentification NTLMv2.";
NtlmV2Enabled.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, l'authentification NTLMv2 est activée.\n\nSi cette règle est désactivée, l'authentification NTLMv2 l'est également.\n\nToutes les versions récentes des serveurs Samba et Microsoft® Windows® acceptent cette authentification. Pour des raisons de sécurité, cette règle ne doit être désactivée qu'à des fins de rétrocompatibilité.";
OopPrintDriversAllowed.pfm_title = "Pilotes d'impression hors processus autorisés";
OopPrintDriversAllowed.pfm_description = "Détermine si Brave interagit avec les pilotes de l'imprimante via un processus de service distinct. Les appels d'impression de plate-forme pour interroger les imprimantes disponibles, obtenir les paramètres du pilote d'impression et envoyer des documents pour impression sur des imprimantes locales sont effectués via un processus de service. Retirer ces appels du processus du navigateur permet d'améliorer la stabilité et de réduire les blocages de l'UI dans l'aperçu avant impression.\n\nSi cette règle est activée ou n'est pas configurée, Brave utilise un processus de service distinct pour les tâches d'impression de plate-forme.\n\nSi cette règle est désactivée, Brave utilise le processus du navigateur pour les tâches d'impression de plate-forme.\n\nCette règle sera supprimée quand la fonctionnalité de pilotes d'impression hors processus sera entièrement déployée.";
OriginAgentClusterDefaultEnabled.pfm_title = "Autorise par défaut le clustering d'agents selon l'origine.";
OriginAgentClusterDefaultEnabled.pfm_description = "Par défaut, cette règle autorise le clustering d'agents selon l'origine.\n\nL'en-tête HTTP Origin-Agent-Cluster permet de spécifier si un document est isolé dans un cluster d'agents selon l'origine ou selon le site. Ce choix a des implications sur la sécurité, car le clustering d'agents selon l'origine permet d'isoler des documents en fonction de l'origine. Du point de vue du développeur, cela se traduit par l'impossibilité de configurer l'accesseur document.domain.\n\nLe comportement par défaut (aucune configuration de l'en-tête Origin-Agent-Cluster) dans M111 n'est plus une isolation selon le site, mais selon l'origine.\n\nSi cette règle est activée ou qu'elle n'est pas configurée, le navigateur applique ce nouveau comportement par défaut à partir de cette version.\n\nSi elle est désactivée, ce changement est annulé et les documents sans en-têtes Origin-Agent-Cluster sont affectés aux clusters d'agents selon le site. L'accesseur document.domain reste donc configurable par défaut. Cela correspond à l'ancien comportement.\n\nPour en savoir plus, consultez https://developer.chrome.com/blog/immutable-document-domain/.";
OriginKeyedProcessesEnabled.pfm_title = "Activer l'isolation des processus selon l'origine par défaut.";
OriginKeyedProcessesEnabled.pfm_description = "Active l'isolation des processus selon l'origine pour la plupart des pages (c'est-à-dire celles qui sont attribuées par défaut à un cluster d'agents selon l'origine). Cela améliore la sécurité, mais augmente aussi le nombre de processus créés. Les utilisateurs sont autorisés à ignorer la valeur de règle définie via les flags de ligne de commande ou chrome://flags (pour activer ou désactiver cette fonctionnalité).\n\nSi cette règle est activée, la plupart des origines sont isolées, même des autres origines provenant du même site. Voir également les règles IsolateOrigins et SitePerProcess.\n\nSi cette règle est désactivée, aucune origine n'est isolée du reste de son site, sauf si une origine le demande explicitement.\n\nSi cette règle n'est pas configurée, le navigateur détermine les origines à isoler et le moment où il doit procéder à l'isolation.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "Origines ou modèles de nom d'hôte non soumis aux restrictions applicables aux origines non sécurisées";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "Cette règle permet d'établir la liste des origines (URL) ou modèles de nom d'hôte non sécurisés (comme *.example.com) pour lesquels des restrictions de sécurité ne s'appliquent pas. Les modèles ne sont acceptés que pour les noms d'hôtes. Les URL/origines avec des schémas doivent être des chaînes exactes. Par exemple, les organisations peuvent indiquer des origines pour les anciennes applications qui ne peuvent pas déployer TLS, ou configurer un serveur intermédiaire pour les développements Web internes. Les développeurs peuvent ainsi tester des fonctionnalités nécessitant des contextes sécurisés, sans avoir à déployer TLS sur ce serveur intermédiaire. Cette règle évite également qu'une origine soit accompagnée de la mention \"Non sécurisé\" dans la barre d'adresse.\n\nLa création d'une liste d'URL dans cette règle revient à définir l'option de ligne de commande \"--unsafely-treat-insecure-origin-as-secure\" sur une liste comportant les mêmes URL séparées par une virgule. Cette règle remplace l'option de ligne de commande et la règle UnsafelyTreatInsecureOriginAsSecure (si elles sont disponibles).\n\nPour en savoir plus sur les contextes sécurisés, consultez la page https://www.w3.org/TR/secure-contexts.";
PartitionedBlobUrlUsage.pfm_title = "Choisir si les URL blob sont partitionnées pendant l'extraction et la navigation";
PartitionedBlobUrlUsage.pfm_description = "Cette règle détermine si les URL blob sont partitionnées lors de l'extraction et de la navigation.\nSi cette règle est activée ou n'est pas configurée, les URL blob sont partitionnées.\nSi elle est désactivée, les URL blob ne sont pas partitionnées.\n\nSi vous devez utiliser cette règle, veuillez signaler un bug sur Brave en expliquant votre cas d'utilisation. Cette règle sera disponible jusqu'à la version 146 de Brave, après quoi l'ancienne implémentation sera supprimée.\n\nREMARQUE : Seuls les nouveaux processus du moteur de rendu refléteront les modifications apportées à cette règle lorsque le navigateur sera en cours d'exécution.\n\nPour en savoir plus sur le partitionnement du stockage tiers, consultez https://developers.google.com/privacy-sandbox/cookies/storage-partitioning.";
PasswordDismissCompromisedAlertEnabled.pfm_title = "Activer la fermeture des alertes de mot de passe compromis pour les identifiants saisis";
PasswordDismissCompromisedAlertEnabled.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, l'utilisateur peut choisir de fermer/restaurer les alertes de mot de passe compromis.\n\nSi vous désactivez ce paramètre, les utilisateurs ne pourront plus fermer les alertes concernant les mots de passe compromis. S'il est activé, les utilisateurs pourront fermer ces alertes.";
PasswordLeakDetectionEnabled.pfm_title = "Autorise la détection de fuite pour les identifiants saisis";
PasswordLeakDetectionEnabled.pfm_description = "Si cette règle est activée, les utilisateurs peuvent faire en sorte que Brave contrôle si les noms d'utilisateur et les mots de passe saisis ont fait l'objet d'une fuite.\n\nSi elle est désactivée, les utilisateurs ne peuvent pas utiliser cette fonctionnalité.\n\nSi cette règle est configurée, les utilisateurs ne peuvent pas la modifier dans Brave. Si elle n'est pas configurée, la vérification de fuite d'identifiants est autorisée, mais l'utilisateur peut la désactiver.";
PasswordManagerBlocklist.pfm_title = "Configurer la liste des domaines pour lesquels le Password Manager (Enregistrer et Remplir) sera désactivé";
PasswordManagerBlocklist.pfm_description = "Configurez la liste des domaines sur lesquels Brave doit désactiver le Password Manager. Cela signifie que les workflows d'enregistrement et de remplissage seront désactivés, de sorte que les mots de passe de ces sites Web ne pourront pas être enregistrés ou remplis automatiquement dans des formulaires Web.\n\nSi un domaine figure dans la liste, le Password Manager sera désactivé pour ce domaine.\n\nSi un domaine n'est pas présent dans la liste, le Password Manager sera disponible pour ce domaine.\n\nSi cette règle n'est pas configurée, le Password Manager sera disponible pour tous les domaines.\n\nPour en savoir plus sur les formats d‘URL valides, veuillez consulter https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
PasswordManagerEnabled.pfm_title = "Activer l'enregistrement des mots de passe dans le gestionnaire de mots de passe";
PasswordManagerEnabled.pfm_description = "Cette règle contrôle la capacité du navigateur à mémoriser automatiquement les mots de passe sur les sites et à les enregistrer dans le gestionnaire de mots de passe intégré. Elle ne limite pas l'accès ni ne modifie le contenu des mots de passe enregistrés dans le gestionnaire de mots de passe et éventuellement synchronisés avec le profil de compte Google et Android.\n\nSi cette règle est activée, les utilisateurs doivent demander à Brave de mémoriser les mots de passe et les saisir la prochaine fois qu'ils se connectent à un site.\n\nSi cette règle est désactivée, les utilisateurs ne peuvent pas enregistrer de nouveaux mots de passe. Cependant, ceux enregistrés précédemment fonctionneront toujours.\n\nSi cette règle est configurée, les utilisateurs ne peuvent pas la modifier dans Brave. Si cette règle n'est pas configurée, les utilisateurs peuvent désactiver l'enregistrement des mots de passe.";
PasswordManagerPasskeysEnabled.pfm_title = "Activer l'enregistrement des clés d'accès dans le gestionnaire de mots de passe";
PasswordManagerPasskeysEnabled.pfm_description = "Cette règle contrôle la capacité du navigateur à enregistrer les clés d'accès dans le gestionnaire de mots de passe intégré. Elle ne limite pas l'accès aux clés d'accès déjà enregistrées dans le gestionnaire de mots de passe et ne modifie pas leur contenu. Si la règle PasswordManagerEnabled est désactivée, l'enregistrement dans le gestionnaire de mots de passe intégré est désactivé en général, y compris pour les clés d'accès et les mots de passe. Cette règle n'est donc pas applicable.\n\nSi cette règle est activée ou qu'elle n'est pas configurée, les utilisateurs peuvent enregistrer des clés d'accès dans le gestionnaire de mots de passe intégré s'ils sont connectés à Brave.\n\nSi cette règle est désactivée, les utilisateurs ne peuvent pas enregistrer de clés d'accès dans le gestionnaire de mots de passe intégré, mais les clés d'accès enregistrées précédemment fonctionneront toujours.";
PasswordProtectionChangePasswordURL.pfm_title = "Configurez l'URL de modification de mot de passe.";
PasswordProtectionChangePasswordURL.pfm_description = "Cette règle permet de spécifier l'URL à laquelle les utilisateurs doivent modifier leur mot de passe après avoir lu l'avertissement affiché dans le navigateur. Le service de protection par mot de passe redirige les utilisateurs vers l'URL (protocoles HTTP et HTTPS uniquement) que vous avez indiquée dans cette règle. Pour que Brave enregistre correctement la copie hachée et après salage du nouveau mot de passe sur la page de modification de celui-ci, vérifiez si cette page respecte bien les consignes indiquées sur https://www.chromium.org/developers/design-documents/create-amazing-password-forms.\n\nSi cette règle est désactivée ou n'est pas configurée, les utilisateurs sont redirigés vers la page https://myaccount.google.com pour modifier leur mot de passe.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
PasswordProtectionLoginURLs.pfm_title = "Configurez la liste des URL de connexion d'entreprise pour lesquelles le service de protection par mot de passe doit enregistrer une copie hachée et salée des mots de passe.";
PasswordProtectionLoginURLs.pfm_description = "Cette règle permet de lister les URL de connexion d'entreprise (protocoles HTTP et HTTPS uniquement). Le service de protection par mot de passe enregistre des copies hachées et après salage des mots de passe au niveau de ces URL afin de détecter les mots de passe réutilisés. Pour que Brave enregistre correctement ces copies, vérifiez que vos pages de connexion respectent les consignes décrites sur https://www.chromium.org/developers/design-documents/create-amazing-password-forms.\n\nSi cette règle est désactivée ou n'est pas configurée, le service de protection par mot de passe n'enregistre que les copies hachées et après salage sur https://accounts.google.com.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
PasswordProtectionWarningTrigger.pfm_title = "Déclencheur d'avertissement de protection par mot de passe";
PasswordProtectionWarningTrigger.pfm_description = "0 - L'avertissement de protection par mot de passe est désactivé\n1 - L'avertissement de protection par mot de passe est déclenché en cas de réutilisation du mot de passe\n2 - L'avertissement de protection par mot de passe est déclenché en cas de réutilisation du mot de passe sur une page d'hameçonnage\nPermet de contrôler l'affichage d'un avertissement du service de protection par mot de passe, qui vise à alerter les utilisateurs lorsque ceux-ci réutilisent leur mot de passe protégé sur des sites potentiellement suspects.\n\nUtilisez les règles PasswordProtectionLoginURLs et PasswordProtectionChangePasswordURL pour configurer le mot de passe à protéger.\n\nSi cette règle est définie sur :\n\n* PasswordProtectionWarningOff, l'avertissement en question n'est pas affiché ;\n\n* PasswordProtectionWarningOnPasswordReuse, l'avertissement est affiché lorsque les utilisateurs réutilisent leur mot de passe protégé sur un site qui ne figure pas dans la liste des sites autorisés ;\n\n* PasswordProtectionWarningOnPhishingReuse, l'avertissement est affiché lorsque les utilisateurs réutilisent leur mot de passe protégé sur un site d'hameçonnage.\n\nSi cette règle n'est pas configurée, le service de protection par mot de passe ne protège que les mots de passe Google. Toutefois, les utilisateurs peuvent modifier ce paramètre.";
PasswordSharingEnabled.pfm_title = "Activer le partage des identifiants de l'utilisateur avec d'autres utilisateurs";
PasswordSharingEnabled.pfm_description = "Si cette règle est activée, l'utilisateur peut envoyer ses mots de passe à des membres de sa famille et en recevoir de leur part (selon les services destinés aux familles).\nSi cette règle est activée ou n'est pas configurée, le Gestionnaire de mots de passe propose un bouton qui permet d'envoyer un mot de passe.\nLes mots de passe reçus sont stockés dans le compte de l'utilisateur et disponibles dans le Gestionnaire de mots de passe.\n\nSi cette règle est désactivée, l'utilisateur ne peut pas envoyer de mots de passe à d'autres utilisateurs depuis le Gestionnaire de mots de passe ni en recevoir de la part d'autres utilisateurs.\n\nCette fonctionnalité n'est pas disponible si la synchronisation des mots de passe est désactivée (soit dans les paramètres de l'utilisateur, soit si la règle SyncDisabled est activée).\n\nLes comptes gérés ne peuvent pas rejoindre ni créer de groupe familial, et ne peuvent donc pas partager de mots de passe.";
PaymentMethodQueryEnabled.pfm_title = "Autoriser les sites Web à vérifier si des modes de paiement sont disponibles.";
PaymentMethodQueryEnabled.pfm_description = "Permet de définir si les sites Web sont autorisés à vérifier si l'utilisateur a enregistré des modes de paiement.\n\nSi cette règle est désactivée, les sites Web qui utilisent l'API PaymentRequest.canMakePayment ou PaymentRequest.hasEnrolledInstrument seront informés qu'aucun mode de paiement n'est disponible.\n\nSi cette règle est activée ou si elle n'est pas configurée, les sites Web sont autorisés à vérifier si l'utilisateur possède des modes de paiement enregistrés.";
PdfAnnotationsEnabled.pfm_title = "Activer les annotations des PDF";
PdfAnnotationsEnabled.pfm_description = "Détermine si la visionneuse de PDF intégrée à Brave peut annoter les PDF.\n\nSi cette règle n'est pas configurée, ou si elle est définie sur \"True\", la visionneuse de PDF peut annoter ces fichiers.\n\nSi cette règle est définie sur \"False\", la visionneuse de PDF ne peut pas annoter ces fichiers.";
PdfLocalFileAccessAllowedForDomains.pfm_title = "Autoriser l'accès aux fichiers locaux aux URL file:// sur ces sites dans le lecteur PDF";
PdfLocalFileAccessAllowedForDomains.pfm_description = "Cette règle permet aux domaines indiqués d'accéder aux URL file:// dans le lecteur PDF.\nL'ajout d'un domaine à cette règle lui permet d'accéder aux URL file:// dans le lecteur PDF.\nLa suppression d'un domaine de cette règle l'empêchera d'accéder aux URL file:// dans le lecteur PDF.\nSi cette règle n'est pas configurée, aucun domaine ne peut accéder aux URL file:// dans le lecteur PDF.";
PdfUseSkiaRendererEnabled.pfm_title = "Utiliser le moteur de rendu Skia pour le rendu PDF";
PdfUseSkiaRendererEnabled.pfm_description = "Détermine si la visionneuse de PDF de Brave utilise le moteur de rendu Skia.\n\nLorsque cette règle est activée, la visionneuse de PDF utilise le moteur de rendu Skia.\n\nSi elle est désactivée, la visionneuse de PDF utilise son moteur de rendu AGG actuel.\n\nSi cette règle n'est pas configurée, le moteur de rendu des PDF est sélectionné par le navigateur.";
PolicyAtomicGroupsEnabled.pfm_title = "Activer le concept de groupes atomiques de règles";
PolicyAtomicGroupsEnabled.pfm_description = "Si cette règle est activée, les règles associées à un groupe atomique qui ne sont pas issues de la source ayant la plus haute priorité dans le groupe sont ignorées.\n\nSi elle est désactivée, aucune règle n'est ignorée en raison de sa source. Les règles ne sont ignorées que s'il existe un conflit et que celles-ci n'ont pas la plus haute priorité.\n\nSi cette règle est définie à partir d'une source cloud, elle ne peut pas cibler un utilisateur en particulier.";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "Autoriser la fusion de règles de dictionnaire qui proviennent de sources différentes";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - URL d'exception manuelle des utilisateurs gérés\nDeviceLoginScreenPowerManagement - Gestion de l'alimentation sur l'écran de connexion\nExtensionSettings - Paramètres de gestion des extensions\nKeyPermissions - Autorisations de clés\nPowerManagementIdleSettings - Paramètres de gestion de l'alimentation en cas d'inactivité de l'utilisateur\nScreenBrightnessPercent - Niveau de luminosité de l'écran (%)\nScreenLockDelays - Délais de verrouillage de l'écran\nCette règle permet de fusionner les règles sélectionnées lorsqu'elles proviennent de sources différentes, et si le niveau et les champs d'application sont les mêmes. Cette fusion concerne les clés de premier niveau du dictionnaire provenant de chaque source. La clé qui prévaut est celle dont la source présente la plus haute priorité.\n\nUtilisez le caractère générique \"*\" pour autoriser la fusion de toutes les règles de dictionnaire compatibles.\n\nSi une règle figure dans la liste et qu'il y a conflit entre deux sources :\n\n* les valeurs sont fusionnées dans un nouveau dictionnaire de règles si le niveau et les champs d'application sont les mêmes ;\n\n* la règle ayant la plus haute priorité s'applique si le niveau ou les champs d'application diffèrent.\n\nSi une règle ne figure pas dans la liste et qu'il y a conflit entre plusieurs sources, champs d'application ou niveaux, la règle ayant la plus haute priorité s'applique.";
PolicyListMultipleSourceMergeList.pfm_title = "Autoriser la fusion de règles répertoriées qui proviennent de sources différentes";
PolicyListMultipleSourceMergeList.pfm_description = "Cette règle permet de fusionner les règles sélectionnées lorsqu'elles proviennent de sources différentes, et si le niveau et les champs d'application sont les mêmes.\n\nUtilisez le caractère générique \"*\" pour autoriser la fusion de toutes les règles de liste.\n\nSi une règle figure dans la liste et qu'il y a conflit entre deux sources :\n\n* les valeurs sont fusionnées dans une nouvelle liste de règles si le niveau et les champs d'application sont les mêmes ;\n\n* la règle ayant la plus haute priorité s'applique si le niveau ou les champs d'application diffèrent.\n\nSi une règle ne figure pas dans la liste et qu'il y a conflit entre plusieurs sources, champs d'application ou niveaux, la règle ayant la plus haute priorité s'applique.";
PolicyRefreshRate.pfm_title = "Fréquence d'actualisation des règles relatives aux utilisateurs";
PolicyRefreshRate.pfm_description = "Cette règle permet d'indiquer, en millisecondes, la fréquence à laquelle le service de gestion des appareils est interrogé en vue d'obtenir des informations sur les règles relatives aux utilisateurs. Les valeurs valides sont comprises entre 1 800 000 (30 minutes) et 86,4 millions (1 jour). Toute valeur en dehors de cette plage sera remplacée par la valeur minimale ou maximale la plus proche autorisée.\n\nSi cette règle n'est pas configurée, la valeur par défaut (3 heures) est utilisée.\n\nRemarque : Pour éviter toute actualisation inutile, chaque fois qu'une règle est modifiée, une actualisation est effectuée de façon forcée pour signaler ce changement. Si la plate-forme accepte les notifications relatives aux règles, le délai d'actualisation est de 24 heures (et toutes les valeurs par défaut ainsi que celle de cette règle sont ignorées).";
PopupsAllowedForUrls.pfm_title = "Autoriser les pop-up sur ces sites";
PopupsAllowedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites peuvent ouvrir les fenêtres pop-up.\n\nSi cette règle n'est pas configurée, la règle DefaultPopupsSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
PopupsBlockedForUrls.pfm_title = "Bloquer les pop-up sur ces sites";
PopupsBlockedForUrls.pfm_description = "Permet de dresser la liste des formats d'URL pour lesquels les sites ne sont pas autorisés à ouvrir les pop-ups.\n\nSi cette règle n'est pas configurée, la règle DefaultPopupsSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
PreciseGeolocationAllowedForUrls.pfm_title = "Autoriser la géolocalisation précise sur ces sites";
PreciseGeolocationAllowedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites sont autorisés à accéder à la géolocalisation haute précision de l'utilisateur sans avoir à lui demander son autorisation au préalable.\n\nSi cette règle n'est pas configurée, la règle DefaultGeolocationSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
PreferSlowCiphers.pfm_title = "Privilégier des algorithmes de chiffrement spécifiques pour TLS";
PreferSlowCiphers.pfm_description = "cnsa - Privilégier les algorithmes de chiffrement répondant aux exigences de la suite CNSA 1.0 et 2.0\ndefault - Utiliser l'ordre des algorithmes de chiffrement par défaut de Brave\nCette règle configure Brave pour qu'il ordonne ses algorithmes de chiffrement préférés dans TLS 1.3 afin de refléter une préférence pour les algorithmes approuvés par un régime de conformité spécifique.\n\nConfigurer cette règle ne garantit pas que des algorithmes spécifiques seront négociés.\n\nCette règle permet aux opérateurs de serveur qui souhaitent prendre en charge les clients avec et sans exigences de conformité de faire la distinction entre ces clients, et d'utiliser uniquement certains algorithmes non définis par défaut avec une force cryptographique accrue pour ceux dont la préférence est explicitement configurée.\n\nSi vous définissez la règle sur \"cnsa\", Brave privilégie les algorithmes de chiffrement requis pour la conformité avec les versions 1.0 et 2.0 de la suite Commercial National Security Algorithm (CNSA 1.0 et 2.0, suite d'algorithmes de sécurité nationale commerciale).\n\nSi vous ne configurez pas la règle ou si vous la définissez sur \"default\", Brave utilise ses algorithmes de chiffrement par défaut.\n\nLa configuration de cette règle n'est pas requise pour la sécurité. La cryptographie par défaut utilisée par Brave est suffisamment robuste pour résister à une attaque par force brute utilisant toute la puissance du Soleil.\n\nSi vous configurez cette règle, Brave sera plus lent lors de l'accès aux sites Web.\n\nCette règle n'affecte que TLS 1.3 et QUIC. Elle n'affecte pas les versions antérieures de TLS.\n\nCette règle peut être définie pour l'appareil et pour l'utilisateur. Si elle est définie pour l'utilisateur, cette règle n'affectera que les requêtes réseau initiées par le profil utilisateur et n'affectera peut-être pas les requêtes réseau effectuées par Brave pour exécuter des tâches en arrière-plan à l'échelle du navigateur. Ces tâches étant, en effet, contrôlées par la valeur définie au niveau de l'appareil. Si cette règle est définie à la fois au niveau de l'appareil et de l'utilisateur, la valeur au niveau de l'appareil s'applique, sauf si l'ordre de priorité des règles a été modifié par la règle CloudUserPolicyOverridesCloudMachinePolicy.\n\nPour les versions 155 et antérieures, cette règle ne s'applique qu'au niveau de l'appareil.";
PreferSlowKexAlgorithms.pfm_title = "Privilégier des algorithmes d'échange de clés spécifiques pour TLS";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - Privilégier les méthodes d'échange de clés répondant aux exigences de la suite CNSA 2.0\ndefault - Utiliser les groupes compatibles par défaut de Brave\nCette règle configure Brave pour qu'il ordonne ses algorithmes d'accord de clé préférés (groupes compatibles) dans TLS 1.3 afin de refléter une préférence pour les algorithmes approuvés par un régime de conformité spécifique.\n\nConfigurer cette règle ne garantit pas que des algorithmes spécifiques seront négociés.\n\nCette règle permet aux opérateurs de serveur qui souhaitent prendre en charge les clients avec et sans exigences de conformité de faire la distinction entre ces clients, et d'utiliser uniquement certains algorithmes non définis par défaut avec une force cryptographique accrue pour ceux dont la préférence est explicitement configurée.\n\nSi vous définissez la règle sur \"cnsa2\", Brave privilégie les méthodes d'échange de clés requises pour la conformité avec la suite Commercial National Security Algorithm 2.0 (CNSA 2.0, suite d'algorithmes de sécurité nationale commerciale).\n\nSi vous ne configurez pas la règle ou si vous la définissez sur \"default\", Brave utilise ses méthodes d'échange de clés par défaut.\n\nLa configuration de cette règle n'est pas requise pour la sécurité. La cryptographie par défaut utilisée par Brave est suffisamment robuste pour résister à une attaque par force brute utilisant toute la puissance du Soleil.\n\nSi vous configurez cette règle, Brave sera plus lent lors de l'accès aux sites Web.\n\nCette règle n'affecte que TLS 1.3 et QUIC. Elle n'affecte pas les versions antérieures de TLS.\n\nCette règle peut être définie pour l'appareil et pour l'utilisateur. Si elle est définie pour l'utilisateur, cette règle n'affectera que les requêtes réseau initiées par le profil utilisateur et n'affectera peut-être pas les requêtes réseau effectuées par Brave pour exécuter des tâches en arrière-plan à l'échelle du navigateur. Ces tâches étant, en effet, contrôlées par la valeur définie au niveau de l'appareil. Si cette règle est définie à la fois au niveau de l'appareil et de l'utilisateur, la valeur au niveau de l'appareil s'applique, sauf si l'ordre de priorité des règles a été modifié par la règle CloudUserPolicyOverridesCloudMachinePolicy.\n\nPour les versions 155 et antérieures, cette règle ne s'applique qu'au niveau de l'appareil.";
PrefetchWithServiceWorkerEnabled.pfm_title = "Autoriser le préchargement SpeculationRules pour les URL contrôlées par ServiceWorker";
PrefetchWithServiceWorkerEnabled.pfm_description = "Le préchargement SpeculationRules peut être émis pour les URL contrôlées par ServiceWorker. Cependant, l'ancien code ne l'autorisait pas et annulait les requêtes de préchargement. Cette règle permet de contrôler le comportement.\n\nSi cette règle est activée ou n'est pas configurée, le préchargement SpeculationRules est autorisé pour les URL contrôlées par ServiceWorker (si le flag de fonctionnalité PrefetchServiceWorker est activé). Il s'agit du comportement par défaut actuel, qui est conforme aux spécifications.\n\nSi cette règle est désactivée, le préchargement SpeculationRules n'est pas autorisé pour les URL contrôlées par ServiceWorker. Cela correspond à l'ancien comportement.\n\nCette règle est provisoire et sera supprimée prochainement.";
PrintHeaderFooter.pfm_title = "Imprimer les en-têtes et les pieds de page";
PrintHeaderFooter.pfm_description = "Si vous activez cette règle, les en-têtes et les pieds de pages sont activés dans l'aperçu avant impression. Si vous la désactivez, ces éléments le sont également dans l'aperçu avant impression.\n\nSi vous définissez cette règle, les utilisateurs ne peuvent pas la modifier. Si vous ne la configurez pas, l'emplacement des en-têtes et des pieds de page est déterminé par les utilisateurs.";
PrintPdfAsImageAvailability.pfm_title = "Possibilité d'imprimer le PDF en tant qu'image";
PrintPdfAsImageAvailability.pfm_description = "Contrôle comment Brave propose l'option \"Imprimer en tant qu'image\" sur Microsoft® Windows® et macOS lors de l'impression de PDF.\n\nLors de l'impression de PDF sur Microsoft® Windows® ou macOS, les tâches d'impression doivent parfois être rastérisées sous forme d'image pour obtenir le rendu souhaité sur certaines imprimantes.\n\nLorsque cette règle est activée, Brave propose l'option \"Imprimer en tant qu'image\" dans l'aperçu avant impression d'un PDF.\n\nLorsque cette règle est désactivée ou n'est pas configurée, Brave ne propose pas l'option \"Imprimer en tant qu'image\" dans l'aperçu avant impression et les PDF sont imprimés normalement, sans être rastérisés sous forme d'image avant d'être envoyés à destination.";
PrintPdfAsImageDefault.pfm_title = "Imprimer le document PDF en tant qu'image par défaut";
PrintPdfAsImageDefault.pfm_description = "Détermine si Brave propose l'option \"Imprimer en tant qu'image\" par défaut lors de l'impression de documents PDF.\n\nLorsque cette règle est activée, Brave propose l'option \"Imprimer en tant qu'image\" par défaut dans l'aperçu avant impression d'un PDF.\n\nSi cette règle est désactivée ou n'est pas configurée, l'option \"Imprimer en tant qu'image\" n'est pas proposée à l'utilisateur de Brave.  Si l'option est disponible, l'utilisateur pourra la sélectionner pour chaque tâche d'impression PDF.\n\nPour Microsoft® Windows® ou macOS, cette règle n'est effective que si PrintPdfAsImageAvailability est également activée.";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "Utiliser l'imprimante système par défaut";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "Si vous activez cette règle, cela signifie que Brave utilise l'imprimante par défaut du système d'exploitation en tant que destination par défaut pour l'aperçu avant impression.\n\nSi vous la désactivez, ou si vous ne la configurez pas, Brave définira la dernière imprimante utilisée en tant que destination par défaut pour l'aperçu avant impression.";
PrintRasterizePdfDpi.pfm_title = "Résolution d'impression de PDF rastérisés";
PrintRasterizePdfDpi.pfm_description = "Contrôle la résolution des images imprimées lorsque Brave imprime les PDF après rastérisation.\n\nLors de l'impression d'un PDF à l'aide de l'option \"Imprimer en tant qu'image\", il peut être opportun d'indiquer une résolution d'impression différente des paramètres d'un appareil ou par défaut d'un PDF.  Une résolution plus élevée allonge de manière significative le délai de traitement et d'impression, mais une résolution moins élevée peut affecter la qualité de l'impression.\n\nCette règle permet d'indiquer une résolution spécifique à utiliser en cas de rastérisation de PDF avant impression.\n\nSi la règle est définie sur zéro ou si elle n'est pas configurée, la résolution par défaut du système est utilisée lors de la rastérisation des images de la page.";
PrinterTypeDenyList.pfm_title = "Permet de désactiver les types d'imprimantes figurant sur la liste deny";
PrinterTypeDenyList.pfm_description = "privet - Destinations des protocoles basés sur Zeroconf (mDNS + DNS-SD) (obsolète)\nextension - Destinations basées sur des extensions\npdf - Destinations \"Enregistrer au format PDF\" et \"Enregistrer dans Google Drive\" sur les appareils Google Chrome OS\nlocal - Destinations des imprimantes locales\ncloud - Google Cloud Print (obsolète)\nSi vous ajoutez des types d'imprimantes à la liste de blocage, vous ne pourrez plus les voir ni récupérer leurs fonctionnalités.\n\nLorsque vous placez tous les types d'imprimantes sur la liste de blocage, vous désactivez l'impression. En effet, plus aucune destination n'est alors disponible lorsque vous envoyez un document pour impression.\n\nDans les versions antérieures à la version 102, inclure le type \"cloud\" dans la liste de blocage revient à définir la règle \"CloudPrintSubmitEnabled\" sur \"False\". Pour que les destinations Google Cloud Print restent visibles, la règle \"CloudPrintSubmitEnabled\" doit être définie sur \"True\", et le type \"cloud\" ne doit pas figurer sur la liste de blocage. À partir de la version 102, les destinations Google Cloud Print ne sont pas disponibles et n'apparaîtront pas, quelle que soit la valeur de la règle.\n\nSi cette règle n'est pas configurée ou si elle est définie sur une liste vide, tous les types d'imprimantes seront visibles.\n\nLes extensions permettant d'imprimer depuis un navigateur, ou destinations des fournisseurs d'impression, englobent toutes les destinations appartenant à une extension Brave.\n\nLes imprimantes locales, ou destinations d'impression native, englobent les destinations disponibles sur l'ordinateur local et les imprimantes réseau partagées.";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "Limiter le mode d'impression d'images de fond";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - Autoriser l'impression à la fois avec et sans graphiques d'arrière-plan\nenabled - Autoriser l'impression uniquement avec des images de fond\ndisabled - Autoriser l'impression uniquement sans images de fond\nPermet de limiter le mode d'impression d'images de fond. Si cette règle n'est pas configurée, aucune limite ne s'applique.";
PrintingBackgroundGraphicsDefault.pfm_title = "Mode d'impression d'images de fond par défaut";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - Activer le mode d'impression d'images de fond par défaut\ndisabled - Désactiver le mode d'impression d'images de fond par défaut\nPermet d'ignorer le mode d'impression d'images de fond par défaut.";
PrintingEnabled.pfm_title = "Activer l'impression";
PrintingEnabled.pfm_description = "Si vous activez cette règle ou que vous ne la configurez pas, les utilisateurs peuvent imprimer dans Brave. En revanche, ils ne peuvent pas modifier ce paramètre.\n\nSi vous la désactivez, les utilisateurs ne peuvent pas imprimer à partir de Brave. La fonctionnalité d'impression est désactivée dans le menu à trois points, les extensions et les applications JavaScript.";
PrintingPaperSizeDefault.pfm_title = "Format de page d'impression par défaut";
PrintingPaperSizeDefault.pfm_description = "Cette règle permet d'ignorer le format de la page d'impression par défaut.\n\nLa propriété name doit contenir l'un des formats répertoriés ou être définie sur \"Personnalisé\" si le format du papier requis ne figure pas dans la liste. Si elle est définie sur \"Personnalisé\", il est obligatoire de spécifier également la propriété custom_size. La hauteur et la largeur souhaitées sont exprimées en micromètres. Dans le cas contraire, la propriété custom_size ne doit pas être renseignée. Toute règle qui ne respecte pas ces consignes sera ignorée.\n\nSi la taille de la page n'est pas disponible pour l'imprimante sélectionnée, cette règle est ignorée.\nConsultez la page https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault pour en savoir plus sur le schéma et le formatage.";
ProfilePickerOnStartupAvailability.pfm_title = "Disponibilité du sélecteur du profil au démarrage";
ProfilePickerOnStartupAvailability.pfm_description = "0 - Sélecteur de profil disponible au démarrage\n1 - Sélecteur de profil désactivé au démarrage\n2 - Sélecteur de profil forcé au démarrage\nIndique si le sélecteur de profil est activé, désactivé ou forcé au démarrage du navigateur.\n\nPar défaut, le sélecteur de profil n'est pas affiché si le navigateur démarre en mode Invité ou navigation privée, si un répertoire et/ou des URL de profils sont indiqués par ligne de commande, si l'ouverture d'une application a été demandée de manière explicite, si le navigateur a été lancé par une notification native, s'il n'y a qu'un seul profil disponible ou si la règle ForceBrowserSignin est définie sur \"True\".\n\nSi l'option \"Activé\" (0) est sélectionnée ou si la règle n'est pas configurée, le sélecteur de profil sera affiché par défaut au démarrage, mais les utilisateurs pourront l'activer/le désactiver.\n\nSi l'option \"Désactivé\" (1) est sélectionnée, le sélecteur de profil ne s'affichera jamais et les utilisateurs ne pourront pas modifier le paramètre.\n\nSi l'option \"Forcé\" (2) est sélectionnée, le sélecteur de profil ne pourra pas être supprimé par l'utilisateur. Le sélecteur de profil sera affiché même si un seul profil est disponible.";
ProfileReauthPrompt.pfm_title = "Inviter les utilisateurs à s'authentifier de nouveau auprès du profil";
ProfileReauthPrompt.pfm_description = "0 - Ne pas inviter à s'authentifier de nouveau\n1 - Inviter à s'authentifier de nouveau dans un onglet\nSi la règle est définie sur \"DoNotPrompt\" ou n'est pas configurée, Brave n'invite pas automatiquement l'utilisateur à s'authentifier de nouveau auprès du navigateur.\n\nSi elle est définie sur \"PromptInTab\", lorsque l'authentification de l'utilisateur expire, un nouvel onglet avec la page de connexion Google s'ouvre immédiatement. Cela ne se produit que si la Chrome Sync est utilisée.";
ProfileSeparationDomainExceptionList.pfm_title = "Liste d'autorisation des domaines secondaires de séparation des profils d'entreprise";
ProfileSeparationDomainExceptionList.pfm_description = "Si cette règle n'est pas configurée, aucune connexion à un compte n'est requise pour créer un profil distinct.\n\nSi cette règle est configurée, aucune connexion à un compte à partir des domaines listés n'est requise pour créer un profil distinct.\n\nCette règle peut être définie sur une chaîne vide afin qu'une connexion à un compte soit toujours requise pour créer un profil distinct.";
PromotionsEnabled.pfm_title = "Activer l'affichage des contenus promotionnels";
PromotionsEnabled.pfm_description = "Si cette règle est définie sur \"True\" ou qu'elle n'est pas configurée, Brave présente aux utilisateurs des contenus promotionnels sur le produit.\n\nSi elle est définie sur \"False\", Brave ne peut pas présenter ces contenus promotionnels.\n\nCette règle permet de contrôler la présentation de contenus promotionnels, y compris les pages de bienvenue qui aident les utilisateurs à se connecter à Brave, de définir Brave comme leur navigateur par défaut ou de les informer des fonctionnalités du produit.";
PromptForDownloadLocation.pfm_title = "Toujours demander où enregistrer les fichiers";
PromptForDownloadLocation.pfm_description = "Si cette règle est activée, les utilisateurs doivent toujours spécifier le répertoire de destination d'un fichier avant de le télécharger. Si cette règle est désactivée, le téléchargement commence immédiatement. Les utilisateurs n'ont pas besoin de spécifier une destination.\n\nSi cette règle n'est pas configurée, les utilisateurs peuvent modifier ce paramètre.";
PromptOnMultipleMatchingCertificates.pfm_title = "Demander si plusieurs certificats correspondent";
PromptOnMultipleMatchingCertificates.pfm_description = "Cette règle détermine si l'utilisateur est invité ou non à sélectionner un certificat client quand la règle AutoSelectCertificateForUrls établit une correspondance avec plus d'un certificat.\nSi cette règle est activée, l'utilisateur est invité à sélectionner un certificat client chaque fois que la règle de sélection automatique établit une correspondance avec plusieurs certificats.\nSi cette règle est désactivée ou n'est pas configurée, l'utilisateur ne peut être invité que si la règle de sélection automatique n'établit de correspondance avec aucun certificat.";
ProxySettings.pfm_title = "Paramètres de proxy";
ProxySettings.pfm_description = "Cette règle permet de configurer les paramètres de proxy pour Chrome et les applis ARC, qui ignorent toutes les options liées au proxy spécifiées à partir de la ligne de commande.\n\nSi cette règle n'est pas configurée, les utilisateurs peuvent sélectionner les paramètres de proxy.\n\nSi la règle ProxySettings est configurée, les champs suivants sont proposés :\n\n* ProxyMode : permet de spécifier le serveur proxy que Chrome utilise et empêche les utilisateurs de modifier les paramètres proxy\n\n* ProxyPacUrl : URL d'un fichier .pac de proxy ou d'un script PAC encodé en tant qu'URL de données avec le type MIME application/x-ns-proxy-autoconfig\n\n* ProxyPacMandatory : empêche la pile réseau de revenir aux connexions directes avec un script PAC non valide ou indisponible\n\n* ProxyServer : URL du serveur proxy\n\n* ProxyBypassList : liste d'hôtes pour lesquels le proxy sera contourné\n\nLe champ ProxyServerMode est obsolète et remplacé par le champ ProxyMode. Dans ProxyMode, si vous sélectionnez :\n\n* direct, aucun proxy n'est utilisé et tous les autres champs sont ignorés ;\n\n* system, le proxy du système est utilisé et tous les autres champs sont ignorés ;\n\n* auto_detect, tous les autres champs sont ignorés ;\n\n* fixed_servers, les champs ProxyServer et ProxyBypassList sont utilisés ;\n\n* pac_script, les champs ProxyPacUrl, ProxyPacMandatory et ProxyBypassList sont utilisés.\n\nRemarque : Pour voir des exemples détaillés, accédez à The Chromium Projects ( https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings ).\nConsultez la page https://chromeenterprise.google/policies/?policy=ProxySettings pour en savoir plus sur le schéma et le formatage.";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "Active le générateur de QR code";
QRCodeGeneratorEnabled.pfm_description = "Cette règle active la fonctionnalité de générateur de QR code dans Brave.\n\nSi vous activez cette règle ou ne la configurez pas, la fonctionnalité de générateur de QR code est activée.\n\nSi vous désactivez cette règle, la fonctionnalité de générateur de QR code est désactivée.";
QuicAllowed.pfm_title = "Autoriser le protocole QUIC";
QuicAllowed.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, l'utilisation du protocole QUIC est autorisée dans Brave.\n\nSi cette règle est désactivée, l'utilisation du protocole QUIC n'est pas autorisée.";
RegisteredProtocolHandlers.pfm_title = "Inscrire des gestionnaires de protocoles";
RegisteredProtocolHandlers.pfm_description = "Cette règle (recommandation uniquement) permet d'enregistrer une liste de gestionnaires de protocoles combinée à ceux enregistrés par l'utilisateur, afin que les deux ensembles s'appliquent. Définissez la propriété \"protocole\" sur le schéma (par exemple, \"mailto\") et la propriété \"URL\" sur le format d'URL de l'application qui gère le schéma spécifié dans le champ \"protocole\". Le schéma peut inclure un espace réservé \"%s\" remplacé par l'URL gérée.\n\nLes utilisateurs ne peuvent pas supprimer un gestionnaire de protocoles enregistré par une règle. Toutefois, l'installation d'un nouveau gestionnaire par défaut leur permet de modifier les gestionnaires de protocoles installés par une règle.\nConsultez la page https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers pour en savoir plus sur le schéma et le formatage.";
RelaunchFastIfOutdated.pfm_title = "Période (jours)";
RelaunchFastIfOutdated.pfm_description = "Précise l'ancienneté minimale de la version au-delà de laquelle les notifications de relance deviennent plus fréquentes. L'ancienneté est calculée à partir de la date de dernière diffusion aux clients de la version en cours.\n\nS'il est nécessaire de relancer le navigateur ou redémarrer l'appareil pour finaliser une mise à jour en attente et que la version actuelle est obsolète depuis plus de jours que le nombre indiqué par ce paramètre, la valeur de la règle RelaunchNotificationPeriod est remplacée par deux heures. Si la règle RelaunchNotification est définie sur 1 (\"Obligatoire\"), les utilisateurs seront obligés de relancer ou de redémarrer à la fin de la période.\n\nSi elle n'est pas définie ou que l'ancienneté de la version ne peut pas être déterminée, la règle RelaunchNotificationPeriod sera utilisée pour toutes les mises à jour.";
RelaunchNotification.pfm_title = "Avertir un utilisateur qu'un redémarrage du navigateur ou de l'appareil est recommandé ou exigé";
RelaunchNotification.pfm_description = "1 - Afficher une invite récurrente indiquant qu'un redémarrage est recommandé\n2 - Afficher une invite récurrente indiquant qu'un redémarrage est nécessaire\nAvertit les utilisateurs que Brave doit être relancé ou que l'appareil Google Chrome OS doit être redémarré pour qu'une mise à jour en cours puisse être appliquée.\n\nCette règle active l'envoi de notifications pour avertir l'utilisateur qu'un redémarrage du navigateur ou de l'appareil est recommandé ou exigé. Si cette règle n'est pas configurée, Brave indique à l'utilisateur, par le biais de modifications discrètes du menu, qu'un redémarrage est nécessaire. Pour l'appareil Google Chrome OS, une notification s'affiche dans la barre d'état système. Si la règle est définie sur \"Recommandé\", un avertissement récurrent s'affiche, indiquant qu'un redémarrage est recommandé. L'utilisateur peut ignorer cet avertissement et redémarrer le navigateur ou l'appareil plus tard. Si elle est définie sur \"Requis\", un avertissement récurrent s'affiche, indiquant que le redémarrage du navigateur ou de l'appareil sera forcé à l'issue de la période de notification. Par défaut, ce délai est de sept jours pour Brave et de quatre jours pour l'appareil Google Chrome OS, et peut être configuré à l'aide du paramètre RelaunchNotificationPeriod.\n\nLa session de l'utilisateur est restaurée après le redémarrage.";
RelaunchNotificationPeriod.pfm_title = "Période (millisecondes)";
RelaunchNotificationPeriod.pfm_description = "Permet de définir la période, en millisecondes, pendant laquelle les utilisateurs sont avertis que Brave doit être relancé ou qu'un appareil Google Chrome OS doit être redémarré pour l'application d'une mise à jour en attente.\n\nAu cours de cette période, l'utilisateur est régulièrement informé de la nécessité d'appliquer la mise à jour. Pour les appareils Google Chrome OS, une notification de redémarrage s'affiche dans la barre d'état système conformément à la règle RelaunchHeadsUpPeriod. Pour les navigateurs Brave, lorsqu'un tiers de la période de notification s'est écoulé, le menu d'application change pour indiquer qu'il est nécessaire de redémarrer le navigateur. La notification change de couleur une première fois lorsque les deux tiers de la période de notification se sont écoulés, et une deuxième fois à l'issue de cette période. Les notifications supplémentaires activées par la règle RelaunchNotification pour les navigateurs suivent le même calendrier.\n\nSi ce paramètre n'est pas défini, la période par défaut est fixée à 604 800 000 millisecondes (une semaine).";
RelaunchWindow.pfm_title = "Fenêtre de redémarrage";
RelaunchWindow.pfm_description = "Permet de définir une fenêtre cible pour la fin de la période de notification du redémarrage.\n\nSelon les paramètres des règles \"RelaunchNotification\" et \"RelaunchNotificationPeriod\", les utilisateurs sont prévenus que le navigateur va devoir être relancé, ou l'appareil, redémarré. Si la règle \"RelaunchNotification\" est définie sur \"Obligatoire\", les navigateurs ou appareils sont redémarrés de manière forcée une fois la période de notification écoulée. La règle \"RelaunchWindow\" peut servir à différer la fin de la période de notification afin qu'elle coïncide avec une fenêtre spécifique.\n\nSi cette règle n'est pas configurée, la fenêtre cible par défaut est comprise entre 2h et 4h du matin pour Google Chrome OS ou étendue à toute la journée pour Brave (la fin de la période de notification n'est alors jamais différée).\n\nRemarque : Même si la règle peut accepter plusieurs éléments dans \"entries\", ils sont tous ignorés, sauf le premier.\nAvertissement : Configurer cette règle peut retarder l'application des mises à jour logicielles.\nConsultez la page https://chromeenterprise.google/policies/?policy=RelaunchWindow pour en savoir plus sur le schéma et le formatage.";
RemoteAccessHostAllowClientPairing.pfm_title = "Activer ou désactiver l'authentification sans code d'accès pour les hôtes d'accès à distance";
RemoteAccessHostAllowClientPairing.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, les utilisateurs peuvent choisir d'associer les clients et les hôtes au moment de la connexion, ce qui évite d'avoir à saisir systématiquement un code.\n\nSi cette règle est désactivée, cette fonctionnalité n'est pas disponible.";
RemoteAccessHostAllowFileTransfer.pfm_title = "Autoriser le transfert de fichiers vers et depuis l'hôte pour les utilisateurs connectés à distance";
RemoteAccessHostAllowFileTransfer.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, les utilisateurs connectés à un hôte d'accès à distance peuvent transférer des fichiers entre le client et l'hôte. Cela ne s'applique pas aux connexions d'assistance à distance, qui ne sont pas compatibles avec le transfert de fichiers.\n\nSi cette règle est désactivée, ces utilisateurs ne peuvent pas transférer de fichiers.";
RemoteAccessHostAllowPinAuthentication.pfm_title = "Autoriser les méthodes d'authentification par code ou association pour les hôtes d'accès à distance";
RemoteAccessHostAllowPinAuthentication.pfm_description = "Si cette règle est activée, l'hôte d'accès à distance peut utiliser des authentifications par code ou association lorsqu'il accepte des connexions client.\n\nSi cette règle est désactivée, les authentifications par code ou association ne sont pas autorisées.\n\nSi cette règle n'est pas configurée, l'hôte décide si l'authentification par code et/ou par association peut être utilisée.\n\nRemarque : Si ce paramètre a pour conséquence qu'aucune méthode d'authentification n'est acceptée à la fois par l'hôte et le client, la connexion sera refusée.";
RemoteAccessHostAllowRelayedConnection.pfm_title = "Autoriser l'hôte d'accès à distance à utiliser des serveurs de relais";
RemoteAccessHostAllowRelayedConnection.pfm_description = "Si la règle RemoteAccessHostAllowRelayedConnection est activée ou qu'elle n'est pas configurée, et que la règle RemoteAccessHostFirewallTraversal est activée, les clients distants peuvent utiliser des serveurs relais pour se connecter à cet ordinateur quand aucune connexion directe n'est disponible (par exemple, en raison de restrictions du pare-feu).\n\nSi cette règle est désactivée, l'accès à distance n'est pas désactivé, et seules les connexions à partir du même réseau sont autorisées (pas de relais ni de Traversée NAT).";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "Autoriser les connexions d'accès à distance à cet ordinateur";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "Si cette règle est désactivée, le service hôte d'accès à distance ne peut pas être démarré ni configuré pour accepter les connexions entrantes.  Cette règle ne concerne pas les cas d'assistance à distance.\n\nElle n'a aucune incidence non plus si elle est activée, si elle n'est pas configurée ou si elle est vide.";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "Autoriser les connexions d'assistance à distance à cet appareil";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "Si cette règle est désactivée, l'hôte d'assistance à distance ne peut pas être démarré ni configuré pour accepter les connexions entrantes.\n\nCette règle ne concerne pas les cas d'accès à distance.\n\nCette règle n'empêche pas les administrateurs d'entreprise de se connecter à des appareils Google Chrome OS gérés.\n\nElle n'a aucun effet si elle est activée, laissée vide ou n'est pas définie.";
RemoteAccessHostAllowUrlForwarding.pfm_title = "Autoriser les utilisateurs connectés à distance à ouvrir des URL côté hôte dans leur navigateur client local";
RemoteAccessHostAllowUrlForwarding.pfm_description = "Si cette règle est activée ou n'est pas configurée, les utilisateurs connectés à un hôte d'accès à distance pourraient être autorisés à ouvrir des URL côté hôte dans leur navigateur client local.\n\nSi cette règle est désactivée, l'hôte d'accès à distance ne peut pas envoyer d'URL au client.\n\nCe paramètre ne concerne pas les connexions d'assistance à distance, car la fonctionnalité n'est pas compatible avec ce mode de connexion.\n\nRemarque : Cette fonctionnalité n'est pas encore disponible au grand public. Son activation ne signifie donc pas qu'elle sera visible dans l'interface utilisateur du client.";
RemoteAccessHostClientDomainList.pfm_title = "Configurer les noms de domaines requis pour les clients d'accès à distance";
RemoteAccessHostClientDomainList.pfm_description = "Cette règle permet d'établir la liste des noms de domaine du client qui sont imposés aux clients d'accès à distance et que les utilisateurs ne peuvent pas modifier. Seuls les clients de l'un des domaines indiqués peuvent se connecter à l'hôte.\n\nSi cette règle n'est pas configurée ou qu'aucun nom ne figure dans la liste, la règle par défaut pour le type de connexion concerné est appliquée. Dans le cadre d'une assistance à distance, cela permet aux clients de n'importe quel domaine de se connecter à l'hôte. Concernant l'accès à distance à tout moment, seul le propriétaire de l'hôte peut se connecter.\n\nConsultez également la règle \"RemoteAccessHostDomainList\".\n\nRemarque : Ce paramètre ignore la règle \"RemoteAccessHostClientDomain\", le cas échéant.";
RemoteAccessHostClipboardSizeBytes.pfm_title = "La taille maximale, en octets, qui peut être transférée entre le client et l'hôte via la synchronisation du presse-papiers";
RemoteAccessHostClipboardSizeBytes.pfm_description = "Si cette règle est définie, les données du presse-papiers envoyées vers et depuis l'hôte seront tronquées à la limite définie dans la règle.\n\nSi la valeur est 0, la synchronisation du presse-papiers est désactivée.\n\nCette règle affecte à la fois les cas d'accès et d'assistance à distance.\n\nElle n'a aucun effet si elle n'est pas définie.\n\nSi la durée définie dans cette règle n'est pas comprise dans les limites indiquées, l'hôte risque de ne pas démarrer.\n\nVeuillez noter que la taille maximale réelle du presse-papiers est basée sur la taille maximale de message du canal de données WebRTC, qui ne dépend pas de cette règle.";
RemoteAccessHostDomainList.pfm_title = "Configurer les noms de domaines requis pour les hôtes d'accès à distance";
RemoteAccessHostDomainList.pfm_description = "Cette règle permet d'établir la liste des noms de domaine de l'hôte qui sont imposés aux hôtes d'accès à distance et que les utilisateurs ne peuvent pas modifier. Les hôtes ne peuvent être partagés qu'à l'aide de comptes enregistrés sur l'un des noms de domaine spécifiés.\n\nSi cette règle n'est pas configurée ou qu'aucun nom ne figure dans la liste, les hôtes peuvent être partagés à l'aide de n'importe quel compte.\n\nConsultez également la règle \"RemoteAccessHostClientDomainList\".\n\nRemarque : Ce paramètre ignore la règle \"RemoteAccessHostDomain\", le cas échéant.";
RemoteAccessHostFirewallTraversal.pfm_title = "Activer la traversée de pare-feu depuis l'hôte d'accès à distance";
RemoteAccessHostFirewallTraversal.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, elle permet d'utiliser des serveurs STUN. Les clients distants peuvent ainsi détecter cet ordinateur et s'y connecter même s'ils sont séparés par un pare-feu.\n\nSi cette règle est désactivée lorsque les connexions UDP sortantes sont filtrées par le pare-feu, l'ordinateur ne permet que la connexion d'ordinateurs clients au sein du réseau local.";
RemoteAccessHostMatchUsername.pfm_title = "Exiger que le nom de l'utilisateur local corresponde à celui du propriétaire de l'hôte d'accès à distance";
RemoteAccessHostMatchUsername.pfm_description = "Si cette règle est activée, l'hôte d'accès à distance compare le nom de l'utilisateur local auquel il est associé au nom du compte Google enregistré en tant que propriétaire de l'hôte (par exemple, \"pierredupont\" si l'hôte appartient à pierredupont@example.com). Cet hôte ne démarre pas si le nom de son propriétaire diffère de celui de l'utilisateur local auquel l'hôte est associé. Pour faire en sorte que le compte Google du propriétaire soit associé à un domaine spécifique, utilisez la règle avec \"RemoteAccessHostDomain\".\n\nSi la règle est désactivée ou qu'elle n'est pas configurée, l'hôte d'accès à distance peut être associé à n'importe quel utilisateur local.";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "Durée maximale des sessions autorisée pour les connexions d'accès à distance";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "Si cette règle est activée, les connexions d'accès à distance se termineront automatiquement une fois le nombre de minutes défini écoulé. Cela n'empêche pas le client de se reconnecter après avoir atteint la durée maximale de session. Si la durée définie dans cette règle n'est pas comprise dans les limites indiquées, l'hôte risque de ne pas démarrer. Cette règle ne concerne pas les cas d'assistance à distance.\n\nElle n'a aucun effet si elle n'est pas définie. Dans ce cas, les connexions d'accès à distance n'auront pas de limite de durée sur cet ordinateur.";
RemoteAccessHostRequireCurtain.pfm_title = "Activer la protection des hôtes d'accès à distance";
RemoteAccessHostRequireCurtain.pfm_description = "Si cette règle est activée, les appareils d'entrée et de sortie physiques des hôtes d'accès à distance sont désactivés pendant une connexion à distance.\n\nSi cette règle est désactivée ou qu'elle n'est pas configurée, l'utilisateur local et l'utilisateur à distance peuvent interagir avec l'hôte tant que ce celui-ci est partagé.";
RemoteAccessHostUdpPortRange.pfm_title = "Restreindre la plage de ports UDP utilisés par l'hôte d'accès à distance";
RemoteAccessHostUdpPortRange.pfm_description = "Cette règle permet de limiter la plage de ports UDP utilisés par l'hôte d'accès à distance sur cet ordinateur.\n\nSi cette règle n'est pas configurée ou qu'elle est définie sur une chaîne vide, l'hôte en question peut utiliser n'importe quel port disponible.\n\nRemarque : Si la règle \"RemoteAccessHostFirewallTraversal\" est désactivée, l'hôte utilise les ports UDP compris dans la plage 12 400-12 409.";
RemoteDebuggingAllowed.pfm_title = "Autoriser le débogage à distance";
RemoteDebuggingAllowed.pfm_description = "Permet de déterminer si les utilisateurs peuvent effectuer ou non un débogage à distance.\n\nSi cette règle est activée ou si elle n'est pas configurée, les utilisateurs peuvent effectuer un débogage à distance en spécifiant les paramètres de ligne de commande --remote-debugging-port et --remote-debugging-pipe sur les plates-formes de bureau, ou en activant le paramètre système de débogage USB sous Android.\n\nSi cette règle est désactivée, les utilisateurs ne peuvent pas effectuer de débogage à distance.";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "Exiger des contrôles OCSP/CRL en ligne pour les ancres d'approbation locales";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "Si cette règle est définie sur \"True\", Brave vérifie toujours la révocation des certificats de serveur qui sont validés et signés par des certificats CA installés localement. Si Brave ne peut pas obtenir d'informations sur l'état de la révocation, Brave considère ces certificats comme révoqués. Ils sont alors associés à la valeur \"hard-fail\" (échec).\n\nSi cette règle est définie sur \"False\" ou qu'elle n'est pas configurée, Brave utilise les paramètres actuels de vérification en ligne de la révocation.\n\nSous macOS, cette règle n'a aucun effet si la règle ChromeRootStoreEnabled est définie sur \"False\".";
RestoreOnStartup.pfm_title = "Action au démarrage";
RestoreOnStartup.pfm_description = "5 - Ouvrir la page Nouvel onglet\n1 - Restaurer la dernière session\n4 - Ouvrir une liste d'URL\n6 - Ouvrir une liste d'URL et restaurer la dernière session\nCette règle permet de définir le comportement du système au démarrage. Désactiver cette règle revient à ne pas la configurer, car le comportement de Brave au démarrage doit être spécifié.\n\nSi cette règle est configurée, les utilisateurs ne peuvent pas la modifier dans Brave. Si elle n'est pas configurée, les utilisateurs peuvent la modifier.\n\nConfigurer cette règle sur RestoreOnStartupIsLastSession ou RestoreOnStartupIsLastSessionAndURLs désactive certains paramètres qui sont basés sur les sessions ou qui exécutent des actions à la fermeture, comme l'effacement des données de navigation ou des cookies d'une session.\n\nSi cette règle est définie sur RestoreOnStartupIsLastSessionAndURLs, le navigateur restaure la session précédente et ouvre une fenêtre distincte pour afficher les URL spécifiées dans RestoreOnStartupURLs. Les utilisateurs peuvent choisir de garder ces URL ouvertes, lesquelles seront aussi restaurées à la prochaine session.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
RestoreOnStartupURLs.pfm_title = "URL à ouvrir au démarrage";
RestoreOnStartupURLs.pfm_description = "Si la règle RestoreOnStartup est définie sur RestoreOnStartupIsURLs, configurer la règle RestoreOnStartupURLs sur une liste d'URL permet de spécifier les URL à ouvrir.\n\nSi la règle n'est pas configurée, la page \"Nouvel onglet\" s'affiche au démarrage.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "Restreindre l'API Background Fetch lorsqu'elle est appelée à partir d'un service worker";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "Cette règle détermine si les requêtes de récupération en arrière-plan provenant des service workers sont restreintes. Si une fonctionnalité qui télécharge des fichiers en arrière-plan est affectée, cette règle peut être pertinente.\n\nSi cette règle est activée ou n'est pas configurée, la restriction est active et les requêtes de récupération en arrière-plan provenant de contextes de service worker peuvent être bloquées.\n\nSi cette règle est désactivée, la restriction est contournée, ce qui permet à tous les service workers d'effectuer des requêtes de récupération en arrière-plan.\n\nCette règle d'entreprise est temporaire et sera supprimée après M152.";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "Limiter les comptes Google éligibles à l'enregistrement de fichiers PDF dans Google Drive à partir du lecteur PDF Brave";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "Contient une expression régulière permettant de déterminer les comptes Google éligibles à l'enregistrement de fichiers PDF dans Google Drive à partir du lecteur PDF Brave.\n\nUne erreur s'affiche si un utilisateur tente d'importer un fichier PDF dans Google Drive à l'aide d'un compte qui ne correspond pas à ce format.\n\nSi cette règle n'est pas configurée ou est laissée vide, l'utilisateur peut utiliser n'importe quel compte Google pour enregistrer des fichiers PDF dans Google Drive.";
RestrictSigninToPattern.pfm_title = "Restreindre les comptes Google autorisés à être définis comme comptes de navigation principaux dans Brave";
RestrictSigninToPattern.pfm_description = "Contient une expression régulière utilisée pour déterminer quels comptes Google peuvent être configurés comme comptes de navigation principaux sur Brave (par exemple, le compte choisi au moment d'activer la synchronisation).\n\nLe message d'erreur approprié s'affiche si l'utilisateur essaie de définir un compte de navigation principal dont l'identifiant ne correspond pas à ce format.\n\nSi cette règle est laissée vide ou n'est pas configurée, l'utilisateur peut utiliser n'importe quel compte Google comme compte de navigation principal sur Brave.";
RestrictYouTubeCookiesDeletion.pfm_title = "Limiter la suppression des cookies YouTube";
RestrictYouTubeCookiesDeletion.pfm_description = "Empêche la suppression manuelle des cookies YouTube.\n\nCette règle vise à empêcher les utilisateurs d'accéder à YouTube alors qu'ils n'y sont pas autorisés, après avoir supprimé manuellement les cookies YouTube à partir de la page des paramètres du site.\n\nSi cette règle est activée, les cookies YouTube ne peuvent pas être supprimés manuellement.\n\nSi cette règle est désactivée ou qu'elle n'est pas configurée, les cookies YouTube peuvent être supprimés normalement.\n\nRemarque : Cette règle empêche uniquement la suppression manuelle depuis l'UI des paramètres du site. Elle n'empêche pas la suppression automatique par les règles ClearBrowsingDataOnExitList ou BrowsingDataLifetime. De plus, si la règle AllowDeletingBrowserHistory est activée, les utilisateurs peuvent toujours effacer tous leurs cookies via la boîte de dialogue \"Effacer les données de navigation\".";
SSLErrorOverrideAllowed.pfm_title = "Autoriser la poursuite de la navigation depuis une page d'avertissement SSL";
SSLErrorOverrideAllowed.pfm_description = "Si cette règle est activée ou si elle n'est pas configurée, les utilisateurs peuvent passer les pages d'avertissement qu'affiche Brave lorsqu'ils naviguent vers des sites présentant des erreurs SSL.\n\nSi cette règle est désactivée, les utilisateurs ne peuvent pas passer les pages d'avertissement.";
SSLErrorOverrideAllowedForOrigins.pfm_title = "Autoriser l'accès malgré un avertissement SSL depuis certaines origines";
SSLErrorOverrideAllowedForOrigins.pfm_description = "Cette règle permet, si la règle \"SSLErrorOverrideAllowed\" est désactivée, de dresser une liste de formats d'origines afin d'autoriser les utilisateurs qui arrivent sur les sites concernés à passer les pages d'avertissement affichées par Brave en cas d'erreurs SSL. Les utilisateurs ne pourront pas passer les pages d'avertissement SSL des origines qui ne figurent pas dans cette liste.\n\nCette règle n'a aucun effet si la règle \"SSLErrorOverrideAllowed\" est activée ou qu'elle n'est pas configurée.\n\nSi cette règle n'est pas configurée, la règle \"SSLErrorOverrideAllowed\" s'applique à tous les sites.\n\nPour en savoir plus sur les formats d'entrée valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/. La valeur \"*\" n'est pas acceptée pour cette règle. Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.";
SafeBrowsingAllowlistDomains.pfm_title = "Configurez la liste des domaines sur lesquels la navigation sécurisée ne déclenchera aucun avertissement.";
SafeBrowsingAllowlistDomains.pfm_description = "Si cette règle est activée, la fonctionnalité de navigation sécurisée juge fiables les domaines que vous avez spécifiés. Autrement dit, elle ne vérifie pas si des ressources présentent un danger (hameçonnage, logiciels malveillants ou indésirables, par exemple). Le service de protection des téléchargements associé à cette fonctionnalité ne vérifie pas non plus les téléchargements hébergés sur ces domaines. De même, le service de protection par mot de passe ne vérifie pas si un mot de passe est réutilisé.\n\nSi cette règle n'est pas configurée, la navigation sécurisée applique son service de protection par défaut à toutes les ressources.\n\nCette règle n'accepte pas les expressions régulières, mais elle autorise les sous-domaines d'un domaine donné. Les noms de domaine complets ne sont pas obligatoires.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.";
SafeBrowsingDeepScanningEnabled.pfm_title = "Autoriser l'analyse approfondie des téléchargements pour les utilisateurs pour lesquels la navigation sécurisée est activée";
SafeBrowsingDeepScanningEnabled.pfm_description = "Si cette règle est activée ou n'est pas configurée, Brave peut envoyer à Google les téléchargements suspects d'utilisateurs pour lesquels la navigation sécurisée est activée, afin de rechercher des logiciels malveillants, ou inviter les utilisateurs à fournir un mot de passe pour les archives chiffrées.\nSi elle est désactivée, cette analyse n'est pas effectuée.\nCette règle n'a pas d'incidence sur l'analyse du contenu téléchargé configurée par les connecteurs Chrome Enterprise.";
SafeBrowsingProtectionLevel.pfm_title = "Mode de protection de la navigation sécurisée";
SafeBrowsingProtectionLevel.pfm_description = "0 - La navigation sécurisée n'est jamais active.\n1 - La navigation sécurisée est active et en mode de protection standard.\n2 - La navigation sécurisée est active et en mode de protection renforcée. Ce mode offre une meilleure sécurité, mais nécessite de partager plus d'informations de navigation avec Google.\nPermet de contrôler si la fonctionnalité de navigation sécurisée de Brave est activée ou non, ainsi que le mode dans lequel elle est définie.\n\nSi cette règle est définie sur \"NoProtection\" (valeur 0), la navigation sécurisée n'est jamais active.\n\nSi cette règle est définie sur \"StandardProtection\" (valeur 1, qui correspond à la valeur par défaut), la navigation sécurisée est toujours active et en mode de protection standard.\n\nSi cette règle est définie sur \"EnhancedProtection\" (valeur 2), la navigation sécurisée est toujours active et en mode de protection renforcée. Ce mode offre une meilleure sécurité, mais nécessite de partager plus d'informations de navigation avec Google.\n\nSi vous définissez cette règle comme obligatoire, les utilisateurs ne peuvent pas modifier ni ignorer le paramètre de navigation sécurisée dans Brave.\n\nSi cette règle n'est pas configurée, la navigation sécurisée est en mode de protection standard. Toutefois, les utilisateurs peuvent modifier ce paramètre.\n\nPour en savoir plus sur la navigation sécurisée, rendez-vous sur https://support.google.com/chrome?p=safe_browsing_preferences.";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "Autoriser les vérifications en temps réel via proxy pour la navigation sécurisée";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "Ce paramètre détermine si le mode de protection standard de la navigation sécurisée autorise l'envoi des hachages partiels des URL à Google au travers d'un proxy, via un protocole HTTP Oblivious, pour déterminer si elles peuvent être consultées de manière sécurisée.\n\nLe proxy permet aux navigateurs d'importer des hachages partiels d'URL sans les associer à l'adresse IP de l'utilisateur. La règle permet également aux navigateurs d'importer les hachages partiels d'URL avec une fréquence plus élevée pour améliorer la qualité de la protection de la navigation sécurisée.\n\nCette règle est ignorée si la navigation sécurisée est désactivée ou définie sur le mode de protection renforcée.\n\nSi cette règle est activée ou n'est pas configurée, la recherche d'une protection supérieure via proxy est activée.\n\nSi cette règle est désactivée, la recherche d'une protection supérieure via proxy est désactivée. Les hachages partiels d'URL sont importés directement sur Google avec une fréquence beaucoup plus faible, ce qui réduit la protection.";
SafeBrowsingSurveysEnabled.pfm_title = "Autoriser les enquêtes sur la navigation sécurisée";
SafeBrowsingSurveysEnabled.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, l'utilisateur peut recevoir des enquêtes sur la navigation sécurisée.\nSi cette règle est désactivée, l'utilisateur ne reçoit pas ces enquêtes.";
SafeSitesFilterBehavior.pfm_title = "Contrôler le filtrage SafeSites des contenus réservés aux adultes.";
SafeSitesFilterBehavior.pfm_description = "0 - Ne pas filtrer les sites de contenus réservés aux adultes\n1 - Filtrer les sites de contenus réservés aux adultes\nPermet de contrôler l'application du filtre d'URL SafeSites, qui utilise l'API Google Safe Search pour déterminer si une URL est associée ou non à du contenu pornographique.\n\nPrincipe de cette règle :\n\n* Si cette règle est définie sur \"Ne pas filtrer les sites de contenus réservés aux adultes\" ou qu'elle n'est pas configurée, les sites ne sont pas filtrés\n\n* Si cette règle est définie sur \"Filtrer les sites de contenus réservés aux adultes\", les sites pornographiques sont filtrés\n\nCette règle s'applique à la fois à l'URL vers laquelle l'utilisateur navigue et aux iFrames. La règle URLAllowlist prévaut sur cette règle et peut être utilisée pour ignorer les évaluations de l'API Google Safe Search.";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "Autoriser la capture d'onglet de même origine selon ces origines";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "Si cette règle est configurée, vous pouvez lister les formats d'URL qui peuvent prendre une capture d'onglets de même origine.\n\nSi elle ne l'est pas, ces sites ne sont pas pris en compte dans les exceptions à ce niveau de capture.\n\nNotez que les Applications Chrome en mode fenêtre qui ont la même origine que ce site pourront quand même être capturées.\n\nSi un site correspond à un format d'URL dans cette règle, les règles suivantes sont ignorées : TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nPour en savoir plus sur les formats url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.  Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.";
SandboxExternalProtocolBlocked.pfm_title = "Autoriser Chrome à bloquer les navigations vers des protocoles externes dans des cadres iFrame en bac à sable";
SandboxExternalProtocolBlocked.pfm_description = "Chrome bloquera les navigations vers des protocoles externes dans\nun iFrame en bac à sable. Consultez https://chromestatus.com/features/5680742077038592.\n\nSi cette règle est définie sur \"True\", Chrome bloque ces navigations.\n\nSi elle est définie sur \"False\", Chrome ne peut pas les bloquer.\n\nElle est définie par défaut sur \"True\" (fonctionnalité de sécurité activée).\n\nLes administrateurs qui ont besoin de plus de temps pour mettre à jour leur site interne concerné par cette nouvelle restriction peuvent utiliser cette règle. Cette règle d'entreprise est temporaire et sera normalement supprimée après la version 117 de Brave.\n";
SavingBrowserHistoryDisabled.pfm_title = "Désactiver l'enregistrement de l'historique du navigateur";
SavingBrowserHistoryDisabled.pfm_description = "Si cette règle est activée, l'historique de navigation n'est pas enregistré, la synchronisation des onglets est désactivée et les utilisateurs ne peuvent pas modifier ce paramètre.\n\nSi cette règle est désactivée ou si elle n'est pas configurée, l'historique de navigation est enregistré.";
ScreenCaptureAllowed.pfm_title = "Autoriser ou interdire la capture d'écran";
ScreenCaptureAllowed.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée (par défaut), une page Web peut utiliser des API de partage d'écran (ex. : getDisplayMedia() ou Desktop Capture Extension) pour inviter l'utilisateur à sélectionner un onglet, une fenêtre ou un écran dont il veut prendre une capture.\n\nSi elle est désactivée, tous les appels d'API de partage d'écran échouent et génèrent une erreur. Toutefois, cette règle est ignorée (et un site sera autorisé à utiliser des API de partage d'écran) si le site correspond à un format d'origine dans l'une des règles suivantes :\nScreenCaptureAllowedByOrigins,\nWindowCaptureAllowedByOrigins,\nTabCaptureAllowedByOrigins,\nSameOriginTabCaptureAllowedByOrigins.\n";
ScreenCaptureAllowedByOrigins.pfm_title = "Autoriser les captures d'écran, de fenêtre et d'onglet selon ces origines";
ScreenCaptureAllowedByOrigins.pfm_description = "Si cette règle est configurée, vous pouvez lister les formats d'URL qui peuvent utiliser les captures d'écran, de fenêtre et d'onglet.\n\nSi elle ne l'est pas, ces sites ne sont pas pris en compte pour un remplacement à ce niveau de capture.\n\nCette règle est ignorée si un site correspond à un format d'URL dans l'une de ces règles : WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nSi un site correspond à un format d'URL dans cette règle, la règle ScreenCaptureAllowed est ignorée.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.  Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "Autoriser la capture d'écran sans geste préalable de l'utilisateur";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "Pour des raisons de sécurité, l'API Web getDisplayMedia() nécessite un geste préalable de l'utilisateur (\"activation temporaire\"). Sinon, une erreur se produit.\n\nUne fois cette règle définie, les administrateurs peuvent préciser les origines sur lesquelles cette API peut être appelée sans geste préalable de l'utilisateur.\n\nPour en savoir plus sur les formats d'URL valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/. La valeur * n'est pas acceptée pour cette règle.\n\nSi cette règle n'est pas configurée, toutes les origines nécessitent un geste préalable de l'utilisateur pour appeler cette API.";
ScrollToTextFragmentEnabled.pfm_title = "Activer le défilement jusqu'au texte spécifié dans des fragments d'URL";
ScrollToTextFragmentEnabled.pfm_description = "Cette fonctionnalité permet aux URL de pointer directement vers un fragment de texte spécifique dans une page Web de sorte que, une fois chargée, la page défile jusqu'à ce fragment de texte.\n\nSi vous activez cette règle ou ne la configurez pas, le défilement des pages Web vers des fragments de texte spécifiques via URL sera activé.\n\nSi vous la désactivez, le défilement des pages Web vers des fragments de texte spécifiques via URL sera désactivé.";
SearchContentSharingSettings.pfm_title = "Activer le partage de contenu avec les intégrations du Google AI Mode et de Lens";
SearchContentSharingSettings.pfm_description = "0 - Autoriser le partage de contenu avec les intégrations Google AI Mode.\n1 - Ne pas autoriser le partage de contenu avec les intégrations Google AI Mode.\nCette règle contrôle le partage du contenu de la page ou du fichier avec le Google AI Mode et Lens via le panneau latéral ou les onglets de Google Chrome.\n\nSachez que cette règle n'a pas d'incidence sur le Google AI Mode sur le Web. Elle contrôle uniquement la façon dont les utilisateurs peuvent partager des informations avec ce mode lorsqu'ils utilisent Google Chrome.\n\n0 : les utilisateurs peuvent partager le contenu de la page ou du fichier avec le Google AI Mode.\n\n1 : les utilisateurs ne peuvent pas partager le contenu de la page ou du fichier avec le Google AI Mode. Les points d'entrée pour partager le contexte et le panneau latéral sont alors désactivés ou masqués.\n\nCette règle est ignorée lorsque la Google Search n'est pas le moteur de recherche par défaut des utilisateurs, car la fonctionnalité est désactivée.\n\nCette règle est indépendante de la règle AIModeSettings. La règle AIModeSettings ne contrôle que les points d'entrée sur l'omnibox ou le champ de recherche de la page \"Nouvel onglet\", tandis que cette règle contrôle le partage de contexte via le panneau latéral ou les onglets.\n\nCette règle ne contrôle pas non plus l'intégration de Google Gemini, qui peut être désactivée par GeminiSettings.\n\nSi cette règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
SearchSuggestEnabled.pfm_title = "Activer les suggestions de recherche";
SearchSuggestEnabled.pfm_description = "Si cette règle est définie sur \"True\", la fonctionnalité Suggestions de recherche est activée dans la barre d'adresse du navigateur Brave. Si cette règle est définie sur \"False\", cette fonctionnalité est désactivée.\n\nLes suggestions basées sur les favoris ou sur l'historique ne sont pas concernées par cette règle.\n\nSi vous configurez cette règle, les utilisateurs ne peuvent pas la modifier. Si cette règle n'est pas configurée, cette fonctionnalité est activée par défaut, mais les utilisateurs peuvent la désactiver à tout moment.";
SecurityKeyPermitAttestation.pfm_title = "URL/domaines automatiquement autorisés à recevoir une attestation des clés de sécurité";
SecurityKeyPermitAttestation.pfm_description = "Cette règle permet de spécifier les ID RP WebAuthn pour lesquels aucune invite ne s'affiche lorsque des certificats d'attestation des clés de sécurité sont demandés. Un signal est également envoyé à la clé de sécurité pour indiquer qu'une attestation d'entreprise peut être utilisée. Sans cela, dans Brave 65 et versions ultérieures, les utilisateurs sont avertis lorsque des sites demandent une attestation des clés de sécurité.";
SensorsAllowedForUrls.pfm_title = "Autoriser l'accès aux capteurs sur ces sites";
SensorsAllowedForUrls.pfm_description = "Permet de dresser la liste des formats d'URL pour lesquels les sites sont autorisés à accéder aux capteurs (de mouvement et de lumière, par exemple).\n\nSi cette règle n'est pas configurée, la règle DefaultSensorsSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nSi un même format d'URL est spécifié à la fois dans cette règle et dans la règle SensorsBlockedForUrls, cette dernière est prioritaire et l'accès aux capteurs de mouvement ou de lumière est bloqué.\n\nPour en savoir plus sur les formats url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
SensorsBlockedForUrls.pfm_title = "Bloquer l'accès aux capteurs sur ces sites";
SensorsBlockedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites ne peuvent pas accéder aux capteurs (de mouvement et de lumière, par exemple).\n\nSi cette règle n'est pas configurée, la règle DefaultSensorsSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nSi un même format d'URL est spécifié à la fois dans cette règle et dans la règle SensorsAllowedForUrls, la première prévaut, et l'accès aux capteurs de mouvement ou de lumière est bloqué.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés.";
SerialAllowAllPortsForUrls.pfm_title = "Autoriser automatiquement les sites à se connecter à tous les ports série.";
SerialAllowAllPortsForUrls.pfm_description = "Cette règle permet d'établir la liste des sites automatiquement autorisés à accéder à tous les ports série disponibles.\n\nSi les URL ne sont pas valides, la règle est ignorée. Seule l'origine (schéma, hôte et port) de l'URL est prise en compte.\n\nSur Google Chrome OS, cette règle ne s'applique qu'aux utilisateurs affiliés.\n\nElle remplace DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls et les préférences de l'utilisateur.";
SerialAllowUsbDevicesForUrls.pfm_title = "Autoriser automatiquement les sites à se connecter aux appareils série USB.";
SerialAllowUsbDevicesForUrls.pfm_description = "Cette règle permet d'établir la liste des sites qui sont automatiquement autorisés à accéder aux appareils série USB avec les ID produit et de fournisseur correspondant aux champs product_id et vendor_id. Si vous ne renseignez pas le champ product_id, la règle autorise les sites donnés à accéder aux appareils à l'aide d'un ID de fournisseur correspondant au champ vendor_id et de n'importe quel ID produit.\n\nSi les URL ne sont pas valides, la règle est ignorée. Seule l'origine (schéma, hôte et port) de l'URL est prise en compte.\n\nSur Chrome OS, cette règle ne s'applique qu'aux utilisateurs affiliés.\n\nElle remplace DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls et les préférences de l'utilisateur.\n\nCette règle ne concerne que l'accès aux appareils USB via l'API Web Serial. Pour autoriser l'accès aux appareils USB via l'API WebUSB, consultez la règle WebUsbAllowDevicesForUrls.\nConsultez la page https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls pour en savoir plus sur le schéma et le formatage.";
SerialAskForUrls.pfm_title = "Autoriser l'API Serial sur ces sites";
SerialAskForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites peuvent demander aux utilisateurs l'accès à un port série.\n\nSi cette règle n'est pas configurée, la règle DefaultSerialGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si elle n'est pas définie, les paramètres spécifiés par les utilisateurs s'appliquent.\n\nSi le format d'URL ne correspond pas à celui défini dans cette règle, les règles suivantes s'appliquent, selon l'ordre de priorité suivant : SerialBlockedForUrls (si une correspondance existe), DefaultSerialGuardSetting (si elle est définie) ou les paramètres personnels des utilisateurs.\n\nSi les formats d'URL entrent en conflit avec SerialBlockedForUrls, ils sont ignorés.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
SerialBlockedForUrls.pfm_title = "Bloquer l'API Serial sur ces sites";
SerialBlockedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites ne peuvent pas demander aux utilisateurs l'accès à un port série.\n\nSi cette règle n'est pas configurée, la règle DefaultSerialGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nSi le format d'URL ne correspond pas à celui défini dans cette règle, les règles suivantes s'appliquent, selon l'ordre de priorité suivant : SerialAskForUrls (si une correspondance existe), DefaultSerialGuardSetting (si elle est définie) ou les paramètres personnels de l'utilisateur.\n\nSi les formats d'URL entrent en conflit avec SerialAskForUrls, cette règle prévaut.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
ServiceWorkerAutoPreloadEnabled.pfm_title = "Autoriser ServiceWorker à distribuer des requêtes de navigation sans attendre son démarrage";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nLa fonctionnalité ServiceWorkerAutoPreload envoie une requête réseau pour une ressource principale en même temps qu'elle lance le processus d'amorçage ServiceWorker.\n\nSi cette règle est activée ou qu'elle n'est pas configurée, Brave active ServiceWorkerAutoPreload. La requête de navigation est automatiquement distribuée lors du démarrage de ServiceWorker dans certains scénarios, par exemple lorsque ServiceWorker n'est pas en cours d'exécution.\n\nSi cette règle est désactivée, Brave n'activera pas ServiceWorkerAutoPreload. La requête de navigation est toujours distribuée après le démarrage de ServiceWorker.\n\nCette règle est une mesure temporaire pour contrôler la fonctionnalité et sera supprimée dans M154.";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "Autoriser ServiceWorker à contrôler les iFrames srcdoc";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "https://github.com/w3c/ServiceWorker/issues/765 demande que ServiceWorker contrôle l'iFrame srcdoc avec l'attribut sandbox \"allow-same-origin\".\n\nSi cette règle est activée ou si elle n'est pas configurée, Brave fait en sorte que ServiceWorker contrôle les iFrames srcdoc avec des attributs sandbox \"allow-same-origin\".\n\nSi cette règle est désactivée, ServiceWorker ne contrôle pas l'iFrame srcdoc.\n\nCette règle est provisoire et sera supprimée en 2026.";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "Indique si SharedArrayBuffers peut être utilisé dans un contexte non isolé multi-origine";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\nIndique si SharedArrayBuffer peut être utilisé dans un contexte non isolé multi-origine. Pour des raisons de compatibilité Web, Brave nécessitera un contexte isolé multi-origine lors de l'utilisation de SharedArrayBuffer à partir de Brave 91 (25/05/2021). Pour en savoir plus, consultez https://developer.chrome.com/blog/enabling-shared-array-buffer/.\n\nLorsque cette règle est définie sur \"True\", les sites peuvent utiliser SharedArrayBuffer sans aucune restriction.\n\nSi cette règle est définie sur \"False\" ou n'est pas configurée, les sites ne peuvent utiliser SharedArrayBuffer que dans un contexte isolé multi-origine.";
SharedWorkerBlobURLFixEnabled.pfm_title = "Adapter le comportement de l'URL blob SharedWorker à la spécification";
SharedWorkerBlobURLFixEnabled.pfm_description = "Selon https://w3c.github.io/ServiceWorker/#control-and-use-worker-client, les workers doivent hériter des contrôleurs pour l'URL blob.  Toutefois, le code existant n'autorise que les DedicatedWorkers à hériter du contrôleur, et les SharedWorkers n'en héritent pas.\n\nSi cette règle est activée ou si elle n'est pas configurée, Brave hérite du contrôleur si une URL blob est utilisée comme URL SharedWorker.\n\nSi vous désactivez cette règle, le comportement ne sera pas aligné sur la spécification actuelle.\n\nCette règle est provisoire et sera supprimée à l'avenir.";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "Activer la durée de vie étendue pour les SharedWorkers";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "Les SharedWorkers peuvent avoir une durée de vie étendue si l'option \"extendedLifetime\" est définie sur \"true\" dans le constructeur SharedWorker.\n\nSi cette règle est activée ou n'est pas configurée, les SharedWorkers peuvent avoir une durée de vie étendue.\n\nSi cette règle est désactivée, les SharedWorkers ne peuvent pas avoir une durée de vie étendue, même si l'option est définie sur \"true\".\n\nCette règle est provisoire et sera supprimée prochainement.";
ShoppingListEnabled.pfm_title = "Autoriser l'activation de la fonctionnalité Liste d'achats";
ShoppingListEnabled.pfm_description = "Cette règle détermine la disponibilité de la fonctionnalité Liste d'achats.\nSi elle est activée, les utilisateurs voient l'interface permettant de suivre le prix du produit affiché sur la page active. Le produit suivi s'affiche alors dans le panneau latéral des favoris.\nSi cette règle est activée ou n'est pas configurée, les utilisateurs ont accès à la fonctionnalité Liste d'achats.\nSi elle est désactivée, la fonctionnalité Liste d'achats n'est pas disponible.\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "Afficher le raccourci des applications dans la barre de favoris";
ShowAppsShortcutInBookmarkBar.pfm_description = "Si cette règle est définie sur \"True\", le raccourci des applications est affiché. Si cette règle est définie sur \"False\", ce raccourci n'est jamais affiché.\n\nSi vous configurez cette règle, les utilisateurs ne peuvent pas la modifier. Si cette règle n'est pas configurée, les utilisateurs peuvent choisir d'afficher ou de masquer ce raccourci dans le menu contextuel de la barre de favoris.";
ShowCastIconInToolbar.pfm_title = "Afficher l'icône de la barre d'outils de Google Cast";
ShowCastIconInToolbar.pfm_description = "Si cette règle est activée, l'icône Cast s'affiche dans la barre d'outils ou dans le menu à développer, et les utilisateurs ne peuvent pas la supprimer.\n\nSi cette règle est désactivée ou n'est pas configurée, les utilisateurs peuvent épingler ou retirer l'icône depuis son menu contextuel.\n\nSi la règle EnableMediaRouter est désactivée, elle n'a aucune incidence, et l'icône de la barre d'outils n'est pas affichée.";
ShowCastSessionsStartedByOtherDevices.pfm_title = "Afficher les commandes multimédias pour les sessions Google Cast lancées par d'autres appareils sur le réseau local";
ShowCastSessionsStartedByOtherDevices.pfm_description = "Lorsque cette règle est activée, l'UI des commandes de lecture multimédia est disponible pour les sessions Google Cast lancées par d'autres appareils sur le réseau local.\n\nSi cette règle n'est pas configurée pour les utilisateurs de la version Enterprise ou si elle est désactivée, l'UI des commandes de lecture multimédia n'est pas disponible pour les sessions Google Cast lancées par d'autres appareils sur le réseau local.\n\nSi la règle EnableMediaRouter est désactivée, cette règle n'a aucune incidence, car tout le fonctionnement de Google Cast est désactivé.";
ShowFullUrlsInAddressBar.pfm_title = "Affiche les URL complètes";
ShowFullUrlsInAddressBar.pfm_description = "Permet d'afficher ou non l'URL complète dans la barre d'adresse.\nSi cette règle est définie sur \"True\", l'URL complète est affichée dans la barre d'adresse, y compris les schémas et les sous-domaines.\nSi cette règle est définie sur \"False\", l'URL par défaut s'affiche.\nSi cette règle n'est pas configurée, l'URL par défaut s'affiche. Toutefois, l'utilisateur peut alterner entre l'affichage par défaut et l'affichage de l'URL complète à l'aide d'une option de menu contextuel.\n";
ShowHomeButton.pfm_title = "Afficher le bouton Accueil sur la barre d'outils";
ShowHomeButton.pfm_description = "Si cette règle est activée, le bouton d'accueil s'affiche sur la barre d'outils de Brave. Si elle est désactivée, le bouton d'accueil ne s'affiche pas.\n\nSi cette règle est configurée, les utilisateurs ne peuvent pas la modifier dans Brave. Si elle n'est pas configurée, les utilisateurs peuvent choisir d'afficher ou non le bouton d'accueil.";
SideSearchEnabled.pfm_title = "Autoriser l'affichage de la page des résultats les plus récents du moteur de recherche par défaut dans un panneau latéral du navigateur";
SideSearchEnabled.pfm_description = "Si cette règle est activée ou n'est pas configurée, les utilisateurs peuvent afficher la page la plus récente des résultats du moteur de recherche par défaut dans un panneau latéral à l'aide d'une icône de la barre d'outils.\n\nSi cette règle est désactivée, cette icône qui permet d'ouvrir le panneau latéral contenant la page de résultats du moteur de recherche par défaut n'est pas affichée dans la barre d'outils.";
SignedHTTPExchangeEnabled.pfm_title = "Activer la compatibilité avec la fonctionnalité Signed HTTP Exchange (SXG)";
SignedHTTPExchangeEnabled.pfm_description = "Si cette règle est définie sur \"True\" ou si elle n'est pas configurée, Brave accepte la diffusion de contenus Web en tant que Signed HTTP Exchanges.\n\nSi cette règle est définie sur \"False\", les Signed HTTP Exchanges ne peuvent pas être chargés.";
SigninInterceptionEnabled.pfm_title = "Activer l'interception de connexion";
SigninInterceptionEnabled.pfm_description = "Ce paramètre active ou désactive l'interception de connexion.\n\nSi cette règle est activée, ou si elle n'est pas configurée, la boîte de dialogue d'interception de connexion s'ouvre lorsqu'un compte Google est ajouté sur le Web. L'utilisateur peut alors déplacer ce compte vers un autre profil (nouveau ou existant).\n\nSi elle est désactivée, la boîte de dialogue d'interception de connexion ne s'ouvre pas.\nDans ce cas, une boîte de dialogue s'affiche néanmoins si ManagedAccountsSigninRestriction force la séparation des profils de comptes gérés.";
SilentPrintingEnabled.pfm_title = "Activer l'impression silencieuse";
SilentPrintingEnabled.pfm_description = "Si cette règle est définie sur \"True\", l'impression silencieuse est activée. La fenêtre d'aperçu avant impression se ferme immédiatement lorsqu'elle s'ouvre, et l'impression est lancée sur l'imprimante par défaut avec les options par défaut. Si l'imprimante par défaut est définie sur \"Enregistrer au format PDF\", le fichier sera enregistré dans le dossier \"Téléchargements\".\n\nSi cette règle n'est pas configurée ou qu'elle est définie sur \"False\", l'impression silencieuse est désactivée. La fenêtre d'aperçu avant impression ne se ferme pas automatiquement et l'utilisateur doit sélectionner une option comme d'habitude.";
SitePerProcess.pfm_title = "Exiger l'isolation de chaque site";
SitePerProcess.pfm_description = "Depuis Brave 67, l'isolation de sites a été activée par défaut sur toutes les plates-formes de bureau. Chaque site exécute ainsi son propre processus. Un site est un schéma avec eTLD+1 (ex. : https://example.com). Activer cette règle ne change pas ce comportement. Cela empêche seulement les utilisateurs de s'y soustraire (par exemple, via l'option \"Désactiver l'isolation de sites\" sur chrome://flags). Depuis Brave 76, si cette règle est désactivée ou qu'elle n'est pas configurée, l'isolation de sites n'est pas désactivée, mais les utilisateurs peuvent s'y soustraire.\n\nIsolateOrigins peut aussi être utile pour isoler des origines spécifiques plus précisément que le site (ex. : https://a.example.com).\n\nPour Google Chrome OS 76 ou version antérieure, attribuez la même valeur à la règle DeviceLoginScreenSitePerProcess relative aux appareils. Si les valeurs diffèrent, cela peut ralentir l'ouverture de la session utilisateur.\n\nRemarque : Sous Android, utilisez la règle SitePerProcessAndroid à la place.";
SiteSearchSettings.pfm_title = "Paramètres de recherche sur site";
SiteSearchSettings.pfm_description = "Cette règle liste des sites sur lesquels les utilisateurs peuvent effectuer des recherches rapides à l'aide de raccourcis dans la barre d'adresse. Les utilisateurs peuvent lancer une recherche en saisissant dans la barre d'adresse le raccourci ou raccourci précédé du caractère @ (par exemple, @travail), puis en appuyant sur la barre d'espace ou la touche de tabulation.\n\nLes champs suivants sont obligatoires pour chaque site : name, shortcut, url.\n\nLe champ name correspond au nom du site ou du moteur de recherche à présenter à l'utilisateur dans la barre d'adresse.\n\nLe champ shortcut peut contenir des mots et caractères bruts, mais il ne peut pas inclure d'espaces ni commencer par le symbole @. Les raccourcis doivent également être uniques.\n\nPour chaque entrée, le champ url indique l'URL du moteur de recherche utilisé lors d'une recherche avec le mot clé correspondant. L'URL doit inclure la chaîne '{searchTerms}', qui sera remplacée dans la requête par les termes de recherche de l'utilisateur. Les entrées non valides et celles comportant des raccourcis en double sont ignorées.\n\nLes entrées de recherche sur site configurées comme mises en avant sont affichées dans la barre d'adresse quand l'utilisateur saisit \"@\". Jusqu'à trois entrées peuvent être sélectionnées comme mises en avant.\n\nPour une entrée de recherche sur site où allow_user_override est défini sur \"true\", les utilisateurs peuvent modifier ou désactiver cette entrée. Toutefois, les moteurs mis en avant (commençant par \"@\") ne peuvent être que désactivés. Si un utilisateur modifie une entrée créée initialement par cette règle, elle ne sera plus gérée par la règle et sera traitée comme un raccourci créé par l'utilisateur. Lorsque allow_user_override est défini sur \"false\" ou n'est pas spécifié pour une entrée de recherche sur site, l'utilisateur ne peut pas modifier ni désactiver cette entrée. Le paramètre permettant d'autoriser le remplacement par l'utilisateur n'est compatible qu'avec M139 et les versions ultérieures. Les versions antérieures désactivent par défaut le remplacement par l'utilisateur.\n\nL'utilisateur ne peut pas créer d'entrées de recherche sur site avec un raccourci créé précédemment à l'aide de cette règle, sauf si allow_user_override est définie sur \"true\" pour l'entrée de recherche sur site.\n\nEn cas de conflit avec un raccourci que l'utilisateur a créé précédemment, le paramètre de l'utilisateur prévaut. Toutefois, l'utilisateur peut toujours déclencher l'option créée par la règle en saisissant le caractère @ dans la barre de recherche. Par exemple, si l'utilisateur a déjà défini \"travail\" comme raccourci vers l'URL1 et que la règle définit \"travail\" comme raccourci vers l'URL2, saisir \"travail\" dans la barre de recherche déclenchera une recherche sur l'URL1, mais saisir \"@travail\" dans la barre de recherche déclenchera une recherche sur l'URL2.\n\nSous Microsoft® Windows®, cette règle n'est disponible que sur les instances associées à un domaine Microsoft® Active Directory®, à Microsoft® Azure® Active Directory® ou qui bénéficient de Chrome Enterprise Core.\n\nSous macOS, cette règle n'est disponible que sur les instances gérées via MDM, associées à un domaine via MCX ou qui bénéficient de Chrome Enterprise Core.\nConsultez la page https://chromeenterprise.google/policies/?policy=SiteSearchSettings pour en savoir plus sur le schéma et le formatage.";
SmartTabSharingSettings.pfm_title = "Paramètres du partage intelligent d'onglets";
SmartTabSharingSettings.pfm_description = "0 - Autoriser le partage intelligent d'onglets avec les intégrations du Google AI Mode.\n1 - Ne pas autoriser le partage intelligent d'onglets avec les intégrations du Google AI Mode.\nCette règle contrôle la fonctionnalité de partage intelligent d'onglets du Google AI Mode via le panneau latéral ou les onglets de Google Chrome.\n\nSachez que cette règle n'a pas d'incidence sur le Google AI Mode sur le Web. Elle contrôle uniquement la façon dont les utilisateurs peuvent partager des informations avec ce mode lorsqu'ils utilisent Google Chrome.\n\n0 : les utilisateurs peuvent partager le contenu de la page ou du fichier avec le Google AI Mode.\n\n1 : les utilisateurs ne peuvent pas partager le contenu de la page ou du fichier avec le Google AI Mode. Les points d'entrée pour partager le contexte et le panneau latéral sont alors désactivés ou masqués.\n\nCette règle est ignorée lorsque la Google Search n'est pas le moteur de recherche par défaut des utilisateurs, car la fonctionnalité est désactivée.\n\nCette règle est indépendante de la règle AIModeSettings. La règle AIModeSettings ne contrôle que les points d'entrée sur l'omnibox ou le champ de recherche de la page \"Nouvel onglet\", tandis que cette règle contrôle le partage de contexte via le panneau latéral ou les onglets.\n\nCette règle ne contrôle pas non plus l'intégration de Google Gemini, qui peut être désactivée par GeminiSettings.\n\nSachez que si SearchContentSharingSettings est désactivée, cette règle est ignorée.\n\nSi cette règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
SpellCheckServiceEnabled.pfm_title = "Activer ou désactiver le service Web de correction orthographique";
SpellCheckServiceEnabled.pfm_description = "Si cette règle est activée, un service Web Google est utilisé pour faciliter la correction des erreurs d'orthographe. Cette règle ne contrôle que l'utilisation du service en ligne. Si elle est désactivée, le service n'est jamais utilisé.\n\nSi elle n'est pas définie, les utilisateurs peuvent choisir d'utiliser ou non le service de correction orthographique.\n\nLe correcteur orthographique peut toujours utiliser un dictionnaire téléchargé en local, sauf si la fonctionnalité est désactivée par SpellcheckEnabled, auquel cas cette règle n'a aucun effet.";
SpellcheckEnabled.pfm_title = "Activer la vérification orthographique";
SpellcheckEnabled.pfm_description = "Si cette règle est activée, le correcteur orthographique l'est également, et les utilisateurs ne peuvent pas le désactiver. Sur Microsoft® Windows®, Google Chrome OS et Linux®, il est possible d'ajouter et de supprimer des langues au cas par cas pour le correcteur orthographique. Les utilisateurs peuvent ainsi désactiver le correcteur en supprimant toutes les langues. Afin d'éviter ce cas de figure, utilisez SpellcheckLanguage pour forcer l'ajout de langues spécifiques au correcteur orthographique.\n\nSi cette règle est désactivée, le correcteur l'est également sur toutes les sources, et les utilisateurs ne peuvent pas l'activer Les règles SpellCheckServiceEnabled, SpellcheckLanguage et SpellcheckLanguageBlocklist n'ont aucun effet si cette règle est définie sur \"False\".\n\nSi cette règle n'est pas définie, les utilisateurs peuvent activer ou désactiver le correcteur orthographique à leur guise dans les paramètres linguistiques.";
StandardizedBrowserZoomEnabled.pfm_title = "Activer le comportement standardisé du zoom dans le navigateur";
StandardizedBrowserZoomEnabled.pfm_description = "Cette règle permet de suivre la spécification nouvellement adoptée concernant le zoom CSS.\n\nLorsque cette règle est activée ou n'est pas configurée, la propriété \"zoom\" CSS suit la spécification ci-après :\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\nLorsque cette règle est désactivée, la propriété \"zoom\" CSS fonctionne de la même manière qu'avant la spécification standard.\n\nCette règle est proposée pour une durée limitée afin de laisser le temps de migrer le contenu Web en fonction de la nouvelle spécification. Il existe aussi un essai Original Trial (DisableStandardizedBrowserZoom) qui correspond au comportement quand cette règle est désactivée. Dans la version 134, cette règle sera supprimée et le zoom CSS suivra la spécification standard de façon permanente.";
StaticStorageQuotaEnabled.pfm_title = "Contrôler si les API de quota de stockage renvoient des valeurs statiques";
StaticStorageQuotaEnabled.pfm_description = "Lorsque cette règle est activée, les API de quota de stockage renvoient une valeur statique égale à l'utilisation + min (10 Gio, espace disque arrondi à l'entier le plus proche de 1 Gio).\nLorsque cette règle est désactivée, les API de quota de stockage renvoient généralement une valeur dynamique proportionnelle à l'espace total disponible sur l'appareil, quelle que soit l'utilisation.\nSi cette règle n'est pas configurée, les API de quota de stockage utilisent le comportement Chrome par défaut.\nLes sites disposant d'autorisations de stockage illimité ne sont pas concernés par ce paramètre. Le quota appliqué n'est pas non plus affecté.";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "Activer la vérification stricte du type MIME pour les scripts de nœuds de calcul";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "Cette règle active la vérification stricte du type MIME pour les scripts de nœuds de calcul.\n\nSi cette règle est activée ou n'est pas configurée, les scripts de nœuds de calcul utiliseront une vérification stricte du type MIME pour JavaScript, qui est le nouveau comportement par défaut. Les scripts de nœuds de calcul avec d'anciens types MIME seront refusés.\n\nSi cette règle est désactivée, les scripts de nœuds de calcul utilisent la vérification laxiste du type MIME pour que les scripts de nœuds de calcul avec d'anciens types MIME (ex. : text/ascii) continuent d'être chargés et exécutés.\n\nLes navigateurs utilisaient traditionnellement la vérification laxiste du type MIME pour que les ressources comportant un certain nombre d'anciens types MIME puissent être compatibles. Par exemple, text/ascii est un ancien type MIME compatible avec les ressources JavaScript. Cela peut entraîner des problèmes de sécurité en autorisant le chargement de ressources en tant que scripts qui n'ont jamais été conçus pour être utilisés comme tels. Chrome passera prochainement à la vérification stricte du type MIME. La règle activée suit le comportement par défaut. La désactivation de cette règle permet aux administrateurs de conserver l'ancien comportement, s'ils le souhaitent.\n\nPour en savoir plus sur les types de contenus JavaScript/ECMAScript, consultez https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage.\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "Supprimer les boîtes de dialogue JavaScript déclenchées depuis des sous-frames d'une autre origine";
SuppressDifferentOriginSubframeDialogs.pfm_description = "Tel que décrit sur https://www.chromestatus.com/feature/5148698084376576, les boîtes de dialogue modales JavaScript déclenchées par window.alert, window.confirm et window.prompt seront bloquées sur Brave si elles sont déclenchées depuis un sous-frame dont l'origine est différente de celle du frame principal.\n\nCette règle permet d'ignorer cette distinction.\nSi la règle est activée ou n'est pas définie, les boîtes de dialogue JavaScript déclenchées depuis un sous-frame d'une origine différente seront bloquées.\nSi elle est désactivée, les boîtes de dialogue JavaScript déclenchées depuis un sous-frame d'une origine différente ne seront pas bloquées.\n\nCette règle sera supprimée prochainement de Brave.";
SuppressUnsupportedOSWarning.pfm_title = "Supprimer l'avertissement relatif au système d'exploitation non compatible";
SuppressUnsupportedOSWarning.pfm_description = "Si cette règle est activée, l'avertissement qui s'affiche lorsque Brave s'exécute sur un ordinateur ou un système d'exploitation non compatible est supprimé.\n\nSi elle est désactivée ou si elle n'est pas configurée, les avertissements s'affichent sur les systèmes non compatibles.";
SyncDisabled.pfm_title = "Désactiver la synchronisation des données avec Google";
SyncDisabled.pfm_description = "Activée, cette règle permet de désactiver la synchronisation des données dans Brave à l'aide des services de synchronisation hébergés par Google.\nPour désactiver complètement les services Chrome Sync, nous vous conseillons de désactiver le service dans la Google Admin console.\n\nSi cette règle est désactivée ou n'est pas configurée, les utilisateurs peuvent décider d'utiliser ou non Chrome Sync.\n\nRemarque : Cette règle ne doit pas être activée si la règle RoamingProfileSupportEnabled l'est également, car elles partagent la même fonctionnalité côté client. Dans ce cas, le service de synchronisation hébergé par Google est totalement désactivé.";
SyncTypesListDisabled.pfm_title = "Liste des types à exclure de la synchronisation";
SyncTypesListDisabled.pfm_description = "Si cette règle est configurée, tous les types de données spécifiés ne seront pas synchronisés avec Chrome Sync ni avec le profil itinérant. Cela peut permettre de réduire la taille du profil itinérant ou de limiter les types de données importés sur les serveurs Chrome Sync.\n\nLes types de données actuels pour cette règle sont : \"apps\", \"autofill\", \"bookmarks\", \"extensions\", \"preferences\", \"passwords\", \"payments\", \"productComparison\", \"readingList\", \"tabs\", \"themes\", \"typedUrls\" et \"wifiConfigurations\". Ces noms sont sensibles à la casse.\n\nRemarques : L'actualisation dynamique des stratégies n'est disponible qu'à partir de la version 123 de Brave. La désactivation du type de données \"autofill\" désactive également le type \"payments\". \"typedUrls\" fait référence à tout l'historique de navigation.";
TLS13EarlyDataEnabled.pfm_title = "Activer TLS 1.3 Early Data";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Early Data est une extension de TLS 1.3 qui permet d'envoyer une requête HTTP simultanément avec le handshake TLS.\n\nSi cette règle n'est pas configurée, Brave suivra le processus de déploiement par défaut pour TLS 1.3 Early Data.\n\nSi elle est activée, Brave activera TLS 1.3 Early Data.\n\nSi elle est désactivée, Brave n'activera pas TLS 1.3 Early Data.\n\nLorsque cette fonctionnalité est activée, Brave peut utiliser ou non TLS 1.3 Early Data en fonction de la compatibilité avec le serveur.\n\nTLS 1.3 Early Data est un protocole établi. Les serveurs TLS, les boîtiers intermédiaires et les logiciels de sécurité existants devraient gérer ou rejeter TLS 1.3 Early Data sans interrompre la connexion.\n\nToutefois, les appareils qui n'implémentent pas correctement TLS peuvent dysfonctionner et se déconnecter lorsque TLS 1.3 Early Data est utilisée. Si cela se produit, les administrateurs doivent contacter le fournisseur pour obtenir une solution.\n\nCette règle est une mesure temporaire pour contrôler la fonctionnalité et sera supprimée par la suite. Elle peut être activée pour vous permettre de tester des problèmes, ou désactivée pendant la résolution des problèmes.";
TabCaptureAllowedByOrigins.pfm_title = "Autoriser la capture d'onglet selon ces origines";
TabCaptureAllowedByOrigins.pfm_description = "Si cette règle est configurée, vous pouvez lister les formats d'URL qui peuvent utiliser la capture d'onglet.\n\nSi elle ne l'est pas, ces sites ne sont pas pris en compte pour un remplacement à ce niveau de capture.\n\nNotez que les applications Chrome en mode fenêtre pourront quand même être capturées.\n\nCette règle est ignorée si un site correspond à un format d'URL dans la règle SameOriginTabCaptureAllowedByOrigins.\n\nSi un site correspond à un format d'URL dans cette règle, les règles suivantes sont ignorées : WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.  Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.";
TabCompareSettings.pfm_title = "Paramètres de Tab Compare";
TabCompareSettings.pfm_description = "0 - Autoriser le comparateur d'onglets et améliorer les modèles d'IA.\n1 - Autoriser le comparateur d'onglets sans améliorer les modèles d'IA.\n2 - Ne pas autoriser le comparateur d'onglets.\nLe comparateur d'onglets est un outil optimisé par l'IA qui compare les informations entre les onglets d'un utilisateur. Par exemple, cette fonctionnalité peut être proposée à l'utilisateur lorsque plusieurs onglets contenant des produits d'une catégorie similaire sont ouverts.\n\n0 = Permettre d'utiliser la fonctionnalité tout en autorisant Google à utiliser des données pertinentes pour améliorer ses modèles d'IA. Selon la fonctionnalité, les données pertinentes peuvent inclure des prompts, des entrées, des sorties, des documents source et des commentaires écrits. Elles pourront également être examinées par des réviseurs humains dans le seul but d'améliorer les modèles d'IA. 0 est la valeur par défaut, sauf pour les exceptions ci-dessous.\n\n1 = Permettre d'utiliser la fonctionnalité, mais ne pas autoriser Google à améliorer ses modèles à l'aide du contenu des utilisateurs (y compris les prompts, les entrées, les sorties, les documents source et les commentaires écrits). 1 est la valeur par défaut pour les utilisateurs de la version Enterprise gérés par Google Admin console et pour les comptes Education gérés par Google Workspace.\n\n2 = Ne pas autoriser la fonctionnalité.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
TabDiscardingExceptions.pfm_title = "Exceptions à la suppression des onglets en raison du format d'URL";
TabDiscardingExceptions.pfm_description = "Cette règle détermine que toute URL correspondant à un ou plusieurs des formats qu'elle spécifie (avec le format de filtre URLBlocklist) ne sera jamais supprimée par le navigateur.\nCela s'applique à la suppression de la pression sur la mémoire et du mode Haute efficacité.\nUne page supprimée est déchargée et ses ressources entièrement récupérées. L'onglet auquel elle est associée reste dans la barre d'onglets, mais son affichage déclenche une actualisation complète.\n";
TaskManagerEndProcessEnabled.pfm_title = "Mettre fin aux processus dans le gestionnaire des tâches";
TaskManagerEndProcessEnabled.pfm_description = "Si vous désactivez cette règle, les utilisateurs ne pourront pas arrêter les processus dans le gestionnaire des tâches.\n\nSi vous l'activez, ou si vous ne la configurez pas, les utilisateurs peuvent arrêter les processus dans le gestionnaire des tâches.";
ThirdPartyAiChatSettings.pfm_title = "Paramètres des intégrations du Mode IA de tiers dans la barre d'adresse et le champ de recherche de la page \"Nouvel onglet\".";
ThirdPartyAiChatSettings.pfm_description = "0 - Autoriser les intégrations du Mode IA de tiers.\n1 - Ne pas autoriser les intégrations du Mode IA de tiers.\nCette règle contrôle les intégrations du Mode IA de tiers dans la barre d'adresse et le champ de recherche de la page \"Nouvel onglet\".\n\nPour accéder à cette fonctionnalité, l'utilisateur doit avoir défini un moteur de recherche tiers compatible avec le Mode IA comme moteur de recherche par défaut.\n\n0 : les utilisateurs auront accès à la fonctionnalité.\n\n1 : les utilisateurs n'auront pas accès à la fonctionnalité.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "Définir la limite de mémoire pour les instances de Chrome";
TotalMemoryLimitMb.pfm_description = "Permet de configurer la quantité de mémoire qu'une instance de Brave peut utiliser avant que des onglets ne commencent à être ignorés (c'est-à-dire que la mémoire utilisée par l'onglet sera libérée, et l'onglet devra être actualisé lorsque l'utilisateur le sélectionnera) afin d'économiser de la mémoire.\n\nSi cette règle est configurée, le navigateur commence à ignorer des onglets pour économiser de la mémoire lorsque la limite est dépassée. Il n'est cependant pas garanti que le navigateur fonctionne toujours en deçà de cette limite. Toute valeur inférieure à 1024 est arrondie à ce nombre.\n\nSi cette règle n'est pas configurée, le navigateur ne commence à économiser de la mémoire que s'il détecte que la quantité de mémoire physique sur l'ordinateur est faible.";
TranslateEnabled.pfm_title = "Activer Google Traduction";
TranslateEnabled.pfm_description = "Si cette règle est définie sur \"True\", vous pouvez proposer une fonctionnalité de traduction aux utilisateurs, le cas échéant. Une barre d'outils intégrée de traduction s'affiche alors dans Brave, ainsi qu'une option de traduction disponible dans le menu contextuel que l'utilisateur peut afficher en effectuant un clic droit. Si cette règle est définie sur \"False\", toutes les fonctionnalités de traduction intégrées sont fermées.\n\nSi cette règle est configurée, les utilisateurs ne peuvent pas modifier la fonctionnalité. Si elle n'est pas configurée, les utilisateurs peuvent modifier le paramètre.";
TranslatorAPIAllowed.pfm_title = "Autoriser l'API Translator";
TranslatorAPIAllowed.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, l'utilisation de l'API Translator est autorisée dans Brave.\n\nSi cette règle est désactivée, l'utilisation de l'API Translator n'est pas autorisée.";
TryOnYouSettings.pfm_title = "Paramètres de la fonctionnalité Essayage.";
TryOnYouSettings.pfm_description = "0 - Activer Essayage avec amélioration du modèle.\n1 - Activer Essayage sans amélioration du modèle.\n2 - Désactiver Essayage.\nEssayage est une fonctionnalité optimisée par l'IA qui permet aux utilisateurs d'essayer virtuellement des vêtements à partir d'images trouvées sur le Web et qui fournit des informations d'achat utiles dans Gemini dans Chrome, si Gemini dans Chrome est activé.\n\n0 = Permettre d'utiliser la fonctionnalité tout en autorisant Google à utiliser des données pertinentes pour améliorer ses modèles d'IA. Selon la fonctionnalité, les données pertinentes peuvent inclure des images, des entrées, des résultats, des sources et des commentaires. Elles pourront également être examinées par des réviseurs humains afin d'améliorer les modèles d'IA. 0 est la valeur par défaut, sauf pour les exceptions ci-dessous.\n\n1 = Permettre d'utiliser la fonctionnalité, mais ne pas autoriser Google à améliorer ses modèles à l'aide du contenu des utilisateurs (y compris les images, les entrées, les résultats, les sources et les commentaires). 1 est la valeur par défaut pour les utilisateurs de la version Enterprise gérés par Google Admin console et pour les comptes Education gérés par Google Workspace.\n\n2 = Ne pas autoriser la fonctionnalité.\n\nRemarque : La restriction sur les améliorations du modèle (valeur 1) ne s'applique que lorsque la fonctionnalité Essayage est déclenchée via le flux du navigateur Chrome. Elle ne s'applique pas lorsque la fonctionnalité est utilisée via d'autres flux.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings. Pour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.\n\nLa fonctionnalité Essayage n'est pas disponible dans tous les pays ni dans toutes les langues. La configuration de cette règle ne garantit pas que la fonctionnalité sera activée. Elle reste soumise à disponibilité. Pour en savoir plus sur le déploiement, consultez les notes de version Enterprise : https://support.google.com/chrome/a/answer/7679408?hl=fr";
URLAllowlist.pfm_title = "Autoriser l'accès à une liste d'URL";
URLAllowlist.pfm_description = "Cette règle permet d'autoriser l'accès aux URL listées comme exceptions à URLBlocklist. Lisez sa description pour connaître le format des entrées listées. Par exemple, définir URLBlocklist sur \"*\" bloque toutes les requêtes, et vous pouvez appliquer cette règle pour autoriser l'accès à une liste limitée d'URL. Utilisez-la pour définir des exceptions à certains schémas, ports, chemins d'accès spécifiques ou sous-domaines d'autres domaines à l'aide du format spécifié sur https://support.google.com/chrome/a?p=url_blocklist_filter_format. Le filtre le plus spécifique détermine si une URL est bloquée ou autorisée. La règle URLAllowlist prévaut sur URLBlocklist. Cette règle est limitée à 1 000 entrées.\n\nElle permet aussi d'autoriser le navigateur d'une appli externe enregistrée comme gestionnaire de protocoles à appeler automatiquement les protocoles listés tels que \"tel:\" ou \"ssh:\".\n\nSi cette règle n'est pas configurée, aucune exception à URLBlocklist n'est autorisée.\n\nÀ compter de la version 92 de Brave, cette règle est aussi prise en charge en mode headless.";
URLBlocklist.pfm_title = "Bloquer l'accès à une liste d'URL";
URLBlocklist.pfm_description = "Si vous définissez la règle URLBlocklist, les pages Web dont les URL sont interdites ne peuvent pas se charger. Les administrateurs peuvent spécifier la liste des formats d'URL à bloquer. Si cette règle n'est pas configurée, aucune URL n'est bloquée dans le navigateur. Vous pouvez définir jusqu'à 1 000 exceptions dans URLAllowlist. Découvrez les formats d'URL à respecter (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nRemarque : Cette règle ne s'applique pas aux URL JavaScript intégrées dans les pages dont les données sont chargées dynamiquement. Si vous bloquez example.com/abc, example.com pourra toujours la charger à l'aide de XMLHTTPRequest. En outre, cette règle n'empêche pas les pages Web de remplacer l'URL affichée dans l'omnibox par une URL bloquée à l'aide de l'API JavaScript History.\n\nÀ partir de la version 73 de Brave, vous pouvez bloquer les URL javascript://*. Toutefois, cela ne concerne que le code JavaScript saisi dans la barre d'adresse ou, par exemple, les favoris intelligents.\n\nÀ compter de la version 92 de Brave, cette règle est aussi prise en charge en mode headless.\n\nÀ partir de la version 147 de Brave, le caractère générique * seul ne s'applique pas aux URL chrome:// internes. Pour les bloquer, vous devez utiliser explicitement le format chrome://*.\n\nRemarque : Bloquer des URL internes chrome://* et chrome-untrusted://* peut entraîner des erreurs inattendues ou être contourné dans certains cas. Au lieu de bloquer certaines URL internes, vérifiez si des règles plus spécifiques sont disponibles. Par exemple :\n\n– Au lieu de bloquer chrome://settings/certificates, utilisez CACertificateManagementAllowed.\n\n– Au lieu de bloquer chrome-untrusted://crosh, utilisez SystemFeaturesDisableList.\n\n– Au lieu de bloquer devtools://*, utilisez l'une des règles DeveloperToolsAvailability, DeveloperToolsAvailabilityAllowlist ou DeveloperToolsAvailabilityBlocklist.";
UpdateOnZeroWindowEnabled.pfm_title = "Contrôle le relancement automatique en arrière-plan lorsque toutes les fenêtres du navigateur sont fermées";
UpdateOnZeroWindowEnabled.pfm_description = "Contrôle le comportement de redémarrage automatique en arrière-plan sur macOS lorsqu'une mise à jour de sécurité est en attente et que toutes les fenêtres du navigateur sont fermées.\n\nSi cette règle est définie sur \"True\" ou qu'elle n'est pas configurée, Brave est autorisé à redémarrer automatiquement pour appliquer les mises à jour en attente lorsque toutes les fenêtres du navigateur sont fermées.\n\nSi cette règle est définie sur \"False\", les relancements automatiques sont désactivés lorsque toutes les fenêtres du navigateur sont fermées.";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "Activer la collecte de données anonymisées avec clé d'URL";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "Si cette règle est activée, la collecte de données anonymisées avec clé d'URL (qui envoie à Google les URL des pages que l'utilisateur visite afin d'améliorer la recherche et la navigation) est toujours active.\n\nSi cette règle est désactivée, les données anonymisées avec clé d'URL ne sont pas collectées.\n\nSi cette règle n'est pas configurée, l'utilisateur peut modifier ce paramètre manuellement.\n\nDans Google Chrome OS Kiosk, cette règle ne propose pas l'option \"Laisser l'utilisateur décider\". Si cette règle n'est pas configurée pour Google Chrome OS Kiosk, la collecte de données anonymisées avec clé d'URL est toujours active.\nLorsqu'elle est définie pour Google Chrome OS Kiosk, cette règle active la collecte de métriques avec clé d'URL  pour les applis kiosque.";
UserDataDir.pfm_title = "Définir le répertoire de données utilisateur";
UserDataDir.pfm_description = "Permet de configurer le répertoire utilisé par Brave pour le stockage des données de l'utilisateur.\n\nSi vous définissez cette règle, Brave utilisera le répertoire fourni, que l'utilisateur ait ou non spécifié le flag \"--user-data-dir\". Pour éviter la perte de données ou d'autres erreurs inattendues, ne définissez pas cette règle sur un répertoire utilisé à d'autres fins, car Brave gère son contenu.\n\nPour connaître la liste des variables acceptées, consultez cette page : https://support.google.com/chrome/a?p=Supported_directory_variables.\n\nSi cette règle n'est pas définie, le chemin de profil par défaut sera utilisé, et l'utilisateur pourra le remplacer avec le flag de ligne de commande \"--user-data-dir\".";
UserDataSnapshotRetentionLimit.pfm_title = "Limite le nombre d'instantanés de données utilisateur retenus en prévision d'un éventuel rollback d'urgence.";
UserDataSnapshotRetentionLimit.pfm_description = "Après chaque mise à jour de version majeure, Chrome crée un instantané de certaines portions des données de navigation de l'utilisateur en prévision d'un éventuel rollback de version d'urgence. Si un rollback d'urgence a lieu et que Chrome dispose de l'instantané correspondant, les données de cet instantané sont restaurées. L'utilisateur récupérera ainsi ses favoris et ses données de saisie automatique, entre autres.\n\nSi la règle n'est pas définie, la valeur par défaut 3 est utilisée.\n\nSi la règle est définie, les anciens instantanés sont supprimés au fur et à mesure pour respecter la limite. Si la règle est définie sur 0, aucun instantané n'est enregistré.";
UserFeedbackAllowed.pfm_title = "Autoriser les commentaires des utilisateurs";
UserFeedbackAllowed.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, les utilisateurs peuvent envoyer des commentaires à Google en sélectionnant Menu > Aide > Signaler un problème, ou via un raccourci clavier.\n\nSi elle est désactivée, les utilisateurs ne peuvent pas envoyer de commentaires à Google.";
VideoCaptureAllowed.pfm_title = "Autoriser ou interdire la capture vidéo";
VideoCaptureAllowed.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, l'utilisateur est invité à autoriser ou non l'accès à la capture vidéo, sauf si l'URL concernée figure dans la liste VideoCaptureAllowedUrls.\n\nSi cette règle est désactivée, aucune invite ne s'affiche à ce sujet, et la capture vidéo n'est possible que si l'URL concernée figure dans la liste VideoCaptureAllowedUrls.\n\nRemarque : Cette règle concerne toutes les entrées vidéo (pas seulement la caméra intégrée).";
VideoCaptureAllowedUrls.pfm_title = "URL autorisées à accéder aux appareils de capture vidéo sans avis préalable";
VideoCaptureAllowedUrls.pfm_description = "Permet d'établir la liste des URL dont les formats sont mis en correspondance avec la source de sécurité de l'URL à l'origine de la demande. En cas de correspondance, l'accès aux appareils de capture vidéo est autorisé sans invite.\n\nPour en savoir plus sur les formats url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/. Notez toutefois que le format \"*\", qui correspond à n'importe quelle URL, n'est pas pris en charge par cette règle.";
VoiceTypingSettings.pfm_title = "Paramètres de la fonctionnalité Parler pour écrire";
VoiceTypingSettings.pfm_description = "0 - Autoriser la fonctionnalité Parler pour écrire.\n1 - Autoriser la fonctionnalité Parler pour écrire sans collecte de données.\n2 - Ne pas autoriser la fonctionnalité Parler pour écrire.\n\"Parler pour écrire\" est une fonctionnalité basée sur l'IA qui permet aux utilisateurs de saisir et de modifier du texte en parlant. Elle s'appuie sur des modèles d'IA générative pour fournir une transcription et une mise en forme de haute qualité.\n\n0 = Autoriser l'utilisation de la fonctionnalité et autoriser Google à utiliser les données pertinentes pour améliorer ses modèles d'IA. Selon la fonctionnalité, ces données peuvent inclure les prompts, les données d'entrée et de sortie, les sources et les commentaires écrits. Elles pourront aussi être examinées par des réviseurs humains afin d'améliorer les modèles d'IA. 0 est la valeur par défaut, sauf pour les exceptions ci-dessous.\n\n1 = Autoriser l'utilisation de la fonctionnalité, mais ne pas autoriser Google à améliorer ses modèles à l'aide du contenu des utilisateurs (y compris les prompts, les données d'entrée et de sortie, les sources et les commentaires écrits). 1 est la valeur par défaut pour les utilisateurs de la version Enterprise gérés par Google Admin console et pour les comptes Education gérés par Google Workspace.\n\n2 = Ne pas autoriser la fonctionnalité.\n\nSi la règle n'est pas configurée, son comportement est déterminé par la règle GenAiDefaultSettings.\n\nPour en savoir plus sur la gestion des données pour les fonctionnalités d'IA générative, veuillez consulter https://support.google.com/chrome/a?p=generative_ai_settings.";
WPADQuickCheckEnabled.pfm_title = "Activer l'optimisation WPAD";
WPADQuickCheckEnabled.pfm_description = "Si cette règle est activée ou qu'elle n'est pas configurée, l'optimisation WPAD (Web Proxy Auto-Discovery, découverte automatique du proxy) est activée dans Brave.\n\nSi cette règle est désactivée, l'optimisation WPAD l'est également, et le temps de réponse des serveurs WPAD basés sur le DNS est alors plus long dans Brave.\n\nQue cette règle soit configurée ou non, les utilisateurs ne peuvent pas modifier le paramètre d'optimisation WPAD.";
WarnBeforeQuittingEnabled.pfm_title = "Afficher une boîte de dialogue d'avertissement quand l'utilisateur tente de quitter";
WarnBeforeQuittingEnabled.pfm_description = "Contrôler la boîte de dialogue \"Confirmer avant de quitter (⌘Q)\" quand l'utilisateur tente de quitter le navigateur.\n\nSi cette règle est activée ou n'est pas configurée, une boîte de dialogue d'avertissement s'affiche quand l'utilisateur tente de quitter.\n\nSi elle est désactivée, aucune boîte de dialogue d'avertissement ne s'affiche quand l'utilisateur tente de quitter.";
WebAppInstallByUserEnabled.pfm_title = "Autoriser les utilisateurs à installer des applications Web depuis le navigateur";
WebAppInstallByUserEnabled.pfm_description = "Cette règle détermine si les utilisateurs peuvent installer des applications Web via le navigateur.\nSi vous activez cette règle ou ne la configurez pas, les utilisateurs peuvent installer des applications Web via le navigateur.\nSi vous désactivez cette règle, les utilisateurs ne peuvent pas installer d'applications Web via le navigateur, et le type de données \"applications\" est exclu de la synchronisation pour Chrome Sync.\nCette règle n'est pas compatible avec l'actualisation dynamique. Toute modification (activation, désactivation ou non-configuration) ne prend effet qu'après le redémarrage du navigateur.\nCette règle n'affecte pas la règle \"WebAppInstallForceList\".";
WebAppInstallForceList.pfm_title = "URL des applications Web à installer de façon silencieuse.";
WebAppInstallForceList.pfm_description = "Permet de lister les applis Web qui s'installent de manière autonome (sans intervention de l'utilisateur) et de définir quels utilisateurs ne peuvent pas les désinstaller ni les désactiver.\n\nChaque élément de la liste de cette règle est un objet constitué d'un membre obligatoire :\nurl (qui correspond à l'URL de l'appli Web à installer)\n\net de six membres facultatifs :\n- default_launch_container\n(qui indique où s'ouvre l'application Web ; par défaut, elle s'ouvre dans un nouvel onglet)\n\n- create_desktop_shortcut\n(\"True\" si vous voulez créer des raccourcis sur le bureau Linux et\nMicrosoft® Windows®).\n\n- fallback_app_name\n(Disponible depuis la version 90 de Brave ;\npermet de remplacer le nom de l'appli,\nsauf pour les progressive web apps (PWA) –\ndans le cas d'une PWA avec authentification requise pour l'installation,\nle nom de l'appli temporaire peut être remplacé. Si les règles\ncustom_name et\nfallback_app_name sont fournies,\ncette dernière sera ignorée.)\n\n- custom_name\n(Disponible depuis la version 99 de Google Chrome OS\net la version 112 sur tous les autres systèmes d'exploitation ; permet de remplacer\ndéfinitivement le nom d'une appli pour toutes les applis Web et les PWA.)\n\n- custom_icon\n(Disponible depuis la version 99 de Google Chrome OS\net la version 112 sur tous les autres systèmes d'exploitation ; permet de remplacer\nl'icône des applis installées. Les icônes ne doivent pas dépasser 1 Mo.\nElles doivent être carrées et au format jpeg, png, gif, webp ou ico.\nLa valeur de hachage doit être un hachage SHA256 du fichier d'icône. L'url doit être accessible sans authentification pour que l'icône puisse être utilisée une fois l'appli installée.)\n\n- install_as_shortcut\n(Disponible depuis la version 107 de Brave). Si cette règle est activée, l'url donnée sera installée en tant que raccourci, comme si vous cliquiez sur l'option \"Créer un raccourci…\"\ndans l'IUG du navigateur pour ordinateur.\nNotez que lorsqu'elle est installée en tant que raccourci, elle n'est pas mise à jour si le fichier manifeste dans l'url change.\nSi cette règle est désactivée ou qu'elle n'est pas configurée, l'application Web de l'url donnée sera installée normalement.\n\nConsultez PinnedLauncherApps pour épingler des applis à l'étagère Google Chrome OS.\nConsultez la page https://chromeenterprise.google/policies/?policy=WebAppInstallForceList pour en savoir plus sur le schéma et le formatage.";
WebAppSettings.pfm_title = "Paramètres de gestion de l'application Web";
WebAppSettings.pfm_description = "Cette règle permet à un administrateur de définir des paramètres pour les applications Web installées. Elle fait correspondre un ID d'application Web à son paramètre spécifique. Une configuration par défaut peut être définie avec l'ID spécial *, lequel s'applique à toutes les applications Web pour lesquelles aucune configuration personnalisée n'est définie dans cette règle.\n\nLe champ manifest_id contient l'ID du fichier manifeste pour l'application Web. Pour savoir comment déterminer l'ID du fichier manifeste d'une application Web qui a été installée, consultez https://developer.chrome.com/blog/pwa-manifest-id/.\nLe champ run_on_os_login indique si une application Web peut être exécutée pendant la connexion au système d'exploitation. Si ce champ est défini sur blocked, l'application Web ne s'exécutera pas pendant la connexion au système d'exploitation et l'utilisateur ne pourra pas activer ce champ plus tard. Si ce champ est défini sur run_windowed, l'application Web s'exécutera pendant la connexion au système d'exploitation et l'utilisateur ne pourra pas désactiver ce champ plus tard. Si ce champ est défini sur allowed, l'utilisateur pourra configurer l'application Web pour qu'elle s'exécute pendant la connexion au système d'exploitation. La configuration par défaut n'autorise que les valeurs allowed et blocked.\n(Depuis la version 117) Le champ prevent_close_after_run_on_os_login indique si la fermeture de l'application Web doit être empêchée de quelque manière que ce soit (par l'utilisateur, le gestionnaire de tâches ou les API Web, par exemple). Ce comportement ne peut être activé que si run_on_os_login est défini sur run_windowed. Si l'appli était déjà en cours d'exécution, cette propriété ne sera prise en compte qu'après avoir redémarré l'appli. Si ce champ n'est pas défini, les utilisateurs pourront fermer les applis.\n(Depuis la version 118) Le champ force_unregister_os_integration indique si toutes les intégrations OS pour une application Web (raccourcis, gestionnaires de fichiers, gestionnaires de protocoles, etc.) seront supprimées ou non. Si une appli est déjà en cours d'exécution, cette propriété ne sera prise en compte qu'après avoir redémarré l'appli. Utilisez cette option avec prudence, car elle peut ignorer toute intégration OS définie automatiquement au démarrage du système d'applications Web. Ne fonctionne actuellement que sur les plates-formes Windows, Mac et Linux.\nConsultez la page https://chromeenterprise.google/policies/?policy=WebAppSettings pour en savoir plus sur le schéma et le formatage.";
WebAudioOutputBufferingEnabled.pfm_title = "Activer la mise en mémoire tampon adaptative pour Web Audio";
WebAudioOutputBufferingEnabled.pfm_description = "Cette règle contrôle si le navigateur utilise la mise en mémoire tampon adaptative pour Web Audio. Cela peut réduire les problèmes audio, mais aussi augmenter la latence de façon variable.\n\nSi cette règle est activée, la mise en mémoire tampon adaptative est toujours utilisée.\n\nSi cette règle est désactivée ou qu'elle n'est pas configurée, le processus de lancement de fonctionnalités du navigateur détermine si la mise en mémoire tampon adaptative est utilisée.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "Origines autorisées pour les requêtes WebAuthn envoyées par proxy à partir d'applis de bureau à distance.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "Liste des origines des applis clientes de bureau à distance pouvant exécuter des requêtes API WebAuthn envoyées à partir d'une session de navigation sur un hôte à distance.\n\nToute origine configurée dans cette règle peut envoyer des requêtes WebAuthn pour des ID de tiers de confiance qu'elle ne devrait normalement pas pouvoir réclamer.\n\nSeules les origines HTTPS valides sont autorisées. Les caractères génériques ne sont pas pris en charge.\nLes entrées non valides sont ignorées.\n\nCette règle ne s'applique qu'aux utilisateurs affiliés.";
WebHidAllowAllDevicesForUrls.pfm_title = "Autoriser automatiquement les sites à se connecter à tous les appareils HID.";
WebHidAllowAllDevicesForUrls.pfm_description = "Cette règle permet de dresser la liste des sites automatiquement autorisés à accéder à tous les appareils disponibles.\n\nSi les URL ne sont pas valides, la règle est ignorée. Seule l'origine (schéma, hôte et port) de l'URL est prise en compte.\n\nSur Chrome OS, cette règle ne s'applique qu'aux utilisateurs affiliés.\n\nElle remplace DefaultWebHidGuardSetting, WebHidAskForUrls, WebHidBlockedForUrls et les préférences de l'utilisateur.";
WebHidAllowDevicesForUrls.pfm_title = "Autoriser automatiquement ces sites à se connecter aux appareils HID correspondant aux ID produit et du fournisseur indiqués.";
WebHidAllowDevicesForUrls.pfm_description = "Cette règle permet de dresser la liste des URL des sites automatiquement autorisés à se connecter à un appareil HID à l'aide des ID produit et du fournisseur indiqués. Pour que la règle soit valide, les champs devices et urls doivent être renseignés pour chaque élément de la liste. Si ce n'est pas le cas, la règle est ignorée. Chaque élément du champ devices doit avoir un champ vendor_id et peut avoir un champ product_id. Si vous ne renseignez pas le champ product_id, la règle qui est créée correspond à tous les appareils ayant l'ID de fournisseur spécifié. Une règle ayant un champ product_id, mais pas de champ vendor_id n'est pas valide et est ignorée.\n\nSi cette règle n'est pas configurée, la règle DefaultWebHidGuardSetting s'applique, à condition qu'elle soit définie. Sinon, le paramètre défini par l'utilisateur s'applique.\n\nLes URL de cette règle ne doivent pas entrer en conflit avec celles configurées via WebHidBlockedForUrls. En cas de conflit, cette règle prévaut sur WebHidBlockedForUrls.\nConsultez la page https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls pour en savoir plus sur le schéma et le formatage.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "Autoriser automatiquement ces sites à se connecter à des appareils HID contenant des collections de niveau supérieur avec l'utilisation indiquée des appareils HID.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "Cette règle permet de dresser la liste des URL des sites automatiquement autorisés à se connecter à un appareil HID contenant une collection de niveau supérieur avec l'utilisation donnée de l'appareil HID. Pour que la règle soit valide, les champs usages et urls doivent être renseignés pour chaque élément de la liste. Chaque élément du champ usages doit avoir un champ usage_page et peut avoir un champ usage. Si vous ne renseignez pas le champ usage, la règle qui est créée correspond à tous les appareils contenant une collection de niveau supérieur avec une utilisation tirée de la page d'utilisation spécifiée. Une règle ayant un champ usage, mais pas de champ usage_page n'est pas valide et est ignorée.\n\nSi cette règle n'est pas configurée, la règle DefaultWebHidGuardSetting s'applique, à condition qu'elle soit définie. Sinon, le paramètre défini par l'utilisateur s'applique.\n\nLes URL de cette règle ne doivent pas entrer en conflit avec celles configurées via WebHidBlockedForUrls. En cas de conflit, cette règle prévaut sur WebHidBlockedForUrls.\nConsultez la page https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls pour en savoir plus sur le schéma et le formatage.";
WebHidAskForUrls.pfm_title = "Autoriser l'API WebHID sur ces sites";
WebHidAskForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites peuvent demander aux utilisateurs l'accès à un appareil HID.\n\nSi cette règle n'est pas configurée, la règle DefaultWebHidGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, les paramètres spécifiés par les utilisateurs s'appliquent.\n\nSi le format d'URL ne correspond pas à celui défini dans cette règle, les règles suivantes s'appliquent, selon cet ordre :\n\n  * WebHidBlockedForUrls (si une correspondance existe)\n\n  * DefaultWebHidGuardSetting (si elle est définie) ou\n\n  * Paramètres personnels des utilisateurs.\n\nLes formats d'URL ne doivent pas entrer en conflit avec WebHidBlockedForUrls. Aucune règle ne prévaut si un format d'URL figure dans les deux règles.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
WebHidBlockedForUrls.pfm_title = "Bloquer l'API WebHID sur ces sites";
WebHidBlockedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites ne peuvent pas demander aux utilisateurs l'accès à un appareil HID.\n\nSi cette règle n'est pas configurée, la règle DefaultWebHidGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, les paramètres spécifiés par les utilisateurs s'appliquent.\n\nSi le format d'URL ne correspond pas à celui défini dans cette règle, les règles suivantes s'appliquent, selon cet ordre :\n\n  * WebHidAskForUrls (si une correspondance existe)\n\n  * DefaultWebHidGuardSetting (si elle est définie) ou\n\n  * Paramètres personnels des utilisateurs.\n\nLes formats d'URL ne peuvent pas entrer en conflit avec ceux de la règle WebHidAskForUrls. Aucune règle ne prévaut si un format d'URL figure dans les deux règles.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "Activer la collecte des journaux de diagnostic WebRTC pour des origines spécifiques";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "Cette règle permet d'activer la collecte des journaux de diagnostic pour WebRTC pour des origines spécifiques.\n\nPour en savoir plus sur les formats d'entrée valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle. Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré. Scheme et les sous-domaines sont pris en charge.\n\nSi cette règle est configurée, la collecte des journaux de diagnostic sera activée pour les origines correspondant aux formats de la liste.\n\nSi cette règle n'est pas configurée, la collecte des journaux de diagnostic sera désactivée par défaut.";
WebRtcEventLogCollectionAllowed.pfm_title = "Autoriser la collecte des journaux d'événements WebRTC à partir des services Google";
WebRtcEventLogCollectionAllowed.pfm_description = "Si vous activez cette règle, Brave peut collecter les journaux des événements WebRTC auprès des services Google (Hangouts Meet, par exemple) et les importer sur Google. Ces journaux contiennent des informations de diagnostic permettant de déboguer des problèmes liés aux réunions audio ou aux visioconférences dans Brave, telles que l'horodatage et la taille des paquets RTP, des commentaires sur l'encombrement du réseau, ainsi que des métadonnées concernant l'horodatage et la qualité de la vidéo et de l'audio. Ces journaux n'incluent aucun contenu audio ni vidéo de la réunion. Dans le but de faciliter le débogage, Google peut associer ces journaux à d'autres journaux collectés par le service Google proprement dit au moyen d'un ID de session.\n\nSi vous désactivez cette règle, ces journaux ne sont ni collectés, ni importés.\n\nSur Brave version M76 ou inférieure, si la règle n'est pas définie, l'application ne peut, par défaut, ni collecter, ni importer ces journaux. À partir de la version M77, Brave est, par défaut, en mesure de collecter et d'importer ces journaux à partir de la plupart des profils affectés par les règles d'entreprise au niveau de l'utilisateur dans le cloud. De la version M77 à la version M80, Brave peut également, par défaut, collecter et importer ces journaux à partir des profils affectés par la fonction de gestion sur site de Brave.";
WebRtcIPHandling.pfm_title = "Gestion des adresses IP WebRTC";
WebRtcIPHandling.pfm_description = "default - WebRTC utilisera toutes les interfaces disponibles pour rechercher le meilleur chemin.\ndefault_public_and_private_interfaces - WebRTC utilisera uniquement l'interface pour se connecter à l'Internet public, mais pourra se connecter à l'aide d'adresses IP privées.\ndefault_public_interface_only - WebRTC utilisera uniquement l'interface pour se connecter à l'Internet public, et ne se connectera pas à l'aide d'adresses IP privées.\ndisable_non_proxied_udp - WebRTC utilisera TCP sur l'interface publique et utilisera UDP uniquement s'il est compatible avec un proxy configuré.\nCette règle permet de limiter les adresses IP et interfaces utilisées par WebRTC pour tenter d'identifier la meilleure connexion disponible.\n\nValeurs valides :\n\n* default : WebRTC utilise toutes les interfaces réseau disponibles.\n\n* default_public_and_private_interfaces : WebRTC utilise toutes les interfaces publiques et privées.\n\n* default_public_interface_only : WebRTC utilise toutes les interfaces publiques, mais pas les interfaces privées.\n\n* disable_non_proxied_udp : WebRTC utilise le proxy UDP SOCKS ou bascule sur le proxy TCP.\n\nLorsqu'elle n'est pas définie, elle utilise par défaut toutes les interfaces réseau disponibles.\n\nConsultez la section 5.2 du document RFC 8828 (https://tools.ietf.org/html/rfc8828.html#section-5.2) pour obtenir une description détaillée de toutes les valeurs de gestion.";
WebRtcIPHandlingUrl.pfm_title = "Gestion des adresses IP WebRTC par URL";
WebRtcIPHandlingUrl.pfm_description = "Cette règle permet de limiter les adresses IP et interfaces utilisées par WebRTC pour essayer d'identifier la meilleure connexion disponible pour chaque format d'URL spécifique.\n\nElle accepte une liste de paires de formats d'URL et de types de gestion. Les formats d'URL sont vérifiés dans l'ordre. Le premier qui correspond détermine quelle gestion est utilisée par WebRTC pour le domaine. Lorsque l'URL du document actuel ne correspond à aucune entrée, elle utilise la configuration définie par la règle WebRtcIPHandling.\n\nPour en savoir plus sur les formats d'entrée valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/. Les caractères génériques (*) sont autorisés. Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.\n\nValeurs de gestion valides :\n\n* default : WebRTC utilise toutes les interfaces réseau.\n\n* default_public_and_private_interfaces : WebRTC utilise toutes les interfaces publiques et privées.\n\n* default_public_interface_only : WebRTC utilise toutes les interfaces publiques, mais pas les interfaces privées.\n\n* disable_non_proxied_udp : WebRTC utilise le proxy UDP SOCKS ou bascule sur le proxy TCP.\n\nConsultez la section 5.2 du document RFC 8828 (https://tools.ietf.org/html/rfc8828.html#section-5.2) pour obtenir une description détaillée de toutes les valeurs de gestion.\nConsultez la page https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl pour en savoir plus sur le schéma et le formatage.";
WebRtcLocalIpsAllowedUrls.pfm_title = "URL pour lesquelles les candidats WebRTC ICE affichent les adresses IP locales";
WebRtcLocalIpsAllowedUrls.pfm_description = "Les modèles de cette liste sont comparés à la source de sécurité de l'URL à l'origine de la demande.\nEn cas de correspondance ou si chrome://flags/#enable-webrtc-hide-local-ips-with-mdns est désactivé, les candidats WebRTC ICE affichent les adresses IP locales.\nSinon, les adresses IP locales sont masquées avec les noms d'hôte mDNS.\nVeuillez noter que cette règle affaiblit la protection des adresses IP locales, dans le cas où celle-ci serait requise par les administrateurs.";
WebRtcPostQuantumKeyAgreement.pfm_title = "Activer l'accord de clé post-quantique pour WebRTC";
WebRtcPostQuantumKeyAgreement.pfm_description = "Cette règle permet de contrôler l'accord de clé post-quantique pour WebRTC.\n\nSi cette règle est activée, l'accord de clé post-quantique est proposé pour WebRTC.\n\nSi cette règle est désactivée, l'accord de clé post-quantique n'est pas proposé pour WebRTC.\n\nSi cette règle n'est pas configurée, la valeur est définie par le processus de déploiement par défaut pour l'accord de clé post-quantique proposé pour WebRTC.\n\nLa proposition d'un accord de clé post-quantique est rétrocompatible. Les homologues DTLS et le middleware de mise en réseau existants devraient ignorer la nouvelle option et continuer à sélectionner les options précédentes.\n\nToutefois, les appareils qui n'implémentent pas correctement DTLS peuvent dysfonctionner lorsqu'ils reçoivent la nouvelle option. Par exemple, ils peuvent se déconnecter en réponse à des options non reconnues ou à des messages plus volumineux qui en résultent. Ces appareils ne sont pas prêts pour le post-quantique et interfèrent avec la transition post-quantique d'une entreprise. Le cas échéant, les administrateurs doivent contacter le fournisseur pour obtenir une solution.\n\nCette règle est une mesure temporaire qui sera supprimée dans quelque temps.";
WebRtcTextLogCollectionAllowed.pfm_title = "Autoriser la collecte des journaux texte WebRTC à partir des services Google";
WebRtcTextLogCollectionAllowed.pfm_description = "Si cette règle est activée, Brave peut collecter les journaux texte WebRTC à partir des services Google tels que Google Meet, et les importer sur Google. Ces journaux contiennent des informations de diagnostic permettant de déboguer des problèmes liés aux réunions audio ou visioconférences dans Brave, telles que des métadonnées de texte décrivant des flux WebRTC entrants et sortants, des entrées de journal spécifiques à WebRTC et d'autres informations système. Ces journaux n'incluent aucun contenu audio ni vidéo de réunions ou visioconférences.\nSi cette règle est désactivée, ces journaux ne sont pas importés sur Google, mais ils sont toujours rassemblés localement sur l'appareil de l'utilisateur.\nSi cette règle n'est pas configurée, Brave peut, par défaut, collecter et importer ces journaux.";
WebRtcUdpPortRange.pfm_title = "Restreindre la portée des ports UDP locaux utilisés par WebRTC";
WebRtcUdpPortRange.pfm_description = "Si cette règle est définie, la portée du port UDP utilisé par WebRTC est restreinte à l'intervalle de port spécifié (points de terminaison inclus).\n\nSi cette règle n'est pas définie, ou si elle est définie sur la chaîne vide ou sur une portée de port non valide, WebRTC peut utiliser n'importe quel port UDP local disponible.";
WebUsbAllowDevicesForUrls.pfm_title = "Autoriser automatiquement ces sites à se connecter à des appareils USB correspondant au fournisseur et aux ID de produit indiqués.";
WebUsbAllowDevicesForUrls.pfm_description = "Cette règle permet de dresser la liste des formats d'URL qui indiquent les sites automatiquement autorisés à accéder à un appareil USB à l'aide des ID produit et de fournisseur indiqués. Pour que la règle soit valide, les champs devices et urls doivent être renseignés pour chaque élément de la liste. Chaque élément du champ devices peut avoir un champ vendor_id et product_id. Si vous ne renseignez pas le champ vendor_id, la règle qui est créée correspond à tous les appareils. Si vous ne renseignez pas le champ product_id, la règle qui est créée correspond à tous les appareils ayant l'ID de fournisseur donné. Une règle ayant un champ product_id, mais pas de champ vendor_id n'est pas valide.\n\nLe modèle d'autorisations USB autorisera l'URL spécifiée à accéder à l'appareil USB en tant qu'origine de niveau supérieur. Si les cadres intégrés doivent accéder aux appareils USB, l'en-tête feature-policy \"usb\" doit être utilisé pour autoriser l'accès. Si l'URL n'est pas valide, la règle est ignorée.\n\nObsolète : Le modèle d'autorisations USB permettait de spécifier à la fois l'URL à l'origine de la requête et l'URL d'intégration. Il est obsolète et uniquement pris en charge pour la rétrocompatibilité, de cette manière : si l'URL à l'origine de la requête et l'URL d'intégration sont spécifiées, alors la seconde obtiendra l'autorisation en tant qu'origine de niveau supérieur et la première sera totalement ignorée.\n\nCette règle remplace DefaultWebUsbGuardSetting, WebUsbAskForUrls, WebUsbBlockedForUrls et les préférences de l'utilisateur.\n\nCette règle ne concerne que l'accès aux appareils USB via l'API WebUSB. Pour autoriser l'accès aux appareils USB via l'API Web Serial, consultez la règle SerialAllowUsbDevicesForUrls.\nConsultez la page https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls pour en savoir plus sur le schéma et le formatage.";
WebUsbAskForUrls.pfm_title = "Autoriser WebUSB sur ces sites";
WebUsbAskForUrls.pfm_description = "Permet de dresser la liste des formats d'URL pour lesquels les sites sont autorisés à demander aux utilisateurs à accéder à un appareil USB.\n\nSi cette règle n'est pas configurée, la règle DefaultWebUsbGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, les paramètres spécifiés par les utilisateurs s'appliquent.\n\nLes formats d'URL ne doivent pas entrer en conflit avec ceux de WebUsbAskForUrls. Aucune règle ne prévaut si un format d'URL est listé dans les deux règles.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
WebUsbBlockedForUrls.pfm_title = "Bloquer WebUSB sur ces sites";
WebUsbBlockedForUrls.pfm_description = "Cette règle permet de lister les formats d'URL pour lesquels les sites ne peuvent pas demander aux utilisateurs l'accès à un appareil USB.\n\nSi cette règle n'est pas configurée, la règle DefaultWebUsbGuardSetting s'applique pour tous les sites, à condition qu'elle soit définie. Si ce n'est pas le cas, le paramètre défini par l'utilisateur s'applique.\n\nLes formats d'URL ne peuvent pas entrer en conflit avec ceux de la règle WebUsbAskForUrls. Aucune règle ne prévaut si un format d'URL figure dans les deux règles.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. La valeur * n'est pas acceptée pour cette règle.";
WindowCaptureAllowedByOrigins.pfm_title = "Autoriser les captures de fenêtre et d'onglet selon ces origines";
WindowCaptureAllowedByOrigins.pfm_description = "Si cette règle est configurée, vous pouvez lister les formats d'URL qui peuvent utiliser les captures de fenêtre et d'onglet.\n\nSi elle ne l'est pas, ces sites ne sont pas pris en compte pour un remplacement à ce niveau de capture.\n\nCette règle est ignorée si un site correspond à un format d'URL dans l'une de ces règles : TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nSi un site correspond à un format d'URL dans cette règle, les règles suivantes sont ignorées : ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nPour en savoir plus sur les formats d‘url valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns/.  Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.";
WindowManagementAllowedForUrls.pfm_title = "Accorder l'autorisation de gestion des fenêtres sur ces sites";
WindowManagementAllowedForUrls.pfm_description = "Permet de lister les formats d'URL pour lesquels les sites accordent automatiquement l'autorisation de gestion des fenêtres. Cela étend la capacité des sites à voir les informations concernant les écrans de l'appareil, ainsi qu'à utiliser ces informations pour ouvrir et positionner des fenêtres, ou demander le passage en plein écran sur certains écrans.\n\nPour en savoir plus sur les formats d'URL de site valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés. Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.\n\nSi cette règle n'est pas définie pour un site, alors la règle DefaultWindowManagementSetting s'applique au site (si elle est définie). Sinon, les paramètres par défaut du navigateur s'appliquent, et les utilisateurs peuvent définir l'autorisation pour chaque site.\n\nCette règle remplace la règle WindowPlacementAllowedForUrls, qui est obsolète.";
WindowManagementBlockedForUrls.pfm_title = "Bloquer l'autorisation de gestion des fenêtres sur ces sites";
WindowManagementBlockedForUrls.pfm_description = "Permet de lister les formats d'URL pour lesquels les sites refusent automatiquement l'autorisation de gestion des fenêtres. Cela limite la capacité des sites à voir les informations concernant les écrans de l'appareil, ainsi qu'à utiliser ces informations pour ouvrir et positionner des fenêtres, ou demander le passage en plein écran sur certains écrans.\n\nPour en savoir plus sur les formats d'URL de sites valides, veuillez consulter https://chromeenterprise.google/policies/url-patterns. Les caractères génériques (*) sont autorisés. Cette règle ne tient compte que de l'origine. Ainsi, tout chemin d'accès dans le format d'URL est ignoré.\n\nSi cette règle n'est pas définie pour un site, alors la règle DefaultWindowManagementSetting s'applique au site (si elle est définie). Sinon, les paramètres par défaut du navigateur s'appliquent, et les utilisateurs peuvent définir l'autorisation pour chaque site.\n\nCette règle remplace la règle WindowPlacementBlockedForUrls, qui est obsolète.";
XSLTEnabled.pfm_title = "Contrôler la disponibilité de la fonctionnalité XSLT";
XSLTEnabled.pfm_description = "Cette règle contrôle la disponibilité de la fonctionnalité XSLT (l'API JavaScript XSLTProcessor et l'instruction de traitement XSL).\nSi cette règle est activée, XSLT sera disponible, quel que soit l'état par défaut de la fonctionnalité dans le navigateur.\nSi cette règle est désactivée, XSLT ne sera pas disponible, quel que soit l'état par défaut de la fonctionnalité dans le navigateur.\nSi cette règle n'est pas configurée, la disponibilité de XSLT sera déterminée par les paramètres par défaut du navigateur et les tests en conditions réelles.\nCette règle est une solution temporaire et sera supprimée dans M176.";