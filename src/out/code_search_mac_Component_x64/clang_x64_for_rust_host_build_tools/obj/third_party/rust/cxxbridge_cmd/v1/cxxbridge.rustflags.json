{
    "rustenv": {
        "OUT_DIR": "clang_x64_for_rust_host_build_tools/gen/third_party/rust/cxxbridge_cmd/v1/cxxbridge",
        "CLIPPY_CONF_DIR": "../../build/config",
        "CARGO_PKG_AUTHORS": "David Tolnay <dtolnay@gmail.com>",
        "CARGO_PKG_VERSION": "1.0.202",
        "CARGO_PKG_VERSION_MAJOR": "1",
        "CARGO_PKG_VERSION_MINOR": "0",
        "CARGO_PKG_VERSION_PATCH": "202",
        "CARGO_PKG_VERSION_PRE": "",
        "CARGO_PKG_NAME": "cxxbridge-cmd",
        "CARGO_PKG_DESCRIPTION": "C++ code generator for integrating `cxx` crate into a non-Cargo build.",
        "CARGO_PKG_REPOSITORY": "https://github.com/dtolnay/cxx",
        "CARGO_MANIFEST_DIR": "../../third_party/rust/cxxbridge_cmd/v1/cxxbridge/crate"
    },
    "rustflags": [
        "-Clinker=../../third_party/llvm-build/Release+Asserts/bin/clang++",
        "../../third_party/rust/chromium_crates_io/vendor/cxxbridge-cmd-v1/src/main.rs",
        "-Clink-arg=-fPIC",
        "-Clink-arg=--target=x86_64-unknown-linux-gnu",
        "-Clink-arg=-no-canonical-prefixes",
        "-Clink-arg=-Wl,--gc-sections",
        "-Clink-arg=-Wl,-z,defs",
        "-Clink-arg=-Wl,--as-needed",
        "-Clink-arg=-nostdlib++",
        "-Clink-arg=--sysroot=../../build/linux/debian_bullseye_amd64-sysroot",
        "-Clink-arg=-fuse-ld=lld",
        "-Clink-arg=-Wl,--fatal-warnings",
        "-Clink-arg=-Wl,--build-id=fast",
        "-Clink-arg=-Wl,-z,noexecstack",
        "-Clink-arg=-Wl,-z,relro",
        "-Clink-arg=-Wl,-z,now",
        "-Clink-arg=-Wl,--icf=all",
        "-Clink-arg=-Wl,--color-diagnostics",
        "-Clink-arg=-Wl,--undefined-version",
        "-Clink-arg=-Wl,--no-call-graph-profile-sort",
        "-Clink-arg=-rdynamic",
        "-Clink-arg=-pie",
        "-Clink-arg=-Wl,--disable-new-dtags",
        "@clang_x64_for_rust_host_build_tools/obj/third_party/rust/cxxbridge_cmd/v1/cxxbridge.rsp.rust"
    ]
}