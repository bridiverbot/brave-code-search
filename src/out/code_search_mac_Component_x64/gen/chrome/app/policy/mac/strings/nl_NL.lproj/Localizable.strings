/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Voorkeuren voor Brave";
AIModeSettings.pfm_title = "Instellingen voor integraties van de AI-modus van Google in de adresbalk en het zoekvak op de pagina Nieuw tabblad.";
AIModeSettings.pfm_description = "0 - Integraties van de AI-modus toestaan.\n1 - Integraties van de AI-modus niet toestaan.\nMet dit beleid bepaal je of integraties van de AI-modus van Google in de adresbalk en het zoekvak op de pagina Nieuw tabblad beschikbaar zijn.\n\nVoor toegang tot deze functie moet Google zijn ingesteld als de standaard zoekmachine van de gebruiker.\n\n0 = De functie is beschikbaar voor gebruikers.\n\n1 = De functie is niet beschikbaar voor gebruikers.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.";
AbusiveExperienceInterventionEnforce.pfm_title = "Interventie voor misleidende functionaliteit afdwingen";
AbusiveExperienceInterventionEnforce.pfm_description = "Als je SafeBrowsingEnabled niet hebt uitgezet, voorkomt het aanzetten van AbusiveExperienceInterventionEnforce of dit niet instellen dat sites met misleidende functionaliteit nieuwe vensters of tabbladen openen.\n\nAls je SafeBrowsingEnabled of AbusiveExperienceInterventionEnforce uitzet, kunnen sites met misleidende functionaliteit nieuwe vensters of tabbladen openen.";
AccessCodeCastDeviceDuration.pfm_title = "Hiermee geef je op hoelang (in seconden) een cast-apparaat dat via een toegangscode of QR-code is geselecteerd, in de lijst met cast-apparaten van het Google Cast-menu blijft staan.";
AccessCodeCastDeviceDuration.pfm_description = "Met dit beleid geef je op hoelang (in seconden) een cast-apparaat dat eerder via een toegangscode of QR-code is geselecteerd, zichtbaar blijft in het Google Cast-menu met cast-apparaten.\nDe levensduur van een item begint op het moment dat de toegangscode voor het eerst wordt opgegeven of de QR-code voor het eerst wordt gescand.\nTijdens deze periode verschijnt het cast-apparaat in de lijst met cast-apparaten van het Google Cast-menu.\nNa deze periode moet de toegangscode opnieuw worden opgegeven of de QR-code opnieuw worden gescand om het cast-apparaat opnieuw te gebruiken.\nDe periode is standaard nul seconden. Dit betekent dat cast-apparaten niet in het Google Cast-menu blijven staan en de toegangscode dus opnieuw moet worden opgegeven of de QR-code opnieuw moet worden gescand om een nieuwe castsessie te starten.\nDit beleid is alleen van invloed op hoelang een cast-apparaat in het Google Cast-menu wordt getoond en heeft geen effect op lopende castsessies die actief blijven nadat de periode is verlopen.\nDit beleid is niet geldig tenzij het beleid AccessCodeCastEnabled wordt toegepast.";
AccessCodeCastEnabled.pfm_title = "Toestaan dat gebruikers vanuit het Google Cast-menu cast-apparaten selecteren met een toegangscode of QR-code.";
AccessCodeCastEnabled.pfm_description = "Met dit beleid bepaal je of gebruikers in het Google Cast-menu een optie te zien krijgen waarmee ze kunnen casten naar apparaten die niet in het Google Cast-menu voorkomen, met de toegangscode of QR-code die wordt getoond op het scherm van de cast-apparaten.\nStandaard moet de gebruiker de toegangscode opnieuw opgeven of de QR-code opnieuw scannen om een volgende castsessie te starten, maar als je het beleid AccessCodeCastDeviceDuration instelt op een waarde die niet nul is (de standaardwaarde is nul), blijft het cast-apparaat in de lijst met beschikbare cast-apparaten staan totdat de opgegeven periode is verstreken.\nAls je dit beleid toepast, krijgen gebruikers de optie om cast-apparaten te selecteren met een toegangscode of door een QR-code te scannen.\nAls je dit beleid niet toepast of niet instelt, krijgen gebruikers niet de optie om cast-apparaten te selecteren met een toegangscode of door een QR-code te scannen.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "Overeenkomende Access-Control-Allow-Methods in pre-flightverzoek voor CORS laten overeenkomen met de specificaties";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Met dit beleid bepaal je of verzoekmethoden in hoofdletters worden gestuurd als ze overeenkomen met reactieheaders voor Access-Control-Allow-Methods in een pre-flightverzoek voor CORS.\n\nAls je het beleid niet toepast, worden verzoekmethoden in hoofdletters geschreven.\nDit is het gedrag in of vóór Brave 108.\n\nAls je het beleid toepast of niet instelt, worden verzoekmethoden niet in hoofdletters geschreven, tenzij ze niet-hoofdlettergevoelig overeenkomen met DELETE, GET, HEAD, OPTIONS, POST of PUT.\nDe reactieheader fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" wordt dan afgewezen, maar fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\" wordt geaccepteerd.\n\nOpmerking: Dit is niet van invloed op de verzoekmethoden \"post\" en \"put\", maar wel op \"patch\".\n\nDit beleid is tijdelijk en wordt in de toekomst verwijderd.";
AccessibilityImageLabelsEnabled.pfm_title = "Get Image Descriptions from Google aanzetten";
AccessibilityImageLabelsEnabled.pfm_description = "Met de toegankelijkheidsfunctie Get Image Descriptions from Google kunnen slechtziende gebruikers van een schermlezer beschrijvingen van niet-gelabelde afbeeldingen op internet krijgen. Gebruikers die de functie aanzetten, kunnen een anonieme Google-service gebruiken voor automatische beschrijvingen van niet-gelabelde afbeeldingen die ze tegenkomen op internet.\n\nAls deze functie aanstaat, wordt de content van afbeeldingen naar de servers van Google gestuurd om een beschrijving te maken. Er worden geen cookies of andere gebruikersgegevens gestuurd en Google bewaart of registreert de content van afbeeldingen niet.\n\nAls dit beleid is ingesteld op Enabled (Aangezet), wordt de functie Get Image Descriptions from Google aangezet, maar is deze alleen van toepassing op gebruikers die een schermlezer of andere vergelijkbare ondersteunende technologie gebruiken.\n\nAls dit beleid is ingesteld op Disabled (Uitgezet), kunnen gebruikers de functie niet aanzetten.\n\nAls het beleid niet is ingesteld, kunnen gebruikers kiezen of ze deze functie willen gebruiken.";
AdditionalDnsQueryTypesEnabled.pfm_title = "DNS-zoekopdrachten voor aanvullende DNS-recordtypen toestaan";
AdditionalDnsQueryTypesEnabled.pfm_description = "Dit beleid bepaalt of Brave zoekopdrachten voor aanvullende DNS-recordtypen mag uitvoeren als er niet-beveiligde DNS-verzoeken worden gestuurd. Dit beleid heeft geen effect op DNS-zoekopdrachten die worden uitgevoerd via Beveiligde DNS, waarmee altijd zoekopdrachten voor aanvullende DNS-typen mogen worden uitgevoerd.\n\nAls je dit beleid toepast of niet instelt, mogen zoekopdrachten voor aanvullende typen zoals HTTPS (DNS-type 65) worden uitgevoerd in aanvulling op A (DNS-type 1) en AAAA (DNS-type 28).\n\nAls je dit beleid niet toepast, worden zoekopdrachten voor DNS alleen uitgevoerd voor A (DNS-type 1) en/of AAAA (DNS-type 28).\n\nDit beleid is een tijdelijke maatregel en wordt verwijderd in toekomstige versies van Brave. Na verwijdering van het beleid kan Brave altijd zoekopdrachten voor aanvullende DNS-typen uitvoeren.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Advertentie-instellingen voor sites met opdringerige advertenties";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Advertenties toestaan op alle sites\n2 - Geen advertenties toestaan op sites met opdringerige advertenties\nAdvertenties zijn op alle sites toegestaan als je AdsSettingForIntrusiveAdsSites instelt op 1 of niet instelt, tenzij SafeBrowsingEnabled is ingesteld op False.\n\nAls je het beleid instelt op 2, worden advertenties geblokkeerd op alle sites met opdringerige advertenties.";
AdvancedProtectionAllowed.pfm_title = "Extra beveiligingsfuncties aanzetten voor gebruikers die zijn ingeschreven voor Geavanceerde beveiliging";
AdvancedProtectionAllowed.pfm_description = "Met dit beleid wordt bepaald of gebruikers die bij 'Geavanceerde beveiliging' zijn ingeschreven, extra beveiligingsmaatregelen ontvangen. Voor sommige van deze functies kunnen gegevens worden gedeeld met Google (gebruikers van 'Geavanceerde beveiliging' kunnen bijvoorbeeld hun downloads naar Google sturen om ze te scannen op malware). Als dit beleid is ingesteld op True of niet is ingesteld, ontvangen ingeschreven gebruikers extra beveiligingsmaatregelen. Als dit beleid is ingesteld op False, ontvangen gebruikers van 'Geavanceerde beveiliging' alleen de standaardfuncties voor consumenten.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Lijst met herkomsten waarvoor alle HTTP-verificatie is toegestaan";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "Als je het beleid instelt, wordt gespecificeerd voor welke oorsprongen alle HTTP-verificatieschema's worden toegestaan die Brave ondersteunt, ongeacht het beleid AuthSchemes.\n\nVanaf Brave versie 161 is dit beleid alleen van toepassing op oorsprongen van bestemmingsservers en niet op verificatie-uitdagingen van proxyservers. Als je alle HTTP-verificatieschema's voor proxyservers wilt toestaan, gebruik je het beleid AllHttpAuthSchemesAllowedForProxies. Vóór versie 161 mogen proxyservers die overeenkomen met dit beleid ook alle HTTP-verificatieschema's gebruiken, tenzij AllHttpAuthSchemesAllowedForProxies is ingesteld.\n\nMaak het oorsprongpatroon op volgens deze indeling (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Je kunt maximaal 1000 uitzonderingen definiëren in AllHttpAuthSchemesAllowedForOrigins.\nJokertekens zijn toegestaan voor de hostcomponent (bijvoorbeeld *:8000 komt overeen met alle hosts op poort 8000). Als je alle schema's of alle poorten wilt matchen, laat je de component helemaal weg (bijvoorbeeld example.com komt overeen met elk schema en elke poort). Een hostnaam (bijvoorbeeld example.com) komt ook overeen met de subdomeinen. Als je een host exact wilt matchen en de subdomeinen wilt uitsluiten, voeg je een punt toe (bijvoorbeeld .example.com). Als je alle oorsprongen wilt matchen, gebruik je één asterisk (*).";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Lijst met proxyservers waarvoor alle HTTP-verificatieschema's zijn toegestaan";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "Als je het beleid instelt, wordt gespecificeerd voor welke proxyservers alle HTTP-verificatieschema's worden toegestaan die Brave ondersteunt, ongeacht het beleid AuthSchemes.\n\nMaak het proxyserverpatroon op volgens de indeling van het URL-blokkeerlijstfilter (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Je kunt maximaal 1000 uitzonderingen definiëren.\nJokertekens zijn toegestaan voor de hostcomponent (bijvoorbeeld *:8080 komt overeen met alle proxy's op poort 8080). Een hostnaam (bijvoorbeeld proxy.example.com) komt ook overeen met de subdomeinen. Als je een host exact wilt matchen en de subdomeinen wilt uitsluiten, voeg je een punt toe (bijvoorbeeld .proxy.example.com).\n\nAls je dit beleid niet instelt, worden alleen de HTTP-verificatieschema's die zijn gespecificeerd in AuthSchemes (of de standaardschema's als dit niet is ingesteld) ondersteund voor proxyverificatie.";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Toestaan dat pagina's met de koptekst Cache-Control: no-store worden opgeslagen in Back-Forward Cache.";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Dit beleid bepaalt of een pagina met de koptekst Cache-Control: no-store kan worden opgeslagen in Back-Forward Cache. De website die deze koptekst instelt, verwacht misschien niet dat de pagina wordt hersteld vanuit Back-Forward Cache, omdat bepaalde gevoelige informatie na het herstel misschien nog steeds wordt getoond, ook als deze niet meer toegankelijk is.\n\nAls je het beleid toepast of niet instelt, kan de pagina met de koptekst Cache-Control: no-store worden hersteld vanuit Back-Forward Cache, tenzij verwijdering uit het cachegeheugen wordt geactiveerd (bijvoorbeeld als er een cookiewijziging met alleen HTTP op de site is).\n\nAls je het beleid niet toepast, wordt de pagina met de koptekst Cache-Control: no-store niet opgeslagen in Back-Forward Cache.";
AllowCrossOriginAuthPrompt.pfm_title = "Cross-origin-prompts voor HTTP-verificatie";
AllowCrossOriginAuthPrompt.pfm_description = "Als je het beleid toepast, kunnen afbeeldingen van derden op een pagina een verificatieprompt tonen.\n\nAls je het beleid niet toepast of niet instelt, kunnen afbeeldingen van derden geen verificatieprompt tonen.\n\nDit beleid wordt meestal niet toegepast als beveiliging tegen phishing.";
AllowDeletingBrowserHistory.pfm_title = "Verwijdering van browser- en downloadgeschiedenis aanzetten";
AllowDeletingBrowserHistory.pfm_description = "Als je het beleid toepast of niet instelt, kunnen de browser- en downloadgeschiedenis in Chrome worden verwijderd. Gebruikers kunnen deze instelling niet wijzigen.\n\nAls je dit beleid niet toepast, kunnen de browser- en downloadgeschiedenis niet worden verwijderd. Ook als je dit beleid niet toepast, kan niet worden gegarandeerd dat de browser- en downloadgeschiedenis behouden blijven. Gebruikers kunnen de databasebestanden van de geschiedenis rechtstreeks bewerken of verwijderen en de browser kan sommige of alle geschiedenisitems op elk moment laten verlopen of archiveren.";
AllowDinosaurEasterEgg.pfm_title = "Easter egg-dinosaurusgame toestaan";
AllowDinosaurEasterEgg.pfm_description = "Als je het beleid instelt op True, kunnen gebruikers de dinosaurusgame spelen. Als je het beleid instelt op False, kunnen gebruikers de easter egg-dinosaurusgame niet spelen als het apparaat offline is.\n\nAls je het beleid niet instelt, kunnen gebruikers de game niet spelen op ingeschreven Google Chrome OS-apparaten, maar wel onder andere omstandigheden.";
AllowFileSelectionDialogs.pfm_title = "Activering van dialoogvensters voor het selecteren van bestanden toestaan";
AllowFileSelectionDialogs.pfm_description = "Als je dit beleid toepast of niet instelt, kan Chrome dialoogvensters voor het selecteren van bestanden bekijken en kunnen gebruikers deze openen.\n\nAls je het beleid niet toepast, wordt er in plaats daarvan altijd een bericht getoond als gebruikers acties uitvoeren die een dialoogvenster voor het selecteren van bestanden aanroepen, zoals bookmarks importeren, bestanden uploaden en links opslaan. Er wordt vanuit gegaan dat de gebruiker op Annuleren heeft geklikt in het dialoogvenster voor het selecteren van bestanden.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Herschikking in willekeurige volgorde van de grootte van de socketgroep voor proxy's toestaan";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "Herschikking in willekeurige volgorde van de grootte van de socketgroep is een beveiligingsmechanisme dat voorkomt dat aanvallers deterministische capaciteitslimieten misbruiken om informatie op meerdere sites te leren.\nAls de capaciteit voor een groep normaal gesproken 128 sockets is, wordt de groep met dit mechanisme willekeurig beperkt tot tussen de 128 en 256.\nHierdoor kunnen er tot 2 keer zoveel verbindingen met de proxy worden gemaakt, maar in de praktijk is de verwachte waarde meer 1,2 keer.\n\nDit heeft invloed op de instellingen van MaxConnectionsPerProxy en MaxConnectionsPerProxyForWebSocket.\nIn plaats van dat zij de bovengrens bepalen, is de bovengrens 2 keer hun waarden (maar de verwachte waarde in de praktijk is eerder 1,2 keer hun waarden).\n\nDit staat standaard aan voor alle groepen, maar met dit beleid kun je de functie specifiek uitzetten voor proxygroepen.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Verzoeken voor webverificatie toestaan op sites met niet-werkende TLS-certificaten.";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Als je dit beleid toepast, staat Brave verzoeken voor webverificatie toe op websites met TLS-certificaten met fouten (dat wil zeggen, websites die niet als beveiligd worden beschouwd).\n\nAls je het beleid niet toepast of niet instelt, is het standaardgedrag van toepassing, waarbij dergelijke verzoeken worden geblokkeerd.";
AllowedDomainsForApps.pfm_title = "Domeinen definiëren die toegang mogen hebben tot Google Workspace";
AllowedDomainsForApps.pfm_description = "Als je dit beleid instelt, wordt de beperkte inlogfunctie van Chrome in Google Workspace aangezet. Gebruikers kunnen deze instelling niet wijzigen. Gebruikers kunnen Google-tools alleen openen met accounts van de opgegeven domeinen (voeg consumer_accounts toe aan de lijst met domeinen om Gmail- en GoogleMail-accounts toe te staan). Deze instelling voorkomt dat gebruikers inloggen op een secundair account en dit toevoegen aan een beheerd apparaat waarvoor Google-verificatie vereist is, als dit account niet behoort tot één van de expliciet toegestane domeinen.\n\nAls je deze instelling leeg laat of niet instelt, kunnen gebruikers Google Workspace openen met elk account.\n\nGebruikers kunnen deze instelling niet wijzigen of overschrijven.\n\nOpmerking: Door dit beleid wordt de kop 'X-GoogApps-Allowed-Domains' toegevoegd aan alle HTTP- en HTTPS-verzoeken voor alle google.com-domeinen, zoals beschreven in https://support.google.com/a/answer/1668854.";
AlternateErrorPagesEnabled.pfm_title = "Alternatieve foutpagina's gebruiken";
AlternateErrorPagesEnabled.pfm_description = "Als je het beleid instelt op True, gebruikt Brave alternatieve foutpagina's die zijn ingebouwd (zoals Pagina niet gevonden). Als je het beleid instelt op False, gebruikt Brave nooit alternatieve foutpagina's.\n\nAls je het beleid instelt, kunnen gebruikers het niet wijzigen. Als je het beleid niet instelt, wordt het toegepast maar kunnen gebruikers deze instelling wijzigen.";
AlternativeBrowserParameters.pfm_title = "Opdrachtregelparameters voor de alternatieve browser.";
AlternativeBrowserParameters.pfm_description = "Als je dit beleid instelt op een lijst met tekenreeksen, wordt elke tekenreeks doorgegeven aan de alternatieve browser als afzonderlijke opdrachtregelparameter. In Microsoft® Windows® worden de parameters samengevoegd met spaties. In macOS en Linux® mag een parameter spaties bevatten en wordt dan nog steeds verwerkt als één parameter.\n\nAls een parameter ${url} bevat, wordt ${url} vervangen door de URL van de pagina die moet worden geopend. Als geen enkele parameter ${url} bevat, wordt de URL toegevoegd aan het einde van de opdrachtregel.\n\nOmgevingsvariabelen worden uitgevouwen. In Microsoft® Windows® wordt %ABC% vervangen door de waarde van de omgevingsvariabele ABC. In macOS en Linux® wordt ${ABC} vervangen door de waarde van de omgevingsvariabele ABC.\n\nAls je het beleid niet instelt, wordt alleen de URL doorgegeven als opdrachtregelparameter.";
AlternativeBrowserPath.pfm_title = "Alternatieve browser die wordt gestart voor geconfigureerde websites.";
AlternativeBrowserPath.pfm_description = "Met dit beleid bepaal je welke opdracht moet worden gebruikt om URL's te openen in een alternatieve browser. Je kunt dit beleid instellen op ${ie}, ${firefox}, ${safari}, ${opera}, ${edge} of een bestandspad. Als je dit beleid instelt op een bestandspad, wordt dat bestand als uitvoerbaar bestand gebruikt. ${ie} is alleen beschikbaar op Microsoft® Windows®. ${safari} en ${edge} zijn alleen beschikbaar op Microsoft® Windows® en macOS.\n\nAls je het beleid niet instelt, wordt er een platformspecifieke standaard-app gebruikt: Internet Explorer® voor Microsoft® Windows® en Safari® voor macOS. In Linux® werkt het starten van een alternatieve browser niet.";
AlwaysOpenPdfExternally.pfm_title = "Pdf-bestanden altijd extern openen";
AlwaysOpenPdfExternally.pfm_description = "Als je het beleid toepast, wordt de interne pdf-viewer in Brave uitgezet, worden pdf-bestanden als downloads behandeld en kunnen gebruikers pdf's openen met de standaard-app.\n\nAls je het beleid niet toepast, worden pdf-bestanden geopend, tenzij gebruikers de pdf-plug-in uitzetten.\n\nAls je het beleid instelt, kunnen gebruikers dit niet wijzigen in Brave. Als je het beleid niet instelt, kunnen gebruikers kiezen of ze pdf-bestanden extern willen openen.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Ambient-verificatie voor profieltypen aanzetten.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Ambient-verificatie alleen in normale sessies aanzetten.\n1 - Ambient-verificatie in normale en incognitosessies aanzetten.\n2 - Ambient-verificatie in normale en gastsessies aanzetten.\n3 - Ambient-verificatie in normale, incognito- en gastsessies aanzetten.\nAls je dit beleid instelt, wordt Ambient-verificatie voor incognito- en gastprofielen toegestaan/niet toegestaan in Brave.\n\nAmbient-verificatie is HTTP-verificatie met standaardgegevens als er geen expliciete gegevens worden verstrekt via uitdaging/reactie-schema's van NTLM/Kerberos/Negotiate.\n\nAls je RegularOnly (waarde 0) instelt, is Ambient-verificatie alleen toegestaan voor normale sessies. Ambient-verificatie is dan niet toegestaan voor incognito- en gastsessies.\n\nAls je IncognitoAndRegular (waarde 1) instelt, is Ambient-verificatie toegestaan voor normale en incognitosessies. Ambient-verificatie is dan niet toegestaan voor gastsessies.\n\nAls je GuestAndRegular (waarde 2) instelt, is Ambient-verificatie toegestaan voor normale en gastsessies. Ambient-verificatie is dan niet toegestaan voor incognitosessies.\n\nAls je All (waarde 3) instelt, is Ambient-verificatie toegestaan voor alle sessies.\n\nAmbient-verificatie is altijd toegestaan voor normale profielen.\n\nAls het beleid niet is ingesteld in versie 81 en hoger van Brave, wordt Ambient-verificatie alleen gebruikt in normale sessies.";
AudioCaptureAllowed.pfm_title = "Het opnemen van audio toestaan of weigeren";
AudioCaptureAllowed.pfm_description = "Als je het beleid toepast of niet instelt, wordt gebruikers in een prompt om toegang tot audio-opnamen gevraagd, met uitzondering van de URL's die zijn ingesteld in de lijst AudioCaptureAllowedUrls.\n\nAls je het beleid niet toepast, worden prompts uitgezet en zijn audio-opnamen alleen beschikbaar voor URL's die zijn ingesteld in de lijst AudioCaptureAllowedUrls.\n\nOpmerking: Dit beleid is van invloed op alle audio-invoer (en niet alleen op de ingebouwde microfoon).";
AudioCaptureAllowedUrls.pfm_title = "URL's die zonder prompt toegang krijgen tot apparaten voor het vastleggen van audio";
AudioCaptureAllowedUrls.pfm_description = "Als je het beleid instelt, specificeer je de lijst met URL's waarvan de patronen worden vergeleken met de beveiligingsoorsprong van de aanvragende URL. Bij een overeenkomst wordt zonder prompt toegang gegeven tot apparaten voor audio-opnamen.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige url-patronen. Houd er wel rekening mee dat het patroon *, dat overeenkomt met elke URL, niet wordt ondersteund door dit beleid.";
AudioSandboxEnabled.pfm_title = "Toestaan dat de audiosandbox wordt uitgevoerd";
AudioSandboxEnabled.pfm_description = "Met dit beleid wordt het sandboxproces voor audio beheerd.\nAls dit beleid is toegepast, wordt het audioproces uitgevoerd in een sandbox.\nAls dit beleid niet is toegepast, wordt het audioproces niet uitgevoerd in een sandbox en wordt de WebRTC-audioverwerkingsmodule uitgevoerd in het proces van het weergaveprogramma.\nHierdoor staan gebruikers bloot aan beveiligingsrisico's doordat het subsysteem voor audio niet in een sandbox wordt uitgevoerd.\nAls dit beleid niet wordt ingesteld, wordt de standaardconfiguratie voor de audiosandbox gebruikt, die per platform kan verschillen.\nDit beleid is bedoeld om bedrijven de flexibiliteit te bieden om de audiosandbox uit te zetten als ze instellingen voor beveiligingssoftware gebruiken die de sandbox kunnen verstoren.";
AuthNegotiateDelegateAllowlist.pfm_title = "Toelatingslijst voor Kerberos-delegatieserver";
AuthNegotiateDelegateAllowlist.pfm_description = "Als je het beleid instelt, worden servers toegewezen waaraan Brave kan delegeren. Gebruik bij meerdere servernamen een komma als scheidingsteken. Jokertekens (*) zijn toegestaan.\n\nAls je het beleid niet instelt, delegeert Brave geen inloggegevens van gebruikers, zelfs niet als een server wordt gedetecteerd als intranet.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Gebruik KDC-beleid om gegevens te delegeren.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Als je het beleid toepast, respecteert HTTP-verificatie goedkeuring door het KDC-beleid. Met andere woorden: Brave delegeert inloggegevens van gebruikers alleen aan de te gebruiken service als het KDC OK-AS-DELEGATE instelt op een serviceticket. Zie RFC 5896 (https://tools.ietf.org/html/rfc5896.html). De service moet ook worden toegestaan door AuthNegotiateDelegateAllowlist.\n\nAls je het beleid niet toepast of niet instelt, wordt het KDC-beleid genegeerd op ondersteunde platforms en wordt alleen AuthNegotiateDelegateAllowlist gerespecteerd.\n\nOp Microsoft® Windows® wordt het KDC-beleid altijd gerespecteerd.";
AuthSchemes.pfm_title = "Ondersteunde authenticatieschema's";
AuthSchemes.pfm_description = "Als je het beleid instelt, geef je aan welke HTTP-verificatieschema's worden ondersteund door Brave.\n\nAls je het beleid niet instelt, worden alle vier de schema's toegepast.\n\nGeldige waarden:\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nOpmerking: Gebruik bij meerdere waarden een komma als scheidingsteken.";
AuthServerAllowlist.pfm_title = "Toelatingslijst voor verificatieserver";
AuthServerAllowlist.pfm_description = "Als je het beleid instelt, geef je aan welke servers op de toelatingslijst voor geïntegreerde verificatie moeten worden gezet. Geïntegreerde verificatie is alleen aangezet als Brave een verificatie-uitdaging ontvangt van een proxy of een server die op deze toelatingslijst staat.\n\nAls je het beleid niet instelt, probeert Brave te detecteren of er een server op het intranet is. Alleen dan reageert het product op IWA-verzoeken. Als een server wordt gedetecteerd als internet, worden IWA-verzoeken ervan genegeerd door Brave.\n\nOpmerking: Gebruik bij meerdere servernamen een komma als scheidingsteken. Jokertekens (*) zijn toegestaan.";
AutoLaunchProtocolsFromOrigins.pfm_title = "Een lijst definiëren met protocollen die een externe app waarvan de herkomst in een lijst wordt vermeld, kunnen starten zonder prompt aan de gebruiker";
AutoLaunchProtocolsFromOrigins.pfm_description = "Hiermee kun je een lijst met protocollen instellen (en voor elk protocol een gekoppelde lijst met toegestane herkomstpatronen) die een externe app kunnen starten zonder prompt aan de gebruiker. Het scheidingsteken achteraan moet niet worden opgenomen bij de vermelding van het protocol. Vermeld bijvoorbeeld 'skype' in plaats van 'skype:' of 'skype://'.\n\nAls dit beleid is ingesteld, kan een protocol volgens het beleid een externe app alleen starten zonder prompt aan de gebruiker als het protocol in de lijst wordt vermeld en de herkomst van de site die probeert het protocol te starten, overeenkomt met een van de herkomstpatronen in de lijst allowed_origins van dat protocol. Als een van de voorwaarden False is, wordt de prompt voor starten via een extern protocol volgens het beleid niet overgeslagen.\n\nAls dit beleid niet is ingesteld, kunnen protocollen standaard niet worden gestart zonder prompt. Gebruikers kunnen zich voor specifieke protocollen/sites afmelden voor prompts, tenzij het beleid ExternalProtocolDialogShowAlwaysOpenCheckbox is uitgezet. Dit beleid heeft geen invloed op promptuitzonderingen voor specifieke protocollen/sites die zijn ingesteld door gebruikers.\n\nDe patronen voor overeenkomende oorsprong gebruiken een vergelijkbare indeling als die voor het beleid URLBlocklist (deze worden gedocumenteerd op https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nPatronen voor overeenkomende herkomst voor dit beleid mogen geen '/path' or '@query'-elementen bevatten. Patronen die een '/path'- of '@query'-element bevatten, worden genegeerd.\nGa naar https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins voor meer informatie over schema en indeling.";
AutoOpenAllowedForURLs.pfm_title = "URL's waarbij AutoOpenFileTypes van toepassing kan zijn";
AutoOpenAllowedForURLs.pfm_description = "Lijst met URL's waarin wordt aangegeven op welke URL's AutoOpenFileTypes van toepassing is. Dit beleid is niet van invloed op waarden voor automatisch openen die zijn ingesteld door gebruikers.\n\nAls dit beleid is ingesteld, worden bestanden alleen geopend op basis van het beleid als de URL onderdeel is van deze set en het bestandstype wordt vermeld in AutoOpenFileTypes. Als een van de voorwaarden False is, wordt de download niet automatisch geopend op basis van het beleid.\n\nAls dit beleid niet is ingesteld, worden alle downloads waarvan het bestandstype in AutoOpenFileTypes staat automatisch geopend.\n\nEen URL-patroon moet worden ingedeeld volgens https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
AutoOpenFileTypes.pfm_title = "Lijst met bestandstypen die automatisch moeten worden geopend nadat ze zijn gedownload";
AutoOpenFileTypes.pfm_description = "Lijst met bestandstypen die automatisch moeten worden geopend nadat ze zijn gedownload. Het voorafgaande scheidingsteken mag niet worden opgenomen als je het bestandstype vermeldt. Vermeld dus 'txt' in plaats van '.txt'.\n\nBestanden met typen die automatisch moeten worden geopend, vallen nog steeds onder de geactiveerde Safe Browsing-checks en worden niet geopend als ze die checks niet doorstaan.\n\nAls dit beleid niet is ingesteld, worden alleen bestandstypen waarvoor een gebruiker dit al heeft aangegeven, automatisch geopend nadat ze zijn gedownload.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
AutoSelectCertificateForUrls.pfm_title = "Clientcertificaten automatisch selecteren voor deze sites";
AutoSelectCertificateForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen invoeren van sites waarvoor Chrome automatisch een clientcertificaat kan selecteren. De waarde is een matrix van JSON-woordenboeken met tekenreeksen, elk met de indeling { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER }, waarbij $URL_PATTERN een patroon voor het instellen van content is. $FILTER beperkt de clientcertificaten waaruit de browser automatisch kan kiezen. Onafhankelijk van het filter worden alleen certificaten geselecteerd die overeenkomen met het certificaatverzoek van de server. Op Android en iOS kan Chrome alleen clientcertificaten selecteren die het zelf heeft ingesteld. Chrome heeft geen toegang tot certificaten die zijn geïnstalleerd op het niveau van het besturingssysteem.\n\nVoorbeelden voor het gebruik van het gedeelte $FILTER:\n\n* Als $FILTER is ingesteld op { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } }, worden er alleen clientcertificaten geselecteerd die zijn uitgegeven door een certificaat met de CommonName $ISSUER_CN.\n\n* Als $FILTER zowel het gedeelte \"ISSUER\" als het gedeelte \"SUBJECT\" bevat, worden alleen clientcertificaten geselecteerd die aan beide voorwaarden voldoen.\n\n* Als $FILTER een gedeelte \"SUBJECT\" met de waarde \"O\" bevat, moet een certificaat ten minste één organisatie hebben die overeenkomt met de ingevoerde waarde om te worden geselecteerd.\n\n* Als $FILTER een gedeelte \"SUBJECT\" met een waarde \"OU\" bevat, moet een certificaat ten minste één organisatie-eenheid hebben die overeenkomt met de ingevoerde waarde om te worden geselecteerd.\n\n* Als $FILTER is ingesteld op {}, wordt de selectie van clientcertificaten niet verder beperkt. Houd er rekening mee dat filters die door de webserver worden geleverd, nog steeds van toepassing zijn.\n\nAls je het beleid niet instelt, worden clientcertificaten voor geen enkele site automatisch geselecteerd.\nGa naar https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls voor meer informatie over schema en indeling.";
AutofillGenAiSettings.pfm_title = "Instellingen voor generatieve AI-functies in Automatisch invullen";
AutofillGenAiSettings.pfm_description = "0 - Sta generatieve AI-functies in Automatisch invullen toe en verbeter AI-modellen.\n1 - Sta generatieve AI-functies in Automatisch invullen toe zonder AI-modellen te verbeteren.\n2 - Functies voor generatieve AI in Automatisch invullen niet toestaan.\nDeze functies in Brave gebruiken modellen voor generatieve AI om gebruikers te helpen formulieren op internet in te vullen. Als je deze functies wilt gebruiken, moet Brave gegevens verzamelen zoals de structuur van de formulieren waarmee een gebruiker interactie heeft en, voor Zoeken en invullen met Gemini, de vrije-tekstquery's die een gebruiker invoert om gekoppelde Gemini-apps te doorzoeken, en deze gegevens naar een server sturen die eigendom is van Google, waarop een model voor generatieve AI wordt uitgevoerd.\n\nAls je het beleid instelt op 0 (Functies voor generatieve AI toestaan in Automatisch invullen en AI-modellen verbeteren), kunnen de functies worden gebruikt en kan Google relevante gegevens gebruiken om de AI-modellen te verbeteren. Relevante gegevens kunnen prompts, invoer, uitvoer, bronmateriaal en geschreven feedback zijn, afhankelijk van de functie. 0 is de standaardwaarde, behalve zoals hieronder aangegeven.\n\nAls je het beleid instelt op 1 (Functies voor generatieve AI in Automatisch invullen toestaan zonder AI-modellen te verbeteren), kunnen de functies worden gebruikt, maar kan Google geen modellen verbeteren met content van gebruikers (waaronder prompts, invoer, uitvoer, bronmateriaal en geschreven feedback). 1 is de standaardwaarde voor zakelijke gebruikers die worden beheerd via Google Admin console en voor onderwijsaccounts die worden beheerd via Google Workspace.\n\nAls je het beleid instelt op 2 (Functies voor generatieve AI niet toestaan in Automatisch invullen), worden de functies niet toegestaan.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nFuncties voor generatieve AI in Automatisch invullen zijn onder andere:\n\n- Slimmer formulieren invullen: Gebruikt AI om de velden van een formulier te herkennen en te classificeren, zodat er meer kunnen worden ingevuld.\n\n- Zoeken en invullen met Gemini: Vindt informatie uit de apps die een gebruiker aan Gemini heeft gekoppeld en biedt deze aan om in te vullen, als proactieve suggesties op een formulier of als reactie op een vraag die de gebruiker schrijft.\n\nDit beleid vervangt het beleid AutofillPredictionSettings, dat nog steeds van toepassing is als dit beleid niet is ingesteld. Voor de functie Zoeken en invullen met Gemini mag het beleid GeminiSettings ook niet uitstaan.\n\nDit beleid beheert geen functies voor automatisch invullen die geen generatieve AI gebruiken.\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
AutofillSettings.pfm_title = "Gegevenstypen voor automatisch invullen blokkeren voor specifieke sites";
AutofillSettings.pfm_description = "Als je dit beleid instelt, kun je aangeven welke gegevenstypen voor automatisch invullen worden geblokkeerd voor specifieke URL-patronen.\n\nHet beleid is gestructureerd als een lijst met woordenboeken. Elk woordenboek moet het volgende bevatten:\n* 'url_pattern': Een URL-patroon voor het instellen van content voor het hoofdframe (bijv. 'https://[*.]example.com').\n* 'blocked_types': Een lijst met tekenreeksen die de categorieën van gegevens voor automatisch invullen aangeven die moeten worden geblokkeerd.\n\nDe ondersteunde waarden voor 'blocked_types' zijn:\n* 'contact_info': Blokkeert het invullen en opslaan van contactgegevens.\n* 'payments': Blokkeert het invullen en opslaan van creditcards en betaalmethoden.\n* 'identity_docs': Blokkeert het invullen en opslaan van identiteitsdocumenten (bijv. paspoort, rijbewijs, nationale ID).\n* 'travel': Blokkeert het invullen en opslaan van reisinformatie (bijv. vluchtreservering, voertuigregistratie).\n* 'shopping': Blokkeert het invullen en opslaan van winkelinformatie (bijv. online bestellingen, verzendingen).\n* 'all': Blokkeert het invullen en opslaan van alle gegevenstypen voor automatisch invullen.\n\nAls een gegevenstype is geblokkeerd voor een site, wordt zowel het genereren van suggesties als de prompt om nieuwe gegevens van dat type op te slaan/te importeren uitgezet op die site.\n\nAls een URL overeenkomt met meerdere patroonitems in de lijst, worden de geblokkeerde typen van alle overeenkomende items gecombineerd (samengevoegd). Ongeldige URL-patronen in de lijst worden genegeerd.\n\nAls je dit beleid niet instelt, worden er geen gegevenstypen voor automatisch invullen geblokkeerd op domein.\n\nGa voor gedetailleerde informatie over geldige URL-patronen naar:\nhttps://chromeenterprise.google/policies/url-patterns. Het jokerteken * wordt ondersteund. Dit patroon komt overeen met elke URL, met elk schema, elke poort en elk pad.\nGa naar https://chromeenterprise.google/policies/?policy=AutofillSettings voor meer informatie over schema en indeling.";
AutomatedPasswordChangeSettings.pfm_title = "Geautomatiseerde wachtwoordwijziging aanzetten";
AutomatedPasswordChangeSettings.pfm_description = "0 - Gebruik van functie toestaan en AI-modellen verbeteren\n1 - Gebruik van functie toestaan zonder AI-modellen te verbeteren\n2 - Functie niet toestaan\nDit beleid bepaalt de beschikbaarheid van de functie voor geautomatiseerde wachtwoordwijziging van Brave.\n\nAls je dit beleid toepast, kan een gebruiker een proces starten waarbij de browser automatisch probeert het wachtwoord op een website te wijzigen. Dit proces wordt beheerd door generatieve AI. Het nieuwe wachtwoord wordt opgeslagen in de wachtwoordmanager van de browser.\n\n0 = Hiermee wordt toegestaan dat de functie wordt gebruikt en dat Google relevante gegevens gebruikt om de AI-modellen te verbeteren. Relevante gegevens kunnen prompts, invoer, uitvoer, bronmateriaal en geschreven feedback zijn, afhankelijk van de functie. De gegevens kunnen ook door mensen worden beoordeeld om AI-modellen te verbeteren. 0 is de standaardwaarde, behalve zoals hieronder aangegeven.\n\n1 = Hiermee wordt toegestaan dat de functie wordt gebruikt, maar wordt niet toegestaan dat Google modellen verbetert met content van gebruikers (waaronder prompts, invoer, uitvoer, bronmateriaal en geschreven feedback). 1 is de standaardwaarde voor zakelijke gebruikers die worden beheerd door de Google Beheerdersconsole en voor onderwijsaccounts die worden beheerd door Google Workspace.\n\n2 = Hiermee wordt de functie niet toegestaan.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Automatische downloads toestaan op deze sites";
AutomaticDownloadsAllowedForUrls.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen van sites die automatisch meerdere bestanden mogen downloaden.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\n\nAls een URL overeenkomt met zowel AutomaticDownloadsAllowedForUrls als AutomaticDownloadsBlockedForUrls, heeft AutomaticDownloadsBlockedForUrls voorrang.\n\nAls je dit beleid niet instelt, is DefaultAutomaticDownloadsSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Automatische downloads blokkeren op deze sites";
AutomaticDownloadsBlockedForUrls.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen van sites die niet automatisch meerdere bestanden mogen downloaden.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\n\nAls een URL overeenkomt met zowel AutomaticDownloadsAllowedForUrls als AutomaticDownloadsBlockedForUrls, heeft AutomaticDownloadsBlockedForUrls voorrang.\n\nAls je dit beleid niet instelt, is DefaultAutomaticDownloadsSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Automatisch volledig scherm toestaan op deze sites";
AutomaticFullscreenAllowedForUrls.pfm_description = "Om veiligheidsredenen moet voor de web-API requestFullscreen() een eerder gebruikersgebaar ('tijdelijke activering') worden aangeroepen, anders mislukt deze. De persoonlijke instellingen van gebruikers kunnen toestaan dat bepaalde oorsprongen deze API aanroepen zonder eerder gebruikersgebaar, zoals beschreven in https://chromestatus.com/feature/6218822004768768.\n\nDit beleid vervangt de persoonlijke instellingen van gebruikers en staat toe dat overeenkomende oorsprongen de API aanroepen zonder eerder gebruikersgebaar.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\nJokertekens (*) zijn toegestaan.\n\nOorsprongen die overeenkomen met zowel geblokkeerde als toegestane beleidspatronen worden geblokkeerd.\nVoor oorsprongen waarvoor geen informatie is in beleid of gebruikersinstellingen, is een eerder gebruikersgebaar vereist om deze API aan te roepen.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Automatisch volledig scherm blokkeren op deze sites";
AutomaticFullscreenBlockedForUrls.pfm_description = "Om veiligheidsredenen moet voor de web-API requestFullscreen() een eerder gebruikersgebaar ('tijdelijke activering') worden aangeroepen, anders mislukt deze. De persoonlijke instellingen van gebruikers kunnen toestaan dat bepaalde oorsprongen deze API aanroepen zonder eerder gebruikersgebaar, zoals beschreven in https://chromestatus.com/feature/6218822004768768.\n\nDit beleid vervangt de persoonlijke instellingen van gebruikers en voorkomt dat overeenkomende oorsprongen de API aanroepen zonder eerder gebruikersgebaar.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\nJokertekens (*) zijn toegestaan.\n\nOorsprongen die overeenkomen met zowel geblokkeerde als toegestane beleidspatronen worden geblokkeerd.\nVoor oorsprongen waarvoor geen informatie is in beleid of gebruikersinstellingen is een eerder gebruikersgebaar vereist om deze API aan te roepen.";
AutoplayAllowed.pfm_title = "Automatisch afspelen van media toestaan";
AutoplayAllowed.pfm_description = "Als je het beleid instelt op True, wordt media automatisch afgespeeld door Brave. Als je het beleid instelt op False, wordt media niet automatisch afgespeeld door Brave.\n\nAls dit beleid niet wordt ingesteld, wordt media niet automatisch afgespeeld door Brave. Voor bepaalde URL-patronen kun je het beleid AutoplayAllowlist gebruiken om deze instellingen te wijzigen.\n\nAls je dit beleid wijzigt terwijl Brave wordt uitgevoerd, wordt het alleen toegepast op nieuw geopende tabbladen.";
AutoplayAllowlist.pfm_title = "Automatisch afspelen van media toestaan op een toelatingslijst met URL-patronen";
AutoplayAllowlist.pfm_description = "Als je dit beleid instelt, worden video's met audiocontent automatisch (zonder toestemming van de gebruiker) afgespeeld in Brave. Als het beleid AutoplayAllowed is ingesteld op True, heeft dit beleid geen effect. Als AutoplayAllowed is ingesteld op False, kunnen URL-patronen die in dit beleid zijn ingesteld nog altijd worden afgespeeld. Als je dit beleid wijzigt terwijl Brave wordt uitgevoerd, wordt het alleen toegepast op nieuw geopende tabbladen.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige URL-patronen.";
BackgroundTabFreezingEnabled.pfm_title = "Vastzetten van tabbladen op de achtergrond aanzetten";
BackgroundTabFreezingEnabled.pfm_description = "Bepaalt of Brave inactieve achtergrondtabbladen vastzet om CPU-rekenkracht en geheugen te besparen.\n\nAls het vastzetten van tabbladen op de achtergrond actief is, worden tabbladen die een tijdje inactief zijn geweest op de achtergrond vastgezet door de uitvoering van JavaScript en timertaken te onderbreken. Vastgezette tabbladen blijven in het geheugen geladen en worden onmiddellijk hervat als de gebruiker ze selecteert. Tabbladen met actieve achtergrondtaken, zoals tabbladen die audio of video afspelen, scherm- of camerastreams vastleggen, actieve WebRTC-verbindingen onderhouden of Web Locks bevatten, komen niet in aanmerking voor vastzetten en blijven actief. Sites die zijn ingesteld in het beleid TabDiscardingExceptions of in de uitzonderingen voor het verwijderen van tabbladen van de gebruiker, zijn ook vrijgesteld van vastzetten.\n\nAls je het beleid toepast, wordt automatisch vastzetten van achtergrondtabbladen aangezet voor in aanmerking komende achtergrondtabbladen. Gebruikers kunnen deze instelling niet wijzigen.\n\nAls je het beleid niet toepast, kunnen achtergrondtabbladen niet worden vastgezet. Gebruikers kunnen deze instelling niet wijzigen.\n\nAls je het beleid niet instelt, staat het vastzetten van tabbladen op de achtergrond standaard aan, maar kunnen gebruikers dit aan- of uitzetten in de instellingen van Brave.";
BasicAuthOverHttpEnabled.pfm_title = "Basic-verificatie toestaan voor HTTP";
BasicAuthOverHttpEnabled.pfm_description = "Als je het beleid aanzet of niet instelt, mogen Basic-verificatie-uitdagingen worden ontvangen via niet-beveiligde HTTP.\n\nAls je het beleid uitzet, mogen niet-beveiligde HTTP-verzoeken het Basic-verificatieschema niet gebruiken. Alleen beveiligde HTTPS is toegestaan.\n\nDe instelling voor dit beleid wordt genegeerd (en Basic is altijd verboden) als het beleid AuthSchemes is ingesteld en niet Basic bevat.";
BatterySaverModeAvailability.pfm_title = "Batterijbesparingsmodus aanzetten";
BatterySaverModeAvailability.pfm_description = "0 - De batterijbesparingsmodus wordt uitgezet.\n1 - De batterijbesparingsmodus wordt aangezet als het apparaat op de batterij werkt en het batterijniveau laag is.\n2 - Deze waarde is beëindigd vanaf M121. In M121 en daarna worden waarden behandeld als EnabledBelowThreshold.\nMet dit beleid kun je de instelling Batterijbesparing aan- of uitzetten.\nIn Chrome wordt met deze instelling de framesnelheid beperkt voor een lager stroomverbruik. Als je dit beleid niet instelt, kan de eindgebruiker deze instelling beheren in chrome://settings/performance.\nIn ChromeOS zorgt deze instelling ervoor dat de framesnelheid en CPU-frequentie worden beperkt, achtergrondverlichting wordt gedimd en Android in de modus Batterijbesparing wordt gezet. Op apparaten met meerdere CPU's worden sommige CPU's uitgezet.\nDe verschillende niveaus zijn:\nDisabled (0): De modus Batterijbesparing wordt uitgezet.\nEnabledBelowThreshold (1): De modus Batterijbesparing wordt aangezet als het apparaat op de batterij werkt en het batterijniveau laag is.\nEnabledOnBattery (2): Deze waarde is beëindigd vanaf M121. Vanaf M121 worden waarden behandeld als EnabledBelowThreshold.\n";
BlockExternalExtensions.pfm_title = "Blokkeert de installatie van externe extensies";
BlockExternalExtensions.pfm_description = "Beheert de installatie van externe extensies.\n\nAls je dit beleid toepast, kunnen externe extensies niet worden geïnstalleerd.\n\nAls je dit beleid niet toepast of niet instelt, kunnen externe extensies worden geïnstalleerd.\n\nExterne extensies en de installatie daarvan worden beschreven op https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions.\n\nOpmerking: Dit beleid geldt alleen voor platforms die extensies ondersteunen.";
BlockThirdPartyCookies.pfm_title = "Cookies van derden blokkeren";
BlockThirdPartyCookies.pfm_description = "Als je het beleid toepast, kunnen webpagina-elementen die niet afkomstig zijn van het domein dat in de adresbalk van de browser staat, geen cookies instellen. Als je het beleid niet toepast, kunnen die elementen cookies instellen en kunnen gebruikers deze instelling niet wijzigen.\n\nAls je het beleid niet instelt, zijn cookies van derden toegestaan maar kunnen gebruikers deze instelling wijzigen.\n\nOpmerking: Dit beleid is niet van toepassing in de incognitomodus, waar cookies van derden worden geblokkeerd en alleen op siteniveau kunnen worden toegestaan. Gebruik het beleid CookiesAllowedForUrls om cookies op siteniveau toe te staan.";
BookmarkBarEnabled.pfm_title = "Bookmarkbalk aanzetten";
BookmarkBarEnabled.pfm_description = "Als je het beleid instelt op 'True', wordt er een bookmarkbalk weergegeven in Brave. Als je het beleid instelt op 'False', krijgen gebruikers de bookmarkbalk niet te zien.\n\nAls je het beleid instelt, kunnen gebruikers het niet wijzigen. Als je het beleid niet instelt, kunnen gebruikers bepalen of ze deze functie wel of niet willen gebruiken.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "'Persoon toevoegen' aanzetten in gebruikersbeheer";
BrowserAddPersonEnabled.pfm_description = "Als je dit beleid instelt op waar of niet instelt, staan Brave en Lacros toe dat er een nieuwe persoon wordt toegevoegd via gebruikersbeheer.\n\nAls je dit beleid instelt op onwaar, staan Brave en Lacros niet toe dat er een nieuwe persoon wordt toegevoegd via gebruikersbeheer.";
BrowserGuestModeEnabled.pfm_title = "Gastmodus in browser gebruiken";
BrowserGuestModeEnabled.pfm_description = "Als je dit beleid toepast of niet instelt, zet Brave gastlogins aan. Gastlogins zijn Brave-profielen waarbij alle vensters in de incognitomodus zijn.\n\nAls je dit beleid niet toepast, staat Brave niet toe dat er gastprofielen worden gestart.";
BrowserGuestModeEnforced.pfm_title = "Gastmodus voor browser afdwingen";
BrowserGuestModeEnforced.pfm_description = "Als je dit beleid toepast, dwingt Brave gastsessies af en wordt voorkomen dat gebruikers inloggen bij profielen. Gastlogins zijn Brave-profielen waarbij alle vensters in de incognitomodus zijn.\n\nAls je het beleid niet toepast, niet instelt of de gastmodus voor de browser uitzet (via BrowserGuestModeEnabled), is het gebruik van nieuwe en bestaande profielen toegestaan.";
BrowserLabsEnabled.pfm_title = "Icoon voor experimentele browserfuncties op werkbalk";
BrowserLabsEnabled.pfm_description = "Als je het beleid toepast of niet toepast, hebben gebruikers via een icoon op de werkbalk toegang tot experimentele browserfuncties\n\nAls je het beleid niet toepast, wordt het icoon voor experimentele browserfuncties verwijderd van de werkbalk.\n\nchrome://flags en andere manieren om browserfuncties aan- en uit te zetten werken nog steeds hetzelfde, ongeacht of je het beleid wel of niet hebt toegepast.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Query's naar een Google-tijdservice toestaan";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Als je het beleid toepast of niet instelt, stuurt Brave af en toe query's naar een Google-server om een nauwkeurig tijdstempel op te halen.\n\nAls je het beleid niet toepast, stopt Brave met het sturen van deze query's.";
BrowserSignin.pfm_title = "Instellingen voor inloggen bij browser";
BrowserSignin.pfm_description = "0 - Inloggen bij browser uitzetten\n1 - Inloggen bij browser aanzetten\n2 - Gebruikers dwingen in te loggen om de browser te gebruiken\nDit beleid bepaalt het inloggedrag van de browser. Je kunt instellen of de gebruiker met hun account kan inloggen bij Brave en accountgerelateerde services kan gebruiken, zoals Brave-synchronisatie.\n\nAls het beleid is ingesteld op 'Inloggen bij browser uitzetten', kan de gebruiker niet inloggen bij de browser en geen accountgebaseerde services gebruiken. Functies op browserniveau (zoals Brave-synchronisatie) kunnen in dit geval niet worden gebruikt en zijn niet beschikbaar. Voor iOS geldt dat als de gebruiker was ingelogd en het beleid niet wordt toegepast, de gebruiker meteen wordt uitgelogd. Op andere platforms wordt de gebruiker uitgelogd zodra deze Brave weer gebruikt. Op alle platforms blijven de lokale profielgegevens van de gebruiker (zoals bookmarks en wachtwoorden) behouden en kan de gebruiker deze blijven gebruiken. De gebruiker kan nog steeds inloggen bij en gebruikmaken van Google-webservices zoals Gmail.\n\nAls het beleid is ingesteld op 'Inloggen bij browser aanzetten', mag de gebruiker inloggen bij de browser. Op alle platforms behalve iOS wordt automatisch ingelogd bij de browser als de gebruiker is ingelogd bij Google-webservices zoals Gmail. Als een gebruiker wordt ingelogd bij de browser, betekent dit dat de accountgegevens van de gebruiker worden bewaard door de browser. Het betekent niet dat Brave-synchronisatie standaard wordt toegepast. De gebruiker moet zich afzonderlijk aanmelden voor gebruik van deze functie. Als dit beleid wordt toegepast, kan de gebruiker de instelling die inloggen bij de browser toestaat, niet uitzetten. Gebruik het beleid SyncDisabled om de beschikbaarheid van Brave-synchronisatie te beheren.\n\nAls het beleid is ingesteld op 'Gebruikers dwingen in te loggen om de browser te gebruiken', krijgt de gebruiker een dialoogvenster voor accountselectie en moet deze een account kiezen en inloggen om de browser te gebruiken. Dit zorgt ervoor dat voor beheerde accounts de aan het account gekoppelde beleidsregels worden toegepast en afgedwongen. BrowserGuestModeEnabled wordt standaard niet toegepast. Bestaande, niet-ingelogde profielen worden vergrendeld en zijn niet meer toegankelijk als dit beleid wordt toegepast. Bekijk dit Helpcentrum-artikel voor meer informatie: https://support.google.com/chrome/?p=force_browser_signin. Deze optie wordt niet ondersteund voor Google Chrome OS of Android. Als deze optie toch wordt gebruikt, wordt de reserveoptie 'Inloggen bij browser aanzetten' toegepast.\n\nAls dit beleid niet is ingesteld, kan de gebruiker naar eigen inzicht via de instellingen van Brave bepalen of die de optie voor inloggen bij de browser wil toepassen.";
BrowserSwitcherDelay.pfm_title = "Vertraging voor starten van alternatieve browser (in milliseconden)";
BrowserSwitcherDelay.pfm_description = "Als je het beleid instelt op een getal, toont Brave gedurende dat aantal milliseconden een melding en wordt daarna de alternatieve browser geopend.\n\nAls je dit beleid niet instelt of instelt op 0, wordt de URL onmiddellijk in een alternatieve browser geopend als je naar de URL navigeert.";
BrowserSwitcherEnabled.pfm_title = "Zet de functie Ondersteuning voor oudere browsers aan.";
BrowserSwitcherEnabled.pfm_description = "Als je het beleid toepast, probeert Brave bepaalde URL's te openen in een alternatieve browser, zoals Internet Explorer®. Deze functie is ingesteld volgens de beleidsregels in de groep Legacy Browser support.\n\nAls je dit beleid niet toepast, of niet instelt, probeert Brave geen toegewezen URL's in een alternatieve browser te openen.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "URL van een XML-bestand dat URL's bevat die nooit overschakeling naar een andere browser veroorzaken.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Als je dit beleid instelt op een geldige URL, downloadt Brave de lijst met sites van die URL en worden de regels toegepast alsof ze zijn ingesteld met het BrowserSwitcherUrlGreylist-beleid. Met dit beleid wordt voorkomen dat Brave en de alternatieve browser elkaar openen.\n\nAls je dit beleid niet instelt (of instelt op een ongeldige URL), gebruikt Brave dit beleid niet als een bron van regels die het niet overschakelen naar een andere browser regelen.\n\nOpmerking: Dit beleid verwijst naar een XML-bestand met dezelfde indeling als het beleid SiteList van Internet Explorer®. Hiermee worden regels vanuit een XML-bestand geladen, zonder dat deze regels worden gedeeld met Internet Explorer®. Bekijk meer informatie over het beleid SiteList van Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL van een XML-bestand dat URL's bevat voor laden in een alternatieve browser.";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Als je dit beleid instelt op een geldige URL, downloadt Brave de lijst met sites van die URL en worden de regels toegepast alsof ze zijn ingesteld met het BrowserSwitcherUrlList-beleid.\n\nAls je dit beleid niet instelt (of instelt op een ongeldige URL), gebruikt Brave dit beleid niet als een bron van regels die overschakeling naar een andere browser regelen.\n\nOpmerking: Dit beleid verwijst naar een XML-bestand met dezelfde indeling als het beleid SiteList van Internet Explorer®. Hiermee worden regels vanuit een XML-bestand geladen, zonder dat deze regels worden gedeeld met Internet Explorer®. Bekijk meer informatie over het beleid SiteList van Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Laatste tabblad open houden in Chrome.";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Als je het beleid toepast of niet instelt, houdt Brave minstens één tabblad open nadat er is overgeschakeld naar een alternatieve browser.\n\nAls je het beleid niet toepast, sluit Brave het tabblad nadat er is overgeschakeld naar een alternatieve browser, ook als dit het laatste tabblad was. Hierdoor wordt Brave volledig gesloten.";
BrowserSwitcherParsingMode.pfm_title = "Modus voor sitelijstparsering";
BrowserSwitcherParsingMode.pfm_description = "0 - Standaardgedrag voor LBS.\n1 - Meer compatibel met sitelijsten in de Microsoft IE-/Edge-bedrijfsmodus.\nMet dit beleid bepaal je hoe Google Chrome beleid voor sitelijsten/grijze lijsten interpreteert voor de ondersteuningsfunctie voor oudere browsers. Het is alleen van invloed op het volgende beleid: BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl en BrowserSwitcherExternalGreylistUrl.\n\nAls je dit op Default (0) zet of niet instelt, wordt de URL-overeenkomst minder strikt toegepast. Regels die geen '/' bevatten, zoeken naar een subtekenreeks in de URL-hostnaam. De overeenkomst van de padcomponent van een URL is hoofdlettergevoelig.\n\nAls dit op IESiteListMode (1) is gezet, wordt de URL-overeenkomst strikter toegepast. Regels die geen '/' bevatten komen alleen overeen aan het einde van de hostnaam. Deze moeten zich ook bij de domeinnaamgrens bevinden. De overeenkomst van de padcomponent van een URL is niet hoofdlettergevoelig. Dit werkt beter met Microsoft® Internet Explorer® en Microsoft® Edge®.\n\nEen voorbeeld met de regels 'example.com' en 'acme.com/abc':\n\n'http://example.com/', 'http://subdomain.example.com/' en 'http://acme.com/abc' komen overeen, ongeacht de parseermodus.\n\n'http://notexample.com/', 'http://example.com.invalid.com/' en 'http://example.comabc/' komen alleen overeen in de modus Default.\n\n'http://acme.com/ABC' komt alleen overeen in IESiteListMode.";
BrowserSwitcherUrlGreylist.pfm_title = "Websites die nooit een schakeling tussen browsers veroorzaken.";
BrowserSwitcherUrlGreylist.pfm_description = "Met dit beleid wordt de lijst met websites bepaald die nooit een schakeling tussen browsers veroorzaken. Elk item wordt als regel behandeld. Bij overeenkomende regels wordt er geen alternatieve browser geopend. Anders dan bij het beleid BrowserSwitcherUrlList zijn de regels in beide richtingen van toepassing. Als de add-in van Internet Explorer® aanstaat, bepaalt deze ook of Internet Explorer® deze URL's moet openen in Brave.\n\nAls je het beleid niet instelt, worden er geen websites aan de lijst toegevoegd.\n\nOpmerking: Elementen kunnen ook aan deze lijst worden toegevoegd via het beleid BrowserSwitcherExternalGreylistUrl.";
BrowserSwitcherUrlList.pfm_title = "Websites die worden geopend in de alternatieve browser";
BrowserSwitcherUrlList.pfm_description = "Met dit beleid kun je de lijst met websites instellen die in een alternatieve browser moeten worden geopend. Elk item wordt behandeld als regel waarmee iets in een alternatieve browser wordt geopend. Brave gebruikt deze regels bij de keuze of een URL in een alternatieve browser moet worden geopend. Als de add-in van Internet Explorer® aanstaat, schakelt Internet Explorer® terug naar Brave als de regels niet overeenkomen. Als regels elkaar tegenspreken, gebruikt Brave de meest specifieke regel.\n\nAls je het beleid niet instelt, worden er geen websites aan de lijst toegevoegd.\n\nOpmerking: Elementen kunnen ook aan deze lijst worden toegevoegd via het BrowserSwitcherUseIeSitelist- en BrowserSwitcherExternalSitelistUrl-beleid.";
BrowserThemeColor.pfm_title = "Een kleur instellen voor het thema van de browser";
BrowserThemeColor.pfm_description = "Met dit beleid kunnen beheerders de kleur voor het thema van Brave instellen. Je moet een geldige hexadecimale kleur opgeven in de vorm van een tekenreeks met de indeling #RRGGBB.\n\nAls je dit beleid instelt op een geldige hexadecimale kleur, wordt op basis van deze kleur automatisch een thema samengesteld en toegepast op de browser. Gebruikers kunnen het in het beleid ingestelde thema niet wijzigen.\n\nAls je dit beleid niet instelt, kunnen gebruikers het thema voor de browser naar eigen inzicht instellen.";
BrowsingDataLifetime.pfm_title = "Instellingen voor levensduur van browsegegevens";
BrowsingDataLifetime.pfm_description = "Hiermee configureer je de instellingen voor de levensduur van browsergegevens voor Brave. Met dit beleid kunnen beheerders instellen (per gegevenstype) wanneer gegevens door de browser moeten worden verwijderd. Dit is handig voor klanten die met gevoelige klantgegevens werken.\n\nWaarschuwing: Als je dit beleid instelt, kan dit gevolgen hebben voor lokale persoonsgegevens en kunnen deze definitief worden verwijderd. We raden je aan de instellingen te testen voordat je ze implementeert om te voorkomen dat persoonsgegevens per ongeluk worden verwijderd.\n\nDe beschikbare gegevenstypen zijn 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' en 'hosted_app_data'. 'download_history' en 'hosted_app_data' worden niet ondersteund op Android.\n\nDe browser verwijdert automatisch gegevens van de geselecteerde typen die ouder zijn dan 'time_to_live_in_hours'. De minimumwaarde die kan worden ingesteld is 1 uur.\n\nDe verwijdering van verlopen gegevens vindt plaats 15 seconden nadat de browser is gestart en daarna elke 30 minuten terwijl de browser actief is.\n\nDe gebruiker blijft ingelogd op hun Google-account wanneer cookies worden verwijderd.\n\nTot Chrome 114 moest voor dit beleid het beleid SyncDisabled worden ingesteld op Waar. Vanaf Chrome 115 geldt dat als je dit beleid instelt, synchronisatie voor de betreffende gegevenstypen wordt uitgezet als Chrome Sync niet is uitgezet door het beleid SyncDisabled in te stellen en BrowserSignin niet is uitgezet.\nGa naar https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime voor meer informatie over schema en indeling.";
BuiltInAIAPIsEnabled.pfm_title = "Toestaan dat pagina's de ingebouwde AI-API's gebruiken";
BuiltInAIAPIsEnabled.pfm_description = "Dit beleid bepaalt of een pagina de ingebouwde AI-API's (zoals LanguageModel API, Summarization API, Writer API en Rewriter API) kan gebruiken.\n\nAls het beleid is toegepast of niet is ingesteld, kunnen de API's worden gebruikt.\n\nAls je het beleid niet toepast, krijg je een fout als je de API's probeert te gebruiken.";
BuiltInDnsClientEnabled.pfm_title = "Ingebouwde DNS-client gebruiken";
BuiltInDnsClientEnabled.pfm_description = "Dit beleid beheert welke softwarestack wordt gebruikt voor communicatie met de DNS-server: de DNS-client van het besturingssysteem of de ingebouwde DNS-client van Brave. Dit beleid heeft geen invloed op welke DNS-servers worden gebruikt. Als het besturingssysteem bijvoorbeeld is ingesteld voor gebruik van een zakelijke DNS-server, wordt diezelfde server gebruikt door de ingebouwde DNS-client. Ook wordt met dit beleid niet beheerd of DNS-over-HTTPS wordt gebruikt. Brave gebruikt altijd de ingebouwde resolver voor DNS-over-HTTPS-verzoeken. Zie het DnsOverHttpsMode-beleid voor informatie over het beheer van DNS-over-HTTPS.\n\nAls je dit beleid toepast of niet instelt, wordt de ingebouwde DNS-client gebruikt.\n\nAls je dit beleid niet toepast, wordt de ingebouwde DNS-client alleen gebruikt als DNS-over-HTTPS wordt gebruikt.";
CACertificateManagementAllowed.pfm_title = "Gebruikers toestaan geïnstalleerde CA-certificaten te beheren.";
CACertificateManagementAllowed.pfm_description = "0 - Gebruikers toestaan alle certificaten te beheren\n1 - Gebruikers toestaan gebruikerscertificaten te beheren\n2 - Gebruikers niet toestaan certificaten te beheren\nAls je het beleid instelt op All (0) of niet instelt, kunnen gebruikers vertrouwensinstellingen bewerken voor alle CA-certificaten, door de gebruiker geïmporteerde certificaten verwijderen en certificaten importeren met Certificaatbeheer. Als je het beleid instelt op UserOnly (1), kunnen gebruikers alleen door de gebruiker geïmporteerde certificaten beheren, maar niet de vertrouwensinstellingen van ingebouwde certificaten wijzigen. Als je het beleid instelt op None (2), kunnen gebruikers CA-certificaten bekijken (maar niet beheren).";
CACertificates.pfm_title = "TLS-certificaten die Brave moet vertrouwen voor serververificatie";
CACertificates.pfm_description = "Een lijst met TLS-certificaten die Brave moet vertrouwen voor serververificatie.\nCertificaten moeten base64-gecodeerd zijn.";
CACertificatesWithConstraints.pfm_title = "TLS-certificaten die moeten worden vertrouwd door Brave voor serververificatie met beperkingen";
CACertificatesWithConstraints.pfm_description = "Een lijst met TLS-certificaten die Brave moet vertrouwen voor serververificatie, met beperkingen die buiten het certificaat worden toegevoegd. Als er geen beperking van een bepaald type aanwezig is, is elke naam van dat type toegestaan.\nCertificaten moeten base64-gecodeerd zijn. Er moet minstens één beperking worden gespecificeerd voor elk certificaat.\nGa naar https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints voor meer informatie over schema en indeling.";
CADistrustedCertificates.pfm_title = "TLS-certificaten die niet moeten worden vertrouwd door Brave voor serververificatie";
CADistrustedCertificates.pfm_description = "Een lijst met openbare sleutels voor certificaten die niet moeten worden vertrouwd door Brave voor verificatie van de TLS-server.\n\nDe beleidswaarde is een lijst met base64-gecodeerde X.509-certificaten. Elk certificaat met een overeenkomende SPKI (SubjectPublicKeyInfo) wordt niet vertrouwd.";
CAHintCertificates.pfm_title = "TLS-certificaten die niet worden vertrouwd, maar kunnen worden gebruikt om paden voor serververificatie te maken";
CAHintCertificates.pfm_description = "Een lijst met certificaten die niet worden vertrouwd in Brave, maar kunnen worden gebruikt als hints om paden te maken. Certificaten moeten base64-gecodeerd zijn.";
CAPlatformIntegrationEnabled.pfm_title = "Door de gebruiker toegevoegde TLS-certificaten van truststores van het platform gebruiken voor serververificatie";
CAPlatformIntegrationEnabled.pfm_description = "Als je dit toepast (of niet instelt), worden door gebruikers toegevoegde TLS-certificaten uit truststores van het platform gebruikt om paden voor TLS-serververificatie te maken.\n\nAls je dit beleid niet toepast, worden door de gebruiker toegevoegde TLS-certificaten uit truststores van het platform niet gebruikt om paden voor TLS-serververificatie te maken.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "Ondersteuning voor CORS-verzoekheaders zonder jokertekens";
CORSNonWildcardRequestHeadersSupport.pfm_description = "Hiermee stel je ondersteuning voor CORS-verzoekheaders zonder jokertekens in.\n\nIn versie 97 van Brave wordt ondersteuning voor CORS-verzoekheaders zonder jokertekens geïntroduceerd. Als scripts een cross-origin-netwerkverzoek via fetch() en XMLHttpRequest doen met een door het script toegevoegde Authorization-header, moet de header expliciet worden toegestaan door de Access-Control-Allow-Headers-header in de CORS-pre-flightreactie. Expliciet houdt hier in dat het jokertekensymbool * de Authorization-header niet dekt. Zie https://chromestatus.com/feature/5742041264816128 voor meer informatie.\n\nAls je dit beleid niet instelt of instelt op True, ondersteunt Brave de CORS-verzoekheaders zonder jokertekens en gedraagt het product zich zoals hierboven beschreven.\n\nAls je dit beleid instelt op False, staat Chrome het jokertekensymbool (*) toe in de Access-Control-Allow-Headers-header in de CORS-pre-flightreactie om de Authorization-header te dekken.\n\nDit zakelijke beleid is tijdelijk. Het is de bedoeling het in de toekomst te verwijderen.";
CacheEncryptionEnabled.pfm_title = "Met dit beleid kunnen beheerders het HTTP-cachegeheugen op de schijf versleutelen.";
CacheEncryptionEnabled.pfm_description = "Met dit beleid kunnen beheerders het HTTP-browsercachegeheugen op de schijf versleutelen.\n\nAls je dit beleid toepast, wordt het browsercachegeheugen versleuteld.\n\nAls je dit beleid niet toepast of niet instelt, wordt het browsercachegeheugen niet versleuteld.\n\nVersleuteling van het browsercachegeheugen kan invloed hebben op de prestaties.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "Handhaving van Certificaattransparantie voor een lijst met subjectPublicKeyInfo-hashes";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "Als je dit beleid instelt, wordt de handhaving van vereisten voor openbaarmaking via Certificaattransparantie uitgezet voor een lijst van subjectPublicKeyInfo-hashes. Enterprise-hosts kunnen certificaten blijven gebruiken die anders niet zouden worden vertrouwd (omdat deze niet op de juiste manier openbaar zijn gemaakt). Als je de handhaving wilt uitzetten, moet de hash aan een van de volgende voorwaarden voldoen:\n\n* De hash maakt deel uit van een subjectPublicKeyInfo van het servercertificaat.\n\n* De hash maakt deel uit van een subjectPublicKeyInfo die voorkomt in een CA-certificaat in de certificaatketen. Dat CA-certificaat is beperkt via de extensie X.509v3 nameConstraints, er zijn een of meer directoryName nameConstraints aanwezig in permittedSubtrees en de directoryName bevat een organizationName-kenmerk.\n\n* De hash maakt deel uit van een subjectPublicKeyInfo die voorkomt in een CA-certificaat in de certificaatketen, het CA-certificaat heeft een of meer organizationName-kenmerken in het certificaatonderwerp en het servercertificaat bevat hetzelfde aantal organizationName-kenmerken, in dezelfde volgorde en met waarden die byte voor byte identiek zijn.\n\nGeef een subjectPublicKeyInfo-hash op door de naam van het hash-algoritme, een slash en de Base64-codering van het betreffende toegepaste hash-algoritme te koppelen aan de subjectPublicKeyInfo met DER-codering van het opgegeven certificaat. Een indeling met Base64-codering komt overeen met die van een SPKI-vingerafdruk. Het enige herkende hash-algoritme is sha256. Andere algoritmen worden genegeerd.\n\nAls je het beleid niet instelt, betekent dit dat als certificaten die openbaar moeten worden gemaakt via Certificaattransparantie niet openbaar worden gemaakt, de betreffende certificaten niet door Brave worden vertrouwd.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "Handhaving van Certificaattransparantie voor een lijst met URL's uitzetten";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "Als je het beleid instelt, wordt de handhaving van vereisten voor openbaarmaking via Certificaattransparantie uitgezet voor de hostnamen in de opgegeven URL's. Hoewel het moeilijker wordt om misbruik van certificaten vast te stellen, kunnen hosts certificaten blijven gebruiken die anders niet zouden worden vertrouwd (omdat deze niet op de juiste manier openbaar zijn gemaakt).\n\nAls je het beleid niet instelt, betekent dit dat als certificaten die openbaar moeten worden gemaakt via Certificaattransparantie niet openbaar worden gemaakt, de betreffende certificaten niet door Brave worden vertrouwd.\n\nVoor een URL-patroon wordt deze indeling gehanteerd (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Aangezien de certificaten geldig zijn voor een bepaalde hostnaam (los van het schema, de poort of het pad), houdt Brave alleen rekening met het hostnaamgedeelte van de URL. Hosts met jokertekens worden niet ondersteund.";
ChromeForTestingAllowed.pfm_title = "Chrome for Testing toestaan";
ChromeForTestingAllowed.pfm_description = "Bepaalt of gebruikers Chrome for Testing mogen gebruiken.\n\nAls je dit beleid toepast of niet instelt, kunnen gebruikers Chrome for Testing installeren en uitvoeren.\n\nAls je dit beleid niet toepast, kunnen gebruikers Chrome for Testing niet uitvoeren. Gebruikers kunnen Chrome for Testing nog steeds installeren, maar de functie wordt niet uitgevoerd met de profielen waarvoor dit beleid niet wordt toegepast.";
ChromeSuggestionsSettings.pfm_title = "Instellingen voor Chrome-suggesties";
ChromeSuggestionsSettings.pfm_description = "Met deze instelling kan Chrome op relevante momenten AI-mogelijkheden voorstellen.\n\n0/niet ingesteld = Chrome-suggesties worden aangezet voor gebruikers.\n\n1 = Chrome-suggesties staan uit voor gebruikers.\n\nGa voor meer informatie naar het Helpcentrum-artikel: https://support.google.com/chrome/a?p=chrome_suggestions";
ChromeVariations.pfm_title = "De beschikbaarheid van varianten bepalen";
ChromeVariations.pfm_description = "0 - Alle varianten aanzetten\n1 - Varianten alleen aanzetten voor essentiële oplossingen\n2 - Alle varianten uitzetten\nAls je dit beleid instelt, kun je opgeven welke varianten mogen worden toegepast in Brave.\n\nVarianten vormen een manier om aanpassingen in Brave aan te bieden zonder een nieuwe versie van de browser te publiceren. Hiervoor worden al bestaande functies selectief aan- of uitgezet. Ga voor meer informatie naar https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework.\n\nAls je VariationsEnabled (waarde 0) instelt of het beleid niet instelt, mogen alle varianten worden toegepast op de browser.\n\nAls je CriticalFixesOnly (waarde 1) instelt, mogen alleen varianten die worden beschouwd als essentiële beveiligings- of stabiliteitsoplossingen, worden toegepast op Brave.\n\nAls je VariationsDisabled (waarde 2) instelt, mag geen van de varianten worden toegepast op de browser. Deze modus kan er potentieel voor zorgen dat Brave-ontwikkelaars essentiële beveiligingsoplossingen niet tijdig kunnen leveren en wordt dus niet aanbevolen.";
ClearBrowsingDataOnExitList.pfm_title = "Browsegegevens wissen bij afsluiten";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - Browsegeschiedenis\ndownload_history - Downloadgeschiedenis\ncookies_and_other_site_data - Cookies en andere sitegegevens\ncached_images_and_files - Gecachete afbeeldingen en bestanden\npassword_signin - Inloggen met wachtwoord\nautofill - Automatisch invullen\nsite_settings - Site-instellingen\nhosted_app_data - Gegevens van gehoste apps\nHiermee stel je een lijst met typen browsergegevens in die moeten worden verwijderd als de gebruiker alle browservensters sluit.\n\nWaarschuwing: Als je dit beleid instelt, kan dit gevolgen hebben voor lokale persoonsgegevens en kunnen deze definitief worden verwijderd. We raden je aan de instellingen te testen voordat je ze implementeert om te voorkomen dat persoonsgegevens per ongeluk worden verwijderd.\n\nDe beschikbare gegevenstypen zijn browsegeschiedenis (browsing_history), downloadgeschiedenis (download_history), cookies (cookies_and_other_site_data), cachegeheugen ((cached_images_and_files)), automatisch invullen (autofill), wachtwoorden (password_signin), site-instellingen (site_settings) en gegevens van gehoste apps (hosted_app_data). Dit beleid krijgt geen voorrang op AllowDeletingBrowserHistory.\n\nDe gebruiker blijft ingelogd op hun Google-account wanneer cookies worden verwijderd.\n\nTot Chrome 114 moest voor dit beleid het beleid SyncDisabled worden ingesteld op Waar. Vanaf Chrome 115 geldt dat als je dit beleid instelt, synchronisatie voor de betreffende gegevenstypen wordt uitgezet als Chrome Sync niet is uitgezet door het beleid SyncDisabled in te stellen en BrowserSignin niet is uitgezet.\n\nAls de gegevensverwijdering om een of andere reden is gestart maar niet is afgerond, worden de browsegegevens gewist als het profiel weer wordt geladen.\n\nAls Brave niet correct wordt afgesloten (bijvoorbeeld als de browser of het OS crasht), worden de browsegegevens niet gewist, omdat het sluiten van de browser niet het gevolg was van het sluiten van alle browservensters door de gebruiker.";
ClipboardAllowedForUrls.pfm_title = "Klembord toestaan op deze sites";
ClipboardAllowedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen voor sites die het klembord kunnen gebruiken. Dit omvat niet alle klembordbewerkingen op oorsprongen die overeenkomen met de patronen. Gebruikers kunnen bijvoorbeeld nog steeds plakken met sneltoetsen, omdat dit niet wordt beperkt door de klembordrechten voor sites.\n\n\nAls je het beleid niet instelt, is DefaultClipboardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
ClipboardBlockedForUrls.pfm_title = "Het klembord blokkeren op deze sites";
ClipboardBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen voor sites die het klembord niet kunnen gebruiken. Dit omvat niet alle klembordbewerkingen op oorsprongen die overeenkomen met de patronen. Gebruikers kunnen bijvoorbeeld nog steeds plakken met sneltoetsen, omdat dit niet wordt beperkt door de klembordrechten voor sites.\n\nAls je het beleid niet instelt, is DefaultClipboardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
CloudManagementEnrollmentMandatory.pfm_title = "Inschrijving voor cloudbeheer verplichten";
CloudManagementEnrollmentMandatory.pfm_description = "Als je dit beleid toepast, wordt Chrome Enterprise Core-browserinschrijving verplicht en wordt het startproces van Brave geblokkeerd als dit mislukt.\n\nAls je het beleid niet toepast of niet instelt, wordt Chrome Enterprise Core-browserinschrijving optioneel en wordt het startproces van Brave niet geblokkeerd als het mislukt.\n\nDit beleid wordt gebruikt bij inschrijving van het cloudbeleid op apparaatniveau voor desktops. Zie https://support.google.com/chrome/a/answer/9301891 voor meer informatie.";
CloudManagementEnrollmentToken.pfm_title = "De inschrijvingstoken voor het cloudbeleid";
CloudManagementEnrollmentToken.pfm_description = "Als je het beleid toepast, probeert Brave zichzelf te registreren bij Chrome Enterprise Core-browserbeheer. De waarde van dit beleid is een token voor inschrijving die je kunt ophalen uit de Google Admin console.\n\nZie https://support.google.com/chrome/a/answer/9301891 voor meer informatie.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "Brave-cloudbeleid krijgt voorrang op het platformbeleid.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Als je het beleid toepast, krijgt het cloudbeleid voorrang bij een conflict met het platformbeleid.\n\nAls je het beleid niet toepast of niet instelt, krijgt het platformbeleid voorrang bij een conflict met het cloudbeleid.\n\nDit verplichte beleid heeft gevolgen voor cloudbeleid op apparaatniveau.\n\nDit beleid is specifiek voor Brave en heeft geen invloed op Google Update, omdat dit onafhankelijke apps zijn.\nGoogle Update heeft een afzonderlijk beleid met dezelfde naam.";
CloudUserPolicyMerge.pfm_title = "Hiermee kun je aanzetten dat cloudbeleidsregels voor gebruikers worden samengevoegd in beleidsregels op machineniveau";
CloudUserPolicyMerge.pfm_description = "Als je dit beleid toepast, kunnen beleidsregels die zijn gekoppeld aan een beheerd account worden samengevoegd in beleidsregels op apparaatniveau.\n\nAls je het beleid niet toepast of niet instelt, kunnen cloudbeleidsregels op gebruikersniveau niet worden samengevoegd met beleidsregels van andere bronnen.\n\nAlleen beleidsregels die afkomstig zijn van beveiligde gebruikers kunnen voorrang krijgen. Een beveiligde gebruiker is aangesloten bij de organisatie die de browser van de gebruiker beheert via Chrome Enterprise Core. Alle andere beleidsregels op gebruikersniveau hebben een standaardvoorrang.\n\nBeleidsregels die moeten worden samengevoegd, moeten ook worden ingesteld in PolicyListMultipleSourceMergeList of PolicyDictionaryMultipleSourceMergeList. Dit beleid wordt genegeerd als geen van de twee eerder genoemde beleidsregels is ingesteld.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Toestaan dat cloudbeleidsregels voor gebruikers Chrome Browser Cloud Management-beleidsregels overschrijven.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Als je het beleid toepast, krijgen beleidsregels die zijn gekoppeld aan een beheerd account voorrang als er een conflict is met Chrome Enterprise Core-browserbeleidsregels.\n\nAls je het beleid niet toepast of niet instelt, krijgen cloudbeleidsregels op gebruikersniveau een standaardprioriteit.\n\nAlleen beleidsregels die afkomstig zijn van beveiligde gebruikers kunnen voorrang krijgen. Een beveiligde gebruiker is aangesloten bij de organisatie die de browser van de gebruiker beheert via Chrome Enterprise Core. Alle andere beleidsregels op gebruikersniveau hebben een standaardvoorrang.\n\nHet beleid kan worden gecombineerd met CloudPolicyOverridesPlatformPolicy. Als beide beleidsregels worden toegepast, krijgen cloudbeleidsregels voor gebruikers ook voorrang als er een conflict is met platformbeleid.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Beveiligingswaarschuwingen voor opdrachtregelmarkeringen aanzetten";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Als je dit beleid toepast of niet instelt, worden er beveiligingswaarschuwingen getoond als Chrome wordt gestart met bepaalde mogelijk schadelijke opdrachtregelmarkeringen.\n\nAls je dit beleid niet toepast, worden er geen beveiligingswaarschuwingen getoond als Chrome wordt gestart met bepaalde mogelijk schadelijke opdrachtregelmarkeringen.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
ComponentUpdatesEnabled.pfm_title = "Componentupdates in Brave aanzetten";
ComponentUpdatesEnabled.pfm_description = "Hiermee zet je componentupdates voor alle componenten in Brave aan als het beleid wordt toegepast of niet is ingesteld.\n\nAls je het beleid niet toepast, staan updates voor componenten uit. Bepaalde componenten zijn wel uitgesloten van dit beleid. Updates voor componenten worden niet uitgezet als deze geen uitvoerbare code bevatten en essentieel zijn voor de beveiliging van de browser.\nVoorbeelden van dergelijke componenten zijn Certificate Revocation Lists en subresource-filters.";
CompressionDictionaryTransportEnabled.pfm_title = "Support voor compressiefunctie voor woordenboekoverdracht aanzetten";
CompressionDictionaryTransportEnabled.pfm_description = "Met deze functie kun je woordenboekspecifieke contentcoderingen gebruiken in de Accept-Encoding-verzoekheader ('sbr' en 'zst-d') als er woordenboeken beschikbaar zijn voor gebruik.\n\nAls je het beleid toepast of niet instelt, accepteert Brave webcontent via de compressiefunctie voor woordenboekoverdracht.\nAls je het beleid niet toepast, wordt de compressiefunctie voor woordenboekenoverdracht uitgezet.";
CookiesAllowedForUrls.pfm_title = "Cookies toestaan op deze sites";
CookiesAllowedForUrls.pfm_description = "Hiermee kun je een lijst met URL-patronen aangeven van sites die cookies mogen instellen.\n\nURL-patronen kunnen één URL zijn die aangeeft dat de site cookies mag gebruiken op alle sites op het hoogste niveau.\n\nPatronen kunnen ook bestaan uit twee URL's die worden gescheiden door een komma. De eerste geeft de site aan die cookies mag gebruiken. De tweede geeft de site op het hoogste niveau aan waarop de eerste waarde moet worden toegepast.\n\nAls je twee URL's gebruikt, ondersteunt de eerste waarde in het paar * maar de tweede waarde niet. Als je * voor de eerste waarde gebruikt, geef je aan dat alle sites cookies kunnen gebruiken als de tweede URL de site op het hoogste niveau is.\n\nAls je dit beleid niet instelt, wordt de algemene standaardwaarde gebruikt voor alle sites op basis van het beleid DefaultCookiesSetting of BlockThirdPartyCookies als dit is ingesteld. Als dit niet het geval is, wordt de persoonlijke configuratie van de gebruiker gebruikt.\n\nBekijk ook het beleid CookiesBlockedForUrls en CookiesSessionOnlyForUrls. Houd er rekening mee dat er geen conflicterende URL-patronen tussen deze drie beleidsregels mogen bestaan. Er is niet aangeven welk beleid voorrang krijgt.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen. * is geen geaccepteerde waarde voor dit beleid.";
CookiesBlockedForUrls.pfm_title = "Cookies blokkeren op deze sites";
CookiesBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen aangeven van sites die geen cookies mogen instellen.\n\nAls je het beleid niet instelt, wordt DefaultCookiesSetting gebruikt voor alle sites als dit is ingesteld. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nZie CookiesAllowedForUrls en CookiesSessionOnlyForUrls als geen enkel specifiek beleid voorrang krijgt. De URL-patronen die in deze drie beleidsregels worden vermeld, mogen niet met elkaar conflicteren.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
CookiesSessionOnlyForUrls.pfm_title = "Cookies van overeenkomende URL's beperken tot de huidige sessie";
CookiesSessionOnlyForUrls.pfm_description = "Als je CookiesSessionOnlyForUrls instelt, kun je een lijst met URL-patronen aangeven van sites die geen cookies kunnen instellen voor één sessie, tenzij het beleid RestoreOnStartup is ingesteld op het permanent herstellen van URL's uit vorige sessies.\n\nAls je het beleid niet instelt, wordt DefaultCookiesSetting gebruikt voor alle sites als dit is ingesteld. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker. Voor URL's die niet overeenkomen met de aangegeven patronen worden de standaardwaarden gebruikt.\n\nZie CookiesBlockedForUrls en CookiesAllowedForUrls als geen specifiek beleid voorrang krijgt. De URL-patronen die in deze drie beleidsregels worden vermeld, mogen niet met elkaar conflicteren.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
CpuPerformanceTierOverride.pfm_title = "Overschrijven voor het CPU-prestatieniveau";
CpuPerformanceTierOverride.pfm_description = "Als je dit beleid instelt, kunnen bedrijven de waarde overschrijven die wordt geretourneerd door de CPU Performance API (bijv.\nnavigator.cpuPerformance,\nga naar https://github.com/WICG/cpu-performance voor meer informatie).\n\nAls je dit beleid instelt, wordt de waarde van navigator.cpuPerformance overschreven door de ingevoerde waarde. Als je het beleid niet instelt, wordt de standaardberekening van prestatieniveaus gebruikt.\n\nDe mogelijke waarden voor dit beleid zijn 0 tot 4.";
CreatePasskeysInICloudKeychain.pfm_title = "Bepalen of het maken van toegangssleutels standaard wordt ingesteld op iCloud Sleutelhanger.";
CreatePasskeysInICloudKeychain.pfm_description = "Brave kan verzoeken voor het maken van toegangssleutels/WebAuthn rechtstreeks naar iCloud Sleutelhanger op macOS 13.5 of hoger sturen. Als iCloud Sleutelhanger-synchronisatie nog niet is aangezet, wordt de gebruiker gevraagd om in te loggen bij iCloud of iCloud Sleutelhanger-synchronisatie aan te zetten.\n\nAls je dit beleid instelt op False, wordt iCloud Sleutelhanger niet standaard gebruikt en kan het eerdere gedrag (inloggegevens maken in het Brave-profiel) worden gebruikt. Gebruikers kunnen iCloud Sleutelhanger nog steeds als optie selecteren en kunnen de inloggegevens van iCloud Sleutelhanger nog steeds zien als ze inloggen.\n\nAls je dit beleid instelt op True, is iCloud Sleutelhanger de standaardinstelling als het WebAuthn-verzoek compatibel is met die keuze.\n\nAls je dit beleid niet instelt, is de standaard afhankelijk van factoren zoals of iCloud Drive aanstaat en of de gebruiker recent inloggegevens heeft gebruikt of gemaakt in hun Brave-profiel.";
CreateThemesSettings.pfm_title = "Instellingen voor Thema's maken met AI";
CreateThemesSettings.pfm_description = "0 - Sta Thema's maken toe en verbeter AI-modellen.\n1 - Sta Thema's maken toe zonder AI-modellen te verbeteren.\n2 - Sta Thema's maken niet toe.\nMet de functie Thema's maken met AI kunnen gebruikers aangepaste thema's of achtergronden maken door ze vooraf te selecteren in een lijst met opties.\n\n0 = Hiermee wordt toegestaan dat de functie wordt gebruikt en dat Google relevante gegevens gebruikt om de AI-modellen te verbeteren. Relevante gegevens kunnen prompts, invoer, uitvoer, bronmateriaal en geschreven feedback zijn, afhankelijk van de functie. De gegevens kunnen ook door mensen worden beoordeeld om AI-modellen te verbeteren. 0 is de standaardwaarde, behalve zoals hieronder aangegeven.\n\n1 = Hiermee wordt toegestaan dat de functie wordt gebruikt, maar wordt niet toegestaan dat Google modellen verbetert met content van gebruikers (waaronder prompts, invoer, uitvoer, bronmateriaal en geschreven feedback). 1 is de standaardwaarde voor zakelijke gebruikers die worden beheerd via Google Admin console en voor onderwijsaccounts die worden beheerd via Google Workspace.\n\n2 = Hiermee wordt de functie niet toegestaan.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
DNSInterceptionChecksEnabled.pfm_title = "Controles voor DNS-onderschepping aangezet";
DNSInterceptionChecksEnabled.pfm_description = "Met dit beleid wordt een lokale schakelaar ingesteld die kan worden gebruikt om controles voor DNS-onderschepping uit te zetten. Deze controles proberen te achterhalen of er een proxy achter de browser zit die als omleiding naar onbekende hostnamen dient.\n\nIn een bedrijfsomgeving waar de netwerkconfiguratie bekend is, is het misschien niet nodig om dit te controleren, omdat er bij het opstarten en bij elke wijziging van de DNS-configuratie een beperkte hoeveelheid DNS- en HTTP-verkeer wordt gegenereerd.\n\nAls dit beleid niet is ingesteld of als het is toegepast, worden de controles voor DNS-onderschepping uitgevoerd. Als het beleid expliciet niet is toegepast, is dit niet het geval.";
DataURLWhitespacePreservationEnabled.pfm_title = "Witruimte in DataURL behouden voor alle mediatypen";
DataURLWhitespacePreservationEnabled.pfm_description = "Dit beleid biedt een tijdelijke afmelding voor wijzigingen in de manier waarop Chrome witruimte behandelt in data-URL's.\nVoorheen werd witruimte alleen behouden als het mediatype op het hoogste niveau text was of de tekenreeks xml voor mediatype bevatte.\nNu blijft witruimte behouden in alle gegevens-URL's, ongeacht het mediatype.\n\nAls je dit beleid niet instelt of instelt op Waar, wordt het nieuwe gedrag toegepast.\n\nAls je dit beleid instelt op Onwaar, wordt het oude gedrag toegepast.";
DataUrlInSvgUseEnabled.pfm_title = "Ondersteuning voor gegevens-URL's voor SVGUseElement.";
DataUrlInSvgUseEnabled.pfm_description = "Met dit beleid wordt ondersteuning voor gegevens-URL's voor SVGUseElement aangezet. Dit wordt standaard uitgezet vanaf M119.\nAls je dit beleid toepast, blijven gegevens-URL's werken in SVGUseElement.\nAls je dit beleid niet toepast of niet instelt, werken gegevens-URL's niet in SVGUseElement.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Ondoorzichtige oorsprongen voor gegevens-URL's in Web Workers aanzetten";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Hiermee wordt bepaald of Web Workers die zijn gemaakt op basis van gegevens-URL's een unieke ondoorzichtige oorsprong krijgen toegewezen.\n\nWeb Workers kunnen worden gemaakt met een gegevens-URL die het script van de worker bevat. Eerder namen deze workers de oorsprong over van de pagina die ze had gemaakt, waardoor ze toegang hadden tot dezelfde lokale opslag, cookies en andere aan de oorsprong gebonden gegevens. Chrome verandert het standaardgedrag in mijlpaal 149 om de beveiliging te verbeteren en af te stemmen op de HTML-specificatie. Workers die zijn gemaakt op basis van gegevens-URL's hebben nu een unieke, ondoorzichtige oorsprong. Zo worden ze geïsoleerd van de gegevens van de makerpagina.\n\nAls je dit beleid toepast of niet instelt, wordt het nieuwe standaardgedrag (beter beveiligd) gebruikt en hebben Web Workers die zijn gemaakt op basis van gegevens-URL's een unieke ondoorzichtige oorsprong.\n\nAls je dit beleid niet toepast, keert Chrome terug naar het oude gedrag en nemen Web Workers die zijn gemaakt op basis van gegevens-URL's de oorsprong van hun maker over. Zo kunnen beheerders compatibiliteitsproblemen tijdelijk oplossen als interne apps niet meer werken door de beveiligingswijziging.\n\nDit beleid is tijdelijk en wordt verwijderd in mijlpaal 157.";
DefaultAutomaticDownloadsSetting.pfm_title = "Standaardinstelling voor automatische downloads";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Sites toestaan automatisch meerdere bestanden te downloaden\n2 - Sites niet toestaan automatisch meerdere bestanden te downloaden\n3 - Vragen als een site automatisch meerdere bestanden wil downloaden\nAls je het beleid instelt op 1, kunnen websites automatisch meerdere bestanden downloaden. Als je het beleid instelt op 2, wordt dit recht geweigerd. Je kunt het beleid zo instellen dat om goedkeuring wordt gevraagd als een website automatisch meerdere bestanden wil downloaden.\n\nAls je het beleid niet instelt, is het beleid AskAutomaticDownloads van toepassing maar kunnen gebruikers deze instelling wijzigen.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Brave instellen als standaardbrowser";
DefaultBrowserSettingEnabled.pfm_description = "Als je het beleid instelt op True, checkt Brave altijd of het de standaardbrowser is bij het opstarten en, indien mogelijk, registreert het zichzelf automatisch. Als je het beleid instelt op False, checkt Brave niet of het de standaardbrowser is en worden de gebruikersmogelijkheden voor deze optie uitgezet.\n\nAls je het beleid niet instelt, geeft Brave gebruikers de controle over of het de standaardbrowser is en als dit niet zo is, of er gebruikersmeldingen moeten worden weergegeven.\n\nOpmerking: Als Microsoft®Windows®-beheerders deze instelling aanzetten, werkt dit alleen op systemen met Windows 7. Voor latere versies moet je een bestand voor standaard app-koppelingen implementeren, waarmee Brave de verwerker wordt voor het https- en http-protocol (en eventueel het ftp-protocol en andere bestandsindelingen). Raadpleeg de Help-pagina van Chrome voor meer informatie (https://support.google.com/chrome?p=make_chrome_default_win).";
DefaultClipboardSetting.pfm_title = "Standaard klembordinstelling";
DefaultClipboardSetting.pfm_description = "2 - Geen enkele site toestaan het klembordrecht voor sites te gebruiken\n3 - Sites toestaan de gebruiker te vragen om toegang tot het klembord te geven\nAls je het beleid instelt op 2, kunnen sites het klembord niet gebruiken. Als je het beleid instelt op 3 of niet instelt, kan de gebruiker de instelling wijzigen en bepalen of de klembord-API's beschikbaar zijn als een site er een wil gebruiken.\n\nDit beleid kan met de beleidsregels ClipboardAllowedForUrls en ClipboardBlockedForUrls worden overschreven voor specifieke URL-patronen.\n\nDit beleid is alleen van toepassing op klembordbewerkingen die worden beheerd door het klembordrecht voor sites, niet op opgeschoonde klembordschrijfbewerkingen of vertrouwde kopieer-en-plakbewerkingen.";
DefaultCookiesSetting.pfm_title = "Standaardinstelling voor cookies";
DefaultCookiesSetting.pfm_description = "1 - Alle sites toestaan lokale gegevens in te stellen\n2 - Niet toestaan dat sites lokaal gegevens instellen\n4 - Cookies bewaren voor de duur van de sessie\nAls je CookiesSessionOnlyForUrls instelt, kun je een lijst met URL-patronen opgeven van sites die geen cookies kunnen instellen voor 1 sessie, tenzij het beleid RestoreOnStartup is ingesteld op het permanent herstellen van URL's uit vorige sessies.\n\nAls je het beleid niet instelt, wordt DefaultCookiesSetting gebruikt voor alle sites als dit is ingesteld. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker. Voor URL's die niet overeenkomen met de opgegeven patronen worden de standaardwaarden gebruikt.\n\nZie CookiesBlockedForUrls en CookiesAllowedForUrls als geen specifiek beleid voorrang krijgt. De URL-patronen die in deze 3 beleidsregels worden vermeld, mogen niet met elkaar conflicteren.";
DefaultDownloadDirectory.pfm_title = "Standaardmap voor downloads instellen";
DefaultDownloadDirectory.pfm_description = "Als je het beleid instelt, wordt de standaardmap gewijzigd waarnaar Chrome bestanden downloadt maar kunnen gebruikers deze map wijzigen.\n\nAls je het beleid niet instelt, gebruikt Chrome de platformspecifieke standaardmap.\n\nDit beleid heeft geen effect als het beleid DownloadDirectory is ingesteld.\n\nOpmerking: Bekijk een lijst met variabelen die je kunt gebruiken (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DefaultFileSystemReadGuardSetting.pfm_title = "Gebruik van de File System API voor lezen beheren";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - Geen sites toestemming geven om leestoegang tot bestanden of directory's te vragen via de File System API\n3 - Sites toestaan om gebruikers schrijftoegang te vragen tot bestanden en directory's via de File System API\nAls je het beleid instelt op 3, kunnen websites leestoegang vragen tot bestanden en directory's in het bestandssysteem van het besturingssysteem van de host via de File System API. Als je het beleid instelt op 2, wordt toegang geblokkeerd.\n\nAls je het beleid niet instelt, vragen websites om toegang maar kunnen gebruikers deze instelling wijzigen.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Gebruik van de File System API voor schrijven beheren";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - Geen sites toestemming geven om schrijftoegang tot bestanden en directory's te vragen\n3 - Sites toestaan om gebruikers schrijftoegang te vragen tot bestanden en directory's\nAls je het beleid instelt op 3, kunnen websites schrijftoegang vragen tot bestanden en directory's in het bestandssysteem van het besturingssysteem van de host. Als je het beleid instelt op 2, wordt toegang geblokkeerd.\n\nAls je het beleid niet instelt, vragen websites om toegang maar kunnen gebruikers deze instelling wijzigen.";
DefaultGeolocationSetting.pfm_title = "Standaardinstelling voor geolocatie";
DefaultGeolocationSetting.pfm_description = "1 - Sites toestaan de fysieke locatie van gebruikers bij te houden\n2 - Niet toestaan dat sites de fysieke locatie van gebruikers bijhouden\n3 - Goedkeuring vragen wanneer een site de fysieke locatie van gebruikers wil bijhouden\nAls je het beleid instelt op 1, kunnen sites de fysieke locatie van gebruikers standaard bijhouden. Als je het beleid instelt op 2, wordt het bijhouden van de fysieke locatie van gebruikers standaard geblokkeerd. Je kunt het beleid zo instellen dat om goedkeuring wordt gevraagd als een site de fysieke locatie van gebruikers wil bijhouden.\n\nAls je het beleid niet instelt, is het beleid AskGeolocation van toepassing maar kunnen gebruikers deze instelling wijzigen.";
DefaultIdleDetectionSetting.pfm_title = "Inactiviteitsdetectie";
DefaultIdleDetectionSetting.pfm_description = "1 - Toestaan dat sites de inactieve status detecteren zonder de gebruiker om toestemming te vragen\n2 - Niet toestaan dat sites de inactieve status van de gebruiker detecteren\n3 - Altijd vragen als een site de inactieve status van de gebruiker wil detecteren\nHiermee kun je instellen of websites de Idle Detection API mogen gebruiken.\n\nAls je dit beleid instelt op 1 (AllowIdleDetection), kunnen websites de API gebruiken zonder de gebruiker om toestemming te vragen.\n\nAls je dit beleid instelt op 2 (BlockIdleDetection), kunnen websites de API niet gebruiken, ongeacht de toestemming van de gebruiker.\n\nAls je dit beleid instelt op 3 (AskIdleDetection) of niet instelt, kunnen websites de API niet gebruiken zonder toestemming van de gebruiker.";
DefaultImagesSetting.pfm_title = "Standaardinstelling voor afbeeldingen";
DefaultImagesSetting.pfm_description = "1 - Alle sites toestaan afbeeldingen te tonen\n2 - Niet toestaan dat sites afbeeldingen tonen\nAls je het beleid instelt op 1, mogen alle websites afbeeldingen tonen. Als je het beleid instelt op 2, wordt de weergave van afbeeldingen geblokkeerd.\n\nAls je het beleid niet instelt, is de weergave van afbeeldingen toegestaan maar kunnen gebruikers deze instelling wijzigen.";
DefaultInsecureContentSetting.pfm_title = "Gebruik van niet-beveiligde contentuitzonderingen beheren";
DefaultInsecureContentSetting.pfm_description = "2 - Niet toestaan dat sites gemengde content laden\n3 - Gebruikers toestaan uitzonderingen toe te voegen om gemengde content toe te staan\nHiermee kun je instellen of gebruikers uitzonderingen kunnen toevoegen om gecombineerde content toe te staan voor specifieke sites.\n\nDit beleid kan worden overschreven voor specifieke URL-patronen met het beleid InsecureContentAllowedForUrls en InsecureContentBlockedForUrls.\n\nAls je dit beleid niet instelt, kunnen gebruikers uitzonderingen toevoegen om blokkeerbare gecombineerde content toe te staan en automatische upgrades voor optioneel blokkeerbare gemengde content uitzetten.";
DefaultJavaScriptJitSetting.pfm_title = "Gebruik van JavaScript JIT beheren";
DefaultJavaScriptJitSetting.pfm_description = "1 - Toestaan dat sites JavaScript JIT uitvoeren\n2 - Niet toestaan dat sites JavaScript JIT uitvoeren\nHiermee kun je instellen of Brave de v8 JavaScript-engine uitvoert met de JIT-compiler (Just In Time) aangezet of niet.\n\nAls je de JavaScript JIT-compiler uitzet, kan Brave er langer over doen om webcontent te laten zien en kunnen ook delen van JavaScript (waaronder WebAssembly) worden uitgezet. Als je de JavaScript JIT-compiler uitzet, kan Brave webcontent laten zien in een meer beveiligde configuratie.\n\nDit beleid kan met behulp van het beleid JavaScriptJitAllowedForSites en JavaScriptJitBlockedForSites worden overschreven voor specifieke URL-patronen.\n\nAls je dit beleid niet instelt, staat JavaScript JIT aan.";
DefaultJavaScriptOptimizerSetting.pfm_title = "Gebruik van JavaScript-optimalisaties beheren";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Geavanceerde JavaScript-optimalisaties aanzetten op alle sites\n2 - Geavanceerde JavaScript-optimalisaties uitzetten op alle sites\nHiermee kun je instellen of Brave de v8 JavaScript-engine uitvoert met meer geavanceerde JavaScript-optimalisaties aangezet.\n\nAls je JavaScript-optimalisaties uitzet (door de waarde van dit beleid in te stellen op 2), doet Brave er langer over om webcontent te renderen.\n\nDit beleid kan voor specifieke URL-patronen worden overschreven met de beleidsregels JavaScriptOptimizerAllowedForSites en JavaScriptOptimizerBlockedForSites.\n\nAls je dit beleid niet instelt, worden JavaScript-optimalisaties aangezet.";
DefaultJavaScriptSetting.pfm_title = "Standaardinstelling voor JavaScript";
DefaultJavaScriptSetting.pfm_description = "1 - Alle sites toestaan JavaScript uit te voeren\n2 - Niet toestaan dat sites JavaScript uitvoeren\nAls je het beleid instelt op 1, mogen websites JavaScript uitvoeren. Als je het beleid instelt op 2, wordt JavaScript geblokkeerd.\n\nAls je het beleid niet instelt, is JavaScript toegestaan maar kunnen gebruikers deze instelling wijzigen.";
DefaultLocalFontsSetting.pfm_title = "Standaardinstelling voor het recht voor lokale lettertypen";
DefaultLocalFontsSetting.pfm_description = "2 - Het recht voor lokale lettertypen wordt standaard geweigerd voor alle sites\n3 - Altijd toestemming vragen als een site het recht voor lokale lettertypen wil hebben\nAls je het beleid instelt op BlockLocalFonts (waarde 2), wordt het recht voor lokale lettertypen standaard automatisch geweigerd voor sites. Dit beperkt de mogelijkheid van sites om informatie over lokale lettertypen te bekijken.\n\nAls je het beleid instelt op AskLocalFonts (waarde 3), wordt de gebruiker standaard om toestemming gevraagd als het recht voor lokale lettertypen wordt aangevraagd. Als gebruikers het recht verlenen, hebben sites de mogelijkheid om informatie over lokale lettertypen te bekijken.\n\nAls je het beleid niet instelt, wordt het standaardgedrag toegepast en krijgt de gebruiker een prompt. Gebruikers kunnen deze instelling wijzigen.";
DefaultNotificationsSetting.pfm_title = "Standaardinstelling voor meldingen";
DefaultNotificationsSetting.pfm_description = "1 - Sites toestaan bureaubladmeldingen te tonen\n2 - Niet toestaan dat sites bureaubladmeldingen tonen\n3 - Altijd goedkeuring vragen wanneer een site bureaubladmeldingen wil tonen\nAls je het beleid instelt op 1, kunnen websites bureaubladmeldingen tonen. Als je het beleid instelt op 2, worden bureaubladmeldingen geblokkeerd.\n\nAls je het beleid niet instelt, is AskNotifications van toepassing maar kunnen gebruikers deze instelling wijzigen.";
DefaultPopupsSetting.pfm_title = "Standaardinstelling voor pop-ups";
DefaultPopupsSetting.pfm_description = "1 - Alle sites toestaan pop-ups te tonen\n2 - Niet toestaan dat sites pop-ups tonen\nAls je het beleid instelt op 1, kunnen websites pop-ups tonen. Als je het beleid instelt op 2, worden pop-ups geblokkeerd.\n\nAls je het beleid niet instelt, is BlockPopups van toepassing maar kunnen gebruikers deze instelling wijzigen.";
DefaultPrinterSelection.pfm_title = "Regels voor selectie van standaardprinter";
DefaultPrinterSelection.pfm_description = "Als je dit beleid instelt, kun je regels voor de selectie van de standaardprinter instellen in Brave, die de standaardregels overschrijven. Als gebruikers voor het eerst iets afdrukken en Brave een printer zoekt die aan de opgegeven kenmerken voldoet, moeten ze een printer selecteren. Brave kan zo worden ingesteld dat als er geen perfecte overeenkomst is, een willekeurige geschikte printer wordt geselecteerd op basis van de volgorde waarin printers worden gevonden.\n\nAls je het beleid niet instelt of instelt op kenmerken zonder overeenkomst, wordt standaard de geïntegreerde pdf-printer gebruikt. Als er geen pdf-printer is, heeft Brave standaard geen waarde (None).\n\nOp dit moment zijn alle printers geclassificeerd als \"local\". Printers die aan Google Cloud Print zijn gekoppeld, worden als printers van het type \"cloud\" beschouwd, maar Google Cloud Print wordt niet meer ondersteund.\n\nOpmerking: Als je een veld overslaat, betekent dit dat alle waarden overeenkomen voor dat specifieke veld. Als je bijvoorbeeld geen idPattern opgeeft, accepteert Afdrukvoorbeeld alle printer-ID's. Reguliere-expressiepatronen moeten de RegExp-syntaxis voor JavaScript volgen en namen komen alleen overeen als ook het hoofdlettergebruik klopt (hoofdlettergevoelig).\nGa naar https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection voor meer informatie over schema en indeling.";
DefaultSearchProviderAlternateURLs.pfm_title = "Lijst met alternatieve URL's voor de standaardzoekprovider";
DefaultSearchProviderAlternateURLs.pfm_description = "Als DefaultSearchProviderEnabled is aangezet en je DefaultSearchProviderAlternateURLs instelt, wordt er een lijst met alternatieve URL's gespecificeerd om zoektermen uit de zoekmachine te extraheren. De URL's moeten de tekenreeks '{searchTerms}' bevatten.\n\nAls je DefaultSearchProviderAlternateURLs niet instelt, worden er geen alternatieve URL's gespecificeerd om zoektermen uit de zoekmachine te extraheren.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Toegang toestaan tot standaard zoekprovider in contextmenu";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "Hiermee wordt een standaard zoekprovider in het contextmenu gebruikt.\n\nAls je dit beleid niet toepast, is de zoekoptie in het contextmenu die je standaard zoekprovider gebruikt niet beschikbaar.\n\nAls dit beleid is toegepast of niet is ingesteld, is de optie in het contextmenu voor je standaard zoekprovider beschikbaar.\n\nDe beleidswaarde wordt alleen toegepast als het beleid DefaultSearchProviderEnabled is toegepast en is anders niet van toepassing.";
DefaultSearchProviderEnabled.pfm_title = "Standaard zoekprovider gebruiken";
DefaultSearchProviderEnabled.pfm_description = "Als je het beleid toepast, wordt er een standaard zoekopdracht uitgevoerd als een gebruiker in de adresbalk tekst invoert die geen URL is. Als je de standaard zoekprovider wilt aangeven, stel je alle andere standaard zoekbeleidsregels in. Als je die zoekbeleidsregels leeg laat, kan de gebruiker zelf de standaardprovider kiezen. Als je het beleid niet toepast, wordt er geen zoekopdracht uitgevoerd als de gebruiker in de adresbalk tekst invoert die geen URL is. De waarde Uitgezet wordt niet ondersteund door de Google Admin console.\n\nAls je het beleid instelt, kunnen gebruikers dit niet wijzigen in Brave. Als je dit beleid niet instelt, wordt de standaard zoekprovider geactiveerd en kunnen gebruikers de lijst met zoekproviders instellen.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
DefaultSearchProviderEncodings.pfm_title = "Coderingen voor standaardzoekprovider";
DefaultSearchProviderEncodings.pfm_description = "Als DefaultSearchProviderEnabled is aangezet en je DefaultSearchProviderEncodings instelt, worden de tekencoderingen gespecificeerd die worden ondersteund door de zoekprovider. Deze coderingen zijn codepaginanamen zoals UTF-8, GB2312 en ISO-8859-1. Ze worden getest in de volgorde waarin ze worden opgegeven.\n\nAls je DefaultSearchProviderEncodings niet instelt, wordt UTF-8 gebruikt.";
DefaultSearchProviderImageURL.pfm_title = "Parameter die een functie voor zoeken op afbeelding levert voor de standaardzoekprovider";
DefaultSearchProviderImageURL.pfm_description = "Als DefaultSearchProviderEnabled aanstaat en je daarna DefaultSearchProviderImageURL instelt, wordt de URL aangegeven van de zoekmachine die wordt gebruikt voor afbeeldingszoekopdrachten. (Als DefaultSearchProviderImageURLPostParams is ingesteld, wordt in plaats daarvan de POST-methode gebruikt voor afbeeldingszoekopdrachten.)\n\nAls je DefaultSearchProviderImageURL niet instelt, worden er geen afbeeldingszoekopdrachten gebruikt.\n\nAls afbeeldingszoekopdrachten de GET-methode gebruiken, moet de URL afbeeldingsparameters aangeven met een geldige combinatie van de volgende tijdelijke aanduidingen:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "Parameters voor afbeeldings-URL die POST gebruikt";
DefaultSearchProviderImageURLPostParams.pfm_description = "Als DefaultSearchProviderEnabled aanstaat en je daarna DefaultSearchProviderImageURLPostParams instelt, worden de parameters aangegeven tijdens afbeeldingszoekopdrachten met POST. Deze bestaan uit door komma's gescheiden naam/waarde-paren. Als een waarde een templateparameter (zoals {imageThumbnail}) is, wordt de waarde vervangen door echte thumbnailgegevens.\n\nAls je DefaultSearchProviderImageURLPostParams niet instelt, worden afbeeldingszoekopdrachten gestuurd met de GET-methode.\n\nDe URL moet de afbeeldingsparameter aangeven met een geldige combinatie van de volgende tijdelijke aanduidingen, afhankelijk van wat de zoekprovider ondersteunt:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Zoekwoord voor standaardzoekprovider";
DefaultSearchProviderKeyword.pfm_description = "Als DefaultSearchProviderEnabled is aangezet en je DefaultSearchProviderKeyword instelt, wordt het zoekwoord of de snelkoppeling gespecificeerd die in de adresbalk wordt gebruikt om de zoekfunctie voor deze provider te activeren.\n\nAls je DefaultSearchProviderKeyword niet instelt, wordt de zoekprovider niet geactiveerd door een zoekwoord.";
DefaultSearchProviderName.pfm_title = "Naam van standaardzoekprovider";
DefaultSearchProviderName.pfm_description = "Als DefaultSearchProviderEnabled is aangezet en je DefaultSearchProviderName instelt, wordt de naam van de standaard zoekprovider gespecificeerd.\n\nAls je DefaultSearchProviderName niet instelt, wordt de hostnaam gebruikt die door de zoek-URL wordt gespecificeerd.";
DefaultSearchProviderNewTabURL.pfm_title = "URL van standaard zoekprovider voor nieuwe tabbladpagina";
DefaultSearchProviderNewTabURL.pfm_description = "Als DefaultSearchProviderEnabled is aangezet en je DefaultSearchProviderNewTabURL instelt, wordt de URL gespecificeerd van de zoekmachine die wordt gebruikt om een pagina Nieuw tabblad te leveren.\n\nAls je DefaultSearchProviderNewTabURL niet instelt, wordt er geen pagina Nieuw tabblad geopend.";
DefaultSearchProviderSearchURL.pfm_title = "Zoek-URL voor standaardzoekprovider";
DefaultSearchProviderSearchURL.pfm_description = "Als DefaultSearchProviderEnabled is aangezet en je DefaultSearchProviderSearchURL instelt, wordt de URL gespecificeerd van de zoekmachine die tijdens een standaard zoekopdracht wordt gebruikt. De URL moet de tekenreeks '{searchTerms}' bevatten. Deze tekenreeks wordt tijdens de zoekopdracht vervangen door de zoektermen van de gebruiker.\n\nJe kunt de zoek-URL van Google opgeven als: '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "Parameters voor zoek-URL die POST gebruikt";
DefaultSearchProviderSearchURLPostParams.pfm_description = "Als DefaultSearchProviderEnabled is aangezet en je DefaultSearchProviderSearchURLPostParams instelt, worden de parameters gespecificeerd als een URL wordt gezocht via POST. Deze bestaan uit door komma's gescheiden naam/waarde-paren. Als een waarde een templateparameter is (zoals '{searchTerms}'), wordt deze vervangen door de echte zoektermen.\n\nAls je DefaultSearchProviderSearchURLPostParams niet instelt, worden zoekopdrachten gestuurd met de GET-methode.";
DefaultSearchProviderSuggestURL.pfm_title = "Voorgestelde URL voor standaardzoekprovider";
DefaultSearchProviderSuggestURL.pfm_description = "Als DefaultSearchProviderEnabled is aangezet en je DefaultSearchProviderSuggestURL instelt, wordt de URL gespecificeerd van de zoekmachine die wordt gebruikt om zoeksuggesties te bieden. De URL moet de tekenreeks '{searchTerms}' bevatten. Deze tekenreeks wordt tijdens de zoekopdracht vervangen door de zoektermen van de gebruiker.\n\nJe kunt de zoek-URL van Google opgeven als: '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "Parameters voor suggestie-URL die POST gebruikt";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "Als DefaultSearchProviderEnabled is aangezet en je DefaultSearchProviderSuggestURLPostParams instelt, worden de parameters gespecificeerd tijdens voorgestelde zoekopdrachten met POST. Deze bestaan uit door komma's gescheiden naam/waarde-paren. Als een waarde een templateparameter is (zoals '{searchTerms}'), wordt deze vervangen door de echte zoektermen.\n\nAls je DefaultSearchProviderSuggestURLPostParams niet instelt, worden voorgestelde zoekopdrachten gestuurd met de GET-methode.";
DefaultSensorsSetting.pfm_title = "Standaardinstelling voor sensoren";
DefaultSensorsSetting.pfm_description = "1 - Toestaan dat sites toegang hebben tot sensoren\n2 - Geen sites toegang geven tot sensoren\n3 - Vragen als een site toegang wil krijgen tot sensoren\nAls je het beleid instelt op 1, hebben websites toegang tot sensoren, zoals bewegings- en lichtsensoren. Als je het beleid instelt op 2, wordt de toegang tot sensoren geblokkeerd. Als je het beleid instelt op 3, wordt de gebruiker om toestemming gevraagd als een site toegang tot sensoren aanvraagt als de functie-flag met 3 statussen aanstaat. Anders wordt toegang tot sensoren standaard toegestaan.\n\nAls je het beleid niet instelt, is AllowSensors van toepassing maar kunnen gebruikers deze instelling wijzigen.";
DefaultSerialGuardSetting.pfm_title = "Gebruik van de Serial API beheren";
DefaultSerialGuardSetting.pfm_description = "2 - Geen sites toestemming geven om toegang tot seriële poorten te vragen via de Serial API\n3 - Sites toestaan om gebruikers toestemming te vragen voor toegang tot een seriële poort\nAls je het beleid instelt op 3, kunnen websites toegang vragen tot seriële poorten. Als je het beleid instelt op 2, wordt de toegang tot seriële poorten geblokkeerd.\n\nAls je het beleid niet instelt, vragen websites om toegang maar kunnen gebruikers deze instelling wijzigen.";
DefaultWebBluetoothGuardSetting.pfm_title = "Gebruik van de Web Bluetooth API beheren";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - Niet toestaan dat sites toegang tot Bluetooth-apparaten vragen via de Web Bluetooth API\n3 - Toestaan dat sites de gebruiker vragen om toegang te verlenen tot een Bluetooth-apparaat in de buurt\nAls je het beleid instelt op 3, kunnen websites vragen om toegang tot bluetooth-apparaten in de buurt. Als je het beleid instelt op 2, wordt de toegang tot bluetooth-apparaten in de buurt geblokkeerd.\n\nAls je het beleid niet instelt, kunnen sites om toegang vragen maar kunnen gebruikers deze instelling wijzigen.";
DefaultWebHidGuardSetting.pfm_title = "Het gebruik van de WebHID API beheren";
DefaultWebHidGuardSetting.pfm_description = "2 - Geen enkele site toestemming geven om toegang te vragen tot HID-apparaten via de WebHID API\n3 - Sites toestaan om gebruikers toegang te vragen tot een HID-apparaat\nAls je het beleid instelt op 3, kunnen websites toegang vragen tot HID-apparaten. Als je het beleid instelt op 2, wordt toegang tot HID-apparaten geweigerd.\n\nAls je het beleid niet instelt, vragen websites om toegang maar kunnen gebruikers deze instelling wijzigen.\n\nDit beleid kan via het beleid WebHidAskForUrls en WebHidBlockedForUrls worden overschreven voor specifieke url-patronen.";
DefaultWebUsbGuardSetting.pfm_title = "Gebruik van de WebUSB API beheren";
DefaultWebUsbGuardSetting.pfm_description = "2 - Niet toestaan dat sites via de WebUSB API toegang tot USB-apparaten vragen\n3 - Toestaan dat sites de gebruiker vragen om toegang te verlenen tot een aangesloten USB-apparaat\nAls je het beleid instelt op 3, kunnen websites vragen om toegang tot aangesloten USB-apparaten. Als je het beleid instelt op 2, wordt de toegang tot aangesloten USB-apparaten geblokkeerd.\n\nAls je het beleid niet instelt, vragen websites om toegang maar kunnen gebruikers deze instelling wijzigen.";
DefaultWindowManagementSetting.pfm_title = "Standaardinstelling voor het recht voor vensterbeheer";
DefaultWindowManagementSetting.pfm_description = "2 - Het recht voor vensterbeheer wordt standaard geweigerd voor alle sites\n3 - Altijd toestemming vragen als een site het recht voor vensterbeheer wil hebben\nAls je het beleid instelt op BlockWindowManagement (waarde 2), wordt het recht voor vensterbeheer standaard geweigerd voor alle sites. Dit beperkt de mogelijkheid van sites om informatie over de schermen van het apparaat te bekijken en die informatie te gebruiken om vensters te openen en te plaatsen of om een volledig scherm voor bepaalde schermen aan te vragen.\n\nAls je het beleid instelt op AskWindowManagement (waarde 3), wordt de gebruiker standaard om toestemming gevraagd als het recht voor vensterbeheer wordt aangevraagd. Als gebruikers het recht verlenen, hebben sites de mogelijkheid om informatie over de schermen van het apparaat te bekijken en kan die informatie worden gebruikt om vensters te openen en te plaatsen of om een volledig scherm voor bepaalde schermen aan te vragen.\n\nAls je het beleid niet instelt, is het beleid AskWindowManagement van toepassing maar kunnen gebruikers deze instelling wijzigen.\n\nDit vervangt het beëindigde beleid DefaultWindowPlacementSetting.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Verwijdering van niet-ontsleutelbare wachtwoorden aanzetten";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Met dit beleid bepaal je of de ingebouwde wachtwoordmanager niet-ontsleutelbare wachtwoorden mag verwijderen uit de bijbehorende database. Dit is vereist om de volledige functionaliteit van de ingebouwde wachtwoordmanager te herstellen, maar er kan permanent gegevensverlies optreden. Niet-ontsleutelbare wachtwoordwaarden worden niet automatisch ontsleutelbaar. Als ze kunnen worden gecorrigeerd, zijn er meestal complexe gebruikersacties nodig.\n\nAls je het beleid aanzet of niet instelt, verliezen gebruikers hun niet-ontsleutelbare wachtwoorden die zijn opgeslagen in de ingebouwde wachtwoordmanager. Er gebeurt niets met wachtwoorden die nog steeds werken.\n\nAls je het beleid uitzet, behouden gebruikers hun gegevens van de wachtwoordmanager, maar werkt de wachtwoordmanager niet.\n\nAls je het beleid instelt, kunnen gebruikers het niet wijzigen in Brave.";
DesktopSharingHubEnabled.pfm_title = "Delen van bureaublad aanzetten in de omnibox en het menu met 3 stippen";
DesktopSharingHubEnabled.pfm_description = "Als je het beleid instelt op True of niet instelt, kunnen gebruikers de huidige webpagina delen of opslaan via acties die worden geleverd door de hub voor het delen van het bureaublad. De hub voor delen is toegankelijk via een omniboxicoon of het menu met 3 stippen.\n\nAls je het beleid instelt op False, verwijder je het icoon voor delen uit de omnibox en de vermelding uit het menu met 3 stippen.";
DevToolsGenAiSettings.pfm_title = "Instellingen voor generatieve AI-functies van Chrome DevTools";
DevToolsGenAiSettings.pfm_description = "0 - Sta generatieve AI-functies van Chrome DevTools toe en verbeter AI-modellen.\n1 - Sta generatieve AI-functies van Chrome DevTools toe zonder AI-modellen te verbeteren.\n2 - Sta generatieve AI-functies van Chrome DevTools niet toe.\nDeze functies in Chrome DevTools gebruiken modellen voor generatieve AI om aanvullende foutopsporingsinformatie te bieden. Als je deze functies wilt gebruiken, moet Brave gegevens zoals foutmeldingen, stacktraces, codefragmenten en netwerkverzoeken verzamelen en naar een server sturen die eigendom is van Google, waarop een model voor generatieve AI wordt uitgevoerd. De hoofdtekst van de reactie of de verificatie- en cookieheaders in netwerkverzoeken worden niet opgenomen in de gegevens die naar de server worden gestuurd.\n\n0 = Hiermee wordt toegestaan dat de functie wordt gebruikt en dat Google relevante gegevens gebruikt om de AI-modellen te verbeteren. Relevante gegevens kunnen prompts, invoer, uitvoer, bronmateriaal en geschreven feedback zijn, afhankelijk van de functie. De gegevens kunnen ook door mensen worden beoordeeld om AI-modellen te verbeteren. 0 is de standaardwaarde, behalve zoals hieronder aangegeven.\n\n1 = Hiermee wordt toegestaan dat de functie wordt gebruikt, maar wordt niet toegestaan dat Google modellen verbetert met content van gebruikers (waaronder prompts, invoer, uitvoer, bronmateriaal en geschreven feedback). 1 is de standaardwaarde voor zakelijke gebruikers die worden beheerd via Google Admin console en voor onderwijsaccounts die worden beheerd via Google Workspace.\n\n2 = Hiermee wordt de functie niet toegestaan.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nDe generatieve AI-functies in Chrome DevTools zijn onder andere:\n\n- Console Insights: Hier vind je uitleg over consoleberichten en suggesties om consolefouten op te lossen.\n\n- AI-ondersteuning: Krijg hulp bij het begrijpen van css-stijlen (vanaf versie 131), netwerkverzoeken, prestaties en bestanden (allemaal vanaf versie 132).\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Google Developer Program-profielen aanzetten in Chrome DevTools";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Integratie met het Google Developer Program aanzetten in Chrome DevTools.\n1 - Integratie van het Google Developer Program aanzetten in Chrome DevTools, maar zonder toolgebruik te delen (voor het toekennen van badges).\n2 - Integratie met het Google Developer Program niet aanzetten in Chrome DevTools.\nDit beleid beheert de integratie van het Google Developer Program met Chrome DevTools. Het Google Developer Program-profiel van de gebruiker wordt getoond in Chrome DevTools en gebruikers krijgen badges voor specifieke acties in Chrome DevTools.\n\nAls je het beleid instelt op 0 (Aangezet) of geen beleidswaarde instelt, wordt de integratie van het Google Developer Program met Chrome DevTools toegestaan en wordt het delen van het gebruik van de Chrome DevTools-tool toegestaan om badges te kunnen toekennen.\n\nAls je het beleid instelt op 1 (Aangezet zonder badges), kun je het Google Developer Program integreren met Chrome DevTools, maar kun je het gebruik van de Chrome DevTools-tool niet delen met het Google-ontwikkelaarsprogramma. Er worden geen badges toegekend.\n\nAls je het beleid instelt op 2 (Uitgezet), staat het de integratie van het Google Developer Program met Chrome DevTools niet toe.";
DeveloperToolsAvailability.pfm_title = "Bepalen waar Chrome DevTools kan worden gebruikt";
DeveloperToolsAvailability.pfm_description = "0 - Het gebruik van de Chrome DevTools niet toestaan voor apps en extensies die via het organisatiebeleid zijn geïnstalleerd of, sinds versie 114 en als dit een beheerde gebruiker is, extensies die in de browser zijn ingebouwd. Gebruik van Chrome DevTools toestaan in andere contexten\n1 - Gebruik van Chrome DevTools toestaan\n2 - Gebruik van Chrome DevTools niet toestaan\nAls je het beleid instelt op 0 (standaardinstelling), heb je toegang tot de Chrome DevTools en de JavaScript-console, maar niet in de context van extensies die via het organisatiebeleid zijn geïnstalleerd of, sinds versie 114 en als dit een beheerde gebruiker is, extensies die in de browser zijn ingebouwd. Als je het beleid instelt op 1, heb je toegang tot de Chrome DevTools en de JavaScript-console in alle contexten, waaronder die van extensies die via het organisatiebeleid zijn geïnstalleerd. Als je het beleid instelt op 2, heb je geen toegang tot de Chrome DevTools en kun je website-elementen niet inspecteren.\n\nMet deze instelling worden sneltoetsen en menu- en contextmenu-opties uitgezet waarmee Chrome DevTools of de JavaScript-console kunnen worden geopend.\n\nVanaf Brave versie 99 beheert deze instelling ook de startpunten voor de functie Paginabron bekijken. Als je dit beleid instelt op 'DeveloperToolsDisallowed' (waarde 2), kunnen gebruikers de bron niet bekijken via een sneltoets of het contextmenu. Als je het bekijken van de bron helemaal wilt blokkeren, moet je ook 'view-source:*' toevoegen aan het beleid URLBlocklist.\n\nVanaf Brave versie 119 bepaalt deze instelling ook of de ontwikkelaarsmodus voor geïsoleerde web-apps kan worden geactiveerd en gebruikt.\n\nVanaf Brave versie 128 bepaalt deze instelling niet de ontwikkelaarsmodus op de pagina Extensies als het beleid ExtensionDeveloperModeSettings is ingesteld.\n\nDit beleid is van invloed op Chrome DevTools, directe toegang tot het Chrome DevTools-protocol (CDP) (bijvoorbeeld als dit wordt gestart met --remote-debugging-port of --remote-debugging-pipe) en toegang tot het Chrome DevTools-protocol (CDP) via chrome.debugger-API's. Zowel dit beleid als het beleid RemoteDebuggingAllowed is van toepassing: RemoteDebuggingAllowed bepaalt of foutopsporing op afstand kan worden gestart, terwijl dit beleid beperkt of afzonderlijke doelen kunnen worden geïnspecteerd, zelfs als foutopsporing op afstand wordt uitgevoerd.\n\nHet beleid DeveloperToolsAvailabilityAllowlist en DeveloperToolsAvailabilityBlocklist krijgen voorrang op dit beleid. De beschikbaarheid van Chrome DevTools wordt bepaald in deze volgorde van prioriteit:\n\n1. Als een URL overeenkomt met een patroon in het beleid DeveloperToolsAvailabilityAllowlist, zijn Chrome DevTools toegestaan.\n2. Als je DeveloperToolsAvailabilityAllowlist instelt en DeveloperToolsAvailabilityBlocklist niet, wordt elke URL die niet op de toelatingslijst staat, geblokkeerd.\n3. Als een URL overeenkomt met een patroon in het beleid DeveloperToolsAvailabilityBlocklist, worden Chrome DevTools geblokkeerd.\n4. Als geen van beide beleidsregels is ingesteld of als een URL met geen van beide lijsten overeenkomt, wordt dit beleid (DeveloperToolsAvailability) gebruikt als reservemechanisme.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Lijst met URL-patronen waarvoor Chrome DevTools mogen worden geopend";
DeveloperToolsAvailabilityAllowlist.pfm_description = "Je kunt dit beleid gebruiken om Chrome DevTools toe te staan voor specifieke URL's.\n\nDe beschikbaarheid van Chrome DevTools wordt geëvalueerd op doelniveau. URL-patronen worden vergeleken met de URL van elk doel dat wordt geïnspecteerd (zoals het hoofdframe van een pagina, een ingesloten subframe, een extensie of een web-app). Het resulterende gedrag hangt ervan af of het beleid DeveloperToolsAvailabilityBlocklist ook is ingesteld.\n\nAls je dit beleid instelt en DeveloperToolsAvailabilityBlocklist niet, moet de URL van een doel overeenkomen met een patroon op deze toelatingslijst om Chrome DevTools toe te staan voor dat doel. Als de URL van een doel niet overeenkomt met deze toelatingslijst, wordt Chrome DevTools geblokkeerd voor dat doel (een subframe waarvan de URL niet op de toelatingslijst staat, kan bijvoorbeeld niet worden geïnspecteerd, maar de hoofdpagina kan nog steeds worden geïnspecteerd als de URL op de toelatingslijst staat). Ga naar https://support.google.com/chrome/a?p=url_blocklist_filter_format voor informatie over de URL-indeling.\n\nAls je dit beleid en het beleid DeveloperToolsAvailabilityBlocklist beide instelt, heeft deze toelatingslijst voorrang. Als de URL van een doel overeenkomt met een patroon op deze toelatingslijst, wordt deze toegestaan, zelfs als deze ook overeenkomt met een patroon op de blokkeerlijst. Als de URL van een doel overeenkomt met een patroon op deze blokkeerlijst (maar niet op de toelatingslijst), wordt deze geblokkeerd. Als de URL van een doel met geen van beide overeenkomt, wordt het beleid DeveloperToolsAvailability gebruikt als reserve.\n\nAls je dit beleid niet instelt, wordt de beschikbaarheid van Chrome DevTools bepaald door het beleid DeveloperToolsAvailabilityBlocklist en DeveloperToolsAvailability.\n\nAlgemene jokertekens (zoals '*' of '[*]') zijn niet toegestaan. Gebruik het beleid DeveloperToolsAvailability om de functie wereldwijd aan te zetten.\n\nDit beleid is van invloed op Chrome DevTools, directe toegang tot het Chrome DevTools-protocol (CDP) (bijvoorbeeld als dit wordt gestart met --remote-debugging-port of --remote-debugging-pipe) en toegang tot het Chrome DevTools-protocol (CDP) via chrome.debugger-API's. Zowel dit beleid als het beleid RemoteDebuggingAllowed is van toepassing: RemoteDebuggingAllowed bepaalt of foutopsporing op afstand kan worden gestart, terwijl dit beleid beperkt of afzonderlijke doelen kunnen worden geïnspecteerd, zelfs als foutopsporing op afstand wordt uitgevoerd.\n\nDit beleid is beperkt tot 1000 items.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Lijst met URL-patronen waarvoor Chrome DevTools zijn geblokkeerd";
DeveloperToolsAvailabilityBlocklist.pfm_description = "Je kunt dit beleid gebruiken om Chrome DevTools te blokkeren voor specifieke URL's. Ga naar https://support.google.com/chrome/a?p=url_blocklist_filter_format voor informatie over de URL-indeling.\n\nDe beschikbaarheid van Chrome DevTools wordt geëvalueerd op doelniveau. URL-patronen worden vergeleken met de URL van elk doel dat wordt geïnspecteerd (zoals het hoofdframe van een pagina, een ingesloten subframe, een extensie of een web-app). Het resulterende gedrag hangt ervan af of het beleid DeveloperToolsAvailabilityAllowlist ook is ingesteld.\n\nAls je dit beleid instelt en DeveloperToolsAvailabilityAllowlist niet, wordt Chrome DevTools geblokkeerd voor een doel als de URL van dat doel overeenkomt met een patroon op deze blokkeerlijst (een subframe waarvan de URL overeenkomt met deze blokkeerlijst kan bijvoorbeeld niet worden geïnspecteerd, maar de hoofdpagina kan nog steeds worden geïnspecteerd als de URL niet op de blokkeerlijst staat). Als de URL van een doel niet overeenkomt met een patroon, wordt de beschikbaarheid bepaald door het beleid DeveloperToolsAvailability.\n\nAls je dit beleid en het beleid DeveloperToolsAvailabilityAllowlist beide instelt, heeft de toelatingslijst voorrang. Als de URL van een doel overeenkomt met een patroon op de toelatingslijst, wordt deze toegestaan, zelfs als deze ook overeenkomt met een patroon op deze blokkeerlijst. Als de URL van een doel overeenkomt met een patroon op deze blokkeerlijst (maar niet op de toelatingslijst), wordt deze geblokkeerd. Als de URL van een doel met geen van beide overeenkomt, wordt het beleid DeveloperToolsAvailability gebruikt als reserve.\n\nAls je dit beleid niet instelt, wordt de beschikbaarheid van Chrome DevTools bepaald door het beleid DeveloperToolsAvailabilityAllowlist en DeveloperToolsAvailability.\n\nDit beleid is van invloed op Chrome DevTools, directe toegang tot het Chrome DevTools-protocol (CDP) (bijvoorbeeld als dit wordt gestart met --remote-debugging-port of --remote-debugging-pipe) en toegang tot het Chrome DevTools-protocol (CDP) via chrome.debugger-API's. Zowel dit beleid als het beleid RemoteDebuggingAllowed is van toepassing: RemoteDebuggingAllowed bepaalt of foutopsporing op afstand kan worden gestart, terwijl dit beleid beperkt of afzonderlijke doelen kunnen worden geïnspecteerd, zelfs als foutopsporing op afstand wordt uitgevoerd.\n\nDit beleid is beperkt tot 1000 items.";
Disable3DAPIs.pfm_title = "Ondersteuning voor API's voor 3D-beelden uitzetten";
Disable3DAPIs.pfm_description = "Als je het beleid instelt op Waar (of HardwareAccelerationModeEnabled instelt op Onwaar), hebben webpagina's geen toegang tot de WebGL API.\n\nAls je het beleid instelt op Onwaar of niet instelt, kunnen webpagina's de WebGL API gebruiken, maar kunnen de standaardinstellingen van de browser nog steeds opdrachtregelargumenten vereisen om deze API's te gebruiken.";
DisableAuthNegotiateCnameLookup.pfm_title = "CNAME-lookup bij verwerking van Kerberos-verificatie uitzetten";
DisableAuthNegotiateCnameLookup.pfm_description = "Als je het beleid toepast, wordt CNAME-lookup overgeslagen. De servernaam wordt gebruikt zoals deze is ingevoerd tijdens het maken van de Kerberos SPN.\n\nAls je het beleid niet toepast of niet instelt, bepaalt CNAME-lookup de canonieke naam van de server tijdens het maken van de Kerberos SPN.";
DisablePrintPreview.pfm_title = "Afdrukvoorbeeld uitzetten";
DisablePrintPreview.pfm_description = "Als je dit beleid toepast, opent Brave het dialoogvenster voor afdrukken van het systeem in plaats van het geïntegreerde afdrukvoorbeeld als gebruikers iets willen afdrukken.\n\nAls je het beleid niet toepast of niet instelt, wordt het afdrukvoorbeeldscherm geactiveerd door afdrukopdrachten.";
DisableSafeBrowsingProceedAnyway.pfm_title = "Doorgaan vanaf de Safe Browsing-waarschuwingspagina uitzetten";
DisableSafeBrowsingProceedAnyway.pfm_description = "Als je het beleid toepast, voorkom je dat gebruikers vanaf de waarschuwingspagina van de Safe Browsing-service toch doorgaan naar de schadelijke site. Dit beleid voorkomt alleen dat gebruikers doorgaan na Safe Browsing-waarschuwingen over bijvoorbeeld malware en phishing en heeft geen betrekking op aan SSL-certificaten gerelateerde problemen zoals ongeldige of verlopen certificaten.\n\nAls je het beleid niet toepast of niet instelt, kunnen gebruikers ervoor kiezen door te gaan naar de gemarkeerde site nadat de waarschuwing wordt getoond.\n\nMeer informatie over Safe Browsing ( https://developers.google.com/safe-browsing ).";
DisableScreenshots.pfm_title = "Maken van screenshots uitzetten";
DisableScreenshots.pfm_description = "Als je het beleid toepast, zijn screenshots die worden gemaakt met sneltoetsen of extensie-API's niet toegestaan. Als je het beleid niet toepast of niet instelt, zijn screenshots toegestaan.\n\nVanaf Brave versie 154 voorkomt dit beleid ook dat extensies het foutopsporingsprogramma koppelen via chrome.debugger.attach().\n\nOp Microsoft® Windows®, macOS en Linux voorkomt dit niet dat screenshots worden gemaakt met het besturingssysteem of apps van derden.";
DiskCacheDir.pfm_title = "Directory voor schijfcache instellen";
DiskCacheDir.pfm_description = "Als je het beleid instelt, kan Brave de door jou opgegeven directory gebruiken voor de opslag van gecachte bestanden op de schrijf, ongeacht of gebruikers de optie '--disk-cache-dir' hebben opgegeven.\n\nAls je dit beleid niet instelt, gebruikt Brave de standaard cachedirectory. Gebruikers kunnen die instelling echter wijzigen met behulp van de opdrachtregel '--disk-cache-dir'.\n\nBrave beheert de inhoud van de root-map van een volume. Als je gegevensverlies of andere fouten wilt voorkomen, moet je dit beleid niet instellen op de root-map of een directory die voor andere doeleinden wordt gebruikt. Bekijk de variabelen die je kunt gebruiken (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DiskCacheSize.pfm_title = "Grootte voor schijfcache instellen";
DiskCacheSize.pfm_description = "Als je het beleid instelt op None, gebruikt Brave de standaard cachegrootte om gecachte bestanden op de schijf op te slaan. Gebruikers kunnen deze instelling niet wijzigen.\n\nAls je het beleid instelt, gebruikt Brave de door jou opgegeven cachegrootte, ongeacht of gebruikers de optie --disk-cache-size hebben opgegeven. (Waarden onder enkele megabytes worden naar boven afgerond.)\n\nAls je dit beleid niet instelt, gebruikt Brave de standaardgrootte. Gebruikers kunnen deze instelling wijzigen met de optie --disk-cache-size.\n\nOpmerking: De waarde die je in dit beleid opgeeft, wordt gebruikt als hint voor verschillende cachesubsystemen in de browser. Daarom ligt het werkelijke totale schijfverbruik van alle caches hoger, maar in dezelfde orde van grootte als de opgegeven waarde.";
DnsOverHttpsMode.pfm_title = "Hiermee wordt de modus voor DNS-over-HTTPS bepaald";
DnsOverHttpsMode.pfm_description = "off - DNS-over-HTTPS uitzetten\nautomatic - DNS-over-HTTPS met onbeveiligde fallback aanzetten\nsecure - DNS-over-HTTPS zonder onbeveiligde fallback aanzetten\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "URI-template van gewenste DNS-over-HTTPS-resolver opgeven";
DnsOverHttpsTemplates.pfm_description = "De URI-template van de gewenste DNS-over-HTTPS-resolver. Als je meerdere DNS-over-HTTPS-resolvers wilt opgeven, scheid je de overeenkomstige URI-templates met een spatie.\n\nAls de DnsOverHttpsMode is ingesteld op \"secure\", moet dit beleid worden ingesteld en mag het niet leeg blijven. Alleen op Google Chrome OS: dit beleid of de DnsOverHttpsTemplatesWithIdentifiers moet worden ingesteld, anders mislukt de DNS-omzetting.\n\nAls de DnsOverHttpsMode is ingesteld op \"automatic\" en dit beleid is ingesteld, worden de opgegeven URI-templates gebruikt. Als dit beleid niet is ingesteld, worden hardgecodeerde toewijzingen gebruikt om te proberen de huidige DNS-resolver van de gebruiker te upgraden naar een DoH-resolver van dezelfde provider.\n\nAls de URI-template een variabele dns bevat, wordt voor verzoeken aan de resolver GET gebruikt; anders wordt voor verzoeken POST gebruikt.\n\nOnjuist opgemaakte templates worden genegeerd.";
DomainReliabilityAllowed.pfm_title = "Rapportage van gegevens over domeinbetrouwbaarheid toestaan";
DomainReliabilityAllowed.pfm_description = "Als je dit beleid instelt op False, wordt rapportage van diagnostische gegevens over domeinbetrouwbaarheid uitgezet en worden er geen gegevens naar Google gestuurd.\nAls je dit beleid instelt op True of niet instelt, volgt de rapportage van diagnostische gegevens over domeinbetrouwbaarheid het gedrag van MetricsReportingEnabled voor Brave of DeviceMetricsReportingEnabled voor Google Chrome OS.";
DownloadDirectory.pfm_title = "Downloaddirectory instellen";
DownloadDirectory.pfm_description = "Als je het beleid instelt, wordt de directory ingesteld die Chrome gebruikt voor het downloaden van bestanden. Chrome gebruikt de opgegeven directory, ongeacht of de gebruiker een directory heeft gespecificeerd of heeft aangegeven dat er elke keer om een downloadlocatie moet worden gevraagd.\n\nDit beleid overschrijft het beleid DefaultDownloadDirectory.\n\nAls je het beleid niet instelt, gebruikt Chrome de standaard downloaddirectory en kunnen gebruikers deze wijzigen.\n\nIn Google Chrome OS kun je deze alleen instellen op Google Drive-directory's.\n\nOpmerking: Bekijk een lijst met variabelen die je kunt gebruiken (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DownloadRestrictions.pfm_title = "Downloadbeperkingen";
DownloadRestrictions.pfm_description = "0 - Geen speciale beperkingen. Standaard.\n1 - Schadelijke downloads en gevaarlijke bestandstypen blokkeren.\n2 - Schadelijke downloads, ongebruikelijke of ongewenste downloads en gevaarlijke bestandstypen blokkeren.\n3 - Alle downloads blokkeren.\n4 - Schadelijke downloads blokkeren. Aanbevolen.\nAls je het beleid instelt, kunnen gebruikers de keuzes voor downloadbeveiliging niet omzeilen.\n\nEr zijn veel verschillende typen downloadmeldingen in Chrome, die grofweg zijn onder te verdelen in de volgende categorieën (meer informatie over Safe Browsing-analyseresultaten vind je op https://support.google.com/chrome/?p=ib_download_blocked):\n\n* Schadelijk, zoals gemarkeerd door de Safe Browsing-server\n* Ongebruikelijk of ongewenst, zoals gemarkeerd door de Safe Browsing-server\n* Een gevaarlijk bestandstype (bijv. alle swf-downloads en veel exe-downloads)\n\nAls je dit beleid instelt, worden afhankelijk van de waarde verschillende van deze subsets geblokkeerd:\n\n0: Geen speciale beperkingen. Standaard.\n\n1: Blokkeert schadelijke bestanden die zijn gemarkeerd door de Safe Browsing-server EN blokkeert alle gevaarlijke bestandstypen. Alleen aanbevolen voor OE's/browsers/gebruikers met een hoge tolerantie voor foutpositieven.\n\n2: Blokkeert schadelijke bestanden die zijn gemarkeerd door de Safe Browsing-server EN blokkeert ongebruikelijke of ongewenste bestanden die zijn gemarkeerd door de Safe Browsing-server EN blokkeert alle gevaarlijke bestandstypen. Alleen aanbevolen voor OE's/browsers/gebruikers met een hoge tolerantie voor foutpositieven.\n\n3: Blokkeert alle downloads. Niet aanbevolen, behalve voor speciale toepassingen.\n\n4: Blokkeert schadelijke bestanden die zijn gemarkeerd door de Safe Browsing-server, blokkeert geen gevaarlijke bestandstypen. Aanbevolen.\n\nOpmerking: Deze beperkingen gelden zowel voor downloads die via de webpaginacontent als voor downloads die via de menuoptie 'Link downloaden' geactiveerd zijn. De beperkingen gelden niet voor het downloaden van de huidige pagina die wordt weergegeven of voor de afdrukoptie 'Opslaan als pdf'. Bekijk meer informatie over Safe Browsing (https://developers.google.com/safe-browsing).";
EditBookmarksEnabled.pfm_title = "Bewerking van bookmarks aan- of uitzetten";
EditBookmarksEnabled.pfm_description = "Als je het beleid aanzet of niet instelt, kunnen gebruikers bookmarks toevoegen, verwijderen, wijzigen of uploaden.\n\nAls je het beleid uitzet, kunnen gebruikers geen bookmarks toevoegen, verwijderen, wijzigen of uploaden. Ze kunnen nog wel bestaande bookmarks gebruiken.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Niet-standaardpoort in Kerberos-SPN opnemen";
EnableAuthNegotiatePort.pfm_description = "Als je het beleid toepast en een niet-standaard poort invoert (dat wil zeggen, een andere poort dan 80 of 443), wordt deze poort opgenomen in de gemaakte Kerberos-SPN.\n\nAls je het beleid niet toepast of niet instelt, bevat de gemaakte Kerberos-SPN geen poort.";
EnableExperimentalPolicies.pfm_title = "Hiermee worden experimentele beleidsregels toegepast";
EnableExperimentalPolicies.pfm_description = "Hiermee kan Brave experimentele beleidsregels laden.\n\nWAARSCHUWING: Experimentele beleidsregels worden niet ondersteund en kunnen zonder kennisgeving worden gewijzigd of verwijderd uit toekomstige versies van de browser.\n\nEen experimentele beleidsregel is mogelijk niet compleet of kan bekende of onbekende fouten bevatten. De beleidsregel kan zonder kennisgeving worden gewijzigd of zelfs worden verwijderd. Door experimentele beleidsregels toe te passen, kun je browsegegevens kwijtraken of je veiligheid of privacy in gevaar brengen.\n\nAls een beleidsregel niet in de lijst wordt vermeld en niet officieel is uitgebracht, wordt de waarde hiervan genegeerd in het bètakanaal en het stabiele kanaal.\n\nAls een beleidsregel in de lijst wordt vermeld en niet officieel is uitgebracht, wordt de waarde hiervan toegepast.\n\nDit beleid heeft geen invloed op al uitgebrachte beleidsregels.";
EnableMediaRouter.pfm_title = "Google Cast aanzetten";
EnableMediaRouter.pfm_description = "Als je het beleid toepast of niet instelt, wordt Google Cast aangezet en kunnen gebruikers dit starten via het app-menu, de paginacontextmenu's, mediabediening op websites die werken met Cast en (als dit wordt getoond) het Cast-icoon op de werkbalk.\n\nAls je het beleid niet toepast, wordt Google Cast uitgezet.";
EnableOnlineRevocationChecks.pfm_title = "Online OCSP/CRL-controles aanzetten";
EnableOnlineRevocationChecks.pfm_description = "Als je het beleid instelt op True, worden er online OCSP/CRL-checks uitgevoerd.\n\nAls je het beleid instelt op False of niet instelt, voert Brave geen online intrekkingschecks uit in Brave 19 en hoger.\n\nOpmerking: Door OCSP/CRL-checks wordt de beveiliging niet aantoonbaar verbeterd.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "Hiermee wordt bepaald welke beheerde gebruikers de beleidsregels ProxyOverrideRules en ProxyProvisioningDomains kunnen instellen.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Als je dit beleid instelt op 0 of niet instelt, wordt het beleid ProxyOverrideRules en ProxyProvisioningDomains alleen toegepast op gebruikersniveau voor aangesloten gebruikers in een beheerde browser.\nAls je dit beleid instelt op 1, wordt het beleid ProxyOverrideRules en ProxyProvisioningDomains toegepast op gebruikersniveau, ook als die gebruiker niet is aangesloten.";
EnableUnsafeSwiftShader.pfm_title = "Software-reserveoptie voor WebGL met SwiftShader toestaan";
EnableUnsafeSwiftShader.pfm_description = "Een beleid dat bepaalt of SwiftShader wordt gebruikt als WebGL-reserveoptie als GPU-hardwareversnelling niet beschikbaar is.\n\nSwiftShader is gebruikt om WebGL te ondersteunen op systemen zonder GPU-versnelling, zoals systemen zonder interface of virtuele machines, maar is beëindigd vanwege beveiligingsproblemen. Vanaf M139 mislukt het maken van een WebGL-context als er anders SwiftShader zou worden gebruikt. Met dit beleid kan de browser of beheerder de beëindiging tijdelijk uitstellen.\n\nAls je het beleid toepast, wordt SwiftShader gebruikt als software-reserveoptie voor WebGL.\n\nAls je het beleid niet toepast of niet instelt, kan het maken van een WebGL-context mislukken als hardwareversnelling via de GPU niet beschikbaar is. Webpagina's kunnen zich onvoorspelbaar gedragen als ze het mislukken van het maken van een WebGL-context niet correct verwerken.\n\nDit is een tijdelijk beleid dat in de toekomst wordt verwijderd.";
EncryptedClientHelloEnabled.pfm_title = "ClientHallo met TLS-versleuteling aanzetten";
EncryptedClientHelloEnabled.pfm_description = "Versleutelde ClientHallo (Encrypted ClientHello, ECH) is een extensie voor TLS waarmee gevoelige velden van de ClientHello kunnen worden versleuteld en de privacy kan worden verbeterd.\n\nAls je dit beleid niet instelt of als je het aanzet, volgt Brave het standaard uitrolproces voor ECH. Als het beleid uitstaat, zet Brave ECH niet aan.\n\nAls de functie aanstaat, kan Brave ECH wel of niet gebruiken, afhankelijk van de serversupport, beschikbaarheid van de HTTPS DNS-record of uitrolstatus.\n\nECH is een protocol dat nog in ontwikkeling is, dus de implementatie van Brave kan veranderen. Dit beleid is daarom een tijdelijke maatregel om de eerste experimentele implementatie te beheren. Het wordt vervangen door definitieve beheeropties zodra het protocol is afgerond.";
EnterpriseCustomLabel.pfm_title = "Een aangepast bedrijfslabel instellen voor een beheerd profiel";
EnterpriseCustomLabel.pfm_description = "Dit beleid beheert een aangepast label waarmee beheerde profielen worden geïdentificeerd. Voor beheerde profielen wordt dit label naast de avatar in de werkbalk getoond. Het aangepaste label wordt niet vertaald.\n\nAls je dit beleid toepast, worden tekenreeksen van meer dan 16 tekens afgekapt met een beletselteken. Gebruik geen uitgebreide namen.\n\nDit beleid kan alleen worden ingesteld als gebruikersbeleid.\n\nDit beleid heeft geen effect als het beleid EnterpriseProfileBadgeToolbarSettings is ingesteld op hide_expanded_enterprise_toolbar_badge (waarde 1).";
EnterpriseCustomLabelForBrowser.pfm_title = "Een aangepast bedrijfslabel instellen voor een beheerde browser";
EnterpriseCustomLabelForBrowser.pfm_description = "Dit beleid beheert een aangepast label waarmee een beheerde browser wordt aangegeven. Voor beheerde browsers wordt dit label getoond in een beheerdisclaimer in de voettekst op de pagina Nieuw tabblad. Het aangepaste label wordt niet vertaald.\n\nDit beleid wordt alleen toegepast voor beheerde browsers. Het heeft dus geen effect voor beheerde gebruikers in onbeheerde browsers.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Hiermee kunnen beheerde extensies de Enterprise Hardware Platform-API gebruiken";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Als je het beleid instelt op True, kunnen extensies die zijn geïnstalleerd door bedrijfsbeleid de Enterprise Hardware Platform API gebruiken.\n\nAls je het beleid instelt op False of niet instelt, kunnen extensies deze API niet gebruiken.\n\nOpmerking: Dit beleid is ook van toepassing op componentextensies, zoals de Hangout Services-extensie.";
EnterpriseLogoUrl.pfm_title = "URL voor zakelijk logo voor een beheerd profiel";
EnterpriseLogoUrl.pfm_description = "Een URL naar een afbeelding die wordt gebruikt als zakelijke badge voor een beheerd profiel. De URL moet naar een afbeelding verwijzen.\n\nDit beleid kan alleen worden ingesteld als gebruikersbeleid.\n\nWe raden je aan het favicon (bijvoorbeeld https://www.google.com/favicon.ico) of een icoon van minimaal 48 x 48 pixels te gebruiken.";
EnterpriseLogoUrlForBrowser.pfm_title = "URL voor zakelijk logo voor een beheerde browser";
EnterpriseLogoUrlForBrowser.pfm_description = "Een URL naar een afbeelding die wordt gebruikt als zakelijke badge voor een beheerde browser. De URL moet naar een afbeelding verwijzen.\n\nWe raden je aan het favicon (bijvoorbeeld https://www.google.com/favicon.ico) of een icoon van minimaal 48 x 48 pixels te gebruiken.\n\nDit beleid wordt alleen toegepast voor beheerde browsers. Het heeft dus geen effect voor beheerde gebruikers in onbeheerde browsers.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Bepaalt de zichtbaarheid van de badge voor zakelijke profielen in de werkbalk";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Uitgevouwen zakelijke werkbalkbadge tonen\n1 - Uitgevouwen zakelijke werkbalkbadge verbergen\nVoor werk- en schoolprofielen toont de werkbalk standaard een label Werk of School naast de werkbalkavatar. Het label wordt alleen getoond als het ingelogde account wordt beheerd.\n\nAls je dit beleid instelt op hide_expanded_enterprise_toolbar_badge (waarde 1), wordt de zakelijke badge voor een beheerd profiel in de werkbalk verborgen.\n\nAls je dit beleid niet instelt of instelt op show_expanded_enterprise_toolbar_badge (waarde 0), wordt de zakelijke badge getoond.\n\nHet label is aanpasbaar via het beleid EnterpriseCustomLabel.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "Browsegegevens standaard bewaren als je een zakelijk profiel maakt";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Als je dit beleid toepast, is de optie om bestaande browsegegevens te behouden bij het maken van een zakelijk profiel standaard aangevinkt.\n\nAls dit beleid niet is ingesteld of als je het niet toepast, wordt de optie om bestaande browsegegevens te behouden bij het maken van een zakelijk profiel niet standaard aangevinkt.\n\nOngeacht de waarde kan de gebruiker bij het maken van een zakelijk profiel zelf bepalen of die bestaande browsegegevens wil bewaren.\n\nDit beleid heeft geen effect als de optie om bestaande browsegegevens te behouden niet beschikbaar is. Dit gebeurt als scheiding voor zakelijke profielen strikt worden afgedwongen of als de gegevens afkomstig zijn van een al beheerd profiel.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Instellingen voor zakelijke verzamelsite voor zoeken";
EnterpriseSearchAggregatorSettings.pfm_description = "Met dit beleid kunnen beheerders een aangewezen zakelijke verzamelsite voor zoeken instellen die zoekaanbevelingen en -resultaten in de omnibox (adresbalk) en het zoekvak op de pagina Nieuw tabblad geeft.\n\nZakelijke zoeksuggesties worden standaard gemengd en getoond naast normale aanbevelingen van Brave. Gebruikers kunnen hun zoekopdracht expliciet beperken tot alleen de zakelijke zoekaggregator door het zoekwoord dat is ingevoerd in het veld shortcut met of zonder het voorvoegsel @ (bijvoorbeeld @work) gevolgd door de spatiebalk of Tab in de omnibox te typen. Gerichte zakelijke zoekopdrachten (geactiveerd door een zoekwoord) worden op dit moment alleen ondersteund in de omnibox en niet in het zoekvak op de pagina Nieuw tabblad.\n\nDe volgende velden zijn vereist: name, shortcut, search_url, suggest_url.\n\nHet veld name komt overeen met de naam van de zoekmachine die in de adresbalk aan de gebruiker wordt getoond.\n\nHet veld shortcut komt overeen met het zoekwoord dat de gebruiker invoert om de zoekopdracht te activeren. De snelkoppeling kan gewone woorden en tekens bevatten, maar mag geen spaties bevatten of beginnen met het symbool @. Snelkoppelingen moeten uniek zijn.\n\nHet veld search_url geeft de URL aan waarop moet worden gezocht. Voer het webadres voor de resultatenpagina van de zoekmachine in en gebruik '{searchTerms}' in plaats van de zoekopdracht.\n\nHet veld suggest_url geeft de URL aan die zoeksuggesties levert. Anders wordt een POST-verzoek verstuurd en wordt de zoekopdracht van de gebruiker doorgegeven in de POST-parameters onder de sleutel 'query'.\n\nHet veld icon_url geeft de URL aan van een afbeelding die wordt gebruikt voor de zoeksuggesties. Er wordt een standaardicoon gebruikt als dit veld niet is ingesteld. We raden je aan een favicon te gebruiken (bijvoorbeeld https://www.google.com/favicon.ico). Ondersteunde bestandsindelingen voor afbeeldingen: jpeg, png en ico.\n\nHet veld require_shortcut geeft aan of de adresbalk shortcut vereist is om zoekaanbevelingen te bekijken. Als dit vereist is, worden suggesties niet in het zoekvak op de pagina Nieuw tabblad getoond maar worden ze nog wel steeds getoond in de omnibox (adresbalk) in de modus voor gerichte zoekopdrachten. Als je dit veld niet instelt, is de adresbalk shortcut niet vereist.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.\nGa naar https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings voor meer informatie over schema en indeling.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "Op bestandsextensies gebaseerde downloadwaarschuwingen uitzetten voor gespecificeerde bestandstypen in domeinen";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Pas dit beleid toe om een woordenboek met bestandsextensies te maken met een bijbehorende lijst van domeinen die worden vrijgesteld van op bestandsextensies gebaseerde downloadwaarschuwingen. Hierdoor kunnen zakelijke beheerders op bestandsextensies gebaseerde downloadwaarschuwingen blokkeren voor bestanden die aan een domein in de lijst zijn gekoppeld. Als de extensie jnlp bijvoorbeeld is gekoppeld aan website1.com, zien gebruikers geen waarschuwing als ze jnlp-bestanden downloaden van website1.com, maar zien ze wel een downloadwaarschuwing als ze jnlp-bestanden downloaden van website2.com.\n\nBestanden met bestandsextensies die zijn aangegeven voor domeinen die door dit beleid worden geïdentificeerd, vallen nog steeds onder beveiligingswaarschuwingen die niet op bestandsextensies zijn gebaseerd, zoals downloadwaarschuwingen voor gemengde content en Safe Browsing-waarschuwingen.\n\nAls je dit beleid niet toepast of niet instelt, tonen bestandstypen die op extensies gebaseerde downloadwaarschuwingen activeren, waarschuwingen aan de gebruiker.\n\nAls je dit beleid toepast, geldt het volgende:\n\n* Het URL-patroon moet worden opgemaakt volgens https://chromeenterprise.google/policies/url-patterns/.\n\n* De ingevoerde bestandsextensie moet in kleine ASCII-letters zijn. Het voorafgaande scheidingsteken mag niet worden opgenomen als je de bestandsextensie vermeldt. Vermeld dus jnlp in plaats van .jnlp.\n\nVoorbeeld:\n\nDe volgende voorbeeldwaarde voorkomt op bestandsextensies gebaseerde downloadwaarschuwingen voor exe- en jnlp-extensies voor *.example.com-domeinen en voor swf-extensies voor alle domeinen. Er wordt een op bestandsextensies gebaseerde downloadwaarschuwing aan de gebruiker getoond op elk ander domein voor exe- en jnlp-bestanden, maar niet voor swf-bestanden.\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nHoewel het voorgaande voorbeeld de onderdrukking van op bestandsextensies gebaseerde downloadwaarschuwingen voor swf-bestanden voor alle domeinen toont, wordt uit veiligheidsoverwegingen het toepassen van onderdrukking van dergelijke waarschuwingen voor alle domeinen niet aanbevolen voor gevaarlijke bestandsextensies. Dit wordt alleen in het voorbeeld getoond om te demonstreren dat het mogelijk is.\n\nAls dit beleid wordt toegepast in combinatie met DownloadRestrictions, hebben de uitzonderingen van op bestandsextensies gebaseerde waarschuwingen die door dit beleid zijn aangegeven, voorrang op een DownloadRestrictions-instelling die gevaarlijke bestandstypen zou blokkeren. De uitzonderingen die door dit beleid zijn aangegeven, zijn alleen van toepassing op het gedrag voor het blokkeren van gevaarlijke bestandstypen dat is aangegeven door de waarden 1 en 2 van DownloadRestrictions.\n\nAls dit beleid bijvoorbeeld een uitzondering opneemt voor downloads van exe-bestanden van website1.com en DownloadRestrictions is ingesteld om schadelijke downloads en gevaarlijke bestandstypen te blokkeren (waarde 1), zijn downloads van exe-bestanden van website1.com vrijgesteld van blokkering op basis van bestandsextensies, maar worden ze nog steeds geblokkeerd als ze schadelijk zijn.\n\nGa naar https://chromeenterprise.google/policies/?policy=DownloadRestrictions voor meer informatie over DownloadRestrictions.\nGa naar https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings voor meer informatie over schema en indeling.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Expliciet toegestane netwerkpoorten";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - poort 554 (blokkering kan worden opgeheven tot 15-10-2021)\n10080 - poort 10080 (blokkering kan worden opgeheven tot 01-04-2022)\n6566 - poort 6566 (blokkering kan worden opgeheven tot 15-10-2021)\n989 - poort 989 (blokkering kan worden opgeheven tot 01-02-2022)\n990 - poort 990 (blokkering kan worden opgeheven tot 01-02-2022)\nEr is een lijst met beperkte poorten ingebouwd in Brave. Met deze poorten kan geen verbinding worden gemaakt. Met deze instelling kun je die lijst omzeilen. De waarde is een door komma's gescheiden lijst van 0 of meer poorten waarvoor uitgaande verbindingen zijn toegestaan.\n\nPoorten zijn beperkt om te voorkomen dat Brave als vector wordt gebruikt om misbruik te maken van verschillende kwetsbaarheden in het netwerk. Als je dit beleid instelt, kun je je netwerk blootstellen aan aanvallen. Dit beleid is bedoeld als tijdelijke oplossing voor fouten met de code ERR_UNSAFE_PORT terwijl je een service van een geblokkeerde poort overzet naar een standaardpoort (zoals poort 80 of 443).\n\nSchadelijke websites kunnen makkelijk detecteren dat dit beleid is ingesteld (en voor welke poorten), en die informatie gebruiken voor gerichte aanvallen.\n\nElke poort hier is gelabeld met een datum waarop deze kan worden gedeblokkeerd. Na die datum wordt de poort beperkt, ongeacht deze instelling.\n\nAls je de waarde leeg laat of niet instelt, worden alle beperkte poorten geblokkeerd. Bij een combinatie van geldige en ongeldige waarden worden de geldige waarden toegepast.\n\nDit beleid overschrijft de opdrachtregeloptie --explicitly-allowed-ports.";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Blokkeerlijst van identiteitsproviders die Extensible Enterprise SSO niet kunnen gebruiken voor de browser";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Alle identiteitsproviders\nmicrosoft - Microsoft®-cloudidentiteitsprovider\nokta - Okta®-cloudidentiteitsprovider\nping - Ping®-cloudidentiteitsprovider\nZet Single sign-on uit met Extensible Enterprise SSO voor de vermelde identiteitsproviders.\n\nAls je de waarde 'all' toevoegt, worden alle ondersteunde identiteitsproviders voor SSO uitgezet.\n\nAls je de waarde 'microsoft' toevoegt, wordt ondersteuning voor Single sign-on voor de Microsoft®-cloudidentiteitsprovider in Chrome uitgezet.\n\nAls je dit beleid niet instelt, worden alle identiteitsproviders die worden ondersteund door Brave aangezet.\n\nVoor identiteitsproviders die zijn aangezet in Brave en op het apparaat zijn ingesteld door de beheerder, kunnen gebruikers die inloggen op hun account met die identiteitsprovider in een app die Extensible Enterprise SSO ondersteunt, automatisch inloggen bij webproperty's met die identiteitsprovider. Informatie over de verificatiegegevens van de gebruiker wordt voor elke verificatiegebeurtenis overgedragen naar de cloudidentiteitsprovider van de gebruiker.\n\nOpmerkingen:\n\nBrave ondersteunt Single sign-on met Extensible Enterprise SSO niet in de incognito- of gastmodus.\n\nBrave ondersteunt Single sign-on met Extensible Enterprise SSO alleen voor de volgende identiteitsproviders: Microsoft, Okta, Ping.\n\nDeze functie is beschikbaar vanaf macOS 10.15.";
ExtensionAllowedTypes.pfm_title = "Typen extensies/apps die mogen worden geïnstalleerd";
ExtensionAllowedTypes.pfm_description = "extension - Extensie\ntheme - Thema\nuser_script - Gebruikersscript\nhosted_app - Gehoste app\nlegacy_packaged_app - Verouderde verpakte-app\nplatform_app - Platform-app\nAls je dit beleid instelt, wordt beheerd welke apps en extensies mogen worden geïnstalleerd in Brave en met welke hosts ze interactie kunnen hebben. Ook wordt de runtime-toegang beperkt.\n\nAls je het beleid niet instelt, bestaan er geen beperkingen voor de geaccepteerde typen extensies en apps.\n\nExtensies en apps van een type dat niet op de lijst staat, worden niet geïnstalleerd. Elke waarde moet een van deze tekenreeksen zijn\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\nRaadpleeg de documentatie over extensies van Brave voor meer informatie over deze typen.\n\nVersies vóór 75 die gebruikmaken van meerdere, door komma's gescheiden extensie-ID's worden niet ondersteund en worden overgeslagen. De rest van het beleid is van toepassing.\n\nOpmerking: Dit beleid is ook van invloed op extensies en apps die afgedwongen worden geïnstalleerd met ExtensionInstallForcelist.\n\nOpmerking: Dit beleid geldt alleen voor platforms die extensies ondersteunen.";
ExtensionDeveloperModeSettings.pfm_title = "De beschikbaarheid van de ontwikkelaarsmodus op de pagina Extensies bepalen";
ExtensionDeveloperModeSettings.pfm_description = "0 - Het gebruik van de ontwikkelaarsmodus op de pagina Extensies toestaan\n1 - Het gebruik van de ontwikkelaarsmodus op de pagina Extensies niet toestaan\nBepaal of gebruikers de ontwikkelaarsmodus kunnen aanzetten via chrome://extensions.\n\nAls je het beleid niet instelt, kunnen gebruikers de ontwikkelaarsmodus aanzetten via de pagina Extensies, tenzij het beleid DeveloperToolsAvailability is ingesteld op DeveloperToolsDisallowed (2).\nAls het beleid is ingesteld op Allow (0), kunnen gebruikers de ontwikkelaarsmodus aanzetten via de pagina Extensies.\nAls je het beleid instelt op Disallow (1), kunnen gebruikers de ontwikkelaarsmodus niet aanzetten via de pagina Extensies.\n\nAls je dit beleid instelt, kan DeveloperToolsAvailability de ontwikkelaarsmodus niet meer beheren via de pagina Extensies.\n\nOpmerking: Dit beleid geldt alleen voor platforms die extensies ondersteunen.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Stel een lijst met oorsprongen in die langdurige toegang op de achtergrond verlenen aan de verbindende extensies.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "Extensies die verbinding maken met een van deze oorsprongen, blijven actief zolang de poort verbonden is.\n\nAls je dit beleid niet instelt, worden de standaardwaarden gebruikt. Dit zijn app-oorsprongen die SDK's aanbieden waarvan bekend is dat ze geen mogelijkheid bieden om een gesloten verbinding opnieuw op te starten met een eerdere status:\n- Smart Card Connector\n- Citrix Receiver (stabiel, bèta, back-up)\n- VMware Horizon (stabiel, bèta)\n\nAls je dit beleid instelt, wordt de standaardwaardelijst uitgebreid met de nieuw ingestelde waarden. Zowel de standaardwaarden als de door het beleid geleverde items bieden een uitzondering voor de verbindende extensies, zolang de poort verbonden is.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Via beleid geïnstalleerde extensies aanzetten die de standaardinstellingen voor zoeken of de pagina Nieuw tabblad overschrijven";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Hiermee bepaal je of via beleid geïnstalleerde extensies (afgedwongen geïnstalleerd of aanbevolen) die de standaard zoekmachine of de instellingen voor de pagina Nieuw tabblad overschrijven, zijn toegestaan in omgevingen met een laag vertrouwen.\n\nDit beleid is alleen van toepassing op omgevingen met weinig vertrouwen (zoals apparaten waarop beleid lokaal is ingesteld zonder domein- of cloudbeheer). Dit heeft geen invloed op omgevingen met een hoog vertrouwensniveau:\n\nIn Microsoft® Windows® is dit beleid niet beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid niet beschikbaar voor instanties die via MDM worden beheerd, via MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.\n\nExtensies die via beleid zijn geïnstalleerd en die de standaard zoekmachine of de instellingen voor de pagina Nieuw tabblad overschrijven, blijven aanstaan in deze instanties met een hoog vertrouwensniveau.\n\nAls je dit beleid toepast, staat Brave toe dat via beleid geïnstalleerde extensies die de instellingen voor de standaard zoekmachine of de pagina Nieuw tabblad overschrijven, worden geïnstalleerd en aan blijven staan in omgevingen met weinig vertrouwen.\n\nAls je dit beleid niet toepast of niet instelt, voorkomt Brave dat via beleid geïnstalleerde extensies die de instellingen voor de standaard zoekmachine of de pagina Nieuw tabblad overschrijven, worden geïnstalleerd in omgevingen met een laag vertrouwensniveau. Ook worden ze verwijderd als ze al zijn geïnstalleerd.\n\nAls een getroffen extensie wordt aangepast zodat deze instellingen niet meer worden overschreven, installeert Brave deze automatisch binnen 7 dagen.\n\nDit is een tijdelijk beleid dat in een toekomstige release wordt verwijderd.";
ExtensionInstallAllowlist.pfm_title = "Extensie-ID's die zijn vrijgesteld van de blokkeringslijst";
ExtensionInstallAllowlist.pfm_description = "Als je het beleid instelt, geef je aan welke extensies niet onder de blokkeerlijst vallen.\n\nDe waarde * op de blokkeerlijst betekent dat alle extensies worden geblokkeerd. Gebruikers kunnen alleen extensies installeren die op de toelatingslijst staan.\n\nStandaard worden alle extensies toegestaan. Maar als je extensies via beleid hebt verboden, gebruik je de lijst met toegestane extensies om dat beleid te wijzigen.\n\nOpmerking: Dit beleid geldt alleen voor platforms die extensies ondersteunen.";
ExtensionInstallBlocklist.pfm_title = "Id's van extensies die de gebruiker niet mag installeren (of '*' voor alle extensies)";
ExtensionInstallBlocklist.pfm_description = "Hiermee kun je aangeven welke extensies gebruikers NIET kunnen installeren. Extensies die al zijn geïnstalleerd, worden uitgezet als ze op de blokkeerlijst staan. De gebruiker kan ze niet weer aanzetten. Als een extensie die is uitgezet op basis van de blokkeerlijst, van die lijst wordt verwijderd, wordt de extensie automatisch weer aangezet.\n\nDe waarde '*' op de blokkeerlijst betekent dat alle extensies standaard worden geblokkeerd. Extensies die expliciet op de toelatingslijst staan, zijn toegestaan als ze zijn ondertekend (verpakt). Alle uitgepakte extensies worden geblokkeerd.\n\nAls je dit beleid niet instelt, kan de gebruiker elke extensie installeren in Brave.\n\nOpmerking: Dit beleid geldt alleen voor platforms die extensies ondersteunen.";
ExtensionInstallForcelist.pfm_title = "ID's voor extensies/apps en URL's voor updates die op de achtergrond moeten worden geïnstalleerd";
ExtensionInstallForcelist.pfm_description = "Als je het beleid instelt, wordt een lijst met apps en extensies gespecificeerd die op de achtergrond worden geïnstalleerd zonder interactie met de gebruiker en die niet kunnen worden verwijderd of uitgezet door gebruikers via de Brave-interface. Rechten worden impliciet verleend, waaronder voor de extensie-API's enterprise.deviceAttributes en enterprise.platformKeys. (Deze 2 API's zijn niet beschikbaar voor apps en extensies die niet afgedwongen zijn geïnstalleerd.)\n\nHoewel Brave probeert te voorkomen dat gebruikers deze extensies verwijderen, maken sommige besturingssystemen het onmogelijk voor Brave om zich goed te verdedigen tegen externe wijzigingen in extensies. Deze poging tot voorkomen is dus een maximale inspanning.\n\nAls je dit beleid niet instelt, worden apps of extensies niet automatisch geïnstalleerd en kunnen gebruikers elke app of extensie in Brave verwijderen.\n\nDit beleid vervangt het beleid ExtensionInstallBlocklist. Als een eerder afgedwongen geïnstalleerde app of extensie wordt verwijderd uit deze lijst, verwijdert Brave de app of extensie automatisch.\n\nGebruikers kunnen de broncode van een extensie wijzigen via de tools voor ontwikkelaars, waardoor de extensie misschien niet meer functioneert. Als je je hierover zorgen maakt, stel je het beleid DeveloperToolsDisabled in.\n\nElk lijstitem van het beleid is een tekenreeks die een extensie-ID en optioneel een update-URL bevat, gescheiden door een puntkomma (;). De extensie-ID is de tekenreeks van 32 letters die bijvoorbeeld op chrome://extensions kan worden gevonden als de ontwikkelaarsmodus actief is. De update-URL, indien aangegeven, moet verwijzen naar een XML-updatedocument voor het manifest ( https://developer.chrome.com/extensions/autoupdate ). De update-URL moet een van de volgende schema's gebruiken: http, https of file. Standaard wordt de update-URL van de Chrome Web Store gebruikt. De update-URL die in dit beleid is ingesteld, wordt alleen voor de eerste installatie gebruikt. Daaropvolgende updates van de extensie gebruiken de update-URL die in het manifest van de extensie wordt aangegeven. De update-URL voor volgende updates kan worden overschreven door het beleid ExtensionSettings. Zie http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy.\n\nIn Microsoft® Windows® kunnen instanties, apps en extensies van buiten de Chrome Web Store alleen afgedwongen worden geïnstalleerd als de instantie is gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of is ingeschreven voor Chrome Enterprise Core.\n\nIn macOS kunnen instanties, apps en extensies van buiten de Chrome Web Store alleen afgedwongen worden geïnstalleerd als de instantie wordt beheerd via MDM, via MCX aan een domein is gekoppeld of is ingeschreven voor Chrome Enterprise Core.\n\nOpmerking: Dit beleid is niet van toepassing op de incognitomodus. Lees meer informatie over het hosten van extensies ( https://developer.chrome.com/extensions/hosting ).\n\nOpmerking: Dit beleid is alleen van toepassing op platforms die extensies ondersteunen.";
ExtensionInstallSources.pfm_title = "URL-patronen om de installatie van extensies, apps en gebruikersscripts toe te staan vanaf";
ExtensionInstallSources.pfm_description = "Als je dit beleid instelt, kun je aangeven welke URL's extensies, apps en thema's mogen installeren. Vóór Brave 21 konden gebruikers op een link naar een *.crx-bestand klikken en bood Brave aan het bestand te installeren na een aantal waarschuwingen. Sindsdien moeten bestanden worden gedownload en naar de instellingenpagina van Brave worden gesleept. Met deze instelling kunnen specifieke URL's het oude, eenvoudigere installatieproces gebruiken.\n\nElk item in deze lijst is een patroon van een extensie (zie https://developer.chrome.com/extensions/match_patterns). Gebruikers kunnen makkelijk items installeren vanaf elke URL die overeenkomt met een item in deze lijst. De locatie van het *.crx-bestand en de pagina waar de download wordt gestart (de verwijzer genoemd), moeten beide zijn toegestaan op basis van deze patronen.\n\nExtensionInstallBlocklist krijgt voorrang boven dit beleid. Dat betekent dat een extensie op de blokkeerlijst niet wordt geïnstalleerd, zelfs niet als dit gebeurt vanaf een site op deze lijst.\n\nOpmerking: Dit beleid geldt alleen voor platforms die extensies ondersteunen.";
ExtensionInstallTypeBlocklist.pfm_title = "Blokkeerlijst voor installatietypen van extensies";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Voorkomen dat extensies worden geladen via de opdrachtregel\nDe blokkeerlijst bepaalt welke typen extensies niet zijn toegestaan.\n\nAls je 'command_line' instelt, kan de extensie niet worden geladen via de opdrachtregel.";
ExtensionReviewPromptsEnabled.pfm_title = "Prompts voor extensiereviews en links voor beoordelingen beheren";
ExtensionReviewPromptsEnabled.pfm_description = "Bepaalt of systeemeigen reviewprompts en beoordelingslinks (zoals Beoordelen) voor geïnstalleerde Chrome-extensies beschikbaar zijn in Chrome-gebruikersinterfaces.\n\nAls je dit beleid toepast of niet instelt, kunnen gebruikers systeemeigen toegangspunten zien om in aanmerking komende extensies te beoordelen en te beoordelen in de werkbalk, contextmenu's en de pagina voor extensiebeheer (chrome://extensions).\n\nAls je dit beleid niet toepast, worden alle systeemeigen reviewprompts en beoordelingslinks onderdrukt en zijn ze niet beschikbaar.";
ExtensionSettings.pfm_title = "Instellingen voor extensiebeheer";
ExtensionSettings.pfm_description = "Als je dit beleid instelt, worden de extensiebeheerinstellingen voor Brave beheerd, waaronder instellingen die worden beheerd door bestaande, aan extensies gerelateerde beleidsregels.\n\nMet dit beleid wordt alleen een extensie-ID of een update-URL toegewezen aan de bijbehorende specifieke instelling. Er kan een standaardconfiguratie worden ingesteld voor de speciale ID \"*\", die van toepassing is op alle extensies waarvoor geen aangepaste configuratie is ingesteld in dit beleid.\n\nDit beleid kan de configuratie per extensie uit oudere beleidsregels overschrijven.\n\nInstellingen voor extensies per ID van ExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist of ExtensionSettings nemen alleen de standaardinstellingen voor \"*\" over voor installation_mode en update_url. De property neemt geen andere property's over. Bij een update-URL is de configuratie van toepassing op alle extensies met de exacte update-URL die wordt vermeld in het manifest van de extensie (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy). Als de flag override_update_url is ingesteld op Waar, wordt de extensie geïnstalleerd en aangepast met de update-URL die is gespecificeerd in het beleid ExtensionInstallForcelist of in het veld update_url in dit beleid. De markering override_update_url wordt genegeerd als de update_url een URL voor de Chrome Web Store is.\n\nVanaf Brave versie 154 wordt 'chrome.debugger.attach()' volledig uitgezet voor alle doelen als je 'runtime_blocked_hosts' toepast op een extensie met het recht 'debugger'.\n\nIn Microsoft® Windows® kunnen instanties, apps en extensies van buiten de Chrome Web Store alleen afgedwongen worden geïnstalleerd als de instantie is gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of is ingeschreven voor Chrome Enterprise Core.\n\nIn macOS kunnen instanties, apps en extensies van buiten de Chrome Web Store alleen afgedwongen worden geïnstalleerd als de instantie wordt beheerd via MDM, via MCX aan een domein is gekoppeld of is ingeschreven voor Chrome Enterprise Core.\n\nOpmerking: Dit beleid geldt alleen voor platforms die extensies ondersteunen.\nGa naar https://chromeenterprise.google/policies/?policy=ExtensionSettings voor meer informatie over schema en indeling.";
ExtensionUnpublishedAvailability.pfm_title = "De beschikbaarheid bepalen van extensies in de Chrome Web Store waarvan de publicatie ongedaan is gemaakt.";
ExtensionUnpublishedAvailability.pfm_description = "0 - Extensies toestaan waarvan de publicatie ongedaan is gemaakt\n1 - Niet-gepubliceerde extensies uitzetten\nAls je dit beleid toepast, worden extensies waarvan de publicatie ongedaan is gemaakt in de Chrome Web Store uitgezet in Brave.\nDit beleid geldt alleen voor extensies die zijn geïnstalleerd en geüpdatet via de Chrome Web Store.\n\nExtensies van buiten de Chrome Web Store, zoals uitgepakte extensies die zijn geïnstalleerd via de ontwikkelaarsmodus en extensies die zijn geïnstalleerd met de opdrachtregelschakelaar, worden genegeerd.\nAfgedwongen geïnstalleerde extensies die zelf worden gehost, worden genegeerd. Alle vastgezette extensies worden ook genegeerd.\n\nAls je het beleid instelt op AllowUnpublished (0) of niet instelt, zijn extensies toegestaan waarvan de publicatie ongedaan is gemaakt in de Chrome Web Store.\nAls je het beleid instelt op DisableUnpublished (1), worden extensies uitgezet waarvan de publicatie ongedaan is gemaakt in de Chrome Web Store.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Het selectievakje 'Altijd openen' tonen in dialoogvensters voor externe protocollen.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Met dit beleid wordt bepaald of het selectievakje 'Altijd openen' moet worden getoond in bevestigingsprompts voor externe protocolactivering.\n\n     Als dit beleid is ingesteld op True of niet is ingesteld, kan de gebruiker, als er een bevestiging van een extern protocol wordt getoond, 'Altijd toestaan' selecteren om alle toekomstige bevestigingsprompts voor het protocol op deze site over te slaan.\n\n     Als dit beleid is ingesteld op False, wordt het selectievakje 'Altijd toestaan' niet getoond en krijgt de gebruiker elke keer als er een extern protocol wordt aangeroepen een prompt.";
FeedbackSurveysEnabled.pfm_title = "Hiermee bepaal je of Brave-enquêtes in het product rechtstreeks aan gebruikers worden getoond.";
FeedbackSurveysEnabled.pfm_description = "Brave-enquêtes in het product verzamelen gebruikersfeedback voor de browser. De enquête-antwoorden worden niet gekoppeld aan gebruikersaccounts.\nAls je dit beleid toepast of niet instelt, kunnen in het product enquêtes aan gebruikers worden getoond.\nAls je dit beleid niet toepast, worden er geen enquêtes in het product aan gebruikers getoond.\n\nDit beleid heeft geen effect als MetricsReportingEnabled uitstaat, waardoor enquêtes in het product ook worden uitgezet.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Keepalive-duur bij afsluiten ophalen";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Beheert hoelang (in seconden) keepalive-verzoeken toegestaan blijven als de browser wordt afgesloten.\n\nAls hiervoor een waarde is opgegeven, wordt gedurende het opgegeven aantal seconden voorkomen dat de browser afsluit, zodat keepalive-verzoeken (https://fetch.spec.whatwg.org/#request-keepalive-flag) kunnen worden verwerkt.\n\nDe standaardwaarde (0) betekent dat deze functie niet wordt gebruikt.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Toestaan dat API's voor bestands- of directorykiezers worden aangeroepen zonder eerder gebruikersgebaar";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "Om veiligheidsredenen moet voor de web-API's showOpenFilePicker(), showSaveFilePicker() en showDirectoryPicker() een eerder gebruikersgebaar ('tijdelijke activering') worden aangeroepen, anders mislukken deze.\n\nAls dit beleid is ingesteld, kunnen beheerders oorsprongen specificeren waarvoor deze API's kunnen worden aangeroepen zonder eerder gebruikersgebaar.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige URL-patronen. * is geen geaccepteerde waarde voor dit beleid.\n\nAls je dit beleid niet instelt, is voor alle oorsprongen een eerder gebruikersgebaar vereist om deze API's aan te roepen.";
FileSystemReadAskForUrls.pfm_title = "Alleen leestoegang via de File System API toestaan op deze sites";
FileSystemReadAskForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om op te geven welke sites gebruikers mogen vragen om hun leestoegang te geven tot bestanden en directory's in het bestandssysteem van het besturingssysteem van de host via de File System API.\n\nAls je het beleid niet instelt, is DefaultFileSystemReadGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van gebruikers.\n\nURL-patronen mogen geen conflict vormen met FileSystemReadBlockedForUrls. Geen van beide beleidsregels krijgt voorrang als een URL met beide overeenkomt.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
FileSystemReadBlockedForUrls.pfm_title = "Leestoegang via de File System API toestaan op deze sites";
FileSystemReadBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om aan te geven welke sites gebruikers niet mogen vragen om hun leestoegang te geven tot bestanden en directory's in het bestandssysteem van het besturingssysteem van de host via de File System API.\n\nAls je het beleid niet instelt, is DefaultFileSystemReadGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van gebruikers.\n\nURL-patronen mogen geen conflict vormen met FileSystemReadAskForUrls. Geen van beide beleidsregels krijgt voorrang als een URL met beide overeenkomt.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
FileSystemWriteAskForUrls.pfm_title = "Schrijftoegang tot bestanden en directory's voor deze sites toestaan";
FileSystemWriteAskForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om op te geven welke sites gebruikers mogen vragen om hun schrijftoegang te geven tot bestanden en directory's in het bestandssysteem van het besturingssysteem.\n\nAls je het beleid niet instelt, is DefaultFileSystemWriteGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van gebruikers.\n\nURL-patronen mogen geen conflict vormen met FileSystemWriteBlockedForUrls. Geen van beide beleidsregels krijgt voorrang als een URL met beide overeenkomt.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
FileSystemWriteBlockedForUrls.pfm_title = "Schrijftoegang tot bestanden en directory's voor deze sites blokkeren";
FileSystemWriteBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om op te geven welke sites gebruikers niet mogen vragen om hun schrijftoegang te geven tot bestanden en directory's in het bestandssysteem van het besturingssysteem.\n\nAls je het beleid niet instelt, is DefaultFileSystemWriteGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van gebruikers.\n\nURL-patronen mogen geen conflict vormen met FileSystemWriteAskForUrls. Geen van beide beleidsregels krijgt voorrang als een URL met beide overeenkomt.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
ForceEphemeralProfiles.pfm_title = "Kort geldig profiel";
ForceEphemeralProfiles.pfm_description = "Als dit beleid is toegepast, schakelt het profiel gedwongen over naar de kort geldige modus. Als dit beleid als OS-beleid wordt ingesteld (bijv. GPO in Windows), is het van toepassing op elk profiel in het systeem. Als het beleid als cloudbeleid is ingesteld, is het alleen van toepassing op een profiel waarop met een beheerd account is ingelogd.\n\nIn deze modus worden de profielgegevens alleen voor de duur van de gebruikerssessie opgeslagen op de schijf. Functies als browsergeschiedenis, extensies en de bijbehorende gegevens, webgegevens (zoals cookies) en webdatabases blijven niet behouden nadat de browser is gesloten. Hierdoor wordt echter niet voorkomen dat de gebruiker handmatig gegevens naar de schijf kan downloaden of pagina's kan opslaan of afdrukken.\n\nAls de gebruiker synchronisatie heeft aangezet, worden al deze gegevens bewaard in het synchronisatieprofiel van de gebruiker, net als bij gewone profielen. De incognitomodus is ook beschikbaar als deze niet expliciet door een beleid is uitgezet.\n\nAls het beleid niet is toegepast of niet is ingesteld, leidt inloggen tot het gebruik van gewone profielen.";
ForceForegroundPriorityForAllTabs.pfm_title = "Voorgrondprioriteit afdwingen voor alle tabbladen";
ForceForegroundPriorityForAllTabs.pfm_description = "Met dit beleid bepaal je of webcontent op de achtergrond moet worden uitgevoerd met prioriteit op de voorgrond.\n\nDe browser optimaliseert standaard resources door content op tabbladen op de achtergrond minder prioriteit te geven. Als je dit beleid aanzet, wordt dat gedrag overschreven en worden achtergrondtabbladen op dezelfde manier gepland als het actieve tabblad.\n\nAls je achtergrondcontent dwingt om te worden uitgevoerd met voorgrondprioriteit, kan dit de reactiesnelheid van het actieve tabblad enigszins beïnvloeden.\n\nAls je dit beleid toepast, wordt alle webcontent uitgevoerd met prioriteit op de voorgrond, ongeacht de zichtbaarheidsstatus.\n\nAls je dit beleid niet toepast of niet instelt, bepaalt de browser de prioriteit op basis van standaardheuristiek (bijvoorbeeld door content met een lagere prioriteit te geven die niet zichtbaar is, geen audio afspeelt of niet deelneemt aan videogesprekken).";
ForceForegroundPriorityForUrls.pfm_title = "Voorgrondprioriteit afdwingen voor specifieke URL's";
ForceForegroundPriorityForUrls.pfm_description = "Met dit beleid kun je een lijst met URL-patronen instellen. Webcontent op de achtergrond die overeenkomt met deze patronen, wordt gedwongen uitgevoerd met prioriteit op de voorgrond.\n\nAls je het beleid ForceForegroundPriorityForAllTabs toepast, wordt deze lijst genegeerd omdat alle tabbladen prioriteit op de voorgrond krijgen.\n\nAls ForceForegroundPriorityForAllTabs uitstaat of niet is ingesteld, wordt alleen content die overeenkomt met de patronen in deze lijst geforceerd.\n\nGa naar https://support.google.com/chrome/a?p=url_blocklist_filter_format voor uitgebreide informatie over geldige URL-patronen.\n\nAls deze lijst leeg is of niet is ingesteld, wordt er geen achtergrondcontent uitgevoerd met prioriteit op de voorgrond.";
ForceGoogleSafeSearch.pfm_title = "Google SafeSearch afdwingen";
ForceGoogleSafeSearch.pfm_description = "Als je dit beleid toepast, is SafeSearch in Google Zoeken altijd actief. Gebruikers kunnen deze instelling niet wijzigen.\n\nAls je dit beleid niet toepast of niet instelt, wordt SafeSearch in Google Zoeken niet afgedwongen.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "Bepaalt of unload-gebeurtenishandlers kunnen worden uitgezet.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "unload-gebeurtenishandlers worden beëindigd. Of ze worden geactiveerd, is afhankelijk van de unload Permissions-Policy. Op dit moment worden ze standaard toegestaan op basis van beleid. In de toekomst worden ze geleidelijk omgezet naar standaard niet toegestaan en moeten sites ze expliciet aanzetten via Permissions-Policy-headers. Dit zakelijke beleid kan worden gebruikt om je af te melden voor deze geleidelijke beëindiging door af te dwingen dat de standaardinstelling actief blijft.\n\nPagina's kunnen afhankelijk zijn van unload-gebeurtenishandlers om gegevens op te slaan of het einde van een gebruikerssessie aan te geven aan de server. Dit wordt afgeraden omdat het onbetrouwbaar is en de prestaties beïnvloedt door het gebruik van BackForwardCache te blokkeren. Er zijn aanbevolen alternatieven, maar de gebeurtenis unload wordt al lange tijd gebruikt. Sommige apps zijn misschien nog steeds hiervan afhankelijk.\n\nAls je dit beleid instelt op onwaar of niet instelt, worden de unload-gebeurtenishandlers geleidelijk beëindigd, in overeenkomst met de uitrol van de beëindiging. Sites die geen Permissions-Policy-header instellen, stoppen met de activering van unload-gebeurtenissen.\n\nAls je dit beleid instelt op waar, blijven unload-gebeurtenishandlers standaard werken.\n\nOPMERKING: Dit beleid had de onjuist gedocumenteerde standaardwaarde 'waar' in M117. De unload-gebeurtenis is en wordt niet gewijzigd in M117, dus dit beleid heeft geen effect in die versie.\n";
ForceYouTubeRestrict.pfm_title = "Minimale beperkte modus op YouTube afdwingen";
ForceYouTubeRestrict.pfm_description = "0 - Beperkte modus niet afdwingen op YouTube\n1 - Minimaal de gemiddelde beperkte modus op YouTube afdwingen\n2 - Strenge beperkte modus afdwingen voor YouTube\nAls je het beleid instelt, wordt een minimale beperkte modus op YouTube afgedwongen en kunnen gebruikers geen minder beperkte modus kiezen. Als je het instelt op:\n\n* Streng, is de strenge beperkte modus in YouTube altijd actief.\n\n* Gemiddeld, kan de gebruiker alleen de gemiddelde beperkte modus en de strenge beperkte modus selecteren op YouTube, maar kan de gebruiker de beperkte modus niet uitzetten.\n\n* Uit of als je geen waarde instelt, wordt de beperkte modus op YouTube niet afgedwongen door Chrome. De beperkte modus kan nog wel steeds worden afgedwongen door externe beleidsregels zoals het YouTube-beleid.";
ForcedLanguages.pfm_title = "Voorkeurstalen en hun volgorde instellen";
ForcedLanguages.pfm_description = "Met dit beleid kunnen beheerders de volgorde instellen van de voorkeurstalen in de instellingen van Brave.\n\nDe lijst wordt in dezelfde volgorde getoond in het gedeelte Talen rangschikken op basis van je voorkeur op chrome://settings/languages. Gebruikers kunnen talen die door het beleid zijn ingesteld niet verwijderen of anders indelen. Ze kunnen wel extra talen toevoegen onder de talen die door het beleid zijn ingesteld. Gebruikers hebben ook de volledige controle over de UI-taal van de browser en instellingen voor vertaling/spellingcontrole, tenzij die door ander beleid worden afgedwongen.\n\nAls je het beleid niet instelt, kunnen gebruikers de hele lijst met voorkeurstalen aanpassen.";
GeminiActOnWebAllowedForURLs.pfm_title = "Toestaan dat Gemini-app-integraties rechtstreeks acties uitvoeren op aangegeven sites";
GeminiActOnWebAllowedForURLs.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen om aan te geven op welke sites Gemini-app-integraties rechtstreeks acties kunnen uitvoeren op webpagina's.\n\nURL's die niet overeenkomen met de toelatingslijst of de blokkeerlijst, gebruiken GeminiActOnWebSettings.\n\nURL's die overeenkomen met zowel de toelatingslijst als de blokkeerlijst, zijn toegestaan.\n\nGa naar https://support.google.com/chrome/a?p=url_blocklist_filter_format voor uitgebreide informatie over geldige URL-patronen.";
GeminiActOnWebBlockedForURLs.pfm_title = "Niet toestaan dat Gemini-app-integraties rechtstreeks acties uitvoeren op aangegeven sites";
GeminiActOnWebBlockedForURLs.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen om aan te geven op welke sites Gemini-app-integraties niet rechtstreeks acties kunnen uitvoeren op webpagina's.\n\nURL's die niet overeenkomen met de toelatingslijst of de blokkeerlijst, gebruiken GeminiActOnWebSettings.\n\nURL's die overeenkomen met zowel de toelatingslijst als de blokkeerlijst, zijn toegestaan.\n\nGa naar https://support.google.com/chrome/a?p=url_blocklist_filter_format voor uitgebreide informatie over geldige URL-patronen.";
GeminiActOnWebSettings.pfm_title = "Hiermee kunnen Gemini-app-integraties rechtstreeks acties uitvoeren op webpagina's";
GeminiActOnWebSettings.pfm_description = "0 - Toestaan dat de Gemini-app actie onderneemt op de webpagina's.\n1 - De Gemini-app niet toestaan om actie te ondernemen op de webpagina's.\nHiermee bepaal je of de Gemini-app actie mag ondernemen op de webpagina's namens de gebruiker.\n\n0/niet ingesteld = De Gemini-app mag actie ondernemen op de webpagina's.\n\n1 = De Gemini-app mag geen actie ondernemen op de webpagina's.\n\nDit beleid heeft geen effect als de Gemini-app is uitgezet. De Gemini-app kan bijvoorbeeld worden uitgezet met het beleid GeminiSettings.\n\nGa voor meer informatie over Gemini in Chrome naar https://support.google.com/chrome/a/answer/16291696.\n\nActivering van Gemini is niet in alle landen of talen beschikbaar. Als je dit beleid instelt, garandeert dit niet dat de functie wordt aangezet. De functie blijft afhankelijk van de beschikbaarheid. Check de release-opmerkingen voor Chrome Enterprise voor meer informatie over de uitrol: https://support.google.com/chrome/a/answer/7679408?hl=nl";
GeminiSettings.pfm_title = "Instellingen voor Gemini-integratie";
GeminiSettings.pfm_description = "0 - Gemini-integraties toestaan\n1 - Gemini-integraties niet toestaan\nMet deze instelling worden Gemini-app-integraties toegestaan.\n\n0 = Gemini-integratie is beschikbaar voor gebruikers.\n\n1 = Gemini-integratie is niet beschikbaar voor gebruikers.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nGa voor meer informatie naar het Helpcentrum-artikel https://support.google.com/chrome/a?p=gemini_in_chrome.";
GeminiSparkSettings.pfm_title = "Hiermee kan Gemini Spark verbinding maken met Brave en automatisch browsen gebruiken via Gemini in Chrome";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark mag verbinding maken met en van automatisch browsen gebruiken in Brave.\n1 - Gemini Spark mag geen verbinding maken met of automatisch gebruiken browsen in Brave.\nHiermee bepaal je of de Gemini Spark-agent verbinding mag maken met Brave en automatisch browsen mag gebruiken. Gemini Spark is misschien niet beschikbaar voor je organisatie.\n\n0 = Gemini Spark mag verbinding maken met en automatisch browsen gebruiken in Brave\n\n1 = Gemini Spark mag geen verbinding maken met of automatisch browsen gebruiken in Brave\n\nWaarschuwing: Als je Gemini Spark toestaat verbinding te maken met Brave en automatisch browsen te gebruiken, kan de Gemini Spark-agent zelfstandige acties in meerdere stappen uitvoeren op Brave-clients met de actieve browsersessie. Dit brengt aanzienlijke beveiligingsrisico's met zich mee, waaronder risico's voor inloggegevens, toegang tot het lokale netwerk en verlies van contextafhankelijke signalen. Bestaande beheer- en beveiligingsfuncties worden misschien niet gerespecteerd.\n\nWe raden beheerders aan het model voor netwerkdreigingen, de nalevingsrichtlijnen en de privacyrichtlijnen van hun organisatie zorgvuldig te evalueren voordat ze deze functie aanzetten.\n\nDit beleid heeft geen effect als de beleidsregels voor de Google Gemini-app of automatisch browsen in Brave uitstaan. De Google Gemini-app kan bijvoorbeeld worden uitgezet met het beleid GeminiSettings. Ga voor meer informatie over Google Gemini in Brave naar https://support.google.com/chrome/a?p=gemini_in_chrome.\n\nAutomatisch browsen in Brave en Gemini Spark zijn niet in alle landen of alle talen beschikbaar. Als je dit beleid instelt op 0 - Enabled (Aan), garandeert dit niet dat de functie wordt aangezet. De functie blijft afhankelijk van de beschikbaarheid. Check de release-opmerkingen voor Chrome Enterprise voor meer informatie over de uitrol: https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Instellingen voor lokaal basismodel van GenAI";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Het model automatisch downloaden\n1 - Model niet downloaden\nStel in hoe Brave het basismodel voor generatieve AI downloadt en lokaal gebruikt voor inferentie.\n\nAls je het beleid toepast (0) of niet instelt, wordt het model automatisch gedownload en gebruikt voor inferentie.\n\nAls je het beleid niet toepast (1), wordt het model niet gedownload en wordt het bestaande model (als het al is gedownload) verwijderd.\n\nOp desktopplatforms kan het downloaden van modellen ook worden uitgezet door ComponentUpdatesEnabled in te stellen op onwaar.";
GeolocationBlockedForUrls.pfm_title = "Geolocatie blokkeren op deze sites";
GeolocationBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen voor sites die geen toegang tot de geolocatie van de gebruiker hebben en die de gebruiker ook niet om toestemming kunnen vragen.\n\nAls je het beleid niet instelt, is DefaultGeolocationSetting van toepassing op alle sites (als dit is ingesteld). Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "HTTP auth-cache met wereldwijd bereik aanzetten";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Met dit beleid configureer je één globaal cachegeheugen per profiel met HTTP-serververificatiegegevens.\n\nAls je dit beleid niet instelt of niet toepast, gebruikt de browser het standaardgedrag van verificatie voor meerdere sites (cross-site auth), die HTTP-serververificatiegegevens per site op het hoogste niveau in kaart brengt. Dit betekent dat als twee sites bronnen van hetzelfde verificatiedomein gebruiken, de verificatiegegevens onafhankelijk van elkaar moeten worden doorgegeven binnen de context van beide sites. Proxygegevens in het cachegeheugen worden hergebruikt op de andere sites.\n\nAls je het beleid toepast, worden HTTP-verificatiegegevens die binnen de context van één site worden ingevoerd, automatisch gebruikt binnen de context van een andere site.\n\nAls je dit beleid toepast, blijven sites blootstaan aan bepaalde typen cross-site aanvallen en kunnen gebruikers ook zonder gebruik van cookies van site naar site worden gevolgd door het toevoegen van items aan het HTTP-verificatiecachegeheugen via gegevens die zijn ingesloten in URL's.\n\nDit beleid is bedoeld om bedrijven die afhankelijk zijn van het oude gedrag in de gelegenheid te stellen hun inlogprocedures te updaten. Het beleid wordt in de toekomst verwijderd.";
GoogleSearchSidePanelEnabled.pfm_title = "Google Search Side Panel aanzetten";
GoogleSearchSidePanelEnabled.pfm_description = "Als je dit beleid toepast of niet instelt, is Google Search Side Panel toegestaan op alle webpagina's.\n\nAls je dit beleid niet toepast, is Google Search Side Panel op geen enkele webpagina beschikbaar.\n\nGenAI-mogelijkheden die deel uitmaken van deze functie, zijn niet beschikbaar voor Education- of Enterprise-accounts.";
HSTSPolicyBypassList.pfm_title = "Lijst met namen die de controle van het HSTS-beleid overslaan";
HSTSPolicyBypassList.pfm_description = "Als je het beleid instelt, geef je een lijst op met hostnamen die de vooraf geladen HSTS-upgrades van http naar https omzeilen.\n\nIn dit beleid zijn alleen hostnamen met 1 label toegestaan. Dit beleid is alleen van toepassing op 'statische' vooraf geladen HSTS-items (bijvoorbeeld \"app\", \"new\", \"search\", \"play\"). Dit beleid verhindert geen HSTS-upgrades voor servers met 'dynamisch' aangevraagde HSTS-upgrades met een Strict-Transport-Security-reactiekop.\n\nDe opgegeven hostnamen moeten een canonieke URL hebben. Eventuele IDN's moeten worden omgezet naar de A-labelindeling en alle ASCII-letters moeten kleine letters zijn. Dit beleid is alleen van toepassing op de specifiek vermelde hostnamen met 1 label en niet op de subdomeinen van die namen.";
HappyEyeballsV3Enabled.pfm_title = "Het algoritme Happy Eyeballs V3 gebruiken";
HappyEyeballsV3Enabled.pfm_description = "Met deze functie kan het algoritme Happy Eyeballs V3 verbindingspogingen uitvoeren. Zie https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3 voor meer informatie.\n\nAls je het beleid toepast, gebruikt Brave het algoritme Happy Eyeballs V3 voor verbindingspogingen.\n\nAls je het beleid niet toepast, wordt het algoritme Happy Eyeballs V3 uitgezet.\n\nAls je het beleid niet instelt, zet Brave het algoritme Happy Eyeballs V3 aan of uit op basis van chrome://flags/#happy-eyeballs-v3.\n\nDit beleid ondersteunt dynamische vernieuwing.\n\nDit beleid is een tijdelijke maatregel en wordt verwijderd in toekomstige versies van Brave.";
HardwareAccelerationModeEnabled.pfm_title = "Grafische versnelling gebruiken indien beschikbaar";
HardwareAccelerationModeEnabled.pfm_description = "Als je dit beleid toepast of niet instelt, wordt grafische versnelling gebruikt als dit beschikbaar is.\n\nAls je het beleid niet toepast, wordt grafische versnelling niet gebruikt.";
HeadlessMode.pfm_title = "Gebruik van de stand zonder interface beheer";
HeadlessMode.pfm_description = "1 - Gebruik van de stand zonder interface toestaan\n2 - Gebruik van de stand zonder interface niet toestaan\nAls je het beleid instelt op Enabled of niet instelt, sta je het gebruik van de stand zonder interface toe. Als je het beleid instelt op Disabled, sta je het gebruik van de stand zonder interface niet toe.";
HelpMeWriteSettings.pfm_title = "Instellingen voor Help me met schrijven";
HelpMeWriteSettings.pfm_description = "0 - Sta Help me met schrijven toe en verbeter AI-modellen.\n1 - Sta Help me met schrijven toe zonder AI-modellen te verbeteren.\n2 - Sta Help me met schrijven niet toe.\nHelp me met schrijven is een op AI gebaseerde schrijfassistent voor korte content op het web. Voorgestelde content is gebaseerd op prompts die de gebruiker heeft ingevoerd en de content van de webpagina.\n\n0 = Hiermee wordt toegestaan dat de functie wordt gebruikt en dat Google relevante gegevens gebruikt om de AI-modellen te verbeteren. Relevante gegevens kunnen prompts, invoer, uitvoer, bronmateriaal en geschreven feedback zijn, afhankelijk van de functie. De gegevens kunnen ook door mensen worden beoordeeld om AI-modellen te verbeteren. 0 is de standaardwaarde, behalve zoals hieronder aangegeven.\n\n1 = Hiermee wordt toegestaan dat de functie wordt gebruikt, maar wordt niet toegestaan dat Google modellen verbetert met content van gebruikers (waaronder prompts, invoer, uitvoer, bronmateriaal en geschreven feedback). 1 is de standaardwaarde voor zakelijke gebruikers die worden beheerd via Google Admin console en voor onderwijsaccounts die worden beheerd via Google Workspace.\n\n2 = Hiermee wordt de functie niet toegestaan.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
HideWebStoreIcon.pfm_title = "De Web Store verbergen op de pagina 'Nieuw tabblad' en in de App Launcher";
HideWebStoreIcon.pfm_description = "De app en voettekstlink voor de Chrome Web Store verbergen op de pagina 'Nieuw tabblad' en in de App Launcher van Google Chrome OS.\n\nAls dit beleid is ingesteld op 'True', zijn de pictogrammen verborgen.\n\nAls dit beleid is ingesteld op 'False' of niet is ingesteld, zijn de pictogrammen zichtbaar.";
HighEfficiencyModeEnabled.pfm_title = "Modus voor hoge efficiëntie aanzetten";
HighEfficiencyModeEnabled.pfm_description = "Met dit beleid kun je de modus voor hoge efficiëntie aan- of uitzetten. Door deze instelling worden tabbladen na een bepaalde tijd op de achtergrond verwijderd om geheugen vrij te maken.\nAls je dit beleid niet instelt, kan de eindgebruiker deze instelling beheren in chrome://settings/performance.\n";
HistoryClustersVisible.pfm_title = "Een weergave van de Chrome-geschiedenis met groepen pagina's tonen";
HistoryClustersVisible.pfm_description = "Met dit beleid bepaal je de zichtbaarheid van Chrome-geschiedenispagina's die zijn ingedeeld in groepen pagina's.\n\nAls je het beleid toepast, is een Chrome-geschiedenispagina die is ingedeeld in groepen zichtbaar op chrome://history/grouped.\n\nAls je het beleid niet toepast, is een Chrome-geschiedenispagina die is ingedeeld in groepen niet zichtbaar op chrome://history/grouped.\n\nAls je het beleid niet instelt, is een Chrome-geschiedenispagina die is ingedeeld in groepen standaard zichtbaar op chrome://history/grouped.\n\nAls het beleid ComponentUpdatesEnabled niet wordt toegepast, maar HistoryClustersVisible wel wordt toegepast of niet is ingesteld, is een Chrome-geschiedenispagina die is ingedeeld in groepen nog steeds beschikbaar op chrome://history/grouped, maar is die misschien minder relevant voor de gebruiker.\n";
HistorySearchSettings.pfm_title = "Instellingen voor AI-gestuurd zoeken in geschiedenis";
HistorySearchSettings.pfm_description = "0 - Sta AI-gestuurd zoeken in geschiedenis toe en verbeter AI-modellen.\n1 - Sta AI-gestuurd zoeken in geschiedenis toe zonder AI-modellen te verbeteren.\n2 - Sta AI-gestuurd zoeken in geschiedenis niet toe.\nAI-gestuurd zoeken in geschiedenis is een functie waarmee gebruikers in hun browsegeschiedenis kunnen zoeken en gegenereerde antwoorden kunnen krijgen op basis van paginacontent, niet alleen op basis van de paginatitel en -URL.\n\n0 = Hiermee wordt toegestaan dat de functie wordt gebruikt en dat Google relevante gegevens gebruikt om de AI-modellen te verbeteren. Relevante gegevens kunnen prompts, invoer, uitvoer, bronmateriaal en geschreven feedback zijn, afhankelijk van de functie. De gegevens kunnen ook door mensen worden beoordeeld om AI-modellen te verbeteren. 0 is de standaardwaarde, behalve zoals hieronder aangegeven.\n\n1 = Hiermee wordt toegestaan dat de functie wordt gebruikt, maar wordt niet toegestaan dat Google modellen verbetert met content van gebruikers (waaronder prompts, invoer, uitvoer, bronmateriaal en geschreven feedback). 1 is de standaardwaarde voor zakelijke gebruikers die worden beheerd via Google Admin console en voor onderwijsaccounts die worden beheerd via Google Workspace.\n\n2 = Hiermee wordt de functie niet toegestaan.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
HomepageIsNewTabPage.pfm_title = "De pagina 'Nieuw tabblad' als homepage gebruiken";
HomepageIsNewTabPage.pfm_description = "Als je het beleid toepast, wordt de pagina Nieuw tabblad gebruikt als homepage van de gebruiker en wordt de URL voor de homepage genegeerd. Als je het beleid niet toepast, wordt de pagina Nieuw tabblad nooit gebruikt als homepage van de gebruiker, tenzij de URL voor de homepage is ingesteld op chrome://newtab.\n\nAls je het beleid instelt, kunnen gebruikers het type homepage niet wijzigen in Brave. Als je dit beleid niet instelt, kan de gebruiker bepalen of de pagina Nieuw tabblad als homepage wordt gebruikt.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
HomepageLocation.pfm_title = "URL van homepage";
HomepageLocation.pfm_description = "Als je het beleid instelt, wordt de standaard-URL voor de homepage ingesteld in Brave. Je kunt de homepage openen met de knop Homepage. Op desktops bepaalt het beleid RestoreOnStartup welke pagina's worden geopend als de browser wordt opgestart.\n\nAls de homepage niet is ingesteld op de pagina Nieuw tabblad (door de gebruiker of HomepageIsNewTabPage), heeft dit beleid geen effect.\n\nDe URL heeft een standaardschema nodig, zoals http://example.com of https://example.com. Als dit beleid is ingesteld, kunnen gebruikers de URL van de homepage niet wijzigen in Brave.\n\nAls je HomepageLocation en HomepageIsNewTabPage geen van beide instelt, kunnen gebruikers hun homepage kiezen.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
HttpAllowlist.pfm_title = "HTTP-toelatingslijst";
HttpAllowlist.pfm_description = "Als je het beleid instelt, wordt een lijst met hostnamen of hostnaampatronen (zoals '[*.]example.com') opgegeven die niet naar HTTPS worden geüpgraded en wordt er geen fout-interstitial getoond als de modus Eerst HTTPS wordt aangezet. Organisaties kunnen dit beleid gebruiken om toegang te houden tot servers die geen HTTPS ondersteunen, zonder dat ze HTTPS-upgrades en/of de modus Eerst HTTPS hoeven uit te zetten.\n\nDe opgegeven hostnamen moeten een canonieke URL hebben. Eventuele IDN's moeten worden omgezet naar de A-labelindeling en alle ASCII-letters moeten kleine letters zijn.\n\nAlgemene jokertekens (zoals '*' of '[*]') zijn niet toegestaan. In plaats daarvan moeten de modus Eerst HTTPS en HTTPS-upgrades expliciet worden uitgezet via het specifieke beleid.\n\nOpmerking: Dit beleid is niet van toepassing op HSTS-upgrades.";
HttpHeaderInjection.pfm_title = "HTTP-headerinjectie instellen voor specifieke URL-patronen";
HttpHeaderInjection.pfm_description = "Met dit beleid kun je een lijst met regels definiëren om aangepaste HTTP-headers in te voegen in webverzoeken die overeenkomen met specifieke URL-patronen. Headers die zijn ingesteld door dit beleid, hebben voorrang op headers die oorspronkelijk aanwezig waren in het verzoek en op wijzigingen die gebruikers of extensies proberen aan te brengen.\n\nEen veelgebruikte use case voor dit beleid is om toegangsbeheer voor tenants af te dwingen door aangepaste headers te injecteren (bijvoorbeeld X-Tenant-ID).\n\nHet beleid accepteert een lijst met regels. Elke regel bevat het volgende:\n\n* patterns: Een lijst met URL-patronen die moeten overeenkomen. Bekijk hoe je een URL-patroon opmaakt (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\n* headers: Een lijst met objecten die headers vertegenwoordigen die moeten worden geïnjecteerd. Elk object bevat het volgende:\n\n* name: De naam van de header die moet worden geïnjecteerd.\n\n* value: De waarde van de header die moet worden geïnjecteerd.\n\nAls meerdere regels overeenkomen met een verzoek, worden de headers van alle overeenkomende regels toegepast. Als er meerdere headers met dezelfde naam zijn, wordt de header met het meest specifieke URL-patroon toegepast. Als patronen even specifiek zijn, wordt het patroon toegepast dat als laatste in de lijst staat.\n\nHeadernamen moeten voldoen aan RFC 2616 (https://www.rfc-editor.org/rfc/rfc2616). Headerwaarden mogen geen NUL-, CR- of LF-symbolen bevatten. Afzonderlijke headers mogen niet groter zijn dan 8 KB. Ongeldige headers en URL-patronen worden genegeerd.\n\nDit beleid is beperkt tot in totaal 500 URL-patronen voor alle regels. Elke regel kan maximaal 20 headers bevatten. Patronen en headers die deze drempelwaarden overschrijden, worden genegeerd.\n\nOpmerking: Als een URL-patroon overeenkomt met niet-versleutelde schema's (http://, ws:// of als het schema is weggelaten), kunnen de ingestelde headers in platte tekst worden verstuurd via een niet-versleuteld kanaal en kunnen ze zichtbaar worden gemaakt voor netwerkwaarnemers. Beperk URL-patronen tot versleutelde schema's (https:// of wss://) om gevoelige of identificerende headerwaarden te beschermen.\nGa naar https://chromeenterprise.google/policies/?policy=HttpHeaderInjection voor meer informatie over schema en indeling.";
HttpsOnlyMode.pfm_title = "Toestaan dat de modus 'Alleen HTTPS' wordt aangezet";
HttpsOnlyMode.pfm_description = "allowed - Instelling voor de modus Alleen HTTPS van gebruikers niet beperken\ndisallowed - De modus Alleen HTTPS uitzetten\nforce_enabled - De modus Alleen HTTPS aanzetten in de strikte modus\nforce_balanced_enabled - De modus Alleen HTTPS aanzetten in de gebalanceerde modus\nMet dit beleid wordt bepaald of gebruikers de modus Alleen HTTPS (Altijd beveiligde verbindingen gebruiken) kunnen aanzetten in Instellingen. Met de modus Alleen HTTPS wordt een upgrade naar HTTPS doorgevoerd voor alle navigaties.\n\nAls je deze instelling niet instelt of instelt op 'allowed', kunnen gebruikers de modus Alleen HTTPS aanzetten.\n\nAls je deze instelling instelt op 'disallowed', wordt de modus Alleen HTTPS uitgezet.\n\nAls je deze instelling instelt op 'force_enabled', wordt de modus Alleen HTTPS aangezet in de strikte modus.\n\nAls je deze instelling instelt op 'force_balanced_enabled', wordt de modus Alleen HTTPS aangezet in de gebalanceerde modus.\n\n'force_enabled' wordt ondersteund vanaf M112 en 'force_balanced_enabled' wordt ondersteund vanaf M129.\n\n'force_enabled' en 'force_balanced_enabled' kunnen ook worden aanbevolen aan gebruikers.\nDe modus Alleen HTTPS wordt in eerste instantie ingesteld op Strikt of Gebalanceerd, maar gebruikers kunnen dit wijzigen.\n\nAls je dit beleid instelt op een waarde die niet wordt ondersteund door de versie van Chrome die het beleid ontvangt, gebruikt Chrome standaard de toegestane instelling.\n\nHet afzonderlijke beleid HttpAllowlist kan worden gebruikt om te voorkomen dat specifieke hostnamen of hostnaampatronen door deze functie worden geüpgraded naar HTTPS.";
HttpsUpgradesEnabled.pfm_title = "Automatische HTTPS-upgrades aanzetten";
HttpsUpgradesEnabled.pfm_description = "Brave probeert waar mogelijk bepaalde navigatie te upgraden van HTTP naar HTTPS. Je kunt dit beleid gebruiken om dit gedrag uit te zetten. Als je dit instelt op True of niet instelt, wordt deze functie standaard aangezet.\n\nHet afzonderlijke beleid HttpAllowlist kan worden gebruikt om te voorkomen dat specifieke hostnamen of hostnaampatronen door deze functie worden geüpgraded naar HTTPS.\n\nZie ook het beleid HttpsOnlyMode.";
IPv6ReachabilityOverrideEnabled.pfm_title = "Overschrijven van IPv6-bereikbaarheidscheck aanzetten";
IPv6ReachabilityOverrideEnabled.pfm_description = "Als je het beleid instelt op True, wordt de IPv6-bereikbaarheidscheck overschreven. Dit betekent dat het systeem altijd AAAA-records opvraagt voor hostnaamresolutie. Dit is van toepassing op alle gebruikers en interfaces op het apparaat.\n\nAls je het beleid instelt op False of niet instelt, wordt de IPv6-bereikbaarheidscheck niet overschreven.\nHet systeem vraagt AAAA-records alleen op indien bereikbaar voor een algemene IPv6-host.";
IdleDetectionAllowedForUrls.pfm_title = "Toegestane sites voor inactiviteitsdetectie";
IdleDetectionAllowedForUrls.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen voor sites die de Idle Detection API mogen gebruiken zonder de gebruiker om toestemming te vragen. Vermeldingen op de blokkeerlijst hebben een hogere prioriteit dan vermeldingen op de toelatingslijst, die op hun beurt een hogere prioriteit hebben dan de ingestelde standaardwaarde.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige site-URL-patronen. Jokertekens (*) zijn toegestaan. Dit beleid zoekt alleen overeenkomsten op basis van de herkomst, dus elk pad in het URL-patroon wordt genegeerd.\n\nAls je dit beleid niet instelt, wordt de algemene standaardwaarde gebruikt voor alle sites. Deze wordt ingesteld door het beleid DefaultIdleDetectionSetting (standaardinstelling voor inactiviteitsdetectie) als dit is ingesteld, of anders door de persoonlijke configuratie van de gebruiker.";
IdleDetectionBlockedForUrls.pfm_title = "Geblokkeerde sites voor inactiviteitsdetectie";
IdleDetectionBlockedForUrls.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen om aan te geven welke sites de Idle Detection API niet mogen gebruiken.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige site-URL-patronen. Jokertekens (*) zijn toegestaan. Dit beleid zoekt alleen overeenkomsten op basis van de herkomst, dus elk pad in het URL-patroon wordt genegeerd.\n\nAls je dit beleid niet instelt, wordt de algemene standaardwaarde gebruikt voor alle sites. Deze wordt ingesteld door het beleid DefaultIdleDetectionSetting (standaardinstelling voor inactiviteitsdetectie) als dit is ingesteld, of anders door de persoonlijke configuratie van de gebruiker.";
IdleTimeout.pfm_title = "Vertraging voordat acties bij inactiviteit worden uitgevoerd";
IdleTimeout.pfm_description = "Hiermee wordt een actie gestart als de computer inactief is.\n\nAls dit beleid is ingesteld, specificeert het de tijdsduur zonder gebruikersinvoer (in minuten) voordat de browser acties uitvoert die zijn ingesteld via het beleid IdleTimeoutActions.\n\nAls dit beleid niet is ingesteld, wordt er geen actie uitgevoerd.\n\nDe minimum drempelwaarde is 1 minuut.\n\n'Gebruikersinvoer' wordt gedefinieerd door API's voor het besturingssysteem en omvat bijvoorbeeld de muis bewegen of typen op het toetsenbord.";
IdleTimeoutActions.pfm_title = "Acties die moeten worden uitgevoerd als de computer inactief is";
IdleTimeoutActions.pfm_description = "close_browsers - Browsers sluiten\nshow_profile_picker - Profielkiezer tonen\nclear_browsing_history - Browsegeschiedenis wissen\nclear_download_history - Downloadgeschiedenis wissen\nclear_cookies_and_other_site_data - Cookies en andere sitegegevens wissen\nclear_cached_images_and_files - Afbeeldingen en bestanden in het cachegeheugen wissen\nclear_password_signin - Inloggen met wachtwoord wissen\nclear_autofill - Automatisch invullen wissen\nclear_site_settings - Site-instellingen wissen\nclear_hosted_app_data - Gehoste app-gegevens wissen\nreload_pages - Pagina's opnieuw laden\nsign_out - Uitloggen\nclose_tabs - Tabbladen sluiten\nLijst met acties die moeten worden uitgevoerd als de time-out van het beleid IdleTimeout is bereikt.\n\nWaarschuwing: Als je dit beleid instelt, kan dit gevolgen hebben voor lokale persoonsgegevens en kunnen deze definitief worden verwijderd. We raden je aan de instellingen te testen voordat je ze implementeert om te voorkomen dat persoonsgegevens per ongeluk worden verwijderd.\n\nAls je het beleid IdleTimeout niet instelt, heeft dit beleid geen effect.\n\nAls de time-out van het beleid IdleTimeout is bereikt, voert de browser de acties uit die in dit beleid zijn ingesteld.\n\nAls je dit beleid leeg laat of niet instelt, heeft het beleid IdleTimeout geen effect.\n\nDeze acties worden ondersteund:\n\nclose_browsers: Alle browservensters en PWA's voor dit profiel worden gesloten. Niet ondersteund op Android en iOS.\n\nclose_tabs: Alle geopende tabbladen in geopende vensters worden gesloten. Alleen ondersteund op iOS.\n\nshow_profile_picker: Het profielkiezervenster tonen. Niet ondersteund op Android en iOS.\n\nsign_out: De huidige ingelogde gebruiker wordt uitgelogd. Alleen ondersteund op iOS.\n\nclear_browsing_history, clear_download_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing, clear_autofill, clear_site_settings, clear_hosted_app_data: De bijbehorende browsegegevens worden gewist. Zie het beleid ClearBrowsingDataOnExitList voor meer informatie. De ondersteunde typen op iOS zijn clear_browsing_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing en clear_autofill.\n\nreload_pages: Alle webpagina's worden opnieuw geladen. Voor sommige pagina's kan de gebruiker eerst om bevestiging worden gevraagd. Niet ondersteund op iOS.\n\nDe gebruiker blijft ingelogd op hun Google-account wanneer cookies worden verwijderd met clear_cookies_and_other_site_data.\n\nAls je clear_browsing_history, clear_password_signing, clear_autofill en clear_site_settings instelt, wordt synchronisatie voor de betreffende gegevenstypen uitgezet als Chrome Sync niet is uitgezet door het beleid SyncDisabled in te stellen en BrowserSignin niet is uitgezet.";
ImagesAllowedForUrls.pfm_title = "Afbeeldingen toestaan op deze sites";
ImagesAllowedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen opgeven van sites die afbeeldingen mogen weergeven.\n\nAls je het beleid niet instelt, is DefaultImagesSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.\n\nDit beleid is in het verleden ten onrechte toegepast op Android, maar deze functionaliteit is nooit volledig ondersteund voor Android.";
ImagesBlockedForUrls.pfm_title = "Afbeeldingen blokkeren op deze sites";
ImagesBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van sites die geen afbeeldingen mogen weergeven.\n\nAls je het beleid niet instelt, is DefaultImagesSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\n Ga naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.\n\n Dit beleid is in het verleden ten onrechte toegepast op Android, maar deze functionaliteit is nooit volledig ondersteund voor Android.";
ImportAutofillFormData.pfm_title = "Formuliergegevens voor Automatisch invullen importeren uit standaardbrowser bij eerste uitvoering";
ImportAutofillFormData.pfm_description = "Als je het beleid toepast, worden de formuliergegevens voor automatisch invullen van de vorige standaardbrowser geïmporteerd bij de eerste uitvoering. Als je het beleid niet toepast of niet instelt, worden formuliergegevens voor automatisch invullen niet geïmporteerd bij de eerste uitvoering.\n\nAls gebruikers het dialoogvenster voor importeren openen, is het selectievakje voor formuliergegevens voor automatisch invullen aan- of uitgevinkt in overeenstemming met de waarde van dit beleid.";
ImportBookmarks.pfm_title = "Bookmarks importeren uit standaardbrowser bij eerste uitvoering";
ImportBookmarks.pfm_description = "Als je het beleid toepast, worden de bookmarks van de vorige standaardbrowser geïmporteerd bij de eerste uitvoering. Als je het beleid niet toepast of niet instelt, worden de bookmarks niet geïmporteerd bij de eerste uitvoering.\n\nAls gebruikers het dialoogvenster voor importeren openen, is het selectievakje voor bookmarks aan- of uitgevinkt in overeenstemming met de waarde van dit beleid.";
ImportHistory.pfm_title = "Browsegeschiedenis importeren uit standaardbrowser bij eerste uitvoering";
ImportHistory.pfm_description = "Als je het beleid toepast, wordt de browsegeschiedenis van de vorige standaardbrowser geïmporteerd bij de eerste uitvoering. Als je het beleid niet toepast of niet instelt, wordt de browsegeschiedenis niet geïmporteerd bij de eerste uitvoering.\n\nAls gebruikers het dialoogvenster voor importeren openen, is het selectievakje voor de browsegeschiedenis aan- of uitgevinkt in overeenstemming met de waarde van dit beleid.";
ImportHomepage.pfm_title = "Homepage importeren uit standaardbrowser bij eerste uitvoering";
ImportHomepage.pfm_description = "Als je het beleid toepast, wordt de homepage van de vorige standaardbrowser geïmporteerd bij de eerste uitvoering. Als je het beleid niet toepast of niet instelt, wordt de homepage niet geïmporteerd bij de eerste uitvoering.\n\nAls gebruikers het dialoogvenster voor importeren openen, is het selectievakje voor de homepage aan- of uitgevinkt in overeenstemming met de waarde van dit beleid.";
ImportSavedPasswords.pfm_title = "Opgeslagen wachtwoorden importeren uit standaardbrowser bij eerste uitvoering";
ImportSavedPasswords.pfm_description = "Dit beleid bepaalt alleen het eerste uitvoeringsgedrag na de installatie. Hiermee wordt een naadloze overgang naar Brave mogelijk in omgevingen waar vaak een andere browser werd gebruikt voordat de browser werd geïnstalleerd. Dit beleid heeft geen invloed op de mogelijkheden van de wachtwoordmanager voor Google-accounts.\n\nAls je het beleid toepast, worden opgeslagen wachtwoorden van de vorige standaardbrowser geïmporteerd bij de eerste uitvoering en is handmatig importeren vanaf de pagina Instellingen ook mogelijk.\nAls je het beleid niet toepast, worden er geen opgeslagen wachtwoorden geïmporteerd bij de eerste uitvoering en wordt handmatig importeren via de pagina Instellingen geblokkeerd.\nAls je het beleid niet instelt, worden er geen opgeslagen wachtwoorden geïmporteerd bij de eerste uitvoering maar kan de gebruiker dit doen via de pagina Instellingen.";
ImportSearchEngine.pfm_title = "Zoekmachines importeren uit standaardbrowser bij eerste uitvoering";
ImportSearchEngine.pfm_description = "Als je het beleid toepast, wordt de standaard zoekmachine van de vorige standaardbrowser geïmporteerd bij de eerste uitvoering. Als je het beleid niet toepast of niet instelt, wordt de standaard zoekmachine niet geïmporteerd bij de eerste uitvoering.\n\nAls gebruikers het dialoogvenster voor importeren openen, is het selectievakje voor de standaard zoekmachine aan- of uitgevinkt in overeenstemming met de waarde van dit beleid.";
IncognitoModeAvailability.pfm_title = "Beschikbaarheid van incognitomodus";
IncognitoModeAvailability.pfm_description = "0 - Incognitomodus beschikbaar\n1 - Incognitomodus staat uit\n2 - Incognitomodus afgedwongen\nSpecificeert of de gebruiker pagina's mag openen in de incognitomodus in Brave.\n\nAls dit beleid wordt toegepast of niet is ingesteld, kunnen pagina's worden geopend in de incognitomodus.\n\nAls dit beleid niet wordt toegepast, kunnen pagina's niet worden geopend in de incognitomodus.\n\nAls dit beleid wordt afgedwongen, kunnen pagina's UITSLUITEND worden geopend in de incognitomodus. De optie Afgedwongen werkt niet voor Android in Chrome.\n\nHet beleid IncognitoModeUrlAllowlist heeft prioriteit boven dit beleid en kan de incognitomodus opnieuw aanzetten voor specifieke URL's. Als de incognitomodus door dit beleid wordt uitgezet als er een toelatingslijst wordt verstrekt, is de incognitomodus alleen beschikbaar voor URL's die overeenkomen met de toelatingslijst. Alle andere pagina's worden geblokkeerd.\n\nOpmerking: Als iOS wordt gebruikt en het beleid wordt aangepast tijdens een sessie, treedt de aanpassing pas in werking na een herstart.";
IncognitoModeUrlAllowlist.pfm_title = "Toegang geven tot een lijst met URL's in de incognitomodus.";
IncognitoModeUrlAllowlist.pfm_description = "Als je het beleid instelt, wordt toegang geboden tot de vermelde URL's in de incognitomodus. Gebruik dit beleid om uitzonderingen te openen voor bepaalde URL-patronen die zijn gedefinieerd in IncognitoModeUrlBlocklist, met de indeling die wordt gespecificeerd op (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nAls zowel dit beleid als IncognitoModeUrlBlocklist zijn ingesteld, heeft de toelatingslijst voorrang. Als een URL overeenkomt met een patroon op de toelatingslijst, wordt deze toegestaan. Als een URL overeenkomt met een patroon op de blokkeerlijst (maar niet op de toelatingslijst), wordt deze geblokkeerd. Als een URL met geen van beide overeenkomt, wordt het algemene beleid van URLBlocklist/URLAllowlist gebruikt als reserve.\n\nAls je dit beleid instelt en IncognitoModeUrlBlocklist niet, wordt elke URL die niet op de toelatingslijst staat, geblokkeerd in de incognitomodus.\n\nAls je IncognitoModeAvailability instelt op Niet toestaan (waarde 1), maar dit beleid instelt, is de incognitomodus alleen beschikbaar voor de URL's die overeenkomen met de toelatingslijst.\n\nAls je het beleid niet instelt, zijn er geen uitzonderingen toegestaan op IncognitoModeUrlBlocklist en IncognitoModeAvailability.\n\nDit beleid is alleen van invloed op de incognitomodus. Als je URL's wilt toestaan voor alle gebruikersprofielen, gebruik je het beleid URLAllowlist.\n\nAlgemene jokertekens (zoals '*' of '[*]') zijn niet toegestaan. Gebruik het beleid IncognitoModeAvailability om de functie wereldwijd aan te zetten.\n\nDit beleid is beperkt tot 1000 items.";
IncognitoModeUrlBlocklist.pfm_title = "Toegang blokkeren tot een lijst met URL's in de incognitomodus.";
IncognitoModeUrlBlocklist.pfm_description = "Als je het beleid IncognitoModeUrlBlocklist instelt, worden webpagina's met verboden URL's niet geladen in de incognitomodus. Beheerders kunnen de lijst met URL-patronen invullen die moeten worden geblokkeerd. Bekijk hoe je een URL-patroon opmaakt (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nAls je dit beleid en het beleid IncognitoModeUrlAllowlist instelt, heeft de toelatingslijst voorrang. Als een URL overeenkomt met een patroon op de toelatingslijst, wordt deze toegestaan. Als een URL overeenkomt met een patroon op de blokkeerlijst maar niet op de toelatingslijst, wordt deze geblokkeerd. Als een URL met geen van beide overeenkomt, wordt het algemene beleid van URLBlocklist/URLAllowlist gebruikt als reserve.\n\nAls je het beleid IncognitoModeUrlAllowlist instelt en dit beleid niet, wordt elke URL die niet op de toelatingslijst staat, geblokkeerd in de incognitomodus.\n\nAls IncognitoModeAvailability is ingesteld op Niet toestaan (waarde 1), maar het beleid IncognitoModeUrlAllowlist is ingesteld, is de incognitomodus alleen beschikbaar voor de URL's die overeenkomen met de toelatingslijst.\n\nDit beleid is alleen van invloed op de incognitomodus. Als je URL's wilt blokkeren voor alle gebruikersprofielen, gebruik je het beleid URLBlocklist.\n\nDit beleid is beperkt tot 1000 items.";
InsecureContentAllowedForUrls.pfm_title = "Niet-beveiligde content op deze sites toestaan";
InsecureContentAllowedForUrls.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen van sites waarop blokkeerbare (actieve) gemengde content (zoals HTTP-content op een HTTPS-site) mag worden weergegeven en waarvoor optioneel blokkeerbare gemengde content wordt uitgezet.\n\nAls je dit beleid niet instelt, wordt blokkeerbare gemengde content geblokkeerd en wordt optioneel blokkeerbare gemengde content geüpgraded. Bovendien kunnen gebruikers uitzonderingen instellen om dergelijke content toe te staan voor specifieke sites.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen. Jokertekens (*) zijn toegestaan.";
InsecureContentBlockedForUrls.pfm_title = "Niet-beveiligde content op deze sites blokkeren";
InsecureContentBlockedForUrls.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen van sites waarop blokkeerbare (actieve) gemengde content (zoals HTTP-content op HTTPS-sites) niet mag worden weergegeven en waarvoor optioneel blokkeerbare (passieve) gemengde content wordt geüpgraded.\n\nAls je dit beleid niet instelt, wordt blokkeerbare gemengde content geblokkeerd en wordt optioneel blokkeerbare gemengde content geüpgraded. Gebruikers kunnen wel uitzonderingen instellen om dergelijke content toe te staan voor specifieke sites.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen. Jokertekens (*) zijn toegestaan.";
IntensiveWakeUpThrottlingEnabled.pfm_title = "De functie IntensiveWakeUpThrottling beheren.";
IntensiveWakeUpThrottlingEnabled.pfm_description = "Als de functie IntensiveWakeUpThrottling aanstaat, worden JavaScript-timers op achtergrondtabbladen op agressieve wijze gethrottled en samengevoegd, zodat ze niet vaker dan één keer per minuut worden uitgevoerd nadat een pagina 5 minuten of langer op de achtergrond heeft gestaan.\n\nDeze functie voldoet aan de internetstandaarden, maar kan ervoor zorgen dat bepaalde websites niet goed functioneren omdat bepaalde acties tot maximaal een minuut kunnen worden vertraagd. Als deze functie aanstaat, heeft dit wel aanzienlijke CPU- en batterijbesparingen tot gevolg. Bekijk https://bit.ly/30b1XR4 voor meer informatie.\n\nAls dit beleid wordt toegepast, wordt de functie gedwongen aangezet en kunnen gebruikers dit niet overschrijven.\n\nAls dit beleid niet wordt toegepast, wordt de functie gedwongen uitgezet en kunnen gebruikers dit niet overschrijven.\n\nAls dit beleid niet is ingesteld, wordt de functie beheerd door de eigen interne logica, die handmatig kan worden ingesteld door gebruikers.\n\nHoud er rekening mee dat het beleid wordt toegepast per weergaveprogrammaproces en dat de meest recente waarde van de beleidsinstelling van kracht is als een weergaveprogrammaproces wordt gestart. Volledig opnieuw opstarten is vereist om ervoor te zorgen dat op alle geladen tabbladen een consistente beleidsinstelling wordt toegepast. Dit heeft geen negatieve invloed op processen die met andere waarden van dit beleid worden uitgevoerd.\n";
IntranetRedirectBehavior.pfm_title = "Gedrag voor intranetomleidingen";
IntranetRedirectBehavior.pfm_description = "0 - Standaardgedrag van browser gebruiken.\n1 - Controles voor DNS-onderschepping en infobalken voor 'bedoelde je http://intranetsite/' uitzetten.\n2 - Controles voor DNS-onderschepping uitzetten, infobalken voor 'bedoelde je http://intranetsite/' toestaan.\n3 - Controles voor DNS-onderschepping en infobalken voor 'bedoelde je http://intranetsite/' toestaan.\nMet dit beleid configureer je het gedrag voor intranetomleiding via controles voor DNS-onderschepping. Deze controles proberen te achterhalen of er een proxy achter de browser zit die als omleiding naar onbekende hostnamen dient.\n\nAls je dit beleid niet instelt, gebruikt de browser het standaardgedrag voor controles voor DNS-onderschepping en suggesties voor intranetomleidingen. In M88 zijn ze standaard aangezet, maar ze worden standaard uitgezet in een toekomstige release.\n\nDNSInterceptionChecksEnabled is een gerelateerd beleid waarmee controles voor DNS-onderschepping ook kunnen worden uitgezet. Dit beleid is een flexibelere versie waarmee infobalken voor intranetomleidingen afzonderlijk kunnen worden beheerd. Het beleid kan in de toekomst worden uitgebreid.\nAls DNSInterceptionChecksEnabled of dit beleid vraagt om controles voor onderschepping uit te zetten, worden de controles uitgezet.";
IsolateOrigins.pfm_title = "Site-isolatie voor opgegeven oorsprongen aanzetten";
IsolateOrigins.pfm_description = "Geef een lijst aan met oorsprongen die in een eigen proces worden uitgevoerd.\n\nOp Android werkt dit beleid alleen voor apparaten met voldoende geheugen (meer dan 3,2 GB RAM), omdat het isoleren van te veel sites op apparaten met beperkte bronnen prestatieproblemen kan veroorzaken. Gebruik IsolateOriginsShortlist voor Android-apparaten met beperkte bronnen.\n\nWe raden af om procesisolatie in te stellen op apparaten met minder dan 1 GB geheugen.\n\nElk proces van een benoemde oorsprong mag alleen documenten bevatten van de betreffende oorsprong en de subdomeinen daarvan. Als je bijvoorbeeld https://a1.example.com/ aangeeft, valt https://a2.a1.example.com/ onder hetzelfde proces, maar https://example.com of https://b.example.com niet.\n\nSinds Brave 77 kun je met een jokerteken een oorsprongbereik aangeven om te isoleren. Als je bijvoorbeeld https://[*.]corp.example.com aangeeft, wordt elke oorsprong onder https://corp.example.com uitgevoerd in een eigen proces, waaronder https://corp.example.com zelf, https://a1.corp.example.com en https://a2.a1.corp.example.com.\n\nZoals wordt vermeld in ons beleid SitePerProcess, zijn op desktopplatforms alle sites (dus het schema plus eTLD+1, zoals https://example.com) standaard geïsoleerd. Het beleid IsolateOrigins is handig om specifieke oorsprongen op een lager detailniveau te isoleren (bijvoorbeeld https://a.example.com).\n\nAndroid isoleert bepaalde gevoelige sites standaard vanaf versie 77 van Brave. Dit beleid breidt die modus uit om specifieke extra oorsprongen te isoleren.\n\nOorsprongen die door dit beleid worden geïsoleerd, kunnen geen scripts uitvoeren van andere oorsprongen binnen dezelfde site. Normaal is dit wel mogelijk als 2 documenten van dezelfde site hun waarden voor document.domain op elkaar afstemmen. Beheerders moeten bevestigen dat dit ongebruikelijke gedrag niet wordt toegepast op een oorsprong voordat deze wordt geïsoleerd.\n\nAls je het beleid instelt op een lege tekenreeks of niet instelt, is site-isolatie niet vereist voor specifieke oorsprongen. Gebruikers kunnen procesisolatie nog steeds handmatig aanzetten via de opdrachtregelflag.";
JavaScriptAllowedForUrls.pfm_title = "JavaScript toestaan op deze sites";
JavaScriptAllowedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen om aan te geven welke sites JavaScript mogen uitvoeren.\n\nAls je het beleid niet instelt, is DefaultJavaScriptSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
JavaScriptBlockedForUrls.pfm_title = "JavaScript blokkeren op deze sites";
JavaScriptBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen om op te geven welke sites JavaScript niet mogen uitvoeren.\n\nAls je het beleid niet instelt, is DefaultJavaScriptSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.\n\nDit beleid blokkeert JavaScript als de oorsprong van het document op het hoogste niveau (meestal de pagina-URL die ook in de adresbalk wordt getoond) overeenkomt met een van de patronen. Dit beleid is daarom niet geschikt om aanvallen op de webtoeleveringsketen te beperken. Als je bijvoorbeeld het patroon 'https://[*.]foo.com/' invoert, voorkom je niet dat een pagina die wordt gehost op https://voorbeeld.com een script uitvoert dat is geladen vanaf https://www.foo.com/voorbeeld.js. Als je het patroon 'https://voorbeeld.com/' invoert, voorkom je daarnaast niet dat een document van https://voorbeeld.com scripts uitvoert als het niet het document op het hoogste niveau is, maar is ingebed als subframe in een pagina die wordt gehost op een andere oorsprong, bijvoorbeeld https://www.bar.com.";
JavaScriptJitAllowedForSites.pfm_title = "Toestaan dat JavaScript op deze sites JIT gebruikt";
JavaScriptJitAllowedForSites.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen van sites die JavaScript mogen uitvoeren met de JIT-compiler (Just In Time) aangezet.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige site-URL-patronen. Jokertekens (*) zijn toegestaan.\n\nUitzonderingen op het beleid kunnen worden ingesteld voor specifieke subdomeinen en hele sites. Een beleid dat alleen voor subdomein.site.com is ingesteld, is bijvoorbeeld van toepassing op subdomein.site.com zonder dat dit van invloed is op site.com. In sommige gevallen waarin een subdomein niet kan worden geïsoleerd van de bovenliggende site, kan het beleid worden overgenomen dat is ingesteld op site.com. Uitzonderingen worden misschien ook pas van kracht voor frames die in een bestaand tabblad zijn geladen als de site wordt geopend in een nieuw tabblad. Op Android-apparaten met weinig geheugen worden sitespecifieke uitzonderingen misschien niet afgedwongen. Sites gebruiken dan het beleid van DefaultJavaScriptJitSetting, als dit is ingesteld, of de standaard JavaScript JIT-instelling van het profiel.\n\nBrave kan sites of subdomeinen waarvan de instelling afwijkt van de standaardinstelling in speciale processen plaatsen om uitzonderingen af te dwingen. Dit kan het geheugengebruik verhogen, vooral op Android of als een jokertekenpatroon overeenkomt met veel subdomeinen, omdat elke overeenkomende oorsprong afzonderlijk kan worden geïsoleerd. Geïsoleerde subdomeinen kunnen ook geen document.domain gebruiken om toegang te krijgen tot hun bovenliggende site.\n\nOpmerking: In versie 155 en lager werden beleidsuitzonderingen alleen afgedwongen op site-detailniveau (eTLD+1). Een beleid dat alleen voor subdomein.site.com is ingesteld, werd niet van kracht, zelfs niet voor subdomein.site.com. Het moest worden ingesteld op site.com om van toepassing te zijn op zowel site.com als subdomein.site.com.\n\nDit beleid wordt frame voor frame toegepast en niet alleen op basis van de URL van de oorsprong op het hoogste niveau. Als site-one.com bijvoorbeeld wordt vermeld in het beleid JavaScriptJitAllowedForSites, maar site-one.com een frame laadt dat site-two.com bevat, wordt JavaScript JIT aangezet voor site-one.com, maar gebruikt site-two.com het beleid van DefaultJavaScriptJitSetting, indien ingesteld, of wordt JavaScript JIT standaard aangezet. Vermeldingen op de blokkeerlijst hebben een hogere prioriteit dan vermeldingen op de toelatingslijst, die op hun beurt een hogere prioriteit hebben dan de ingestelde standaardwaarde.\n\nAls dit beleid niet is ingesteld voor een site, is het beleid van DefaultJavaScriptJitSetting van toepassing op de site, indien ingesteld, anders staat JavaScript JIT aan voor de site.";
JavaScriptJitBlockedForSites.pfm_title = "Voorkomen dat JavaScript op deze sites JIT kan gebruiken";
JavaScriptJitBlockedForSites.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen van sites die JavaScript niet mogen uitvoeren met de JIT-compiler (Just In Time) aangezet.\n\nAls je de JavaScript JIT-compiler uitzet, kan Brave er langer over doen om webcontent te renderen en kunnen ook delen van JavaScript (waaronder WebAssembly) worden uitgezet. Als je de JavaScript JIT-compiler uitzet, kan Brave webcontent renderen in een meer beveiligde configuratie.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen. Jokertekens (*) zijn toegestaan.\n\nUitzonderingen op het beleid kunnen worden ingesteld voor specifieke subdomeinen en hele sites. Een beleid dat alleen voor subdomein.site.com is ingesteld, is bijvoorbeeld van toepassing op subdomein.site.com zonder dat dit van invloed is op site.com. In sommige gevallen waarin een subdomein niet kan worden geïsoleerd van de bovenliggende site, kan het beleid worden overgenomen dat is ingesteld op site.com. Uitzonderingen worden misschien ook pas van kracht voor frames die in een bestaand tabblad zijn geladen als de site wordt geopend in een nieuw tabblad. Op Android-apparaten met weinig geheugen worden sitespecifieke uitzonderingen misschien niet afgedwongen. Sites gebruiken dan het beleid van DefaultJavaScriptJitSetting, als dit is ingesteld, of de standaard JavaScript JIT-instelling van het profiel.\n\nBrave kan sites of subdomeinen waarvan de instelling afwijkt van de standaardinstelling in speciale processen plaatsen om uitzonderingen af te dwingen. Dit kan het geheugengebruik verhogen, vooral op Android of als een jokertekenpatroon overeenkomt met veel subdomeinen, omdat elke overeenkomende oorsprong afzonderlijk kan worden geïsoleerd. Geïsoleerde subdomeinen kunnen ook geen document.domain gebruiken om toegang te krijgen tot hun bovenliggende site.\n\nOpmerking: In versie 155 en lager werden beleidsuitzonderingen alleen afgedwongen op site-detailniveau (eTLD+1). Een beleid dat alleen voor subdomein.site.com is ingesteld, werd niet van kracht, zelfs niet voor subdomein.site.com. Het moest worden ingesteld op site.com om van toepassing te zijn op zowel site.com als subdomein.site.com.\n\nDit beleid wordt frame voor frame toegepast en niet alleen op basis van de URL van de oorsprong op het hoogste niveau. Als site-one.com bijvoorbeeld wordt vermeld in het beleid JavaScriptJitBlockedForSites, maar site-one.com een frame laadt dat site-two.com bevat, wordt JavaScript JIT uitgezet voor site-one.com, maar gebruikt site-two.com het beleid van DefaultJavaScriptJitSetting, indien ingesteld, of wordt JavaScript JIT standaard aangezet. Vermeldingen op de blokkeerlijst hebben een hogere prioriteit dan vermeldingen op de toelatingslijst, die op hun beurt een hogere prioriteit hebben dan de ingestelde standaardwaarde.\n\nAls dit beleid niet is ingesteld voor een site, is het beleid van DefaultJavaScriptJitSetting van toepassing op de site, indien ingesteld, anders staat JavaScript JIT aan voor de site.";
JavaScriptOptimizerAllowedForSites.pfm_title = "JavaScript-optimalisaties toestaan op deze sites";
JavaScriptOptimizerAllowedForSites.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen voor sites waarvoor geavanceerde JavaScript-optimalisaties zijn aangezet.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige site-URL-patronen.\nJokertekens (*) zijn toegestaan.\n\nUitzonderingen op het beleid kunnen worden ingesteld voor specifieke subdomeinen en hele sites.\nEen beleid dat alleen voor subdomein.site.com is ingesteld, is bijvoorbeeld van toepassing op subdomein.site.com zonder dat dit van invloed is op site.com. In sommige gevallen waarin een subdomein niet kan worden geïsoleerd van de bovenliggende site, kan het beleid worden overgenomen dat is ingesteld op site.com. Uitzonderingen worden misschien ook pas van kracht voor frames die in een bestaand tabblad zijn geladen als de site wordt geopend in een nieuw tabblad. Op Android-apparaten met weinig geheugen worden sitespecifieke uitzonderingen misschien niet afgedwongen. In plaats daarvan gebruiken sites het beleid van DefaultJavaScriptOptimizerSetting (als dit is ingesteld) of de standaardinstelling voor JavaScript-optimalisatie van het profiel.\n\nBrave kan sites of subdomeinen waarvan de instelling afwijkt van de standaardinstelling in speciale processen plaatsen om uitzonderingen af te dwingen. Dit kan het geheugengebruik verhogen, vooral op Android of als een jokertekenpatroon overeenkomt met veel subdomeinen, omdat elke overeenkomende oorsprong afzonderlijk kan worden geïsoleerd. Geïsoleerde subdomeinen kunnen ook geen document.domain gebruiken om toegang te krijgen tot hun bovenliggende site.\n\nOpmerking: In versie 138 en lager werden beleidsuitzonderingen alleen afgedwongen op site-detailniveau (eTLD+1). Een beleid dat alleen voor subdomein.site.com is ingesteld, werd niet van kracht, zelfs niet voor subdomein.site.com. Het moest worden ingesteld op site.com om van toepassing te zijn op zowel site.com als subdomein.site.com.\n\nDit beleid wordt frame voor frame toegepast en niet alleen op basis van de URL van de oorsprong op het hoogste niveau. Als site-one.com bijvoorbeeld wordt vermeld in het beleid JavaScriptOptimizerAllowedForSites, maar site-one.com een frame laadt dat site-two.com bevat, worden JavaScript-optimalisaties aangezet voor site-one.com, maar gebruikt site-two.com het beleid van DefaultJavaScriptOptimizerSetting, indien ingesteld, of worden JavaScript-optimalisaties standaard aangezet. Vermeldingen op de blokkeerlijst hebben een hogere prioriteit dan vermeldingen op de toelatingslijst, die op hun beurt een hogere prioriteit hebben dan de ingestelde standaardwaarde.\n\nAls dit beleid niet is ingesteld voor een site, is het beleid van DefaultJavaScriptOptimizerSetting van toepassing op de site, indien ingesteld. Anders staat JavaScript-optimalisatie aan voor de site.";
JavaScriptOptimizerBlockedForSites.pfm_title = "JavaScript-optimalisaties blokkeren op deze sites";
JavaScriptOptimizerBlockedForSites.pfm_description = "Hiermee kun je een lijst met URL-patronen instellen voor sites waarvoor geavanceerde JavaScript-optimalisaties zijn uitgezet.\n\nAls je JavaScript-optimalisaties uitzet, kan Brave er langer over doen om webcontent te renderen.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\nJokertekens (*) zijn toegestaan.\n\nUitzonderingen op het beleid kunnen worden ingesteld voor specifieke subdomeinen en hele sites.\nEen beleid dat alleen voor subdomein.site.com is ingesteld, is bijvoorbeeld van toepassing op subdomein.site.com zonder dat dit van invloed is op site.com. In sommige gevallen waarin een subdomein niet kan worden geïsoleerd van de bovenliggende site, kan het beleid worden overgenomen dat is ingesteld op site.com. Uitzonderingen worden misschien ook pas van kracht voor frames die in een bestaand tabblad zijn geladen als de site wordt geopend in een nieuw tabblad. Op Android-apparaten met weinig geheugen worden sitespecifieke uitzonderingen misschien niet afgedwongen. In plaats daarvan gebruiken sites het beleid van DefaultJavaScriptOptimizerSetting (als dit is ingesteld) of de standaardinstelling voor JavaScript-optimalisatie van het profiel.\n\nBrave kan sites of subdomeinen waarvan de instelling afwijkt van de standaardinstelling in speciale processen plaatsen om uitzonderingen af te dwingen. Dit kan het geheugengebruik verhogen, vooral op Android of als een jokertekenpatroon overeenkomt met veel subdomeinen, omdat elke overeenkomende oorsprong afzonderlijk kan worden geïsoleerd. Geïsoleerde subdomeinen kunnen ook geen document.domain gebruiken om toegang te krijgen tot hun bovenliggende site.\n\nOpmerking: In versie 138 en lager werden beleidsuitzonderingen alleen afgedwongen op site-detailniveau (eTLD+1). Een beleid dat alleen voor subdomein.site.com is ingesteld, werd niet van kracht, zelfs niet voor subdomein.site.com. Het moest worden ingesteld op site.com om van toepassing te zijn op zowel site.com als subdomein.site.com.\n\nDit beleid wordt frame voor frame toegepast en niet alleen op basis van de URL van de oorsprong op het hoogste niveau. Als site-one.com bijvoorbeeld wordt vermeld in het beleid JavaScriptOptimizerBlockedForSites, maar site-one.com een frame laadt dat site-two.com bevat, worden JavaScript-optimalisaties uitgezet voor site-one.com, maar gebruikt site-two.com het beleid van DefaultJavaScriptOptimizerSetting, als dit is ingesteld, of worden JavaScript-optimalisaties standaard aangezet. Vermeldingen op de blokkeerlijst hebben een hogere prioriteit dan vermeldingen op de toelatingslijst, die op hun beurt een hogere prioriteit hebben dan de ingestelde standaardwaarde.\n\nAls dit beleid niet is ingesteld voor een site, is het beleid van DefaultJavaScriptOptimizerSetting van toepassing op de site, als dit is ingesteld. Anders staat JavaScript-optimalisatie aan voor de site.";
LiveCaptionEnabled.pfm_title = "Live ondertiteling aanzetten";
LiveCaptionEnabled.pfm_description = "Zet de functie Live ondertiteling aan.\n\nAls je dit beleid toepast, staat Live ondertiteling altijd aan.\n\nAls je dit beleid niet toepast, staat Live ondertiteling altijd uit.\n\nAls je dit beleid als verplicht instelt, kunnen gebruikers de instelling niet wijzigen of overschrijven.\n\nAls je dit beleid niet instelt, staat Live ondertiteling in eerste instantie uit, maar kan de gebruiker deze functie op elk moment aanzetten.";
LiveTranslateEnabled.pfm_title = "Live vertalen aanzetten";
LiveTranslateEnabled.pfm_description = "Zet vertaling van live ondertiteling aan. Ondertiteling wordt naar Google gestuurd voor vertaling.\n\nAls je dit beleid toepast, staat Live vertalen altijd aan.\n\nAls je dit beleid niet toepast, staat Live Translate altijd uit.\n\nAls je dit beleid als verplicht instelt, kunnen gebruikers de instelling niet wijzigen of overschrijven.\n\nAls je dit beleid niet instelt, staat Live vertalen in eerste instantie uit, maar kan de gebruiker deze functie op elk moment aanzetten.\n\nAls je LiveCaptionEnabled niet toepast, staat Live vertalen uit, ongeacht deze beleidsinstelling.";
LocalFontsAllowedForUrls.pfm_title = "Het recht voor lokale lettertypen toestaan op deze sites";
LocalFontsAllowedForUrls.pfm_description = "Hiermee wordt een lijst met URL-patronen voor sites ingesteld waarmee sites worden gespecificeerd waarvoor het recht voor lokale lettertypen automatisch wordt verleend. Dit is een uitbreiding van de mogelijkheid van sites om informatie over lokale lettertypen te bekijken.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige site-URL-patronen. Jokertekens (*) zijn toegestaan. Dit beleid zoekt alleen overeenkomsten op basis van de herkomst, dus elk pad in het URL-patroon wordt genegeerd.\n\nAls dit beleid niet is ingesteld voor een site, is het beleid van DefaultLocalFontsSetting van toepassing op de site (als dit is ingesteld), anders worden de standaardinstellingen van de browser gevolgd en kunnen gebruikers per site kiezen of ze dit recht willen verlenen.";
LocalFontsBlockedForUrls.pfm_title = "Het recht voor lokale lettertypen blokkeren op deze sites";
LocalFontsBlockedForUrls.pfm_description = "Hiermee wordt een lijst met URL-patronen voor sites ingesteld waarmee sites worden gespecificeerd waarvoor het recht voor lokale lettertypen automatisch wordt geweigerd. Dit beperkt de mogelijkheid van sites om informatie over lokale lettertypen te bekijken.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige site-URL-patronen. Jokertekens (*) zijn toegestaan. Dit beleid zoekt alleen overeenkomsten op basis van de oorsprong, dus elk pad in het URL-patroon wordt genegeerd.\n\nAls dit beleid niet is ingesteld voor een site, is het beleid van DefaultLocalFontsSetting van toepassing op de site (als dit is ingesteld), anders worden de standaardinstellingen van de browser gevolgd en kunnen gebruikers per site kiezen of ze dit recht willen verlenen.";
LocalNetworkAccessAllowedForUrls.pfm_title = "Toestaan dat sites netwerkverzoeken naar lokale apparaten en lokale netwerkeindpunten sturen.";
LocalNetworkAccessAllowedForUrls.pfm_description = "Lijst met URL-patronen. Netwerkverzoeken die worden gestart vanaf websites die worden geleverd via overeenkomende oorsprongen, worden niet onderworpen aan Local Network Access-checks.\n\nVoor oorsprongen die niet overeenkomen met de hier genoemde patronen, is de persoonlijke configuratie van de gebruiker van toepassing.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\n\nZie https://wicg.github.io/local-network-access/ voor beperkingen voor Local Network Access.\n\nEr zijn meerdere beleidsregels met oorsprongen die van invloed zijn op verzoeken aan lokale apparaten en lokale netwerkeindpunten. Als een oorsprong overeenkomt met meer dan één van de volgende beleidsregels, hebben de beleidsregels voorrang in deze volgorde:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "Voorkomen dat sites netwerkverzoeken naar lokale apparaten en lokale netwerkeindpunten sturen.";
LocalNetworkAccessBlockedForUrls.pfm_description = "Lijst met URL-patronen. Netwerkverzoeken die worden gestart vanaf websites die worden geleverd via overeenkomende oorsprongen, worden geblokkeerd voor het indienen van Local Network Access-verzoeken.\n\nVoor oorsprongen die niet overeenkomen met de hier genoemde patronen, is de persoonlijke configuratie van de gebruiker van toepassing.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\n\nZie https://wicg.github.io/local-network-access/ voor beperkingen voor Local Network Access.\n\nEr zijn meerdere beleidsregels met oorsprongen die van invloed zijn op verzoeken aan lokale apparaten en lokale netwerkeindpunten. Als een oorsprong overeenkomt met meer dan één van de volgende beleidsregels, hebben de beleidsregels voorrang in deze volgorde:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "Toewijzingen van IP-adresruimtes overschrijven";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "Dit kan worden gebruikt om bepaalde interne adresbereiken te behandelen als 'openbaar', wat inhoudt dat ze niet onder Local Network Access-controles vallen. Omgekeerd kan dit worden gebruikt om bepaalde openbare adresbereiken die intern kunnen worden gebruikt, te behandelen als 'lokaal' zodat ze worden beschermd door Local Network Access-controles.\n\nEr zijn 2 vormen van overschrijvingen van IP-adresruimtes:\n\n[cidr]=[public|local|loopback]\n\nwaarbij [cidr] een IP-adresbereik is in CIDR-notatie (zie paragraaf 3.1 van https://tools.ietf.org/html/rfc4632 voor IPv4 en paragraaf 2.3 van https://tools.ietf.org/html/rfc4291 voor IPv6). IPv6-adressen moeten worden ingevoerd in een voor URL's geschikte indeling (met haakjes). CIDR-overschrijvingen zijn van toepassing op alle poorten.\n\nof\n\n[ip-address]:[port]=[public|local|loopback]\n\nGa voor meer informatie over Local Network Access naar https://wicg.github.io/local-network-access/ en https://developer.chrome.com/blog/local-network-access.\n\nDit beleid ondersteunt geen dynamische vernieuwing.\n\nOverschrijvingen via de opdrachtregelschakelaar --ip-address-space-overrides hebben voorrang op overschrijvingen die zijn ingesteld via dit beleid.";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "Verzoeken voor lokale netwerktoegang (Local Network Access, LNA) in subframes toestaan zonder expliciete machtiging";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "Standaard kunnen de rechten voor lokale netwerktoegang (Local Network Access, LNA) alleen worden aangevraagd in cross-origin-subframes als ze expliciet zijn gemachtigd. Je kunt dit beleid gebruiken om dit standaardgedrag te overschrijven, zodat LNA-rechten standaard worden overgenomen in subframes, tenzij expliciet geweigerd in het rechtenbeleid.\n\nAls je dit beleid toepast, worden subframes standaard gemachtigd voor alle functies voor LNA-rechtenbeleid en kunnen ze lokale netwerkverzoeken doen (waardoor de rechtenprompt wordt geactiveerd).\n\nAls je dit beleid niet toepast of niet instelt, moeten subframes expliciet de functie voor rechtenbeleid krijgen om lokale netwerkverzoeken te doen en de rechtenprompt te activeren.\n\nDit beleid is van toepassing op de functies \"local-network-access\", \"loopback-network\" en \"local-network\" van het rechtenbeleid.\n\nGa voor meer informatie over lokale netwerktoegang naar https://wicg.github.io/local-network-access/ en https://developer.chrome.com/blog/local-network-access.\n\nGa naar https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy voor meer informatie over rechtenbeleid.";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "Bepaalt of je je (tijdelijk) wilt afmelden voor beperkingen voor toegang tot lokaal netwerk";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "Als je dit beleid toepast, worden er alleen waarschuwingen getoond in Chrome DevTools voor Local Network Access-verzoeken omdat de Local Network Access-controles mislukken.\n\nAls je dit beleid niet toepast of niet instelt, wordt de standaardafhandeling van deze verzoeken gebruikt voor Local Network Access-verzoeken.\n\nZie https://wicg.github.io/local-network-access/ voor beperkingen voor Local Network Access.\n\nDit bedrijfsbeleid is tijdelijk en wordt verwijderd na M163.\n\nOp de lange termijn kun je het beleid LocalNetworkAccessAllowedForUrls gebruiken om URL-patronen op de toelatingslijst te zetten waarvoor het recht Local Network Access automatisch moet worden verleend.";
LocalNetworkAllowedForUrls.pfm_title = "Toestaan dat sites netwerkverzoeken naar lokale netwerkeindpunten sturen.";
LocalNetworkAllowedForUrls.pfm_description = "Lijst met URL-patronen. Netwerkverzoeken die worden gestart vanaf websites die via overeenkomende oorsprongen worden geleverd aan lokale netwerkeindpunten, worden niet onderworpen aan Local Network Access-checks.\n\nVoor oorsprongen die niet overeenkomen met de hier genoemde patronen, is de persoonlijke configuratie van de gebruiker van toepassing.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\n\nZie https://wicg.github.io/local-network-access/ voor beperkingen voor Local Network Access.\n\nEr zijn meerdere beleidsregels met oorsprongen die van invloed zijn op verzoeken aan lokale netwerkeindpunten. Als een oorsprong overeenkomt met meer dan één van de volgende beleidsregels, hebben de beleidsregels voorrang in deze volgorde:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkBlockedForUrls.pfm_title = "Voorkomen dat sites netwerkverzoeken naar lokale netwerkeindpunten sturen.";
LocalNetworkBlockedForUrls.pfm_description = "Lijst met URL-patronen. Voor netwerkverzoeken die worden gestart vanaf websites die via overeenkomende oorsprongen worden geleverd aan lokale netwerkeindpunten, wordt voorkomen dat ze Local Network Access-verzoeken indienen.\n\nVoor oorsprongen die niet overeenkomen met de hier genoemde patronen, is de persoonlijke configuratie van de gebruiker van toepassing.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\n\nZie https://wicg.github.io/local-network-access/ voor beperkingen voor Local Network Access.\n\nEr zijn meerdere beleidsregels met oorsprongen die van invloed zijn op verzoeken aan lokale netwerkeindpunten. Als een oorsprong overeenkomt met meer dan één van de volgende beleidsregels, hebben de beleidsregels voorrang in deze volgorde:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LookalikeWarningAllowlistDomains.pfm_title = "Waarschuwingen voor nagebootste domeinen onderdrukken voor domeinen";
LookalikeWarningAllowlistDomains.pfm_description = "Dit beleid voorkomt dat er waarschuwingen worden getoond voor nagebootste URL's op de vermelde sites. Deze waarschuwingen worden meestal getoond op sites waarvan Brave denkt dat deze misschien een andere site proberen te spoofen die bij de gebruiker bekend is.\n\nAls je het beleid toepast en instelt op een of meer domeinen, worden er geen waarschuwingen voor nagebootste URL's getoond als de gebruiker pagina's in dat domein bezoekt.\n\nAls je het beleid niet instelt of instelt op een lege lijst, kunnen er waarschuwingen worden getoond op elke site die de gebruiker bezoekt.\n\nEen hostnaam kan worden toegestaan als deze exact overeenkomt met een host of overeenkomt met een domein. Voor een URL zoals https://foo.example.com/bar kunnen waarschuwingen bijvoorbeeld worden onderdrukt als deze lijst foo.example.com of example.com bevat.";
LoopbackNetworkAllowedForUrls.pfm_title = "Toestaan dat sites netwerkverzoeken naar het lokale apparaat sturen.";
LoopbackNetworkAllowedForUrls.pfm_description = "Lijst met URL-patronen. Netwerkverzoeken die worden gestart vanaf websites die via overeenkomende oorsprongen worden geleverd aan het lokale apparaat, worden niet onderworpen aan Local Network Access-checks.\n\nVoor oorsprongen die niet overeenkomen met de hier genoemde patronen, is de persoonlijke configuratie van de gebruiker van toepassing.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\n\nZie https://wicg.github.io/local-network-access/ voor beperkingen voor Local Network Access.\n\nEr zijn meerdere beleidsregels met oorsprongen die van invloed zijn op verzoeken aan het lokale apparaat. Als een oorsprong overeenkomt met meer dan één van de volgende beleidsregels, hebben de beleidsregels voorrang in deze volgorde:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LoopbackNetworkBlockedForUrls.pfm_title = "Voorkomen dat sites netwerkverzoeken naar het lokale apparaat sturen.";
LoopbackNetworkBlockedForUrls.pfm_description = "Lijst met URL-patronen. Voor netwerkverzoeken die worden gestart vanaf websites die via overeenkomende oorsprongen worden geleverd aan het lokale apparaat, wordt voorkomen dat ze Local Network Access-verzoeken indienen.\n\nVoor oorsprongen die niet overeenkomen met de hier genoemde patronen, is de persoonlijke configuratie van de gebruiker van toepassing.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige URL-patronen.\n\nZie https://wicg.github.io/local-network-access/ voor beperkingen voor Local Network Access.\n\nEr zijn meerdere beleidsregels met oorsprongen die van invloed zijn op verzoeken aan het lokale apparaat. Als een oorsprong overeenkomt met meer dan één van de volgende beleidsregels, hebben de beleidsregels voorrang in deze volgorde:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
ManagedBookmarks.pfm_title = "Beheerde bookmarks";
ManagedBookmarks.pfm_description = "Als je het beleid instelt, wordt er een lijst met bookmarks ingesteld, waarbij elke bookmark een woordenboek is met de sleutels 'name' en 'url'. Deze sleutels bevatten de naam en target van de bookmark. Beheerders kunnen een submap instellen door een bookmark zonder de sleutel 'url', maar met de aanvullende sleutel 'children' te definiëren. Deze sleutel bevat ook een lijst met bookmarks, waarvan sommige ook mappen kunnen zijn. Chrome vult onvolledige URL's aan alsof ze via de adresbalk zijn opgegeven. Zo wordt 'google.com' aangevuld tot 'https://google.com/'.\n\nGebruikers kunnen de mappen waarin de bookmarks zijn geplaatst niet wijzigen (maar ze kunnen deze wel verbergen via de bookmarkbalk). De standaard mapnaam voor beheerde bookmarks is 'Beheerde bookmarks' maar je kunt deze naam wijzigen door een nieuw subwoordenboek aan het beleid toe te voegen met één sleutel met de naam 'toplevel_name' en met de gewenste map als waarde. Beheerde bookmarks worden niet gesynchroniseerd met het gebruikersaccount en kunnen niet worden gewijzigd via extensies.\nGa naar https://chromeenterprise.google/policies/?policy=ManagedBookmarks voor meer informatie over schema en indeling.";
ManagedConfigurationPerOrigin.pfm_title = "Stelt waarden voor beheerde configuraties voor websites in voor specifieke herkomsten";
ManagedConfigurationPerOrigin.pfm_description = "Als je dit beleid instelt, wordt de waarde gedefinieerd die de Managed Configuration API voor een bepaalde herkomst retourneert.\n\n De Managed Configuration API is een sleutel/waarde-configuratie waartoe je toegang hebt via de JavaScript-aanroep navigator.managed.getManagedConfiguration(). Deze API is alleen beschikbaar voor herkomsten die overeenkomen met afgedwongen geïnstalleerde web-apps via WebAppInstallForceList.\n\nGa naar https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin voor meer informatie over schema en indeling.";
MaxConnectionsPerProxy.pfm_title = "Maximumaantal gelijktijdige verbindingen per proxyserver voor niet-WebSocket-verzoeken";
MaxConnectionsPerProxy.pfm_description = "Als je het beleid instelt, geef je het maximale aantal gelijktijdige verbindingen per proxyserver aan voor niet-WebSocket-verzoeken.\n\nZie MaxConnectionsPerProxyForWebSocket om de limieten voor WebSocket-verzoeken aan te passen.\n\nAls je het beleid niet instelt, wordt de standaardwaarde 128 gebruikt.\n\nHet is bekend dat sommige web-apps veel verbindingen gebruiken voor openstaande GET-verzoeken. Als je een waarde lager dan 128 instelt, lopen netwerkprocessen van de browser daarom mogelijk vast als er te veel web-apps met openstaande verbindingen zijn geopend.\nBepaalde proxyservers kunnen niet een groot aantal gelijktijdige verbindingen per client verwerken. Dit kan worden opgelost door dit beleid op een lagere waarde in te stellen.\n\nDe waarde moet gelijk zijn aan of hoger zijn dan 6.\nAls je een waarde onder die limiet instelt, wordt 6 gebruikt.\nHet tot onder de standaardwaarde (128) verlagen van deze waarde is daarom op eigen risico.\n\nDe waarde moet gelijk zijn aan of lager zijn dan 256 (99 in Brave 147 en eerdere versies).\nAls je een waarde boven die limiet instelt, wordt 256 gebruikt (99 in Brave 147 en eerdere versies).\nAls je deze waarde tot boven de standaardwaarde (128) verhoogt, doe je dat op eigen risico.\n\nDe afgedwongen limieten worden beïnvloed door AllowSocketPoolSizeRandomizationForProxies.";
MaxConnectionsPerProxyForWebSocket.pfm_title = "Maximumaantal gelijktijdige verbindingen per proxyserver voor WebSocket-verzoeken";
MaxConnectionsPerProxyForWebSocket.pfm_description = "Als je het beleid instelt, geef je het maximale aantal gelijktijdige verbindingen per proxyserver aan voor WebSocket-verzoeken.\n\nZie MaxConnectionsPerProxy om limieten voor niet-WebSocket-verzoeken aan te passen.\n\nAls je het beleid niet instelt, wordt de standaardwaarde 128 gebruikt.\n\nHet is bekend dat sommige web-apps veel verbindingen gebruiken voor openstaande GET-verzoeken. Als je een waarde lager dan 128 instelt, lopen netwerkprocessen van de browser daarom mogelijk vast als er te veel web-apps met openstaande verbindingen zijn geopend.\nBepaalde proxyservers kunnen niet een groot aantal gelijktijdige verbindingen per client verwerken. Dit kan worden opgelost door dit beleid op een lagere waarde in te stellen.\n\nDe waarde moet gelijk zijn aan of hoger zijn dan 6.\nAls je een waarde onder die limiet instelt, wordt 6 gebruikt.\nHet tot onder de standaardwaarde (128) verlagen van deze waarde is daarom op eigen risico.\n\nDe waarde moet gelijk zijn aan of lager zijn dan 256.\nAls je een waarde boven die limiet instelt, wordt 256 gebruikt.\nAls je deze waarde tot boven de standaardwaarde (128) verhoogt, doe je dat op eigen risico.\n\nDe afgedwongen limieten worden beïnvloed door AllowSocketPoolSizeRandomizationForProxies.";
MaxInvalidationFetchDelay.pfm_title = "Maximum vertraging voor ophalen na ongeldigverklaring voor beleid";
MaxInvalidationFetchDelay.pfm_description = "Als je het beleid instelt, wordt de maximumvertraging in milliseconden gespecificeerd tussen het ontvangen van een ongeldigverklaring van een beleid en het ophalen van het nieuwe beleid uit de apparaatbeheerservice. Geldige waarden liggen tussen 1000 (1 seconde) en 300.000 (5 minuten). Waarden buiten dit bereik worden vast ingesteld op de respectieve grenswaarde.\n\nAls je het beleid niet instelt, gebruikt Brave de standaardwaarde van 10 seconden.";
MediaRecommendationsEnabled.pfm_title = "Media-aanbevelingen aanzetten";
MediaRecommendationsEnabled.pfm_description = "De browser toont standaard media-aanbevelingen die zijn gepersonaliseerd voor de gebruiker. Als je dit beleid niet toepast, ziet de gebruiker deze aanbevelingen niet. Als je dit beleid toepast of niet instelt, ziet de gebruiker de media-aanbevelingen.";
MediaRouterCastAllowAllIPs.pfm_title = "Google Cast toestaan om verbinding te maken met Cast-apparaten op alle IP-adressen.";
MediaRouterCastAllowAllIPs.pfm_description = "Als je MediaRouterCastAllowAllIPs toepast, maakt Google Cast verbinding met cast-apparaten op alle IP-adressen en niet alleen op RFC1918/RFC4193-privéadressen, tenzij je EnableMediaRouter niet toepast.\n\nAls je het beleid niet toepast, maakt Google Cast alleen verbinding met cast-apparaten op RFC1918/RFC4193.\n\nAls je het beleid niet instelt, maakt Google Cast alleen verbinding met cast-apparaten op RFC1918/RFC4193, tenzij de functie CastAllowAllIPs aanstaat.";
MemorySaverModeSavings.pfm_title = "Besparingen in de modus Geheugenbesparing wijzigen";
MemorySaverModeSavings.pfm_description = "0 - Gemiddelde geheugenbesparingen.\n1 - Gebalanceerde geheugenbesparingen.\n2 - Maximale geheugenbesparingen.\nMet dit beleid wijzig je het besparingsniveau van Geheugenbesparing.\n\nDit is alleen van kracht als Geheugenbesparing is aangezet via de instellingen of via het beleid HighEfficiencyModeEnabled en heeft invloed op hoe heuristieken worden gebruikt om te bepalen wanneer tabbladen moeten worden verwijderd. Als je bijvoorbeeld de levensduur van een inactief tabblad verkort voordat je het verwijdert, kun je geheugen besparen. Het betekent ook dat tabbladen vaker worden geladen, wat kan leiden tot een slechte gebruikerservaring en meer netwerkverkeer.\n\nAls je het beleid instelt op 0, zorgt Geheugenbesparing voor gemiddelde geheugenbesparingen. Tabbladen worden na een langere periode inactief.\n\nAls je het beleid instelt op 1, zorgt Geheugenbesparing voor gebalanceerde geheugenbesparingen. Je tabbladen worden na een optimale periode inactief.\n\nAls je het beleid instelt op 2, zorgt Geheugenbesparing voor maximale geheugenbesparingen. Je tabbladen worden na een kortere periode inactief.\n\nAls je dit beleid niet instelt, kan de eindgebruiker deze instelling beheren in chrome://settings/performance.";
MetricsReportingEnabled.pfm_title = "Rapportage van gebruiks- en crashgegevens aanzetten";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "Kaarten tonen op de pagina Nieuw tabblad";
NTPCardsVisible.pfm_description = "Met dit beleid bepaal je of er kaarten worden getoond op de pagina Nieuw tabblad. Kaarten tonen startpunten voor algemene gebruikerstrajecten op basis van het browsegedrag van de gebruiker.\n\nAls je het beleid toepast, laat de pagina Nieuw tabblad kaarten zien als er content beschikbaar is.\n\nAls je het beleid niet toepast, laat de pagina Nieuw tabblad geen kaarten zien.\n\nAls je het beleid niet instelt, kan de gebruiker zelf bepalen of de kaarten wel of niet zichtbaar zijn. De standaardwaarde is 'zichtbaar'.\n";
NTPCustomBackgroundEnabled.pfm_title = "Gebruikers toestaan de achtergrond van de pagina 'Nieuw tabblad' aan te passen";
NTPCustomBackgroundEnabled.pfm_description = "Als het beleid is ingesteld op Onwaar, kunnen gebruikers de achtergrond van de pagina Nieuw tabblad niet aanpassen. Eventuele bestaande aangepaste achtergronden worden definitief verwijderd, zelfs als het beleid later weer wordt ingesteld op Waar.\n\nAls het beleid wordt ingesteld op Waar of niet wordt ingesteld, kunnen gebruikers de achtergrond van de pagina Nieuw tabblad aanpassen.\n\nOpmerking: Voor Android wordt het beleid pas toegepast op de browser nadat deze opnieuw is opgestart.";
NTPFooterExtensionAttributionEnabled.pfm_title = "Bepalen of de toeschrijving van de extensie zichtbaar is op de pagina Nieuw tabblad";
NTPFooterExtensionAttributionEnabled.pfm_description = "Dit beleid bepaalt of een toeschrijving aan de extensie die de pagina Nieuw tabblad (New Tab Page, NTP) aanpast, wordt getoond in de voettekst van de NTP.\n\nAls een extensie de normale NTP heeft overschreven, wordt standaard een bericht in de voettekst getoond waarin deze wijziging aan de specifieke extensie wordt toegeschreven. Deze toeschrijving bevat meestal een link naar de relevante extensie in de Chrome Web Store.\n\nAls je dit beleid niet instelt of instelt op Waar, is de toeschrijving van de extensie zichtbaar in de voettekst van de NTP als een extensie de NTP beheert.\n\nAls je dit beleid instelt op Onwaar, wordt de toeschrijving aan de extensie in de NTP-voettekst onderdrukt.";
NTPFooterManagementNoticeEnabled.pfm_title = "De zichtbaarheid van de beheermelding op de pagina Nieuw tabblad voor beheerde browsers beheren";
NTPFooterManagementNoticeEnabled.pfm_description = "Met dit beleid bepaal je of de beheermelding zichtbaar is in de voettekst van de pagina Nieuw tabblad (NTP). De NTP-voettekst toont standaard informatie als de browser wordt beheerd door een organisatie (aangegeven met een gebouwicoon en 'Beheerd door [domeinnaam]'). Dit kan worden aangepast met het beleid EnterpriseCustomLabelForBrowser en EnterpriseLogoUrlForBrowser.\n\nAls je dit beleid niet instelt of instelt op Waar, tonen beheerde browsers een melding 'Beheerd door…' met een icoon.\n\nAls je dit beleid instelt op Onwaar, wordt de beheermelding verborgen.\n\nDit beleid wordt alleen toegepast voor beheerde browsers. Het heeft dus geen effect voor beheerde gebruikers in onbeheerde browsers.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
NTPOutlookCardVisible.pfm_title = "Kaart Outlook-agenda tonen op de pagina Nieuw tabblad";
NTPOutlookCardVisible.pfm_description = "Met dit beleid bepaal je of de kaart Outlook zichtbaar is op de pagina Nieuw tabblad. De kaart wordt alleen op de pagina Nieuw tabblad getoond als het beleid wordt toegepast en je organisatie het gebruik van de Outlook-agendagegevens in de browser heeft goedgekeurd.\n\nOutlook-gegevens worden niet opgeslagen door de browser.\n\nDe kaart Outlook toont de volgende agenda-afspraak en een snel overzicht van de rest van de vergaderingen van de dag. Het doel is om het probleem van contextwisseling aan te pakken en de productiviteit te verbeteren door gebruikers een snelkoppeling naar hun volgende vergadering te geven.\n\nDe kaart Microsoft Outlook vereist extra beheerdersconfiguratie. Ga naar https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards voor gedetailleerde informatie over hoe je de kaart op de pagina Nieuw tabblad van Chrome koppelt aan Outlook.\n\nAls NTPCardsVisible niet wordt toegepast, wordt de kaart Outlook niet getoond. Als NTPCardsVisible wordt toegepast, wordt de kaart Outlook getoond als dit beleid ook wordt toegepast en er gegevens zijn om te tonen. Als NTPCardsVisible niet is ingesteld, wordt de kaart Outlook getoond als dit beleid ook wordt toegepast, de gebruiker de kaart heeft aangezet in Chrome aanpassen en er gegevens zijn om te tonen.";
NTPSharepointCardVisible.pfm_title = "Kaart SharePoint- en OneDrive-bestand tonen op de pagina Nieuw tabblad";
NTPSharepointCardVisible.pfm_description = "Dit beleid bepaalt de zichtbaarheid van de kaart SharePoint- en OneDrive-bestand op de pagina Nieuw tabblad. De kaart wordt alleen op de pagina Nieuw tabblad getoond als het beleid wordt toegepast en je organisatie het gebruik van de SharePoint- en OneDrive-bestandsgegevens in de browser heeft geautoriseerd.\n\nSharePoint- en OneDrive-gegevens worden niet opgeslagen door de browser.\n\nDe kaart met aanbevelingen voor SharePoint- en OneDrive-bestanden toont een lijst met aanbevolen bestanden.  Het doel is om het probleem van contextwisseling aan te pakken en de productiviteit te verbeteren door gebruikers een snelkoppeling te geven naar hun belangrijkste documenten.\n\nDe kaart Microsoft SharePoint en OneDrive vereist extra beheerdersconfiguratie. Ga naar https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards voor gedetailleerde informatie over hoe je de kaart op de pagina Nieuw tabblad van Chrome koppelt aan SharePoint.\n\nAls NTPCardsVisible niet wordt toegepast, wordt de kaart SharePoint en OneDrive niet getoond. Als NTPCardsVisible wordt toegepast, wordt de kaart SharePoint en OneDrive getoond als dit beleid ook wordt toegepast en er gegevens zijn om te tonen. Als NTPCardsVisible niet is ingesteld, wordt de kaart SharePoint en OneDrive getoond als dit beleid ook wordt toegepast, de gebruiker de kaart heeft aangezet in Chrome aanpassen en er gegevens zijn om te tonen.";
NTPShortcuts.pfm_title = "Snelkoppelingen instellen op de pagina Nieuw tabblad";
NTPShortcuts.pfm_description = "Door het beleid in te stellen worden maximaal 10 aangepaste snelkoppelingen vooraf ingesteld op de pagina Nieuw tabblad van Brave.\n\nAls je dit beleid instelt, zien gebruikers deze snelkoppelingen standaard, naast hun persoonlijke snelkoppelingen. Gebruikers kunnen de zichtbaarheid van de snelkoppelingen van hun organisatie beheren in het deelvenster Chrome aanpassen.\n\nSnelkoppelings-URL's moeten uniek zijn.\n\nAls je allow_user_edit instelt op waar, kunnen gebruikers de naam van de snelkoppeling wijzigen. Als je dit beleid instelt op onwaar of niet instelt, kunnen gebruikers de naam niet bewerken.\n\nAls je allow_user_delete instelt op waar, kunnen gebruikers de snelkoppeling verwijderen. Als je het beleid instelt op onwaar of niet instelt, kunnen gebruikers de snelkoppeling niet verwijderen.\nGa naar https://chromeenterprise.google/policies/?policy=NTPShortcuts voor meer informatie over schema en indeling.";
NativeMessagingAllowlist.pfm_title = "Namen van de hosts voor systeemeigen berichten die moeten worden vrijgesteld van de blokkeringslijst";
NativeMessagingAllowlist.pfm_description = "Als je het beleid instelt, geef je aan welke hosts voor systeemeigen berichten niet onder de weigeringslijst vallen. Een weigeringslijst met de waarde * betekent dat alle hosts voor systeemeigen berichten worden geweigerd, tenzij ze expliciet zijn toegestaan.\n\nAlle hosts voor systeemeigen berichten zijn standaard toegestaan. Maar als alle hosts voor systeemeigen berichten door een beleidsregel worden geweigerd, kan de beheerder de toelatingslijst gebruiken om die beleidsregel te wijzigen.";
NativeMessagingBlocklist.pfm_title = "Namen van de verboden hosts voor systeemeigen berichten (of * voor alle)";
NativeMessagingBlocklist.pfm_description = "Als je dit beleid toepast, geef je aan welke hosts voor systeemeigen berichten niet mogen worden geladen. Een weigeringslijst met de waarde * betekent dat alle hosts voor systeemeigen berichten worden geweigerd, tenzij ze expliciet zijn toegestaan.\n\nAls je het beleid niet instelt, laadt Brave alle geïnstalleerde hosts voor systeemeigen berichten.";
NativeMessagingUserLevelHosts.pfm_title = "Hosts voor native berichten op gebruikersniveau toestaan (geïnstalleerd zonder beheerdersrechten)";
NativeMessagingUserLevelHosts.pfm_description = "Als je het beleid toepast of niet instelt, kan Brave de hosts voor systeemeigen berichten gebruiken die zijn geïnstalleerd op gebruikersniveau.\n\nAls je het beleid niet toepast, kan Brave deze hosts alleen gebruiken als ze zijn geïnstalleerd op systeemniveau.";
NetworkPredictionOptions.pfm_title = "Netwerkvoorspelling aanzetten";
NetworkPredictionOptions.pfm_description = "0 - Netwerkacties voorspellen voor elke netwerkverbinding\n1 - Netwerkacties voorspellen op elk netwerk dat niet mobiel is.\n(Beëindigd in 50, verwijderd in 52. Als na 52 waarde 1 is ingesteld, wordt deze waarde verwerkt als 0 - netwerkacties voorspellen voor elke netwerkverbinding.)\n2 - Geen netwerkacties voorspellen voor een netwerkverbinding\nMet dit beleid wordt netwerkvoorspelling in Brave beheerd. Hiermee worden DNS-prefetching, het vooraf verbinden met TCP en SSL en het vooraf renderen van webpagina's beheerd.\n\nAls je het beleid instelt, kunnen gebruikers het niet wijzigen. Als je het beleid niet instelt, wordt netwerkvoorspelling aangezet, maar kan de gebruiker dit wijzigen.";
NewTabPageLocation.pfm_title = "URL van pagina 'Nieuw tabblad'";
NewTabPageLocation.pfm_description = "Met dit beleid wordt de standaard-URL van de pagina Nieuw tabblad geconfigureerd en wordt voorkomen dat gebruikers deze kunnen wijzigen.\n\nDe pagina Nieuw tabblad wordt geopend als er nieuwe tabbladen en vensters worden geopend.\n\nMet dit beleid bepaal je niet welke pagina's worden geopend als de browser wordt opgestart. Deze pagina's worden beheerd door het beleid RestoreOnStartup. Dit beleid is wel van invloed op de homepage als hiervoor is ingesteld dat de pagina Nieuw tabblad moet worden geopend, maar ook op de startpagina als deze is ingesteld op de pagina Nieuw tabblad.\n\nHet is verstandig om de volledig canonieke URL op te geven. Als de URL niet volledig canoniek is, gebruikt Brave standaard https://.\n\nAls je het beleid niet instelt of leeg laat, wordt de standaardpagina Nieuw tabblad gebruikt.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
NotificationsAllowedForUrls.pfm_title = "Meldingen op deze sites toestaan";
NotificationsAllowedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van de sites die meldingen mogen weergeven.\n\nAls je het beleid niet instelt, is DefaultNotificationsSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
NotificationsBlockedForUrls.pfm_title = "Meldingen op deze sites blokkeren";
NotificationsBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van de sites die geen meldingen mogen weergeven.\n\nAls je het beleid niet instelt, is DefaultNotificationsSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
NtlmV2Enabled.pfm_title = "NTLMv2-verificatie aanzetten.";
NtlmV2Enabled.pfm_description = "Als je het beleid toepast of niet instelt, wordt NTLMv2 aangezet.\n\nAls je het beleid niet toepast, wordt NTLMv2 uitgezet.\n\nAlle recente versies van Samba- en Microsoft® Windows®-servers ondersteunen NTLMv2. Dit beleid mag niet worden toegepast voor compatibiliteit met eerdere versies, aangezien de beveiliging van de verificatie wordt verminderd.";
OopPrintDriversAllowed.pfm_title = "Printerstuurprogramma's buiten het proces toegestaan";
OopPrintDriversAllowed.pfm_description = "Bepaalt of Brave interactie heeft met printerstuurprogramma's vanuit een afzonderlijk serviceproces. Platformgebaseerde afdrukaanroepen om beschikbare printers op te vragen, instellingen voor printerstuurprogramma's op te halen en documenten in te dienen om af te drukken op lokale printers worden gedaan vanuit een serviceproces. Als je dit soort aanroepen uit het browserproces verplaatst, verbeter je de stabiliteit en verminder je het vastlopen van de UI in het afdrukvoorbeeld.\n\nAls je dit beleid toepast of niet instelt, gebruikt Brave een afzonderlijk serviceproces voor platformgebaseerde afdruktaken.\n\nAls je dit beleid niet toepast, gebruikt Brave het browserproces voor platformgebaseerde afdruktaken.\n\nDit beleid wordt in de toekomst verwijderd nadat de functie voor afdrukstuurprogramma's buiten het proces helemaal is uitgerold.";
OriginAgentClusterDefaultEnabled.pfm_title = "Staat origin-keyed agentclustering standaard toe.";
OriginAgentClusterDefaultEnabled.pfm_description = "Dit beleid staat origin-keyed agentclustering standaard toe.\n\nDe HTTP-header Origin-Agent-Cluster bepaalt of een document wordt geïsoleerd in een origin-keyed agentcluster of in een site-keyed agentcluster. Dit heeft beveiligingsimplicaties omdat een origin-keyed agentcluster isolatie van documenten op basis van oorsprong toestaat. Het voor de ontwikkelaar zichtbare gevolg hiervan is dat de accessor document.domain niet meer kan worden ingesteld.\n\nHet standaardgedrag (wanneer er geen header Origin-Agent-Cluster: is ingesteld) verandert in M111 van site-keyed naar origin-keyed.\n\nAls je dit beleid toepast of niet instelt, volgt de browser deze nieuwe standaardwaarde vanaf die versie.\n\nAls je dit beleid niet toepast, wordt deze wijziging teruggedraaid en worden documenten zonder een header Origin-Agent-Cluster: toegewezen aan site-keyed agentclusters. Als gevolg hiervan blijft de accessor document.domain standaard instelbaar. Dit komt overeen met het verouderde gedrag.\n\nZie https://developer.chrome.com/blog/immutable-document-domain/ voor meer informatie.";
OriginKeyedProcessesEnabled.pfm_title = "Zet op oorsprong gebaseerde procesisolatie standaard aan.";
OriginKeyedProcessesEnabled.pfm_description = "Zet op oorsprong gebaseerde procesisolatie aan voor de meeste pagina's (dat wil zeggen pagina's die standaard zijn toegewezen aan een op oorsprong gebaseerde agentclustering). Hiermee verbeter je de beveiliging, maar verhoog je ook het aantal gemaakte processen. Gebruikers mogen de ingestelde beleidswaarde overschrijven via de opdrachtregelmarkeringen of chrome://flags (beide om deze functie aan of uit te zetten).\n\nAls je het beleid toepast, worden de meeste oorsprongen geïsoleerd, zelfs van andere oorsprongen op dezelfde site. Bekijk ook het beleid IsolateOrigins en het beleid SitePerProcess.\n\nAls je het beleid niet toepast, worden er geen oorsprongen geïsoleerd van de rest van hun site, tenzij een oorsprong hier expliciet om vraagt.\n\nAls je het beleid niet instelt, bepaalt de browser welke oorsprongen moeten worden geïsoleerd en wanneer ze moeten worden geïsoleerd.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "Beginpunten of hostnaampatronen waarvoor geen beperkingen voor niet-beveiligde herkomsten zouden moeten gelden.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "Als je dit beleid instelt, wordt een lijst met oorsprongen (URL's) of hostnaampatronen (zoals '*.example.com') gedefinieerd waarop beveiligingsbeperkingen voor niet-beveiligde oorsprongen niet van toepassing zijn. Patronen worden alleen geaccepteerd voor hostnamen. URL's/oorsprongen met schema's moeten exacte tekenreeksen zijn. Organisaties kunnen oorsprongen aangeven voor verouderde apps die geen TLS kunnen implementeren, of een staging server voor interne webontwikkelingen instellen, zodat de ontwikkelaars functies die een beveiligde context vereisen, kunnen testen zonder TLS te hoeven implementeren op de staging server. Dit beleid verhindert ook dat de oorsprong wordt aangeduid als Niet beveiligd in de adresbalk.\n\nAls er een lijst met URL's wordt ingesteld in dit beleid, heeft dit hetzelfde effect als wanneer de opdrachtregelflag '--unsafely-treat-insecure-origin-as-secure' wordt ingesteld voor een door komma's gescheiden lijst met dezelfde URL's. Het beleid overschrijft de opdrachtregelflag en UnsafelyTreatInsecureOriginAsSecure, indien aanwezig.\n\nVoor meer informatie over een beveiligde context ga je naar https://www.w3.org/TR/secure-contexts.";
PartitionedBlobUrlUsage.pfm_title = "Kiezen of blob-URL's worden gepartitioneerd tijdens ophalen en navigeren";
PartitionedBlobUrlUsage.pfm_description = "Met dit beleid bepaal je of blob-URL's worden gepartitioneerd tijdens ophalen en navigeren.\nAls je dit beleid toepast of niet instelt, worden blob-URL's gepartitioneerd.\nAls je dit beleid niet toepast, worden blob-URL's niet gepartitioneerd.\n\nAls je het beleid moet gebruiken, dien je een bug in op Brave waarin je je use case uitlegt. Volgens de planning wordt het beleid voortgezet tot en met versie 146 van Brave, waarna de oude implementatie wordt verwijderd.\n\nOPMERKING: Wijzigingen in dit beleid worden alleen weergegeven in recent gestarte weergaveprocessen terwijl de browser actief is.\n\nGa naar https://developers.google.com/privacy-sandbox/cookies/storage-partitioning voor meer informatie over partitionering van opslag door derden.";
PasswordDismissCompromisedAlertEnabled.pfm_title = "Afwijzen van meldingen over gehackte wachtwoorden aanzetten voor de opgegeven inloggegevens";
PasswordDismissCompromisedAlertEnabled.pfm_description = "Als je het beleid toepast of niet instelt, krijgt de gebruiker de optie om meldingen voor gehackte wachtwoorden af te wijzen/te herstellen.\n\nAls je deze instelling uitzet, kunnen gebruikers meldingen over gehackte wachtwoorden niet afwijzen. Als je deze instelling aanzet, kunnen gebruikers meldingen over gehackte wachtwoorden afwijzen.";
PasswordLeakDetectionEnabled.pfm_title = "Datalekdetectie voor ingevoerde gegevens aanzetten";
PasswordLeakDetectionEnabled.pfm_description = "Als je het beleid toepast, kunnen gebruikers Brave laten checken of ingevoerde gebruikersnamen en wachtwoorden deel uitmaken van een gegevenslek.\n\nAls je het beleid niet toepast, hebben gebruikers geen toegang tot deze functionaliteit.\n\nAls je het beleid instelt, kunnen gebruikers het niet wijzigen in Brave. Als je het beleid niet instelt, is checken op gegevenslekken toegestaan, maar kan de gebruiker deze functie uitzetten.";
PasswordManagerBlocklist.pfm_title = "De lijst met domeinen instellen waarvoor Password Manager (Opslaan en Invullen) wordt uitgezet";
PasswordManagerBlocklist.pfm_description = "Stel de lijst met domeinen in waarvoor Brave Password Manager moet uitzetten. Dit betekent dat de workflows Opslaan en Invullen worden uitgezet, zodat wachtwoorden voor die websites niet worden opgeslagen of automatisch worden ingevuld in webformulieren.\n\nAls een domein in de lijst staat, wordt Password Manager voor dat domein uitgezet.\n\nAls een domein niet in de lijst staat, is Password Manager beschikbaar voor dat domein.\n\nAls je het beleid niet instelt, is Password Manager beschikbaar voor alle domeinen.\n\nGa naar https://support.google.com/chrome/a?p=url_blocklist_filter_format voor uitgebreide informatie over geldige URL-patronen.";
PasswordManagerEnabled.pfm_title = "Opslag van wachtwoorden in Wachtwoordmanager aanzetten";
PasswordManagerEnabled.pfm_description = "Dit beleid bepaalt of de browser wachtwoorden op websites automatisch kan onthouden en opslaan in de ingebouwde wachtwoordmanager. Het beleid beperkt de toegang niet en wijzigt de inhoud niet van wachtwoorden die in de wachtwoordmanager zijn opgeslagen en misschien zijn gesynchroniseerd met het Google-accountprofiel en Android.\n\nAls je het beleid toepast, kunnen gebruikers Brave wachtwoorden laten onthouden en gebruiken als ze opnieuw inloggen op een site.\n\nAls je het beleid niet toepast, kunnen gebruikers geen nieuwe wachtwoorden opslaan, maar kunnen ze nog wel gebruikmaken van eerder opgeslagen wachtwoorden.\n\nAls je het beleid instelt, kunnen gebruikers het niet wijzigen in Brave. Als je dit beleid niet instelt, kunnen gebruikers de functie voor opslag van wachtwoorden uitzetten.";
PasswordManagerPasskeysEnabled.pfm_title = "Opslaan van toegangssleutels in wachtwoordmanager aanzetten";
PasswordManagerPasskeysEnabled.pfm_description = "Dit beleid bepaalt of de browser toegangssleutels kan opslaan in de ingebouwde wachtwoordmanager. Het beleid beperkt de toegang niet en wijzigt de inhoud niet van toegangssleutels die al zijn opgeslagen in de wachtwoordmanager. Als het beleid PasswordManagerEnabled niet wordt toegepast, is opslaan in de ingebouwde wachtwoordmanager in het algemeen uitgezet, waaronder toegangssleutels en wachtwoorden. Dit beleid is dan niet van toepassing.\n\nAls je het beleid toepast of niet instelt, kunnen gebruikers toegangssleutels opslaan in de ingebouwde wachtwoordmanager als ze zijn ingelogd bij Brave.\n\nAls je het beleid niet toepast, kunnen gebruikers geen toegangssleutels opslaan in de ingebouwde wachtwoordmanager, maar kunnen ze nog wel gebruikmaken van eerder opgeslagen toegangssleutels.";
PasswordProtectionChangePasswordURL.pfm_title = "Configureer de URL voor het wijzigen van het wachtwoord.";
PasswordProtectionChangePasswordURL.pfm_description = "Als je dit beleid instelt, stel je de URL in waarmee gebruikers hun wachtwoord moeten wijzigen nadat zij een waarschuwing zien in de browser. De service voor wachtwoordbeveiliging stuurt gebruikers de URL (alleen HTTP- en HTTPS-protocollen) die je aangeeft via dit beleid. Zorg dat je pagina voor het wijzigen van wachtwoorden voldoet aan de richtlijnen op https://www.chromium.org/developers/design-documents/create-amazing-password-forms, zodat Brave de salted hash van het nieuwe wachtwoord op deze pagina voor het wijzigen van wachtwoorden juist vastlegt.\n\nAls je dit beleid niet toepast of niet instelt, stuurt de service gebruikers naar https://myaccount.google.com om hun wachtwoord te wijzigen.\n\nIn Microsoft® Windows® is deze functionaliteit alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is deze functionaliteit alleen beschikbaar voor instanties die via MDM worden beheerd, via MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
PasswordProtectionLoginURLs.pfm_title = "Configureer de lijst met zakelijke login-URL's waar de service voor wachtwoordbeveiliging salted hashes van wachtwoorden moet vastleggen.";
PasswordProtectionLoginURLs.pfm_description = "Als je het beleid instelt, wordt de lijst met zakelijke login-URL's (alleen HTTP- en HTTPS-protocollen) ingesteld. De service voor wachtwoordbeveiliging legt salted hashes van wachtwoorden op deze URL's vast en gebruikt ze om hergebruik van wachtwoorden op te sporen. Zorg ervoor dat je inlogpagina's voldoen aan de richtlijnen op https://www.chromium.org/developers/design-documents/create-amazing-password-forms, zodat Brave de 'salted hashes' van wachtwoorden juist vastlegt.\n\nAls je deze instelling uitzet of niet instelt, legt de service voor wachtwoordbeveiliging salted hashes van wachtwoorden alleen vast op https://accounts.google.com.\n\nIn Microsoft® Windows® is deze functionaliteit alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is deze functionaliteit alleen beschikbaar voor instanties die via MDM worden beheerd, via MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
PasswordProtectionWarningTrigger.pfm_title = "Waarschuwingstrigger voor wachtwoordbeveiliging";
PasswordProtectionWarningTrigger.pfm_description = "0 - Waarschuwing voor wachtwoordbeveiliging staat uit\n1 - Waarschuwing voor wachtwoordbeveiliging wordt geactiveerd bij hergebruik van een wachtwoord\n2 - Waarschuwing voor wachtwoordbeveiliging wordt geactiveerd bij hergebruik van een wachtwoord op een phishingpagina\nAls je dit beleid instelt, kun je de activering van de waarschuwing voor wachtwoordbeveiliging beheren. Wachtwoordbeveiliging waarschuwt gebruikers als ze hun beschermde wachtwoord opnieuw gebruiken op mogelijk verdachte sites.\n\nGebruik PasswordProtectionLoginURLs en PasswordProtectionChangePasswordURL om in te stellen welk wachtwoord moet worden beschermd.\n\nAls dit beleid is ingesteld op:\n\n* PasswordProtectionWarningOff, wordt er geen waarschuwing voor wachtwoordbeveiliging getoond.\n\n* PasswordProtectionWarningOnPasswordReuse, wordt de waarschuwing voor wachtwoordbeveiliging getoond als de gebruiker het beschermde wachtwoord opnieuw gebruikt op een site die niet op de toelatingslijst staat.\n\n* PasswordProtectionWarningOnPhishingReuse, wordt de waarschuwing voor wachtwoordbeveiliging getoond als de gebruiker het beschermde wachtwoord opnieuw gebruikt op een phishingsite.\n\nAls dit beleid niet is ingesteld, beschermt de service voor wachtwoordbeveiliging alleen Google-wachtwoorden, maar de gebruiker kan deze instelling wijzigen.";
PasswordSharingEnabled.pfm_title = "Delen van inloggegevens met andere gebruikers aanzetten";
PasswordSharingEnabled.pfm_description = "Als je het beleid aanzet, kunnen gebruikers hun wachtwoord sturen naar en krijgen van gezinsleden (volgens de Gezinsservice).\nAls het beleid aanstaat of niet is ingesteld, is er een knop in Wachtwoordmanager waarmee je een wachtwoord kunt sturen.\nDe ontvangen wachtwoorden worden opgeslagen in het account van de gebruiker en zijn beschikbaar in Wachtwoordmanager.\n\nAls je het beleid uitzet, kunnen gebruikers geen wachtwoorden van Wachtwoordmanager naar andere gebruikers sturen en geen wachtwoorden van andere gebruikers krijgen.\n\nDe functie is niet beschikbaar als synchronisatie van wachtwoorden uitstaat (via de gebruikersinstellingen of als het beleid SyncDisabled aanstaat).\n\nBeheerde accounts kunnen geen lid te worden van een gezinsgroep of er zelf een maken en kunnen daarom geen wachtwoorden delen.";
PaymentMethodQueryEnabled.pfm_title = "Websites toestaan beschikbare betaalmethoden op te vragen";
PaymentMethodQueryEnabled.pfm_description = "Hiermee kun je instellen of websites controleren of de gebruiker betaalmethoden heeft opgeslagen.\n\nAls dit beleid niet is toegepast, wordt er aan websites die de API PaymentRequest.canMakePayment of PaymentRequest.hasEnrolledInstrument gebruiken, doorgegeven dat er geen betaalmethoden beschikbaar zijn.\n\nAls de instelling is toegepast of niet is ingesteld, mogen websites controleren of de gebruiker betaalmethoden heeft opgeslagen.";
PdfAnnotationsEnabled.pfm_title = "Pdf-annotaties aanzetten";
PdfAnnotationsEnabled.pfm_description = "Beheert of er annotaties in pdf's kunnen worden gemaakt met de pdf-viewer in Brave.\n\nAls dit beleid niet is ingesteld of is ingesteld op true, kunnen met de pdf-viewer annotaties in pdf's worden gemaakt.\n\nAls dit beleid is ingesteld op false, kunnen met de pdf-viewer geen annotaties in pdf's worden gemaakt.";
PdfLocalFileAccessAllowedForDomains.pfm_title = "Lokale bestandstoegang tot file://-URL's op deze sites toestaan in de pdf-viewer";
PdfLocalFileAccessAllowedForDomains.pfm_description = "Als je dit beleid instelt, hebben de vermelde domeinen toegang tot file://-URL's in de pdf-viewer.\nAls je een domein aan dit beleid toevoegt, krijgt het toegang tot file://-URL's in de pdf-viewer.\nAls je een domein uit het beleid verwijdert, heeft het geen toegang meer tot file://-URL's in de pdf-viewer.\nAls je het beleid niet instelt, hebben alle domeinen geen toegang tot file://-URL's in de pdf-viewer.";
PdfUseSkiaRendererEnabled.pfm_title = "Skia-weergaveprogramma gebruiken voor pdf-weergave";
PdfUseSkiaRendererEnabled.pfm_description = "Hiermee bepaal je of de pdf-viewer in Brave het Skia-weergaveprogramma gebruikt.\n\nAls je dit beleid toepast, gebruikt de pdf-viewer het Skia-weergaveprogramma.\n\nAls je dit beleid niet toepast, gebruikt de pdf-viewer het huidige AGG-weergaveprogramma.\n\nAls je dit beleid niet instelt, wordt het pdf-weergaveprogramma gekozen door de browser.";
PolicyAtomicGroupsEnabled.pfm_title = "Hiermee wordt het concept van atomische beleidsgroepen toegepast";
PolicyAtomicGroupsEnabled.pfm_description = "Als je het beleid toepast, worden beleidsregels van een atomische groep genegeerd die niet dezelfde bron met de hoogste prioriteit van die groep hebben.\n\nAls je het beleid niet toepast, worden er geen beleidsregels genegeerd vanwege de bron. Beleidsregels worden alleen genegeerd als er een conflict is en het beleid niet de hoogste prioriteit heeft.\n\nAls je dit beleid instelt vanuit een cloudbron, kan het geen specifieke gebruiker targeten.";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "Toestaan dat woordenboekbeleid van verschillende bronnen wordt samengevoegd";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - URL's van handmatige uitzonderingen voor beheerde gebruikers\nDeviceLoginScreenPowerManagement - Energiebeheer op het inlogscherm\nExtensionSettings - Instellingen voor extensiebeheer\nKeyPermissions - Rechten voor sleutels\nPowerManagementIdleSettings - Instellingen voor energiebeheer wanneer de gebruiker inactief is\nScreenBrightnessPercent - Percentage voor helderheid van scherm\nScreenLockDelays - Drempels voor schermvergrendeling\nAls je het beleid instelt, kunnen de geselecteerde beleidsregels worden samengevoegd als ze afkomstig zijn van verschillende bronnen en hetzelfde bereik en niveau hebben. Dit samenvoegen vindt plaats in de sleutels op het eerste niveau van het woordenboek uit elke bron. De waarde die afkomstig is van de bron met de hoogste prioriteit, krijgt voorrang.\n\nGebruik het jokerteken '*' om samenvoeging van alle ondersteunde woordenboekbeleidsregels toe te staan.\n\nAls een beleid in de lijst staat en er een conflict is tussen bronnen met:\n\n* Hetzelfde bereik en niveau: de waarden worden samengevoegd in een nieuw beleidswoordenboek.\n\n* Verschillend bereik en niveau: het beleid met de hoogste prioriteit wordt toegepast.\n\nAls een beleid niet in de lijst staat en er een conflict tussen bronnen, bereik of niveau is, wordt het beleid met de hoogste prioriteit toegepast.";
PolicyListMultipleSourceMergeList.pfm_title = "Toestaan dat lijstbeleid van verschillende bronnen kan worden samengevoegd";
PolicyListMultipleSourceMergeList.pfm_description = "Als je het beleid instelt, kunnen de geselecteerde beleidsregels worden samengevoegd als ze afkomstig zijn van verschillende bronnen en hetzelfde bereik en niveau hebben.\n\nGebruik het jokerteken '*' om samenvoeging van alle lijstbeleidsregels toe te staan.\n\nAls een beleid in de lijst staat en er een conflict is tussen bronnen met:\n\n* Hetzelfde bereik en niveau: de waarden worden samengevoegd in een nieuwe beleidslijst.\n\n* Verschillend bereik en niveau: het beleid met de hoogste prioriteit wordt toegepast.\n\nAls een beleid niet in de lijst staat en er een conflict tussen bronnen, bereik of niveau is, wordt het beleid met de hoogste prioriteit toegepast.";
PolicyRefreshRate.pfm_title = "Vernieuwingsfrequentie voor gebruikersbeleid";
PolicyRefreshRate.pfm_description = "Als je het beleid instelt, wordt de periode in milliseconden gespecificeerd waarna de apparaatbeheerservice wordt gevraagd om informatie over het gebruikersbeleid. Geldige waarden liggen tussen 1.800.000 (30 minuten) en 86.400.000 (1 dag). Waarden buiten dit bereik worden vast ingesteld op de respectieve grenswaarde.\n\nAls je het beleid niet instelt, wordt de standaardwaarde van 3 uur gebruikt.\n\nOpmerking: Beleidsmeldingen dwingen een vernieuwing af als het beleid wordt gewijzigd, waardoor frequente vernieuwingen overbodig zijn. Als het platform deze meldingen ondersteunt, is de vernieuwingsvertraging 24 uur (hierbij worden alle standaardinstellingen en de waarde van dit beleid genegeerd).";
PopupsAllowedForUrls.pfm_title = "Pop-ups toestaan op deze sites";
PopupsAllowedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van de sites die pop-ups mogen openen.\n\nAls je het beleid niet instelt, is DefaultPopupsSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
PopupsBlockedForUrls.pfm_title = "Pop-ups blokkeren op deze sites";
PopupsBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van de sites die geen pop-ups mogen openen.\n\nAls je het beleid niet instelt, is DefaultPopupsSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
PreciseGeolocationAllowedForUrls.pfm_title = "Exacte geolocatie toestaan op deze sites";
PreciseGeolocationAllowedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen voor sites die toegang tot de geolocatie met hoge nauwkeurigheid van de gebruiker hebben zonder de gebruiker eerst om toestemming te vragen.\n\nAls je het beleid niet instelt, geldt DefaultGeolocationSetting voor alle sites (als dit is ingesteld). Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
PreferSlowCiphers.pfm_title = "Specifieke versleutelingsalgoritmen voor TLS gebruiken";
PreferSlowCiphers.pfm_description = "cnsa - Voorkeur geven aan versleutelingen die voldoen aan de vereisten van CNSA 1.0 en 2.0\ndefault - Standaard coderingsvolgorde van Brave gebruiken\nMet dit beleid stel je Brave in om de voorkeursversleutelingsalgoritmen in TLS 1.3 te ordenen op basis van een voorkeur voor algoritmen die zijn goedgekeurd door een specifiek nalevingsregime.\n\nAls je dit beleid instelt, garandeert dit niet dat er specifieke algoritmen worden onderhandeld.\n\nDit beleid is bedoeld om serverbeheerders die clients met en zonder nalevingsvereisten willen ondersteunen, onderscheid te laten maken tussen deze clients en alleen bepaalde niet-standaard algoritmen met verhoogde cryptografische sterkte te laten gebruiken voor clients die expliciet zijn ingesteld om deze te gebruiken.\n\nAls je het beleid instelt op cnsa, wordt Brave zo ingesteld dat het de voorkeur geeft aan versleutelingen die nodig zijn voor naleving van de Commercial National Security Algorithm Suite versie 1.0 en 2.0 (CNSA 1.0 en 2.0).\n\nAls je het beleid niet instelt of instelt op default, wordt Brave ingesteld om de standaardcijfers te gebruiken.\n\nHet is niet nodig om dit beleid in te stellen voor de beveiliging. De standaardversleuteling die Brave gebruikt, is sterk genoeg om een brute-force-aanval te weerstaan met de hele kracht van de zon.\n\nAls je dit beleid instelt, wordt Brave trager als je websites opent.\n\nDit beleid heeft alleen invloed op TLS 1.3 en QUIC. Het heeft geen invloed op eerdere versies van TLS.\n\nDit beleid kan worden ingesteld voor de machine en voor de gebruiker. Als dit beleid is ingesteld voor de gebruiker, heeft het alleen invloed op netwerkverzoeken die worden gestart door het gebruikersprofiel en misschien niet op netwerkverzoeken die door Brave worden gedaan om browserbrede achtergrondtaken uit te voeren. Deze worden beheerd door de waarde op machineniveau. Als dit beleid is ingesteld op zowel apparaat- als gebruikersniveau, is de waarde op apparaatniveau van toepassing, tenzij de volgorde van beleidsvoorrang is gewijzigd door het beleid CloudUserPolicyOverridesCloudMachinePolicy.\n\nVoor versie 155 en lager geldt dit beleid alleen voor het hele apparaat.";
PreferSlowKexAlgorithms.pfm_title = "Specifieke sleuteluitwisselingsalgoritmen voor TLS gebruiken";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - Voorkeur geven aan sleuteluitwisselingsmethoden die voldoen aan de vereisten van CNSA 2.0\ndefault - Standaard ondersteunde groepen van Brave gebruiken\nMet dit beleid stel je Brave in om de voorkeursalgoritmen voor sleutelovereenkomst (ondersteunde groepen) in TLS 1.3 te ordenen op basis van een voorkeur voor algoritmen die zijn goedgekeurd door een specifiek nalevingsregime.\n\nAls je dit beleid instelt, garandeert dit niet dat er specifieke algoritmen worden onderhandeld.\n\nDit beleid is bedoeld om serverbeheerders die clients met en zonder nalevingsvereisten willen ondersteunen, onderscheid te laten maken tussen deze clients en alleen bepaalde niet-standaard algoritmen met verhoogde cryptografische sterkte te laten gebruiken voor clients die expliciet zijn ingesteld om deze te gebruiken.\n\nAls je het beleid instelt op cnsa2, wordt Brave zo ingesteld dat het de voorkeur geeft aan sleuteluitwisselingsmethoden die nodig zijn voor naleving van de Commercial National Security Algorithm Suite 2.0 (CNSA 2.0).\n\nAls je het beleid niet instelt of instelt op default, wordt Brave ingesteld om de standaardmethoden voor sleuteluitwisseling te gebruiken.\n\nHet is niet nodig om dit beleid in te stellen voor de beveiliging. De standaardversleuteling die Brave gebruikt, is sterk genoeg om een brute-force-aanval te weerstaan met de hele kracht van de zon.\n\nAls je dit beleid instelt, wordt Brave trager als je websites opent.\n\nDit beleid heeft alleen invloed op TLS 1.3 en QUIC. Het heeft geen invloed op eerdere versies van TLS.\n\nDit beleid kan worden ingesteld voor de machine en voor de gebruiker. Als dit beleid is ingesteld voor de gebruiker, heeft het alleen invloed op netwerkverzoeken die worden gestart door het gebruikersprofiel en misschien niet op netwerkverzoeken die door Brave worden gedaan om browserbrede achtergrondtaken uit te voeren. Deze worden beheerd door de waarde op machineniveau. Als dit beleid is ingesteld op zowel apparaat- als gebruikersniveau, is de waarde op apparaatniveau van toepassing, tenzij de volgorde van beleidsvoorrang is gewijzigd door het beleid CloudUserPolicyOverridesCloudMachinePolicy.\n\nVoor versie 155 en lager geldt dit beleid alleen voor het hele apparaat.";
PrefetchWithServiceWorkerEnabled.pfm_title = "SpeculationRules-prefetch toestaan voor door ServiceWorker beheerde URL's";
PrefetchWithServiceWorkerEnabled.pfm_description = "SpeculationRules-prefetch kan worden uitgegeven voor URL's die door ServiceWorker worden beheerd. Oudere code stond dit echter niet toe en annuleerde de prefetch-verzoeken. Met dit beleid kun je het gedrag beheren.\n\nAls je dit beleid toepast of niet instelt, is SpeculationRules-prefetch mogelijk voor door ServiceWorker beheerde URL's (als de functievlag PrefetchServiceWorker aanstaat). Dit is het huidige standaardgedrag en is afgestemd op de specificaties.\n\nAls je dit beleid niet toepast, wordt SpeculationRules-prefetch niet toegestaan voor URL's die door ServiceWorker worden beheerd. Dit is het verouderde gedrag.\n\nDit beleid is tijdelijk en wordt in de toekomst verwijderd.";
PrintHeaderFooter.pfm_title = "Kop- en voetteksten afdrukken";
PrintHeaderFooter.pfm_description = "Als je dit beleid toepast, zijn kop- en voetteksten zichtbaar in het afdrukvoorbeeld. Als je het beleid niet toepast, zijn ze niet zichtbaar in het afdrukvoorbeeld.\n\nAls je het beleid instelt, kunnen gebruikers het niet wijzigen. Als je het beleid niet instelt, bepalen gebruikers of kop- en voetteksten zichtbaar zijn.";
PrintPdfAsImageAvailability.pfm_title = "'Pdf afdrukken als afbeelding' beschikbaar";
PrintPdfAsImageAvailability.pfm_description = "Dit beleid bepaalt hoe Brave de optie 'Afdrukken als afbeelding' beschikbaar maakt op Microsoft® Windows® en macOS bij het afdrukken van pdf's.\n\nBij het afdrukken van een pdf op Microsoft® Windows® of macOS moeten afdruktaken op sommige printers worden gerasterd als een afbeelding om uitvoer te krijgen die er goed uitziet.\n\nAls dit beleid op Aan staat, maakt Brave de optie 'Afdrukken als afbeelding' beschikbaar in het afdrukvoorbeeld als de gebruiker een pdf afdrukt.\n\nAls dit beleid op Uit staat of niet is ingesteld, laat Brave de optie 'Afdrukken als afbeelding' niet aan gebruikers zien in het afdrukvoorbeeld. Pdf's worden dan zoals gewoonlijk afgedrukt zonder te worden gerasterd als afbeelding voordat ze naar de afdrukbestemming worden gestuurd.";
PrintPdfAsImageDefault.pfm_title = "Pdf standaard afdrukken als afbeelding";
PrintPdfAsImageDefault.pfm_description = "Hiermee bepaal je of Brave de optie Afdrukken als afbeelding instelt als standaard bij het afdrukken van pdf-bestanden.\n\nAls je dit beleid toepast, stelt Brave de optie Afdrukken als afbeelding in als standaard in het afdrukvoorbeeld als er een pdf wordt afgedrukt.\n\nAls je dit beleid niet toepast of niet instelt, is de gebruikersselectie voor de optie Afdrukken als afbeelding in eerste instantie niet ingesteld voor Brave.  De gebruiker kan dit selecteren voor elke afzonderlijke afdruktaak voor pdf-bestanden als de optie beschikbaar is.\n\nVoor Microsoft® Windows® en macOS heeft dit beleid alleen invloed als PrintPdfAsImageAvailability ook aanstaat.";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "Standaardprinter van systeem gebruiken als standaard";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "Als je dit beleid toepast, gebruikt Brave de standaardprinter van het OS als standaardbestemming voor het afdrukvoorbeeld.\n\nAls je het beleid niet toepast of niet instelt, gebruikt Brave de laatst gebruikte printer als standaardbestemming voor het afdrukvoorbeeld.";
PrintRasterizePdfDpi.pfm_title = "DPI voor afdrukrastering van pdf's";
PrintRasterizePdfDpi.pfm_description = "Dit beleid beheert de afbeeldingsresolutie voor afdrukken als Brave gerasterde pdf's afdrukt.\n\nAls een pdf wordt afgedrukt met de optie 'Afdrukken als afbeelding', kan het soms beter zijn om een andere afdrukresolutie te selecteren dan de printerinstelling van het apparaat of de standaardoptie voor pdf's.  Met een hoge resolutie wordt de verwerkings- en afdruktijd een stuk langer, terwijl een lage resolutie tot een slechte afbeeldingskwaliteit kan leiden.\n\nMet dit beleid kan een bepaalde resolutie worden ingesteld voor gebruik bij rastering van pdf's voor afdrukken.\n\nAls het beleid op nul staat of helemaal niet is ingesteld, wordt de standaardresolutie van het systeem gebruikt bij het rasteren van pagina-afbeeldingen.";
PrinterTypeDenyList.pfm_title = "Printertypen op blokkeerlijst uitzetten";
PrinterTypeDenyList.pfm_description = "privet - Op zeroconf gebaseerde (mDNS + DNS-SD) protocolbestemmingen (beëindigd)\nextension - Op extensies gebaseerde bestemmingen\npdf - De bestemming Opslaan als pdf en de bestemming Opslaan in Google Drive op Google Chrome OS-apparaten\nlocal - Lokale printerbestemmingen\ncloud - Google Cloud Print (beëindigd)\nDe printertypen die op de weigeringslijst zijn gezet, kunnen niet worden gevonden en hun mogelijkheden kunnen niet worden opgehaald.\n\nAls je alle printertypen op de weigeringslijst plaatst, zet je in feite de afdrukfunctie uit. Er zijn dan geen bestemmingen beschikbaar waar een document naartoe kan worden gestuurd om af te drukken.\n\nAls je in versies lager dan 102 cloud op de weigeringslijst zet, heeft dit hetzelfde effect als het beleid CloudPrintSubmitEnabled instellen op False. Je kunt ervoor zorgen dat Google Cloud Print-bestemmingen vindbaar blijven door het beleid CloudPrintSubmitEnabled in te stellen op True en cloud niet op de weigeringslijst te zetten. Vanaf versie 102 worden Google Cloud Print-bestemmingen niet ondersteund en zijn ze niet zichtbaar, ongeacht de beleidswaarden.\n\nAls het beleid niet is ingesteld of is ingesteld op een lege lijst, kunnen alle printertypen worden gevonden.\n\nExtensieprinters staan ook bekend als afdrukproviderbestemmingen en omvatten elke bestemming die bij een Brave-extensie hoort.\n\nLokale printers staan ook bekend als systeemeigen afdrukbestemmingen en omvatten bestemmingen die beschikbaar zijn voor de lokale computer en gedeelde netwerkprinters.";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "De modus voor afdrukken met achtergrondbeelden beperken";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - Afdrukken zowel met als zonder achtergrondbeelden toestaan\nenabled - Alleen afdrukken met achtergrondbeelden toestaan\ndisabled - Alleen afdrukken zonder achtergrondbeelden toestaan\nBeperkt de modus voor afdrukken met achtergrondbeelden. Als er geen beleid is ingesteld, gelden er geen beperkingen.";
PrintingBackgroundGraphicsDefault.pfm_title = "Standaardmodus voor afdrukken met achtergrondbeelden";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - Modus voor afdrukken met achtergrondbeelden standaard aanzetten\ndisabled - Modus voor afdrukken met achtergrondbeelden standaard uitzetten\nHiermee wordt de standaardmodus voor afdrukken met achtergrondbeelden overschreven.";
PrintingEnabled.pfm_title = "Afdrukken aanzetten";
PrintingEnabled.pfm_description = "Als je dit beleid toepast of niet instelt, kunnen gebruikers afdrukken in Brave en kunnen ze deze instelling niet wijzigen.\n\nAls je het beleid niet hebt toegepast, kunnen gebruikers ook niet afdrukken vanaf Brave. Afdrukken is niet mogelijk vanuit het menu met 3 stippen, extensies en JavaScript-apps.";
PrintingPaperSizeDefault.pfm_title = "Standaard paginagrootte voor afdrukken";
PrintingPaperSizeDefault.pfm_description = "Hiermee overschrijf je het standaardformaat voor de afdrukpagina.\n\nname moet een van de vermelde indelingen bevatten of 'custom' als het vereiste papierformaat niet in de lijst staat. Als de waarde 'custom' is opgegeven, moet de eigenschap custom_size worden gespecificeerd. Dit beschrijft de gewenste hoogte en breedte in micrometers. Anders moet de eigenschap custom_size niet worden gespecificeerd. Beleid dat deze regels schendt, wordt genegeerd.\n\nAls het paginaformaat niet beschikbaar is op de printer die de gebruiker heeft gekozen, wordt dit beleid genegeerd.\nGa naar https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault voor meer informatie over schema en indeling.";
ProfilePickerOnStartupAvailability.pfm_title = "Beschikbaarheid van profielkiezer bij opstarten";
ProfilePickerOnStartupAvailability.pfm_description = "0 - Profielkiezer beschikbaar bij opstarten\n1 - Profielkiezer staat uit bij opstarten\n2 - Profielkiezer afgedwongen bij opstarten\nGeeft aan of de profielkiezer aanstaat, uitstaat of wordt verplicht bij het opstarten van de browser.\n\nStandaard zie je de profielkiezer niet als de browser in de gast- of incognitomodus start, er een profieldirectory en/of URL's zijn opgegeven via een opdrachtregel, het openen van een app expliciet is aangevraagd, de browser is gestart via een systeemeigen melding, er maar één profiel beschikbaar is of het beleid ForceBrowserSignin is ingesteld op True.\n\nAls Aangezet (0) is geselecteerd of het beleid niet is ingesteld, wordt de profielkiezer standaard getoond bij het opstarten, maar kunnen gebruikers deze aan- of uitzetten.\n\nAls Uitgezet (1) is geselecteerd, wordt de profielkiezer nooit getoond en kunnen gebruikers de instelling niet wijzigen.\n\nAls Verplicht (2) is geselecteerd, kunnen gebruikers de profielkiezer niet onderdrukken. De profielkiezer wordt ook getoond als er maar één profiel beschikbaar is.";
ProfileReauthPrompt.pfm_title = "Gebruikers vragen opnieuw te verifiëren voor het profiel";
ProfileReauthPrompt.pfm_description = "0 - Niet vragen om opnieuw te verifiëren\n1 - Vragen om opnieuw te verifiëren in een tabblad\nAls je dit beleid instelt op DoNotPrompt of niet instelt, vraagt Brave de gebruiker niet automatisch om opnieuw te verifiëren voor de browser.\n\nAls je dit beleid instelt op PromptInTab, wordt na het verlopen van de verificatie van de gebruiker meteen een nieuw tabblad met de inlogpagina van Google geopend. Dit gebeurt alleen als je Chrome Sync gebruikt.";
ProfileSeparationDomainExceptionList.pfm_title = "Toelatingslijst voor secundaire domeinen voor scheiding van zakelijke profielen";
ProfileSeparationDomainExceptionList.pfm_description = "Als je dit beleid niet instelt, hoeven gebruikers niet in te loggen op het account om een nieuw afzonderlijk profiel te maken.\n\nAls je dit beleid instelt, hoeven gebruikers in de vermelde domeinen geen nieuw afzonderlijk profiel te maken.\n\nDit beleid kan worden ingesteld op een lege tekenreeks, zodat alle gebruikers die inloggen bij hun account een nieuw afzonderlijk profiel moeten maken.";
PromotionsEnabled.pfm_title = "Weergave van promotiecontent aanzetten";
PromotionsEnabled.pfm_description = "Als je het beleid instelt op True of niet instelt, toont Brave gebruikers promotiecontent voor producten.\n\nAls je het beleid instelt op False, kan Brave geen promotiecontent voor producten tonen.\n\nDeze instelling bepaalt de presentatie van promotiecontent, waaronder de welkomstpagina's waar gebruikers kunnen inloggen bij Brave, Brave kunnen instellen als standaardbrowser van de gebruiker of op een andere manier kunnen worden geïnformeerd over productfuncties.";
PromptForDownloadLocation.pfm_title = "Altijd vragen waar een bestand moet worden opgeslagen";
PromptForDownloadLocation.pfm_description = "Als je het beleid toepast, wordt gebruikers gevraagd waar ze elk bestand willen opslaan voordat het bestand wordt gedownload. Als je het beleid niet toepast, worden downloads onmiddellijk gestart en wordt gebruikers niet gevraagd waar ze het bestand willen opslaan.\n\nAls je het beleid niet instelt, kunnen gebruikers deze instelling zelf wijzigen.";
PromptOnMultipleMatchingCertificates.pfm_title = "Prompt als meerdere certificaten overeenkomen";
PromptOnMultipleMatchingCertificates.pfm_description = "Met dit beleid bepaal je of de gebruiker wordt gevraagd een clientcertificaat te selecteren als meerdere certificaten overeenkomen met AutoSelectCertificateForUrls.\nAls je dit beleid toepast, wordt de gebruiker gevraagd een clientcertificaat te selecteren als het beleid voor automatisch selecteren overeenkomt met meerdere certificaten.\nAls je dit beleid niet toepast of niet instelt, wordt de gebruiker misschien alleen gevraagd een clientcertificaat te selecteren als geen enkel certificaat overeenkomt met de automatische selectie.";
ProxySettings.pfm_title = "Proxyinstellingen";
ProxySettings.pfm_description = "Als je het beleid instelt, bepaal je de proxyinstellingen voor Chrome en ARC-apps, die alle proxygerelateerde opties negeren die via de opdrachtregel worden gespecificeerd.\n\nAls je het beleid niet instelt, kunnen gebruikers hun proxyinstellingen kiezen.\n\nAls je het beleid ProxySettings instelt, worden de volgende velden geaccepteerd:\n\n* ProxyMode: Hiermee verstrek je de proxyserver die Chrome gebruikt en voorkom je dat gebruikers de proxy-instellingen kunnen wijzigen.\n\n* ProxyPacUrl: Een URL naar een proxy-pac-bestand of een PAC-script dat is gecodeerd als een gegevens-URL met het MIME-type application/x-ns-proxy-autoconfig.\n\n* ProxyPacMandatory: Hiermee wordt voorkomen dat de netwerkstack terugvalt op directe verbindingen met een ongeldig of niet-beschikbaar PAC-script.\n\n* ProxyServer: Een URL van de proxyserver.\n\n* ProxyBypassList: Een lijst met proxyhosts die de proxy omzeilen.\n\nHet veld ProxyServerMode is beëindigd en vervangen door het veld ProxyMode. Als je voor ProxyMode de volgende waarde kiest:\n* direct: Er wordt nooit een proxy gebruikt en alle andere velden worden genegeerd.\n\n* system: De proxy van het systeem wordt gebruikt en alle andere velden worden genegeerd.\n\n* auto_detect: Alle andere velden worden genegeerd.\n\n* fixed_servers: De velden ProxyServer en ProxyBypassList worden gebruikt.\n\n* pac_script: De velden ProxyPacUrl, ProxyPacMandatory en ProxyBypassList worden gebruikt.\n\nOpmerking: Voor gedetailleerdere voorbeelden ga je naar The Chromium Projects ( https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings ).\nGa naar https://chromeenterprise.google/policies/?policy=ProxySettings voor meer informatie over schema en indeling.";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "Generator voor QR-codes aanzetten";
QRCodeGeneratorEnabled.pfm_description = "Met dit beleid wordt de functie voor de generator voor QR-codes aangezet in Brave.\n\nAls je dit beleid aanzet of niet instelt, wordt de functie voor de generator van QR-codes aangezet.\n\nAls je dit beleid uitzet, wordt de functie voor de generator van QR-codes uitgezet.";
QuicAllowed.pfm_title = "QUIC-protocol toestaan";
QuicAllowed.pfm_description = "Als je het beleid toepast of niet instelt, mag het QUIC-protocol worden gebruikt in Brave.\n\nAls je het beleid niet toepast, mag het QUIC-protocol niet worden gebruikt.";
RegisteredProtocolHandlers.pfm_title = "Protocolhandlers registreren";
RegisteredProtocolHandlers.pfm_description = "Als je het beleid instelt (alleen zoals aanbevolen), kun je een lijst met protocolhandlers registreren. Deze worden samengevoegd met de protocolhandlers die de gebruiker registreert, waarna beide sets gebruikt worden. Stel de eigenschap 'protocol' in op het schema, zoals 'mailto', en stel de eigenschap 'URL' in op het URL-patroon van de app die het schema verwerkt dat in het veld 'protocol' wordt gespecificeerd. Het patroon mag de tijdelijke aanduiding '%s' bevatten die wordt vervangen door de verwerkte URL.\n\nGebruikers kunnen een protocolhandler niet verwijderen als deze is geregistreerd door een beleid. Als ze een nieuwe standaard handler installeren, kunnen ze de protocolhandlers wijzigen die door het beleid zijn geïnstalleerd.\nGa naar https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers voor meer informatie over schema en indeling.";
RelaunchFastIfOutdated.pfm_title = "Periode (dagen)";
RelaunchFastIfOutdated.pfm_description = "Geeft de minimale releaseleeftijd aan waarna meldingen voor herstarten dwingender worden. De leeftijd wordt berekend vanaf het moment dat de huidige versie voor het laatst aan clients werd geleverd.\n\nAls een browser of apparaat opnieuw moet worden opgestart om een update in behandeling af te ronden en de huidige versie al langer verouderd is dan het aantal dagen dat is aangegeven in deze instelling, wordt het beleid RelaunchNotificationPeriod overschreven naar 2 uur. Als het beleid RelaunchNotification is ingesteld op 1 (Vereist), worden gebruikers gedwongen om aan het einde van de periode te herstarten of opnieuw op te starten.\n\nAls je dit beleid niet instelt of als de releaseleeftijd niet kan worden bepaald, wordt het beleid RelaunchNotificationPeriod gebruikt voor alle updates.";
RelaunchNotification.pfm_title = "Een gebruiker laten weten dat het aanbevolen of vereist is om de browser of het apparaat opnieuw op te starten";
RelaunchNotification.pfm_description = "1 - Toon de gebruiker een terugkerende prompt om aan te geven dat opnieuw opstarten wordt aanbevolen\n2 - Toon de gebruiker een terugkerende prompt om aan te geven dat opnieuw opstarten vereist is\nHiermee laat je gebruikers weten dat Brave of Google Chrome OS opnieuw moet worden opgestart om een beschikbare update uit te voeren.\n\nMet deze beleidsinstelling worden meldingen getoond waarin de gebruiker wordt gevraagd of aangeraden om de browser of het apparaat opnieuw op te starten. Als dit beleid niet is ingesteld, laat Brave de gebruiker via kleine wijzigingen in het menu weten dat de browser opnieuw moet worden opgestart. Voor Google Chrome OS wordt deze melding in het systeemvak getoond. Als dit beleid is ingesteld op Aanbevolen, wordt er een herhaalde waarschuwing getoond om de gebruiker te laten weten dat opnieuw opstarten wordt aanbevolen. De gebruiker kan deze waarschuwing negeren om de actie uit te stellen. Als dit is ingesteld op Vereist, wordt er een herhaalde waarschuwing getoond om de gebruiker te laten weten dat de browser automatisch opnieuw wordt opgestart zodra de meldingsperiode is verstreken. De standaardperiode is zeven dagen voor Brave en vier dagen voor Google Chrome OS en kan worden aangepast via de beleidsinstelling RelaunchNotificationPeriod.\n\nDe sessie van de gebruiker wordt hersteld zodra opnieuw is opgestart.";
RelaunchNotificationPeriod.pfm_title = "Periode (milliseconden)";
RelaunchNotificationPeriod.pfm_description = "Hiermee kun je de periode in milliseconden instellen waarin gebruikers een melding ontvangen dat Brave opnieuw moet worden gestart of dat een Google Chrome OS-apparaat opnieuw moet worden opgestart om een update in behandeling uit te voeren.\n\nGedurende deze periode krijgt de gebruiker regelmatig de melding dat er een update moet worden uitgevoerd. Voor Google Chrome OS-apparaten wordt een melding over opnieuw opstarten weergegeven in het systeemvak, in overeenstemming met het RelaunchHeadsUpPeriod-beleid. Voor Brave-browsers wordt het app-menu gewijzigd om aan te geven dat er opnieuw moet worden opgestart zodra een derde van de meldingsperiode is verstreken. Deze melding krijgt een andere kleur zodra twee derde van de meldingsperiode is verstreken en dit gebeurt nogmaals als de volledige periode is verstreken. Hetzelfde schema wordt gehanteerd voor aanvullende meldingen die door het RelaunchNotification-beleid zijn aangezet.\n\nAls dit beleid niet is ingesteld, wordt de standaardperiode van 604.800.000 milliseconden (één week) gebruikt.";
RelaunchWindow.pfm_title = "Tijdvenster voor herstarten";
RelaunchWindow.pfm_description = "Geef een beoogd tijdvenster op voor het einde van de meldingsperiode voor herstarten.\n\nOp basis van de instellingen voor het beleid RelaunchNotification en RelaunchNotificationPeriod krijgen gebruikers een melding als de browser moet worden herstart of het apparaat opnieuw moet worden opgestart. Browsers en apparaten worden gedwongen opnieuw opgestart aan het einde van de meldingsperiode als het beleid RelaunchNotification is ingesteld op Vereist. Dit beleid RelaunchWindow kan worden gebruikt om het einde van de meldingsperiode uit te stellen zodat dit binnen een specifiek tijdvenster valt.\n\nAls je dit beleid niet instelt, is het standaard beoogde tijdvenster voor Google Chrome OS tussen 02:00 en 04:00 uur. Het standaard beoogde tijdvenster voor Brave is de hele dag (dat wil zeggen, het einde van de meldingsperiode wordt nooit uitgesteld).\n\nOpmerking: Hoewel er met het beleid meerdere items kunnen worden geaccepteerd in entries, wordt alleen het eerste item gebruikt. De andere items worden genegeerd.\nWaarschuwing: Als je dit beleid instelt, kan de toepassing van software-updates worden vertraagd.\nGa naar https://chromeenterprise.google/policies/?policy=RelaunchWindow voor meer informatie over schema en indeling.";
RemoteAccessHostAllowClientPairing.pfm_title = "Verificatie zonder pincode aan- of uitzetten voor hosts voor externe toegang";
RemoteAccessHostAllowClientPairing.pfm_description = "Als je dit beleid toepast of niet instelt, kunnen gebruikers clients en hosts koppelen op het moment dat verbinding wordt gemaakt, zodat er niet elke keer een pincode hoeft te worden opgegeven.\n\nAls je het beleid niet toepast, is deze functie niet beschikbaar.";
RemoteAccessHostAllowFileTransfer.pfm_title = "Toestaan dat gebruikers met externe toegang bestanden overzetten van/naar de host";
RemoteAccessHostAllowFileTransfer.pfm_description = "Als je dit beleid toepast of niet instelt, kunnen gebruikers die met een host voor externe toegang zijn verbonden, bestanden overzetten tussen de client en de host. Dit is niet van toepassing op verbindingen voor hulp op afstand, die geen bestandsoverdracht ondersteunen.\n\nAls je het beleid niet toepast, is er geen bestandsoverdracht toegestaan.";
RemoteAccessHostAllowPinAuthentication.pfm_title = "Methoden voor pincode- en koppelingsverificatie toestaan voor hosts voor externe toegang";
RemoteAccessHostAllowPinAuthentication.pfm_description = "Als je het beleid toepast, kan de host voor externe toegang pincode- en koppelingsverificaties gebruiken bij de acceptatie van clientverbindingen.\n\nAls je het beleid niet toepast, zijn pincode- of koppelingsverificaties niet toegestaan.\n\nAls je het beleid niet instelt, kan de host bepalen of pincode- en/of koppelingsverificaties kunnen worden gebruikt.\n\nOpmerking: Als de instelling resulteert in geen verificatiemethoden die wederzijds worden ondersteund door zowel de host als de client, wordt de verbinding geweigerd.";
RemoteAccessHostAllowRelayedConnection.pfm_title = "Relayservers laten gebruiken door de host voor externe toegang";
RemoteAccessHostAllowRelayedConnection.pfm_description = "Als je RemoteAccessHostFirewallTraversal hebt toegepast en RemoteAccessHostAllowRelayedConnection toepast of niet instelt, kunnen externe clients relayservers gebruiken om verbinding met dit apparaat te maken als er geen rechtstreekse verbinding beschikbaar is (bijvoorbeeld vanwege firewallbeperkingen).\n\nAls je het beleid niet toepast, wordt externe toegang niet uitgezet, maar zijn alleen verbindingen vanuit hetzelfde netwerk toegestaan (geen NAT-traversal of -relay).";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "Verbindingen voor externe toegang tot deze machine toestaan";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "Als dit beleid niet is toegepast, kan de hostservice voor externe toegang niet worden gestart of ingesteld om inkomende verbindingen te accepteren.  Dit beleid heeft geen effect op scenario's voor support op afstand.\n\nDit beleid is niet geldig als het is ingesteld op Enabled (Aangezet), leeg wordt gelaten of niet wordt ingesteld.";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "Verbindingen voor externe support met deze machine toestaan";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "Als je dit beleid niet toepast, kan de host voor externe support niet worden gestart of ingesteld om inkomende verbindingen te accepteren.\n\nDit beleid heeft geen effect op scenario's voor externe toegang.\n\nDit beleid voorkomt niet dat bedrijfsbeheerders verbinding maken met beheerde Google Chrome OS-apparaten.\n\nDit beleid heeft geen effect als je het toepast, leeg laat of niet instelt.";
RemoteAccessHostAllowUrlForwarding.pfm_title = "Toestaan dat gebruikers met externe toegang URL's aan de hostzijde openen in hun lokale clientbrowser";
RemoteAccessHostAllowUrlForwarding.pfm_description = "Als je het beleid aanzet of niet instelt, kunnen gebruikers die verbinding hebben met een host voor externe toegang, URL's aan de hostzijde openen in hun lokale clientbrowser.\n\nAls je het beleid uitzet, kan de host voor externe toegang geen URL's naar de client sturen.\n\nDeze instelling is niet van toepassing op verbindingen voor externe support, omdat de functie niet wordt ondersteund voor die verbindingsmodus.\n\nOpmerking: Deze functie is nog niet algemeen beschikbaar, dus als je deze aanzet, betekent dit niet dat de functie zichtbaar is in de client-UI.";
RemoteAccessHostClientDomainList.pfm_title = "De vereiste domeinnamen configureren voor clients voor externe toegang";
RemoteAccessHostClientDomainList.pfm_description = "Als je dit beleid instelt, geef je de client-domeinnamen op die worden opgelegd aan clients voor externe toegang en voorkom je dat gebruikers deze wijzigen. Alleen clients van een van de opgegeven domeinen kunnen verbinding maken met de host.\n\nAls je dit beleid instelt op een lege lijst of niet instelt, wordt het standaardbeleid voor het verbindingstype toegepast. In het geval van hulp op afstand kunnen clients van elk domein verbinding maken met de host. In het geval van externe toegang op elk gewenst moment kan alleen de eigenaar van de host verbinding maken.\n\nZie ook RemoteAccessHostDomainList.\n\nOpmerking: Deze instelling overschrijft RemoteAccessHostClientDomain (indien aanwezig).";
RemoteAccessHostClipboardSizeBytes.pfm_title = "De maximumgrootte, in bytes, die kan worden overgezet tussen de client en host via klembordsynchronisatie";
RemoteAccessHostClipboardSizeBytes.pfm_description = "Als je dit beleid instelt, worden klembordgegevens die naar en vanaf de host worden gestuurd, ingekort tot de limiet die wordt ingesteld door dit beleid.\n\nAls je de waarde 0 instelt, wordt klembordsynchronisatie uitgezet.\n\nDit beleid is van invloed op scenario's voor zowel externe toegang als externe support.\n\nDit beleid heeft geen effect als het niet is ingesteld.\n\nAls je het beleid instelt op een waarde die niet binnen het minimale/maximale bereik ligt, kan de host misschien niet worden gestart.\n\nHoud er rekening mee dat de werkelijke bovengrens voor de klembordgrootte is gebaseerd op de maximale berichtgrootte van het WebRTC-gegevenskanaal, waarop dit beleid geen invloed heeft.";
RemoteAccessHostDomainList.pfm_title = "De vereiste domeinnamen configureren voor hosts voor externe toegang";
RemoteAccessHostDomainList.pfm_description = "Als je dit beleid instelt, geeft je de domeinnamen op die worden opgelegd aan hosts voor externe toegang en voorkom je dat gebruikers deze wijzigen. Hosts kunnen alleen worden gedeeld met accounts die zijn geregistreerd op een van de opgegeven domeinnamen.\n\nAls je het beleid instelt op een lege lijst of niet instelt, kunnen hosts worden gedeeld met elk account.\n\nZie ook RemoteAccessHostClientDomainList.\n\nOpmerking: Deze instelling overschrijft RemoteAccessHostDomain (indien aanwezig).";
RemoteAccessHostFirewallTraversal.pfm_title = "Firewallpassage vanaf host voor externe toegang aanzetten";
RemoteAccessHostFirewallTraversal.pfm_description = "Als je dit beleid toepast of niet instelt, kun je STUN-servers gebruiken, zodat externe clients dit apparaat kunnen zien en er verbinding mee kunnen maken, zelfs door een firewall.\n\nAls je het beleid niet toepast terwijl uitgaande UDP-verbindingen worden gefilterd door de firewall, staat dit apparaat alleen verbindingen toe met clientapparaten binnen het lokale netwerk.";
RemoteAccessHostMatchUsername.pfm_title = "Vereisen dat de naam van de lokale gebruiker en de eigenaar van de host voor externe toegang met elkaar overeenkomen";
RemoteAccessHostMatchUsername.pfm_description = "Als je dit beleid toepast, vergelijkt de host voor externe toegang de naam van de lokale gebruiker waaraan de host is gekoppeld, met de naam van het Google-account dat is geregistreerd als eigenaar van de host (bijvoorbeeld 'jansmits' als de host eigendom is van het Google-account jansmits@example.com). Deze host wordt niet gestart als de naam van de hosteigenaar anders is dan de naam van de lokale gebruiker waaraan de host is gekoppeld. Als je wilt afdwingen dat het Google-account van de eigenaar wordt gekoppeld aan een specifiek domein, gebruik je het beleid met RemoteAccessHostDomain.\n\nAls je het beleid niet toepast of niet instelt, kan de host voor externe toegang aan elke lokale gebruiker worden gekoppeld.";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "Maximale toegestane sessieduur voor verbindingen voor externe toegang";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "Als je dit beleid aanzet, worden verbindingen voor externe toegang automatisch verbroken nadat het aantal minuten dat in het beleid wordt gedefinieerd, is verstreken. Hierdoor wordt niet voorkomen dat de client opnieuw verbinding maakt nadat de maximale sessieduur is bereikt. Als je het beleid instelt op een waarde die niet binnen het minimale/maximale bereik ligt, kan de host misschien niet worden gestart. Dit beleid heeft geen effect op scenario's voor support op afstand.\n\nDit beleid heeft geen effect als het niet is ingesteld. In dat geval is er geen maximale duur voor verbindingen voor externe toegang op deze machine.";
RemoteAccessHostRequireCurtain.pfm_title = "Afscherming van hosts voor externe toegang aanzetten";
RemoteAccessHostRequireCurtain.pfm_description = "Als je dit beleid toepast, worden de fysieke invoer- en uitvoerapparaten van hosts voor externe toegang uitgezet tijdens een externe verbinding.\n\nAls je het beleid niet toepast of niet instelt, kunnen zowel lokale als externe gebruikers met de host communiceren terwijl deze wordt gedeeld.";
RemoteAccessHostUdpPortRange.pfm_title = "Het UDP-poortbereik beperken dat voor de host voor externe toegang wordt gebruikt";
RemoteAccessHostUdpPortRange.pfm_description = "Als je dit beleid instelt, beperk je het UDP-poortbereik dat wordt gebruikt door de host voor externe toegang op dit apparaat.\n\nAls je het beleid niet instelt of instelt op een lege tekenreeks, kan de host voor externe toegang elke beschikbare poort gebruiken.\n\nOpmerking: Als RemoteAccessHostFirewallTraversal is uitgezet, gebruikt de host voor externe toegang UDP-poorten in het bereik 12400-12409.";
RemoteDebuggingAllowed.pfm_title = "Foutopsporing op afstand toestaan";
RemoteDebuggingAllowed.pfm_description = "Bepaalt of gebruikers foutopsporing op afstand mogen toevoegen.\n\nAls dit beleid aanstaat of niet is ingesteld, kunnen gebruikers foutopsporing op afstand gebruiken door de opdrachtregelschakelaars --remote-debugging-port en --remote-debugging-pipe te verstrekken op desktopplatforms of door de systeeminstelling voor USB-foutopsporing aan te zetten op Android.\n\nAls dit beleid uitstaat, mogen gebruikers geen foutopsporing op afstand gebruiken.";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "Online OCSP/CRL-controles voor lokale vertrouwensinstanties vereisen";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "Als je het beleid instelt op True, voert Brave altijd een intrekkingscontrole uit voor gevalideerde servercertificaten die zijn ondertekend door lokaal geïnstalleerde CA-certificaten. Als Brave geen informatie over de intrekkingsstatus kan verkrijgen, beschouwt Brave deze certificaten als ingetrokken ('hard-fail').\n\nAls je het beleid instelt op False of niet instelt, gebruikt Brave de bestaande instellingen voor online intrekkingscontrole.\n\nVoor macOS heeft dit beleid geen effect als het beleid ChromeRootStoreEnabled is ingesteld op False.";
RestoreOnStartup.pfm_title = "Actie bij starten";
RestoreOnStartup.pfm_description = "5 - Pagina 'Nieuw tabblad' openen\n1 - De laatste sessie herstellen\n4 - Een lijst met URL's openen\n6 - Een lijst met URL's openen en de laatste sessie herstellen\nAls je dit beleid instelt, kun je aangeven hoe het systeem moet reageren als de browser wordt opgestart. Als je deze instelling uitzet, heeft dit hetzelfde effect als wanneer je het beleid niet instelt, omdat het opstartgedrag van Brave moet zijn aangegeven.\n\nAls je het beleid instelt, kunnen gebruikers dit niet wijzigen in Brave. Als je het beleid niet instelt, kunnen gebruikers dit wijzigen.\n\nAls je dit beleid instelt op RestoreOnStartupIsLastSession of RestoreOnStartupIsLastSessionAndURLs, worden sommige instellingen uitgezet die afhankelijk zijn van sessies of waarmee bij het afsluiten bepaalde acties worden uitgevoerd (zoals browsegegevens wissen bij afsluiten of sessiespecifieke cookies).\n\nAls je dit beleid instelt op RestoreOnStartupIsLastSessionAndURLs, herstelt de browser de vorige sessie en wordt een afzonderlijk venster geopend om URL's te tonen die zijn ingesteld via RestoreOnStartupURLs. Gebruikers kunnen ervoor kiezen om deze URL's geopend te laten. Dan worden ze ook hersteld in de toekomstige sessie.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
RestoreOnStartupURLs.pfm_title = "URL's die worden geopend bij starten";
RestoreOnStartupURLs.pfm_description = "Als je RestoreOnStartup instelt op RestoreOnStartupIsURLs, geef je aan welke URL's moeten worden geopend door RestoreOnStartupURLs in te stellen op een lijst met URL's.\n\nAls je het beleid niet instelt, wordt de pagina 'Nieuw tabblad' geopend als de browser wordt opgestart.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "De Background Fetch API beperken als deze wordt aangeroepen vanuit een service worker";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "Met dit beleid wordt bepaald of achtergrondverzoeken van service workers worden beperkt. Dit beleid kan relevant zijn als een functie die bestanden op de achtergrond downloadt, wordt beïnvloed.\n\nAls je dit beleid toepast of niet instelt, is de beperking actief en kunnen verzoeken voor ophalen op de achtergrond vanuit service worker-contexten worden geblokkeerd.\n\nAls je dit beleid niet toepast, wordt de beperking omzeild en kunnen alle service workers verzoeken voor ophalen op de achtergrond doen.\n\nDit bedrijfsbeleid is tijdelijk en wordt verwijderd na M152.";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "Beperk in aanmerking komende Google-accounts voor het opslaan van pdf-bestanden in Google Drive vanuit Brave PDF Viewer";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "Bevat een reguliere expressie om te bepalen welke Google-accounts in aanmerking komen om pdf-bestanden op te slaan in Google Drive vanuit Brave PDF Viewer.\n\nEr wordt een foutmelding getoond als een gebruiker een pdf-bestand probeert te uploaden naar Google Drive met een account dat niet overeenkomt met dit patroon.\n\nAls je dit beleid niet instelt of leeg laat, kan de gebruiker elk Google-account gebruiken om pdf-bestanden op te slaan in Google Drive.";
RestrictSigninToPattern.pfm_title = "Beperken welke Google-accounts mogen worden ingesteld als primaire browseraccounts in Brave";
RestrictSigninToPattern.pfm_description = "Bevat een reguliere expressie die wordt gebruikt om te bepalen welke Google-accounts kunnen worden ingesteld als primair browseraccount in Brave (oftewel het account dat wordt gekozen als de gebruiker synchronisatie toestaat).\n\nEr wordt een fout weergegeven als een gebruiker probeert een primair browseraccount in te stellen met een gebruikersnaam die niet met dit patroon overeenkomt.\n\nAls dit beleid niet wordt ingesteld of leeg is, kan de gebruiker elk willekeurig Google-account instellen als primair browseraccount in Brave.";
RestrictYouTubeCookiesDeletion.pfm_title = "Verwijdering van cookies van YouTube beperken";
RestrictYouTubeCookiesDeletion.pfm_description = "Voorkomt dat YouTube-cookies handmatig worden verwijderd.\n\nDit beleid is bedoeld om te voorkomen dat gebruikers niet-geautoriseerde toegang krijgen tot YouTube nadat ze hun YouTube-cookies handmatig hebben gewist via de pagina met site-instellingen.\n\nAls je het beleid toepast, kunnen YouTube-cookies niet handmatig worden verwijderd.\n\nAls je het beleid niet toepast of niet instelt, kunnen YouTube-cookies normaal worden verwijderd.\n\nOpmerking: Dit beleid voorkomt alleen handmatige verwijdering via de UI van de site-instellingen. Het voorkomt niet dat items automatisch worden verwijderd op basis van het beleid van ClearBrowsingDataOnExitList of BrowsingDataLifetime. Als het beleid AllowDeletingBrowserHistory aanstaat, kunnen gebruikers bovendien nog steeds al hun cookies wissen via het dialoogvenster Browsegegevens wissen.";
SSLErrorOverrideAllowed.pfm_title = "Doorgaan vanaf de SSL-waarschuwingspagina toestaan";
SSLErrorOverrideAllowed.pfm_description = "Als je dit beleid toepast of niet instelt, kunnen gebruikers klikken door waarschuwingspagina's die door Brave worden getoond als gebruikers naar sites gaan die SSL-fouten bevatten.\n\nAls je het beleid niet toepast, kunnen gebruikers niet door waarschuwingspagina's klikken.";
SSLErrorOverrideAllowedForOrigins.pfm_title = "Doorgaan vanaf de SSL-waarschuwingspagina toestaan voor specifieke herkomsten";
SSLErrorOverrideAllowedForOrigins.pfm_description = "Als SSLErrorOverrideAllowed niet wordt toegepast, kun je met dit beleid een lijst met herkomstpatronen instellen voor sites waar gebruikers door de waarschuwingspagina's van Brave kunnen klikken als ze naar sites met SSL-fouten navigeren. Gebruikers kunnen niet doorklikken op SSL-waarschuwingspagina's voor herkomsten die niet op deze lijst staan.\n\nAls SSLErrorOverrideAllowed wordt toegepast of niet wordt ingesteld, doet dit beleid niets.\n\nAls je het beleid niet instelt, wordt SSLErrorOverrideAllowed toegepast op alle sites.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige invoerpatronen. * is geen geaccepteerde waarde voor dit beleid. Dit beleid zoekt alleen overeenkomsten op basis van de herkomst, dus elk pad in het URL-patroon wordt genegeerd.";
SafeBrowsingAllowlistDomains.pfm_title = "Configureer de lijst met domeinen waar Safe Browsing geen waarschuwingen activeert.";
SafeBrowsingAllowlistDomains.pfm_description = "Als je dit beleid toepast, vertrouwt Safe Browsing de domeinen die je aangeeft. De functie checkt deze niet op gevaarlijke bronnen zoals phishing, malware of ongewenste software. De service voor downloadbeveiliging van Safe Browsing checkt downloads die worden gehost op deze domeinen niet. De service voor wachtwoordbeveiliging checkt niet of wachtwoorden opnieuw worden gebruikt.\n\nAls je het beleid niet instelt, wordt de standaardbescherming van Safe Browsing toegepast op alle bronnen.\n\nDit beleid ondersteunt geen reguliere expressies. Subdomeinen van een bepaald domein worden wel op de toelatingslijst gezet. Volledig gekwalificeerde domeinnamen (FQDN's) zijn niet vereist.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.";
SafeBrowsingDeepScanningEnabled.pfm_title = "Uitgebreide scans van downloads toestaan voor gebruikers waarvoor Safe Browsing aanstaat";
SafeBrowsingDeepScanningEnabled.pfm_description = "Als je dit beleid toepast of niet instelt, kan Brave verdachte downloads van gebruikers waarvoor Safe Browsing aanstaat, naar Google sturen om te scannen op malware of gebruikers vragen om een wachtwoord voor versleutelde archieven.\nAls je dit beleid niet toepast, worden deze scans niet uitgevoerd.\nDit beleid heeft geen invloed op de analyse van gedownloade content die is ingesteld door Chrome Enterprise Connectors.";
SafeBrowsingProtectionLevel.pfm_title = "Safe Browsing-beveiligingsniveau";
SafeBrowsingProtectionLevel.pfm_description = "0 - Safe Browsing is nooit actief.\n1 - Safe Browsing is actief in de standaardmodus.\n2 - Safe Browsing is actief in de uitgebreide modus. Deze modus biedt betere beveiliging, maar vereist dat er meer browsegegevens worden gedeeld met Google.\nHiermee kun je bepalen of de Safe Browsing-functie van Brave moet aanstaan en in welke modus de functie actief moet zijn.\n\nAls je dit beleid instelt op NoProtection (waarde 0), is Safe Browsing nooit actief.\n\nAls je dit beleid instelt op StandardProtection (waarde 1, de standaardinstelling), is Safe Browsing altijd actief in de standaardmodus.\n\nAls je dit beleid instelt op EnhancedProtection (waarde 2), is Safe Browsing altijd actief in de uitgebreide modus. Deze modus biedt betere beveiliging, maar vereist dat er meer browsegegevens worden gedeeld met Google.\n\nAls je dit beleid instelt als verplicht, kunnen gebruikers de instelling voor Safe Browsing in Brave niet wijzigen of overschrijven.\n\nAls je dit beleid niet instelt, staat Safe Browsing aan voor de standaard beveiligingsmodus, maar kunnen gebruikers deze instelling wijzigen.\n\nZie https://support.google.com/chrome?p=safe_browsing_preferences voor meer informatie over Safe Browsing.";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "Realtime checks via proxy voor Safe Browsing toestaan";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "Hiermee bepaal je of de standaard beveiligingsmodus van Safe Browsing toestemming heeft om gedeeltelijke hashes van URL's via een proxy naar Google te sturen via Oblivious HTTP om te bepalen of ze veilig kunnen worden bezocht.\n\nMet de proxy kunnen browsers gedeeltelijke hashes van URL's uploaden naar Google zonder dat ze worden gekoppeld aan het IP-adres van de gebruiker. Met dit beleid kunnen browsers de gedeeltelijke hashes van URL's ook met een hogere frequentie uploaden voor betere Safe Browsing-bescherming.\n\nDit beleid wordt genegeerd als Safe Browsing uitstaat of is ingesteld op de modus voor geoptimaliseerde beveiliging.\n\nAls je het beleid toepast of niet instelt, zijn de lookups via proxy met een betere beveiliging mogelijk.\n\nAls je het beleid niet toepast, zijn lookups via proxy met een betere beveiliging niet toegestaan. Gedeeltelijke hashes van URL's worden rechtstreeks naar Google geüpload met een veel lagere frequentie, waardoor de bescherming afneemt.";
SafeBrowsingSurveysEnabled.pfm_title = "Safe Browsing-enquêtes toestaan";
SafeBrowsingSurveysEnabled.pfm_description = "Als je dit beleid toepast of niet instelt, kan de gebruiker enquêtes over Safe Browsing krijgen.\nAls je dit beleid niet toepast, krijgt de gebruiker geen enquêtes over Safe Browsing.";
SafeSitesFilterBehavior.pfm_title = "SafeSites-filters voor content voor volwassenen beheren.";
SafeSitesFilterBehavior.pfm_description = "0 - Sites niet filteren op content voor volwassenen\n1 - Sites filteren op content voor volwassenen\nAls je dit beleid instelt, wordt de toepassing van het SafeSites URL-filter beheerd. Dit filter gebruikt de Google Safe Search API om URL's al dan niet te classificeren als pornografisch.\n\nAls dit beleid is ingesteld op:\n\n* Sites niet filteren op content voor volwassenen (of als het niet is ingesteld), worden de sites niet gefilterd\n\n* Sites filteren op content voor volwassenen, worden de sites gefilterd die zijn geclassificeerd als pornografisch\n\nHet beleid is van toepassing op zowel de URL waar de gebruiker naartoe navigeert als op iframes. Het beleid URLAllowlist heeft voorrang op dit beleid en kan worden gebruikt om beoordelingen van de Google Safe Search API te overschrijven.";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "Toestaan dat deze oorsprongen tabbladen met dezelfde oorsprong opnemen";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van de sites die tabbladen met dezelfde oorsprong mogen opnemen.\n\nAls je dit beleid niet instelt, komen sites niet in aanmerking voor een overschrijving op dit opnameniveau.\n\nChrome-apps in vensters met dezelfde oorsprong als deze site mogen nog steeds worden opgenomen.\n\nAls een site overeenkomt met een URL-patroon in dit beleid, wordt er geen rekening gehouden met de volgende beleidsregels: TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige url-patronen.  Dit beleid zoekt alleen overeenkomsten op basis van de herkomst, dus elk pad in het URL-patroon wordt genegeerd.";
SandboxExternalProtocolBlocked.pfm_title = "Toestaan dat Chrome navigatie naar externe protocollen in iframes in sandboxes blokkeert";
SandboxExternalProtocolBlocked.pfm_description = "Chrome blokkeert navigatie naar externe protocollen in iframes in sandboxes. Zie https://chromestatus.com/features/5680742077038592.\n\nAls dit is ingesteld op True, kan Chrome die navigatie blokkeren.\n\nAls dit is ingesteld op False, wordt voorkomen dat Chrome die navigatie blokkeert.\n\nDit is standaard ingesteld op True: beveiligingsfunctie aan.\n\nDit kan worden gebruikt door beheerders die meer tijd nodig hebben om hun interne website te updaten waarop deze nieuwe beperking van invloed is. Dit zakelijke beleid is tijdelijk. Het is de bedoeling het te verwijderen na Brave versie 117.\n";
SavingBrowserHistoryDisabled.pfm_title = "Opslag van browsegeschiedenis aanzetten";
SavingBrowserHistoryDisabled.pfm_description = "Als je het beleid toepast, wordt browsegeschiedenis niet opgeslagen en tabbladsynchronisatie uitgezet. Gebruikers kunnen deze instelling niet wijzigen.\n\nAls je het beleid niet toepast of niet instelt, wordt browsegeschiedenis opgeslagen.";
ScreenCaptureAllowed.pfm_title = "Screenshots toestaan of weigeren";
ScreenCaptureAllowed.pfm_description = "Als dit beleid aanstaat of niet is ingesteld (standaard), kan een webpagina via API's voor scherm delen (bijvoorbeeld getDisplayMedia() of de API voor de extensie Bureaublad streamen) de gebruiker vragen een tabblad, venster of bureaublad te selecteren om vast te leggen.\n\nAls dit beleid uitstaat, mislukken aanroepen van API's voor scherm delen en wordt er een fout getoond. Er wordt echter geen rekening gehouden met dit beleid (en een site mag API's voor scherm delen gebruiken) als de site overeenkomt met het patroon van een oorsprong in een van de volgende beleidsregels:\nScreenCaptureAllowedByOrigins,\nWindowCaptureAllowedByOrigins,\nTabCaptureAllowedByOrigins,\nSameOriginTabCaptureAllowedByOrigins.\n";
ScreenCaptureAllowedByOrigins.pfm_title = "Bureaublad-, venster- en tabbladopname door deze oorsprongen toestaan";
ScreenCaptureAllowedByOrigins.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van sites die bureaublad-, venster- en tabbladopname mogen gebruiken.\n\nAls je dit beleid niet instelt, komen sites niet in aanmerking voor een overschrijving op dit opnameniveau.\n\nEr wordt geen rekening gehouden met dit beleid als een site overeenkomt met een URL-patroon in een van de volgende beleidsregels: WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nAls een site overeenkomt met een URL-patroon in dit beleid, wordt er geen rekening gehouden met het beleid ScreenCaptureAllowed.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige url-patronen.  Dit beleid zoekt alleen overeenkomsten op basis van de oorsprong, dus elk pad in het URL-patroon wordt genegeerd.";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "Schermopname zonder eerder gebruikersgebaar toestaan";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "Om veiligheidsredenen moet voor de web-API getDisplayMedia() een eerder gebruikersgebaar ('tijdelijke activering') worden aangeroepen, anders mislukt deze.\n\nAls dit beleid is ingesteld, kunnen beheerders oorsprongen specificeren waarvoor deze API kan worden aangeroepen zonder eerder gebruikersgebaar.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige URL-patronen. * is geen geaccepteerde waarde voor dit beleid.\n\nAls je dit beleid niet instelt, is voor alle oorsprongen een eerder gebruikersgebaar vereist om deze API aan te roepen.";
ScrollToTextFragmentEnabled.pfm_title = "Scrollen naar opgegeven tekst in URL-fragmenten aanzetten";
ScrollToTextFragmentEnabled.pfm_description = "Met deze functie kan URL-navigatie via hyperlinks en de adresbalk specifieke tekst binnen een webpagina targeten. Er wordt naar de tekst gescrolld nadat de webpagina is geladen.\n\nAls je dit beleid toepast of niet instelt, wordt op de webpagina naar specifieke tekstfragmenten scrollen via de URL aangezet.\n\nAls je dit beleid niet toepast, wordt op de webpagina naar specifieke tekstfragmenten scrollen via de URL uitgezet.";
SearchContentSharingSettings.pfm_title = "Content delen met Google AI Mode- en Lens-integraties aanzetten";
SearchContentSharingSettings.pfm_description = "0 - Content delen met Google AI Mode-integraties toestaan.\n1 - Content delen met Google AI Mode-integraties niet toestaan.\nMet dit beleid bepaal je of pagina- en bestandscontent kan worden gedeeld met Google AI Mode en Lens via het zijvenster of de tabbladen van Google Chrome.\n\nDit beleid heeft geen invloed op Google AI Mode op het web. Het bepaalt alleen hoe gebruikers informatie met het product kunnen delen als ze Google Chrome gebruiken.\n\n0 = gebruikers kunnen pagina- of bestandscontent delen met Google AI Mode.\n\n1 = gebruikers kunnen pagina- of bestandscontent niet delen met Google AI Mode. De startpunten voor context delen en het zijvenster worden uitgezet of verborgen.\n\nDit beleid wordt genegeerd als Google Search niet de standaard zoekmachine van gebruikers is, omdat de functie dan uitstaat.\n\nDit beleid is onafhankelijk van het beleid AIModeSettings. Het beleid AIModeSettings bepaalt alleen startpunten in de omnibox of het zoekvak op de pagina Nieuw tabblad, terwijl dit beleid het delen van context via het zijvenster of tabbladen beheert.\n\nDit beleid beheert ook niet de integratie van Google Gemini. Deze kan worden uitgezet door GeminiSettings.\n\nAls je dit beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
SearchSuggestEnabled.pfm_title = "Zoeksuggesties aanzetten";
SearchSuggestEnabled.pfm_description = "Als je het beleid instelt op True, worden zoeksuggesties in de adresbalk van Brave aangezet. Als je het beleid instelt op False, worden deze zoeksuggesties uitgezet.\n\nSuggesties op basis van bookmarks of geschiedenis worden niet beïnvloed door het beleid.\n\nAls je het beleid instelt, kunnen gebruikers het niet wijzigen. Als je dit beleid niet instelt, staan zoeksuggesties in eerste instantie aan, maar kunnen gebruikers deze op elk moment uitzetten.";
SecurityKeyPermitAttestation.pfm_title = "URL's/domeinen hebben rechtstreekse bevestiging van de beveiligingssleutel toegestaan";
SecurityKeyPermitAttestation.pfm_description = "Als je het beleid instelt, geef je WebAuthn RP-ID's op waarvoor geen prompt wordt getoond als er bevestigingscertificaten van beveiligingssleutels worden aangevraagd. Er wordt ook een signaal naar de beveiligingssleutel gestuurd om aan te geven dat zakelijke bevestiging kan worden gebruikt. Zonder dit signaal krijgen gebruikers in Brave versie 65 en later een prompt te zien als sites bevestiging van beveiligingssleutels aanvragen.";
SensorsAllowedForUrls.pfm_title = "Toegang tot sensoren op deze sites toestaan";
SensorsAllowedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van sites met toegang tot sensoren, zoals bewegingssensoren en lichtsensoren.\n\nAls je het beleid niet instelt, is DefaultSensorsSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nAls hetzelfde URL-patroon zowel in dit beleid als in het beleid SensorsBlockedForUrls bestaat, krijgt het tweede beleid voorrang en wordt de toegang tot bewegings- of lichtsensoren geblokkeerd.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
SensorsBlockedForUrls.pfm_title = "Toegang tot sensoren op deze sites blokkeren";
SensorsBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van sites die geen toegang mogen hebben tot sensoren, zoals bewegingssensoren en lichtsensoren.\n\nAls je het beleid niet instelt, is DefaultSensorsSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nAls hetzelfde URL-patroon zowel bestaat in dit beleid als het beleid SensorsAllowedForUrls, krijgt dit beleid voorrang en wordt de toegang tot bewegings- of lichtsensoren geblokkeerd.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. Jokertekens (*) zijn toegestaan.";
SerialAllowAllPortsForUrls.pfm_title = "Automatisch rechten aan sites geven om verbinding te maken met alle seriële poorten.";
SerialAllowAllPortsForUrls.pfm_description = "Als je dit beleid instelt, kun je een lijst met sites maken die automatisch toestemming krijgen voor toegang tot alle beschikbare seriële poorten.\n\nDe URL's moeten geldig zijn, anders wordt het beleid genegeerd. Er wordt alleen gekeken naar de oorsprong (schema, host en poort) van de URL.\n\nVoor Google Chrome OS geldt dit beleid alleen voor aangesloten gebruikers.\n\nDit beleid overschrijft DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls en de voorkeuren van de gebruiker.";
SerialAllowUsbDevicesForUrls.pfm_title = "Automatisch toestemming aan sites geven om verbinding te maken met seriële USB-apparaten.";
SerialAllowUsbDevicesForUrls.pfm_description = "Als je dit beleid instelt, kun je een lijst met sites maken die automatisch toegang krijgen tot seriële USB-apparaten met leveranciers- en product-ID's die overeenkomen met de velden vendor_id en product_id. Als je het veld product_id weglaat, krijgen de opgegeven sites toestemming voor toegang tot apparaten met een leveranciers-ID die overeenkomt met het veld vendor_id en elke willekeurige product-ID.\n\nDe URL's moeten geldig zijn, anders wordt het beleid genegeerd. Er wordt alleen gekeken naar de oorsprong (schema, host en poort) van de URL.\n\nVoor Chrome OS geldt dit beleid alleen voor aangesloten gebruikers.\n\nDit beleid overschrijft DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls en de voorkeuren van de gebruiker.\n\nDit beleid heeft alleen effect op USB-apparaten via de Web Serial API. Zie het beleid WebUsbAllowDevicesForUrls als je USB-apparaten toegang wilt geven via de WebUSB API.\nGa naar https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls voor meer informatie over schema en indeling.";
SerialAskForUrls.pfm_title = "De Serial API toestaan op deze sites";
SerialAskForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om op te geven welke sites gebruikers mogen vragen om toegang tot een seriële poort.\n\nAls je het beleid niet instelt, is DefaultSerialGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van gebruikers.\n\nAls URL-patronen niet overeenkomen met het beleid SerialBlockedForUrls (als er een overeenkomst is), krijgen DefaultSerialGuardSetting (indien ingesteld) of de persoonlijke instellingen van de gebruikers voorrang, in die volgorde.\n\nAls URL-patronen conflicteren met SerialBlockedForUrls, worden ze genegeerd.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
SerialBlockedForUrls.pfm_title = "De Serial API op deze sites blokkeren";
SerialBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om aan te geven welke sites gebruikers niet mogen vragen om toegang tot een seriële poort.\n\nAls je het beleid niet instelt, is DefaultSerialGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nAls URL-patronen niet overeenkomen met het beleid SerialAskForUrls (als er een overeenkomst is), krijgen DefaultSerialGuardSetting (indien ingesteld) of de persoonlijke instellingen van de gebruikers voorrang, in die volgorde.\n\nAls URL-patronen conflicteren met SerialAskForUrls, krijgt dit beleid voorrang.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
ServiceWorkerAutoPreloadEnabled.pfm_title = "ServiceWorker toestaan navigatieverzoeken te sturen zonder te wachten tot deze is opgestart";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nDe functie ServiceWorkerAutoPreload stuurt een netwerkverzoek voor een hoofdresource op hetzelfde moment dat het ServiceWorker-bootstrap-proces wordt gestart.\n\nAls je het beleid toepast of niet instelt, zet Brave ServiceWorkerAutoPreload aan. Het navigatieverzoek wordt in sommige scenario's automatisch verstuurd terwijl de ServiceWorker wordt gestart, bijvoorbeeld als de ServiceWorker niet actief is.\n\nAls je het beleid niet toepast, zet Brave ServiceWorkerAutoPreload niet aan. Het navigatieverzoek wordt altijd verstuurd nadat de ServiceWorker is gestart.\n\nDit beleid is een tijdelijke maatregel om de functie te beheren en wordt verwijderd in M154.";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "ServiceWorker toestaan srcdoc-iframes te beheren";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "https://github.com/w3c/ServiceWorker/issues/765 vereist dat een srcdoc-iframe met het sandboxkenmerk 'allow-same-origin' wordt beheerd door ServiceWorker.\n\nAls je het beleid toepast of niet instelt, zorgt Brave ervoor dat srcdoc-iframes met het sandboxkenmerk 'allow-same-origin' worden beheerd door ServiceWorker.\n\nAls je het beleid niet toepast, wordt het srcdoc-iframe niet beheerd door ServiceWorker.\n\nDit beleid is tijdelijk en wordt verwijderd in 2026.";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "Geeft aan of SharedArrayBuffers kan worden gebruikt in een context zonder cross-origin-isolatie";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\nGeeft aan of SharedArrayBuffers kan worden gebruikt in een context zonder cross-origin-isolatie. Vanaf Brave 91 (25-05-2021) vereist Brave cross-origin-isolatie bij gebruik van SharedArrayBuffers vanwege redenen met webcompatibiliteit. Je kunt meer informatie bekijken op: https://developer.chrome.com/blog/enabling-shared-array-buffer/.\n\nAls dit beleid wordt toegepast, kunnen sites SharedArrayBuffer gebruiken zonder beperkingen.\n\nAls dit beleid niet wordt toegepast of niet is ingesteld, kunnen sites SharedArrayBuffers alleen gebruiken als ze cross-origin geïsoleerd zijn.";
SharedWorkerBlobURLFixEnabled.pfm_title = "Het gedrag van de SharedWorker-blob-URL afstemmen op de specificatie";
SharedWorkerBlobURLFixEnabled.pfm_description = "Volgens https://w3c.github.io/ServiceWorker/#control-and-use-worker-client moeten workers controllers voor de blob-URL overnemen.  In bestaande code kunnen alleen DedicatedWorkers de controller overnemen en SharedWorkers niet.\n\nAls je het beleid toepast of niet instelt, neemt Brave de controller over als een blob-URL wordt gebruikt als een SharedWorker-URL.\n\nAls je het beleid niet toepast, wordt het gedrag niet afgestemd op de specificatie.\n\nDit beleid is tijdelijk en wordt in de toekomst verwijderd.";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "Uitgebreide levensduur voor SharedWorkers aanzetten";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "SharedWorkers kunnen een uitgebreide levensduur hebben als de optie extendedLifetime is ingesteld op waar in de SharedWorker-constructor.\n\nAls je dit beleid toepast of niet instelt, kunnen SharedWorkers een uitgebreide levensduur hebben.\n\nAls je dit beleid niet toepast, kunnen SharedWorkers geen uitgebreide levensduur hebben, zelfs niet als je de optie instelt op Waar.\n\nDit beleid is tijdelijk en wordt in de toekomst verwijderd.";
ShoppingListEnabled.pfm_title = "Toestaan dat de functie voor boodschappenlijstjes wordt aangezet";
ShoppingListEnabled.pfm_description = "Dit beleid bepaalt de beschikbaarheid van de functie voor boodschappenlijstjes.\nAls je dit beleid toepast, krijgen gebruikers een UI te zien om de prijs te volgen van het product dat op de huidige pagina wordt getoond. Het gevolgde product wordt in het zijvenster met bookmarks getoond.\nAls je dit beleid toepast of niet instelt, is de functie voor boodschappenlijstjes beschikbaar voor gebruikers.\nAls je dit beleid niet toepast, is de functie voor boodschappenlijstjes niet beschikbaar.\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "De snelkoppeling voor apps tonen op de bookmarkbalk";
ShowAppsShortcutInBookmarkBar.pfm_description = "Als je het beleid instelt op 'True', wordt de app-snelkoppeling getoond. Als je het beleid instelt op 'False', wordt deze snelkoppeling nooit getoond.\n\nAls je het beleid instelt, kunnen gebruikers het niet wijzigen. Als je het beleid niet instelt, kunnen gebruikers aangeven of de app-snelkoppeling moet worden getoond of verborgen in het contextmenu van de bookmarkbalk.";
ShowCastIconInToolbar.pfm_title = "Werkbalkicoon van Google Cast tonen";
ShowCastIconInToolbar.pfm_description = "Als je het beleid toepast, wordt het Cast-icoon getoond op de werkbalk of in het overloopmenu en kunnen gebruikers het icoon niet verwijderen.\n\nAls je het beleid niet toepast of niet instelt, kunnen gebruikers het icoon vastzetten of verwijderen via het contextmenu.\n\nAls je het beleid EnableMediaRouter niet toepast, heeft de waarde van dit beleid geen effect en wordt het werkbalkicoon niet getoond.";
ShowCastSessionsStartedByOtherDevices.pfm_title = "Mediabediening tonen voor Google Cast-sessies die worden gestart door andere apparaten in het lokale netwerk";
ShowCastSessionsStartedByOtherDevices.pfm_description = "Als je dit beleid toepast, is de gebruikersinterface voor de afspeelbediening voor media beschikbaar voor Google Cast-sessies die worden gestart door andere apparaten in het lokale netwerk.\n\nAls je dit beleid niet instelt voor zakelijke gebruikers of niet toepast, is de gebruikersinterface voor de afspeelbediening voor media niet beschikbaar voor Google Cast-sessies die worden gestart door andere apparaten in het lokale netwerk.\n\nAls je het beleid EnableMediaRouter niet toepast, heeft de waarde van dit beleid geen effect, omdat de hele Google Cast-functionaliteit uitstaat.";
ShowFullUrlsInAddressBar.pfm_title = "Volledige URL's tonen";
ShowFullUrlsInAddressBar.pfm_description = "Met deze functie is de volledige URL in de adresbalk zichtbaar.\nAls je dit beleid instelt op True, is de volledige URL zichtbaar in de adresbalk, inclusief schema's en subdomeinen.\nAls je dit beleid instelt op False, wordt de standaard URL-weergave toegepast.\nAls je dit beleid niet instelt, wordt de standaard URL-weergave toegepast. Via een optie in het contextmenu kan de gebruiker schakelen tussen de standaard en volledige URL-weergave.";
ShowHomeButton.pfm_title = "Homepage-knop in de werkbalk tonen";
ShowHomeButton.pfm_description = "Als je het beleid toepast, wordt de Homepage-knop in de werkbalk van Brave getoond. Als je het beleid niet toepast, wordt de Homepage-knop niet getoond.\n\nAls je het beleid instelt, kunnen gebruikers dit niet wijzigen in Brave. Als je het beleid niet instelt, kunnen gebruikers bepalen of ze de Homepage-knop wel of niet willen tonen.";
SideSearchEnabled.pfm_title = "Weergave van de meest recente resultatenpagina van de standaard zoekmachine in een zijvenster van de browser toestaan";
SideSearchEnabled.pfm_description = "Als je dit beleid toepast of niet instelt, kunnen gebruikers de meest recente resultatenpagina van de standaard zoekmachine in een zijvenster tonen door een icoon in de werkbalk aan/uit te zetten.\n\nAls je dit beleid niet toepast, wordt het icoon waarmee het zijvenster met de resultatenpagina van de standaard zoekmachine kan worden geopend, uit de werkbalk verwijderd.";
SignedHTTPExchangeEnabled.pfm_title = "Signed HTTP Exchange-ondersteuning (SXG) aanzetten";
SignedHTTPExchangeEnabled.pfm_description = "Als je het beleid instelt op True of niet instelt, accepteert Brave webcontent die wordt getoond als Signed HTTP Exchange.\n\nAls je het beleid instelt op False, worden Signed HTTP Exchanges niet geladen.";
SigninInterceptionEnabled.pfm_title = "Onderschepping bij inloggen aanzetten";
SigninInterceptionEnabled.pfm_description = "Met deze instelling kun je onderschepping bij inloggen aan- of uitzetten.\n\nAls je dit beleid toepast of niet instelt, wordt het dialoogvenster voor onderschepping bij inloggen getoond als een Google-account wordt toegevoegd op het web en de gebruiker er mogelijk baat bij heeft als dit account wordt verplaatst naar een ander (nieuw of bestaand) profiel.\n\nAls je het beleid niet toepast, wordt geen dialoogvenster voor onderschepping bij inloggen getoond.\nAls je het beleid niet toepast, wordt er toch een dialoogvenster getoond als de scheiding van profielen voor beheerde accounts wordt afgedwongen door ManagedAccountsSigninRestriction.";
SilentPrintingEnabled.pfm_title = "Stil afdrukken aanzetten";
SilentPrintingEnabled.pfm_description = "Als je dit beleid instelt op Waar, wordt stil afdrukken aangezet. Het venster voor afdrukvoorbeeld wordt dan meteen gesloten als het wordt geopend en er wordt afgedrukt naar de standaardprinter met de standaardopties. Als de standaardprinter Opslaan als pdf is, wordt het bestand opgeslagen in de map Downloads.\n\nAls je dit beleid niet instelt of instelt op Onwaar, wordt stil afdrukken uitgezet. Het venster voor afdrukvoorbeeld wordt dan niet automatisch gesloten en de gebruiker moet zoals gewoonlijk een selectie maken.";
SitePerProcess.pfm_title = "Site-isolatie verplichten voor elke site";
SitePerProcess.pfm_description = "Sinds Brave 67 staat site-isolatie standaard aan op alle desktopplatforms, waardoor elke site zijn eigen proces uitvoert. Een site is een schema plus eTLD+1 (bijvoorbeeld https://example.com). Dit gedrag verandert niet als je dit beleid toepast, maar het verhindert wel dat gebruikers deze functie kunnen uitzetten (bijvoorbeeld door site-isolatie uit te zetten in chrome://flags). Sinds Brave 76 wordt site-isolatie niet uitgezet als je het beleid niet toepast of niet instelt, maar kunnen gebruikers deze functie zelf uitzetten.\n\nIsolateOrigins kan ook handig zijn om specifieke herkomsten te isoleren op een kleiner niveau dan het siteniveau (bijvoorbeeld https://a.example.com).\n\nIn Google Chrome OS versie 76 en eerder stel je het apparaatbeleid van DeviceLoginScreenSitePerProcess in op dezelfde waarde. (Er kan een vertraging optreden als de waarden niet overeenkomen bij het starten van een gebruikerssessie.)\n\nOpmerking: Voor Android gebruik je het beleid SitePerProcessAndroid.";
SiteSearchSettings.pfm_title = "Instellingen voor Zoekopdrachten op site";
SiteSearchSettings.pfm_description = "Dit beleid biedt een lijst met sites die gebruikers snel kunnen zoeken met snelkoppelingen in de adresbalk. Gebruikers kunnen een zoekopdracht starten door de snelkoppeling of @snelkoppeling (bijvoorbeeld @werk), gevolgd door de spatiebalk of Tab, in de adresbalk te typen.\n\nDe volgende velden zijn vereist voor elke site: name, shortcut, url.\n\nHet veld name komt overeen met de naam van de site of zoekmachine die aan de gebruiker wordt getoond in de adresbalk.\n\nHet veld shortcut kan gewone woorden en tekens bevatten, maar mag geen spaties bevatten of beginnen met het symbool @. Snelkoppelingen moeten ook uniek zijn.\n\nVoor elke invoer geeft het veld url de URL aan van de zoekmachine die tijdens een zoekopdracht met het bijbehorende zoekwoord wordt gebruikt. De URL moet de tekenreeks '{searchTerms}' bevatten. Deze tekenreeks wordt tijdens de zoekopdracht vervangen door de zoektermen van de gebruiker. Ongeldige invoer en vermeldingen met dubbele snelkoppelingen worden genegeerd.\n\nItems voor zoekopdrachten op site die zijn ingesteld als aanbevolen, worden weergegeven in de adresbalk als de gebruiker '@' typt. Er kunnen maximaal 3 items als aanbevolen worden geselecteerd.\n\nVoor een item voor zoekopdrachten op site waarbij allow_user_override Waar is, kunnen gebruikers die vermelding bewerken of uitzetten. Aanbevolen zoekmachines (die beginnen met @) kunnen alleen worden uitgezet. Als een gebruiker een item wijzigt dat oorspronkelijk is gemaakt door dit beleid, wordt het niet meer beheerd door het beleid en wordt het behandeld als een door de gebruiker gemaakte snelkoppeling. Als allow_user_override Onwaar of niet gespecificeerd is voor een item voor zoekopdrachten op site, kunnen gebruikers dat item niet bewerken of uitzetten. De instelling om overschrijven door gebruikers toe te staan, wordt alleen ondersteund in M139 en hoger. Eerdere versies staan standaard geen overschrijving door gebruikers toe.\n\nGebruikers kunnen geen nieuwe items voor zoekopdrachten op site maken met een snelkoppeling die eerder via dit beleid is gemaakt, tenzij allow_user_override is ingesteld op Waar voor het item voor zoekopdrachten op site.\n\nAls er een conflict is met een snelkoppeling die de gebruiker eerder heeft gemaakt, krijgt de gebruikersinstelling voorrang. Gebruikers kunnen de optie die door het beleid is gemaakt nog wel activeren door '@' in de zoekbalk te typen. Als de gebruiker bijvoorbeeld 'werk' al heeft gedefinieerd als snelkoppeling naar URL1 en het beleid de optie 'werk' definieert als snelkoppeling naar URL2, wordt er een zoekopdracht naar URL1 gestart als de gebruiker 'werk' in de zoekbalk typt, maar wordt er naar URL2 gezocht als de gebruiker '@werk' in de zoekbalk typt.\n\nIn Microsoft® Windows® is dit beleid alleen beschikbaar voor instanties die zijn gekoppeld aan een Microsoft® Active Directory®-domein of aan Microsoft® Azure® Active Directory®, of die zijn ingeschreven voor Chrome Enterprise Core.\n\nIn macOS is dit beleid alleen beschikbaar voor instanties die via MDM worden beheerd, via een MCX aan een domein zijn gekoppeld of zijn ingeschreven voor Chrome Enterprise Core.\nGa naar https://chromeenterprise.google/policies/?policy=SiteSearchSettings voor meer informatie over schema en indeling.";
SmartTabSharingSettings.pfm_title = "Instellingen voor slim tabblad delen";
SmartTabSharingSettings.pfm_description = "0 - Slimme tabbladen delen met Google AI Mode-integraties toestaan.\n1 - Slim tabblad delen met Google AI Mode-integraties niet toestaan.\nMet dit beleid bepaal je of de functie voor slim tabblad delen van Google AI Mode kan worden gebruikt via het zijvenster of de tabbladen van Google Chrome.\n\nDit beleid heeft geen invloed op Google AI Mode op het web. Het bepaalt alleen hoe gebruikers informatie met het product kunnen delen als ze Google Chrome gebruiken.\n\n0 = gebruikers kunnen pagina- of bestandscontent delen met Google AI Mode.\n\n1 = gebruikers kunnen pagina- of bestandscontent niet delen met Google AI Mode. De startpunten voor context delen en het zijvenster worden uitgezet of verborgen.\n\nDit beleid wordt genegeerd als Google Search niet de standaard zoekmachine van gebruikers is, omdat de functie dan uitstaat.\n\nDit beleid is onafhankelijk van het beleid AIModeSettings. Het beleid AIModeSettings bepaalt alleen startpunten in de omnibox of het zoekvak op de pagina Nieuw tabblad, terwijl dit beleid context delen via het zijvenster of tabbladen beheert.\n\nDit beleid beheert ook niet de integratie van Google Gemini. Deze kan worden uitgezet door GeminiSettings.\n\nAls je SearchContentSharingSettings uitzet, wordt dit beleid genegeerd.\n\nAls je dit beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
SpellCheckServiceEnabled.pfm_title = "Webservice voor spellingcontrole aan- of uitzetten";
SpellCheckServiceEnabled.pfm_description = "Als je het beleid toepast, wordt een Google-webservice gebruikt om spelfouten te verhelpen. Dit beleid beheert alleen het gebruik van de online service. Als je het beleid niet toepast, wordt deze service nooit gebruikt.\n\nAls je het beleid niet instelt, kunnen gebruikers kiezen of ze de service voor spellingcontrole willen gebruiken.\n\nVoor de spellingcontrole kan altijd een lokaal gedownload woordenboek worden gebruikt, tenzij de functie is uitgezet op basis van SpellcheckEnabled. In dat geval heeft dit beleid geen effect.";
SpellcheckEnabled.pfm_title = "Spellingcontrole aanzetten";
SpellcheckEnabled.pfm_description = "Als je het beleid toepast, wordt de spellingcontrole aangezet en kunnen gebruikers deze niet uitzetten. In Microsoft® Windows®, Google Chrome OS en Linux® kunnen talen voor spellingcontrole afzonderlijk worden aan- of uitgezet, zodat gebruikers de spellingcontrole nog steeds kunnen uitzetten door alle talen voor spellingcontrole uit te zetten. Als je dat wilt voorkomen, gebruik je het beleid SpellcheckLanguage om af te dwingen dat specifieke talen voor spellingcontrole worden aangezet.\n\nAls je het beleid niet toepast, wordt spellingcontrole vanuit alle bronnen uitgezet en kunnen gebruikers deze niet aanzetten. De beleidsregels SpellCheckServiceEnabled, SpellcheckLanguage en SpellcheckLanguageBlocklist hebben geen invloed wanneer dit beleid is ingesteld op False.\n\nAls je het beleid niet instelt, kunnen gebruikers de spellingcontrole aan- of uitzetten in de taalinstellingen.";
StandardizedBrowserZoomEnabled.pfm_title = "Gestandaardiseerd zoomgedrag van browser aanzetten";
StandardizedBrowserZoomEnabled.pfm_description = "Dit beleid zorgt voor naleving van de nieuw aangenomen specificatie voor css-zoom.\n\nAls je dit beleid toepast of niet instelt, houdt de css-eigenschap 'zoom' zich aan de specificatie:\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\nAls je het beleid niet toepast, valt de css-eigenschap 'zoom' terug op het verouderde gedrag van vóór de standaardisatie.\n\nDit beleid is een tijdelijke uitstelmaatregel om tijd te geven om webcontent te migreren naar het nieuwe gedrag. Er is ook een origin trial (DisableStandardizedBrowserZoom) die overeenkomt met het gedrag als dit beleid niet wordt toegepast. Dit beleid wordt verwijderd en het gedrag Aangezet wordt permanent in mijlpaal 134.";
StaticStorageQuotaEnabled.pfm_title = "Bepalen of API's voor opslagquotum statische waarden retourneren";
StaticStorageQuotaEnabled.pfm_description = "Als dit beleid wordt toegepast, retourneren de API's voor opslagquotum een statische waarde die gelijk is aan gebruik + min (10 GiB, schijf afgerond naar boven naar de dichtstbijzijnde 1 GiB).\nAls het beleid niet wordt toegepast, retourneren de API's voor opslagquotum meestal een dynamische waarde die evenredig is aan de totale beschikbare ruimte op het apparaat, ongeacht het gebruik.\nAls je dit beleid niet instelt, gebruiken de API's voor opslagquotum het standaardgedrag van Chrome.\nDeze instelling heeft geen invloed op sites met rechten voor onbeperkte opslag. Dit heeft ook geen invloed op het afgedwongen quotum.";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "Strenge MIME-typecontrole voor workerscripts aanzetten";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "Met dit beleid kun je strenge MIME-typecontrole voor workerscripts aanzetten.\n\nAls je het beleid toepast of niet instelt, gebruiken workerscripts strenge MIME-typecontrole voor JavaScript. Dit is het nieuwe standaardgedrag. Workerscripts met verouderde MIME-typen worden geweigerd.\n\nAls je het beleid niet toepast, gebruiken workerscripts minder strenge MIME-typecontrole, zodat workerscripts met verouderde MIME-typen, bijv. text/ascii, nog steeds worden geladen en uitgevoerd.\n\nBrowsers maakten oorspronkelijk gebruik van minder strenge MIME-typecontrole, zodat resources met een aantal verouderde MIME-typen werden ondersteund. Voor JavaScript-resources is text/ascii bijvoorbeeld een verouderd ondersteund MIME-type. Dit kan beveiligingsproblemen opleveren, omdat resources dan kunnen worden geladen als scripts die nooit bedoeld waren om op die manier te worden gebruikt. Chrome wordt binnenkort overgezet naar strenge MIME-typecontrole. Het toegepaste beleid houdt het standaardgedrag bij. Als je dit beleid niet toepast, kunnen beheerders het verouderde gedrag bijhouden als ze dat willen.\n\nGa naar https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage voor meer informatie over JavaScript-/ECMAScript-mediatypen.\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "JavaScript-dialoogvensters onderdrukken als deze worden geactiveerd vanaf een subframe met een andere oorsprong";
SuppressDifferentOriginSubframeDialogs.pfm_description = "Zoals wordt beschreven in https://www.chromestatus.com/feature/5148698084376576, worden modulaire JavaScript-dialoogvensters die worden geactiveerd door window.alert, window.confirm en window.prompt, geblokkeerd in Brave als ze worden geactiveerd vanuit een subframe waarvan de oorsprong verschilt van de oorsprong van de hoofdframe.\n\nMet dit beleid kun je die wijziging overschrijven.\nAls je het beleid toepast of niet instelt, worden JavaScript-dialoogvensters geblokkeerd als ze afkomstig zijn van een subframe met een andere oorsprong.\nAls je het beleid niet toepast, worden JavaScript-dialoogvensters niet geblokkeerd, zelfs niet als ze afkomstig zijn van een subframe met een andere oorsprong.\n\nDit beleid wordt in de toekomst verwijderd uit Brave.";
SuppressUnsupportedOSWarning.pfm_title = "De waarschuwing voor een niet-ondersteund besturingssysteem negeren";
SuppressUnsupportedOSWarning.pfm_description = "Als je het beleid toepast, wordt de waarschuwing genegeerd die wordt getoond als Brave wordt uitgevoerd op een computer die of besturingssysteem dat niet meer wordt ondersteund.\n\nAls je dit beleid niet toepast of niet instelt, worden de waarschuwingen bekijken op niet-ondersteunde systemen.";
SyncDisabled.pfm_title = "Synchronisatie van gegevens met Google uitzetten";
SyncDisabled.pfm_description = "Als je het beleid toepast, wordt gegevenssynchronisatie in Brave via door Google gehoste synchronisatieservices uitgezet.\nAls je Chrome Sync-services helemaal wilt uitzetten, raden we je aan de service in Google Admin console uit te zetten.\n\nAls je het beleid niet toepast of niet instelt, kunnen gebruikers kiezen of ze gebruikmaken van Chrome Sync.\n\nOpmerking: Pas dit beleid niet toe als RoamingProfileSupportEnabled aanstaat, want die functie heeft dezelfde functionaliteit aan de clientzijde. In dit geval staat de door Google gehoste synchronisatie helemaal uit.";
SyncTypesListDisabled.pfm_title = "Lijst met typen die moeten worden uitgesloten van synchronisatie";
SyncTypesListDisabled.pfm_description = "Als je het beleid instelt, worden alle verstrekte gegevenstypen uitgesloten van synchronisatie voor zowel Chrome Sync als synchronisatie van roamingprofielen. Dit kan handig zijn om het roamingprofiel te verkleinen of het type gegevens te beperken dat wordt geüpload naar de Chrome Sync-servers.\n\nDe huidige gegevenstypen voor dit beleid zijn: \"apps\", \"autofill\", \"bookmarks\", \"extensions\", \"preferences\", \"passwords\", \"payments\", \"productComparison\", \"readingList\", \"tabs\", \"themes\", \"typedUrls\", \"wifiConfigurations\". Die namen zijn hoofdlettergevoelig.\n\nOpmerkingen: Beleid dynamisch vernieuwen wordt alleen ondersteund in Brave versie 123 en hoger. Als je 'autofill' uitzet, wordt 'payments' ook uitgezet. 'typedUrls' verwijst naar de hele browsegeschiedenis.";
TLS13EarlyDataEnabled.pfm_title = "TLS 1.3 Early Data aanzetten";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Early Data is een extensie van TLS 1.3 waarmee je een HTTP-verzoek tegelijkertijd met de TLS-handshake kunt sturen.\n\nAls je dit beleid niet instelt, volgt Brave het standaard uitrolproces voor TLS 1.3 Early Data.\n\nAls je dit beleid toepast, zet Brave TLS 1.3 Early Data aan.\n\nAls je het beleid niet toepast, zet Brave TLS 1.3 Early Data niet aan.\n\nAls de functie aanstaat, kan Brave TLS 1.3 Early Data wel of niet gebruiken, afhankelijk van de serverondersteuning.\n\nTLS 1.3 Early Data is een vastgesteld protocol. Van bestaande TLS-servers, middleboxes en beveiligingssoftware wordt verwacht dat ze TLS 1.3 Early Data verwerken of weigeren zonder de verbinding te verbreken.\n\nApparaten waarop TLS niet correct wordt geïmplementeerd, werken misschien niet goed en verbreken mogelijk de verbinding als TLS 1.3 Early Data wordt gebruikt. Als dit gebeurt, moeten beheerders contact opnemen met de leverancier voor een oplossing.\n\nDit beleid is een tijdelijke maatregel om de functie te beheren en wordt daarna verwijderd. Je kunt het beleid aanzetten om te testen of er problemen zijn en uitzetten als er problemen optreden.";
TabCaptureAllowedByOrigins.pfm_title = "Tabbladopname door deze oorsprongen toestaan";
TabCaptureAllowedByOrigins.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van de sites die tabbladopname mogen gebruiken.\n\nAls je dit beleid niet instelt, komen sites niet in aanmerking voor een overschrijving op dit opnameniveau.\n\nChrome-apps in vensters met dezelfde oorsprong mogen worden opgenomen.\n\nMet dit beleid wordt geen rekening gehouden als een site overeenkomt met een URL-patroon in het beleid SameOriginTabCaptureAllowedByOrigins.\n\nAls een site overeenkomt met een URL-patroon in dit beleid, wordt er geen rekening gehouden met de volgende beleidsregels: WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige url-patronen.  Dit beleid zoekt alleen overeenkomsten op basis van de oorsprong, dus elk pad in het URL-patroon wordt genegeerd.";
TabCompareSettings.pfm_title = "Instellingen voor Tabbladen vergelijken";
TabCompareSettings.pfm_description = "0 - Sta Tabbladen vergelijken toe en verbeter AI-modellen.\n1 - Sta Tabbladen vergelijken toe zonder AI-modellen te verbeteren.\n2 - Sta Tabbladen vergelijken niet toe.\nTabbladen vergelijken is een AI-gestuurde tool om informatie op de tabbladen van een gebruiker te vergelijken. De functie kan bijvoorbeeld worden aangeboden aan de gebruiker als er meerdere tabbladen met producten in een vergelijkbare categorie zijn geopend.\n\n0 = Hiermee wordt toegestaan dat de functie wordt gebruikt en dat Google relevante gegevens gebruikt om de AI-modellen te verbeteren. Relevante gegevens kunnen prompts, invoer, uitvoer, bronmateriaal en geschreven feedback zijn, afhankelijk van de functie. De gegevens kunnen ook door mensen worden beoordeeld om AI-modellen te verbeteren. 0 is de standaardwaarde, behalve zoals hieronder aangegeven.\n\n1 = Hiermee wordt toegestaan dat de functie wordt gebruikt, maar wordt niet toegestaan dat Google modellen verbetert met content van gebruikers (waaronder prompts, invoer, uitvoer, bronmateriaal en geschreven feedback). 1 is de standaardwaarde voor zakelijke gebruikers die worden beheerd via Google Admin console en voor onderwijsaccounts die worden beheerd via Google Workspace.\n\n2 = Hiermee wordt de functie niet toegestaan.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
TabDiscardingExceptions.pfm_title = "URL-patroonuitzonderingen voor tabbladverwijdering";
TabDiscardingExceptions.pfm_description = "Dit beleid zorgt ervoor dat elke URL die overeenkomt met een of meer patronen uit het beleid (met de filterindeling URLBlocklist), nooit door de browser wordt verwijderd.\nDit is van toepassing op geheugenbelasting en weggooien in de modus voor hoge efficiëntie.\nHet laden van een weggegooide pagina wordt ongedaan gemaakt en de bijbehorende resources worden volledig teruggeclaimd. Het tabblad waaraan de pagina is gekoppeld, blijft in de tabbladstrook staan, maar als je het tabblad zichtbaar maakt, wordt de pagina helemaal opnieuw geladen.\n";
TaskManagerEndProcessEnabled.pfm_title = "Beëindiging van processen in Taakbeheer aanzetten";
TaskManagerEndProcessEnabled.pfm_description = "Als je het beleid niet toepast, kunnen gebruikers geen processen beëindigen in Taakbeheer.\n\nAls je het beleid toepast of niet instelt, kunnen gebruikers processen beëindigen in Taakbeheer.";
ThirdPartyAiChatSettings.pfm_title = "Instellingen voor integraties van de AI-modus van derden in de adresbalk en het zoekvak op de pagina Nieuw tabblad.";
ThirdPartyAiChatSettings.pfm_description = "0 - Integraties van derden met de AI-modus toestaan.\n1 - Integraties van derden met de AI-modus niet toestaan.\nMet dit beleid bepaal je of integraties van de AI-modus van derden beschikbaar zijn in de adresbalk en het zoekvak op de pagina Nieuw tabblad.\n\nVoor toegang tot deze functie moet een zoekmachine van derden die de AI-modus ondersteunt, zijn ingesteld als de standaard zoekmachine van de gebruiker.\n\n0 = De functie is beschikbaar voor gebruikers.\n\n1 = De functie is niet beschikbaar voor gebruikers.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "Geheugenlimiet instellen voor Chrome-instanties";
TotalMemoryLimitMb.pfm_description = "Hiermee configureer je de hoeveelheid geheugen die één instantie van Brave kan gebruiken voordat tabbladen worden verwijderd om geheugen te besparen (dit houdt in dat het geheugen dat voor het tabblad wordt gebruikt, wordt vrijgemaakt en dat het tabblad opnieuw moet worden geladen als de gebruiker naar dit tabblad schakelt).\n\nAls het beleid is ingesteld, worden tabbladen in de browser verwijderd om geheugen te besparen als de limiet wordt bereikt. Er is geen garantie dat de browser altijd onder de limiet wordt uitgevoerd. Elke waarde lager dan 1024 wordt afgerond naar 1024.\n\nAls dit beleid niet is ingesteld, begint de browser pas met het besparen van geheugen nadat is gedetecteerd dat er nog maar een kleine hoeveelheid fysiek geheugen op de machine beschikbaar is.";
TranslateEnabled.pfm_title = "Vertalen aanzetten";
TranslateEnabled.pfm_description = "Als je het beleid instelt op True, wordt gebruikers vertaalfunctionaliteit aangeboden als dit gepast is. In dat geval is een geïntegreerde vertaalwerkbalk zichtbaar in Brave en een vertaaloptie in het contextmenu als je klikt met de rechtermuisknop. Als je het beleid instelt op False, worden alle ingebouwde vertaalfuncties uitgezet.\n\nAls je het beleid instelt, kunnen gebruikers deze functie niet wijzigen. Als je het niet instelt, kunnen ze de instelling wel wijzigen.";
TranslatorAPIAllowed.pfm_title = "Translator API toestaan";
TranslatorAPIAllowed.pfm_description = "Als je het beleid toepast of niet instelt, mag de Translator API worden gebruikt in Brave.\n\nAls je het beleid niet toepast, mag de Translator API niet worden gebruikt.";
TryOnYouSettings.pfm_title = "Instellingen voor Uitproberen op jezelf.";
TryOnYouSettings.pfm_description = "0 - Uitproberen op jezelf aanzetten met modelverbetering.\n1 - Uitproberen op jezelf aanzetten zonder modelverbetering.\n2 - Uitproberen op jezelf uitzetten.\nUitproberen op jezelf is een AI-gestuurde functie waarmee gebruikers kledingafbeeldingen die ze op internet vinden, virtueel kunnen uitproberen en nuttige Shopping-inzichten krijgen in Gemini in Chrome, als Gemini in Chrome aanstaat.\n\n0 = Hiermee wordt toegestaan dat de functie wordt gebruikt en dat Google relevante gegevens gebruikt om de AI-modellen te verbeteren. Relevante gegevens kunnen afbeeldingen, invoer, uitvoer, bronmateriaal en feedback zijn, afhankelijk van de functie. De gegevens kunnen ook door mensen worden beoordeeld om AI-modellen te verbeteren. 0 is de standaardwaarde, behalve zoals hieronder aangegeven.\n\n1 = Hiermee wordt toegestaan dat de functie wordt gebruikt, maar wordt niet toegestaan dat Google modellen verbetert met content van gebruikers (waaronder afbeeldingen, invoer, uitvoer, bronmateriaal en feedback). 1 is de standaardwaarde voor zakelijke gebruikers die worden beheerd via Google Admin console en voor onderwijsaccounts die worden beheerd via Google Workspace.\n\n2 = Hiermee wordt de functie niet toegestaan.\n\nOpmerking: De beperking voor modelverbeteringen (waarde 1) is alleen van toepassing als Uitproberen op jezelf wordt geactiveerd via de browserflow van Chrome. Dit geldt niet als de functie wordt gebruikt via andere processen.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings. Ga naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.\n\nUitproberen op jezelf is niet in alle landen of talen beschikbaar. Als je dit beleid instelt, garandeert dit niet dat de functie wordt aangezet. De functie blijft afhankelijk van de beschikbaarheid. Check de release-opmerkingen voor Chrome Enterprise voor meer informatie over de uitrol: https://support.google.com/chrome/a/answer/7679408?hl=nl";
URLAllowlist.pfm_title = "Toegang verlenen aan een lijst met URL's";
URLAllowlist.pfm_description = "Als je dit beleid instelt, wordt toegang geboden tot de vermelde URL's, als uitzonderingen op URLBlocklist. Zie de beschrijving van dat beleid voor de indeling van items in deze lijst. Als je URLBlocklist bijvoorbeeld instelt op *, worden alle verzoeken geblokkeerd en kun je dit beleid gebruiken om toegang tot een beperkte lijst met URL's toe te staan. Je kunt dit beleid gebruiken om uitzonderingen voor bepaalde schema's, subdomeinen van andere domeinen, poorten of specifieke paden op te geven met de indeling die wordt gespecificeerd op (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Het meest specifieke filter bepaalt of een URL wordt geblokkeerd of toegestaan. Het beleid URLAllowlist krijgt voorrang op URLBlocklist. Dit beleid is beperkt tot 1000 items.\n\nMet dit beleid kan ook de automatische aanroep door de browser van een externe app worden aangezet die is geregistreerd als protocolhandler voor de vermelde protocollen, zoals tel: of ssh:.\n\nAls je het beleid niet instelt, zijn er geen uitzonderingen toegestaan op URLBlocklist.\n\nVanaf Brave versie 92 wordt dit beleid ook ondersteund in de stand zonder interface.";
URLBlocklist.pfm_title = "Toegang blokkeren voor een lijst met URL's";
URLBlocklist.pfm_description = "Als je het beleid URLBlocklist instelt, worden webpagina's met verboden URL's niet geladen. Beheerders kunnen de lijst met URL-patronen aangeven die moeten worden geblokkeerd. Als je dit beleid niet instelt, worden er geen URL's geblokkeerd in de browser. Er kunnen maximaal 1000 uitzonderingen worden gedefinieerd in URLAllowlist. Bekijk hoe je een URL-patroon opmaakt (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nOpmerking: Dit beleid is niet van toepassing op in-page JavaScript-URL's met dynamisch geladen gegevens. Als je example.com/abc hebt geblokkeerd, kan example.com de pagina nog steeds laden met XMLHTTPRequest. Dit beleid voorkomt ook niet dat webpagina's de URL die in de omnibox wordt getoond, updaten naar een geblokkeerde site via de JavaScript History API.\n\nVanaf versie 73 van Brave kun je javascript://*-URL's blokkeren. Dit heeft alleen gevolgen voor JavaScript dat in de adresbalk wordt ingevoerd of voor bijvoorbeeld bookmarklets.\n\nVanaf Brave versie 92 wordt dit beleid ook ondersteund in de modus zonder interface.\n\nVanaf versie 147 van Brave is het jokerteken * op zichzelf niet van toepassing op interne chrome://-URL's. Als je deze wilt blokkeren, moet je expliciet het patroon chrome://* gebruiken.\n\nOpmerking: Als je interne URL's met chrome://* en chrome-untrusted://* blokkeert, kan dit leiden tot onverwachte fouten of kan de blokkering worden omzeild in speciale gevallen. In plaats van bepaalde interne URL's te blokkeren, kun je beter checken of er specifiekere beleidsregels beschikbaar zijn. Bijvoorbeeld:\n\n- Gebruik CACertificateManagementAllowed in plaats van chrome://settings/certificates te blokkeren.\n\n- Gebruik SystemFeaturesDisableList in plaats van chrome-untrusted://crosh te blokkeren.\n\n- Gebruik een van de beleidsregels DeveloperToolsAvailability, DeveloperToolsAvailabilityAllowlist of DeveloperToolsAvailabilityBlocklist in plaats van devtools://* te blokkeren.";
UpdateOnZeroWindowEnabled.pfm_title = "Bepaalt of de browser automatisch herstart als alle browservensters zijn gesloten";
UpdateOnZeroWindowEnabled.pfm_description = "Bepaalt het gedrag bij automatisch opnieuw opstarten op de achtergrond op macOS als er een beveiligingsupdate in behandeling is en alle browservensters zijn gesloten.\n\nAls je dit beleid instelt op Waar of niet instelt, mag Brave automatisch opnieuw herstart om in behandeling zijnde updates toe te passen als alle browservensters zijn gesloten.\n\nAls je dit beleid instelt op Onwaar, worden automatische herstarten uitgezet als alle browservensters zijn gesloten.";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "Aan URL's gekoppelde, geanonimiseerde gegevens verzamelen";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "Als je het beleid toepast, is de geanonimiseerde gegevensverzameling met URL-sleutel altijd actief. Hiermee worden de URL's van pagina's die de gebruiker bezoekt naar Google gestuurd om zoekopdrachten en browsen te verbeteren.\n\nAls je het beleid niet toepast, wordt de geanonimiseerde gegevensverzameling met URL-sleutel niet aangezet.\n\nAls je dit beleid niet instelt, kunnen gebruikers deze instelling handmatig wijzigen.\n\nIn de Google Chrome OS-kiosk biedt dit beleid niet de optie Gebruiker laten bepalen. Als dit beleid niet is ingesteld voor de Google Chrome OS-kiosk, is de geanonimiseerde gegevensverzameling met URL-sleutel altijd actief.\nAls dit beleid is ingesteld voor de Google Chrome OS-kiosk, wordt de verzameling van URL-sleutelstatistieken voor kiosk-apps aangezet.";
UserDataDir.pfm_title = "Gegevensdirectory voor gebruiker instellen";
UserDataDir.pfm_description = "Hiermee wordt de directory geconfigureerd die Brave gebruikt voor het opslaan van gebruikersgegevens.\n\nAls je dit beleid instelt, gebruikt Brave deze directory, ongeacht of de gebruiker de flag '--user-data-dir' heeft opgegeven. Als je gegevensverlies of andere onverwachte fouten wilt voorkomen, moet je dit beleid niet instellen op een directory die wordt gebruikt voor andere doeleinden, omdat Brave de content ervan beheert.\n\nGa naar https://support.google.com/chrome/a?p=Supported_directory_variables voor een lijst met variabelen die je kunt gebruiken.\n\nAls dit beleid niet wordt ingesteld, wordt het standaard profielpad gebruikt. De gebruiker kan dit overschrijven met de opdrachtregelflag '--user-data-dir'.";
UserDataSnapshotRetentionLimit.pfm_title = "Beperkt het aantal momentopnamen van gebruikersgegevens dat wordt bewaard voor gebruik bij een noodrollback.";
UserDataSnapshotRetentionLimit.pfm_description = "Na elke grote versie-update maakt Chrome een momentopname van bepaalde gedeelten van de browsegegevens van de gebruiker. Deze momentopname kan worden gebruikt voor een latere noodrollback van de versie. Als er een noodrollback wordt uitgevoerd naar een versie waarvoor een gebruiker een bijbehorende momentopname heeft, worden de gegevens in de momentopname hersteld. Zo kunnen gebruikers instellingen als bookmarks en gegevens voor automatisch invullen behouden.\n\nAls dit beleid niet is ingesteld, wordt de standaardwaarde 3 gebruikt.\n\nAls het beleid is ingesteld, worden oude momentopnamen verwijderd als dat nodig is om aan de limiet te voldoen. Als het beleid is ingesteld op 0, worden er geen momentopnamen gemaakt.";
UserFeedbackAllowed.pfm_title = "Gebruikersfeedback toestaan";
UserFeedbackAllowed.pfm_description = "Als je het beleid toepast of niet instelt, kunnen gebruikers feedback naar Google sturen via Menu > Hulp > Een probleem melden of via een toetscombinatie.\n\nAls je het beleid niet toepast, kunnen gebruikers geen feedback naar Google sturen.";
VideoCaptureAllowed.pfm_title = "Het opnemen van video's toestaan of weigeren";
VideoCaptureAllowed.pfm_description = "Als je het beleid toepast of niet instelt, wordt gebruikers in een prompt om toegang tot video-opnamen gevraagd, met uitzondering van de URL's die zijn ingesteld in de lijst VideoCaptureAllowedUrls.\n\nAls je het beleid niet toepast, worden prompts uitgezet en zijn video-opnamen alleen beschikbaar voor URL's die zijn ingesteld in de lijst VideoCaptureAllowedUrls.\n\nOpmerking: Het beleid is van invloed op alle video-invoer (en niet alleen op de ingebouwde camera).";
VideoCaptureAllowedUrls.pfm_title = "URL's die zonder prompt toegang krijgen tot apparaten voor het vastleggen van video";
VideoCaptureAllowedUrls.pfm_description = "Als je het beleid instelt, specificeer je de lijst met URL's waarvan de patronen worden vergeleken met de beveiligingsoorsprong van de aanvragende URL. Bij een overeenkomst wordt zonder prompt toegang gegeven tot apparaten voor video-opnamen.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige url-patronen. Houd er wel rekening mee dat het patroon *, dat overeenkomt met elke URL, niet wordt ondersteund door dit beleid.";
VoiceTypingSettings.pfm_title = "Instellingen voor Praten om te typen";
VoiceTypingSettings.pfm_description = "0 - Sta Praten om te typen toe.\n1 - Sta Praten om te typen toe zonder gegevensverzameling.\n2 - Sta Praten om te typen niet toe.\nPraten om te typen is een AI-gestuurde functie waarmee gebruikers tekst kunnen invoeren en bewerken met hun stem. De functie wordt mogelijk gemaakt door generatieve AI-modellen die transcriptie en opmaak van hoge kwaliteit bieden.\n\n0 = Hiermee wordt toegestaan dat de functie wordt gebruikt en dat Google relevante gegevens gebruikt om de AI-modellen te verbeteren. Relevante gegevens kunnen prompts, invoer, uitvoer, bronmateriaal en geschreven feedback zijn, afhankelijk van de functie. De gegevens kunnen ook door mensen worden beoordeeld om AI-modellen te verbeteren. 0 is de standaardwaarde, behalve zoals hieronder aangegeven.\n\n1 = Hiermee wordt toegestaan dat de functie wordt gebruikt, maar wordt niet toegestaan dat Google modellen verbetert met content van gebruikers (waaronder prompts, invoer, uitvoer, bronmateriaal en geschreven feedback). 1 is de standaardwaarde voor zakelijke gebruikers die worden beheerd via Google Admin console en voor onderwijsaccounts die worden beheerd via Google Workspace.\n\n2 = Hiermee wordt de functie niet toegestaan.\n\nAls je het beleid niet instelt, wordt het gedrag bepaald door het beleid GenAiDefaultSettings.\n\nGa naar https://support.google.com/chrome/a?p=generative_ai_settings voor meer informatie over gegevensverwerking voor generatieve AI-functies.";
WPADQuickCheckEnabled.pfm_title = "WPAD-optimalisatie aanzetten";
WPADQuickCheckEnabled.pfm_description = "Als je het beleid toepast of niet instelt, staat WPAD-optimalisatie (Web Proxy Auto-Discovery) aan in Brave.\n\nAls je het beleid niet toepast, staat WPAD-optimalisatie uit, waardoor Brave langer moet wachten op DNS-gebaseerde WPAD-servers.\n\nOngeacht of dit beleid is ingesteld, kan de gebruiker de instelling voor WPAD-optimalisatie niet wijzigen.";
WarnBeforeQuittingEnabled.pfm_title = "Een waarschuwingsdialoogvenster tonen als de gebruiker probeert de browser te sluiten";
WarnBeforeQuittingEnabled.pfm_description = "Beheert het dialoogvenster Melding voor sluiten (⌘Q) als de gebruiker probeert de browser te sluiten.\n\nAls dit beleid wordt toegepast of niet is ingesteld, wordt een waarschuwingsdialoogvenster getoond als de gebruiker probeert de browser te sluiten.\n\nAls dit beleid niet wordt toegepast, wordt er geen waarschuwingsdialoogvenster getoond als de gebruiker probeert de browser te sluiten.";
WebAppInstallByUserEnabled.pfm_title = "Installatie van web-apps door gebruikers vanuit browser aanzetten";
WebAppInstallByUserEnabled.pfm_description = "Met dit beleid wordt bepaald of gebruikers web-apps kunnen installeren via de browser.\nAls je dit beleid toepast of niet instelt, kunnen gebruikers web-apps installeren via de browser.\nAls je dit beleid niet toepast, kunnen gebruikers geen web-apps installeren via de browser en wordt het gegevenstype Apps uitgesloten van synchronisatie voor Chrome Sync.\nDit beleid ondersteunt geen dynamische vernieuwing. Wijzigingen, zoals instellingen aan- of uitzetten of instellingen verwijderen, worden pas van kracht nadat de browser opnieuw is opgestart.\nDit beleid heeft geen invloed op het beleid WebAppInstallForceList.";
WebAppInstallForceList.pfm_title = "URL's voor web-apps die op de achtergrond worden geïnstalleerd.";
WebAppInstallForceList.pfm_description = "Als je het beleid instelt, wordt een lijst met web-apps gespecificeerd die op de achtergrond worden geïnstalleerd zonder interactie met de gebruiker en die niet kunnen worden verwijderd of uitgezet door gebruikers.\n\nElk lijstitem van het beleid is een object met een verplicht lid:\nurl (de URL van de web-app die moet worden geïnstalleerd)\n\nen 6 optionele leden:\n- default_launch_container (voor hoe de web-app wordt geopend: de standaardinstelling is een nieuw tabblad)\n\n- create_desktop_shortcut (True als je Linux- en Microsoft® Windows®-snelkoppelingen wilt maken).\n\n- fallback_app_name (Vanaf versie 90 van Brave kun je de app-naam overschrijven als het geen progressive web-app (PWA) is, of kun je de tijdelijk geïnstalleerde app-naam overschrijven als het een PWA is, maar verificatie vereist is voordat de installatie kan worden afgerond. Als zowel custom_name als fallback_app_name zijn verstrekt, wordt die laatste genegeerd.)\n\n- custom_name\n(Vanaf versie 99 voor Google Chrome OS en versie 112 voor alle andere desktopbesturingssystemen kun je de app-naam definitief overschrijven voor alle web-apps en PWA's.)\n\n- custom_icon\n(Vanaf versie 99 voor Google Chrome OS en versie 112 voor alle andere desktopbesturingssystemen kun je het app-icoon van geïnstalleerde apps overschrijven. De iconen moeten vierkant zijn, met een maximale grootte van 1 MB en een van de volgende indelingen hebben: jpeg, png, gif, webp, ico.\nDe hash-waarde moet de SHA256-hash van het icoonbestand zijn. De url moet toegankelijk zijn zonder verificatie om te zorgen dat het icoon kan worden gebruikt bij installatie van de app.)\n\n- install_as_shortcut\n(Vanaf versie 107 voor Brave). Als je dit beleid toepast, wordt de aangegeven url geïnstalleerd als snelkoppeling, alsof je dit doet via de optie Snelkoppeling maken\nin de GUI van de desktopbrowser.\nHoud er rekening mee dat als het manifest in url wordt gewijzigd, de URL niet wordt geüpdatet als deze is geïnstalleerd als snelkoppeling.\nAls je dit beleid niet toepast of niet instelt, wordt de web-app op de aangegeven url normaal geïnstalleerd.\n\nBekijk PinnedLauncherApps voor het vastzetten van apps op de Google Chrome OS-plank.\nGa naar https://chromeenterprise.google/policies/?policy=WebAppInstallForceList voor meer informatie over schema en indeling.";
WebAppSettings.pfm_title = "Instellingen voor beheer van web-apps";
WebAppSettings.pfm_description = "Met dit beleid kan een beheerder instellingen voor geïnstalleerde web-apps aangeven. Dit beleid wijst een web-app-ID toe aan de specifieke instelling. Met de speciale ID * kan een standaardconfiguratie worden ingesteld die van toepassing is op alle web-apps waarvoor geen aangepaste configuratie is ingesteld in dit beleid.\n\nHet veld manifest_id is de manifest-ID voor de web-app. Zie https://developer.chrome.com/blog/pwa-manifest-id/ voor instructies om de manifest-ID voor een geïnstalleerde web-app te bepalen.\nHet veld run_on_os_login geeft aan of een web-app kan worden uitgevoerd tijdens de OS-login. Als dit veld is ingesteld op blocked, wordt de web-app niet uitgevoerd tijdens de OS-login en kan de gebruiker dit later niet aanzetten. Als dit veld is ingesteld op run_windowed, wordt de web-app uitgevoerd tijdens de OS-login en kan de gebruiker dit later niet uitzetten. Als dit veld is ingesteld op allowed, kan de gebruiker instellen dat de web-app wordt uitgevoerd tijdens de OS-login. De standaardconfiguratie staat alleen de waarden allowed en blocked toe.\n(Sinds versie 117) Het veld prevent_close_after_run_on_os_login geeft aan of het sluiten van een web-app op een bepaalde manier wordt voorkomen (bijvoorbeeld door de gebruiker, taakbeheer, web-API's). Dit gedrag kan alleen worden aangezet als run_on_os_login is ingesteld op run_windowed. Als de app al actief was, wordt deze property pas van kracht nadat de app opnieuw is opgestart. Als dit veld niet is gedefinieerd, kunnen gebruikers apps sluiten.\n(Sinds versie 118) Het veld force_unregister_os_integration geeft aan of alle OS-integratie voor een web-app (zoals snelkoppelingen, bestandshandlers, protocolhandlers) wel of niet wordt verwijderd. Als er al een app actief is, wordt deze property van kracht nadat de app opnieuw is opgestart. Wees voorzichtig bij het gebruik, omdat hierdoor elke OS-integratie kan worden overschreven die automatisch wordt ingesteld tijdens het opstarten van het systeem met web-apps. Werkt op dit moment alleen op Windows-, Mac- en Linux-platforms.\nGa naar https://chromeenterprise.google/policies/?policy=WebAppSettings voor meer informatie over schema en indeling.";
WebAudioOutputBufferingEnabled.pfm_title = "Aanpasbare buffering voor Web Audio aanzetten";
WebAudioOutputBufferingEnabled.pfm_description = "Met dit beleid wordt bepaald of de browser aanpasbare buffering voor Web Audio gebruikt. Dit kan audioproblemen verminderen, maar de vertraging met een variabele hoeveelheid verhogen.\n\nAls je het beleid toepast, wordt aanpasbare buffering altijd gebruikt.\n\nAls je het beleid niet toepast of niet instelt, kan het startproces van de browserfunctie beslissen of aanpasbare buffering wordt gebruikt.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "Toegestane oorsprongen voor WebAuthn-verzoeken via een proxy vanuit Remote Desktop-apps.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "Een lijst met oorsprongen van Remote Desktop-client-apps die WebAuthn API-verzoeken kunnen uitvoeren die afkomstig zijn van een browsesessie op een externe host.\n\nElke oorsprong die is ingesteld in dit beleid, kan WebAuthn-verzoeken indienen voor Relying Party-ID's (RP-ID's) die normaal gesproken niet kunnen worden geclaimd.\n\nAlleen geldige HTTPS-oorsprongen zijn toegestaan. Jokertekens worden niet ondersteund.\nOngeldige vermeldingen worden genegeerd.\n\nDit beleid geldt alleen voor aangesloten gebruikers.";
WebHidAllowAllDevicesForUrls.pfm_title = "Automatisch rechten aan sites geven om verbinding te maken met elk HID-apparaat.";
WebHidAllowAllDevicesForUrls.pfm_description = "Als je dit beleid instelt, kun je een lijst met sites maken die automatisch toestemming krijgen voor toegang tot alle beschikbare apparaten.\n\nDe URL's moeten geldig zijn, anders wordt het beleid genegeerd. Er wordt alleen gekeken naar de oorsprong (schema, host en poort) van de URL.\n\nVoor Chrome OS geldt dit beleid alleen voor aangesloten gebruikers.\n\nDit beleid overschrijft DefaultWebHidGuardSetting, WebHidAskForUrls, WebHidBlockedForUrls en de voorkeuren van de gebruiker.";
WebHidAllowDevicesForUrls.pfm_title = "Automatisch rechten aan deze sites geven om verbinding te maken met HID-apparaten met de opgegeven leveranciers- en product-ID's.";
WebHidAllowDevicesForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL's maken die aangeven welke sites automatisch toegangsrechten krijgen voor een HID-apparaat met de opgegeven leveranciers- en product-ID's. Het beleid is alleen geldig als elk item in de lijst de velden devices en urls bevat, anders wordt het item genegeerd. Elk item in het veld devices moet een veld vendor_id hebben en kan het een veld product_id hebben. Als je het veld product_id weglaat, wordt een beleid gemaakt dat geschikt is voor elk apparaat met de opgegeven leveranciers-ID. Een item dat het veld product_id heeft zonder het veld vendor_id, is ongeldig en wordt genegeerd.\n\nAls je het beleid niet instelt, is DefaultWebHidGuardSetting van toepassing als dit is ingesteld. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nDe URL's in dit beleid mogen niet conflicteren met de URL's die zijn ingesteld via WebHidBlockedForUrls. Als dit het geval is, krijgt dit beleid voorrang op WebHidBlockedForUrls.\nGa naar https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls voor meer informatie over schema en indeling.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "Automatisch rechten aan deze sites geven om verbinding te maken met HID-apparaten die toplevelcollecties bevatten met het opgegeven HID-gebruik.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL's maken die aangeven welke sites automatisch toegangsrechten krijgen voor een HID-apparaat dat een toplevelcollectie bevat met het opgegeven HID-gebruik. Het beleid is alleen geldig als elk item in de lijst de velden usages en urls bevat. Elk item in het veld usages moet een veld usage_page hebben en kan het een veld usage hebben. Als je het veld usage weglaat, wordt een beleid gemaakt dat geschikt is voor elk apparaat dat een toplevelcollectie bevat met een gebruik van de opgegeven gebruikspagina. Een item dat het veld usage heeft zonder het veld usage_page is ongeldig en wordt genegeerd.\n\nAls je het beleid niet instelt, is DefaultWebHidGuardSetting van toepassing als dit is ingesteld. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nDe URL's in dit beleid mogen niet conflicteren met de URL's die zijn ingesteld via WebHidBlockedForUrls. Als dit het geval is, krijgt dit beleid voorrang op WebHidBlockedForUrls.\nGa naar https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls voor meer informatie over schema en indeling.";
WebHidAskForUrls.pfm_title = "De WebHID API toestaan op deze sites";
WebHidAskForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om aan te geven welke sites gebruikers mogen vragen om toegang tot een HID-apparaat.\n\nAls je het beleid niet instelt, is DefaultWebHidGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van gebruikers.\n\nAls URL-patronen niet overeenkomen met het beleid, krijgen de volgende voorrang, in deze volgorde:\n\n* WebHidBlockedForUrls (als er een overeenkomst is),\n\n* DefaultWebHidGuardSetting (indien ingesteld) of\n\n* de persoonlijke instellingen van gebruikers.\n\nURL-patronen mogen geen conflict vormen met WebHidBlockedForUrls. Geen van beide beleidsregels krijgt voorrang als een URL met beide overeenkomt.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
WebHidBlockedForUrls.pfm_title = "De WebHID API op deze sites blokkeren";
WebHidBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om aan te geven welke sites gebruikers niet mogen vragen om toegang tot een HID-apparaat.\n\nAls je het beleid niet instelt, is DefaultWebHidGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van gebruikers.\n\nAls URL-patronen niet overeenkomen met het beleid, krijgen de volgende voorrang, in deze volgorde:\n\n* WebHidAskForUrls (als er een overeenkomst is),\n\n* DefaultWebHidGuardSetting (indien ingesteld) of\n\n* de persoonlijke instellingen van gebruikers.\n\nURL-patronen mogen geen conflict vormen met WebHidAskForUrls. Geen van beide beleidsregels krijgt voorrang als een URL met beide overeenkomt.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "Verzameling van diagnostische WebRTC-logboeken aanzetten voor specifieke oorsprongen";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "Met dit beleid kun je verzameling van diagnostische logboeken voor WebRTC aanzetten voor specifieke oorsprongen.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige invoerpatronen. * is geen geaccepteerde waarde voor dit beleid. Dit beleid zoekt alleen overeenkomsten op basis van de oorsprong, dus elk pad in het URL-patroon wordt genegeerd. Schema en subdomeinen worden ondersteund.\n\nAls je het beleid instelt, wordt verzameling van diagnostische logboeken aangezet voor de oorsprongen die overeenkomen met de patronen in de lijst.\n\nAls je het beleid niet instelt, wordt de verzameling van diagnostische logboeken standaard uitgezet.";
WebRtcEventLogCollectionAllowed.pfm_title = "Verzameling van WebRTC-gebeurtenislogboeken van Google-services toestaan";
WebRtcEventLogCollectionAllowed.pfm_description = "Als je het beleid toepast, kan Brave WebRTC-gebeurtenislogboeken verzamelen van Google-services (zoals Hangouts Meet) en deze logboeken uploaden naar Google. Deze logboeken bevatten diagnostische informatie voor het oplossen van problemen met audio- of videovergaderingen in Brave. Deze informatie betreft bijvoorbeeld het tijdstip en de grootte van RTP-pakketten, feedback over overbelasting van het netwerk en metadata over de duur en kwaliteit van audio- en videoframes. Deze logboeken bevatten geen audio- of videocontent van de vergadering. Google kan deze logboeken aan de hand van de sessie-ID koppelen aan andere logboeken die door de Google-service zelf zijn verzameld. Het doel hiervan is dat fouten makkelijker kunnen worden opgespoord.\n\nAls je het beleid niet toepast, worden dergelijke logboeken niet verzameld of geüpload.\n\nAls het beleid niet is ingesteld in versies tot en met M76, kan Brave deze logboeken standaard niet verzamelen en uploaden. Vanaf M77 kan Brave deze logboeken standaard verzamelen en uploaden vanuit de meeste profielen waarop cloudgebaseerde bedrijfsbeleidsregels op gebruikersniveau van toepassing zijn. Vanaf M77 tot en met M80 kan Brave deze logboeken ook standaard verzamelen en uploaden vanuit profielen waarop Brave-beheer op locatie van toepassing is.";
WebRtcIPHandling.pfm_title = "IP-verwerking voor WebRTC";
WebRtcIPHandling.pfm_description = "default - WebRTC gebruikt alle beschikbare interfaces als naar het beste pad wordt gezocht.\ndefault_public_and_private_interfaces - WebRTC gebruikt alleen de interface die is verbonden met het openbare internet, maar maakt mogelijk verbinding via IP-adressen die privé zijn.\ndefault_public_interface_only - WebRTC gebruikt alleen de interface die is verbonden met het openbare internet en maakt geen verbinding via IP-adressen die privé zijn.\ndisable_non_proxied_udp - WebRTC gebruikt TCP in de openbare interface en gebruikt alleen UDP als dit wordt ondersteund door een ingestelde proxy.\nDit beleid maakt het mogelijk om te beperken welke IP-adressen en interfaces worden gebruikt door WebRTC als naar de beste beschikbare verbinding wordt gezocht.\n\nGeldige waarden:\n\n* default: WebRTC gebruikt alle beschikbare netwerkinterfaces.\n\n* default_public_and_private_interfaces: WebRTC gebruikt alle openbare en privé-interfaces.\n\n* default_public_interface_only: WebRTC gebruikt alle openbare interfaces, maar geen privé-interfaces.\n\n* disable_non_proxied_udp: WebRTC gebruikt UDP SOCKS-proxy's of valt terug op TCP-proxy's.\n\nAls het beleid niet wordt ingesteld, worden standaard alle beschikbare netwerkinterfaces gebruikt.\n\nZie RFC 8828 artikel 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2) voor een gedetailleerde beschrijving van alle waarden voor verwerking.";
WebRtcIPHandlingUrl.pfm_title = "IP-verwerking per URL voor WebRTC";
WebRtcIPHandlingUrl.pfm_description = "Dit beleid maakt het mogelijk om te beperken welke IP-adressen en interfaces worden gebruikt door WebRTC als naar de beste beschikbare verbinding wordt gezocht voor elk specifieke URL-patroon.\n\nHet beleid accepteert een lijst met paren van URL-patronen en verwerkingstypen. De URL-patronen worden op volgorde gecheckt en de eerste overeenkomst bepaalt welke verwerking door WebRTC voor het domein wordt gebruikt. Als de URL van het huidige document niet overeenkomt met een item, wordt de configuratie gebruikt die is ingesteld door het beleid WebRtcIPHandling.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige invoerpatronen. Jokertekens (*) zijn toegestaan. Dit beleid zoekt alleen overeenkomsten op basis van de oorsprong, dus elk pad in het URL-patroon wordt genegeerd.\n\nGeldige waarden voor verwerking:\n\n* default: WebRTC gebruikt alle netwerkinterfaces.\n\n* default_public_and_private_interfaces: WebRTC gebruikt alle openbare en privé-interfaces.\n\n* default_public_interface_only: WebRTC gebruikt alle openbare interfaces, maar geen privé-interfaces.\n\n* disable_non_proxied_udp: WebRTC gebruikt UDP SOCKS-proxy's of valt terug op TCP-proxy's.\n\nZie RFC 8828 artikel 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2) voor een gedetailleerde beschrijving van alle waarden voor verwerking.\nGa naar https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl voor meer informatie over schema en indeling.";
WebRtcLocalIpsAllowedUrls.pfm_title = "URL's waarvan lokale IP's zichtbaar zijn in WebRTC ICE-kandidaten";
WebRtcLocalIpsAllowedUrls.pfm_description = "Patronen in deze lijst worden vergeleken met de beveiligingsoorsprong van de aanvragende URL.\nAls een overeenkomst wordt gevonden of als chrome://flags/#enable-webrtc-hide-local-ips-with-mdns is Uitgezet, worden de lokale IP-adressen getoond in WebRTC ICE-kandidaten.\nAnders worden lokale IP-adressen verborgen met mDNS-hostnamen.\nHoud er rekening mee dat dit beleid de beveiliging van lokale IP's verzwakt als beheerders dit nodig hebben.";
WebRtcPostQuantumKeyAgreement.pfm_title = "Post-quantum sleutelovereenkomst voor WebRTC aanzetten";
WebRtcPostQuantumKeyAgreement.pfm_description = "Met dit beleid kun je de post-quantum sleutelovereenkomst voor WebRTC beheren.\n\nAls je dit beleid toepast, wordt een post-quantum sleutelovereenkomst aangeboden voor WebRTC.\n\nAls je dit beleid niet toepast, wordt er geen post-quantum sleutelovereenkomst aangeboden voor WebRTC.\n\nAls je dit beleid niet instelt, wordt de waarde ingesteld door het standaard uitrolproces voor post-quantum sleutelovereenkomsten dat wordt aangeboden voor WebRTC.\n\nEen post-quantum sleutelovereenkomst aanbieden is compatibel met eerdere versies. Van bestaande DTLS-peers en netwerkmiddleware wordt verwacht dat ze de nieuwe optie negeren en eerdere opties blijven selecteren.\n\nApparaten waarop DTLS niet correct wordt geïmplementeerd, werken misschien niet goed als de nieuwe optie wordt aangeboden. Ze kunnen bijvoorbeeld de verbinding verbreken als reactie op niet-herkende opties of de resulterende langere berichten. Zulke apparaten zijn niet klaar voor post-quantum verwerking en kunnen de post-quantum overgang van een onderneming verstoren. Als dit gebeurt, moeten beheerders contact opnemen met de leverancier voor een oplossing.\n\nDit beleid is een tijdelijke maatregel en wordt na een aantal mijlpalen verwijderd.";
WebRtcTextLogCollectionAllowed.pfm_title = "Verzamelen van WebRTC-tekstlogboeken van Google-services toestaan";
WebRtcTextLogCollectionAllowed.pfm_description = "Als je het beleid toepast, kan Brave WebRTC-tekstlogboeken ophalen uit Google-services zoals Google Meet en deze uploaden naar Google. Deze logboeken bevatten diagnostische informatie voor het oplossen van problemen met audio- of videovergaderingen in Brave. Deze informatie betreft bijvoorbeeld tekstmetadata die inkomende en uitgaande WebRTC-streams beschrijven, WebRTC-specifieke logboekitems en aanvullende systeemgegevens. Deze logboeken bevatten geen audio- of videocontent van de vergadering.\nAls je het beleid niet toepast, worden deze logboeken niet geüpload naar Google. Logboeken worden nog steeds lokaal op het apparaat van de gebruiker verzameld.\nAls je het beleid niet instelt, kan Brave deze logboeken standaard verzamelen en uploaden.";
WebRtcUdpPortRange.pfm_title = "Het bereik beperken van lokale UDP-poorten die door WebRTC worden gebruikt";
WebRtcUdpPortRange.pfm_description = "Als het beleid is ingesteld, wordt het door WebRTC gebruikte UDP-poortbereik beperkt tot het opgegeven poortinterval (inclusief eindpunten).\n\nAls het beleid niet wordt ingesteld, of als dit wordt ingesteld voor een lege tekenreeks of een ongeldig poortbereik, kan WebRTC gebruikmaken van elke lokale UDP-poort.";
WebUsbAllowDevicesForUrls.pfm_title = "Automatisch rechten verlenen aan deze sites om verbinding te maken met USB-apparaten met de opgegeven leveranciers- en product-ID's.";
WebUsbAllowDevicesForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen opgeven met de sites die automatisch toegangsrechten krijgen voor een USB-apparaat met de opgegeven leveranciers- en product-ID's. Het beleid is alleen geldig als elk item in de lijst de velden devices en urls bevat. Elk item in het veld devices kan een veld vendor_id en een veld product_id hebben. Als je het veld vendor_id weglaat, wordt een beleid gemaakt dat geschikt is voor elk apparaat. Als je het veld product_id weglaat, wordt een beleid gemaakt dat geschikt is voor elk apparaat met de opgegeven leveranciers-ID. Een beleid dat het veld product_id bevat zonder het veld vendor_id, is ongeldig.\n\nHet USB-rechtenmodel geeft de opgegeven URL toegang tot het USB-apparaat als oorsprong op hoofdniveau. Als ingesloten frames toegang tot USB-apparaten nodig hebben, moet de feature-policy-header 'usb' worden gebruikt om toegang te geven. De URL moet geldig zijn, anders wordt het beleid genegeerd.\n\nBeëindigd: Het USB-rechtenmodel ondersteunde specificatie van de aanvragende URL en de insluitings-URL. Deze ondersteuning is beëindigd en geldt alleen nog voor compatibiliteit met eerdere versies: als zowel een aanvragende URL als een insluitings-URL is opgegeven, krijgt de insluitings-URL toegang als oorsprong op hoofdniveau en wordt de aanvragende URL helemaal genegeerd.\n\nDit beleid overschrijft DefaultWebUsbGuardSetting, WebUsbAskForUrls, WebUsbBlockedForUrls en de voorkeuren van de gebruiker.\n\nDit beleid heeft alleen effect op USB-apparaten via de WebUSB API. Zie het beleid SerialAllowUsbDevicesForUrls als je USB-apparaten toegang wilt geven via de Web Serial API.\nGa naar https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls voor meer informatie over schema en indeling.";
WebUsbAskForUrls.pfm_title = "WebUSB toestaan op deze sites";
WebUsbAskForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om op te geven welke sites gebruikers mogen vragen om toegang tot een USB-apparaat.\n\nAls je het beleid niet instelt, is DefaultWebUsbGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van gebruikers.\n\nURL-patronen mogen geen conflict vormen met WebUsbAskForUrls. Geen van beide beleidsregels krijgt voorrang als een URL met beide overeenkomt.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
WebUsbBlockedForUrls.pfm_title = "WebUSB blokkeren op deze sites";
WebUsbBlockedForUrls.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen maken om op te geven welke sites gebruikers niet mogen vragen om toegang tot een USB-apparaat.\n\nAls je het beleid niet instelt, is DefaultWebUsbGuardSetting (indien ingesteld) van toepassing op alle sites. Zo niet, dan gelden de persoonlijke instellingen van de gebruiker.\n\nURL-patronen mogen geen conflict vormen met WebUsbAskForUrls. Geen van beide beleidsregels krijgt voorrang als een URL met beide overeenkomt.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige url-patronen. * is geen geaccepteerde waarde voor dit beleid.";
WindowCaptureAllowedByOrigins.pfm_title = "Venster- en tabbladopname door deze oorsprongen toestaan";
WindowCaptureAllowedByOrigins.pfm_description = "Als je het beleid instelt, kun je een lijst met URL-patronen instellen van sites die venster- en tabbladopname mogen gebruiken.\n\nAls je dit beleid niet instelt, komen sites niet in aanmerking voor een overschrijving op dit opnameniveau.\n\nEr wordt geen rekening gehouden dit beleid als een site overeenkomt met een URL-patroon in een van de volgende beleidsregels: TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nAls een site overeenkomt met een URL-patroon in dit beleid, wordt er geen rekening gehouden met de volgende beleidsregels: ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nGa naar https://chromeenterprise.google/policies/url-patterns/ voor gedetailleerde informatie over geldige url-patronen.  Dit beleid zoekt alleen overeenkomsten op basis van de oorsprong, dus elk pad in het URL-patroon wordt genegeerd.";
WindowManagementAllowedForUrls.pfm_title = "Het recht voor vensterbeheer toestaan voor deze sites";
WindowManagementAllowedForUrls.pfm_description = "Hiermee kun je een lijst met URL-patronen aangeven van sites waarvoor het recht voor vensterbeheer automatisch wordt verleend. Dit biedt sites de mogelijkheid om informatie over de schermen van het apparaat te bekijken en die informatie te gebruiken om vensters te openen en te plaatsen of om een volledig scherm voor bepaalde schermen aan te vragen.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige site-URL-patronen. Jokertekens (*) zijn toegestaan. Dit beleid zoekt alleen overeenkomsten op basis van de herkomst, dus elk pad in het URL-patroon wordt genegeerd.\n\nAls dit beleid niet is ingesteld voor een site, is het beleid van DefaultWindowManagementSetting van toepassing op de site (als dit is ingesteld), anders worden de standaardinstellingen van de browser gevolgd en kunnen gebruikers per site kiezen of ze dit recht willen verlenen.\n\nDit vervangt het beëindigde beleid WindowPlacementAllowedForUrls.";
WindowManagementBlockedForUrls.pfm_title = "Het recht voor vensterbeheer weigeren voor deze sites";
WindowManagementBlockedForUrls.pfm_description = "Hiermee kun je een lijst met URL-patronen aangeven van sites waarvoor het recht voor vensterbeheer automatisch wordt geweigerd. Dit beperkt de mogelijkheid van sites om informatie over de schermen van het apparaat te bekijken en die informatie te gebruiken om vensters te openen en te plaatsen of om een volledig scherm voor bepaalde schermen aan te vragen.\n\nGa naar https://chromeenterprise.google/policies/url-patterns voor gedetailleerde informatie over geldige site-URL-patronen. Jokertekens (*) zijn toegestaan. Dit beleid zoekt alleen overeenkomsten op basis van de herkomst, dus elk pad in het URL-patroon wordt genegeerd.\n\nAls dit beleid niet is ingesteld voor een site, is het beleid van DefaultWindowManagementSetting van toepassing op de site (als dit is ingesteld), anders worden de standaardinstellingen van de browser gevolgd en kunnen gebruikers per site kiezen of ze dit recht willen verlenen.\n\nDit vervangt het beëindigde beleid WindowPlacementBlockedForUrls.";
XSLTEnabled.pfm_title = "De beschikbaarheid van de XSLT-functie bepalen";
XSLTEnabled.pfm_description = "Dit beleid bepaalt de beschikbaarheid van de XSLT-functie (de XSLTProcessor Javascript API en de XSL-verwerkingsinstructie).\nAls je dit beleid toepast, is XSLT beschikbaar, ongeacht de standaardstatus van de functie in de browser.\nAls je dit beleid niet toepast, is XSLT niet beschikbaar, ongeacht de standaardstatus van de functie in de browser.\nAls je dit beleid niet instelt, wordt de beschikbaarheid van XSLT bepaald door de standaardinstellingen van de browser en praktijktests.\nDit beleid is een tijdelijke maatregel en wordt verwijderd in M176.";