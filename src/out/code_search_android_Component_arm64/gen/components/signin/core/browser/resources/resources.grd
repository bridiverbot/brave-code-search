      <include name="IDR_SIGNIN_INTERNALS_SIGNIN_INDEX_CSS" file="${root_gen_dir}/components/signin/core/browser/resources/preprocessed/signin_index.css" resource_path="signin_index.css" use_base_dir="false" type="BINDATA" />
