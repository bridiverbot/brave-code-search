{
    "rustenv": {
        "OUT_DIR": "clang_x64_for_rust_host_build_tools/gen/third_party/rust/libm/v0_2/libm_lib_v0_2_build_script",
        "CLIPPY_CONF_DIR": "../../build/config",
        "CARGO_PKG_AUTHORS": "Alex Crichton <alex@alexcrichton.com>, Amanieu d'Antras <amanieu@gmail.com>, Jorge Aparicio <japaricious@gmail.com>, Trevor Gross <tg@trevorgross.com>",
        "CARGO_PKG_VERSION": "0.2.16",
        "CARGO_PKG_VERSION_MAJOR": "0",
        "CARGO_PKG_VERSION_MINOR": "2",
        "CARGO_PKG_VERSION_PATCH": "16",
        "CARGO_PKG_VERSION_PRE": "",
        "CARGO_PKG_NAME": "libm",
        "CARGO_PKG_DESCRIPTION": "libm in pure Rust",
        "CARGO_PKG_REPOSITORY": "https://github.com/rust-lang/compiler-builtins",
        "CARGO_MANIFEST_DIR": "."
    },
    "rustflags": [
        "-Clinker=../../third_party/llvm-build/Release+Asserts/bin/clang++",
        "../../third_party/rust/chromium_crates_io/vendor/libm-v0_2/build.rs",
        "-Clink-arg=-fPIC",
        "-Clink-arg=--target=x86_64-unknown-linux-gnu",
        "-Clink-arg=-no-canonical-prefixes",
        "-Clink-arg=-Wl,--gc-sections",
        "-Clink-arg=-Wl,-z,defs",
        "-Clink-arg=-Wl,--as-needed",
        "-Clink-arg=-nostdlib++",
        "-Clink-arg=--sysroot=../../build/linux/debian_bullseye_amd64-sysroot",
        "-Clink-arg=--ld-path=../../buildtools/third_party/mold/cipd/mold",
        "-Clink-arg=-Wl,--fatal-warnings",
        "-Clink-arg=-Wl,--build-id",
        "-Clink-arg=-Wl,-z,noexecstack",
        "-Clink-arg=-Wl,-z,relro",
        "-Clink-arg=-Wl,-z,now",
        "-Clink-arg=-Wl,--icf=all",
        "-Clink-arg=-Wl,--undefined-version",
        "-Clink-arg=-rdynamic",
        "-Clink-arg=-pie",
        "-Clink-arg=-Wl,--disable-new-dtags",
        "-Clink-arg=-Werror",
        "@clang_x64_for_rust_host_build_tools/obj/third_party/rust/libm/v0_2/libm_lib_v0_2_build_script.rsp.rust"
    ]
}