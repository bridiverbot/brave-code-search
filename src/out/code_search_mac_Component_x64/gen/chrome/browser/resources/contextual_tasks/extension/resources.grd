      <include name="IDR_CONTEXTUAL_TASKS_EXTENSION_MANIFEST_JSON" file="${root_gen_dir}/chrome/browser/resources/contextual_tasks/extension/preprocessed/manifest.json" resource_path="contextual_tasks_extension/manifest.json" use_base_dir="false" type="BINDATA" />
      <include name="IDR_CONTEXTUAL_TASKS_EXTENSION_TAB_PICKER_HTML" file="${root_gen_dir}/chrome/browser/resources/contextual_tasks/extension/preprocessed/tab_picker.html" resource_path="contextual_tasks_extension/tab_picker.html" use_base_dir="false" type="chrome_html" />
