<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/critical_actions_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/critical_actions_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/critical_actions_resources_map.h"
            type="resource_map_header" />
    <output filename="critical_actions_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_CRITICAL_ACTIONS_INDEX_HTML" file="${root_gen_dir}/chrome/browser/resources/critical_actions/preprocessed/index.html" resource_path="index.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CRITICAL_ACTIONS_INDEX_CSS" file="${root_gen_dir}/chrome/browser/resources/critical_actions/preprocessed/index.css" resource_path="index.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_CRITICAL_ACTIONS_ACTION_ROW_JS" file="${root_gen_dir}/chrome/browser/resources/critical_actions/minified/action_row.js" resource_path="action_row.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CRITICAL_ACTIONS_ACTION_ROW_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/critical_actions/minified/action_row.html.js" resource_path="action_row.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CRITICAL_ACTIONS_APP_JS" file="${root_gen_dir}/chrome/browser/resources/critical_actions/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CRITICAL_ACTIONS_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/critical_actions/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CRITICAL_ACTIONS_ACTION_ROW_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/critical_actions/minified/action_row.css.js" resource_path="action_row.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CRITICAL_ACTIONS_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/critical_actions/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CRITICAL_ACTIONS_CRITICAL_ACTIONS_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/critical_actions/minified/critical_actions.mojom-webui.js" resource_path="critical_actions.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
