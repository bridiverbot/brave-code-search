<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/webui_js_error_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/webui_js_error_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/webui_js_error_resources_map.h"
            type="resource_map_header" />
    <output filename="webui_js_error_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_WEBUI_JS_ERROR_WEBUI_JS_ERROR_HTML" file="${root_gen_dir}/chrome/browser/resources/webui_js_error/preprocessed/webui_js_error.html" resource_path="webui_js_error.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WEBUI_JS_ERROR_WEBUI_JS_ERROR_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/webui_js_error/minified/webui_js_error.rollup.js" resource_path="webui_js_error.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
