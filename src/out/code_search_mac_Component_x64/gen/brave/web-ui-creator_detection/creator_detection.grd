      <include name="IDR_CREATOR_DETECTION_YOUTUBE_BUNDLE_JS" file="${root_gen_dir}/brave/web-ui-creator_detection/youtube.bundle.js" resource_path="youtube.bundle.js" use_base_dir="false" type="BINDATA" />
