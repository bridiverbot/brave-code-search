#ifndef __METAL_SIMDGROUP_MATRIX
#define __METAL_SIMDGROUP_MATRIX


#if defined(__HAVE_SIMDGROUP_MATRIX__)
#pragma METAL internals : enable
namespace metal
{
template <typename T>
struct is_simdgroup_matrix_element : bool_constant<__is_metal_simdgroup_matrix_element(__type_traits_detail::remove_qualifiers_t<T>)>
{
};
template <typename T>
constant constexpr bool is_simdgroup_matrix_element_v = is_simdgroup_matrix_element<T>::value;

namespace __simdgroup_matrix_detail
{
template <typename T, int Cols, int Rows>
struct _simdgroup_matrix_storage_type
{
  typedef vec<T, Cols * Rows> type;
};
template <typename T, int Cols, int Rows>
using _simdgroup_matrix_storage_type_t = typename _simdgroup_matrix_storage_type<T, Cols, Rows>::type;
} // namespace __simdgroup_matrix_detail

namespace __simdgroup_matrix_detail
{
template <typename T, int Cols>
struct _simdgroup_init_diag_impl;
template <typename T>
struct _simdgroup_init_diag_impl<T, 8>
{
  METAL_FUNC _simdgroup_matrix_storage_type_t<T, 8, 8> operator()(T value) const thread
  {
    return __metal_simdgroup_matrix_8x8_init_diag(value);
  }
};
} // namespace __simdgroup_matrix_detail

template <typename T, int Cols, int Rows = Cols>
struct simdgroup_matrix
{
  static_assert(is_simdgroup_matrix_element_v<T>, "invalid element type 'T' for 'simdgroup_matrix'");
  static_assert(Cols == 8 && Rows == 8, "invalid size for 'simdgroup_matrix'");

  using storage_type = __simdgroup_matrix_detail::_simdgroup_matrix_storage_type_t<T, Cols, Rows>;

  METAL_FUNC simdgroup_matrix() thread = default;
  METAL_FUNC simdgroup_matrix(const thread simdgroup_matrix &that) thread = default;

  METAL_FUNC explicit simdgroup_matrix(T value) thread : t(__simdgroup_matrix_detail::_simdgroup_init_diag_impl<T, Cols>()(value))
  {
  }

  METAL_FUNC thread storage_type &thread_elements() thread
  {
    return t;
  }
  METAL_FUNC storage_type thread_elements() const thread
  {
    return t;
  }

  METAL_FUNC thread simdgroup_matrix &operator=(const thread simdgroup_matrix &that) thread = default;

private:
  storage_type t;
};

#if defined(__HAVE_BFLOAT__)
typedef simdgroup_matrix<bfloat, 8, 8> simdgroup_bfloat8x8;
#endif
typedef simdgroup_matrix<half, 8, 8> simdgroup_half8x8;
typedef simdgroup_matrix<float, 8, 8> simdgroup_float8x8;

namespace __simdgroup_matrix_detail
{
template <typename T, int Cols, int Rows>
struct _make_filled_simdgroup_matrix_impl;
template <typename T>
struct _make_filled_simdgroup_matrix_impl<T, 8, 8>
{
  METAL_FUNC simdgroup_matrix<T, 8, 8> operator()(T value) thread
  {
    simdgroup_matrix<T, 8, 8> d;
    d.thread_elements() = __metal_simdgroup_matrix_8x8_init_filled(value);
    return d;
  }
};

template <typename T, int Cols, int Rows, typename U>
constexpr constant bool _valid_make_filled_simdgroup_matrix_v = is_simdgroup_matrix_element_v<T> && Cols == 8 && Rows == 8 && is_convertible_v<U, T>;
} // namespace __simdgroup_matrix_detail

template <typename T, int Cols, int Rows = Cols, typename U>
METAL_FUNC enable_if_t<__simdgroup_matrix_detail::_valid_make_filled_simdgroup_matrix_v<T, Cols, Rows, U>, simdgroup_matrix<T, Cols, Rows>>
make_filled_simdgroup_matrix(U value)
{
  return __simdgroup_matrix_detail::_make_filled_simdgroup_matrix_impl<T, Cols, Rows>()(value);
}

namespace __simdgroup_matrix_detail
{
template <typename T, int Cols, int Rows>
struct _simdgroup_load_impl;
template <typename T>
struct _simdgroup_load_impl<T, 8, 8>
{
  METAL_FUNC void operator()(thread simdgroup_matrix<T, 8, 8> &d, const threadgroup T *src, ulong elements_per_row, ulong2 matrix_origin, bool transpose_matrix) thread
  {
    d.thread_elements() = __metal_simdgroup_matrix_8x8_load(src, elements_per_row, matrix_origin, transpose_matrix, 0);
  }
  METAL_FUNC void operator()(thread simdgroup_matrix<T, 8, 8> &d, const device T *src, ulong elements_per_row, ulong2 matrix_origin, bool transpose_matrix) thread
  {
    d.thread_elements() = __metal_simdgroup_matrix_8x8_load(src, elements_per_row, matrix_origin, transpose_matrix, 0);
  }
};
} // namespace __simdgroup_matrix_detail

template <typename T, int Cols, int Rows>
METAL_FUNC void simdgroup_load(thread simdgroup_matrix<T, Cols, Rows> &d, const threadgroup T *src, ulong elements_per_row = Cols, ulong2 matrix_origin = ulong2(0, 0), bool transpose_matrix = false)
{
  __simdgroup_matrix_detail::_simdgroup_load_impl<T, Cols, Rows>()(d, src, elements_per_row, matrix_origin, transpose_matrix);
}
template <typename T, int Cols, int Rows>
METAL_FUNC void simdgroup_load(thread simdgroup_matrix<T, Cols, Rows> &d, const device T *src, ulong elements_per_row = Cols, ulong2 matrix_origin = ulong2(0, 0), bool transpose_matrix = false)
{
  __simdgroup_matrix_detail::_simdgroup_load_impl<T, Cols, Rows>()(d, src, elements_per_row, matrix_origin, transpose_matrix);
}

namespace __simdgroup_matrix_detail
{
template <typename T, int Cols, int Rows>
struct _simdgroup_store_impl;
template <typename T>
struct _simdgroup_store_impl<T, 8, 8>
{
