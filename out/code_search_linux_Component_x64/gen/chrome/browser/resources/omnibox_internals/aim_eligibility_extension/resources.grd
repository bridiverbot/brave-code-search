<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/aim_eligibility_extension_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/aim_eligibility_extension_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/aim_eligibility_extension_resources_map.h"
            type="resource_map_header" />
    <output filename="aim_eligibility_extension_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <part file="manifest.grdp" />
      <include name="IDR_AIM_ELIGIBILITY_EXTENSION_AIM_ELIGIBILITY_HTML" file="${root_gen_dir}/chrome/browser/resources/omnibox_internals/aim_eligibility_extension/preprocessed/aim_eligibility.html" resource_path="aim_eligibility_extension/aim_eligibility.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_AIM_ELIGIBILITY_EXTENSION_APP_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/omnibox_internals/aim_eligibility_extension/minified/app.rollup.js" resource_path="aim_eligibility_extension/app.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
