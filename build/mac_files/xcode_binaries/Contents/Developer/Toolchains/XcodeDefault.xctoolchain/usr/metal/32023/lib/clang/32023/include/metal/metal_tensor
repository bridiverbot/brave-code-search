// Check stride alignment for implied strides (packed layout)
template <class ElementType, class Extents, size_t AlignBytes,
          class Enable = void>
struct __is_implied_stride_aligned_impl : true_type
{
};
#if defined(__HAVE_PACKED_NUMERIC__)
// For format types with a static extent, check AlignBytes alignment
// for rank >= 2 in non-thread/non-generic address spaces.
template <class ElementType, class Extents, size_t AlignBytes>
struct __is_implied_stride_aligned_impl<ElementType, Extents, AlignBytes,
  enable_if_t<__is_tensor_element_format_v<ElementType> &&
              (Extents::static_extent(0) != dynamic_extent) &&
              (Extents::rank() >= 2) &&
              !__is_thread_addrspace_v<ElementType>
#if defined(__HAVE_GENERIC_ADDRESS_SPACE__)
              && !__is_generic_addrspace_v<ElementType>
#endif
              >>
{
private:
  static constexpr constant size_t bitsize =
      __packed_numeric_detail::_numeric_format_bits_v<ElementType>;
  static constexpr constant size_t align_bitsize = AlignBytes * 8;
public:
  static constexpr constant bool value =
      (((Extents::static_extent(0) % align_bitsize) * bitsize) % align_bitsize) == 0;
};
#endif
template <class ElementType, class Extents, size_t AlignBytes>
struct __is_implied_stride_aligned
  : __is_implied_stride_aligned_impl<ElementType, Extents, AlignBytes>
{
};
template <class ElementType, class Extents, size_t AlignBytes>
constexpr constant bool __is_implied_stride_aligned_v =
    __is_implied_stride_aligned<ElementType, Extents, AlignBytes>::value;

constexpr bool __is_static_extent_divisible(size_t extent, size_t divisor)
{
  return (extent == dynamic_extent) || (extent % divisor == 0);
}

// Check if static extent(0) is a multiple of AlignElements
template <class ElementType, class Extents, size_t AlignElements, class Enable = void>
struct __tensor_extent_type_aligned_impl : true_type
{
};
#if defined(__HAVE_PACKED_NUMERIC__)
// For format types with static extent, check element alignment
template <class ElementType, class Extents, size_t AlignElements>
struct __tensor_extent_type_aligned_impl<ElementType, Extents, AlignElements,
  enable_if_t<__is_tensor_element_format_v<ElementType> &&
              (Extents::static_extent(0) != dynamic_extent)>>
    : bool_constant<__is_static_extent_divisible(Extents::static_extent(0), AlignElements)>
{
};
#endif
template <class ElementType, class Extents, size_t AlignElements>
struct __tensor_extent_type_aligned
  : __tensor_extent_type_aligned_impl<ElementType, Extents, AlignElements>
{
};
template <class ElementType, class Extents, size_t AlignElements>
constexpr constant bool __tensor_extent_type_aligned_v =
    __tensor_extent_type_aligned<ElementType, Extents, AlignElements>::value;

// Check if all static extents are divisible by their corresponding block sizes
template <class Extents, size_t... BlockSizes>
struct __tensor_extent_aligned_blockwise_impl
{
private:
  template <size_t... Is>
  static constexpr bool check_impl(index_sequence<Is...>)
  {
    constexpr size_t block_sizes[] = {BlockSizes...};
    return ((__is_static_extent_divisible(Extents::static_extent(Is), block_sizes[Is])) && ...);
  }

public:
  static constexpr constant bool value = check_impl(make_index_sequence<sizeof...(BlockSizes)>{});
};

template <class Extents, size_t... BlockSizes>
struct __tensor_extent_aligned_blockwise
  : bool_constant<__tensor_extent_aligned_blockwise_impl<Extents, BlockSizes...>::value>
{
};

template <class Extents, size_t... BlockSizes>
constexpr constant bool __tensor_extent_aligned_blockwise_v =
    __tensor_extent_aligned_blockwise<Extents, BlockSizes...>::value;

