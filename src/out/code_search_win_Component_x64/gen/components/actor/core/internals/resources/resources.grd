<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/actor_internals_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/actor_internals_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/actor_internals_resources_map.h"
            type="resource_map_header" />
    <output filename="actor_internals_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_ACTOR_INTERNALS_ACTOR_INTERNALS_CSS" file="${root_gen_dir}/components/actor/core/internals/resources/preprocessed/actor_internals.css" resource_path="actor_internals.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_ACTOR_INTERNALS_ACTOR_INTERNALS_HTML" file="${root_gen_dir}/components/actor/core/internals/resources/preprocessed/actor_internals.html" resource_path="actor_internals.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ACTOR_INTERNALS_ACTOR_INTERNALS_JS" file="${root_gen_dir}/components/actor/core/internals/resources/minified/actor_internals.js" resource_path="actor_internals.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ACTOR_INTERNALS_BROWSER_PROXY_JS" file="${root_gen_dir}/components/actor/core/internals/resources/minified/browser_proxy.js" resource_path="browser_proxy.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ACTOR_INTERNALS_ACTOR_INTERNALS_MOJOM_WEBUI_JS" file="${root_gen_dir}/components/actor/core/internals/resources/minified/actor_internals.mojom-webui.js" resource_path="actor_internals.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
