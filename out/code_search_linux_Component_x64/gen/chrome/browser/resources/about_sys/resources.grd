<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/about_sys_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/about_sys_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/about_sys_resources_map.h"
            type="resource_map_header" />
    <output filename="about_sys_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_ABOUT_SYS_ABOUT_SYS_HTML" file="${root_gen_dir}/chrome/browser/resources/about_sys/preprocessed/about_sys.html" resource_path="about_sys.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ABOUT_SYS_APP_JS" file="${root_gen_dir}/chrome/browser/resources/about_sys/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ABOUT_SYS_BROWSER_PROXY_JS" file="${root_gen_dir}/chrome/browser/resources/about_sys/minified/browser_proxy.js" resource_path="browser_proxy.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ABOUT_SYS_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/about_sys/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ABOUT_SYS_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/about_sys/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
