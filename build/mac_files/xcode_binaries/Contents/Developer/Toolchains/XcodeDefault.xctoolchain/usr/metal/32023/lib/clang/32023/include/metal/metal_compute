#if defined(__HAVE_CRITICAL_SECTION__)
#if defined(__HAVE_GENERIC_ADDRESS_SPACE__)
template <typename P, typename B>
METAL_FUNC enable_if_t<is_class_v<remove_reference_t<P>> && is_same_v<decltype(declval<thread P>()()), bool>
                       && is_class_v<remove_reference_t<B>> && is_same_v<decltype(declval<thread B>()()), void>
                       >
critical_section(thread P &&predicate, thread B &&body)
{
  using PT = remove_reference_t<P>;
  using BT = remove_reference_t<B>;
  auto wrap_predicate = [](thread PT *p) { return (*p)(); };
  auto wrap_body = [](thread BT *b) { return (*b)(); };
  __metal_critical_section((thread PT *)&predicate, (bool (*)(thread PT *))wrap_predicate, (thread BT *)&body, (void (*)(thread BT *))wrap_body);
}
#endif
