typedef struct MMR_STREAM_STATS
{
    // Bytes waiting to be sent to the client
    UINT64 bytesBuffered;
    // Bytes already sent to the client
    UINT64 bytesSent;
    // Count of buffers waiting to be sent to the client
    UINT64 buffersBuffered;
    // Count of buffers already sent to the client
    UINT64 buffersSent;
} MMR_STREAM_STATS;

typedef struct MMR_EXTENDED_STATS
{
    UINT32 framesRendered;
    UINT32 framesDropped;
    UINT32 framesCorrupted;
    float framesPerSecond;
    double playbackJitter;
    double totalFrameDelay;
} MMR_EXTENDED_STATS;

[
    object,
    uuid(1af14559-6770-4446-978f-022921af5360),
    pointer_default(unique)
]
interface IMMRStream : IUnknown
{
    // Queues one encoded media buffer for delivery to the remote client.
    // data: Encoded audio or video bytes.
    // dataSize: Number of bytes in data.
    // timestamp: Intended presentation time, in 100-nanosecond units.
    // duration: Intended playback duration, in 100-nanosecond units.
    // isKeyFrame: TRUE if this buffer is independently decodable
    //   (for example, a key frame, IDR frame, or clean point).
    HRESULT AppendBuffer(
        [in, size_is(dataSize)] BYTE* data,
        [in] UINT32 dataSize,
        [in] LONGLONG timestamp,
        [in] LONGLONG duration,
        [in] BOOL isKeyFrame);
    // Signals end of stream to the remote client.  No additional buffers
    // should be appended after this call until the play position is changed.
    // The "ended" event is raised when the client has finished playing all
    // queued buffers on all streams.
    HRESULT EndOfStream();
    // Sets the destination rectangle for video rendering.
    // parent: Parent window that owns the video region. If NULL,
    //   the desktop window is used.
    // x, y: Upper-left corner of the video region, in client coordinates.
    // width, height: Size of the video region, in pixels.
    HRESULT SetVideoRect(HWND parent, UINT32 x, UINT32 y, UINT32 width, UINT32 height);
    // Retrieves stream buffering and transfer statistics.
    // stats: Receives current stream statistics.
    HRESULT GetStats([out] MMR_STREAM_STATS* stats);
};

[
    object,
    uuid(13c7bbd1-6ef4-40a4-81c2-99fa0e8cf028),
    pointer_default(unique)
]
interface IMMREventHandler : IUnknown
{
    // Callback when remoting has been initialized.
    // succeeded: TRUE if remoting was successfully initialized and the client is ready to receive buffers;
    //  FALSE if remoting initialization failed and the caller should fall back to local playback.
    HRESULT OnRemotingInitialized(BOOL succeeded);
    // Callback when buffering state changes on the remote client.
    // buffering: TRUE if the client is buffering and cannot play immediately; FALSE if the client is ready to play.
    HRESULT OnBufferingStateChanged(BOOL buffering);
    // Callback when the remote client hits an error.  The caller should fall back to local playback if this is received.
    // errorMessage: Error message describing the failure.
    // errorCode: If appliciable, error code returned by the failing API.  May be 0/S_OK if no error code was 
    //  associated with the error.
    HRESULT OnError(LPCWSTR errorMessage, HRESULT errorCode);
    // Callback when the remote client's playback time has progressed.
    // currentTime: Current playback position on the client, in 100-nanosecond units.
    HRESULT OnTimeUpdate(LONGLONG currentTime);
    // Callback when the remote client has completed playback by reaching end of stream on all streams.
    HRESULT OnEnded();
    // Callback when the remote client has completed a seek operation.
    HRESULT OnSeeked();
};

[
    object,
    uuid(506ae701-fe5d-41b3-8b9c-d1d6374b38d8),
    pointer_default(unique)
]
interface IMMRResponseHandler : IUnknown
{
    // Callback for raw openscreen protocol messages from the remote client.
    // message: Pointer to the raw message payload.
    // messageSize: Number of bytes in message.
    HRESULT OnResponse([in, size_is(messageSize)] BYTE* message, UINT32 messageSize);
};

[
    object,
    uuid(75d41cbb-a826-45f0-8152-90d0e617cca5),
    pointer_default(unique)
]
interface IMMRSessionOpenscreen : IUnknown
{
    // Creates a stream bound to a caller-provided openscreen stream ID.
    // Use this when the application manages openscreen messaging directly.
    // streamId: Stream identifier to associate with the stream.
    // stream: Receives the created stream interface.
    HRESULT CreateStream(UINT32 streamId, [out] IMMRStream** stream);
    // Registers the handler for raw openscreen responses.
    // handler: Callback interface that receives raw responses.
    HRESULT SetResponseHandler([in, optional] IMMRResponseHandler* handler);
    // Sends a raw openscreen message to the remote client.
    // message: Pointer to the raw openscreen payload.
    // messageSize: Number of bytes in message.
    HRESULT SendRawOpenscreenMessage([in, size_is(messageSize)] BYTE* message, UINT32 messageSize);
};

[
    object,
    uuid(5B9C4B5E-8A4F-4A6C-9D9A-5C7B3D2E8A11),
    pointer_default(unique)
]
interface IMMRSession : IUnknown
{
    // Returns the number of codec MIME entries available through GetSupportedCodec.
    // supportedCodecCount: Receives the number of supported codec entries.
    HRESULT GetSupportedCodecCount([out] UINT32* supportedCodecCount);
    // Returns a client-supported MIME type entry, including codec details.
    // index: Zero-based index in the supported codec list.
    // mimeType: Receives a CoTaskMem-allocated string. Caller must free with CoTaskMemFree.
    HRESULT GetSupportedCodec(UINT32 index, [out] LPWSTR* mimeType);
    // Creates an audio stream with the specified decoder configuration.
    // config: Audio decoder configuration for the stream.
    // extraData: Optional codec-specific initialization data (may be NULL).
    //   extraData may be required for the client codec to decode the stream.
    // extraDataSize: Number of bytes in extraData.
    // stream: Receives the created stream interface.
    HRESULT CreateAudioStream(
        [in] MMR_AUDIO_DECODER_CONFIG config,
        [in, size_is(extraDataSize)] BYTE* extraData,
        UINT32 extraDataSize,
        [out] IMMRStream** stream);
    // Creates a video stream with the specified decoder configuration.
    // config: Video decoder configuration for the stream.
    // extraData: Optional codec-specific initialization data (may be NULL).
    //   extraData may be required for the client codec to decode the stream.
    // extraDataSize: Number of bytes in extraData.
    // stream: Receives the created stream interface.
    HRESULT CreateVideoStream(
        [in] MMR_VIDEO_DECODER_CONFIG config,
        [in, size_is(extraDataSize)] BYTE* extraData,
        UINT32 extraDataSize,
        [out] IMMRStream** stream);
    // Starts remoting for this session after stream creation is complete.
    // No additional streams can be created after this call succeeds.
    HRESULT BeginRemoting();
    // Registers the event handler for media events from this session.
    // handler: Callback interface that receives session events.
    HRESULT SetEventHandler([in, optional] IMMREventHandler* handler);
    // Starts or resumes playback on the remote client.
    HRESULT Play();
    // Pauses playback on the remote client.
    HRESULT Pause();
    // Requests a seek to a new playback position on the remote client.
    // The event handler receives "seeked" after the client confirms the position.
    // timestamp: Target playback position, in 100-nanosecond units.
    HRESULT SetCurrentTime(LONGLONG timestamp);
    // Sets the current playback rate for the session.
    // rate: Playback rate multiplier (for example, 1.0 = normal speed).
    // Takes effect immediately if playback is active.
    HRESULT SetPlaybackRate(double rate);
    // Enables or disables loop playback mode.
    // loop: TRUE to restart from the beginning at end of content;
    //   FALSE to stop at end and emit the "ended" event.
    HRESULT SetLoop(BOOL loop);
    // Sets session volume on the remote client.
    // volume: Attenuation level where 0.0 is silent and 1.0 is full volume.
    HRESULT SetVolume(double volume);
    // Retrieve the most recent extended pipeline statistics reported by the
    // remote sink. Returns zeroed stats if no stats have been received yet.
    HRESULT GetExtendedStats([out] MMR_EXTENDED_STATS* stats);
    // Gets the image that should take the place of the video stream while
    // it is being remoted.  This image should be in screen pixels, rather than
    // logical pixels, as scaling the image may prevent the client from being
    // able to render any overlay correctly.
    // imageData: Buffer that is at least stride * height * 4 bytes in size.  The image is returned in BGRA format.
    // width: Width of the image in screen pixels.
    // height: Height of the image in screen pixels.
    // stride: Number of bytes in a row of the image.  This may be greater than width if the image is padded.
    HRESULT GetVideoReplacementImage([in, size_is(stride * height)] BYTE* imageData, UINT32 width, UINT32 height, UINT32 stride);
};

[
    object,
    uuid(8B1E7C5A-7E6C-4A27-9B3A-0F6C4D2C9A75),
    pointer_default(unique)
]
interface IMMRClient : IUnknown
{
    // Callback indicating a new session was created successfully.
    // session: Newly created session interface, ready for stream setup.
    HRESULT OnSessionCreated([in] IMMRSession* session);
    // Callback indicating session creation failed.
    // errorCode: Failure HRESULT for the create-session request.
    HRESULT OnSessionCreationFailed([in] HRESULT errorCode);
    // Callback indicating the remote client disconnected.
    // Existing session interfaces are no longer valid and must be recreated
    // after reconnection.
    HRESULT OnRemoteClientDisconnected();
    // Callback indicating the remote client is connected and ready for new sessions.
    HRESULT OnRemoteClientConnected();
    // Callback indicating an error has occurred while processing messages
    // in the background.  The redirector and all of its sessions should be
    // considered invalid.  A new redirector and new sessions should be
    // created.
    HRESULT OnAsyncError(HRESULT errorCode);
};

[
    object,
    uuid(9A2C3E74-1F5D-4E5E-8A3B-7C1D4F8B2C90),
    pointer_default(unique)
]
interface IMultimediaRedirector : IUnknown
{
    // Asynchronously creates a multimedia redirection session with a remote client.
    // Success is reported through the IMMRClient provided when this redirector
    // was created by IMultimediaRedirectorFactory.
    // Failure is reported through IMMRClient::OnSessionCreationFailed.
    HRESULT BeginCreateRemoteSession();

    // Starts client-side diagnostic log capture.
    // Captured logs are written to the same location as server logs.
    // Use only for diagnostics because capture can impact performance.
    HRESULT BeginCaptureClientLogs();
    // Stops client-side diagnostic log capture started by BeginCaptureClientLogs.
    HRESULT EndCaptureClientLogs();
};

[
    object,
    uuid(3E7A73B2-4BD0-4E66-BDBB-91EB5E84F4CF),
    pointer_default(unique)
]
interface IMultimediaRedirectorFactory : IUnknown
{
    // Creates a redirector bound to the provided callback interface.
    HRESULT CreateMultimediaRedirector(
        [in] IMMRClient* client,
        [out] IMultimediaRedirector** redirector);
};

cpp_quote("DEFINE_GUID(CLSID_MultimediaRedirectorFactory, 0xcdbeb1db, 0xc3ad, 0x4918, 0xae, 0xd8, 0xbb, 0xd4, 0x7f, 0x75, 0x59, 0x10);")
