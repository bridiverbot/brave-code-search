<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/webui_toolbar_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/webui_toolbar_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/webui_toolbar_resources_map.h"
            type="resource_map_header" />
    <output filename="webui_toolbar_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_WEBUI_TOOLBAR_WEBUI_TOOLBAR_HTML" file="${root_gen_dir}/chrome/browser/resources/webui_toolbar/preprocessed/webui_toolbar.html" resource_path="webui_toolbar.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WEBUI_TOOLBAR_WEBUI_TOOLBAR_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/webui_toolbar/minified/webui_toolbar.rollup.js" resource_path="webui_toolbar.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
