<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/side_panel_comments_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/side_panel_comments_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/side_panel_comments_resources_map.h"
            type="resource_map_header" />
    <output filename="side_panel_comments_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_SIDE_PANEL_COMMENTS_COMMENTS_HTML" file="${root_gen_dir}/chrome/browser/resources/side_panel/comments/preprocessed/comments.html" resource_path="comments.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_SIDE_PANEL_COMMENTS_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/side_panel/comments/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_SIDE_PANEL_COMMENTS_APP_JS" file="${root_gen_dir}/chrome/browser/resources/side_panel/comments/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_SIDE_PANEL_COMMENTS_COMMENTS_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/side_panel/comments/minified/comments.mojom-webui.js" resource_path="comments.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
