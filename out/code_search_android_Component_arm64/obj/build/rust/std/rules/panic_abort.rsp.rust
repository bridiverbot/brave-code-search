--crate-name
panic_abort
--crate-type
rlib
--cfg=backtrace_in_libstd
-Zforce-unstable-if-unmarked
--cap-lints=allow
--edition=2024
-Cforce-unwind-tables=yes
-Crelocation-model=pic
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--color=always
--target=aarch64-linux-android
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
-Zbranch-protection=pac-ret,bti
--cfg
cr_rustc_revision="110108a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-8a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-1-24-14453-ge063be79"
-Copt-level=3
-Cforce-frame-pointers=yes
-Zdwarf-version=5
-Cdebuginfo=1
-Cdebug-assertions
-Zdefault-visibility=hidden
-Dwarnings
--sysroot=local_rustc_sysroot
-Ldependency=local_rustc_sysroot/lib/rustlib/aarch64-linux-android/lib
-Clink-arg=../../third_party/llvm-build/Release+Asserts/lib/clang/24/lib/linux/libclang_rt.builtins-aarch64-android.a
--extern
alloc=local_rustc_sysroot/lib/rustlib/aarch64-linux-android/lib/liballoc_alloc.rlib
--extern
core=local_rustc_sysroot/lib/rustlib/aarch64-linux-android/lib/librustc_std_workspace_core_rustc_std_workspace_core.rlib
--extern
libc=local_rustc_sysroot/lib/rustlib/aarch64-linux-android/lib/liblibc_libc.rlib