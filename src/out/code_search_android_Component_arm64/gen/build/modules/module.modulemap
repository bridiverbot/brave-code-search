module "//build/modules:system" [system] {
// This module contains headers related to the configuration of the library. These headers
// are free of any dependency on the rest of libc++.
module std_config {
  textual header "../../../../../buildtools/third_party/libc++/__config_site"
  textual header "../../../../../third_party/libc++/src/include/__config"
  textual header "../../../../../third_party/libc++/src/include/__configuration/abi.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/attributes.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/availability.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/compiler.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/diagnostic_suppression.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/experimental.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/hardening.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/language.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/namespace.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/platform.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/pstl.h"
  textual header "../../../../../third_party/libc++/src/include/__configuration/utility.h"
  textual header "../../../../../third_party/libc++/src/include/version"
}

module std_core {
  module cstddef {
    module byte         { header "../../../../../third_party/libc++/src/include/__cstddef/byte.h" }
