<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/device_log_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/device_log_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/device_log_resources_map.h"
            type="resource_map_header" />
    <output filename="device_log_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_DEVICE_LOG_DEVICE_LOG_UI_HTML" file="${root_gen_dir}/chrome/browser/resources/device_log/preprocessed/device_log_ui.html" resource_path="device_log_ui.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DEVICE_LOG_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/device_log/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DEVICE_LOG_APP_JS" file="${root_gen_dir}/chrome/browser/resources/device_log/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DEVICE_LOG_BROWSER_PROXY_JS" file="${root_gen_dir}/chrome/browser/resources/device_log/minified/browser_proxy.js" resource_path="browser_proxy.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DEVICE_LOG_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/device_log/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
