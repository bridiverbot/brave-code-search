/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Brave 환경설정";
AIModeSettings.pfm_title = "주소 표시줄과 새 탭 페이지 검색창에 표시되는 Google AI 모드 통합 설정입니다.";
AIModeSettings.pfm_description = "0 - AI 모드 통합을 허용합니다.\n1 - AI 모드 통합을 허용하지 않습니다.\n이 정책은 주소 표시줄과 새 탭 페이지 검색창에 표시되는 Google AI 모드 통합을 제어합니다.\n\n이 기능에 액세스하려면 Google을 사용자의 기본 검색엔진으로 설정해야 합니다.\n\n0 = 사용자가 이 기능을 사용할 수 있습니다.\n\n1 = 사용자가 이 기능을 사용할 수 없습니다.\n\n정책을 설정하지 않으면 GenAiDefaultSettings 정책에 따라 동작이 결정됩니다.";
AbusiveExperienceInterventionEnforce.pfm_title = "악의적 사용자 환경 개입 시행";
AbusiveExperienceInterventionEnforce.pfm_description = "SafeBrowsingEnabled가 사용 안함으로 설정된 경우 AbusiveExperienceInterventionEnforce를 사용으로 설정하거나 설정하지 않으면 악의적 사용자 환경이 포함된 사이트에서 새 창 또는 탭을 열 수 없습니다.\n\nSafeBrowsingEnabled 또는 AbusiveExperienceInterventionEnforce를 사용 안함으로 설정하면 악의적 사용자 환경이 포함된 사이트가 새 창 또는 탭을 열 수 있습니다.";
AccessCodeCastDeviceDuration.pfm_title = "액세스 코드 또는 QR 코드로 선택된 Cast 기기가 Google Cast 메뉴의 Cast 기기 목록에 표시되는 기간 지정(단위: 초)";
AccessCodeCastDeviceDuration.pfm_description = "이 정책은 이전에 액세스 코드 또는 QR 코드로 선택된 Cast 기기가 Google Cast 메뉴의 Cast 기기 목록에 표시되는 기간을 지정합니다(단위: 초).\n항목이 표시되는 전체 기간은 액세스 코드가 처음 입력되거나 QR 코드가 처음 스캔된 시점부터 시작합니다.\n이 기간 동안 Cast 기기가 Google Cast 메뉴의 Cast 기기 목록에 표시됩니다.\n이 기간이 끝난 후 Cast 기기를 다시 사용하려면 액세스 코드를 다시 입력하거나 QR 코드를 다시 스캔해야 합니다.\n기본적으로 이 기간은 0초이므로 Cast 기기가 Google Cast 메뉴에 표시된 상태로 유지되지 않으며, 새로운 전송 세션을 시작하려면 액세스 코드를 다시 입력하거나 QR 코드를 다시 스캔해야 합니다.\n이 정책은 Cast 기기가 Google Cast 메뉴에 표시되는 기간에만 영향을 미치며, 기간이 만료된 후에도 계속 진행되는 전송 세션에는 아무런 영향을 주지 않습니다.\nAccessCodeCastEnabled 정책이 사용 설정되어 있지 않는 한 이 정책은 아무런 영향을 미치지 않습니다.";
AccessCodeCastEnabled.pfm_title = "사용자가 Google Cast 메뉴에서 액세스 코드 또는 QR 코드를 사용하여 Cast 기기를 선택하도록 허용";
AccessCodeCastEnabled.pfm_description = "이 정책은 사용자가 Cast 기기 화면에 표시되는 액세스 코드 또는 QR 코드를 사용하여 Google Cast 메뉴에 표시되지 않는 Cast 기기에 전송할 수 있도록 하는 Google Cast 메뉴에 옵션을 표시할지 제어합니다.\n기본적으로 사용자가 전송 세션을 시작하려면 액세스 코드를 다시 입력하거나 QR 코드를 다시 스캔해야 합니다. 하지만 AccessCodeCastDeviceDuration 정책이 0이 아닌 값으로 설정된 경우(기본값은 0임) 지정된 기간이 만료되기 전까지 Cast 기기가 사용 가능한 Cast 기기 목록에 계속 표시됩니다.\n정책을 사용으로 설정하면 액세스 코드를 사용하거나 QR 코드를 스캔하여 Cast 기기를 선택하는 옵션이 사용자에게 표시됩니다.\n정책을 사용 안함으로 설정하거나 설정하지 않으면 액세스 코드를 사용하거나 QR 코드를 스캔하여 Cast 기기를 선택하는 옵션이 사용자에게 제공되지 않습니다.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "CORS 프리플라이트에서 Access-Control-Allow-Methods 응답 헤더와 일치 시 강제로 사양을 준수하도록 함";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "이 정책은 요청 메서드가 CORS 프리플라이트에서 Access-Control-Allow-Methods 응답 헤더와 일치할 때 대문자로 표시할지를 제어합니다.\n\n정책이 사용 중지되면 요청 메서드가 대문자로 표기됩니다.\nBrave 108 이전 동작입니다.\n\n정책을 사용 설정하거나 설정하지 않으면 DELETE, GET, HEAD, OPTIONS, POST 또는 PUT와 대소문자 구별 없이 일치하지 않는 한 요청 메서드가 대문자로 표시되지 않습니다.\n이렇게 하면 fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" 응답 헤더가 거부되고 fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\" 응답 헤더가 허용됩니다.\n\n참고: 요청 메서드 \"post\"와 \"put\"는 영향을 받지 않지만 \"patch\"는 영향을 받습니다.\n\n이 정책은 일시적이며 나중에 삭제될 예정입니다.";
AccessibilityImageLabelsEnabled.pfm_title = "Get Image Descriptions from Google 사용";
AccessibilityImageLabelsEnabled.pfm_description = "Get Image Descriptions from Google\n 접근성 기능은 시각장애인 스크린 리더 사용자가\n라벨이 지정되지 않은 웹 이미지에 관한 설명을 들을 수 있도록 지원합니다. 기능을 사용하는 사용자에게는\n익명의 Google 서비스를 통해 라벨이 지정되지 않은 웹 이미지에 관해\n자동으로 생성된 설명을 듣는 옵션이 제공됩니다.\n\n이 기능을 사용하면 이미지의 콘텐츠가 Google 서버로 전송되어\n설명이 생성됩니다. 쿠키 또는 기타 사용자 데이터는\n전송되지 않으며 Google에서 이미지 콘텐츠를 저장하거나 기록하지 않습니다.\n\n정책을 사용 설정하면\nGet Image Descriptions from Google\n기능이 사용됩니다. 단, 스크린 리더 또는 다른 유사한 보조 기술을 사용하는\n사용자에게만 영향을 미칩니다.\n\n사용 안함으로 설정하면 사용자에게 이 기능을 사용할 수 있는 옵션이\n제공되지 않습니다.\n\n설정되지 않으면 사용자가 이 기능의 사용 여부를 선택할 수 있습니다.\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "추가적인 DNS 유형의 DNS 쿼리 허용";
AdditionalDnsQueryTypesEnabled.pfm_description = "이 정책은 Brave에서 안전하지 않은 DNS 요청을 할 때 추가적인 DNS 레코드 유형을 쿼리할지를 결정합니다. 항상 추가적인 DNS 유형을 쿼리할 수 있는 보안 DNS를 통한 DNS 쿼리에는 영향을 주지 않습니다.\n\n정책이 설정되지 않거나 사용 설정되면 A(DNS 유형 1) 및 AAAA(DNS 유형 28)뿐만 아니라 HTTPS(DNS type 65)와 같은 추가적인 유형이 쿼리될 수 있습니다.\n\n이 정책이 Disabled로 설정되면 DNS가 A(DNS 유형 1) 또는 AAAA(DNS 유형 28)에 관해서만 쿼리됩니다.\n\n정책은 일시적인 조치로, 향후 Brave 버전에서는 삭제될 예정입니다. 정책이 삭제되고 나면 Brave에서 항상 추가적인 DNS 유형을 쿼리할 수 있게 됩니다.";
AdsSettingForIntrusiveAdsSites.pfm_title = "방해가 되는 광고가 포함된 사이트의 광고 설정";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - 모든 사이트에서 광고 허용\n2 - 방해가 되는 광고가 포함된 사이트에서 광고 허용 안 함\nSafeBrowsingEnabled가 False로 설정되지 않은 경우 AdsSettingForIntrusiveAdsSites를 1로 설정하거나 설정하지 않으면 모든 사이트에서 광고가 허용됩니다.\n\n정책을 2로 설정하면 사이트에서 방해가 되는 광고를 차단합니다.";
AdvancedProtectionAllowed.pfm_title = "고급 보호 프로그램에 등록된 사용자를 위한 추가 보호 기능 사용";
AdvancedProtectionAllowed.pfm_description = "이 정책은 고급 보호 프로그램에 등록한 사용자에게 추가 보호를 제공할지 결정합니다. 추가 기능 중 일부를 사용하려면 Google과 데이터를 공유해야 합니다. 예를 들어, 고급 보호 사용자가 멀웨어 검사를 위해 다운로드 항목을 Google에 전송할 수 있습니다. 정책을 True로 설정하거나 설정하지 않으면 등록된 사용자에게 추가 보호가 제공됩니다. False로 설정하면 고급 보호 사용자에게 표준 소비자 기능만 제공됩니다.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "모든 HTTP 인증을 허용하는 출처 목록";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "정책을 설정하면 AuthSchemes 정책과 관계없이 Brave에서 지원하는 모든 HTTP 인증 스킴을 허용할 출처가 지정됩니다.\n\nBrave 버전 161부터 이 정책은 대상 서버 출처에만 적용되며 프록시 서버 인증 시도에는 적용되지 않습니다. 프록시 서버에 모든 HTTP 인증 스킴을 허용하려면 대신 AllHttpAuthSchemesAllowedForProxies 정책을 사용하세요. 161 이전 버전에서는 AllHttpAuthSchemesAllowedForProxies 정책이 설정되지 않은 한 이 정책과 일치하는 프록시 서버도 모든 HTTP 인증 스킴을 사용할 수 있습니다.\n\n출처 패턴 형식은 이 형식(https://support.google.com/chrome/a?p=url_blocklist_filter_format)을 따라야 합니다. AllHttpAuthSchemesAllowedForOrigins에 최대 1,000개의 예외를 정의할 수 있습니다.\n호스트 구성요소에 와일드 카드를 사용할 수 있습니다(예: '*:8000'은 포트 8000의 모든 호스트와 일치함). 모든 스킴 또는 모든 포트와 일치시키려면 구성요소를 완전히 생략하세요(예: 'example.com'은 모든 스킴 및 모든 포트와 일치함). 호스트 이름(예: 'example.com')은 하위 도메인과도 일치합니다. 호스트를 정확히 일치시키고 하위 도메인을 제외하려면 호스트 앞에 점을 추가하세요(예: '.example.com'). 모든 출처와 일치시키려면 별표('*') 하나를 사용하세요.";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "모든 HTTP 인증 스킴을 허용하는 프록시 서버 목록";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "정책을 설정하면 AuthSchemes 정책과 관계없이 Brave에서 지원하는 모든 HTTP 인증 스킴을 허용할 프록시 서버가 지정됩니다.\n\n프록시 서버 패턴 형식을 URL 차단 목록 필터 형식(https://support.google.com/chrome/a?p=url_blocklist_filter_format)에 따라 지정합니다. 예외를 최대 1,000개까지 정의할 수 있습니다.\n호스트 구성요소에 와일드 카드를 사용할 수 있습니다(예: '*:8080'은 포트 8080의 모든 프록시와 일치함). 호스트 이름(예: 'proxy.example.com')은 하위 도메인과도 일치합니다. 호스트를 정확히 일치시키고 하위 도메인을 제외하려면 호스트 앞에 점을 추가하세요(예: '.proxy.example.com').\n\n이 정책을 설정하지 않으면 AuthSchemes에 지정된 HTTP 인증 스킴(또는 설정되지 않은 경우 기본 스킴)만 프록시 인증에 지원됩니다.";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Cache-Control: no-store 헤더가 있는 페이지에서 뒤로-앞으로 캐시를 입력하도록 허용";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "이 정책은 Cache-Control: no-store 헤더가 있는 페이지를 뒤로-앞으로 캐시에 저장할 수 있는지를 제어합니다. 이 헤더를 설정하는 웹사이트의 페이지는 뒤로-앞으로 캐시에서 복원되지 않을 수도 있습니다. 페이지에 더 이상 액세스할 수 없더라도 복원 이후에 일부 민감한 정보가 표시될 수 있기 때문입니다.\n\n정책을 사용 설정하거나 설정하지 않으면 캐시 제거가 트리거(예: 사이트에 HTTP 전용 쿠키가 변경된 경우)되지 않는 경우를 제외하고 Cache-Control: no-store 헤더가 있는 페이지가 뒤로-앞으로 캐시에서 복원될 수도 있습니다.\n\n정책을 사용 중지하면 Cache-Control: no-store 헤더가 있는 페이지가 뒤로-앞으로 캐시에 저장되지 않습니다.";
AllowCrossOriginAuthPrompt.pfm_title = "교차 도메인 HTTP 인증 프롬프트";
AllowCrossOriginAuthPrompt.pfm_description = "정책을 사용으로 설정하면 페이지의 서드 파티 이미지에서 인증 프롬프트를 표시할 수 있습니다.\n\n사용 안함으로 설정하거나 설정하지 않으면 서드 파티 이미지에서 인증 프롬프트를 표시할 수 없습니다.\n\n이 정책은 일반적으로 피싱 차단을 위해 사용 중지되어 있습니다.";
AllowDeletingBrowserHistory.pfm_title = "브라우저 및 다운로드 기록을 삭제하도록 설정합니다.";
AllowDeletingBrowserHistory.pfm_description = "이 정책을 사용으로 설정하거나 설정하지 않으면 방문 기록 및 다운로드 기록이 Chrome에서 삭제될 수 있으며 사용자가 이 설정을 변경할 수 없습니다.\n\n정책을 사용 안함으로 설정하면 방문 기록 및 다운로드 기록이 삭제되지 않습니다. 정책을 사용 중지해도 방문 및 다운로드 기록이 반드시 보관되는 것은 아닙니다. 사용자는 기록 데이터베이스 파일을 직접 수정하거나 삭제할 수 있습니다. 또한 브라우저는 언제든지 기록 항목을 자체적으로 만료시키거나 보관처리할 수 있습니다.";
AllowDinosaurEasterEgg.pfm_title = "공룡 부활절 달걀 게임 허용";
AllowDinosaurEasterEgg.pfm_description = "정책을 True로 설정하면 사용자가 공룡 게임을 플레이할 수 있습니다. 정책을 False로 설정하면 기기가 오프라인 상태일 때는 사용자가 공룡 이스터 에그 게임을 플레이할 수 없습니다.\n\n정책을 설정하지 않으면 사용자가 등록한 Google Chrome OS에서 게임을 플레이할 수 없지만 다른 상황에서는 플레이할 수 있습니다.";
AllowFileSelectionDialogs.pfm_title = "파일 선택 대화상자의 호출 허용";
AllowFileSelectionDialogs.pfm_description = "이 정책을 사용 설정하거나 설정하지 않으면 Chrome에서 파일 선택 대화상자를 표시하고, 사용자가 열 수 있게 됩니다.\n\n정책을 사용 중지하면 사용자가 파일 선택 대화상자를 불러오는 작업을 할 때(예: 북마크 가져오기, 파일 업로드, 링크 저장 등)마다 메시지가 표시됩니다. 사용자가 파일 선택 대화상자에서 '취소'를 클릭한 것으로 간주됩니다.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "프록시에 대한 소켓 풀 크기 무작위화 허용";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "소켓 풀 크기 무작위화는 공격자가 결정론적인 용량 한도를 악용해 크로스 사이트 정보를 알아내는 것을 방지하는 보안 메커니즘입니다.\n풀의 용량이 일반적으로 128개의 소켓인 경우 이 메커니즘은 풀을 128~256개 사이에서 무작위로 제한합니다.\n이로 인해 프록시에 연결되는 수가 최대 2배까지 늘어날 수 있지만, 실제 평균 증가량은 약 1.2배 수준에 가깝습니다.\n\n이 기능은 MaxConnectionsPerProxy 및 MaxConnectionsPerProxyForWebSocket의 설정에 영향을 미칩니다.\n해당 설정은 직접적인 상한값을 정의하지 않으며, 실제 상한값은 설정값의 2배가 됩니다(다만 실제 평균값은 앞서 언급했듯이 약 1.2배 수준입니다).\n\n이 기능은 기본적으로 모든 풀에서 사용 설정되어 있지만, 이 정책을 사용하면 프록시 풀에 한해 기능을 사용 중지할 수 있습니다.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "손상된 TLS 인증서가 있는 사이트의 웹 인증 요청을 허용합니다.";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "정책을 사용 설정하면 Brave에서 오류가 있는 TLS 인증서가 있는 웹사이트(안전하지 않은 것으로 간주되는 웹사이트)의 웹 인증 요청을 허용합니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 이러한 요청을 차단하는 기본 동작이 적용됩니다.";
AllowedDomainsForApps.pfm_title = "Google Workspace에 액세스할 수 있는 도메인 정의";
AllowedDomainsForApps.pfm_description = "이 정책을 설정하면 Google Workspace 내 Chrome의 제한된 로그인 기능이 사용 설정되고 사용자가 설정을 변경할 수 없습니다. 사용자는 특정 도메인의 계정을 사용해서만 Gmail 또는 googlemail 계정을 허용하고 도메인 목록에 consumer_accounts를 추가하기 위해 Google 도구에 액세스할 수 있습니다. 이 설정은 보조 계정이 명시적으로 허용된 도메인에 속하지 않은 경우 사용자가 Google 인증이 필요한 관리 대상 기기에 보조 계정을 추가하고 보조 계정으로 로그인하는 것을 차단합니다.\n\n설정을 비워 두거나 설정하지 않으면 사용자가 어느 계정으로든 Google Workspace에 액세스할 수 있습니다.\n\n사용자는 이 설정을 변경하거나 재정의할 수 없습니다.\n\n참고: 정책을 사용하면 https://support.google.com/a/answer/1668854에서 설명된 바와 같이 X-GoogApps-Allowed-Domains 헤더가 모든 google.com 도메인에 대한 HTTP 및 HTTPS 요청에 첨부됩니다.";
AlternateErrorPagesEnabled.pfm_title = "대체 오류 페이지 사용";
AlternateErrorPagesEnabled.pfm_description = "정책을 True로 설정하면 Brave에서 브라우저에 내장된 대체 오류 페이지(예: '페이지를 찾을 수 없습니다')를 사용합니다. 정책을 False로 설정하면 Brave에서 대체 오류 페이지를 사용하지 않습니다.\n\n정책을 설정하면 사용자가 변경할 수 없습니다. 설정하지 않으면 정책이 사용 설정되지만 사용자가 이 설정을 변경할 수 있습니다.";
AlternativeBrowserParameters.pfm_title = "대체 브라우저의 명령줄 매개변수입니다.";
AlternativeBrowserParameters.pfm_description = "이 정책을 문자열 목록으로 설정하면 각 문자열이 별도의 명령줄 매개변수로 대체 브라우저에 전달됩니다. Microsoft® Windows®에서는 매개변수와 공백이 합쳐집니다. macOS 및 Linux®에서는 매개변수에 공백이 포함될 수 있으며 이 경우에도 여전히 하나의 매개변수로 처리됩니다.\n\n매개변수에 ${url}이 있으면 ${url}이 열릴 페이지의 URL로 대체됩니다. 매개변수에 ${url}이 없으면 이 URL이 명령줄 끝에 추가됩니다.\n\n환경 변수는 확장됩니다. Microsoft® Windows®에서는 %ABC%가 ABC 환경 변수의 값으로 대체됩니다. macOS 및 Linux®에서는 ${ABC}가 ABC 환경 변수의 값으로 대체됩니다.\n\n정책을 설정하지 않으면 URL만 명령줄 매개변수로 전달됩니다.";
AlternativeBrowserPath.pfm_title = "구성된 웹사이트를 실행하기 위한 대체 브라우저입니다.";
AlternativeBrowserPath.pfm_description = "정책을 설정하면 대체 브라우저에서 URL을 여는 데 사용할 명령어를 제어할 수 있습니다. 정책은 ${ie}, ${firefox}, ${safari}, ${opera}, ${edge} 중 하나 또는 파일 경로로 설정할 수 있습니다. 정책을 파일 경로로 설정하면 파일이 실행 파일로 사용됩니다. ${ie}은(는) Microsoft® Windows®에서만 사용할 수 있습니다. ${safari} 및 ${edge}은(는) Microsoft® Windows® 및 macOS에서만 사용할 수 있습니다.\n\n정책을 설정하지 않으면 Microsoft® Windows®에서는 Internet Explorer®, macOS에서는 Safari®와 같이 플랫폼별 기본값이 사용됩니다. Linux®에서는 대체 브라우저가 실행되지 않습니다.";
AlwaysOpenPdfExternally.pfm_title = "항상 외부 앱으로 PDF 파일 열기";
AlwaysOpenPdfExternally.pfm_description = "정책을 Enabled로 설정하면 Brave의 내부 PDF 뷰어를 사용 중지하고, PDF 파일을 다운로드 파일로 처리하며, 사용자가 기본 애플리케이션으로 PDF를 열 수 있습니다.\n\n정책을 Disabled로 설정하면 사용자가 PDF 플러그인을 사용 중지하지 않는 한 PDF 플러그인에서 PDF 파일을 엽니다.\n\n정책을 설정하면 사용자가 Brave에서 정책을 변경할 수 없습니다. 설정하지 않으면 사용자가 외부에서 PDF를 열지를 선택할 수 있습니다.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "프로필 유형에 수동 인증을 사용 설정합니다.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - 일반 세션에서만 수동 인증을 사용 설정합니다.\n1 - 시크릿 모드와 일반 세션에서 수동 인증을 사용 설정합니다.\n2 - 게스트 세션과 일반 세션에서 수동 인증을 사용 설정합니다.\n3 - 일반, 시크릿 모드, 게스트 세션에서 수동 인증을 사용 설정합니다.\n이 정책을 설정하면 Brave의 시크릿 모드와 게스트 프로필에서 앰비언트 인증을 허용/금지할 수 있습니다.\n\n앰비언트 인증은 명시적인 사용자 인증 정보가 자격 확인/응답 유형의 NTLM/Kerberos/Negotiate 방식을 통해 제공되지 않는 경우 기본 사용자 인증 정보를 사용하는 HTTP 인증입니다.\n\nRegularOnly(값 0)를 설정하면 일반 세션에만 앰비언트 인증이 허용됩니다. 시크릿 모드와 게스트 세션에서는 앰비언트 인증을 사용할 수 없습니다.\n\nIncognitoAndRegular(값 1)를 설정하면 시크릿 모드와 일반 세션에서 앰비언트 인증이 허용됩니다. 게스트 세션에서는 앰비언트 인증을 사용할 수 없습니다.\n\nGuestAndRegular(값 2)를 설정하면 게스트 세션과 일반 세션에서 앰비언트 인증이 허용됩니다. 시크릿 모드 세션에서는 앰비언트 인증을 사용할 수 없습니다.\n\nAll(값 3)을 설정하면 모든 세션에서 앰비언트 인증이 허용됩니다.\n\n일반 프로필에서는 앰비언트 인증을 항상 사용할 수 있습니다.\n\nBrave 버전 81 이상에서는 정책을 설정하지 않으면 일반 세션에서만 앰비언트 인증이 허용됩니다.";
AudioCaptureAllowed.pfm_title = "오디오 캡처 허용 또는 거부";
AudioCaptureAllowed.pfm_description = "정책을 '사용'으로 설정하거나 설정하지 않으면 AudioCaptureAllowedUrls 목록에 설정된 URL은 제외하고 사용자에게 오디오 캡처 액세스 권한에 대한 메시지가 표시됩니다.\n\n정책을 '사용 안함'으로 설정하면 메시지가 사용 중지되며, AudioCaptureAllowedUrl 목록에 설정된 URL에서만 오디오 캡처를 사용할 수 있습니다.\n\n참고: 이 정책은 내장된 마이크뿐만 아니라 모든 오디오 입력에 적용됩니다.";
AudioCaptureAllowedUrls.pfm_title = "별도 메시지를 표시하지 않고 오디오 캡처 기기에 대한 액세스 권한이 부여되는 URL입니다.";
AudioCaptureAllowedUrls.pfm_description = "정책을 설정하면 URL 목록에 지정한 URL 패턴이 요청 URL의 보안 원본과 비교됩니다. 비교 후 일치 여부가 확인되면 오디오 캡처 기기에 액세스 권한이 부여되며 프롬프트가 표시되지 않습니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns/ 페이지를 참고하세요. 하지만 모든 URL과 일치하는 '*' 패턴은 이 정책에서 지원되지 않습니다.";
AudioSandboxEnabled.pfm_title = "오디오 샌드박스 실행 허용";
AudioSandboxEnabled.pfm_description = "이 정책은 오디오 프로세스 샌드박스를 제어합니다.\n정책이 사용 설정되어 있으면 샌드박스 처리된 오디오 프로세스가 실행됩니다.\n사용 중지되면 샌드박스 처리되지 않은 오디오 프로세스가 실행되며 WebRTC 오디오 처리 모듈이 렌더러 프로세스에서 실행됩니다.\n이 경우 사용자가 샌드박스 처리되지 않은 오디오 하위 시스템 실행과 관련된 보안 위험에 노출됩니다.\n정책이 설정되지 않으면 오디오 샌드박스의 기본 구성이 사용되며, 이 구성은 플랫폼별로 다를 수 있습니다.\n이 정책은 기업에서 샌드박스를 방해하는 보안 소프트웨어 설정을 사용하는 경우 필요에 따라 오디오 샌드박스를 사용 중지할 수 있도록 만들어졌습니다.";
AuthNegotiateDelegateAllowlist.pfm_title = "Kerberos 위임 서버 허용 목록";
AuthNegotiateDelegateAllowlist.pfm_description = "정책을 설정하면 Brave에서 위임할 수 있는 서버가 할당됩니다. 서로 다른 서버 이름은 쉼표로 구분합니다. 와일드 카드(*)를 사용할 수 있습니다.\n\n정책을 설정하지 않으면 서버가 인트라넷으로 감지되더라도 Brave에서 사용자 인증 정보를 위임하지 않습니다.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "KDC 정책을 사용하여 사용자 인증 정보를 위임합니다.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "정책을 사용으로 설정하면 HTTP 인증에서 KDC 정책에 의한 인증을 승인합니다. 즉, Brave에서는 KDC가 서비스 티켓에 OK-AS-DELEGATE를 설정한 경우에만 액세스할 서비스에 사용자 인증 정보를 위임합니다. RFC 5896( https://tools.ietf.org/html/rfc5896.html )을 참고하세요. 서비스는 AuthNegotiateDelegateAllowlist에 의해 허용되어야 합니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 지원되는 플랫폼에서 KDC 정책이 무시되고 AuthNegotiateDelegateAllowlist 정책만 인정됩니다.\n\nMicrosoft® Windows®에서는 KDC 정책이 항상 인정됩니다.";
AuthSchemes.pfm_title = "지원되는 인증 스키마";
AuthSchemes.pfm_description = "정책을 설정하면 Brave에서 지원하는 HTTP 인증 스키마가 지정됩니다.\n\n정책을 설정하지 않으면 스키마 4개가 모두 사용됩니다.\n\n유효한 값:\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\n참고: 서로 다른 값은 쉼표로 구분합니다.";
AuthServerAllowlist.pfm_title = "인증 서버 허용 목록";
AuthServerAllowlist.pfm_description = "정책을 설정하면 통합 인증에 허용되어야 하는 서버가 지정됩니다. 통합 인증은 Brave이 허용 목록에 있는 서버 또는 프록시에서 인증 요청을 받은 경우에만 사용 설정됩니다.\n\n정책을 설정하지 않으면 Brave에서 서버가 인트라넷에 있는지 감지합니다. 그런 다음에만 IWA 요청에 응답합니다. 서버가 인터넷으로 감지되면 Brave에서 서버의 IWA 요청을 무시합니다.\n\n참고: 서로 다른 서버 이름은 쉼표로 구분하세요. 와일드 카드(*)를 사용할 수 있습니다.";
AutoLaunchProtocolsFromOrigins.pfm_title = "사용자에게 메시지를 표시하지 않고 목록에 등록된 출처의 외부 애플리케이션을 실행할 수 있는 프로토콜의 목록 정의";
AutoLaunchProtocolsFromOrigins.pfm_description = "프로토콜 목록과 각 프로토콜에 허용되는 출처 패턴의 목록을 설정하도록 하여 사용자에게 메시지를 표시하지 않고도 외부 애플리케이션이 실행될 수 있도록 합니다. 프로토콜을 목록에 등록할 때 후행 구분자가 포함되어서는 안 됩니다. 따라서 'skype:' 또는 'skype://'가 아닌 'skype'로 표시하세요.\n\n이 정책을 설정하면 프로토콜이 목록에 등록되어 있고 해당 프로토콜을 실행하려는 사이트의 출처가 해당 프로토콜의 allowed_origins 목록에 있는 출처 패턴 중 하나와 일치하는 경우에만 사용자에게 메시지를 표시하지 않고 프로토콜이 외부 애플리케이션을 실행하도록 정책에서 허용합니다. 두 가지 조건 중 하나라도 충족되지 않는 경우 외부 프로토콜이 실행될 때 정책에서 메시지 표시를 생략하지 않습니다.\n\n정책을 설정하지 않으면 기본적으로 어떠한 프로토콜도 메시지 표시 없이는 실행될 수 없습니다. ExternalProtocolDialogShowAlwaysOpenCheckbox 정책이 사용 안 함으로 설정되지 않은 경우 사용자는 프로토콜별/사이트별로 메시지 표시를 선택 해제할 수 있습니다. 이 정책은 사용자가 설정한 프로토콜별/사이트별 메시지 표시 예외에 영향을 미치지 않습니다.\n\n출처 일치 패턴은 'URLBlocklist' 정책(https://support.google.com/chrome/a?p=url_blocklist_filter_format의 설명 참고)과 비슷한 형식을 사용합니다.\n\n하지만 이 정책의 출처 일치 패턴에는 '/path' 또는 '@query' 요소가 포함될 수 없습니다. '/path' 또는 '@query' 요소가 포함된 패턴은 무시됩니다.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins 페이지를 참조하세요.";
AutoOpenAllowedForURLs.pfm_title = "AutoOpenFileTypes가 적용될 수 있는 URL";
AutoOpenAllowedForURLs.pfm_description = "AutoOpenFileTypes가 적용될 URL을 지정하는 URL 목록입니다. 이 정책은 사용자가 설정한 자동으로 열리는 값에 영향을 미치지 않습니다.\n\n정책을 설정하면 URL이 이 집합에 속하고 파일 형식이 AutoOpenFileTypes에 표시된 경우에만 정책에 의해 자동으로 파일이 열립니다. 두 가지 조건 중 하나라도 충족되지 않으면 다운로드한 항목이 정책에 따라 자동으로 열리지 않습니다.\n\n정책을 설정하지 않으면 파일 형식이 AutoOpenFileTypes인 모든 다운로드 항목이 자동으로 열립니다.\n\nURL 패턴 형식은 https://support.google.com/chrome/a?p=url_blocklist_filter_format에 따라 지정되어야 합니다.";
AutoOpenFileTypes.pfm_title = "다운로드 시 자동으로 열려야 하는 파일 유형 목록";
AutoOpenFileTypes.pfm_description = "다운로드 시 자동으로 열려야 하는 파일 형식 목록입니다. 파일 형식을 나열할 때 접두 구분자가 포함되어서는 안 됩니다. '.txt' 대신 'txt'로 표시하세요.\n\n세이프 브라우징 확인이 사용 설정된 경우 자동으로 열려야 하는 형식의 파일에도 적용되며, 파일이 이 확인을 통과하지 못하면 열리지 않습니다.\n\n정책을 설정하지 않은 경우 사용자가 이미 자동으로 열리도록 지정한 파일 형식만 다운로드 시 자동으로 열립니다.\n\nMicrosoft® Windows®의 경우 이 정책은 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.\n\nmacOS의 경우 이 정책은 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.";
AutoSelectCertificateForUrls.pfm_title = "이 사이트에 대해 클라이언트 인증서를 자동으로 선택합니다.";
AutoSelectCertificateForUrls.pfm_description = "정책을 설정하면 Chrome에서 클라이언트 인증서를 자동으로 선택할 사이트를 지정하는 URL 패턴 목록을 작성할 수 있습니다. 값은 각각 { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER } 형식의 문자열화된 JSON 사전 배열이며, 여기에서 $URL_PATTERN은 콘텐츠 설정 패턴입니다. $FILTER는 브라우저에서 자동으로 선택할 클라이언트 인증서를 제한합니다. 필터와 관계없이 서버의 인증서 요청과 일치하는 인증서만 선택됩니다. Android 및 iOS에서 Chrome은 자체적으로 프로비저닝한 클라이언트 인증서만 선택할 수 있으며 운영체제 수준에서 설치된 인증서에는 액세스할 수 없습니다.\n\n$FILTER 섹션 사용의 예:\n\n* $FILTER를 { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } }으로 설정하면 CommonName이 $ISSUER_CN인 인증서에서 발급한 클라이언트 인증서만 선택됩니다.\n\n* $FILTER에 \"ISSUER\" 및 \"SUBJECT\" 섹션이 모두 포함된 경우 두 조건을 모두 만족하는 클라이언트 인증서만 선택됩니다.\n\n* $FILTER에 \"O\" 값이 있는 \"SUBJECT\" 섹션이 포함된 경우 선택되려면 인증서에 지정된 값과 일치하는 조직이 하나 이상 있어야 합니다.\n\n* $FILTER에 \"OU\" 값이 있는 \"SUBJECT\" 섹션이 포함된 경우 선택되려면 인증서에 지정된 값과 일치하는 조직 단위가 하나 이상 있어야 합니다.\n\n* $FILTER를 {}로 설정하면 클라이언트 인증서 선택에 추가로 적용되는 제한은 없습니다. 웹 서버에서 제공한 필터가 계속 적용됩니다.\n\n정책을 설정하지 않으면 어느 사이트에서도 자동으로 인증서가 선택되지 않습니다.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls 페이지를 참조하세요.";
AutofillGenAiSettings.pfm_title = "자동 완성의 생성형 AI 기능 설정";
AutofillGenAiSettings.pfm_description = "0 - 자동 완성에서 생성형 AI 기능을 허용하고 AI 모델을 개선합니다.\n1 - 자동 완성에서 생성형 AI 기능을 허용하되 AI 모델을 개선하지 않습니다.\n2 - 자동 완성에서 생성형 AI 기능을 허용하지 않습니다.\nBrave의 이러한 기능은 생성형 AI 모델을 통해 사용자가 웹에서 양식을 작성하는 데 도움을 줍니다. 이러한 기능을 사용하려면 Brave에서 사용자가 상호작용하는 양식의 구조와 같은 데이터를 수집해야 하며, Gemini로 찾기 및 자동 완성의 경우 사용자가 연결된 Gemini 앱을 검색하기 위해 입력하는 자유 형식 텍스트 쿼리를 수집하고 이 데이터를 생성형 AI 모델을 실행하는 Google 소유의 서버로 전송해야 합니다.\n\n정책을 0(자동 완성에서 생성형 AI 기능 허용 및 AI 모델 개선)으로 설정하면 이 기능의 사용을 허용하여 Google에서 관련 데이터를 활용해 AI 모델을 개선할 수 있습니다. 관련 데이터에는 기능에 따라 프롬프트나 입력, 출력, 소스 자료, 서면 의견이 포함될 수 있습니다. 아래에 명시된 경우를 제외하고 0이 기본값입니다.\n\n정책을 1(자동 완성에서 생성형 AI 기능을 허용하되 AI 모델을 개선하지 않음)로 설정하면 기능을 사용할 수 있지만 Google에서 사용자 콘텐츠(프롬프트, 입력, 출력, 소스 자료, 서면 의견 등)를 활용해 모델을 개선할 수 없습니다. 1은 Google Admin console에서 관리되는 기업 사용자 및 Google Workspace에서 관리되는 Education 계정의 기본값입니다.\n\n정책을 2(자동 완성에서 생성형 AI 기능을 허용하지 않음)로 설정하면 기능을 허용하지 않습니다.\n\n정책을 설정하지 않으면 GenAiDefaultSettings 정책에 따라 동작이 결정됩니다.\n\n자동 완성의 생성형 AI 기능은 다음과 같습니다.\n\n- 스마트 양식 작성: AI를 사용하여 양식의 입력란을 식별하고 분류하므로 더 많은 입력란을 채울 수 있습니다.\n\n- Gemini로 정보 찾기 및 자동 완성: 사용자가 Gemini에 연결한 앱에서 정보를 찾아 양식에 대한 능동적 제안 형태로 또는 사용자가 작성한 질문에 대한 대답 형태로 자동 입력할 수 있습니다.\n\n이 정책은 AutofillPredictionSettings 정책보다 우선 적용되며, 해당 정책은 이 정책이 설정되지 않은 경우에도 적용됩니다. 'Gemini로 정보 찾기 및 자동 완성' 기능을 사용하려면 GeminiSettings 정책도 사용 중지된 상태가 아니어야 합니다.\n\n이 정책은 생성형 AI를 사용하지 않는 자동 완성 기능에는 영향을 미치지 않습니다.\n\n생성형 AI 기능의 데이터 처리에 관한 자세한 내용은 https://support.google.com/chrome/a?p=generative_ai_settings 페이지를 참고하세요.";
AutofillSettings.pfm_title = "특정 사이트의 자동 완성 데이터 유형 차단";
AutofillSettings.pfm_description = "이 정책을 설정하면 특정 URL 패턴에서 차단되는 자동 완성 데이터 유형을 지정할 수 있습니다.\n\n정책은 사전 목록으로 구성됩니다. 각 사전에는 다음이 포함되어야 합니다.\n* 'url_pattern': 기본 프레임의 콘텐츠 설정 URL 패턴(예: 'https://[*.]example.com')입니다.\n* 'blocked_types': 차단할 자동 완성 데이터의 카테고리를 나타내는 문자열 목록입니다.\n\n'blocked_types'에 지원되는 값은 다음과 같습니다.\n* 'contact_info': 연락처 정보 입력 및 저장을 차단합니다.\n* 'payments': 신용카드 및 결제 수단의 자동 입력 및 저장을 차단합니다.\n* 'identity_docs': 신분증(예: 여권, 운전면허증, 국가 신분증)의 자동 입력 및 저장을 차단합니다.\n* 'travel': 여행 정보(예: 항공편 예약, 차량 등록)의 자동 입력 및 저장을 차단합니다.\n* 'shopping': 쇼핑 정보(예: 온라인 주문, 배송)의 자동 입력 및 저장을 차단합니다.\n* 'all': 모든 자동 완성 데이터 유형의 자동 입력 및 저장을 차단합니다.\n\n사이트에서 데이터 유형이 차단되면 해당 사이트에서 추천 생성과 해당 유형의 새 데이터를 저장하고 가져오라는 프롬프트가 모두 사용 중지됩니다.\n\nURL이 목록의 여러 패턴 항목과 일치하면 일치하는 모든 항목의 차단된 유형이 결합(합집합 병합)됩니다. 목록의 잘못된 URL 패턴은 무시됩니다.\n\n이 정책을 설정하지 않으면 도메인별로 자동 완성 데이터 유형이 차단되지 않습니다.\n\n유효한 URL 패턴에 관한 자세한 내용은\nhttps://chromeenterprise.google/policies/url-patterns 페이지를 참고하세요. 와일드 카드*가 지원되며, 이 패턴은 스킴, 포트, 경로와 관계없이 모든 URL과 일치합니다.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=AutofillSettings 페이지를 참조하세요.";
AutomatedPasswordChangeSettings.pfm_title = "자동화된 비밀번호 변경 사용 설정";
AutomatedPasswordChangeSettings.pfm_description = "0 - 기능 사용 및 AI 모델 개선 허용\n1 - AI 모델 개선 없이 기능 사용 허용\n2 - 기능 허용 안함\n이 정책은 Brave의 자동화된 비밀번호 변경 기능 사용 가능 여부를 제어합니다.\n\n사용 설정하면 사용자가 브라우저에서 웹사이트의 비밀번호를 자동으로 변경하려고 시도하는 프로세스를 트리거할 수 있습니다. 이 프로세스는 생성형 AI로 관리되며 새로운 비밀번호는 브라우저의 비밀번호 관리자에 저장됩니다.\n\n0 = 이 기능을 사용하도록 허용하면서 Google에서 관련 데이터를 사용하여 AI 모델을 개선하도록 허용합니다. 관련 데이터에는 기능에 따라 프롬프트나 입력, 출력, 소스 자료, 서면 의견이 포함될 수 있습니다. AI 모델을 개선하기 위해 사람이 데이터를 검토할 수도 있습니다. 아래에 명시된 경우를 제외하고 0이 기본값입니다.\n\n1 = 기능을 사용하도록 허용하되 Google에서 사용자 콘텐츠(프롬프트, 입력, 출력, 소스 자료, 서면 의견 등)를 사용하여 모델을 개선하도록 허용하지 않습니다. 1은 Google 관리 콘솔에서 관리되는 기업 사용자 및 Google Workspace에서 관리되는 Education 계정의 기본값입니다.\n\n2 = 기능을 허용하지 않습니다.\n\n정책을 설정하지 않으면 GenAiDefaultSettings 정책에 따라 동작이 결정됩니다.\n\n생성형 AI 기능의 데이터 처리에 관한 자세한 내용은 https://support.google.com/chrome/a?p=generative_ai_settings 페이지를 참고하세요.";
AutomaticDownloadsAllowedForUrls.pfm_title = "이 사이트에서 자동 다운로드 허용";
AutomaticDownloadsAllowedForUrls.pfm_description = "여러 파일을 자동으로 다운로드하도록 허용되는 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n유효한 URL 패턴에 관한 자세한 내용은 https://chromeenterprise.google/policies/url-patterns/ 페이지를 참고하세요.\n\nURL이 AutomaticDownloadsAllowedForUrls 및 AutomaticDownloadsBlockedForUrls 모두와 일치하면 AutomaticDownloadsBlockedForUrls가 우선 적용됩니다.\n\n이 정책을 설정하지 않으면, DefaultAutomaticDownloadsSetting 정책이 설정되어 있는 경우 모든 사이트에 적용됩니다. 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다.";
AutomaticDownloadsBlockedForUrls.pfm_title = "이 사이트에서 자동 다운로드 차단";
AutomaticDownloadsBlockedForUrls.pfm_description = "여러 파일을 자동으로 다운로드하도록 허용되지 않는 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n유효한 URL 패턴에 관한 자세한 내용은 https://chromeenterprise.google/policies/url-patterns/ 페이지를 참고하세요.\n\nURL이 AutomaticDownloadsAllowedForUrls 및 AutomaticDownloadsBlockedForUrls 모두와 일치하면 AutomaticDownloadsBlockedForUrls가 우선 적용됩니다.\n\n이 정책을 설정하지 않으면, DefaultAutomaticDownloadsSetting 정책이 설정되어 있는 경우 모든 사이트에 적용됩니다. 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다.";
AutomaticFullscreenAllowedForUrls.pfm_title = "다음 사이트에서 자동 전체 화면 허용";
AutomaticFullscreenAllowedForUrls.pfm_description = "보안상의 이유로\nrequestFullscreen() 웹 API에서는\n이전 사용자 동작('일시적 활성화')을 호출해야 하며,\n그러지 않으면 실패합니다. 사용자의 개인 설정을 사용하면\nhttps://chromestatus.com/feature/6218822004768768에 설명된 대로 특정 출처에서 이전 사용자 동작 없이\n이 API를 호출할 수 있습니다.\n\n이 정책은 사용자의 개인 설정을 대체하며 일치하는 출처에서 이전 사용자 동작 없이\nAPI를 호출하도록 허용합니다.\n\n유효한 URL 패턴에 관한 자세한 내용은\nhttps://chromeenterprise.google/policies/url-patterns를 참고하세요.\n와일드 카드(*)를 사용할 수 있습니다.\n\n차단된 정책 패턴 및 허용된 정책 패턴 모두와 일치하는 출처는 차단됩니다.\n정책이나 사용자 설정에 의해 지정되지 않은 출처에서는 API를 호출하려면\n이전 사용자 동작이 필요합니다.";
AutomaticFullscreenBlockedForUrls.pfm_title = "이 사이트에서 자동 전체 화면 차단";
AutomaticFullscreenBlockedForUrls.pfm_description = "보안상의 이유로\nrequestFullscreen() 웹 API에서는\n이전 사용자 동작('일시적 활성화')을 호출해야 하며,\n그러지 않으면 실패합니다. 사용자의 개인 설정을 사용하면 https://chromestatus.com/feature/6218822004768768에 설명된 대로\n특정 출처에서 이전 사용자 동작 없이 이 API를\n호출할 수 있습니다.\n\n이 정책은 사용자의 개인 설정을 대체하며 일치하는 출처에서\n이전 사용자 동작 없이 API를 호출하지 못하도록 차단합니다.\n\n유효한 URL 패턴에 관한 자세한 내용은\nhttps://chromeenterprise.google/policies/url-patterns 페이지를 참고하세요.\n와일드 카드(*)를 사용할 수 있습니다.\n\n차단된 정책 패턴 및 허용된 정책 패턴 모두와 일치하는 출처는 차단됩니다.\n정책이나 사용자 설정에 의해 지정되지 않은 출처에서는 API를 호출하려면\n이전 사용자 동작이 필요합니다.";
AutoplayAllowed.pfm_title = "미디어 자동 재생 허용";
AutoplayAllowed.pfm_description = "정책을 True로 설정하면 Brave의 미디어 자동 재생이 허용됩니다. 정책을 False로 설정하면 Brave의 미디어 자동 재생이 중지됩니다.\n\n이 정책을 설정하지 않으면 Brave에서 미디어를 자동 재생하지 않습니다. 하지만 특정 URL 패턴에 AutoplayAllowlist 정책을 사용하여 이 설정을 변경할 수 있습니다.\n\nBrave이 실행 중일 때 이 정책이 변경되면 정책이 새로 열린 탭에만 적용됩니다.";
AutoplayAllowlist.pfm_title = "URL 패턴의 허용 목록에서 미디어 자동 재생 허용";
AutoplayAllowlist.pfm_description = "정책을 설정하면 Brave에서 동영상이 사용자 동의 없이 오디오 콘텐츠와 함께 자동으로 재생될 수 있습니다. AutoplayAllowed 정책을 True로 설정하면 이 정책은 적용되지 않습니다. AutoplayAllowed 정책을 False로 설정하면 이 정책에 설정된 URL 패턴은 계속해서 재생할 수 있습니다. Brave을 실행하는 동안 이 정책을 변경하면 새로 열린 탭에만 적용됩니다.\n\n유효한 URL 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns/ 페이지를 참고하세요.";
BackgroundTabFreezingEnabled.pfm_title = "백그라운드 탭 고정 사용 설정";
BackgroundTabFreezingEnabled.pfm_description = "Brave에서 CPU 및 메모리를 절약하기 위해 비활성 백그라운드 탭을 중단할지 여부를 제어합니다.\n\n백그라운드 탭 중단이 활성화되면 일정 시간 동안 백그라운드에서 비활성 상태였던 탭이 JavaScript 실행 및 타이머 작업을 일시중지하여 중단됩니다. 중단된 탭은 메모리에 로드된 상태로 유지되며 사용자가 선택하면 즉시 재개됩니다. 오디오 또는 동영상 재생, 화면 또는 카메라 스트림 캡처, 활성 WebRTC 연결 유지, 웹 잠금 유지 등 활성 백그라운드 작업이 있는 탭은 정지할 수 없으며 계속 실행됩니다. TabDiscardingExceptions 정책 또는 사용자의 탭 삭제 예외에 구성된 사이트도 중단에서 제외됩니다.\n\n이 정책을 사용 설정하면 요건을 충족하는 백그라운드 탭에 대해 자동 백그라운드 탭 중단이 사용 설정됩니다. 사용자는 이 설정을 변경할 수 없습니다.\n\n정책을 사용 중지하면 백그라운드 탭이 중단되지 않습니다. 사용자는 이 설정을 변경할 수 없습니다.\n\n정책을 설정하지 않으면 백그라운드 탭 중단이 기본적으로 사용 설정되지만 사용자가 Brave 설정에서 사용 설정하거나 사용 중지할 수 있습니다.";
BasicAuthOverHttpEnabled.pfm_title = "HTTP 연결에 Basic 인증 허용";
BasicAuthOverHttpEnabled.pfm_description = "정책을 사용 설정하거나 설정하지 않으면 비보안 HTTP를 통해 수신된 Basic 인증 시도가 허용됩니다.\n\n사용 중지하면 Basic 인증 스키마를 사용한 비보안 HTTP 요청이 금지되고 보안 HTTPS만 허용됩니다.\n\nAuthSchemes 정책이 설정되어 있고 Basic을 포함하지 않으면 이 정책이 무시되며 Basic이 항상 금지됩니다.";
BatterySaverModeAvailability.pfm_title = "절전 모드 사용 설정";
BatterySaverModeAvailability.pfm_description = "0 - 절전 모드가 사용 중지됩니다.\n1 - 기기의 배터리 전원이 켜져 있고 배터리 잔량이 부족한 경우 절전 모드가 사용 설정됩니다.\n2 - 이 값은 M121부터 지원이 중단됩니다. M121 및 이후 버전에서는 값이 EnabledBelowThreshold로 처리됩니다.\n이 정책은 절전 모드 설정을 사용 또는 사용 중지합니다.\nChrome에서 이 설정을 사용하면 프레임 속도가 제한되어 전력 소비가 줄어듭니다. 정책을 설정하지 않으면 최종 사용자가 chrome://settings/performance에서 이 설정을 제어할 수 있습니다.\nChromeOS에서 이 설정을 사용하면 프레임 속도와 CPU 주파수가 떨어지고 백라이트가 어두워지며 Android가 절전 모드로 전환됩니다. CPU가 여러 개인 기기에서 일부 CPU가 사용 중지됩니다. 수준은 다음과 같습니다. Disabled (0): 절전 모드가 사용 중지됩니다.\nEnabledBelowThreshold (1): 기기의 배터리 전원이 켜져 있고 배터리 잔량이 부족한 경우 절전 모드가 사용 설정됩니다.\nEnabledOnBattery (2): 이 값은 M121부터 지원 중단됩니다. M121부터는 값이 EnabledBelowThreshold로 처리됩니다.\n";
BlockExternalExtensions.pfm_title = "외부 확장 프로그램이 설치되지 못하도록 차단합니다.";
BlockExternalExtensions.pfm_description = "외부 확장 프로그램 설치를 제어합니다.\n\n정책을 사용 설정하면 외부 확장 프로그램이 설치되지 않습니다.\n\n정책을 사용 중지하거나 설정하지 않은 상태로 두면 외부 확장 프로그램을 설치할 수 있습니다.\n\n외부 확장 프로그램 및 설치 관련 문서는 다음 페이지에서 확인하세요. https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions\n\n참고: 이 정책은 확장 프로그램을 지원하는 플랫폼에만 적용됩니다.";
BlockThirdPartyCookies.pfm_title = "제3자 쿠키 차단";
BlockThirdPartyCookies.pfm_description = "정책을 사용으로 설정하면 브라우저의 주소 표시줄에 있는 도메인이 출처가 아닌 웹페이지 요소가 쿠키를 설정할 수 없습니다. 정책을 사용 안함으로 설정하면 이러한 요소가 쿠키를 설정하도록 허용하고 사용자가 설정을 변경할 수 없습니다.\n\n정책을 설정하지 않으면 서드 파티 쿠키가 허용되지만, 사용자가 이 설정을 변경할 수 있습니다.\n\n참고: 이 정책은 서드 파티 쿠키가 차단되고 사이트 수준에서만 허용될 수 있는 시크릿 모드에는 적용되지 않습니다. 사이트 수준에서 쿠키를 허용하려면 CookiesAllowedForUrls 정책을 사용하세요.";
BookmarkBarEnabled.pfm_title = "북마크바 사용";
BookmarkBarEnabled.pfm_description = "정책을 True로 설정하면 Brave에 북마크바가 표시됩니다. 정책을 False로 설정하면 사용자에게 북마크바가 표시되지 않습니다.\n\n정책을 설정하면 사용자가 변경할 수 없습니다. 설정하지 않으면 사용자가 이 기능을 사용할지 결정합니다.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "사용자 관리자에서 사용자 추가 허용";
BrowserAddPersonEnabled.pfm_description = "정책을 true로 설정하거나 설정하지 않으면 Brave 및 Lacros가 사용자 관리자에서 새로운 사용자를 추가하도록 허용합니다.\n\n정책을 false로 설정하면 Brave 및 Lacros가 사용자 관리자에서 새로운 사용자를 추가하도록 허용하지 않습니다.";
BrowserGuestModeEnabled.pfm_title = "브라우저에서 게스트 모드 사용";
BrowserGuestModeEnabled.pfm_description = "이 정책을 사용하거나 설정하지 않으면 Brave에서 게스트 로그인을 사용 설정합니다. 게스트 로그인은 모든 창이 시크릿 모드인 Brave 프로필입니다.\n\n이 정책을 사용 중지하면 Brave에서 게스트 프로필이 시작하도록 허용하지 않습니다.";
BrowserGuestModeEnforced.pfm_title = "브라우저 게스트 모드 시행";
BrowserGuestModeEnforced.pfm_description = "정책을 사용 설정하면 Brave에서 게스트 세션을 실행하고 프로필 로그인을 차단합니다. 게스트 로그인은 창이 시크릿 모드인 Brave 프로필입니다.\n\n정책을 사용 중지하거나, 설정하지 않거나, BrowserGuestModeEnabled를 통해 브라우저 게스트 모드를 사용 중지하면 새로운 프로필과 기존 프로필 사용이 허용됩니다.";
BrowserLabsEnabled.pfm_title = "툴바의 브라우저 실험 아이콘";
BrowserLabsEnabled.pfm_description = "정책을 '사용'으로 설정하거나 설정하지 않으면 사용자가 툴바의 아이콘을 통해 브라우저 실험 기능에 액세스할 수 있습니다.\n\n정책을 '사용 안함'으로 설정하면 브라우저 실험 기능 아이콘이 툴바에서 삭제됩니다.\n\nchrome://flags 및 브라우저 기능을 사용 설정/중지하는 기타 수단은 정책의 '사용' 또는 '사용 안함' 여부와 관계없이 정상적으로 작동합니다.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Google 시간 서비스에 쿼리 허용";
BrowserNetworkTimeQueriesEnabled.pfm_description = "정책을 사용 설정하거나 설정하지 않으면 Brave에서 정확한 타임스탬프를 가져오기 위해 Google 서버에 비정기적으로 쿼리를 전송합니다.\n\n정책을 사용 중지하면 Brave에서 쿼리를 전송하지 않습니다.";
BrowserSignin.pfm_title = "브라우저 로그인 설정";
BrowserSignin.pfm_description = "0 - 브라우저 로그인 사용 중지\n1 - 브라우저 로그인 사용\n2 - 사용자가 브라우저를 사용하려면 로그인하도록 강제\n브라우저의 로그인 동작을 제어하는 정책입니다. 정책을 사용하면 사용자가 자신의 계정으로 Brave에 로그인하고 Brave 동기화와 같은 계정 관련 서비스를 사용하도록 허용할지 결정할 수 있습니다.\n\n정책을 '브라우저 로그인 사용 중지'로 설정하면 사용자가 브라우저에 로그인하여 계정 기반 서비스를 사용할 수 없게 됩니다. 이 경우 Brave 동기화와 같은 브라우저 수준의 기능을 사용할 수 없으며, 이러한 기능이 제공되지도 않습니다. iOS에서는 사용자가 로그인한 상태에서 정책을 '사용 중지'로 설정하면 사용자가 즉시 로그아웃됩니다. 다른 플랫폼에서는 다음번 Brave 실행 시 로그아웃됩니다. 북마크, 비밀번호 등의 로컬 프로필 데이터는 모든 플랫폼에서 유지되며 그대로 사용 가능합니다. Gmail과 같은 Google 웹 서비스에는 계속해서 로그인하고 사용할 수 있습니다.\n\n정책을 '브라우저 로그인 사용'으로 설정하면 사용자가 브라우저에 로그인할 수 있게 됩니다. iOS 외의 모든 플랫폼에서 Gmail과 같은 Google 웹 서비스에 로그인하면 브라우저에도 자동으로 로그인됩니다. 브라우저에 로그인되었다는 것은 사용자의 계정 정보가 브라우저에 보관된다는 의미입니다. 하지만 Brave 동기화가 기본적으로 사용 설정되지는 않습니다. 동기화 기능을 이용하려면 사용자가 별도로 선택해야 합니다. 정책을 사용 설정하면 브라우저 로그인을 허용하는 설정을 사용자가 사용 중지할 수 없습니다. Brave 동기화의 사용 여부를 제어하려면 SyncDisabled 정책을 사용하세요.\n\n정책을 '브라우저 로그인 강제 사용'으로 설정하면 사용자에게 계정 선택 대화상자가 표시되며, 계정을 선택하여 로그인해야 브라우저를 사용할 수 있습니다. 관리 계정의 경우 이 설정을 통해 계정과 관련된 정책을 적용 및 시행할 수 있습니다. BrowserGuestModeEnabled의 기본 설정은 사용 중지입니다. 정책을 사용 설정하면 로그인되지 않은 기존 프로필은 잠겨서 액세스할 수 없게 됩니다. 자세한 내용은 고객센터 도움말(https://support.google.com/chrome/?p=force_browser_signin)을 참고하세요. 이 옵션은 Google Chrome OS 및 Android에서 지원되지 않으며, 사용할 경우 '브라우저 로그인 사용'으로 대체됩니다.\n\n정책을 설정하지 않으면 사용자가 Brave 설정에서 브라우저 로그인을 사용할지 결정하고 필요에 따라 사용할 수 있습니다.";
BrowserSwitcherDelay.pfm_title = "대체 브라우저 실행 전 대기 시간(밀리초)";
BrowserSwitcherDelay.pfm_description = "이 정책을 숫자로 설정하면 Brave에 숫자만큼의 밀리초 동안 메시지가 표시된 후 대체 브라우저가 실행됩니다.\n\n정책을 설정하지 않거나 0으로 설정하면 지정된 URL로 이동하는 즉시 대체 브라우저가 실행됩니다.";
BrowserSwitcherEnabled.pfm_title = "이전 브라우저 지원 기능을 사용 설정합니다.";
BrowserSwitcherEnabled.pfm_description = "이 정책을 사용으로 설정하면 Brave에서 일부 URL을 대체 브라우저(예: Internet Explorer®)에서 열려고 시도합니다. 이 기능은 Legacy Browser support 그룹의 정책을 사용해 설정됩니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 Brave에서 지정된 URL을 대체 브라우저에서 열려고 시도하지 않습니다.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "브라우저 전환을 실행해서는 안 되는 URL이 포함된 XML 파일의 URL입니다.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "이 정책을 유효한 URL로 설정하면 Brave이 URL로부터 사이트 목록을 다운로드하며 BrowserSwitcherUrlGreylist 정책으로 규칙이 설정된 경우와 동일한 규칙을 적용합니다. 이 정책은 Brave과 대체 브라우저가 서로를 열지 못하게 합니다.\n\n정책을 설정하지 않거나 잘못된 URL로 설정하면 Brave에서 브라우저를 전환하지 않는 규칙의 출처로 이 정책을 사용하지 않습니다.\n\n참고: 이 정책은 Internet Explorer®의 SiteList 정책과 동일한 형식의 XML 파일로 연결됩니다. 정책은 XML 파일에서 규칙을 로드하지만 이를 Internet Explorer®와 공유하지는 않습니다. Internet Explorer®의 SiteList 정책(https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)을 자세히 살펴보세요.";
BrowserSwitcherExternalSitelistUrl.pfm_title = "대체 브라우저에서 로드할 URL이 포함된 XML 파일의 URL입니다.";
BrowserSwitcherExternalSitelistUrl.pfm_description = "이 정책을 유효한 URL로 설정하면 Brave이 URL로부터 사이트 목록을 다운로드하며 BrowserSwitcherUrlList 정책으로 규칙이 설정된 경우와 동일한 규칙을 적용합니다.\n\n정책을 설정하지 않거나 유효한 URL로 설정하지 않으면 Brave에서 브라우저를 전환하는 규칙의 출처로 이 정책을 사용하지 않습니다.\n\n참고: 이 정책은 Internet Explorer®의 SiteList 정책과 동일한 형식의 XML 파일로 연결됩니다. 정책은 XML 파일에서 규칙을 로드하지만 이를 Internet Explorer®와 공유하지는 않습니다. Internet Explorer®의 SiteList 정책(https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)을 자세히 살펴보세요.";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Chrome에서 마지막 탭을 열어둠";
BrowserSwitcherKeepLastChromeTab.pfm_description = "이 정책을 사용 설정하거나 설정하지 않은 상태로 두면 대체 브라우저로 전환한 후 Brave에서 최소 1개의 탭을 열어둡니다.\n\n정책을 사용 중지하면 대체 브라우저로 전환한 후 Brave에서 마지막 탭일지라도 모두 닫습니다. 따라서 Brave이 완전히 종료됩니다.";
BrowserSwitcherParsingMode.pfm_title = "사이트 목록 파싱 모드";
BrowserSwitcherParsingMode.pfm_description = "0 - LBS 기본 동작\n1 - Microsoft IE/Edge 엔터프라이즈 모드 사이트 목록과 더 잘 호환됩니다.\n이 정책은 Google Chrome에서 이전 브라우저 지원 기능을 위한 사이트 목록/그레이리스트를 해석하는 방식을 결정합니다. BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl 및 BrowserSwitcherExternalGreylistUrl 정책에 영향을 미칩니다.\n\n'Default'(0)로 설정하거나 설정하지 않을 경우 URL 매칭이 덜 엄격합니다. '/'를 포함하지 않는 규칙은 URL 호스트 이름 어디에서든 하위 문자열을 찾습니다. URL 경로 구성요소 매칭은 대소문자를 구분합니다.\n\n'IESiteListMode'(1)인 경우 URL 매칭이 더 엄격합니다. '/'를 포함하지 않는 규칙은 호스트 이름 끝에서만 매칭합니다. 도메인 이름 경계에도 있어야 합니다. URL 경로 구성요소 매칭은 대소문자를 구분하지 않습니다. Microsoft® Internet Explorer® 및 Microsoft® Edge®에서 더 잘 호환됩니다.\n\n예를 들어 'example.com' 및 'acme.com/abc' 규칙이 있는 경우 'http://example.com/', 'http://subdomain.example.com/', 'http://acme.com/abc'는 파싱 모드와 관계없이 매칭됩니다.\n\n'http://notexample.com/', 'http://example.com.invalid.com/', 'http://example.comabc/'는 'Default' 모드에서만 매칭됩니다.\n\n'http://acme.com/ABC'는 'IESiteListMode'에서만 매칭됩니다.";
BrowserSwitcherUrlGreylist.pfm_title = "브라우저 전환을 실행해서는 안 되는 웹사이트입니다.";
BrowserSwitcherUrlGreylist.pfm_description = "이 정책을 설정하면 브라우저 전환을 실행하지 않을 웹사이트 목록을 제어합니다. 각 항목은 규칙으로 취급됩니다. 규칙이 일치하면 대체 브라우저가 열리지 않습니다. BrowserSwitcherUrlList 정책과 달리 규칙이 양방향으로 적용됩니다. Internet Explorer® 부가기능이 사용 설정되어 있으면 정책이 Internet Explorer®에서 Brave을 통해 이러한 URL을 열어야 하는지도 제어합니다.\n\n정책을 설정하지 않으면 목록에 아무 웹사이트도 추가되지 않습니다.\n\n참고: BrowserSwitcherExternalGreylistUrl 정책을 통해서도 이 목록에 요소를 추가할 수 있습니다.";
BrowserSwitcherUrlList.pfm_title = "대체 브라우저에서 열리는 웹사이트";
BrowserSwitcherUrlList.pfm_description = "이 정책은 대체 브라우저에서 열 웹사이트 목록을 제어합니다. 대체 브라우저에서 열 항목을 대상으로 각 항목이 규칙으로 취급됩니다. Brave은 이러한 규칙을 사용하여 URL을 대체 브라우저에서 열어야 하는지 선택합니다. Internet Explorer® 부가기능이 사용 설정된 경우 규칙이 일치하지 않으면 Internet Explorer®가 Brave으로 다시 전환됩니다. 규칙이 서로 충돌하면 Brave에서 가장 구체적인 규칙을 사용합니다.\n\n정책을 설정하지 않으면 목록에 아무 웹사이트도 추가되지 않습니다.\n\n참고: BrowserSwitcherUseIeSitelist 및 BrowserSwitcherExternalSitelistUrl 정책을 통해서도 이 목록에 요소를 추가할 수 있습니다.";
BrowserThemeColor.pfm_title = "브라우저 테마의 색상 구성";
BrowserThemeColor.pfm_description = "이 정책으로 관리자는 Brave의 테마 색상을 구성할 수 있습니다. 입력 문자열은 '#RRGGBB' 형식의 유효한 16진수 색상이어야 합니다.\n\n정책을 유효한 16진수 색상으로 설정하면 색상을 토대로 테마가 자동 생성되어 브라우저에 적용됩니다. 정책에 의해 설정된 테마는 사용자가 변경할 수 없습니다.\n\n정책을 설정하지 않으면 사용자가 원하는 대로 브라우저의 테마를 변경할 수 있습니다.";
BrowsingDataLifetime.pfm_title = "인터넷 사용 기록 보관 기간 설정";
BrowsingDataLifetime.pfm_description = "Brave의 인터넷 사용 기록 보관 기간 설정을 구성합니다. 이 정책을 통해 관리자가 데이터 유형별로 브라우저에서 데이터를 삭제할 시점을 설정할 수 있습니다. 민감한 고객 데이터를 다루는 고객에게 유용합니다.\n\n경고: 이 정책을 설정하면 로컬 개인 정보가 영향을 받아 영구적으로 삭제될 수 있습니다. 개인 정보가 실수로 삭제되지 않도록 배포하기 전에 설정을 테스트하는 것이 좋습니다.\n\n사용 가능한 데이터 유형은 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings', 'hosted_app_data'입니다. 'download_history' 및 'hosted_app_data'는 Android에서 지원되지 않습니다.\n\n브라우저에서 'time_to_live_in_hours' 값을 경과한 데이터 중 선택된 유형의 데이터를 자동으로 삭제합니다. 설정 가능한 최솟값은 1시간입니다.\n\n만료된 데이터 삭제는 브라우저를 시작하고 15초 후에 이루어지며, 브라우저가 실행되는 동안에는 30분마다 이루어집니다.\n\n쿠키를 삭제해도 사용자는 Google 계정에 로그인된 상태로 유지됩니다.\n\nChrome 114까지 이 정책을 적용하려면 SyncDisabled 정책을 true로 설정해야 합니다. Chrome 115부터 이 정책을 설정하면 `Chrome Sync`가 SyncDisabled 정책으로 인해 사용 중지되지 않고 BrowserSignin 정책도 사용 중지되지 않은 경우 각 데이터 유형의 동기화가 사용 중지됩니다.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime 페이지를 참조하세요.";
BuiltInAIAPIsEnabled.pfm_title = "페이지에서 내장 AI API를 사용하도록 허용";
BuiltInAIAPIsEnabled.pfm_description = "이 정책은 페이지에서 내장 AI API(LanguageModel API, Summarization API, Writer API, Rewriter API 등)를 사용할 수 있는지 여부를 제어합니다.\n\n정책이 사용 설정되거나 설정되지 않은 경우 API를 사용할 수 있습니다.\n\n정책이 사용 중지된 경우 API를 사용하려고 하면 오류가 발생합니다.";
BuiltInDnsClientEnabled.pfm_title = "내장 DNS 클라이언트 사용";
BuiltInDnsClientEnabled.pfm_description = "이 정책은 운영체제 DNS 클라이언트나 Brave의 내장 DNS 클라이언트와 같이 DNS 서버와의 통신에 사용되는 소프트웨어 스택을 제어합니다. 이 정책은 사용되는 DNS 서버에 영향을 미치지 않습니다. 예를 들어 엔터프라이즈 DNS 서버를 사용하도록 운영체제가 구성된 경우 내장 DNS 클라이언트에도 동일한 서버가 사용됩니다. DNS-over-HTTPS가 사용되는 경우에도 제어를 하지 않습니다. Brave에서는 항상 DNS-over-HTTPS 요청에 관한 내장 리졸버를 사용합니다. DNS-over-HTTPS 제어에 관한 자세한 내용은 DnsOverHttpsMode 정책을 참고하세요.\n\n정책을 사용 설정하거나 설정하지 않으면 내장 DNS 클라이언트가 사용됩니다.\n\n정책을 사용 중지하면 DNS-over-HTTPS가 사용 중인 경우에만 내장 DNS 클라이언트가 사용됩니다.";
CACertificateManagementAllowed.pfm_title = "사용자가 설치된 CA 인증을 관리하도록 허용합니다.";
CACertificateManagementAllowed.pfm_description = "0 - 사용자가 모든 인증서를 관리하도록 허용\n1 - 사용자가 자신의 인증서를 관리하도록 허용\n2 - 사용자가 인증서를 관리하도록 허용 안함\n정책을 모두(0)로 설정하거나 설정하지 않으면 사용자는 모든 CA 인증서의 신뢰 설정을 수정하고 사용자가 가져온 인증서를 삭제하며 인증서 관리자를 사용하여 인증서를 가져올 수 있습니다. 정책을 사용자전용(1)으로 설정하면 사용자는 사용자가 가져온 인증서만 관리할 수 있으며 내장 인증서의 신뢰 설정은 변경할 수 없습니다. 정책을 없음(2)으로 설정하면 사용자는 CA 인증서를 볼 수만 있고 관리할 수는 없습니다.";
CACertificates.pfm_title = "서버 인증을 위해 Brave에서 신뢰할 수 있는 TLS 인증서";
CACertificates.pfm_description = "Brave에서 서버 인증 목적으로 신뢰할 수 있는 TLS 인증서 목록입니다.\n인증서는 base64로 인코딩되어야 합니다.";
CACertificatesWithConstraints.pfm_title = "제약 조건이 있는 서버 인증 목적으로 Brave에서 신뢰하는 TLS 인증서";
CACertificatesWithConstraints.pfm_description = "서버 인증을 위해 Brave에서 신뢰할 수 있는 TLS 인증서 목록입니다. 인증서 외부에 제약 조건이 추가되었습니다. 특정 유형의 제약 조건이 없는 경우 해당 유형의 모든 이름이 허용됩니다.\n인증서는 base64로 인코딩되어야 합니다. 각 인증서에 제약 조건을 하나 이상 지정해야 합니다.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints 페이지를 참조하세요.";
CADistrustedCertificates.pfm_title = "Brave에서 서버 인증 목적으로 신뢰하지 않는 TLS 인증서";
CADistrustedCertificates.pfm_description = "Brave에서 TLS 서버 인증 목적으로 신뢰하지 않는 인증서 공개 키의 목록입니다.\n\n정책 값은 base64로 인코딩된 X.509 인증서 목록입니다. 일치하는 SPKI(SubjectPublicKeyInfo)가 있는 인증서는 신뢰할 수 없습니다.";
CAHintCertificates.pfm_title = "신뢰할 수 없거나 신뢰하지 않지만 서버 인증을 위한 경로 구축에 사용할 수 있는 TLS 인증서";
CAHintCertificates.pfm_description = "Brave에서 신뢰할 수 없거나 신뢰하지 않지만 경로 빌드를 위한 힌트로 사용할 수 있는 인증서의 목록입니다. 인증서는 base64로 인코딩되어야 합니다.";
CAPlatformIntegrationEnabled.pfm_title = "서버 인증에 플랫폼 트러스트 저장소의 사용자가 추가한 TLS 인증서 사용";
CAPlatformIntegrationEnabled.pfm_description = "사용 설정하거나 설정하지 않으면 플랫폼 트러스트 저장소에서 사용자가 추가한 TLS 인증서가 TLS 서버 인증을 위한 경로 구축에 사용됩니다.\n\n사용 중지하면 플랫폼 트러스트 저장소에서 사용자가 추가한 TLS 인증서가 TLS 서버 인증용 경로 구축에 사용되지 않습니다.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "와일드카드가 아닌 CORS 요청 헤더 지원";
CORSNonWildcardRequestHeadersSupport.pfm_description = "와일드 카드가 아닌 CORS 요청 헤더 지원을 구성합니다.\n\nBrave 버전 97에서는 와일드 카드가 아닌 CORS 요청 헤더를 지원합니다. 스크립트에서 스크립트가 추가된 Authorization 헤더와 함께 fetch() 및 XMLHttpRequest를 사용하여 교차 출처 네트워크 요청을 하는 경우 CORS 프리플라이트 응답에서 Access-Control-Allow-Headers 헤더가 이 헤더를 명시적으로 허용해야 합니다. 여기서 \"명시적으로\"는 Authorization 헤더에 와일드 카드 기호 \"*\"를 사용할 수 없음을 의미합니다. https://chromestatus.com/feature/5742041264816128에서 자세한 내용을 참고하세요.\n\n정책이 설정되지 않거나 True로 설정되면 Brave에서 와일드 카드가 아닌 CORS 요청 헤더를 지원하고 위 설명과 같이 동작합니다.\n\n정책이 False로 설정되면 Chrome은 CORS 프리플라이트 응답의 Access-Control-Allow-Headers 헤더에서 와일드 카드 기호(\"*\")를 Authorization 헤더에 사용할 수 있도록 허용합니다.\n\n이 기업 정책은 일시적이며 향후 삭제됩니다.";
CacheEncryptionEnabled.pfm_title = "이 정책을 사용하면 관리자가 디스크의 HTTP 캐시를 암호화할 수 있습니다.";
CacheEncryptionEnabled.pfm_description = "관리자는 이 정책을 사용하여 디스크의 브라우저 HTTP 캐시를 암호화할 수 있습니다.\n\n이 정책을 사용 설정하면 브라우저 캐시가 암호화됩니다.\n\n정책을 사용 중지하거나 설정하지 않으면 브라우저 캐시가 암호화되지 않습니다.\n\n브라우저 캐시 암호화는 성능에 영향을 미칠 수 있습니다.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "subjectPublicKeyInfo 해시 목록에 인증서 투명성 시행 사용 중지";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "정책을 설정하면 subjectPublicKeyInfo 해시 목록에 대해 인증서 투명성 공개 요구사항의 시행이 사용 중지됩니다. 이에 따라 적절하게 공개되지 않아 신뢰할 수 없던 인증서를 엔터프라이즈 호스트에서 계속해서 사용할 수 있습니다. 시행을 사용 중지하려면 해시는 다음 조건 중 하나를 만족해야 합니다.\n\n* 서버 인증서의 subjectPublicKeyInfo입니다.\n\n* 인증서 체인의 인증 기관(CA) 인증서에 표시되는 subjectPublicKeyInfo입니다. CA 인증서는 X.509v3 nameConstraints 확장 프로그램을 통해 제한되고, 하나 이상의 directoryName nameConstraints가 permittedSubtrees에 있으며, directoryName에 organizationName 속성이 있습니다.\n\n* 인증서 체인의 CA 인증서에 표시되는 subjectPublicKeyInfo이며, CA 인증서의 인증서 제목에 하나 이상의 organizationName 속성이 있고, 서버 인증서에 동일한 수의 organizationName 속성이 동일한 순서로 포함되어 있고, 바이트별 값도 동일합니다.\n\n해시 알고리즘 이름, 슬래시 및 지정된 인증서의 DER 인코딩 subjectPublicKeyInfo에 적용된 해시 알고리즘 Base64 인코딩을 연결하여 subjectPublicKeyInfo 해시를 지정합니다. Base64 인코딩 형식은 SPKI 지문 형식과 일치합니다. 유일하게 인식되는 해시 알고리즘은 sha256이고 다른 모든 알고리즘은 무시됩니다.\n\n정책을 설정하지 않으면 인증서 투명성을 통해 공개해야 하는 인증서가 공개되지 않은 경우 Brave에서 인증서를 신뢰하지 않습니다.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "일부 URL 목록에는 인증서 투명성 시행 사용 중지";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "정책을 설정하면 지정된 URL의 호스트 이름에 인증서 투명성 공개 요구사항이 사용 중지됩니다. 이렇게 하면 잘못 발급된 인증서를 감지하기는 어려워지지만 적절하게 공개되지 않아 신뢰할 수 없던 인증서를 호스트에서 계속해서 사용할 수 있습니다.\n\n정책을 설정하지 않으면 인증서 투명성을 통해 공개해야 하는 인증서가 공개되지 않은 경우 Brave에서 인증서를 신뢰하지 않습니다.\n\nURL 패턴은 https://support.google.com/chrome/a?p=url_blocklist_filter_format 양식을 따릅니다. 하지만 주어진 호스트 이름의 인증서 유효성이 스키마, 포트 또는 경로와 관련이 없으므로 Brave에서 URL의 호스트 이름 부분만 고려합니다. 와일드 카드 호스트는 지원되지 않습니다.";
ChromeForTestingAllowed.pfm_title = "Chrome for Testing 허용";
ChromeForTestingAllowed.pfm_description = "사용자의 Chrome for Testing 사용 가능 여부를 제어합니다.\n\n정책을 '사용'으로 설정하거나 설정하지 않으면 사용자가 Chrome for Testing을 설치하고 실행할 수 있습니다.\n\n정책을 '사용 안함'으로 설정하면 사용자가 Chrome for Testing을 실행할 수 없습니다. 사용자는 여전히 Chrome for Testing을 설치할 수 있지만 정책이 '사용 안함'으로 설정된 프로필에서는 실행되지 않습니다.";
ChromeSuggestionsSettings.pfm_title = "Chrome 추천 설정";
ChromeSuggestionsSettings.pfm_description = "이 설정을 사용하면 Chrome에서 관련 시점에 AI 기능을 추천할 수 있습니다.\n\n0/설정 안 함 = 사용자에 대해 Chrome 추천이 사용 설정됩니다.\n\n1 = 사용자에 대해 Chrome 추천이 사용 중지됩니다.\n\n자세한 내용은 고객센터 도움말(https://support.google.com/chrome/a?p=chrome_suggestions)을 참고하세요.";
ChromeVariations.pfm_title = "변형 사용 가능 여부 결정";
ChromeVariations.pfm_description = "0 - 모든 변형 허용\n1 - 중요한 수정사항과 관련된 변형만 사용\n2 - 모든 변형 사용 안함\n이 정책을 설정하면 Brave에서 적용 가능한 변형을 지정할 수 있습니다.\n\n변형을 사용하면 새로운 브라우저 버전을 제공하지 않고도 기존 기능을 선별적으로 사용 설정 또는 중지하여 Brave의 변형본을 제공할 수 있습니다. 자세히 알아보려면 https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework를 참고하세요.\n\nVariationsEnabled 옵션을 설정하거나(값 0) 정책을 설정하지 않으면 브라우저에 모든 변형을 적용할 수 있습니다.\n\nCriticalFixesOnly 옵션을 설정하면(값 1) 중요한 보안 또는 안정성 관련 수정사항으로 간주되는 변형만 Brave에 적용 가능합니다.\n\nVariationsDisabled 옵션을 설정하면(값 2) 어떤 변형도 브라우저에 적용할 수 없습니다. 이 모드를 사용하면 Brave 개발자가 중요한 보안 수정사항을 신속히 제공하지 못할 수 있으므로 권장되지 않습니다.";
ClearBrowsingDataOnExitList.pfm_title = "종료 시 인터넷 사용 기록 삭제";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - 방문 기록\ndownload_history - 다운로드 기록\ncookies_and_other_site_data - 쿠키 및 기타 사이트 데이터\ncached_images_and_files - 캐시된 이미지 및 파일\npassword_signin - 비밀번호 로그인\nautofill - 자동 완성\nsite_settings - 사이트 설정\nhosted_app_data - 호스팅된 앱 데이터\n사용자가 모든 브라우저 창을 닫을 때 삭제되어야 하는 인터넷 사용 기록 유형의 목록을 구성합니다.\n\n경고: 이 정책을 설정하면 로컬 개인 정보가 영향을 받아 영구적으로 삭제될 수 있습니다. 개인 정보가 실수로 삭제되지 않도록 배포하기 전에 설정을 테스트하는 것이 좋습니다.\n\n사용 가능한 데이터 유형은 방문 기록(browsing_history), 다운로드 기록(download_history), 쿠키(cookies_and_other_site_data), 캐시(cached_images_and_files), 자동 완성(autofill), 비밀번호(password_signin), 사이트 설정(site_settings), 호스팅된 앱 데이터(hosted_app_data)입니다. 이 정책은 AllowDeletingBrowserHistory보다 우선 적용되지 않습니다.\n\n쿠키를 삭제해도 사용자는 Google 계정에 로그인된 상태로 유지됩니다.\n\nChrome 114까지 이 정책을 적용하려면 SyncDisabled 정책을 true로 설정해야 합니다. Chrome 115부터 이 정책을 설정하면 `Chrome Sync`가 SyncDisabled 정책으로 인해 사용 중지되지 않고 BrowserSignin 정책도 사용 중지되지 않은 경우 각 데이터 유형의 동기화가 사용 중지됩니다.\n\n어떤 이유로 데이터 삭제가 시작되었지만 완료되지 않은 경우 다음에 프로필이 로드될 때 인터넷 사용 기록이 지워집니다.\n\nBrave이 올바르게 종료되지 않으면(예: 브라우저 또는 OS 비정상 종료) 브라우저 창을 모두 닫아서 브라우저가 종료된 것이 아니기 때문에 인터넷 사용 기록이 삭제되지 않습니다.";
ClipboardAllowedForUrls.pfm_title = "사이트에서 클립보드 허용";
ClipboardAllowedForUrls.pfm_description = "정책을 설정하면 클립보드 사이트 권한을 사용할 수 있는 사이트를 명시하는 URL 패턴 목록을 설정할 수 있습니다. 여기에 패턴과 일치하는 출처에서 이루어진 모든 클립보드 작업이 포함되는 것은 아닙니다. 예를 들어 키보드 단축키를 사용하여 붙여넣는 작업은 클립보드 사이트 권한이 필요하지 않기 때문에 계속 가능합니다.\n\n\n정책을 설정하지 않은 경우 DefaultClipboardSetting이 설정되어 있으면 모든 사이트에 적용됩니다. 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.";
ClipboardBlockedForUrls.pfm_title = "사이트에서 클립보드 차단";
ClipboardBlockedForUrls.pfm_description = "정책을 설정하면 클립보드 사이트 권한을 사용할 수 없는 사이트를 명시하는 URL 패턴 목록을 설정할 수 있습니다. 여기에 패턴과 일치하는 출처에서 이루어진 모든 클립보드 작업이 포함되는 것은 아닙니다. 예를 들어 키보드 단축키를 사용하여 붙여넣는 작업은 클립보드 사이트 권한이 필요하지 않기 때문에 계속 가능합니다.\n\n정책을 설정하지 않은 경우 DefaultClipboardSetting이 설정되어 있으면 모든 사이트에 적용됩니다. 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.";
CloudManagementEnrollmentMandatory.pfm_title = "필수 클라우드 관리 등록 사용";
CloudManagementEnrollmentMandatory.pfm_description = "정책을 사용으로 설정하면 Chrome Enterprise Core 브라우저 등록이 필수로 설정되며 실패할 경우 Brave 실행 프로세스가 차단됩니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 Chrome Enterprise Core 브라우저 등록이 옵션으로 간주되고 실패할 경우 Brave 실행 프로세스가 차단되지 않습니다.\n\n데스크톱의 머신 범위 클라우드 정책 등록에서 이 정책을 사용합니다. 자세한 내용은 https://support.google.com/chrome/a/answer/9301891을 참고하세요.";
CloudManagementEnrollmentToken.pfm_title = "클라우드 정책 등록 토큰";
CloudManagementEnrollmentToken.pfm_description = "정책을 설정하면 Brave에서 Chrome Enterprise Core 브라우저 관리에 자체 등록을 시도합니다. 정책의 값은 Google Admin console에서 가져올 수 있는 등록 토큰입니다.\n\n자세한 내용은 https://support.google.com/chrome/a/answer/9301891을 참고하세요.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "Brave 클라우드 정책이 플랫폼 정책에 우선합니다.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "정책을 사용으로 설정하면 클라우드 정책과 플랫폼 정책이 충돌할 경우 클라우드 정책이 우선 적용됩니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 플랫폼 정책과 클라우드 정책이 충돌할 경우 플랫폼 정책이 우선 적용됩니다.\n\n이 필수 정책은 머신 범위 클라우드 정책에 영향을 줍니다.\n\n이 정책은 Brave에만 적용되며 독립적인 애플리케이션이므로 Google Update에는 영향을 미치지 않습니다.\nGoogle Update에는 이름이 동일한 별도의 정책이 있습니다.";
CloudUserPolicyMerge.pfm_title = "사용자 클라우드 정책과 시스템 수준 정책의 병합 사용";
CloudUserPolicyMerge.pfm_description = "정책을 사용으로 설정하면 관리 계정과 연결된 정책을 시스템 수준 정책에 병합할 수 있습니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 사용자 수준 클라우드 정책이 다른 소스의 정책과 병합되지 않습니다.\n\n보안 사용자가 만든 정책만 우선 적용됩니다. 보안 사용자는 Chrome Enterprise Core를 사용하여 브라우저를 관리하는 조직에 속합니다. 다른 모든 사용자 수준 정책은 기본적으로 우선 적용됩니다.\n\n병합해야 하는 정책은 PolicyListMultipleSourceMergeList 또는 PolicyDictionaryMultipleSourceMergeList 중 하나에도 설정되어 있어야 합니다. 앞서 언급한 두 정책이 모두 구성되지 않은 경우 이 정책은 무시됩니다.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "사용자 클라우드 정책이 Chrome Browser Cloud Management 정책보다 우선 적용되도록 허용";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "정책을 사용으로 설정하면 Chrome Enterprise Core 브라우저 정책과 충돌하는 경우 관리 계정에 연결된 정책이 우선 적용됩니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 사용자 수준 클라우드 정책이 기본적으로 우선 적용됩니다.\n\n보안 사용자가 만든 정책만 우선 적용됩니다. 보안 사용자는 Chrome Enterprise Core를 사용하여 브라우저를 관리하는 조직에 속합니다. 다른 모든 사용자 수준 정책은 기본적으로 우선 적용됩니다.\n\n이 정책은 CloudPolicyOverridesPlatformPolicy 정책과 결합될 수 있습니다. 두 정책이 모두 사용으로 설정되어 있으면 사용자 클라우드 정책이 충돌하는 플랫폼 정책보다 우선 적용됩니다.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "명령줄 플래그에 보안 경고를 사용합니다.";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "이 정책을 사용 설정하거나 설정하지 않으면 잠재적으로 위험한 명령줄 플래그와 함께 Chrome이 실행되었을 때 보안 경고가 표시됩니다.\n\n정책을 사용 중지하면 잠재적으로 위험한 명령줄 플래그와 함께 Chrome이 실행되었을 때 보안 경고가 표시되지 않습니다.\n\nMicrosoft® Windows®의 경우 이 정책은 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.\n\nmacOS의 경우 이 정책은 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.";
ComponentUpdatesEnabled.pfm_title = "Brave 구성요소 업데이트 허용";
ComponentUpdatesEnabled.pfm_description = "설정하지 않거나 사용 설정하면 Brave의 모든 구성요소에 구성요소 업데이트를 사용합니다.\n\n사용 안함으로 설정하면 구성요소 업데이트가 사용 중지됩니다. 하지만 일부 구성요소는 이 정책에서 제외됩니다. 예를 들어 실행 코드가 포함되지 않은 구성요소와 브라우저 보안에 중요한 구성요소 업데이트는 사용 중지되지 않습니다.\n이와 같은 구성요소의 예로는 해지 인증서 목록 및 하위 리소스 필터가 있습니다.";
CompressionDictionaryTransportEnabled.pfm_title = "압축 사전 전송 지원 사용 설정";
CompressionDictionaryTransportEnabled.pfm_description = "이 기능을 사용하면 사전을 사용할 수 있을 때 Accept-Encoding 요청 헤더('sbr' 및 'zst-d')에서 사전별 콘텐츠 인코딩 사용을 사용 설정할 수 있습니다.\n\n정책을 사용 설정하거나 설정하지 않으면 Brave에서 압축 사전 전송 기능을 사용하여 웹 콘텐츠를 허용합니다.\n정책을 사용 중지하면 압축 사전 전송 기능이 사용 중지됩니다.";
CookiesAllowedForUrls.pfm_title = "이 사이트에서 쿠키 허용";
CookiesAllowedForUrls.pfm_description = "쿠키 설정이 허용되는 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\nURL 패턴은 사이트가 모든 최상위 사이트에서 쿠키를 사용할 수 있음을 나타내는 단일 URL일 수 있습니다.\n\n패턴은 쉼표로 구분된 URL 2개일 수도 있습니다. 첫 번째 URL은 쿠키 사용을 허용해야 하는 사이트를 지정합니다. 두 번째 URL은 첫 번째 값이 적용되어야 하는 최상위 사이트를 지정합니다.\n\nURL 한 쌍을 사용하는 경우 쌍의 첫 번째 값은 * 기호를 지원하지만 두 번째 값은 지원하지 않습니다. 첫 번째 값에 * 기호를 사용하면 두 번째 URL이 최상위 사이트일 때 모든 사이트에서 쿠키를 사용할 수 있음을 나타냅니다.\n\n정책을 설정하지 않으면 DefaultCookiesSetting 또는 BlockThirdPartyCookies 정책 중 하나(설정되어 있는 경우) 혹은 사용자의 개인 구성에 따른 전체 기본값이 모든 사이트에 사용됩니다.\n\nCookiesBlockedForUrls 및 CookiesSessionOnlyForUrls 정책도 참고하세요. 이 세 정책 간에 충돌하는 URL 패턴이 없어야 합니다. 어떤 정책이 우선 적용되는지는 지정되어 있지 않습니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. *는 이 정책에 허용되는 값이 아닙니다.";
CookiesBlockedForUrls.pfm_title = "이 사이트에서 쿠키 차단";
CookiesBlockedForUrls.pfm_description = "정책을 설정하면 쿠키 설정이 불가한 사이트를 지정하는 URL 패턴 목록을 만들 수 있습니다.\n\n정책을 설정하지 않았을 때 DefaultCookiesSetting이 설정되어 있으면 모든 사이트에 사용되며 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다.\n\n특정 정책이 우선 적용되지 않는 경우 CookiesAllowedForUrls와 CookiesSessionOnlyForUrls를 참고하세요. 3가지 정책 간의 URL 패턴은 충돌하지 않아야 합니다.\n\n유효한 url 패턴에 관한 자세한 내용은 https://chromeenterprise.google/policies/url-patterns 페이지를 참고하세요. *는 이 정책에 허용되는 값이 아닙니다.";
CookiesSessionOnlyForUrls.pfm_title = "일치하는 URL의 쿠키를 현재 세션으로 제한";
CookiesSessionOnlyForUrls.pfm_description = "RestoreOnStartup 정책이 이전 세션의 URL을 영구적으로 복원하도록 설정되어 있지 않을 경우, CookiesSessionOnlyForUrls를 설정하면 세션 하나에 대한 사이트의 쿠키 설정 여부를 지정하는 URL 패턴 목록을 만들 수 있습니다.\n\n정책을 설정하지 않았을 때 DefaultCookiesSetting이 설정되어 있으면 모든 사이트에 사용되며 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다. 지정된 패턴에 해당하지 않는 URL에서도 기본값을 사용합니다.\n\n특정 정책이 우선 적용되지 않는 경우 CookiesBlockedForUrls와 CookiesAllowedForUrls를 참고하세요. 3가지 정책 간의 URL 패턴은 충돌하지 않아야 합니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. *는 이 정책에 허용되는 값이 아닙니다.";
CpuPerformanceTierOverride.pfm_title = "CPU 성능 등급 재정의";
CpuPerformanceTierOverride.pfm_description = "이 정책을 설정하면 CPU Performance API에서 반환한 값을 기업이\n재정의할 수 있습니다(즉\nnavigator.cpuPerformance,\n자세한 내용은 https://github.com/WICG/cpu-performance 참고).\n\n이 정책을 설정하면\nnavigator.cpuPerformance 값이\n지정된 값으로 재정의됩니다. 정책을 설정하지 않으면\n기본 성능 등급 계산이 사용됩니다.\n\n이 정책에 사용할 수 있는 값은 0~4입니다.";
CreatePasskeysInICloudKeychain.pfm_title = "iCloud 키체인의 기본 패스키 생성 여부를 제어합니다.";
CreatePasskeysInICloudKeychain.pfm_description = "Brave에서 macOS 13.5 이상의 iCloud 키체인에 직접 패스키/WebAuthn 생성 요청을 전달할 수도 있습니다. iCloud 키체인 동기화가 아직 사용 설정되지 않은 경우 사용자에게 iCloud로 로그인하라는 메시지가 표시되거나 iCloud 키체인 동기화를 사용 설정하라는 프롬프트가 표시될 수 있습니다.\n\n이 정책을 false로 설정하면 iCloud 키체인이 기본적으로 사용되지 않으며 Brave 프로필에서 사용자 인증 정보를 만드는 이전 동작이 대신 사용될 수도 있습니다. 사용자는 여전히 iCloud 키체인을 옵션으로 선택할 수 있으며 로그인 시 iCloud 키체인 사용자 인증 정보가 계속 표시될 수도 있습니다.\n\n이 정책을 'true'로 설정하면 WebAuthn 요청이 해당 선택과 호환되는 경우 항상 iCloud 키체인의 기본값이 됩니다.\n\n이 정책을 설정하지 않으면 iCloud Drive 사용 설정 여부, 사용자가 최근에 Brave 프로필에서 사용자 인증 정보를 사용했거나 만들었는지 여부 등의 요인에 따라 기본값이 달라집니다.";
CreateThemesSettings.pfm_title = "AI로 테마 만들기 설정";
CreateThemesSettings.pfm_description = "0 - 테마 만들기를 허용하고 AI 모델을 개선합니다.\n1 - AI 모델 개선 없이 테마 만들기를 허용합니다.\n2 - 테마 만들기를 허용하지 않습니다.\nAI로 테마 만들기를 사용하면 사용자가 옵션 목록에서 미리 선택하여 맞춤 테마/배경화면을 만들 수 있습니다.\n\n0 = 이 기능을 사용하도록 허용하면서 Google에서 관련 데이터를 사용하여 AI 모델을 개선하도록 허용합니다. 관련 데이터에는 기능에 따라 프롬프트나 입력, 출력, 소스 자료, 서면 의견이 포함될 수 있습니다. AI 모델을 개선하기 위해 사람이 데이터를 검토할 수도 있습니다. 아래에 명시된 경우를 제외하고 0이 기본값입니다.\n\n1 = 기능을 사용하도록 허용하되 Google에서 사용자 콘텐츠(프롬프트, 입력, 출력, 소스 자료, 서면 의견 등)를 사용하여 모델을 개선하도록 허용하지 않습니다. 1은 Google Admin console에서 관리되는 기업 사용자 및 Google Workspace에서 관리되는 Education 계정의 기본값입니다.\n\n2 = 기능을 허용하지 않습니다.\n\n정책을 설정하지 않으면 GenAiDefaultSettings 정책에 따라 동작이 결정됩니다.\n\n생성형 AI 기능의 데이터 처리에 관한 자세한 내용은 https://support.google.com/chrome/a?p=generative_ai_settings 페이지를 참고하세요.";
DNSInterceptionChecksEnabled.pfm_title = "DNS 가로채기 검사 사용 설정됨";
DNSInterceptionChecksEnabled.pfm_description = "이 정책은 DNS 가로채기 검사를 사용 중지하는 데 이용할 수 있는 로컬 스위치를 구성합니다. DNS 가로채기 검사는 브라우저에서 알 수 없는 호스트 이름을 리디렉션하는 프록시를 사용 중인지 확인합니다.\n\n네트워크 구성이 알려진 엔터프라이즈 환경에서는 검사를 시작하거나 DNS 구성을 변경할 때마다 검사로 인해 DNS 및 HTTP 트래픽이 발생하므로 이 검사가 필요하지 않을 수 있습니다.\n\n정책이 설정되어 있지 않거나 사용 설정되어 있으면 DNS 가로채기 검사가 실행됩니다. 명시적으로 사용 중지되면 검사가 실행되지 않습니다.";
DataURLWhitespacePreservationEnabled.pfm_title = "모든 미디어 유형의 DataURL 공백 유지";
DataURLWhitespacePreservationEnabled.pfm_description = "이 정책은 Chrome에서 data URL의 공백을 처리하는 방식을 변경하는 기능을 일시적으로 선택 해제합니다.\n이전에는 최상위 미디어 유형이 text거나 미디어 유형 문자열 xml을 포함하는 경우에만 공백이 유지되었습니다.\n이제 미디어 유형에 관계없이 모든 데이터 URL에서 공백이 유지됩니다.\n\n정책을 설정하지 않거나 True로 설정하면 새 동작이 사용 설정됩니다.\n\n정책이 False로 설정되면 이전 동작이 사용 설정됩니다.";
DataUrlInSvgUseEnabled.pfm_title = "SVGUseElement에 대한 데이터 URL 지원.";
DataUrlInSvgUseEnabled.pfm_description = "이 정책은 SVGUseElement에 대한 데이터 URL 지원을 사용 설정하며 M119부터 기본적으로 사용 중지됩니다.\n정책을 사용으로 설정하면 SVGUseElement에서 데이터 URL이 계속 작동합니다.\n정책을 사용 안함으로 설정하거나 설정하지 않으면 SVGUseElement에서 데이터 URL이 작동하지 않습니다.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "웹 작업자의 데이터 URL에 불투명 출처 사용 설정";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "데이터 URL에서 생성된 웹 작업자에 고유한 불투명 출처를 할당할지 여부를 제어합니다.\n\n웹 작업자는 작업자의 스크립트가 포함된 데이터 URL을 사용하여 생성될 수 있습니다. 이전에는 이러한 작업자가 자신을 생성한 페이지의 출처를 상속받아 동일한 로컬 스토리지, 쿠키, 기타 출처 바인딩 데이터에 액세스할 수 있었습니다. 보안을 개선하고 HTML 사양을 준수하기 위해 Chrome은 149 버전부터 데이터 URL에서 생성된 작업자가 이제 고유한 불투명 출처를 갖도록 기본 동작을 변경합니다. 이렇게 하면 생성자 페이지의 데이터와 작업자가 분리됩니다.\n\n이 정책이 '사용 설정됨'으로 설정되거나 별도의 설정을 하지 않으면 새로운 더 안전한 기본 동작이 사용되며, 데이터 URL에서 생성된 웹 작업자에 고유한 불투명 출처가 부여됩니다.\n\n이 정책이 '사용 중지됨'으로 설정되면 Chrome이 기존 동작으로 되돌아가고, 데이터 URL에서 생성된 웹 작업자는 생성자의 출처를 상속받게 됩니다. 이렇게 하면 보안 변경으로 인해 내부 애플리케이션이 중단되는 경우 관리자가 호환성 문제를 일시적으로 해결할 수 있습니다.\n\n이 정책은 임시 조치이며 157 버전에서 삭제될 예정입니다.";
DefaultAutomaticDownloadsSetting.pfm_title = "기본 자동 다운로드 설정";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - 모든 사이트에서 여러 파일을 자동으로 다운로드하도록 허용\n2 - 사이트에서 여러 파일을 자동으로 다운로드하도록 허용하지 않음\n3 - 사이트에서 여러 파일을 자동으로 다운로드하려고 할 때마다 확인\n정책을 1로 설정하면 웹사이트에서 여러 파일을 자동으로 다운로드할 수 있습니다. 정책을 2로 설정하면 이 권한이 거부됩니다. 웹사이트에서 여러 파일을 자동으로 다운로드하려고 할 때마다 사용자에게 묻도록 정책을 설정할 수 있습니다.\n\n정책을 설정하지 않으면 AskAutomaticDownloads 정책이 적용되지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Brave을(를) 기본 브라우저로 설정";
DefaultBrowserSettingEnabled.pfm_description = "정책을 True로 설정하면 Brave에서 시작 시 항상 기본 브라우저인지 확인하며 가능한 경우 자동으로 기본 브라우저로 등록합니다. 정책을 False로 설정하면 Brave에서 기본 브라우저인지 확인하지 않으며 사용자가 이 옵션을 사용 중지할 수 없습니다.\n\n정책을 설정하지 않으면 Brave에서 사용자가 기본 브라우저 여부를 제어하며 기본 브라우저가 아닌 경우 사용자 알림이 표시되어야 하는지를 제어할 수 있습니다.\n\n참고: Microsoft®Windows® 관리자의 경우 Windows 7을 실행하는 기기에서만 이 설정을 사용 설정할 수 있습니다. 이후 버전의 경우 Brave을(를) https 및 http 프로토콜(선택적으로 ftp 프로토콜 및 기타 파일 형식)의 핸들러로 설정하는 '기본 애플리케이션 연결' 파일을 배포해야 합니다. Chrome 도움말( https://support.google.com/chrome?p=make_chrome_default_win )을 참조하세요.";
DefaultClipboardSetting.pfm_title = "기본 클립보드 설정";
DefaultClipboardSetting.pfm_description = "2 - 모든 사이트에서 클립보드 사이트 권한 사용 허용 안함\n3 - 사이트에서 사용자에게 클립보드 사이트 권한 부여를 요청하도록 허용\n정책을 2로 설정하면 사이트에서 클립보드 사이트 권한을 사용할 수 없습니다. 정책을 3으로 설정하거나 설정하지 않으면 사용자가 설정을 변경할 수 있고, 사이트에서 클립보드 API 사용을 요청할 때 사용 가능 여부를 결정할 수 있습니다.\n\nClipboardAllowedForUrls 및 ClipboardBlockedForUrls 정책을 사용하는 특정 URL 패턴의 경우 이 정책보다 우선 적용될 수 있습니다.\n\n이 정책은 클립보드 사이트 권한으로 제어되는 클립보드 작업에만 영향을 미치며, 검사된 클립보드 쓰기 또는 신뢰할 수 있는 복사하여 붙여넣기 작업에는 영향을 미치지 않습니다.";
DefaultCookiesSetting.pfm_title = "기본 쿠키 설정";
DefaultCookiesSetting.pfm_description = "1 - 모든 사이트에서 로컬 데이터 설정 허용\n2 - 모든 사이트에서 로컬 데이터 설정 허용 안함\n4 - 세션이 지속되는 동안 쿠키를 유지합니다.\nRestoreOnStartup 정책이 이전 세션의 URL을 영구적으로 복원하도록 설정되어 있지 않을 경우, CookiesSessionOnlyForUrls를 설정하면 세션 하나에 대한 사이트의 쿠키 설정 여부를 지정하는 URL 패턴 목록을 만들 수 있습니다.\n\n정책을 설정하지 않았을 때 DefaultCookiesSetting이 설정되어 있으면 모든 사이트에 사용되며 설정되지 않으면 사용자의 개인 설정이 적용됩니다. 지정된 패턴에 해당하지 않는 URL에서도 기본값을 사용합니다.\n\n특정 정책이 우선 적용되지 않는 경우 CookiesBlockedForUrls와 CookiesAllowedForUrls를 참고하세요. 3가지 정책 간의 URL 패턴은 충돌하지 않아야 합니다.";
DefaultDownloadDirectory.pfm_title = "기본 다운로드 디렉터리 설정";
DefaultDownloadDirectory.pfm_description = "정책을 설정하면 Chrome에서 파일을 다운로드하는 기본 디렉터리가 변경되지만, 사용자가 이 디렉터리를 변경할 수 있습니다.\n\n정책을 설정하지 않으면 Chrome에서는 플랫폼별 기본 디렉터리를 사용합니다.\n\nDownloadDirectory 정책이 설정되어 있으면 이 정책은 아무런 영향을 미치지 않습니다.\n\n참고: 다음 페이지에서 사용 가능한 변수를 확인하세요. https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables";
DefaultFileSystemReadGuardSetting.pfm_title = "읽기 관련 File System API 사용 제어";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - 모든 사이트에서 File System API를 통한 파일 및 디렉터리 읽기 액세스 권한을 요청하지 못하도록 차단\n3 - 사이트에서 사용자에게 File System API를 통해 파일 및 디렉터리 읽기 액세스 권한을 요청하도록 허용\n이 정책을 3으로 설정하면 웹사이트에서 File System API를 통해 호스트 운영체제의 파일 시스템 내 파일 및 디렉터리에 대한 읽기 액세스 권한을 요청할 수 있습니다. 정책을 2로 설정하면 액세스가 거부됩니다.\n\n정책을 설정하지 않으면 웹사이트에서 액세스 권한을 요청할 수 있지만, 사용자가 이 설정을 변경할 수 있습니다.";
DefaultFileSystemWriteGuardSetting.pfm_title = "쓰기 관련 File System API 사용 제어";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - 모든 사이트에서 파일 및 디렉터리 쓰기 액세스 권한을 요청하지 못하도록 차단\n3 - 사이트에서 사용자에게 파일 및 디렉터리 쓰기 액세스 권한을 요청하도록 허용\n이 정책을 3으로 설정하면 웹사이트에서 호스트 운영체제의 파일 시스템 내 파일 및 디렉터리에 대한 쓰기 액세스 권한을 요청할 수 있습니다. 정책을 2로 설정하면 액세스가 거부됩니다.\n\n정책을 설정하지 않으면 웹사이트에서 액세스 권한을 요청할 수 있지만, 사용자가 이 설정을 변경할 수 있습니다.";
DefaultGeolocationSetting.pfm_title = "기본 위치정보 설정";
DefaultGeolocationSetting.pfm_description = "1 - 사이트에서 사용자 실제 위치를 추적하도록 허용\n2 - 모든 사이트에서 사용자 실제 위치를 추적하도록 허용 안함\n3 - 사이트에서 사용자의 실제 위치를 추적할 때마다 확인\n정책을 1로 설정하면 사이트에서 기본 상태로 사용자의 실제 위치를 추적하도록 허용합니다. 정책을 2로 설정하면 이 추적을 기본적으로 거부합니다. 사이트에서 사용자의 실제 위치를 추적하려고 할 때마다 사용자에게 묻도록 정책을 설정할 수 있습니다.\n\n정책을 설정하지 않으면 AskGeolocation 정책이 적용되지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultIdleDetectionSetting.pfm_title = "유휴 상태 감지";
DefaultIdleDetectionSetting.pfm_description = "1 - 사이트에서 사용자에게 묻지 않고 유휴 상태를 감지하도록 허용\n2 - 모든 사이트에서 사용자의 유휴 상태를 감지하도록 허용 안 함\n3 - 사이트에서 사용자의 유휴 상태를 감지하려고 할 때마다 확인\n웹사이트가 Idle Detection API를 사용하도록 허용할지 설정할 수 있습니다.\n\n정책을 1 - AllowIdleDetection으로 설정하면 웹사이트에서 사용자에게 권한을 요청하지 않고도 API를 사용할 수 있습니다.\n\n정책을 2 - BlockIdleDetection으로 설정하면 사용자의 권한과 관계없이 웹사이트에서 API를 사용할 수 없습니다.\n\n정책을 3 - AskIdleDetection으로 설정하거나 설정하지 않으면 웹사이트에서 사용자의 동의 없이 API를 사용할 수 없습니다.";
DefaultImagesSetting.pfm_title = "기본 이미지 설정";
DefaultImagesSetting.pfm_description = "1 - 모든 사이트에서 모든 이미지를 표시하도록 허용\n2 - 모든 사이트에서 이미지 표시 허용 안함\n정책을 1로 설정하면 모든 웹사이트에서 이미지 표시를 허용합니다. 정책을 2로 설정하면 이미지 표시를 거부합니다.\n\n설정하지 않으면 이미지를 허용하지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultInsecureContentSetting.pfm_title = "안전하지 않은 콘텐츠 예외 사용 제어";
DefaultInsecureContentSetting.pfm_description = "2 - 모든 사이트에서 혼합 콘텐츠 로드 허용 안함\n3 - 사용자가 혼합 콘텐츠를 허용하는 예외를 추가하도록 허용\n사용자가 특정 사이트에 혼합 콘텐츠를 허용하는 예외를 추가할 수 있도록 할지 결정합니다.\n\n'InsecureContentAllowedForUrls' 정책 및 'InsecureContentBlockedForUrls' 정책을 사용하는 특정 URL 패턴의 경우, 이 정책을 재정의할 수 있습니다.\n\n정책이 설정되어 있지 않으면 사용자는 차단 가능한 혼합 콘텐츠를 허용하는 예외를 추가하고 선택적으로 차단 가능한 혼합 콘텐츠의 자동 업그레이드를 사용 중지할 수 있습니다.";
DefaultJavaScriptJitSetting.pfm_title = "자바스크립트 JIT 사용 제어";
DefaultJavaScriptJitSetting.pfm_description = "1 - 모든 사이트에서 자바스크립트 JIT를 실행하도록 허용\n2 - 모든 사이트에서 자바스크립트 JIT를 실행하도록 허용 안함\nBrave에서 v8 자바스크립트 엔진을 JIT(Just In Time) 컴파일러가 사용 설정된 상태로 실행할지 아니면 사용 중지된 상태로 실행할지를 선택할 수 있습니다.\n\n자바스크립트 JIT를 사용 중지하면 Brave의 웹 콘텐츠 렌더링 속도가 느려질 수 있으며 WebAssembly를 비롯해 자바스크립트의 일부가 사용 중지될 수 있습니다. 자바스크립트 JIT를 사용 중지하면 Brave이 더 안전한 구성으로 웹 콘텐츠를 렌더링할 수 있습니다.\n\nJavaScriptJitAllowedForSites 및 JavaScriptJitBlockedForSites 정책을 사용하는 특정 URL 패턴의 경우 이 정책보다 우선 적용될 수 있습니다.\n\n정책이 설정되지 않으면 자바스크립트 JIT가 사용 설정됩니다.";
DefaultJavaScriptOptimizerSetting.pfm_title = "JavaScript 최적화 도구 사용 제어";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - 모든 사이트에서 고급 JavaScript 최적화 사용 설정\n2 - 모든 사이트에서 고급 JavaScript 최적화 사용 중지\nBrave에서 고급 JavaScript 최적화가 사용 설정된 상태로 V8 JavaScript 엔진을 실행할지 여부를 선택할 수 있습니다.\n\nJavaScript 최적화를 사용 중지하면(이 정책의 값을 2로 설정) Brave의 웹 콘텐츠 렌더링 속도가 느려질 수 있습니다.\n\nJavaScriptOptimizerAllowedForSites 및 JavaScriptOptimizerBlockedForSites 정책을 사용하는 특정 URL 패턴의 경우 이 정책보다 우선 적용될 수 있습니다.\n\n정책을 설정하지 않으면 JavaScript 최적화가 사용 설정됩니다.";
DefaultJavaScriptSetting.pfm_title = "기본 자바 스크립트 설정";
DefaultJavaScriptSetting.pfm_description = "1 - 모든 사이트에서 자바스크립트 실행 허용\n2 - 모든 사이트에서 자바스크립트 실행 허용 안함\n정책을 1로 설정하면 웹사이트에서 JavaScript를 실행하도록 허용합니다. 정책을 2로 설정하면 JavaScript를 거부합니다.\n\n정책을 설정하지 않으면 JavaScript를 허용하지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultLocalFontsSetting.pfm_title = "기본 로컬 글꼴 권한 설정";
DefaultLocalFontsSetting.pfm_description = "2 - 기본적으로 모든 사이트에서 로컬 글꼴 권한 거부\n3 - 사이트에서 로컬 글꼴 권한을 얻을 때마다 확인\n정책을 BlockLocalFonts(값 2) 정책으로 설정하면 기본적으로 사이트에 대한 로컬 글꼴 권한이 자동 거부됩니다. 이렇게 하면 로컬 글꼴에 관한 정보를 볼 수 있는 사이트 기능이 제한됩니다.\n\n정책을 AskLocalFonts(값 3) 정책으로 설정하면 기본적으로 로컬 글꼴 권한이 요청될 때 사용자에게 메시지가 표시됩니다. 사용자가 권한을 허용하면 사이트에서 로컬 글꼴에 관한 정보를 볼 수 있는 기능이 확장됩니다.\n\n정책을 설정하지 않으면 사용자에게 메시지를 표시하는 기본 동작이 적용되지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultNotificationsSetting.pfm_title = "기본 알림 설정";
DefaultNotificationsSetting.pfm_description = "1 - 사이트에서 데스크톱 알림을 표시하도록 허용\n2 - 모든 사이트에서 데스크톱 알림 표시 허용 안함\n3 - 사이트에서 데스크톱 알림을 표시할 때마다 확인\n정책을 1로 설정하면 웹사이트에서 데스크톱 알림을 표시하도록 허용합니다. 정책을 2로 설정하면 데스크톱 알림을 거부합니다.\n\n정책을 설정하지 않으면 AskNotifications 정책이 적용되지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultPopupsSetting.pfm_title = "기본 팝업 설정";
DefaultPopupsSetting.pfm_description = "1 - 모든 사이트에서 팝업 표시 허용\n2 - 모든 사이트에서 팝업 표시 허용 안함\n정책을 1로 설정하면 웹사이트에서 팝업을 표시하도록 허용합니다. 정책을 2로 설정하면 팝업을 거부합니다.\n\n정책을 설정하지 않으면 BlockPopups 정책이 적용되지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultPrinterSelection.pfm_title = "기본 프린터 선택 규칙";
DefaultPrinterSelection.pfm_description = "정책을 설정하면 Brave에서 기본 프린터를 선택하는 규칙이 설정되며, 이 규칙은 기본 규칙보다 우선 적용됩니다. 사용자가 처음 인쇄를 시도할 때 Brave에서 특정 속성과 일치하는 프린터를 찾으면 프린터가 선택됩니다. 정확하게 일치하는 항목이 없는 경우 프린터가 검색되는 순서에 따라 일치하는 프린터를 선택하도록 Brave을 설정할 수 있습니다.\n\n정책을 설정하지 않거나 일치하는 항목이 없는 속성으로 설정하면 내장 PDF 프린터가 기본값이 됩니다. PDF 프린터가 없는 경우 Brave의 기본값은 없음입니다.\n\n현재 모든 프린터는 \"local\"로 분류되며 Google Cloud Print에 연결된 프린터는 \"cloud\"로 간주되지만 Google Cloud Print은(는) 더 이상 지원되지 않습니다.\n\n참고: 필드 값을 비워두면 모든 값이 해당 필드와 일치하게 됩니다. 예를 들어 idPattern을 지정하지 않으면 인쇄 미리보기에서 모든 프린터 ID를 허용합니다. 정규 표현식 패턴은 JavaScript RegExp 문법을 따라야 하며 일치하는 항목은 대소문자를 구분합니다.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection 페이지를 참조하세요.";
DefaultSearchProviderAlternateURLs.pfm_title = "기본 검색 공급자의 대체 URL 목록";
DefaultSearchProviderAlternateURLs.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있으면 DefaultSearchProviderAlternateURLs 설정은 검색엔진에서 검색어를 추출하기 위한 대체 URL 목록을 지정합니다. URL은 '{searchTerms}' 문자열을 포함해야 합니다.\n\nDefaultSearchProviderAlternateURLs을 설정하지 않으면 검색어를 추출할 때 대체 URL이 사용되지 않습니다.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "기본 검색 공급업체 컨텍스트 메뉴 검색 액세스 허용";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "컨텍스트 메뉴에서 기본 검색 제공업체를 사용 설정합니다.\n\n정책을 사용 중지하면 기본 검색 공급업체에 의존하는 검색 컨텍스트 메뉴 항목을 사용할 수 없습니다.\n\n정책이 사용 설정되거나 설정되지 않으면 기본 검색 공급업체의 컨텍스트 메뉴 항목을 사용할 수 있습니다.\n\n이 정책 값은 DefaultSearchProviderEnabled 정책이 사용 설정된 경우에만 적용되며 다른 경우에는 적용되지 않습니다.";
DefaultSearchProviderEnabled.pfm_title = "기본 검색 공급자 사용";
DefaultSearchProviderEnabled.pfm_description = "정책을 '사용'으로 설정하면 사용자가 주소 표시줄에 URL이 아닌 텍스트를 입력했을 때 기본 검색이 수행됩니다. 기본 검색 서비스 제공업체를 지정하려면 기본 검색 정책의 나머지를 설정하세요. 이러한 정책을 비워두면 사용자가 기본 공급자를 선택할 수 있습니다. 정책을 사용 중지하면 사용자가 주소 표시줄에 URL이 아닌 텍스트를 입력했을 때 검색이 수행되지 않습니다. 사용 중지 값은 Google Admin console에서 지원되지 않습니다.\n\n정책을 설정하면 사용자가 Brave에서 정책을 변경할 수 없습니다. 정책을 설정하지 않으면 기본 검색 서비스 제공업체가 사용 설정되고 사용자는 검색 서비스 제공업체 목록을 설정할 수 있습니다.\n\nMicrosoft® Windows®의 경우 이 정책은 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.\n\nmacOS의 경우 이 정책은 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.";
DefaultSearchProviderEncodings.pfm_title = "기본 검색 공급자 인코딩";
DefaultSearchProviderEncodings.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있으면 DefaultSearchProviderEncodings을(를) 설정할 경우 검색 공급자에서 지원되는 문자 인코딩을 지정합니다. 인코딩은 UTF-8, GB2312 및 ISO-8859-1과 같은 코드 페이지 이름입니다. 인코딩은 제공된 순서대로 사용됩니다.\n\nDefaultSearchProviderEncodings를 설정하지 않으면 UTF-8이 사용됩니다.";
DefaultSearchProviderImageURL.pfm_title = "기본 검색엔진에 이미지로 검색 기능을 제공하는 매개변수";
DefaultSearchProviderImageURL.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있으면 DefaultSearchProviderImageURL을 설정할 경우 이미지 검색에 사용된 검색엔진의 URL을 지정합니다. DefaultSearchProviderImageURLPostParams가 설정되면 이미지 검색 요청에서 POST 메서드를 대신 사용합니다.\n\nDefaultSearchProviderImageURL을 설정하지 않은 상태로 두면 이미지 검색이 사용되지 않습니다.\n\n이미지 검색에 get 메서드가 사용되는 경우, URL은 다음 자리표시자의 유효한 조합을 사용하여 이미지 매개변수를 지정해야 합니다.\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'";
DefaultSearchProviderImageURLPostParams.pfm_title = "POST를 사용하는 이미지 URL용 매개변수";
DefaultSearchProviderImageURLPostParams.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있으면 DefaultSearchProviderImageURLPostParams 설정은 POST로 이미지를 검색할 때 사용하는 매개변수를 지정합니다. 이 매개변수는 쉼표로 구분된 이름 값의 쌍으로 구성됩니다. 값이 {imageThumbnail}과 같은 템플릿 매개변수면 실제 이미지 썸네일 데이터로 교체됩니다.\n\nDefaultSearchProviderImageURLPostParams를 설정하지 않은 상태로 두면 get 메서드를 사용해 이미지 검색 요청이 전송됩니다.\n\nURL은 검색 서비스 제공업체가 지원하는 항목에 따라 다음과 같은 자리표시자의 유효한 조합을 사용하여 이미지 매개변수를 지정해야 합니다.\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'";
DefaultSearchProviderKeyword.pfm_title = "기본 검색 공급자 키워드";
DefaultSearchProviderKeyword.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있으면 DefaultSearchProviderKeyword을(를) 설정할 경우 이 공급자의 검색을 트리거하기 위해 주소 표시줄에서 사용되는 키워드 또는 단축키를 지정합니다.\n\nDefaultSearchProviderKeyword를 설정하지 않으면 어떤 키워드도 검색 공급자를 활성화하지 않습니다.";
DefaultSearchProviderName.pfm_title = "기본 검색 공급자 이름";
DefaultSearchProviderName.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있으면 DefaultSearchProviderName 설정은 기본 검색 공급자의 이름을 지정합니다.\n\nDefaultSearchProviderName을 설정하지 않으면 검색 URL에서 지정된 호스트 이름이 사용됩니다.";
DefaultSearchProviderNewTabURL.pfm_title = "기본 검색 공급자 새 탭 페이지 URL";
DefaultSearchProviderNewTabURL.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있으면 DefaultSearchProviderNewTabURL을 설정하여 새 탭 페이지를 제공할 때 사용되는 검색엔진의 URL을 지정합니다.\n\nDefaultSearchProviderNewTabURL을 설정하지 않으면 새 탭 페이지가 제공되지 않습니다.";
DefaultSearchProviderSearchURL.pfm_title = "기본 검색 공급자 검색 URL";
DefaultSearchProviderSearchURL.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있는 경우 DefaultSearchProviderSearchURL을 설정하여 기본 검색에서 사용되는 검색엔진의 URL을 지정합니다. URL은 '{searchTerms}' 문자열을 포함해야 하며, 이 문자열은 쿼리 시 사용자의 검색어로 대체됩니다.\n\nGoogle 검색 URL은 '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'으로 지정할 수 있습니다.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "POST를 사용하는 검색 URL용 매개변수";
DefaultSearchProviderSearchURLPostParams.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있으면 DefaultSearchProviderSearchURLPostParams 설정은 POST로 URL을 검색할 때의 매개변수를 지정합니다. 이 매개변수는 쉼표로 구분된 이름 값의 쌍으로 구성됩니다. 값이 '{searchTerms}'와 같은 템플릿 매개변수면 실제 검색어 데이터로 교체됩니다.\n\nDefaultSearchProviderSearchURLPostParams를 설정하지 않으면 GET 메서드를 사용해 검색 요청이 전송됩니다.";
DefaultSearchProviderSuggestURL.pfm_title = "기본 검색 공급자 추천 URL";
DefaultSearchProviderSuggestURL.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있는 경우 DefaultSearchProviderSuggestURL을 설정하여 추천 검색어를 제공할 때 사용할 검색엔진의 URL을 지정합니다. URL은 '{searchTerms}' 문자열을 포함해야 하며, 이 문자열은 쿼리 시 사용자의 검색어로 대체됩니다.\n\nGoogle 검색 URL은 '{google:baseURL}complete/search?output=chrome&q={searchTerms}'로 지정할 수 있습니다.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "POST를 사용하는 추천 URL용 매개변수";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "DefaultSearchProviderEnabled가 사용 설정되어 있으면 DefaultSearchProviderSuggestURLPostParams 설정은 POST로 추천 검색어를 제공할 때의 매개변수를 지정합니다. 이 매개변수는 쉼표로 구분된 이름 값의 쌍으로 구성됩니다. 값이 '{searchTerms}'와 같은 템플릿 매개변수면 실제 검색어 데이터로 교체됩니다.\n\nDefaultSearchProviderSuggestURLPostParams를 설정하지 않으면 GET 메서드를 사용해 추천 검색어 요청이 전송됩니다.";
DefaultSensorsSetting.pfm_title = "기본 센서 설정";
DefaultSensorsSetting.pfm_description = "1 - 사이트에서 센서에 액세스하도록 허용\n2 - 모든 사이트에서 센서에 액세스하도록 허용 안함\n3 - 사이트에서 센서에 액세스하려고 할 때마다 확인\n정책을 1로 설정하면 웹사이트에서 움직임 감지 센서 및 조도 센서 등의 센서에 액세스하고 이러한 센서를 사용할 수 있습니다. 정책을 2로 설정하면 센서 액세스가 거부됩니다. 정책을 3으로 설정하면 삼중 상태 기능 플래그가 사용 설정된 경우 사이트에서 센서 액세스를 요청할 때 사용자에게 확인을 요청합니다. 그렇지 않으면 기본적으로 센서 액세스가 허용됩니다.\n\n정책을 설정하지 않으면 AllowSensors 정책이 적용되지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultSerialGuardSetting.pfm_title = "Serial API 사용 제어";
DefaultSerialGuardSetting.pfm_description = "2 - 모든 사이트에서 Serial API를 통한 직렬 포트 액세스를 요청하도록 허용 안함\n3 - 사이트에서 사용자에게 직렬 포트 액세스를 요청하도록 허용\n이 정책을 3으로 설정하면 웹사이트에서 직렬 포트 액세스를 요청할 수 있습니다. 정책을 2로 설정하면 직렬 포트 액세스를 거부합니다.\n\n정책을 설정하지 않으면 웹사이트에서 액세스를 요청할 수 있지만, 사용자가 이 설정을 변경할 수 있습니다.";
DefaultWebBluetoothGuardSetting.pfm_title = "Web Bluetooth API 사용 조정";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - 어떤 사이트든지 Web Bluetooth API를 통해 블루투스 기기에 대한 액세스를 요청하도록 허용하지 않습니다.\n3 - 사이트에서 사용자에게 근처 블루투스 기기에 대한 액세스 권한을 부여할 것인지 묻도록 허용합니다.\n정책을 3으로 설정하면 웹사이트에서 근처 블루투스 기기 액세스를 요청하도록 허용합니다. 정책을 2로 설정하면 근처 블루투스 기기 액세스를 거부합니다.\n\n정책을 설정하지 않으면 사이트의 액세스 요청이 허용되지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultWebHidGuardSetting.pfm_title = "WebHID API 사용 제어";
DefaultWebHidGuardSetting.pfm_description = "2 - 어느 사이트에서도 WebHID API를 통한 HID 기기 액세스 요청을 허용 안함\n3 - 사이트에서 사용자에게 HID 기기 액세스를 요청하도록 허용\n이 정책을 3으로 설정하면 웹사이트에서 HID 기기 액세스를 요청할 수 있습니다. 정책을 2로 설정하면 HID 기기 액세스가 거부됩니다.\n\n정책을 설정하지 않으면 웹사이트에서 액세스를 요청할 수 있지만, 사용자가 이 설정을 변경할 수 있습니다.\n\nWebHidAskForUrls 및 WebHidBlockedForUrls 정책을 사용하는 특정 url 패턴의 경우 이 정책보다 우선 적용될 수 있습니다.";
DefaultWebUsbGuardSetting.pfm_title = "WebUSB API 사용 조정";
DefaultWebUsbGuardSetting.pfm_description = "2 - 어떤 사이트든지 WebUSB API를 통해 USB 기기의 액세스를 요청하도록 허용하지 않습니다.\n3 - 사이트에서 사용자에게 연결된 USB 기기의 액세스 권한을 부여할지 묻도록 허용합니다.\n정책을 3으로 설정하면 웹사이트에서 연결된 USB 기기 액세스를 요청하도록 허용합니다. 정책을 2로 설정하면 연결된 USB 기기 액세스를 거부합니다.\n\n설정하지 않으면 웹사이트에서 액세스를 요청하도록 허용하지만 사용자가 이 설정을 변경할 수 있습니다.";
DefaultWindowManagementSetting.pfm_title = "기본 창 관리 권한 설정";
DefaultWindowManagementSetting.pfm_description = "2 - 기본적으로 모든 사이트에서 창 관리 권한 거부\n3 - 사이트에서 창 관리 권한을 얻을 때마다 확인\n정책을 BlockWindowManagement(값 2) 정책으로 설정하면 기본적으로 창 관리 권한이 사이트에 부여되지 않도록 자동으로 거부됩니다. 이렇게 하면 사이트에서 기기 화면에 관한 정보를 본 다음, 해당 정보를 사용하여 창을 열고 배치하거나 특정 화면에서는 전체 화면을 요청하는 기능이 제한됩니다.\n\n정책을 AskWindowManagement(값 3) 정책으로 설정하면 기본적으로 창 관리 권한이 요청될 때 사용자에게 메시지가 표시됩니다. 사용자가 권한을 허용하면 사이트에서 기기 화면에 관한 정보를 본 다음, 해당 정보를 사용하여 창을 열고 배치하거나 특정 화면에서는 전체 화면을 요청하는 기능이 확장됩니다.\n\n정책을 설정하지 않으면 AskWindowManagement 정책이 적용되어도 사용자가 이 설정을 변경할 수 있다는 것을 의미합니다.\n\n이는 지원 중단된 DefaultWindowPlacementSetting 정책을 대체합니다.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "복호화할 수 없는 비밀번호 삭제 사용 설정";
DeletingUndecryptablePasswordsEnabled.pfm_description = "이 정책은 기본 제공되는 비밀번호 관리자가 복호화할 수 없는 비밀번호를 데이터베이스에서 삭제할 수 있는지를 제어합니다. 기본 제공되는 비밀번호 관리자의 전체 기능을 복원하려면 이 정책이 필요하지만, 데이터가 영구적으로 손실될 수도 있습니다. 복호화할 수 없는 비밀번호 값은 자체적으로 복호화되지 않으며, 이러한 값을 수정할 수 있는 경우에는 주로 복잡한 사용자 작업이 요구됩니다.\n\n정책을 사용 설정하거나 설정하지 않은 상태로 두면 복호화할 수 없는 비밀번호를 내장된 비밀번호 관리자에 저장한 사용자는 비밀번호를 잃게 됩니다. 아직 작동 중인 상태의 비밀번호는 그대로 유지됩니다.\n\n이 정책을 사용 중지하면 사용자의 비밀번호 관리자 데이터는 그대로 유지되지만, 비밀번호 관리자 기능이 손상됩니다.\n\n정책을 설정하면 사용자가 Brave에서 이를 변경할 수 없습니다.";
DesktopSharingHubEnabled.pfm_title = "검색주소창과 점 3개 메뉴에서 데스크톱 공유 사용 설정";
DesktopSharingHubEnabled.pfm_description = "정책을 True로 설정하거나 설정하지 않으면 사용자가 데스크톱 공유 허브를 통해 제공되는 작업을 사용하여 현재 웹페이지를 저장하거나 공유할 수 있습니다. 공유 허브는 검색주소창 아이콘이나 점 3개 메뉴를 통해 액세스할 수 있습니다.\n\n정책을 False로 설정하면 검색주소창에서 공유 아이콘이 삭제되고 점 3개 메뉴의 항목도 삭제됩니다.";
DevToolsGenAiSettings.pfm_title = "Chrome DevTools 생성형 AI 기능 설정";
DevToolsGenAiSettings.pfm_description = "0 - Chrome DevTools 생성형 AI 기능을 허용하고 AI 모델을 개선합니다.\n1 - AI 모델을 개선하지 않고 Chrome DevTools 생성형 AI 기능을 허용합니다.\n2 - Chrome DevTools 생성형 AI 기능을 허용하지 않습니다.\nChrome DevTools의 이러한 기능은 생성형 AI 모델을 사용하여 추가 디버깅 정보를 제공합니다. 이러한 기능을 사용하려면 Brave에서 오류 메시지, 스택 트레이스, 코드 스니펫, 네트워크 요청과 같은 데이터를 수집하고 생성형 AI 모델을 실행하는 Google 소유의 서버로 이를 전송해야 합니다. 네트워크 요청의 응답 본문 또는 인증 및 쿠키 헤더는 서버로 전송되는 데이터에 포함되지 않습니다.\n\n0 = 이 기능을 사용하도록 허용하면서 Google에서 관련 데이터를 사용하여 AI 모델을 개선하도록 허용합니다. 관련 데이터에는 기능에 따라 프롬프트나 입력, 출력, 소스 자료, 서면 의견이 포함될 수 있습니다. AI 모델을 개선하기 위해 사람이 데이터를 검토할 수도 있습니다. 아래에 명시된 경우를 제외하고 0이 기본값입니다.\n\n1 = 기능을 사용하도록 허용하되 Google에서 사용자 콘텐츠(프롬프트, 입력, 출력, 소스 자료, 서면 의견 등)를 사용하여 모델을 개선하도록 허용하지 않습니다. 1은 Google Admin console에서 관리되는 기업 사용자 및 Google Workspace에서 관리되는 Education 계정의 기본값입니다.\n\n2 = 기능을 허용하지 않습니다.\n\n정책을 설정하지 않으면 GenAiDefaultSettings 정책에 따라 동작이 결정됩니다.\n\nChrome DevTools 생성형 AI 기능에는 다음이 포함됩니다.\n\n- 콘솔 통계: 콘솔 메시지를 설명하고, 콘솔 오류를 해결할 방법을 제안합니다.\n\n- AI 어시스턴스: CSS 스타일(버전 131 이상), 네트워크 요청, 성능, 파일(모두 버전 132 이상)을 이해하는 데 도움을 받습니다.\n\n생성형 AI 기능의 데이터 처리에 관한 자세한 내용은 https://support.google.com/chrome/a?p=generative_ai_settings 페이지를 참고하세요.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Chrome DevTools에서 Google Developer Program 프로필을 사용 설정합니다.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Chrome DevTools에서 Google Developer Program 통합을 사용 설정합니다.\n1 - Chrome DevTools에서 Google Developer Program 통합을 사용 설정하지만, 도구 사용량(배지 수여용)은 공유하지 않습니다.\n2 - Chrome DevTools에서 Google Developer Program 통합을 사용 설정하지 않습니다.\n이 정책은 Google Developer Program과 Chrome DevTools의 통합을 제어합니다. 사용자의 Google Developer Program 프로필이 Chrome DevTools에 표시되며 사용자는 Chrome DevTools 내에서 특정 작업을 수행하면 배지를 받습니다.\n\n정책을 0 - '사용 설정됨'으로 설정하거나 정책 값을 설정하지 않으면 Google Developer Program과 Chrome DevTools가 통합되고 배지를 수여할 수 있도록 Chrome DevTools 도구 사용량이 공유됩니다.\n\n정책을 1- '배지 없이 사용 설정됨'으로 설정하면 Google Developer Program과 Chrome DevTools의 통합은 허용되지만, Chrome DevTools 도구 사용량을 Google Developer Program과 공유하는 것은 허용되지 않으므로 배지는 수여되지 않습니다.\n\n정책을 2- '사용 중지됨'으로 설정하면 Google Developer Program과 Chrome DevTools를 통합할 수 없습니다.";
DeveloperToolsAvailability.pfm_title = "Chrome DevTools의 사용 가능 여부 제어";
DeveloperToolsAvailability.pfm_description = "0 - 기업 정책에 의해 설치된 앱 및 확장 프로그램에서 Chrome DevTools 사용을 금지하며, 버전 114 이상을 사용 중이며 관리 사용자인 경우 브라우저에 내장된 확장 프로그램에서도 사용이 금지됩니다. 다른 컨텍스트에서 Chrome DevTools 사용 허용\n1 - Chrome DevTools 사용 허용\n2 - Chrome DevTools 사용 허용 안함\n정책을 0(기본값)으로 설정하면 Chrome DevTools 및 JavaScript 콘솔에 액세스할 수 있지만 기업 정책으로 설치한 확장 프로그램의 컨텍스트나 버전 114 이상을 사용 중이며 관리 사용자인 경우 브라우저에 내장된 확장 프로그램의 컨텍스트에서는 액세스할 수 없습니다. 정책을 1로 설정하면 기업 정책으로 설치한 확장 프로그램을 비롯한 모든 컨텍스트에서 Chrome DevTools 및 JavaScript 콘솔에 액세스할 수 있습니다. 정책을 2로 설정하면 Chrome DevTools에 액세스할 수 없으며 웹사이트 요소를 검사할 수 없습니다.\n\n또한 이 설정은 Chrome DevTools 또는 JavaScript 콘솔을 여는 키보드 단축키, 메뉴 항목, 컨텍스트 메뉴 항목의 사용을 중지합니다.\n\nBrave 버전 99부터는 '페이지 소스 보기' 기능의 진입점도 제어합니다. 이 정책을 'DeveloperToolsDisallowed'(값 2)로 설정하면 사용자가 단축키 또는 컨텍스트 메뉴를 통해 소스 보기에 액세스할 수 없습니다. 소스 보기를 완전히 차단하려면 URLBlocklist 정책에 'view-source:*'도 추가해야 합니다.\n\nBrave 버전 119부터 이 설정으로 분리형 웹 앱의 개발자 모드 활성화 및 사용 여부도 제어할 수 있습니다.\n\nBrave 버전 128부터는 ExtensionDeveloperModeSettings 정책이 설정된 경우 이 설정으로 확장 프로그램 페이지의 개발자 모드를 제어할 수 없습니다.\n\n이 정책은 Chrome DevTools, 직접 Chrome DevTools 프로토콜(CDP) 액세스(예: --remote-debugging-port 또는 --remote-debugging-pipe로 실행된 경우), chrome.debugger API를 통한 Chrome DevTools 프로토콜(CDP) 액세스에 영향을 미칩니다. 이 정책과 RemoteDebuggingAllowed 정책이 모두 적용됩니다. RemoteDebuggingAllowed 정책은 원격 디버깅을 시작할 수 있는지 여부를 제어하는 반면, 이 정책은 원격 디버깅이 실행 중인 경우에도 개별 타겟을 검사할 수 있는지 여부를 제한합니다.\n\nDeveloperToolsAvailabilityAllowlist 및 DeveloperToolsAvailabilityBlocklist 정책이 이 정책보다 우선 적용됩니다. Chrome DevTools의 사용 가능 여부는 다음 우선순위로 결정됩니다.\n\n1. URL이 DeveloperToolsAvailabilityAllowlist 정책의 패턴과 일치하면 Chrome DevTools가 허용됩니다.\n2. DeveloperToolsAvailabilityAllowlist가 설정되고 DeveloperToolsAvailabilityBlocklist가 설정되지 않은 경우 허용 목록에 없는 모든 URL이 차단됩니다.\n3. URL이 DeveloperToolsAvailabilityBlocklist 정책의 패턴과 일치하면 Chrome DevTools가 차단됩니다.\n4. 두 정책이 모두 설정되지 않았거나 URL이 어느 목록과도 일치하지 않으면 이 정책(DeveloperToolsAvailability)이 대체 메커니즘으로 사용됩니다.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Chrome DevTools을(를) 여는 것이 허용되는 URL 패턴 목록";
DeveloperToolsAvailabilityAllowlist.pfm_description = "이 정책을 사용하여 특정 URL에서 Chrome DevTools를 허용할 수 있습니다.\n\nChrome DevTools 사용 가능 여부는 타겟 수준에서 평가됩니다. URL 패턴이 검사 중인 각 타겟(예: 페이지의 기본 프레임, 삽입된 서브프레임, 확장 프로그램, 웹 애플리케이션)의 URL과 일치합니다. DeveloperToolsAvailabilityBlocklist 정책도 설정되어 있는지에 따라 결과 동작이 달라집니다.\n\n이 정책이 설정되어 있고 DeveloperToolsAvailabilityBlocklist 정책은 설정되어 있지 않은 경우, 타겟에 대해 Chrome DevTools가 허용되려면 해당 타겟의 URL이 해당 허용 목록의 패턴과 일치해야 합니다. 타겟의 URL이 해당 허용 목록과 일치하지 않으면 해당 타겟에 대해 Chrome DevTools가 차단됩니다. 예를 들어 URL이 허용 목록에 없는 서브프레임은 검사할 수 없지만, URL이 허용 목록에 추가되어 있는 경우 기본 페이지는 계속 검사할 수 있습니다. URL 형식에 대한 정보는 https://support.google.com/chrome/a?p=url_blocklist_filter_format에서 확인하세요.\n\n이 정책과 DeveloperToolsAvailabilityBlocklist 정책이 모두 설정된 경우 이 허용 목록이 우선 적용됩니다. 타겟의 URL이 해당 허용 목록의 패턴과 일치하는 경우, 차단 목록의 패턴과도 일치하더라도 해당 URL은 허용됩니다. 타겟의 URL이 해당 차단 목록의 패턴과 일치하지만 허용 목록의 패턴과는 일치하지 않을 경우 차단됩니다. 타겟의 URL이 어느 쪽과도 일치하지 않으면 DeveloperToolsAvailability 정책이 대체 정책으로 사용됩니다.\n\n이 정책을 설정하지 않은 경우, DeveloperToolsAvailabilityBlocklist 및 DeveloperToolsAvailability 정책에 따라 Chrome DevTools의 사용 가능 여부가 결정됩니다.\n\n포괄적 호스트 와일드 카드(즉, '*' 또는 '[*]')는 허용되지 않습니다. 전체적으로 기능을 사용 설정하려면 DeveloperToolsAvailability 정책을 사용하세요.\n\n이 정책은 Chrome DevTools, 직접 Chrome DevTools 프로토콜(CDP) 액세스(예: --remote-debugging-port 또는 --remote-debugging-pipe로 실행된 경우), chrome.debugger API를 통한 Chrome DevTools 프로토콜(CDP) 액세스에 영향을 미칩니다. 이 정책과 RemoteDebuggingAllowed 정책이 모두 적용됩니다. RemoteDebuggingAllowed 정책은 원격 디버깅을 시작할 수 있는지 여부를 제어하는 반면, 이 정책은 원격 디버깅이 실행 중인 경우에도 개별 타겟을 검사할 수 있는지 여부를 제한합니다.\n\n정책의 항목은 1,000개로 제한됩니다.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Chrome DevTools이(가) 차단되는 URL 패턴 목록";
DeveloperToolsAvailabilityBlocklist.pfm_description = "이 정책을 사용하여 특정 URL에서 Chrome DevTools를 차단할 수 있습니다. URL 형식에 대한 정보는 https://support.google.com/chrome/a?p=url_blocklist_filter_format에서 확인하세요.\n\nChrome DevTools 사용 가능 여부는 타겟 수준에서 평가됩니다. URL 패턴이 검사 중인 각 타겟(예: 페이지의 기본 프레임, 삽입된 서브프레임, 확장 프로그램, 웹 애플리케이션)의 URL과 일치합니다. DeveloperToolsAvailabilityAllowlist 정책도 설정되어 있는지에 따라 결과 동작이 달라집니다.\n\n이 정책이 설정되어 있고 DeveloperToolsAvailabilityAllowlist 정책은 설정되어 있지 않은 경우 이 차단 목록의 패턴과 일치하는 타겟의 URL은 해당 타겟에 대해 Chrome DevTools를 차단합니다. 예를 들어 URL이 해당 차단 목록과 일치하는 서브프레임은 검사할 수 없지만, URL이 차단 목록에 포함되지 않은 경우 기본 페이지는 계속 검사할 수 있습니다. 타겟의 URL이 어떤 패턴과도 일치하지 않으면 DeveloperToolsAvailability 정책에 따라 사용 가능 여부가 결정됩니다.\n\n이 정책과 DeveloperToolsAvailabilityAllowlist 정책이 모두 설정된 경우 해당 허용 목록이 우선 적용됩니다. 타겟의 URL이 허용 목록의 패턴과 일치하는 경우, 이 차단 목록의 패턴과도 일치하더라도 해당 URL은 허용됩니다. 타겟의 URL이 해당 차단 목록의 패턴과 일치하지만 허용 목록의 패턴과는 일치하지 않을 경우 차단됩니다. 타겟의 URL이 어느 쪽과도 일치하지 않으면 DeveloperToolsAvailability 정책이 대체 정책으로 사용됩니다.\n\n이 정책을 설정하지 않은 경우, DeveloperToolsAvailabilityAllowlist 및 DeveloperToolsAvailability 정책에 따라 Chrome DevTools의 사용 가능 여부가 결정됩니다.\n\n이 정책은 Chrome DevTools, 직접 Chrome DevTools 프로토콜(CDP) 액세스(예: --remote-debugging-port 또는 --remote-debugging-pipe로 실행된 경우), chrome.debugger API를 통한 Chrome DevTools 프로토콜(CDP) 액세스에 영향을 미칩니다. 이 정책과 RemoteDebuggingAllowed 정책이 모두 적용됩니다. RemoteDebuggingAllowed 정책은 원격 디버깅을 시작할 수 있는지 여부를 제어하는 반면, 이 정책은 원격 디버깅이 실행 중인 경우에도 개별 타겟을 검사할 수 있는지 여부를 제한합니다.\n\n정책의 항목은 1,000개로 제한됩니다.";
Disable3DAPIs.pfm_title = "3D 그래픽 API 지원 사용 중지";
Disable3DAPIs.pfm_description = "정책을 True로 설정하거나 HardwareAccelerationModeEnabled 정책을 False로 설정하면 웹페이지에서 WebGL API에 액세스할 수 없습니다.\n\n정책을 False로 설정하거나 설정하지 않으면 웹페이지에서 WebGL API를 사용할 수 있지만, 이러한 API를 사용하려면 여전히 브라우저 기본 설정에 명령줄 인수가 필요할 수 있습니다.";
DisableAuthNegotiateCnameLookup.pfm_title = "Kerberos 인증을 협상할 때 CNAME 조회 사용 중지";
DisableAuthNegotiateCnameLookup.pfm_description = "정책을 사용으로 설정하면 CNAME 조회를 건너뜁니다. 서버 이름은 Kerberos SPN 생성 시 입력한 이름으로 사용됩니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 Kerberos SPN 생성 시 CNAME 조회로 서버의 표준 이름이 결정됩니다.";
DisablePrintPreview.pfm_title = "인쇄 미리보기 사용 안함";
DisablePrintPreview.pfm_description = "정책을 사용 설정하면 사용자가 인쇄를 요청할 때 Brave에서 내장 인쇄 미리보기 대신 시스템 인쇄 대화상자가 열립니다.\n\n정책을 사용 중지하거나 설정하지 않으면 인쇄 명령으로 인쇄 미리보기 화면이 실행됩니다.";
DisableSafeBrowsingProceedAnyway.pfm_title = "세이프 브라우징 경고 페이지 사용 중지";
DisableSafeBrowsingProceedAnyway.pfm_description = "이 정책을 사용으로 설정하면 사용자가 세이프 브라우징 서비스에서 표시하는 경고 페이지를 무시하고 악성 사이트로 이동할 수 없습니다. 하지만 사용자가 세이프 브라우징 경고(예: 멀웨어 및 피싱)를 무시할 수 없게 될 뿐, 잘못되거나 만료된 인증서 등의 SSL 인증서 관련 경고는 계속해서 무시할 수 있습니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 경고가 표시되더라도 사용자가 원하는 경우 신고된 사이트로 이동할 수 있습니다.\n\n세이프 브라우징에 관해 자세히 알아보세요(https://developers.google.com/safe-browsing).";
DisableScreenshots.pfm_title = "화면 캡쳐 사용 중지";
DisableScreenshots.pfm_description = "정책을 '사용'으로 설정하면 단축키나 확장 프로그램 API를 통해 스크린샷을 캡처할 수 없습니다. 정책을 설정하지 않거나 '사용 안함'으로 설정하면 스크린샷을 캡처할 수 있습니다.\n\nBrave 버전 154부터 이 정책을 사용 설정하면 확장 프로그램이 'chrome.debugger.attach()'를 통해 디버거를 연결할 수 없습니다.\n\n정책 설정과 관계없이 Microsoft® Windows®, macOS, Linux에서는 운영체제나 서드 파티 애플리케이션으로 찍은 스크린샷이 차단되지 않습니다.";
DiskCacheDir.pfm_title = "디스크 캐시 디렉터리 설정";
DiskCacheDir.pfm_description = "정책을 설정하면 Brave에서 사용자가 --disk-cache-dir 플래그를 지정한 여부와 관계없이 디스크에 캐시된 파일을 저장하는 데 제공된 디렉터리를 사용합니다.\n\n설정되지 않으면 Brave에서 기본 캐시 디렉터리를 사용하지만 사용자는 --disk-cache-dir 명령줄 플래그를 사용하여 해당 설정을 변경할 수 있습니다.\n\nBrave은 볼륨의 루트 디렉터리의 콘텐츠를 관리합니다. 따라서 데이터 손실 및 기타 오류를 방지하려면 이 정책을 루트 디렉터리나 기타 목적으로 사용되는 디렉터리로 설정해서는 안 됩니다. https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables에서 사용 가능한 변수를 확인할 수 있습니다.";
DiskCacheSize.pfm_title = "디스크 캐시 크기 설정";
DiskCacheSize.pfm_description = "정책을 None으로 설정하면 Brave에서 디스크에 캐시된 파일을 저장하는 데 기본 캐시 크기를 사용합니다. 사용자는 이 설정을 변경할 수 없습니다.\n\n정책을 설정하면 사용자가 --disk-cache-size 플래그를 지정했는지와 관계없이 Brave에서 내가 입력한 캐시 크기를 사용합니다. 몇 MB 이하의 값은 반올림됩니다.\n\n정책을 설정하지 않으면 Brave에서 기본 크기를 사용합니다. 사용자는 --disk-cache-size 플래그를 통해 기본 크기를 변경할 수 있습니다.\n\n참고: 이 정책에 지정된 값은 브라우저에서 다양한 캐시 하위 시스템의 힌트로 사용됩니다. 따라서 실제로는 모든 캐시의 총 디스크 소비량이 더 많지만, 지정된 값의 자릿수보다 크지는 않습니다.";
DnsOverHttpsMode.pfm_title = "DNS-over-HTTPS 모드 제어";
DnsOverHttpsMode.pfm_description = "off - DNS-over-HTTPS 사용 안함\nautomatic - 안전하지 않은 대체를 포함하여 DNS-over-HTTPS 사용\nsecure - 안전하지 않은 대체 없이 DNS-over-HTTPS 사용\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "원하는 DNS-over-HTTPS 리졸버의 URI 템플릿 지정";
DnsOverHttpsTemplates.pfm_description = "원하는 DNS-over-HTTPS 리졸버의 URI 템플릿입니다. 여러 개의 DNS-over-HTTPS 리졸버를 지정하려면 해당하는 URI 템플릿을 공백으로 구분하세요.\n\nDnsOverHttpsMode 정책을 \"secure\" 모드로 설정하면 이 정책을 설정해야 하며 비어있으면 안 됩니다. Google Chrome OS에만 이 정책 또는 DnsOverHttpsTemplatesWithIdentifiers 정책을 설정해야 합니다. 그러지 않으면 DNS 변환에 실패합니다.\n\nDnsOverHttpsMode 정책을 \"automatic\" 모드로 설정하고, 이 정책을 설정하면 지정된 URI 템플릿이 사용됩니다. 이 정책을 설정하지 않으면 하드코딩된 매핑이 사용되어 사용자의 현재 DNS 리졸버를 동일한 제공업체가 운영하는 DoH 리졸버로 업그레이드하려고 시도합니다.\n\nURI 템플릿에 dns 변수가 포함된 경우 리졸버에 관한 요청에서 GET 메서드를 사용하며, 그 외의 경우에는 POST 메서드를 사용합니다.\n\n잘못된 형식의 템플릿은 무시됩니다.";
DomainReliabilityAllowed.pfm_title = "도메인 안정성 관련 데이터 보고 허용";
DomainReliabilityAllowed.pfm_description = "정책을 False로 설정하면 도메인 안정성 진단 데이터 보고가 사용 중지되고 데이터가 Google로 전송되지 않습니다.\n정책을 True로 설정하거나 설정하지 않으면 도메인 안정성 진단 데이터 보고에서 Brave의 경우 MetricsReportingEnabled, Google Chrome OS의 경우 DeviceMetricsReportingEnabled 동작을 따릅니다.";
DownloadDirectory.pfm_title = "다운로드 디렉터리 설정";
DownloadDirectory.pfm_description = "정책을 설정하면 Chrome에서 파일을 다운로드할 때 사용하는 디렉터리가 설정됩니다. Chrome은 사용자가 디렉터리를 직접 지정하든 매번 다운로드 위치를 묻도록 플래그를 사용 설정하든 관계없이 제공된 디렉터리를 사용합니다.\n\n이 정책은 DefaultDownloadDirectory 정책보다 우선 적용됩니다.\n\n정책을 설정하지 않으면 Chrome에서 기본 다운로드 디렉터리를 사용하며 사용자가 이를 변경할 수 있습니다.\n\nGoogle Chrome OS에서는 Google Drive 디렉터리로만 설정되도록 하는 것이 가능합니다.\n\n참고: 다음 페이지에서 사용 가능한 변수를 확인하세요. https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables";
DownloadRestrictions.pfm_title = "다운로드 제한";
DownloadRestrictions.pfm_description = "0 - 특별한 제한이 없습니다. 기본값입니다.\n1 - 악성 다운로드와 위험한 파일 형식을 차단합니다.\n2 - 악성 다운로드, 비정상적이거나 원치 않는 다운로드, 위험한 파일 형식을 차단합니다.\n3 - 모든 다운로드를 차단합니다.\n4 - 악성 다운로드를 차단합니다. 권장사항입니다.\n정책을 설정하면 사용자가 다운로드 보안 관련 결정을 우회할 수 없습니다.\n\nChrome 내에서는 여러 가지 유형의 다운로드 경고가 표시되며, 이러한 경고는 크게 다음과 같은 카테고리로 나눌 수 있습니다. 세이프 브라우징의 평가에 관해 자세히 알아보세요. https://support.google.com/chrome/?p=ib_download_blocked):\n\n* 세이프 브라우징 서버에서 표시하는 악성 파일\n* 세이프 브라우징 서버에서 표시하는 비정상적인 파일 또는 원치 않는 파일\n* 위험한 파일 형식(예: 모든 SWF 다운로드 및 대부분의 EXE 다운로드)\n\n정책을 설정하면 정책 값에 따라 그에 해당하는 다운로드 하위 세트가 차단됩니다.\n\n0: 특별한 제한이 없습니다. 기본값입니다.\n\n1: 세이프 브라우징 서버에서 표시한 악성 파일 및 모든 위험한 파일 형식을 차단합니다. 거짓양성 평가 결과를 수용하기 쉬운 OU/브라우저/사용자에게만 권장됩니다.\n\n2: 세이프 브라우징 서버에서 표시한 악성 파일, 세이프 브라우징 서버에서 표시한 비정상적이거나 원치 않는 파일 및 모든 위험한 파일 형식을 차단합니다. 거짓양성 평가 결과를 수용하기 쉬운 OU/브라우저/사용자에게만 권장됩니다.\n\n3: 모든 다운로드를 차단합니다. 특별한 사용 사례가 아니라면 권장되지 않습니다.\n\n4: 세이프 브라우징 서버에서 표시한 악성 파일은 차단하지만 위험한 파일 형식은 차단하지 않습니다. 권장사항입니다.\n\n참고: 이러한 제한은 웹페이지 콘텐츠 또는 '다운로드 링크…' 메뉴 옵션을 통해 실행된 다운로드에 적용됩니다. 이러한 제한은 현재 표시된 페이지의 다운로드 또는 인쇄 옵션 중 'PDF로 저장'에는 적용되지 않습니다. 세이프 브라우징에 관해 자세히 알아보세요(https://developers.google.com/safe-browsing).";
EditBookmarksEnabled.pfm_title = "북마크 수정 사용 또는 사용 중지";
EditBookmarksEnabled.pfm_description = "정책을 사용 설정하거나 설정하지 않으면 사용자가 북마크를 추가, 삭제, 수정 또는 업로드할 수 있습니다.\n\n정책을 사용 중지하면 사용자가 북마크를 추가, 삭제, 수정 또는 업로드할 수 없습니다. 사용자는 계속해서 기존 북마크를 사용할 수 있습니다.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Kerberos SPN에 비표준 포트 포함";
EnableAuthNegotiatePort.pfm_description = "정책을 사용으로 설정하고 비표준 포트(즉, 80 또는 443이 아닌 포트)를 입력하면 생성된 Kerberos SPN에 포트가 포함됩니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 생성된 Kerberos SPN에 포트가 포함되지 않습니다.";
EnableExperimentalPolicies.pfm_title = "실험용 정책 사용 설정";
EnableExperimentalPolicies.pfm_description = "Brave에서 실험용 정책을 로드할 수 있도록 허용합니다.\n\n경고: 실험용 정책은 지원되지 않으며 브라우저의 향후 버전에서 고지 없이 변경되거나 삭제될 수 있습니다.\n\n실험용 정책은 미완성 상태일 수 있으며 알려지거나 알려지지 않은 결함을 포함할 수 있습니다. 공지 없이 변경되거나 삭제될 수도 있습니다. 실험용 정책을 사용 설정하면 인터넷 사용 기록이 손실되거나 보안이 악화되거나 개인 정보가 유출될 수도 있습니다.\n\n정책이 목록에 포함되어 있지 않고 공식적으로 출시되지 않았다면 그 값은 베타 및 공개 버전 채널에서 무시됩니다.\n\n정책이 목록에 포함되어 있고 공식적으로 출시되지 않았다면 그 값이 적용됩니다.\n\n이 정책은 이미 출시된 정책에는 영향을 미치지 않습니다.";
EnableMediaRouter.pfm_title = "Google Cast 사용";
EnableMediaRouter.pfm_description = "정책을 사용 설정하거나 설정하지 않은 상태로 두면 Google Cast가 사용 설정되며 사용자가 앱 메뉴, 페이지 컨텍스트 메뉴, Cast 지원 웹사이트의 미디어 컨트롤, Cast 툴바 아이콘(표시되는 경우)을 통해 실행할 수 있습니다.\n\n정책을 사용 중지하면 Google Cast가 사용 중지됩니다.";
EnableOnlineRevocationChecks.pfm_title = "온라인 OCSP/CRL 확인을 사용합니다.";
EnableOnlineRevocationChecks.pfm_description = "정책을 True로 설정하면 온라인 OCSP/CRL 확인 검사가 진행됩니다.\n\n정책을 False로 설정하거나 설정하지 않으면 Brave에서 Brave 19 이후에는 온라인 해지 확인 검사를 진행하지 않습니다.\n\n참고: OCSP/CRL 검사는 보안상 실질적인 이점이 없습니다.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "관리 사용자가 ProxyOverrideRules 및 ProxyProvisioningDomains 정책을 설정할 수 있는지 제어합니다.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "이 정책을 0으로 설정하거나 설정하지 않으면 관리 브라우저에서 연결된 사용자의 사용자 범위에만 ProxyOverrideRules 및 ProxyProvisioningDomains 정책이 적용됩니다.\n이 정책을 1로 설정하면 사용자가 연결되지 않았더라도 사용자 범위에서 ProxyOverrideRules 및 ProxyProvisioningDomains 정책이 적용됩니다.";
EnableUnsafeSwiftShader.pfm_title = "SwiftShader를 사용하여 소프트웨어 WebGL 대체 허용";
EnableUnsafeSwiftShader.pfm_description = "하드웨어 GPU 가속을 사용할 수 없는 경우 SwiftShader를 WebGL 대체로 사용할지 여부를 제어하는 정책입니다.\n\nSwiftShader는 헤드리스 시스템 또는 가상 머신과 같이 GPU 가속화가 없는 시스템에서 WebGL을 지원하는 데 사용되었지만 보안 문제로 인해 지원 중단되었습니다. M139부터는 SwiftShader를 사용했을 경우 WebGL 컨텍스트 생성이 실패합니다. 이 정책을 사용하면 브라우저 또는 관리자가 지원 중단을 일시적으로 연기할 수 있습니다.\n\n정책을 사용으로 설정하면 SwiftShader가 소프트웨어 WebGL 대체로 사용됩니다.\n\n정책을 사용 중지로 설정하거나 설정하지 않으면 하드웨어 GPU 가속을 사용할 수 없는 경우 WebGL 컨텍스트 생성이 실패할 수 있습니다. WebGL 컨텍스트 생성 실패를 적절하게 처리하지 않으면 웹페이지가 제대로 작동하지 않을 수 있습니다.\n\n이는 임시 정책으로 향후 삭제될 예정입니다.";
EncryptedClientHelloEnabled.pfm_title = "TLS Encrypted ClientHello 사용";
EncryptedClientHelloEnabled.pfm_description = "Encrypted ClientHello(ECH)는 ClientHello의 민감한 필드를 암호화하고 개인 정보 보호를 개선하기 위한 TLS의 확장 프로그램입니다.\n\n정책을 구성하지 않거나 사용으로 설정하면 Brave에서 ECH의 기본 출시 프로세스를 따릅니다. 사용 중지하면 Brave에서 ECH를 사용하지 않습니다.\n\n사용 설정된 경우 서버 지원, HTTPS DNS 레코드 사용 가능 여부 또는 출시 상태에 따라 Brave에서 ECH를 사용하거나 사용하지 않을 수 있습니다.\n\nECH는 발전 중인 프로토콜이므로 Brave 구현은 변경될 수 있습니다. 따라서 이 정책은 초기 실험 구현을 제어하기 위한 임시 조치입니다. 프로토콜이 확정되면 최종적인 제어 기능으로 대체됩니다.";
EnterpriseCustomLabel.pfm_title = "관리 프로필에 맞춤 기업 라벨 설정";
EnterpriseCustomLabel.pfm_description = "이 정책은 관리 프로필을 식별하는 데 사용되는 맞춤 라벨을 제어합니다. 관리 프로필의 경우 이 라벨이 툴바의 아바타 옆에 표시됩니다. 맞춤 라벨은 번역되지 않습니다.\n\n이 정책이 적용되면 16자를 초과하는 문자열은 '...'로 잘립니다. 긴 이름을 사용하지 마세요.\n\n이 정책은 사용자 정책으로만 설정할 수 있습니다.\n\nEnterpriseProfileBadgeToolbarSettings 정책이 hide_expanded_enterprise_toolbar_badge(값 1)로 설정되어 있으면 이 정책은 아무런 영향을 미치지 않습니다.";
EnterpriseCustomLabelForBrowser.pfm_title = "관리 브라우저에 맞춤 기업 라벨 설정";
EnterpriseCustomLabelForBrowser.pfm_description = "이 정책은 관리 브라우저를 나타내는 데 사용되는 맞춤 라벨을 제어합니다. 관리 브라우저의 경우 이 라벨은 새 탭 페이지 바닥글의 관리 면책 조항에 표시됩니다. 맞춤 라벨은 번역되지 않습니다.\n\n이 정책은 관리 브라우저에만 적용되므로 관리되지 않는 브라우저의 관리 사용자에게는 영향을 미치지 않습니다.\n\nMicrosoft® Windows®의 경우 이 정책은 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.\n\nmacOS의 경우 이 정책은 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "관리되는 확장 프로그램에서 Enterprise Hardware Platform API를 사용할 수 있도록 허용합니다.";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "정책을 True로 설정하면 기업 정책에 의해 설치된 확장 프로그램에서 Enterprise Hardware Platform API를 사용할 수 있습니다.\n\n정책을 False로 설정하거나 설정하지 않으면 확장 프로그램에서 이 API를 사용할 수 없습니다.\n\n참고: 이 정책은 행아웃 서비스 확장 프로그램과 같은 구성요소 확장 프로그램에도 적용됩니다.";
EnterpriseLogoUrl.pfm_title = "관리 프로필의 기업 로고 URL";
EnterpriseLogoUrl.pfm_description = "관리 프로필에 기업 배지로 사용될 이미지의 URL입니다. URL은 이미지를 가리켜야 합니다.\n\n이 정책은 사용자 정책으로만 설정할 수 있습니다.\n\n파비콘(예: https://www.google.com/favicon.ico) 또는 48x48픽셀 이상의 아이콘을 사용하는 것이 좋습니다.";
EnterpriseLogoUrlForBrowser.pfm_title = "관리 브라우저의 기업 로고 URL";
EnterpriseLogoUrlForBrowser.pfm_description = "관리 브라우저에 기업 배지로 사용될 이미지의 URL입니다. URL은 이미지를 가리켜야 합니다.\n\n파비콘(예: https://www.google.com/favicon.ico) 또는 48x48픽셀 이상의 아이콘을 사용하는 것이 좋습니다.\n\n이 정책은 관리 브라우저에만 적용되므로, 관리되지 않는 브라우저의 관리 사용자에게는 영향을 미치지 않습니다.\n\nMicrosoft® Windows®의 경우 이 정책은 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.\n\nmacOS의 경우 이 정책은 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "툴바에서 기업 프로필 배지의 공개 상태 제어";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - 확장된 기업 툴바 배지 표시\n1 - 확장된 기업 툴바 배지 숨기기\n직장 및 학교 프로필의 경우 기본적으로 툴바 아바타 옆의 툴바에 '직장' 또는 '학교' 라벨이 표시됩니다. 라벨은 로그인한 계정이 관리 계정인 경우에만 표시됩니다.\n\n정책을 hide_expanded_enterprise_toolbar_badge(값 1)로 설정하면 툴바에서 관리 프로필의 기업 배지가 숨겨집니다.\n\n정책을 설정하지 않거나 show_expanded_enterprise_toolbar_badge(값 0)로 설정하면 기업 배지가 표시됩니다.\n\nEnterpriseCustomLabel 정책을 통해 라벨을 맞춤설정할 수 있습니다.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "기본적으로 기업 프로필 생성 시 인터넷 사용 기록 유지";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "정책이 사용 설정되면 기업 프로필 생성 시 기존 인터넷 사용 기록을 유지하는 옵션이 기본적으로 선택됩니다.\n\n정책을 설정하지 않거나 사용 중지하면 기업 프로필 생성 시 기존 인터넷 사용 기록을 유지하는 옵션이 기본적으로 선택되지 않습니다.\n\n이 값과 관계없이 사용자는 기업 프로필을 만들 때 기존 인터넷 사용 기록을 유지할지 여부를 결정할 수 있습니다.\n\n기존 인터넷 사용 기록을 유지하는 옵션을 사용할 수 없는 경우 이 정책은 적용되지 않습니다. 이는 기업 프로필 분리가 엄격하게 적용되거나 데이터가 이미 관리된 프로필의 데이터인 경우에 발생합니다.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "엔터프라이즈 검색 애그리게이터 설정";
EnterpriseSearchAggregatorSettings.pfm_description = "이 정책을 통해 관리자는 새 탭 페이지의 검색주소창(주소 표시줄) 및 검색창에서 검색 추천 및 결과를 제공하는 지정된 엔터프라이즈 검색 애그리게이터를 설정할 수 있습니다.\n\n기본적으로 엔터프라이즈 추천 검색어가 일반 Brave 추천과 함께 혼합되어 표시됩니다. 사용자는 검색주소창에 @ 접두사(예: @work)를 포함하거나 제외한 상태로 shortcut 필드에 지정된 키워드를 입력한 다음 스페이스바 또는 Tab 키를 눌러 검색 범위를 엔터프라이즈 검색 애그리게이터로 명시적으로 지정할 수 있습니다. 범위가 지정된 엔터프라이즈 검색(키워드로 트리거됨)은 현재 새 탭 페이지의 검색창이 아닌 검색주소창에서만 지원됩니다.\n\nname, shortcut, search_url, suggest_url 입력란은 필수입니다.\n\nname 입력란은 주소 표시줄에서 사용자에게 표시되는 검색엔진 이름에 해당합니다.\n\nshortcut 입력란은 사용자가 입력하여 검색을 트리거하는 키워드에 해당합니다. 단축어는 일반 단어와 문자를 포함할 수 있지만 공백을 포함하거나 @ 기호로 시작할 수 없습니다. 단축어는 고유해야 합니다.\n\nsearch_url 필드는 검색할 URL을 지정합니다. 검색엔진의 검색 결과 페이지 웹 주소를 입력하고 검색어가 있을 자리에 '{searchTerms}'를 사용합니다.\n\nsuggest_url 필드는 추천 검색어를 제공하는 URL을 지정합니다. POST 요청이 생성되고 사용자의 쿼리가 'query' 키 아래의 POST 매개변수에 전달됩니다.\n\nicon_url 필드는 추천 검색어에 사용될 이미지의 URL을 지정합니다. 이 필드가 설정되지 않은 경우 기본 아이콘이 사용됩니다. 파비콘(https://www.google.com/favicon.ico)을 사용하는 것이 좋습니다. 지원되는 이미지 파일 형식은 JPEG, PNG, ICO입니다.\n\nrequire_shortcut 필드는 검색 추천을 보려면 shortcut 주소 표시줄이 필요한지를 지정합니다. 필요한 경우 새 탭 페이지의 검색창에는 추천이 표시되지 않지만, 범위 지정된 검색 모드에서는 검색주소창(주소 표시줄)에 계속 표시됩니다. 이 필드를 설정하지 않으면 shortcut 주소 표시줄이 필요하지 않습니다.\n\nMicrosoft® Windows®의 경우 이 정책은 Microsoft® Active Directory® 도메인에 조인되거나, Microsoft® Azure® Active Directory®에 조인되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.\n\nmacOS의 경우 이 정책은 MDM을 통해 관리되거나, MCX를 통해 도메인에 조인되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings 페이지를 참조하세요.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "도메인에서 특정 파일 형식에 관한 파일 형식 확장자 기반 다운로드 경고 사용 중지";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "이 정책을 사용 설정하면 파일 형식 확장자 기반 다운로드 경고에서 제외될 도메인 목록에 상응하는 파일 형식 확장자 사전을 만들 수 있습니다. 이렇게 하면 기업 관리자가 목록에 있는 도메인과 연결된 파일에 대해 파일 형식 확장자 기반 다운로드 경고를 차단할 수 있습니다. 예를 들어 'jnlp' 확장자가 'website1.com'과 연결된 경우 사용자가 'website1.com'에서 'jnlp' 파일을 다운로드할 때는 경고가 표시되지 않지만 'website2.com'에서 'jnlp' 파일을 다운로드하면 다운로드 경고가 표시됩니다.\n\n이 정책에 의해 식별된 도메인에 지정된 파일 형식 확장자를 갖는 파일이라고 할지라도 혼합 콘텐츠 다운로드 경고 및 세이프 브라우징 경고 등 파일 형식 확장자에 기반하지 않는 보안 경고는 계속 표시됩니다.\n\n이 정책을 사용 중지하거나 구성하지 않으면 확장자 기반 다운로드 경고를 트리거하는 형식의 파일을 다운로드할 때 경고가 사용자에게 표시됩니다.\n\n이 정책을 사용 설정하는 경우:\n\n* https://chromeenterprise.google/policies/url-patterns/에 따라 URL 패턴 형식이 지정되어야 합니다.\n\n* 파일 형식 확장자는 소문자 ASCII로 입력되어야 합니다. 파일 형식 확장자를 나열할 때 선행 구분자가 포함되어서는 안 됩니다. '.jnlp' 대신 'jnlp'로 표시하세요.\n\n예:\n\n다음의 예시 값을 사용하면 *.example.com 도메인의 'exe' 및 'jnlp' 확장자와 모든 도메인의 'swf' 확장자에 관한 파일 형식 확장자 기반 다운로드 경고가 표시되지 않습니다. 다른 도메인에서는 exe 및 jnlp 파일에 관한 파일 형식 확장자 기반 다운로드 경고가 표시되지만, swf 파일의 경우 표시되지 않습니다.\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\n앞선 예시에서는 모든 도메인에서 'swf' 파일에 대한 파일 형식 확장자 기반 다운로드 경고가 표시되지 않습니다. 그러나 모든 도메인에서 위험한 파일 형식 확장자에 관한 경고를 차단하는 것은 보안 우려가 있으므로 권장되지 않습니다. 단지 이러한 경우도 가능하다는 것을 보여주기 위해 포함된 예시입니다.\n\n이 정책이 DownloadRestrictions와 함께 사용 설정되면, 이 정책에 의해 지정된 파일 형식 확장자 기반 경고의 예외가 위험한 파일 형식을 차단할 DownloadRestrictions 설정보다 우선합니다. 이 정책에 의해 지정된 예외는 DownloadRestrictions의 값 1과 2로 지정된 '위험한 파일 형식 차단' 동작에만 적용됩니다.\n\n예를 들어 이 정책이 'website1.com'에서의 'exe' 다운로드에 대한 예외를 지정하고 DownloadRestrictions가 악성 다운로드 및 위험한 파일 형식을 차단하도록 설정된 경우(값 1), 'website1.com'에서의 'exe' 다운로드는 파일 형식 확장자 기반 차단에서 제외되지만 악성인 경우에는 계속 차단됩니다.\n\nDownloadRestrictions에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=DownloadRestrictions 페이지를 참고하세요.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings 페이지를 참조하세요.";
ExplicitlyAllowedNetworkPorts.pfm_title = "명시적으로 허용된 네트워크 포트";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - 포트 554(2021년 10월 15일까지 차단 해제될 수 있음)\n10080 - 포트 10080(2022년 4월 1일까지 차단 해제될 수 있음)\n6566 - 포트 6566(2021년 10월 15일까지 차단 해제될 수 있음)\n989 - 포트 989(2022년 2월 1일까지 차단 해제될 수 있음)\n990 - 포트 990(2022년 2월 1일까지 차단 해제될 수 있음)\nBrave에는 제한된 포트 목록이 내장되어 있습니다. 이 포트에는 연결이 되지 않습니다. 이 설정은 제한된 포트 목록을 우회하는 것을 허용합니다. 값은 쉼표로 구분된 목록으로, 발신 연결이 허용될 0개 이상의 포트가 나열됩니다.\n\nBrave이 여러 가지 네트워크 취약점을 오남용하기 위한 수단으로 이용되는 것을 방지하기 위해 포트 사용이 제한됩니다. 정책을 설정하면 네트워크가 공격에 노출될 수도 있습니다. 이 정책은 차단된 포트에서 실행되는 서비스를 일반 포트(포트 80 또는 443)로 이전하는 동안 발생하는 'ERR_UNSAFE_PORT' 코드 오류를 해결하기 위한 일시적인 방법으로 사용됩니다.\n\n악성 웹사이트는 이 정책의 설정 여부 및 정책이 설정된 포트를 간단히 탐지할 수 있으며, 이 정보를 사용해 표적 공격을 실행할 수 있습니다.\n\n여기에 표시된 각각의 포트에는 차단을 해제할 수 있는 기한의 날짜가 라벨로 표시되어 있습니다. 이 날짜가 지나면 설정과 관계없이 포트가 제한됩니다.\n\n값을 비워 두거나 설정하지 않으면 제한된 모든 포트가 차단됩니다. 유효한 값과 잘못된 값이 섞여 있으면 유효한 값이 적용됩니다.\n\n이 정책은 '--explicitly-allowed-ports' 명령줄 옵션보다 우선 적용됩니다.";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "브라우저에 확장 가능한 엔터프라이즈 SSO를 사용할 수 없는 ID 공급업체의 차단 목록";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - 모든 ID 공급업체\nmicrosoft - Microsoft® 클라우드 ID 공급업체\nokta - Okta® 클라우드 ID 공급업체\nping - Ping® 클라우드 ID 공급업체\n나열된 ID 공급업체에서 Extensible Enterprise SSO를 사용한 싱글 사인온(SSO)을 사용 중지합니다.\n\n'all' 값을 추가하면 SSO에 대해 지원되는 모든 ID 공급업체가 사용 중지됩니다.\n\n'microsoft' 값을 추가하면 Chrome에서 Microsoft® 클라우드 ID 공급업체에 대한 싱글 사인온(SSO) 지원이 중지됩니다.\n\n이 정책을 설정하지 않으면 Brave에서 지원하는 모든 ID 공급업체가 사용 설정됩니다.\n\nBrave에서 사용 설정되어 있고 관리자가 기기에서 구성한 ID 공급업체의 경우, Extensible Enterprise SSO를 지원하는 애플리케이션에서 해당 ID 공급업체를 사용하여 한 번 로그인한 사용자는 해당 ID 공급업체를 사용하여 웹 서비스에 자동으로 로그인할 수 있습니다. 각 인증 이벤트의 사용자 인증 정보 관련 정보가 사용자의 클라우드 ID 공급업체로 전송됩니다.\n\n참고:\n\nBrave에서는 시크릿 모드 또는 게스트 모드에서 Extensible Enterprise SSO를 사용한 싱글 사인온(SSO)을 지원하지 않습니다.\n\nBrave에서는 Microsoft, Okta, Ping과 같은 ID 공급업체에 대해 Extensible Enterprise SSO를 사용한 싱글 사인온(SSO)만 지원합니다.\n\n이 기능은 macOS 10.15부터 사용할 수 있습니다.";
ExtensionAllowedTypes.pfm_title = "설치가 허용된 확장 프로그램/앱 유형";
ExtensionAllowedTypes.pfm_description = "extension - 확장 프로그램\ntheme - 테마\nuser_script - 사용자 스크립트\nhosted_app - 호스팅된 앱\nlegacy_packaged_app - 이전 패키지 앱\nplatform_app - 플랫폼 앱\n이 정책을 설정하여 Brave에 설치할 수 있는 앱 및 확장 프로그램과 상호작용 가능한 호스트를 관리하고 런타임 액세스를 제한합니다.\n\n정책을 설정하지 않으면 허용되는 확장 프로그램과 앱 유형에는 제한이 적용되지 않습니다.\n\n목록에 없는 유형인 확장 프로그램과 앱은 설치되지 않습니다. 각 값은 다음 문자열 중 하나여야 합니다.\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\n이러한 유형에 관한 자세한 정보는 Brave 확장 프로그램 문서를 참고하세요.\n\n쉼표로 구분되는 확장 프로그램 ID를 여러 개 사용하는 75 이전 버전은 지원되지 않으며 건너뛰게 됩니다. 정책의 나머지 부분은 적용됩니다.\n\n참고: 이 정책은 ExtensionInstallForcelist로 강제 설치되는 확장 프로그램과 앱에도 영향을 미칩니다.\n\n참고: 이 정책은 확장 프로그램을 지원하는 플랫폼에만 적용됩니다.";
ExtensionDeveloperModeSettings.pfm_title = "확장 프로그램 페이지에서 개발자 모드의 사용 가능 여부 제어";
ExtensionDeveloperModeSettings.pfm_description = "0 - 확장 프로그램 페이지에서 개발자 모드의 사용 허용\n1 - 확장 프로그램 페이지에서 개발자 모드의 사용 허용 안함\n사용자가 chrome://extensions에서 개발자 모드를 사용 설정할 수 있는지 제어합니다.\n\n정책을 설정하지 않으면 DeveloperToolsAvailability 정책이 DeveloperToolsDisallowed(2)로 설정되어 있지 않은 한 사용자가 확장 프로그램 페이지에서 개발자 모드를 사용 설정할 수 있습니다.\n정책을 Allow(0)로 설정하면 사용자가 확장 프로그램 페이지에서 개발자 모드를 사용 설정할 수 있습니다.\n정책을 Disallow(1)로 설정하면 사용자가 확장 프로그램 페이지에서 개발자 모드를 사용 설정할 수 없습니다.\n\n이 정책을 설정하면 DeveloperToolsAvailability로는 더 이상 확장 프로그램 개발자 모드를 제어할 수 없습니다.\n\n참고: 이 정책은 확장 프로그램을 지원하는 플랫폼에만 적용됩니다.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "연결 확장 프로그램에 백그라운드 시간 연장을 제공하는 출처 목록을 구성합니다.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "이러한 출처 중 하나와 연결되는 확장 프로그램은 포트가 연결되어 있는 한 계속 실행됩니다.\n\n정책을 설정하지 않으면 정책의 기본값이 사용됩니다. 이전 상태에 대한 닫힌 연결을 다시 시작할 수 없는 것으로 알려진 SDK를 제공하는 앱 출처는 다음과 같습니다.\n- 스마트 카드 커넥터\n- Citrix Receiver(공개, 베타, 백업)\n- VMware Horizon(공개, 베타)\n\n정책이 설정되면 기본값 목록이 확장되어 새로 구성된 값이 포함됩니다. 포트가 연결되어 있는 한 기본값 및 정책 제공 항목 모두 연결 확장 프로그램에 예외를 부여합니다.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "기본 검색 또는 새 탭 페이지 설정을 재정의하는 정책 설치 확장 프로그램 사용 설정";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "신뢰도가 낮은 환경에서 기본 검색엔진 또는 새 탭 페이지 설정을 재정의하는 정책 설치 확장 프로그램(강제 설치 또는 권장)이 허용되는지 여부를 제어합니다.\n\n이 정책은 신뢰도가 낮은 환경(예: 도메인 또는 클라우드 관리 없이 로컬에서 정책이 구성되는 기기)에만 적용됩니다. 신뢰도가 높은 환경은 영향을 받지 않습니다.\n\nMicrosoft® Windows®의 경우 이 정책은 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서 사용할 수 없습니다.\n\nmacOS의 경우 이 정책은 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서 사용할 수 없습니다.\n\n이러한 신뢰도가 높은 인스턴스에서는 기본 검색엔진 또는 새 탭 페이지 설정을 재정의하는 정책 설치 확장 프로그램이 사용 설정된 상태로 유지됩니다.\n\n사용 설정하면 Brave에서 기본 검색엔진 또는 새 탭 페이지 설정을 재정의하는 정책 설치 확장 프로그램을 설치하고 신뢰도가 낮은 환경에서 사용 설정된 상태로 유지할 수 있습니다.\n\n사용 중지하거나 구성하지 않으면 Brave에서 기본 검색엔진 또는 새 탭 페이지 설정을 재정의하는 정책 설치 확장 프로그램이 신뢰도가 낮은 환경에 설치되지 않도록 하고, 이미 설치된 경우 삭제합니다.\n\n해당 확장 프로그램이 더 이상 이러한 설정을 재정의하지 않도록 업데이트되면 Brave에서 7일 이내에 자동으로 설치합니다.\n\n이 정책은 일시적인 조치이며 향후 버전에서 삭제될 예정입니다.";
ExtensionInstallAllowlist.pfm_title = "차단 목록에서 제외할 확장 프로그램 ID";
ExtensionInstallAllowlist.pfm_description = "정책을 설정하면 차단 목록의 대상이 아닌 확장 프로그램이 지정됩니다.\n\n차단 목록의 * 값은 모든 확장 프로그램이 차단되며 사용자는 허용 목록에 있는 확장 프로그램만 설치할 수 있다는 의미입니다.\n\n기본적으로 모든 확장 프로그램이 허용됩니다. 그러나 정책으로 확장 프로그램을 금지한 경우 정책을 변경하려면 허용되는 확장 프로그램 목록을 사용합니다.\n\n참고: 이 정책은 확장 프로그램을 지원하는 플랫폼에만 적용됩니다.";
ExtensionInstallBlocklist.pfm_title = "사용자가 설치할 수 없는 확장 프로그램 ID(또는 전체 확장 프로그램의 경우 *)";
ExtensionInstallBlocklist.pfm_description = "사용자가 설치하지 못하는 확장 프로그램을 지정할 수 있습니다. 이미 설치된 확장 프로그램이 차단된 경우 사용 중지되며, 사용자가 사용 설정할 방법은 없습니다. 차단 목록에 포함되어 사용 중지되었던 확장 프로그램이 차단 목록에서 삭제되면 자동으로 다시 사용 설정됩니다.\n\n차단 목록의 '*' 값은 모든 확장 프로그램이 기본적으로 차단됨을 의미합니다. 허용 목록에 명시적으로 나열된 확장 프로그램은 서명(압축)된 경우 허용됩니다. 압축해제된 모든 확장 프로그램은 차단됩니다.\n\n이 정책을 설정하지 않으면 사용자는 Brave의 모든 확장 프로그램을 설치할 수 있습니다.\n\n참고: 이 정책은 확장 프로그램을 지원하는 플랫폼에만 적용됩니다.";
ExtensionInstallForcelist.pfm_title = "자동으로 설치되는 확장 프로그램/앱 ID와 업데이트 URL";
ExtensionInstallForcelist.pfm_description = "이 정책을 설정하면 사용자 상호작용 없이 자동으로 설치되는 앱 및 확장 프로그램 목록이 지정되며, 사용자가 Brave 인터페이스를 통해 제거하거나 사용 중지할 수 없습니다. enterprise.deviceAttributes 및 enterprise.platformKeys 확장 프로그램 API의 권한을 비롯한 권한은 암시적으로 부여됩니다. (이 2개의 API는 강제 설치되지 않은 앱과 확장 프로그램에서는 사용할 수 없습니다.)\n\nBrave에서는 사용자가 이러한 확장 프로그램을 제거하지 못하도록 차단하고자 하지만, 일부 운영체제의 경우 외부에서 수정되는 확장 프로그램을 Brave에서 강력하게 방어할 수 없으므로 이와 같은 방지가 최선의 노력입니다.\n\n정책을 설정하지 않으면 앱 또는 확장 프로그램이 자동 설치되지 않으며 사용자는 Brave에서 모든 앱 또는 확장 프로그램을 제거할 수 있습니다.\n\n이 정책은 ExtensionInstallBlocklist 정책을 대체합니다. 기존에 강제 설치된 앱 또는 확장 프로그램은 이 목록에서 삭제되며 Brave에서 자동으로 제거됩니다.\n\n모든 확장 프로그램의 소스 코드는 사용자가 개발자 도구를 통해 변경 가능하며, 이 과정에서 확장 프로그램 오작동이 발생할 수 있습니다. 이 점이 우려된다면 DeveloperToolsDisabled 정책을 설정하세요.\n\n정책의 각 목록 항목은 세미콜론(;)으로 구분된 확장 프로그램 ID 및 업데이트 URL(선택사항)로 구성된 문자열입니다. 확장 프로그램 ID는 32자리 문자열로, 예를 들어 개발자 모드일 때 chrome://extensions에서 확인할 수 있습니다. 업데이트 URL을 지정하는 경우 업데이트 매니페스트 XML 문서(https://developer.chrome.com/extensions/autoupdate)로 연결되어야 합니다. 업데이트 URL은 http, https 또는 file 스키마 중 하나를 사용해야 합니다. 기본적으로 Chrome 웹 스토어의 업데이트 URL이 사용됩니다. 정책에 설정된 업데이트 URL은 최초 설치 시에만 사용되며 향후 확장 프로그램 업데이트에서는 확장 프로그램 매니페스트에 있는 업데이트 URL이 사용됩니다. 후속 업데이트를 위한 업데이트 URL은 ExtensionSettings 정책을 사용하여 재정의할 수 있습니다. http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy를 참고하세요.\n\nMicrosoft® Windows® 인스턴스의 경우 인스턴스가 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 경우에만 Chrome 웹 스토어 외부의 앱 및 확장 프로그램이 강제 설치될 수 있습니다.\n\nmacOS 인스턴스의 경우 인스턴스가 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 경우에만 Chrome 웹 스토어 외부의 앱 및 확장 프로그램이 강제 설치될 수 있습니다.\n\n참고: 이 정책은 시크릿 모드에는 적용되지 않습니다. 확장 프로그램 호스팅에 관해 자세히 알아보세요(https://developer.chrome.com/extensions/hosting).\n\n참고: 이 정책은 확장 프로그램을 지원하는 플랫폼에만 적용됩니다.";
ExtensionInstallSources.pfm_title = "확장 프로그램, 앱, 사용자 스크립트 설치 등을 허용하는 URL 패턴";
ExtensionInstallSources.pfm_description = "정책을 설정하여 확장 프로그램, 앱, 테마를 설치할 수 있는 URL을 지정합니다. Brave 21 이전에는 사용자가 *.crx 파일 링크를 클릭하면 Brave에서 몇 가지 경고 후 파일을 설치하도록 허용했습니다. 이후에는 파일을 다운로드하여 Brave 설정 페이지로 드래그해야 합니다. 이 설정을 사용하면 특정 URL에서 더 간편한 기존의 설치 과정을 따를 수 있습니다.\n\n이 목록에 있는 각 항목은 확장 프로그램 스타일의 일치 패턴입니다(https://developer.chrome.com/extensions/match_patterns 참고). 사용자는 목록의 항목과 일치하는 모든 URL에서 항목을 쉽게 설치할 수 있습니다. *.crx 파일과 다운로드 시작 페이지(예: 리퍼러)의 위치는 이러한 패턴에 따라 허용되어야 합니다.\n\nExtensionInstallBlocklist가 이 정책보다 우선적으로 적용됩니다. 즉, 이 목록의 사이트에서 설치하더라도 차단 목록에 있는 확장 프로그램은 설치되지 않습니다.\n\n참고: 이 정책은 확장 프로그램을 지원하는 플랫폼에만 적용됩니다.";
ExtensionInstallTypeBlocklist.pfm_title = "확장 프로그램 설치 유형 차단 목록";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - 확장 프로그램이 명령줄에서 로드되지 않도록 차단\n차단 목록은 허용되지 않는 확장 프로그램 설치 유형을 설정합니다.\n\n'command_line'을 설정하면 명령줄에서 확장 프로그램이\n로드되지 않습니다.";
ExtensionReviewPromptsEnabled.pfm_title = "확장 프로그램 리뷰 프롬프트 및 평점 링크 제어";
ExtensionReviewPromptsEnabled.pfm_description = "설치된 Chrome 확장 프로그램의 기본 리뷰 프롬프트 및 평점 링크('평가하기' 등)를 Chrome 사용자 인터페이스에서 사용할 수 있는지 제어합니다.\n\n이 정책을 사용 설정하거나 설정하지 않으면 사용자가 툴바, 컨텍스트 메뉴, 확장 프로그램 관리 페이지(chrome://extensions)에서 요건을 충족하는 확장 프로그램을 검토하고 평가하기 위한 기본 진입점을 확인할 수 있습니다.\n\n정책을 사용 중지로 설정하면 모든 기본 리뷰 프롬프트 및 평점 링크가 표시되지 않으며 사용할 수 없게 됩니다.";
ExtensionSettings.pfm_title = "확장 프로그램 관리 설정";
ExtensionSettings.pfm_description = "정책을 설정하면 기존 확장 프로그램 관련 정책으로 제어되는 설정을 포함해 Brave의 확장 프로그램 관리 설정을 제어할 수 있습니다.\n\n이 정책은 확장 프로그램 ID 또는 업데이트 URL을 특정 설정에만 매핑합니다. 특수 ID \"*\"에 기본 구성을 설정할 수 있으며, 정책에서 맞춤 구성이 설정되지 않은 모든 확장 프로그램에 기본 구성이 적용됩니다.\n\n이 정책은 기존 정책의 확장 프로그램별 구성보다 우선될 수 있습니다.\n\nExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist 또는 ExtensionSettings의 ID별 확장 프로그램 설정은 \"*\" 기본값에서 'installation_mode' 및 'update_url'만 상속받습니다. 다른 속성은 상속받지 않습니다. 업데이트 URL이 있으면 구성은 확장 프로그램 매니페스트(http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy)에 규정된 정확한 업데이트 URL을 포함하는 확장 프로그램에 적용됩니다. 'override_update_url' 플래그가 true로 설정된 경우 ExtensionInstallForcelist 정책 또는 이 정책의 'update_url' 필드에 지정된 'update' URL을 사용하여 확장 프로그램이 설치 및 업데이트됩니다. 'update_url'이 Chrome 웹 스토어 url인 경우 'override_update_url' 플래그가 무시됩니다.\n\nBrave 버전 154부터 'debugger' 권한이 있는 확장 프로그램에 'runtime_blocked_hosts'를 적용하면 모든 타겟에서 'chrome.debugger.attach()'가 완전히 사용 중지됩니다.\n\nMicrosoft® Windows® 인스턴스의 경우 인스턴스가 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 경우에만 Chrome 웹 스토어 외부의 앱 및 확장 프로그램이 강제 설치될 수 있습니다.\n\nmacOS 인스턴스의 경우 인스턴스가 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 경우에만 Chrome 웹 스토어 외부의 앱 및 확장 프로그램이 강제 설치될 수 있습니다.\n\n참고: 이 정책은 확장 프로그램을 지원하는 플랫폼에만 적용됩니다.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=ExtensionSettings 페이지를 참조하세요.";
ExtensionUnpublishedAvailability.pfm_title = "Chrome 웹 스토어에서 게시 취소된 확장 프로그램의 사용 가능 여부를 제어합니다.";
ExtensionUnpublishedAvailability.pfm_description = "0 - 게시 취소된 확장 프로그램 허용\n1 - 게시가 취소된 확장 프로그램 사용 중지\n정책을 사용 설정하면 Brave에서 Chrome 웹 스토어에서 게시 취소된 확장 프로그램이 사용 중지됩니다.\n이 정책은 Chrome 웹 스토어에서 설치 및 업데이트된 확장 프로그램에만 적용됩니다.\n\n개발자 모드를 사용하여 설치되는 압축해제된 확장 프로그램 및 명령줄 전환을 사용하여 설치된 확장 프로그램 등 스토어 외부에서 설치된 확장 프로그램은 무시됩니다.\n강제 설치되었으며 자체 호스팅되는 확장 프로그램은 무시됩니다. 모든 버전 고정 확장 프로그램도 무시됩니다.\n\n정책을 AllowUnpublished(0)(으)로 설정하거나 설정하지 않으면 Chrome 웹 스토어에서 게시 취소된 확장 프로그램을 사용할 수 있습니다.\n정책을 DisableUnpublished(1)(으)로 설정하면 Chrome 웹 스토어에서 게시 취소된 확장 프로그램이 사용 중지됩니다.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "외부 프로토콜 대화상자에 '항상 열기' 체크박스 표시";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "이 정책은 '항상 열기' 체크박스를 외부 프로토콜 시작 확인 메시지에 표시할지 제어합니다.\n\n     이 정책이 True로 설정되거나 설정되지 않으면 외부 프로토콜 확인이 표시될 경우 사용자는 '항상 허용'을 선택하여 이 사이트에 있는 프로토콜의 향후 모든 확인 메시지를 건너뛸 수 있습니다.\n\n     이 정책이 False로 설정되면 '항상 허용' 체크박스가 표시되지 않고 외부 프로토콜이 호출될 때마다 사용자에게 메시지가 표시됩니다.";
FeedbackSurveysEnabled.pfm_title = "제품 내 Brave 설문조사를 사용자에게 표시할지 지정합니다.";
FeedbackSurveysEnabled.pfm_description = "Brave 제품 내 설문조사에서는 브라우저에 대한 사용자 의견을 수집합니다. 설문조사 응답은 사용자 계정과 연결되지 않습니다.\n정책을 사용 설정하거나 설정하지 않으면 제품 내 설문조사가 사용자에게 표시될 수 있습니다.\n정책을 사용 중지하면 제품 내 설문조사가 사용자에게 표시되지 않습니다.\n\nMetricsReportingEnabled가 사용 중지되어 제품 내 설문조사도 사용 중지되는 경우에는 이 정책은 아무런 영향을 미치지 않습니다.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "종료 시 연결 유지 길이 가져오기";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "브라우저 종료 시 연결 유지 요청에 허용되는 길이(초)를 설정합니다.\n\n지정하면 지정된 초만큼 브라우저 종료가 차단되어 연결 유지(https://fetch.spec.whatwg.org/#request-keepalive-flag) 요청을 처리할 수 있습니다.\n\n기본값(0)으로 두면 기능이 비활성화됩니다.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "이전 사용자 동작 없이 파일 또는 디렉터리 선택 도구 API를 호출할 수 있도록 허용";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "보안상의 이유로 showOpenFilePicker(), showSaveFilePicker(), showDirectoryPicker() 웹 API에는 이전 사용자 동작('임시 활성화') 호출을 요구하며, 호출하지 않을 경우 실패합니다.\n\n이 정책을 설정하면 관리자는 이전 사용자 동작 없이 이러한 API를 호출하는 출처를 지정할 수 있습니다.\n\n유효한 URL 패턴에 관해 자세히 알아보려면\nhttps://chromeenterprise.google/policies/url-patterns/ 페이지를 참고하세요. * 기호는 이 정책에 허용되는 값이 아닙니다.\n\n정책을 설정하지 않으면 모든 출처에서 이러한 API를 호출하기 위해 이전 사용자 동작을 요구합니다.";
FileSystemReadAskForUrls.pfm_title = "다음 사이트에서 File System API를 통한 읽기 액세스 허용";
FileSystemReadAskForUrls.pfm_description = "정책을 설정하면 URL 패턴 목록을 만들어 사용자에게 File System API를 통해 호스트 운영체제의 파일 시스템 내 파일 또는 디렉터리에 대한 읽기 액세스 권한을 요청할 수 있는 사이트를 지정하는 것이 가능합니다.\n\n정책을 설정하지 않은 경우 DefaultFileSystemReadGuardSetting이 설정되어 있으면 모든 사이트에 적용됩니다. 설정되어 있지 않으면 사용자의 개인 설정이 적용됩니다.\n\nURL 패턴은 FileSystemReadBlockedForUrls 정책과 충돌하지 않아야 합니다. URL이 둘 모두와 일치하면 어떠한 정책도 우선 적용되지 않습니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. * 값은 이 정책에 허용되는 값이 아닙니다.";
FileSystemReadBlockedForUrls.pfm_title = "다음 사이트에서 File System API를 통한 읽기 액세스 차단";
FileSystemReadBlockedForUrls.pfm_description = "정책을 설정하면 URL 패턴 목록을 만들어 사용자에게 File System API를 통해 호스트 운영체제의 파일 시스템 내 파일 또는 디렉터리에 대한 읽기 액세스 권한을 요청할 수 없는 사이트를 지정하는 것이 가능합니다.\n\n정책을 설정하지 않았을 때 DefaultFileSystemReadGuardSetting이 설정되어 있으면 모든 사이트에 적용되며, 설정되어 있지 않으면 사용자의 개인 설정이 적용됩니다.\n\nURL 패턴이 FileSystemReadAskForUrls와 충돌해서는 안 됩니다. URL이 둘 모두와 일치하면 어떠한 정책도 우선 적용되지 않습니다.\n\n유효한 url 패턴에 관한 자세한 내용은 https://chromeenterprise.google/policies/url-patterns 페이지를 참고하세요. *는 이 정책에 허용되는 값이 아닙니다.";
FileSystemWriteAskForUrls.pfm_title = "다음 사이트에서 파일 및 디렉터리 쓰기 액세스 허용";
FileSystemWriteAskForUrls.pfm_description = "정책을 설정하면 URL 패턴 목록을 만들어 사용자에게 호스트 운영체제의 파일 시스템 내 파일 또는 디렉터리에 대한 쓰기 액세스 권한을 요청할 수 있는 사이트를 지정하는 것이 가능합니다.\n\n정책을 설정하지 않은 경우 DefaultFileSystemWriteGuardSetting이 설정되어 있으면 모든 사이트에 적용됩니다. 설정되어 있지 않으면 사용자의 개인 설정이 적용됩니다.\n\nURL 패턴은 FileSystemWriteBlockedForUrls 정책과 충돌하지 않아야 합니다. URL이 둘 모두와 일치하면 어떠한 정책도 우선 적용되지 않습니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. * 값은 이 정책에 허용되는 값이 아닙니다.";
FileSystemWriteBlockedForUrls.pfm_title = "다음 사이트에서 파일 및 디렉터리 쓰기 액세스 차단";
FileSystemWriteBlockedForUrls.pfm_description = "정책을 설정하면 URL 패턴 목록을 만들어 사용자에게 호스트 운영체제의 파일 시스템 내 파일 또는 디렉터리에 대한 쓰기 액세스 권한을 요청할 수 없는 사이트를 지정하는 것이 가능합니다.\n\n정책을 설정하지 않은 경우 DefaultFileSystemWriteGuardSetting이 설정되어 있으면 모든 사이트에 적용됩니다. 설정되어 있지 않으면 사용자의 개인 설정이 적용됩니다.\n\nURL 패턴이 FileSystemWriteAskForUrls와 충돌해서는 안 됩니다. URL이 둘 모두와 일치하면 어떠한 정책도 우선 적용되지 않습니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. * 값은 이 정책에 허용되는 값이 아닙니다.";
ForceEphemeralProfiles.pfm_title = "임시 프로필";
ForceEphemeralProfiles.pfm_description = "이 정책을 사용하도록 설정하면 프로필이 임시 모드로 전환됩니다. 이 정책을 OS 정책(예: Windows의 GPO)으로 지정하면 시스템의 모든 프로필에 적용되며, 클라우드 정책으로 설정하면 관리 계정으로 로그인한 프로필에만 적용됩니다.\n\n이 모드에서는 프로필 데이터가 사용자 세션 기간에만 디스크에 지속됩니다. 브라우저 기록, 확장 프로그램 및 확장 프로그램 데이터, 쿠키와 웹 데이터베이스 등의 웹 데이터와 같은 기능은 브라우저를 종료한 후에 저장되지 않습니다. 하지만 이 모드에서 사용자는 원하는 데이터를 직접 디스크로 다운로드하고 페이지를 저장하거나 인쇄할 수 있습니다.\n\n사용자가 동기화를 사용하는 경우 이러한 데이터가 모두 일반 프로필과 마찬가지로 동기화 프로필에 저장됩니다. 정책에서 명시적으로 사용 중지하지 않는 한 시크릿 모드도 사용할 수 있습니다.\n\n이 정책이 사용 중지로 설정되었거나 아예 설정되지 않은 경우 로그인하면 일반 프로필로 연결됩니다.";
ForceForegroundPriorityForAllTabs.pfm_title = "모든 탭에 포그라운드 우선순위 강제 적용";
ForceForegroundPriorityForAllTabs.pfm_description = "이 정책은 백그라운드 웹 콘텐츠를 강제로 포그라운드 우선순위로 실행할지\n제어합니다.\n\n기본적으로 브라우저는 백그라운드 탭의 콘텐츠 우선순위를 낮춰\n리소스를 최적화합니다. 이 정책을 사용 설정하면 해당 동작이 재정의되어\n백그라운드 탭이 활성 탭과 동일한 방식으로 예약됩니다.\n\n백그라운드 콘텐츠를 강제로 포그라운드 우선순위로 실행하도록 설정하면\n활성 탭의 반응 속도가 약간 떨어질 수 있습니다.\n\n이 정책을 '사용'으로 설정하면 모든 웹 콘텐츠가 표시 상태와 관계없이\n포그라운드 우선순위로 실행됩니다.\n\n이 정책을 '사용 안함'으로 설정하거나 설정하지 않으면 브라우저가\n표준 휴리스틱(예: 표시되지 않거나 오디오를 재생하지 않는 콘텐츠, 영상 통화에\n참여 중이 아닌 콘텐츠의 우선순위 낮춤)을 기준으로 우선순위를 정합니다.";
ForceForegroundPriorityForUrls.pfm_title = "특정 URL에 포그라운드 우선순위 강제 적용";
ForceForegroundPriorityForUrls.pfm_description = "이 정책을 사용하면 URL 패턴 목록을 지정할 수 있습니다. 해당 패턴과 일치하는 백그라운드 웹 콘텐츠는 포그라운드 우선순위로 강제 실행됩니다.\n\nForceForegroundPriorityForAllTabs 정책이 사용 설정되면 모든 탭이 포그라운드 우선순위로 강제 적용되므로 이 목록은 무시됩니다.\n\nForceForegroundPriorityForAllTabs 정책이 사용 중지되거나 설정되지 않은 경우, 이 목록의 패턴과 일치하는 콘텐츠만 강제 적용됩니다.\n\n유효한 URL 패턴에 관해 자세히 알아보려면 https://support.google.com/chrome/a?p=url_blocklist_filter_format을 참고하세요.\n\n이 목록이 비어 있거나 설정되지 않은 경우 백그라운드 콘텐츠가 포그라운드 우선순위로 강제 적용되지 않습니다.";
ForceGoogleSafeSearch.pfm_title = "Google 세이프서치 강제 실행";
ForceGoogleSafeSearch.pfm_description = "이 정책을 사용으로 설정하면 Google 검색에서 세이프서치가 항상 활성화되며 사용자가 이 설정을 변경할 수 없습니다.\n\n정책을 사용 안함으로 설정하거나 설정하지 않으면 Google 검색에서 세이프서치가 적용되지 않습니다.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "unload 이벤트 핸들러의 사용 중지 여부 제어";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "unload 이벤트 핸들러가 지원 중단됩니다. 실행 여부는 unload Permissions-Policy에 따라 달라집니다. 현재는 기본적으로 정책에 의해 허용됩니다. 향후 기본적으로 허용되지 않는 것으로 점차 바뀌며, 사이트에서는 Permissions-Policy 헤더를 사용하여 명시적으로 해당 핸들러를 사용 설정해야 합니다. 이 기업 정책은 기본값을 사용 설정된 상태로 강제 유지함으로써 이러한 점진적인 지원 중단을 거부하는 데 사용할 수 있습니다.\n\n페이지는 unload 이벤트 핸들러에 따라 데이터를 저장하거나 서버에 사용자 세션의 종료를 알릴 수 있습니다. 이는 신뢰할 수 없을 뿐만 아니라 BackForwardCache 사용을 차단하여 성능에 영향을 미치므로 권장되지 않습니다. 권장되는 다른 방법이 있지만 unload 이벤트가 오랫동안 사용되었습니다. 일부 애플리케이션은 계속해서 이를 사용할 수 있습니다.\n\n정책을 false로 설정하거나 설정하지 않으면 unload 이벤트 핸들러가 지원 중단 적용에 따라 점진적으로 지원 중단되며, Permissions-Policy 헤더가 설정되지 않은 사이트에서는 `unload` 이벤트 실행이 중지됩니다.\n\n정책을 true로 설정하면 기본적으로 unload 이벤트 핸들러가 계속 작동합니다.\n\n참고: M117에는 이 정책에 잘못 문서화된 기본값 'true'가 있었습니다. unload 이벤트는 M117에서 변경되지 않았고 앞으로도 변경되지 않을 것이므로 이 정책은 해당 버전에서 아무런 영향을 미치지 않습니다.\n";
ForceYouTubeRestrict.pfm_title = "최소 YouTube 제한 모드 강제 적용";
ForceYouTubeRestrict.pfm_description = "0 - YouTube의 제한 모드 강제 안함\n1 - 최소 보통 이상의 YouTube 제한 모드 강제 적용\n2 - YouTube의 엄격한 제한 모드 강제 적용\n이 정책을 설정하면 YouTube의 최소 제한 모드가 적용되며 사용자가 이보다 낮은 수준의 제한 모드를 선택할 수 없습니다. 설정하는 옵션에 따른 결과는 다음과 같습니다.\n\n* '엄격' - 항상 YouTube의 엄격한 제한 모드가 적용됩니다.\n\n* '보통' - 사용자는 YouTube의 보통 제한 모드와 엄격한 제한 모드만 선택할 수 있으며, 제한 모드를 사용 중지할 수는 없습니다.\n\n* '사용 안함' 또는 값을 설정하지 않음 - Chrome에서 YouTube의 제한 모드가 적용되지 않습니다. 단, YouTube 정책과 같은 외부 정책에 의해 계속해서 제한 모드가 적용될 수 있습니다.";
ForcedLanguages.pfm_title = "기본 언어의 콘텐츠 및 순서 구성";
ForcedLanguages.pfm_description = "이 정책은 관리자가 Brave 설정에서 기본 언어의 순서를 구성할 수 있도록 허용합니다.\n\n목록의 순서는 chrome://settings/languages의 '환경설정에 따른 언어 순서' 섹션의 순서와 동일하게 표시됩니다. 사용자는 정책에서 설정된 언어를 삭제하거나 순서를 변경할 수는 없지만 정책에서 설정된 언어 아래에 언어를 추가할 수는 있습니다. 다른 정책에 의해 강제되지 않는 한 사용자는 브라우저의 UI 언어 및 번역/맞춤법 검사 설정을 원하는 대로 변경할 수 있습니다.\n\n정책을 설정하지 않으면 사용자가 기본 언어의 전체 목록을 변경할 수 있습니다.";
GeminiActOnWebAllowedForURLs.pfm_title = "지정된 사이트에서 직접 작동하는 Gemini 앱 통합 허용";
GeminiActOnWebAllowedForURLs.pfm_description = "URL 패턴 목록을 설정하여 Gemini 앱 통합이 웹페이지에서 직접 작동해도 되는 사이트를 지정할 수 있습니다.\n\n허용 목록 또는 차단 목록과 일치하지 않는 URL에는 GeminiActOnWebSettings가 사용됩니다.\n\n허용 목록 및 차단 목록과 일치하는 URL은 허용됩니다.\n\n유효한 URL 패턴에 관해 자세히 알아보려면 https://support.google.com/chrome/a?p=url_blocklist_filter_format 페이지를 참고하세요.";
GeminiActOnWebBlockedForURLs.pfm_title = "지정된 사이트에서 직접 작동하는 Gemini 앱 통합 차단";
GeminiActOnWebBlockedForURLs.pfm_description = "URL 패턴 목록을 설정하여 Gemini 앱 통합이 웹페이지에서 직접 작동해서는 안 되는 사이트를 지정할 수 있습니다.\n\n허용 목록 또는 차단 목록과 일치하지 않는 URL에는 GeminiActOnWebSettings가 사용됩니다.\n\n허용 목록 및 차단 목록과 일치하는 URL은 허용됩니다.\n\n유효한 URL 패턴에 관해 자세히 알아보려면 https://support.google.com/chrome/a?p=url_blocklist_filter_format 페이지를 참고하세요.";
GeminiActOnWebSettings.pfm_title = "Gemini 앱 통합이 웹페이지에서 직접 작동하도록 허용합니다.";
GeminiActOnWebSettings.pfm_description = "0 - Gemini 앱이 웹페이지에서 작업을 실행하도록 허용합니다.\n1 - Gemini 앱이 웹페이지에서 작업을 실행하도록 허용하지 않습니다.\nGemini 앱이 사용자를 대신하여 웹페이지에서 작업을 실행하도록 허용할지 제어합니다.\n\n0/설정 안 함 = Gemini 앱이 웹페이지에서 작업을 실행하도록 허용합니다.\n\n1 = Gemini 앱이 웹페이지에서 작업을 실행하도록 허용하지 않습니다.\n\nGemini 앱이 사용 중지되면 이 정책은 아무런 영향을 미치지 않습니다. 예를 들어 GeminiSettings 정책으로 Gemini 앱을 사용 중지할 수 있습니다.\n\nChrome의 Gemini에 관한 자세한 내용은 https://support.google.com/chrome/a/answer/16291696 페이지를 참고하세요.\n\n일부 국가 또는 언어에서는 Gemini가 작동하지 않습니다. 이 정책을 설정해도 기능이 사용 설정된다는 보장은 없으며, 기능은 사용 가능 여부에 따라 달라집니다. 출시에 관한 자세한 내용은 Enterprise 출시 노트(https://support.google.com/chrome/a/answer/7679408?hl=ko)를 참고하세요.";
GeminiSettings.pfm_title = "Gemini 통합 설정";
GeminiSettings.pfm_description = "0 - Gemini 통합을 허용합니다.\n1 - Gemini 통합을 허용하지 않습니다.\n이 설정은 Gemini 앱 통합을 허용합니다.\n\n0 = 사용자가 Gemini 통합을 사용할 수 있습니다.\n\n1 = 사용자가 Gemini 통합을 사용할 수 없습니다.\n\n정책을 설정하지 않으면 GenAiDefaultSettings 정책에 따라 동작이 결정됩니다.\n\n자세한 내용은 고객센터 도움말(https://support.google.com/chrome/a?p=gemini_in_chrome)을 참고하세요.";
GeminiSparkSettings.pfm_title = "Gemini Spark가 Brave에 연결하고 Chrome의 Gemini를 통해 자동 탐색을 사용하도록 허용합니다.";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark가 Brave 자동 탐색에 연결하고 이를 사용할 수 있습니다.\n1 - Gemini Spark가 Brave 자동 탐색에 연결하거나 이를 사용할 수 없습니다.\nGemini Spark 에이전트가 Brave에 연결하고 자동 탐색을 사용하도록 허용할지 여부를 설정합니다. 조직에서 Gemini Spark 기능을 사용하지 못할 수도 있습니다.\n\n0 = Gemini Spark가 Brave 자동 탐색에 연결하고 이를 사용하도록 허용합니다.\n\n1 = Gemini Spark가 Brave 자동 탐색에 연결하거나 이를 사용하도록 허용하지 않습니다.\n\n경고: Gemini Spark가 Brave에 연결하고 자동 탐색을 사용하도록 허용하면 Gemini Spark 에이전트가 활성 브라우저 세션을 사용하여 Brave 클라이언트에서 자율적인 다단계 작업을 수행할 수 있습니다. 여기에는 사용자 인증 정보 위험, 로컬 네트워크 인그레스, 컨텍스트 인식 신호 손실과 같은 심각한 보안 위험이 수반됩니다. 기존 관리 및 보안 제어가 적용되지 않을 수 있습니다.\n\n관리자는 이 기능을 사용 설정하기 전에 조직의 네트워크 위협 모델, 규정 준수, 개인 정보 보호 가이드라인을 신중하게 평가하시기 바랍니다.\n\nGoogle Gemini 앱 또는 Brave 자동 탐색 정책이 사용 중지되어 있는 경우 이 정책은 적용되지 않습니다. 예를 들어 GeminiSettings 정책에 의해 Google Gemini 앱이 사용 중지될 수 있습니다. Brave의 Google Gemini에 대한 자세한 내용은 https://support.google.com/chrome/a?p=gemini_in_chrome 페이지를 참고하세요.\n\nBrave 자동 탐색 및 Gemini Spark는 일부 국가 또는 언어에서만 제공됩니다. 이 정책을 0(사용 설정)으로 설정해도 이 기능이 사용 설정된다는 보장은 없으며, 기능 사용 가능 여부에 따라 달라집니다. 출시에 관한 자세한 내용은 Enterprise 출시 노트(https://chromeenterprise.google/resources/release-notes/)를 참고하세요.";
GenAILocalFoundationalModelSettings.pfm_title = "생성형 AI 로컬 기반 모델 설정";
GenAILocalFoundationalModelSettings.pfm_description = "0 - 모델 자동 다운로드\n1 - 모델 다운로드 안함\nBrave에서 기본적인 생성형 AI 모델을 다운로드하고 로컬에서 추론에 사용하는 방법을 구성합니다.\n\n정책을 허용됨(0)으로 설정하거나 설정하지 않으면 모델이 자동으로 다운로드되어 추론에 사용됩니다.\n\n정책을 사용 안 함(1)으로 설정하면 모델이 다운로드되지 않으며 기존 모델(이미 다운로드된 경우)이 삭제됩니다.\n\n데스크톱 플랫폼의 경우 ComponentUpdatesEnabled 정책을 false로 설정하여 모델 다운로드를 사용 중지할 수도 있습니다.";
GeolocationBlockedForUrls.pfm_title = "이 사이트에서 위치정보 차단";
GeolocationBlockedForUrls.pfm_description = "정책을 설정하면 사용자의 위치정보에 액세스할 수 없으며 액세스 권한을 요청할 수 없는 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n정책을 설정하지 않으면 DefaultGeolocationSetting이 설정되어 있는 경우 모든 사이트에 적용됩니다. 설정되지 않았다면 사용자의 개인 설정이 적용됩니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "전역적으로 범위가 지정된 HTTP 인증 캐시 사용 설정";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "이 정책은 HTTP 서버 사용자 인증 정보를 저장하는 프로필별 단일 전역 캐시를 구성합니다.\n\n이 정책이 설정되지 않았거나 사용 중지된 경우 브라우저에서 크로스 사이트 인증의 기본 동작을 사용합니다. 이 동작은 HTTP 서버 사용자 인증 정보의 범위를 최상위 수준 사이트 단위로 제한합니다. 이에 따라 두 개의 사이트가 동일한 인증 도메인에서 리소스를 사용하면 두 사이트 모두의 컨텍스트에서 사용자 인증 정보가 개별적으로 제공되어야 합니다. 캐시된 프록시 사용자 인증 정보는 사이트 전반에서 다시 사용됩니다.\n\n정책이 사용 설정되면 한 사이트의 컨텍스트에 입력된 HTTP 사용자 인증 정보가 자동으로 다른 사이트의 컨텍스트에 사용됩니다.\n\n또한 사이트가 일부 크로스 사이트 공격에 노출되며 URL에 삽입된 사용자 인증 정보를 사용하여 HTTP 인증 캐시에 항목을 추가해 쿠키 없이도 사이트 전반에서 사용자를 추적할 수 있습니다.\n\n이 정책은 레거시 동작에 따라 기업이 로그인 절차를 업데이트할 기회를 제공하기 위한 임시방편이며 향후 삭제될 예정입니다.";
GoogleSearchSidePanelEnabled.pfm_title = "Google Search Side Panel 사용 설정";
GoogleSearchSidePanelEnabled.pfm_description = "정책을 사용으로 설정하거나 설정하지 않으면 모든 웹페이지에서 Google Search Side Panel이 허용됩니다.\n\n사용 안함으로 설정하면 어떤 웹페이지에서도 Google Search Side Panel을 사용할 수 없습니다.\n\nEducation 또는 Enterprise 계정에서는 이 기능에 속한 생성형 AI 기능을 사용할 수 없습니다.";
HSTSPolicyBypassList.pfm_title = "HSTS 정책 검사를 우회할 이름 목록입니다.";
HSTSPolicyBypassList.pfm_description = "정책을 설정하면 미리 로드된 HSTS를 http에서 https로 업그레이드하지 않도록 우회할 호스트 이름의 목록이 지정됩니다.\n\n단일 라벨 호스트 이름만 허용되는 이 정책은 HST가 미리 로드된 '정적' 항목(예: \"app\", \"new\", \"search\", \"play\")에만 적용됩니다. 정책은 Strict-Transport-Security 응답 헤더를 사용하여 HSTS 업그레이드를 '동적으로' 요청한 서버의 HSTS 업그레이드를 막지 않습니다.\n\n제공된 호스트 이름은 표준화되어야 합니다. 모든 IDN은 A 라벨 형식으로 변환되어야 하며 모든 ASCII 문자는 소문자여야 합니다. 정책은 지정된 특정 단일 라벨 호스트 이름에만 적용되며 지정된 이름의 하위 도메인에는 적용되지 않습니다.";
HappyEyeballsV3Enabled.pfm_title = "Happy Eyeballs V3 알고리즘 사용";
HappyEyeballsV3Enabled.pfm_description = "이 기능을 사용하면 Happy Eyeballs V3 알고리즘이 연결을 시도합니다. 자세한 내용은 https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3를 참고하세요.\n\n정책을 사용 설정하면 Brave에서 연결 시도에 Happy Eyeballs V3 알고리즘을 사용합니다.\n\n정책을 사용 중지하면 Happy Eyeballs V3 알고리즘이 사용 중지됩니다.\n\n정책을 설정하지 않으면 Brave에서 chrome://flags/#happy-eyeballs-v3에 따라 Happy Eyeballs V3 알고리즘을 사용 설정하거나 사용 중지합니다.\n\n이 정책은 동적 새로고침을 지원합니다.\n\n정책은 일시적인 조치로, 향후 Brave 버전에서는 삭제될 예정입니다.";
HardwareAccelerationModeEnabled.pfm_title = "가능한 경우 그래픽 가속 사용";
HardwareAccelerationModeEnabled.pfm_description = "정책을 사용 설정하거나 설정하지 않으면 가능한 경우 그래픽 가속이 사용 설정됩니다.\n\n정책을 사용 중지하면 그래픽 가속이 사용 중지됩니다.";
HeadlessMode.pfm_title = "헤드리스 모드 사용 제어";
HeadlessMode.pfm_description = "1 - 헤드리스 모드 사용 허용\n2 - 헤드리스 모드 사용 허용 안 함\n정책을 Enabled로 설정하거나 설정하지 않으면 헤드리스 모드의 사용이 허용됩니다. 정책을 Disabled로 설정하면 헤드리스 모드 사용이 허용되지 않습니다.";
HelpMeWriteSettings.pfm_title = "작성 지원 기능 설정";
HelpMeWriteSettings.pfm_description = "0 - 글쓰기 도우미를 허용하고 AI 모델을 개선합니다.\n1 - AI 모델 개선 없이 글쓰기 도우미를 허용합니다.\n2 - 글쓰기 도우미를 허용하지 않습니다.\n글쓰기 도우미는 짧은 형식의 웹 콘텐츠를 위한 AI 기반 글쓰기 어시스턴트입니다. 추천 콘텐츠는 사용자가 입력한 프롬프트와 웹페이지의 콘텐츠를 기반으로 합니다.\n\n0 = 이 기능을 사용하도록 허용하면서 Google에서 관련 데이터를 사용하여 AI 모델을 개선하도록 허용합니다. 관련 데이터에는 기능에 따라 프롬프트나 입력, 출력, 소스 자료, 서면 의견이 포함될 수 있습니다. AI 모델을 개선하기 위해 사람이 데이터를 검토할 수도 있습니다. 아래에 명시된 경우를 제외하고 0이 기본값입니다.\n\n1 = 기능을 사용하도록 허용하되 Google에서 사용자 콘텐츠(프롬프트, 입력, 출력, 소스 자료, 서면 의견 등)를 사용하여 모델을 개선하도록 허용하지 않습니다. 1은 Google Admin console에서 관리되는 기업 사용자 및 Google Workspace에서 관리되는 Education 계정의 기본값입니다.\n\n2 = 기능을 허용하지 않습니다.\n\n정책을 설정하지 않으면 GenAiDefaultSettings 정책에 따라 동작이 결정됩니다.\n\n생성형 AI 기능의 데이터 처리에 관한 자세한 내용은 https://support.google.com/chrome/a?p=generative_ai_settings 페이지를 참고하세요.";
HideWebStoreIcon.pfm_title = "새 탭 페이지 및 앱 런처에서 웹 스토어 숨기기";
HideWebStoreIcon.pfm_description = "새 탭 페이지 및 Google Chrome OS 앱 런처에서 Chrome 웹 스토어 앱과 바닥글 링크가 표시되지 않도록 숨깁니다.\n\n이 정책이 true로 설정된 경우 아이콘이 표시되지 않습니다.\n\n이 정책이 false로 설정되거나 정책이 설정되지 않은 경우 아이콘이 표시됩니다.";
HighEfficiencyModeEnabled.pfm_title = "고효율 모드 사용 설정";
HighEfficiencyModeEnabled.pfm_description = "이 정책은 고효율 모드 설정을 사용 또는 사용 중지합니다. 이렇게 설정하면 백그라운드에서 일정 시간이 지난 후에 탭을 닫아 메모리를 확보할 수 있습니다.\n정책을 설정하지 않으면 최종 사용자가 chrome://settings/performance에서 이 설정을 제어할 수 있습니다.\n";
HistoryClustersVisible.pfm_title = "페이지 그룹과 함께 Chrome 방문 기록 화면이 표시됩니다.";
HistoryClustersVisible.pfm_description = "이 정책은 페이지 그룹으로 구성된 Chrome 방문 기록 페이지의 공개 상태를 제어합니다.\n\n정책을 사용 설정하면 그룹으로 구성된 Chrome 방문 기록 페이지가 chrome://history/grouped에 표시됩니다.\n\n정책을 사용 안함으로 설정하면 그룹으로 구성된 Chrome 방문 기록 페이지가 chrome://history/grouped에 표시되지 않습니다.\n\n정책을 설정하지 않으면 그룹으로 구성된 Chrome 방문 기록 페이지가 기본적으로 chrome://history/grouped에 표시됩니다.\n\nComponentUpdatesEnabled 정책이 사용 안함으로 설정되었지만 HistoryClustersVisible 정책이 사용 설정되거나 설정되지 않은 경우 그룹으로 구성된 Chrome 방문 기록 페이지는 chrome://history/grouped에서 계속 이용 가능하지만, 사용자와의 관련성이 떨어질 수 있습니다.\n";
HistorySearchSettings.pfm_title = "AI 기반 방문 기록 검색 설정";
HistorySearchSettings.pfm_description = "0 - AI 기록 검색을 허용하고 AI 모델을 개선합니다.\n1 - AI 모델을 개선하지 않고 AI 기록 검색을 허용합니다.\n2 - AI 기록 검색을 허용하지 않습니다.\nAI 기록 검색은 사용자가 방문 기록을 검색하고 페이지 제목과 URL뿐만 아니라 페이지 콘텐츠를 토대로 생성된 답변을 받을 수 있는 기능입니다.\n\n0 = 이 기능을 사용하도록 허용하면서 Google에서 관련 데이터를 사용하여 AI 모델을 개선하도록 허용합니다. 관련 데이터에는 기능에 따라 프롬프트나 입력, 출력, 소스 자료, 서면 의견이 포함될 수 있습니다. AI 모델을 개선하기 위해 사람이 데이터를 검토할 수도 있습니다. 아래에 명시된 경우를 제외하고 0이 기본값입니다.\n\n1 = 기능을 사용하도록 허용하되 Google에서 사용자 콘텐츠(프롬프트, 입력, 출력, 소스 자료, 서면 의견 등)를 사용하여 모델을 개선하도록 허용하지 않습니다. 1은 Google Admin console에서 관리되는 기업 사용자 및 Google Workspace에서 관리되는 Education 계정의 기본값입니다.\n\n2 = 기능을 허용하지 않습니다.\n\n정책을 설정하지 않으면 GenAiDefaultSettings 정책에 따라 동작이 결정됩니다.\n\n생성형 AI 기능의 데이터 처리에 관한 자세한 내용은 https://support.google.com/chrome/a?p=generative_ai_settings 페이지를 참고하세요.";
HomepageIsNewTabPage.pfm_title = "새 탭 페이지를 홈페이지로 사용";
HomepageIsNewTabPage.pfm_description = "정책을 사용으로 설정하면 새 탭 페이지가 사용자의 홈페이지로 설정되고 기존 홈페이지 URL 위치는 무시됩니다. 정책을 사용 중지하면 사용자의 홈페이지 URL을 chrome://newtab으로 설정하지 않는 한 홈페이지가 새 탭 페이지로 지정되지 않습니다.\n\n정책을 설정하면 사용자가 Brave에서 홈페이지 유형을 변경할 수 없습니다. 설정하지 않으면 사용자가 새 탭 페이지를 홈페이지로 지정할지를 결정할 수 있습니다.\n\nMicrosoft® Windows®의 경우 이 정책은 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.\n\nmacOS의 경우 이 정책은 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.";
HomepageLocation.pfm_title = "홈페이지 URL";
HomepageLocation.pfm_description = "정책을 설정하면 Brave에서 기본 홈페이지 URL이 설정됩니다. 홈 버튼을 사용하여 홈페이지를 엽니다. 데스크톱에서 RestoreOnStartup 정책은 시작 시 열리는 페이지를 제어합니다.\n\n사용자 또는 HomepageIsNewTabPage에 의해 홈페이지가 새 탭 페이지로 설정된 경우 정책이 적용되지 않습니다.\n\nURL은 http://example.com 또는 https://example.com과 같은 표준 스킴이어야 합니다. 정책을 설정하면 사용자가 Brave에서 홈페이지 URL을 변경할 수 없습니다.\n\nHomepageLocation 및 HomepageIsNewTabPage를 모두 설정하지 않으면 사용자가 홈페이지를 선택할 수 있습니다.\n\nMicrosoft® Windows®의 경우 이 정책은 Microsoft® Active Directory® 도메인에 연결되거나, Microsoft® Azure® Active Directory®에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.\n\nmacOS의 경우 이 정책은 MDM을 통해 관리되거나, MCX를 통해 도메인에 연결되거나, Chrome Enterprise Core에 등록된 인스턴스에서만 사용할 수 있습니다.";
HttpAllowlist.pfm_title = "HTTP 허용 목록";
HttpAllowlist.pfm_description = "정책을 설정하면 HTTPS로 업그레이드되지 않고 HTTPS 우선 모드가 설정된 경우 오류 전면 광고가 표시되지 않는 호스트 이름 또는 호스트 이름 패턴(예: '[*.]example.com') 목록이 지정됩니다. 조직에서 이 정책을 사용하면 HTTPS 업그레이드 또는 HTTPS 우선 모드를 사용 중지하지 않고도 HTTPS를 지원하지 않는 서버에 대한 액세스를 유지할 수 있습니다.\n\n제공된 호스트 이름은 표준화되어야 합니다. 모든 IDN은 A 라벨 형식으로 변환되어야 하며 모든 ASCII 문자는 소문자여야 합니다.\n\n포괄적 호스트 와일드 카드(즉, '*' 또는 '[*]')는 허용되지 않습니다. 대신 HTTPS 우선 모드와 HTTPS 업그레이드는 특정 정책을 통해 명시적으로 사용 중지해야 합니다.\n\n참고: HSTS 업그레이드에는 이 정책이 적용되지 않습니다.";
HttpHeaderInjection.pfm_title = "특정 URL 패턴에 대한 HTTP 헤더 삽입 구성";
HttpHeaderInjection.pfm_description = "이 정책을 사용하면 특정 URL 패턴과 일치하는 웹 요청에 맞춤 HTTP 헤더를 삽입하는 규칙 목록을 정의할 수 있습니다. 이 정책에 의해 설정된 헤더는 요청에 원래 포함되어 있던 헤더뿐만 아니라 사용자 또는 확장 프로그램이 시도한 수정 사항보다 우선 적용됩니다.\n\n이 정책의 일반적인 사용 사례는 맞춤 헤더(예: X-Tenant-ID)를 삽입하여 테넌트 액세스 제어를 적용하는 것입니다.\n\n이 정책은 규칙 목록을 허용합니다. 각 규칙에는 다음이 포함됩니다.\n\n* patterns: 일치시킬 URL 패턴 목록입니다. URL 패턴의 형식을 지정하는 방법을 확인하세요(https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\n* headers: 삽입할 헤더를 나타내는 객체 목록입니다. 각 객체에는 다음이 포함됩니다.\n\n* name: 삽입할 헤더의 이름입니다.\n\n* value: 삽입할 헤더의 값입니다.\n\n요청과 일치하는 규칙이 여러 개 있는 경우 일치하는 모든 규칙의 헤더가 적용됩니다. 이름이 같은 헤더가 여러 개 있는 경우 가장 구체적인 URL 패턴이 있는 헤더가 적용됩니다. 패턴이 동일하게 구체적인 경우에는 목록에서 마지막에 표시되는 패턴이 적용됩니다.\n\n헤더 이름은 RFC 2616(https://www.rfc-editor.org/rfc/rfc2616)을 준수해야 합니다. 헤더 값에는 NUL, CR 또는 LF 기호가 포함되어서는 안 됩니다. 개별 헤더는 8KB를 초과할 수 없습니다. 잘못된 헤더 및 URL 패턴은 무시됩니다.\n\n이 정책은 모든 규칙에서 총 500개 URL 패턴으로 제한됩니다. 각 규칙에는 최대 20개 헤더가 포함될 수 있습니다. 이러한 기준점을 초과하는 패턴과 헤더는 무시됩니다.\n\n참고: URL 패턴이 암호화되지 않은 스키마(http://, ws:// 또는 스키마가 생략된 경우)와 일치하는 경우 구성된 헤더가 암호화되지 않은 채널을 통해 일반 텍스트로 전송되어 네트워크 관찰자에게 노출될 수 있습니다. 민감한거나 식별 가능한 헤더 값을 보호하려면 URL 패턴을 암호화된 스키마(https:// 또는 wss://)로 제한하세요.\n스키마 및 포맷에 관한 자세한 내용은 https://chromeenterprise.google/policies/?policy=HttpHeaderInjection 페이지를 참조하세요.";
HttpsOnlyMode.pfm_title = "HTTPS 전용 모드가 사용 설정되도록 허용";
HttpsOnlyMode.pfm_description = "allowed - 사용자의 HTTPS 우선 모드 설정 제한 안 함\ndisallowed - HTTPS 우선 모드 사용 중지\nforce_enabled - 엄격 모드에서 HTTPS 우선 모드 사용 설정\nforce_balanced_enabled - 균형 모드에서 HTTPS 우선 모드 사용 설정\n이 정책은 사용자가 설정에서 HTTPS 우선 모드(항상 보안 연결 사용)를 사용 설정할 수 있는지 제어합니다. HTTPS 우선 모드는 모든 탐색을 HTTPS로 업그레이드합니다.\n\n이 설정을 설정하지 않거나 '허용됨'으로 설정할 경우 사용자는 HTTPS 우선 모드를 사용 설정할 수 있습니다.\n\n이 설정이 '허용되지 않음'으로 설정되면 HTTPS 우선 모드가 사용 중지됩니다.\n\n이 설정이 'force_enabled'로 설정된 경우 엄격 모드에서 HTTPS 우선 모드가 사용 설정됩니다.\n\n이 설정이 'force_balanced_enabled'로 설정된 경우 균형 모드에서 HTTPS 우선 모드가 사용 설정됩니다.\n\n'force_enabled'는 M112부터 지원되며, 'force_balanced_enabled'는 M129부터 지원됩니다.\n\n'force_enabled' 및 'force_balanced_enabled'도 사용자에게 추천할 수 있습니다.\nHTTPS 우선 모드는 처음에는 엄격 또는 균형 모드로 설정되지만 사용자가\n변경할 수 있습니다.\n\n정책을 수신하는 Chrome 버전에서 지원되지 않는 값으로 정책을 설정하면 Chrome에서는 기본적으로 허용되는 설정을 사용합니다.\n\n별도의 HttpAllowlist 정책을\n사용하여 이 기능을 통해 특정 호스트 이름 또는 호스트 이름 패턴이 HTTPS로 업그레이드되지 않도록\n제외할 수 있습니다.";
HttpsUpgradesEnabled.pfm_title = "자동 HTTPS 업그레이드 사용 설정";
HttpsUpgradesEnabled.pfm_description = "Brave에서는 가능한 경우 일부 탐색을 HTTP에서 HTTPS로 업그레이드하려고 시도합니다. 이 정책을 사용하여 이 동작을 사용 중지할 수 있습니다. 'true'로 설정하거나 설정하지 않으면 이 기능이 기본적으로 사용 설정됩니다.\n\n별도의 HttpAllowlist 정책을 사용하여 이 기능을 통해 특정 호스트 이름 또는 호스트 이름 패턴이 HTTPS로 업그레이드되지 않도록 제외할 수 있습니다.\n\nHttpsOnlyMode 정책도 참고하세요.";
IPv6ReachabilityOverrideEnabled.pfm_title = "IPv6 연결 가능성 확인 재정의 사용 설정";
IPv6ReachabilityOverrideEnabled.pfm_description = "정책을 true로 설정하면 IPv6 연결 가능성 확인이 재정의됩니다. 즉, 시스템은\n호스트 이름을 변환할 때 항상 AAAA 레코드를 쿼리합니다. 이 정책은\n기기의 모든 사용자와 인터페이스에 적용됩니다.\n\n정책을 false로 설정하거나 설정하지 않은 상태로 두면 IPv6 연결 가능성 확인이 재정의되지 않습니다.\n시스템은 전역 IPv6 호스트에 연결할 수 있을 때만 AAAA 레코드를 쿼리합니다.";
IdleDetectionAllowedForUrls.pfm_title = "유휴 감지가 허용되는 사이트";
IdleDetectionAllowedForUrls.pfm_description = "사용자에게 요청하지 않고 Idle Detection API를 사용할 수 있는 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다. 차단 목록 항목은 허용 목록 항목보다 우선순위가 높으며, 허용 목록 항목은 구성된 기본값보다 우선순위가 높습니다.\n\n유효한 사이트 URL 패턴에 관한 자세한 내용은 https://chromeenterprise.google/policies/url-patterns 페이지를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다. 이 정책은 출처만 기준으로 일치 여부를 판단하므로 URL 패턴의 경로는 무시됩니다.\n\n이 정책을 설정하지 않으면 DefaultIdleDetectionSetting(기본 유휴 감지 설정) 정책(설정된 경우) 또는 사용자 개인 설정에 따라 구성된 전체 기본값이 모든 사이트에 사용됩니다.";
IdleDetectionBlockedForUrls.pfm_title = "유휴 상태 감지가 차단된 사이트";
IdleDetectionBlockedForUrls.pfm_description = "Idle Detection API 사용이 허용되지 않는 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n유효한 사이트 URL 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다. 이 정책은 출처만 기준으로 일치 여부를 판단하므로 URL 패턴의 경로는 무시됩니다.\n\n이 정책을 설정하지 않으면 DefaultIdleDetectionSetting(기본 유휴 감지 설정) 정책(설정된 경우) 또는 사용자 개인 설정에 따라 구성된 전체 기본값이 모든 사이트에 사용됩니다.";
IdleTimeout.pfm_title = "유휴 작업 실행 전 지연";
IdleTimeout.pfm_description = "컴퓨터가 유휴 상태일 때 작업을 실행합니다.\n\n정책을 설정하면 사용자 입력이 없는 시간(분)을 지정하여 해당 시간이 지나면 브라우저에서 IdleTimeoutActions 정책에 따라 구성된 작업을 실행합니다.\n\n정책이 설정되어 있지 않으면 아무 작업도 실행되지 않습니다.\n\n최소 기준점은 1분입니다.\n\n'사용자 입력'은 운영체제 API에 의해 정의되며, 마우스 이동 또는 키보드 입력 등의 항목이 포함됩니다.";
IdleTimeoutActions.pfm_title = "컴퓨터가 유휴 상태일 때 실행할 작업";
IdleTimeoutActions.pfm_description = "close_browsers - 브라우저 닫기\nshow_profile_picker - 프로필 선택 도구 표시\nclear_browsing_history - 방문 기록 삭제\nclear_download_history - 다운로드 기록 삭제\nclear_cookies_and_other_site_data - 쿠키 및 기타 사이트 데이터 삭제\nclear_cached_images_and_files - 캐시된 이미지 및 파일 삭제\nclear_password_signin - 로그인 비밀번호 삭제\nclear_autofill - 자동 완성 기록 삭제\nclear_site_settings - 사이트 설정 삭제\nclear_hosted_app_data - 호스팅된 앱 데이터 삭제\nreload_pages - 페이지 새로고침\nsign_out - 로그아웃\nclose_tabs - 탭 닫기\nIdleTimeout 정책에 설정된 제한 시간 도달 시 실행할 작업 목록입니다.\n\n경고: 이 정책을 설정하면 로컬 개인 정보가 영향을 받아 영구적으로 삭제될 수 있습니다. 개인 정보가 실수로 삭제되지 않도록 배포하기 전에 설정을 테스트하는 것이 좋습니다.\n\nIdleTimeout 정책이 설정되어 있지 않으면 이 정책이 적용되지 않습니다.\n\nIdleTimeout 정책에 설정된 제한 시간 도달 시 브라우저에서 이 정책에 구성된 작업을 실행합니다.\n\n정책이 비어 있거나 설정되어 있지 않으면 IdleTimeout 정책이 적용되지 않습니다.\n\n지원되는 작업은 다음과 같습니다.\n\n'close_browsers': 프로필의 모든 브라우저 창과 PWA를 닫습니다. Android와 iOS에서는 지원되지 않습니다.\n\n'close_tabs': 열려 있는 창의 열려 있는 모든 탭을 닫습니다. iOS에서만 지원됩니다.\n\n'show_profile_picker': 프로필 선택 도구 창을 표시합니다. Android와 iOS에서는 지원되지 않습니다.\n\n'sign_out': 현재 로그인한 사용자를 로그아웃시킵니다. iOS에서만 지원됩니다.\n\n'clear_browsing_history', 'clear_download_history', 'clear_cookies_and_other_site_data', 'clear_cached_images_and_files', 'clear_password_signing', 'clear_autofill', 'clear_site_settings', 'clear_hosted_app_data': 해당 인터넷 사용 기록을 삭제합니다. 자세한 내용은 ClearBrowsingDataOnExitList 정책을 참고하세요. iOS에서 지원되는 유형은 'clear_browsing_history', 'clear_cookies_and_other_site_data', 'clear_cached_images_and_files', 'clear_password_signing', 'clear_autofill'입니다.\n\n'reload_pages': 모든 웹페이지를 새로고침합니다. 일부 페이지에서는 사용자에게 먼저 확인 메시지가 표시될 수 있습니다. iOS에서는 지원되지 않습니다.\n\n'clear_cookies_and_other_site_data'를 사용하여 쿠키를 삭제하면 사용자가 Google 계정에 로그인된 상태로 유지됩니다.\n\n'clear_browsing_history', 'clear_password_signing', 'clear_autofill', 'clear_site_settings'를 설정하면 'Chrome Sync`가 SyncDisabled 정책으로 인해 사용 중지되지 않고 BrowserSignin 정책도 사용 중지되지 않은 경우 각 데이터 유형의 동기화가 사용 중지됩니다.";
ImagesAllowedForUrls.pfm_title = "이 사이트에서 이미지 허용";
ImagesAllowedForUrls.pfm_description = "정책을 설정하면 이미지를 표시할 수 있는 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n정책을 설정하지 않은 경우 DefaultImagesSetting이 설정되어 있으면 모든 사이트에 적용됩니다. 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.\n\n이전에는 이 정책이 Android에서 잘못 사용 설정되었으나 이 기능이 Android에서 완전히 지원된 적은 없습니다.";
ImagesBlockedForUrls.pfm_title = "이 사이트의 이미지 차단";
ImagesBlockedForUrls.pfm_description = "정책을 설정하면 이미지를 표시할 수 없는 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n정책을 설정하지 않은 경우 DefaultImagesSetting이 설정되어 있으면 모든 사이트에 적용됩니다. 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다.\n\n 유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.\n\n 이전에는 이 정책이 Android에서 잘못 사용 설정되었으나 이 기능이 Android에서 완전히 지원된 적은 없습니다.";
ImportAutofillFormData.pfm_title = "처음 실행할 때 기본 브라우저에서 양식 자동 완성 데이터 가져오기";
ImportAutofillFormData.pfm_description = "정책을 '사용'으로 설정하면 최초 실행 시 이전 기본 브라우저의 자동 완성 양식 데이터를 가져옵니다. 정책을 '사용 안함'으로 설정하거나 설정하지 않으면 최초 실행 시 자동 완성 양식 데이터를 가져오지 않습니다.\n\n사용자는 가져오기 대화상자를 트리거할 수 있으며 '자동 완성 양식 데이터' 체크박스가 이 정책의 값에 맞게 선택되거나 선택 해제됩니다.";
ImportBookmarks.pfm_title = "처음 실행 시 기본 브라우저에서 북마크 가져오기";
ImportBookmarks.pfm_description = "정책을 '사용'으로 설정하면 최초 실행 시 이전 기본 브라우저의 북마크를 가져옵니다. 정책을 '사용 안함'으로 설정하거나 설정하지 않으면 최초 실행 시 북마크를 가져오지 않습니다.\n\n사용자는 가져오기 대화상자를 트리거할 수 있으며 '북마크' 체크박스가 이 정책의 값에 맞게 선택되거나 선택 해제됩니다.";
ImportHistory.pfm_title = "처음 실행 시 기본 브라우저에서 인터넷 사용기록 가져오기";
ImportHistory.pfm_description = "정책을 '사용'으로 설정하면 최초 실행 시 이전 기본 브라우저의 방문 기록을 가져옵니다. 정책을 '사용 안함'으로 설정하거나 설정하지 않으면 최초 실행 시 방문 기록을 가져오지 않습니다.\n\n사용자는 가져오기 대화상자를 트리거할 수 있으며 '방문 기록' 체크박스가 이 정책의 값에 맞게 선택되거나 선택 해제됩니다.";
ImportHomepage.pfm_title = "처음 실행 시 기본 브라우저에서 홈페이지 가져오기";
ImportHomepage.pfm_description = "정책을 사용으로 설정하면 최초 실행 시 이전 기본 브라우저의 홈페이지를 가져옵니다. 정책을 사용 안함으로 설정하거나 설정하지 않으면 최초 실행 시 홈페이지를 가져오지 않습니다.\n\n사용자는 가져오기 대화상자를 실행할 수 있으며 홈페이지 체크박스가 이 정책의 값에 맞게 선택되거나 선택 해제됩니다.";
ImportSavedPasswords.pfm_title = "처음 실행 시 기본 브라우저에서 저장된 비밀번호 가져오기";
ImportSavedPasswords.pfm_description = "이 정책은 설치 후 최초 실행 가져오기 동작만 제어합니다. 브라우저를 설치하기 전에 다른 브라우저를 광범위하게 사용하던 환경에서 Brave으로 더 원활하게 전환하도록 지원합니다. 이 정책은 Google 계정의 비밀번호 관리자 기능에는 영향을 미치지 않습니다.\n\n정책을 사용 설정하면 최초 실행 시 이전 기본 브라우저에서 저장된 비밀번호를 가져오며 설정 페이지에서 수동 가져오기를 수행할 수도 있습니다.\n정책을 사용 중지하면 최초 실행 시 저장된 비밀번호를 가져오지 않으며 설정 페이지에서 수동 가져오기도 차단됩니다.\n정책을 설정하지 않으면 최초 실행 시 저장된 비밀번호를 가져오지 않으나 사용자가 설정 페이지에서 가져올 수 있습니다.";
ImportSearchEngine.pfm_title = "처음 실행 시 기본 브라우저에서 검색엔진 가져오기";
ImportSearchEngine.pfm_description = "정책을 '사용'으로 설정하면 최초 실행 시 이전 기본 브라우저의 기본 검색엔진을 가져옵니다. 정책을 '사용 안함'으로 설정하거나 설정하지 않으면 최초 실행 시 기본 검색엔진을 가져오지 않습니다.\n\n사용자는 가져오기 대화상자를 트리거할 수 있으며 '기본 검색엔진' 체크박스가 이 정책의 값에 맞게 선택되거나 선택 해제됩니다.";
IncognitoModeAvailability.pfm_title = "시크릿 모드 사용 가능 여부";
IncognitoModeAvailability.pfm_description = "0 - 시크릿 모드 사용 가능\n1 - 시크릿 모드 사용이 중지됨\n2 - 시크릿 모드를 강제로 사용함\n사용자가 Brave에서 시크릿 모드로 페이지를 열 수 있는지를 선택합니다.\n\n'사용 설정됨'이 선택되어 있거나 정책을 설정하지 않으면 페이지가 시크릿 모드로 열릴 수 있습니다.\n\n'사용 안함'이 선택되어 있으면 페이지가 시크릿 모드로 열리지 않을 수 있습니다.\n\n'강제 사용'이 선택되어 있으면 페이지가 시크릿 모드로만 열릴 수 있습니다. '강제 사용'은 Android의 Chrome 환경에서는 작동하지 않습니다.\n\nIncognitoModeUrlAllowlist 정책이 이 정책보다 우선 적용되며, 특정 URL에 시크릿 모드를 다시 사용 설정할 수 있습니다. 허용 목록이 제공될 때 이 정책에 의해 시크릿 모드가 사용 중지되면, 허용 목록과 일치하는 URL에만 시크릿 모드를 사용할 수 있으며 다른 모든 페이지는 차단됩니다.\n\n참고: iOS에서 세션 도중에 정책이 변경될 경우 다시 시작해야만 변경 사항이 적용됩니다.";
IncognitoModeUrlAllowlist.pfm_title = "시크릿 모드에서 URL 목록에 대한 액세스 허용";
IncognitoModeUrlAllowlist.pfm_description = "정책을 설정하면 시크릿 모드에서 목록에 추가된 URL에 액세스할 수 있습니다. 이 정책을 사용하면 (https://support.google.com/chrome/a?p=url_blocklist_filter_format)에 지정된 형식을 사용하여 IncognitoModeUrlBlocklist에 정의된 특정 URL 패턴에 대한 예외를 열 수 있습니다.\n\n이 정책과 IncognitoModeUrlBlocklist 정책이 모두 설정된 경우 허용 목록이 우선 적용됩니다. URL이 허용 목록의 패턴과 일치하면 허용됩니다. 차단 목록의 패턴과 일치하지만 허용 목록의 패턴과 일치하지 않으면 차단됩니다. URL이 어느 쪽과도 일치하지 않으면 일반 URLBlocklist/URLAllowlist 정책이 대체 정책으로 사용됩니다.\n\n이 정책이 설정되어 있고 IncognitoModeUrlBlocklist 정책은 설정되어 있지 않은 경우 허용 목록에 없는 모든 URL이 시크릿 모드에서 차단됩니다.\n\nIncognitoModeAvailability 정책이 허용 안 함(값 1)으로 설정되어 있지만 이 정책이 구성된 경우 허용 목록과 일치하는 URL에만 시크릿 모드를 사용할 수 있습니다.\n\n정책을 설정하지 않으면 IncognitoModeUrlBlocklist 및 IncognitoModeAvailability에 예외가 허용되지 않습니다.\n\n이 정책은 시크릿 모드에만 영향을 미칩니다. 모든 사용자 프로필에서 URL을 허용하려면 URLAllowlist 정책을 사용하세요.\n\n포괄적 호스트 와일드 카드(즉, '*' 또는 '[*]')는 허용되지 않습니다. 전체적으로 기능을 사용 설정하려면 IncognitoModeAvailability 정책을 사용하세요.\n\n정책의 항목은 1,000개로 제한됩니다.";
IncognitoModeUrlBlocklist.pfm_title = "시크릿 모드에서 URL 목록에 대한 액세스 차단";
IncognitoModeUrlBlocklist.pfm_description = "IncognitoModeUrlBlocklist 정책을 설정하면 시크릿 모드에서 금지된 URL이 있는 웹페이지의 로드가 중지됩니다. 관리자는 차단할 URL 패턴 목록을 지정할 수 있습니다. URL 패턴의 형식을 지정하는 방법을 확인하세요(https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\n이 정책과 IncognitoModeUrlAllowlist 정책이 모두 설정된 경우 허용 목록이 우선 적용됩니다. URL이 허용 목록의 패턴과 일치하면 허용됩니다. 차단 목록의 패턴과 일치하지만 허용 목록의 패턴과 일치하지 않으면 차단됩니다. URL이 어느 쪽과도 일치하지 않으면 일반 URLBlocklist/URLAllowlist 정책이 대체 정책으로 사용됩니다.\n\nIncognitoModeUrlAllowlist 정책이 설정되어 있고 이 정책이 설정되어 있지 않으면 시크릿 모드에서 허용 목록에 없는 모든 URL이 차단됩니다.\n\nIncognitoModeAvailability 정책이 허용 안함(값 1)으로 설정되어 있지만 IncognitoModeUrlAllowlist 정책이 구성된 경우, 허용 목록과 일치하는 URL에만 시크릿 모드를 사용할 수 있습니다.\n\n이 정책은 시크릿 모드에만 영향을 미칩니다. 모든 사용자 프로필에서 URL을 차단하려면 URLBlocklist 정책을 사용하세요.\n\n정책의 항목은 1,000개로 제한됩니다.";
InsecureContentAllowedForUrls.pfm_title = "이 사이트에서 안전하지 않은 콘텐츠 허용";
InsecureContentAllowedForUrls.pfm_description = "차단 가능한(능동) 혼합 콘텐츠(HTTPS 사이트의 HTTP 콘텐츠) 표시를 허용하고 선택적으로 차단 가능한 혼합 콘텐츠 업그레이드를 사용 중지할 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n정책을 설정하지 않으면 차단 가능한 혼합 콘텐츠는 차단되고 선택적으로 차단 가능한 혼합 콘텐츠는 업그레이드되며 사용자는 예외를 설정해 특정 사이트에서 혼합 콘텐츠를 허용할 수 있습니다.\n\n유효한 URL 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.";
InsecureContentBlockedForUrls.pfm_title = "이 사이트에서 안전하지 않은 콘텐츠 차단";
InsecureContentBlockedForUrls.pfm_description = "차단 가능한(능동) 혼합 콘텐츠(HTTPS 사이트의 HTTP 콘텐츠) 표시를 차단하고 선택적으로 차단 가능한(수동) 혼합 콘텐츠를 업그레이드할 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n정책을 설정하지 않으면 차단 가능한 혼합 콘텐츠는 차단되고 선택적으로 차단 가능한 혼합 콘텐츠는 업그레이드되지만 사용자는 예외를 설정하여 특정 사이트에서 혼합 콘텐츠를 허용할 수 있습니다.\n\n유효한 URL 패턴에 관한 자세한 내용은 https://chromeenterprise.google/policies/url-patterns 페이지를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.";
IntensiveWakeUpThrottlingEnabled.pfm_title = "IntensiveWakeUpThrottling 기능을 제어합니다.";
IntensiveWakeUpThrottlingEnabled.pfm_description = "IntensiveWakeUpThrottling 기능을 사용 설정하면 백그라운드 탭의 자바스크립트 타이머가 지나치게 제한되거나 병합되므로 페이지가 5분 이상 백그라운드 상태가 된 후 분당 한 번만 실행됩니다.\n\n이는 웹 표준 호환 기능이지만\n특정 작업을 최대 1분까지 지연되게 하여 일부 웹사이트의 기능이\n손상될 수 있습니다. 하지만 사용 설정되면 CPU 및 배터리를 상당히 절약할 수\n있습니다. 자세한 내용은 https://bit.ly/30b1XR4 페이지를 참고하세요.\n\n정책이 사용 설정되면 기능이 강제 실행되고\n사용자는 이를 재정의할 수 없습니다.\n\n정책이 사용 중지되면 기능이 강제 실행 중지되고\n사용자는 이를 재정의할 수 없습니다.\n\n정책이 설정되지 않으면 기능이 자체 내부 로직으로 제어되고\n이는 사용자가 직접 구성할 수 있습니다.\n\n정책은 렌더러 프로세스 단위로 적용되고 렌더러 프로세스가 시작되면\n정책 설정의 가장 최근 값이 적용됩니다. 로드된\n모든 탭에서 정책 설정이 일관적으로 적용되게 하려면\n완전히 다시 시작해야 합니다. 이 정책 값이 달라도 프로세스가 실행되는 데는\n어떠한 문제도 없습니다.\n";
IntranetRedirectBehavior.pfm_title = "인트라넷 리디렉션 동작";
IntranetRedirectBehavior.pfm_description = "0 - 기본 브라우저 동작을 사용합니다.\n1 - DNS 가로채기 검사 및 'http://intranetsite/'를 찾으셨나요? 정보 표시줄을 사용 중지합니다.\n2 - DNS 가로채기 검사를 사용 중지하고 'http://intranetsite/'를 찾으셨나요? 정보 표시줄을 허용합니다.\n3 - DNS 가로채기 검사 및 'http://intranetsite/'를 찾으셨나요? 정보 표시줄을 허용합니다.\n이 정책은 DNS 가로채기 검사를 통한 인트라넷 리디렉션 동작을 구성합니다. DNS 가로채기 검사는 브라우저에서 알 수 없는 호스트 이름을 리디렉션하는 프록시를 사용 중인지 확인합니다.\n\n정책을 설정하지 않으면 브라우저에서 DNS 가로채기 검사와 인트라넷 리디렉션 제안의 기본 동작을 사용합니다. M88에서는 기본적으로 사용 설정되어 있으나 향후 버전에서는 기본적으로 사용 중지될 예정입니다.\n\nDNSInterceptionChecksEnabled도 DNS 가로채기 검사를 사용 중지할 수 있는 관련 정책입니다. 이 정책은 좀 더 유연한 버전으로 인트라넷 리디렉션 정보 표시줄을 별도로 제어하며 향후 확장될 수 있습니다.\nDNSInterceptionChecksEnabled 또는 이 정책 중 하나가 가로채기 검사 사용 중지를 요청하면 검사가 사용 중지됩니다.";
IsolateOrigins.pfm_title = "지정된 출처의 사이트 격리 사용 설정";
IsolateOrigins.pfm_description = "전용 프로세스에서 실행되는 출처 목록을 지정합니다.\n\nAndroid에서 이 정책은 메모리가 충분한 기기(반드시 3.2GB RAM 이상)에서만 작동합니다. 리소스가 제한된 기기에서 너무 많은 사이트를 격리하면 성능 문제가 발생할 수 있습니다. 리소스가 제한된 Android 기기의 경우 IsolateOriginsShortlist 정책을 대신 사용하세요.\n\n메모리가 1GB 미만인 기기에는 특정 프로세스 격리를 구성하지 않는 것이 좋습니다.\n\n이름이 지정된 각 출처의 프로세스에는 해당 출처와 하위 도메인의 문서만 포함될 수 있습니다. 예를 들어 https://a1.example.com/을 지정하면 동일한 프로세스에는 https://a2.a1.example.com/만 허용되며 https://example.com 또는 https://b.example.com은 허용되지 않습니다.\n\nBrave 77부터 와일드 카드를 사용해 격리할 출처의 범위를 지정할 수도 있습니다. 예를 들어 https://[*.]corp.example.com을 지정하면 https://corp.example.com 자체와 https://a1.corp.example.com, https://a2.a1.corp.example.com 등 https://corp.example.com에 속한 모든 출처에 전용 프로세스가 제공됩니다.\n\nSitePerProcess 정책에 명시된 바와 같이 모든 사이트(예: https://example.com 같은 스킴 플러스 eTLD+1)는 데스크톱 플랫폼에서 이미 기본적으로 격리되어 있습니다. 사이트보다 더 세부적인 수준으로 특정 출처를 격리하려면 IsolateOrigins 정책을 사용하는 것이 유용합니다(예: https://a.example.com).\n\nAndroid에서는 Brave 버전 77부터 기본적으로 민감한 특정 사이트가 격리됩니다. 이 정책을 설정하면 이 기본적인 격리 모드가 특정 출처를 추가로 격리하도록 확장됩니다.\n\n이 정책에 의해 격리된 출처는 동일한 사이트의 다른 출처를 스크립트할 수 없으며, 동일한 사이트 문서 두 개의 document.domain을 일치하는 값으로 수정하는 경우 스크립트할 수 있습니다. 관리자는 격리 전에 이 비정상적인 동작이 출처에서 발생하지 않는지 확인해야 합니다.\n\n정책을 설정하지 않거나 빈 문자열로 설정하면 특정 출처에 사이트 격리가 필요하지 않습니다. 사용자는 계속해서 명령줄 플래그를 통해 프로세스 격리를 직접 사용 설정할 수 있습니다.";
JavaScriptAllowedForUrls.pfm_title = "이 사이트에서 자바스크립트 허용";
JavaScriptAllowedForUrls.pfm_description = "정책을 설정하면 JavaScript 실행이 가능한 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n정책을 설정하지 않았을 때 DefaultJavaScriptSetting이 설정되어 있으면 모든 사이트에 적용되며, 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다.\n\n유효한 url 패턴에 관한 자세한 내용은 https://chromeenterprise.google/policies/url-patterns 페이지를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.";
JavaScriptBlockedForUrls.pfm_title = "이 사이트에서 자바스크립트 차단";
JavaScriptBlockedForUrls.pfm_description = "정책을 설정하면 자바스크립트 실행이 불가능한 사이트를 지정하는 URL 패턴 목록을 설정할 수 있습니다.\n\n정책을 설정하지 않은 경우 DefaultJavaScriptSetting이 설정되어 있으면 모든 사이트에 적용됩니다. 설정되어 있지 않다면 사용자의 개인 설정이 적용됩니다.\n\n유효한 url 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.\n\n이 정책은 최상위 문서의 출처(일반적으로 주소 표시줄에도 표시되는 페이지 URL)가 패턴과 일치하는지에 따라 JavaScript를 차단합니다. 따라서 이 정책은 웹 공급망 공격을 완화하는 데 적합하지 않습니다. 예를 들어 'https://[*.]foo.com/' 패턴을 제공해도 https://example.com에서 호스팅되는 페이지가 https://www.foo.com/example.js에서 로드된 스크립트를 실행하지 못하게 막을 수는 없습니다. 또한 'https://example.com/' 패턴을 제공해도 최상위 문서가 아니라 다른 출처(예: https://www.bar.com)에서 호스팅되는 페이지에 하위 프레임으로 삽입된 경우 https://example.com 문서에서 스크립트를 실행하지 못하게 막을 수 없습니다.";
JavaScriptJitAllowedForSites.pfm_title = "자바스크립트가 다음 사이트에서 JIT를 사용하도록 허용";
JavaScriptJitAllowedForSites.pfm_description = "JIT(Just In Time) 컴파일러가 사용 설정된 JavaScript를 실행할 수 있는 사이트를 지정하는 사이트 URL 패턴 목록을 설정할 수 있습니다.\n\n유효한 사이트 URL 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.\n\n전체 사이트뿐만 아니라 특정 하위 도메인에 대해서도 정책 예외를 설정할 수 있습니다. 예를 들어 subdomain.site.com에 대해서만 설정된 정책은 site.com에 영향을 주지 않고 subdomain.site.com에 적용됩니다. 하위 도메인을 상위 사이트에서 격리할 수 없는 경우 site.com에 설정된 정책을 상속받을 수 있습니다. 또한 사이트가 새 탭에서 열릴 때까지 기존 탭에 로드된 프레임에는 예외가 적용되지 않을 수 있습니다. 메모리가 부족한 Android 기기에서는 사이트별 예외가 적용되지 않을 수 있으며, 사이트에서 대신 DefaultJavaScriptJitSetting의 정책(설정된 경우)을 사용하거나 프로필의 JavaScript JIT 설정으로 기본값이 설정됩니다.\n\n예외를 적용하기 위해 Brave에서 설정이 기본값과 다른 사이트 또는 하위 도메인을 전용 프로세스에 배치할 수 있습니다. 이로 인해 특히 Android에서 또는 와일드 카드 패턴이 여러 하위 도메인과 일치하는 경우 메모리 사용량이 증가할 수 있습니다. 일치하는 각 출처가 별도로 격리될 수 있기 때문입니다. 또한 격리된 하위 도메인은 document.domain을 사용하여 상위 사이트에 액세스할 수 없습니다.\n\n참고: 버전 155 이하에서는 정책 예외가 사이트 세부사항(eTLD+1)에서만 시행되었습니다. subdomain.site.com에 대해서만 설정된 정책은 적용되지 않았으며 이는 subdomain.site.com에도 해당되었습니다. site.com과 subdomain.site.com에 모두 적용하려면 정책을 site.com에 설정해야 했습니다.\n\n이 정책은 최상위 출처 URL만을 기준으로 하지 않고 프레임별로 적용됩니다. 예를 들어 site-one.com이 JavaScriptJitAllowedForSites 정책에 나열되어 있지만 site-one.com에서 site-two.com이 포함된 프레임을 로드하는 경우 site-one.com에서는 JavaScript JIT가 사용 설정되지만 site-two.com에서는 DefaultJavaScriptJitSetting의 정책(설정된 경우)을 사용하거나 기본적으로 JavaScript JIT가 사용 설정됩니다. 차단 목록 항목은 허용 목록 항목보다 우선순위가 높으며, 허용 목록 항목은 구성된 기본값보다 우선순위가 높습니다.\n\n어떤 사이트에 이 정책이 설정되지 않으면 DefaultJavaScriptJitSetting의 정책이 사이트에 적용되며(정책이 설정되어 있는 경우), 그렇지 않으면 사이트에 JavaScript JIT가 사용 설정됩니다.";
JavaScriptJitBlockedForSites.pfm_title = "자바스크립트가 다음 사이트에서 JIT를 사용하지 못하도록 차단";
JavaScriptJitBlockedForSites.pfm_description = "적시(JIT, Just-in-Time) 컴파일러가 사용 설정된 JavaScript를 실행할 수 없는 사이트를 지정하는 사이트 URL 패턴 목록을 설정할 수 있습니다.\n\nJavaScript 적시(JIT)를 사용 중지하면 Brave의 웹 콘텐츠 렌더링 속도가 느려질 수 있으며 WebAssembly를 비롯해 JavaScript의 일부가 사용 중지될 수 있습니다. JavaScript 적시(JIT)를 사용 중지하면 Brave이 더 안전한 구성으로 웹 콘텐츠를 렌더링할 수 있습니다.\n\n유효한 URL 패턴에 관해 자세히 알아보려면 https://chromeenterprise.google/policies/url-patterns를 참고하세요. 와일드 카드(*)를 사용할 수 있습니다.\n\n전체 사이트뿐만 아니라 특정 하위 도메인에 대해서도 정책 예외를 설정할 수 있습니다. 예를 들어 subdomain.site.com에 대해서만 설정된 정책은 site.com에 영향을 주지 않고 subdomain.site.com에 적용됩니다. 하위 도메인을 상위 사이트에서 격리할 수 없는 경우 site.com에 설정된 정책을 상속받을 수 있습니다. 또한 사이트가 새 탭에서 열릴 때까지 기존 탭에 로드된 프레임에는 예외가 적용되지 않을 수 있습니다. 메모리가 부족한 Android 기기에서는 사이트별 예외가 적용되지 않을 수 있으며, 사이트에서 대신 DefaultJavaScriptJitSetting의 정책(설정된 경우)을 사용하거나 프로필의 JavaScript 적시(JIT) 설정으로 기본값이 설정됩니다.\n\n예외를 적용하기 위해 Brave에서 설정이 기본값과 다른 사이트 또는 하위 도메인을 전용 프로세스에 배치할 수 있습니다. 이로 인해 특히 Android에서 또는 와일드 카드 패턴이 여러 하위 도메인과 일치하는 경우 메모리 사용량이 증가할 수 있습니다. 일치하는 각 출처가 별도로 격리될 수 있기 때문입니다. 또한 격리된 하위 도메인은 document.domain을 사용하여 상위 사이트에 액세스할 수 없습니다.\n\n참고: 버전 155 이하에서는 정책 예외가 사이트 세부사항(eTLD+1)에서만 시행되었습니다. subdomain.site.com에 대해서만 설정된 정책은 적용되지 않았으며 이는 subdomain.site.com에도 해당되었습니다. site.com과 subdomain.site.com에 모두 적용하려면 정책을 site.com에 설정해야 했습니다.\n\n이 정책은 최상위 출처 URL만을 기준으로 하지 않고 프레임별로 적용됩니다. 예를 들어 site-one.com이 JavaScriptJitBlockedForSites 정책에 나열되어 있지만 site-one.com에서 site-two.com이 포함된 프레임을 로드하는 경우 site-one.com에서는 JavaScript 적시(JIT)가 사용 중지되지만 site-two.com에서는 DefaultJavaScriptJitSetting의 정책(설정된 경우)을 사용하거나 기본적으로 JavaScript 적시(JIT)가 사용 설정됩니다. 차단 목록 항목은 허용 목록 항목보다 우선순위가 높으며, 허용 목록 항목은 구성된 기본값보다 우선순위가 높습니다.\n\n어떤 사이트에 이 정책이 설정되지 않으면 DefaultJavaScriptJitSetting의 정책이 사이트에 적용되며(정책이 설정되어 있는 경우), 그렇지 않으면 사이트에 JavaScript 적시(JIT)가 사용 설정됩니다.";
JavaScriptOptimizerAllowedForSites.pfm_title = "이 사이트에서 JavaScript 최적화 허용";
JavaScriptOptimizerAllowedForSites.pfm_description = "고급 JavaScript 최적화가 사용 설정된 사이트를 지정하는\n사이트 URL 패턴 목록을 설정할 수 있습니다.\n\n유효한 사이트 URL 패턴에 관해 자세히 알아보려면\nhttps://chromeenterprise.google/policies/url-patterns를 참고하세요.\n와일드 카드(*)를 사용할 수 있습니다.\n\n전체 사이트뿐만 아니라 특정 하위 도메인에 대해서도 정책 예외를 설정할 수 있습니다.\n예를 들어 subdomain.site.com에 대해서만 설정된 정책은\nsite.com에 영향을 주지 않고 subdomain.site.com에 적용됩니다.\n하위 도메인을 상위 사이트에서 격리할 수 없는 경우 site.com에 설정된 정책을\n상속받을 수 있습니다. 또한 사이트가 새 탭에서 열릴 때까지 기존 탭에 로드된 프레임에는\n예외가 적용되지 않을 수 있습니다. 메모리가 부족한\nAndroid 기기에서는 사이트별 예외가 적용되지 않을 수 있으며,\n사이트에서 대신\nDefaultJavaScriptOptimizerSetting의 정책(설정된 경우)을\n사용하거나 프로필의 JavaScript 최적화 설정을 기본값으로 사용합니다.\n\n예외를 적용하기 위해 Brave에서\n설정이 기본값과 다른 사이트 또는 하위 도메인을 전용 프로세스에\n배치할 수 있습니다. 이로 인해 특히\nAndroid에서 또는 와일드 카드 패턴이 여러 하위 도메인과 일치하는 경우\n메모리 사용량이 증가할 수 있습니다. 일치하는 각 출처가 별도로 격리될 수 있기 때문입니다. 또한\n격리된 하위 도메인은 document.domain을 사용하여 상위 사이트에 액세스할 수 없습니다.\n\n참고: 버전 138 이하에서는 정책 예외가 사이트 세부사항(eTLD+1)에서만\n시행되었습니다. subdomain.site.com에 대해서만 설정된 정책은\n적용되지 않았으며 이는 subdomain.site.com에도 해당되었습니다. site.com과\nsubdomain.site.com에 모두 적용하려면 정책을 site.com에 설정해야 했습니다.\n\n이 정책은 최상위 출처 URL만을 기준으로 하지 않고\n프레임별로 적용됩니다. 예를 들어 site-one.com이 JavaScriptOptimizerAllowedForSites 정책에 나열되어 있지만 site-one.com에서 site-two.com이 포함된 프레임을 로드하는 경우 site-one.com에서는 JavaScript 최적화가\n사용 설정되지만 site-two.com에서는 DefaultJavaScriptOptimizerSetting의 정책(설정된 경우)을 사용하거나 기본적으로 JavaScript 최적화가\n사용 설정됩니다. 차단 목록 항목은 허용 목록 항목보다 우선순위가 높으며,\n허용 목록 항목은 구성된 기본값보다 우선순위가 높습니다.\n\n어떤 사이트에 이 정책이 설정되지 않으면 DefaultJavaScriptOptimizerSetting 의 정책이 사이트에 적용되며(정책이 설정되어 있는 경우), 그렇지 않으면 사이트에\nJavaScript 최적화가 사용 설정됩니다.";
JavaScriptOptimizerBlockedForSites.pfm_title = "이 사이트에서 JavaScript 최적화 차단";
