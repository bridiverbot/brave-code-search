--crate-name
test_rust_unittests
--crate-type
bin
--cfg
feature="test"
--test
-Dwarnings
-Csplit-debuginfo=unpacked
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--color=always
--target=x86_64-apple-darwin
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
--cfg
cr_rustc_revision="110108a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-8a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-1-24-14453-ge063be79"
-Copt-level=3
-Cforce-frame-pointers=yes
-Zdwarf-version=4
-g
-Zallow-features=
-Cdebug-assertions
-Zdefault-visibility=hidden
--edition=2024
--sysroot=local_rustc_sysroot
-Ldependency=obj/build/rust/tests/test_rust_static_library
-Ldependency=obj/third_party/rust/cxx/v1/lib
-Ldependency=clang_x64_for_rust_host_build_tools
-Ldependency=obj/third_party/rust/foldhash/v0_2/lib
-Ldependency=local_rustc_sysroot/lib/rustlib/x86_64-apple-darwin/lib
-Ldependency=obj/build/rust/allocator
-Ldependency=obj/build/rust/chromium_prelude
-Clink-arg=-Bdynamic
-Clink-arg=obj/build/rust/tests/test_rust_static_library/libtest_rust_static_library_cxx_generated.a
-Clink-arg=obj/build/rust/libcxx_cppdeps_lib.a
-Clink-arg=obj/build/rust/allocator/liballoc_error_handler_impl.a
-Clink-arg=./libc++_chrome.dylib
-Clink-arg=local_rustc_sysroot/lib/rustlib/x86_64-apple-darwin/lib/libgetopts_getopts.rlib
-Clink-arg=local_rustc_sysroot/lib/rustlib/x86_64-apple-darwin/lib/librustc_std_workspace_std_rustc_std_workspace_std.rlib
-Clink-arg=local_rustc_sysroot/lib/rustlib/x86_64-apple-darwin/lib/libtest_test.rlib
-Clink-arg=../../third_party/llvm-build/Release+Asserts/lib/clang/24/lib/darwin/libclang_rt.osx.a
--extern
test_rust_static_library_2e6cac4b=obj/build/rust/tests/test_rust_static_library/libtest_rust_static_library_2e6cac4b.rlib
--extern
cxx=obj/third_party/rust/cxx/v1/lib/libcxx_lib.rlib
