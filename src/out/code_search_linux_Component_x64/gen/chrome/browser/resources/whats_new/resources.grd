<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/whats_new_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/whats_new_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/whats_new_resources_map.h"
            type="resource_map_header" />
    <output filename="whats_new_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_WHATS_NEW_WHATS_NEW_HTML" file="${root_gen_dir}/chrome/browser/resources/whats_new/preprocessed/whats_new.html" resource_path="whats_new.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WHATS_NEW_FORMAT_MODULE_NAME_JS" file="${root_gen_dir}/chrome/browser/resources/whats_new/minified/format_module_name.js" resource_path="format_module_name.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WHATS_NEW_HANDLERS_JS" file="${root_gen_dir}/chrome/browser/resources/whats_new/minified/handlers.js" resource_path="handlers.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WHATS_NEW_TYPES_JS" file="${root_gen_dir}/chrome/browser/resources/whats_new/minified/types.js" resource_path="types.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WHATS_NEW_WHATS_NEW_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/whats_new/minified/whats_new_app.html.js" resource_path="whats_new_app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WHATS_NEW_WHATS_NEW_APP_JS" file="${root_gen_dir}/chrome/browser/resources/whats_new/minified/whats_new_app.js" resource_path="whats_new_app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WHATS_NEW_WHATS_NEW_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/whats_new/minified/whats_new_app.css.js" resource_path="whats_new_app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WHATS_NEW_WHATS_NEW_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/whats_new/minified/whats_new.mojom-webui.js" resource_path="whats_new.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
