<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/bookmarks_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/bookmarks_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/bookmarks_resources_map.h"
            type="resource_map_header" />
    <output filename="bookmarks_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_BOOKMARKS_IMAGES_BATCH_UPLOAD_BOOKMARKS_PROMO_SVG" file="${root_src_dir}/chrome/browser/resources/bookmarks/images/batch_upload_bookmarks_promo.svg" resource_path="images/batch_upload_bookmarks_promo.svg" use_base_dir="false" type="BINDATA" />
      <include name="IDR_BOOKMARKS_IMAGES_BATCH_UPLOAD_BOOKMARKS_PROMO_DARK_SVG" file="${root_src_dir}/chrome/browser/resources/bookmarks/images/batch_upload_bookmarks_promo_dark.svg" resource_path="images/batch_upload_bookmarks_promo_dark.svg" use_base_dir="false" type="BINDATA" />
      <include name="IDR_BOOKMARKS_BOOKMARKS_HTML" file="${root_gen_dir}/chrome/browser/resources/bookmarks/preprocessed/bookmarks.html" resource_path="bookmarks.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BOOKMARKS_BOOKMARKS_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/bookmarks/minified/bookmarks.rollup.js" resource_path="bookmarks.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
