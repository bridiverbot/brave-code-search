#ifndef __METAL_UTILITY
#define __METAL_UTILITY

namespace metal
{
template <typename T, T... I>
struct _integer_sequence
{
  typedef T value_type;
  static constexpr size_t size()
  {
    return sizeof...(I);
  }
};
template <typename T, T N>
using _make_integer_sequence = __make_integer_seq<_integer_sequence, T, N>;
#ifdef __cpp_variable_templates
template <typename T, T... I>
using integer_sequence = _integer_sequence<T, I...>;
template <typename T, T N>
using make_integer_sequence = _make_integer_sequence<T, N>;

#if defined(__HAVE_UTILITY_INDEX_SEQUENCE__)
template <size_t... Ints>
using index_sequence = integer_sequence<size_t, Ints...>;
template <size_t N>
using make_index_sequence = make_integer_sequence<size_t, N>;
#endif
#endif

#if defined(__HAVE_GENERIC_ADDRESS_SPACE__)
template <typename T>
constexpr typename remove_reference<T>::type &&move(T &&t)
{
  return static_cast<typename remove_reference<T>::type &&>(t);
}
#else
template <typename T>
constexpr thread typename remove_reference<T>::type &&move(thread T &&t)
{
  return static_cast<thread typename remove_reference<T>::type &&>(t);
}
#endif

#if defined(__HAVE_UTILITY_AS_CONST__)
template <class T>
#if defined(__HAVE_GENERIC_ADDRESS_SPACE__)
constexpr add_const_t<T> &as_const(T &t)
#else
constexpr thread add_const_t<T> &as_const(thread T &t)
#endif
{
  return t;
};

#if defined(__HAVE_GENERIC_ADDRESS_SPACE__)
template <class T>
void as_const(const T &&t) = delete;
#else
template <class T>
void as_const(const thread T &&t) = delete;
#endif
#endif

#if defined(__HAVE_GENERIC_ADDRESS_SPACE__)
template <typename T> T &&__declval(int);
#else
template <typename T> thread T &&__declval(int);
#endif
template <typename T> T   __declval(long);
template <typename T> decltype(__declval<T>(0)) declval();
} // namespace metal

#endif // __METAL_UTILITY
