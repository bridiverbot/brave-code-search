<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/translate_internals_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/translate_internals_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/translate_internals_resources_map.h"
            type="resource_map_header" />
    <output filename="translate_internals_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_TRANSLATE_INTERNALS_TRANSLATE_INTERNALS_CSS" file="${root_gen_dir}/components/translate/translate_internals/preprocessed/translate_internals.css" resource_path="translate_internals.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_TRANSLATE_INTERNALS_TRANSLATE_INTERNALS_HTML" file="${root_gen_dir}/components/translate/translate_internals/preprocessed/translate_internals.html" resource_path="translate_internals.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_TRANSLATE_INTERNALS_TRANSLATE_INTERNALS_JS" file="${root_gen_dir}/components/translate/translate_internals/minified/translate_internals.js" resource_path="translate_internals.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
