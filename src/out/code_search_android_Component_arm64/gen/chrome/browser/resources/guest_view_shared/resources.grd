<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/guest_view_shared_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/guest_view_shared_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/guest_view_shared_resources_map.h"
            type="resource_map_header" />
    <output filename="guest_view_shared_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_GUEST_VIEW_SHARED_EVENT_DISPATCHER_JS" file="${root_gen_dir}/chrome/browser/resources/guest_view_shared/minified/event_dispatcher.js" resource_path="shared/guest_view/event_dispatcher.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_GUEST_VIEW_SHARED_REQUEST_THROTTLERS_JS" file="${root_gen_dir}/chrome/browser/resources/guest_view_shared/minified/request_throttlers.js" resource_path="shared/guest_view/request_throttlers.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_GUEST_VIEW_SHARED_SLIM_WEBVIEW_JS" file="${root_gen_dir}/chrome/browser/resources/guest_view_shared/minified/slim_webview.js" resource_path="shared/guest_view/slim_webview.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_GUEST_VIEW_SHARED_SLIM_WEBVIEW_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/guest_view_shared/minified/slim_webview.html.js" resource_path="shared/guest_view/slim_webview.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_GUEST_VIEW_SHARED_SLIM_WEBVIEW_BROWSER_PROXY_JS" file="${root_gen_dir}/chrome/browser/resources/guest_view_shared/minified/slim_webview_browser_proxy.js" resource_path="shared/guest_view/slim_webview_browser_proxy.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_GUEST_VIEW_SHARED_SLIM_WEBVIEW_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/guest_view_shared/minified/slim_webview.css.js" resource_path="shared/guest_view/slim_webview.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_GUEST_VIEW_SHARED_SLIM_WEB_VIEW_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/guest_view_shared/minified/slim_web_view.mojom-webui.js" resource_path="shared/guest_view/slim_web_view.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
