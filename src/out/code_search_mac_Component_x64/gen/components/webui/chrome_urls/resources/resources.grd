<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/chrome_urls_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/chrome_urls_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/chrome_urls_resources_map.h"
            type="resource_map_header" />
    <output filename="chrome_urls_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_CHROME_URLS_CHROME_URLS_HTML" file="${root_gen_dir}/components/webui/chrome_urls/resources/preprocessed/chrome_urls.html" resource_path="chrome_urls.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CHROME_URLS_APP_HTML_JS" file="${root_gen_dir}/components/webui/chrome_urls/resources/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CHROME_URLS_APP_JS" file="${root_gen_dir}/components/webui/chrome_urls/resources/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CHROME_URLS_APP_CSS_JS" file="${root_gen_dir}/components/webui/chrome_urls/resources/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CHROME_URLS_CHROME_URLS_MOJOM_WEBUI_JS" file="${root_gen_dir}/components/webui/chrome_urls/resources/minified/chrome_urls.mojom-webui.js" resource_path="chrome_urls.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
