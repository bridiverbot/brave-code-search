-Clinker=../../third_party/llvm-build/Release+Asserts/bin/lld-link
-Clink-arg=--rsp-quoting=posix
--crate-name
compiler_builtins
--crate-type
rlib
--cfg=backtrace_in_libstd
-Zforce-unstable-if-unmarked
--cap-lints=allow
--cfg
intrinsics_enabled
--cfg
optimizations_enabled
--cfg
mem_unaligned
--cfg=feature="arch"
--cfg=feature="compiler-builtins"
--cfg=feature="default"
--cfg=feature="unmangled-names"
--edition=2024
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--target=x86_64-pc-windows-msvc
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
--cfg
cr_rustc_revision="110108a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-8a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-1-24-14453-ge063be79"
-Copt-level=3
-Cllvm-args=-pick-merged-source-locations
-g
-Cdebug-assertions
-Ccontrol-flow-guard
-Dwarnings
-Ccodegen-units=10000
--sysroot=local_rustc_sysroot
-Ldependency=local_rustc_sysroot/lib/rustlib/x86_64-pc-windows-msvc/lib
-Clink-arg=../../third_party/llvm-build/Release+Asserts/lib/clang/24/lib/windows/clang_rt.builtins-x86_64.lib
--extern
core=local_rustc_sysroot/lib/rustlib/x86_64-pc-windows-msvc/lib/libcore_core.rlib