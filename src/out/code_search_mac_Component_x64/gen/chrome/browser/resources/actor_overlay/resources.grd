<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/actor_overlay_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/actor_overlay_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/actor_overlay_resources_map.h"
            type="resource_map_header" />
    <output filename="actor_overlay_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_ACTOR_OVERLAY_ACTOR_OVERLAY_HTML" file="${root_gen_dir}/chrome/browser/resources/actor_overlay/preprocessed/actor_overlay.html" resource_path="actor_overlay.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ACTOR_OVERLAY_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/actor_overlay/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ACTOR_OVERLAY_APP_JS" file="${root_gen_dir}/chrome/browser/resources/actor_overlay/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ACTOR_OVERLAY_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/actor_overlay/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ACTOR_OVERLAY_ACTOR_OVERLAY_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/actor_overlay/minified/actor_overlay.mojom-webui.js" resource_path="actor_overlay.mojom-webui.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ACTOR_OVERLAY_APP_CHROMIUM_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/actor_overlay/minified/app-chromium.css.js" resource_path="app-chromium.css.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
