#endif
#endif

private:
  static_assert(__mdspan_detail::is_extents_v<Extents>,
                "tensor: Extents template parameter must be a specialization of extents");
  static_assert(__tensor_detail::__is_tensor_index_v<typename Extents::index_type>,
                "tensor: Index type template parameter of extents must be one of (u)short/(u)int/(u)long");
  static_assert(__tensor_detail::__is_tensor_rank(Extents::rank()),
                "tensor: Rank template parameter of extents must be at most 16");
  static_assert(__tensor_detail::__is_tensor_element_v<ElementType>,
#if defined(__HAVE_PACKED_NUMERIC__)
                "tensor: ElementType must be a scalar integer, floating point, or format type"
#else
                "tensor: ElementType must be a scalar integer or floating point type"
#endif
  );
  static_assert(!__tensor_detail::__is_tensor_element_format_v<ElementType> || Extents::rank() != 0,
                "tensor: ElementType cannot be a format type for rank 0 tensors");
  static_assert(__tensor_detail::__is_tensor_addrspace_v<tensor_inline, ElementType>,
#if defined(__HAVE_GENERIC_ADDRESS_SPACE__)
                "tensor: ElementType may either not have an address space or have thread, device, constant or threadgroup qualifier");
#else
                "tensor: ElementType must be thread, device, constant or threadgroup qualified");
#endif
#if defined(__HAVE_TENSOR_MULTIPLANE__)
