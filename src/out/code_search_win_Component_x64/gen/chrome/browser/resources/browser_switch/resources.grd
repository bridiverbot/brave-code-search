<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/browser_switch_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/browser_switch_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/browser_switch_resources_map.h"
            type="resource_map_header" />
    <output filename="browser_switch_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_BROWSER_SWITCH_BROWSER_SWITCH_HTML" file="${root_gen_dir}/chrome/browser/resources/browser_switch/preprocessed/browser_switch.html" resource_path="browser_switch.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BROWSER_SWITCH_INTERNALS_BROWSER_SWITCH_INTERNALS_HTML" file="${root_gen_dir}/chrome/browser/resources/browser_switch/preprocessed/internals/browser_switch_internals.html" resource_path="internals/browser_switch_internals.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BROWSER_SWITCH_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/browser_switch/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BROWSER_SWITCH_APP_JS" file="${root_gen_dir}/chrome/browser/resources/browser_switch/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BROWSER_SWITCH_BROWSER_SWITCH_PROXY_JS" file="${root_gen_dir}/chrome/browser/resources/browser_switch/minified/browser_switch_proxy.js" resource_path="browser_switch_proxy.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BROWSER_SWITCH_INTERNALS_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/browser_switch/minified/internals/app.html.js" resource_path="internals/app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BROWSER_SWITCH_INTERNALS_APP_JS" file="${root_gen_dir}/chrome/browser/resources/browser_switch/minified/internals/app.js" resource_path="internals/app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BROWSER_SWITCH_INTERNALS_BROWSER_SWITCH_INTERNALS_PROXY_JS" file="${root_gen_dir}/chrome/browser/resources/browser_switch/minified/internals/browser_switch_internals_proxy.js" resource_path="internals/browser_switch_internals_proxy.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BROWSER_SWITCH_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/browser_switch/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_BROWSER_SWITCH_INTERNALS_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/browser_switch/minified/internals/app.css.js" resource_path="internals/app.css.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
