#pragma METAL internals : enable
// Type validation for non-fetch atomic operations (store, load, exchange, compare_exchange)
template <typename T, typename _E = void>
struct _valid_non_fetch_type : false_type
{
};

template <typename T>
struct _valid_non_fetch_type<T, typename enable_if<_disjunction<is_same<T, device int *>,
                                                                is_same<T, threadgroup int *>,
                                                                is_same<T, device uint *>,
                                                                is_same<T, threadgroup uint *>
#if defined(__HAVE_ATOMIC_FLOAT__)
                                                                ,
                                                                is_same<T, device float *>
#endif
#if defined(__HAVE_ATOMIC_THREADGROUP_FLOAT__)
                                                                ,
                                                                is_same<T, threadgroup float *>
#endif
#if defined(__HAVE_ATOMIC_BOOL__)
                                                                ,
                                                                is_same<T, device bool *>,
                                                                is_same<T, threadgroup bool *>
#endif
#if defined(__HAVE_GENERIC_ADDRESS_SPACE__)
                                                                ,
                                                                is_same<T, int *>,
                                                                is_same<T, uint *>,
                                                                is_same<T, float *>,
                                                                is_same<T, bool *> ,
                                                                is_same<T, thread int *>,
                                                                is_same<T, thread uint *>,
                                                                is_same<T, thread float *>,
                                                                is_same<T, thread bool *>
#endif
                                                                >::value>::type> : true_type
{
};
