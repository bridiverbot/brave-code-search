-Clink-arg=obj/buildtools/third_party/libunwind/libunwind/UnwindRegistersSave.o
-Clink-arg=obj/third_party/compiler-rt/atomic/atomic.o
-Clink-arg=obj/buildtools/third_party/libc++/libc++.a
-Clink-arg=obj/buildtools/third_party/libc++abi/libc++abi.a
-Clink-arg=local_rustc_sysroot/lib/rustlib/aarch64-linux-android/lib/libstd_std.rlib
