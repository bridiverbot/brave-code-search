<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/crashes_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/crashes_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/crashes_resources_map.h"
            type="resource_map_header" />
    <output filename="crashes_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_CRASHES_SADTAB_SVG" file="${root_src_dir}/components/crash/core/browser/resources/sadtab.svg" resource_path="sadtab.svg" use_base_dir="false" type="BINDATA" />
      <include name="IDR_CRASHES_CRASHES_CSS" file="${root_gen_dir}/components/crash/core/browser/resources/preprocessed/crashes.css" resource_path="crashes.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_CRASHES_CRASHES_HTML" file="${root_gen_dir}/components/crash/core/browser/resources/preprocessed/crashes.html" resource_path="crashes.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_CRASHES_CRASHES_JS" file="${root_gen_dir}/components/crash/core/browser/resources/minified/crashes.js" resource_path="crashes.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
