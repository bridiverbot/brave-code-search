<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/tracing_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/tracing_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/tracing_resources_map.h"
            type="resource_map_header" />
    <output filename="tracing_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_TRACING_ABOUT_TRACING_HTML" file="${root_gen_dir}/content/browser/tracing/about_tracing.html" resource_path="about_tracing.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_TRACING_ABOUT_TRACING_JS" file="${root_gen_dir}/content/browser/tracing/about_tracing.js" resource_path="about_tracing.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
