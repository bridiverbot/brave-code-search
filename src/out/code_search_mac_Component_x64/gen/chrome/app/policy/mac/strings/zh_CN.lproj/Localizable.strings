/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "“Brave”偏好设置";
AIModeSettings.pfm_title = "地址栏和新标签页搜索框的 Google AI 模式集成设置。";
AIModeSettings.pfm_description = "0 - 允许集成 AI 模式。\n1 - 不允许集成 AI 模式。\n此政策用于控制地址栏和新标签页搜索框的 Google AI 模式集成。\n\n如需使用此功能，必须将 Google 设为用户的默认搜索引擎。\n\n0 = 用户可以使用此功能。\n\n1 = 用户将无法使用此功能。\n\n如果此政策未设置，其行为将由“GenAiDefaultSettings”政策决定。";
AbusiveExperienceInterventionEnforce.pfm_title = "针对误导性体验的强制干预政策";
AbusiveExperienceInterventionEnforce.pfm_description = "如果 SafeBrowsingEnabled 未停用，您便可通过启用或不设置 AbusiveExperienceInterventionEnforce 来阻止提供误导性体验的网站打开新窗口或标签页。\n\n如果 SafeBrowsingEnabled 已停用或者 AbusiveExperienceInterventionEnforce 已停用，系统会允许提供误导性体验的网站打开新窗口或标签页。";
AccessCodeCastDeviceDuration.pfm_title = "指定使用访问代码或二维码选择的投放设备会在 Google Cast 菜单的投放设备列表中保留多长时间（以秒为单位）。";
AccessCodeCastDeviceDuration.pfm_description = "此政策用于指定以前使用访问代码或二维码选择的投放设备可在 Google Cast 投放设备菜单中持续显示多长时间（以秒为单位）。\n条目的有效期从用户首次输入访问代码或首次扫描二维码时起算。\n在此时间段内，相应的投放设备会显示在 Google Cast 菜单的投放设备列表中。\n待此时间段过后，若要再次使用相应的投放设备，用户必须重新输入访问代码或重新扫描二维码。\n默认情况下，此时间段为 0 秒，因此投放设备不会显示在 Google Cast 菜单中，而这样一来，用户就必须重新输入访问代码或重新扫描二维码才能启动新的投放会话。\n请注意，此政策仅会影响投放设备在 Google Cast 菜单中的显示时长，丝毫不会影响任何正在进行的投放会话（即使此时间段已过，这类会话仍会继续）。\n此政策只有在已启用 AccessCodeCastEnabled 政策的情况下才会生效。";
AccessCodeCastEnabled.pfm_title = "允许用户从 Google Cast 菜单中使用访问代码或二维码选择投放设备。";
AccessCodeCastEnabled.pfm_description = "此政策可控制系统是否会在 Google Cast 菜单中为用户提供一个选项，以允许他们使用 Google Cast 菜单中未包含的投放设备的屏幕上显示的访问代码或二维码投放至这些投放设备。\n默认情况下，用户必须重新输入访问代码或重新扫描二维码才能启动后续投放会话，但如果 AccessCodeCastDeviceDuration 政策已设为非 0 值（默认值为 0），那么投放设备将保留在可用投放设备列表中，直到指定时间段已过。\n如果此政策已启用，系统将为用户提供通过使用访问代码或扫描二维码选择投放设备的选项。\n如果此政策已停用或未设置，系统将不会为用户提供通过使用访问代码或扫描二维码选择投放设备的选项。";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "使 CORS 预检请求中的 Access-Control-Allow-Methods 匹配合乎规范";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "此政策用于控制是否应大写与 CORS 预检请求中的 Access-Control-Allow-Methods 响应标头匹配的请求方法。\n\n如果此政策已停用，请求方法都会采用大写形式。\n这是 Brave 108 版或之前版本上的行为。\n\n如果此政策已启用或未设置，请求方法都不会采用大写形式，除非在不区分大小写的情况下与 DELETE、GET、HEAD、OPTIONS、POST 或 PUT 匹配。\n这样会拒绝 fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" 响应标头但接受 fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\" 响应标头。\n\n注意：请求方法 \"post\" 和 \"put\" 不受影响，而 \"patch\" 会受到影响。\n\n此政策只是暂时性措施，日后会被移除。";
AccessibilityImageLabelsEnabled.pfm_title = "启用“Get Image Descriptions from Google”。";
AccessibilityImageLabelsEnabled.pfm_description = "无障碍功能“Get Image Descriptions from Google”让使用屏幕阅读器的视障用户能够获取对无标签网络图片的说明。如果选择启用该功能，用户将能选择使用匿名 Google 服务为他们遇到的无标签网络图片提供自动说明。\n\n如果该功能已启用，系统会将图片内容发送给 Google 服务器以便生成说明，但不会发送任何 Cookie 或其他用户数据，而且 Google 不会保存或记录任何图片内容。\n\n如果此政策已启用，系统将会启用“Get Image Descriptions from Google”功能，但这仅会影响使用屏幕阅读器或其他类似辅助技术的用户。\n\n如果此政策已停用，用户将无法选择启用该功能。\n\n如果此政策未设置，用户可以选择是否使用该功能。\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "允许针对其他 DNS 记录类型发出 DNS 查询";
AdditionalDnsQueryTypesEnabled.pfm_description = "此政策旨在控制 Brave 能否在发出不安全的 DNS 请求时查询其他 DNS 记录类型。此政策对通过安全 DNS 进行的 DNS 查询没有影响，这类查询始终都能查询其他 DNS 类型。\n\n如果此政策已启用或未设置，即意味着除了能查询 A（DNS 类型 1）和 AAAA（DNS 类型 28）之外，还能查询其他类型，例如 HTTPS（DNS 类型 65）。\n\n如果此政策已停用，则意味着只能针对 A（DNS 类型 1）和/或 AAAA（DNS 类型 28）进行 DNS 查询。\n\n此政策只是一项暂时性措施，会从 Brave 的未来版本中移除。移除此政策后，Brave 将始终都能查询其他 DNS 类型。";
AdsSettingForIntrusiveAdsSites.pfm_title = "针对含侵扰性广告的网站的广告设置";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - 允许所有网站展示广告\n2 - 不允许含侵扰性广告的网站展示广告\n如果 AdsSettingForIntrusiveAdsSites 设为 1 或不设置，系统会允许所有网站展示广告，除非 SafeBrowsingEnabled 设为 False。\n\n如果此政策设为 2，系统会阻止含侵扰性广告的网站展示广告。";
AdvancedProtectionAllowed.pfm_title = "为已加入“高级保护”计划的用户启用更多保护功能";
AdvancedProtectionAllowed.pfm_description = "此政策决定了加入“高级保护”计划的用户是否可获享额外的保护。其中部分功能可能涉及与 Google 共享数据（例如，加入“高级保护”计划的用户可将他们的下载内容发送给 Google 进行恶意软件扫描）。如果此政策设为 True 或未设置，已加入“高级保护”计划的用户将会获享额外的保护。如果此政策设为 False，已加入“高级保护”计划的用户只能使用标准的消费者级功能。";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "允许所有 HTTP 身份验证的来源列表";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "此政策允许您指定哪些源可以使用 Brave 支持的所有 HTTP 身份验证方案，而无需考虑 AuthSchemes 政策。\n\n从 Brave 161 版开始，此政策仅适用于目标服务器源，不适用于代理服务器的身份验证质询。如需允许代理服务器使用所有 HTTP 身份验证方案，请改用 AllHttpAuthSchemesAllowedForProxies 政策。在 161 版之前，与此政策匹配的代理服务器也可以使用所有 HTTP 身份验证方案，除非设置了 AllHttpAuthSchemesAllowedForProxies 政策。\n\n请按 https://support.google.com/chrome/a?p=url_blocklist_filter_format 中的说明处理源的格式。最多可在 AllHttpAuthSchemesAllowedForOrigins 中定义 1,000 个例外情况。\n主机组件可以使用通配符（例如，“*:8000”匹配端口 8000 上的所有主机）。如需匹配所有方案或所有端口，请完全忽略相应组件（例如，“example.com”匹配任何方案和任何端口）。主机名（例如“example.com”）也与其子网域匹配。如需完全匹配某个主机并排除其子网域，请在其前面加上一个点（例如“.example.com”）。如需匹配所有源，请使用单个星号（“*”）。";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "可使用所有 HTTP 身份验证方案的代理服务器列表";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "此政策允许您指定哪些代理服务器可以使用 Brave 支持的所有 HTTP 身份验证方案，而无需考虑 AuthSchemes 政策。\n\n请按 https://support.google.com/chrome/a?p=url_blocklist_filter_format 中说明的网址屏蔽清单过滤器格式处理代理服务器的格式。最多可定义 1,000 个例外情况。\n主机组件可以使用通配符（例如，“*:8080”匹配端口 8080 上的所有代理）。主机名（例如“proxy.example.com”）也与其子网域匹配。如需完全匹配某个主机并排除其子网域，请在其前面加上一个点（例如“.proxy.example.com”）。\n\n如果未设置此政策，则代理身份验证仅支持 AuthSchemes 政策中指定的 HTTP 身份验证方案（如果该政策也未设置，则仅支持默认方案）。";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "允许具有“Cache-Control: no-store”标头的网页进入往返缓存";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "此政策旨在控制是否可将具有“Cache-Control: no-store”标头的网页储存在往返缓存中。设置了此标头的网站可能不希望从往返缓存中恢复相应网页，因为即使页面不再可访问，一些敏感信息仍然可能被显示出来。\n\n如果已启用或未设置此政策，除非触发了缓存逐出（例如当网站的 HTTP-Only Cookie 发生更改时），否则系统可能会从往返缓存中恢复具有“Cache-Control: no-store”标头的网页。\n\n如果已停用此政策，具有“Cache-Control: no-store”标头的网页将不会储存在往返缓存中。";
AllowCrossOriginAuthPrompt.pfm_title = "跨域 HTTP 身份验证提示";
AllowCrossOriginAuthPrompt.pfm_description = "如果已启用此政策，系统会允许网页上的第三方图片显示身份验证提示。\n\n如果已停用或未设置此政策，第三方图片将无法显示身份验证提示。\n\n通常，为防御钓鱼式攻击，此政策将被停用。";
AllowDeletingBrowserHistory.pfm_title = "允许删除浏览器历史记录和下载记录";
AllowDeletingBrowserHistory.pfm_description = "如果此政策已启用或未设置，系统将可以删除 Chrome 中的浏览器历史记录和下载记录，并且用户无法更改此设置。\n\n如果此政策已停用，系统将无法删除浏览器历史记录和下载记录。即使此政策停用，浏览和下载记录也不一定会保留。用户可能能够直接修改或删除历史记录数据库文件，而且浏览器本身也可能会随时将任意或所有历史记录项设为失效或进行归档。";
AllowDinosaurEasterEgg.pfm_title = "允许用户玩恐龙复活节彩蛋游戏";
AllowDinosaurEasterEgg.pfm_description = "如果此政策设为 True，用户可以玩恐龙游戏。如果此政策设为 False，用户无法在设备处于离线状态时玩恐龙复活节彩蛋游戏。\n\n如果此政策未设置，用户无法在已注册的 Google Chrome OS 上玩恐龙游戏，但可在其他环境下玩这款游戏。";
AllowFileSelectionDialogs.pfm_title = "允许调用文件选择对话框";
AllowFileSelectionDialogs.pfm_description = "如果此政策已启用或未设置，Chrome 便可显示文件选择对话框，而且用户可以打开这些对话框。\n\n如果此政策已停用，那么只要用户执行了会触发文件选择对话框的操作（例如导入书签、上传文件、保存链接，等等），系统就会显示一条消息，并会假定用户已在文件选择对话框中点击了“取消”。";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "允许为代理随机化套接字池大小";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "套接字池大小随机化是一种安全机制，可防止攻击者利用确定性容量限制来获取跨网站信息。\n如果池的容量通常为 128 个套接字，则此机制会将池容量随机限制在 128 到 256 之间。\n这最多可使代理连接数达到原来的 2 倍，但实际上，预期值更接近 1.2 倍。\n\n这会影响 MaxConnectionsPerProxy 和 MaxConnectionsPerProxyForWebSocket 中的设置。\n上限不再由它们直接定义，而是设为其值的 2 倍（不过，实际上，预期值更接近于其值的 1.2 倍）。\n\n默认情况下，所有池都启用此功能，但此政策允许专门为代理池停用此功能。";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "允许在 TLS 证书已损坏的网站上发出网络身份验证请求。";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "如果此政策已启用，Brave 将允许在 TLS 证书含有错误的网站（即，那些被视为不安全的网站）上发出网络身份验证请求。\n\n如果此政策已停用或未设置，系统将会应用默认行为（即，屏蔽这类请求）。";
AllowedDomainsForApps.pfm_title = "定义允许访问 Google Workspace 的网域";
AllowedDomainsForApps.pfm_description = "通过设置此政策，您可以开启 Chrome 的 Google Workspace 受限登录功能，并禁止用户更改此设置。用户只能通过来自指定网域的账号使用 Google 工具（若要允许使用 gmail 或 googlemail 账号，请将 consumer_accounts 添加到网域列表中）。在需要进行 Google 身份验证的受管设备上，此设置会禁止用户登录和添加辅助账号（如果该账号不属于明确允许的某一网域）。\n\n如果您将此设置留空/未配置此设置，用户将能够使用任何账号访问 Google Workspace。\n\n用户无法更改或覆盖此设置。\n\n请注意：此政策会致使系统将 X-GoogApps-Allowed-Domains 标头附加到向所有 google.com 网域发送的所有 HTTP 和 HTTPS 请求中，如 https://support.google.com/a/answer/1668854 中所述。";
AlternateErrorPagesEnabled.pfm_title = "启用备用的错误页面";
AlternateErrorPagesEnabled.pfm_description = "如果此政策设为 True，Brave 会使用内置的备用错误页面（例如“找不到网页”）。如果此政策设为 False，Brave 将一律不使用备用错误页面。\n\n如果您设置了此政策，用户便无法更改相关设置。如果您未设置此政策，系统会开启它，但用户可以更改此设置。";
AlternativeBrowserParameters.pfm_title = "用于启动替代浏览器的命令行参数。";
AlternativeBrowserParameters.pfm_description = "如果此政策设为一系列字符串，系统会将每个字符串作为单独的命令行参数传递到备用浏览器。在 Microsoft® Windows® 上，这些参数会以空格连接。在 macOS 和 Linux® 上，参数可以包含空格，但仍会被视为单个参数。\n\n如果有参数包含 ${url}，系统会将 ${url} 替换成要打开的网页对应的网址。如果没有参数包含 ${url}，系统会将网址附加到命令行的末尾。\n\n系统会扩展环境变量。在 Microsoft® Windows® 上，%ABC% 会被替换成 ABC 环境变量的值。在 macOS 和 Linux® 上，${ABC} 会被替换成 ABC 环境变量的值。\n\n如果您未设置此政策，系统只会将网址作为命令行参数传递。";
AlternativeBrowserPath.pfm_title = "对于配置的网站要启动的替代浏览器。";
AlternativeBrowserPath.pfm_description = "通过设置此政策，您可以控制应使用哪个命令在备用浏览器中打开网址。此政策可以设为下列任一值：${ie}、${firefox}、${safari}、${opera}、${edge} 或文件路径。如果此政策设为文件路径，系统会将相应文件用作可执行文件。${ie} 仅适用于 Microsoft® Windows®。${safari} 和 ${edge} 仅适用于 Microsoft® Windows® 和 macOS。\n\n如果您未设置此政策，系统会使用相应的平台专用默认浏览器：在 Microsoft® Windows® 上使用 Internet Explorer®，在 macOS 上使用 Safari®。在 Linux® 上，无法启动备用浏览器。";
AlwaysOpenPdfExternally.pfm_title = "始终使用外部应用打开 PDF 文件";
AlwaysOpenPdfExternally.pfm_description = "如果此政策已启用，系统会在 Brave 中停用内部 PDF 查看器，将 PDF 文件视为下载项，并允许用户使用默认应用打开 PDF 文件。\n\n如果此政策已停用，则意味着系统会使用 PDF 插件打开 PDF 文件，除非用户已关闭该插件。\n\n如果您已设置此政策，用户将无法在 Brave 中更改相关设置。如果您未设置此政策，用户便可选择是否要在外部打开 PDF。";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "为个人资料类型启用静默身份验证。";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - 仅为常规会话启用静默身份验证。\n1 - 为无痕会话和常规会话启用静默身份验证。\n2 - 为访客会话和常规会话启用静默身份验证。\n3 - 为常规会话、无痕会话和访客会话启用静默身份验证。\n通过配置此政策，您可以允许/禁止对 Brave 中的无痕模式和访客个人资料进行静默身份验证。\n\n静默身份验证是指在未通过 NTLM/Kerberos/Negotiate 质询-响应方案提供明确凭据的情况下，采用默认凭据进行的 HTTP 身份验证。\n\n设置 RegularOnly（值为 0）会仅允许常规会话执行静默身份验证，不允许无痕会话和访客会话静默地验证用户身份。\n\n设置 IncognitoAndRegular（值为 1）会允许无痕会话和常规会话执行静默身份验证，不允许访客会话静默地验证用户身份。\n\n设置 GuestAndRegular（值为 2）会允许访客会话和常规会话执行静默身份验证，不允许无痕会话静默地验证用户身份。\n\n设置 All（值为 3）会允许所有会话执行静默身份验证。\n\n请注意：系统始终允许对常规个人资料进行静默身份验证。\n\n在 Brave 版本 81 及更高版本中，如果未设置此政策，系统将会仅在常规会话中启用静默身份验证。";
AudioCaptureAllowed.pfm_title = "是否允许音频捕获";
AudioCaptureAllowed.pfm_description = "如果此政策已启用或未设置，系统将会在收到针对录音设备的使用请求时提示用户，但 AudioCaptureAllowedUrls 列表中设置的网址除外。\n\n如果此政策已停用，系统将会关闭提示，而且只有 AudioCaptureAllowedUrls 列表中设置的网址可以使用录音设备。\n\n注意：此政策会影响所有录音设备（而不仅仅是内置麦克风）的音频输入。";
AudioCaptureAllowedUrls.pfm_title = "无需提示用户即可使用音频捕获设备的网址";
AudioCaptureAllowedUrls.pfm_description = "通过设置此政策，您可以指定一个网址列表，列表中的网址格式将与请求网址的安全源进行匹配。如果找到了匹配项，系统会在不提示用户的情况下直接允许相应网址使用音频捕获设备。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns/。但请注意，此政策不支持可与任意网址匹配的“*”格式。";
AudioSandboxEnabled.pfm_title = "允许音频沙盒运行";
AudioSandboxEnabled.pfm_description = "此政策用于控制音频进程是否会采用沙盒机制。\n如果启用了此政策，音频进程在运行时将会采用沙盒机制。\n如果停用了此政策，音频进程在运行时将不会采用沙盒机制，WebRTC 音频处理模块将在渲染器进程中运行。\n运行未采用沙盒机制的音频子系统会致使用户面临安全风险。\n如果此政策未设置，系统将使用音频沙盒的默认配置（此配置可能会因平台而异）。\n借助此政策，当企业使用的安全软件设置会干扰音频沙盒时，他们就能够灵活地停用沙盒。";
AuthNegotiateDelegateAllowlist.pfm_title = "Kerberos 委派服务器许可名单";
AuthNegotiateDelegateAllowlist.pfm_description = "通过设置此政策，您可以指定 Brave 可将用户凭据委派给哪台/哪些服务器。若要指定多个服务器名称，请用英文逗号分隔。允许使用通配符 *。\n\n如果您不设置此政策，那么即使检测到某台服务器在内网上，Brave 也不会将用户凭据委派给它。";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "使用 KDC 政策委派凭据。";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "如果此政策已启用，HTTP 身份验证机制会遵循 KDC 政策的审批结果。换言之，如果 KDC 政策在服务工单上设置了 OK-AS-DELEGATE，Brave 便会向正在访问的服务委派用户凭证。请参阅 RFC 5896 ( https://tools.ietf.org/html/rfc5896.html )。AuthNegotiateDelegateAllowlist 也应允许使用该服务。\n\n如果此政策已停用或未设置，那么在支持的平台上，只会遵循 AuthNegotiateDelegateAllowlist 政策，KDC 政策会被忽略。\n\n在 Microsoft® Windows® 上，始终都会遵循 KDC 政策。";
AuthSchemes.pfm_title = "支持的身份验证方案";
AuthSchemes.pfm_description = "通过设置此政策，您可以指定 Brave 支持的 HTTP 身份验证方案。\n\n如果您不设置此政策，系统将采用全部 4 种方案。\n\n有效值：\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\n注意：各个值之间用英文逗号隔开。";
AuthServerAllowlist.pfm_title = "身份验证服务器许可名单";
AuthServerAllowlist.pfm_description = "通过设置此政策，您可以指定应允许哪些服务器进行集成身份验证。仅当收到由此许可名单中的代理服务器或服务器发出的身份验证请求时，Brave 才会启用集成式身份验证机制。\n\n如果您不设置此政策，Brave 将会尝试检测某台服务器是否在内网上，确认在内网后才会响应它发出的 IWA 请求。如果检测到某台服务器是在互联网上，Brave 将会忽略这台服务器发出的 IWA 请求。\n\n注意：若要指定多个服务器名称，请用英文逗号分隔。允许使用通配符 *。";
AutoLaunchProtocolsFromOrigins.pfm_title = "指定一系列协议以便无需提示用户就能启动所列来源中的外部应用";
AutoLaunchProtocolsFromOrigins.pfm_description = "让您能够设置一个协议列表，并为每份协议设置一个关联列表，包含允许的来源格式，使协议无需提示用户就能启动外部应用。罗列协议时不应添加结尾分隔符，因此请罗列“skype”而非“skype:”或“skype://”。\n\n如果您设置了此政策，那么仅当满足以下条件时，相应协议才可依照政策在不提示用户的情况下启动外部应用：该协议包含在列表中，而且尝试启动该协议的网站的来源与该协议 allowed_origins 列表中的来源格式之一匹配。如果相应协议不满足上述任一条件，系统将不会依照此政策跳过外部协议启动提示。\n\n如果此政策未设置，那么在默认情况下，倘若系统不提示用户，任何协议都无法启动。用户可以针对个别协议/网站选择不接收提示，除非 ExternalProtocolDialogShowAlwaysOpenCheckbox 政策已停用。对于用户针对个别协议/网站指定的不接收提示设置，此政策不会产生任何影响。\n\n用于与来源进行匹配的网址格式和“URLBlocklist”政策中设置的网址格式类似，详见 https://support.google.com/chrome/a?p=url_blocklist_filter_format。\n\n不过，此政策中用于与来源进行匹配的网址格式不能包含“/path”或“@query”元素。系统会忽略所有包含“/path”或“@query”元素的网址格式。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins。";
AutoOpenAllowedForURLs.pfm_title = "AutoOpenFileTypes 可应用到的网址";
AutoOpenAllowedForURLs.pfm_description = "以列表形式指定 AutoOpenFileTypes 会应用于哪些网址。此政策对用户设定的自动打开值没有任何影响。\n\n如果您设置了此政策，那么仅当文件的网址包含在列表中且文件类型已列在 AutoOpenFileTypes 中时，相应文件才会依照此政策自动打开。如果不符合上述任一条件，下载内容便不会依照此政策自动打开。\n\n如果此政策未设置，文件类型已列在 AutoOpenFileTypes 中的所有下载内容都将会自动打开。\n\n必须根据 https://support.google.com/chrome/a?p=url_blocklist_filter_format 来设置网址格式。";
AutoOpenFileTypes.pfm_title = "应在下载完毕后自动打开的文件类型的列表";
AutoOpenFileTypes.pfm_description = "以列表形式指定应在下载完毕后自动打开的文件类型。列出文件类型时不应包含前导分隔符，因此请输入“txt”而非“.txt”。\n\n如果启用了安全浏览功能，那么指定的自动打开文件类型仍须接受检查；如果未通过检查，则不会自动打开。\n\n如果未设置此政策，那么只有用户已指定自动打开的特定类型文件才会在下载完毕后自动打开。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过移动设备管理 (MDM) 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
AutoSelectCertificateForUrls.pfm_title = "自动选择这些网站的客户端证书";
AutoSelectCertificateForUrls.pfm_description = "此政策用于设置一系列网址格式，从而指定 Chrome 可为哪些网站自动选择客户端证书。此政策的值是一个由字符串化的 JSON 字典组成的数组，每个字典条目都必须采用 { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER } 格式，其中 $URL_PATTERN 是内容设置格式。$FILTER 用于限制浏览器可自动从哪些客户端证书中进行选择。无论是否设置了过滤条件，系统都只会选择与服务器的证书请求相匹配的证书。在 Android 和 iOS 上，Chrome 只能选择它自行配置的客户端证书，而无法访问在操作系统级别安装的证书。\n\n$FILTER 部分的用法示例：\n\n* 如果 $FILTER 设为 { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } }，则系统只会选择由 CommonName 为 $ISSUER_CN 的证书颁发机构颁发的客户端证书。\n\n* 如果 $FILTER 既包含 \"ISSUER\" 部分，也包含 \"SUBJECT\" 部分，则系统只会选择同时满足这两个条件的客户端证书。\n\n* 如果 $FILTER 包含 \"SUBJECT\" 部分，而其中指定了 \"O\" 的值，则证书需要包含至少 1 个与指定值匹配的组织才会被选中。\n\n* 如果 $FILTER 包含 \"SUBJECT\" 部分，而其中指定了 \"OU\" 的值，则证书便需要包含至少 1 个与指定值匹配的组织部门才会被选中。\n\n* 如果 $FILTER 设为 {}，则系统在选择客户端证书时不会受到额外限制。请注意，网络服务器提供的过滤条件仍然适用。\n\n如果此政策未设置，系统将不会为任何网站自动选择证书。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls。";
AutofillGenAiSettings.pfm_title = "生成式 AI 自动填充功能的设置";
AutofillGenAiSettings.pfm_description = "0 - 允许使用生成式 AI 自动填充功能并改进 AI 模型。\n1 - 允许使用生成式 AI 自动填充功能，但不改进 AI 模型。\n2 - 不允许使用生成式 AI 自动填充功能。\nBrave 中的这些功能采用生成式 AI 模型来帮助用户填写网页表单。如需使用这些功能，Brave 必须收集数据（例如用户与之互动的表单的结构，以及用户使用 Gemini 智能查找和填充时，为搜索关联的 Gemini 应用而输入的自由文本查询），并将这些数据发送到用于运行生成式 AI 模型的 Google 服务器。\n\n如果将此政策设为 0（允许使用生成式 AI 自动填充功能并改进 AI 模型），表示允许使用这些功能，同时允许 Google 使用相关数据改进其 AI 模型。相关数据可能包括提示、输入、输出、素材和书面反馈，具体取决于相应功能。默认值是 0，但以下注明的情况除外。\n\n如果将此政策设为 1（允许使用生成式 AI 自动填充功能，但不改进 AI 模型），表示允许使用这些功能，但不允许 Google 使用用户内容（包括提示、输入、输出、素材和书面反馈）改进模型。对于受 Google Admin console管理的企业用户和受 Google Workspace 管理的教育版账号，默认值是 1。\n\n如果将此政策设为 2（不允许使用生成式 AI 自动填充功能），表示不允许使用这些功能。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。\n\n生成式 AI 自动填充功能包括：\n\n- 更智能地理解表单：使用 AI 识别表单中的字段并对其进行分类，以便填充更多字段。\n\n- Gemini 智能查找和填充：从用户关联到 Gemini 的应用中查找信息，并提供这些信息以供填充。这些信息既可以作为表单上的主动建议呈现，也可以是响应用户输入的查询。\n\n此政策会取代 AutofillPredictionSettings 政策；若未设置此政策，后者仍会生效。如需使用“Gemini 智能查找和填充”功能，还必须启用 GeminiSettings 政策。\n\n此政策不会控制不使用生成式 AI 的自动填充功能。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
AutofillSettings.pfm_title = "针对特定网站屏蔽自动填充数据类型";
AutofillSettings.pfm_description = "通过设置此政策，您可以针对特定的网址格式，指定要屏蔽哪些类型的自动填充数据。\n\n此政策的结构是一个字典列表。每个字典必须包含：\n*“url_pattern”：主框架的内容设置网址格式（例如“https://[*.]example.com”）。\n*“blocked_types”：字符串列表，表示要屏蔽的自动填充数据类别。\n\n“blocked_types”支持的值包括：\n*“contact_info”：禁止填充和保存联系信息。\n*“payments”：禁止填充和保存信用卡及支付方式。\n*“identity_docs”：禁止填充和保存身份证件（例如护照、驾照、国民身份证）。\n*“travel”：禁止填充和保存出行信息（例如航班预订、车辆登记信息）。\n*“shopping”：禁止填充和保存购物信息（例如在线订单、货运信息）。\n*“all”：禁止填充和保存所有类型的自动填充数据。\n\n如果针对某个网站屏蔽了某种数据类型，则系统不会在该网站上生成相关建议，也不会提示保存或导入该类型的新数据。\n\n如果某个网址与列表中的多个格式条目匹配，则所有匹配条目中被屏蔽的类型将合并（取并集）。系统会忽略列表中的无效网址格式。\n\n如果未设置此政策，系统不会按网域屏蔽任何自动填充数据类型。\n\n如需详细了解有效的网址格式，请访问：https://chromeenterprise.google/policies/url-patterns。支持通配符 *，此格式会匹配包含任何协议、端口和路径的网址。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=AutofillSettings。";
AutomatedPasswordChangeSettings.pfm_title = "启用自动密码更改功能";
AutomatedPasswordChangeSettings.pfm_description = "0 - 允许使用该功能并改进 AI 模型\n1 - 允许使用该功能，但不改进 AI 模型\n2 - 不允许使用该功能\n此政策用于控制 Brave 的自动密码更改功能的可用性。\n\n如果启用，用户可以触发一个流程，让浏览器尝试自动更改其在某个网站上的密码。此流程由生成式 AI 管理。新密码会保存在浏览器的密码管理工具中。\n\n0 表示允许使用此功能，同时允许 Google 使用相关数据改进其 AI 模型。相关数据可能包括提示、输入、输出、素材和书面反馈，具体取决于相应功能。工作人员也可能会审核这些数据，以改进 AI 模型。除非下文另有说明，否则默认值是 0。\n\n1 表示允许使用此功能，但不允许 Google 使用用户内容（包括提示、输入、输出、素材和书面反馈）改进模型。对于受 Google 管理控制台管理的企业用户和受 Google Workspace 管理的教育版账号，默认值是 1。\n\n2 表示不允许使用此功能。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
AutomaticDownloadsAllowedForUrls.pfm_title = "允许在这些网站上自动下载";
AutomaticDownloadsAllowedForUrls.pfm_description = "此政策允许您设置一个网址格式列表，用于指定允许哪些网站自动下载多个文件。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。\n\n如果某个网址与 AutomaticDownloadsAllowedForUrls 和 AutomaticDownloadsBlockedForUrls 政策都相符，则优先应用 AutomaticDownloadsBlockedForUrls。\n\n如果未设置此政策，那么只要设置了 DefaultAutomaticDownloadsSetting，系统就会将其应用于所有网站。否则，系统会应用用户的个人设置。";
AutomaticDownloadsBlockedForUrls.pfm_title = "禁止在这些网站上自动下载";
AutomaticDownloadsBlockedForUrls.pfm_description = "此政策允许您设置一个网址格式列表，用于指定不允许哪些网站自动下载多个文件。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。\n\n如果某个网址与 AutomaticDownloadsAllowedForUrls 和 AutomaticDownloadsBlockedForUrls 政策都相符，则优先应用 AutomaticDownloadsBlockedForUrls。\n\n如果未设置此政策，那么只要设置了 DefaultAutomaticDownloadsSetting，系统就会将其应用于所有网站。否则，系统会应用用户的个人设置。";
AutomaticFullscreenAllowedForUrls.pfm_title = "允许在这些网站上自动全屏显示";
AutomaticFullscreenAllowedForUrls.pfm_description = "出于安全考虑，调用 requestFullscreen() Web API 需要过往用户手势（“暂时性激活”），否则将会失败。用户的个人设置可能允许某些源在不使用过往用户手势的情况下调用此 API，如 https://chromestatus.com/feature/6218822004768768 中所述。\n\n此政策会取代用户的个人设置，并允许匹配源在不使用过往用户手势的情况下调用此 API。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。\n允许使用通配符 *。\n\n同时符合已屏蔽和允许的政策格式的源将被禁止。\n政策或用户设置均未指定的源需要过往用户手势才能调用此 API。";
AutomaticFullscreenBlockedForUrls.pfm_title = "禁止在这些网站上自动全屏显示";
AutomaticFullscreenBlockedForUrls.pfm_description = "出于安全考虑，调用 requestFullscreen() Web API 需要过往用户手势（“暂时性激活”），否则将会失败。用户的个人设置可能允许某些源在不使用过往用户手势的情况下调用此 API，如 https://chromestatus.com/feature/6218822004768768 中所述。\n\n此政策会取代用户的个人设置，并禁止匹配源在不使用过往用户手势的情况下调用此 API。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。\n允许使用通配符 *。\n\n同时符合屏蔽和允许政策格式的源将被禁止。\n政策或用户设置均未指定的源需要使用过往用户手势才能调用此 API。";
AutoplayAllowed.pfm_title = "允许自动播放媒体内容";
AutoplayAllowed.pfm_description = "如果此政策设为 True，Brave 会自动播放媒体。如果此政策设为 False，Brave 不会自动播放媒体。\n\n如果未设置此政策，Brave 不会自动播放媒体。但是，对于某些网址格式，您可以使用 AutoplayAllowlist 政策更改此设置。\n\n如果此政策在 Brave 运行期间发生了更改，相应更改将仅适用于新打开的标签页。";
AutoplayAllowlist.pfm_title = "允许符合网址格式许可名单中所列格式的网页自动播放媒体内容";
AutoplayAllowlist.pfm_description = "如果您设置了此政策，Brave 中带有音频内容的视频可以自动播放（无需经过用户同意）。如果 AutoplayAllowed 政策设为 True，此政策不会产生任何效力。如果 AutoplayAllowed 设为 False，此政策中设置的任何网址格式都仍可自动播放视频。如果此政策在 Brave 运行期间发生了更改，相应更改将仅适用于新打开的标签页。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns/。";
BackgroundTabFreezingEnabled.pfm_title = "启用后台标签页冻结功能";
BackgroundTabFreezingEnabled.pfm_description = "控制 Brave 是否冻结闲置后台标签页，以节省 CPU 和内存。\n\n启用后台标签页冻结功能后，系统会通过暂停执行 JavaScript 和计时器任务，冻结在后台闲置一段时间的标签页。冻结的标签页仍会加载到内存中，并在用户选中以后立即恢复。含有活跃后台任务的标签页不符合冻结条件，将保持运行。这些任务包括：播放音频或视频、捕获屏幕或摄像头画面、保持活跃的 WebRTC 连接或持有 Web 锁。在 TabDiscardingExceptions 政策或用户标签页舍弃例外项中配置的网站，同样不会被冻结。\n\n如果此政策已启用，系统会自动冻结符合条件的后台标签页。用户无法更改此设置。\n\n如果此政策已停用，系统会阻止冻结后台标签页。用户无法更改此设置。\n\n如果未设置此政策，系统会默认启用后台标签页冻结功能，但用户可以在 Brave 设置中开启或关闭此功能。";
BasicAuthOverHttpEnabled.pfm_title = "允许通过 HTTP 进行Basic身份验证";
BasicAuthOverHttpEnabled.pfm_description = "如果此政策已启用或未设置，系统将会允许通过不安全的 HTTP 接收Basic身份验证请求。\n\n如果此政策已停用，不安全的 HTTP 请求将无法使用Basic身份验证方案，只有安全的 HTTPS 能使用该方案。\n\n在以下情况下，系统会忽略这项政策设置（一律禁止使用“Basic”）：AuthSchemes 政策已设置，且其中不包含“Basic”。";
BatterySaverModeAvailability.pfm_title = "启用省电模式";
BatterySaverModeAvailability.pfm_description = "0 - 系统将停用省电模式。\n1 - 当设备使用电池供电且电池电量低时，启用省电模式。\n2 - 自 M121 起，此值已被弃用。在 M121 及之后，相关值将被视为 EnabledBelowThreshold。\n此政策用于启用或停用“省电模式”设置。\n在 Chrome 中，如果启用了该设置，系统会限制帧速率，从而降低耗电量。如果此政策未设置，最终用户可在 chrome://settings/performance 上控制该设置。\n在 ChromeOS 上，如果启用了该设置，系统会限制帧速率和 CPU 频率，调暗背光，并将 Android 置于省电模式。在具有多个 CPU 的设备上，某些 CPU 会被关闭。\n不同级别如下：\nDisabled (0)：系统将停用省电模式。\nEnabledBelowThreshold (1)：当设备使用电池供电且电池电量低时，系统会启用省电模式。\nEnabledOnBattery (2)：自 M121 起，此值已被弃用。从 M121 开始，相关值将被视为 EnabledBelowThreshold。\n";
BlockExternalExtensions.pfm_title = "禁止安装外部扩展程序";
BlockExternalExtensions.pfm_description = "此政策可用来控制外部扩展程序的安装。\n\n如果已启用此政策，则系统会阻止安装外部扩展程序。\n\n如果已停用或未设置此政策，则系统会允许安装外部扩展程序。\n\n如需查看外部扩展程序及其安装方法，请参阅 https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions 上的文档。\n\n注意：此政策仅适用于支持扩展程序的平台。";
BlockThirdPartyCookies.pfm_title = "阻止第三方 Cookie";
BlockThirdPartyCookies.pfm_description = "如果此政策已启用，网页元素只要不属于浏览器地址栏中的网域，就无法设置 Cookie。如果此政策已停用，系统会允许这些元素设置 Cookie，并会阻止用户更改此设置。\n\n如果此政策未设置，系统会允许使用第三方 Cookie，但用户可以更改此设置。\n\n注意：此政策不适用于无痕模式。在无痕模式下，第三方 Cookie 会被屏蔽，并且只能在网站级别允许使用。如需在网站级别允许使用 Cookie，请使用 CookiesAllowedForUrls 政策。";
BookmarkBarEnabled.pfm_title = "启用书签栏";
BookmarkBarEnabled.pfm_description = "如果此政策设为 True，Brave 中会显示书签栏。如果此政策设为 False，用户一律不会看到书签栏。\n\n如果您设置了此政策，用户便无法更改它。如果您不设置此政策，用户可以自行决定是否使用这项功能。";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "允许通过用户管理器添加用户";
BrowserAddPersonEnabled.pfm_description = "如果此政策设为 true 或未配置，Brave 和 Lacros 将会允许从用户管理器中添加新用户。\n\n如果此政策设为 false，Brave 和 Lacros 将会禁止从用户管理器中添加新用户。";
BrowserGuestModeEnabled.pfm_title = "在浏览器中启用访客模式";
BrowserGuestModeEnabled.pfm_description = "如果此政策已启用或未配置，Brave 将会允许以访客身份登录。访客身份是一类 Brave 个人资料；使用此类个人资料登录后，所有窗口均处于无痕模式。\n\n如果此政策已停用，Brave 将会禁止启用访客资料。";
BrowserGuestModeEnforced.pfm_title = "强制采用浏览器访客模式";
BrowserGuestModeEnforced.pfm_description = "如果此政策已启用，Brave 会强制启动访客会话并禁止登录个人资料。访客身份是一类特殊的 Brave 个人资料；使用此类个人资料打开的窗口均会处于无痕模式。\n\n如果此政策已停用或未设置，或者浏览器访客模式已停用（通过 BrowserGuestModeEnabled 进行设置），系统将允许使用新的和现有的个人资料。";
BrowserLabsEnabled.pfm_title = "在工具栏中显示浏览器实验性功能图标";
BrowserLabsEnabled.pfm_description = "如果此政策已启用或未设置，用户便可通过工具栏中的图标访问浏览器实验性功能\n\n如果此政策已停用，系统会从工具栏中移除浏览器实验性功能图标。\n\n无论此政策是已启用还是已停用，chrome://flags 和任何其他可用于开启和关闭浏览器功能的方法都能正常起作用。";
BrowserNetworkTimeQueriesEnabled.pfm_title = "允许向 Google 时间服务发出查询";
BrowserNetworkTimeQueriesEnabled.pfm_description = "如果此政策已启用或未设置，Brave 会不定时向 Google 服务器发送查询以检索准确的时间戳。\n\n如果此政策已停用，系统会阻止 Brave 发送此类查询。";
BrowserSignin.pfm_title = "浏览器登录设置";
BrowserSignin.pfm_description = "0 - 禁止登录浏览器\n1 - 允许登录浏览器\n2 - 强制要求用户登录才能使用浏览器\n此政策用于控制浏览器的登录行为。通过设置此政策，您可以指定用户能否使用其账号登录 Brave 并使用账号相关服务（如 Brave 同步）。\n\n如果此政策设为“禁止登录浏览器”，用户便无法登录浏览器，也无法使用账号相关服务。在这种情况下，用户将无法使用多种浏览器级功能（如 Brave 同步），这些功能会处于不可用状态。在 iOS 上，如果在用户登录后将此政策设为“Disabled”，用户将会立即退出登录。在其他平台上，用户将会在下次运行 Brave 时退出登录。在所有平台上，用户的本地个人资料数据（如书签、密码等）会得到保留并且依然可用。用户仍能登录并使用 Google Web 服务（如 Gmail）。\n\n如果此政策设为“允许登录浏览器”，用户将可以登录浏览器。在除 iOS 之外的所有其他平台上，用户会在登录 Google Web 服务（如 Gmail）时自动登录浏览器。登录浏览器意味着浏览器将会保存用户的账号信息，但并不意味着 Brave 同步功能会默认开启；用户必须另行选择使用此功能。启用此政策会阻止用户关闭用于允许登录浏览器的设置。若要控制 Brave 同步功能的可用性，请使用 SyncDisabled 政策。\n\n如果此政策设为“强制登录浏览器”，系统将会向用户显示账号选择对话框，而且用户必须选择并登录某个账号才能使用浏览器。这样可确保针对受管理的账号采用并强制执行与该账号关联的政策。BrowserGuestModeEnabled 的默认值将会设为“Disabled”。请注意，启用此政策后，现有的未登录个人资料都会处于锁定且不可访问的状态。如需了解详情，请参阅这篇帮助中心文章：https://support.google.com/chrome/?p=force_browser_signin。Google Chrome OS 和 Android 不支持此选项，如果您在这些平台上使用此选项，系统将改为采用“允许登录浏览器”选项。\n\n如果此政策未设置，用户可以自行决定是否要在 Brave 设置中启用浏览器登录选项并酌情使用登录功能。";
BrowserSwitcherDelay.pfm_title = "在启动替代浏览器之前的延迟时间（以毫秒为单位）";
BrowserSwitcherDelay.pfm_description = "如果此政策设为一个数字，Brave 会先按照与该数字等同的毫秒数显示一条消息，然后再打开备用浏览器。\n\n如果此政策未设置或设为 0，当用户要前往指定的网址时，系统会立即在备用浏览器中打开相应网页。";
BrowserSwitcherEnabled.pfm_title = "启用“旧版浏览器支持”功能。";
BrowserSwitcherEnabled.pfm_description = "如果已启用此政策，Brave 将会尝试在备用浏览器（例如 Internet Explorer®）中打开某些网址。此功能是使用“Legacy Browser support”组中的政策设置的。\n\n如果已停用或未设置此政策，Brave 将不会尝试在备用浏览器中打开指定的网址。";
BrowserSwitcherExternalGreylistUrl.pfm_title = "包含始终不应触发浏览器切换的网址的 XML 文件对应的网址。";
BrowserSwitcherExternalGreylistUrl.pfm_description = "如果此政策设为一个有效网址，Brave 就会从该网址下载网站列表，并参照 BrowserSwitcherUrlGreylist 政策的设定应用相应规则。这些政策会阻止 Brave 和备用浏览器互相打开。\n\n如果此政策未设置（或设为一个无效网址），Brave 便不会将它用作浏览器不切换规则的来源。\n\n注意：此政策指向一个与 Internet Explorer® 的 SiteList 政策采用相同格式的 XML 文件。此政策会加载 XML 文件中的规则，但不会与 Internet Explorer® 共享这些规则。如需详细了解 Internet Explorer® 的 SiteList 政策，请访问 https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherExternalSitelistUrl.pfm_title = "与包含要在替代浏览器中加载的网址的 XML 文件对应的网址。";
BrowserSwitcherExternalSitelistUrl.pfm_description = "如果此政策设为一个有效网址，Brave 就会从该网址下载网站列表，并参照 BrowserSwitcherUrlList 政策的设定应用相应规则。\n\n如果此政策未设置（或设为一个无效网址），Brave 便不会将它用作浏览器切换规则的来源。\n\n注意：此政策指向一个与 Internet Explorer® 的 SiteList 政策采用相同格式的 XML 文件。此政策会加载 XML 文件中的规则，但不会与 Internet Explorer® 共享这些规则。如需详细了解 Internet Explorer® 的 SiteList 政策，请访问 https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherKeepLastChromeTab.pfm_title = "使 Chrome 中仅剩的那个标签页保持打开状态。";
BrowserSwitcherKeepLastChromeTab.pfm_description = "如果此政策已启用或未设置，当切换到备用浏览器后，Brave 会使至少一个标签页保持打开状态。\n\n如果此政策已停用，当切换到备用浏览器后，Brave 会关闭所含的标签页（即使仅剩下此标签页）。这会导致 Brave 彻底关闭。";
BrowserSwitcherParsingMode.pfm_title = "Sitelist 解析模式";
BrowserSwitcherParsingMode.pfm_description = "0 - LBS 的默认行为。\n1 - 更好地兼容 Microsoft IE/Edge 企业模式 sitelist。\n此政策用于控制 Google Chrome 如何解析“旧版浏览器支持”功能的 sitelist/greylist 政策。它会影响以下政策：BrowserSwitcherUrlList、BrowserSwitcherUrlGreylist、BrowserSwitcherUseIeSitelist、BrowserSwitcherExternalSitelistUrl 和 BrowserSwitcherExternalGreylistUrl。\n\n如果此政策设为“Default”(0) 或未设置，网址匹配将不太严格。不含“/”的规则会在网址主机名中的任意位置查找子字符串。匹配网址路径组成部分时区分大小写。\n\n如果此政策设为“IESiteListMode”(1)，网址匹配将更为严格。不含“/”的规则仅在主机名末尾处匹配。它们还必须位于域名边界。匹配网址路径组成部分时不区分大小写。此政策可以更好地兼容 Microsoft® Internet Explorer® 和 Microsoft® Edge®。\n\n例如，对于规则“example.com”和“acme.com/abc”：\n\n“http://example.com/”、“http://subdomain.example.com/”和“http://acme.com/abc”匹配，无论解析模式为何。\n\n“http://notexample.com/”、“http://example.com.invalid.com/”和“http://example.comabc/”仅在“Default”模式下匹配。\n\n“http://acme.com/ABC”仅在“IESiteListMode”下匹配。";
BrowserSwitcherUrlGreylist.pfm_title = "始终不应触发浏览器切换的网站。";
BrowserSwitcherUrlGreylist.pfm_description = "通过设置此政策，您可以控制哪些网站始终不会导致切换浏览器。网站列表中的每项内容都会被视为一条规则。有匹配项的规则将不会打开备用浏览器。与 BrowserSwitcherUrlList 政策不同的是，此政策中的规则双向适用。如果 Internet Explorer® 插件已开启，此政策还可控制 Internet Explorer® 是否应在 Brave 中打开这些网址。\n\n如果您不设置此政策，系统不会将任何网站加入列表。\n\n注意：系统也可通过 BrowserSwitcherExternalGreylistUrl 政策向该列表添加元素。";
BrowserSwitcherUrlList.pfm_title = "要在替代浏览器中打开的网站";
BrowserSwitcherUrlList.pfm_description = "通过设置此政策，您可以控制要在备用浏览器中打开的网站列表。每项内容都会被视为一条规则，用于确定要在备用浏览器中打开的网站。Brave 会使用这些规则来确定是否应在备用浏览器中打开某个网址。如果 Internet Explorer® 插件已开启，当规则无匹配项时，Internet Explorer® 会切换回 Brave。如果规则之间相互冲突，Brave 会使用最具体的规则。\n\n如果您不设置此政策，系统不会将任何网站加入列表。\n\n注意：系统也可通过 BrowserSwitcherUseIeSitelist 和 BrowserSwitcherExternalSitelistUrl 政策向该列表添加元素。";
BrowserThemeColor.pfm_title = "配置浏览器主题的颜色";
BrowserThemeColor.pfm_description = "此政策让管理员能够配置 Brave 主题的颜色。输入的字符串应是有效的十六进制颜色字符串（采用“#RRGGBB”格式）。\n\n如果此政策设为一种有效的十六进制颜色，系统便会根据该颜色自动生成主题并将其应用于浏览器。用户将无法更改此政策中设定的主题。\n\n如果此政策未设置，用户可根据自己的偏好更改所用浏览器的主题。";
BrowsingDataLifetime.pfm_title = "浏览数据生命周期设置";
BrowsingDataLifetime.pfm_description = "为 Brave 配置浏览数据生命周期设置。通过此政策，管理员能够按数据类型配置浏览器何时删除数据。这对需要处理敏感客户数据的客户非常有用。\n\n警告：设置此政策可能会影响并永久移除本地个人数据。建议您在部署之前测试设置，以免意外删除个人数据。\n\n可用的数据类型包括'browsing_history''download_history''cookies_and_other_site_data''cached_images_and_files''password_signin''autofill''site_settings'和'hosted_app_data'。不过，'download_history'和'hosted_app_data'在 Android 上不受支持。\n\n所选类型的数据的留存时长一旦超过'time_to_live_in_hours'，浏览器便会自动将其移除。可设置的最小值为 1 小时。\n\n浏览器启动 15 秒后便会开始删除过期数据，运行期间则会每 30 分钟删除一次。\n\n删除 Cookie 后，用户仍会保持 Google 账号登录状态。\n\n截至 Chrome 114，此政策要求将 SyncDisabled 政策设为 true。从 Chrome 115 开始，如果既未通过设置 SyncDisabled 政策停用“Chrome Sync”，也未停用 BrowserSignin，设置此政策会为相应的数据类型停用同步功能。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime。";
BuiltInAIAPIsEnabled.pfm_title = "允许网页使用内置 AI API。";
BuiltInAIAPIsEnabled.pfm_description = "此政策控制网页是否可以使用内置的 AI API（例如 LanguageModel API、Summarization API、Writer API 和 Rewriter API）。\n\n如果此政策已启用或未设置，则这些 API 将被启用。\n\n如果此政策已停用，尝试使用这些 API 将导致出现错误。";
BuiltInDnsClientEnabled.pfm_title = "使用内置 DNS 客户端";
BuiltInDnsClientEnabled.pfm_description = "此政策用于控制使用哪个软件堆栈与 DNS 服务器通信：操作系统 DNS 客户端或 Brave 的内置 DNS 客户端。此政策不会影响使用哪些 DNS 服务器：例如，如果操作系统已配置为使用一台企业 DNS 服务器，内置 DNS 客户端也会使用这台服务器。此政策也不会控制是否使用 DNS-over-HTTPS；Brave 将始终使用内置的解析器发送 DNS-over-HTTPS 请求。如需了解如何控制 DNS-over-HTTPS，请参阅 DnsOverHttpsMode 政策。\n\n如果此政策已启用或未设置，系统将会使用内置 DNS 客户端。\n\n如果此政策已停用，只有当 DNS-over-HTTPS 正在使用中时，系统才会使用内置 DNS 客户端。";
CACertificateManagementAllowed.pfm_title = "允许用户管理已安装的 CA 证书。";
CACertificateManagementAllowed.pfm_description = "0 - 允许用户管理所有证书\n1 - 允许用户管理用户证书\n2 - 禁止用户管理证书\n如果此政策设为“All (0)”或未设置，用户便可修改所有 CA 证书的信任设置、移除用户导入的证书并使用证书管理器导入证书。如果此政策设为“UserOnly (1)”，用户将仅能管理用户导入的证书，但无法更改内置证书的信任设置。如果此政策设为“None (2)”，用户可以查看（但无法管理）CA 证书。";
CACertificates.pfm_title = "Brave 在验证服务器身份时应信任的 TLS 证书";
CACertificates.pfm_description = "Brave 在验证服务器身份时应信任的 TLS 证书列表。\n证书应采用 base64 编码。";
CACertificatesWithConstraints.pfm_title = "Brave 在验证服务器身份时应信任的 TLS 证书（有限制条件）";
CACertificatesWithConstraints.pfm_description = "Brave 在验证服务器身份时应信任的 TLS 证书列表（在证书外部添加了限制条件）。如果没有特定类型的限制条件，则允许该类型的任何名称。\n证书应采用 base64 编码。必须为每个证书至少指定一项限制条件。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints。";
CADistrustedCertificates.pfm_title = "Brave 在验证服务器身份时不应信任的 TLS 证书";
CADistrustedCertificates.pfm_description = "Brave 在验证服务器身份时不应信任的证书公钥的列表。\n\n此政策的值是一个采用 base64 编码的 X.509 证书列表。任何具有匹配 SPKI (SubjectPublicKeyInfo) 的证书都将不受信任。";
CAHintCertificates.pfm_title = "不受信任或不可信但可在验证服务器身份时用于路径构建的 TLS 证书";
CAHintCertificates.pfm_description = "在 Brave 中不受信任或不可信但可用作路径构建提示的证书的列表。证书应采用 base64 编码。";
CAPlatformIntegrationEnabled.pfm_title = "使用平台受信任证书存储区中用户添加的 TLS 证书进行服务器身份验证";
CAPlatformIntegrationEnabled.pfm_description = "如果此政策已启用（或未设置），在进行 TLS 服务器身份验证路径构建时，将会使用平台受信任证书存储区中用户添加的 TLS 证书。\n\n如果此政策已停用，在进行 TLS 服务器身份验证路径构建时，将不会使用平台受信任证书存储区中用户添加的 TLS 证书。";
CORSNonWildcardRequestHeadersSupport.pfm_title = "对 CORS 非通配符式请求标头的支持情况";
CORSNonWildcardRequestHeadersSupport.pfm_description = "旨在配置对 CORS 非通配符式请求标头的支持情况。\n\nBrave 97 版引入了对 CORS 非通配符式请求标头的支持。如果脚本通过 fetch() 和已在所含授权标头中添加了脚本的 XMLHttpRequest 发出跨源网络请求，该标头必须在 CORS 预检响应中获得 Access-Control-Allow-Headers 标头的明确允许。这里的“明确”意味着通配符“*”不会涵盖授权标头。详见 https://chromestatus.com/feature/5742041264816128。\n\n如果此政策设为 True 或未设置，Brave 将会支持 CORS 非通配符式请求标头，并会具有上述行为。\n\n如果此政策设为 False，Chrome 将会允许在 CORS 预检响应中的 Access-Control-Allow-Headers 标头内使用通配符“*”涵盖授权标头。\n\n这项企业政策只是暂时性政策，预计日后会移除。";
CacheEncryptionEnabled.pfm_title = "此政策让管理员能够加密磁盘上的 HTTP 缓存。";
CacheEncryptionEnabled.pfm_description = "此政策让管理员能够对磁盘上的浏览器 HTTP 缓存进行加密。\n\n如果已启用此政策，浏览器缓存会被加密。\n\n如果已停用或未设置此政策，则浏览器缓存不会被加密。\n\n加密浏览器缓存可能会影响性能。";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "对于指定的一系列 subjectPublicKeyInfo 哈希，不强制执行证书透明化要求";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "设置此政策可使系统不对一系列 subjectPublicKeyInfo 哈希强制执行证书透明度披露要求。因没有恰当公开披露相关信息而不受信任的证书，企业主机也可以继续使用。若要关闭强制执行，哈希必须满足以下条件之一：\n\n* 是服务器证书中 subjectPublicKeyInfo 的哈希。\n\n* 是证书链中某个证书授权机构 (CA) 所颁证书内包含的 subjectPublicKeyInfo 的哈希。该 CA 证书受 X.509v3 nameConstraints 扩展规则的限制，permittedSubtrees 中有一个或多个 directoryName nameConstraints，并且 directoryName 包含 organizationName 属性。\n\n* 是证书链中某个 CA 证书内包含的 subjectPublicKeyInfo 的哈希，该 CA 证书的证书主题包含一个或多个 organizationName 属性，服务器的证书也包含数量、顺序和值方面完全相同的 organizationName 属性。\n\n您只需将以下各项连结起来即可指定 subjectPublicKeyInfo 哈希：哈希算法名称、“/”字符，以及相应哈希算法（对所指定证书的 DER 编码 subjectPublicKeyInfo 应用的哈希算法）的 Base64 编码。Base64 编码的格式与 SPKI 指纹的格式一致。唯一得到认可的哈希算法是 sha256，其他算法都会被忽略。\n\n如果您不设置此政策，Brave 便会将那些应按照证书透明度要求进行披露但却未予披露的证书视为不可信证书。";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "对于指定的一系列网址，不强制要求必须符合证书透明度政策";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "设置此政策可关闭对指定网址中所含主机名的证书透明度披露要求。虽然这会导致更难以检测到误颁的证书，但相应主机可以继续使用因没有恰当公开披露相关信息而不受信任的证书。\n\n如果您未设置此政策，Brave 便会将那些应按照证书透明度要求进行披露但却未予披露的证书视为不可信证书。\n\n网址格式应采用 https://support.google.com/chrome/a?p=url_blocklist_filter_format 中规定的格式。不过，判定给定主机名的证书是否有效与架构、端口或路径皆无关，因此 Brave 只会考虑相应网址的主机名部分。采用通配符的主机名不受支持。";
ChromeForTestingAllowed.pfm_title = "允许运行 Chrome for Testing";
ChromeForTestingAllowed.pfm_description = "控制用户能否使用 Chrome for Testing。\n\n如果此政策已启用或未设置，用户便可安装并运行 Chrome for Testing。\n\n如果此政策已停用，用户将无法运行 Chrome for Testing。用户仍然可以安装 Chrome for Testing，但无法在已停用此政策的个人资料中运行该版本。";
ChromeSuggestionsSettings.pfm_title = "Chrome 建议设置";
ChromeSuggestionsSettings.pfm_description = "此设置允许 Chrome 在适当的时候推荐 AI 功能。\n\n0/未设置 = 为用户启用 Chrome 建议。\n\n1 = 为用户停用 Chrome 建议。\n\n如需了解详情，请参阅这篇帮助中心文章：https://support.google.com/chrome/a?p=chrome_suggestions";
ChromeVariations.pfm_title = "确定变体的可用情况";
ChromeVariations.pfm_description = "0 - 启用所有变体\n1 - 仅启用与重要修复程序有关的变体\n2 - 停用所有变体\n通过配置此政策，您可以指定哪些变体能应用到 Brave 中。\n\n通过有选择地启用/停用现有功能，变体让我们无需推出新版浏览器即可实现对 Brave 的修改。如需了解详情，请访问 https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework。\n\n如果将此政策设置为 VariationsEnabled（值为 0）或不设置此政策，则所有变体都可应用于浏览器。\n\n如果将此政策设置为 CriticalFixesOnly（值为 1），则只有被视为重要安全性或稳定性修复程序的变体可以应用于 Brave。\n\n如果将此政策设置为 VariationsDisabled（值为 2），则任何变体都不会应用于浏览器。请注意，我们不建议您使用此模式，因为它可能会妨碍 Brave 开发者及时提供重要的安全性修复程序。";
ClearBrowsingDataOnExitList.pfm_title = "退出时清除浏览数据";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - 浏览记录\ndownload_history - 下载记录\ncookies_and_other_site_data - Cookie 及其他网站数据\ncached_images_and_files - 缓存的图片和文件\npassword_signin - 密码登录信息\nautofill - 自动填充\nsite_settings - 网站设置\nhosted_app_data - 托管的应用数据\n配置一个列表，在其中列出系统应在用户关闭所有浏览器窗口时删除哪些类型的浏览数据。\n\n警告：设置此政策可能会影响并永久移除本地个人数据。建议您在部署之前测试设置，以免意外删除个人数据。\n\n可用的数据类型包括浏览记录 (browsing_history)、下载记录 (download_history)、Cookie (cookies_and_other_site_data)、缓存 (cached_images_and_files)、自动填充 (autofill)、密码 (password_signin)、网站设置 (site_settings) 和托管的应用数据 (hosted_app_data)。此政策不会优先于 AllowDeletingBrowserHistory。\n\n删除 Cookie 后，用户仍会保持 Google 账号登录状态。\n\n截至 Chrome 114，此政策要求将 SyncDisabled 政策设为 true。从 Chrome 115 开始，如果既未通过设置 SyncDisabled 政策停用“Chrome Sync”，也未停用 BrowserSignin，设置此政策会为相应的数据类型停用同步功能。\n\n如果出于某种原因，数据删除已开始但未完成，系统将在下次加载个人资料时清除浏览数据。\n\n如果 Brave 未正常关闭（例如发生浏览器或操作系统崩溃的情况），系统不会清除浏览数据，因为浏览器关闭并非由用户关闭所有浏览器窗口所致。";
ClipboardAllowedForUrls.pfm_title = "允许这些网站使用剪贴板";
ClipboardAllowedForUrls.pfm_description = "通过设置此政策，您可以设置一个网址格式列表，从而指定哪些网站可以使用剪贴板网站权限。这并不涵盖与相应格式匹配的源上的所有剪贴板操作。例如，用户仍能使用键盘快捷键进行粘贴，因为此操作不受剪贴板网站权限的限制。\n\n\n未设置此政策时，如果已设置 DefaultClipboardSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
ClipboardBlockedForUrls.pfm_title = "禁止这些网站使用剪贴板";
ClipboardBlockedForUrls.pfm_description = "通过设置此政策，您可以设置一个网址格式列表，从而指定哪些网站无法使用剪贴板网站权限。这并不涵盖与相应格式匹配的源上的所有剪贴板操作。例如，用户仍能使用键盘快捷键进行粘贴，因为此操作不受剪贴板网站权限的限制。\n\n未设置此政策时，如果已设置 DefaultClipboardSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
CloudManagementEnrollmentMandatory.pfm_title = "启用强制性云管理注册";
CloudManagementEnrollmentMandatory.pfm_description = "如果已启用此政策，Chrome Enterprise Core浏览器注册将是强制性的。如果注册失败，系统会阻止 Brave 启动进程。\n\n如果已停用或未设置此政策，Chrome Enterprise Core浏览器注册将是可选的。如果注册失败，系统不会阻止 Brave 启动进程。\n\n在桌面设备上进行计算机范围云政策注册时会用到此政策。如需了解详情，请访问 https://support.google.com/chrome/a/answer/9301891。";
CloudManagementEnrollmentToken.pfm_title = "云政策的注册令牌";
CloudManagementEnrollmentToken.pfm_description = "如果设置此政策，Brave 会尝试向 Chrome Enterprise Core浏览器管理服务注册自身。此政策的值是一个可从 Google Admin console检索的注册令牌。\n\n如需了解详情，请访问 https://support.google.com/chrome/a/answer/9301891。";
CloudPolicyOverridesPlatformPolicy.pfm_title = "Brave 云政策会替换平台政策。";
CloudPolicyOverridesPlatformPolicy.pfm_description = "如果已启用此政策，当云政策与平台政策冲突时，系统会以云政策为准。\n\n如果已停用或未设置此政策，当平台政策与云政策冲突时，系统会以平台政策为准。\n\n这项强制性政策仅会影响计算机范围云政策。\n\n此政策仅适用于 Brave，不会影响 Google Update，因为它们是两个独立的应用。\nGoogle Update有一项同名的单独政策。";
CloudUserPolicyMerge.pfm_title = "允许将用户级云政策合并到计算机级政策中";
CloudUserPolicyMerge.pfm_description = "如果已启用此政策，与受管理的账号关联的政策便可被合并到计算机级政策中。\n\n如果已停用或未设置此政策，系统将阻止用户级云政策与任何其他来源的政策合并。\n\n系统仅以源自安全用户的政策为准。安全用户是指与使用 Chrome Enterprise Core来管理用户浏览器的组织关联的用户。所有其他用户级政策都将具有默认优先级。\n\n此外，务必要在 PolicyListMultipleSourceMergeList 或 PolicyDictionaryMultipleSourceMergeList 中设置需合并的政策。如果上述两项政策均未配置，系统会忽略此政策。";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "允许用户级云政策覆盖 Chrome Browser Cloud Management 政策。";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "如果已启用此政策，当与受管理的账号关联的政策和 Chrome Enterprise Core浏览器政策冲突时，系统会以前者为准。\n\n如果已停用或未设置此政策，用户级云政策将具有默认优先级。\n\n系统仅以源自安全用户的政策为准。安全用户是指与使用 Chrome Enterprise Core来管理用户浏览器的组织关联的用户。所有其他用户级政策都将具有默认优先级。\n\n此政策可与 CloudPolicyOverridesPlatformPolicy 结合使用。如果这两项政策均已启用，当用户级云政策与平台政策冲突时，系统也会以前者为准。";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "针对命令行标记启用安全警告功能";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "如果已启用或未设置此政策，当您使用可能不安全的命令行 flag 启动 Chrome 时，系统会显示安全警告。\n\n如果已停用此政策，当您使用可能不安全的命令行 flag 启动 Chrome 时，系统不会显示安全警告。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
ComponentUpdatesEnabled.pfm_title = "允许更新 Brave 中的组件";
ComponentUpdatesEnabled.pfm_description = "如果此政策未设置或已启用，即意味着允许更新 Brave 中的所有组件。\n\n如果此政策已停用，则无法更新组件。不过，某些组件不受此政策限制：只要相应组件不含可执行的代码，并且对浏览器的安全性至关重要，系统就不会禁止更新该组件。\n这类组件包括证书吊销列表、子资源过滤器，等等。";
CompressionDictionaryTransportEnabled.pfm_title = "启用压缩字典传输支持";
CompressionDictionaryTransportEnabled.pfm_description = "当字典可供使用时，此功能可允许在 Accept-Encoding 请求标头（“sbr”和“zst-d”）中使用字典专用内容编码。\n\n如果此政策已启用或未设置，Brave 将会使用压缩字典传输功能接受 Web 内容。\n如果此政策已停用，系统会关闭压缩字典传输功能。";
CookiesAllowedForUrls.pfm_title = "在这些网站上允许 Cookie";
CookiesAllowedForUrls.pfm_description = "此政策允许您设置一个网址格式列表，用于指定允许哪些网站设置 Cookie。\n\n网址格式可以是单个网址，表示该网站可以在所有顶级网站上使用 Cookie。\n\n格式也可以是两个以英文逗号分隔的网址。第一个用于指定允许使用 Cookie 的网站。第二个则用于指定要应用第一个值的顶级网站。\n\n如果您使用一对网址，则其中的第一个值支持 *，但第二个值不支持。如果第一个值使用 *，则表示当第二个网址是顶级网站时，所有网站都可以使用 Cookie。\n\n未设置此政策时，如果 DefaultCookiesSetting 或 BlockThirdPartyCookies 政策已设置，系统便会将其全局默认值应用于所有网站，否则就会应用用户个人配置中的全局默认值。\n\n另请查看 CookiesBlockedForUrls 和 CookiesSessionOnlyForUrls 政策。请注意，这三项政策中的网址格式不得互相冲突，因为如果存在冲突，系统将无法判断应以哪项政策为准。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
CookiesBlockedForUrls.pfm_title = "在这些网站上阻止 Cookie";
CookiesBlockedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，用于指定哪些网站无法设置 Cookie。\n\n未设置此政策时，如果 DefaultCookiesSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n另请查看 CookiesAllowedForUrls 和 CookiesSessionOnlyForUrls。虽然这三项政策并无优先级差异，但它们的网址格式不得存在冲突。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
CookiesSessionOnlyForUrls.pfm_title = "仅在当前会话中使用来自相符网址的 Cookie";
CookiesSessionOnlyForUrls.pfm_description = "除非 RestoreOnStartup 政策设为一律恢复先前会话中的网址，否则您可以通过设置 CookiesSessionOnlyForUrls 创建一个网址格式列表，用于指定哪些网站可以/无法为单个会话设置 Cookie。\n\n未设置此政策时，如果 DefaultCookiesSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。如果网址不符合指定的格式，系统也会使用默认设置。\n\n另请查看 CookiesBlockedForUrls 和 CookiesAllowedForUrls。虽然这三项政策并无优先级差异，但它们的网址格式不得存在冲突。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
CpuPerformanceTierOverride.pfm_title = "替换 CPU 性能层级";
CpuPerformanceTierOverride.pfm_description = "设置此政策后，企业可以替换 CPU Performance API 返回的值（即navigator.cpuPerformance，请访问 https://github.com/WICG/cpu-performance 了解详情）。\n\n如果此政策已设置，navigator.cpuPerformance 的值将被替换为指定的值。如果此政策未设置，系统将使用默认的性能层级计算方式。\n\n此政策的可能值为 0 到 4。";
CreatePasskeysInICloudKeychain.pfm_title = "控制是否默认在 iCloud 钥匙串中创建通行密钥。";
CreatePasskeysInICloudKeychain.pfm_description = "在 macOS 13.5 或更高版本上，Brave 可将通行密钥/WebAuthn 创建请求直接定向到 iCloud 钥匙串。如果 iCloud 钥匙串同步功能尚未启用，系统会提示用户通过 iCloud 登录，或者可能会提示用户启用 iCloud 钥匙串同步功能。\n\n如果此政策设为 false，系统默认不会使用 iCloud 钥匙串，而会改为采取之前的行为（即在 Brave 个人资料中创建凭证）。用户仍能选择将 iCloud 钥匙串作为一个选项，并且登录时或许仍会看到 iCloud 钥匙串凭证。\n\n如果此政策设为“true”，每当 WebAuthn 请求与所选的选项兼容时，系统默认便会在 iCloud 钥匙串中创建凭证。\n\n如果未设置此政策，默认设置将取决于多种因素，例如是否启用了 iCloud 云盘，以及用户近期是否使用过其 Brave 个人资料中的凭证或在其中创建了凭证。";
CreateThemesSettings.pfm_title = "“利用 AI 创建主题”的相关设置";
CreateThemesSettings.pfm_description = "0 - 允许使用“创建主题”功能并改进 AI 模型。\n1 - 允许使用“创建主题”功能，但不改进 AI 模型。\n2 - 不允许使用“创建主题”功能。\n借助“利用 AI 创建主题”功能，用户可从一系列选项中预先选择来创建自定义主题/壁纸。\n\n0 表示允许使用此功能，同时允许 Google 使用相关数据改进其 AI 模型。相关数据可能包括提示、输入、输出、来源资料和书面反馈，具体取决于相应功能。工作人员也可能会审核这些数据，以改进 AI 模型。除非下文另有说明，否则默认值是 0。\n\n1 表示允许使用此功能，但不允许 Google 使用用户内容（包括提示、输入、输出、来源资料和书面反馈）改进模型。对于受 Google Admin console管理的企业用户和受 Google Workspace 管理的教育版账号，默认值是 1。\n\n2 表示不允许使用此功能。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
DNSInterceptionChecksEnabled.pfm_title = "启用 DNS 拦截检查功能";
DNSInterceptionChecksEnabled.pfm_description = "借助此政策，您可以配置一个用于停用 DNS 拦截检查功能的本地开关。该检查功能旨在尝试检测浏览器是否使用了会重定向不明主机名的代理。\n\n在企业环境中，其网络配置是已知的，可能没必要使用这项检测功能，因为如果在此类环境中使用该功能，那么每当该功能启动时以及每当 DNS 配置有变时，都会产生一些 DNS 和 HTTP 流量。\n\n如果未设置或启用了此政策，系统会执行 DNS 拦截检查。如果明确停用了此政策，系统便不会执行 DNS 拦截检查。";
DataURLWhitespacePreservationEnabled.pfm_title = "保留所有媒体类型的 DataURL 空白";
DataURLWhitespacePreservationEnabled.pfm_description = "对于data网址中的空白，可通过此政策选择暂时不更改 Chrome 的处理方式。在之前，只有当顶级媒体类型为text或包含媒体类型字符串 xml 时，才会保留空白。\n现在，无论媒体类型如何，所有数据网址都将保留空白。\n\n如果此政策未设置或设为 True，系统会启用新行为。\n\n如果此政策设为 False，系统会启用旧行为。";
DataUrlInSvgUseEnabled.pfm_title = "对 SVGUseElement 的数据网址支持。";
DataUrlInSvgUseEnabled.pfm_description = "此政策用于为 SVGUseElement 启用数据网址支持；自 M119 起，该支持将默认处于停用状态。\n如果此政策已启用，数据网址会继续在 SVGUseElement 中发挥作用。\n如果此政策已停用或未设置，数据网址不会在 SVGUseElement 中发挥作用。";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "为 Web Worker 中的数据网址启用不透明来源";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "用于控制是否为通过数据网址创建的 Web Worker 分配唯一的不透明来源。\n\nWeb Worker 可通过包含 Worker 脚本的数据网址创建。以前，这些 Worker 会继承创建它们的页面的来源，从而能够访问相同的本地存储空间、Cookie 和其他与来源绑定的数据。为了提高安全性并符合 HTML 规范，Chrome 将在里程碑 149 中更改其默认行为，使通过数据网址创建的 Worker 具有唯一的不透明来源，从而将其与创建者页面的数据隔离开来。\n\n如果此政策设为“已启用”或未设置，系统会使用新的默认（更安全）行为，并且通过数据网址创建的 Web Worker 将具有唯一的不透明来源。\n\n如果此政策设为“已停用”，Chrome 会恢复至旧版行为，并且通过数据网址创建的 Web Worker 将继承其创建者的来源。此政策可让管理员在内部应用因安全更改而出现故障时，暂时解决兼容性问题。\n\n此政策只是暂时性措施，将在里程碑 157 中移除。";
DefaultAutomaticDownloadsSetting.pfm_title = "默认自动下载设置";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - 允许网站自动下载多个文件\n2 - 禁止任何网站自动下载多个文件\n3 - 每次网站想自动下载多个文件时都询问\n如果此政策设为 1，系统会允许网站自动下载多个文件。如果此政策设为 2，系统会拒绝向网站授予此权限。您可通过设置此政策，让网站在每次想要自动下载多个文件时都先询问用户。\n\n如果此政策未设置，系统将应用 AskAutomaticDownloads 政策，但用户仍可更改此设置。";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "将 Brave 设为默认浏览器";
DefaultBrowserSettingEnabled.pfm_description = "如果此政策设为 True，Brave 在启动时始终会检查自己是否是默认浏览器，并会尽可能自动注册。如果此政策设为 False，Brave 一律不会检查自己是否是默认浏览器，并会禁止用户设置此选项。\n\n如果您不设置此政策，Brave 会让用户控制是否将它设置为默认浏览器，以及是否在它不是默认浏览器的情况下显示用户通知。\n\nMicrosoft®Windows® 管理员需要注意：只能在运行 Windows 7 的设备中开启此设置。在运行更高版本的设备中，您必须部署一个“默认应用关联”文件，使 Brave 成为 https 和 http 协议的处理程序（也可成为 ftp 协议和其他文件格式的处理程序）。请参阅 Chrome 帮助文章 ( https://support.google.com/chrome?p=make_chrome_default_win )。";
DefaultClipboardSetting.pfm_title = "默认剪贴板设置";
DefaultClipboardSetting.pfm_description = "2 - 不允许任何网站使用剪贴板网站权限\n3 - 允许网站请求用户授予剪贴板网站权限\n如果此政策设为 2，网站将无法使用剪贴板网站权限。如果此政策设为 3 或未设置，用户将能更改相关设置，并能在网站想使用剪贴板 API 时决定是否允许使用剪贴板 API。\n\n您可通过在 ClipboardAllowedForUrls 和 ClipboardBlockedForUrls 政策中设置特定网址格式来覆盖此政策。\n\n此政策仅影响由剪贴板网站权限控制的剪贴板操作，不影响已清理的剪贴板写入操作或受信任的复制和粘贴操作。";
DefaultCookiesSetting.pfm_title = "默认 Cookie 设置";
DefaultCookiesSetting.pfm_description = "1 - 允许所有网站设置本地数据\n2 - 不允许任何网站设置本地数据\n4 - 在会话期间保留 Cookie\n您可以通过设置 CookiesSessionOnlyForUrls 创建一个网址格式列表，从而指定哪些网站可以/无法为单个会话设置 Cookie，除非 RestoreOnStartup 政策设为一律恢复先前会话中的网址。\n\n如果您未设置此政策，那么，倘若 DefaultCookiesSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。指定的格式未涵盖的网址也会导致系统使用默认设置。\n\n另请查看一下 CookiesBlockedForUrls 和 CookiesAllowedForUrls。虽然这 3 项政策并无优先级差异，它们的网址格式不得互相冲突。";
DefaultDownloadDirectory.pfm_title = "设置默认下载目录";
DefaultDownloadDirectory.pfm_description = "通过设置此政策，您可以更改 Chrome 会将文件下载到的默认目录，但用户可以更改该目录。\n\n如果您未设置此政策，Chrome 会使用自己的平台专用默认目录。\n\n此政策只有在未设置 DownloadDirectory 政策的情况下才会生效。\n\n注意：查看您可以使用哪些变量 ( https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables )。";
DefaultFileSystemReadGuardSetting.pfm_title = "控制 File System API 在读取方面的使用";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - 不允许任何网站通过 File System API 请求对文件和目录的读取权限\n3 - 允许网站通过 File System API 请求用户授予对文件和目录的读取权限\n如果此政策设为 3，系统会允许网站通过 File System API 请求对主机操作系统的文件系统中的文件和目录的读取权限。如果此政策设为 2，系统会禁止网站请求访问。\n\n如果此政策未设置，系统会允许网站请求访问，但用户可以更改此设置。";
DefaultFileSystemWriteGuardSetting.pfm_title = "控制 File System API 在写入方面的使用";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - 不允许任何网站请求对文件和目录的写入权限\n3 - 允许网站请求用户授予对文件和目录的写入权限\n如果此政策设为 3，系统会允许网站请求对主机操作系统的文件系统中的文件和目录的写入权限。如果此政策设为 2，系统会禁止网站请求访问。\n\n如果此政策未设置，系统会允许网站请求访问，但用户可以更改此设置。";
DefaultGeolocationSetting.pfm_title = "默认地理位置设置";
DefaultGeolocationSetting.pfm_description = "1 - 允许网站跟踪用户的地理位置\n2 - 不允许任何网站跟踪用户的地理位置\n3 - 每次网站尝试跟踪用户的地理位置时都询问我\n如果此政策设为 1，系统会默认允许网站跟踪用户的实际位置；如果设为 2，则系统会默认禁止此类跟踪。您可通过设置此政策，让网站在每次想要跟踪用户的实际位置时都先询问用户的意见。\n\n如果此政策未设置，则意味着 AskGeolocation 政策适用，但用户可以更改此设置。";
DefaultIdleDetectionSetting.pfm_title = "空闲检测";
DefaultIdleDetectionSetting.pfm_description = "1 - 允许网站不询问用户意见即可检测空闲状态\n2 - 不允许任何网站检测用户的空闲状态\n3 - 每次网站尝试检测用户的空闲状态时都询问\n您可以借助此政策来设置是否允许网站使用 Idle Detection API。\n\n如果此政策设为 1 - AllowIdleDetection，则网站可以使用该 API，而无需征求用户许可。\n\n如果此政策设为 2 - BlockIdleDetection，则网站将无法使用该 API，无论用户是否授予了许可。\n\n如果此政策设为 3 - AskIdleDetection 或未设置，则网站无法未经用户许可便使用该 API。";
DefaultImagesSetting.pfm_title = "默认图片设置";
DefaultImagesSetting.pfm_description = "1 - 允许所有网站显示所有图片\n2 - 不允许任何网站显示图片\n如果此政策设为 1，系统会允许所有网站显示图片；如果设为 2，系统会禁止网站显示图片；\n\n如果未设置，系统会允许网站显示图片，但用户可以更改此设置。";
DefaultInsecureContentSetting.pfm_title = "控制对不安全内容例外情况的使用";
DefaultInsecureContentSetting.pfm_description = "2 - 不允许任何网站加载混合内容\n3 - 让用户能够添加例外情况以允许显示混合内容\n让您能够设置用户可否添加例外情况以允许在特定网站中显示混合内容。\n\n您可以使用“InsecureContentAllowedForUrls”和“InsecureContentBlockedForUrls”政策为特定网址格式覆盖此政策。\n\n如果此政策未设置，用户将能添加例外情况以允许显示可屏蔽的混合内容，并能为可选的可屏蔽混合内容停用自动升级功能。";
DefaultJavaScriptJitSetting.pfm_title = "控制对 JavaScript JIT 的使用";
DefaultJavaScriptJitSetting.pfm_description = "1 - 允许任何网站运行 JavaScript JIT\n2 - 不允许任何网站运行 JavaScript JIT\n让您能够设置 Brave 是否将在运行 v8 JavaScript 引擎时启用 JIT（即时）编译器。\n\n停用 JavaScript JIT 后，Brave 呈现网页内容的速度可能会更慢，且可能会停用 JavaScript 的某些部分（包括 WebAssembly）。停用 JavaScript JIT 可能会允许 Brave 以更安全的配置呈现网页内容。\n\n您可以使用 JavaScriptJitAllowedForSites 和 JavaScriptJitBlockedForSites 政策为特定网址格式覆盖此政策。\n\n如果未设置此政策，系统会启用 JavaScript JIT。";
DefaultJavaScriptOptimizerSetting.pfm_title = "控制对 JavaScript 优化工具的使用";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - 在所有网站上启用高级 JavaScript 优化功能\n2 - 在所有网站上停用高级 JavaScript 优化功能\n让您能够设置 Brave 是否将在运行 v8 JavaScript 引擎时启用更高级的 JavaScript 优化功能。\n\n停用 JavaScript 优化功能（通过将此政策的值设为 2）后，Brave 渲染 Web 内容的速度可能会变慢。\n\n您可以使用 JavaScriptOptimizerAllowedForSites 和 JavaScriptOptimizerBlockedForSites 政策为特定网址格式覆盖此政策。\n\n如果您未设置此政策，系统会启用 JavaScript 优化功能。";
DefaultJavaScriptSetting.pfm_title = "默认 JavaScript 设置";
DefaultJavaScriptSetting.pfm_description = "1 - 允许所有网站运行 JavaScript\n2 - 不允许任何网站运行 JavaScript\n如果此政策设为 1，系统会允许网站运行 JavaScript；如果设为 2，系统会禁止网站运行 JavaScript；\n\n如果未设置，则系统会允许运行 JavaScript，但用户可以更改此设置。";
DefaultLocalFontsSetting.pfm_title = "默认的本地字体权限设置";
DefaultLocalFontsSetting.pfm_description = "2 - 默认拒绝向所有网站授予本地字体权限\n3 - 每当网站想获得本地字体权限时都询问\n如果您将此政策设为 BlockLocalFonts（值　2），默认情况下，系统会自动拒绝向网站授予本地字体权限。此设置会限制网站查看本地字体相关信息的能力。\n\n如果您将此政策设为 AskLocalFonts（值 3），默认情况下，系统会在网站请求获取本地字体权限时提示用户。如果用户同意授予这项权限，则会扩展网站查看本地字体相关信息的能力。\n\n如果您未设置此政策，系统便会应用默认行为（即提示用户），但用户可以更改此设置";
DefaultNotificationsSetting.pfm_title = "默认通知设置";
DefaultNotificationsSetting.pfm_description = "1 - 允许网站显示桌面通知\n2 - 不允许任何网站显示桌面通知\n3 - 每次网站尝试显示桌面通知时都询问\n如果此政策设为 1，系统会允许网站显示桌面通知；如果设为 2，系统会禁止网站显示桌面通知；\n\n如果未设置，则意味着 AskNotifications 政策适用，但用户可以更改此设置。";
DefaultPopupsSetting.pfm_title = "默认弹出式窗口设置";
DefaultPopupsSetting.pfm_description = "1 - 允许所有网站显示弹出式窗口\n2 - 不允许任何网站显示弹出式窗口\n如果此政策设为 1，系统会允许网站显示弹出式窗口；如果设为 2，系统会禁止网站显示弹出式窗口；\n\n如果未设置，则意味着 BlockPopups 政策适用，但用户可以更改此设置。";
DefaultPrinterSelection.pfm_title = "默认打印机选择规则";
DefaultPrinterSelection.pfm_description = "通过设置此政策，可以设定 Brave 中选择默认打印机的规则，从而覆盖默认的选择规则。用户首次打印时，Brave 会寻找一台与指定属性匹配的打印机。如果没有与指定属性完全匹配的打印机，可以通过设置让 Brave 选择一台与指定属性部分匹配的打印机，具体取决于打印机被发现的顺序。\n\n如果未设置此政策，或没有打印机与所设属性匹配，系统会选择内置的 PDF 打印机作为默认打印机。如果没有 PDF 打印机，Brave 默认不会选择任何打印机。\n\n目前，所有打印机都会归类为\"local\"打印机。连接到 Google Cloud Print的打印机会被视为\"cloud\"打印机，但 Google Cloud Print已不再受支持。\n\n注意：如果您未在某个字段中输入值，则意味着所有打印机都符合此项属性。例如，如果未指定 idPattern 的值，则意味着“打印预览”接受所有打印机 ID。正则表达式的格式必须遵循 JavaScript RegExp 语法，并在匹配时区分大小写。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection。";
DefaultSearchProviderAlternateURLs.pfm_title = "默认搜索服务提供商的备选网址列表";
DefaultSearchProviderAlternateURLs.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderAlternateURLs 来指定用于从搜索引擎提取搜索字词的备用网址列表。网址应包含字符串'{searchTerms}'。\n\n如果您不设置 DefaultSearchProviderAlternateURLs，系统将不会使用任何备用网址提取搜索字词。";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "允许在上下文菜单中使用默认搜索服务提供商进行搜索";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "允许在上下文菜单中使用默认搜索服务提供商。\n\n如果您停用了此政策，依赖您的默认搜索服务提供商的搜索上下文菜单项将不可用。\n\n如果您启用了或未设置此政策，与您的默认搜索服务提供商对应的上下文菜单项将可用。\n\n此政策的值仅在 DefaultSearchProviderEnabled 政策设为启用时才适用，在其他情况下一概不适用。";
DefaultSearchProviderEnabled.pfm_title = "启用默认搜索服务提供商";
DefaultSearchProviderEnabled.pfm_description = "如果已启用此政策，当用户在地址栏中输入非网址的文字时，系统将会执行默认搜索。若要指定默认搜索服务提供商，请设置其余的默认搜索政策。如果您将这些政策留空，用户可自行选择默认提供商。如果已停用此政策，当用户在地址栏中输入非网址的文字时，系统将不会执行任何搜索。Google Admin console不支持将值设为“已停用”。\n\n如果您设置了此政策，用户将无法在 Brave 中更改它。如果未设置此政策，系统将启用默认的搜索服务提供商，并且用户可以自行设置搜索服务提供商列表。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
DefaultSearchProviderEncodings.pfm_title = "默认搜索服务提供商的编码";
DefaultSearchProviderEncodings.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderEncodings 来指定搜索服务提供商支持的字符编码。编码是 UTF-8、GB2312 和 ISO-8859-1 之类的代码页名称。系统会按照您指定的顺序尝试这些编码。\n\n如果您不设置 DefaultSearchProviderEncodings，系统将使用 UTF-8。";
DefaultSearchProviderImageURL.pfm_title = "用来为默认搜索服务提供商提供图片搜索功能的参数";
DefaultSearchProviderImageURL.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderImageURL 来指定用于搜索图片的搜索引擎网址。（如果 DefaultSearchProviderImageURLPostParams 已设置，图片搜索请求会改用 POST 方法。）\n\n如果您不设置 DefaultSearchProviderImageURL，系统将不会搜索任何图片。\n\n如果图片搜索使用 get 方法，则网址必须使用以下占位符的有效组合来指定图片参数：\n'{google:imageURL}'、\n'{google:imageOriginalHeight}'、\n'{google:imageOriginalWidth}'、\n'{google:processedImageDimensions}'、\n'{google:imageSearchSource}'、\n'{google:imageThumbnail}'、\n'{google:imageThumbnailBase64}'。";
DefaultSearchProviderImageURLPostParams.pfm_title = "在使用 POST 的图片网址中所需的参数";
DefaultSearchProviderImageURLPostParams.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderImageURLPostParams 来指定在借助 POST 搜索图片时应使用的参数。所指定的内容由一系列以英文逗号分隔的名称-值对组成。如果值为模板参数（例如 {imageThumbnail}），系统会将其替换成真实的缩略图数据。\n\n如果您不设置 DefaultSearchProviderImageURLPostParams，系统将使用 get 方法发送图片搜索请求。\n\n网址必须使用以下占位符的有效组合来指定图片参数，具体取决于搜索服务提供商支持的组合：\n'{google:imageURL}'、\n'{google:imageOriginalHeight}'、\n'{google:imageOriginalWidth}'、\n'{google:processedImageDimensions}'、\n'{google:imageSearchSource}'、\n'{google:imageThumbnail}'、\n'{google:imageThumbnailBase64}'。";
DefaultSearchProviderKeyword.pfm_title = "默认搜索服务提供商关键字";
DefaultSearchProviderKeyword.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderKeyword 来指定关键字或快捷方式，以用于在地址栏中触发针对此提供商的搜索。\n\n如果您不设置 DefaultSearchProviderKeyword，则意味着没有任何可用于查找此搜索服务提供商的关键字。";
DefaultSearchProviderName.pfm_title = "默认搜索服务提供商名称";
DefaultSearchProviderName.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderName 来指定默认搜索服务提供商的名称。\n\n如果您不设置 DefaultSearchProviderName，系统将使用由搜索网址指定的主机名。";
DefaultSearchProviderNewTabURL.pfm_title = "默认搜索服务提供商新标签页网址";
DefaultSearchProviderNewTabURL.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderNewTabURL 来指定用于提供新标签页的搜索引擎网址。\n\n如果您不设置 DefaultSearchProviderNewTabURL，系统将不会提供任何新标签页。";
DefaultSearchProviderSearchURL.pfm_title = "默认搜索服务提供商的搜索网址";
DefaultSearchProviderSearchURL.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderSearchURL 来指定在默认搜索期间使用的搜索引擎网址。该网址应包含字符串'{searchTerms}'；当用户执行查询时，系统会将此字符串替换成用户的搜索字词。\n\n您可按以下格式指定 Google 的搜索网址：'{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'。";
DefaultSearchProviderSearchURLPostParams.pfm_title = "在使用 POST 的搜索网址中所需的参数";
DefaultSearchProviderSearchURLPostParams.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderSearchURLPostParams 来指定在借助 POST 搜索网址时应使用的参数。所指定的内容由一系列以英文逗号分隔的名称-值对组成。如果值为模板参数（例如'{searchTerms}'），系统会将其替换成真实的搜索字词数据。\n\n如果您不设置 DefaultSearchProviderSearchURLPostParams，系统将使用 GET 方法发送网址搜索请求。";
DefaultSearchProviderSuggestURL.pfm_title = "默认搜索服务提供商建议网址";
DefaultSearchProviderSuggestURL.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderSuggestURL 来指定用于提供搜索建议的搜索引擎网址。该网址应包含字符串'{searchTerms}'；当用户执行查询时，系统会将此字符串替换成用户的搜索字词。\n\n您可按以下格式指定 Google 的搜索网址：'{google:baseURL}complete/search?output=chrome&q={searchTerms}'。";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "在使用 POST 的建议网址中所需的参数";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "如果 DefaultSearchProviderEnabled 已开启，您便可通过设置 DefaultSearchProviderSuggestURLPostParams 来指定在借助 POST 搜索建议时应使用的参数。所指定的内容由一系列以英文逗号分隔的名称-值对组成。如果值为模板参数（例如'{searchTerms}'），系统会将其替换成真实的搜索字词数据。\n\n如果您不设置 DefaultSearchProviderSuggestURLPostParams，系统将使用 GET 方法发送建议搜索请求。";
DefaultSensorsSetting.pfm_title = "默认传感器设置";
DefaultSensorsSetting.pfm_description = "1 - 允许网站使用传感器\n2 - 不允许任何网站使用传感器\n3 - 每次网站想访问传感器时都询问\n如果此政策设为 1，则允许网站访问并使用动作和光线等传感器。如果此政策设为 2，则禁止访问传感器。当此政策设为 3 时，如果已启用三态功能标志，系统会在网站请求访问传感器时询问用户；否则默认允许访问传感器。\n\n如果未设置，则意味着 AllowSensors 政策适用，但用户可以更改此设置。";
DefaultSerialGuardSetting.pfm_title = "控制对 Serial API 的使用";
DefaultSerialGuardSetting.pfm_description = "2 - 不允许任何网站请求通过 Serial API 使用串行端口\n3 - 允许网站请求用户授权其访问串行端口\n如果此政策设为 3，系统会允许网站请求访问串行端口。如果此政策设为 2，系统会禁止访问串行端口。\n\n如果此政策未设置，系统会允许网站请求访问，但用户可以更改此设置。";
DefaultWebBluetoothGuardSetting.pfm_title = "控制对 Web Bluetooth API 的使用";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - 不允许任何网站通过 Web Bluetooth API 请求访问蓝牙设备\n3 - 允许网站请求用户授予对附近蓝牙设备的访问权限\n如果此政策设为 3，系统会允许网站请求访问附近的蓝牙设备。如果此政策设为 2，系统会禁止网站访问附近的蓝牙设备。\n\n如果此政策未设置，系统会允许网站请求访问，但用户可以更改此设置。";
DefaultWebHidGuardSetting.pfm_title = "控制对 WebHID API 的使用";
DefaultWebHidGuardSetting.pfm_description = "2 - 不允许任何网站通过 WebHID API 请求对 HID 设备的访问权限\n3 - 允许网站请求用户授予对 HID 设备的访问权限\n如果此政策设为 3，系统会允许网站请求对 HID 设备的访问权限。如果此政策设为 2，系统会禁止网站访问 HID 设备。\n\n如果此政策未设置，系统会允许网站请求获取访问权限，但用户可以更改此设置。\n\n您可通过在 WebHidAskForUrls 和 WebHidBlockedForUrls 政策中设置特定url格式来覆盖此政策。";
DefaultWebUsbGuardSetting.pfm_title = "控制对 WebUSB API 的使用";
DefaultWebUsbGuardSetting.pfm_description = "2 - 不允许任何网站通过 WebUSB API 请求访问 USB 设备\n3 - 允许网站请求用户授权其访问所连接的 USB 设备\n如果此政策设为 3，系统会允许网站请求访问已连接的 USB 设备。如果此政策设为 2，系统会禁止网站访问已连接的 USB 设备。\n\n如果此政策未设置，系统会允许网站请求访问，但用户可以更改此设置。";
DefaultWindowManagementSetting.pfm_title = "默认窗口管理权限设置";
DefaultWindowManagementSetting.pfm_description = "2 - 默认情况下拒绝向所有网站授予窗口管理权限\n3 - 每当网站想获得窗口管理权限时都询问\n如果此政策设为 BlockWindowManagement（值 2），默认情况下，系统会自动拒绝向网站授予窗口管理权限。此设置会限制网站的以下功能：查看设备屏幕的相关信息，以及使用该信息在特定屏幕上打开并放置窗口或者请求进入全屏模式。\n\n如果此政策设为 AskWindowManagement（值 3），默认情况下，当网站请求获取窗口管理权限时，系统会提示用户。如果用户同意授予这项权限，则会扩展网站的以下功能：查看设备屏幕的相关信息，以及使用该信息在特定屏幕上打开并放置窗口或者请求进入全屏模式。\n\n如果此政策未设置，则系统会应用 AskWindowManagement 政策，但用户可以更改此设置。\n\n此政策取代了已弃用的 DefaultWindowPlacementSetting 政策。";
DeletingUndecryptablePasswordsEnabled.pfm_title = "允许删除无法破解的密码";
DeletingUndecryptablePasswordsEnabled.pfm_description = "此政策用于控制内置密码管理工具是否可以从其数据库中删除无法破解的密码。您必须允许删除密码才能恢复内置密码管理工具的全部功能，但这可能会导致数据永久丢失。无法破解的密码值不会自动变为可破解的密码值，即使能够修正这一问题，通常也需要执行复杂的用户操作。\n\n如果已启用或未设置此政策，用户将丢失保存在内置密码管理工具中的无法破解的密码。仍处于正常状态的密码不会受到影响。\n\n如果此政策已停用，用户保存在密码管理工具中的数据不会受到影响，但密码管理工具的功能会出现问题。\n\n如果已设置此政策，用户便无法在 Brave 中更改它。";
DesktopSharingHubEnabled.pfm_title = "在多功能框和三点状菜单中启用桌面分享功能";
DesktopSharingHubEnabled.pfm_description = "如果此政策设为 True 或未设置，用户便可使用桌面分享中心提供的操作分享或保存当前网页。可通过多功能框或三点状菜单访问分享中心。\n\n如果此政策设为 False，系统会从多功能框移除分享图标，并从三点状菜单移除相应条目。";
DevToolsGenAiSettings.pfm_title = "Chrome DevTools生成式 AI 功能的设置";
DevToolsGenAiSettings.pfm_description = "0 - 允许使用 Chrome DevTools生成式 AI 功能并改进 AI 模型。\n1 - 允许使用 Chrome DevTools生成式 AI 功能，但不改进 AI 模型。\n2 - 不允许使用 Chrome DevTools生成式 AI 功能。\nChrome DevTools中的这些功能采用生成式 AI 模型来提供额外的调试信息。如需使用这些功能，Brave 必须收集出错提示、堆栈轨迹、代码段和网络请求等数据，并将这些数据发送到用于运行生成式 AI 模型的 Google 服务器。网络请求中的响应正文或身份验证信息和 Cookie 标头不会包含在发送至服务器的数据中。\n\n0 表示允许使用此功能，同时允许 Google 使用相关数据改进其 AI 模型。相关数据可能包括提示、输入、输出、素材和书面反馈，具体取决于相应功能。这些数据也可能会由人工审核，以改进 AI 模型。默认值是 0，但以下注明的情况除外。\n\n1 表示允许使用此功能，但不允许 Google 使用用户内容（包括提示、输入、输出、素材和书面反馈）改进模型。对于受 Google Admin console管理的企业用户和受 Google Workspace 管理的教育版账号，默认值是 1。\n\n2 表示不允许使用此功能。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。\n\nChrome DevTools的生成式 AI 功能包括：\n\n- 控制台数据分析：解释控制台消息，并提供有关修复控制台错误的建议。\n\n- AI 辅助：帮助您了解 CSS 样式（从版本 131 开始）、网络请求、性能和文件（均从版本 132 开始）。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "在 Chrome DevTools中启用 Google 开发者计划资料";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - 在 Chrome DevTools中启用 Google 开发者计划集成功能。\n1 - 在 Chrome DevTools中启用 Google 开发者计划集成功能，但不分享工具使用情况（用于获得徽章）。\n2 - 不在 Chrome DevTools中启用 Google 开发者计划集成功能。\n此政策会控制 Google 开发者计划与 Chrome DevTools的集成。用户的 Google 开发者计划资料会显示在 Chrome DevTools中，并且用户在 Chrome DevTools中执行特定操作后会获得徽章。\n\n如果将此政策设为 0 -“已启用”，或者未设置任何政策值，则允许将 Google 开发者计划与 Chrome DevTools集成，并允许分享 Chrome DevTools工具使用情况，以便能够获得徽章。\n\n如果将此政策设为 1 -“已启用，但不获得徽章”，则允许将 Google 开发者计划与 Chrome DevTools集成，但不允许与 Google 开发者计划分享 Chrome DevTools工具使用情况。这种情况下，不会获得任何徽章。\n\n如果将此政策设为 2 -“已停用”，则不允许将 Google 开发者计划与 Chrome DevTools集成。";
DeveloperToolsAvailability.pfm_title = "控制可以在何处使用 Chrome DevTools";
DeveloperToolsAvailability.pfm_description = "0 - 禁止在由企业政策安装的应用和扩展程序中使用 Chrome DevTools；自 114 版起，也禁止受管理的用户在浏览器内置的扩展程序中使用开发者工具。允许在其他情境下使用 Chrome DevTools\n1 - 允许使用 Chrome DevTools\n2 - 禁止使用 Chrome DevTools\n如果此政策设为 0（默认值），您可以访问 Chrome DevTools和 JavaScript 控制台，但无法在由企业政策安装的扩展程序中访问它们；自 114 版起，若是受管理的用户，也无法在浏览器内置的扩展程序中访问它们。如果此政策设为 1，无论在什么情境下（包括在由企业政策安装的扩展程序中），您都可以访问 Chrome DevTools和 JavaScript 控制台。如果此政策设为 2，您既无法访问 Chrome DevTools，也无法检查网站元素。\n\n此设置还会关闭用于打开 Chrome DevTools或 JavaScript 控制台的键盘快捷键及菜单/上下文菜单条目。自 Brave 99 版起，此设置还可控制“查看网页源代码”功能的入口点。如果此政策设为“DeveloperToolsDisallowed”（值为 2），用户将无法通过键盘快捷键或上下文菜单查看源代码。若要完全阻止查看源代码，您还必须将“view-source:*”添加到 URLBlocklist 政策中。\n\n自 Brave 119 版起，此设置还可控制是否可以对独立式 Web 应用 (IWA) 启用和使用开发者模式。\n\n自 Brave 128 版起，如果设置了 ExtensionDeveloperModeSettings 政策，此设置将不会控制扩展程序页面上的开发者模式。\n\n此政策会影响 Chrome DevTools、Chrome DevTools Protocol (CDP) 直接访问权限（例如，使用 --remote-debugging-port 或 --remote-debugging-pipe 启动时）以及通过 chrome.debugger API 获得的 Chrome DevTools Protocol (CDP) 访问权限。此政策和 RemoteDebuggingAllowed 政策均适用：RemoteDebuggingAllowed 用于控制是否可以启动远程调试，而此政策则用于限制在远程调试运行期间是否可以检查单个目标。\n\nDeveloperToolsAvailabilityAllowlist 和 DeveloperToolsAvailabilityBlocklist 政策优先于此政策。Chrome DevTools的可用性按以下优先顺序确定：\n1. 如果网址与 DeveloperToolsAvailabilityAllowlist 政策中的格式匹配，则允许使用 Chrome DevTools。\n2. 如果已设置 DeveloperToolsAvailabilityAllowlist，但未设置 DeveloperToolsAvailabilityBlocklist，则所有不在许可清单上的网址都会被屏蔽。\n3. 如果网址与 DeveloperToolsAvailabilityBlocklist 政策中的格式匹配，则 Chrome DevTools会被屏蔽。\n4. 如果未设置任何政策，或者网址与这两个列表都不匹配，则此政策 (DeveloperToolsAvailability) 将用作备用机制。";
DeveloperToolsAvailabilityAllowlist.pfm_title = "允许打开 Chrome DevTools的网址格式列表";
DeveloperToolsAvailabilityAllowlist.pfm_description = "可使用此政策允许在特定网址上使用 Chrome DevTools。\n\n系统会在目标层面评估 Chrome DevTools的可用性。系统会将网址格式与正在接受检查的每个目标（例如页面的主框架、嵌入式子框架、扩展程序或 Web 应用）的网址进行比对。最终行为取决于是否也设置了 DeveloperToolsAvailabilityBlocklist 政策。\n\n如果已设置此政策，但未设置 DeveloperToolsAvailabilityBlocklist，则只有当目标的网址与此许可清单上的格式匹配时，才允许对该目标使用 Chrome DevTools。如果目标的网址与此许可清单不匹配，系统将对该目标屏蔽 Chrome DevTools（例如，无法检查网址不在许可清单中的子框架，但如果主页面的网址在许可清单中，则仍可检查主页面）。如需了解网址格式，请参阅 https://support.google.com/chrome/a?p=url_blocklist_filter_format。\n\n如果同时设置了此政策和 DeveloperToolsAvailabilityBlocklist 政策，则以许可清单为准。如果目标的网址与此许可清单上的格式匹配，那么即使它同时匹配屏蔽清单中的格式，也仍会被允许。如果某个目标的网址与此屏蔽清单（而非许可清单）上的格式匹配，则该网址会被屏蔽。如果目标的网址与两者都不匹配，则 DeveloperToolsAvailability 政策将用作备用政策。\n\n如果未设置此政策，则将由 DeveloperToolsAvailabilityBlocklist 和 DeveloperToolsAvailability 政策决定 Chrome DevTools的可用性。\n\n不允许使用全主机通配符（例如“*”或“[*]”），请使用 DeveloperToolsAvailability 政策在全局范围内启用该功能。\n\n此政策会影响 Chrome DevTools、Chrome DevTools Protocol (CDP) 直接访问权限（例如，使用 --remote-debugging-port 或 --remote-debugging-pipe 启动时）以及通过 chrome.debugger API 获得的 Chrome DevTools Protocol (CDP) 访问权限。此政策和 RemoteDebuggingAllowed 政策均适用：RemoteDebuggingAllowed 用于控制是否可以启动远程调试，而此政策则用于限制在远程调试运行期间是否可以检查单个目标。\n\n此政策最多只能包含 1,000 个条目。";
DeveloperToolsAvailabilityBlocklist.pfm_title = "禁止使用 Chrome DevTools的网址格式列表";
DeveloperToolsAvailabilityBlocklist.pfm_description = "此政策可用于在特定网址上屏蔽 Chrome DevTools。如需了解网址格式，请参阅 https://support.google.com/chrome/a?p=url_blocklist_filter_format。\n\n系统会在目标层面评估 Chrome DevTools的可用性。系统会将网址格式与正在接受检查的每个目标（例如页面的主框架、嵌入式子框架、扩展程序或 Web 应用）的网址进行比对。最终行为取决于是否也设置了 DeveloperToolsAvailabilityAllowlist 政策。\n\n如果已设置此政策，但未设置 DeveloperToolsAvailabilityAllowlist，则当目标的网址与此屏蔽清单中的格式匹配时，将对该目标屏蔽 Chrome DevTools（例如，无法检查网址与此屏蔽清单匹配的子框架，但如果主页面的网址未列入屏蔽清单，则仍可检查主页面）。如果目标的网址与任何格式都不匹配，则将由 DeveloperToolsAvailability 政策决定可用性。\n\n如果同时设置了此政策和 DeveloperToolsAvailabilityAllowlist 政策，则以许可清单为准。如果目标的网址与许可清单上的格式匹配，那么即使它同时匹配屏蔽清单中的格式，也仍会被允许。如果某个目标的网址与此屏蔽清单（而非许可清单）上的格式匹配，则该网址会被屏蔽。如果目标的网址与两者都不匹配，则 DeveloperToolsAvailability 政策将用作备用政策。\n\n如果未设置此政策，则将由 DeveloperToolsAvailabilityAllowlist 和 DeveloperToolsAvailability 政策决定 Chrome DevTools的可用性。\n\n此政策会影响 Chrome DevTools、Chrome DevTools Protocol (CDP) 直接访问权限（例如，使用 --remote-debugging-port 或 --remote-debugging-pipe 启动时）以及通过 chrome.debugger API 获得的 Chrome DevTools Protocol (CDP) 访问权限。此政策和 RemoteDebuggingAllowed 政策均适用：RemoteDebuggingAllowed 用于控制是否可以启动远程调试，而此政策则用于限制在远程调试运行期间是否可以检查单个目标。\n\n此政策最多只能包含 1,000 个条目。";
Disable3DAPIs.pfm_title = "停用对 3D 图形 API 的支持";
Disable3DAPIs.pfm_description = "如果此政策设为 True（或者 HardwareAccelerationModeEnabled 设为 False），网页会无法访问 WebGL API。\n\n如果此政策设为 False 或未设置，网页可以使用 WebGL API，但浏览器的默认设置可能仍然要求在使用这些 API 前先传递命令行参数。";
DisableAuthNegotiateCnameLookup.pfm_title = "在协商 Kerberos 身份验证时停用 CNAME 查找";
DisableAuthNegotiateCnameLookup.pfm_description = "如果此政策已启用，系统便会跳过 CNAME 查找步骤。当生成 Kerberos SPN 时，系统会使用输入的服务器名称。\n\n如果此政策已停用或未设置，当生成 Kerberos SPN 时，服务器的规范名称将由 CNAME 查找来决定。";
DisablePrintPreview.pfm_title = "停用打印预览";
DisablePrintPreview.pfm_description = "如果此政策已启用，当用户请求打印某个页面时，Brave 将打开系统打印对话框而非内置打印预览。\n\n如果此政策已停用或未设置，打印命令将触发打印预览屏幕。";
DisableSafeBrowsingProceedAnyway.pfm_title = "禁止从安全浏览警告页面继续访问";
DisableSafeBrowsingProceedAnyway.pfm_description = "如果此政策已启用，用户在看到安全浏览服务显示的警告页面后将无法再继续访问相应的恶意网站。此政策只会阻止用户在收到安全浏览警告（如针对恶意软件和网上诱骗的警告）后继续进行访问，不针对与 SSL 证书相关的问题（如证书无效或已过期）。\n\n如果此政策已停用或未设置，用户在看到警告后可以选择继续访问被标记为可能存在恶意内容的网站。\n\n详细了解“安全浏览”功能 (https://developers.google.com/safe-browsing)。";
DisableScreenshots.pfm_title = "停用截取屏幕截图功能";
DisableScreenshots.pfm_description = "启用此政策会禁止使用键盘快捷键或扩展程序 API 截屏。停用或不设置此政策则会允许截屏。\n\n从 Brave 版本 154 开始，启用此政策还会阻止扩展程序通过“chrome.debugger.attach()”附加调试程序。\n\n请注意，在 Microsoft® Windows®、macOS 和 Linux 上，此政策不会阻止用户通过操作系统或第三方应用截屏。";
DiskCacheDir.pfm_title = "设置磁盘缓存目录";
DiskCacheDir.pfm_description = "如果您设置了此政策，那么无论用户是否指定了 --disk-cache-dir 标记，Brave 都会使用您所提供的目录在磁盘上存储缓存文件。\n\n如果您未设置此政策，Brave 会使用默认的缓存目录，但用户可以使用 --disk-cache-dir 命令行标记更改此设置。\n\nBrave 会管理卷的根目录内容。因此，为避免丢失数据或发生其他错误，请勿将此政策设为根目录或任何有其他用途的目录。查看您可以使用的变量 (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables)。";
DiskCacheSize.pfm_title = "设置磁盘缓存大小";
DiskCacheSize.pfm_description = "当此政策设为 None 时，Brave 会使用默认的缓存大小在磁盘中存储缓存文件。用户无法更改此设置。\n\n如果您设置了此政策，那么无论用户是否指定了 --disk-cache-size flag，Brave 都会使用您所提供的缓存大小（小于几兆字节的值都会向上舍入）。\n\n如果您未设置此政策，Brave 会使用默认大小。用户可以使用 --disk-cache-size flag 更改此设置。\n\n注意：此政策中指定的值会被用作对浏览器中各种缓存子系统的提示。因此，所有缓存的实际磁盘总消耗将会变得更高，但仍会与指定的值在同一数量级。";
DnsOverHttpsMode.pfm_title = "控制 DNS-over-HTTPS 模式";
DnsOverHttpsMode.pfm_description = "off - 停用 DNS-over-HTTPS\nautomatic - 启用 DNS-over-HTTPS，且允许改用不安全的查询\nsecure - 启用 DNS-over-HTTPS，且禁止改用不安全的查询\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "指定所需 DNS-over-HTTPS 解析器的 URI 模板";
DnsOverHttpsTemplates.pfm_description = "所需 DNS-over-HTTPS 解析器的 URI 模板。若要指定多个 DNS-over-HTTPS 解析器，请使用空格分隔相应的 URI 模板。\n\n如果 DnsOverHttpsMode 设为 \"secure\"，则必须设置此政策，不得将它留空。（仅限 Google Chrome OS）必须设置此政策或 DnsOverHttpsTemplatesWithIdentifiers，否则 DNS 解析将会失败。\n\n如果 DnsOverHttpsMode 设为\"automatic\"，并且此政策已设置，系统将会使用指定的 URI 模板；如果此政策未设置，系统便会使用硬编码映射来尝试将用户的当前 DNS 解析器升级到由同一提供商运营的 DoH 解析器。\n\n如果 URI 模板包含 dns 变量，向解析器发出的请求将会使用 GET；否则，这些请求便会使用 POST。\n\n格式有误的模板将被忽略。";
DomainReliabilityAllowed.pfm_title = "允许报告网域可靠性相关数据";
DomainReliabilityAllowed.pfm_description = "如果此政策设为 false，系统会停用网域可靠性诊断数据报告功能，且不会向 Google 发送任何数据。\n如果此政策设为 true 或未设置，系统会按照 Brave 的 MetricsReportingEnabled 行为或 Google Chrome OS 的 DeviceMetricsReportingEnabled 行为执行网域可靠性诊断数据报告功能。";
DownloadDirectory.pfm_title = "设置下载目录";
DownloadDirectory.pfm_description = "通过设置此政策，您可以配置供 Chrome 用于下载文件的目录。无论用户是指定了一个目录，还是开启了 flag，要求系统在每次下载前都向用户询问文件保存位置，Chrome 都会使用此政策中提供的目录。\n\n此政策会覆盖 DefaultDownloadDirectory 政策。\n\n如果您未设置此政策，Chrome 会使用默认下载目录，而且用户可以更改此目录。\n\n在 Google Chrome OS 中，可将此政策仅设为 Google 云端硬盘目录。\n\n注意：查看您可以使用哪些变量 ( https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables )。";
DownloadRestrictions.pfm_title = "下载限制";
DownloadRestrictions.pfm_description = "0 - 无特殊限制。默认。\n1 - 拦截恶意下载内容和危险文件类型。\n2 - 拦截恶意下载内容、不常见或不需要的下载内容以及危险文件类型。\n3 - 拦截所有下载内容。\n4 - 拦截恶意下载内容。推荐。\n如果设置此政策，用户便无法绕过下载安全性决策。\n\nChrome 中有很多类型的下载警告，这些警告大致分为以下类别（如需详细了解“安全浏览”功能的判定结果，请访问 https://support.google.com/chrome/?p=ib_download_blocked）：\n\n* 恶意，由“安全浏览”服务器标记\n* 不常见或不需要，由“安全浏览”服务器标记\n* 危险文件类型（例如，所有 SWF 下载内容和很多 EXE 下载内容）\n\n设置此政策可以拦截这些下载内容的不同子集，具体取决于此政策的值：\n\n0：无特殊限制。这是默认值。\n\n1：拦截已被“安全浏览”服务器标记的恶意文件以及所有危险文件类型。仅推荐用于对误判有较高容忍度的组织部门/浏览器/用户。\n\n2：拦截已被“安全浏览”服务器标记的恶意文件、不常见或不需要的文件，以及所有危险文件类型。仅推荐用于对误判有较高容忍度的组织部门/浏览器/用户。\n\n3：拦截所有下载内容。除非是特殊使用情形，否则不推荐此设置。\n\n4：拦截已被“安全浏览”服务器标记的恶意文件，但不拦截危险文件类型。这是推荐值。\n\n注意：这些限制适用于通过网页内容以及“下载链接…”菜单选项触发的下载，但不适用于当前所示页面的下载，也不适用于通过打印选项另存为 PDF 文件的情形。详细了解“安全浏览”功能 (https://developers.google.com/safe-browsing)。";
EditBookmarksEnabled.pfm_title = "启用或停用书签修改功能";
EditBookmarksEnabled.pfm_description = "如果此政策已启用或未设置，用户可以添加、移除、修改或上传书签。\n\n如果此政策已停用，用户将无法添加、移除、修改或上传书签，但仍能使用现有书签。";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "在 Kerberos SPN 中加入非标准端口";
EnableAuthNegotiatePort.pfm_description = "如果您启用了此政策并输入了非标准端口（换言之，80 或 443 以外的端口），系统便会将此端口包含在生成的 Kerberos SPN 中。\n\n如果此政策已停用或未设置，生成的 Kerberos SPN 便不会包含端口。";
EnableExperimentalPolicies.pfm_title = "启用实验性政策";
EnableExperimentalPolicies.pfm_description = "允许 Brave 加载实验性政策。\n\n警告：实验性政策不受支持，而且在未来版本的浏览器中可能会被更改或移除，恕不另行通知！\n\n实验性政策可能尚未制定完毕，或者仍有已知或未知的缺陷。此类政策可能会被更改甚至移除，而不显示任何通知。启用实验性政策可能会致使您丢失浏览器数据，或者致使您的安全或隐私受到威胁。\n\n如果某项政策不在列表中且未正式发布，那么在 Beta 版和稳定版中，系统会忽略该政策的值。\n\n如果某项政策在列表中且未正式发布，系统会应用该政策的值。\n\n此政策不会影响已发布的政策。";
EnableMediaRouter.pfm_title = "启用 Google Cast";
EnableMediaRouter.pfm_description = "如果此政策已启用或未设置，系统将会开启 Google Cast 以供用户从以下位置启动：应用菜单、页面上下文菜单、支持 Cast 的网站上的媒体控件，以及（如果显示的话）Cast 工具栏图标。\n\n如果此政策已停用，系统会关闭 Google Cast。";
EnableOnlineRevocationChecks.pfm_title = "启用在线 OCSP/CRL 检查";
EnableOnlineRevocationChecks.pfm_description = "如果此政策设为 True，系统会执行在线 OCSP/CRL 检查。\n\n如果此政策设为 False 或未设置，Brave 不会在 Brave 19 和更高版本中执行在线撤消检查。\n\n请注意：OCSP/CRL 检查并不能有效增强安全性。";
EnableProxyOverrideRulesForAllUsers.pfm_title = "控制哪些受管理的用户可以设置 ProxyOverrideRules 和 ProxyProvisioningDomains 政策。";
EnableProxyOverrideRulesForAllUsers.pfm_description = "如果此政策设为 0 或未设置，将仅在受管理的浏览器上关联用户的用户范围内应用 ProxyOverrideRules 和 ProxyProvisioningDomains 政策。如果此政策设为 1，将在用户范围内应用 ProxyOverrideRules 和 ProxyProvisioningDomains 政策，即使相应用户不是关联用户也是如此。";
EnableUnsafeSwiftShader.pfm_title = "允许使用 SwiftShader 进行软件 WebGL 回退";
EnableUnsafeSwiftShader.pfm_description = "此政策控制在无法使用硬件 GPU 加速时，是否将 SwiftShader 用作 WebGL 回退方案。\n\nSwiftShader 曾用于在没有 GPU 加速的系统（例如无头系统或虚拟机）上支持 WebGL，但由于存在安全问题，该功能已被弃用。从 M139 开始，如果 WebGL 上下文创建操作原本会使用 SwiftShader，那么创建操作将失败。此政策允许浏览器或管理员暂时推迟弃用。\n\n如果此政策已启用，SwiftShader 将用作软件 WebGL 回退方案。\n\n如果此政策已停用或未设置，当硬件 GPU 加速不可用时，WebGL 上下文创建操作可能会失败。如果网页无法优雅地处理 WebGL 上下文创建失败的情况，则可能会出现异常行为。\n\n此政策只是暂时性政策，日后会被移除。";
EncryptedClientHelloEnabled.pfm_title = "启用经过 TLS 加密的 ClientHello";
EncryptedClientHelloEnabled.pfm_description = "经过加密的 ClientHello (ECH) 是 TLS 的一项扩展功能，用于加密 ClientHello 的敏感字段并加强隐私保护。\n\n如果您未配置或已启用此政策，Brave 将会遵循 ECH 的默认发布流程。如果您已停用此政策，Brave 将不会启用 ECH。\n\n当这项功能处于启用状态时，Brave 未必会使用 ECH，具体取决于服务器支持情况、HTTPS DNS 记录的可用性或发布状态。\n\nECH 是一种会不断演变的协议，因此 Brave 的实现可能会发生变化。所以，此政策只是一项临时措施，用于控制最初的实验性实现。待该协议演变完毕后，此政策将被替换为最终控件。";
EnterpriseCustomLabel.pfm_title = "为受管个人资料设置自定义企业标签";
EnterpriseCustomLabel.pfm_description = "此政策可控制用于标识受管理资料的自定义标签。对于受管理资料，此标签会显示在工具栏中的头像旁边。系统不会翻译该自定义标签。\n\n应用此政策后，任何超过 16 个字符的字符串都会被截断，并在末尾添加“…”。请避免使用过长的名称。\n\n此政策只能设置为用户政策。请注意，如果 EnterpriseProfileBadgeToolbarSettings 政策设为 hide_expanded_enterprise_toolbar_badge（值为 1），此政策将不会产生任何影响。";
EnterpriseCustomLabelForBrowser.pfm_title = "为受管浏览器设置自定义企业标签";
EnterpriseCustomLabelForBrowser.pfm_description = "此政策可控制用于标识受管浏览器的自定义标签。对于受管浏览器，此标签会显示在“新标签页”页面页脚的管理免责声明中。系统不会翻译该自定义标签。\n\n请注意，此政策仅适用于受管浏览器，对使用非受管浏览器的受管用户没有影响。在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "允许受管理的扩展程序使用 Enterprise Hardware Platform API";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "如果此政策设为 True，系统会允许由企业政策安装的扩展程序使用 Enterprise Hardware Platform API。\n\n如果此政策设为 False 或未设置，系统会阻止扩展程序使用该 API。\n\n请注意：此政策也适用于组件扩展程序，例如 Hangout Services 扩展程序。";
EnterpriseLogoUrl.pfm_title = "受管个人资料的企业徽标网址";
EnterpriseLogoUrl.pfm_description = "指向特定图片的网址，该图片将用作受管理资料的企业标记。该网址必须指向图片。\n\n此政策只能设为用户政策。建议使用网站图标（例如 https://www.google.com/favicon.ico）或不小于 48 x 48 像素的图标。";
EnterpriseLogoUrlForBrowser.pfm_title = "受管浏览器的企业徽标网址";
EnterpriseLogoUrlForBrowser.pfm_description = "指向特定图片的网址，该图片将用作受管浏览器的企业标记。此网址必须指向图片。建议使用网站图标（例如 https://www.google.com/favicon.ico）或不小于 48 x 48 像素的图标。请注意，此政策仅适用于受管浏览器，对使用非受管浏览器的受管用户没有影响。在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例，或已注册 Chrome Enterprise Core的实例。在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "控制企业资料标记在工具栏中的显示情况";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - 显示展开的企业工具栏标记\n1 - 隐藏展开的企业工具栏标记\n对于工作资料和学校资料，工具栏会默认在工具栏头像旁边显示“工作”或“学校”标签。只有登录受管理的账号时，系统才会显示该标签。\n\n如果此政策设为 hide_expanded_enterprise_toolbar_badge（值为 1），系统会在工具栏中隐藏受管理资料的企业标记。\n\n如果此政策未设置或设为 show_expanded_enterprise_toolbar_badge（值为 0），系统会显示企业标记。\n\n您可以通过 EnterpriseCustomLabel 政策自定义该标签。";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "默认在创建企业资料时保留浏览数据";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "如果此政策已启用，系统会默认勾选相应选项，允许在创建企业资料时保留所有现有浏览数据。\n\n如果此政策未设置或已停用，系统会默认不勾选相应选项，禁止在创建企业资料时保留所有现有浏览数据。\n\n无论此政策的值是什么，用户都能决定是否要在创建企业资料时保留所有现有浏览数据。\n\n如果用于保留现有浏览数据的选项不可用，此政策不会产生任何影响，这种情况会发生于系统严格执行企业资料分隔或者数据来自一份已受管理的资料时。\n";
EnterpriseSearchAggregatorSettings.pfm_title = "企业搜索聚合器设置";
EnterpriseSearchAggregatorSettings.pfm_description = "管理员可以通过此政策指定企业搜索聚合器，当用户在多功能框（地址栏）和“新标签页”页面上的搜索框中输入关键字时，该聚合器会提供搜索建议和结果。\n\n默认情况下，企业搜索建议会与常规的 Brave 建议混合显示。用户可以在多功能框中输入“shortcut”字段中指定的关键字（可以带 @ 前缀，例如 @work，也可以不带 @ 前缀），然后按空格键或 Tab 键，即可明确将搜索范围限定为企业搜索聚合器。目前，系统仅支持在多功能框中进行范围限定的企业搜索（由关键字触发），而不支持在“新标签页”页面上的搜索框中进行此类搜索。\n\n以下字段是必填字段：name、shortcut、search_url、suggest_url。\n\n“name”字段对应于地址栏中向用户显示的搜索引擎名称。\n\n“shortcut”字段对应于用户输入的用于触发搜索的关键字。快捷字词可以包含纯文字和字符，但不得包含空格，也不得以 @ 符号开头。快捷字词不得重复。\n\n“search_url”字段用于指定要在哪个网址中进行搜索。输入搜索引擎结果页面的网址，然后使用'{searchTerms}'代替搜索查询。\n\n“suggest_url”字段用于指定提供搜索建议的网址。Chrome 将发出 POST 请求，并通过键名为'query'的 POST 参数传递用户的搜索查询。\n\n“icon_url”字段用于指定将在搜索建议中使用的图片的网址。如果此字段未设置，Chrome 将使用默认图标。建议使用网站图标（示例：https://www.google.com/favicon.ico）。支持的图片文件格式包括：JPEG、PNG 和 ICO。\n\n“require_shortcut”字段用于指定是否需要地址栏shortcut才能查看搜索建议。如果需要，建议不会显示在“新标签页”页面上的搜索框中，但会继续显示在范围限定搜索模式下的多功能框（地址栏）中。如果此字段未经设置，则地址栏shortcut不是必需的。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings。";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "不针对所列网域中的指定文件类型显示基于文件类型扩展名的下载警告";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "如果启用此政策，您可以创建一个由文件类型扩展名构成的字典及配套的网域列表，指定这些扩展名不会在哪些网域中触发基于文件类型扩展名的下载警告。这样一来，企业管理员便能针对已与某个所列网域关联的文件类型，屏蔽基于文件类型扩展名的下载警告。例如，如果扩展名“jnlp”与网域“website1.com”关联，用户在从“website1.com”下载“jnlp”文件时不会看到警告，但在从“website2.com”下载“jnlp”文件时会看到警告。\n\n即使具有此政策中为所列网域指定的文件类型扩展名，相关文件仍可能会触发并非以文件类型扩展名为依据的安全警告（例如混合内容下载警告和安全浏览警告）。\n\n如果您停用或不配置此政策，当用户下载的文件触发基于文件类型扩展名的下载警告时，系统将会向用户显示警告。\n\n如果您启用此政策：\n\n* 网址格式应遵循 https://chromeenterprise.google/policies/url-patterns/ 上的要求。\n\n* 所输入的文件类型扩展名必须采用小写 ASCII。罗列文件类型扩展名时不应添加前导分隔符，因此请输入“jnlp”而非“.jnlp”。\n\n示例：\n\n下列示例值会阻止扩展名“exe”和“jnlp”在网域“*.example.com”中触发基于文件类型扩展名的下载警告，并阻止扩展名“swf”在所有网域中触发此类警告。如果这样设置，在其他任何网域上，系统都会针对“exe”和“jnlp”文件向用户显示基于文件类型扩展名的下载警告，但不会针对“swf”文件显示此类警告。\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\n请注意，尽管上例所示设置在所有网域中都不会针对“swf”文件显示基于文件类型扩展名的下载警告，但出于安全方面的考虑，我们不建议您在所有网域中针对任何危险文件类型扩展名屏蔽此类警告。上例中之所以显示相应设置，只是为了表明这样的设置是可行的。\n\n如果此政策和 DownloadRestrictions 都已启用，且 DownloadRestrictions 设为屏蔽危险文件类型，则系统会以此政策中指定的文件类型扩展名警告豁免设置为准。此政策指定的豁免设置仅适用于 DownloadRestrictions 的值 1 和 2 所指定的“屏蔽危险文件类型”行为。\n\n例如，如果此政策指定了可从“website1.com”下载“exe”文件，同时 DownloadRestrictions 设为屏蔽恶意下载内容和危险文件类型（值 1），则从“website1.com”下载“exe”文件将不受基于文件类型扩展名的屏蔽政策的约束，但如果这些文件是恶意的，系统仍会屏蔽它们。\n\n如需详细了解 DownloadRestrictions，请访问 https://chromeenterprise.google/policies/?policy=DownloadRestrictions。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings。";
ExplicitlyAllowedNetworkPorts.pfm_title = "明确允许使用的网络端口";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - 端口 554（可在 2021 年 10 月 15 日之前解禁）\n10080 - 端口 10080（可在 2022 年 4 月 1 日之前解禁）\n6566 - 端口 6566（可在 2021 年 10 月 15 日之前解禁）\n989 - 端口 989（可在 2022 年 2 月 1 日之前解禁）\n990 - 端口 990（可在 2022 年 2 月 1 日之前解禁）\n这是 Brave 内置的受限端口列表。与这些端口的连接将失败。此设置允许绕过该列表。此政策的值应是一个逗号分隔列表，包含 0 个或多个获准进行外发连接的端口。\n\n限制端口是为了防止有人将 Brave 作为媒介来利用各种网络安全漏洞。设置此政策可能会致使您的网络遭到攻击。此政策是一种临时的变通方案，旨在应对“ERR_UNSAFE_PORT”代码类错误，以便将在被禁用的端口上运行的服务迁移到标准端口（例如端口 80 或 443）。\n\n恶意网站可轻松地检测到此政策已设置以及其中指定了哪些端口，并会使用这类信息来确定攻击目标。\n\n此处的每个端口都带有日期标签，此日期代表该端口可解禁的截止日期。该日期过后，无论此设置是怎样设定的，相应端口都会受到限制。\n\n将此政策的值留空（或不设置此政策）意味着所有受限端口都会被禁用。如果该列表既包含有效值也包含无效值，有效值会被应用。\n\n此政策会覆盖“--explicitly-allowed-ports”命令行选项。";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "无法为浏览器使用可扩展的企业单点登录的身份提供方屏蔽名单";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - 所有身份提供方\nmicrosoft - Microsoft® Cloud Identity 提供方\nokta - Okta® 云身份提供方\nping - Ping® 云身份提供方\n针对列出的身份提供方，停用通过 Extensible Enterprise SSO 实现单点登录的功能。\n\n如果您添加值 'all'，系统会停用支持的所有单点登录身份提供方。\n\n如果您添加值 'microsoft'，系统会停用 Chrome 中对 Microsoft® 云身份提供方的单点登录支持。\n\n如果您未设置此政策，系统会启用 Brave 支持的所有身份提供方。\n\n对于在 Brave 中启用并由管理员在设备上配置的身份提供方，如果用户在任何支持 Extensible Enterprise SSO 的应用中使用该身份提供方登录一次，则可以使用该身份提供方自动登录网站媒体资源。系统会针对每个身份验证事件，将与用户的身份验证信息相关的信息传输给该用户的云身份提供方。\n\n注意：\n\nBrave 不支持在无痕模式或访客模式下使用 Extensible Enterprise SSO 实现单点登录。\n\nBrave 仅支持使用 Extensible Enterprise SSO 为以下身份提供方实现单点登录：Microsoft、Okta、Ping。\n\n此功能适用于 macOS 10.15 及以上的系统。";
ExtensionAllowedTypes.pfm_title = "允许安装的扩展程序/应用的类型";
ExtensionAllowedTypes.pfm_description = "extension - 扩展程序\ntheme - 主题\nuser_script - 用户脚本\nhosted_app - 托管应用程序\nlegacy_packaged_app - 旧版封装应用\nplatform_app - 平台应用\n通过设置此政策，您可以控制可在 Brave 中安装哪些应用和扩展程序、它们可与哪些主机互动，还可以限制运行时访问。\n\n如果不设置此政策，则任何类型的扩展程序和应用都可以安装。\n\n不属于此列表中所列类型的扩展程序和应用将无法安装。每个值都应是以下某个字符串：\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\n如需详细了解这些类型，请参阅 Brave 扩展程序文档。\n\n如果某个版本属于 75 版以前的版本，并且使用以英文逗号分隔的多个扩展程序 ID，则该版本不受支持且会被跳过。此政策的其余部分仍然适用。\n\n注意：此政策还适用于要使用 ExtensionInstallForcelist 进行强制安装的扩展程序和应用。\n\n注意：此政策仅适用于支持扩展程序的平台。";
ExtensionDeveloperModeSettings.pfm_title = "控制开发者模式在扩展程序页面上的使用情况";
ExtensionDeveloperModeSettings.pfm_description = "0 - 允许在扩展程序页面上使用开发者模式\n1 - 不允许在扩展程序页面上使用开发者模式\n此政策可用来控制用户是否可以在 chrome://extensions 上开启开发者模式。\n\n如果未设置此政策，除非将 DeveloperToolsAvailability 政策设为 DeveloperToolsDisallowed (2)，否则用户可在扩展程序页面上开启开发者模式。\n如果此政策设为 Allow (0)，则用户可在扩展程序页面上开启开发者模式。\n如果此政策设为 Disallow (1)，则用户无法在扩展程序页面上开启开发者模式。\n\n如果已设置此政策，则 DeveloperToolsAvailability 将无法再控制扩展程序开发者模式。\n\n注意：此政策仅适用于支持扩展程序的平台。";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "配置源列表，以向这些源所连接的扩展程序授予更长的后台生命周期。";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "只要与端口建立了连接，与所指定的某个源相连的扩展程序就会保持运行状态。\n\n如果此政策未设置，系统将使用相应的默认值。目前已知下列应用源提供的 SDK 无法将已关闭的连接重启到关闭前的状态：\n- Smart Card Connector\n- Citrix Receiver（稳定版、Beta 版、备份）\n- VMware Horizon（稳定版、Beta 版）\n\n如果此政策已设置，系统会将新配置的值添加到默认值列表中。只要与端口建立了连接，默认值和政策提供的条目都会向连接的扩展程序授予例外资格。";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "启用由政策安装且会覆盖默认搜索引擎或“新标签页”页面设置的扩展程序";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "控制是否允许在低信任环境中启用由政策强制安装或推荐安装且会覆盖默认搜索引擎或“新标签页”页面设置的扩展程序。\n\n此政策仅适用于低信任环境（例如在本地配置政策、无网域或云管理的设备）。高信任环境不受影响：\n\n在 Microsoft® Windows® 上，此政策不适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策不适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在这些高信任实例中，由政策安装且会覆盖默认搜索引擎或“新标签页”页面设置的扩展程序将保持启用状态。\n\n如果已启用，Brave 会允许在低信任环境中安装由政策安装且会覆盖默认搜索引擎或“新标签页”页面设置的扩展程序，并保持启用状态。\n\n如果已停用或未配置，Brave 会阻止在低信任环境中安装由政策安装且会覆盖默认搜索引擎或“新标签页”页面设置的扩展程序。如已安装，则会将其移除。\n\n如果受影响的扩展程序经过更新后不再覆盖这些设置，Brave 将在 7 天内自动完成安装。\n\n这是一项暂时性政策，将在未来版本中移除。";
ExtensionInstallAllowlist.pfm_title = "要从屏蔽名单中排除的扩展程序 ID";
ExtensionInstallAllowlist.pfm_description = "通过设置此政策，您可以指定哪些扩展程序不受屏蔽名单影响。\n\n屏蔽名单值“*”表示所有扩展程序均已被屏蔽，用户只能安装许可名单中列出的扩展程序。\n\n默认情况下，所有扩展程序都是允许安装的，但如果您通过政策禁止了扩展程序，则可使用扩展程序许可列表来更改相应政策。\n\n注意：此政策仅适用于支持扩展程序的平台。";
ExtensionInstallBlocklist.pfm_title = "应禁止用户安装的扩展程序的 ID（或者用“*”表示禁止安装所有扩展程序）";
ExtensionInstallBlocklist.pfm_description = "此政策允许您指定禁止用户安装的扩展程序。已安装的扩展程序一旦被屏蔽，便会被停用，且用户无法以任何方式启用。因被列入屏蔽名单而遭停用的扩展程序，一旦从屏蔽名单中移除，便会自动重新启用。\n\n屏蔽名单值“*”表示所有扩展程序都已被默认屏蔽。被明确列入许可名单的扩展程序，只有在已签名（已打包）后方可安装。所有未打包的扩展程序都会被屏蔽。\n\n如果未设置此政策，则用户可在 Brave 中安装任一款扩展程序。\n\n注意：此政策仅适用于支持扩展程序的平台。";
ExtensionInstallForcelist.pfm_title = "要静默安装的扩展程序/应用的 ID 和更新网址";
ExtensionInstallForcelist.pfm_description = "通过设置此政策，您可以指定一个列表，列表中的应用和扩展程序无需用户互动即可静默安装，且用户无法通过 Brave 界面卸载或停用这些应用和扩展程序。相关权限由系统默认授予，其中包括对 enterprise.deviceAttributes 和 enterprise.platformKeys 扩展程序 API 的权限（这 2 个 API 不适用于非强制安装的应用和扩展程序）。\n\n尽管 Brave 努力防止用户卸载这些扩展程序，但某些操作系统会导致 Brave 无法有效阻止扩展程序遭到外部修改，因此我们只能尽力防止发生这种情况。\n\n如果未设置此政策，系统将不会自动安装任何应用或扩展程序，且用户可在 Brave 中卸载任何应用或扩展程序。\n\n此政策将会取代 ExtensionInstallBlocklist 政策。如果从此列表中移除了以前强制安装的某个应用或扩展程序，Brave 会自动卸载该应用或扩展程序。\n\n用户可通过开发者工具更改任意扩展程序的源代码，这可能会导致扩展程序无法正常运行。如果您担心发生此种情况，请设置 DeveloperToolsDisabled 政策。\n\n此政策的每个列表项都是一个字符串，其中包含一个扩展程序 ID 和一个可选的更新网址（两者之间以英文分号“;”分隔）。扩展程序 ID 是一个由 32 个字母构成的字符串；若想查找该字符串，可在开发者模式下访问 chrome://extensions。如果指定了更新网址，则该网址应指向一个更新清单 XML 文档 (https://developer.chrome.com/extensions/autoupdate)。更新网址应使用以下某个 scheme：http、https 或 file。默认情况下，系统会使用 Chrome 应用商店的更新网址。此政策中设置的更新网址仅用于初次安装；扩展程序的后续更新将会使用扩展程序清单中的更新网址。后续更新所用的更新网址可通过 ExtensionSettings 政策覆盖，详见 http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy。\n\n仅当 Microsoft® Windows® 实例已加入 Microsoft® Active Directory® 网域、已加入 Microsoft® Azure® Active Directory®，或已在 Chrome Enterprise Core中注册时，才能在该实例上强制安装 Chrome 应用商店以外的应用和扩展程序。\n\n仅当 macOS 实例通过 MDM 进行管理、已通过 MCX 加入网域，或已在 Chrome Enterprise Core中注册时，才能在该实例上强制安装 Chrome 应用商店以外的应用和扩展程序。\n\n注意：此政策不适用于无痕模式。如需了解如何托管扩展程序，请访问 https://developer.chrome.com/extensions/hosting。\n\n注意：此政策仅适用于支持扩展程序的平台。";
ExtensionInstallSources.pfm_title = "允许的扩展程序、应用和用户脚本安装源的网址格式";
ExtensionInstallSources.pfm_description = "通过设置此政策，您可以指定哪些网址可安装扩展程序、应用和主题背景。Brave 21 版问世前，用户可以点击指向 *.crx 文件的链接，Brave 虽然会显示一些警告，但仍会让用户安装该文件。但从 21 版开始，用户必须下载此类文件，并将其拖到 Brave 的设置页面中。此设置可允许特定网址采用较简便的旧安装流程。\n\n此列表中的每一项都是一种扩展程序样式的匹配模式，详见 https://developer.chrome.com/extensions/match_patterns。只要扩展程序的网址与此列表中的项匹配，用户便可轻松安装此扩展程序。*.crx 文件的位置和下载来源网页（引荐来源网址）都必须与此列表中的模式相符。\n\nExtensionInstallBlocklist 的优先级高于此政策。也就是说，如果某个扩展程序被列入了屏蔽名单，即使其来源网站在此列表中，用户也无法安装该扩展程序。\n\n注意：此政策仅适用于支持扩展程序的平台。";
ExtensionInstallTypeBlocklist.pfm_title = "扩展程序安装类型的屏蔽名单";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - 禁止从命令行加载扩展程序\n屏蔽名单用于控制不允许的扩展程序安装类型。\n\n设置“command_line”将禁止从命令行加载扩展程序。";
ExtensionReviewPromptsEnabled.pfm_title = "控制扩展程序评价提示和评分链接";
ExtensionReviewPromptsEnabled.pfm_description = "控制是否在 Chrome 界面中显示已安装 Chrome 扩展程序的原生评价提示和评分链接（例如“为其评分”）。\n\n如果此政策已启用或未设置，用户可能会在工具栏、上下文菜单和扩展程序管理页面 (chrome://extensions) 中看到原生入口点，以便评价符合条件的扩展程序并为其评分。\n\n如果此政策已停用，系统会屏蔽所有原生评价提示和评分链接，使其无法使用。";
ExtensionSettings.pfm_title = "扩展程序管理设置";
ExtensionSettings.pfm_description = "通过设置此政策，您可以控制 Brave 的扩展程序管理设置，其中包括由现有的扩展程序相关政策控制的设置。\n\n此政策仅会将某个扩展程序 ID 或某个更新网址映射至其对应的特定设置。您可为特殊 ID\"*\"设定默认配置，该配置会应用于未在此政策中设定自定义配置的所有扩展程序。\n\n此政策可以覆盖旧版政策中针对各扩展程序的配置。\n\n请注意，来自 ExtensionInstallForcelist、ExtensionInstallAllowlist、ExtensionInstallBlocklist 或 ExtensionSettings 的任何按 ID 配置的扩展程序设置都只会从 \"*\" 默认设置继承“installation_mode”和“update_url”。它不会继承任何其他属性。对于更新网址，相应配置会应用于具有在扩展程序清单 (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy) 中注明的确切更新网址的扩展程序。如果“override_update_url”flag 设为 true，系统会根据 ExtensionInstallForcelist 政策中或此政策的“update_url”字段中指定的“更新”网址安装并更新扩展程序。如果“update_url”是 Chrome 应用商店网址，“override_update_url”flag 会被忽略。\n\n从 Brave 版本 154 开始，如果将“runtime_blocked_hosts”应用于具有“debugger”权限的扩展程序，系统会在所有目标上完全停用“chrome.debugger.attach()”。\n\n只有当 Microsoft® Windows® 实例已加入 Microsoft® Active Directory® 网域、已加入 Microsoft® Azure® Active Directory® 或已注册 Chrome Enterprise Core时，才能在该实例上强制安装并非来自 Chrome 应用商店的应用和扩展程序。\n\n只有当 macOS 实例是通过 MDM 进行管理、已通过 MCX 加入网域或已注册 Chrome Enterprise Core时，才能在该实例上强制安装并非来自 Chrome 应用商店的应用和扩展程序。\n\n注意：此政策仅适用于支持扩展程序的平台。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=ExtensionSettings。";
ExtensionUnpublishedAvailability.pfm_title = "控制能否使用 Chrome 应用商店中处于未发布状态的扩展程序。";
ExtensionUnpublishedAvailability.pfm_description = "0 - 允许使用处于未发布状态的扩展程序\n1 - 停用处于未发布状态的扩展程序\n如果此政策已启用，系统会在 Brave 中停用 Chrome 应用商店中处于未发布状态的扩展程序。\n此政策仅适用于那些通过 Chrome 应用商店安装和更新的扩展程序。\n\n系统会忽略并非通过 Chrome 应用商店安装的扩展程序，例如：使用开发者模式安装的未打包扩展程序，以及使用命令行开关安装的扩展程序。\n系统还会忽略自主托管的强制安装扩展程序。所有已被固定了版本的扩展程序也会被忽略。\n\n如果此政策设为 AllowUnpublished (0) 或未设置，系统将允许使用 Chrome 应用商店中处于未发布状态的扩展程序。\n如果此政策设为 DisableUnpublished (1)，系统将停用 Chrome 应用商店中处于未发布状态的扩展程序。";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "在外部协议对话框中显示“始终打开”复选框。";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "此政策用于控制在出现外部协议启动确认提示时是否显示“始终打开”复选框。\n\n     如果您将此政策设为 true 或不设置此政策，当系统显示外部协议确认提示时，用户可选择“始终打开”，以跳过系统未来会在此网站中显示的所有针对该协议的确认提示。\n\n     如果您将此政策设为 false，系统将不会显示“始终打开”复选框，并且在每次调用外部协议时都会提示用户。";
FeedbackSurveysEnabled.pfm_title = "指定是否向用户显示产品内 Brave 调查问卷。";
FeedbackSurveysEnabled.pfm_description = "Brave 产品内调查问卷用于收集用户对浏览器的反馈。调查问卷回复不与用户账号关联。\n如果已启用或未设置此政策，系统可能会向用户显示产品内调查问卷。\n如果已停用此政策，系统将不会向用户显示产品内调查问卷。\n\n如果已停用 MetricsReportingEnabled（这也会停用产品内调查问卷），此政策不会产生任何效力。";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "浏览器关闭时的 Fetch keepalive 时长";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "控制在浏览器关闭时系统对 keepalive 请求的处理时长（以秒为单位）。\n\n如果您指定了此政策，系统在关闭浏览器时便可延迟所设秒数之久，以处理 keepalive (https://fetch.spec.whatwg.org/#request-keepalive-flag) 请求。\n\n默认值 (0) 表示此功能已停用。";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "允许在不使用以往用户手势的情况下调用文件或目录选择器 API";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "出于安全考虑，调用 showOpenFilePicker()、showSaveFilePicker() 和 showDirectoryPicker() Web API 前需要用户先执行一个手势（“暂时性激活”），否则调用将会失败。\n\n如果已设置此政策，管理员可以指定哪些源可以直接调用这些 API，而不需要用户先执行一个手势。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns/。“*”不是此政策可接受的值。\n\n如果未设置此政策，所有源在调用这些 API 前，都需要用户先执行一个手势。";
FileSystemReadAskForUrls.pfm_title = "允许在这些网站上通过 File System API 读取内容";
FileSystemReadAskForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址格式，从而指定哪些网站可以通过 File System API 请求用户授予对主机操作系统的文件系统中文件或目录的读取权限。\n\n未设置此政策时，如果已设置 DefaultFileSystemReadGuardSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n网址格式不得与 FileSystemReadBlockedForUrls 冲突。如果某个网址与这两项政策都相符，系统将不会优先应用任一项政策。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
FileSystemReadBlockedForUrls.pfm_title = "禁止在这些网站上通过 File System API 读取内容";
FileSystemReadBlockedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，用于指定哪些网站无法通过 File System API 请求用户授权其读取主机操作系统的文件系统中的文件或目录。\n\n未设置此政策时，如果 DefaultFileSystemReadGuardSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n网址格式不能与 FileSystemReadAskForUrls 冲突。如果某个网址与这两项政策都相符，系统将不会优先应用任一项政策。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
FileSystemWriteAskForUrls.pfm_title = "允许在这些网站上向文件和目录写入内容";
FileSystemWriteAskForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址格式，从而指定哪些网站可以请求用户授予对主机操作系统的文件系统中文件或目录的写入权限。\n\n未设置此政策时，如果已设置 DefaultFileSystemWriteGuardSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n网址格式不得与 FileSystemWriteBlockedForUrls 冲突。如果某个网址与这两项政策都相符，系统将不会优先应用任一项政策。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
FileSystemWriteBlockedForUrls.pfm_title = "禁止在这些网站上向文件和目录写入内容";
FileSystemWriteBlockedForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址格式，从而指定哪些网站无法请求用户授予对主机操作系统的文件系统中文件或目录的写入权限。\n\n未设置此政策时，如果已设置 DefaultFileSystemWriteGuardSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n网址格式不能与 FileSystemWriteAskForUrls 冲突。如果某个网址与这两项政策都相符，系统将不会优先应用任一项政策。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
ForceEphemeralProfiles.pfm_title = "临时个人资料";
ForceEphemeralProfiles.pfm_description = "如果您启用了此政策，它会将个人资料强制切换到暂存模式。如果您将此政策指定为操作系统政策（例如 Windows 中的 GPO），它将应用于系统中的所有个人资料；如果您将此政策设为云政策，它将仅应用于使用受管理的账号登录的个人资料。\n\n在这种模式下，只有在用户会话期间个人资料数据才会保留在磁盘上。关闭浏览器后，浏览器历史记录等内容、扩展程序及其数据、网络数据（例如 Cookie）和网络数据库全都不会保留下来。不过，用户仍可以手动将任何数据下载到磁盘中、保存网页或打印网页。\n\n如果用户已启用同步功能，所有这些数据都会保留在其同步个人资料中，就像常规个人资料一样。如果此政策并未明确停用隐身模式，那么用户还可以使用隐身模式。\n\n如果此政策设为停用或未设置，用户登录时系统会使用常规个人资料。";
ForceForegroundPriorityForAllTabs.pfm_title = "强制将所有标签页设为前台优先级";
ForceForegroundPriorityForAllTabs.pfm_description = "此政策用于控制是否强制以前台优先级运行后台 Web 内容。\n\n默认情况下，浏览器会降低后台标签页中内容的优先级，以此优化资源利用。启用此政策会覆盖以上行为，导致后台标签页的调度方式与活动标签页相同。\n\n请注意，强制以前台优先级运行后台内容，可能会略微影响活动标签页的响应速度。\n\n如果启用此政策，所有 Web 内容都将以前台优先级运行，无论是否在前台显示。\n\n如果停用或不设置此政策，浏览器会根据标准启发法来确定优先级。例如，降低不可见、不播放音频、不参与视频通话的内容的优先级。";
ForceForegroundPriorityForUrls.pfm_title = "对特定网址强制执行前台优先级";
ForceForegroundPriorityForUrls.pfm_description = "此政策允许您指定一个网址格式列表。匹配这些格式的后台 Web 内容将强制以前台优先级运行。\n\n如果启用了 ForceForegroundPriorityForAllTabs 政策，系统会忽略此列表，因为所有标签页都将强制以前台优先级运行。\n\n如果已停用或未设置 ForceForegroundPriorityForAllTabs，仅当内容与此列表中的格式匹配时，才会强制以前台优先级运行。\n\n如需详细了解有效的URL格式，请访问 https://support.google.com/chrome/a?p=url_blocklist_filter_format。\n\n如果此列表为空或未设置，系统不会强制任何后台内容以前台优先级运行。";
ForceGoogleSafeSearch.pfm_title = "强制启用 Google 安全搜索功能";
ForceGoogleSafeSearch.pfm_description = "如果此政策已启用，Google 搜索中的安全搜索功能将始终处于启用状态，并且用户无法更改此设置。\n\n如果此政策已停用或未设置，系统将不会在 Google 搜索中强制启用安全搜索功能。";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "控制是否可以停用 unload 事件处理脚本。";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "unload 事件处理脚本即将被弃用。这类脚本是否会触发取决于 unload Permissions-Policy。目前，政策默认允许触发，但后续会逐步更改为默认禁止触发，而且网站必须使用 Permissions-Policy 标头明确启用此类脚本。这项企业政策可用于将默认设置强制保留为启用状态，这样就可以避免脚本被逐步弃用。\n\n网页可能会依赖 unload 事件处理脚本，以便保存数据或向服务器发出用户会话结束的信号。我们不建议采用这种做法，因为这样做不可靠，并且会因禁止使用 BackForwardCache 而影响性能。尽管有推荐使用的替代方案，但 unload 事件已经使用了很久，有些应用可能仍会依赖这类事件。\n\n如果此政策设为 false 或未设置，那么 unload 事件处理脚本会根据弃用安排被逐步弃用，而且未设置 Permissions-Policy 标头的网站将停止触发“unload”事件。\n\n如果此政策设为 true，unload 事件处理脚本将默认继续正常运行。\n\n注意：在 M117 中，此政策的默认值被错误地记录成了“true”。unload 事件在 M117 中未发生变化，而且日后也不会改变，所以此政策在该版本中没有任何影响。\n";
ForceYouTubeRestrict.pfm_title = "强制启用最低级别的 YouTube 受限模式";
ForceYouTubeRestrict.pfm_description = "0 - 不强制启用 YouTube 受限模式\n1 - 至少强制启用 YouTube“中等”受限模式\n2 - 强制启用 YouTube“严格”受限模式\n通过设置此政策，您可以强制启用最低级别的 YouTube 受限模式，并禁止用户选择限制条件更加宽松的模式。如果此政策设为：\n\n*“严格”- YouTube“严格”受限模式将始终处于启用状态。\n\n*“中等”- 用户只能选择启用 YouTube“中等”受限模式或“严格”受限模式，但无法关闭受限模式。\n\n*“关闭”或未设置值 - Chrome 不会强制启用 YouTube 受限模式。但是，外部政策（例如 YouTube 政策）仍有可能会强制启用受限模式。";
ForcedLanguages.pfm_title = "配置首选语言的内容和顺序";
ForcedLanguages.pfm_description = "此政策让管理员能够在 Brave 设置中以列表形式配置首选语言的顺序。\n\n该列表将按同样的顺序显示在 chrome://settings/languages 页面内的“根据您的偏好设置对语言进行排序”部分中。用户将无法移除或重新排列此政策设定的语言，但能在这些语言下方添加语言。此外，用户还能完全控制浏览器的界面语言和翻译/拼写检查设置，除非其他政策已强制执行这些设置。\n\n如果此政策未设置，用户便可操控整个首选语言列表。";
GeminiActOnWebAllowedForURLs.pfm_title = "允许 Gemini 应用集成功能直接对指定网站执行操作";
GeminiActOnWebAllowedForURLs.pfm_description = "允许设置网址格式清单，指定 Gemini 应用集成功能可以直接对哪些网站的网页执行操作。\n\n如果网址既不符合许可清单也不符合屏蔽清单，系统会使用 GeminiActOnWebSettings。\n\n如果网址同时符合许可清单和屏蔽清单，则允许 Gemini 应用集成功能执行操作。\n\n如需详细了解有效网址格式，请访问 https://support.google.com/chrome/a?p=url_blocklist_filter_format。";
GeminiActOnWebBlockedForURLs.pfm_title = "禁止 Gemini 应用集成功能直接对指定网站执行操作";
GeminiActOnWebBlockedForURLs.pfm_description = "允许设置网址格式清单，指定 Gemini 应用集成功能无法直接对哪些网站的网页执行操作。\n\n如果网址既不符合许可清单也不符合屏蔽清单，系统会使用 GeminiActOnWebSettings。\n\n如果网址同时符合许可清单和屏蔽清单，则允许 Gemini 应用集成功能执行操作。\n\n如需详细了解有效网址格式，请访问 https://support.google.com/chrome/a?p=url_blocklist_filter_format。";
GeminiActOnWebSettings.pfm_title = "允许 Gemini 应用集成功能直接对网页执行操作";
GeminiActOnWebSettings.pfm_description = "0 - 允许 Gemini 应用在网页上执行操作。\n1 - 禁止 Gemini 应用在网页上执行操作。\n控制 Gemini 应用是否可以代表用户在网页上执行操作。\n\n0/未设置 = Gemini 应用可以在网页上执行操作。\n\n1 = Gemini 应用不得在网页上执行操作。\n\n如果 Gemini 应用已停用，此政策将不会产生任何影响。例如，可通过 GeminiSettings 政策停用 Gemini 应用。\n\n如需详细了解 Chrome 中的 Gemini，请访问 https://support.google.com/chrome/a/answer/16291696。\n\nGemini 只能在部分国家/地区启用，并且仅支持部分语言。设置此政策并不能保证该功能会启用，仍需取决于实际可用情况。如需详细了解推出情况，请查看企业版版本说明：https://support.google.com/chrome/a/answer/7679408?hl=en";
GeminiSettings.pfm_title = "Gemini 集成的设置";
GeminiSettings.pfm_description = "0 - 允许集成 Gemini。\n1 - 不允许集成 Gemini。\n此设置会控制 Gemini 应用集成。\n\n0 = 用户可以使用 Gemini 集成功能。\n\n1 = 用户将无法使用 Gemini 集成功能。\n\n如果未设置此政策，其行为将由“GenAiDefaultSettings”政策决定。\n\n如需了解详情，请参阅帮助中心文章 https://support.google.com/chrome/a?p=gemini_in_chrome。";
GeminiSparkSettings.pfm_title = "允许 Gemini Spark 连接到 Brave 并通过 Chrome 中的 Gemini 使用自动浏览功能";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark 可以连接到 Brave 并使用自动浏览功能。\n1 - 不允许 Gemini Spark 连接到 Brave 或使用自动浏览功能。\n控制是否允许 Gemini Spark 智能体连接到 Brave 并使用自动浏览功能。您的组织可能无法使用 Gemini Spark。\n\n0 = 允许 Gemini Spark 连接到 Brave 并使用自动浏览功能\n\n1 = 不允许 Gemini Spark 连接到 Brave 或使用自动浏览功能\n\n警告：如果允许 Gemini Spark 连接到 Brave 并使用自动浏览功能，Gemini Spark 智能体将能够使用活跃的浏览器会话在 Brave 客户端上执行自主的多步操作。这涉及重大的安全风险，包括凭证风险、本地网络入站以及情境感知信号的丢失。现有的管理和安全控制措施可能无法得到遵守。\n\n建议管理员在启用此功能之前，仔细评估组织的网络威胁模型、合规性和隐私权准则。\n\n如果 Google Gemini 应用或 Brave 自动浏览政策已停用，则此政策不会生效。例如，可通过 GeminiSettings 政策停用 Google Gemini 应用。如需详细了解 Brave 中的 Google Gemini，请访问 https://support.google.com/chrome/a?p=gemini_in_chrome。\n\nBrave 自动浏览和 Gemini Spark 仅在部分国家/地区推出，且仅支持部分语言。将此政策设为 0（即已启用）并不能保证该功能一定会生效；其启用情况仍取决于实际的可用性。如需详细了解推出情况，请查看企业版版本说明：https://chromeenterprise.google/resources/release-notes/。";
GenAILocalFoundationalModelSettings.pfm_title = "生成式 AI 本地基础模型的设置";
GenAILocalFoundationalModelSettings.pfm_description = "0 - 自动下载模型\n1 - 不下载模型\n配置 Brave 如何下载基础生成式 AI 模型并在本地用于推理。\n\n如果此政策设为“允许”（即值为 0）或未设置，系统会自动下载模型，并将其用于推理。\n\n如果此政策设为“停用”（即值为 1），系统将不会下载模型，并且会删除现有模型（如果已下载）。\n\n在桌面平台上，也可以通过将 ComponentUpdatesEnabled 设置为 false 来禁止下载模型。";
GeolocationBlockedForUrls.pfm_title = "禁止这些网站访问地理定位信息";
GeolocationBlockedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，从而指定哪些网站不得访问用户的地理定位信息且无法请求用户授予相应权限。\n\n如果您未设置此政策，那么，倘若 DefaultGeolocationSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "启用全局范围的 HTTP 身份验证缓存";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "通过此政策，您可以使用 HTTP 服务器身份验证凭证为每份个人资料配置一个全局性的缓存文件。\n\n如果此政策未设置或已停用，浏览器将会使用跨网站身份验证机制的默认行为（即根据顶级网站来界定 HTTP 服务器身份验证凭证的适用范围），因此如果两个网站使用的资源是来自同一个要求进行身份验证的网域，则需在这两个网站中分别提供凭证。系统会跨网站重复使用缓存的代理凭证。\n\n如果此政策已启用，系统会自动将在一个网站中输入的 HTTP 身份验证凭证用于另一个网站。\n\n启用此政策会导致网站容易受到某些类型的跨网站攻击，并允许使用网址内嵌的凭证向 HTTP 身份验证缓存文件添加条目，让攻击者能够对用户进行跨网站跟踪（甚至是在不使用 Cookie 的情况下）。\n\n此政策旨在让依靠旧版行为的企业能够更新其登录流程，日后将会移除。";
GoogleSearchSidePanelEnabled.pfm_title = "启用“Google Search Side Panel”政策";
GoogleSearchSidePanelEnabled.pfm_description = "如果已启用或未设置“Google Search Side Panel”政策，系统会允许在所有网页上使用此政策。\n\n如果已停用“Google Search Side Panel”政策，所有网页上都无法使用此政策。\n\n此功能中的 GenAI 功能不适用于教育版账号或企业账号。";
HSTSPolicyBypassList.pfm_title = "以列表形式指定：哪些名称将绕过 HSTS 政策检查";
HSTSPolicyBypassList.pfm_description = "通过设置此政策，您可以指定一系列可绕过预加载的 HSTS 升级（从 HTTP 升级到 HTTPS）的主机名。\n\n此政策只能使用单标签主机名，并且仅适用于预加载了 HSTS 的“静态”条目（例如，\"app\", \"new\", \"search\", \"play\"）。对于已使用 Strict-Transport-Security 响应标头“动态地”请求 HSTS 升级的服务器，此政策不会阻止它们进行 HSTS 升级。\n\n必须将所提供的主机名规范化：任何 IDN 都必须转换为对应的 A 标签格式，而且所有 ASCII 字母都必须小写。此政策仅适用于指定的特定单标签主机名，不适用于这些名称的子网域。";
HappyEyeballsV3Enabled.pfm_title = "使用 Happy Eyeballs V3 算法";
HappyEyeballsV3Enabled.pfm_description = "此功能可让 Happy Eyeballs V3 算法进行连接尝试。如需了解详情，请访问 https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3。\n\n如果已启用此政策，Brave 将使用 Happy Eyeballs V3 算法进行连接尝试。\n\n如果已停用此政策，系统会关闭 Happy Eyeballs V3 算法。\n\n如果未设置此政策，Brave 将根据 chrome://flags/#happy-eyeballs-v3 开启或关闭 Happy Eyeballs V3 算法。\n\n此政策支持动态刷新。\n\n此政策只是一项暂时性措施，会从 Brave 的未来版本中移除。";
HardwareAccelerationModeEnabled.pfm_title = "使用图形加速功能（如果可用）";
HardwareAccelerationModeEnabled.pfm_description = "如果此政策已启用或未设置，系统会开启图形加速功能（如果可用）。\n\n如果此政策已停用，系统会关闭图形加速功能。";
HeadlessMode.pfm_title = "控制对无头模式的使用权限";
HeadlessMode.pfm_description = "1 - 允许使用无头模式\n2 - 不允许使用无头模式\n如果此政策设为 Enabled 或未设置，即意味着允许使用无头模式。如果此政策设为 Disabled，则意味着禁止使用无头模式。";
HelpMeWriteSettings.pfm_title = "“帮我写”的相关设置";
HelpMeWriteSettings.pfm_description = "0 - 允许使用“帮我写”功能并改进 AI 模型。\n1 - 允许使用“帮我写”功能，但不改进 AI 模型。\n2 - 不允许使用“帮我写”功能。\n“帮我写”是一款基于 AI 的写作助手，适用于在网上创作简短内容。系统会根据用户输入的提示以及网页内容提供建议的内容。\n\n0 表示允许使用此功能，同时允许 Google 使用相关数据改进其 AI 模型。相关数据可能包括提示、输入、输出、来源资料和书面反馈，具体取决于相应功能。工作人员也可能会审核这些数据，以改进 AI 模型。除非下文另有说明，否则默认值是 0。\n\n1 表示允许使用此功能，但不允许 Google 使用用户内容（包括提示、输入、输出、来源资料和书面反馈）改进模型。对于受 Google Admin console管理的企业用户和受 Google Workspace 管理的教育版账号，默认值是 1。\n\n2 表示不允许使用此功能。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
HideWebStoreIcon.pfm_title = "在“打开新的标签页”页面和应用启动器中不显示网上应用店";
HideWebStoreIcon.pfm_description = "在“打开新的标签页”页面和 Google Chrome OS应用启动器中不显示“Chrome 应用商店”应用和页脚链接。\n\n此政策设为 true 时，相应的图标会隐藏起来。\n\n此政策设为 false 或未配置时，相应的图标会显示出来。";
HighEfficiencyModeEnabled.pfm_title = "启用高效模式";
HighEfficiencyModeEnabled.pfm_description = "此政策用于启用或停用“高效模式”设置。如果启用了该设置，系统会在一段时间后在后台舍弃标签页以回收内存。\n如果此政策未设置，最终用户可在 chrome://settings/performance 上控制该设置。\n";
HistoryClustersVisible.pfm_title = "显示以网页分组的“Chrome 历史记录”视图";
HistoryClustersVisible.pfm_description = "此政策用于控制是否以网页分组的方式显示“Chrome 历史记录”页面。\n\n如果已启用此政策，chrome://history/grouped 中会以网页分组的方式显示“Chrome 历史记录”页面。\n\n如果已停用此政策，chrome://history/grouped 中不会以网页分组的方式显示“Chrome 历史记录”页面。\n\n如果未设置此政策，默认情况下，chrome://history/grouped 中会以网页分组的方式显示“Chrome 历史记录”页面。\n\n请注意，如果已停用 ComponentUpdatesEnabled 政策，但已启用或未设置 HistoryClustersVisible，chrome://history/grouped 中仍然会以网页分组的方式显示“Chrome 历史记录”页面，但与用户的相关程度可能会变低。\n";
HistorySearchSettings.pfm_title = "AI 赋能的历史记录搜索功能的设置";
HistorySearchSettings.pfm_description = "0 - 允许使用“AI 历史记录搜索”功能并改进 AI 模型。\n1 - 允许使用“AI 历史记录搜索”功能，但不改进 AI 模型。\n2 - 不允许使用“AI 历史记录搜索”功能。\n“AI 历史记录搜索”功能可让用户根据网页内容（而不仅仅是网页标题和网址）搜索其浏览记录，并获得生成的答案。\n\n0 表示允许使用此功能，同时允许 Google 使用相关数据改进其 AI 模型。相关数据可能包括提示、输入、输出、来源资料和书面反馈，具体取决于相应功能。工作人员也可能会审核这些数据，以改进 AI 模型。除非下文另有说明，否则默认值是 0。\n\n1 表示允许使用此功能，但不允许 Google 使用用户内容（包括提示、输入、输出、来源资料和书面反馈）改进模型。对于受 Google Admin console管理的企业用户和受 Google Workspace 管理的教育版账号，默认值是 1。\n\n2 表示不允许使用此功能。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
HomepageIsNewTabPage.pfm_title = "使用“新标签页”作为主页";
HomepageIsNewTabPage.pfm_description = "如果已启用此政策，系统会使用“新标签页”页面作为用户的主页，并忽略所有主页网址位置。如果已停用此政策，系统绝不会使用“新标签页”页面作为用户的主页，除非用户将主页网址设为 chrome://newtab。\n\n如果您设置了此政策，用户将无法更改 Brave 中的主页类型。如果未设置此政策，用户便可自行决定是否使用“新标签页”页面作为主页。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
HomepageLocation.pfm_title = "主页网址";
HomepageLocation.pfm_description = "通过设置此政策，您可以配置 Brave 中的默认主页网址。您可以使用“主页”按钮打开主页。在桌面设备上，RestoreOnStartup 政策控制哪些页面会在 Chrome 启动时打开。\n\n如果用户或 HomepageIsNewTabPage 将主页设为“新标签页”页面，此政策不会产生任何影响。\n\n此网址必须是采用标准架构的网址，例如 http://example.com 或 https://example.com。如果您已设置此政策，用户将无法在 Brave 中更改主页网址。\n\n如果 HomepageLocation 和 HomepageIsNewTabPage 均未设置，用户便可自行选择主页。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
HttpAllowlist.pfm_title = "HTTP 许可名单";
HttpAllowlist.pfm_description = "通过设置此政策，您能以列表形式指定：在启用了 HTTPS-First 模式的情况下，哪些主机名或主机名格式（例如“[*.]example.com”）不会升级到 HTTPS 且不会显示错误插页。组织可以使用此政策保留对不支持 HTTPS 的服务器的访问权限，而无需停用 HTTPS 升级和/或 HTTPS-First 模式。\n\n必须将所提供的主机名规范化：任何 IDN 都必须转换为对应的 A 标签格式，而且所有 ASCII 字母都必须小写。\n\n不允许使用一揽子主机通配符（例如“*”或“[*]”），而应通过各自的具体政策明确停用 HTTPS-First 模式和 HTTPS 升级。\n\n注意：此政策不适用于 HSTS 升级。";
HttpHeaderInjection.pfm_title = "为特定网址格式配置 HTTP 标头注入";
HttpHeaderInjection.pfm_description = "此政策支持定义一系列规则，以便将自定义 HTTP 标头注入与特定网址格式匹配的 Web 请求中。此政策设置的标头优先于请求中最初存在的标头，以及用户或扩展程序尝试进行的修改。\n\n此政策的常见使用场景是通过注入自定义标头（例如 X-Tenant-ID）来强制执行租户访问权限控制。\n\n此政策接受规则列表。每条规则都包含：\n\n* patterns：要匹配的网址格式列表。了解如何设置网址格式 (https://support.google.com/chrome/a?p=url_blocklist_filter_format)。\n\n* headers：表示要注入的标头的对象列表，每个对象包含：\n\n* name：要注入的标头的名称。\n\n* value：要注入的标头的值。\n\n如果有多条规则与请求匹配，系统将应用所有匹配规则中的标头。如果多个标头同名，系统将应用网址格式最具体的标头。如果网址格式的具体程度相同，系统将应用列表中最后出现的标头。\n\n标头名称必须符合 RFC 2616 (https://www.rfc-editor.org/rfc/rfc2616)。标头值不得包含 NUL、CR 或 LF 符号。单个标头的大小不得超过 8KB。系统会忽略无效的标头和网址格式。\n\n此政策中所有规则的网址格式总数限制为 500 个。每条规则最多可包含 20 个标头。超出这些阈值的网址格式和标头将被忽略。\n\n注意：如果网址格式匹配未加密的协议（http://、ws://）或省略了协议，则所配置的标头可能会以明文形式通过未加密的通道传输，并可能暴露给网络观察者。为了保护敏感或可识别身份的标头值，请将网址格式限定为仅使用加密协议（https:// 或 wss://）。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=HttpHeaderInjection。";
HttpsOnlyMode.pfm_title = "允许启用纯 HTTPS 模式";
HttpsOnlyMode.pfm_description = "allowed - 不限制用户的 HTTPS-Only 模式设置\ndisallowed - 停用 HTTPS-Only 模式\nforce_enabled - 在严格模式下启用 HTTPS-Only 模式\nforce_balanced_enabled - 在平衡模式下启用 HTTPS-Only 模式\n此政策用于控制用户能否在“设置”中启用 HTTPS-Only 模式（即“一律使用安全连接”）。HTTPS-Only 模式会将所有导航路径升级到 HTTPS。\n\n如果此设置设为“allowed”或未配置，用户将能启用 HTTPS-Only 模式。\n如果此设置设为“disallowed”，系统会停用 HTTPS-Only 模式。\n\n如果此设置设为“force_enabled”，系统将会在严格模式下启用 HTTPS-Only 模式。\n\n如果此设置设为“force_balanced_enabled”，系统将会在平衡模式下启用 HTTPS-Only 模式。\n\n系统从 M112 开始支持“force_enabled”，从 M129 开始支持“force_balanced_enabled”。\n\n也可以向用户推荐“force_enabled”和“force_balanced_enabled”。\nHTTPS-Only 模式最初会设置为“严格”或“平衡”，但用户可以更改此设置。\n\n如果接收此政策的 Chrome 版本不支持您为此政策设置的值，Chrome 将默认采用允许的设置。\n\n单独的 HttpAllowlist 政策可用于豁免特定主机名或主机名格式，使其不会被该功能升级到 HTTPS。";
HttpsUpgradesEnabled.pfm_title = "启用自动 HTTPS 升级";
HttpsUpgradesEnabled.pfm_description = "Brave 会尽可能尝试将某些导航从 HTTP 升级到 HTTPS。此政策可用于停止该行为。如果此政策设为“true”或未设置，系统会默认启用该功能。\n\n单独的 HttpAllowlist 政策可用于豁免特定主机名或主机名格式，使其不会被该功能升级到 HTTPS。\n\n另请参阅 HttpsOnlyMode 政策。";
IPv6ReachabilityOverrideEnabled.pfm_title = "启用 IPv6 可达性检查覆盖";
IPv6ReachabilityOverrideEnabled.pfm_description = "如果此政策设为 true，系统会覆盖 IPv6 可达性检查。这意味着在解析主机名时，系统始终会查询 AAAA 记录。此设置适用于相应设备上的所有用户和所有界面。\n\n如果此政策设为 false 或未设置，IPv6 可达性检查不会被覆盖。\n仅当设备可连接到全局 IPv6 主机时，系统才会查询 AAAA 记录。";
IdleDetectionAllowedForUrls.pfm_title = "已允许检测空闲状态的网站";
IdleDetectionAllowedForUrls.pfm_description = "此政策允许您设置一个网址格式列表，用于指定哪些网站无需询问用户意见即可使用 Idle Detection API。屏蔽清单条目的优先级高于许可清单条目，而许可清单条目的优先级高于配置的默认值。\n\n如需详细了解有效的网站网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。此政策只能根据源进行匹配，因此网址格式中的任何路径都会被忽略。\n\n未设置此政策时，如果 DefaultIdleDetectionSetting（默认空闲检测设置）政策已设置，系统便会据此对所有网站使用全局默认值，否则会根据用户个人配置对所有网站使用全局默认值。";
IdleDetectionBlockedForUrls.pfm_title = "已禁止检测空闲状态的网站";
IdleDetectionBlockedForUrls.pfm_description = "此政策允许您设置一个网址格式列表，用于指定不允许哪些网站使用 Idle Detection API。\n\n如需详细了解有效的网站网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。此政策只能根据源进行匹配，因此网址格式中的任何路径都会被忽略。\n\n未设置此政策时，如果 DefaultIdleDetectionSetting（默认空闲检测设置）政策已设置，系统便会据此对所有网站使用全局默认值，否则会根据用户个人配置对所有网站使用全局默认值。";
IdleTimeout.pfm_title = "运行闲置操作前的延迟时间";
IdleTimeout.pfm_description = "在计算机处于闲置状态时触发操作。\n\n设置此政策后，只要设备处于闲置状态（未发生用户输入）的时长达到此处指定的时长（以分钟为单位），浏览器就会运行 IdleTimeoutActions 政策中配置的操作。\n\n如果未设置此政策，系统将不会运行任何操作。\n\n最低阈值为 1 分钟。\n\n“用户输入”由操作系统 API 定义，包括移动鼠标或使用键盘输入内容等操作。";
IdleTimeoutActions.pfm_title = "在计算机处于闲置状态时要运行的操作";
IdleTimeoutActions.pfm_description = "close_browsers - 关闭浏览器\nshow_profile_picker - 显示个人资料选择器\nclear_browsing_history - 清除浏览记录\nclear_download_history - 清除下载记录\nclear_cookies_and_other_site_data - 清除 Cookie 和其他网站数据\nclear_cached_images_and_files - 清除缓存的图片和文件\nclear_password_signin - 清除密码登录信息\nclear_autofill - 清除自动填充数据\nclear_site_settings - 清除网站设置\nclear_hosted_app_data - 清除托管的应用数据\nreload_pages - 重新加载页面\nsign_out - 退出\nclose_tabs - 关闭标签页\n在达到 IdleTimeout 政策所设的超时时限后要运行的一系列操作。\n\n警告：设置此政策可能会影响并永久移除本地个人数据。建议您在部署之前测试设置，以免意外删除个人数据。\n\n如果 IdleTimeout 政策未设置，此政策将不会产生任何影响。\n\n达到 IdleTimeout 政策所设的超时时限后，浏览器会运行此政策中配置的操作。\n\n如果此政策为空或未设置，IdleTimeout 政策将不会产生任何影响。\n\n支持的操作如下：\n\n“close_browsers”：关闭该个人资料的所有浏览器窗口和 PWA。在 Android 和 iOS 设备上不受支持。\n\n“close_tabs”：关闭已打开窗口中所有打开的标签页。仅在 iOS 设备上受支持。\n\n“show_profile_picker”：显示“个人资料选择器”窗口。在 Android 和 iOS 设备上不受支持。\n\n“sign_out”：退出当前登录用户的账号。仅在 iOS 设备上受支持。\n\n“clear_browsing_history”“clear_download_history”“clear_cookies_and_other_site_data”“clear_cached_images_and_files”“clear_password_signing”“clear_autofill”“clear_site_settings”“clear_hosted_app_data”：清除相应的浏览数据。有关详情，请参阅 ClearBrowsingDataOnExitList 政策。iOS 设备上支持的类型包括“clear_browsing_history”“clear_cookies_and_other_site_data”“clear_cached_images_and_files”“clear_password_signing”和“clear_autofill”\n\n“reload_pages”：重新加载所有网页。对于某些页面，系统可能会提示用户先进行确认。在 iOS 设备上不受支持。\n\n使用“clear_cookies_and_other_site_data”删除 Cookie 后，用户仍会保持 Google 账号登录状态。\n\n如果既未通过设置 SyncDisabled 政策停用“Chrome Sync”，也未停用 BrowserSignin，设置“clear_browsing_history”“clear_password_signing”“clear_autofill”和“clear_site_settings”将为相应的数据类型停用同步功能。";
ImagesAllowedForUrls.pfm_title = "在这些网站上允许图片";
ImagesAllowedForUrls.pfm_description = "通过设置此政策，您可以设置一个网址格式列表，从而指定哪些网站可以显示图片。\n\n未设置此政策时，如果已设置 DefaultImagesSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。\n\n请注意，我们先前误在 Android 设备上启用了此政策，但从未在 Android 设备上为这项功能提供完整支持。";
ImagesBlockedForUrls.pfm_title = "在这些网站上阻止图片";
ImagesBlockedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，从而指定哪些网站无法显示图片。\n\n未设置此政策时，如果已设置 DefaultImagesSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n 如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。\n\n 请注意，我们先前误在 Android 设备上启用了此政策，但从未在 Android 设备上为这项功能提供完整支持。";
ImportAutofillFormData.pfm_title = "首次运行时，从默认浏览器导入自动填充表单数据";
ImportAutofillFormData.pfm_description = "如果此政策已启用，当首次运行浏览器时，系统将会从先前的默认浏览器导入自动填充表单数据。如果此政策已停用或未设置，当首次运行浏览器时，系统不会导入任何自动填充表单数据。\n\n用户可以触发导入对话框，系统将会根据此政策的值选中或不选中“自动填充表单数据”复选框。";
ImportBookmarks.pfm_title = "首次运行时，从默认浏览器导入书签";
ImportBookmarks.pfm_description = "如果此政策已启用，当首次运行浏览器时，系统将会从先前的默认浏览器导入书签。如果此政策已停用或未设置，当首次运行浏览器时，系统不会导入任何书签。\n\n用户可以触发导入对话框，系统将会根据此政策的值选中或不选中“书签”复选框。";
ImportHistory.pfm_title = "首次运行时，从默认浏览器导入浏览记录";
ImportHistory.pfm_description = "如果此政策已启用，当首次运行浏览器时，系统将会从先前的默认浏览器导入浏览记录。如果此政策已停用或未设置，当首次运行浏览器时，系统不会导入任何浏览记录。\n\n用户可以触发导入对话框，系统将会根据此政策的值选中或不选中“浏览记录”复选框。";
ImportHomepage.pfm_title = "首次运行时，从默认浏览器导入主页";
ImportHomepage.pfm_description = "如果此政策已启用，当首次运行浏览器时，系统将会从先前的默认浏览器导入主页。如果此政策已停用或未设置，当首次运行浏览器时，系统不会导入主页。\n\n用户可以触发导入对话框，系统将会根据此政策的值选中或不选中“主页”复选框。";
ImportSavedPasswords.pfm_title = "首次运行时，从默认浏览器导入保存的密码";
ImportSavedPasswords.pfm_description = "此政策仅用于控制 Chrome 安装后首次运行时的导入行为。如果是处于在 Brave 安装前已有一款不同浏览器被广泛使用的环境中，此政策让您能够更顺畅地过渡到所安装的这款浏览器。此政策不会影响 Google 账号的密码管理工具功能。\n\n如果此政策已启用，首次运行时系统会从先前的默认浏览器导入已保存的密码，用户也可从“设置”页面中手动导入。\n如果此政策已停用，首次运行时系统不会导入任何已保存的密码，用户也无法从“设置”页面中手动导入。\n如果此政策未设置，首次运行时系统不会导入任何已保存的密码，但用户可以选择从“设置”页面中执行导入操作。";
ImportSearchEngine.pfm_title = "首次运行时，从默认浏览器导入搜索引擎";
ImportSearchEngine.pfm_description = "如果此政策已启用，当首次运行浏览器时，系统将会从先前的默认浏览器导入默认搜索引擎。如果此政策已停用或未设置，当首次运行浏览器时，系统不会导入默认搜索引擎。\n\n用户可以触发导入对话框，系统将会根据此政策的值选中或不选中“默认搜索引擎”复选框。";
IncognitoModeAvailability.pfm_title = "无痕模式的可用性";
IncognitoModeAvailability.pfm_description = "0 - 可使用无痕模式\n1 - 隐身模式已停用\n2 - 强制使用隐身模式\n此政策用于指定用户可否在 Brave 中以无痕模式打开网页。\n\n如果您选择了“Enabled”或未设置此政策，用户将能够以无痕模式打开网页。\n\n如果您选择了“Disabled”，用户将无法以无痕模式打开网页。\n\n如果您选择了“Forced”，用户将只能以无痕模式打开网页。请注意，“Forced”不适用于 Android 版 Chrome\n\nIncognitoModeUrlAllowlist 政策的优先级高于此政策，它可以为特定网址重新启用无痕模式。当存在许可清单时，如果此政策停用了无痕模式，则无痕模式仅适用于与许可清单匹配的网址，而所有其他网页都会被屏蔽。\n\n注意：在 iOS 上，如果此政策在会话期间发生更改，相应更改要等到浏览器重新启动时才会生效。";
IncognitoModeUrlAllowlist.pfm_title = "允许在无痕模式下访问一系列网址。";
IncognitoModeUrlAllowlist.pfm_description = "通过设置此政策，可在无痕模式下访问所列网址。您可利用此政策，为 IncognitoModeUrlBlocklist 中定义的特定网址格式设置例外情况；请务必按照 https://support.google.com/chrome/a?p=url_blocklist_filter_format 中指定的格式进行配置。\n\n如果同时设置了此政策和 IncognitoModeUrlBlocklist 政策，则以许可清单为准。如果某个网址与许可清单上的格式匹配，则允许访问该网址；如果与屏蔽清单（而非许可清单）上的格式匹配，则该网址会被屏蔽；如果与两者都不匹配，则通用的 URLBlocklist/URLAllowlist 政策将用作后备政策。\n\n如果已设置此政策，但未设置 IncognitoModeUrlBlocklist 政策，则所有不在许可清单上的网址都会在无痕模式下被屏蔽。\n\n如果 IncognitoModeAvailability 政策设置为禁止（值为 1），但已配置此政策，则无痕模式将仅适用于与许可清单匹配的网址。\n\n如果未设置此政策，IncognitoModeUrlBlocklist 和 IncognitoModeAvailability 政策将不会有任何例外情况。\n\n此政策仅影响无痕模式。如要允许所有用户个人资料访问相关网址，请使用 URLAllowlist 政策。\n\n不允许使用全主机通配符（例如“*”或“[*]”），请使用 IncognitoModeAvailability 政策在全局范围内启用该功能。\n\n此政策最多只能包含 1,000 个条目。";
IncognitoModeUrlBlocklist.pfm_title = "禁止在无痕模式下访问一系列网址。";
IncognitoModeUrlBlocklist.pfm_description = "通过设置 IncognitoModeUrlBlocklist 政策，您可以禁止在无痕模式下加载已列入屏蔽清单的网址所对应的网页。管理员可以列出要屏蔽的网址格式。了解如何设置网址格式 (https://support.google.com/chrome/a?p=url_blocklist_filter_format)。\n\n如果同时设置了此政策和 IncognitoModeUrlAllowlist 政策，则以许可清单为准。如果某个网址与许可清单上的格式匹配，则允许访问该网址；如果与屏蔽清单（而非许可清单）上的格式匹配，则该网址会被屏蔽；如果与两者都不匹配，则通用的 URLBlocklist/URLAllowlist 政策将用作后备政策。\n\n如果已设置 IncognitoModeUrlAllowlist 政策，但未设置此政策，则在无痕模式下，所有不在许可清单上的网址都会被屏蔽。\n\n如果 IncognitoModeAvailability 设置为禁止（值为 1），但已配置 IncognitoModeUrlAllowlist 政策，则无痕模式仅适用于与许可清单匹配的网址。\n\n此政策仅影响无痕模式。如要禁止所有用户个人资料访问相关网址，请使用 URLBlocklist 政策。\n\n此政策最多只能包含 1,000 个条目。";
InsecureContentAllowedForUrls.pfm_title = "允许在这些网站上显示不安全内容";
InsecureContentAllowedForUrls.pfm_description = "此政策允许您设置一个网址格式列表，从而指定允许哪些网站显示可屏蔽的（即主动型）混合内容（即 HTTPS 网站上的 HTTP 内容），以及要为哪些网站上可选的可屏蔽（即被动型）混合内容停用升级功能。\n\n如果您未设置此政策，可屏蔽的混合内容将被屏蔽，同时可选的可屏蔽混合内容将被升级，而且用户将能设置例外情况以允许在特定网站上显示此类内容。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
InsecureContentBlockedForUrls.pfm_title = "禁止在这些网站上显示不安全内容";
InsecureContentBlockedForUrls.pfm_description = "此政策允许您设置一个网址格式列表，用于指定不允许哪些网站显示可屏蔽的（即主动型）混合内容（即 HTTPS 网站上的 HTTP 内容），以及要为哪些网站升级可选的可屏蔽（即被动型）混合内容。\n\n如果您未设置此政策，可屏蔽的混合内容将被屏蔽，同时可选的可屏蔽混合内容将被升级，但用户将能设置例外情况以允许在特定网站上显示此类内容。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
IntensiveWakeUpThrottlingEnabled.pfm_title = "控制 IntensiveWakeUpThrottling 功能。";
IntensiveWakeUpThrottlingEnabled.pfm_description = "如果此政策已启用，“IntensiveWakeUpThrottling”功能会使后台标签页中的 JavaScript 计时器受到过度节流并被聚合：当某个网页已在后台运行 5 分钟或更长时间后，这类计时器的运行频率不会超过每分钟 1 次。\n\n该功能符合 Web 标准，但可能会导致某些操作延迟 1 分钟之久，进而导致某些网站上的功能无法正常运作。不过，启用该功能可以大幅节省 CPU 占用量和电池耗电量。如需了解详情，请访问 https://bit.ly/30b1XR4。\n\n如果此政策已启用，系统会强制启用该功能，而且用户将无法覆盖此设置。\n\n如果此政策已停用，系统会强制停用该功能，而且用户将无法覆盖此设置。\n\n如果此政策未设置，该功能将由其自身的内部逻辑控制，但用户可以手动配置这一逻辑。\n\n请注意，此政策是按渲染程序进程来应用的，当有渲染程序进程启动时，此政策设置中的最新值会生效。必须完全重启设备，才能确保加载的所有标签页都会应用一致的政策设置。不同的进程可以使用此政策的不同值运行。\n";
IntranetRedirectBehavior.pfm_title = "内网重定向行为";
IntranetRedirectBehavior.pfm_description = "0 - 使用默认浏览器行为。\n1 - 停用 DNS 拦截检查功能和“您是不是要前往 http://intranetsite/？”信息栏。\n2 - 停用 DNS 拦截检查功能；允许使用“您是不是要前往 http://intranetsite/？”信息栏。\n3 - 允许使用 DNS 拦截检查功能和“您是不是要前往 http://intranetsite/？”信息栏。\n借助此政策，您可以配置通过 DNS 拦截检查功能进行内网重定向的行为。该检查功能旨在尝试检测浏览器是否使用了会重定向不明主机名的代理。\n\n如果此政策未设置，浏览器会使用 DNS 拦截检查功能和内网重定向建议功能的默认行为。在 M88 中，这些功能默认处于启用状态，但在未来的版本中，它们将会默认处于停用状态。\n\nDNSInterceptionChecksEnabled 是一项相关政策，也可用来停用 DNS 拦截检查功能；这版政策更灵活，可另行控制内网重定向信息栏，在未来可能会被扩展。\n如果 DNSInterceptionChecksEnabled 或此政策请求停用拦截检查功能，系统便会停用该功能。";
IsolateOrigins.pfm_title = "为指定的来源启用网站隔离功能";
IsolateOrigins.pfm_description = "指定在专用进程中运行的源列表。\n\n在 Android 上，此政策仅适用于内存充足（RAM 必须超过 3.2 GB）的设备，因为在资源受限的设备上隔离过多网站可能会导致性能问题。对于资源受限的 Android 设备，请改用 IsolateOriginsShortlist。\n\n对于内存小于 1 GB 的设备，不建议专门配置任何进程隔离。\n\n每个指定源的进程将仅允许包含来自该源及其子网域的文档。例如，如果指定 https://a1.example.com/，则同一进程中可以包含 https://a2.a1.example.com/，但不可包含 https://example.com 或 https://b.example.com。\n\n从 Brave 77 版起，您也可以使用通配符指定一系列要隔离的源。例如，如果指定 https://[*.]corp.example.com，则 https://corp.example.com 下的每个源都会获得各自的专用进程，包括 https://corp.example.com 本身、https://a1.corp.example.com 和 https://a2.a1.corp.example.com。\n\n请注意，如 SitePerProcess 政策中所述，系统已默认在桌面平台上隔离所有网站（网址格式为协议加上 eTLD+1，例如 https://example.com）。此 IsolateOrigins 政策适用于以更细的粒度隔离特定的源（例如，https://a.example.com）。\n\n请注意，从 Brave 77 版本开始，Android 默认会隔离某些敏感网站，而此政策则扩展了该模式，以便隔离其他特定的源。\n\n另请注意，此政策所隔离的源将无法通过脚本访问同一网站中的其他源，除非同一网站上有两个文档将各自的 document.domain 值改为一致的值。在隔离某个源之前，管理员应确认此源没有这种不常见的行为。\n\n如果此政策设为空字符串或未设置，系统不会要求对任何特定源进行网站隔离。不过，用户仍能通过命令行 flag 手动开启进程隔离。";
JavaScriptAllowedForUrls.pfm_title = "在这些网站上允许 JavaScript";
JavaScriptAllowedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，用于指定哪些网站可以运行 JavaScript。\n\n未设置此政策时，如果 DefaultJavaScriptSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
JavaScriptBlockedForUrls.pfm_title = "在这些网站上阻止 JavaScript";
JavaScriptBlockedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，从而指定哪些网站无法运行 JavaScript。\n\n未设置此政策时，如果已设置 DefaultJavaScriptSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。\n\n请注意，此政策会根据顶级文档的源（通常是地址栏中显示的网页网址）是否与任何格式匹配来阻止运行 JavaScript。因此，此政策不适合用于缓解网络供应链攻击。例如，提供格式“https://[*.]foo.com/”不会阻止托管在 https://example.com 上的网页运行从 https://www.foo.com/example.js 加载的脚本。此外，如果 https://example.com 上的文档不是顶级文档，而是作为子框架嵌入到由其他源（例如 https://www.bar.com）托管的网页中，则提供格式“https://example.com/”不会阻止该文档运行脚本。";
JavaScriptJitAllowedForSites.pfm_title = "允许 JavaScript 在这些网站上使用 JIT";
JavaScriptJitAllowedForSites.pfm_description = "此政策允许您设置一个网站网址格式列表，用于指定允许哪些网站在运行 JavaScript 时启用 JIT（即时）编译器。\n\n如需详细了解有效的网站网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。\n\n您可为特定子网域以及整个网站设置政策例外情况。例如，仅针对 subdomain.site.com 设置的政策只会应用于该子网域，而不会影响 site.com。在某些情况下，如果子网域无法与其父级网站隔离，则可能会继承针对 site.com 设置的政策。此外，对于加载到现有标签页中的框架，例外情况也可能不会产生任何效力，除非在新标签页中打开该网站。在低内存 Android 设备上，系统可能不会强制执行特定于网站的例外情况。网站会改用 DefaultJavaScriptJitSetting 政策（若已设置），或默认应用个人资料的 JavaScript JIT 设置。\n\n为强制执行例外情况，Brave 可能会将设置不同于默认值的网站或子网域放入专用进程。这可能会增加内存用量，尤其是在 Android 上或当通配符模式与多个子网域匹配时，因为每个匹配源都可能要单独隔离。此外，被隔离的子网域无法使用 document.domain 访问其父级网站。\n\n注意：在 155 及更早版本中，系统仅会在网站层级 (eTLD+1) 强制执行政策例外情况。仅为 subdomain.site.com 设置的政策不会产生任何效力，即使对 subdomain.site.com 也不例外；必须针对 site.com 设置政策，才能将所设政策同时应用于 site.com 和 subdomain.site.com。\n\n此政策会按框架逐一应用，而非仅基于顶级源网址。例如，如果 site-one.com 已列在 JavaScriptJitAllowedForSites 政策中，但 site-one.com 会加载包含 site-two.com 的框架，那么 site-one.com 将启用 JavaScript JIT，但 site-two.com 将使用 DefaultJavaScriptJitSetting 政策（若已设置）或默认启用 JavaScript JIT。屏蔽清单条目的优先级高于许可清单条目，而许可清单条目的优先级高于配置的默认值。\n\n没有为某个网站设置此政策时，如果 DefaultJavaScriptJitSetting 政策已设置，系统便会将它应用于该网站，否则就会为该网站启用 JavaScript JIT。";
JavaScriptJitBlockedForSites.pfm_title = "禁止 JavaScript 在这些网站上使用 JIT";
JavaScriptJitBlockedForSites.pfm_description = "此政策允许您设置一个网站网址格式列表，用于指定允许哪些网站在运行 JavaScript 时启用 JIT（即时）编译器。\n\n停用 JavaScript JIT 后，Brave 渲染 Web 内容的速度可能会更慢，且 JavaScript 中的 WebAssembly 等某些部分也可能会随之停用，但这可能会让 Brave 以更安全的配置渲染 Web 内容。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。\n\n您可为特定子网域以及整个网站设置政策例外情况。例如，仅针对 subdomain.site.com 设置的政策只会应用于该子网域，而不会影响 site.com。在某些情况下，如果子网域无法与其父级网站隔离，则可能会继承针对 site.com 设置的政策。此外，对于加载到现有标签页中的框架，例外情况也可能不会产生任何效力，除非在新标签页中打开该网站。在低内存 Android 设备上，系统可能不会强制执行特定于网站的例外情况。网站会改用 DefaultJavaScriptJitSetting 政策（若已设置），或默认应用个人资料的 JavaScript JIT 设置。\n\n为强制执行例外情况，Brave 可能会将设置不同于默认值的网站或子网域放入专用进程。这可能会增加内存用量，尤其是在 Android 上或当通配符模式与多个子网域匹配时，因为每个匹配源都可能要单独隔离。此外，被隔离的子网域无法使用 document.domain 访问其父级网站。\n\n注意：在 155 及更早版本中，系统仅会在网站层级 (eTLD+1) 强制执行政策例外情况。仅为 subdomain.site.com 设置的政策不会产生任何效力，即使对 subdomain.site.com 也不例外；必须针对 site.com 设置政策，才能将所设政策同时应用于 site.com 和 subdomain.site.com。\n\n此政策会按框架逐一应用，而非仅基于顶级源网址。例如，如果 site-one.com 已列在 JavaScriptJitBlockedForSites 政策中，但 site-one.com 会加载包含 site-two.com 的框架，那么 site-one.com 将停用 JavaScript JIT，但 site-two.com 将使用 DefaultJavaScriptJitSetting 政策（若已设置）或默认启用 JavaScript JIT。屏蔽清单条目的优先级高于许可清单条目，而许可清单条目的优先级高于配置的默认值。\n\n没有为某个网站设置此政策时，如果 DefaultJavaScriptJitSetting 政策已设置，系统便会将它应用于该网站，否则就会为该网站启用 JavaScript JIT。";
JavaScriptOptimizerAllowedForSites.pfm_title = "允许在这些网站上使用 JavaScript 优化功能";
JavaScriptOptimizerAllowedForSites.pfm_description = "此政策允许您设置一个网站网址格式列表，从而指定要为哪些网站启用高级 JavaScript 优化功能。\n\n如需详细了解有效的网站网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。\n允许使用通配符 *。\n\n您可为特定子网域以及整个网站设置政策例外情况。\n例如，仅针对 subdomain.site.com 设置的政策只会应用于该子网域，而不会影响 site.com。在某些情况下，如果子网域无法与其父级网站隔离，则可能会继承针对 site.com 设置的政策。此外，对于加载到现有标签页中的框架，例外情况也可能不会产生任何效力，除非在新标签页中打开该网站。在低内存 Android 设备上，系统可能不会强制执行特定于网站的例外情况。网站会改用 DefaultJavaScriptOptimizerSetting 政策（若已设置），或默认应用个人资料的 JavaScript 优化设置。\n\n为强制执行例外情况，Brave 可能会将设置不同于默认值的网站或子网域放入专用进程。这可能会增加内存用量，尤其是在 Android 上或当通配符模式与多个子网域匹配时，因为每个匹配源都可能要单独隔离。此外，被隔离的子网域无法使用 document.domain 访问其父级网站。\n\n注意：在 138 及更早版本中，系统仅会在网站层级 (eTLD+1) 强制执行政策例外情况。仅为 subdomain.site.com 设置的政策不会产生任何效力，即使对 subdomain.site.com 也不例外；必须针对 site.com 设置政策，才能将所设政策同时应用于 site.com 和 subdomain.site.com。\n\n此政策会按框架逐一应用，而非仅基于顶级源网址。例如，如果 site-one.com 已列在 JavaScriptOptimizerAllowedForSites 政策中，但 site-one.com 会加载包含 site-two.com 的框架，那么 site-one.com 将启用 JavaScript 优化功能，但 site-two.com 将使用 DefaultJavaScriptOptimizerSetting 政策（若已设置）或默认启用 JavaScript 优化功能。屏蔽清单条目的优先级高于许可清单条目，而许可清单条目的优先级高于配置的默认值。\n\n没有为某个网站设置此政策时，如果 DefaultJavaScriptOptimizerSetting 政策已设置，系统便会将它应用于该网站，否则就会为该网站启用 JavaScript 优化功能。";
JavaScriptOptimizerBlockedForSites.pfm_title = "禁止在这些网站上使用 JavaScript 优化功能";
JavaScriptOptimizerBlockedForSites.pfm_description = "此政策允许您设置一个网站网址格式列表，从而指定要为哪些网站停用高级 JavaScript 优化功能。\n\n停用 JavaScript 优化功能后，Brave 渲染 Web 内容的速度可能会变慢。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。\n允许使用通配符 *。\n\n您可为特定子网域以及整个网站设置政策例外情况。\n例如，仅针对 subdomain.site.com 设置的政策只会应用于该子网域，而不会影响 site.com。在某些情况下，如果子网域无法与其父级网站隔离，则可能会继承针对 site.com 设置的政策。此外，对于加载到现有标签页中的框架，例外情况也可能不会产生任何效力，除非在新标签页中打开该网站。在低内存 Android 设备上，系统可能不会强制执行特定于网站的例外情况。网站会改用 DefaultJavaScriptOptimizerSetting 政策（若已设置），或默认应用个人资料的 JavaScript 优化设置。\n\n为强制执行例外情况，Brave 可能会将设置不同于默认值的网站或子网域放入专用进程。这可能会增加内存用量，尤其是在 Android 上或当通配符模式与多个子网域匹配时，因为每个匹配源都可能要单独隔离。此外，被隔离的子网域无法使用 document.domain 访问其父级网站。\n\n注意：在 138 及更早版本中，系统仅会在网站层级 (eTLD+1) 强制执行政策例外情况。仅为 subdomain.site.com 设置的政策不会产生任何效力，即使对 subdomain.site.com 也不例外；必须针对 site.com 设置政策，才能将所设政策同时应用于 site.com 和 subdomain.site.com。\n\n此政策会按框架逐一应用，而非仅基于顶级源网址。例如，如果 site-one.com 已列在 JavaScriptOptimizerBlockedForSites 政策中，但 site-one.com 会加载包含 site-two.com 的框架，那么 site-one.com 将停用 JavaScript 优化功能，但 site-two.com 将使用 DefaultJavaScriptOptimizerSetting 政策（若已设置）或默认启用 JavaScript 优化功能。屏蔽清单条目的优先级高于许可清单条目，而许可清单条目的优先级高于配置的默认值。\n\n没有为某个网站设置此政策时，如果 DefaultJavaScriptOptimizerSetting 政策已设置，系统便会将它应用于该网站，否则就会为该网站启用 JavaScript 优化功能。";
LiveCaptionEnabled.pfm_title = "启用实时字幕";
LiveCaptionEnabled.pfm_description = "启用实时字幕。\n\n如果此政策已启用，实时字幕将始终处于开启状态。\n\n如果此政策已停用，实时字幕将始终处于关闭状态。\n\n如果您将此政策设为强制性要求，用户便无法更改或覆盖它。\n\n如果此政策未设置，则实时字幕最初会处于停用状态，但用户可以随时启用该功能。";
LiveTranslateEnabled.pfm_title = "启用“实时翻译”功能";
LiveTranslateEnabled.pfm_description = "启用实时字幕翻译功能。系统会将字幕发送给 Google 进行翻译。\n\n如果此政策已启用，实时翻译将始终处于开启状态。\n\n如果此政策已停用，实时翻译将始终处于关闭状态。\n\n如果您将此政策设为强制性要求，用户便无法更改或覆盖它。\n\n如果此政策未设置，则实时翻译最初会处于停用状态，但用户可以随时启用该功能。\n\n如果 LiveCaptionEnabled 已停用，无论此政策如何设置，实时翻译都会停用。";
LocalFontsAllowedForUrls.pfm_title = "允许向这些网站授予本地字体权限";
LocalFontsAllowedForUrls.pfm_description = "设置一个网站网址格式列表，从而指定系统自动向哪些网站授予本地字体权限。这将扩展网站查看本地字体信息的能力。\n\n如需详细了解有效的网站网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。此政策只根据源进行匹配，因此会忽略网址格式中的任何路径。\n\n若未对某个网站设置此政策，则系统会应用 DefaultLocalFontsSetting 的政策（若已设置）；否则权限将遵循浏览器的默认设置，允许用户按网站选择此权限。";
LocalFontsBlockedForUrls.pfm_title = "拒绝向这些网站授予本地字体权限";
LocalFontsBlockedForUrls.pfm_description = "供您用来设置一个网站网址格式列表，从而指定要让系统自动拒绝向哪些网站授予本地字体权限。此设置会限制网站查看本地字体相关信息的能力。\n\n如需详细了解有效的网站网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。此政策只能根据源进行匹配，因此网址格式中的任何路径都会被忽略。\n\n如果您未为某个网站设置此政策，系统便会将 DefaultLocalFontsSetting 中的政策（若已设置）应用于该网站，或者让该网站遵循浏览器的默认权限设置并允许用户按网站选择这项权限。";
LocalNetworkAccessAllowedForUrls.pfm_title = "允许网站向本地设备和本地网络端点发送网络请求。";
LocalNetworkAccessAllowedForUrls.pfm_description = "指定一系列网址格式。从匹配源所提供的网站中发起的网络请求无需接受Local Network Access检查。\n\n        对于与此处所列格式不匹配的源，系统会应用用户的个人配置。\n\n如需详细了解有效网址格式，请访问 https://chromeenterprise.google/policies/url-patterns/。\n\n如需了解Local Network Access限制，请访问 https://wicg.github.io/local-network-access/。\n\n有多项政策列出了会影响向本地设备和本地网络端点发送请求的源。如果某个源同时匹配以下多项政策，则政策的优先级顺序如下：\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "禁止网站向本地设备和本地网络端点发送网络请求。";
LocalNetworkAccessBlockedForUrls.pfm_description = "指定一系列网址格式。从匹配源所提供的网站中发起的网络请求将无法发出Local Network Access请求。\n\n对于与此处所列格式不匹配的源，系统会应用用户的个人配置。\n\n如需详细了解有效网址格式，请访问 https://chromeenterprise.google/policies/url-patterns/。\n\n如需了解Local Network Access限制，请访问 https://wicg.github.io/local-network-access/。\n\n有多项政策列出了会影响向本地设备和本地网络端点发送请求的源。如果某个源同时匹配以下多项政策，则政策的优先级顺序如下：\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "覆盖 IP 地址空间映射";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "设置此政策即可将某些内部地址范围视为“公开”，使之无需接受Local Network Access检查。反之，如果某些公开地址范围可能用于内部，则可以将其视为“本地”，以便通过Local Network Access检查予以保护。\n\nIP 地址空间覆盖有两种形式：\n\n[cidr]=[public|local|loopback]\n\n其中 [cidr] 是以 CIDR 表示法表示的 IP 地址范围（对于 IPv4，请参阅 https://tools.ietf.org/html/rfc4632 的第 3.1 节；对于 IPv6，请参阅 https://tools.ietf.org/html/rfc4291 的第 2.3 节）。IPv6 地址必须采用网址安全（带方括号）格式指定。CIDR 覆盖适用于所有端口。\n\n或\n\n[ip-address]:[port]=[public|local|loopback]\n\n如需详细了解Local Network Access，请参阅 https://wicg.github.io/local-network-access/ 和 https://developer.chrome.com/blog/local-network-access。\n\n此政策不支持动态刷新。\n\n命令行开关 --ip-address-space-overrides 的覆盖设置优先于此政策设定的覆盖设置。";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "允许在子框架中发出本地网络访问 (LNA) 请求，而无需明确委托";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "默认情况下，只有在明确委托时，才允许在跨源子框架中请求本地网络访问 (LNA) 权限。此政策可用于替换此默认行为，以便 LNA 权限默认继承到子框架中，除非权限政策明确拒绝。\n\n如果此政策设为启用，默认情况下，子框架会被委托所有 LNA 权限政策功能，并且可以发出本地网络请求（触发权限提示）。\n\n如果此政策设为停用或未设置，子框架必须明确获得权限政策功能的授权，才能发出本地网络请求并触发权限提示。\n\n此政策适用于权限政策功能 \"local-network-access\"、\"loopback-network\" 和 \"local-network\"。\n\n如需详细了解本地网络访问，请参阅 https://wicg.github.io/local-network-access/ 和 https://developer.chrome.com/blog/local-network-access。\n\n如需详细了解权限政策，请参阅 https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy。";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "指定是否（暂时）停止本地网络访问权限限制";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "如果此政策设为“已启用”，Local Network Access请求将仅在 Chrome DevTools中显示因Local Network Access检查失败而导致的警告。\n\n如果此政策设为“已停用”或未设置，Local Network Access请求将使用此类请求的默认处理方式。\n\n如需了解Local Network Access限制，请访问 https://wicg.github.io/local-network-access/。\n\n这项企业政策只是暂时性政策，将在 M163 之后移除。\n\n从长远来看，可以使用政策 LocalNetworkAccessAllowedForUrls 将应自动获得Local Network Access权限的网址格式列入许可清单。";
LocalNetworkAllowedForUrls.pfm_title = "允许网站向本地网络端点发送网络请求。";
LocalNetworkAllowedForUrls.pfm_description = "指定一系列网址格式。从匹配源所提供网站发起的针对本地网络端点的网络请求不会受到Local Network Access检查机制的约束。\n\n对于与此处所列格式不匹配的源，系统会应用用户的个人配置。\n\n如需详细了解有效网址格式，请访问 https://chromeenterprise.google/policies/url-patterns/。\n\n如需了解Local Network Access限制，请访问 https://wicg.github.io/local-network-access/。\n\n有多项政策列出了相关源，这些政策会影响向本地网络端点发送的请求。如果某个源同时匹配以下多项政策，则政策的优先级顺序如下：\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkBlockedForUrls.pfm_title = "禁止网站向本地网络端点发送网络请求。";
LocalNetworkBlockedForUrls.pfm_description = "指定一系列网址格式。从匹配源所提供网站发起的针对本地网络端点的网络请求将无法发出Local Network Access请求。\n\n对于与此处所列格式不匹配的源，系统会应用用户的个人配置。\n\n如需详细了解有效网址格式，请访问 https://chromeenterprise.google/policies/url-patterns/。\n\n如需了解Local Network Access限制，请访问 https://wicg.github.io/local-network-access/。\n\n有多项政策列出了相关源，这些政策会影响向本地网络端点发送的请求。如果某个源同时匹配以下多项政策，则政策的优先级顺序如下：\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LookalikeWarningAllowlistDomains.pfm_title = "禁止在特定网域中针对相似域名显示警告";
LookalikeWarningAllowlistDomains.pfm_description = "通过设置此政策，您可禁止在所列网站上针对相似网址显示警告。一般情况下，当 Brave 认定网站可能正试图仿冒用户熟悉的另一个网站时，就会在网站上显示这类警告。\n\n如果此政策已启用，并且设为一个或多个域名，当用户访问相应网域上的网页时，系统将不会针对相似网址显示任何警告页面。\n\n如果此政策未设置或设为一个空列表，系统可能会在用户访问的任一网站上显示这类警告。\n\n允许主机名匹配整个主机或任一网域。例如，倘若此列表包含“foo.example.com”或“example.com”，诸如“https://foo.example.com/bar”之类的网址便可能不会显示这类警告。";
LoopbackNetworkAllowedForUrls.pfm_title = "允许网站向本地设备发送网络请求。";
LoopbackNetworkAllowedForUrls.pfm_description = "指定一系列网址格式。从匹配源所提供网站发起的针对本地设备的网络请求不会受到Local Network Access检查机制的约束。\n\n对于与此处所列格式不匹配的源，系统会应用用户的个人配置。\n\n如需详细了解有效网址格式，请访问 https://chromeenterprise.google/policies/url-patterns/。\n\n如需了解Local Network Access限制，请访问 https://wicg.github.io/local-network-access/。\n\n有多项政策列出了相关源，这些政策会影响向本地设备发送的请求。如果某个源同时匹配以下多项政策，则政策的优先级顺序如下：\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LoopbackNetworkBlockedForUrls.pfm_title = "禁止网站向本地设备发送网络请求。";
LoopbackNetworkBlockedForUrls.pfm_description = "指定一系列网址格式。从匹配源所提供网站发起的针对本地设备的网络请求将无法发出Local Network Access请求。\n\n对于与此处所列格式不匹配的源，系统会应用用户的个人配置。\n\n如需详细了解有效网址格式，请访问 https://chromeenterprise.google/policies/url-patterns/。\n\n如需了解Local Network Access限制，请访问 https://wicg.github.io/local-network-access/。\n\n有多项政策列出了相关源，这些政策会影响向本地设备发送的请求。如果某个源同时匹配以下多项政策，则政策的优先级顺序如下：\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
ManagedBookmarks.pfm_title = "受管理的书签";
ManagedBookmarks.pfm_description = "设置此政策可创建一个书签列表，其中的每个书签都是一个包含“name”和“url”键的字典条目。这些键分别指定书签的名称和目标网址。管理员可以创建一个子文件夹，方法是：定义一个不含“url”键但含一个额外“children”键的书签。这个额外键也会包含一个书签列表，其中的部分书签也可以是文件夹。Chrome 会修正不完整的网址，就像是修正通过地址栏提交的不完整网址一样。例如，将“google.com”改为“https://google.com/”。\n\n用户无法更改用于放置书签的文件夹，但可从书签栏中将其隐藏。受管理书签的默认文件夹名称为“受管理的书签”，但用户可以更改该名称，方法是：向此政策中添加一个新的仅包含“toplevel_name”键的子字典条目，并将键值设为所需的文件夹名称。受管理的书签不会同步到用户账号中，且无法由扩展程序修改。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=ManagedBookmarks。";
ManagedConfigurationPerOrigin.pfm_title = "为特定来源的网站设定受管理配置值";
ManagedConfigurationPerOrigin.pfm_description = "通过设置此政策，您可以指定 Managed Configuration API 应为给定来源返回的值。\n\n Managed configuration API 是一种键值对配置，可通过 navigator.managed.getManagedConfiguration() javascript 调用来使用。该 API 仅适用于通过 WebAppInstallForceList 强制安装的 Web 应用所对应的来源。\n\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin。";
MaxConnectionsPerProxy.pfm_title = "每个代理服务器针对非 WebSocket 请求的并发连接数上限";
MaxConnectionsPerProxy.pfm_description = "通过设置此政策，您可以指定每个代理服务器针对非 WebSocket 请求的并发连接数上限。\n\n如需针对 WebSocket 请求修改此上限，请参阅 MaxConnectionsPerProxyForWebSocket。\n\n如果您未设置此政策，系统将使用默认值 128。\n\n有些 Web 应用会通过“挂起 GET”占用大量连接。因此，如果将此值设为小于 128，并且同时打开了太多此类 Web 应用，就可能会导致浏览器网络连接挂起。\n某些代理服务器无法处理由同一客户端发起的大量并发连接，这时只需将此政策的值调低即可解决问题。\n\n此值应大于或等于 6。\n如果设置的值小于该限制，系统将使用 6。\n如果设置的值小于默认值 (128)，您需自担风险。\n\n此值应小于或等于 256（在 Brave 147 及更早版本中为 99）。\n如果设置的值大于该限制，系统将使用 256（在 Brave 147 及更早版本中为 99）。\n如果设置的值大于默认值 (128)，您需自担风险。\n\n请注意，强制执行的限制会受到 AllowSocketPoolSizeRandomizationForProxies 的影响。";
MaxConnectionsPerProxyForWebSocket.pfm_title = "每个代理服务器针对 WebSocket 请求的并发连接数上限";
MaxConnectionsPerProxyForWebSocket.pfm_description = "通过设置此政策，您可以指定每个代理服务器针对 WebSocket 请求的并发连接数上限。\n\n如需针对非 WebSocket 请求修改此上限，请参阅 MaxConnectionsPerProxy。\n\n如果您未设置此政策，系统将使用默认值 128。\n\n有些 Web 应用会通过“挂起 GET”占用大量连接。因此，如果将此值设为小于 128，并且同时打开了太多此类 Web 应用，就可能会导致浏览器网络连接挂起。\n某些代理服务器无法处理由同一客户端发起的大量并发连接，这时只需将此政策的值调低即可解决问题。\n\n此值应大于或等于 6。\n如果设置的值小于该限制，系统将使用 6。\n如果设置的值小于默认值 (128)，您需自担风险。\n\n此值应小于或等于 256。\n如果设置的值大于该限制，系统将使用 256。\n如果设置的值大于默认值 (128)，您需自担风险。\n\n请注意，强制执行的限制会受到 AllowSocketPoolSizeRandomizationForProxies 的影响。";
MaxInvalidationFetchDelay.pfm_title = "政策失效后的最大提取延迟";
MaxInvalidationFetchDelay.pfm_description = "通过设置此政策，您可以指定收到政策失效通知与从设备管理服务提取新政策之间的最大延迟（以毫秒为单位）。有效值范围为 1000（1 秒）至 300000（5 分钟）。此范围之外的值均会被相应地向上/向下舍入为邻近的限值。\n\n如果您未设置此政策，Brave 将会使用默认值（10 秒）。";
MediaRecommendationsEnabled.pfm_title = "启用媒体推荐内容";
MediaRecommendationsEnabled.pfm_description = "默认情况下，浏览器会显示为用户量身定制的媒体推荐内容。如果此政策已停用，系统将对用户隐藏这些推荐内容。如果此政策已启用或未设置，系统则会向用户显示媒体推荐内容。";
MediaRouterCastAllowAllIPs.pfm_title = "允许 Google Cast 连接到位于所有 IP 地址的 Cast 设备。";
MediaRouterCastAllowAllIPs.pfm_description = "除非 EnableMediaRouter 设为“已停用”，否则，如果 MediaRouterCastAllowAllIPs 已启用，Google Cast 将会连接到位于所有 IP 地址的投放设备，而不是只连接到位于 RFC1918/RFC4193 私有地址的投放设备。\n\n如果此政策已停用，Google Cast 将会只连接到位于 RFC1918/RFC4193 的投放设备。\n\n如果此政策未设置，Google Cast 将会只连接到位于 RFC1918/RFC4193 的投放设备，除非 CastAllowAllIPs 功能已开启。";
MemorySaverModeSavings.pfm_title = "更改省内存模式的节省量";
MemorySaverModeSavings.pfm_description = "0 - 适中节省内存。\n1 - 均衡节省内存。\n2 - 尽可能节省内存。\n此政策用于更改省内存模式的节省级别。\n\n此政策仅在通过设置或 HighEfficiencyModeEnabled 政策启用省内存模式后才会生效，并且会影响系统如何使用启发法来确定何时舍弃标签页。例如，在舍弃之前缩短闲置标签页的生命周期可以节省内存，但这也意味着标签页会更频繁地重新加载，从而导致用户体验不佳并消耗更多网络流量。\n\n如果将此政策设为 0，省内存模式将适中地节省内存。标签页会在较长的一段时间后变为非活跃状态\n\n如果将此政策设为 1，省内存模式将均衡地节省内存。标签页会在最适宜的一段时间后变为非活跃状态。\n\n如果将此政策设为 2，省内存模式将尽可能节省内存。标签页会在更短的一段时间后变为非活跃状态。\n\n如果此政策未设置，最终用户可在 chrome://settings/performance 上控制这项设置。";
MetricsReportingEnabled.pfm_title = "启用关于使用情况和崩溃相关数据的报告";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "在“新标签页”页面上显示卡片";
NTPCardsVisible.pfm_description = "此政策用于控制是否在“新标签页”页面上显示卡片。卡片会呈现入口点，以根据用户的浏览行为启动常见的用户操作流程。\n\n如果此政策已启用，“新标签页”页面将会显示卡片（若有可用内容）。\n\n如果此政策已停用，“新标签页”页面将不会显示卡片。\n\n如果此政策未设置，用户可以控制卡片公开范围。默认情况下，卡片会处于可见状态。\n";
NTPCustomBackgroundEnabled.pfm_title = "允许用户在“新标签页”页面上自定义背景";
NTPCustomBackgroundEnabled.pfm_description = "如果此政策设为 false，“新标签页”页面将不允许用户自定义背景。所有现有的自定义背景都将被永久移除，即使此政策后来又改设为 true 也是如此。\n\n如果此政策设为 true 或未设置，用户便能够在“新标签页”页面上自定义背景。\n\n注意：在 Android 设备上，此政策只有在浏览器重启后才会生效。";
NTPFooterExtensionAttributionEnabled.pfm_title = "控制是否在“新标签页”页面上显示扩展程序来源信息";
NTPFooterExtensionAttributionEnabled.pfm_description = "此政策决定是否在“新标签页”页面 (NTP) 的页脚中显示一条来源信息，该信息注明了修改 NTP 的扩展程序。\n\n默认情况下，如果某个扩展程序覆盖了标准 NTP，页脚中会显示一条消息，说明这项更改是由该特定扩展程序造成的。此来源信息通常包含指向 Chrome 应用商店中相关扩展程序的链接。\n\n如果此政策未设置或设为 true，当扩展程序控制 NTP 时，NTP 页脚中将显示扩展程序来源信息。\n\n如果此政策设为 false，NTP 页脚中的扩展程序来源信息将被隐藏。";
NTPFooterManagementNoticeEnabled.pfm_title = "控制是否在受管浏览器的“新标签页”页面上显示管理通知";
NTPFooterManagementNoticeEnabled.pfm_description = "此政策用于控制是否在“新标签页”页面 (NTP) 的页脚中显示管理通知。默认情况下，当浏览器由组织管理时，NTP 页脚会显示相关信息（由建筑物图标和“由 [域名] 管理”表示）。您可以使用 EnterpriseCustomLabelForBrowser 和 EnterpriseLogoUrlForBrowser 政策对此进行自定义。\n\n如果此政策未设置或设为 true，受管浏览器将会显示带有图标的“受…管理”通知。\n\n如果此政策设为 false，管理通知将会隐藏。\n\n请注意，此政策仅适用于受管浏览器，对使用非受管浏览器的受管用户没有影响。在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
NTPOutlookCardVisible.pfm_title = "在“新标签页”页面上显示 Outlook 日历卡片";
NTPOutlookCardVisible.pfm_description = "此政策用于控制是否在“新标签页”页面上显示 Outlook 卡片。只有在启用此政策且您的组织授权在浏览器中使用 Outlook 日历数据时，此卡片才会显示在“新标签页”页面上。\n\n浏览器不会存储 Outlook 数据。\n\nOutlook 卡片会显示下一个日历活动，并提供当天其余会议的概览。此功能旨在为用户提供查看下一场会议的快捷方式，从而解决上下文切换问题并提高工作效率。\n\nMicrosoft Outlook 卡片需要由管理员进行额外配置。如需详细了解如何将 Chrome“新标签页”页面卡片连接到 Outlook，请访问 https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards。\n\n如果已停用 NTPCardsVisible，系统将不会显示 Outlook 卡片。如果已启用 NTPCardsVisible，同时已启用此政策，且有待显示的数据，那么系统将显示 Outlook 卡片。如果未设置 NTPCardsVisible，但已启用此政策，同时用户已在“自定义 Chrome”中启用 Outlook 卡片，且有待显示的数据，那么系统将显示 Outlook 卡片。";
NTPSharepointCardVisible.pfm_title = "在“新标签页”页面上显示 SharePoint 和 OneDrive 文件卡片";
NTPSharepointCardVisible.pfm_description = "此政策用于控制是否在“新标签页”页面上显示 SharePoint 和 OneDrive 文件卡片。只有在启用此政策且您的组织授权在浏览器中使用 SharePoint 和 OneDrive 文件数据时，此卡片才会显示在“新标签页”页面上。\n\n浏览器不会存储 SharePoint 和 OneDrive 数据。\n\nSharePoint 和 OneDrive 文件建议卡片会显示建议文件的列表。此功能旨在为用户提供打开最重要文档的快捷方式，从而解决上下文切换问题并提高工作效率。\n\nMicrosoft SharePoint 和 OneDrive 卡片需要由管理员进行额外配置。如需详细了解如何将 Chrome“新标签页”页面卡片连接到 SharePoint，请访问 https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards。\n\n如果已停用 NTPCardsVisible，系统将不会显示 SharePoint 和 OneDrive 卡片。如果已启用 NTPCardsVisible，同时已启用此政策，且有待显示的数据，那么系统将显示 SharePoint 和 OneDrive 卡片。如果未设置 NTPCardsVisible，但已启用此政策，同时用户已在“自定义 Chrome”中启用 SharePoint 和 OneDrive 卡片，且有待显示的数据，那么系统将显示 SharePoint 和 OneDrive 卡片。";
NTPShortcuts.pfm_title = "设置要在“新标签页”页面上显示的快捷方式";
NTPShortcuts.pfm_description = "通过设置此政策，您可以预先配置在 Brave 的“新标签页”页面上显示多达 10 个自定义快捷方式。\n\n设置之后，用户在其个人快捷方式之外，还会默认看到这些快捷方式。用户可以在“自定义 Chrome”面板中控制其所属组织的快捷方式的显示情况。\n\n快捷方式网址不得重复。\n\n如果 allow_user_edit 设为 true，用户可以更改快捷方式的名称。如果此政策设为 false 或未设置，用户无法修改快捷方式的名称。\n\n如果 allow_user_delete 设为 true，用户可以移除快捷方式。如果此政策设为 false 或未设置，用户无法移除快捷方式。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=NTPShortcuts。";
NativeMessagingAllowlist.pfm_title = "要从屏蔽名单中排除的本地消息传递主机名";
NativeMessagingAllowlist.pfm_description = "通过设置此政策，您可以指定不受拒绝名单影响的本地消息传递主机。拒绝名单值 * 表示所有本地消息传递主机均会被拒绝，除非它们已获得明确许可。\n\n默认情况下，所有本地消息传递主机都列在许可名单中，但如果所有本地消息传递主机都已被依照某项政策拒绝，管理员可以使用许可名单来更改该政策。";
NativeMessagingBlocklist.pfm_title = "被禁的本地消息传递主机的名称（用“*”则表示全部禁止）";
NativeMessagingBlocklist.pfm_description = "通过设置此政策，您可以指定不应加载哪些本地消息传递主机。拒绝名单值 * 表示所有本地消息传递主机均会被拒绝，除非它们已获得明确许可。\n\n如果您未设置此政策，Brave 便会加载已安装的所有本地消息传递主机。";
NativeMessagingUserLevelHosts.pfm_title = "允许使用用户级本地消息传递主机（安装时没有管理员权限）";
NativeMessagingUserLevelHosts.pfm_description = "如果此政策已启用或未设置，Brave 便可使用在用户级安装的本地消息传递主机。\n\n如果此政策已停用，Brave 将只能使用在系统级安装的本地消息传递主机。";
NetworkPredictionOptions.pfm_title = "启用网络预测功能";
NetworkPredictionOptions.pfm_description = "0 - 采用任何网络连接时，均预测网络操作\n1 - 连上网络时一律预测网络操作（移动网络除外）。\n（在版本 50 中已不适用，在版本 52 中已遭到移除。在 52 以上版本中，如果设置值为 1，则系统会视为 0 - 连上网络时一律预测网络操作。）\n2 - 采用任何网络连接时，均不预测网络操作\n此政策旨在控制 Brave 中的网络预测功能。它控制着 DNS 预提取、TCP 和 SSL 预连接以及网页预呈现。\n\n如果您设置了此政策，用户便无法更改相关设置。如果您未设置此政策，系统会开启网络预测功能，但用户可以更改设置。";
NewTabPageLocation.pfm_title = "在新标签页中打开的页面网址";
NewTabPageLocation.pfm_description = "通过设置此政策，您可以配置默认的“新标签页”页面网址，并禁止用户更改此设置。\n\n在打开新的标签页和窗口时，系统会显示“新标签页”页面。\n\n此政策不影响哪些页面会在 Chrome 启动时打开。启动时打开的页面由 RestoreOnStartup 政策控制。如果主页被设为打开“新标签页”页面，此政策确实会影响主页；如果启动页被设为打开“新标签页”页面，此政策也会影响启动页。\n\n最佳实践是提供完全规范化的网址；如果您提供的网址并未完全规范化，Brave 会默认采用 https://。\n\n如果未设置此政策或将其留空，系统会使用默认的“新标签页”页面。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
NotificationsAllowedForUrls.pfm_title = "允许在这些网站上显示通知";
NotificationsAllowedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，用于指定哪些网站可以显示通知。\n\n未设置此政策，如果 DefaultNotificationsSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
NotificationsBlockedForUrls.pfm_title = "阻止在这些网站上显示通知";
NotificationsBlockedForUrls.pfm_description = "通过设置此政策，您可以设置一个网址格式列表，从而指定哪些网站无法显示通知。\n\n未设置此政策时，如果已设置 DefaultNotificationsSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
NtlmV2Enabled.pfm_title = "启用 NTLMv2 身份验证。";
NtlmV2Enabled.pfm_description = "如果此政策已启用或未设置，系统会开启 NTLMv2。\n\n如果此政策已停用，系统会关闭 NTLMv2。\n\n所有最新版本的 Samba 和 Microsoft® Windows® 服务器均支持 NTLMv2。只有为了实现向后兼容性时才应关闭此功能，因为关闭此功能会降低身份验证的安全性。";
OopPrintDriversAllowed.pfm_title = "允许使用进程外的打印驱动程序";
OopPrintDriversAllowed.pfm_description = "控制 Brave 是否使用独立的服务进程与打印机驱动程序交互。用于查询可用打印机、获取打印驱动程序设置、将待打印的文档提交至本地打印机的平台打印任务调用，均通过一项服务进程执行。将这类调用从浏览器进程中移出有助于提升稳定性，并减少打印预览中的界面冻结行为。\n\n如果此政策已启用或未设置，Brave 将会使用独立的服务进程执行平台打印任务。\n\n如果此政策已停用，Brave 将会使用浏览器进程执行平台打印任务。\n\n日后，待进程外打印驱动程序功能全面推出后，此政策将被移除。";
OriginAgentClusterDefaultEnabled.pfm_title = "默认允许使用以源为键的代理集群。";
OriginAgentClusterDefaultEnabled.pfm_description = "此政策默认允许使用以源为键的代理集群。\n\nOrigin-Agent-Cluster HTTP 标头可控制是将某个文档隔离在以源为键的代理集群中，还是隔离在以网站为键的代理集群中。这会对安全性造成影响，因为以源为键的代理集群允许按源隔离文档。对开发者来说，采用这种做法就无法再设置 document.domain 这一访问函数。\n\n默认行为 - 未设置 Origin-Agent-Cluster 标头时 - 在 M111 中，从以网站为键改为以源为键。\n\n如果此政策已启用或未设置，从该版本开始，浏览器将遵循这一新的默认行为。\n\n如果此政策已停用，这项更改会反转，不带 Origin-Agent-Cluster 标头的文档将被分配给以网站为键的代理集群。因此，document.domain 访问函数会默认处于可设置状态。这与旧版行为一致。\n\n如需了解详情，请访问 https://developer.chrome.com/blog/immutable-document-domain/。";
OriginKeyedProcessesEnabled.pfm_title = "默认启用源键进程隔离。";
OriginKeyedProcessesEnabled.pfm_description = "为大多数网页（即默认分配给源键代理集群的网页）启用源键进程隔离。这会提高安全性，但也会增加创建的进程数。用户可以使用命令行 flag 或 chrome://flags（两种方式都可用于开启或关闭此功能）替换设置的政策值。\n\n如果启用了此政策，系统会将大多数源隔离，即使在同一网站中的源也会相互隔离。另请参阅 IsolateOrigins 和 SitePerProcess 政策。\n\n如果停用了此政策，除非源明确要求，否则不会将任何源与其同一网站中的其他源隔离。\n\n如果未设置此政策，浏览器会自行决定隔离哪些源以及何时隔离。";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "针对不安全来源的安全性限制不适用于哪些来源或主机名模式";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "通过设置此政策，您能以列表形式指定针对不安全来源的安全性限制不适用于哪些来源（网址）或主机名模式（例如 *.example.com）。模式仅适用于主机名；带架构的网址/来源必须是精确的字符串。组织可为无法部署 TLS 的旧版应用指定来源，或设置用于内部 Web 开发的预演服务器，这样开发者不必在预演服务器上部署 TLS 就能测试需要在安全上下文中运行的功能。此政策还可防止来源在地址栏中被标记为“不安全”。\n\n您可以在此政策中设置网址列表，也可以设置“--unsafely-treat-insecure-origin-as-secure”命令行 flag 并为其指定包含相同网址的逗号分隔列表，两种方法效果相同。此政策会覆盖该命令行 flag 和 UnsafelyTreatInsecureOriginAsSecure（若存在）。\n\n如需详细了解安全上下文，请参阅“安全上下文”(https://www.w3.org/TR/secure-contexts)。";
PartitionedBlobUrlUsage.pfm_title = "选择在提取和导航期间是否对 Blob 网址进行分区";
PartitionedBlobUrlUsage.pfm_description = "此政策用于控制在提取和导航期间是否对 Blob 网址进行分区。\n如果此政策已启用或未设置，Blob 网址将被分区。\n如果此政策已停用，则 Blob 网址不会分区。\n\n如果您必须使用此政策，请在 Brave 上提交 bug，说明使用情形。此政策的预定有效期会一直持续到 Brave 146 版，之后我们将移除旧版实现。\n\n注意：在浏览器运行期间，只有新启动的渲染程序进程才会反映对此政策的更改。\n\n如需详细了解第三方存储分区，请访问 https://developers.google.com/privacy-sandbox/cookies/storage-partitioning。";
PasswordDismissCompromisedAlertEnabled.pfm_title = "允许关闭针对所输入凭证的密码泄露警示";
PasswordDismissCompromisedAlertEnabled.pfm_description = "如果此政策已启用或未设置，系统会为用户提供选项，以便关闭/恢复密码泄露警示。\n\n如果此设置已停用，用户将无法关闭密码泄露警示。如果此设置已启用，用户将能够关闭密码泄露警示。";
PasswordLeakDetectionEnabled.pfm_title = "针对输入的凭据启用泄露检测功能";
PasswordLeakDetectionEnabled.pfm_description = "如果已启用此政策，用户便可让 Brave 检查所输入的用户名和密码是否已泄露。\n\n如果已停用此政策，用户将无法使用此功能。\n\n如果您设置了此政策，用户便无法在 Brave 中更改它。如果未设置此政策，系统会允许执行凭证泄露检查，但用户可关闭该功能。";
PasswordManagerBlocklist.pfm_title = "配置将停用Password Manager（保存和填充）的网域列表";
PasswordManagerBlocklist.pfm_description = "配置 Brave 应为哪些网域停用Password Manager。这意味着保存和填充工作流程将被停用，以确保无法保存这些网站的密码，也无法将这些网站的密码自动填充到网页表单中。\n\n如果某个网域在列表中，则系统会为该网域停用Password Manager。\n\n如果某个网域不在列表中，则该网域可以使用Password Manager。\n\n如果此政策未设置，则所有网域均可使用Password Manager。\n\n如需详细了解有效的 URL 格式，请访问 https://support.google.com/chrome/a?p=url_blocklist_filter_format。";
PasswordManagerEnabled.pfm_title = "允许将密码保存到密码管理工具";
PasswordManagerEnabled.pfm_description = "此政策用于控制浏览器能否自动记住网站上的密码并将其保存到内置的密码管理工具中。此政策不会限制访问或更改下述类型的密码内容：已保存到密码管理工具，且可能已同步到 Google 账号个人资料和 Android。\n\n如果此政策已启用，用户便可让 Brave 记住密码并在自己下次登录相应网站时提供密码。\n\n如果此政策已停用，用户将无法保存新密码，但先前保存的密码仍可正常使用。\n\n如果您设置了此政策，用户便无法在 Brave 中更改它。如果您未设置此政策，用户将能够关闭密码保存功能。";
PasswordManagerPasskeysEnabled.pfm_title = "允许将通行密钥保存到密码管理工具中";
PasswordManagerPasskeysEnabled.pfm_description = "此政策用于控制浏览器能否将通行密钥保存到内置的密码管理工具中。此政策不会限制对已保存在密码管理工具中的通行密钥的访问权限，也不会更改这些通行密钥的内容。一般来说，如果 PasswordManagerEnabled 政策已停用，则禁止将通行密钥和密码等保存到内置密码管理工具中，因此此政策不适用。\n\n如果相应政策已启用或未设置，则用户登录 Brave 后，便可将通行密钥保存到内置密码管理工具中。\n\n如果相应政策已停用，用户将无法把通行密钥保存到内置密码管理工具中，但先前保存的通行密钥仍可正常使用。";
PasswordProtectionChangePasswordURL.pfm_title = "配置用于更改密码的网址。";
PasswordProtectionChangePasswordURL.pfm_description = "通过设置此政策，您可以配置当浏览器显示警告后，供用户更改密码的网址。密码保护服务会将用户转到您通过此政策指定的网址（仅限 HTTP 和 HTTPS 协议）。为了使 Brave 能够在这个密码更改页面上正确捕获新密码的加盐哈希值，请确保该页面遵循了这些准则 (https://www.chromium.org/developers/design-documents/create-amazing-password-forms)。\n\n如果已停用或未设置此政策，该服务会将用户转到 https://myaccount.google.com，以便其更改密码。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
PasswordProtectionLoginURLs.pfm_title = "配置企业登录网址列表，以便密码保护服务从这些网址中捕获密码的加盐哈希值。";
PasswordProtectionLoginURLs.pfm_description = "通过设置此政策，您可以配置企业登录网址（仅限 HTTP 和 HTTPS 协议）列表。密码保护服务会在这些网址上捕获密码的加盐哈希值，用于检测密码重用情况。为了使 Brave 能够正确捕获密码的加盐哈希值，请确保登录页面遵循了这些准则 (https://www.chromium.org/developers/design-documents/create-amazing-password-forms)。\n\n如果已停用或未配置此设置，密码保护服务将仅在 https://accounts.google.com 上捕获密码的加盐哈希值。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
PasswordProtectionWarningTrigger.pfm_title = "密码保护服务警告功能触发条件";
PasswordProtectionWarningTrigger.pfm_description = "0 - 密码保护服务警告功能处于关闭状态\n1 - 重复使用密码可触发密码保护服务警告功能\n2 - 在网上诱骗网页中重复使用密码可触发密码保护服务警告功能\n通过设置此政策，您可以控制密码保护服务警告的触发条件。当用户在潜在的可疑网站上重复使用受保护的密码时，密码保护服务会向用户发出提醒。\n\n您可以使用 PasswordProtectionLoginURLs 和 PasswordProtectionChangePasswordURL 来设置要保护的密码。\n\n如果此政策设为：\n\n* PasswordProtectionWarningOff - 系统将一律不显示密码保护服务警告。\n\n* PasswordProtectionWarningOnPasswordReuse - 当用户在未列入许可名单的网站上重复使用受保护的密码时，系统将会显示密码保护服务警告。\n\n* PasswordProtectionWarningOnPhishingReuse - 当用户在网上诱骗性质的网站上重复使用受保护的密码时，系统将会显示密码保护服务警告。\n\n如果您不设置此政策，密码保护服务将只保护 Google 密码，但用户能够更改该设置。";
PasswordSharingEnabled.pfm_title = "允许与其他用户共享用户凭证";
PasswordSharingEnabled.pfm_description = "如果此政策已启用，用户即可与家庭服务中定义的家庭成员互相收发密码。\n如果此政策已启用或未设置，密码管理工具中会显示用于发送密码的按钮。\n收到的密码会存储在用户的账号中，并可在密码管理工具中查看。\n\n如果此政策已停用，用户将无法通过密码管理工具向其他用户发送密码，也无法接收其他用户发来的密码。\n\n如果关闭了密码同步功能（在用户设置中关闭或通过启用 SyncDisabled 政策关闭），则无法使用上述功能。\n\n受管理的账号无权加入或创建家人群组，因此无法分享密码。";
PaymentMethodQueryEnabled.pfm_title = "允许网站查询可用的付款方式。";
PaymentMethodQueryEnabled.pfm_description = "该政策让您能够设置是否允许网站检查用户有无已保存的付款方式。\n\n如果停用了此政策，使用 PaymentRequest.canMakePayment 或 PaymentRequest.hasEnrolledInstrument API 的网站将被告知没有可用的付款方式。\n\n如果启用了或未配置此设置，那么系统将允许网站检查用户有无已保存的付款方式。";
PdfAnnotationsEnabled.pfm_title = "启用 PDF 注释";
PdfAnnotationsEnabled.pfm_description = "控制 Brave 中的 PDF 查看器能否在 PDF 文件中添加注释。\n如果此政策未设置或设为 true，PDF 查看器便能在 PDF 文件中添加注释。\n\n如果此政策设为 false，PDF 查看器将无法在 PDF 文件中添加注释。";
PdfLocalFileAccessAllowedForDomains.pfm_title = "允许这些网站使用 PDF 查看器对 file:// 网址进行本地文件访问";
PdfLocalFileAccessAllowedForDomains.pfm_description = "如果设置此政策，系统会允许所列网域在 PDF 查看器中访问 file:// 网址。\n如果向此政策中添加网域，系统会允许该网域在 PDF 查看器中访问 file:// 网址。\n如果从此政策中移除网域，系统会禁止该网域在 PDF 查看器中访问 file:// 网址。\n如果此政策未设置，系统会禁止所有网域在 PDF 查看器中访问 file:// 网址。";
PdfUseSkiaRendererEnabled.pfm_title = "使用 Skia 渲染程序进行 PDF 渲染";
PdfUseSkiaRendererEnabled.pfm_description = "控制 Brave 中的 PDF 查看器是否会使用 Skia 渲染程序。\n\n如果此政策已启用，PDF 查看器会使用 Skia 渲染程序。\n\n如果此政策已停用，PDF 查看器会使用其当前的 AGG 渲染程序。\n\n如果此政策未设置，由浏览器选择使用哪种 PDF 渲染程序。";
PolicyAtomicGroupsEnabled.pfm_title = "启用政策原子组的概念";
PolicyAtomicGroupsEnabled.pfm_description = "如果此政策已启用，那么对于同一政策原子组，系统会忽略组内与具有最高优先级的政策不属于同一来源的政策。\n\n如果此政策已停用，任何政策都不会因来源而被忽略。系统仅会忽略与其他政策冲突且不具有最高优先级的政策。\n\n如果此政策是通过云端来源设定的，则无法应用于特定用户。";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "允许合并来自多个不同来源的字典政策";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - 受管理用户手动添加的例外网址\nDeviceLoginScreenPowerManagement - 登录屏幕的电源管理设置\nExtensionSettings - 扩展程序管理设置\nKeyPermissions - 密钥使用权限\nPowerManagementIdleSettings - 设备闲置时的电源管理设置\nScreenBrightnessPercent - 屏幕亮度百分比\nScreenLockDelays - 屏幕锁定延迟时间\n通过设置此政策，您可以允许合并来自多个不同来源并具有相同范围及级别的所选政策。这项合并操作会涵盖每个来源中的字典的第一级密钥。系统会优先应用来自优先级最高的来源的密钥。\n\n若要允许合并所有受支持的字典政策，请使用通配符“*”。\n\n如果某项政策位于列表中，而且来源之间存在冲突，\n\n* 但范围和级别都相同：相应的值会合并到一个新的政策字典中。\n\n* 但范围或级别不同：系统将会应用优先级最高的政策。\n\n如果某项政策不在列表中，而且来源、范围或级别之间存在冲突，系统将会应用优先级最高的政策。";
PolicyListMultipleSourceMergeList.pfm_title = "允许合并具有多个不同来源的列表政策";
PolicyListMultipleSourceMergeList.pfm_description = "通过设置此政策，您可以允许合并来自多个不同来源并具有相同范围及级别的所选政策。\n\n若要允许合并列表中的所有政策，请使用通配符“*”。\n\n如果某项政策位于列表中，而且来源之间存在冲突，\n\n* 但范围和级别都相同：相应的值会合并到一个新的政策列表中。\n\n* 但范围或级别不同：系统将会应用优先级最高的政策。\n\n如果某项政策不在列表中，而且来源、范围或级别之间存在冲突，系统将会应用优先级最高的政策。";
PolicyRefreshRate.pfm_title = "用户策略的更新频率";
PolicyRefreshRate.pfm_description = "通过设置此政策，您可以指定向设备管理服务查询用户政策信息的周期（以毫秒为单位）。有效值范围为 1800000（30 分钟）至 86400000（1 天）。此范围之外的值均会被相应地向上/向下舍入为邻近的限值。\n\n如果您未设置此政策，系统会使用默认值（3 小时）。\n\n注意：当此政策有变时，政策通知会强制进行刷新，因此您不必频繁刷新。如果平台支持此类通知，刷新延迟时间将为 24 小时（忽略默认值和此政策的值）。";
PopupsAllowedForUrls.pfm_title = "允许这些网站显示弹出式窗口";
PopupsAllowedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，用于指定哪些网站可以打开弹出式窗口。\n\n未设置此政策时，如果 DefaultPopupsSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
PopupsBlockedForUrls.pfm_title = "禁止这些网站显示弹出式窗口";
PopupsBlockedForUrls.pfm_description = "通过设置此政策，您可以设置一个网址格式列表，从而指定哪些网站无法打开弹出式窗口。\n\n未设置此政策时，如果已设置 DefaultPopupsSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
PreciseGeolocationAllowedForUrls.pfm_title = "允许在这些网站上获取精确地理位置信息";
PreciseGeolocationAllowedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，指定哪些网站无需先请求用户授权即可访问用户的高精确度地理位置信息。\n未设置此政策时，如果已设置 DefaultGeolocationSetting，系统会对所有网站应用该默认设置，否则会应用用户的个人设置。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
PreferSlowCiphers.pfm_title = "首选特定的 TLS 加密算法";
PreferSlowCiphers.pfm_description = "cnsa - 首选满足 CNSA 1.0 和 2.0 要求的加密算法\ndefault - 使用 Brave 的默认加密算法顺序\n此政策旨在配置 Brave，使其对 TLS 1.3 中的首选加密算法进行排序，以反映对特定合规制度所批准的算法的偏好程度。\n\n设置此政策并不能保证系统会协商使用任何特定算法。\n\n此政策旨在帮助希望同时支持有无合规要求的客户端的服务器运营商区分这两类客户端，并且只有当客户端明确配置为偏好某些加密强度更高的非默认算法时，服务器才会对其启用这些算法。\n\n将此政策设为“cnsa”后，Brave 将优先采用符合商业国家安全算法套件 1.0 和 2.0 版（CNSA 1.0 和 2.0）要求的加密算法。\n\n如果不设置此政策，或将其设为“default”，Brave 将使用其默认加密算法。\n\n设置此政策并非安全方面的必要措施。Brave 使用的默认加密技术非常强大，足以抵御利用整个太阳的能量进行的暴力破解攻击。\n\n设置此政策会导致 Brave 在访问网站时速度变慢。\n\n此政策仅影响 TLS 1.3 和 QUIC，不会影响早期版本的 TLS。\n\n您可针对设备和用户设置此政策。如果是针对用户设置，则此政策只会影响由用户个人资料发起的网络请求，可能不会影响 Brave 为在整个浏览器中执行后台任务而发起的网络请求；这些均由设备级别的值控制。如果同时在设备级别和用户级别设置此政策，除非 CloudUserPolicyOverridesCloudMachinePolicy 政策更改了政策优先级顺序，否则系统会应用设备级别的值。\n\n对于 155 及更低版本，此政策仅在设备级别有效。";
PreferSlowKexAlgorithms.pfm_title = "首选特定的 TLS 密钥交换算法";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - 首选满足 CNSA 2.0 要求的密钥交换方法\ndefault - 使用 Brave 的默认支持群组\n此政策旨在配置 Brave，使其对 TLS 1.3 中的首选密钥协议算法（受支持的群组）进行排序，以反映对特定合规制度所批准算法的偏好。\n\n设置此政策并不能保证系统会协商使用任何特定算法。\n\n此政策旨在帮助希望同时支持有无合规要求的客户端的服务器运营商区分这两类客户端，并且只有当客户端明确配置为偏好某些加密强度更高的非默认算法时，服务器才会对其启用这些算法。\n\n将此政策设为“cnsa2”后，Brave 将优先采用符合商业国家安全算法套件 2.0 (CNSA 2.0) 要求的密钥交换方法。\n\n如果不设置此政策，或将其设为“default”，Brave 将使用其默认密钥交换方法。\n\n设置此政策并非安全方面的必要措施。Brave 使用的默认加密技术非常强大，足以抵御利用整个太阳的能量进行的暴力破解攻击。\n\n设置此政策会导致 Brave 在访问网站时速度变慢。\n\n此政策仅影响 TLS 1.3 和 QUIC，不会影响早期版本的 TLS。\n\n您可针对设备和用户设置此政策。如果是针对用户设置，则此政策只会影响由用户个人资料发起的网络请求，可能不会影响 Brave 为在整个浏览器中执行后台任务而发起的网络请求；这些均由设备级别的值控制。如果同时在设备级别和用户级别设置此政策，除非 CloudUserPolicyOverridesCloudMachinePolicy 政策更改了政策优先级顺序，否则系统会应用设备级别的值。\n\n对于 155 及更低版本，此政策仅在设备级别有效。";
PrefetchWithServiceWorkerEnabled.pfm_title = "允许将 SpeculationRules 预提取发送到由 ServiceWorker 控制的网址";
PrefetchWithServiceWorkerEnabled.pfm_description = "SpeculationRules 预提取可发送到由 ServiceWorker 控制的网址。但是，旧版代码不允许这样做，并取消了预提取请求。此政策可用于控制该行为。\n\n如果此政策已启用或未设置，系统会允许将 SpeculationRules 预提取发送到由 ServiceWorker 控制的网址（如果 PrefetchServiceWorker 功能标志已启用）。这是当前的默认行为，与规范一致。\n\n如果此政策已停用，系统将禁止将 SpeculationRules 预提取发送到由 ServiceWorker 控制的网址。这是旧版行为。\n\n此政策只是暂时性措施，日后会被移除。";
PrintHeaderFooter.pfm_title = "打印页眉和页脚";
PrintHeaderFooter.pfm_description = "如果此政策已启用，系统会在打印预览中开启页眉和页脚。如果此政策已停用，系统会在打印预览中关闭页眉和页脚。\n\n如果您设置了此政策，用户便无法更改相关设置。如果您未设置此政策，用户可以决定是否显示页眉和页脚。";
PrintPdfAsImageAvailability.pfm_title = "提供“以图片形式打印 PDF 文件”选项";
PrintPdfAsImageAvailability.pfm_description = "控制 Brave 如何在 Microsoft® Windows® 和 macOS 上提供“以图片形式打印”选项来打印 PDF。\n\n如果在 Microsoft® Windows® 或 macOS 上打印 PDF，某些打印机有时需要将打印任务光栅化为图片，才能输出正确的结果。\n\n如果此政策已启用，在打印 PDF 时，Brave 将在“打印预览”对话框中提供“以图片形式打印”选项。\n\n如果此政策已停用或未设置，Brave 将不会在“打印预览”对话框中向用户提供“以图片形式打印”选项，PDF 将会像平常一样打印，而不会在发送到目标打印机之前光栅化为图片。";
PrintPdfAsImageDefault.pfm_title = "默认以图片形式打印 PDF 文件";
PrintPdfAsImageDefault.pfm_description = "控制 Brave 是否会在打印 PDF 文档时默认选中“以图片形式打印”选项。\n\n如果此政策已启用，当打印 PDF 文档时，Brave 会在“打印预览”对话框中默认选中“以图片形式打印”选项。\n\n如果此政策已停用或未设置，Brave 最初不会为用户选中“以图片形式打印”选项。用户将能够为各个 PDF 打印任务选择该选项（若有）。\n\n对于 Microsoft® Windows® 或 macOS，此政策仅在也启用了 PrintPdfAsImageAvailability 的情况下有效。";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "使用系统默认打印机作为默认选项";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "如果此政策已启用，Brave 会在进行打印预览时将操作系统默认打印机用作默认目标。\n\n如果此政策已停用或未设置，Brave 会在进行打印预览时将上次使用的打印机用作默认目标。";
PrintRasterizePdfDpi.pfm_title = "打印光栅化的 PDF DPI";
PrintRasterizePdfDpi.pfm_description = "控制 Brave 以光栅化模式打印 PDF 时的打印图片分辨率。\n\n使用“以图片形式打印”选项打印 PDF 时，不妨指定与设备的打印机设置或 PDF 默认值不同的打印分辨率，因为这样做可能会大有裨益。高分辨率会显著增加处理和打印用时，低分辨率则可能会导致图片质量不佳。\n\n此政策允许设置特定分辨率，以用于在打印之前进行 PDF 光栅化。\n\n如果此政策设为零或根本未设置，系统将在对网页图片进行光栅化时使用系统默认分辨率。";
PrinterTypeDenyList.pfm_title = "禁用拒绝列表中的打印机类型";
PrinterTypeDenyList.pfm_description = "privet - 基于零配置 (mDNS + DNS-SD) 的协议目的地（已弃用）\nextension - 基于扩展程序的目的地\npdf - “另存为 PDF”目的地和 Google Chrome OS 设备上的“保存到 Google 云端硬盘”目的地\nlocal - 本地打印机目的地\ncloud - Google Cloud Print（已弃用）\n已在拒绝列表中的各类打印机将被停用，因此用户将无法发现或使用它们。\n\n将所有打印机类型都添加到拒绝列表中相当于停用打印功能，因为没有任何可用来接收要打印的文档的目的地。\n\n在 102 之前的版本中，在拒绝列表中添加“cloud”与将 CloudPrintSubmitEnabled 政策设为 false 具有同样的效果。若要使 Google Cloud Print目的地能被用户发现，则必须确保 CloudPrintSubmitEnabled 政策设为 true 且拒绝列表中不含“cloud”。从版本 102 开始，Google Cloud Print目的地将不再受支持，而且无论政策值为多少都不会显示。\n\n如果此政策未设置或设为一个空列表，那么所有打印机类型都将能被用户发现。\n\n基于扩展程序的打印机也称为打印提供程序目的地，包括 Brave 扩展程序名下的所有目的地。\n\n本地打印机也称为本机打印目的地，包括可供本地计算机使用的目的地以及共享的网络打印机。";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "限制背景图片打印模式";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - 始终允许打印（无论是否有背景图片）\nenabled - 仅允许在有背景图片的情况下打印\ndisabled - 仅允许在没有背景图片的情况下打印\n限制背景图片打印模式。不设置此政策将被视为无限制。";
PrintingBackgroundGraphicsDefault.pfm_title = "默认背景图片打印模式";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - 默认启用背景图片打印模式\ndisabled - 默认停用背景图片打印模式\n覆盖默认背景图片打印模式。";
PrintingEnabled.pfm_title = "启用打印功能";
PrintingEnabled.pfm_description = "如果此政策已启用或未设置，用户便可在 Brave 中使用打印功能，但无法更改相关设置。\n\n如果此政策已停用，用户将无法通过 Brave 进行打印。在三点状菜单、扩展程序和 JavaScript 应用中，打印功能处于关闭状态。";
PrintingPaperSizeDefault.pfm_title = "默认打印页面大小";
PrintingPaperSizeDefault.pfm_description = "替换默认打印页面大小。\n\nname 应包含所列格式之一，如果所需页面大小不在列表中，则应包含“custom”值。如果提供了“custom”值，则应指定 custom_size 属性，用于指定所需的高度和宽度（以微米为单位）。如果未提供“custom”值，便不应指定 custom_size 属性。系统会忽略违反这些规则的政策。\n\n如果这一页面大小在用户选择的打印机上不适用，系统会忽略此政策。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault。";
ProfilePickerOnStartupAvailability.pfm_title = "在 Chrome 启动时是否显示个人资料选择器";
ProfilePickerOnStartupAvailability.pfm_description = "0 - 在浏览器启动时显示个人资料选择器\n1 - 在浏览器启动时停用个人资料选择器\n2 - 在浏览器启动时强制显示个人资料选择器\n此政策用于指定在浏览器启动时是启用、停用还是强制显示个人资料选择器。\n\n在以下情况下，系统会默认不显示个人资料选择器：浏览器在访客模式或无痕模式下启动；个人资料目录和/或网址由命令行指定；用户已明确请求打开某个应用；用户从本地通知中启动了浏览器；只有 1 份可用的个人资料；ForceBrowserSignin 政策设为 true。\n\n如果您选择了“已启用”(0) 或未设置此政策，系统会默认在浏览器启动时显示个人资料选择器，但用户将能够启用/停用它。\n\n如果您选择了“已停用”(1)，系统会始终不显示个人资料选择器，而且用户将无法更改相关设置。\n\n如果您选择了“强制”(2)，用户将无法禁止显示个人资料选择器，即使只有 1 份可用的个人资料也是如此。";
ProfileReauthPrompt.pfm_title = "提示用户重新向个人资料验证身份";
ProfileReauthPrompt.pfm_description = "0 - 不提示重新验证身份\n1 - 在标签页中提示重新验证身份\n如果此政策设为 DoNotPrompt 或未设置，Brave 不会自动提示用户重新向浏览器验证身份。\n\n如果此政策设为 PromptInTab，当用户的身份验证到期时，系统会立即在新标签页中打开 Google 登录页面。这种情况仅发生于使用 Chrome Sync时。";
ProfileSeparationDomainExceptionList.pfm_title = "企业资料分离辅助网域许可名单";
ProfileSeparationDomainExceptionList.pfm_description = "如果此政策未设置，对于任何网域，用户无需登录账号即可新建单独的个人资料。\n\n如果此政策已设置，对于政策中罗列的网域，用户无需登录账号即可新建单独的个人资料。\n\n此政策可设为一个空字符串，在这种情况下，对于任何网域，用户都需要登录账号才能新建单独的个人资料。";
PromotionsEnabled.pfm_title = "允许显示推广内容";
PromotionsEnabled.pfm_description = "如果此政策设为 True 或未设置，Brave 会向用户显示产品推广内容。\n\n如果此政策设为 False，Brave 不会显示产品推广内容。\n\n设置此政策可控制如何显示推广内容（包括有助于用户登录 Brave 的欢迎页面），将 Brave 设置为用户的默认浏览器，或者以其他方式向用户介绍产品功能。";
PromptForDownloadLocation.pfm_title = "下载前询问每个文件的保存位置";
PromptForDownloadLocation.pfm_description = "如果此政策已启用，系统会在开始下载前询问用户要将相应文件保存到何处。如果此政策已停用，系统不会先询问用户要将相应文件保存到何处，而是会立即开始下载文件。\n\n如果您不设置此政策，用户便可更改此设置。";
PromptOnMultipleMatchingCertificates.pfm_title = "有多份证书匹配时发出提示";
PromptOnMultipleMatchingCertificates.pfm_description = "此政策旨在控制是否让系统在有多个证书与 AutoSelectCertificateForUrls 匹配时提示用户选择客户端证书。\n如果此政策已启用，每当自动选择政策与多个证书匹配时，系统都会提示用户选择客户端证书。\n如果此政策已停用或未设置，只有当无任何证书与自动选择政策匹配时，系统才会提示用户。";
ProxySettings.pfm_title = "代理设置";
ProxySettings.pfm_description = "通过设置此政策，您可为 Chrome 和 ARC 应用配置代理设置，它们会忽略从命令行中指定的所有与代理有关的选项。\n\n如果您未设置此政策，用户便可自行选择代理设置。\n\n设置 ProxySettings 政策时，可以使用以下字段：\n\n* ProxyMode，用于指定 Chrome 使用的代理服务器，并防止用户更改代理设置\n\n* ProxyPacUrl，即代理 .pac 文件的网址，或以 MIME 类型 application/x-ns-proxy-autoconfig 编码为数据网址的 PAC 脚本\n\n* ProxyPacMandatory，用于防止网络栈回退到带有无效或不可用 PAC 脚本的直接连接\n\n* ProxyServer，即代理服务器的网址\n\n* ProxyBypassList，即将要绕过代理的主机列表\n\nProxyServerMode 字段已弃用，请改用 ProxyMode 字段。对于 ProxyMode，如果您选择以下值：\n\n* direct - 系统永远不会使用代理，并且会忽略所有其他字段。\n\n* system - 系统会使用自己的代理，并且会忽略所有其他字段。\n\n* auto_detect - 系统会忽略所有其他字段。\n\n* fixed_servers - 系统会使用 ProxyServer 和 ProxyBypassList 字段。\n\n* pac_script - 系统会使用 ProxyPacUrl、ProxyPacMandatory 和 ProxyBypassList 字段。\n\n注意：如需查看更详细的示例，请访问 Chromium 项目 (https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings)。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=ProxySettings。";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "启用二维码生成器";
QRCodeGeneratorEnabled.pfm_description = "此政策用于在 Brave 中启用二维码生成器功能。\n\n如果您启用此政策或未对其进行配置，系统会启用二维码生成器功能。\n\n如果您停用此政策，系统会停用二维码生成器功能。";
QuicAllowed.pfm_title = "允许使用 QUIC 协议";
QuicAllowed.pfm_description = "如果此政策已启用或未设置，系统将允许在 Brave 中使用 QUIC 协议。\n\n如果此政策已停用，系统将禁止使用 QUIC 协议。";
RegisteredProtocolHandlers.pfm_title = "注册协议处理程序";
RegisteredProtocolHandlers.pfm_description = "通过设置此政策（仅为建议性政策），您可以注册一个协议处理程序列表以与用户注册的协议处理程序列表合并，从而同时使用这两组协议处理程序。“protocol”属性应设为“mailto”之类的协议，“URL”属性应设为处理相应协议（“protocol”字段中指定的协议）的应用所采用的网址格式。该格式可以包含一个“%s”占位符（将会替换为被处理的网址）。\n\n用户无法卸载由政策注册的协议处理程序，但可通过安装新的默认处理程序来更改由政策安装的协议处理程序。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers。";
RelaunchFastIfOutdated.pfm_title = "时间段（天）";
RelaunchFastIfOutdated.pfm_description = "指定最短发布期限，如果超过此期限，重新启动通知会更频繁。系统会以当前正在运行的版本上次提供给客户端的时间为起点来计算此期限。\n\n如果重新启动浏览器或重启设备是完成待处理更新所必需的条件，并且当前版本的已过期时间超过此设置中指定的天数，则 RelaunchNotificationPeriod 政策将被覆盖并设为 2 小时。如果 RelaunchNotification 政策设为 1（“必需”），系统将在该时间段结束时强制重新启动或重启。\n\n如果此政策未经设置或无法确定发布期限，系统会将 RelaunchNotificationPeriod 政策应用于所有更新。";
RelaunchNotification.pfm_title = "系统建议或要求重新启动浏览器或重启设备时，通知用户";
RelaunchNotification.pfm_description = "1 - 显示建议用户重新启动浏览器的周期性提示\n2 - 显示要求用户重新启动浏览器的周期性提示\n必须重新启动 Brave 或必须重启 Google Chrome OS以应用待应用的更新时，通知用户。\n\n此政策设置用于启用通知功能，以便在系统建议或要求重新启动浏览器或重启设备时，通知用户。如果此政策未设置，当需要重新启动时，Brave 会通过菜单的细微变化来提示用户，而 Google Chrome OS则会通过系统任务栏中的通知来提示用户。如果此政策设为“推荐”，当建议重新启动浏览器时，系统将会显示周期性警告。用户可以关闭该警告来推迟重新启动。如果此政策设为“必需”，系统将会显示周期性警告，以便让用户知道系统将于通知时间段过后立即强制重新启动浏览器。对于 Brave，通知时间段会默认设为 7 天，对于 Google Chrome OS，则会默认设为 4 天，不过可以通过 RelaunchNotificationPeriod 政策设置进行配置。\n\n浏览器重新启动/设备重启后，将会恢复用户会话。";
RelaunchNotificationPeriod.pfm_title = "时间段（毫秒）";
RelaunchNotificationPeriod.pfm_description = "您可以设置一个时间段（以毫秒为单位），在该时间段内，系统会通知用户必须重新启动 Brave 或重启 Google Chrome OS设备以安装更新。\n\n在该时间段内，系统会反复通知用户需要更新。对于 Google Chrome OS设备，系统会根据 RelaunchHeadsUpPeriod 政策在系统任务栏中显示重启通知。对于 Brave 浏览器，在通知时间段过去三分之一后，应用菜单会发生变化，示意需要重启浏览器。此通知会在通知时间段过去三分之二后改变颜色，并会在时间段结束后再次改变颜色。由 RelaunchNotification 政策引发的其他通知也会遵循这一规律。\n\n如果未做设置，系统会使用默认通知时间段，即 604800000 毫秒（1 周）。";
RelaunchWindow.pfm_title = "重新启动时间范围";
RelaunchWindow.pfm_description = "为重新启动通知时间段的结束指定目标时间范围。\n\n系统会根据 RelaunchNotification 和 RelaunchNotificationPeriod 政策设置向用户发送通知，指明他们需要重新启动浏览器或重启设备。如果 RelaunchNotification 政策设为“必需”，系统会在通知时间段结束时强制重启浏览器和设备。此 RelaunchWindow 政策可用于将通知时间段的结束时间推迟至特定的时间范围内。\n\n如果此政策未设置，Google Chrome OS的默认目标时间范围会是凌晨 2 点到 4 点之间，而 Brave 的默认目标时间范围会是全天（即，一律不推迟通知时间段的结束时间）。\n\n注意：虽然此政策可以接受“entries”中的多个项，但除第一项之外的所有其他项都会被忽略。\n警告：设置此政策可能会延迟应用软件更新。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=RelaunchWindow。";
RemoteAccessHostAllowClientPairing.pfm_title = "针对远程访问主机启用或停用无 PIN 码身份验证";
RemoteAccessHostAllowClientPairing.pfm_description = "如果此政策已启用或未设置，用户便可让客户端和主机在连接时自动配对，无需每次都输入 PIN 码。\n\n如果此政策已停用，用户则无法使用该功能。";
RemoteAccessHostAllowFileTransfer.pfm_title = "允许远程访问用户将文件传到主机或接收从主机传出的文件";
RemoteAccessHostAllowFileTransfer.pfm_description = "如果此政策已启用或未设置，用户便能连接到远程访问主机以在客户端和主机之间传输文件。此政策不适用于远程协助连接，因为这类连接不支持文件传输。\n\n如果此政策已停用，系统将禁止传输文件。";
RemoteAccessHostAllowPinAuthentication.pfm_title = "允许远程访问主机使用 PIN 码和配对身份验证方法";
RemoteAccessHostAllowPinAuthentication.pfm_description = "如果此政策已启用，系统会允许远程访问主机在接受客户端连接时使用 PIN 码和配对身份验证方法。\n\n如果此政策已停用，系统将禁止使用 PIN 码或配对身份验证方法。\n\n如果此政策未设置，主机将决定能否使用 PIN 码和/或配对身份验证方法。\n\n注意：如果此设置导致没有主机和客户端共同支持的身份验证方法，则系统将拒绝连接。";
RemoteAccessHostAllowRelayedConnection.pfm_title = "允许远程访问主机使用中继服务器";
RemoteAccessHostAllowRelayedConnection.pfm_description = "如果 RemoteAccessHostFirewallTraversal 已启用且 RemoteAccessHostAllowRelayedConnection 已启用或未设置，当无法（例如，因受到防火墙限制）直接连接到这台计算机时，远程客户端可通过中继服务器建立连接。\n\n如果此政策已停用，系统将不会关闭远程访问功能，但只接受从同一网络内（而非通过 NAT 穿越或中继）发起的连接。";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "允许与这台计算机建立远程访问连接";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "如果此政策已停用，系统将无法启动远程访问主机服务，也无法将该服务配置为接受传入连接。此政策不影响远程支持场景。\n\n如果已启用、留空或未设置，此政策将不会产生任何影响。";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "允许与这台计算机建立远程支持连接";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "如果停用此政策，将无法启动远程支持主机，也无法将该主机配置为接受传入连接。\n\n此政策不会影响远程访问场景。\n\n此政策不会阻止企业管理员连接到受管 Google Chrome OS 设备。\n\n启用、留空或未设置此政策时，它不会产生任何影响。";
RemoteAccessHostAllowUrlForwarding.pfm_title = "允许远程访问用户在本地客户端浏览器中打开主机端网址";
RemoteAccessHostAllowUrlForwarding.pfm_description = "如果此政策已启用或未设置，连接到远程访问主机的用户便可在本地客户端浏览器中打开主机端网址。\n\n如果此政策已停用，系统将禁止该远程访问主机向客户端发送网址。\n\n此设置不适用于远程协助连接，因为相应连接模式不支持该功能。\n\n注意：此功能尚未正式发布，因此启用该功能并不意味着该功能会显示在客户端界面中。";
RemoteAccessHostClientDomainList.pfm_title = "为远程访问客户端配置所需的域名";
RemoteAccessHostClientDomainList.pfm_description = "通过设置此政策，您可指定客户端域名以限制远程访问客户端，而且用户无法更改相关设置。只有来自这些指定域名的客户端才能连接到主机。\n\n如果您将此政策设为一个空列表或未设置此政策，系统会采用相应连接类型的默认政策。对于远程协助，来自任何域名的客户端都可连接到主机；对于无时间限制的远程访问，只有主机所有者可以连接到主机。\n\n另请参阅 RemoteAccessHostDomainList。\n\n注意：此设置会覆盖 RemoteAccessHostClientDomain（若已设置）。";
RemoteAccessHostClipboardSizeBytes.pfm_title = "可通过剪贴板同步功能在客户端和主机之间传输的数据的大小上限（以字节为单位）";
RemoteAccessHostClipboardSizeBytes.pfm_description = "如果您设置了此政策，向/由相应主机发送的剪贴板数据将会被截断，以符合此政策设定的限值。\n\n如果所设值为 0，剪贴板同步功能会被停用。\n\n此政策既会影响远程访问情形，也会影响远程支持情形。\n\n如果未设置，此政策将不会产生任何影响。\n\n如果您为此政策指定的值不在下限值/上限值范围内，则可能会导致相应主机无法启动。\n\n请注意，剪贴板数据大小的实际上限取决于不受此政策控制的 WebRTC 数据通道消息大小上限。";
RemoteAccessHostDomainList.pfm_title = "为远程访问主机配置所需的域名";
RemoteAccessHostDomainList.pfm_description = "通过设置此政策，您可指定主机域名以限制远程访问主机，而且用户无法更改相关设置。仅当使用在这些指定域名注册的账号时，主机才会接受远程访问。\n\n如果您将此政策设为一个空列表或未设置此政策，则无论使用什么账号，主机都会接受远程访问。\n\n另请参阅 RemoteAccessHostClientDomainList。\n\n注意：此设置会覆盖 RemoteAccessHostDomain（若已设置）。";
RemoteAccessHostFirewallTraversal.pfm_title = "支持通过远程访问主机穿越防火墙";
RemoteAccessHostFirewallTraversal.pfm_description = "如果此政策已启用或未设置，系统会允许使用 STUN 服务器，以便远程客户端（即使受到防火墙阻隔）能够发现和连接到这台计算机。\n\n如果此政策已停用，而且防火墙会阻止出站 UDP 连接，则这台计算机将只接受由本地网络内的客户端计算机发起的连接。";
RemoteAccessHostMatchUsername.pfm_title = "要求本地用户的名称和远程访问主机所有者的名称必须一致";
RemoteAccessHostMatchUsername.pfm_description = "如果此政策已启用，远程访问主机会对比这两个名称：与主机关联的本地用户的名称，以及注册为主机所有者的 Google 账号的名称（如果主机归“johndoe@example.com”所有，Google 账号的名称就是“johndoe”）。如果主机所有者的名称不同于与主机关联的本地用户的名称，该主机将不会启动。若要强制将所有者的 Google 账号与特定网域关联，请将此政策与 RemoteAccessHostDomain 搭配使用。\n\n如果此政策已停用或未设置，远程访问主机便能与任何本地用户关联。";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "远程访问连接可达到的会话时长上限";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "如果您设置了此政策，当会话时长达到此政策中指定的分钟数之后，远程访问连接将会自动断开。这不会阻止客户端在达到会话时长上限后重新建立连接。如果您为此政策指定的值不在下限值/上限值范围内，主机可能会因此无法启动。此政策不影响远程支持场景。\n\n如果未设置，此政策将不会产生任何影响。在这种情况下，此计算机上的远程访问连接将不会受到任何时长上限的制约。";
RemoteAccessHostRequireCurtain.pfm_title = "启用远程访问主机的屏蔽设置";
RemoteAccessHostRequireCurtain.pfm_description = "如果此政策已启用，在远程连接期间，系统会关闭远程访问主机的物理输入和输出设备。\n\n如果此政策已停用或未设置，本地用户和远程用户都能在访问期间与远程访问主机交互。";
RemoteAccessHostUdpPortRange.pfm_title = "限制远程访问主机使用的UDP端口范围";
RemoteAccessHostUdpPortRange.pfm_description = "通过设置此政策，您可以限制远程访问主机在这台计算机上使用的 UDP 端口范围。\n\n如果此政策未设置或设为空字符串，远程访问主机便能使用任意可用端口。\n\n注意：如果 RemoteAccessHostFirewallTraversal 已停用，远程访问主机将使用 12400-12409 范围内的 UDP 端口。";
RemoteDebuggingAllowed.pfm_title = "允许进行远程调试";
RemoteDebuggingAllowed.pfm_description = "控制用户是否可以进行远程调试。\n\n如果此政策已启用或未设置，用户便可以通过在桌面平台上指定 --remote-debugging-port 和 --remote-debugging-pipe 命令行开关，或在 Android 上启用 USB 调试系统设置，来进行远程调试。\n\n如果此政策已停用，用户将无法进行远程调试。";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "要求为本地信任锚执行在线 OCSP/CRL 检查";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "如果此政策设为 True，对于已成功通过验证且已由安装在本地的 CA 证书签名的服务器证书，Brave 始终会执行撤消状态检查。如果 Brave 无法获取撤消状态信息，Brave 会将此类证书视为已撤消（硬性失败）。\n\n如果此政策设为 False 或未设置，Brave 会使用现有的在线撤消状态检查设置。\n\n在 macOS 上，如果 ChromeRootStoreEnabled 政策设为 False，此政策不会产生任何影响。";
RestoreOnStartup.pfm_title = "启动时的操作";
RestoreOnStartup.pfm_description = "5 - 打开新标签页\n1 - 恢复上次的会话\n4 - 打开网址列表\n6 - 打开一系列网址并恢复上次的会话\n通过设置此政策，您可以指定 Chrome 启动时的系统行为。关闭此设置相当于未设置，因为 Brave 必须有指定的启动行为。\n\n如果您设置了此政策，用户将无法在 Brave 中更改它。如果未设置此政策，用户便可自行更改它。\n\n如果此政策设为 RestoreOnStartupIsLastSession 或 RestoreOnStartupIsLastSessionAndURLs，某些依赖于会话的设置或在退出时执行操作的设置（例如：退出时清除浏览数据或仅在会话期间有效的 Cookie）就会关闭。\n\n如果此政策设为 RestoreOnStartupIsLastSessionAndURLs，浏览器将会恢复上一个会话并打开一个单独的窗口，以显示通过 RestoreOnStartupURLs 设置的网址。请注意，用户可以选择让这些网址保持打开状态，它们也会在未来的会话中恢复。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
RestoreOnStartupURLs.pfm_title = "启动时打开的网址";
RestoreOnStartupURLs.pfm_description = "如果 RestoreOnStartup 设为 RestoreOnStartupIsURLs，那么可以将 RestoreOnStartupURLs 设置为网址列表，以指定 Chrome 启动时会打开哪些网址。\n\n如果未设置此政策，Chrome 启动时会打开“新标签页”页面。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过移动设备管理 (MDM) 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "限制从 Service Worker 调用 Background Fetch API";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "此政策用于控制是否限制来自 Service Worker 的后台提取请求。如果某项在后台下载文件的功能受到影响，此政策可能适用。\n\n如果此政策已启用或未设置，该限制将生效，系统可能会屏蔽来自 Service Worker 上下文的后台提取请求。\n\n如果此政策已停用，系统会绕过限制，允许所有 Service Worker 发出后台提取请求。\n\n这项企业政策只是暂时性政策，将在 M152 之后移除。";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "仅允许符合条件的 Google 账号通过 Brave PDF 查看器将 PDF 文件保存到 Google 云端硬盘";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "此政策包含一个正则表达式，用于确定哪些 Google 账号符合条件，可通过 Brave PDF 查看器将 PDF 文件保存到 Google 云端硬盘。\n\n如果用户尝试使用不符合条件的账号将 PDF 文件上传到 Google 云端硬盘，则系统会显示错误。\n\n如果未设置此政策或此政策为空，则用户可使用任何 Google 账号将 PDF 文件保存到 Google 云端硬盘。";
RestrictSigninToPattern.pfm_title = "限制哪些 Google 账号可以设置为 Brave 中的浏览器主账号";
RestrictSigninToPattern.pfm_description = "这项政策包含一个正则表达式，用于决定哪些 Google 账号可以设定为 Brave 中的浏览器主账号（也就是在同步功能启用流程中所选的账号）。\n\n如果用户尝试使用与此格式不匹配的用户名设置浏览器主账号，就会显示相应错误。\n\n如果此政策未设置或为空，则用户可以将任何 Google 账号设置为 Brave 中的浏览器主账号。";
RestrictYouTubeCookiesDeletion.pfm_title = "限制 YouTube Cookie 的删除";
RestrictYouTubeCookiesDeletion.pfm_description = "防止手动删除 YouTube Cookie。\n\n此政策旨在防止用户从网站设置页面手动清除 YouTube Cookie 后，访问未经授权的 YouTube。\n\n如果启用此政策，系统会阻止用户手动删除 YouTube Cookie。\n\n如果停用此政策或不设置任何值，系统会允许用户正常删除 YouTube Cookie。\n\n注意：此政策仅能阻止从网站设置界面中手动删除，而不会阻止通过 ClearBrowsingDataOnExitList 或 BrowsingDataLifetime 政策自动删除。此外，如果您启用了 AllowDeletingBrowserHistory 政策，则用户仍可通过“清除浏览数据”对话框清除所有 Cookie。";
SSLErrorOverrideAllowed.pfm_title = "允许关闭 SSL 警告页面并继续操作";
SSLErrorOverrideAllowed.pfm_description = "如果此政策已启用或未设置，则用户在访问含 SSL 错误的网站时，可点击 Brave 显示的警告页面并浏览该网站。\n\n如果此政策已停用，用户将无法点击任何警告页面。";
SSLErrorOverrideAllowedForOrigins.pfm_title = "允许从特定来源上的 SSL 警告页面继续操作";
SSLErrorOverrideAllowedForOrigins.pfm_description = "如果 SSLErrorOverrideAllowed 已停用，您可通过设置此政策创建一个源格式列表，指定在哪些存在 SSL 错误的网站上，用户可点击 Brave 显示的警告页面来继续浏览相应网站。如果用户访问的源不在此列表中，他们将无法点击该源上的 SSL 警告页面继续浏览。\n\n如果 SSLErrorOverrideAllowed 已启用或未设置，则此政策不会起作用。\n\n如果您未设置此政策，系统会将 SSLErrorOverrideAllowed 应用于所有网站。\n\n如需详细了解有效的输入格式，请访问 https://chromeenterprise.google/policies/url-patterns/。* 不是此政策可接受的值。此政策只会根据源进行匹配，因此网址格式中的所有路径都会被忽略。";
SafeBrowsingAllowlistDomains.pfm_title = "配置安全浏览功能在哪些网域中不会触发警告。";
SafeBrowsingAllowlistDomains.pfm_description = "如果已启用此政策，“安全浏览”功能将会信任您指定的网域。此功能将不会检查这类网域是否含有危险资源，例如钓鱼式攻击、恶意软件或垃圾软件。“安全浏览”功能的下载保护服务将不会检查托管在这类网域上的下载内容。此功能的密码保护服务将不会检查密码重用情况。\n\n如果未设置此政策，系统便会将默认开启的“安全浏览”保护功能应用于所有资源。\n\n此政策不支持正则表达式，但会将指定网域的子网域列入许可名单。完全限定域名 (FQDN) 不是必需项。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。";
SafeBrowsingDeepScanningEnabled.pfm_title = "允许对已启用安全浏览功能的用户所下载的内容进行深度扫描";
SafeBrowsingDeepScanningEnabled.pfm_description = "如果已启用或未设置此政策，当已启用安全浏览功能的用户下载可疑内容时，Brave 可将相应内容发送给 Google 以便扫描是否有恶意软件，或者提示用户提供加密归档文件的密码。\n如果已停用此政策，系统将不会执行这项扫描。\n此政策不会影响 Chrome 企业版接口所配置的下载内容分析。";
SafeBrowsingProtectionLevel.pfm_title = "“安全浏览”功能的保护级别";
SafeBrowsingProtectionLevel.pfm_description = "0 - “安全浏览”功能会一直处于关闭状态。\n1 - “安全浏览”功能会处于开启状态且会在标准模式下运行。\n2 - “安全浏览”功能会处于开启状态且会在增强模式下运行。此模式可提高安全性，但需与 Google 分享更多浏览信息。\n让您能够控制是否开启 Brave 的“安全浏览”功能以及要在哪种模式下运行此功能。\n\n如果此政策设为“NoProtection”（值为 0），“安全浏览”功能会一直处于关闭状态。\n\n如果此政策设为“StandardProtection”（值为 1，即默认值），“安全浏览”功能会一直处于开启状态且会在标准模式下运行。\n\n如果此政策设为“EnhancedProtection”（值为 2），“安全浏览”功能会一直处于开启状态且会在增强模式下运行。这种模式可提高安全性，但需与 Google 分享更多浏览信息。\n\n如果您将此政策设为强制性要求，用户便无法更改或覆盖 Brave 中的“安全浏览”设置。\n\n如果未设置此政策，“安全浏览”功能将会在标准保护模式下运行，但用户可以自行更改此设置。\n\n如需详细了解“安全浏览”功能，请访问 https://support.google.com/chrome?p=safe_browsing_preferences。";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "允许“安全浏览”功能通过代理进行实时检查";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "此政策用于控制是否允许安全浏览功能的标准保护模式通过 Oblivious HTTP 代理将网址的部分哈希值发送给 Google，以确定这些网址是否可安全访问。\n\n该代理允许浏览器将网址的部分哈希值上传到 Google，而无需将其关联到用户的 IP 地址。此政策还允许浏览器以更高的频率上传网址的部分哈希值，从而增强安全浏览功能的保护成效。\n\n如果安全浏览功能已停用或已设为增强型保护模式，系统会忽略此政策。\n\n如果此政策已启用或未设置，系统将允许以更高保护级别通过代理进行查询。\n\n如果此政策已停用，系统将禁止以更高保护级别通过代理进行查询。网址的部分哈希值被直接上传到 Google 的频率会大大降低，这会削弱保护效果。";
SafeBrowsingSurveysEnabled.pfm_title = "允许接收“安全浏览”功能调查问卷";
SafeBrowsingSurveysEnabled.pfm_description = "如果已启用或未设置此政策，用户可能会收到与“安全浏览”功能相关的调查问卷。\n如果已停用此政策，用户将不会收到与“安全浏览”功能相关的调查问卷。";
SafeSitesFilterBehavior.pfm_title = "控制 SafeSites 的成人内容滤除机制。";
SafeSitesFilterBehavior.pfm_description = "0 - 不滤除提供成人内容的网站\n1 - 滤除提供成人内容的网站\n通过设置此政策，您可以控制 SafeSites 网址滤除机制，此机制使用 Google Safe Search API 来判断是否将网址归类为色情内容。\n\n如果此政策设为：\n\n*“不滤除提供成人内容的网站”或未设置 - 系统将不会滤除这类网站\n\n*“滤除提供成人内容的网站”- 系统将会滤除色情网站\n\n此政策同时适用于用户导航到的网址和 iframe。URLAllowlist 政策优先于此政策，可用于替换 Google Safe Search API 的判定结果。";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "允许这些来源使用同源标签页截取功能";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "通过设置此政策，您可创建一个网址格式列表，指定哪些网站能够捕获与其同源的标签页。\n\n如果未设置此政策，则意味着在该捕获层级下，不会考虑对网站进行权限覆盖。\n\n请注意，系统仍然会允许捕获与相应网站同源的窗口化 Chrome 应用。\n\n如果相应网站与此政策中的网址格式匹配，系统将不会考虑以下政策：TabCaptureAllowedByOrigins、WindowCaptureAllowedByOrigins、ScreenCaptureAllowedByOrigins、ScreenCaptureAllowed。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns/。此政策只会根据源进行匹配，因此网址格式中的所有路径都会被忽略。";
SandboxExternalProtocolBlocked.pfm_title = "允许 Chrome 阻止导航到沙盒化 iframe 中的外部协议";
SandboxExternalProtocolBlocked.pfm_description = "Chrome 会阻止从沙盒化 iframe 内导航到外部协议。请参阅 https://chromestatus.com/features/5680742077038592。\n\n如果此政策设为 True，Chrome 会阻止此类导航。\n\n如果此政策设为 False，Chrome 将无法阻止此类导航。\n\n此政策默认设为 True：安全功能已启用。\n\n如果管理员需要更多时间来更新受这项新限制影响的内部网站，则可以使用此政策。这项企业政策只是暂时性政策，预计将于 Brave 117 版之后移除。\n";
SavingBrowserHistoryDisabled.pfm_title = "停用保存浏览器历史记录的功能";
SavingBrowserHistoryDisabled.pfm_description = "如果此政策已启用，系统将不会保存浏览记录，并且会停用标签页同步功能，用户则无法更改相关设置。\n\n如果此政策已停用或未设置，系统将会保存浏览记录。";
ScreenCaptureAllowed.pfm_title = "允许或拒绝屏幕截图";
ScreenCaptureAllowed.pfm_description = "如果此政策已启用或未配置（默认），网页可以使用屏幕共享 API（例如 getDisplayMedia() 或 Desktop Capture Extension API）提示用户选择要截取的标签页、窗口或桌面。\n\n如果此政策已停用，对屏幕共享 API 的所有调用都会失败并会返回错误；但在以下情况下，系统将不会考虑此政策（相应网站将能够使用屏幕共享 API）：该网站与 ScreenCaptureAllowedByOrigins、WindowCaptureAllowedByOrigins、TabCaptureAllowedByOrigins 或 SameOriginTabCaptureAllowedByOrigins 政策中的来源格式匹配。\n";
ScreenCaptureAllowedByOrigins.pfm_title = "允许这些来源使用桌面、窗口和标签页截取功能";
ScreenCaptureAllowedByOrigins.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，指定哪些网站能够使用桌面、窗口和标签页捕获功能。\n\n如果未设置此政策，系统将不会考虑在这种捕获级别覆盖网站的默认行为。\n\n如果相应网站与 WindowCaptureAllowedByOrigins、TabCaptureAllowedByOrigins 或 SameOriginTabCaptureAllowedByOrigins 政策中的网址格式匹配，系统将不会考虑此政策。\n\n如果相应网站与此政策中的网址格式匹配，系统将不会考虑 ScreenCaptureAllowed。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns/。此政策只会根据源进行匹配，因此网址格式中的任何路径都会被忽略。";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "允许不需要之前的用户手势即可截取屏幕";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "出于安全考虑，调用 getDisplayMedia() Web API 前需要用户先执行一个手势（“暂时性激活”），否则调用将会失败。\n\n如果已设置此政策，管理员可以指定哪些源可以直接调用此 API，而不需要用户先执行一个手势。\n\n如需详细了解有效的网址格式，请访问 https://chromeenterprise.google/policies/url-patterns/。“*”不是此政策可接受的值。\n\n如果未设置此政策，所有源在调用此 API 前，都需要用户先执行一个手势。";
ScrollToTextFragmentEnabled.pfm_title = "允许滚动至网址片段指定的文本所在的位置";
ScrollToTextFragmentEnabled.pfm_description = "此功能可让超链接和地址栏导航网址定位到网页中的特定文本。一旦网页加载完毕，系统即会自动将网页滚动至该文本所在的位置。\n\n如果您启用了此政策或不配置此政策，系统将会根据网址将网页滚动至特定文本片段所在的位置。\n如果您停用了此政策，系统便不会根据网址将网页滚动至特定文本片段所在的位置。";
SearchContentSharingSettings.pfm_title = "允许与 Google AI Mode和Lens集成功能分享内容";
SearchContentSharingSettings.pfm_description = "0 - 允许与 Google AI Mode集成功能分享内容。\n1 - 不允许与 Google AI Mode集成功能分享内容。\n此政策用于控制是否可以通过 Google Chrome 侧边栏或标签页与 Google AI Mode和Lens分享网页和文件内容。\n\n请注意，此政策不影响在网页上使用 Google AI Mode，仅控制用户在使用 Google Chrome 时可如何与该 AI 模式分享信息。\n\n0 = 用户可以与 Google AI Mode分享网页或文件内容。\n\n1 = 用户无法与 Google AI Mode分享网页或文件内容。用于分享上下文的入口点和侧边栏将被停用或隐藏。\n\n如果 Google Search未设为用户的默认搜索引擎，系统会忽略此政策，因为相应功能已停用。\n\n此政策独立于“AIModeSettings”政策。“AIModeSettings”政策仅控制多功能框或 NTP 搜索框中的入口点，而此政策旨在控制是否可以通过侧边栏或标签页分享上下文信息。\n\n此政策也不会控制 Google Gemini 集成功能，该功能可通过“GeminiSettings”政策停用。\n\n如果未设置此政策，相关行为将由“GenAiDefaultSettings”政策决定。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
SearchSuggestEnabled.pfm_title = "启用搜索建议";
SearchSuggestEnabled.pfm_description = "如果此政策设为 True，系统会在 Brave 地址栏中显示搜索建议。如果此政策设为 False，系统会停用此类搜索建议功能。\n\n根据书签或历史记录提供的建议不受此政策的影响。\n\n如果您设置了此政策，用户便无法更改相关设置。如果您不设置此政策，系统最初会显示搜索建议，但用户可随时停用此功能。";
SecurityKeyPermitAttestation.pfm_title = "自动允许直接安全密钥认证的网址/网域";
SecurityKeyPermitAttestation.pfm_description = "通过设置此政策，您可指定：对于哪些 WebAuthn RP ID，当网站要求安全密钥提供认证证书时，系统不会显示任何提示。系统还会向安全密钥发送信号，表明可能会使用企业认证。如果您未设置此政策，当网站要求安全密钥提供认证证书时，Brave 65 版及更高版本会向用户显示提示。";
SensorsAllowedForUrls.pfm_title = "允许在这些网站上使用传感器";
SensorsAllowedForUrls.pfm_description = "通过设置此政策，您可以设置一个网址格式列表，从而指定哪些网站可以使用传感器（例如移动传感器和光传感器）。\n\n未设置此政策时，如果已设置 DefaultSensorsSetting，系统会将其应用于所有网站，否则就会应用用户的个人设置。\n\n如果某个网址格式同时存在于此政策和 SensorsBlockedForUrls 政策中，后者的优先级更高，因此系统会禁止相应网站使用移动传感器或光传感器。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
SensorsBlockedForUrls.pfm_title = "禁止在这些网站上使用传感器";
SensorsBlockedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，用于指定哪些网站无法使用传感器，例如移动传感器和光传感器。\n\n未设置此政策时，如果 DefaultSensorsSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n如果某个网址格式同时存在于此政策和 SensorsAllowedForUrls 政策中，此政策将优先适用，因此系统会禁止相应网站使用移动传感器或光传感器。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。";
SerialAllowAllPortsForUrls.pfm_title = "自动授权网站连接所有串行端口。";
SerialAllowAllPortsForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址，以指定自动授权哪些网站访问所有可用的串行端口。\n\n这些网址必须有效，否则系统会忽略此政策。系统将仅考虑相应网址的来源（架构、主机和端口）。\n\n在 Google Chrome OS 上，此政策仅适用于已关联的用户。\n\n此政策会覆盖 DefaultSerialGuardSetting、SerialAskForUrls、SerialBlockedForUrls 和用户的偏好设置。";
SerialAllowUsbDevicesForUrls.pfm_title = "自动授权网站连接到 USB 串行设备。";
SerialAllowUsbDevicesForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址，从而指定自动授权哪些网站访问符合以下条件的 USB 串行设备：供应商 ID 和产品 ID 分别与 vendor_id 和 product_id 字段相符。如果省略 product_id 字段，系统会授权指定网站访问符合以下条件的设备：供应商 ID 与 vendor_id 字段相符，产品 ID 不限。\n\n这些网址必须有效，否则系统会忽略此政策。系统将仅考虑相应网址的来源（架构、主机和端口）。\n\n在 Chrome 操作系统上，此政策仅适用于已关联的用户。\n\n此政策会覆盖 DefaultSerialGuardSetting、SerialAskForUrls、SerialBlockedForUrls 和用户的偏好设置。\n\n此政策仅会对通过 Web Serial API 访问 USB 设备这一操作产生影响。若要通过 WebUSB API 授权访问 USB 设备，请参见 WebUsbAllowDevicesForUrls 政策。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls。";
SerialAskForUrls.pfm_title = "允许在这些网站上使用 Serial API";
SerialAskForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址格式，从而指定哪些网站可以请求用户授权其访问串行端口。\n\n未设置此政策时，如果已设置 DefaultSerialGuardSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n对于不符合此政策的网址格式，系统会依序优先应用政策 SerialBlockedForUrls（若存在匹配项）、DefaultSerialGuardSetting（若已设置）或用户的个人设置。\n\n如果网址格式与 SerialBlockedForUrls 冲突，系统会忽略它们。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
SerialBlockedForUrls.pfm_title = "禁止在这些网站上使用 Serial API";
SerialBlockedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，用于指定哪些网站无法请求用户授权其访问串行端口。\n\n未设置此政策时，如果 DefaultSerialGuardSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n对于不符合此政策的网址格式，系统会依序优先应用政策 SerialAskForUrls（若存在匹配项）、DefaultSerialGuardSetting（若已设置）或用户的个人设置。\n\n如果网址格式与 SerialAskForUrls 冲突，则此政策会优先适用。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
ServiceWorkerAutoPreloadEnabled.pfm_title = "允许 ServiceWorker 不必等待启动就分派导航请求";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nServiceWorkerAutoPreload 功能会在 ServiceWorker 引导过程开始的同时，分派对主要资源的网络请求。\n\n如果此政策已启用或未设置，Brave 会启用 ServiceWorkerAutoPreload。在某些情况下（例如 ServiceWorker 未运行），系统会在 ServiceWorker 启动期间自动分派导航请求。\n\n如果此政策已停用，Brave 将不会启用 ServiceWorkerAutoPreload。系统始终会在启动 ServiceWorker 后分派导航请求。\n\n此政策只是用于控制该功能的一项暂时性措施，将在 M154 中移除。";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "允许 ServiceWorker 控制 srcdoc iframe";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "https://github.com/w3c/ServiceWorker/issues/765 要求具有“allow-same-origin”沙盒属性的 srcdoc iframe 受 ServiceWorker 控制。\n\n如果此政策已启用或未经设置，Brave 会使具有“allow-same-origin”沙盒属性的 srcdoc iframe 受 ServiceWorker 控制。\n\n如果此政策已停用，srcdoc iframe 将不受 ServiceWorker 控制。\n\n此政策只是暂时性措施，将于 2026 年移除。";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "指定 SharedArrayBuffers 可否用在未进行跨域隔离的情境中";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\n用于指定 SharedArrayBuffers 可否用在未进行跨域隔离的情境中。出于网络兼容性方面的原因，从 Brave 91 (2021-05-25) 开始，Brave 会要求网站在使用 SharedArrayBuffers 时进行跨域隔离。如需了解更多详情，请访问 https://developer.chrome.com/blog/enabling-shared-array-buffer/。\n\n如果此政策已启用，网站将能够随意使用 SharedArrayBuffer，不受任何限制。\n\n如果此政策已停用或未设置，则意味着只有在进行了跨域隔离的情况下，网站才能使用 SharedArrayBuffers。";
SharedWorkerBlobURLFixEnabled.pfm_title = "使 SharedWorker blob 网址行为符合规范";
SharedWorkerBlobURLFixEnabled.pfm_description = "根据 https://w3c.github.io/ServiceWorker/#control-and-use-worker-client，worker 应继承 blob 网址的控制器。不过，现有代码仅允许 DedicatedWorker 继承控制器，而 SharedWorker 则不继承控制器。\n\n如果此政策已启用或未经设置，并且将 blob 网址用作 SharedWorker 网址，那么 Brave 将继承控制器。\n\n停用此政策会导致行为与现有规范不一致。\n\n此政策只是暂时性措施，日后会被移除。";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "为 SharedWorker 启用更长的生命周期";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "如果在 SharedWorker 构造函数中将“extendedLifetime”选项设置为 true，SharedWorker 即可拥有更长的生命周期。\n\n如果此政策已启用或未设置，SharedWorker 可以拥有更长的生命周期。\n\n如果此政策已停用，即使该选项设为 true，SharedWorker 也无法拥有更长的生命周期。\n\n此政策只是暂时性措施，日后会被移除。";
ShoppingListEnabled.pfm_title = "允许启用购物清单功能";
ShoppingListEnabled.pfm_description = "此政策用于控制购物清单功能的可用性。\n如果此政策已启用，系统会向用户呈现用于跟踪当前页面上显示的商品价格的界面。跟踪的商品会显示在书签侧边栏中。\n如果此政策已启用或未设置，用户将可以使用购物清单功能。\n如果此政策已停用，购物清单功能将无法使用。\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "在书签栏中显示应用快捷方式";
ShowAppsShortcutInBookmarkBar.pfm_description = "如果此政策设为 True，系统会显示应用快捷方式。如果此政策设为 False，系统一律不会显示此类快捷方式。\n\n如果您设置了此政策，用户便无法更改它。如果您不设置此政策，用户可从书签栏上下文菜单中选择显示/隐藏应用快捷方式。";
ShowCastIconInToolbar.pfm_title = "显示 Google Cast 工具栏图标";
ShowCastIconInToolbar.pfm_description = "如果此政策已启用，系统会在工具栏或溢出菜单中显示 Cast 工具栏图标，而且用户无法移除该图标。\n\n如果此政策已停用或未设置，用户便可通过该图标的上下文菜单来固定或移除该图标。\n\n如果 EnableMediaRouter 政策设为停用，此政策的值不会产生任何效力，所以 Cast 工具栏图标不会显示。";
ShowCastSessionsStartedByOtherDevices.pfm_title = "显示由本地网络中的其他设备启动的 Google Cast 会话的媒体控件";
ShowCastSessionsStartedByOtherDevices.pfm_description = "如果此政策已启用，由本地网络中的其他设备启动的 Google Cast 会话便可使用媒体播放控件界面。\n\n如果此政策未针对企业用户设置或者已停用，由本地网络中的其他设备启动的 Google Cast 会话便无法使用媒体播放控件界面。\n\n如果 EnableMediaRouter 政策已停用，此政策的值便不会产生任何效力，因为整个 Google Cast 功能都会被停用。";
ShowFullUrlsInAddressBar.pfm_title = "显示完整网址";
ShowFullUrlsInAddressBar.pfm_description = "此功能可让系统在地址栏中显示完整网址。\n如果此政策设为 True，系统将会在地址栏中显示包含协议和子网域的完整网址。\n如果此政策设为 False，系统将会应用默认网址显示方式。\n如果此政策未设置，系统将会应用默认网址显示方式，而且用户将能使用一个上下文菜单选项，在默认网址显示方式和完整网址显示方式之间切换。\n";
ShowHomeButton.pfm_title = "在工具栏上显示“主页”按钮";
ShowHomeButton.pfm_description = "如果此政策已启用，系统会在 Brave 的工具栏中显示“主页”按钮。如果此政策已停用，系统不会显示“主页”按钮。\n\n如果您设置了此政策，用户将无法在 Brave 中更改它。如果您未设置此政策，用户便可自行选择是否显示“主页”按钮。";
SideSearchEnabled.pfm_title = "允许在浏览器侧边栏中显示默认搜索引擎的最新搜索结果页面";
SideSearchEnabled.pfm_description = "如果此政策已启用或未设置，用户便可通过切换工具栏中的图标来开启侧边栏以显示默认搜索引擎的最新搜索结果页面。\n\n如果此政策已停用，系统会从工具栏中移除该切换图标，用户无法打开显示默认搜索引擎的搜索结果页面的侧边栏。";
SignedHTTPExchangeEnabled.pfm_title = "启用 Signed HTTP Exchange (SXG) 支持";
SignedHTTPExchangeEnabled.pfm_description = "如果此政策设为 True 或未设置，Brave 将会接受通过 Signed HTTP Exchange (SXG) 提供的网络内容。\n\n如果此政策设为 False，系统会阻止加载 Signed HTTP Exchange (SXG) 内容。";
SigninInterceptionEnabled.pfm_title = "启用登录拦截功能";
SigninInterceptionEnabled.pfm_description = "此设置用于启用或停用登录拦截功能。\n\n如果此政策未设置或已启用，当用户在网络上添加了 Google 账号时，系统会触发登录拦截对话框，因而用户可将该账号移至另一份（新的或现有的）资料中，这样做可能会对用户有好处。\n\n如果此政策已停用，系统不会触发登录拦截对话框。\n如果此政策已停用，而且受管理的账号的资料是由 ManagedAccountsSigninRestriction 强制分隔，系统仍会显示一个对话框。";
SilentPrintingEnabled.pfm_title = "启用静默打印";
SilentPrintingEnabled.pfm_description = "如果此政策设为 true，则会启用静默打印，即在打开打印预览窗口后立即将其关闭，并在默认打印机上使用默认选项打印。如果默认打印机是“另存为 PDF”，文件将保存到“下载内容”文件夹中。\n\n如果不设置此政策或将其设为 false，则会停用静默打印，这样就不会自动关闭打印预览窗口，并且需要用户像平常一样进行选择。";
SitePerProcess.pfm_title = "要求为所有网站启用网站隔离功能";
SitePerProcess.pfm_description = "从 Brave 67 版起，系统已默认在所有桌面平台上启用网站隔离功能，因此每个网站都会在自己的进程中运行。网站的网址格式为架构加上 eTLD+1（例如，https://example.com）。如果此政策已启用，系统并不会更改相应行为，只会禁止用户选择停用此功能（例如，通过使用 chrome://flags 中的“停用网站隔离”）。从 Brave 76 版起，如果此政策已停用或未设置，系统将不会关闭网站隔离功能，但会允许用户选择停用此功能。\n\nIsolateOrigins 还可用于隔离比网站更精确的特定来源（例如，https://a.example.com）。\n\n在 Google Chrome OS 76 版及更低版本中，请将 DeviceLoginScreenSitePerProcess 设备政策设为相同的值。（如果这两项政策的值不一致，当进入用户会话时，系统可能会出现延迟。）\n\n注意：对于 Android 设备，请改用 SitePerProcessAndroid 政策。";
SiteSearchSettings.pfm_title = "网站搜索设置";
SiteSearchSettings.pfm_description = "此政策列出了用户可在地址栏中使用快捷字词迅速搜索的网站。用户只需在地址栏中输入快捷字词或 @快捷字词（例如 @work），然后按空格键或 Tab 键，即可发起搜索。\n\n对于每个网站，都必须填写以下字段：name、shortcut 和 url。\n\nname 字段对应于要在地址栏中向用户显示的网站或搜索引擎的名称。\n\nshortcut 可以包含纯文字和字符，但不得包含空格，也不得以 @ 符号开头。快捷字词不得重复。\n\n对于每个条目，url 字段用于指定使用相应关键字进行搜索时所用搜索引擎的网址。该网址必须包含字符串 '{searchTerms}'；当用户执行查询时，系统会将此字符串替换成用户的搜索字词。无效条目和包含重复快捷字词的条目会被忽略。\n\n当用户输入“@”时，配置为“默认选用”的网站搜索条目会显示在地址栏中。最多可选择 3 个条目作为默认选用的条目。\n\n对于 allow_user_override 为 true 的网站搜索条目，用户可以修改或停用该条目。不过，默认选用的引擎（以“@”开头）只能停用。如果用户修改了此政策最初创建的条目，该条目将不再受政策管理，而会被视为用户创建的快捷字词。如果网站搜索条目的 allow_user_override 为 false 或未指定，用户将无法修改或停用该条目。只有 M139 及更高版本允许用户覆盖设置；较早版本将默认禁止用户覆盖。\n\n用户无法使用之前通过此政策创建的快捷字词来创建新的网站搜索条目，除非 allow_user_override 已针对该网站搜索条目设为 true。\n\n如果与用户之前创建的快捷字词冲突，系统会优先使用用户设置。不过，用户仍然可以在搜索栏中输入“@”来触发由此政策创建的选项。例如，如果用户已将“work”定义为 URL1 的快捷字词，并且此政策将“work”定义为 URL2 的快捷字词，则在搜索栏中输入“work”将会触发对 URL1 的搜索，但在搜索栏中输入“@work”会触发对 URL2 的搜索。\n\n在 Microsoft® Windows® 上，此政策仅适用于已加入 Microsoft® Active Directory® 网域的实例、已加入 Microsoft® Azure® Active Directory® 的实例或已在 Chrome Enterprise Core中注册的实例。\n\n在 macOS 上，此政策仅适用于通过 MDM 进行管理的实例、已通过 MCX 加入网域的实例或已在 Chrome Enterprise Core中注册的实例。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=SiteSearchSettings。";
SmartTabSharingSettings.pfm_title = "智能标签页分享设置";
SmartTabSharingSettings.pfm_description = "0 - 允许与 Google AI Mode集成功能智能分享标签页。\n1 - 不允许与 Google AI Mode集成功能智能分享标签页。\n此政策用于控制是否允许通过 Google Chrome 侧边栏或标签页使用 Google AI Mode的智能标签页分享功能。\n\n请注意，此政策不影响在网页上使用 Google AI Mode，仅控制用户在使用 Google Chrome 时可如何与其分享信息。\n\n0 = 用户可以与 Google AI Mode分享网页或文件内容。\n\n1 = 用户无法与 Google AI Mode分享网页或文件内容。用于分享上下文的入口点和侧边栏将被停用或隐藏。\n\n如果 Google Search未设为用户的默认搜索引擎，系统会忽略此政策，因为该功能已停用。\n\n此政策独立于 AIModeSettings 政策。AIModeSettings 政策仅控制多功能框或新标签页搜索框中的入口点，而此政策旨在控制通过侧边栏或标签页进行上下文分享。\n\n此政策也不会控制 Google Gemini 集成功能，该功能可通过 GeminiSettings 政策停用。\n\n请注意，如果 SearchContentSharingSettings 处于停用状态，系统将忽略此政策。\n\n如果未设置此政策，相关行为将由 GenAiDefaultSettings 政策决定。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
SpellCheckServiceEnabled.pfm_title = "启用或停用拼写检查网络服务";
SpellCheckServiceEnabled.pfm_description = "如果此政策已启用，系统会使用 Google 网络服务来帮助修正拼写错误。此政策仅控制对在线服务的使用。如果此政策已停用，系统绝不会使用拼写检查服务。\n\n如果此政策未设置，用户便可自行选择是否使用该服务。\n\n拼写检查功能始终都能就地使用已下载的字典，除非该功能已被 SpellcheckEnabled 停用（在这种情况下，此政策将不会产生任何影响）。";
SpellcheckEnabled.pfm_title = "启用拼写检查";
SpellcheckEnabled.pfm_description = "如果此政策已启用，系统会开启拼写检查，但用户无法关闭该功能。由于在 Microsoft® Windows®、Google Chrome OS和 Linux® 中，拼写检查功能的状态（开启/关闭）可因具体语言而异，因此若有语言开启了该功能，用户仍能通过关闭针对每种所涉语言的拼写检查来停用该功能。为避免这种情况，请使用 SpellcheckLanguage 为特定语言强制启用拼写检查。\n\n如果此政策已停用，系统会从所有来源关闭拼写检查，而且用户无法开启该功能。如果此政策设为 False，SpellCheckServiceEnabled、SpellcheckLanguage 和 SpellcheckLanguageBlocklist 政策都不会产生任何影响。\n\n如果此政策未设置，用户便可在语言设置中开启或关闭拼写检查。";
StandardizedBrowserZoomEnabled.pfm_title = "启用标准化的浏览器缩放行为";
StandardizedBrowserZoomEnabled.pfm_description = "此政策用于确保网站遵循新采用的 CSS 缩放规范。\n\n如果此政策已启用或未设置，CSS“zoom”属性将遵循以下规范：\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\n如果此政策已停用，CSS“zoom”属性将回退到标准化之前的旧行为。\n\n此政策是一项暂时性缓解措施，以便您有更多时间将 Web 内容转换为新行为。停用此政策后，还有一个与此行为对应的源试用（“DisableStandardizedBrowserZoom”）。在里程碑版本 134 中，此政策将被移除，“已启用”状态下的行为也将永久生效。";
StaticStorageQuotaEnabled.pfm_title = "控制存储空间配额 API 是否返回静态值";
StaticStorageQuotaEnabled.pfm_description = "如果启用了此设置，存储空间配额 API 会返回一个静态值，该值等于当前用量 + 最小用量（10 GiB，磁盘空间向上取整到最接近的 GiB 数值）。\n如果停用了此设置，存储空间配额 API 通常会返回一个动态值，该值与设备上的总可用空间成正比，无论实际用量是多少。\n如果未设置此设置，存储空间配额 API 将采用默认的 Chrome 行为。\n具有无限存储权限的网站不受此设置的影响。强制执行的配额也不受影响。";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "为工作器脚本启用严格的 MIME 类型检查";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "此政策用于为工作器脚本启用严格的 MIME 类型检查。\n\n如果此政策已启用或未设置，工作器脚本将对 JavaScript 使用严格的 MIME 类型检查，这是新版默认行为。采用旧版 MIME 类型的工作器脚本将被拒绝。\n\n如果此政策已停用，工作器脚本将使用宽松的 MIME 类型检查，以便系统继续加载和执行采用旧版 MIME 类型（例如 text/ascii）的工作器脚本。\n\n过去，浏览器使用宽松的 MIME 类型检查，因此支持那些采用大量旧版 MIME 类型的资源。例如，对于 JavaScript 资源，text/ascii 是受支持的旧版 MIME 类型。这会允许系统将资源作为脚本加载以付诸原本从未预期的用途，因此可能会导致出现安全问题。在不久的将来，Chrome 将会改用严格的 MIME 类型检查。届时，已启用的相关政策将会跟踪这一默认行为。如果此政策已停用，管理员将能酌情保留旧版行为。\n\n如需详细了解 JavaScript/ECMAScript 媒体类型，请参阅 https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage。\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "禁止显示从其他来源的子框架触发的 JavaScript 对话框";
SuppressDifferentOriginSubframeDialogs.pfm_description = "如 https://www.chromestatus.com/feature/5148698084376576 中所述，倘若 JavaScript 模态对话框（由 window.alert、window.confirm 和 window.prompt 触发）是从非主框架源的子框架触发的，Brave 会屏蔽这些对话框。\n\n此政策让您可以覆盖这项变更。\n如果此政策已启用或未设置，系统将会屏蔽从其他源的子框架触发的 JavaScript 对话框。\n如果此政策已停用，系统将不会屏蔽从其他源的子框架触发的 JavaScript 对话框。\n\n日后我们会从 Brave 中移除此政策。";
SuppressUnsupportedOSWarning.pfm_title = "禁止显示“操作系统不受支持”警告";
SuppressUnsupportedOSWarning.pfm_description = "如果此政策已启用，当 Brave 在不受支持的计算机或操作系统中运行时，系统将不会显示警告。\n\n如果此政策已停用或未设置，不受支持的系统中将会显示警告。";
SyncDisabled.pfm_title = "停用与 Google 同步数据的功能";
SyncDisabled.pfm_description = "如果此政策已启用，系统会在使用由 Google 托管的同步服务的 Brave 中关闭数据同步功能。\n如需完全关闭 Chrome Sync服务，我们建议您在 Google Admin console中关闭相应服务。\n\n如果此政策已停用或未设置，用户便可以选择是否使用 Chrome Sync。\n\n注意：如果 RoamingProfileSupportEnabled 已启用，请勿开启此政策，因为此功能具有相同的客户端功能。在这种情况下，由 Google 托管的同步服务会完全关闭。";
SyncTypesListDisabled.pfm_title = "应从同步操作中排除的类型列表";
SyncTypesListDisabled.pfm_description = "如果您设置了此政策，系统将会从同步操作（无论是 Chrome Sync还是漫游个人资料同步）中排除所有指定的数据类型。这有助于缩减漫游个人资料的大小，或者限制向 Chrome Sync服务器上传的数据类型。\n\n此政策当前可用的数据类型为：“apps”“autofill”“bookmarks”“extensions”“preferences”“passwords”“payments”“productComparison”“readingList”“tabs”“themes”“typedUrls”“wifiConfigurations”。这些名称区分大小写！\n\n注意：只有 Brave 版本 123 及更高版本支持动态政策刷新。停用“autofill”也会停用“payments”。“typedUrls”是指所有浏览记录。";
TLS13EarlyDataEnabled.pfm_title = "启用 TLS 1.3 Early Data";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Early Data 是 TLS 1.3 的扩展，用于在 TLS 握手时同时发送 HTTP 请求。\n\n如果此政策未配置，Brave 将会遵循 TLS 1.3 Early Data 的默认分阶段发布流程。\n\n如果启用此功能，Brave 将启用 TLS 1.3 Early Data。\n\n如果您已停用此政策，Brave 将不会启用 TLS 1.3 Early Data。\n\n当这项功能处于启用状态时，Brave 未必会使用 TLS 1.3 Early Data，具体取决于服务器支持情况。\n\nTLS 1.3 Early Data 是一种已建立的协议。现有的 TLS 服务器、中间件和安全软件预计会处理或拒绝 TLS 1.3 Early Data，而不会中断连接。\n\n但是，在使用 TLS 1.3 Early Data 时，未正确实现 TLS 的设备可能会发生故障并断开连接。如果发生这种情况，管理员应联系供应商以寻求解决方案。\n\n此政策只是一项暂时性措施，用于控制此功能，之后会被移除。您可启用此政策以测试是否存在问题，并在解决问题期间停用此政策。";
TabCaptureAllowedByOrigins.pfm_title = "允许这些来源使用标签页截取功能";
TabCaptureAllowedByOrigins.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，指定哪些网站能够使用标签页捕获功能。\n\n如果未设置此政策，系统将不会考虑在这种捕获级别覆盖网站的默认行为。\n\n请注意，系统仍然会允许捕获窗口化 Chrome 应用。\n\n如果相应网站与 SameOriginTabCaptureAllowedByOrigins 政策中的网址格式匹配，系统将不会考虑此政策。\n\n如果相应网站与此政策中的网址格式匹配，系统将不会考虑以下政策：WindowCaptureAllowedByOrigins、ScreenCaptureAllowedByOrigins、ScreenCaptureAllowed。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns/。此政策只会根据源进行匹配，因此网址格式中的任何路径都会被忽略。";
TabCompareSettings.pfm_title = "“标签页比较”设置";
TabCompareSettings.pfm_description = "0 - 允许使用“标签页比较”工具并改进 AI 模型。\n1 - 允许使用“标签页比较”工具，但不改进 AI 模型。\n2 - 不允许使用“标签页比较”工具。\n“标签页比较”是一款运用 AI 技术的工具，可用于比较用户标签页中的信息。例如，如果用户打开了多个标签页，并且其中包含相似类别的商品，系统就可以向用户提供此功能。\n\n0 表示允许使用此功能，同时允许 Google 使用相关数据改进其 AI 模型。相关数据可能包括提示、输入、输出、来源资料和书面反馈，具体取决于相应功能。工作人员也可能会审核这些数据，以改进 AI 模型。除非下文另有说明，否则默认值是 0。\n\n1 表示允许使用此功能，但不允许 Google 使用用户内容（包括提示、输入、输出、来源资料和书面反馈）改进模型。对于受 Google Admin console管理的企业用户和受 Google Workspace 管理的教育版账号，默认值是 1。\n\n2 表示不允许使用此功能。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
TabDiscardingExceptions.pfm_title = "舍弃标签页时的网址格式例外情况";
TabDiscardingExceptions.pfm_description = "此政策旨在确保与其指定（使用 URLBlocklist 过滤器格式）的一个或多个格式匹配的任何网址都绝不会被浏览器舍弃。\n这适用于内存压力和高效率模式舍弃。\n系统会卸载已舍弃的页面并完全回收其资源。与该页面关联的标签页会保留在标签栏中，但切换到它会触发完全重新加载。\n";
TaskManagerEndProcessEnabled.pfm_title = "允许在任务管理器中结束进程";
TaskManagerEndProcessEnabled.pfm_description = "如果此政策已停用，系统会禁止用户在任务管理器中结束进程。\n\n如果此政策已启用或未设置，用户便可在任务管理器中结束进程。";
ThirdPartyAiChatSettings.pfm_title = "地址栏和新标签页搜索框中的第三方 AI 模式集成设置。";
ThirdPartyAiChatSettings.pfm_description = "0 - 允许集成第三方 AI 模式。\n1 - 不允许集成第三方 AI 模式。\n此政策用于控制地址栏和新标签页搜索框中的第三方 AI 模式集成。\n\n如需使用此功能，必须将支持 AI 模式的第三方搜索引擎设为用户的默认搜索引擎。\n\n0 = 用户可以使用此功能。\n\n1 = 用户无法使用此功能。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "设置 Chrome 实例可以占用的内存上限";
TotalMemoryLimitMb.pfm_description = "配置在单个 Brave 实例使用的内存量达到多少后浏览器会为节省内存空间而开始舍弃标签页（即：标签页使用的内存将被释放，而且在用户切换到此标签页时它必须重新加载）。\n\n如果设置了此政策，那么当超出该上限后，浏览器将开始舍弃标签页以节省内存空间。不过，我们无法保证浏览器运行时占用的内存量会始终低于该上限。任何小于 1024 的值都会被向上舍入到 1024。\n\n如果此政策未设置，那么仅当检测到所用机器的物理内存容量即将用尽时，浏览器才会开始尝试节省内存空间。";
TranslateEnabled.pfm_title = "启用翻译";
TranslateEnabled.pfm_description = "如果此政策设为 True，Brave 将会显示一个集成式翻译工具栏，并且在用户点击鼠标右键时，出现的上下文菜单中会显示翻译选项，以便适时地向用户提供翻译功能。将此政策设为 False 会关闭所有内置的翻译功能。\n\n如果您设置了此政策，用户将无法更改这项功能。如果此政策未设置，用户便可以更改此设置。";
TranslatorAPIAllowed.pfm_title = "允许使用 Translator API";
TranslatorAPIAllowed.pfm_description = "如果此政策已启用或未经设置，系统将允许在 Brave 中使用 Translator API。\n\n如果此政策已停用，系统将禁止使用 Translator API。";
TryOnYouSettings.pfm_title = "“虚拟试穿”的设置。";
TryOnYouSettings.pfm_description = "0 - 启用“虚拟试穿”并改进模型。\n1 - 启用“虚拟试穿”，但不改进模型。\n2 - 停用“虚拟试穿”。\n“虚拟试穿”是一项依托 AI 技术的功能，可让用户根据网上的服装图片进行虚拟试穿；如果已启用 Chrome 中的 Gemini，它还会提供实用的购物数据分析。\n\n0 表示允许使用此功能，同时允许 Google 使用相关数据改进其 AI 模型。相关数据可能包括图片、输入、输出、素材和反馈，具体取决于相应功能。工作人员也可能会审核这些数据，以改进 AI 模型。除非下文另有说明，否则默认值是 0。\n\n1 表示允许使用此功能，但不允许 Google 使用用户内容（包括图片、输入、输出、素材和反馈）改进模型。对于受 Google Admin console管理的企业用户和受 Google Workspace 管理的教育版账号，默认值是 1。\n\n2 表示不允许使用此功能。\n\n注意：对模型改进的限制（值 1）仅在通过 Chrome 浏览器流程触发“虚拟试穿”时适用。当通过其他流程使用该功能时，此政策不适用。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings\n\n“虚拟试穿”仅支持部分语言，并且只能在部分国家/地区使用。设置此政策并不能保证该功能会启用，仍需取决于实际可用情况。如需详细了解推出情况，请查看企业版版本说明：https://support.google.com/chrome/a/answer/7679408?hl=en";
URLAllowlist.pfm_title = "允许访问指定的一系列网址";
URLAllowlist.pfm_description = "通过设置此政策，您可列出允许访问的网址，以便将这些网址作为 URLBlocklist 的例外情况。有关此列表所含条目的格式，请参阅 URLBlocklist 政策的说明。例如，将 URLBlocklist 设置为 * 会屏蔽所有请求，但您可以通过此政策来允许访问您所列出的部分网址。您可借助此政策为某些 scheme、其他网域的子网域、端口或特定路径设置例外情况（需使用指定格式，详见 https://support.google.com/chrome/a?p=url_blocklist_filter_format）。系统是会屏蔽还是会允许某个网址取决于最具体的过滤条件。URLAllowlist 政策的优先级高于 URLBlocklist。此政策最多只能包含 1,000 个条目。\n\n通过此政策，您还可让浏览器自动调用以下类型的外部应用：已注册为所列协议（如“tel:”或“ssh:”）的协议处理程序。\n\n如果您未设置此政策，URLBlocklist 将不会有任何例外情况。\n\n从 Brave 92 版开始，此政策在无头模式中也受支持。";
URLBlocklist.pfm_title = "阻止访问网址列表";
URLBlocklist.pfm_description = "通过设置 URLBlocklist 政策，您可禁止加载已列入屏蔽名单的网址所对应的网页。管理员可以列出要屏蔽的网址格式。如果未设置此政策，浏览器将不会屏蔽任何网址。URLAllowlist 中最多可定义 1,000 个例外网址。了解如何设置网址格式 (https://support.google.com/chrome/a?p=url_blocklist_filter_format)。\n\n注意：此政策不适用于通过页内 JavaScript 动态加载数据的网址。如果您屏蔽了 example.com/abc，example.com 仍可以使用 XMLHTTPRequest 加载该网页。另外，此政策不会阻止网页使用 JavaScript History API 将多功能框中显示的网址更新为已屏蔽的网址。\n\n从 Brave 73 版开始，您可以屏蔽 javascript://* 网址。不过，这仅会影响在地址栏或小书签等处输入的 JavaScript 网址。\n\n从 Brave 92 版开始，此政策在无头模式中也受支持。\n\n从 Brave 147 版开始，单独的通配符 * 不适用于内部 chrome:// 网址。如需屏蔽这些网址，您必须明确使用 chrome://* 格式。\n\n注意：屏蔽内部 chrome://* 网址和 chrome-untrusted://* 网址可能会导致意外错误，在某些情况下也可能会被规避。您最好查看是否存在更具体的政策，而不是屏蔽某些内部网址。例如：\n\n- 不要屏蔽 chrome://settings/certificates，而是使用 CACertificateManagementAllowed。\n\n- 不要屏蔽 chrome-untrusted://crosh，而是使用 SystemFeaturesDisableList。\n\n- 不要屏蔽 devtools://*，而是使用 DeveloperToolsAvailability、DeveloperToolsAvailabilityAllowlist 或 DeveloperToolsAvailabilityBlocklist 政策之一。";
UpdateOnZeroWindowEnabled.pfm_title = "控制在所有浏览器窗口关闭时是否自动在后台重新启动";
UpdateOnZeroWindowEnabled.pfm_description = "控制在 macOS 上有待处理的安全更新且所有浏览器窗口均已关闭时，是否允许在后台自动重启。\n\n如果此政策设为 True 或未设置，当所有浏览器窗口都关闭时，Brave 可以自动重新启动以应用待处理的更新。\n\n如果此政策设为 False，当所有浏览器窗口都关闭时，系统会停用自动重新启动功能。";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "启用以网址为键的匿名化数据收集功能";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "如果启用此政策，那么以网址为键的匿名化数据收集功能会始终处于开启状态，从而将用户访问的网页网址发送给 Google，以用于改善搜索和浏览体验。\n\n如果停用此政策，系统将不会启用以网址为键的匿名化数据收集功能。\n\n如果未设置此政策，用户将能手动更改此设置。\n\n在 Google Chrome OS 自助服务终端中，此政策不提供“允许用户决定”选项。如果未为 Google Chrome OS 自助服务终端设置此政策，系统会始终启用以网址为键的匿名化数据收集功能。\n为 Google Chrome OS 自助服务终端设置此政策后，系统会为自助服务终端应用启用以网址为键的指标收集功能。";
UserDataDir.pfm_title = "设置用户数据目录";
UserDataDir.pfm_description = "配置供 Brave 用于存储用户数据的目录。\n\n如果您设置了此政策，那么无论用户是否已指定“--user-data-dir”标记，Brave 都会使用此政策所提供的目录。为避免丢失数据或发生其他意外错误，请勿为此政策指定一个有其他用途的目录，因为 Brave 会管理目录内容。\n\n如需查看可用变量的列表，请访问 https://support.google.com/chrome/a?p=Supported_directory_variables。\n\n如果您未设置此政策，系统将会使用默认的个人资料路径，而用户可以使用“--user-data-dir”命令行标记来替换此路径。";
UserDataSnapshotRetentionLimit.pfm_title = "限制为供执行紧急回滚时使用而保留的用户数据快照的数量。";
UserDataSnapshotRetentionLimit.pfm_description = "每次实施完重大版本更新后，Chrome 都会为用户浏览数据的某些部分创建快照，以供日后执行紧急版本回滚时使用。如果对某个版本执行了紧急回滚，且用户拥有与此版本对应的快照，系统便会恢复相应快照中的数据。这就使得用户能够继续拥有自己的书签和自动填充数据等设置。\n\n如果此政策未设置，系统将会使用默认值（即 3）\n\n如果设置了此政策，系统便会酌情删除旧快照以遵守此限制。如果此政策设为 0，系统将不会创建任何快照";
UserFeedbackAllowed.pfm_title = "允许用户提供反馈";
UserFeedbackAllowed.pfm_description = "如果此政策已启用或未设置，用户便可通过依次转到“菜单”>“帮助”>“报告问题”或按下组合键来向 Google 发送反馈。\n\n如果此政策已停用，用户将无法向 Google 发送反馈。";
VideoCaptureAllowed.pfm_title = "是否允许视频捕获";
VideoCaptureAllowed.pfm_description = "如果此政策已启用或未设置，系统将会在收到针对录像设备的使用请求时提示用户，但 VideoCaptureAllowedUrls 列表中设置的网址除外。\n\n如果此政策已停用，系统将会关闭提示，而且只有 VideoCaptureAllowedUrls 列表中设置的网址可以使用录像设备。\n\n注意：此政策会影响所有录像设备（而不仅仅是内置摄像头）的视频输入。";
VideoCaptureAllowedUrls.pfm_title = "无需提示用户即可使用视频捕获设备的网址";
VideoCaptureAllowedUrls.pfm_description = "通过设置此政策，您可以指定一个网址列表，列表中的网址格式将与请求网址的安全源进行匹配。如果匹配成功，系统会在不提示用户的情况下直接允许相应网址使用录像设备\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns/。但请注意，此政策不支持可与任意网址匹配的“*”格式。";
VoiceTypingSettings.pfm_title = "“语音输入”功能设置";
VoiceTypingSettings.pfm_description = "0 - 允许使用“语音输入”功能。\n1 - 允许使用“语音输入”功能，但不收集数据。\n2 - 不允许使用“语音输入”功能。\n“语音输入”功能依托 AI 技术，让用户可以通过语音输入和编辑文字。该功能由生成式 AI 模型提供支持，可提供高质量的转写文本和格式编排。\n\n0 表示允许使用此功能，同时允许 Google 使用相关数据改进其 AI 模型。相关数据可能包括提示、输入、输出、素材和书面反馈，具体取决于相应功能。工作人员也可能会审核这些数据，以改进 AI 模型。除非下文另有说明，否则默认值是 0。\n\n1 表示允许使用此功能，但不允许 Google 使用用户内容（包括提示、输入、输出、素材和书面反馈）改进模型。对于受 Google Admin console管理的企业用户和受 Google Workspace 管理的教育版账号，默认值是 1。\n\n2 表示不允许使用此功能。\n\n如果此政策未设置，其行为将由 GenAiDefaultSettings 政策决定。\n\n如需详细了解生成式 AI 功能的数据处理机制，请访问 https://support.google.com/chrome/a?p=generative_ai_settings。";
WPADQuickCheckEnabled.pfm_title = "启用WPAD优化";
WPADQuickCheckEnabled.pfm_description = "如果此政策已启用或未设置，系统会在 Brave 中开启 WPAD（网络代理自动发现）优化设置。\n\n如果此政策已停用，系统会关闭 WPAD 优化设置，这会导致 Brave 必须等待更长时间，才能收到基于 DNS 的 WPAD 服务器的响应。\n\n无论您是否设置了此政策，用户都无法更改 WPAD 优化设置。";
WarnBeforeQuittingEnabled.pfm_title = "在用户尝试退出时显示警告对话框";
WarnBeforeQuittingEnabled.pfm_description = "控制系统是否会在用户尝试退出浏览器时显示“退出前警告 (⌘Q)”对话框。\n\n如果此政策已启用或未设置，当用户尝试退出时，系统会显示警告对话框。\n\n如果此政策已停用，当用户尝试退出时，系统不会显示警告对话框。";
WebAppInstallByUserEnabled.pfm_title = "允许用户从浏览器安装 Web 应用";
WebAppInstallByUserEnabled.pfm_description = "此政策用于控制用户能否通过浏览器安装 Web 应用。\n如果您启用或不配置此政策，用户将能通过浏览器安装 Web 应用。\n如果您停用此政策，用户将无法通过浏览器安装 Web 应用，并且“应用”数据类型将从 Chrome Sync操作中排除，不会进行同步。\n此政策不支持动态刷新。无论是启用、停用还是取消设置，任何更改都只会在浏览器重启后生效。\n此政策不会影响“WebAppInstallForceList”政策。";
WebAppInstallForceList.pfm_title = "要静默安装的网络应用的网址。";
WebAppInstallForceList.pfm_description = "通过设置此政策，您能以列表形式指定哪些 Web 应用无需用户互动即可静默安装，且无法由用户卸载或停用。\n\n此政策的每个列表项都是一个对象，其中包含 1 个必要成员：\nurl（要安装的 Web 应用的网址）\n\n以及 6 个可选成员：\n- default_launch_container\n（用于指明 Web 应用的打开方式，默认在新标签页中打开）\n\n- create_desktop_shortcut\n（如果您想创建 Linux 和 Microsoft® Windows® 桌面快捷方式，请设为 True。）\n\n- fallback_app_name\n（自 Brave 90 版起，让您能够替换非渐进式 Web 应用 [PWA] 的应用名称，或替换临时安装但在安装完毕之前需进行身份验证的 PWA 的应用名称。如果同时提供了 custom_name 和 fallback_app_name，系统会忽略后者。）\n\n- custom_name\n（自 Google Chrome OS 99 版以及所有其他桌面操作系统上的 112 版起，让您能永久替换所有 Web 应用和 PWA 的应用名称。）\n\n- custom_icon\n（自 Google Chrome OS 99 版以及所有其他桌面操作系统上的 112 版起，让您能替换安装式应用的应用图标。图标必须为方形，大小不超过 1 MB，并采用以下格式之一：jpeg、png、gif、webp、ico。\n哈希值必须是图标文件的 SHA256 哈希。url 应可直接访问，无需身份验证，以确保可以在应用安装后使用该图标。）\n\n- install_as_shortcut\n（自 Brave 107 版起。）如果此政策已启用，给定的 url 将作为快捷方式安装，就像通过桌面浏览器 GUI 中的“创建快捷方式…”选项完成安装一样。\n请注意，如果作为快捷方式安装，它不会在 url 中的清单发生变化时更新。\n如果此政策已停用或未设置，给定 url 中的 Web 应用将正常安装。\n\n如需了解如何将应用固定到 Google Chrome OS 任务栏中，请参阅 PinnedLauncherApps。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=WebAppInstallForceList。";
WebAppSettings.pfm_title = "Web 应用管理设置";
WebAppSettings.pfm_description = "通过此政策，管理员可为已安装的 Web 应用指定设置。此政策将 Web 应用 ID 与其具体设置对应起来。可以使用特殊 ID“*”设定一项默认配置，这样，未在此政策中自定义配置的所有 Web 应用都将采用该默认配置。\n\nmanifest_id 字段用于指明相应 Web 应用的清单 ID。如需了解怎样确定某个已安装 Web 应用的清单 ID，请参阅 https://developer.chrome.com/blog/pwa-manifest-id/。\nrun_on_os_login 字段用于指明 Web 应用能否在用户登录操作系统期间运行。如果此字段设为“blocked”，相应 Web 应用将不会在用户登录操作系统期间运行，用户后续也无法启用此字段。如果此字段设为“run_windowed”，相应 Web 应用将会在用户登录操作系统期间运行，且用户后续无法停用此字段。如果此字段设为“allowed”，则用户可以将相应 Web 应用配置为在登录操作系统期间运行。默认配置仅接受“allowed”值和“blocked”值。\n（自 117 版起）prevent_close_after_run_on_os_login 字段用于指明是否应阻止以任何方式（例如由用户、任务管理器、Web API）关闭 Web 应用。只有在 run_on_os_login 设为“run_windowed”时，才能允许这种行为。如果应用已经在运行，只有在重启应用后，此属性才会生效。如果未指定此字段，用户将可以关闭应用。\n（自 118 版起）force_unregister_os_integration 字段用于指明是否要移除 Web 应用的所有操作系统集成，即快捷方式、文件处理程序、协议处理程序等。如果应用已经在运行，只有在重启应用后，此属性才会生效。请谨慎使用此字段，因为这可能会覆盖在 Web 应用系统启动期间自动设置的所有操作系统集成。目前仅适用于 Windows、Mac 和 Linux 平台。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=WebAppSettings。";
WebAudioOutputBufferingEnabled.pfm_title = "为 Web Audio 启用自适应缓冲";
WebAudioOutputBufferingEnabled.pfm_description = "此政策旨在控制浏览器是否对 Web Audio 应用自适应缓冲，该缓冲虽然可能有助于减少音频干扰，但可能会使延迟时间增加一个不定的量。\n\n如果此政策已启用，系统将始终使用自适应缓冲。\n\n如果此政策已停用或未设置，浏览器功能启动流程将决定是否使用自适应缓冲。";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "允许源通过代理从远程桌面应用发出 WebAuthn 请求。";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "这是一个远程桌面客户端应用的源列表，这些应用可执行来自远程主机浏览会话的 WebAuthn API 请求。\n\n在此政策中配置的任何源，都可以为那些它通常无权声明代表的依赖方 ID (RP ID) 发起 WebAuthn 请求。\n\n仅允许使用有效的 HTTPS 源。不支持通配符。\n系统会忽略所有无效条目。\n\n此政策仅适用于已关联的用户。";
WebHidAllowAllDevicesForUrls.pfm_title = "自动授权这些网站连接到任意 HID 设备。";
WebHidAllowAllDevicesForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址，从而指定自动授权哪些网站访问所有可用的设备。\n\n这些网址必须有效，否则系统会忽略此政策。系统将仅考虑相应网址的来源（架构、主机和端口）。\n\n在 Chrome 操作系统上，此政策仅适用于已关联的用户。\n\n此政策会覆盖 DefaultWebHidGuardSetting、WebHidAskForUrls、WebHidBlockedForUrls 和用户的偏好设置。";
WebHidAllowDevicesForUrls.pfm_title = "自动授权这些网站连接到具有给定供应商 ID 和产品 ID 的 HID 设备。";
WebHidAllowDevicesForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址，从而指定自动授权哪些网站访问具有给定供应商 ID 和产品 ID 的 HID 设备。列表中的每个项都必须同时包含“devices”和“urls”字段才有效，否则便无效。“devices”字段中的每个项都必须包含“vendor_id”字段且可以包含“product_id”字段。如果您省略“product_id”字段，系统将会创建一项与所有具有给定供应商 ID 的设备都匹配的政策。包含“product_id”字段但不含“vendor_id”字段的项无效，会被忽视。\n\n如果您未设置此政策，那么，倘若 DefaultWebHidGuardSetting 已设置，系统便会应用它，否则就会应用用户的个人设置。\n\n此政策中的网址不应与通过 WebHidBlockedForUrls 配置的网址冲突。如果它们冲突，此政策优先于 WebHidBlockedForUrls。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls。";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "自动授权这些网站连接到提供了包含给定 HID 用法的顶层集合的 HID 设备。";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址，从而指定自动授权哪些网站访问提供了包含给定 HID 用法的顶层集合的 HID 设备。列表中的每个项都必须同时包含“usages”和“urls”字段，此政策才有效。“usages”字段中的每个项都必须包含“usage_page”字段且可以包含“usage”字段。如果您省略“usage”字段，系统将会创建一项与所有提供了给定用法页面所含用法的顶层集合的设备都匹配的政策。包含“usage”字段但不含“usage_page”字段的项无效，会被忽视。\n\n如果您未设置此政策，那么，倘若 DefaultWebHidGuardSetting 已设置，系统便会应用它，否则就会应用用户的个人设置。\n\n此政策中的网址不应与通过 WebHidBlockedForUrls 配置的网址冲突。如果它们冲突，此政策优先于 WebHidBlockedForUrls。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls。";
WebHidAskForUrls.pfm_title = "允许在这些网站上使用 WebHID API";
WebHidAskForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，用于指定哪些网站可以请求用户授权其访问 HID 设备。\n\n未设置此政策时，如果 DefaultWebHidGuardSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n对于不符合此政策的网址格式，系统会依序优先应用以下政策：\n\n  * WebHidBlockedForUrls（若存在匹配项）、\n\n  * DefaultWebHidGuardSetting（若已设置）或\n\n  * 用户的个人设置。\n\n网址格式不得与 WebHidBlockedForUrls 冲突。如果某个网址与这两项政策都相符，系统将不会优先应用任一项政策。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
WebHidBlockedForUrls.pfm_title = "禁止在这些网站上使用 WebHID API";
WebHidBlockedForUrls.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，用于指定哪些网站无法请求用户授权其访问 HID 设备。\n\n未设置此政策时，如果 DefaultWebHidGuardSetting 已设置，系统便会将它应用于所有网站，否则就会应用用户的个人设置。\n\n对于不符合此政策的网址格式，系统会依序优先应用以下政策：\n\n  * WebHidAskForUrls（若存在匹配项）、\n\n  * DefaultWebHidGuardSetting（若已设置）或\n\n  * 用户的个人设置。\n\n网址格式不能与 WebHidAskForUrls 冲突。如果某个网址与这两项政策都相符，系统将不会优先应用任一项政策。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "为特定源启用 WebRTC 诊断日志收集功能";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "此政策允许针对特定源启用 WebRTC 诊断日志收集功能。\n\n如需详细了解有效的输入格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。此政策只能根据源进行匹配，因此网址格式中的任何路径都会被忽略。支持协议和子网域。\n\n如果设置了此政策，系统将为与列表中格式相符的源启用诊断日志收集功能。\n\n如果未设置此政策，系统将默认停用诊断日志收集功能。";
WebRtcEventLogCollectionAllowed.pfm_title = "允许从 Google 服务收集 WebRTC 事件日志";
WebRtcEventLogCollectionAllowed.pfm_description = "如果此政策已启用，Brave 便可从 Google 服务（例如 Hangouts Meet）收集 WebRTC 事件日志并将它们上传到 Google。这些日志包含一些诊断信息，例如 RTP 数据包的时间和大小、网络拥塞情况反馈，以及与语音帧和视频帧的时间和质量相关的元数据。在调试 Brave 中的语音会议或视频会议问题时，这些信息非常有用。这些日志不包含会议的任何音频或视频内容。为了更便于进行调试，Google 可能会利用会话 ID 将这些日志与 Google 服务自身收集的其他日志关联起来。\n\n如果此政策已停用，系统将不会收集和上传此类日志。\n\n在 M76 或更早版本中，不设置此政策意味着 Brave 默认无法收集和上传这些日志。从 M77 开始，Brave 默认能够从受基于云的用户级企业政策影响的大多数个人资料中收集并上传这些日志。从 M77 到 M80（含），Brave 还默认能从受 Brave 本地管理功能影响的个人资料中收集并上传这些日志。";
WebRtcIPHandling.pfm_title = "WebRTC IP 处理";
WebRtcIPHandling.pfm_description = "default - WebRTC 会在搜索最佳路径时使用所有可用接口。\ndefault_public_and_private_interfaces - WebRTC 会仅使用连接到公共互联网的接口，但可能会使用专用 IP 地址进行连接。\ndefault_public_interface_only - WebRTC 会仅使用连接到公共互联网的接口，且不会使用专用 IP 地址进行连接。\ndisable_non_proxied_udp - WebRTC 会在面向公众的接口中使用 TCP；若受所配置的代理支持，则会仅使用 UDP。\n通过设置此政策，您可以限制 WebRTC 在尝试查找最佳的可用连接时会使用的 IP 地址和接口。\n\n有效值：\n\n* default - WebRTC 使用所有可用的网络接口。\n\n* default_public_and_private_interfaces - WebRTC 使用所有公共和专用接口。\n\n* default_public_interface_only - WebRTC 使用所有公共接口，但不使用专用接口。\n\n* disable_non_proxied_udp - WebRTC 使用 UDP SOCKS 代理，或回退到 TCP 代理。\n\n如果未设置此政策，WebRTC 会默认使用所有可用网络接口。如需详细了解所有处理值，请参阅 RFC 8828 第 5.2 条 (https://tools.ietf.org/html/rfc8828.html#section-5.2)";
WebRtcIPHandlingUrl.pfm_title = "WebRTC 网址级 IP 处理";
WebRtcIPHandlingUrl.pfm_description = "通过设置此政策，您可以限制 WebRTC 在尝试查找每个特定网址格式的最佳可用连接时会使用的 IP 地址和接口。\n\n它接受一系列网址格式和处理类型对。系统会按顺序检查网址格式，第一个匹配项将配置 WebRTC 为该网域使用哪种处理方式。如果当前文档的网址与任何条目都不匹配，则会使用政策 WebRtcIPHandling 设置的配置。\n\n如需详细了解有效的输入格式，请访问 https://chromeenterprise.google/policies/url-patterns/。允许使用通配符 *。此政策只会根据源进行匹配，因此网址格式中的任何路径都会被忽略。\n\n有效的处理值：\n\n* default - WebRTC 使用所有网络接口。\n\n* default_public_and_private_interfaces - WebRTC 使用所有公共和专用接口。\n\n* default_public_interface_only - WebRTC 使用所有公共接口，但不使用专用接口。\n\n* disable_non_proxied_udp - WebRTC 使用 UDP SOCKS 代理，或回退到 TCP 代理。\n\n如需详细了解所有处理值，请参阅 RFC 8828 第 5.2 条 (https://tools.ietf.org/html/rfc8828.html#section-5.2)\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl。";
WebRtcLocalIpsAllowedUrls.pfm_title = "在 WebRTC ICE 候选路径中显示本地 IP 的网址";
WebRtcLocalIpsAllowedUrls.pfm_description = "系统会将此列表中的网址格式与请求网址的安全来源进行比对。\n如果找到了匹配项或者 chrome://flags/#enable-webrtc-hide-local-ips-with-mdns 已停用，本地 IP 地址就会显示在 WebRTC ICE 候选路径中。\n否则，本地 IP 地址将会隐藏，被 mDNS 主机名取代。\n请注意，此政策会削弱对本地 IP 的保护（如果管理员需要这样做）。";
WebRtcPostQuantumKeyAgreement.pfm_title = "为 WebRTC 启用后量子密钥协议";
WebRtcPostQuantumKeyAgreement.pfm_description = "此政策用于控制 WebRTC 的后量子密钥协议。\n\n如果已启用此政策，系统将为 WebRTC 提供后量子密钥协议。\n\n如果已停用此政策，系统将不会为 WebRTC 提供后量子密钥协议。\n\n如果未设置此政策，系统将会按照为 WebRTC 提供的后量子密钥协议的默认发布流程来设置相应的值。\n\n提供后量子密钥协议可实现向后兼容。现有的 DTLS 对等体和网络中间件预计会忽略这个新选项，并继续沿用以前的选项。\n\n但是，在提供新选项后，未正确实现 DTLS 的设备可能会发生故障。例如，当遇到无法识别的选项或产生较长的消息时，这些设备可能会断开连接。这些设备尚不支持后量子密钥协议，会妨碍企业改用该算法。如果遇到这种情况，管理员应联系供应商以寻求解决方案。\n\n此政策只是一种临时的变通方案，将在达成几个里程碑后被移除。";
WebRtcTextLogCollectionAllowed.pfm_title = "允许从 Google 服务收集 WebRTC 文本日志";
WebRtcTextLogCollectionAllowed.pfm_description = "如果此政策设为启用，Brave 便可从 Google Meet 等 Google 服务收集 WebRTC 文本日志，并将其上传到 Google。这些日志包含诊断信息，例如描述传入和传出 WebRTC 流的文本元数据、特定于 WebRTC 的日志条目，以及其他系统信息。在调试 Brave 中的语音会议或视频会议问题时，这些信息非常有用。这些日志不包含会议的任何音频或视频内容。\n如果此政策设为停用，系统将不会向 Google 上传此类日志。不过，日志仍会存储在用户设备本地，而且存储的日志会越来越多。如果此政策未设置，Brave 将默认能够收集和上传这些日志。";
WebRtcUdpPortRange.pfm_title = "限制 WebRTC 使用的本地 UDP 端口的范围";
WebRtcUdpPortRange.pfm_description = "如果此政策已设置，则 WebRTC 使用的 UDP 端口范围将仅限于指定的端口区间（包括端点）。\n\n如果此政策未设置，或者它设置为空字符串或无效端口范围，则允许 WebRTC 使用任何可用的本地 UDP 端口。";
WebUsbAllowDevicesForUrls.pfm_title = "自动授权这些网站通过给定的供应商 ID 和产品 ID 连接到 USB 设备。";
WebUsbAllowDevicesForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址格式，从而指定自动授权哪些网站访问具有给定供应商 ID 和产品 ID 的 USB 设备。列表中的每项内容都必须同时包含“devices”和“urls”字段，此政策才有效。“devices”字段中的每项内容都可以包含“vendor_id”和“product_id”字段。如果您省略“vendor_id”字段，系统将会创建一项与所有设备都匹配的政策。如果您省略“product_id”字段，系统将会创建一项与所有具有给定供应商 ID 的设备都匹配的政策。包含“product_id”字段但不含“vendor_id”字段的政策无效。\n\nUSB 权限模型会授权指定网址作为顶级来源访问相应 USB 设备。如果嵌入式框架需要访问 USB 设备，则应通过“usb”feature-policy 标头获得授权。该网址必须有效，否则系统会忽略此政策。\n\n已弃用：用于支持同时指定请求网址和嵌入网址的 USB 权限模型。此模型已被弃用，仅在通过下述方式实现向后兼容性时受支持：如果同时指定了请求网址和嵌入网址，嵌入网址会被授权作为顶级来源，请求网址则会被完全忽略。\n\n此政策会覆盖 DefaultWebUsbGuardSetting、WebUsbAskForUrls、WebUsbBlockedForUrls 和用户的偏好设置。\n\n此政策仅会对通过 WebUSB API 访问 USB 设备产生影响。若要通过 Web Serial API 授权访问 USB 设备，请参见 SerialAllowUsbDevicesForUrls 政策。\n要详细了解架构和格式，请访问 https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls。";
WebUsbAskForUrls.pfm_title = "允许这些网站使用 WebUSB";
WebUsbAskForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址格式，从而指定哪些网站可以请求用户授权其访问 USB 设备。\n\n未设置此政策时，如果已设置 DefaultWebUsbGuardSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n网址格式不得与 WebUsbAskForUrls 冲突。如果某个网址与这两项政策都相符，系统将不会优先应用任一项政策。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
WebUsbBlockedForUrls.pfm_title = "禁止这些网站使用 WebUSB";
WebUsbBlockedForUrls.pfm_description = "通过设置此政策，您可以罗列一些网址格式，从而指定哪些网站无法请求用户授权其访问 USB 设备。\n\n未设置此政策时，如果已设置 DefaultWebUsbGuardSetting，则系统会将其应用于所有网站，否则应用用户的个人设置。\n\n网址格式不能与 WebUsbAskForUrls 冲突。如果某个网址与这两项政策都相符，系统将不会优先应用任一项政策。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns。* 不是此政策可接受的值。";
WindowCaptureAllowedByOrigins.pfm_title = "允许这些来源使用窗口和标签页截取功能";
WindowCaptureAllowedByOrigins.pfm_description = "通过设置此政策，您可以创建一个网址格式列表，指定哪些网站能够使用窗口和标签页捕获功能。\n\n如果未设置此政策，系统将不会考虑在这种捕获级别覆盖网站的默认行为。\n\n如果相应网站与 TabCaptureAllowedByOrigins 或 SameOriginTabCaptureAllowedByOrigins 政策中的网址格式匹配，系统将不会考虑此政策。\n\n如果相应网站与此政策中的网址格式匹配，系统将不会考虑以下政策：ScreenCaptureAllowedByOrigins、ScreenCaptureAllowed。\n\n如需详细了解有效的 url 格式，请访问 https://chromeenterprise.google/policies/url-patterns/。此政策只会根据源进行匹配，因此网址格式中的任何路径都会被忽略。";
WindowManagementAllowedForUrls.pfm_title = "向这些网站授予窗口管理权限";
WindowManagementAllowedForUrls.pfm_description = "此政策允许您设置一个网站网址格式列表，用于指定要自动向哪些网站授予“窗口管理”权限。获得此权限的网站可以执行以下操作：查看设备屏幕的相关信息，使用该信息打开并放置窗口，或请求在特定屏幕上进入全屏模式。\n\n如需详细了解有效的网站网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。此政策只能根据源进行匹配，因此网址格式中的任何路径都会被忽略。\n\n没有为某个网站设置此政策时，如果 DefaultWindowManagementSetting 政策已设置，系统便会将它应用于该网站，否则会沿用浏览器的默认权限设置并允许用户按网站选择这项权限。\n\n此政策取代了已弃用的 WindowPlacementAllowedForUrls 政策。";
WindowManagementBlockedForUrls.pfm_title = "拒绝向这些网站授予窗口管理权限";
WindowManagementBlockedForUrls.pfm_description = "此政策允许您设置一个网站网址格式列表，用于指定要自动拒绝向哪些网站授予“窗口管理”权限。这会限制网站执行以下操作：查看设备屏幕的相关信息，使用该信息打开并放置窗口，或请求在特定屏幕上进入全屏模式。\n\n如需详细了解有效的网站网址格式，请访问 https://chromeenterprise.google/policies/url-patterns。允许使用通配符 *。此政策只能根据源进行匹配，因此网址格式中的任何路径都会被忽略。\n\n没有为某个网站设置此政策时，如果 DefaultWindowManagementSetting 政策已设置，系统便会将它应用于该网站，或者沿用浏览器的默认权限设置并允许用户按网站选择这项权限。\n\n此政策取代了已弃用的 WindowPlacementBlockedForUrls 政策。";
XSLTEnabled.pfm_title = "控制 XSLT 功能的可用性";
XSLTEnabled.pfm_description = "此政策用于控制 XSLT 功能（XSLTProcessor JavaScript API 和 XSL 处理指令）的可用性。\n如果此政策已启用，无论浏览器中此功能的默认状态如何，XSLT 都将可用。\n如果此政策已停用，无论浏览器中此功能的默认状态如何，XSLT 都将不可用。\n如果此政策未设置，XSLT 的可用性将由浏览器的默认设置和现场试验决定。\n此政策是一项暂时性措施，将在 M176 中移除。";