    <style name="BraveButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_marginEnd">48dp</item>
        <item name="android:layout_marginStart">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="HintStyle" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/hint_color</item>
    </style>
    <style name="OnboardingWindowAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
    <style name="TextInputLayout">
        <item name="colorControlNormal">@color/text_input_layout_activated</item>
        <item name="colorControlActivated">@color/text_input_layout_activated</item>
        <item name="colorControlHighlight">@color/text_input_layout_activated</item>
        <item name="android:textColorHint">@color/hint_color</item>
    </style>
    <style name="playlistSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressBackgroundTint">@color/playlist_progress_bar_tint_bg</item>
        <item name="android:progressTint">@color/playlist_progress_bar_tint</item>
        <item name="android:thumbTint">@color/playlist_progress_bar_tint</item>
    </style>
    <declare-styleable name="BottomPanelLayout">
        <attr format="dimension" name="panelHeight"/>
        <attr format="reference" name="scrollableView"/>
        <attr format="enum" name="initialState">
            <enum name="expanded" value="0"/>
            <enum name="collapsed" value="1"/>
            <enum name="anchored" value="2"/>
            <enum name="hidden" value="3"/>
        </attr>
    </declare-styleable>
    <declare-styleable name="PlaylistToolbar">
        <attr format="string" name="title"/>
        <attr format="boolean" name="showOptions"/>
        <attr format="boolean" name="showActionButton"/>
        <attr format="string" name="actionButtonText"/>
        <attr format="boolean" name="requireDarkMode"/>
        <attr format="reference" name="backButtonIcon"/>
        <attr format="reference" name="backButtonTint"/>
        <attr format="reference" name="optionButtonIcon"/>
        <attr format="reference" name="optionButtonTint"/>
    </declare-styleable>
</resources>