      <include name="IDR_NETWORK_ERRORS_NETWORK_ERRORS_LISTING_JS" file="${root_gen_dir}/content/browser/resources/net/minified/network_errors_listing.js" resource_path="network_errors_listing.js" use_base_dir="false" type="chrome_html" />
