<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/histograms_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/histograms_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/histograms_resources_map.h"
            type="resource_map_header" />
    <output filename="histograms_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_HISTOGRAMS_HISTOGRAMS_INTERNALS_CSS" file="${root_gen_dir}/content/browser/resources/histograms/preprocessed/histograms_internals.css" resource_path="histograms_internals.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_HISTOGRAMS_HISTOGRAMS_INTERNALS_HTML" file="${root_gen_dir}/content/browser/resources/histograms/preprocessed/histograms_internals.html" resource_path="histograms_internals.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_HISTOGRAMS_HISTOGRAMS_INTERNALS_JS" file="${root_gen_dir}/content/browser/resources/histograms/minified/histograms_internals.js" resource_path="histograms_internals.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
