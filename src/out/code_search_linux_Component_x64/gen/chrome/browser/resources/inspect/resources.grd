<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/inspect_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/inspect_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/inspect_resources_map.h"
            type="resource_map_header" />
    <output filename="inspect_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_INSPECT_INSPECT_CSS" file="${root_gen_dir}/chrome/browser/resources/inspect/preprocessed/inspect.css" resource_path="inspect.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_INSPECT_INSPECT_HTML" file="${root_gen_dir}/chrome/browser/resources/inspect/preprocessed/inspect.html" resource_path="inspect.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INSPECT_INSPECT_JS" file="${root_gen_dir}/chrome/browser/resources/inspect/minified/inspect.js" resource_path="inspect.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
