--crate-name
cloud_authenticator_test_service
--crate-type
bin
--edition=2024
-Dwarnings
-Cforce-unwind-tables=yes
-Crelocation-model=pic
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--color=always
--target=x86_64-unknown-linux-gnu
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
--cfg
cr_rustc_revision="110108a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-8a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-1-24-14453-ge063be79"
-Copt-level=3
-Cforce-frame-pointers=yes
-Zallow-features=
-Cdebug-assertions
-Zdefault-visibility=hidden
-Funsafe_code
--sysroot=local_rustc_sysroot
-Ldependency=obj/third_party/cloud_authenticator/cbor/cbor
-Ldependency=obj/third_party/rust/bytes/v1/lib
-Ldependency=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib
