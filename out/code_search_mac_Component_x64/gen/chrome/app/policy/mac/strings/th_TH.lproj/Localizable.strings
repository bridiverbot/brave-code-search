Brave.pfm_title = "Brave";
Brave.pfm_description = "ค่ากำหนดของ Brave";
AIModeSettings.pfm_title = "การตั้งค่าสำหรับการผสานรวมโหมด AI ของ Google ในแถบที่อยู่และช่องค้นหาในหน้าแท็บใหม่";
AIModeSettings.pfm_description = "0 - อนุญาตการผสานรวมโหมด AI\n1 - ไม่อนุญาตให้ใช้การผสานรวมโหมด AI\nนโยบายนี้ควบคุมการผสานรวมโหมด AI ของ Google ในแถบที่อยู่และช่องค้นหาในหน้าแท็บใหม่\n\nหากต้องการเข้าถึงฟีเจอร์นี้ ผู้ใช้จะต้องตั้งค่า Google เป็นเครื่องมือค้นหาเริ่มต้น\n\n0 = ฟีเจอร์นี้จะพร้อมใช้งานสำหรับผู้ใช้\n\n1 = ฟีเจอร์นี้จะไม่พร้อมใช้งานสำหรับผู้ใช้\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings";
AbusiveExperienceInterventionEnforce.pfm_title = "การบังคับใช้การแทรกแซงเมื่อเกิดประสบการณ์ที่ไม่เหมาะสม";
AbusiveExperienceInterventionEnforce.pfm_description = "หาก SafeBrowsingEnabled ไม่ได้ตั้งค่าเป็น \"ปิดใช้\" การตั้งค่า AbusiveExperienceInterventionEnforce เป็น \"เปิดใช้\" หรือการไม่ตั้งค่าก็จะป้องกันไม่ให้เว็บไซต์ที่มีการใช้งานที่ไม่เหมาะสมเปิดหน้าต่างหรือแท็บใหม่\n\nการตั้งค่า SafeBrowsingEnabled หรือ AbusiveExperienceInterventionEnforce เป็น \"ปิดใช้\" จะอนุญาตให้เว็บไซต์ที่มีการใช้งานที่ไม่เหมาะสมเปิดหน้าต่างหรือแท็บใหม่";
AccessCodeCastDeviceDuration.pfm_title = "ระบุระยะเวลา (เป็นวินาที) ซึ่งอุปกรณ์แคสต์ที่เลือกไว้ด้วยรหัสการเข้าถึงหรือคิวอาร์โค้ดจะคงอยู่ในรายชื่ออุปกรณ์แคสต์ในเมนูของ Google Cast";
AccessCodeCastDeviceDuration.pfm_description = "นโยบายนี้จะระบุระยะเวลา (เป็นวินาที) ที่จะแสดงอุปกรณ์แคสต์ซึ่งเลือกไว้ก่อนหน้านี้ผ่านรหัสการเข้าถึงหรือคิวอาร์โค้ด ภายในเมนูอุปกรณ์แคสต์ของ Google Cast\nระยะเวลาตลอดอายุของรายการหนึ่งจะเริ่ม ณ เวลาที่ป้อนรหัสการเข้าถึงหรือสแกนคิวอาร์โค้ดเป็นครั้งแรก\nระหว่างระยะเวลานี้ อุปกรณ์แคสต์ดังกล่าวจะปรากฏในรายชื่ออุปกรณ์แคสต์บนเมนูของ Google Cast\nหลังจากระยะเวลานี้ หากต้องการใช้อุปกรณ์แคสต์นั้นอีกครั้ง จะต้องมีการป้อนรหัสการเข้าถึงหรือสแกนคิวอาร์โค้ดอีกครั้ง\nโดยค่าเริ่มต้น ระยะเวลาจะอยู่ที่ 0 วินาที อุปกรณ์แคสต์จึงจะไม่คงอยู่ในเมนูของ Google Cast และจะต้องป้อนรหัสการเข้าถึงหรือสแกนคิวอาร์โค้ดอีกครั้งเพื่อเริ่มต้นเซสชันการแคสต์ใหม่\nโปรดทราบว่านโยบายนี้ส่งผลต่อระยะเวลาที่อุปกรณ์แคสต์ปรากฏในเมนูของ Google Cast เท่านั้น และจะไม่ส่งผลต่อเซสชันการแคสต์ต่อเนื่องใดๆ ซึ่งจะดำเนินต่อไปแม้ระยะเวลาดังกล่าวหมดอายุแล้ว\nนโยบายนี้จะไม่มีผล เว้นแต่จะตั้งค่านโยบาย AccessCodeCastEnabled ไว้เป็น \"เปิดใช้\"";
AccessCodeCastEnabled.pfm_title = "อนุญาตให้ผู้ใช้เลือกอุปกรณ์แคสต์ด้วยรหัสการเข้าถึงหรือคิวอาร์โค้ดจากภายในเมนูของ Google Cast";
AccessCodeCastEnabled.pfm_description = "นโยบายนี้ควบคุมว่าผู้ใช้จะเห็นตัวเลือกภายในเมนูของ Google Cast ซึ่งอนุญาตให้ผู้ใช้แคสต์ไปยังอุปกรณ์แคสต์ที่ไม่ปรากฏในเมนูของ Google Cast หรือไม่ โดยใช้รหัสการเข้าถึงหรือคิวอาร์โค้ดที่แสดงบนหน้าจอของอุปกรณ์แคสต์\nโดยค่าเริ่มต้น ผู้ใช้ต้องป้อนรหัสการเข้าถึงหรือสแกนคิวอาร์โค้ดอีกครั้งเพื่อเริ่มเซสชันการแคสต์ครั้งต่อไป แต่หากตั้งค่านโยบาย AccessCodeCastDeviceDuration เป็นค่าที่ไม่ใช่ 0 (ค่าเริ่มต้นเป็น 0) อุปกรณ์แคสต์จะยังคงอยู่ในรายชื่ออุปกรณ์แคสต์ที่พร้อมใช้งานจนกว่าระยะเวลาที่ระบุไว้จะหมดอายุ\nเมื่อตั้งค่านโยบายนี้เป็น \"เปิดใช้\" ผู้ใช้จะเห็นตัวเลือกให้เลือกอุปกรณ์แคสต์โดยใช้รหัสการเข้าถึงหรือด้วยการสแกนคิวอาร์โค้ด\nเมื่อตั้งค่านโยบายนี้เป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า ผู้ใช้จะไม่เห็นตัวเลือกให้เลือกอุปกรณ์แคสต์โดยใช้รหัสการเข้าถึงหรือด้วยการสแกนคิวอาร์โค้ด";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "ทำให้ Access-Control-Allow-Methods ตรงกันกับข้อกำหนดในการตรวจสอบล่วงหน้าของ CORS ที่เข้ากันได้";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "นโยบายนี้ควบคุมว่าเมธอดคำขอจะเป็นตัวพิมพ์ใหญ่หรือไม่เมื่อตรงกับส่วนหัวการตอบกลับ Access-Control-Allow-Methods ในการตรวจสอบล่วงหน้าของ CORS\n\nหากปิดใช้นโยบาย ระบบจะใช้เมธอดคำขอเป็นตัวพิมพ์ใหญ่\nซึ่งเป็นลักษณะการทำงานใน \"Brave\" เวอร์ชัน 108 หรือก่อนหน้านั้น\n\nหากเปิดใช้นโยบายหรือไม่ได้ตั้งค่า เมธอดคำขอจะไม่เป็นตัวพิมพ์ใหญ่ เว้นแต่กรณีที่ตรงกับ DELETE, GET, HEAD, OPTIONS, POST หรือPUT โดยไม่คำนึงถึงตัวพิมพ์เล็กและตัวพิมพ์ใหญ่\nการดำเนินการนี้จะปฏิเสธส่วนหัวการตอบกลับ fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" และจะยอมรับส่วนหัวการตอบกลับ fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\"\n\nหมายเหตุ: เมธอดคำขอ \"post\" และ \"put\" ไม่ได้รับผลกระทบ แต่จะมีผลกระทบต่อ \"patch\"\n\nนโยบายนี้มีไว้เพื่อใช้ชั่วคราวและจะนำออกในอนาคต";
AccessibilityImageLabelsEnabled.pfm_title = "เปิดใช้ Get Image Descriptions from Google";
AccessibilityImageLabelsEnabled.pfm_description = "ฟีเจอร์การช่วยเหลือพิเศษ Get Image Descriptions from Google ช่วยให้ผู้ใช้โปรแกรมอ่านหน้าจอซึ่งมีความบกพร่องทางสายตารู้รายละเอียดของรูปภาพในเว็บที่ไม่มีป้ายกำกับบอกไว้ ผู้ใช้ที่เลือกเปิดใช้ฟีเจอร์จะมีตัวเลือกการใช้บริการ Google ที่ไม่ระบุตัวบุคคล เพื่อฟังคำอธิบายแบบอัตโนมัติสำหรับรูปภาพที่ไม่ได้ติดป้ายกำกับซึ่งผู้ใช้พบเจอในเว็บ\n\nหากมีการเปิดใช้ฟีเจอร์นี้ ระบบจะส่งเนื้อหาของรูปภาพไปยังเซิร์ฟเวอร์ของ Google เพื่อสร้างคำอธิบาย จะไม่มีการส่งคุกกี้หรือข้อมูลผู้ใช้อื่นๆ และ Google จะไม่บันทึกเนื้อหารูปภาพใดๆ\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" ฟีเจอร์ Get Image Descriptions from Google จะเปิดใช้ แต่จะมีผลเฉพาะกับผู้ใช้ที่ใช้โปรแกรมอ่านหน้าจอหรือเทคโนโลยีความช่วยเหลือพิเศษที่คล้ายกันอื่นๆ เท่านั้น\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ผู้ใช้จะไม่มีตัวเลือกให้เปิดใช้ฟีเจอร์\n\nหากไม่ได้ตั้งค่านโยบายนี้ ผู้ใช้จะเลือกใช้หรือไม่ใช้ฟีเจอร์นี้ได้\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "อนุญาตคำขอ DNS สำหรับประเภทระเบียน DNS เพิ่มเติม";
AdditionalDnsQueryTypesEnabled.pfm_description = "นโยบายนี้ควบคุมว่า Brave จะส่งคำขอประเภทระเบียน DNS เพิ่มเติมเมื่อสร้างคำขอ DNS ที่ไม่ปลอดภัยได้หรือไม่ นโยบายนี้ไม่มีผลต่อคำขอ DNS ที่สร้างผ่าน DNS ที่ปลอดภัย ซึ่งจะส่งคำขอประเภท DNS เพิ่มเติมทุกครั้ง\n\nหากไม่ได้ตั้งค่านโยบายนี้หรือตั้งค่าเป็น \"เปิดใช้\" ระบบจะส่งคำขอประเภทเพิ่มเติม เช่น HTTPS (DNS ประเภท 65) นอกเหนือไปจาก A (DNS ประเภท 1) และ AAAA (DNS ประเภท 28)\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" DNS จะส่งคำขอเฉพาะ A (DNS ประเภท 1) และ/หรือ AAAA (DNS ประเภท 28)\n\nนโยบายนี้เป็นมาตรการชั่วคราวและจะถูกนำออกในBrave เวอร์ชันต่อๆ ไป หลังจากนำนโยบายออกแล้ว Brave จะส่งคำขอประเภท DNS เพิ่มเติมได้ทุกครั้ง";
AdsSettingForIntrusiveAdsSites.pfm_title = "เครื่องมือตั้งค่าโฆษณาสำหรับเว็บไซต์ที่มีโฆษณาที่แทรก";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - อนุญาตโฆษณาในเว็บไซต์ทั้งหมด\n2 - ไม่อนุญาตโฆษณาในเว็บไซต์ที่มีโฆษณาที่แทรก\nหากไม่ตั้งค่า SafeBrowsingEnabled เป็น \"เท็จ\" การตั้งค่า AdsSettingForIntrusiveAdsSites เป็น 1 หรือไม่ได้ตั้งค่าจะอนุญาตให้แสดงโฆษณาในทุกเว็บไซต์\n\nการตั้งค่านโยบายเป็น 2 จะบล็อกโฆษณาในเว็บไซต์ซึ่งมีโฆษณาที่แทรก";
AdvancedProtectionAllowed.pfm_title = "เปิดใช้การปกป้องเพิ่มเติมสำหรับผู้ใช้ที่ลงทะเบียนในโปรแกรมการปกป้องขั้นสูง";
AdvancedProtectionAllowed.pfm_description = "นโยบายนี้ควบคุมว่าผู้ใช้ที่ลงทะเบียนในโปรแกรมการปกป้องขั้นสูงจะได้รับการปกป้องเพิ่มเติมหรือไม่ บางฟีเจอร์เหล่านี้อาจมีการแชร์ข้อมูลกับ Google (เช่น ผู้ใช้การปกป้องขั้นสูงจะส่งไฟล์ที่ดาวน์โหลดไปให้ Google สแกนหามัลแวร์ได้) หากตั้งค่าเป็น \"จริง\" หรือไม่ได้ตั้งค่า ผู้ใช้ที่ลงทะเบียนจะได้รับการปกป้องเพิ่มเติม หากตั้งค่าเป็น \"เท็จ\" ผู้ใช้การปกป้องขั้นสูงจะได้รับเฉพาะฟีเจอร์มาตรฐานสำหรับผู้ใช้ทั่วไป";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "รายการต้นทางที่อนุญาตการตรวจสอบสิทธิ์ HTTP ทั้งหมด";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "การตั้งค่านโยบายจะระบุต้นทางที่จะอนุญาตรูปแบบการตรวจสอบสิทธิ์ HTTP ทั้งหมดที่ Brave รองรับ โดยไม่คำนึงถึงนโยบาย AuthSchemes\n\nตั้งแต่ Brave เวอร์ชัน 161 เป็นต้นไป นโยบายนี้จะมีผลกับต้นทางของเซิร์ฟเวอร์ปลายทางเท่านั้น และจะไม่มีผลกับคำขอตรวจสอบสิทธิ์ของพร็อกซีเซิร์ฟเวอร์ หากต้องการอนุญาตรูปแบบการตรวจสอบสิทธิ์ HTTP ทั้งหมดสำหรับพร็อกซีเซิร์ฟเวอร์ ให้ใช้นโยบาย AllHttpAuthSchemesAllowedForProxies แทน ก่อนเวอร์ชัน 161 พร็อกซีเซิร์ฟเวอร์ที่ตรงกับนโยบายนี้จะได้รับอนุญาตให้ใช้รูปแบบการตรวจสอบสิทธิ์ HTTP ทั้งหมดด้วย เว้นแต่จะมีการตั้งค่า AllHttpAuthSchemesAllowedForProxies ไว้\n\nจัดรูปแบบต้นทางตามนี้ (https://support.google.com/chrome/a?p=url_blocklist_filter_format) คุณกำหนดข้อยกเว้นใน AllHttpAuthSchemesAllowedForOrigins ได้ไม่เกิน 1,000 รายการ\nอนุญาตให้ใช้ไวลด์การ์ดได้สำหรับคอมโพเนนต์โฮสต์ (เช่น \"*:8000\" จะจับคู่โฮสต์ทั้งหมดในพอร์ต 8000) หากต้องการจับคู่กับทุกรูปแบบหรือทุกพอร์ต ให้ละเว้นคอมโพเนนต์ทั้งหมด (เช่น \"example.com\" จะจับคู่กับทุกรูปแบบและทุกพอร์ต) ชื่อโฮสต์ (เช่น \"example.com\") จะจับคู่กับโดเมนย่อยด้วย หากต้องการจับคู่โฮสต์แบบตรงทั้งหมดและไม่รวมโดเมนย่อย ให้ใส่จุดไว้ข้างหน้า (เช่น \".example.com\") หากต้องการจับคู่ต้นทางทั้งหมด ให้ใช้เครื่องหมายดอกจันเดี่ยว (\"*\")";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "รายการพร็อกซีเซิร์ฟเวอร์ที่อนุญาตรูปแบบการตรวจสอบสิทธิ์ HTTP ทั้งหมด";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "การตั้งค่านโยบายจะระบุพร็อกซีเซิร์ฟเวอร์ที่จะอนุญาตรูปแบบการตรวจสอบสิทธิ์ HTTP ทั้งหมดที่ Brave รองรับ โดยไม่คำนึงถึงนโยบาย AuthSchemes\n\nโปรดจัดรูปแบบพร็อกซีเซิร์ฟเวอร์ตามรูปแบบตัวกรองรายการ URL ที่บล็อก (https://support.google.com/chrome/a?p=url_blocklist_filter_format) คุณกำหนดข้อยกเว้นได้ไม่เกิน 1,000 รายการ\nอนุญาตให้ใช้ไวลด์การ์ดได้สำหรับคอมโพเนนต์โฮสต์ (เช่น \"*:8080\" จะจับคู่พร็อกซีทั้งหมดในพอร์ต 8080) ชื่อโฮสต์ (เช่น \"proxy.example.com\") จะจับคู่กับโดเมนย่อยด้วย หากต้องการจับคู่โฮสต์แบบตรงทั้งหมดและไม่รวมโดเมนย่อย ให้ใส่จุดไว้ข้างหน้า (เช่น \".proxy.example.com\")\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะรองรับเฉพาะรูปแบบการตรวจสอบสิทธิ์ HTTP ที่ระบุใน AuthSchemes (หรือรูปแบบเริ่มต้น หากไม่ได้ตั้งค่า) สำหรับการตรวจสอบสิทธิ์พร็อกซี";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "อนุญาตให้หน้าที่มีส่วนหัว Cache-Control: no-store ป้อน Back-Forward Cache ได้";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "นโยบายนี้ควบคุมว่าสามารถจัดเก็บหน้าที่มีส่วนหัว Cache-Control: no-store ใน Back-Forward Cache ได้ไหม เว็บไซต์ที่ตั้งค่าส่วนหัวนี้อาจไม่คิดว่าจะมีการคืนค่าหน้าจาก Back-Forward Cache เนื่องจากยังสามารถแสดงข้อมูลที่ละเอียดอ่อนบางอย่างได้หลังการคืนค่าแม้จะเข้าถึงไม่ได้แล้วก็ตาม\n\nหากเปิดใช้นโยบายหรือไม่ได้ตั้งค่า หน้าที่มีส่วนหัว Cache-Control: no-store อาจได้รับการคืนค่าจาก Back-Forward Cache เว้นแต่จะมีการทริกเกอร์ให้เลือกลบแคชเก่าออกไป (เช่น เมื่อเว็บไซต์มีการเปลี่ยนคุกกี้ประเภท HTTP-เท่านั้น)\n\nหากปิดใช้นโยบาย จะไม่มีการจัดเก็บหน้าที่มีส่วนหัว Cache-Control: no-store ใน Back-Forward Cache";
AllowCrossOriginAuthPrompt.pfm_title = "พรอมต์การตรวจสอบสิทธิ์ HTTP แบบข้ามต้นทาง";
AllowCrossOriginAuthPrompt.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะอนุญาตให้รูปภาพของบุคคลที่สามในหน้าเว็บแสดงพรอมต์การตรวจสอบสิทธิ์\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้รูปภาพของบุคคลที่สามแสดงพรอมต์การตรวจสอบสิทธิ์ไม่ได้\n\nโดยทั่วไปแล้วจะ \"ปิดใช้\" นโยบายนี้เพื่อป้องกันฟิชชิง";
AllowDeletingBrowserHistory.pfm_title = "เปิดใช้งานการนำออกเบราว์เซอร์และประวัติการดาวน์โหลด";
AllowDeletingBrowserHistory.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าหมายความว่าจะลบประวัติการท่องเว็บและประวัติการดาวน์โหลดใน Chrome ได้ และผู้ใช้จะเปลี่ยนการตั้งค่านี้ไม่ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หมายความว่าจะลบประวัติการท่องเว็บและประวัติการดาวน์โหลดไม่ได้ ทั้งนี้ การปิดใช้นโยบายนี้ไม่ได้เป็นการรับประกันว่าระบบจะเก็บรักษาประวัติการท่องเว็บและประวัติการดาวน์โหลดไว้ ผู้ใช้อาจแก้ไขหรือลบไฟล์ฐานข้อมูลประวัติได้โดยตรง และเบราว์เซอร์อาจหมดอายุหรือเก็บถาวรรายการประวัติทั้งหมดหรือบางส่วนเมื่อใดก็ได้";
AllowDinosaurEasterEgg.pfm_title = "อนุญาตให้เล่นเกมไดโนเสาร์ที่ซ่อนไว้ได้";
AllowDinosaurEasterEgg.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" อนุญาตให้ผู้ใช้เล่นเกมไดโนเสาร์ การตั้งค่านโยบายเป็น \"เท็จ\" หมายความว่าผู้ใช้จะเล่นเกมไดโนเสาร์ที่เป็น Easter Egg ขณะที่อุปกรณ์ออฟไลน์อยู่ไม่ได้\n\nการไม่ตั้งค่านโยบายนี้หมายความว่าผู้ใช้จะเล่นเกมดังกล่าวใน Google Chrome OS ที่ลงทะเบียนไว้ไม่ได้ แต่จะเล่นในที่อื่นๆ ได้";
AllowFileSelectionDialogs.pfm_title = "อนุญาตให้เรียกดูช่องโต้ตอบสำหรับการเลือกไฟล์ได้";
AllowFileSelectionDialogs.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ Chrome แสดงผลได้ และผู้ใช้จะเปิดกล่องโต้ตอบสำหรับการเลือกไฟล์ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หมายความว่าเมื่อผู้ใช้ดำเนินการที่เรียกใช้กล่องโต้ตอบสำหรับการเลือกไฟล์ เช่น การนำเข้าบุ๊กมาร์ก การอัปโหลดไฟล์ และการบันทึกลิงก์ จะมีข้อความปรากฏขึ้นแทน โดยถือว่าผู้ใช้ได้คลิก \"ยกเลิก\" ในกล่องโต้ตอบสำหรับการเลือกไฟล์ไว้";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "อนุญาตให้สุ่มขนาดพูลซ็อกเก็ตสำหรับพร็อกซี";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "การสุ่มขนาดพูลซ็อกเก็ตเป็นกลไกการรักษาความปลอดภัยที่ป้องกันไม่ให้ผู้โจมตีใช้ประโยชน์จากขีดจำกัดความจุที่กำหนดไว้ล่วงหน้าเพื่อเรียนรู้ข้อมูลข้ามเว็บไซต์\nหากความจุของพูลโดยปกติคือ 128 ซ็อกเก็ต กลไกนี้จะจำกัดพูลแบบสุ่มระหว่าง 128 ถึง 256\nการดำเนินการนี้จะช่วยให้มีการเชื่อมต่อกับพร็อกซีได้มากถึง 2 เท่า แต่ในทางปฏิบัติ ค่าที่คาดไว้จะอยู่ที่ประมาณ 1.2 เท่า\n\nซึ่งจะส่งผลต่อการตั้งค่าจาก MaxConnectionsPerProxy และ MaxConnectionsPerProxyForWebSocket\nขีดจำกัดสูงสุดจึงเป็น 2 เท่าของค่าดังกล่าว (แม้ว่าค่าที่คาดไว้ในทางปฏิบัติจะอยู่ที่ประมาณ 1.2 เท่า) แทนที่จะให้ผู้ใช้กำหนดขีดจำกัดสูงสุด\n\nฟีเจอร์นี้เปิดใช้โดยค่าเริ่มต้นสำหรับพูลทั้งหมด แต่นโยบายนี้อนุญาตให้ปิดใช้ฟีเจอร์สำหรับพูลพร็อกซีโดยเฉพาะ";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "อนุญาตคำขอการตรวจสอบสิทธิ์ผ่านเว็บในเว็บไซต์ที่มีใบรับรอง TLS ไม่ถูกต้อง";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "หากตั้งค่าเป็นเปิดใช้ \"Brave\" จะอนุญาตคำขอการตรวจสอบสิทธิ์ผ่านเว็บในเว็บไซต์ที่มีใบรับรอง TLS ว่ามีข้อผิดพลาด (เช่น เว็บไซต์ที่ถือว่าไม่ปลอดภัย)\n\nหากตั้งค่านโยบายเป็นปิดใช้ หรือไม่ได้ตั้งค่า ระบบจะใช้ลักษณะการทำงานเริ่มต้นของการบล็อกคำขอดังกล่าว";
AllowedDomainsForApps.pfm_title = "กำหนดโดเมนที่อนุญาตให้เข้าถึง Google Workspace";
AllowedDomainsForApps.pfm_description = "การตั้งค่านโยบายจะเปิดฟีเจอร์การลงชื่อเข้าใช้แบบจำกัดของ Chrome ใน Google Workspace และป้องกันไม่ให้ผู้ใช้เปลี่ยนการตั้งค่านี้ ผู้ใช้จะเข้าถึงเครื่องมือของ Google ได้โดยใช้บัญชีจากโดเมนที่ระบุเท่านั้น (หากต้องการอนุญาตบัญชี gmail หรือ googlemail ให้เพิ่ม consumer_accounts ลงในรายการโดเมน) การตั้งค่านี้จะป้องกันไม่ให้ผู้ใช้ลงชื่อเข้าใช้และเพิ่มบัญชีรองในอุปกรณ์ที่จัดการซึ่งต้องมีการตรวจสอบสิทธิ์จาก Google หากบัญชีดังกล่าวไม่ได้อยู่ในโดเมนที่อนุญาตอย่างชัดแจ้ง\n\nการปล่อยให้การตั้งค่านี้ว่างหรือไม่ได้ตั้งค่าจะทำให้ผู้ใช้เข้าถึง Google Workspace ด้วยบัญชีใดก็ได้\n\nผู้ใช้จะเปลี่ยนหรือลบล้างการตั้งค่านี้ไม่ได้\n\nหมายเหตุ: นโยบายนี้ส่งผลให้ต้องเติมส่วนหัว X-GoogApps-Allowed-Domains ในคำขอ HTTP และ HTTPS ทั้งหมดที่ส่งไปยังโดเมน google.com ทั้งหมดตามที่อธิบายไว้ใน https://support.google.com/a/answer/1668854";
AlternateErrorPagesEnabled.pfm_title = "เปิดใช้งานหน้าเว็บแสดงข้อผิดพลาดสำรอง";
AlternateErrorPagesEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" หมายความว่า Brave จะใช้หน้าแสดงข้อผิดพลาดทางเลือกซึ่งมีอยู่ในเบราว์เซอร์ (เช่น \"ไม่พบหน้าเว็บ\") การตั้งค่านโยบายเป็น \"เท็จ\" หมายความว่า Brave จะไม่ใช้หน้าแสดงข้อผิดพลาดทางเลือกเลย\n\nหากคุณตั้งค่านโยบายไว้ ผู้ใช้จะเปลี่ยนไม่ได้ หากไม่ได้ตั้งค่า นโยบายจะเปิดอยู่ แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
AlternativeBrowserParameters.pfm_title = "พารามิเตอร์บรรทัดคำสั่งสำหรับเบราว์เซอร์สำรอง";
AlternativeBrowserParameters.pfm_description = "การตั้งค่านโยบายนี้เป็นรายการสตริงหมายความว่า ระบบจะส่งแต่ละสตริงไปยังเบราว์เซอร์สำรองเป็นพารามิเตอร์บรรทัดคำสั่งที่แยกจากกัน ใน Microsoft® Windows® พารามิเตอร์ต่างๆ จะรวมกันโดยใช้การเว้นวรรค ส่วนใน macOS และ Linux® พารามิเตอร์หนึ่งๆ อาจมีการเว้นวรรคได้ และระบบจะยังถือว่าเป็นพารามิเตอร์เดียว\n\nหากพารามิเตอร์มี ${url} ก็จะมีการแทนที่ ${url} ด้วย URL ของหน้าเว็บที่จะเปิด หากไม่มีพารามิเตอร์ใดที่มี ${url} ระบบจะใส่ URL ดังกล่าวต่อท้ายบรรทัดคำสั่ง\n\nระบบจะขยายตัวแปรสภาพแวดล้อม โดยใน Microsoft® Windows® จะแทนที่ %ABC% ด้วยค่าตัวแปรสภาพแวดล้อม ABC โดยใน macOS และ Linux® จะแทนที่ ${ABC} ด้วยค่าตัวแปรสภาพแวดล้อม ABC\n\nการไม่ตั้งค่านโยบายนี้หมายความว่า เฉพาะ URL เท่านั้นที่จะส่งผ่านในแบบพารามิเตอร์บรรทัดคำสั่ง";
AlternativeBrowserPath.pfm_title = "เบราว์เซอร์สำรองที่จะเปิดสำหรับเว็บไซต์ที่กำหนดค่า";
AlternativeBrowserPath.pfm_description = "การตั้งค่านโยบายนี้จะควบคุมคำสั่งที่จะใช้เปิด URL ในเบราว์เซอร์สำรอง นโยบายนี้จะตั้งค่าเป็นอย่างใดอย่างหนึ่งได้ระหว่าง ${ie}, ${firefox}, ${safari}, ${opera}, ${edge} หรือเส้นทางของไฟล์ เมื่อตั้งค่านโยบายนี้เป็นเส้นทางของไฟล์ ระบบจะใช้ไฟล์นั้นเป็นไฟล์ที่ดำเนินการได้ ${ie} จะมีเฉพาะใน Microsoft® Windows® ${safari} และ ${edge} จะมีเฉพาะใน Microsoft® Windows® และ macOS\n\nการไม่ตั้งค่านโยบายนี้จะทำให้ระบบใช้ค่าเริ่มต้นเฉพาะแพลตฟอร์มนั้นๆ ได้แก่ Internet Explorer® สำหรับ Microsoft® Windows® หรือ Safari® สำหรับ macOS ส่วนใน Linux® การเปิดเบราว์เซอร์สำรองจะทำไม่สำเร็จ";
AlwaysOpenPdfExternally.pfm_title = "เปิดไฟล์ PDF จากภายนอกทุกครั้ง";
AlwaysOpenPdfExternally.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะปิดโปรแกรมอ่าน PDF ภายในของ Brave รวมถึงถือว่าไฟล์ PDF เป็นไฟล์ที่ดาวน์โหลดมา และอนุญาตให้ผู้ใช้เปิด PDF ด้วยแอปพลิเคชันเริ่มต้น\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หมายความว่าหากผู้ใช้ไม่ได้ปิดปลั๊กอิน PDF ก็จะมีการเปิดไฟล์ PDF\n\nหากคุณตั้งค่านโยบายไว้ ผู้ใช้จะเปลี่ยนการตั้งค่าดังกล่าวใน Brave ไม่ได้ หากไม่ได้ตั้งค่า ผู้ใช้เลือกได้ว่าจะเปิด PDF ภายนอกหรือไม่";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "เปิดใช้การตรวจสอบสิทธิ์แบบแอมเบียนท์สำหรับโปรไฟล์ประเภทต่างๆ";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - เปิดใช้การตรวจสอบสิทธิ์แบบแอมเบียนท์ในเซสชันปกติเท่านั้น\n1 - เปิดใช้การตรวจสอบสิทธิ์แบบแอมเบียนท์ในเซสชันไม่ระบุตัวตนและเซสชันปกติ\n2 - เปิดใช้การตรวจสอบสิทธิ์แบบแอมเบียนท์ในเซสชันผู้เยี่ยมชมและเซสชันปกติ\n3 - เปิดใช้การตรวจสอบสิทธิ์แบบแอมเบียนท์ในเซสชันปกติ เซสชันไม่ระบุตัวตน และเซสชันผู้เยี่ยมชม\nการกำหนดค่านโยบายนี้จะอนุญาต/ไม่อนุญาตการตรวจสอบสิทธิ์แบบแอมเบียนท์สำหรับโปรไฟล์ที่ไม่ระบุตัวตนและโปรไฟล์ผู้เยี่ยมชมใน Brave\n\nการตรวจสอบสิทธิ์แบบแอมเบียนท์คือการตรวจสอบสิทธิ์ http ด้วยข้อมูลเข้าสู่ระบบเริ่มต้นหากไม่ได้ระบุข้อมูลเข้าสู่ระบบที่ชัดแจ้งผ่านรูปแบบคำถาม/คำตอบแบบ NTLM/Kerberos/Negotiate\n\nการตั้งค่าเป็น RegularOnly (ค่า 0) จะอนุญาตการตรวจสอบสิทธิ์แบบแอมเบียนท์สำหรับเซสชันปกติเท่านั้น เซสชันไม่ระบุตัวตนและเซสชันผู้เยี่ยมชมจะไม่ได้รับอนุญาตให้ตรวจสอบสิทธิ์แบบแอมเบียนท์\n\nการตั้งค่าเป็น IncognitoAndRegular (ค่า 1) จะอนุญาตการตรวจสอบสิทธิ์แบบแอมเบียนท์สำหรับเซสชันไม่ระบุตัวตนและเซสชันปกติ เซสชันผู้เยี่ยมชมจะไม่ได้รับอนุญาตให้ตรวจสอบสิทธิ์แบบแอมเบียนท์\n\nการตั้งค่าเป็น GuestAndRegular (ค่า 2) จะอนุญาตการตรวจสอบสิทธิ์แบบแอมเบียนท์สำหรับเซสชันผู้เยี่ยมชมและเซสชันปกติ เซสชันไม่ระบุตัวตนจะไม่ได้รับอนุญาตให้ตรวจสอบสิทธิ์แบบแอมเบียนท์\n\nการตั้งค่าเป็น All (ค่า 3) จะอนุญาตการตรวจสอบสิทธิ์แบบแอมเบียนท์สำหรับทุกเซสชัน\n\nโปรดทราบว่าระบบจะอนุญาตการตรวจสอบสิทธิ์แบบแอมเบียนท์ในโปรไฟล์ปกติเสมอ\n\nใน Brave เวอร์ชัน 81 ขึ้นไป หากไม่ได้ตั้งค่านโยบายนี้ ระบบจะเปิดใช้การตรวจสอบสิทธิ์แบบแอมเบียนท์เฉพาะในเซสชันปกติ";
AudioCaptureAllowed.pfm_title = "อนุญาตหรือปฏิเสธการจับเสียง";
AudioCaptureAllowed.pfm_description = "เมื่อตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ผู้ใช้จะได้รับข้อความแจ้งหากมีการเข้าถึงการจับเสียง ยกเว้นใน URL ที่ตั้งค่าไว้ในรายการ AudioCaptureAllowedUrls\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิดข้อความแจ้ง และการจับเสียงจะใช้ได้เฉพาะกับ URL ที่ตั้งค่าไว้ในรายการ AudioCaptureAllowedUrls เท่านั้น\n\nหมายเหตุ: นโยบายนี้มีผลกับอินพุตเสียงทั้งหมด (ไม่ใช่แค่ไมโครโฟนในตัว)";
AudioCaptureAllowedUrls.pfm_title = "URL ที่จะได้รับสิทธิ์การเข้าถึงอุปกรณ์จับเสียงโดยไม่ต้องแจ้ง";
AudioCaptureAllowedUrls.pfm_description = "การตั้งค่านโยบายนี้เป็นการระบุรายการ URL ที่จะมีการจับคู่รูปแบบกับต้นทางการรักษาความปลอดภัยของ URL ที่ขอ หากรูปแบบตรงกัน ระบบจะให้สิทธิ์เข้าถึงอุปกรณ์จับเสียงโดยไม่แสดงข้อความแจ้ง\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/ อย่างไรก็ตาม โปรดทราบว่านโยบายนี้ไม่รองรับรูปแบบ \"*\" ที่ตรงกับ URL ใดก็ตาม";
AudioSandboxEnabled.pfm_title = "อนุญาตให้เรียกใช้แซนด์บ็อกซ์เสียง";
AudioSandboxEnabled.pfm_description = "นโยบายนี้ควบคุมกระบวนการของเสียงที่มีการใช้แซนด์บ็อกซ์\nหากเปิดใช้นโยบายนี้ กระบวนการของเสียงจะทำงานโดยใช้แซนด์บ็อกซ์\nหากปิดใช้นโยบายนี้ กระบวนการของเสียงจะทำงานโดยไม่ใช้แซนด์บ็อกซ์และโมดูลการประมวลผลเสียง WebRTC จะทำงานในกระบวนการของโหมดแสดงภาพ\nซึ่งทำให้ผู้ใช้มีความเสี่ยงด้านความปลอดภัยที่เกี่ยวข้องกับการเรียกใช้ระบบย่อยของเสียงโดยไม่ใช้แซนด์บ็อกซ์\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะใช้การกำหนดค่าเริ่มต้นสำหรับแซนด์บ็อกซ์เสียง ซึ่งอาจแตกต่างกันในแต่ละแพลตฟอร์ม\nนโยบายนี้มีไว้เพื่อให้ความยืดหยุ่นแก่องค์กรในการปิดใช้แซนด์บ็อกซ์เสียง หากองค์กรใช้การตั้งค่าซอฟต์แวร์ด้านความปลอดภัยที่รบกวนแซนด์บ็อกซ์";
AuthNegotiateDelegateAllowlist.pfm_title = "รายการที่อนุญาตสำหรับเซิร์ฟเวอร์การมอบสิทธิ์ของ Kerberos";
AuthNegotiateDelegateAllowlist.pfm_description = "การตั้งค่านโยบายจะกำหนดเซิร์ฟเวอร์ที่ Brave อาจมอบสิทธิ์ให้ คั่นชื่อเซิร์ฟเวอร์หลายรายการด้วยเครื่องหมายจุลภาค ใช้ไวลด์การ์ด (*) ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า Brave จะไม่มอบสิทธิ์ใช้ข้อมูลเข้าสู่ระบบของผู้ใช้ แม้จะตรวจพบว่าเซิร์ฟเวอร์เป็นอินทราเน็ตก็ตาม";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "ใช้นโยบาย KDC เพื่อมอบอำนาจข้อมูลเข้าสู่ระบบ";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หมายความว่าการตรวจสอบสิทธิ์ HTTP จะยึดตามการอนุมัติโดยนโยบาย KDC กล่าวคือ Brave จะมอบสิทธิ์ใช้ข้อมูลเข้าสู่ระบบของผู้ใช้ให้แก่บริการที่กำลังเข้าถึงในกรณีที่ KDC ตั้งค่า OK-AS-DELEGATE ในตั๋วบริการ ดู RFC 5896 (https://tools.ietf.org/html/rfc5896.html) บริการควรได้รับอนุญาตจาก AuthNegotiateDelegateAllowlist ด้วย\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าหมายความว่าระบบจะไม่สนใจนโยบาย KDC ในแพลตฟอร์มที่รองรับ และจะดำเนินการตาม AuthNegotiateDelegateAllowlist เท่านั้น\n\nใน Microsoft® Windows® ระบบจะดำเนินการตามนโยบาย KDC เสมอ";
AuthSchemes.pfm_title = "สกีมการตรวจสอบสิทธิ์ที่ได้รับการสนับสนุน";
AuthSchemes.pfm_description = "การตั้งค่านโยบายจะระบุรูปแบบการตรวจสอบสิทธิ์ HTTP ที่ Brave รองรับ\n\nการไม่ตั้งค่านโยบายจะใช้ทั้ง 4 รูปแบบ\n\nค่าที่ใช้ได้มีดังนี้\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nหมายเหตุ: คั่นค่าหลายรายการด้วยเครื่องหมายจุลภาค";
AuthServerAllowlist.pfm_title = "รายการที่อนุญาตสำหรับเซิร์ฟเวอร์การตรวจสอบสิทธิ์";
AuthServerAllowlist.pfm_description = "การตั้งค่านโยบายจะระบุว่าเซิร์ฟเวอร์ใดควรจะได้รับอนุญาตสำหรับการตรวจสอบสิทธิ์แบบผสานรวม การตรวจสอบสิทธิ์แบบผสานรวมจะเปิดเฉพาะเมื่อ Brave ได้รับคำขอตรวจสอบสิทธิ์จากพร็อกซีหรือจากเซิร์ฟเวอร์ที่อยู่ในรายการที่ได้รับอนุญาตนี้\n\nการไม่ตั้งค่านโยบายหมายความว่า Brave จะพยายามตรวจหาว่าเซิร์ฟเวอร์อยู่บนอินทราเน็ตไหม หากใช่ก็จะตอบรับคำขอ IWA หากมีการตรวจพบว่าเซิร์ฟเวอร์เป็นอินเทอร์เน็ต Brave จะไม่สนใจคำขอ IWA จากเซิร์ฟเวอร์\n\nหมายเหตุ: คั่นชื่อเซิร์ฟเวอร์หลายรายการด้วยเครื่องหมายจุลภาค ใช้ไวลด์การ์ด (*) ได้";
AutoLaunchProtocolsFromOrigins.pfm_title = "กำหนดรายการโปรโตคอลที่เปิดแอปพลิเคชันภายนอกจากต้นทางที่ระบุได้โดยไม่ต้องแจ้งผู้ใช้";
AutoLaunchProtocolsFromOrigins.pfm_description = "ให้คุณกำหนดรายการโปรโตคอล และรายการที่เชื่อมโยงของรูปแบบต้นทางที่อนุญาตสำหรับแต่ละโปรโตคอล ซึ่งเปิดแอปพลิเคชันภายนอกได้โดยไม่ต้องแจ้งผู้ใช้ ไม่ควรใส่ตัวคั่นข้างหลังเมื่อระบุโปรโตคอล เช่น ให้ใช้ \"skype\" แทน \"skype:\" หรือ \"skype://\"\n\nหากตั้งค่านโยบายนี้ ระบบจะอนุญาตให้โปรโตคอลเปิดแอปพลิเคชันภายนอกโดยไม่มีข้อความแจ้งจากนโยบายในกรณีที่มีการระบุโปรโตคอลดังกล่าวเท่านั้น และต้นทางของเว็บไซต์ที่พยายามเปิดใช้งานโปรโตคอลตรงกับต้นทางรูปแบบใดรูปแบบหนึ่งในรายการ allowed_origins ของโปรโตคอลนั้น หากเงื่อนไขข้อใดข้อหนึ่งเป็น \"เท็จ\" นโยบายจะไม่ละเว้นข้อความแจ้งการเปิดใช้งานโปรโตคอลภายนอก\n\nหากไม่ได้ตั้งค่านโยบาย โปรโตคอลทั้งหมดจะเปิดใช้งานได้ต่อเมื่อมีข้อความแจ้งโดยค่าเริ่มต้นเท่านั้น ผู้ใช้เลือกไม่รับข้อความแจ้งแบบรายโปรโตคอล/รายเว็บไซต์ได้หากนโยบาย ExternalProtocolDialogShowAlwaysOpenCheckbox ไม่ได้ตั้งค่าเป็น \"ปิดใช้\" นโยบายนี้ไม่มีผลต่อการยกเว้นข้อความแจ้งแบบรายโปรโตคอล/รายเว็บไซต์ที่ผู้ใช้ตั้งค่า\n\nรูปแบบที่ตรงกันของต้นทางใช้รูปแบบที่คล้ายกับของนโยบาย \"URLBlocklist\" ตามที่บันทึกไว้ใน https://support.google.com/chrome/a?p=url_blocklist_filter_format\n\nแต่รูปแบบที่ตรงกันของต้นทางในนโยบายนี้ต้องไม่มีองค์ประกอบ \"/path\" หรือ \"@query\" ระบบจะไม่สนใจรูปแบบที่มีองค์ประกอบ \"/path\" หรือ \"@query\"\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins";
AutoOpenAllowedForURLs.pfm_title = "URL ที่ใช้กับ AutoOpenFileTypes ได้";
AutoOpenAllowedForURLs.pfm_description = "รายการ URL ซึ่งระบุ URL ที่จะใช้กับ AutoOpenFileTypes นโยบายนี้ไม่มีผลต่อค่าที่เปิดโดยอัตโนมัติที่ผู้ใช้กำหนดไว้\n\nหากตั้งค่านโยบายนี้ไว้ ไฟล์จะเปิดโดยอัตโนมัติด้วยนโยบายเฉพาะเมื่อ URL นั้นอยู่ในชุดนี้ และมีประเภทไฟล์อยู่ใน AutoOpenFileTypes หากเงื่อนไขข้อใดข้อหนึ่งเป็น \"เท็จ\" ไฟล์ที่ดาวน์โหลดจะไม่เปิดโดยอัตโนมัติด้วยนโยบาย\n\nหากไม่ได้ตั้งค่านโยบายนี้ไว้ ไฟล์ที่ดาวน์โหลดทั้งหมดที่มีประเภทไฟล์อยู่ใน AutoOpenFileTypes จะเปิดโดยอัตโนมัติ\n\nURL ต้องมีรูปแบบเป็นไปตาม https://support.google.com/chrome/a?p=url_blocklist_filter_format";
AutoOpenFileTypes.pfm_title = "รายการของประเภทไฟล์ที่ควรเปิดโดยอัตโนมัติเมื่อดาวน์โหลดเสร็จ";
AutoOpenFileTypes.pfm_description = "รายการของประเภทไฟล์ที่ควรเปิดโดยอัตโนมัติเมื่อดาวน์โหลดเสร็จ ไม่ควรใส่ตัวคั่นข้างหน้าเมื่อระบุประเภทไฟล์ เช่น ให้ใช้ \"txt\" แทน \".txt\"\n\nไฟล์ประเภทที่ควรเปิดโดยอัตโนมัติยังจะต้องผ่านการตรวจสอบของ Google Safe Browsing ที่เปิดใช้อยู่ และระบบจะไม่เปิดไฟล์หากไม่ผ่านการตรวจสอบ\n\nหากไม่ได้ตั้งค่านโยบายนี้ เมื่อดาวน์โหลดเสร็จระบบจะเปิดเฉพาะประเภทไฟล์ที่ผู้ใช้ระบุไว้แล้วว่าให้เปิดโดยอัตโนมัติ\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
AutoSelectCertificateForUrls.pfm_title = "เลือกใบรับรองไคลเอ็นต์สำหรับไซต์เหล่านี้โดยอัตโนมัติ";
AutoSelectCertificateForUrls.pfm_description = "การตั้งค่านโยบายนี้ช่วยให้คุณสร้างรายการรูปแบบ URL ที่ระบุเว็บไซต์ซึ่ง Chrome จะเลือกใบรับรองไคลเอ็นต์ให้โดยอัตโนมัติได้ ค่าจะเป็นอาร์เรย์ของพจนานุกรม JSON ที่มีรูปแบบเป็นสตริงซึ่งแต่ละรายการมีรูปแบบ { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER } โดยที่ $URL_PATTERN เป็นรูปแบบการตั้งค่าเนื้อหา $FILTER จำกัดใบรับรองไคลเอ็นต์ที่เบราว์เซอร์จะเลือกโดยอัตโนมัติ ระบบจะเลือกเฉพาะใบรับรองที่ตรงกับคำขอใบรับรองของเซิร์ฟเวอร์เท่านั้น โดยไม่คำนึงถึงตัวกรอง ใน Android และ iOS นั้น Chrome จะเลือกได้เฉพาะใบรับรองไคลเอ็นต์ที่จัดสรรไว้เองเท่านั้น โดยจะเข้าถึงใบรับรองที่ติดตั้งไว้ในระดับระบบปฏิบัติการไม่ได้\n\nตัวอย่างการใช้งานส่วน $FILTER\n\n* เมื่อตั้งค่า $FILTER เป็น { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } } ระบบจะเลือกเฉพาะใบรับรองไคลเอ็นต์ซึ่งออกโดยใบรับรองที่ใช้ CommonName $ISSUER_CN\n\n* เมื่อ $FILTER มีทั้งส่วน \"ISSUER\" และ \"SUBJECT\" ระบบจะเลือกเฉพาะใบรับรองไคลเอ็นต์ที่เป็นไปตามเงื่อนไขทั้ง 2 ข้อ\n\n* เมื่อ $FILTER มีส่วน \"SUBJECT\" ที่มีค่า \"O\" ใบรับรองต้องมีอย่างน้อย 1 องค์กรที่ตรงกับค่าที่ระบุจึงจะได้รับเลือก\n\n* เมื่อ $FILTER มีส่วน \"SUBJECT\" ที่มีค่า \"OU\" ใบรับรองต้องมีหน่วยขององค์กรอย่างน้อย 1 หน่วยที่ตรงกับค่าที่ระบุจึงจะได้รับเลือก\n\n* เมื่อตั้งค่า $FILTER เป็น {} การเลือกใบรับรองไคลเอ็นต์จะไม่มีข้อจำกัดเพิ่มเติม โปรดทราบว่าตัวกรองที่ได้มาจากเว็บเซิร์ฟเวอร์จะยังคงมีผลอยู่\n\nการไม่ตั้งค่านโยบายนี้หมายความว่าจะไม่มีการเลือกอัตโนมัติสำหรับเว็บไซต์ใดก็ตาม\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls";
AutofillGenAiSettings.pfm_title = "การตั้งค่าสำหรับฟีเจอร์ Generative AI ในการป้อนข้อความอัตโนมัติ";
AutofillGenAiSettings.pfm_description = "0 - อนุญาตให้ใช้ฟีเจอร์ Generative AI ในการป้อนข้อความอัตโนมัติและปรับปรุงโมเดล AI\n1 - อนุญาตให้ใช้ฟีเจอร์ Generative AI ในการป้อนข้อความอัตโนมัติโดยไม่ปรับปรุงโมเดล AI\n2 - ไม่อนุญาตให้ใช้ฟีเจอร์ Generative AI ในการป้อนข้อความอัตโนมัติ\nฟีเจอร์เหล่านี้ใน Brave ใช้โมเดล Generative AI เพื่อช่วยผู้ใช้กรอกแบบฟอร์มบนเว็บ หากต้องการใช้ฟีเจอร์ดังกล่าว Brave จะต้องรวบรวมข้อมูล เช่น โครงสร้างของแบบฟอร์มที่ผู้ใช้โต้ตอบด้วย และสำหรับฟีเจอร์ค้นหาและเติมข้อมูลด้วย Gemini จะต้องรวบรวมคำค้นหาข้อความอิสระที่ผู้ใช้ป้อนเพื่อค้นหาแอป Gemini ที่เชื่อมต่อ แล้วส่งข้อมูลนี้ไปยังเซิร์ฟเวอร์ของ Google ซึ่งเรียกใช้โมเดล Generative AI\n\nการตั้งค่านโยบายเป็น 0 (อนุญาตให้ใช้ฟีเจอร์ Generative AI ในการป้อนข้อความอัตโนมัติและปรับปรุงโมเดล AI) จะอนุญาตให้ใช้ฟีเจอร์ พร้อมกับอนุญาตให้ Google ใช้ข้อมูลที่เกี่ยวข้องเพื่อปรับปรุงโมเดล AI ข้อมูลที่เกี่ยวข้องอาจรวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร โดยทั้งนี้จะขึ้นอยู่กับฟีเจอร์นั้นๆ 0 คือค่าเริ่มต้น เว้นแต่จะระบุไว้ด้านล่าง\n\nการตั้งค่านโยบายเป็น 1 (อนุญาตให้ใช้ฟีเจอร์ Generative AI ในการป้อนข้อความอัตโนมัติโดยไม่ปรับปรุงโมเดล AI) จะอนุญาตให้ใช้ฟีเจอร์ แต่ไม่อนุญาตให้ Google ปรับปรุงโมเดลโดยใช้เนื้อหาของผู้ใช้ (รวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาในแหล่งข้อมูล และความคิดเห็นเป็นลายลักษณ์อักษร) 1 คือค่าเริ่มต้นสำหรับผู้ใช้ระดับองค์กรที่จัดการโดยGoogle Admin console และบัญชี Education ที่จัดการโดย Google Workspace\n\nการตั้งค่านโยบายเป็น 2 (ไม่อนุญาตให้ใช้ฟีเจอร์ Generative AI ในการป้อนข้อความอัตโนมัติ) จะไม่อนุญาตให้ใช้ฟีเจอร์ดังกล่าว\n\nเมื่อไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nฟีเจอร์ Generative AI ในการป้อนข้อความอัตโนมัติประกอบด้วย\n- การทำความเข้าใจแบบฟอร์มที่ชาญฉลาดยิ่งขึ้น: ใช้ AI เพื่อระบุและแยกประเภทช่องของแบบฟอร์ม เพื่อให้กรอกข้อมูลได้มากขึ้น\n\n- ค้นหาและเติมข้อมูลด้วย Gemini: ค้นหาข้อมูลจากแอปที่ผู้ใช้เชื่อมต่อกับ Gemini และเสนอให้เติมข้อมูล ไม่ว่าจะเป็นคำแนะนำเชิงรุกในแบบฟอร์มหรือเพื่อตอบคำถามที่ผู้ใช้เขียน\n\nนโยบายนี้จะมีผลแทนนโยบาย AutofillPredictionSettings ซึ่งจะยังคงมีผลเมื่อไม่ได้ตั้งค่านโยบายนี้ ฟีเจอร์ \"ค้นหาและเติมข้อมูลด้วย Gemini\" ยังกำหนดให้ต้องไม่ปิดใช้นโยบาย GeminiSettings ด้วย\n\nนโยบายนี้ไม่ได้ควบคุมฟีเจอร์การป้อนข้อความอัตโนมัติที่ไม่ได้ใช้ Generative AI\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
AutofillSettings.pfm_title = "บล็อกประเภทข้อมูลการป้อนข้อความอัตโนมัติสำหรับเว็บไซต์ที่เฉพาะเจาะจง";
AutofillSettings.pfm_description = "การตั้งค่านโยบายนี้จะช่วยให้คุณระบุประเภทข้อมูลการป้อนข้อความอัตโนมัติที่จะถูกบล็อกในรูปแบบ URL ที่เฉพาะเจาะจงได้\n\nนโยบายมีโครงสร้างเป็นรายการพจนานุกรม พจนานุกรมแต่ละรายการต้องมีข้อมูลต่อไปนี้\n* \"url_pattern\": รูปแบบ URL การตั้งค่าเนื้อหาสำหรับเฟรมหลัก (เช่น \"https://[*.]example.com\")\n* \"blocked_types\": รายการสตริงที่แสดงถึงหมวดหมู่ของข้อมูลการป้อนข้อความอัตโนมัติที่จะบล็อก\n\nค่าที่รองรับสำหรับ \"blocked_types\" มีดังนี้\n* \"contact_info\": บล็อกการกรอกและบันทึกข้อมูลติดต่อ\n* \"payments\": บล็อกการกรอกและบันทึกบัตรเครดิตและวิธีการชำระเงิน\n* \"identity_docs\": บล็อกการกรอกและบันทึกเอกสารระบุตัวตน (เช่น หนังสือเดินทาง ใบขับขี่ บัตรประจำตัวประชาชน)\n* \"travel\": บล็อกการกรอกและบันทึกข้อมูลการเดินทาง (เช่น การจองเที่ยวบิน การจดทะเบียนยานพาหนะ)\n* \"shopping\": บล็อกการกรอกและบันทึกข้อมูลการช็อปปิ้ง (เช่น คำสั่งซื้อออนไลน์ การจัดส่ง)\n* \"all\": บล็อกการกรอกและบันทึกข้อมูลการป้อนข้อความอัตโนมัติทุกประเภท\n\nหากมีการบล็อกประเภทข้อมูลสำหรับเว็บไซต์ ระบบจะปิดใช้ทั้งการสร้างคำแนะนำและพรอมต์ให้บันทึก/นำเข้าข้อมูลใหม่ประเภทนั้นในเว็บไซต์ดังกล่าว\n\nหาก URL ตรงกับรายการรูปแบบหลายรายการในลิสต์ ระบบจะรวมประเภทที่บล็อกจากรายการที่ตรงกันทั้งหมด (ผสานแบบ Union) ระบบจะไม่สนใจรูปแบบ URL ที่ไม่ถูกต้องในรายการ\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะไม่บล็อกประเภทข้อมูลการป้อนข้อความอัตโนมัติใดๆ ตามโดเมน\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่\nhttps://chromeenterprise.google/policies/url-patterns รองรับไวลด์การ์ด * โดยรูปแบบนี้จะจับคู่ URL ได้ทั้งหมดโดยไม่มีการกำหนดรูปแบบ พอร์ต และเส้นทาง\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=AutofillSettings";
AutomatedPasswordChangeSettings.pfm_title = "เปิดใช้การเปลี่ยนรหัสผ่านอัตโนมัติ";
AutomatedPasswordChangeSettings.pfm_description = "0 - อนุญาตให้ใช้ฟีเจอร์และปรับปรุงโมเดล AI\n1 - อนุญาตให้ใช้ฟีเจอร์โดยไม่ปรับปรุงโมเดล AI\n2 - ไม่อนุญาตให้ใช้ฟีเจอร์\nนโยบายนี้ควบคุมความพร้อมใช้งานของฟีเจอร์เปลี่ยนรหัสผ่านอัตโนมัติของ Brave\n\nหากเปิดใช้ ผู้ใช้จะทริกเกอร์กระบวนการที่เบราว์เซอร์พยายามเปลี่ยนรหัสผ่านในเว็บไซต์โดยอัตโนมัติได้ กระบวนการนี้จัดการโดย Generative AI ระบบจะบันทึกรหัสผ่านใหม่ไว้ในเครื่องมือจัดการรหัสผ่านของเบราว์เซอร์\n\n0 = อนุญาตให้ใช้ฟีเจอร์ พร้อมกับอนุญาตให้ Google ใช้ข้อมูลที่เกี่ยวข้องเพื่อปรับปรุงโมเดล AI ข้อมูลที่เกี่ยวข้องอาจรวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร โดยทั้งนี้จะขึ้นอยู่กับฟีเจอร์นั้นๆ รวมถึงเจ้าหน้าที่อาจตรวจสอบข้อมูลดังกล่าวเพื่อปรับปรุงโมเดล AI 0 คือค่าเริ่มต้น เว้นแต่จะระบุไว้ด้านล่าง\n\n1 = อนุญาตให้ใช้ฟีเจอร์ แต่ไม่อนุญาตให้ Google ปรับปรุงโมเดลโดยใช้เนื้อหาของผู้ใช้ (รวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร) 1 คือค่าเริ่มต้นสำหรับผู้ใช้ระดับองค์กรที่จัดการโดยคอนโซลผู้ดูแลระบบของ Google และสำหรับบัญชี Education ที่จัดการโดย Google Workspace\n\n2 = ไม่อนุญาตให้ใช้ฟีเจอร์\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
AutomaticDownloadsAllowedForUrls.pfm_title = "อนุญาตให้ดาวน์โหลดโดยอัตโนมัติในเว็บไซต์เหล่านี้";
AutomaticDownloadsAllowedForUrls.pfm_description = "ให้คุณกำหนดรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ได้รับอนุญาตให้ดาวน์โหลดหลายไฟล์โดยอัตโนมัติ\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns\n\nหาก URL ตรงกับทั้ง AutomaticDownloadsAllowedForUrls และ AutomaticDownloadsBlockedForUrls ระบบจะให้ความสำคัญกับ AutomaticDownloadsBlockedForUrls มากกว่า\n\nหากไม่ได้ตั้งค่านโยบายนี้ DefaultAutomaticDownloadsSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล";
AutomaticDownloadsBlockedForUrls.pfm_title = "บล็อกการดาวน์โหลดอัตโนมัติในเว็บไซต์เหล่านี้";
AutomaticDownloadsBlockedForUrls.pfm_description = "ให้คุณกำหนดรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่ได้รับอนุญาตให้ดาวน์โหลดหลายไฟล์โดยอัตโนมัติ\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns\n\nหาก URL ตรงกับทั้ง AutomaticDownloadsAllowedForUrls และ AutomaticDownloadsBlockedForUrls ระบบจะให้ความสำคัญกับ AutomaticDownloadsBlockedForUrls มากกว่า\n\nหากไม่ได้ตั้งค่านโยบายนี้ DefaultAutomaticDownloadsSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล";
AutomaticFullscreenAllowedForUrls.pfm_title = "อนุญาตโหมดเต็มหน้าจอโดยอัตโนมัติในเว็บไซต์เหล่านี้";
AutomaticFullscreenAllowedForUrls.pfm_description = "ด้วยเหตุผลด้านความปลอดภัย API ของเว็บ requestFullscreen() จำเป็นต้องเรียกใช้ด้วยการกระทำของผู้ใช้ก่อนหน้า (\"Transient Activation\") มิเช่นนั้นจะดำเนินการไม่สำเร็จ การตั้งค่าส่วนตัวของผู้ใช้อาจอนุญาตให้ต้นทางบางแห่งเรียกใช้ API นี้โดยไม่ต้องมีท่าทางสัมผัสของผู้ใช้ก่อนตามที่อธิบายไว้ใน https://chromestatus.com/feature/6218822004768768\n\nนโยบายนี้มีผลแทนการตั้งค่าส่วนตัวของผู้ใช้ และอนุญาตให้ต้นทางที่ตรงกันเรียกใช้ API ได้โดยไม่ต้องมีท่าทางสัมผัสของผู้ใช้ก่อน\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่\nhttps://chromeenterprise.google/policies/url-patterns\nใช้ไวลด์การ์ด (*) ได้\n\nต้นทางที่ตรงกับทั้งรูปแบบนโยบายที่บล็อกไว้และอนุญาตจะถูกบล็อก\nต้นทางที่นโยบายหรือการตั้งค่าของผู้ใช้ไม่ได้ระบุไว้จะต้องมีท่าทางสัมผัสของผู้ใช้ก่อนเพื่อเรียกใช้ API นี้";
AutomaticFullscreenBlockedForUrls.pfm_title = "บล็อกโหมดเต็มหน้าจอโดยอัตโนมัติในเว็บไซต์เหล่านี้";
AutomaticFullscreenBlockedForUrls.pfm_description = "ด้วยเหตุผลด้านความปลอดภัย API ของเว็บ requestFullscreen() จำเป็นต้องเรียกใช้ด้วยการกระทำของผู้ใช้ก่อนหน้า (\"Transient Activation\") มิเช่นนั้นจะดำเนินการไม่สำเร็จ การตั้งค่าส่วนตัวของผู้ใช้อาจอนุญาตให้ต้นทางบางแห่งเรียกใช้ API นี้โดยไม่ต้องมีการกระทำของผู้ใช้ก่อนหน้าตามที่อธิบายไว้ใน https://chromestatus.com/feature/6218822004768768\n\nนโยบายนี้มีผลแทนการตั้งค่าส่วนตัวของผู้ใช้ และบล็อกต้นทางที่ตรงกันไม่ให้เรียกใช้ API เมื่อไม่มีการกระทำของผู้ใช้ก่อนหน้า\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่\nhttps://chromeenterprise.google/policies/url-patterns\nใช้ไวลด์การ์ด (*) ได้\n\nต้นทางที่ตรงกับทั้งรูปแบบนโยบายที่บล็อกไว้และอนุญาตจะถูกบล็อก\nต้นทางที่นโยบายหรือการตั้งค่าของผู้ใช้ไม่ได้ระบุไว้จะต้องมีการกระทำของผู้ใช้ก่อนหน้าเพื่อเรียกใช้ API นี้";
AutoplayAllowed.pfm_title = "อนุญาตการเล่นสื่ออัตโนมัติ";
AutoplayAllowed.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" อนุญาตให้ Brave เล่นสื่ออัตโนมัติ การตั้งค่านโยบายเป็น \"เท็จ\" ห้ามไม่ให้ Brave เล่นสื่ออัตโนมัติ\n\nหากไม่ได้ตั้งค่านโยบายนี้ Brave จะไม่เล่นสื่ออัตโนมัติ แต่สำหรับ URL บางรูปแบบ คุณใช้นโยบาย AutoplayAllowlist เพื่อเปลี่ยนการตั้งค่านี้ได้\n\nหากนโยบายนี้เปลี่ยนแปลงในขณะที่ Brave ทำงานอยู่ จะมีผลกับแท็บที่เปิดใหม่เท่านั้น";
AutoplayAllowlist.pfm_title = "อนุญาตการเล่นสื่ออัตโนมัติในรายการรูปแบบ URL ที่อนุญาต";
AutoplayAllowlist.pfm_description = "การตั้งค่านโยบายอนุญาตให้วิดีโอเล่นโดยอัตโนมัติ (โดยไม่ต้องได้รับความยินยอมของผู้ใช้) พร้อมเนื้อหาเสียงใน Brave หากตั้งค่านโยบาย AutoplayAllowed เป็น \"จริง\" นโยบายนี้ก็จะไม่มีผล หากตั้งค่านโยบาย AutoplayAllowed เป็น \"เท็จ\" รูปแบบ URL ที่กำหนดไว้ในนโยบายนี้จะยังเล่นได้อยู่ หากนโยบายนี้เปลี่ยนแปลงในขณะที่ Brave ทำงานอยู่ จะมีผลกับแท็บที่เปิดใหม่เท่านั้น\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/";
BackgroundTabFreezingEnabled.pfm_title = "เปิดใช้การตรึงแท็บเบื้องหลัง";
BackgroundTabFreezingEnabled.pfm_description = "ควบคุมว่า Brave จะตรึงแท็บที่ไม่ได้ใช้งานในเบื้องหลังเพื่อประหยัด CPU และหน่วยความจำหรือไม่\n\nเมื่อการตรึงแท็บเบื้องหลังทำงานอยู่ แท็บที่ไม่ได้ใช้งานในเบื้องหลังเป็นระยะเวลาหนึ่งจะถูกตรึงโดยการหยุดการทำงานของ JavaScript และงานตัวจับเวลาชั่วคราว แท็บที่ถูกตรึงจะยังคงโหลดอยู่ในหน่วยความจำและกลับมาทำงานต่อทันทีเมื่อผู้ใช้เลือก แท็บที่มีงานที่ทำงานอยู่เบื้องหลัง เช่น แท็บที่เล่นเสียงหรือวิดีโอ จับภาพหน้าจอหรือสตรีมจากกล้อง รักษาการเชื่อมต่อ WebRTC ที่ใช้งานอยู่ หรือถือ Web Lock จะไม่มีสิทธิ์ตรึงและจะทำงานต่อไป เว็บไซต์ที่กำหนดค่าไว้ในนโยบาย TabDiscardingExceptions หรือในข้อยกเว้นการทิ้งแท็บของผู้ใช้จะได้รับการยกเว้นจากการตรึงด้วย\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" จะเปิดการตรึงแท็บเบื้องหลังอัตโนมัติสำหรับแท็บเบื้องหลังที่มีสิทธิ์ ผู้ใช้จะเปลี่ยนการตั้งค่านี้ไม่ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะป้องกันไม่ให้แท็บที่ทำงานอยู่เบื้องหลังถูกตรึง ผู้ใช้จะเปลี่ยนการตั้งค่านี้ไม่ได้\n\nการไม่ตั้งค่านโยบายหมายความว่าการตรึงแท็บที่ทำงานอยู่เบื้องหลังจะเปิดใช้โดยค่าเริ่มต้น แต่ผู้ใช้สามารถเปิดหรือปิดได้ในการตั้งค่า Brave";
BasicAuthOverHttpEnabled.pfm_title = "อนุญาตการตรวจสอบสิทธิ์Basicสำหรับ HTTP";
BasicAuthOverHttpEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะอนุญาตคำขอตรวจสอบสิทธิ์Basicที่ได้รับผ่าน HTTP ที่ไม่ปลอดภัย\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะห้ามไม่ให้คำขอ HTTP ที่ไม่ปลอดภัยใช้สกีมการตรวจสอบสิทธิ์Basic อนุญาตเฉพาะ HTTPS ที่ปลอดภัยเท่านั้น\n\nระบบจะเพิกเฉยต่อการตั้งค่านโยบายนี้ (และห้ามไม่ให้ใช้แบบBasicเสมอ) หากนโยบาย AuthSchemes มีการตั้งค่าและไม่รวมแบบBasicไว้ด้วย";
BatterySaverModeAvailability.pfm_title = "เปิดใช้โหมดประหยัดแบตเตอรี่";
BatterySaverModeAvailability.pfm_description = "0 - ระบบจะปิดใช้โหมดประหยัดแบตเตอรี่\n1 - ระบบจะเปิดใช้โหมดประหยัดแบตเตอรี่เมื่ออุปกรณ์ใช้พลังงานแบตเตอรี่และระดับแบตเตอรี่เหลือน้อย\n2 - ค่านี้เลิกใช้งานไปแล้วตั้งแต่เวอร์ชัน M121 ในเวอร์ชัน M121 ขึ้นไป ระบบจะถือว่าค่าเป็น EnabledBelowThreshold\nนโยบายนี้จะเปิดใช้หรือปิดใช้การตั้งค่าโหมดประหยัดแบตเตอรี่\nใน Chrome การตั้งค่านี้จะช่วยให้ระบบควบคุมอัตราเฟรมให้ใช้พลังงานน้อยลงได้ หากไม่ได้ตั้งค่านโยบายนี้ ผู้ใช้ปลายทางจะควบคุมการตั้งค่านี้ได้ใน chrome://settings/performance\nใน ChromeOS การตั้งค่านี้จะช่วยควบคุมอัตราเฟรมและความถี่ของ CPU, หรี่ไฟแบ็กไลต์ และให้ Android เข้าสู่โหมดประหยัดแบตเตอรี่ ในอุปกรณ์ที่มี CPU หลายตัว ระบบจะปิด CPU บางตัว\nรายละเอียดของระดับต่างๆ มีดังนี้\nDisabled (0): โหมดประหยัดแบตเตอรี่จะปิดใช้งาน\nEnabledBelowThreshold (1): ระบบจะเปิดใช้โหมดประหยัดแบตเตอรี่เมื่ออุปกรณ์ใช้พลังงานแบตเตอรี่และระดับแบตเตอรี่เหลือน้อย\nEnabledOnBattery (2): ค่านี้เลิกใช้งานไปแล้วตั้งแต่เวอร์ชัน M121 ตั้งแต่เวอร์ชัน M121 เป็นต้นไป ระบบจะถือว่าค่าเป็น EnabledBelowThreshold\n";
BlockExternalExtensions.pfm_title = "บล็อกไม่ให้ติดตั้งส่วนขยายจากภายนอก";
BlockExternalExtensions.pfm_description = "ควบคุมการติดตั้งส่วนขยายจากภายนอก\n\nการตั้งค่านโยบายนี้เป็น \"เปิดใช้\" จะบล็อกการติดตั้งส่วนขยายจากภายนอก\n\nการตั้งค่านโยบายนี้เป็น \"ปิดใช้\" หรือไม่ตั้งค่าจะอนุญาตให้ติดตั้งส่วนขยายจากภายนอก\n\nดูเอกสารประกอบเกี่ยวกับส่วนขยายจากภายนอกและการติดตั้งได้ที่ https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions\n\nหมายเหตุ: นโยบายนี้มีผลเฉพาะกับแพลตฟอร์มที่รองรับส่วนขยาย";
BlockThirdPartyCookies.pfm_title = "ปิดกั้นคุกกี้ของบุคคลที่สาม";
BlockThirdPartyCookies.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะป้องกันไม่ให้องค์ประกอบหน้าเว็บที่ไม่ได้มาจากโดเมนในแถบที่อยู่ของเบราว์เซอร์ตั้งค่าคุกกี้ การตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้องค์ประกอบเหล่านั้นตั้งค่าคุกกี้ได้และป้องกันไม่ให้ผู้ใช้เปลี่ยนการตั้งค่านี้\n\nการไม่ตั้งค่าจะอนุญาตคุกกี้ของบุคคลที่สาม แต่ผู้ใช้สามารถเปลี่ยนการตั้งค่านี้ได้\n\nหมายเหตุ: นโยบายนี้ไม่มีผลในโหมดไม่ระบุตัวตน ซึ่งคุกกี้ของบุคคลที่สามจะถูกบล็อกและอนุญาตเฉพาะในระดับเว็บไซต์เท่า หากต้องการอนุญาตคุกกี้ในระดับเว็บไซต์ ให้ใช้นโยบาย CookiesAllowedForUrls";
BookmarkBarEnabled.pfm_title = "เปิดใช้งานแถบบุ๊กมาร์ก";
BookmarkBarEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" จะแสดงแถบบุ๊กมาร์กใน Brave การตั้งค่านโยบายเป็น \"เท็จ\" หมายความว่าผู้ใช้จะไม่เห็นแถบบุ๊กมาร์กเลย\n\nหากคุณตั้งค่านโยบายนี้ ผู้ใช้จะเปลี่ยนไม่ได้ หากไม่ได้ตั้งค่า ผู้ใช้จะเป็นผู้เลือกว่าจะใช้ฟังก์ชันนี้หรือไม่";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "เปิดใช้การเพิ่มบุคคลในการจัดการผู้ใช้";
BrowserAddPersonEnabled.pfm_description = "หากตั้งค่านโยบายนี้เป็น \"จริง\" หรือไม่ได้กำหนดค่า Brave และ Lacros จะอนุญาตให้เพิ่มบุคคลใหม่จากการจัดการผู้ใช้\n\nหากตั้งค่านโยบายนี้เป็น \"เท็จ\" Brave และ Lacros จะไม่อนุญาตให้เพิ่มบุคคลใหม่จากการจัดการผู้ใช้";
BrowserGuestModeEnabled.pfm_title = "เปิดใช้โหมดผู้มาเยือนในเบราว์เซอร์";
BrowserGuestModeEnabled.pfm_description = "หากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้กำหนดค่า Brave จะเปิดใช้การเข้าสู่ระบบแบบผู้ใช้ชั่วคราว การเข้าสู่ระบบแบบผู้ใช้ชั่วคราวคือโปรไฟล์ Brave ที่หน้าต่างทั้งหมดจะอยู่ในโหมดไม่ระบุตัวตน\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" Brave จะไม่อนุญาตให้เริ่มโปรไฟล์ผู้ใช้ชั่วคราว";
BrowserGuestModeEnforced.pfm_title = "บังคับใช้โหมดผู้เยี่ยมชมในเบราว์เซอร์";
BrowserGuestModeEnforced.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หมายความว่า Brave จะบังคับใช้เซสชันผู้เยี่ยมชมและป้องกันการลงชื่อเข้าใช้โปรไฟล์ การลงชื่อเข้าใช้ของผู้เยี่ยมชมเป็นโปรไฟล์ Brave ซึ่งมีหน้าต่างอยู่ในโหมดไม่ระบุตัวตน\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\", ไม่ตั้งค่านโยบาย หรือปิดใช้โหมดผู้เยี่ยมชมของเบราว์เซอร์ (ผ่าน BrowserGuestModeEnabled) จะทำให้ใช้โปรไฟล์ใหม่และโปรไฟล์ที่มีอยู่ได้";
BrowserLabsEnabled.pfm_title = "ไอคอนการทดสอบเบราว์เซอร์แถบเครื่องมือ";
BrowserLabsEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้ผู้ใช้เข้าถึงฟีเจอร์ทดลองของเบราว์เซอร์ได้ผ่านไอคอนในแถบเครื่องมือ\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะนำไอคอนฟีเจอร์ทดลองของเบราว์เซอร์ออกจากแถบเครื่องมือ\n\nการใช้ chrome://flags รวมถึงการปิดและเปิดฟีเจอร์ของเบราว์เซอร์ด้วยวิธีการอื่นใดจะยังคงมีลักษณะการทำงานตามที่คาดไว้ไม่ว่าจะมีการ \"เปิดใช้\" หรือ \"ปิดใช้\" นโยบายนี้";
BrowserNetworkTimeQueriesEnabled.pfm_title = "อนุญาตคำค้นหาที่ส่งไปยังบริการเวลาของ Google";
BrowserNetworkTimeQueriesEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้ Brave ส่งการค้นหาไปยังเซิร์ฟเวอร์ของ Google เป็นครั้งคราวเพื่อเรียกการประทับเวลาที่ถูกต้อง\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะหยุด Brave ไม่ให้ส่งการค้นหาเหล่านี้";
BrowserSignin.pfm_title = "การตั้งค่าการลงชื่อเข้าใช้เบราว์เซอร์";
BrowserSignin.pfm_description = "0 - ปิดใช้การลงชื่อเข้าใช้เบราว์เซอร์\n1 - เปิดใช้การลงชื่อเข้าใช้เบราว์เซอร์\n2 - บังคับให้ผู้ใช้ลงชื่อเข้าใช้เพื่อใช้เบราว์เซอร์\nนโยบายนี้ควบคุมลักษณะการลงชื่อเข้าใช้ของเบราว์เซอร์ โดยให้คุณระบุว่าผู้ใช้จะลงชื่อเข้าใช้ Brave ด้วยบัญชีของตนและใช้บริการที่เกี่ยวข้องกับบัญชี เช่น การซิงค์ของ Brave ได้หรือไม่\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้การลงชื่อเข้าใช้เบราว์เซอร์\" ผู้ใช้จะลงชื่อเข้าใช้เบราว์เซอร์และใช้บริการที่เกี่ยวข้องกับบัญชีไม่ได้ ในกรณีนี้ฟีเจอร์ระดับเบราว์เซอร์ เช่น การซิงค์ของ Brave จะใช้ไม่ได้และไม่พร้อมใช้งาน ใน iOS หากผู้ใช้ลงชื่อเข้าใช้และมีการตั้งค่านโยบายเป็น \"ปิดใช้\" ผู้ใช้จะออกจากระบบทันที ในแพลตฟอร์มอื่นๆ ผู้ใช้จะออกจากระบบเมื่อเรียกใช้ Brave ครั้งถัดไป ในทุกแพลตฟอร์ม ระบบจะเก็บข้อมูลโปรไฟล์ในเครื่อง เช่น บุ๊กมาร์ก รหัสผ่าน ฯลฯ ไว้ และข้อมูลเหล่านี้ยังใช้ได้อยู่ ผู้ใช้จะยังลงชื่อเข้าใช้และใช้บริการเว็บของ Google เช่น Gmail ได้ต่อไป\n\nหากตั้งค่านโยบายเป็น \"เปิดใช้การลงชื่อเข้าใช้เบราว์เซอร์\" ผู้ใช้จะได้รับอนุญาตให้ลงชื่อเข้าใช้เบราว์เซอร์ ในทุกแพลตฟอร์มยกเว้น iOS ผู้ใช้จะลงชื่อเข้าใช้เบราว์เซอร์โดยอัตโนมัติเมื่อลงชื่อเข้าใช้เว็บเซอร์วิสของ Google เช่น Gmail การลงชื่อเข้าใช้เบราว์เซอร์หมายถึงเบราว์เซอร์จะเก็บข้อมูลบัญชีของผู้ใช้ไว้ แต่ไม่ได้หมายความว่าระบบจะเปิดใช้การซิงค์ของ Brave โดยค่าเริ่มต้น ผู้ใช้ต้องเลือกใช้ฟีเจอร์นี้แยกต่างหาก การเปิดใช้นโยบายนี้จะป้องกันไม่ให้ผู้ใช้ปิดการตั้งค่าที่อนุญาตให้ลงชื่อเข้าใช้เบราว์เซอร์ หากต้องการควบคุมความพร้อมใช้งานของฟีเจอร์การซิงค์ของ Brave ให้ใช้นโยบาย SyncDisabled\n\nหากตั้งค่านโยบายเป็น \"บังคับให้ลงชื่อเข้าใช้เบราว์เซอร์\" ระบบจะแสดงกล่องโต้ตอบการเลือกบัญชีและบังคับให้ผู้ใช้เลือกบัญชีเพื่อลงชื่อเข้าใช้เบราว์เซอร์ ในกรณีของบัญชีที่จัดการ วิธีนี้ช่วยให้แน่ใจว่าจะมีการใช้งานและบังคับใช้นโยบายที่เกี่ยวข้องกับบัญชีนั้น ค่าเริ่มต้นของ BrowserGuestModeEnabled ตั้งไว้เป็น \"ปิดใช้\" โปรดทราบว่าโปรไฟล์ที่ไม่ได้ลงชื่อเข้าใช้ที่มีอยู่จะถูกล็อกและเข้าถึงไม่ได้หลังจากเปิดใช้นโยบายนี้แล้ว ดูข้อมูลเพิ่มเติมได้จากบทความในศูนย์ช่วยเหลือที่ https://support.google.com/chrome/?p=force_browser_signin ตัวเลือกนี้ไม่รองรับใน Google Chrome OS หรือ Android ซึ่งจะเปลี่ยนกลับไปเป็น \"เปิดใช้การลงชื่อเข้าใช้เบราว์เซอร์\" หากใช้\n\nหากไม่ได้ตั้งค่านโยบายนี้ ผู้ใช้เลือกได้ว่าจะเปิดใช้การลงชื่อเข้าใช้เบราว์เซอร์หรือไม่ในการตั้งค่า Brave และใช้งานได้ตามความเหมาะสม";
BrowserSwitcherDelay.pfm_title = "หน่วงเวลาก่อนเปิดเบราว์เซอร์สำรอง (มิลลิวินาที)";
BrowserSwitcherDelay.pfm_description = "การตั้งค่านโยบายนี้เป็นตัวเลขจะทำให้ Brave แสดงข้อความเป็นมิลลิวินาทีตามจำนวนดังกล่าว จากนั้นจึงเปิดเบราว์เซอร์สำรอง\n\nการไม่ตั้งค่านโยบายนี้หรือตั้งค่าเป็น 0 หมายความว่าการไปยัง URL ที่กำหนดจะเป็นการเปิด URL ในเบราว์เซอร์สำรองทันที";
BrowserSwitcherEnabled.pfm_title = "เปิดใช้ฟีเจอร์การรองรับเบราว์เซอร์เวอร์ชันเก่า";
BrowserSwitcherEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หมายความว่า Brave จะพยายามเปิด URL บางรายการในเบราว์เซอร์สำรอง เช่น Internet Explorer® ฟีเจอร์นี้กำหนดค่าโดยใช้นโยบายในกลุ่ม Legacy Browser support\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าหมายความว่า Brave จะไม่พยายามเปิด URL ที่กำหนดในเบราว์เซอร์สำรอง";
BrowserSwitcherExternalGreylistUrl.pfm_title = "URL ของไฟล์ XML ที่มี URL ที่ไม่ควรทริกเกอร์การเปลี่ยนเบราว์เซอร์";
BrowserSwitcherExternalGreylistUrl.pfm_description = "การตั้งค่านโยบายนี้เป็น URL ที่ถูกต้องจะทำให้ Brave ดาวน์โหลดรายการเว็บไซต์จาก URL นั้นและใช้กฎเหมือนกับว่าได้รับการกำหนดค่าด้วยนโยบาย BrowserSwitcherUrlGreylist นโยบายเหล่านี้จะป้องกันไม่ให้ Brave และเบราว์เซอร์สำรองเปิดกันได้\n\nการไม่ได้ตั้งค่านโยบาย (หรือตั้งค่าเป็น URL ที่ไม่ถูกต้อง) หมายความว่า Brave จะไม่ใช้นโยบายนี้เป็นที่มาของกฎสำหรับการไม่เปลี่ยนเบราว์เซอร์\n\nหมายเหตุ: นโยบายนี้ชี้ไปยังไฟล์ XML ในรูปแบบเดียวกับนโยบาย SiteList ของ Internet Explorer® โดยจะโหลดกฎจากไฟล์ XML แต่ไม่แชร์กฎเหล่านั้นกับ Internet Explorer® ดูข้อมูลเพิ่มเติมเกี่ยวกับนโยบาย SiteList ของ Internet Explorer® ได้ที่ https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL ของไฟล์ XML ที่มี URL ที่จะโหลดในเบราว์เซอร์สำรอง";
BrowserSwitcherExternalSitelistUrl.pfm_description = "การตั้งค่านโยบายนี้เป็น URL ที่ถูกต้องจะทำให้ Brave ดาวน์โหลดรายการเว็บไซต์จาก URL นั้นและใช้กฎเหมือนกับว่าได้รับการกำหนดค่าด้วยนโยบาย BrowserSwitcherUrlList\n\nการไม่ได้ตั้งค่านโยบาย (หรือตั้งค่าเป็น URL ที่ไม่ถูกต้อง) หมายความว่า Brave จะไม่ใช้นโยบายนี้เป็นที่มาของกฎสำหรับการเปลี่ยนเบราว์เซอร์\n\nหมายเหตุ: นโยบายนี้ชี้ไปยังไฟล์ XML ในรูปแบบเดียวกับนโยบาย SiteList ของ Internet Explorer® โดยจะโหลดกฎจากไฟล์ XML แต่ไม่แชร์กฎเหล่านั้นกับ Internet Explorer® ดูข้อมูลเพิ่มเติมเกี่ยวกับนโยบาย SiteList ของ Internet Explorer® ได้ที่ https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherKeepLastChromeTab.pfm_title = "เปิดแท็บสุดท้ายไว้ใน Chrome";
BrowserSwitcherKeepLastChromeTab.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้ Brave เปิดแท็บไว้อย่างน้อย 1 แท็บหลังจากเปลี่ยนไปเป็นเบราว์เซอร์สำรอง\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ Brave ปิดแท็บหลังจากเปลี่ยนไปเป็นเบราว์เซอร์สำรอง แม้ว่าจะเป็นแท็บสุดท้ายที่เปิดอยู่ ซึ่งจะปิด Brave ไปเลย";
BrowserSwitcherParsingMode.pfm_title = "โหมดการแยกวิเคราะห์รายการเว็บไซต์";
BrowserSwitcherParsingMode.pfm_description = "0 - ลักษณะการทำงานเริ่มต้นของ LBS\n1 - เข้ากันกับรายการเว็บไซต์ในโหมดองค์กรของ Microsoft IE/Edge ได้ดีกว่า\nนโยบายนี้ควบคุมลักษณะที่ Google Chrome ตีความนโยบายรายการเว็บไซต์/รายการที่ต้องสงสัยของฟีเจอร์การรองรับเบราว์เซอร์เวอร์ชันเก่า ซึ่งจะส่งผลต่อนโยบาย BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl และ BrowserSwitcherExternalGreylistUrl\n\nหากเป็น \"ค่าเริ่มต้น\" (0) หรือไม่ได้ตั้งค่า การจับคู่ URL จะไม่เข้มงวดนัก กฎที่ไม่มีอักขระ \"/\" จะค้นหาสตริงย่อยจากทุกส่วนในชื่อโฮสต์ของ URL การจับคู่คอมโพเนนต์เส้นทางของ URL จะพิจารณาตัวพิมพ์เล็กและตัวพิมพ์ใหญ่\n\nหากเป็น \"IESiteListMode\" (1) การจับคู่ URL จะเข้มงวดยิ่งขึ้น กฎที่ไม่มีอักขระ \"/\" จะจับคู่ที่ส่วนท้ายของชื่อโฮสต์เท่านั้น และต้องอยู่ที่ขอบเขตของชื่อโดเมนด้วย การจับคู่คอมโพเนนต์เส้นทางของ URL จะไม่คำนึงถึงตัวพิมพ์เล็กหรือใหญ่ นโยบายนี้เข้ากันกับ Microsoft® Internet Explorer® และ Microsoft® Edge® ได้ดีกว่า\n\nตัวอย่างเช่น เมื่อใช้กฎ \"example.com\" และ \"acme.com/abc\" แล้ว \"http://example.com/\", \"http://subdomain.example.com/\" และ \"http://acme.com/abc\" จะถือว่าตรงกันไม่ว่าจะอยู่ในโหมดแยกวิเคราะห์หรือไม่\n\nส่วน \"http://notexample.com/\", \"http://example.com.invalid.com/\", \"http://example.comabc/\" จะถือว่าตรงกันเมื่ออยู่ในโหมด \"ค่าเริ่มต้น\" เท่านั้น\n\n\"http://acme.com/ABC\" จะถือว่าตรงกันเฉพาะใน \"IESiteListMode\"";
BrowserSwitcherUrlGreylist.pfm_title = "เว็บไซต์ที่ไม่ควรทริกเกอร์การเปลี่ยนเบราว์เซอร์";
BrowserSwitcherUrlGreylist.pfm_description = "การตั้งค่านโยบายจะควบคุมรายการเว็บไซต์ที่จะไม่ทำให้มีการเปลี่ยนเบราว์เซอร์ ระบบจะถือว่ารายการย่อยแต่ละรายการเป็นกฎ กฎที่ตรงกันจะไม่เปิดเบราว์เซอร์สำรอง ซึ่งต่างจากนโยบาย BrowserSwitcherUrlList ที่กฎต่างๆ จะใช้กับทั้ง 2 ทาง เมื่อ Add-in ของ Internet Explorer® เปิดอยู่ ก็จะเป็นตัวควบคุมด้วยว่า Internet Explorer® ควรเปิด URL เหล่านี้ใน Brave หรือไม่\n\nการไม่ตั้งค่านโยบายนี้จะไม่เพิ่มเว็บไซต์ลงในรายการ\n\nโปรดทราบว่าคุณเพิ่มเอลิเมนต์ลงในรายการนี้ผ่านนโยบาย BrowserSwitcherExternalGreylistUrl ได้ด้วย";
BrowserSwitcherUrlList.pfm_title = "เว็บไซต์ที่จะเปิดในเบราว์เซอร์สำรอง";
BrowserSwitcherUrlList.pfm_description = "การตั้งค่านโยบายนี้จะควบคุมรายการเว็บไซต์ที่จะเปิดในเบราว์เซอร์สำรอง ระบบจะถือว่ารายการย่อยแต่ละรายการเป็นกฎสำหรับบางอย่างที่จะเปิดในเบราว์เซอร์สำรอง Brave จะใช้กฎเหล่านั้นเมื่อเลือกว่า URL ควรเปิดในเบราว์เซอร์สำรองหรือไม่ เมื่อ Add-in ของ Internet Explorer® เปิดอยู่ Internet Explorer® จะเปลี่ยนกลับไปยัง Brave เมื่อกฎไม่ตรงกัน หากกฎขัดแย้งกัน Brave จะใช้กฎที่เจาะจงที่สุด\n\nการไม่ตั้งค่านโยบายนี้จะไม่เพิ่มเว็บไซต์ลงในรายการ\n\nโปรดทราบว่าคุณเพิ่มเอลิเมนต์ลงในรายการนี้ผ่านนโยบาย BrowserSwitcherUseIeSitelist และ BrowserSwitcherExternalSitelistUrl ได้ด้วย";
BrowserThemeColor.pfm_title = "กำหนดค่าสีธีมของเบราว์เซอร์";
BrowserThemeColor.pfm_description = "นโยบายนี้ให้ผู้ดูแลระบบกำหนดค่าสีธีมของ Brave สตริงอินพุตควรเป็นสตริงสีแบบเลขฐานสิบหกที่ถูกต้องซึ่งมีรูปแบบ \"#RRGGBB\"\n\nการตั้งค่านโยบายเป็นสีแบบเลขฐานสิบหกที่ถูกต้องจะทำให้ระบบสร้างธีมที่มีสีดังกล่าวและนำไปใช้กับเบราว์เซอร์โดยอัตโนมัติ ผู้ใช้จะเปลี่ยนธีมที่นโยบายกำหนดไว้ไม่ได้\n\nการไม่ตั้งค่านโยบายจะทำให้ผู้ใช้เปลี่ยนธีมของเบราว์เซอร์ได้ตามที่ต้องการ";
BrowsingDataLifetime.pfm_title = "การตั้งค่าอายุการใช้งานของข้อมูลการท่องเว็บ";
BrowsingDataLifetime.pfm_description = "กำหนดค่าอายุการใช้งานของข้อมูลการท่องเว็บสำหรับ Brave นโยบายนี้อนุญาตให้ผู้ดูแลระบบกำหนดค่า (ตามประเภทข้อมูล) เมื่อเบราว์เซอร์ลบข้อมูล ซึ่งจะเป็นประโยชน์สำหรับลูกค้าที่ทำงานกับข้อมูลลูกค้าที่มีความละเอียดอ่อน\n\nคำเตือน: การตั้งค่านโยบายนี้อาจส่งผลกระทบและนำข้อมูลส่วนตัวในเครื่องออกอย่างถาวร เราขอแนะนำให้ทดสอบการตั้งค่าก่อนติดตั้งใช้งานเพื่อป้องกันการลบข้อมูลส่วนตัวโดยไม่ตั้งใจ\n\nประเภทข้อมูลที่มี ได้แก่ 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' และ 'hosted_app_data' ไม่รองรับ 'download_history' และ 'hosted_app_data' ใน Android\n\nเบราว์เซอร์จะนำข้อมูลประเภทที่เลือกไว้ซึ่งมีอายุนานกว่า 'time_to_live_in_hours' ชั่วโมงออกโดยอัตโนมัติ ค่าต่ำสุดที่ตั้งค่าได้คือ 1 ชั่วโมง\n\nการลบข้อมูลที่หมดอายุจะเกิดขึ้นหลังจากที่เบราว์เซอร์เริ่มต้นไปแล้ว 15 วินาที จากนั้นจะเกิดขึ้นทุก 30 นาทีขณะที่เบราว์เซอร์ทำงาน\n\nผู้ใช้จะยังคงลงชื่อเข้าใช้บัญชี Google เมื่อลบคุกกี้\n\nนโยบายนี้กำหนดให้ตั้งค่านโยบาย SyncDisabled เป็น \"จริง\" จนถึง Chrome 114 ตั้งแต่ Chrome 115 เป็นต้นไป การตั้งค่านโยบายนี้จะปิดใช้การซิงค์สำหรับประเภทข้อมูลที่เกี่ยวข้อง หากไม่ได้ปิดใช้ \"Chrome Sync\" ไว้โดยการตั้งค่านโยบาย SyncDisabled และ BrowserSignin ปิดใช้อยู่\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime";
BuiltInAIAPIsEnabled.pfm_title = "อนุญาตให้หน้าเว็บใช้ AI API ในตัว";
BuiltInAIAPIsEnabled.pfm_description = "นโยบายนี้ควบคุมว่าหน้าเว็บสามารถใช้ AI API ในตัว (เช่น LanguageModel API, Summarization API, Writer API และ Rewriter API) ได้หรือไม่\n\nหากเปิดใช้นโยบายหรือไม่ได้ตั้งค่า จะมีการเปิดใช้ API ให้ใช้งานได้\n\nหากปิดใช้นโยบาย การพยายามใช้ API จะทำให้เกิดข้อผิดพลาด";
BuiltInDnsClientEnabled.pfm_title = "ใช้ไคลเอ็นต์ DNS ในตัว";
BuiltInDnsClientEnabled.pfm_description = "นโยบายนี้ควบคุมกลุ่มซอฟต์แวร์ที่จะใช้เพื่อสื่อสารกับเซิร์ฟเวอร์ DNS ซึ่งได้แก่ ไคลเอ็นต์ DNS ของระบบปฏิบัติการ หรือไคลเอ็นต์ DNS ในตัวของ Brave นโยบายนี้ไม่มีผลกับเซิร์ฟเวอร์ DNS ที่จะใช้ เช่น หากมีการกำหนดค่าให้ระบบปฏิบัติการใช้เซิร์ฟเวอร์ DNS ขององค์กร ไคลเอ็นต์ DNS ในตัวก็จะใช้เซิร์ฟเวอร์เดียวกันนี้ด้วย นอกจากนี้ นโยบายยังไม่ได้ควบคุมว่าจะใช้ DNS-over-HTTPS หรือไม่ Brave จะใช้รีโซลเวอร์ในตัวเมื่อมีคำขอ DNS-over-HTTPS เสมอ โปรดดูข้อมูลเกี่ยวกับการควบคุม DNS-over-HTTPS ในนโยบาย DnsOverHttpsMode\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ระบบจะใช้ไคลเอ็นต์ DNS ในตัว\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" จะมีการใช้ไคลเอ็นต์ DNS ในตัวเฉพาะเมื่อมีการใช้งาน DNS-over-HTTPS อยู่เท่านั้น";
CACertificateManagementAllowed.pfm_title = "อนุญาตให้ผู้ใช้จัดการใบรับรอง CA ที่ติดตั้งไว้";
CACertificateManagementAllowed.pfm_description = "0 - อนุญาตให้ผู้ใช้จัดการใบรับรองทั้งหมด\n1 - อนุญาตให้ผู้ใช้จัดการใบรับรองของผู้ใช้\n2 - ไม่อนุญาตให้ผู้ใช้จัดการใบรับรอง\nการตั้งค่านโยบายเป็น \"All\" (0) หรือไม่ได้ตั้งค่าจะทำให้ผู้ใช้สามารถแก้ไขการตั้งค่าความน่าเชื่อถือของใบรับรอง CA ทั้งหมด ลบใบรับรองที่ผู้ใช้นำเข้า และนำเข้าใบรับรองโดยใช้ตัวจัดการใบรับรองได้ การตั้งค่านโยบายเป็น \"UserOnly\" (1) ทำให้ผู้ใช้จัดการได้เฉพาะใบรับรองที่ผู้ใช้นำเข้า และจะเปลี่ยนแปลงการตั้งค่าความน่าเชื่อถือของใบรับรองในเครื่องไม่ได้ การตั้งค่าเป็น \"None\" (2) ทำให้ผู้ใช้ดูใบรับรอง CA ได้ (จัดการไม่ได้)";
CACertificates.pfm_title = "ใบรับรอง TLS ที่ Brave ควรเชื่อถือสำหรับการตรวจสอบสิทธิ์เซิร์ฟเวอร์";
CACertificates.pfm_description = "รายการใบรับรอง TLS ที่ Brave ควรเชื่อถือสำหรับการตรวจสอบสิทธิ์เซิร์ฟเวอร์\nใบรับรองควรเข้ารหัสฐาน 64";
CACertificatesWithConstraints.pfm_title = "ใบรับรอง TLS ที่ Brave ควรเชื่อถือสำหรับการตรวจสอบสิทธิ์เซิร์ฟเวอร์พร้อมกับข้อจำกัด";
CACertificatesWithConstraints.pfm_description = "รายการใบรับรอง TLS ที่ Brave ควรเชื่อถือสำหรับการตรวจสอบสิทธิ์เซิร์ฟเวอร์ โดยมีการเพิ่มข้อจำกัดไว้นอกใบรับรอง หากไม่มีข้อจำกัดของประเภทใดประเภทหนึ่ง ระบบจะอนุญาตให้ใช้ชื่อของประเภทนั้น\nใบรับรองควรเข้ารหัสฐาน 64 ต้องระบุข้อจำกัดอย่างน้อย 1 ข้อสำหรับใบรับรองแต่ละรายการ\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints";
CADistrustedCertificates.pfm_title = "ใบรับรอง TLS ที่ Brave ไม่ควรเชื่อถือสำหรับการตรวจสอบสิทธิ์เซิร์ฟเวอร์";
CADistrustedCertificates.pfm_description = "รายการคีย์สาธารณะของใบรับรองที่ Brave ไม่ควรเชื่อถือสำหรับการตรวจสอบสิทธิ์เซิร์ฟเวอร์ TLS\n\nค่าของนโยบายคือรายการใบรับรอง X.509 ที่เข้ารหัสฐาน 64 ระบบจะไม่เชื่อถือใบรับรองทั้งหมดที่มี SPKI (SubjectPublicKeyInfo) ที่ตรงกัน";
CAHintCertificates.pfm_title = "ใบรับรอง TLS ที่ไม่น่าเชื่อถือหรือเชื่อถือไม่ได้แต่สามารถใช้ในการสร้างเส้นทางเพื่อการตรวจสอบสิทธิ์เซิร์ฟเวอร์";
CAHintCertificates.pfm_description = "รายการใบรับรองที่ไม่น่าเชื่อถือหรือเชื่อถือไม่ได้ใน Brave แต่สามารถใช้เป็นคำแนะนำในการสร้างเส้นทาง ใบรับรองควรเข้ารหัสฐาน 64";
CAPlatformIntegrationEnabled.pfm_title = "ใช้ใบรับรอง TLS ที่ผู้ใช้เพิ่มไว้จาก Trust Store ของแพลตฟอร์มสำหรับการตรวจสอบสิทธิ์ของเซิร์ฟเวอร์";
CAPlatformIntegrationEnabled.pfm_description = "หากเปิดใช้ (หรือไม่ได้ตั้งค่า) จะมีการใช้ใบรับรอง TLS ที่ผู้ใช้เพิ่มไว้จาก Trust Store ของแพลตฟอร์มในการสร้างเส้นทางสำหรับการตรวจสอบสิทธิ์ของเซิร์ฟเวอร์ TLS\n\nหากปิดใช้ จะไม่มีการใช้ใบรับรอง TLS ที่ผู้ใช้เพิ่มไว้จาก Trust Store ของแพลตฟอร์มในการสร้างเส้นทางสำหรับการตรวจสอบสิทธิ์ของเซิร์ฟเวอร์ TLS";
CORSNonWildcardRequestHeadersSupport.pfm_title = "การรองรับส่วนหัวของคำขอที่ไม่มีไวลด์การ์ดสำหรับ CORS";
CORSNonWildcardRequestHeadersSupport.pfm_description = "กำหนดค่าการรองรับส่วนหัวของคำขอที่ไม่มีไวลด์การ์ดสำหรับ CORS\n\nBrave เวอร์ชัน 97 เพิ่มการรองรับส่วนหัวของคำขอที่ไม่มีไวลด์การ์ดสำหรับ CORS เมื่อสคริปต์ส่งคำขอเครือข่ายแบบข้ามต้นทางผ่าน fetch() และ XMLHttpRequest โดยมีส่วนหัว Authorization ที่สคริปต์เพิ่มเข้าไป ส่วนหัวนี้ต้องได้รับสิทธิ์อย่างชัดเจนจากส่วนหัว Access-Control-Allow-Headers ในการตอบกลับการตรวจสอบล่วงหน้าของ CORS \"อย่างชัดเจน\" ในที่นี้หมายความว่าสัญลักษณ์ไวลด์การ์ด \"*\" ไม่ครอบคลุมส่วนหัว Authorization ดูรายละเอียดเพิ่มเติมที่ https://chromestatus.com/feature/5742041264816128\n\nหากไม่ได้ตั้งค่านโยบายนี้หรือตั้งค่าเป็น \"จริง\" Brave จะรองรับส่วนหัวของคำขอที่ไม่มีไวลด์การ์ดสำหรับ CORS และมีลักษณะการทำงานตามที่อธิบายไว้ข้างต้น\n\nเมื่อตั้งค่านโยบายนี้เป็น \"เท็จ\" Chrome จะอนุญาตให้สัญลักษณ์ไวลด์การ์ด (\"*\") ในส่วนหัว Access-Control-Allow-Headers ของการตอบกลับการตรวจสอบล่วงหน้าของ CORS ครอบคลุมส่วนหัว Authorization\n\nนโยบายองค์กรนี้เป็นนโยบายชั่วคราว และมีแผนที่จะนำออกในอนาคต";
CacheEncryptionEnabled.pfm_title = "นโยบายนี้ช่วยให้ผู้ดูแลระบบเข้ารหัสแคช http ในดิสก์ได้";
CacheEncryptionEnabled.pfm_description = "นโยบายนี้ช่วยให้ผู้ดูแลระบบเข้ารหัสแคช http ของเบราว์เซอร์ในดิสก์ได้\n\nเมื่อเปิดใช้นโยบายนี้ ระบบจะเข้ารหัสแคชของเบราว์เซอร์\n\nเมื่อปิดใช้นโยบายนี้หรือไม่ได้ตั้งค่า ระบบจะไม่เข้ารหัสแคชของเบราว์เซอร์\n\nการเข้ารหัสแคชของเบราว์เซอร์อาจส่งผลกระทบต่อประสิทธิภาพ";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "ปิดการบังคับใช้ความโปร่งใสของใบรับรองสำหรับรายการแฮช subjectPublicKeyInfo";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "การตั้งค่านโยบายจะปิดใช้การบังคับใช้ข้อกำหนดการเปิดเผยความโปร่งใสของใบรับรองสำหรับรายการแฮช subjectPublicKeyInfo โฮสต์ที่เป็นองค์กรจะใช้ใบรับรองที่ไม่น่าเชื่อถือ (เนื่องจากไม่มีการเปิดเผยต่อสาธารณะอย่างเหมาะสม) ต่อไปได้ หากต้องการปิดใช้การบังคับใช้ แฮชนั้นต้องเป็นไปตามเงื่อนไขใดเงื่อนไขหนึ่งต่อไปนี้\n\n* มาจาก subjectPublicKeyInfo ของใบรับรองเซิร์ฟเวอร์\n\n* มาจาก subjectPublicKeyInfo ซึ่งแสดงในใบรับรองของผู้ออกใบรับรอง (CA) ในกลุ่มใบรับรอง ใบรับรอง CA ดังกล่าวถูกจำกัดผ่านส่วนขยาย X.509v3 nameConstraints มี directoryName nameConstraints อย่างน้อย 1 รายการใน permittedSubtrees และ directoryName มีแอตทริบิวต์ organizationName\n\n* มาจาก subjectPublicKeyInfo ที่แสดงในใบรับรอง CA ในกลุ่มใบรับรอง ใบรับรอง CA มีแอตทริบิวต์ organizationName อย่างน้อย 1 รายการในชื่อใบรับรอง และใบรับรองของเซิร์ฟเวอร์มีจำนวนแอตทริบิวต์ organizationName เท่ากัน ในลำดับเดียวกัน และมีค่าเท่ากันแบบไบต์ต่อไบต์\n\nระบุ subjectPublicKeyInfo ได้จากการต่อชื่ออัลกอริทึมของแฮช เครื่องหมายทับ และการเข้ารหัส Base64 ของอัลกอริทึมของแฮชนั้นนำไปใช้กับ subjectPublicKeyInfo ที่เข้ารหัส DER ของใบรับรองที่ระบุ การเข้ารหัส Base64 นี้เป็นรูปแบบเดียวกับลายนิ้วมือ SPKI ระบบรู้จักอัลกอริทึมของแฮชเพียงรายการเดียวนั่นคือ sha256 และจะไม่สนใจอัลกอริทึมของแฮชอื่นๆ\n\nการไม่ตั้งค่านโยบายนี้หมายความว่าหากไม่มีการเปิดเผยความโปร่งใสของใบรับรองตามที่ใบรับรองกำหนด Brave ก็จะไม่เชื่อถือใบรับรองนั้น";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "ปิดการบังคับใช้ความโปร่งใสของใบรับรองสำหรับรายการ URL";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "การตั้งค่านโยบายจะปิดใช้ข้อกำหนดในการเปิดเผยข้อมูลความโปร่งใสของใบรับรองสำหรับชื่อโฮสต์ใน URL ที่ระบุ โฮสต์สามารถใช้ใบรับรองที่ไม่น่าเชื่อถือต่อไปได้ (เนื่องจากไม่มีการเปิดเผยต่อสาธารณะอย่างเหมาะสม) แต่จะทำให้ตรวจหาใบรับรองที่ออกอย่างไม่ถูกต้องได้ยากขึ้น\n\nการไม่ตั้งค่านโยบายนี้หมายความว่าหากไม่มีการเปิดเผยความโปร่งใสของใบรับรองตามที่ใบรับรองกำหนด \"Brave\" ก็จะไม่เชื่อถือใบรับรองนั้น\n\nURL มีรูปแบบดังนี้ ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ) แต่เนื่องจากความถูกต้องของใบรับรองสำหรับชื่อโฮสต์หนึ่งๆ ขึ้นอยู่กับรูปแบบ พอร์ต หรือเส้นทาง \"Brave\" จึงพิจารณาเพียงแค่ส่วนชื่อโฮสต์ของ URL เท่านั้น ไม่รองรับโฮสต์ไวลด์การ์ด";
ChromeForTestingAllowed.pfm_title = "อนุญาตให้ใช้ Chrome สำหรับการทดสอบ";
ChromeForTestingAllowed.pfm_description = "ควบคุมว่าผู้ใช้จะใช้ Chrome สำหรับการทดสอบได้ไหม\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ผู้ใช้จะติดตั้งและเรียกใช้ Chrome สำหรับการทดสอบได้\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ผู้ใช้จะไม่ได้รับอนุญาตให้เรียกใช้ Chrome สำหรับการทดสอบ ผู้ใช้จะยังคงติดตั้ง Chrome สำหรับการทดสอบได้ แต่จะไม่เรียกใช้กับโปรไฟล์ที่ตั้งค่านโยบายนี้เป็น \"ปิดใช้\"";
ChromeSuggestionsSettings.pfm_title = "การตั้งค่าสำหรับ ChromeSuggestions";
ChromeSuggestionsSettings.pfm_description = "การตั้งค่านี้อนุญาตให้ Chrome แนะนำความสามารถของ AI ในช่วงเวลาที่เหมาะสมได้\n\n0/ไม่ได้ตั้งค่า = ระบบจะเปิดใช้คำแนะนำจาก Chrome สำหรับผู้ใช้\n\n1 = ระบบจะปิดใช้คำแนะนำจาก Chrome สำหรับผู้ใช้\n\nดูข้อมูลเพิ่มเติมได้ที่บทความในศูนย์ช่วยเหลือ https://support.google.com/chrome/a?p=chrome_suggestions";
ChromeVariations.pfm_title = "กำหนดความพร้อมใช้งานของรูปแบบต่างๆ";
ChromeVariations.pfm_description = "0 - เปิดใช้รูปแบบทั้งหมด\n1 - เปิดใช้รูปแบบต่างๆ ที่เกี่ยวข้องกับการแก้ไขที่สำคัญเท่านั้น\n2 - ปิดใช้รูปแบบทั้งหมด\nการกำหนดค่านโยบายนี้จะอนุญาตให้ระบุรูปแบบที่อนุญาตให้ใช้ใน Brave\n\nรูปแบบต่างๆ เป็นวิธีที่ช่วยให้เสนอการแก้ไข Brave ได้โดยไม่ต้องส่งเบราว์เซอร์เวอร์ชันใหม่ด้วยการเลือกเปิดหรือปิดใช้ฟีเจอร์ที่มีอยู่แล้ว ดูข้อมูลเพิ่มเติมได้ที่ https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework\n\nการตั้งค่า VariationsEnabled (ค่า 0) หรือไม่ตั้งค่านโยบายจะอนุญาตให้ใช้รูปแบบทั้งหมดกับเบราว์เซอร์ได้\n\nการตั้งค่า CriticalFixesOnly (ค่า 1) จะอนุญาตให้ใช้เฉพาะรูปแบบที่ถือว่าเป็นการแก้ไขด้านความปลอดภัยที่สำคัญมากหรือการแก้ไขด้านความเสถียรกับ Brave เท่านั้น\n\nการตั้งค่า VariationsDisabled (ค่า 2) จะไม่อนุญาตให้ใช้รูปแบบใดก็ตามกับเบราว์เซอร์ โปรดทราบว่าโหมดนี้อาจขัดขวางไม่ให้นักพัฒนาแอปของ Brave ทำการแก้ไขด้านความปลอดภัยที่สำคัญมากได้อย่างทันท่วงที และด้วยเหตุนี้จึงไม่แนะนำให้ใช้โหมดนี้";
ClearBrowsingDataOnExitList.pfm_title = "ล้างข้อมูลการท่องเว็บเมื่อออก";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - ประวัติการเข้าชมที่เรียกดู\ndownload_history - ประวัติการดาวน์โหลด\ncookies_and_other_site_data - คุกกี้และข้อมูลอื่นของเว็บไซต์\ncached_images_and_files - รูปภาพและไฟล์ที่แคชไว้\npassword_signin - ลงชื่อเข้าใช้ด้วยรหัสผ่าน\nautofill - ป้อนอัตโนมัติ\nsite_settings - การตั้งค่าเว็บไซต์\nhosted_app_data - ข้อมูลแอปที่โฮสต์ไว้\nกำหนดค่ารายการประเภทข้อมูลการท่องเว็บที่ควรจะลบออกเมื่อผู้ใช้ปิดหน้าต่างเบราว์เซอร์ทั้งหมด\n\nคำเตือน: การตั้งค่านโยบายนี้อาจส่งผลกระทบและนำข้อมูลส่วนตัวในเครื่องออกอย่างถาวร เราขอแนะนำให้ทดสอบการตั้งค่าก่อนติดตั้งใช้งานเพื่อป้องกันการลบข้อมูลส่วนตัวโดยไม่ตั้งใจ\n\nประเภทข้อมูลที่มี ได้แก่ ประวัติการท่องเว็บ (browsing_history) ประวัติการดาวน์โหลด (download_history) คุกกี้ (cookies_and_other_site_data) แคช (cached_images_and_files) ข้อความป้อนอัตโนมัติ (autofill) รหัสผ่าน (password_signin) การตั้งค่าเว็บไซต์ (site_settings) และข้อมูลแอปที่โฮสต์ไว้ (hosted_app_data) นโยบายนี้ไม่มีความสำคัญเหนือ AllowDeletingBrowserHistory\n\nผู้ใช้จะยังคงลงชื่อเข้าใช้บัญชี Google เมื่อลบคุกกี้\n\nนโยบายนี้กำหนดให้ตั้งค่านโยบาย SyncDisabled เป็น \"จริง\" จนถึง Chrome 114 ตั้งแต่ Chrome 115 เป็นต้นไป การตั้งค่านโยบายนี้จะปิดใช้การซิงค์สำหรับประเภทข้อมูลที่เกี่ยวข้อง หากไม่ได้ปิดใช้ \"Chrome Sync\" ไว้โดยการตั้งค่านโยบาย SyncDisabled และ BrowserSignin ปิดใช้อยู่\n\nหากการลบข้อมูลเริ่มขึ้นแล้วและดำเนินการไม่เสร็จสิ้นด้วยเหตุผลบางประการ ระบบจะล้างข้อมูลการท่องเว็บในครั้งถัดไปที่โหลดโปรไฟล์\n\nหาก Brave ไม่ได้ออกอย่างราบรื่น (เช่น หากเบราว์เซอร์หรือระบบปฏิบัติการขัดข้อง) ระบบจะไม่ล้างข้อมูลการท่องเว็บเนื่องจากการปิดเบราว์เซอร์ไม่ได้เกิดจากการที่ผู้ใช้ปิดหน้าต่างเบราว์เซอร์ทั้งหมด";
ClipboardAllowedForUrls.pfm_title = "อนุญาตคลิปบอร์ดในเว็บไซต์เหล่านี้";
ClipboardAllowedForUrls.pfm_description = "การตั้งค่านโยบายช่วยให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่สามารถใช้สิทธิ์เข้าถึงคลิปบอร์ดสำหรับเว็บไซต์ได้ ทั้งนี้ไม่รวมการดำเนินการเกี่ยวกับคลิปบอร์ดทั้งหมดในต้นทางที่ตรงกับรูปแบบในรายการ ตัวอย่างเช่น ผู้ใช้จะยังวางโดยใช้แป้นพิมพ์ลัดได้อยู่เนื่องจากไม่ถูกกั้นโดยสิทธิ์เข้าถึงคลิปบอร์ดสำหรับเว็บไซต์\n\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultClipboardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
ClipboardBlockedForUrls.pfm_title = "บล็อกคลิปบอร์ดในเว็บไซต์เหล่านี้";
ClipboardBlockedForUrls.pfm_description = "การตั้งค่านโยบายช่วยให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่สามารถใช้สิทธิ์เข้าถึงคลิปบอร์ดสำหรับเว็บไซต์ได้ ทั้งนี้ไม่รวมการดำเนินการเกี่ยวกับคลิปบอร์ดทั้งหมดในต้นทางที่ตรงกับรูปแบบในรายการ ตัวอย่างเช่น ผู้ใช้จะยังวางโดยใช้แป้นพิมพ์ลัดได้อยู่เนื่องจากไม่ถูกกั้นโดยสิทธิ์เข้าถึงคลิปบอร์ดสำหรับเว็บไซต์\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultClipboardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
CloudManagementEnrollmentMandatory.pfm_title = "เปิดใช้การลงทะเบียนการจัดการระบบคลาวด์ที่บังคับ";
CloudManagementEnrollmentMandatory.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะบังคับให้มีการลงทะเบียนเบราว์เซอร์ Chrome Enterprise Core และบล็อกกระบวนการเปิดตัว Brave หากการลงทะเบียนไม่สำเร็จ\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ตั้งค่าจะแสดงการลงทะเบียนเบราว์เซอร์ Chrome Enterprise Core เป็นแบบไม่บังคับและจะไม่บล็อกกระบวนการเปิดตัว Brave แม้การลงทะเบียนไม่สำเร็จ\n\nการลงทะเบียนนโยบายระบบคลาวด์ตามขอบเขตของเครื่องบนเดสก์ท็อปจะใช้นโยบายนี้ ดูรายละเอียดที่ https://support.google.com/chrome/a/answer/9301891";
CloudManagementEnrollmentToken.pfm_title = "โทเค็นการลงทะเบียนของนโยบายระบบคลาวด์";
CloudManagementEnrollmentToken.pfm_description = "การตั้งค่านโยบายจะทำให้ Brave พยายามลงทะเบียนตนเองกับการจัดการเบราว์เซอร์ Chrome Enterprise Core ค่าของนโยบายนี้จะเป็นโทเค็นการลงทะเบียนที่คุณเรียกมาจากGoogle Admin console\n\nดูรายละเอียดที่ https://support.google.com/chrome/a/answer/9301891";
CloudPolicyOverridesPlatformPolicy.pfm_title = "นโยบายระบบคลาวด์ของ Brave จะลบล้างนโยบายแพลตฟอร์ม";
CloudPolicyOverridesPlatformPolicy.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะทำให้นโยบายระบบคลาวด์มีความสำคัญเหนือกว่าหากมีความขัดแย้งกับนโยบายแพลตฟอร์ม\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ตั้งค่าจะทำให้นโยบายแพลตฟอร์มมีความสำคัญเหนือกว่าหากมีความขัดแย้งกับนโยบายระบบคลาวด์\n\nนโยบายที่บังคับนี้ส่งผลต่อนโยบายระบบคลาวด์ตามขอบเขตของเครื่อง\n\nนโยบายนี้มีผลเฉพาะกับ Brave และไม่มีผลกับ Google Updateเนื่องจากเป็นแอปพลิเคชันอิสระ\nGoogle Updateมีนโยบายแยกต่างหากที่ใช้ชื่อเดียวกัน";
CloudUserPolicyMerge.pfm_title = "เปิดใช้การรวมนโยบายในระดับผู้ใช้บนระบบคลาวด์เข้ากับนโยบายระดับแมชชีน";
CloudUserPolicyMerge.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะอนุญาตให้นโยบายที่เกี่ยวข้องกับบัญชีที่จัดการสามารถผสานเข้ากับนโยบายระดับเครื่องได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ตั้งค่าจะป้องกันไม่ให้มีการผสานนโยบายระดับผู้ใช้บนระบบคลาวด์เข้ากับนโยบายจากแหล่งที่มาอื่นๆ\n\nเฉพาะนโยบายที่มาจากผู้ใช้ที่ปลอดภัยเท่านั้นที่จะมีความสำคัญเหนือกว่าได้ ผู้ใช้ที่ปลอดภัยจะเชื่อมโยงกับองค์กรที่จัดการเบราว์เซอร์ของตนโดยใช้ Chrome Enterprise Core นโยบายระดับผู้ใช้อื่นๆ ทั้งหมดจะมีลำดับความสำคัญตามค่าเริ่มต้น\n\nนโยบายที่จะผสานต้องตั้งค่าใน PolicyListMultipleSourceMergeList หรือ PolicyDictionaryMultipleSourceMergeList ด้วย ระบบจะไม่สนใจนโยบายนี้หากไม่ได้กำหนดค่าทั้ง 2 นโยบายที่ระบุไว้ก่อนหน้านี้";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "อนุญาตให้นโยบายระดับผู้ใช้บนระบบคลาวด์ลบล้างนโยบาย Chrome Browser Cloud Management";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะทำให้นโยบายที่เชื่อมโยงกับบัญชีที่จัดการมีความสำคัญเหนือกว่าในกรณีที่ขัดแย้งกับนโยบายเบราว์เซอร์ Chrome Enterprise Core\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ตั้งค่าจะทำให้นโยบายระดับผู้ใช้บนระบบคลาวด์มีลำดับความสำคัญตามค่าเริ่มต้น\n\nเฉพาะนโยบายที่มาจากผู้ใช้ที่ปลอดภัยเท่านั้นที่จะมีความสำคัญเหนือกว่าได้ ผู้ใช้ที่ปลอดภัยจะเชื่อมโยงกับองค์กรที่จัดการเบราว์เซอร์ของตนโดยใช้ Chrome Enterprise Core นโยบายระดับผู้ใช้อื่นๆ ทั้งหมดจะมีลำดับความสำคัญตามค่าเริ่มต้น\n\nนโยบายนี้สามารถใช้ร่วมกับCloudPolicyOverridesPlatformPolicy หากมีการเปิดใช้ทั้ง 2 นโยบาย นโยบายระดับผู้ใช้บนระบบคลาวด์ก็จะมีความสำคัญเหนือกว่านโยบายระดับแพลตฟอร์มที่ขัดแย้งกันด้วย";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "เปิดใช้คำเตือนด้านความปลอดภัยสำหรับการติดธงบรรทัดคำสั่ง";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าหมายความว่าคำเตือนด้านความปลอดภัยจะแสดงเมื่อมีการใช้แฟล็กบรรทัดคำสั่งที่อาจเป็นอันตรายเพื่อเปิด Chrome\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ระบบไม่แสดงคำเตือนด้านความปลอดภัยเมื่อมีการเปิดใช้ Chrome โดยมีแฟล็กบรรทัดคำสั่งที่อาจเป็นอันตราย\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
ComponentUpdatesEnabled.pfm_title = "เปิดใช้การอัปเดตคอมโพเนนต์ใน Brave";
ComponentUpdatesEnabled.pfm_description = "เปิดใช้งานการอัปเดตคอมโพเนนต์สำหรับทุกคอมโพเนนต์ใน Brave เมื่อไม่มีการตั้งค่าหรือตั้งค่าเป็นเปิดใช้งาน\n\nหากตั้งค่าเป็นปิดใช้งาน การอัปเดตสำหรับคอมโพเนนต์จะปิดใช้งาน อย่างไรก็ตาม จะมีบางคอมโพเนนต์ที่ได้รับการยกเว้นจากนโยบายนี้ กล่าวคือระบบจะไม่ปิดใช้การอัปเดตคอมโพเนนต์ที่ไม่มีโค้ดปฏิบัติการและมีความสำคัญต่อการรักษาความปลอดภัยของเบราว์เซอร์\nตัวอย่างของคอมโพเนนต์ดังกล่าว ได้แก่ รายการยกเลิกใบรับรองและตัวกรองทรัพยากรย่อย";
CompressionDictionaryTransportEnabled.pfm_title = "เปิดใช้การรองรับการส่งพจนานุกรมการบีบอัด";
CompressionDictionaryTransportEnabled.pfm_description = "ฟีเจอร์นี้ช่วยให้สามารถใช้การเข้ารหัสเนื้อหาเฉพาะพจนานุกรมในส่วนหัวของคําขอ \"ยอมรับการเข้ารหัส\" (\"sbr\" และ \"zst-d\") ได้เมื่อมีพจนานุกรมพร้อมใช้งาน\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ Brave ยอมรับเนื้อหาเว็บโดยใช้ฟีเจอร์การส่งพจนานุกรมการบีบอัด\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิดฟีเจอร์การส่งพจนานุกรมการบีบอัด";
CookiesAllowedForUrls.pfm_title = "อนุญาตให้ใช้คุกกี้บนไซต์เหล่านี้";
CookiesAllowedForUrls.pfm_description = "ให้คุณกำหนดรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ได้รับอนุญาตให้ตั้งค่าคุกกี้\n\nรูปแบบ URL อาจเป็น URL เดียวที่ระบุว่าเว็บไซต์นั้นอาจใช้คุกกี้ในเว็บไซต์ระดับบนสุดทั้งหมด\n\nหรืออาจเป็น URL 2 รายการซึ่งคั่นด้วยเครื่องหมายคอมมา รายการแรกระบุเว็บไซต์ที่ควรได้รับอนุญาตให้ใช้คุกกี้ รายการที่ 2 ระบุเว็บไซต์ระดับบนสุดที่ควรใช้ค่าแรก\n\nหากคุณใช้ URL 2 รายการ ค่าแรกใน URL จาก 2 รายการจะรองรับ * แต่ค่าที่ 2 จะไม่รองรับ การใช้ * สำหรับค่าแรกหมายความว่าเว็บไซต์ทั้งหมดอาจใช้คุกกี้เมื่อ URL ที่ 2 เป็นเว็บไซต์ระดับบนสุด\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะใช้ค่าเริ่มต้นส่วนกลางกับเว็บไซต์ทั้งหมด โดยนำมาจากนโยบาย DefaultCookiesSetting หรือ BlockThirdPartyCookies หากมีการตั้งค่าไว้ มิเช่นนั้น จะนำมาจากการกำหนดค่าส่วนตัวของผู้ใช้\n\nโปรดดูนโยบาย CookiesBlockedForUrls และ CookiesSessionOnlyForUrls ด้วย โปรดทราบว่ารูปแบบ URL ของนโยบายทั้งสามนี้จะต้องไม่ขัดแย้งกัน เพราะไม่มีการระบุว่านโยบายใดจะมีความสำคัญสูงกว่า\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
CookiesBlockedForUrls.pfm_title = "ปิดกั้นคุกกี้บนไซต์เหล่านี้";
CookiesBlockedForUrls.pfm_description = "การตั้งค่านโยบายนี้จะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ตั้งค่าคุกกี้ไม่ได้\n\nการไม่ตั้งค่านโยบายจะทำให้มีการใช้ DefaultCookiesSetting กับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nแม้จะไม่มีนโยบายที่มีความสำคัญเหนือกว่า แต่ให้ดู CookiesAllowedForUrls และ CookiesSessionOnlyForUrls รูปแบบ URL ใน 3 นโยบายนี้ต้องไม่ขัดแย้งกัน\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
CookiesSessionOnlyForUrls.pfm_title = "จำกัดคุกกี้จาก URL ที่ตรงกันให้อยู่ในเซสชันปัจจุบัน";
CookiesSessionOnlyForUrls.pfm_description = "หากไม่ตั้งค่านโยบาย RestoreOnStartup ให้กู้คืน URL จากเซสชันก่อนหน้าโดยถาวร การตั้งค่า CookiesSessionOnlyForUrls ก็จะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่จะตั้งค่าคุกกี้ได้และไม่ได้สำหรับเซสชันหนึ่งๆ\n\nการไม่ตั้งค่านโยบายจะทำให้มีการใช้ DefaultCookiesSetting กับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล URL ที่ไม่ได้อยู่ในรูปแบบที่ระบุไว้ก็จะทำให้ระบบใช้ค่าเริ่มต้นเช่นกัน\n\nแม้จะไม่มีนโยบายที่มีความสำคัญเหนือกว่า แต่ให้ดู CookiesBlockedForUrls และ CookiesAllowedForUrls รูปแบบ URL ใน 3 นโยบายนี้ต้องไม่ขัดแย้งกัน\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
CpuPerformanceTierOverride.pfm_title = "ลบล้างระดับประสิทธิภาพของ CPU";
CpuPerformanceTierOverride.pfm_description = "การตั้งค่านโยบายนี้จะช่วยให้องค์กรลบล้างค่าที่แสดงโดย\nCPU Performance API (เช่น\nnavigator.cpuPerformance,\nโปรดดูรายละเอียดที่ https://github.com/WICG/cpu-performance\n\nหากตั้งค่านโยบายนี้ ระบบจะลบล้างค่าของ\nnavigator.cpuPerformance\nเป็นค่าที่ระบุ หากไม่ได้ตั้งค่านโยบาย ระบบจะใช้การคำนวณระดับประสิทธิภาพเริ่มต้น\n\nค่าที่เป็นไปได้สำหรับนโยบายนี้คือ 0 ถึง 4";
CreatePasskeysInICloudKeychain.pfm_title = "กําหนดว่าการสร้างพาสคีย์จะมีค่าเริ่มต้นเป็นพวงกุญแจ iCloud หรือไม่";
CreatePasskeysInICloudKeychain.pfm_description = "Brave อาจกําหนดเส้นทางคําขอสร้างพาสคีย์/WebAuthn ไปยังพวงกุญแจ iCloud ใน macOS 13.5 ขึ้นไปโดยตรง หากยังไม่ได้เปิดใช้การซิงค์พวงกุญแจ iCloud นโยบายนี้จะแจ้งให้ผู้ใช้ลงชื่อเข้าใช้ด้วย iCloud หรือเปิดใช้การซิงค์พวงกุญแจ iCloud\n\nหากตั้งค่านโยบายนี้เป็น \"เท็จ\" ระบบจะไม่ใช้พวงกุญแจ iCloud โดยค่าเริ่มต้น และอาจใช้ลักษณะการทํางานก่อนหน้า (ของการสร้างข้อมูลเข้าสู่ระบบในโปรไฟล์ Brave) แทน ผู้ใช้จะยังเลือกพวงกุญแจ iCloud เป็นตัวเลือกได้ และอาจเห็นข้อมูลเข้าสู่ระบบพวงกุญแจ iCloud เมื่อลงชื่อเข้าใช้อยู่\n\nหากตั้งค่านโยบายนี้เป็น \"จริง\" พวงกุญแจ iCloud จะเป็นค่าเริ่มต้นเมื่อคําขอ WebAuthn เข้ากันได้กับตัวเลือกนั้น\n\nหากไม่ได้ตั้งค่านโยบายนี้ ค่าเริ่มต้นจะขึ้นอยู่กับปัจจัยต่างๆ เช่น มีการเปิดใช้ iCloud Drive หรือไม่ และผู้ใช้ได้ใช้หรือสร้างข้อมูลเข้าสู่ระบบในโปรไฟล์ Brave เมื่อเร็วๆ นี้หรือไม่";
CreateThemesSettings.pfm_title = "การตั้งค่าสำหรับการสร้างธีมด้วย AI";
CreateThemesSettings.pfm_description = "0 - อนุญาตให้ใช้ฟีเจอร์สร้างธีมด้วย AI และปรับปรุงโมเดล AI\n1 - อนุญาตให้ใช้ฟีเจอร์สร้างธีมด้วย AI โดยไม่ปรับปรุงโมเดล AI\n2 - ไม่อนุญาตให้ใช้ฟีเจอร์สร้างธีมด้วย AI\nฟีเจอร์สร้างธีมด้วย AI ช่วยให้ผู้ใช้สร้างธีม/วอลเปเปอร์ที่กำหนดเองได้โดยการเลือกรายการตัวเลือกไว้ล่วงหน้า\n\n0 = อนุญาตให้ใช้ฟีเจอร์ พร้อมกับอนุญาตให้ Google ใช้ข้อมูลที่เกี่ยวข้องเพื่อปรับปรุงโมเดล AI ข้อมูลที่เกี่ยวข้องอาจรวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร โดยทั้งนี้จะขึ้นอยู่กับฟีเจอร์นั้นๆ รวมถึงเจ้าหน้าที่อาจตรวจสอบข้อมูลดังกล่าวเพื่อปรับปรุงโมเดล AI 0 คือค่าเริ่มต้น เว้นแต่จะระบุไว้ด้านล่าง\n\n1 = อนุญาตให้ใช้ฟีเจอร์ แต่ไม่อนุญาตให้ Google ปรับปรุงโมเดลโดยใช้เนื้อหาของผู้ใช้ (รวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร) 1 คือค่าเริ่มต้นสำหรับผู้ใช้ระดับองค์กรที่จัดการโดย Google Admin console และบัญชี Education ที่จัดการโดย Google Workspace\n\n2 = ไม่อนุญาตให้ใช้ฟีเจอร์\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
DNSInterceptionChecksEnabled.pfm_title = "เปิดใช้การตรวจสอบการสกัดกั้น DNS แล้ว";
DNSInterceptionChecksEnabled.pfm_description = "นโยบายนี้กำหนดค่าการสลับในเครื่องที่จะใช้สำหรับการปิดใช้การตรวจสอบการสกัดกั้น DNS ได้ การตรวจสอบจะพยายามหาว่าเบราว์เซอร์อยู่หลังพร็อกซีที่เปลี่ยนเส้นทางชื่อโฮสต์ที่ไม่รู้จักหรือไม่\n\nการตรวจจับนี้อาจไม่จำเป็นสำหรับสภาพแวดล้อมแบบองค์กรที่รู้ค่ากำหนดของเครือข่าย เพราะการตรวจจับจะก่อให้เกิดปริมาณการจราจรของ DNS และ HTTP ในการเริ่มต้นและในการเปลี่ยนค่ากำหนด DNS แต่ละครั้ง\n\nหากไม่ได้ตั้งค่านโยบายนี้หรือตั้งค่าเป็นเปิดใช้ การตรวจสอบการสกัดกั้น DNS จะทำงาน หากตั้งค่าอย่างชัดแจ้งว่าปิดใช้ การตรวจสอบจะไม่ทำงาน";
DataURLWhitespacePreservationEnabled.pfm_title = "การเก็บช่องว่างใน URL ข้อมูลสำหรับสื่อทุกประเภท";
DataURLWhitespacePreservationEnabled.pfm_description = "นโยบายนี้ช่วยให้สามารถเลือกไม่รับการเปลี่ยนแปลงได้ชั่วคราวสำหรับวิธีที่ Chrome จัดการช่องว่างใน URL dataก่อนหน้านี้ระบบจะเก็บช่องว่างไว้เฉพาะในกรณีที่ประเภทสื่อระดับบนสุดเป็นtextหรือมีสตริงประเภทสื่อ xml\nตอนนี้ระบบจะเก็บช่องว่างใน URL ข้อมูลทั้งหมดไว้โดยไม่คำนึงถึงประเภทสื่อ\n\nหากไม่ได้ตั้งค่านโยบายนี้หรือตั้งค่าเป็น \"จริง\" ระบบจะเปิดใช้ลักษณะการทำงานแบบใหม่\n\nเมื่อตั้งค่านโยบายนี้เป็น \"เท็จ\" ระบบจะเปิดใช้ลักษณะการทำงานแบบเก่า";
DataUrlInSvgUseEnabled.pfm_title = "การรองรับ URL ข้อมูลสำหรับ SVGUseElement";
DataUrlInSvgUseEnabled.pfm_description = "นโยบายนี้เปิดใช้การรองรับ URL ข้อมูลของ SVGUseElement ซึ่งจะปิดใช้โดยค่าเริ่มต้นตั้งแต่ในเวอร์ชัน M119 เป็นต้นไป\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" URL ข้อมูลจะใช้งานได้ต่อไปใน SVGUseElement\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าไว้ URL ข้อมูลจะใช้งานไม่ได้ใน SVGUseElement";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "เปิดใช้ต้นทางที่ไม่เปิดเผยสำหรับ URL ข้อมูลใน Web Worker";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "ควบคุมว่าจะกำหนดต้นทางที่ไม่เปิดเผยและไม่ซ้ำกันให้กับ Web Worker ที่สร้างจาก URL ข้อมูลหรือไม่\n\nWeb Worker สามารถสร้างได้โดยใช้ URL ข้อมูลที่มีสคริปต์ของ Worker ก่อนหน้านี้ Worker เหล่านี้จะรับช่วงต้นทางของหน้าที่สร้างขึ้น ทำให้เข้าถึงพื้นที่เก็บข้อมูลในเครื่อง คุกกี้ และข้อมูลอื่นๆ ที่ผูกกับต้นทางเดียวกันได้ Chrome จะเปลี่ยนลักษณะการทำงานเริ่มต้นในเวอร์ชัน 149 เพื่อปรับปรุงความปลอดภัยและสอดคล้องกับข้อกำหนด HTML เพื่อให้ตอนนี้ Worker ที่สร้างจาก URL ข้อมูลจะมีต้นทางที่ไม่เปิดเผยและไม่ซ้ำกัน ซึ่งจะแยกข้อมูลเหล่านี้ออกจากข้อมูลของหน้าผู้สร้าง\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าไว้ ระบบจะใช้ลักษณะการทำงานเริ่มต้นใหม่ (ปลอดภัยยิ่งขึ้น) และ Web Worker ที่สร้างจาก URL ข้อมูลจะมีต้นทางที่ไม่เปิดเผยและไม่ซ้ำกัน\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" Chrome จะเปลี่ยนกลับไปเป็นลักษณะการทำงานเดิม และ Web Worker ที่สร้างจาก URL ข้อมูลจะรับช่วงต้นทางของผู้สร้าง ซึ่งช่วยให้ผู้ดูแลระบบแก้ปัญหาความเข้ากันได้ชั่วคราวได้หากแอปพลิเคชันภายในขัดข้องเนื่องจากการเปลี่ยนแปลงด้านความปลอดภัย\n\nนโยบายนี้มีไว้เพื่อใช้ชั่วคราวและจะนำออกในเวอร์ชัน 157";
DefaultAutomaticDownloadsSetting.pfm_title = "การตั้งค่าการดาวน์โหลดอัตโนมัติเริ่มต้น";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - อนุญาตให้ไซต์ดาวน์โหลดไฟล์หลายๆ ไฟล์โดยอัตโนมัติ\n2 - ไม่อนุญาตให้ไซต์ใดๆ ทำการดาวน์โหลดไฟล์หลายๆ ไฟล์โดยอัตโนมัติ\n3 - ถามทุกครั้งที่เว็บไซต์ต้องการดาวน์โหลดไฟล์หลายไฟล์โดยอัตโนมัติ\nการตั้งค่านโยบายเป็น 1 จะทำให้เว็บไซต์ดาวน์โหลดไฟล์หลายไฟล์โดยอัตโนมัติได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธสิทธิ์นี้ คุณตั้งค่านโยบายนี้ได้เพื่อถามทุกครั้งที่เว็บไซต์ต้องการดาวน์โหลดไฟล์หลายไฟล์โดยอัตโนมัติ\n\nการไม่ตั้งค่านโยบายนี้หมายความว่านโยบาย AskAutomaticDownloads จะมีผล แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "ตั้ง Brave เป็นเบราว์เซอร์เริ่มต้น";
DefaultBrowserSettingEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" กำหนดให้ Brave ตรวจสอบเสมอว่าเป็นเบราว์เซอร์เริ่มต้นหรือไม่เมื่อเริ่มต้นใช้งาน และลงทะเบียนตัวเองโดยอัตโนมัติหากเป็นไปได้ การตั้งค่านโยบายเป็น \"เท็จ\" จะหยุด Brave ไม่ให้ตรวจสอบว่าเป็นเบราว์เซอร์เริ่มต้นหรือไม่ และปิดการควบคุมโดยผู้ใช้สำหรับตัวเลือกนี้\n\nการไม่ตั้งค่านโยบายนี้หมายความว่า Brave ให้ผู้ใช้ควบคุมว่าจะให้เป็นเบราว์เซอร์เริ่มต้นหรือไม่ และควรแสดงการแจ้งเตือนผู้ใช้หรือไม่หากไม่ใช่เบราว์เซอร์เริ่มต้น\n\nโปรดทราบว่าสำหรับผู้ดูแลระบบ Microsoft®Windows® การเปิดการตั้งค่านี้จะใช้ได้กับเครื่องที่ใช้ Windows 7 เท่านั้น ส่วนเวอร์ชันที่ใหม่กว่า คุณต้องใช้ไฟล์ \"การเชื่อมโยงแอปพลิเคชันเริ่มต้น\" ที่ทำให้ Brave เป็นเครื่องจัดการโปรโตคอล https และ http (อาจรวมถึงโปรโตคอล ftp และรูปแบบไฟล์อื่นๆ ด้วยก็ได้) ความช่วยเหลือของ Chrome ( https://support.google.com/chrome?p=make_chrome_default_win )";
DefaultClipboardSetting.pfm_title = "การตั้งค่าคลิปบอร์ดเริ่มต้น";
DefaultClipboardSetting.pfm_description = "2 - ไม่อนุญาตให้เว็บไซต์ใช้สิทธิ์เข้าถึงคลิปบอร์ด\n3 - อนุญาตให้เว็บไซต์ขอให้ผู้ใช้ให้สิทธิ์เข้าถึงคลิปบอร์ด\nการตั้งค่านโยบายเป็น 2 จะบล็อกเว็บไซต์ไม่ให้ใช้สิทธิ์เข้าถึงคลิปบอร์ด การตั้งค่านโยบายเป็น 3 หรือไม่ตั้งค่าจะทำให้ผู้ใช้สามารถเปลี่ยนการตั้งค่าและเลือกว่า API ของคลิปบอร์ดจะพร้อมให้เว็บไซต์ใช้งานเมื่อต้องการหรือไม่\n\nนโยบายนี้ถูกลบล้างสำหรับ URL บางรูปแบบได้โดยใช้นโยบาย ClipboardAllowedForUrls และ ClipboardBlockedForUrls\n\nนโยบายนี้มีผลเฉพาะกับการดำเนินการเกี่ยวกับคลิปบอร์ดซึ่งควบคุมโดยสิทธิ์เข้าถึงคลิปบอร์ดสำหรับเว็บไซต์ และไม่มีผลกับการเขียนคลิปบอร์ดที่มีการปรับแต่งหรือการคัดลอกและวางที่เชื่อถือได้";
DefaultCookiesSetting.pfm_title = "การตั้งค่าคุกกี้เริ่มต้น";
DefaultCookiesSetting.pfm_description = "1 - อนุญาตให้ทุกไซต์ตั้งค่าข้อมูลภายในเครื่อง\n2 - ไม่อนุญาตให้ไซต์ใดๆ ตั้งค่าข้อมูลในตัวเครื่อง\n4 - เก็บคุกกี้ไว้ในระหว่างช่วงเวลาของเซสชัน\nหากไม่ตั้งค่านโยบาย RestoreOnStartup ให้กู้คืน URL จากเซสชันก่อนหน้าโดยถาวร การตั้งค่า CookiesSessionOnlyForUrls ก็จะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่จะตั้งค่าคุกกี้ได้และไม่ได้สำหรับเซสชันหนึ่งๆ\n\nการไม่ตั้งค่านโยบายจะทำให้มีการใช้ DefaultCookiesSetting กับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล URL ที่ไม่ได้อยู่ในรูปแบบที่ระบุไว้ก็จะทำให้ระบบใช้ค่าเริ่มต้นเช่นกัน\n\nแม้จะไม่มีนโยบายที่มีความสำคัญเหนือกว่า แต่ให้ดู CookiesBlockedForUrls และ CookiesAllowedForUrls รูปแบบ URL ใน 3 นโยบายนี้ต้องไม่ขัดแย้งกัน";
DefaultDownloadDirectory.pfm_title = "ตั้งค่าไดเรกทอรีเริ่มต้นสำหรับดาวน์โหลด";
DefaultDownloadDirectory.pfm_description = "การตั้งค่านโยบายนี้จะเปลี่ยนไดเรกทอรีเริ่มต้นที่ Chrome จะใช้สำหรับการดาวน์โหลดไฟล์ แต่ผู้ใช้จะเปลี่ยนไดเรกทอรีได้\n\nการไม่ตั้งค่านโยบายหมายความว่า Chrome จะใช้ไดเรกทอรีเริ่มต้นของแพลตฟอร์มนั้นๆ\n\nนโยบายนี้จะไม่มีผลหากตั้งค่านโยบาย DownloadDirectory\n\nหมายเหตุ: ดูรายการตัวแปรที่คุณใช้ได้ (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables)";
DefaultFileSystemReadGuardSetting.pfm_title = "ควบคุมการใช้ File System API สำหรับการอ่าน";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - ไม่อนุญาตให้เว็บไซต์ใดๆ ขอสิทธิ์การเข้าถึงในการอ่านไฟล์และไดเรกทอรีผ่าน File System API\n3 - อนุญาตให้เว็บไซต์ขอให้ผู้ใช้ให้สิทธิ์การเข้าถึงในการอ่านไฟล์และไดเรกทอรีผ่าน File System API\nการตั้งค่านโยบายเป็น 3 จะให้เว็บไซต์ขอสิทธิ์การเข้าถึงในการอ่านไฟล์และไดเรกทอรีในระบบไฟล์ของระบบปฏิบัติการของโฮสต์ผ่าน File System API การตั้งค่านโยบายเป็น 2 จะปฏิเสธการเข้าถึง\n\nการไม่ตั้งค่าจะให้เว็บไซต์ขอสิทธิ์เข้าถึงได้ แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultFileSystemWriteGuardSetting.pfm_title = "ควบคุมการใช้ File System API สำหรับการเขียน";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - ไม่อนุญาตให้เว็บไซต์ใดๆ ขอสิทธิ์การเข้าถึงในการเขียนไฟล์และไดเรกทอรี\n3 - อนุญาตให้เว็บไซต์ขอให้ผู้ใช้ให้สิทธิ์การเข้าถึงในการเขียนไฟล์และไดเรกทอรี\nการตั้งค่านโยบายเป็น 3 จะให้เว็บไซต์ขอสิทธิ์การเข้าถึงในการเขียนไฟล์และไดเรกทอรีในระบบไฟล์ของระบบปฏิบัติการของโฮสต์ การตั้งค่านโยบายเป็น 2 จะปฏิเสธการเข้าถึง\n\nการไม่ตั้งค่าจะให้เว็บไซต์ขอสิทธิ์เข้าถึงได้ แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultGeolocationSetting.pfm_title = "การตั้งค่าตำแหน่งทางภูมิศาสตร์เริ่มต้น";
DefaultGeolocationSetting.pfm_description = "1 - อนุญาตให้ไซต์ติดตามตำแหน่งทางกายภาพของผู้ใช้\n2 - ไม่อนุญาตให้ไซต์ใดๆ ติดตามตำแหน่งทางกายภาพของผู้ใช้\n3 - ถามเมื่อไซต์ต้องการติดตามตำแหน่งทางกายภาพของผู้ใช้\nการตั้งค่านโยบายเป็น 1 จะให้เว็บไซต์ติดตามสถานที่ตั้งจริงของผู้ใช้เป็นสถานะเริ่มต้นได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธการติดตามนี้โดยค่าเริ่มต้น คุณตั้งค่านี้ได้เพื่อถามทุกครั้งที่เว็บไซต์ต้องการติดตามสถานที่ตั้งจริงของผู้ใช้\n\nการไม่ตั้งค่านโยบายนี้หมายความว่านโยบาย AskGeolocation จะมีผล แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultIdleDetectionSetting.pfm_title = "การตรวจจับเมื่อไม่ใช้งาน";
DefaultIdleDetectionSetting.pfm_description = "1 - อนุญาตให้เว็บไซต์ตรวจจับสถานะไม่ได้ใช้งานโดยไม่ต้องขอผู้ใช้\n2 - ไม่อนุญาตให้เว็บไซต์ใดๆ ตรวจหาสถานะที่ไม่ได้ใช้งานของผู้ใช้\n3 - ถามทุกครั้งที่เว็บไซต์ต้องการตรวจจับสถานะที่ไม่ได้ใช้งานของผู้ใช้\nช่วยให้คุณกำหนดว่าเว็บไซต์จะได้รับอนุญาตให้ใช้ Idle Detection API หรือไม่\n\nเมื่อตั้งค่านโยบายนี้เป็น 1 - AllowIdleDetection เว็บไซต์จะใช้ API ได้โดยไม่ต้องขอสิทธิ์จากผู้ใช้\n\nเมื่อตั้งค่านโยบายนี้เป็น 2 - BlockIdleDetection เว็บไซต์จะใช้ API ไม่ได้ ไม่ว่าผู้ใช้จะมีสิทธิ์หรือไม่ก็ตาม\n\nเมื่อตั้งค่านโยบายนี้เป็น 3 - AskIdleDetection หรือไม่ได้ตั้งค่า เว็บไซต์จะใช้ API ไม่ได้หากไม่ได้รับอนุญาตจากผู้ใช้";
DefaultImagesSetting.pfm_title = "การตั้งค่าภาพเริ่มต้น";
DefaultImagesSetting.pfm_description = "1 - อนุญาตให้ไซต์ทั้งหมดแสดงภาพทั้งหมด\n2 - ไม่อนุญาตให้ไซต์ใดแสดงภาพ\nการตั้งค่านโยบายเป็น 1 จะให้ทุกเว็บไซต์แสดงรูปภาพได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธไม่ให้แสดงรูปภาพ\n\nการไม่ตั้งค่าจะอนุญาตให้แสดงรูปภาพ แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultInsecureContentSetting.pfm_title = "ควบคุมการใช้ข้อยกเว้นเนื้อหาที่ไม่ปลอดภัย";
DefaultInsecureContentSetting.pfm_description = "2 - ไม่อนุญาตให้เว็บไซต์ใดๆ โหลดเนื้อหาผสม\n3 - อนุญาตให้ผู้ใช้เพิ่มข้อยกเว้นเพื่ออนุญาตให้แสดงเนื้อหาผสม\nช่วยให้คุณกำหนดได้ว่าจะให้ผู้ใช้เพิ่มข้อยกเว้นเพื่ออนุญาตเนื้อหาผสมในเว็บไซต์ที่เจาะจงได้หรือไม่\n\nนโยบายนี้จะถูกลบล้างสำหรับรูปแบบ URL ที่เจาะจงได้โดยใช้นโยบาย \"InsecureContentAllowedForUrls\" และ \"InsecureContentBlockedForUrls\"\n\nหากไม่ได้ตั้งค่านโยบายนี้ไว้ ผู้ใช้จะสามารถเพิ่มข้อยกเว้นเพื่ออนุญาตเนื้อหาผสมที่บล็อกได้และปิดใช้การอัปเกรดอัตโนมัติสำหรับเนื้อหาผสมที่เลือกบล็อกได้";
DefaultJavaScriptJitSetting.pfm_title = "ควบคุมการใช้ JIT ใน JavaScript";
DefaultJavaScriptJitSetting.pfm_description = "1 - อนุญาตให้เว็บไซต์เรียกใช้ JIT ใน JavaScript\n2 - ไม่อนุญาตให้เว็บไซต์เรียกใช้ JIT ใน JavaScript\nให้คุณกำหนดว่า Brave จะเรียกใช้เครื่องมือ V8 JavaScript ที่เปิดใช้คอมไพเลอร์ JIT (Just In Time) หรือไม่\n\nการปิดใช้ JIT ใน JavaScript อาจทำให้ Brave แสดงเนื้อหาเว็บช้าลงและปิดใช้ส่วนต่างๆ ของ JavaScript รวมถึง WebAssembly การปิดใช้ JIT ใน JavaScript อาจช่วยให้ Brave แสดงเนื้อหาเว็บในการกำหนดค่าที่ปลอดภัยขึ้น\n\nนโยบายนี้จะถูกลบล้างสำหรับรูปแบบ URL ที่เจาะจงได้โดยใช้นโยบาย JavaScriptJitAllowedForSites และ JavaScriptJitBlockedForSites\n\nหากไม่ได้ตั้งค่านโยบายนี้ จะมีการเปิดใช้ JIT ใน JavaScript";
DefaultJavaScriptOptimizerSetting.pfm_title = "ควบคุมการใช้เครื่องมือเพิ่มประสิทธิภาพ JavaScript";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - เปิดใช้การเพิ่มประสิทธิภาพ JavaScript ขั้นสูงในทุกเว็บไซต์\n2 - ปิดใช้การเพิ่มประสิทธิภาพ JavaScript ขั้นสูงในทุกเว็บไซต์\nอนุญาตให้คุณกำหนดว่า Brave จะเรียกใช้เครื่องมือ V8 JavaScript ที่เปิดใช้การเพิ่มประสิทธิภาพ JavaScript ขั้นสูงขึ้นหรือไม่\n\nการปิดใช้การเพิ่มประสิทธิภาพ JavaScript (โดยการกำหนดให้ค่าของนโยบายนี้เป็น 2) จะทำให้ Brave แสดงเนื้อหาเว็บช้าลง\n\nนโยบายนี้ถูกลบล้างสำหรับ URL บางรูปแบบได้โดยใช้นโยบาย JavaScriptOptimizerAllowedForSites และ JavaScriptOptimizerBlockedForSites\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะเปิดใช้การเพิ่มประสิทธิภาพ JavaScript";
DefaultJavaScriptSetting.pfm_title = "การตั้งค่า JavaScript เริ่มต้น";
DefaultJavaScriptSetting.pfm_description = "1 - อนุญาตให้ไซต์ทั้งหมดเรียกใช้ JavaScript\n2 - ไม่อนุญาตให้ไซต์ใดๆ เรียกใช้ JavaScript\nการตั้งค่านโยบายเป็น 1 จะให้เว็บไซต์เรียกใช้ JavaScript ได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธไม่ให้เรียกใช้ JavaScript\n\nการไม่ตั้งค่าจะอนุญาตให้เรียกใช้ JavaScript แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultLocalFontsSetting.pfm_title = "การตั้งค่าเริ่มต้นของสิทธิ์สำหรับแบบอักษรในเครื่อง";
DefaultLocalFontsSetting.pfm_description = "2 - ปฏิเสธการให้สิทธิ์สำหรับแบบอักษรในเครื่องในทุกเว็บไซต์โดยค่าเริ่มต้น\n3 - ถามทุกครั้งที่เว็บไซต์ต้องการได้รับสิทธิ์สำหรับแบบอักษรในเครื่อง\nการตั้งค่านโยบายเป็น BlockLocalFonts (ค่า 2) จะปฏิเสธการให้สิทธิ์สำหรับแบบอักษรในเครื่องแก่เว็บไซต์โดยอัตโนมัติตามค่าเริ่มต้น การดำเนินการนี้จะจำกัดไม่ให้เว็บไซต์ดูข้อมูลเกี่ยวกับแบบอักษรในเครื่องได้\n\nการตั้งค่านโยบายเป็น AskLocalFonts (ค่า 3) จะแสดงข้อความแจ้งผู้ใช้เมื่อขอสิทธิ์สำหรับแบบอักษรในเครื่องโดยค่าเริ่มต้น หากผู้ใช้อนุญาตสิทธิ์ดังกล่าว เว็บไซต์จะดูข้อมูลเกี่ยวกับแบบอักษรในเครื่องได้\n\nหากไม่ได้ตั้งค่านโยบาย ระบบจะใช้ลักษณะการทำงานเริ่มต้น ซึ่งก็คือการแสดงข้อความแจ้งผู้ใช้ แต่ผู้ใช้สามารถเปลี่ยนการตั้งค่านี้ได้";
DefaultNotificationsSetting.pfm_title = "การตั้งค่าการแจ้งเตือนเริ่มต้น";
DefaultNotificationsSetting.pfm_description = "1 - อนุญาตให้ไซต์แสดงการแจ้งเตือนของเดสก์ท็อป\n2 - ไม่อนุญาตให้ไซต์ใดๆ แสดงการแจ้งเตือนของเดสก์ท็อป\n3 - ถามทุกครั้งที่ไซต์ต้องการแสดงการแจ้งเตือนของเดสก์ท็อป\nการตั้งค่านโยบายเป็น 1 จะให้เว็บไซต์แสดงการแจ้งเตือนในเดสก์ท็อปได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธการแจ้งเตือนในเดสก์ท็อป\n\nการไม่ตั้งค่าหมายความว่า AskNotifications จะมีผล แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultPopupsSetting.pfm_title = "การตั้งค่าป๊อปอัปเริ่มต้น";
DefaultPopupsSetting.pfm_description = "1 - อนุญาตให้ไซต์ทั้งหมดแสดงป๊อปอัป\n2 - ไม่อนุญาตให้เว็บไซต์ใดๆ แสดงป๊อปอัป\nการตั้งค่านโยบายเป็น 1 จะให้เว็บไซต์แสดงป๊อปอัปได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธป๊อปอัป\n\nการไม่ตั้งค่าหมายความว่า BlockPopups จะมีผล แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultPrinterSelection.pfm_title = "กฎการเลือกเครื่องพิมพ์เริ่มต้น";
DefaultPrinterSelection.pfm_description = "การตั้งค่านโยบายนี้จะตั้งค่ากฎในการเลือกเครื่องพิมพ์เริ่มต้นใน Brave โดยจะลบล้างกฎเริ่มต้น การเลือกเครื่องพิมพ์เกิดขึ้นในครั้งแรกที่ผู้ใช้พยายามจะสั่งพิมพ์ เมื่อ Brave หาเครื่องพิมพ์ที่ตรงกับแอตทริบิวต์ที่ระบุ ในกรณีที่การจับคู่ไม่สมบูรณ์แบบ จะตั้งค่า Brave ให้เลือกเครื่องพิมพ์ที่ตรงกันเครื่องใดก็ได้โดยขึ้นอยู่กับลำดับในการค้นพบเครื่องพิมพ์\n\nหากไม่ตั้งค่านโยบายหรือตั้งค่าเป็นแอตทริบิวต์ที่จับคู่ไม่ได้ เครื่องพิมพ์ PDF ในตัวจะเป็นค่าเริ่มต้น หากไม่มีเครื่องพิมพ์ PDF ค่าเริ่มต้นของ Brave จะเป็น \"ไม่มี\"\n\nตอนนี้เครื่องพิมพ์ทั้งหมดจัดเป็นประเภท \"local\" เครื่องพิมพ์ที่เชื่อมต่อกับ Google Cloud Print จะถือว่าเป็น \"cloud\" แต่ระบบไม่รองรับ Google Cloud Print แล้ว\n\nหมายเหตุ: การข้ามช่องใดช่องหนึ่งไปแสดงว่าค่าทั้งหมดตรงกับช่องนั้นๆ เช่น การไม่ระบุ idPattern หมายความว่าการแสดงตัวอย่างก่อนพิมพ์จะยอมรับรหัสเครื่องพิมพ์ทั้งหมด รูปแบบนิพจน์ทั่วไปต้องเป็นไปตามไวยากรณ์ JavaScript RegExp และการจับคู่จะคำนึงถึงตัวอักษรพิมพ์เล็กและใหญ่\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection";
DefaultSearchProviderAlternateURLs.pfm_title = "รายการ URL สำรองของผู้ให้บริการค้นหาเริ่มต้น";
DefaultSearchProviderAlternateURLs.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderAlternateURLs จะระบุรายการ URL ทางเลือกสำหรับการแยกข้อความค้นหาออกจากเครื่องมือค้นหา URL ดังกล่าวควรมีสตริง '{searchTerms}'\n\nการไม่ตั้งค่า DefaultSearchProviderAlternateURLs จะทำให้ไม่มีการใช้ URL ทางเลือกเพื่อแยกข้อความค้นหา";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "อนุญาตการเข้าถึงการค้นหาเมนูตามบริบทของผู้ให้บริการการค้นหาเริ่มต้น";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "เปิดใช้การใช้ผู้ให้บริการการค้นหาเริ่มต้นในเมนูตามบริบท\n\nหากตั้งค่านโยบายนี้เป็นปิดใช้ การค้นหารายการในเมนูตามบริบทที่ต้องใช้ผู้ให้บริการการค้นหาเริ่มต้นของคุณจะใช้งานไม่ได้\n\nหากตั้งค่านโยบายนี้เป็นเปิดใช้หรือไม่ได้ตั้งค่า รายการในเมนูตามบริบทสำหรับผู้ให้บริการการค้นหาเริ่มต้นจะใช้งานได้\n\nระบบจะใช้ค่านโยบายเมื่อเปิดใช้นโยบาย DefaultSearchProviderEnabled เท่านั้น และจะไม่มีผลหากไม่เปิดใช้";
DefaultSearchProviderEnabled.pfm_title = "เปิดใช้งานผู้ให้บริการการค้นหาเริ่มต้น";
DefaultSearchProviderEnabled.pfm_description = "หากตั้งค่านโยบายเป็น \"เปิดใช้\" ระบบจะทำการค้นหาที่เป็นค่าเริ่มต้นเมื่อผู้ใช้ป้อนข้อความที่ไม่ใช่ URL ในแถบที่อยู่ หากต้องการระบุผู้ให้บริการค้นหาที่เป็นค่าเริ่มต้น ให้ตั้งค่าส่วนที่เหลือของนโยบายการค้นหาเริ่มต้น หากปล่อยนโยบายเหล่านี้ว่างไว้ ผู้ใช้จะเลือกผู้ให้บริการเริ่มต้นได้ หากตั้งค่านโยบายเป็น \"ปิดใช้\" จะไม่มีการค้นหาเมื่อผู้ใช้ป้อนข้อความที่ไม่ใช่ URL ในแถบที่อยู่ Google Admin console ไม่รองรับค่า \"ปิดใช้\"\n\nหากคุณตั้งค่านโยบายไว้ ผู้ใช้จะเปลี่ยนการตั้งค่าดังกล่าวใน Brave ไม่ได้ หากไม่ได้ตั้งค่าไว้ ระบบจะเปิดใช้ผู้ให้บริการค้นหาเริ่มต้น และผู้ใช้จะกำหนดรายการผู้ให้บริการค้นหาได้\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
DefaultSearchProviderEncodings.pfm_title = "การเข้ารหัสของผู้ให้บริการการค้นหาเริ่มต้น";
DefaultSearchProviderEncodings.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderEncodings จะระบุการเข้ารหัสอักขระที่ผู้ให้บริการค้นหารองรับ การเข้ารหัสคือชื่อ Code Page เช่น UTF-8, GB2312 และ ISO-8859-1 โดยจะมีการใช้งานตามลำดับที่ระบุ\n\nการไม่ตั้งค่า DefaultSearchProviderEncodings จะทำให้ระบบใช้งาน UTF-8";
DefaultSearchProviderImageURL.pfm_title = "พารามิเตอร์ที่ให้ฟีเจอร์การค้นหาโดยภาพสำหรับผู้ให้บริการการค้นหาเริ่มต้น";
DefaultSearchProviderImageURL.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderImageURL จะระบุ URL ของเครื่องมือค้นหาที่ใช้ในการค้นหารูปภาพ (หากตั้งค่า DefaultSearchProviderImageURLPostParams ไว้ คำขอค้นหารูปภาพจะใช้เมธอด POST แทน)\n\nหากไม่ตั้งค่า DefaultSearchProviderImageURL จะไม่มีการใช้การค้นหารูปภาพ\n\nหากการค้นหารูปภาพใช้เมธอด GET แล้ว URL ต้องระบุพารามิเตอร์รูปภาพโดยใช้ชุดค่าผสมที่ใช้ได้ของตัวยึดตำแหน่งต่อไปนี้\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'";
DefaultSearchProviderImageURLPostParams.pfm_title = "พารามิเตอร์สำหรับ URL รูปภาพที่ใช้ POST";
DefaultSearchProviderImageURLPostParams.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderImageURLPostParams จะระบุพารามิเตอร์ระหว่างการค้นหารูปภาพด้วยเมธอด POST โดยจะประกอบด้วยคู่ของ \"ชื่อ-ค่า\" ที่คั่นด้วยคอมมา หากมีค่าใดเป็นพารามิเตอร์เทมเพลต เช่น {imageThumbnail} ข้อมูลภาพขนาดย่อของรูปภาพจริงจะแทนที่ค่าดังกล่าว\n\nการไม่ตั้งค่า DefaultSearchProviderImageURLPostParams จะทำให้ระบบส่งคำขอการค้นหารูปภาพโดยใช้เมธอด GET\n\nURL ต้องระบุพารามิเตอร์รูปภาพโดยใช้ชุดค่าผสมที่ใช้ได้ของตัวยึดตำแหน่งต่อไปนี้โดยขึ้นอยู่กับสิ่งที่ผู้ให้บริการค้นหารองรับ\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'";
DefaultSearchProviderKeyword.pfm_title = "คีย์เวิร์ดของผู้ให้บริการการค้นหาเริ่มต้น";
DefaultSearchProviderKeyword.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderKeyword จะระบุคีย์เวิร์ดหรือทางลัดที่ใช้ในแถบที่อยู่เพื่อทริกเกอร์การค้นหาสำหรับผู้ให้บริการรายนี้\n\nหากไม่ตั้งค่า DefaultSearchProviderKeyword จะไม่มีคีย์เวิร์ดใดเลยที่เปิดใช้งานผู้ให้บริการค้นหาดังกล่าว";
DefaultSearchProviderName.pfm_title = "ชื่อผู้ให้บริการการค้นหาเริ่มต้น";
DefaultSearchProviderName.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderName จะระบุชื่อของผู้ให้บริการค้นหาเริ่มต้น\n\nหากไม่ได้ตั้งค่า DefaultSearchProviderName ไว้ ระบบจะใช้ชื่อโฮสต์ที่ URL การค้นหาระบุ";
DefaultSearchProviderNewTabURL.pfm_title = "URL หน้าแท็บใหม่ของผู้ให้บริการการค้นหาเริ่มต้น";
DefaultSearchProviderNewTabURL.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderNewTabURL จะระบุ URL ของเครื่องมือค้นหาที่ใช้เพื่อจัดเตรียมหน้าแท็บใหม่\n\nการไม่ตั้งค่า DefaultSearchProviderNewTabURL จะทำให้ไม่มีการจัดเตรียมหน้าแท็บใหม่";
DefaultSearchProviderSearchURL.pfm_title = "URL การค้นหาของผู้ให้บริการการค้นหาเริ่มต้น";
DefaultSearchProviderSearchURL.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderSearchURL จะระบุ URL ของเครื่องมือค้นหาที่ใช้ระหว่างการค้นหาที่เป็นค่าเริ่มต้น URL ดังกล่าวควรมีสตริง '{searchTerms}' ซึ่งข้อความค้นหาของผู้ใช้จะมาแทนที่ในการค้นหา\n\nคุณระบุ URL การค้นหาของ Google เป็น '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}' ได้";
DefaultSearchProviderSearchURLPostParams.pfm_title = "พารามิเตอร์สำหรับ URL ค้นหาที่ใช้ POST";
DefaultSearchProviderSearchURLPostParams.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderSearchURLPostParams จะระบุพารามิเตอร์เมื่อค้นหา URL ด้วยเมธอด POST โดยจะประกอบด้วยคู่ชื่อ-ค่าที่คั่นด้วยจุลภาค หากมีค่าใดเป็นพารามิเตอร์เทมเพลต เช่น '{searchTerms}' ข้อมูลข้อความค้นหาจริงจะแทนที่ค่าดังกล่าว\n\nการไม่ตั้งค่า DefaultSearchProviderSearchURLPostParams จะทำให้ระบบส่งคำขอค้นหาโดยใช้เมธอด GET";
DefaultSearchProviderSuggestURL.pfm_title = "URL ที่แนะนำโดยผู้ให้บริการการค้นหาเริ่มต้น";
DefaultSearchProviderSuggestURL.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderSuggestURL จะระบุ URL ของเครื่องมือค้นหาเพื่อจัดเตรียมการแนะนำการค้นหา URL ดังกล่าวควรมีสตริง '{searchTerms}' ซึ่งข้อความค้นหาของผู้ใช้จะมาแทนที่ในการค้นหา\n\nคุณระบุ URL การค้นหาของ Google เป็น '{google:baseURL}complete/search?output=chrome&q={searchTerms}' ได้";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "พารามิเตอร์สำหรับการแนะนำ URL ที่ใช้ POST";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "หาก DefaultSearchProviderEnabled เปิดอยู่ การตั้งค่า DefaultSearchProviderSuggestURLPostParams จะระบุพารามิเตอร์ระหว่างการค้นหาที่แนะนำด้วยเมธอด POST โดยจะประกอบด้วยคู่ชื่อ-ค่าที่คั่นด้วยจุลภาค หากมีค่าใดเป็นพารามิเตอร์เทมเพลต เช่น '{searchTerms}' ข้อมูลข้อความค้นหาจริงจะแทนที่ค่าดังกล่าว\n\nการไม่ตั้งค่า DefaultSearchProviderSuggestURLPostParams จะทำให้ระบบส่งคำขอการค้นหาที่แนะนำโดยใช้เมธอด GET";
DefaultSensorsSetting.pfm_title = "การตั้งค่าเซ็นเซอร์เริ่มต้น";
DefaultSensorsSetting.pfm_description = "1 - อนุญาตให้เว็บไซต์เข้าถึงเซ็นเซอร์\n2 - ไม่อนุญาตให้เว็บไซต์ใดๆ เข้าถึงเซ็นเซอร์\n3 - ถามทุกครั้งที่เว็บไซต์ต้องการเข้าถึงเซ็นเซอร์\nการตั้งค่านโยบายเป็น 1 จะให้เว็บไซต์เข้าถึงและใช้เซ็นเซอร์ เช่น เซ็นเซอร์ตรวจจับการเคลื่อนไหวและเซ็นเซอร์แสงได้ การตั้งค่านโยบายเป็น 2 จะทำให้ระบบปฏิเสธการเข้าถึงเซ็นเซอร์ เมื่อตั้งค่านโยบายเป็น 3 ระบบจะถามผู้ใช้เมื่อเว็บไซต์ขอเข้าถึงเซ็นเซอร์ หากเปิดใช้แฟล็กฟีเจอร์แบบ 3 สถานะ มิเช่นนั้น ระบบจะอนุญาตให้เข้าถึงเซ็นเซอร์โดยค่าเริ่มต้น\n\nการไม่ตั้งค่าหมายความว่า AllowSensors จะมีผล แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultSerialGuardSetting.pfm_title = "ควบคุมการใช้ Serial API";
DefaultSerialGuardSetting.pfm_description = "2 - ไม่อนุญาตให้เว็บไซต์ใดๆ ขอสิทธิ์เข้าถึงพอร์ตอนุกรมผ่าน Serial API\n3 - อนุญาตให้เว็บไซต์ขอให้ผู้ใช้ให้สิทธิ์เข้าถึงพอร์ตอนุกรม\nการตั้งค่านโยบายเป็น 3 จะให้เว็บไซต์ขอสิทธิ์เข้าถึงพอร์ตอนุกรมได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธสิทธิ์เข้าถึงพอร์ตอนุกรม\n\nการไม่ตั้งค่าจะให้เว็บไซต์ขอสิทธิ์เข้าถึงได้ แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultWebBluetoothGuardSetting.pfm_title = "ควบคุมการใช้ Web Bluetooth API";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - ไม่อนุญาตให้เว็บไซต์ใดๆ ขอสิทธิ์เข้าถึงอุปกรณ์บลูทูธผ่าน Web Bluetooth API\n3 - อนุญาตให้เว็บไซต์ขอสิทธิ์เข้าถึงอุปกรณ์บลูทูธที่อยู่ใกล้เคียงจากผู้ใช้\nการตั้งค่านโยบายเป็น 3 จะให้เว็บไซต์ขอสิทธิ์เข้าถึงอุปกรณ์บลูทูธใกล้เคียงได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธสิทธิ์เข้าถึงอุปกรณ์บลูทูธใกล้เคียง\n\nการไม่ตั้งค่านโยบายจะให้เว็บไซต์ขอสิทธิ์เข้าถึงได้ แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultWebHidGuardSetting.pfm_title = "ควบคุมการใช้ WebHID API";
DefaultWebHidGuardSetting.pfm_description = "2 - ไม่อนุญาตให้เว็บไซต์ใดๆ ขอสิทธิ์เข้าถึงอุปกรณ์ HID ผ่าน WebHID API\n3 - อนุญาตให้เว็บไซต์ขอให้ผู้ใช้ให้สิทธิ์เข้าถึงอุปกรณ์ HID\nการตั้งค่านโยบายเป็น 3 จะให้เว็บไซต์ขอสิทธิ์เข้าถึงอุปกรณ์ HID ได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธการเข้าถึงอุปกรณ์ HID\n\nการไม่ตั้งค่าจะให้เว็บไซต์ขอสิทธิ์เข้าถึงได้ แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้\n\nนโยบายนี้จะถูกลบล้างสำหรับรูปแบบ url ที่เจาะจงได้โดยใช้นโยบาย WebHidAskForUrls และ WebHidBlockedForUrls";
DefaultWebUsbGuardSetting.pfm_title = "ควบคุมการใช้ WebUSB API";
DefaultWebUsbGuardSetting.pfm_description = "2 - ไม่อนุญาตให้เว็บไซต์ขอสิทธิ์เข้าถึงอุปกรณ์ USB ผ่าน WebUSB API\n3 - อนุญาตให้เว็บไซต์ขอสิทธิ์จากผู้ใช้เพื่อเข้าถึงอุปกรณ์ USB ที่เชื่อมต่ออยู่\nการตั้งค่านโยบายเป็น 3 จะให้เว็บไซต์ขอสิทธิ์เข้าถึงอุปกรณ์ USB ที่เชื่อมต่อได้ การตั้งค่านโยบายเป็น 2 จะปฏิเสธสิทธิ์เข้าถึงอุปกรณ์ USB ที่เชื่อมต่อ\n\nการไม่ตั้งค่าจะให้เว็บไซต์ขอสิทธิ์เข้าถึงได้ แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
DefaultWindowManagementSetting.pfm_title = "การตั้งค่าเริ่มต้นของสิทธิ์การจัดการหน้าต่าง";
DefaultWindowManagementSetting.pfm_description = "2 - ปฏิเสธสิทธิ์การจัดการหน้าต่างในทุกเว็บไซต์โดยค่าเริ่มต้น\n3 - ถามทุกครั้งที่เว็บไซต์ต้องการได้รับสิทธิ์การจัดการหน้าต่าง\nการตั้งค่านโยบายเป็น BlockWindowManagement (ค่า 2) จะปฏิเสธสิทธิ์การจัดการหน้าต่างของเว็บไซต์โดยค่าเริ่มต้นโดยอัตโนมัติ การดำเนินการนี้จะจำกัดไม่ให้เว็บไซต์ดูข้อมูลเกี่ยวกับหน้าจอของอุปกรณ์เพื่อใช้ข้อมูลนั้นในการเปิดและวางหน้าต่างหรือขอโหมดเต็มหน้าจอในบางหน้าจอ\n\nการตั้งค่านโยบายเป็น AskWindowManagement (ค่า 3) จะแสดงข้อความแจ้งผู้ใช้เมื่อขอสิทธิ์การจัดการหน้าต่างโดยค่าเริ่มต้น หากผู้ใช้อนุญาตสิทธิ์ดังกล่าว เว็บไซต์จะสามารถดูข้อมูลเกี่ยวกับหน้าจอของอุปกรณ์แล้วใช้ข้อมูลนั้นในการเปิดและวางหน้าต่างหรือขอโหมดเต็มหน้าจอในบางหน้าจอได้\n\nการไม่ตั้งค่านโยบายหมายความว่านโยบาย AskWindowManagement จะมีผล แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้\n\nนโยบายนี้มาแทนที่นโยบาย DefaultWindowPlacementSetting ที่เลิกใช้งานแล้ว";
DeletingUndecryptablePasswordsEnabled.pfm_title = "เปิดใช้การลบรหัสผ่านที่ถอดรหัสไม่ได้";
DeletingUndecryptablePasswordsEnabled.pfm_description = "นโยบายนี้ควบคุมว่าจะให้เครื่องมือจัดการรหัสผ่านในตัวสามารถลบรหัสผ่านที่ถอดรหัสไม่ได้ออกจากฐานข้อมูลได้หรือไม่ การตั้งค่านี้จำเป็นต่อการคืนค่าฟังก์ชันการทำงานทั้งหมดของเครื่องมือจัดการรหัสผ่านในตัว แต่อาจทำให้ข้อมูลสูญหายถาวร ค่ารหัสผ่านที่ถอดรหัสไม่ได้จะไม่เปลี่ยนเป็นค่าที่ถอดรหัสได้เอง และหากสามารถแก้ไขได้ โดยปกติแล้วจะต้องให้ผู้ใช้ดำเนินการที่มีความซับซ้อน\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าหมายความว่าผู้ใช้ที่มีรหัสผ่านที่ถอดรหัสไม่ได้ซึ่งบันทึกไว้ในเครื่องมือจัดการรหัสผ่านในตัวจะสูญเสียรหัสผ่านเหล่านั้นไป รหัสผ่านที่อยู่ในสถานะใช้งานได้จะไม่ได้รับผลกระทบ\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หมายความว่าข้อมูลเครื่องมือจัดการรหัสผ่านของผู้ใช้จะยังคงเดิม แต่ผู้ใช้จะพบว่าเครื่องมือจัดการรหัสผ่านไม่ทำงาน\n\nหากตั้งค่านโยบาย ผู้ใช้จะไปเปลี่ยนใน Brave ไม่ได้";
DesktopSharingHubEnabled.pfm_title = "เปิดใช้การแชร์เดสก์ท็อปในแถบอเนกประสงค์และเมนู 3 จุด";
DesktopSharingHubEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" หรือไม่ตั้งค่าจะทำให้ผู้ใช้แชร์หรือบันทึกหน้าเว็บปัจจุบันได้โดยใช้การทำงานที่ฮับการแชร์เดสก์ท็อปมีให้ ฮับการแชร์สามารถเข้าถึงได้ผ่านไอคอนในแถบอเนกประสงค์หรือเมนู 3 จุด\n\nการตั้งค่านโยบายเป็น \"เท็จ\" จะนำไอคอนแชร์ออกจากแถบอเนกประสงค์และนำการแชร์ออกจากเมนู 3 จุด";
DevToolsGenAiSettings.pfm_title = "การตั้งค่าสำหรับฟีเจอร์ Generative AI ของ Chrome DevTools";
DevToolsGenAiSettings.pfm_description = "0 - อนุญาตให้ใช้ฟีเจอร์ Generative AI ของ Chrome DevTools และปรับปรุงโมเดล AI\n1 - อนุญาตให้ใช้ฟีเจอร์ Generative AI ของ Chrome DevTools โดยไม่ปรับปรุงโมเดล AI\n2 - ไม่อนุญาตให้ใช้ฟีเจอร์ Generative AI ของ Chrome DevTools\nฟีเจอร์เหล่านี้ใน Chrome DevTools ใช้โมเดล Generative AI เพื่อให้ข้อมูลการแก้ไขข้อบกพร่องเพิ่มเติม หากต้องการใช้ฟีเจอร์ดังกล่าว Brave จะต้องรวบรวมข้อมูล เช่น ข้อความแสดงข้อผิดพลาด สแต็กเทรซ ข้อมูลโค้ด และคำขอเครือข่าย แล้วส่งไปยังเซิร์ฟเวอร์ของ Google ซึ่งเรียกใช้โมเดล Generative AI เนื้อหาการตอบสนองหรือการตรวจสอบสิทธิ์และส่วนหัวคุกกี้ในคำขอเครือข่ายจะไม่รวมอยู่ในข้อมูลที่ส่งไปยังเซิร์ฟเวอร์\n\n0 = อนุญาตให้ใช้ฟีเจอร์ พร้อมกับอนุญาตให้ Google ใช้ข้อมูลที่เกี่ยวข้องเพื่อปรับปรุงโมเดล AI ข้อมูลที่เกี่ยวข้องอาจรวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร โดยทั้งนี้จะขึ้นอยู่กับฟีเจอร์นั้นๆ รวมถึงเจ้าหน้าที่อาจตรวจสอบข้อมูลดังกล่าวเพื่อปรับปรุงโมเดล AI 0 คือค่าเริ่มต้น เว้นแต่จะระบุไว้ด้านล่าง\n\n1 = อนุญาตให้ใช้ฟีเจอร์ แต่ไม่อนุญาตให้ Google ปรับปรุงโมเดลโดยใช้เนื้อหาของผู้ใช้ (รวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร) 1 คือค่าเริ่มต้นสำหรับผู้ใช้ระดับองค์กรที่จัดการโดยGoogle Admin console และบัญชี Education ที่จัดการโดย Google Workspace\n\n2 = ไม่อนุญาตให้ใช้ฟีเจอร์\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nฟีเจอร์ Generative AI ของ Chrome DevToolsรวมถึง\n\n- Console Insights: ฟีเจอร์ที่อธิบายข้อความในคอนโซลและให้คำแนะนำเกี่ยวกับวิธีแก้ไขข้อผิดพลาดของคอนโซล\n\n- ความช่วยเหลือจาก AI: รับความช่วยเหลือในการทำความเข้าใจรูปแบบ CSS (ตั้งแต่เวอร์ชัน 131) คำขอเครือข่าย ประสิทธิภาพ และไฟล์ (ทั้งหมดตั้งแต่เวอร์ชัน 132)\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "เปิดใช้โปรไฟล์ Google Developer Program ใน Chrome DevTools";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - เปิดใช้การผสานรวม Google Developer Program ใน Chrome DevTools\n1 - เปิดใช้การผสานรวม Google Developer Program ใน Chrome DevTools แต่ไม่ต้องแชร์การใช้งานเครื่องมือ (สำหรับการมอบป้าย)\n2 - ไม่ต้องเปิดใช้การผสานรวม Google Developer Program ใน Chrome DevTools\nนโยบายนี้ควบคุมการผสานรวม Google Developer Program เข้ากับ Chrome DevTools โปรไฟล์ Google Developer Program ของผู้ใช้จะแสดงใน Chrome DevTools และผู้ใช้จะได้รับป้ายเมื่อดำเนินการบางอย่างภายใน Chrome DevTools\n\nการตั้งค่านโยบายเป็น 0 - \"เปิดใช้\" หรือไม่ตั้งค่าใดๆ ในนโยบายจะอนุญาตให้ผสานรวม Google Developer Program เข้ากับ Chrome DevTools และอนุญาตให้แชร์การใช้งานเครื่องมือ Chrome DevTools เพื่อให้สามารถมอบป้ายได้\n\nการตั้งค่านโยบายเป็น 1 - \"เปิดใช้โดยไม่มีป้าย\" จะอนุญาตให้ผสานรวม Google Developer Program เข้ากับ Chrome DevTools แต่ไม่อนุญาตให้แชร์การใช้งานเครื่องมือ Chrome DevTools กับ Google Developer Program นั่นหมายความว่าระบบจะไม่มอบป้ายให้\n\nการตั้งค่านโยบายเป็น 2 - \"ปิดใช้\" จะไม่อนุญาตให้ผสานรวม Google Developer Program เข้ากับ Chrome DevTools";
DeveloperToolsAvailability.pfm_title = "ควบคุมตำแหน่งที่ใช้ Chrome DevTools ได้";
DeveloperToolsAvailability.pfm_description = "0 - ไม่อนุญาตให้ใช้ Chrome DevTools ในแอปและส่วนขยายที่ติดตั้งโดยนโยบายระดับองค์กร หรือตั้งแต่เวอร์ชัน 114 หากเป็นผู้ใช้ที่มีการจัดการ ส่วนขยายจะมีอยู่ในตัวเบราว์เซอร์ อนุญาตให้ใช้ Chrome DevTools ในบริบทอื่นๆ\n1 - อนุญาตให้ใช้งาน Chrome DevTools\n2 - ไม่อนุญาตให้ใช้งาน Chrome DevTools\nการตั้งค่านโยบายเป็น 0 (ค่าเริ่มต้น) หมายความว่าคุณจะเข้าถึง Chrome DevTools และคอนโซล JavaScript ได้ แต่จะไม่สามารถเข้าถึงได้ในบริบทของส่วนขยายที่ติดตั้งโดยนโยบายระดับองค์กร หรือส่วนขยายที่อยู่ในตัวเบราว์เซอร์ (ตั้งแต่เวอร์ชัน 114 เป็นต้นไป และหากเป็นผู้ใช้ที่มีการจัดการ) การตั้งค่านโยบายเป็น 1 หมายความว่าคุณจะเข้าถึง Chrome DevTools และคอนโซล JavaScript ได้ในทุกบริบท ซึ่งรวมถึงส่วนขยายที่ติดตั้งโดยนโยบายระดับองค์กร การตั้งค่านโยบายเป็น 2 หมายความว่าคุณจะเข้าถึง Chrome DevTools ไม่ได้และตรวจสอบองค์ประกอบของเว็บไซต์ไม่ได้\n\nการตั้งค่านี้ยังปิดแป้นพิมพ์ลัดและเมนูหรือรายการในเมนูตามบริบทเพื่อเปิด Chrome DevTools หรือคอนโซล JavaScript ด้วย\n\nตั้งแต่ Brave เวอร์ชัน 99 เป็นต้นไป การตั้งค่านี้ยังควบคุมจุดแรกเข้าสำหรับฟีเจอร์ \"ดูซอร์สโค้ดของหน้าเว็บ\" ด้วย หากตั้งค่านโยบายนี้เป็น \"DeveloperToolsDisallowed\" (ค่า 2) ผู้ใช้จะเข้าถึงการดูที่มาผ่านแป้นพิมพ์ลัดหรือเมนูตามบริบทไม่ได้ หากต้องการบล็อกการดูแหล่งที่มาโดยสมบูรณ์ คุณต้องเพิ่ม \"view-source:*\" ลงในนโยบาย URLBlocklist ด้วย\n\nตั้งแต่ Brave เวอร์ชัน 119 เป็นต้นไป การตั้งค่านี้จะควบคุมว่าจะเปิดใช้งานและใช้โหมดนักพัฒนาซอฟต์แวร์สำหรับ Isolated Web App ได้หรือไม่\n\nตั้งแต่ Brave เวอร์ชัน 128 เป็นต้นไป การตั้งค่านี้จะไม่ควบคุมโหมดนักพัฒนาซอฟต์แวร์ในหน้าส่วนขยายหากมีการตั้งค่านโยบาย ExtensionDeveloperModeSettings ไว้\n\nนโยบายนี้มีผลกับ Chrome DevTools, การเข้าถึงโปรโตคอลเครื่องมือสำหรับนักพัฒนาเว็บใน Chrome (CDP) โดยตรง (เช่น เมื่อเปิดใช้งานด้วย --remote-debugging-port หรือ --remote-debugging-pipe) และการเข้าถึงโปรโตคอลเครื่องมือสำหรับนักพัฒนาเว็บใน Chrome (CDP) ผ่าน chrome.debugger API ทั้งนโยบายนี้และนโยบาย RemoteDebuggingAllowed จะมีผลบังคับใช้ โดย RemoteDebuggingAllowed จะควบคุมว่าจะเริ่มการแก้ไขข้อบกพร่องจากระยะไกลได้หรือไม่ ขณะที่นโยบายนี้จะจำกัดว่าจะตรวจสอบเป้าหมายแต่ละรายการได้หรือไม่ แม้ว่าการแก้ไขข้อบกพร่องจากระยะไกลจะทำงานอยู่ก็ตาม\n\nนโยบาย DeveloperToolsAvailabilityAllowlist และ DeveloperToolsAvailabilityBlocklist จะมีความสำคัญเหนือกว่านโยบายนี้ ความพร้อมใช้งานของ Chrome DevTools จะกำหนดตามลำดับความสำคัญต่อไปนี้\n\n1. หาก URL ตรงกับรูปแบบในนโยบาย DeveloperToolsAvailabilityAllowlist ระบบจะอนุญาตให้ใช้Chrome DevTools\n2. หากตั้งค่า DeveloperToolsAvailabilityAllowlist และไม่ได้ตั้งค่า DeveloperToolsAvailabilityBlocklist ระบบจะบล็อก URL ที่ไม่อยู่ในรายการที่อนุญาต\n3. หาก URL ตรงกับรูปแบบในนโยบาย DeveloperToolsAvailabilityBlocklist ระบบจะบล็อกChrome DevTools\n4. หากไม่ได้ตั้งค่านโยบายใดๆ ไว้ หรือหาก URL ไม่ตรงกับรายการใดเลย ระบบจะใช้นโยบายนี้ (DeveloperToolsAvailability) เป็นกลไกสำรอง";
DeveloperToolsAvailabilityAllowlist.pfm_title = "รายการรูปแบบ URL ของ Chrome DevTools ที่อนุญาตให้เปิด";
DeveloperToolsAvailabilityAllowlist.pfm_description = "คุณสามารถใช้นโยบายนี้เพื่ออนุญาต Chrome DevTools ใน URL ที่เฉพาะเจาะจงได้\n\nระบบจะประเมินความพร้อมใช้งานของ Chrome DevTools ที่ระดับเป้าหมาย รูปแบบ URL จะจับคู่กับ URL ของแต่ละเป้าหมายที่กำลังตรวจสอบ (เช่น เฟรมหลักของหน้าเว็บ เฟรมย่อยแบบฝัง ส่วนขยาย หรือเว็บแอปพลิเคชัน) ลักษณะการทำงานที่ได้จะขึ้นอยู่กับว่ามีการตั้งค่านโยบาย DeveloperToolsAvailabilityBlocklist ด้วยหรือไม่\n\nหากตั้งค่านโยบายนี้และไม่ได้ตั้งค่า DeveloperToolsAvailabilityBlocklist URL ของเป้าหมายต้องตรงกับรูปแบบในรายการที่อนุญาตนี้เพื่อให้ระบบอนุญาต Chrome DevTools สำหรับเป้าหมายนั้น หาก URL ของเป้าหมายไม่ตรงกับรายการที่อนุญาตนี้ ระบบจะบล็อก Chrome DevTools สำหรับเป้าหมายนั้น (เช่น เฟรมย่อยที่มี URL ไม่อยู่ในรายการที่อนุญาตจะไม่สามารถตรวจสอบได้ แต่หน้าหลักจะยังคงตรวจสอบได้หาก URL อยู่ในรายการที่อนุญาต) ดูข้อมูลเกี่ยวกับรูปแบบ URL ได้ที่ https://support.google.com/chrome/a?p=url_blocklist_filter_format\n\nหากตั้งค่าทั้งนโยบายนี้และนโยบาย DeveloperToolsAvailabilityBlocklist รายการที่อนุญาตนี้จะมีความสำคัญเหนือกว่า หาก URL ของเป้าหมายตรงกับรูปแบบในรายการที่อนุญาตนี้ ระบบจะอนุญาตให้ใช้ได้ แม้ว่าจะตรงกับรูปแบบในรายการที่บล็อกด้วยก็ตาม หาก URL ของเป้าหมายตรงกับรูปแบบในรายการที่บล็อกนี้ (แต่ไม่ตรงกับรายการที่อนุญาต) ระบบจะบล็อก URL นั้น หาก URL ของเป้าหมายไม่ตรงกับรูปแบบในรายการใดๆ เลย ระบบจะใช้นโยบาย DeveloperToolsAvailability เป็นตัวเลือกสำรอง\n\nหากไม่ได้ตั้งค่านโยบายนี้ ความพร้อมใช้งานของ Chrome DevTools จะกำหนดโดยนโยบาย DeveloperToolsAvailabilityBlocklist และ DeveloperToolsAvailability\n\nไวลด์การ์ดโฮสต์แบบครอบคลุม (คือ ไม่อนุญาตให้ใช้ \"*\" หรือ \"[*]\") ให้ใช้นโยบาย DeveloperToolsAvailability เพื่อเปิดใช้ฟีเจอร์ทั่วโลก\n\nนโยบายนี้มีผลกับ Chrome DevTools, การเข้าถึงโปรโตคอลเครื่องมือสำหรับนักพัฒนาเว็บใน Chrome (CDP) โดยตรง (เช่น เมื่อเปิดใช้งานด้วย --remote-debugging-port หรือ --remote-debugging-pipe) และการเข้าถึงโปรโตคอลเครื่องมือสำหรับนักพัฒนาเว็บใน Chrome (CDP) ผ่าน chrome.debugger API ทั้งนโยบายนี้และนโยบาย RemoteDebuggingAllowed จะมีผลบังคับใช้ โดย RemoteDebuggingAllowed จะควบคุมว่าจะเริ่มการแก้ไขข้อบกพร่องจากระยะไกลได้หรือไม่ ขณะที่นโยบายนี้จะจำกัดว่าจะตรวจสอบเป้าหมายแต่ละรายการได้หรือไม่ แม้ว่าการแก้ไขข้อบกพร่องจากระยะไกลจะทำงานอยู่ก็ตาม\n\nนโยบายนี้ระบุรายการได้ไม่เกิน 1,000 รายการ";
DeveloperToolsAvailabilityBlocklist.pfm_title = "รายการรูปแบบ URL ของ Chrome DevTools ที่ถูกบล็อก";
DeveloperToolsAvailabilityBlocklist.pfm_description = "คุณสามารถใช้นโยบายนี้เพื่อบล็อก Chrome DevTools ใน URL ที่เฉพาะเจาะจงได้ ดูข้อมูลเกี่ยวกับรูปแบบ URL ได้ที่ https://support.google.com/chrome/a?p=url_blocklist_filter_format\n\nระบบจะประเมินความพร้อมใช้งานของ Chrome DevTools ที่ระดับเป้าหมาย รูปแบบ URL จะจับคู่กับ URL ของแต่ละเป้าหมายที่กำลังตรวจสอบ (เช่น เฟรมหลักของหน้าเว็บ เฟรมย่อยแบบฝัง ส่วนขยาย หรือเว็บแอปพลิเคชัน) ลักษณะการทำงานที่ได้จะขึ้นอยู่กับว่ามีการตั้งค่านโยบาย DeveloperToolsAvailabilityAllowlist ด้วยหรือไม่\n\nหากตั้งค่านโยบายนี้และไม่ได้ตั้งค่า DeveloperToolsAvailabilityAllowlist ระบบจะบล็อก Chrome DevTools สำหรับเป้าหมายที่มี URL ตรงกับรูปแบบในรายการที่บล็อกนี้ (เช่น เฟรมย่อยที่มี URL ตรงกับรายการที่บล็อกนี้จะตรวจสอบไม่ได้ แต่หน้าหลักจะยังตรวจสอบได้หาก URL ของหน้าหลักไม่อยู่ในรายการที่บล็อก) หาก URL ของเป้าหมายไม่ตรงกับรูปแบบใดๆ ความพร้อมใช้งานจะกำหนดโดยนโยบาย DeveloperToolsAvailability\n\nหากตั้งค่าทั้งนโยบายนี้และนโยบาย DeveloperToolsAvailabilityAllowlist รายการที่อนุญาตนี้จะมีความสำคัญเหนือกว่า หาก URL ของเป้าหมายตรงกับรูปแบบในรายการที่อนุญาต ระบบจะอนุญาตให้ใช้ได้ แม้ว่าจะตรงกับรูปแบบในรายการที่บล็อกนี้ด้วยก็ตาม หาก URL ของเป้าหมายตรงกับรูปแบบในรายการที่บล็อกนี้ (แต่ไม่ตรงกับรายการที่อนุญาต) ระบบจะบล็อก URL นั้น หาก URL ของเป้าหมายไม่ตรงกับรูปแบบในรายการใดๆ เลย ระบบจะใช้นโยบาย DeveloperToolsAvailability เป็นตัวเลือกสำรอง\n\nหากไม่ได้ตั้งค่านโยบายนี้ ความพร้อมใช้งานของ Chrome DevTools จะกำหนดโดยนโยบาย DeveloperToolsAvailabilityAllowlist และ DeveloperToolsAvailability\n\nนโยบายนี้มีผลกับ Chrome DevTools, การเข้าถึงโปรโตคอลเครื่องมือสำหรับนักพัฒนาเว็บใน Chrome (CDP) โดยตรง (เช่น เมื่อเปิดใช้งานด้วย --remote-debugging-port หรือ --remote-debugging-pipe) และการเข้าถึงโปรโตคอลเครื่องมือสำหรับนักพัฒนาเว็บใน Chrome (CDP) ผ่าน chrome.debugger API ทั้งนโยบายนี้และนโยบาย RemoteDebuggingAllowed จะมีผลบังคับใช้ โดย RemoteDebuggingAllowed จะควบคุมว่าจะเริ่มการแก้ไขข้อบกพร่องจากระยะไกลได้หรือไม่ ขณะที่นโยบายนี้จะจำกัดว่าจะตรวจสอบเป้าหมายแต่ละรายการได้หรือไม่ แม้ว่าการแก้ไขข้อบกพร่องจากระยะไกลจะทำงานอยู่ก็ตาม\n\nนโยบายนี้ระบุรายการได้ไม่เกิน 1,000 รายการ";
Disable3DAPIs.pfm_title = "ปิดใช้งานการสนับสนุน API ของกราฟิก 3 มิติ";
Disable3DAPIs.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" (หรือตั้งค่า HardwareAccelerationModeEnabled เป็น \"เท็จ\") จะป้องกันไม่ให้หน้าเว็บเข้าถึง WebGL API ได้\n\nการตั้งค่านโยบายเป็น \"เท็จ\" หรือไม่ได้ตั้งค่าจะทำให้หน้าเว็บใช้ WebGL API ได้ แต่การตั้งค่าเริ่มต้นของเบราว์เซอร์อาจยังคงต้องใช้อาร์กิวเมนต์บรรทัดคำสั่งเพื่อใช้ API เหล่านี้";
DisableAuthNegotiateCnameLookup.pfm_title = "ปิดใช้งานการค้นหา CNAME เมื่อมีการเจรจาตรวจสอบสิทธิ์ Kerberos";
DisableAuthNegotiateCnameLookup.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะข้ามการค้นหา CNAME ระบบจะใช้ชื่อเซิร์ฟเวอร์ตามที่ป้อนเมื่อสร้าง Kerberos SPN\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าหมายความว่าการค้นหา CNAME จะกำหนดชื่อ Canonical ของเซิร์ฟเวอร์เมื่อสร้าง Kerberos SPN";
DisablePrintPreview.pfm_title = "ปิดใช้งานหน้าตัวอย่างก่อนพิมพ์";
DisablePrintPreview.pfm_description = "หากตั้งค่านโยบายเป็น \"เปิดใช้\" จะทำให้ Brave เปิดกล่องโต้ตอบการพิมพ์ของระบบแทนการแสดงตัวอย่างก่อนพิมพ์ในตัวเมื่อผู้ใช้ขอพิมพ์\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ตั้งค่า คำสั่งพิมพ์จะทำให้หน้าจอการแสดงตัวอย่างก่อนพิมพ์เปิดขึ้นมา";
DisableSafeBrowsingProceedAnyway.pfm_title = "ปิดใช้งานการดำเนินการต่อจากหน้าคำเตือน Safe Browsing";
DisableSafeBrowsingProceedAnyway.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะป้องกันไม่ให้ผู้ใช้ดำเนินการต่อจากหน้าคำเตือนที่บริการ Google Safe Browsing แสดงและไปยังเว็บไซต์อันตราย นโยบายนี้ป้องกันไม่ให้ผู้ใช้ดำเนินการต่อในกรณีที่ได้รับคำเตือนจาก Google Safe Browsing เช่น มัลแวร์และฟิชชิงเท่านั้น ไม่ใช่ปัญหาเกี่ยวกับใบรับรอง SSL เช่น ใบรับรองไม่ถูกต้องหรือหมดอายุ\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า หมายความว่าผู้ใช้เลือกที่จะดำเนินการต่อไปยังเว็บไซต์ที่มีการแจ้งว่าไม่เหมาะสมหลังจากที่คำเตือนปรากฏขึ้นได้\n\nดูเพิ่มเติมเกี่ยวกับ Google Safe Browsing (https://developers.google.com/safe-browsing)";
DisableScreenshots.pfm_title = "ปิดใช้งานการจับภาพหน้าจอ";
DisableScreenshots.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะไม่อนุญาตให้ถ่ายภาพหน้าจอด้วยแป้นพิมพ์ลัดหรือ API ส่วนขยาย การตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าจะอนุญาตให้ถ่ายภาพหน้าจอได้\n\nตั้งแต่ Brave เวอร์ชัน 154 เป็นต้นไป การเปิดใช้นโยบายนี้จะป้องกันไม่ให้ส่วนขยายแนบโปรแกรมแก้ไขข้อบกพร่องผ่าน \"chrome.debugger.attach()\" ด้วย\n\nโปรดทราบว่าใน Microsoft® Windows®, macOS และ Linux การตั้งค่านี้ไม่ได้ป้องกันการถ่ายภาพหน้าจอด้วยระบบปฏิบัติการหรือแอปพลิเคชันของบุคคลที่สาม";
DiskCacheDir.pfm_title = "ตั้งค่าไดเรกทอรีสำหรับแคชของดิสก์";
DiskCacheDir.pfm_description = "การตั้งค่านโยบายทำให้ Brave ใช้ไดเรกทอรีที่คุณให้ไว้สำหรับจัดเก็บไฟล์ที่แคชไว้ในดิสก์ ไม่ว่าจะระบุการตั้งค่าสถานะ --disk-cache-dir หรือไม่ก็ตาม\n\nหากไม่ได้ตั้งค่า Brave จะใช้ไดเรกทอรีแคชเริ่มต้น แต่ผู้ใช้จะเปลี่ยนการตั้งค่านั้นได้ด้วยการตั้งค่าสถานะบรรทัดคำสั่ง --disk-cache-dir\n\nBrave จะจัดการเนื้อหาของไดเรกทอรีรูทของวอลุ่ม ดังนั้นเพื่อหลีกเลี่ยงการสูญหายของข้อมูลหรือข้อผิดพลาดอื่นๆ โปรดอย่าตั้งค่านโยบายนี้เป็นไดเรกทอรีรูทหรือไดเรกทอรีอื่นที่ใช้สำหรับวัตถุประสงค์อื่นๆ ดูตัวแปรที่คุณใช้ได้ ( https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables )";
DiskCacheSize.pfm_title = "ตั้งค่าขนาดแคชดิสก์";
DiskCacheSize.pfm_description = "การตั้งค่านโยบายนี้เป็น \"ไม่มี\" ทำให้ Brave ใช้ขนาดแคชเริ่มต้นในการจัดเก็บไฟล์ที่แคชไว้ในดิสก์ โดยที่ผู้ใช้จะเปลี่ยนแปลงไม่ได้\n\nหากคุณตั้งค่านโยบายนี้ Brave จะใช้ขนาดแคชที่คุณระบุไว้ ไม่ว่าผู้ใช้จะระบุการตั้งค่าสถานะ --disk-cache-size หรือไม่ก็ตาม (ระบบจะปัดเศษค่าที่ต่ำกว่า 2-3 เมกะไบต์)\n\nหากไม่ได้ตั้งค่า Brave จะใช้ขนาดเริ่มต้น ผู้ใช้เปลี่ยนการตั้งค่าดังกล่าวได้โดยใช้การตั้งค่าสถานะ --disk-cache-size\n\nหมายเหตุ: ค่าที่ระบุในนโยบายนี้จะใช้เป็นคำแนะนำสำหรับระบบย่อยของแคชต่างๆ ในเบราว์เซอร์ ดังนั้น ปริมาณการใช้พื้นที่ดิสก์จริงรวมของแคชทั้งหมดจะสูงกว่านี้ แต่อยู่ภายในขนาดที่ใกล้เคียงกันกับค่าที่ระบุไว้";
DnsOverHttpsMode.pfm_title = "ควบคุมโหมด DNS-over-HTTPS";
DnsOverHttpsMode.pfm_description = "off - ปิดใช้โหมด DNS-over-HTTPS\nautomatic - เปิดใช้โหมด DNS-over-HTTPS ที่มีการถอยหลังกลับที่ไม่ปลอดภัย\nsecure - เปิดใช้โหมด DNS-over-HTTPS ที่ไม่มีการถอยหลังกลับที่ไม่ปลอดภัย\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "ระบุเทมเพลต URI ของรีโซลเวอร์ DNS-over-HTTPS ที่ต้องการ";
DnsOverHttpsTemplates.pfm_description = "เทมเพลต URI ของรีโซลเวอร์ DNS-over-HTTPS ที่ต้องการ วิธีระบุรีโซลเวอร์ DNS-over-HTTPS หลายรายการคือเว้นวรรคระหว่างเทมเพลต URI ที่เกี่ยวข้อง\n\nหากตั้งค่า DnsOverHttpsMode เป็น \"secure\" ก็ต้องตั้งค่านโยบายนี้และนโยบายต้องไม่ว่างเปล่า คุณจะต้องตั้งค่านโยบายนี้หรือ DnsOverHttpsTemplatesWithIdentifiers มิเช่นนั้น การแปลง DNS จะไม่สำเร็จ (เฉพาะใน Google Chrome OS เท่านั้น)\n\nหากตั้งค่า DnsOverHttpsMode เป็น \"automatic\" และตั้งค่านโยบายนี้ด้วย ระบบก็จะใช้เทมเพลต URI ที่ระบุไว้ หากไม่ได้ตั้งค่านโยบายนี้ ระบบจะใช้การจับคู่แบบฮาร์ดโค้ดเพื่อพยายามอัปเกรดรีโซลเวอร์ DNS ปัจจุบันของผู้ใช้เป็นรีโซลเวอร์ DoH ที่ดำเนินการโดยผู้ให้บริการรายเดียวกัน\n\nหากเทมเพลต URI มีตัวแปร dns คำขอที่ส่งไปยังรีโซลเวอร์จะใช้ GET หากไม่มี คำขอจะใช้ POST\n\nระบบจะไม่สนใจเทมเพลตที่จัดรูปแบบไม่ถูกต้อง";
DomainReliabilityAllowed.pfm_title = "อนุญาตการรายงานข้อมูลที่เกี่ยวข้องกับความเสถียรของโดเมน";
DomainReliabilityAllowed.pfm_description = "หากตั้งค่านโยบายนี้เป็น \"เท็จ\" ระบบจะปิดใช้การรายงานข้อมูลการวินิจฉัยความเสถียรของโดเมนและจะไม่ส่งข้อมูลไปยัง Google\nหากตั้งค่านโยบายนี้เป็น \"จริง\" หรือไม่ได้ตั้งค่า การรายงานข้อมูลการวินิจฉัยความเสถียรของโดเมนจะเป็นไปตามลักษณะการทำงานของ MetricsReportingEnabled สำหรับ Brave หรือ DeviceMetricsReportingEnabled สำหรับ Google Chrome OS";
DownloadDirectory.pfm_title = "ตั้งค่าไดเรกทอรีสำหรับดาวน์โหลด";
DownloadDirectory.pfm_description = "การตั้งค่านโยบายนี้จะสร้างไดเรกทอรีที่ Chrome จะใช้สำหรับการดาวน์โหลดไฟล์ และจะใช้ไดเรกทอรีที่มีให้นี้ไม่ว่าผู้ใช้จะระบุไดเรกทอรีใดไว้ หรือได้เปิดใช้การแสดงข้อความแจ้งเพื่อระบุตำแหน่งการดาวน์โหลดทุกครั้งไว้หรือไม่ก็ตาม\n\nนโยบายนี้จะลบล้างนโยบาย DefaultDownloadDirectory\n\nการไม่ตั้งค่านโยบายหมายความว่า Chrome จะใช้ไดเรกทอรีการดาวน์โหลดเริ่มต้น และผู้ใช้จะเปลี่ยนได้\n\nใน Google Chrome OS คุณจะสร้างไดเรกทอรีได้เฉพาะบนไดเรกทอรี Google ไดรฟ์เท่านั้น\n\nหมายเหตุ: ดูรายการตัวแปรที่คุณใช้ได้ (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables)";
DownloadRestrictions.pfm_title = "ข้อจำกัดในการดาวน์โหลด";
DownloadRestrictions.pfm_description = "0 - ไม่มีข้อจำกัดพิเศษ ค่าเริ่มต้น\n1 - บล็อกการดาวน์โหลดและประเภทไฟล์ที่เป็นอันตราย\n2 - บล็อกการดาวน์โหลดที่เป็นอันตราย ไม่ปกติ หรือไม่พึงประสงค์ รวมถึงประเภทไฟล์ที่เป็นอันตราย\n3 - บล็อกการดาวน์โหลดทั้งหมด\n4 - บล็อกการดาวน์โหลดที่เป็นอันตราย แนะนำ\nการตั้งค่านโยบายนี้หมายความว่าผู้ใช้จะข้ามการตัดสินใจเกี่ยวกับความปลอดภัยในการดาวน์โหลดไม่ได้\n\nChrome มีคำเตือนการดาวน์โหลดหลายประเภทซึ่งแบ่งคร่าวๆ ได้เป็นหมวดหมู่ต่อไปนี้ (ดูข้อมูลเพิ่มเติมเกี่ยวกับการพิจารณาของ Google Safe Browsing ที่ https://support.google.com/chrome/?p=ib_download_blocked)\n\n* เป็นอันตราย ตามที่เซิร์ฟเวอร์ Google Safe Browsing แจ้งไว้\n* ไม่ปกติหรือไม่พึงประสงค์ ตามที่เซิร์ฟเวอร์ Google Safe Browsing แจ้งไว้\n* ประเภทไฟล์ที่เป็นอันตราย (เช่น การดาวน์โหลด SWF ทั้งหมดและการดาวน์โหลด EXE จำนวนมาก)\n\nการตั้งค่านโยบายจะบล็อกส่วนย่อยต่างๆ ของหมวดหมู่เหล่านี้ตามค่าที่กำหนด\n\n0: ไม่มีข้อจำกัดพิเศษ ค่าเริ่มต้น\n\n1: บล็อกไฟล์ที่เป็นอันตรายซึ่งเซิร์ฟเวอร์ Google Safe Browsing แจ้งไว้ และบล็อกประเภทไฟล์ที่เป็นอันตรายทั้งหมด แนะนำเฉพาะสำหรับ OU, เบราว์เซอร์ หรือผู้ใช้ที่แยกแยะการตรวจพบที่ผิดพลาดได้เป็นอย่างดี\n\n2: บล็อกไฟล์ที่เป็นอันตรายซึ่งเซิร์ฟเวอร์ Google Safe Browsing แจ้งไว้ บล็อกไฟล์ที่ไม่ปกติหรือไม่พึงประสงค์ซึ่งเซิร์ฟเวอร์ Google Safe Browsing แจ้งไว้ และบล็อกประเภทไฟล์ที่เป็นอันตรายทั้งหมด แนะนำเฉพาะสำหรับ OU, เบราว์เซอร์ หรือผู้ใช้ที่แยกแยะการตรวจพบที่ผิดพลาดได้เป็นอย่างดี\n\n3: บล็อกการดาวน์โหลดทั้งหมด ไม่แนะนำ ยกเว้นในกรณีการใช้งานพิเศษ\n\n4: บล็อกไฟล์ที่เป็นอันตรายซึ่งเซิร์ฟเวอร์ Google Safe Browsing แจ้งไว้ แต่ไม่บล็อกประเภทไฟล์ที่เป็นอันตราย แนะนำ\n\nหมายเหตุ: ข้อจำกัดเหล่านี้มีผลกับการดาวน์โหลดที่เกิดขึ้นจากเนื้อหาของหน้าเว็บ รวมถึงตัวเลือกเมนู \"ลิงก์ดาวน์โหลด…\" ด้วย แต่ไม่มีผลกับการดาวน์โหลดของหน้าที่แสดงอยู่ หรือการบันทึกเป็น PDF จากตัวเลือกการพิมพ์ อ่านเพิ่มเติมเกี่ยวกับ Google Safe Browsing (https://developers.google.com/safe-browsing)";
EditBookmarksEnabled.pfm_title = "เปิดหรือปิดใช้การแก้ไขบุ๊กมาร์ก";
EditBookmarksEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะให้ผู้ใช้เพิ่ม นำออก แก้ไข หรืออัปโหลดบุ๊กมาร์กได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หมายความว่าผู้ใช้ไม่สามารถเพิ่ม นำออก แก้ไข หรืออัปโหลดบุ๊กมาร์ก แต่จะยังใช้บุ๊กมาร์กที่มีอยู่ได้";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "รวมพอร์ตที่ไม่ใช่แบบมาตรฐานใน Kerberos SPN";
EnableAuthNegotiatePort.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" และการป้อนพอร์ตที่ไม่ใช่มาตรฐาน (กล่าวคือ พอร์ตอื่นใดที่ไม่ใช่ 80 หรือ 443) จะรวมพอร์ตนั้นใน Kerberos SPN ที่สร้างขึ้นมา\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าหมายความว่าจะไม่มีการรวมพอร์ตใน Kerberos SPN ที่สร้างขึ้นมา";
EnableExperimentalPolicies.pfm_title = "เปิดใช้นโยบายทดลอง";
EnableExperimentalPolicies.pfm_description = "อนุญาตให้ Brave โหลดนโยบายทดลอง\n\nคำเตือน: นโยบายทดลองไม่ได้มาพร้อมการสนับสนุนและอาจมีการเปลี่ยนแปลงหรือถูกนำออกโดยไม่ต้องแจ้งให้ทราบสำหรับเวอร์ชันในอนาคตของเบราว์เซอร์\n\nนโยบายทดลองอาจยังไม่เสร็จสมบูรณ์หรือยังมีข้อบกพร่องที่ทราบแล้วหรือยังไม่ทราบ ระบบอาจเปลี่ยนแปลงหรือนำนโยบายออกโดยไม่มีการแจ้งให้ทราบ การเปิดใช้นโยบายทดลองอาจทำให้คุณสูญเสียข้อมูลในเบราว์เซอร์หรือทำให้เกิดความเสี่ยงต่อความปลอดภัยหรือความเป็นส่วนตัวของคุณ\n\nหากนโยบายไม่ได้อยู่ในรายการและยังไม่ได้เปิดตัวอย่างเป็นทางการ เวอร์ชันเบต้าและเวอร์ชันเสถียรจะไม่สนใจค่าของนโยบาย\n\nหากนโยบายอยู่ในรายการและยังไม่ได้เปิดตัวอย่างเป็นทางการ ระบบจะใช้ค่าของนโยบาย\n\nนโยบายนี้ไม่มีผลต่อนโยบายที่เปิดตัวไปแล้ว";
EnableMediaRouter.pfm_title = "เปิดใช้ Google Cast";
EnableMediaRouter.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะเปิด Google Cast ซึ่งผู้ใช้จะเรียกใช้ได้จากเมนูแอป เมนูตามบริบทของหน้าเว็บ ตัวควบคุมสื่อในเว็บไซต์ที่พร้อมใช้งาน Cast และไอคอนแถบเครื่องมือของ Cast (หากมีแสดงขึ้นมา)\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิด Google Cast";
EnableOnlineRevocationChecks.pfm_title = "เปิดใช้การตรวจสอบ OCSP/CRL ออนไลน์";
EnableOnlineRevocationChecks.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" หมายความว่าจะมีการตรวจสอบ OCSP/CRL\n\nการตั้งค่านโยบายเป็น \"เท็จ\" หรือไม่ได้ตั้งค่าหมายความว่า Brave จะไม่ตรวจสอบการเพิกถอนทางออนไลน์ใน Brave 19 ขึ้นไป\n\nหมายเหตุ: การตรวจสอบ OCSP/CRL ไม่มีประโยชน์ในด้านการรักษาความปลอดภัยที่มีประสิทธิผล";
EnableProxyOverrideRulesForAllUsers.pfm_title = "ควบคุมว่าผู้ใช้ที่มีการจัดการรายใดสามารถตั้งค่านโยบาย ProxyOverrideRules และ ProxyProvisioningDomains ได้";
EnableProxyOverrideRulesForAllUsers.pfm_description = "เมื่อตั้งค่านโยบายนี้เป็น 0 หรือไม่ได้ตั้งค่า ระบบจะใช้นโยบาย ProxyOverrideRules และ ProxyProvisioningDomains ในระดับผู้ใช้กับผู้ใช้ที่เชื่อมโยงในเบราว์เซอร์ที่มีการจัดการเท่านั้น\nเมื่อตั้งค่านโยบายนี้เป็น 1 ระบบจะใช้นโยบาย ProxyOverrideRules และ ProxyProvisioningDomains ในระดับผู้ใช้ แม้ว่าผู้ใช้รายนั้นจะไม่ได้เป็นผู้ใช้ที่เชื่อมโยงก็ตาม";
EnableUnsafeSwiftShader.pfm_title = "อนุญาตให้สำรอง WebGL ซอฟต์แวร์โดยใช้ SwiftShader";
EnableUnsafeSwiftShader.pfm_description = "นโยบายที่ควบคุมว่าจะใช้ SwiftShader เป็นการสำรอง WebGL ไหม เมื่อการเร่งความเร็ว GPU ของฮาร์ดแวร์ไม่พร้อมใช้งาน\n\nเราเคยใช้ SwiftShader เพื่อรองรับ WebGL ในระบบที่ไม่มีการเร่งความเร็ว GPU เช่น ระบบแบบ Headless หรือเครื่องเสมือนแต่เลิกใช้งานไปแล้วเนื่องจากปัญหาด้านความปลอดภัย ตั้งแต่เวอร์ชัน M139 เป็นต้นไป การสร้างบริบท WebGL จะทำไม่สำเร็จเมื่อใช้ SwiftShader นโยบายนี้ช่วยให้เบราว์เซอร์หรือผู้ดูแลระบบเลื่อนการเลิกใช้งานออกไปได้ชั่วคราว\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" จะทำให้ใช้ SwiftShader เป็นซอฟต์แวร์สำรองของ WebGL ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าอาจทำให้สร้างบริบท WebGL ไม่สำเร็จ หากการเร่งฮาร์ดแวร์ GPU ไม่พร้อมใช้งาน หน้าเว็บอาจทำงานผิดปกติ หากไม่สามารถจัดการกับปัญหาการสร้างบริบท WebGL ที่ไม่เรียบร้อย\n\nนโยบายนี้เป็นนโยบายชั่วคราวซึ่งจะถูกนำออกในอนาคต";
EncryptedClientHelloEnabled.pfm_title = "เปิดใช้ ClientHello ที่เข้ารหัสตาม TLS";
EncryptedClientHelloEnabled.pfm_description = "ClientHello ที่เข้ารหัส (ECH) คือส่วนขยายสำหรับ TLS เพื่อเข้ารหัสช่องที่มีความละเอียดอ่อนของ ClientHello และเพิ่มความเป็นส่วนตัว\n\nหากไม่กำหนดค่านโยบายนี้ หรือตั้งค่าเป็นเปิดใช้ \"Brave\" จะทำตามกระบวนการเริ่มใช้งานเริ่มต้นของ ECH หากปิดใช้ \"Brave\" จะไม่เปิดใช้ ECH\n\nเมื่อเปิดใช้ฟีเจอร์นี้ \"Brave\" อาจใช้หรือไม่ใช้ ECH โดยขึ้นอยู่กับการรองรับของเซิร์ฟเวอร์ ความพร้อมใช้งานของระเบียน DNS ผ่าน HTTPS หรือสถานะการเริ่มใช้งาน\n\nECH เป็นโปรโตคอลที่กำลังพัฒนา การใช้งานของ \"Brave\" จึงอาจมีการเปลี่ยนแปลง ดังนั้น นโยบายนี้เป็นมาตรการชั่วคราวเพื่อควบคุมการใช้งานการทดสอบเริ่มต้น ซึ่งจะแทนที่ด้วยตัวควบคุมสุดท้ายเมื่อโปรโตคอลเสร็จสมบูรณ์";
EnterpriseCustomLabel.pfm_title = "ตั้งค่าป้ายกำกับองค์กรที่กำหนดเองสำหรับโปรไฟล์ที่มีการจัดการ";
EnterpriseCustomLabel.pfm_description = "นโยบายนี้ควบคุมป้ายกำกับที่กำหนดเองซึ่งใช้เพื่อระบุโปรไฟล์ที่มีการจัดการ สำหรับโปรไฟล์ที่มีการจัดการ ป้ายกำกับนี้จะแสดงอยู่ข้างรูปโปรไฟล์ในแถบเครื่องมือ ระบบจะไม่แปลป้ายกำกับที่กำหนดเอง\n\nเมื่อใช้นโยบายนี้ สตริงใดก็ตามที่มีอักขระเกิน 16 ตัวจะถูกตัดส่วนเกินเป็น \"...\" โปรดอย่าใช้ชื่อขนาดยาว\n\nนโยบายนี้จะตั้งค่าเป็นนโยบายผู้ใช้ได้เท่านั้น\n\nโปรดทราบว่านโยบายนี้จะไม่มีผลหากตั้งค่านโยบาย EnterpriseProfileBadgeToolbarSettings เป็น hide_expanded_enterprise_toolbar_badge (ค่า 1)";
EnterpriseCustomLabelForBrowser.pfm_title = "ตั้งค่าป้ายกำกับองค์กรที่กำหนดเองสำหรับเบราว์เซอร์ที่มีการจัดการ";
EnterpriseCustomLabelForBrowser.pfm_description = "นโยบายนี้ควบคุมป้ายกำกับที่กำหนดเองซึ่งใช้เพื่อระบุเบราว์เซอร์ที่มีการจัดการ สำหรับเบราว์เซอร์ที่มีการจัดการ ป้ายกำกับนี้จะแสดงอยู่ในข้อจำกัดความรับผิดด้านการจัดการในส่วนท้ายของหน้าแท็บใหม่ ระบบจะไม่แปลป้ายกำกับที่กำหนดเอง\n\nโปรดทราบว่านโยบายนี้มีผลกับเบราว์เซอร์ที่มีการจัดการเท่านั้น ดังนั้นจะไม่มีผลกับผู้ใช้ที่มีการจัดการในเบราว์เซอร์ที่ไม่มีการจัดการ\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "อนุญาตให้ส่วนขยายที่มีการจัดการใช้ Enterprise Hardware Platform API";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" จะให้ส่วนขยายที่ติดตั้งโดยนโยบายระดับองค์กรใช้ Enterprise Hardware Platform API ได้\n\nการตั้งค่านโยบายเป็น \"เท็จ\" หรือไม่ได้ตั้งค่าจะป้องกันไม่ให้ส่วนขยายใช้ API นี้\n\nหมายเหตุ: นโยบายนี้ยังมีผลกับส่วนขยายคอมโพเนนต์ด้วย เช่น ส่วนขยายบริการ Hangouts";
EnterpriseLogoUrl.pfm_title = "URL ของโลโก้องค์กรสำหรับโปรไฟล์ที่มีการจัดการ";
EnterpriseLogoUrl.pfm_description = "URL ไปยังรูปภาพที่จะใช้เป็นป้ายองค์กรสำหรับโปรไฟล์ที่มีการจัดการ URL ต้องชี้ไปยังรูปภาพ\n\nนโยบายนี้จะตั้งค่าเป็นนโยบายผู้ใช้ได้เท่านั้น\n\nขอแนะนำให้ใช้ไอคอน Fav (ตัวอย่าง https://www.google.com/favicon.ico) หรือไอคอนที่มีขนาดไม่น้อยกว่า 48 x 48 พิกเซล";
EnterpriseLogoUrlForBrowser.pfm_title = "URL ของโลโก้องค์กรสําหรับเบราว์เซอร์ที่มีการจัดการ";
EnterpriseLogoUrlForBrowser.pfm_description = "URL ไปยังรูปภาพที่จะใช้เป็นป้ายองค์กรสำหรับเบราว์เซอร์ที่มีการจัดการ URL ต้องชี้ไปยังรูปภาพ\n\nขอแนะนำให้ใช้ไอคอน Fav (ตัวอย่าง https://www.google.com/favicon.ico) หรือไอคอนที่มีขนาดไม่น้อยกว่า 48 x 48 พิกเซล\n\nโปรดทราบว่านโยบายนี้มีผลกับเบราว์เซอร์ที่มีการจัดการเท่านั้น ดังนั้นจะไม่มีผลกับผู้ใช้ที่มีการจัดการในเบราว์เซอร์ที่ไม่มีการจัดการ\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "ควบคุมระดับการมองเห็นป้ายโปรไฟล์องค์กรในแถบเครื่องมือ";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - แสดงป้ายแถบเครื่องมือขององค์กรแบบขยาย\n1 - ซ่อนป้ายองค์กรแบบขยายในแถบเครื่องมือ\nสำหรับโปรไฟล์งานและโรงเรียน แถบเครื่องมือจะแสดงป้ายกำกับ \"ที่ทำงาน\" หรือ \"โรงเรียน\" โดยค่าเริ่มต้นข้างรูปโปรไฟล์ของแถบเครื่องมือ ป้ายกำกับจะแสดงก็ต่อเมื่อบัญชีที่ลงชื่อเข้าใช้มีการจัดการบัญชี\n\nการตั้งค่านโยบายนี้เป็น hide_expanded_enterprise_toolbar_badge (ค่า 1) จะซ่อนป้ายองค์กรสำหรับโปรไฟล์ที่มีการจัดการในแถบเครื่องมือ\n\nการไม่ตั้งค่านโยบายนี้หรือตั้งค่าเป็น show_expanded_enterprise_toolbar_badge (ค่า 0) จะแสดงป้ายองค์กร\n\nป้ายกำกับนี้ปรับแต่งได้ผ่านนโยบาย EnterpriseCustomLabel";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "เก็บข้อมูลการท่องเว็บไว้เมื่อสร้างโปรไฟล์องค์กรโดยค่าเริ่มต้น";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "หากเปิดใช้นโยบายนี้ ระบบจะเลือกตัวเลือกให้เก็บข้อมูลการท่องเว็บที่มีอยู่ไว้เมื่อสร้างโปรไฟล์องค์กรโดยค่าเริ่มต้น\n\nแต่หากไม่ได้ตั้งค่านโยบายนี้หรือปิดใช้ ตัวเลือกให้เก็บข้อมูลการท่องเว็บที่มีอยู่ไว้เมื่อสร้างโปรไฟล์องค์กรจะไม่มีการเลือกไว้โดยค่าเริ่มต้น\n\nไม่ว่าจะกำหนดค่าแบบใด ผู้ใช้จะสามารถเลือกได้ว่าจะเก็บข้อมูลการท่องเว็บที่มีอยู่ไว้หรือไม่เมื่อสร้างโปรไฟล์องค์กร\n\nนโยบายนี้จะไม่มีผลหากตัวเลือกให้เก็บข้อมูลการท่องเว็บที่มีอยู่ไว้ไม่พร้อมใช้งาน ซึ่งจะเกิดขึ้นหากบังคับใช้การแยกโปรไฟล์องค์กรอย่างเข้มงวด หรือหากข้อมูลมาจากโปรไฟล์ที่มีการจัดการอยู่แล้ว\n";
EnterpriseSearchAggregatorSettings.pfm_title = "การตั้งค่าเครื่องมือรวบรวมข้อมูลการค้นหาขององค์กร";
EnterpriseSearchAggregatorSettings.pfm_description = "นโยบายนี้อนุญาตให้ผู้ดูแลระบบตั้งค่าเครื่องมือรวบรวมข้อมูลการค้นหาขององค์กรที่กำหนดซึ่งจะแสดงคำแนะนำและผลการค้นหาในแถบอเนกประสงค์ (แถบที่อยู่) และช่องค้นหาในหน้าแท็บใหม่\n\nโดยค่าเริ่มต้น การแนะนำการค้นหาขององค์กรจะผสมผสานและแสดงควบคู่ไปกับคำแนะนำปกติของ Brave ผู้ใช้สามารถกำหนดขอบเขตการค้นหาให้เฉพาะผู้รวบรวมข้อมูลการค้นหาขององค์กรได้อย่างชัดเจนโดยการพิมพ์คีย์เวิร์ดที่ระบุในช่อง shortcut โดยใส่หรือไม่ใส่ @ นำหน้าก็ได้ (เช่น @work) ตามด้วยการกด Space หรือ Tab ในแถบอเนกประสงค์ ขณะนี้การค้นหาแบบมีขอบเขตขององค์กร (ทริกเกอร์โดยคีย์เวิร์ด) รองรับเฉพาะในแถบอเนกประสงค์เท่านั้น และไม่รองรับในช่องค้นหาบนหน้าแท็บใหม่\n\nต้องใส่ข้อมูลในช่อง name, shortcut, search_url, suggest_url\n\nช่อง name สอดคล้องกับชื่อเครื่องมือค้นหาที่แสดงให้ผู้ใช้เห็นในแถบที่อยู่\n\nช่อง shortcut สอดคล้องกับคีย์เวิร์ดที่ผู้ใช้ป้อนเพื่อเรียกใช้การค้นหา ทางลัดมีคำและอักขระธรรมดาได้ แต่ต้องไม่มีการเว้นวรรคหรือเริ่มต้นด้วยสัญลักษณ์ @ และทางลัดต้องไม่ซ้ำกัน\n\nช่อง search_url จะระบุ URL ที่จะค้นหา ป้อนที่อยู่เว็บสำหรับหน้าผลการค้นหาของเครื่องมือค้นหา แล้วใช้ '{searchTerms}' แทนตำแหน่งที่เป็นคำค้นหา\n\nช่อง suggest_url จะระบุ URL ที่ให้การแนะนำการค้นหา ระบบจะสร้างคำขอ POST และส่งคำค้นหาของผู้ใช้ในพารามิเตอร์ POST ภายใต้คีย์ 'query'\n\nช่อง icon_url จะระบุ URL ไปยังรูปภาพที่จะใช้ในการแนะนำการค้นหา ระบบจะใช้ไอคอนเริ่มต้นเมื่อไม่ได้ตั้งค่าช่องนี้ ขอแนะนำให้ใช้ไอคอน Fav (ตัวอย่าง https://www.google.com/favicon.ico) รูปแบบไฟล์ภาพที่รองรับ ได้แก่ JPEG, PNG และ ICO\n\nช่อง require_shortcut จะระบุว่าต้องใช้แถบที่อยู่ shortcut เพื่อดูการแนะนำการค้นหาหรือไม่ หากจำเป็น ระบบจะไม่แสดงคำแนะนำในช่องค้นหาบนหน้าแท็บใหม่ แต่จะแสดงในแถบอเนกประสงค์ (แถบที่อยู่) ในโหมดการค้นหาแบบมีขอบเขตต่อไป หากไม่ได้ตั้งค่าช่องนี้ ก็ไม่จำเป็นต้องใช้แถบที่อยู่ shortcut\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "ปิดใช้คำเตือนตามนามสกุลของไฟล์สำหรับการดาวน์โหลด";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "คุณสามารถเปิดใช้นโยบายนี้เพื่อสร้างพจนานุกรมนามสกุลของไฟล์โดยใช้รายชื่อโดเมนที่เกี่ยวข้อง ซึ่งจะได้รับการยกเว้นในคำเตือนการดาวน์โหลดตามนามสกุลของไฟล์ วิธีนี้ช่วยให้ผู้ดูแลระบบขององค์กรบล็อกคำเตือนการดาวน์โหลดตามนามสกุลของไฟล์สำหรับไฟล์ที่เชื่อมโยงกับโดเมนที่ระบุไว้ได้ ตัวอย่างเช่น หากนามสกุล \"jnlp\" เชื่อมโยงกับ \"website1.com\" ผู้ใช้จะไม่เห็นคำเตือนเมื่อดาวน์โหลดไฟล์ \"jnlp\" จาก \"website1.com\" แต่จะเห็นคำเตือนการดาวน์โหลดเมื่อดาวน์โหลดไฟล์ \"jnlp\" จาก \"website2.com\"\n\nไฟล์ซึ่งมีนามสกุลที่ระบุไว้สำหรับโดเมนที่นโยบายนี้กำหนดจะยังได้รับคำเตือนด้านความปลอดภัยตามนามสกุลของไฟล์อยู่ เช่น คำเตือนการดาวน์โหลดเนื้อหาผสมและคำเตือน Google Safe Browsing\n\nหากปิดใช้นโยบายนี้หรือไม่กำหนดค่า ประเภทไฟล์ที่ทำให้เกิดคำเตือนการดาวน์โหลดตามนามสกุลของไฟล์จะแสดงคำเตือนแก่ผู้ใช้\n\nหากเปิดใช้นโยบายนี้\n\n* URL ควรมีรูปแบบตามที่ระบุไว้ใน https://chromeenterprise.google/policies/url-patterns/\n\n* นามสกุลของไฟล์ที่ป้อนควรเป็น ASCII ตัวพิมพ์เล็ก ไม่ควรใส่ตัวคั่นข้างหน้าเมื่อระบุนามสกุลของไฟล์ เช่น ให้ใช้ \"jnlp\" แทน \".jnlp\"\n\nตัวอย่างเช่น\n\nค่าตัวอย่างต่อไปนี้เป็นการป้องกันไม่ให้คำเตือนการดาวน์โหลดตามนามสกุลของไฟล์ \"exe\" และ \"jnlp\" แสดงเมื่อดาวน์โหลดจากโดเมน *.example.com และนามสกุลของไฟล์ \"swf\" เมื่อดาวน์โหลดจากโดเมนทั้งหมด และจะแสดงคำเตือนการดาวน์โหลดตามนามสกุลของไฟล์แก่ผู้ใช้สำหรับไฟล์ exe และ jnlp จากโดเมนอื่น แต่ไม่แสดงสำหรับไฟล์ swf\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nโปรดทราบว่าแม้ตัวอย่างข้างต้นจะแสดงการระงับคำเตือนการดาวน์โหลดตามนามสกุลของไฟล์ \"swf\" จากทุกโดเมน แต่ก็ไม่แนะนำให้ใช้การระงับคำเตือนเช่นนี้กับทุกโดเมนสำหรับนามสกุลของไฟล์ที่เป็นอันตรายเนื่องจากข้อกังวลด้านความปลอดภัย ตัวอย่างดังกล่าวเป็นเพียงการสาธิตความสามารถในการระงับคำเตือนเท่านั้น\n\nหากเปิดใช้นโยบายนี้ควบคู่กับ DownloadRestrictions การยกเว้นคำเตือนตามนามสกุลของไฟล์ที่นโยบายนี้ระบุไว้จะมีความสำคัญเหนือกว่าการตั้งค่า DownloadRestrictions ซึ่งจะบล็อกประเภทไฟล์ที่เป็นอันตราย การยกเว้นที่นโยบายนี้ระบุไว้จะมีผลกับลักษณะการทำงาน \"บล็อกประเภทไฟล์ที่เป็นอันตราย\" ที่ระบุโดยค่า 1 และ 2 ของ DownloadRestrictions เท่านั้น\n\nตัวอย่างเช่น หากนโยบายนี้ระบุให้ยกเว้นการดาวน์โหลดไฟล์ \"exe\" จาก \"website1.com\" และตั้งค่า DownloadRestrictions ให้บล็อกการดาวน์โหลดและประเภทไฟล์ที่เป็นอันตราย (ค่า 1) การดาวน์โหลดไฟล์ \"exe\" จาก \"website1.com\" จะได้รับการยกเว้นจากการบล็อกตามนามสกุลของไฟล์ แต่จะยังคงถูกบล็อกหากเป็นไฟล์ที่เป็นอันตราย\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับ DownloadRestrictions ได้ที่ https://chromeenterprise.google/policies/?policy=DownloadRestrictions\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings";
ExplicitlyAllowedNetworkPorts.pfm_title = "พอร์ตเครือข่ายที่ได้รับอนุญาตอย่างชัดแจ้ง";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - พอร์ต 554 (เลิกบล็อกได้จนถึง 15/10/2021)\n10080 - พอร์ต 10080 (เลิกบล็อกได้จนถึง 01/04/2022)\n6566 - พอร์ต 6566 (เลิกบล็อกได้จนถึง 15/10/2021)\n989 - พอร์ต 989 (เลิกบล็อกได้จนถึง 01/02/2022)\n990 - พอร์ต 990 (เลิกบล็อกได้จนถึง 01/02/2022)\nBrave มีรายการพอร์ตที่จำกัดอยู่ในตัว ซึ่งจะทำให้การเชื่อมต่อพอร์ตเหล่านี้ไม่สำเร็จ การตั้งค่านี้อนุญาตให้ข้ามรายการดังกล่าว ค่าดังกล่าวเป็นรายการที่คั่นด้วยคอมมาของพอร์ตจำนวน 0 พอร์ตขึ้นไปที่จะได้รับอนุญาตให้เชื่อมต่อขาออก\n\nระบบจะจำกัดพอร์ตเพื่อป้องกันไม่ให้มีการใช้ Brave เป็นเวกเตอร์ในการแสวงหาประโยชน์จากช่องโหว่ต่างๆ ในเครือข่าย การตั้งค่านโยบายนี้อาจทำให้เครือข่ายเสี่ยงต่อการถูกโจมตี นโยบายนี้มีไว้เพื่อเป็นวิธีแก้ปัญหาชั่วคราวสำหรับข้อผิดพลาดที่มีรหัส \"ERR_UNSAFE_PORT\" ขณะย้ายข้อมูลบริการที่ทำงานในพอร์ตที่ถูกบล็อกไปยังพอร์ตมาตรฐาน (เช่น พอร์ต 80 หรือ 443)\n\nเว็บไซต์ที่เป็นอันตรายจะตรวจพบได้โดยง่ายว่ามีการตั้งค่านโยบายนี้ ตลอดจนพอร์ตที่มีการตั้งค่านโยบาย และใช้ข้อมูลดังกล่าวเพื่อกำหนดเป้าหมายการโจมตี\n\nพอร์ตแต่ละพอร์ตใน Chrome มีป้ายกำกับวันที่สิ้นสุดการเลิกบล็อก หลังจากวันดังกล่าว พอร์ตจะถูกจำกัดไม่ว่าการตั้งค่านี้จะเป็นอย่างไร\n\nการไม่ระบุค่าหรือไม่ตั้งค่าหมายความว่าพอร์ตที่จำกัดทั้งหมดจะถูกบล็อก หากมีทั้งค่าที่ถูกต้องและไม่ถูกต้องผสมกัน ระบบจะใช้ค่าที่ถูกต้อง\n\nนโยบายนี้ลบล้างตัวเลือกบรรทัดคำสั่ง \"--explicitly-allowed-ports\"";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "รายการที่บล็อกของผู้ให้บริการข้อมูลประจําตัวที่ไม่สามารถใช้ SSO ของ Enterprise ที่ขยายได้สําหรับเบราว์เซอร์";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - ผู้ให้บริการข้อมูลประจำตัวทั้งหมด\nmicrosoft - ผู้ให้บริการข้อมูลประจำตัวในระบบคลาวด์ของ Microsoft®\nokta - ผู้ให้บริการข้อมูลประจำตัวในระบบคลาวด์ของ Okta®\nping - ผู้ให้บริการข้อมูลประจำตัวในระบบคลาวด์ของ Ping®\nปิดใช้การลงชื่อเพียงครั้งเดียวโดยใช้ Extensible Enterprise SSOสำหรับผู้ให้บริการข้อมูลประจำตัวที่ระบุไว้\n\nการเพิ่มค่า 'all' จะเป็นการปิดใช้ผู้ให้บริการข้อมูลประจำตัวทั้งหมดที่รองรับสำหรับ SSO\n\nการเพิ่มค่า 'microsoft' จะปิดใช้การสนับสนุนการลงชื่อเพียงครั้งเดียวสำหรับผู้ให้บริการข้อมูลประจำตัวในระบบคลาวด์ของ Microsoft® ใน Chrome\n\nหากไม่ตั้งค่านโยบายนี้ ระบบจะเปิดใช้ผู้ให้บริการข้อมูลประจำตัวทั้งหมดที่ Brave รองรับ\n\nสำหรับผู้ให้บริการข้อมูลประจำตัวที่เปิดใช้ใน Brave และกำหนดค่าไว้ในอุปกรณ์โดยผู้ดูแลระบบ ผู้ใช้ที่ลงชื่อเข้าใช้แอปพลิเคชันที่รองรับ Extensible Enterprise SSO 1 ครั้งโดยใช้ผู้ให้บริการข้อมูลประจำตัวดังกล่าวจะสามารถลงชื่อเข้าใช้ผลิตภัณฑ์และบริการบนอินเทอร์เน็ตได้โดยใช้ผู้ให้บริการข้อมูลประจำตัวรายนั้นโดยอัตโนมัติ ระบบจะส่งข้อมูลที่เกี่ยวข้องกับการตรวจสอบสิทธิ์ของผู้ใช้ไปยังผู้ให้บริการข้อมูลประจำตัวในระบบคลาวด์ของผู้ใช้เมื่อเกิดเหตุการณ์การตรวจสอบสิทธิ์แต่ละครั้ง\n\nหมายเหตุ:\n\nBrave ไม่รองรับการลงชื่อเพียงครั้งเดียวโดยใช้ Extensible Enterprise SSOในโหมดไม่ระบุตัวตนหรือโหมดผู้มาเยือน\n\nBrave รองรับการลงชื่อเพียงครั้งเดียวโดยใช้ Extensible Enterprise SSOสำหรับผู้ให้บริการข้อมูลประจำตัวต่อไปนี้เท่านั้น ได้แก่ Microsoft, Okta, Ping\n\nฟีเจอร์นี้มีให้บริการใน macOS 10.15 เป็นต้นไป";
ExtensionAllowedTypes.pfm_title = "ประเภทของส่วนขยาย/แอปพลิเคชันที่ได้รับอนุญาตให้ติดตั้ง";
ExtensionAllowedTypes.pfm_description = "extension - ส่วนขยาย\ntheme - ธีม\nuser_script - สคริปต์ของผู้ใช้\nhosted_app - แอปที่โฮสต์\nlegacy_packaged_app - แอปแพ็กเกจเดิม\nplatform_app - แอปแพลตฟอร์ม\nการตั้งค่านโยบายนี้จะกำหนดแอปและส่วนขยายที่ติดตั้งใน Brave ได้ โฮสต์ที่แอปและส่วนขยายนั้นโต้ตอบด้วยได้ และจำกัดการเข้าถึงรันไทม์\n\nการไม่ตั้งค่านโยบายจะทำให้ไม่มีข้อจำกัดใดๆ สำหรับประเภทของส่วนขยายและแอปที่ยอมรับได้\n\nส่วนขยายและแอปซึ่งเป็นประเภทที่ไม่ได้อยู่ในรายการจะติดตั้งไม่ได้ แต่ละค่าควรเป็นสตริงรายการใดรายการหนึ่งต่อไปนี้\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\nดูรายละเอียดเพิ่มเติมเกี่ยวกับประเภทเหล่านี้ได้ในเอกสารประกอบส่วนขยายของ Brave\n\nระบบไม่รองรับการใช้รหัสส่วนขยายหลายรายการที่คั่นด้วยจุลภาคในเวอร์ชันก่อน 75 และจะข้ามรหัสดังกล่าวไป นโยบายส่วนที่เหลือจะมีผลบังคับใช้\n\nหมายเหตุ: นโยบายนี้ส่งผลต่อส่วนขยายและแอปที่จะบังคับติดตั้งโดยใช้ ExtensionInstallForcelist ด้วย\n\nหมายเหตุ: นโยบายนี้มีผลเฉพาะกับแพลตฟอร์มที่รองรับส่วนขยาย";
ExtensionDeveloperModeSettings.pfm_title = "ควบคุมความพร้อมใช้งานของโหมดนักพัฒนาซอฟต์แวร์ในหน้าส่วนขยาย";
ExtensionDeveloperModeSettings.pfm_description = "0 - อนุญาตให้ใช้โหมดนักพัฒนาซอฟต์แวร์ในหน้าส่วนขยาย\n1 - ไม่อนุญาตให้ใช้โหมดนักพัฒนาซอฟต์แวร์ในหน้าส่วนขยาย\nควบคุมว่าผู้ใช้จะเปิดโหมดนักพัฒนาซอฟต์แวร์ใน chrome://extensions ได้หรือไม่\n\nหากไม่ได้ตั้งค่านโยบาย ผู้ใช้จะเปิดโหมดนักพัฒนาซอฟต์แวร์ในหน้าส่วนขยายได้ เว้นแต่ว่านโยบาย DeveloperToolsAvailability ตั้งค่าเป็น DeveloperToolsDisallowed (2)\nหากตั้งค่านโยบายเป็น Allow (0) ผู้ใช้จะเปิดโหมดนักพัฒนาซอฟต์แวร์ในหน้าส่วนขยายได้\nหากตั้งค่านโยบายเป็น Disallow (1) ผู้ใช้จะเปิดโหมดนักพัฒนาซอฟต์แวร์ในหน้าส่วนขยายไม่ได้\n\nหากตั้งค่านโยบายนี้ไว้ DeveloperToolsAvailability จะไม่สามารถควบคุมโหมดนักพัฒนาซอฟต์แวร์สำหรับส่วนขยายได้อีกต่อไป\n\nหมายเหตุ: นโยบายนี้มีผลเฉพาะกับแพลตฟอร์มที่รองรับส่วนขยาย";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "กำหนดค่ารายการต้นทางที่ยืดอายุการใช้งานในเบื้องหลังให้กับส่วนขยายที่เชื่อมต่อ";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "ส่วนขยายที่เชื่อมต่อกับหนึ่งในต้นทางเหล่านี้จะยังคงทำงานอยู่ตราบใดที่มีการเชื่อมต่อพอร์ต\n\nหากไม่ได้ตั้งค่า ระบบจะใช้ค่าเริ่มต้นของนโยบาย รายการต่อไปนี้เป็นต้นทางของแอปที่ให้บริการ SDK ซึ่งทราบแล้วว่าไม่อนุญาตให้คุณรีสตาร์ทการเชื่อมต่อแบบปิดเป็นสถานะก่อนหน้า\n- เครื่องมือเชื่อมต่อสมาร์ทการ์ด\n- ตัวรับ Citrix (เวอร์ชันเสถียร เบต้า สำรอง)\n- VMware Horizon (เวอร์ชันเสถียร เบต้า)\n\nหากตั้งค่าไว้ ระบบจะขยายรายการค่าเริ่มต้นด้วยค่าที่กำหนดไว้ใหม่ ทั้งค่าเริ่มต้นและรายการที่ได้จากนโยบายจะยกเว้นส่วนขยายที่เชื่อมต่อ ตราบใดที่มีการเชื่อมต่อพอร์ตอยู่";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "เปิดใช้ส่วนขยายที่ติดตั้งตามนโยบายซึ่งลบล้างการตั้งค่าการค้นหาเริ่มต้นหรือหน้าแท็บใหม่";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "ควบคุมว่าจะอนุญาตส่วนขยายที่ติดตั้งตามนโยบาย (บังคับติดตั้งหรือแนะนำ) ซึ่งลบล้างการตั้งค่าเครื่องมือค้นหาเริ่มต้นหรือหน้าแท็บใหม่ในสภาพแวดล้อมที่มีความน่าเชื่อถือต่ำหรือไม่\n\nนโยบายนี้มีผลเฉพาะกับสภาพแวดล้อมที่มีความน่าเชื่อถือต่ำ (เช่น อุปกรณ์ที่มีการกำหนดค่านโยบายในเครื่องโดยไม่มีการจัดการโดเมนหรือระบบคลาวด์) สภาพแวดล้อมที่มีความน่าเชื่อถือสูงจะไม่ได้รับผลกระทบ\n\nใน Microsoft® Windows® นโยบายนี้ใช้ไม่ได้ในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ไม่ได้ในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core\n\nส่วนขยายที่ติดตั้งตามนโยบายซึ่งลบล้างการตั้งค่าเครื่องมือค้นหาเริ่มต้นหรือหน้าแท็บใหม่จะยังคงเปิดใช้อยู่ในอินสแตนซ์ที่มีความน่าเชื่อถือสูงเหล่านี้\n\nเมื่อตั้งค่าเป็น \"เปิดใช้\" Brave จะอนุญาตให้ติดตั้งส่วนขยายที่ติดตั้งตามนโยบายซึ่งลบล้างการตั้งค่าเครื่องมือค้นหาเริ่มต้นหรือหน้าแท็บใหม่ และยังคงเปิดใช้อยู่ในสภาพแวดล้อมที่มีความน่าเชื่อถือต่ำ\n\nเมื่อตั้งค่าเป็น \"ปิดใช้\" หรือไม่ได้กำหนดค่า Brave จะป้องกันไม่ให้มีการติดตั้งส่วนขยายที่ติดตั้งตามนโยบายซึ่งลบล้างการตั้งค่าเครื่องมือค้นหาเริ่มต้นหรือหน้าแท็บใหม่ในสภาพแวดล้อมที่มีความน่าเชื่อถือต่ำ และจะนำส่วนขยายดังกล่าวออกหากติดตั้งไว้แล้ว\n\nหากส่วนขยายที่ได้รับผลกระทบได้รับการอัปเดตเพื่อไม่ให้ลบล้างการตั้งค่าเหล่านี้อีกต่อไป Brave จะติดตั้งส่วนขยายดังกล่าวโดยอัตโนมัติภายใน 7 วัน\n\nนโยบายนี้เป็นนโยบายชั่วคราวและจะถูกนำออกเมื่อมีการปล่อยเวอร์ชันใหม่ในอนาคต";
ExtensionInstallAllowlist.pfm_title = "รหัสส่วนขยายที่ได้รับการยกเว้นจากรายการที่บล็อก";
ExtensionInstallAllowlist.pfm_description = "การตั้งค่านโยบายนี้จะระบุว่าส่วนขยายใดบ้างไม่ขึ้นอยู่กับรายการที่บล็อก\n\nค่า * ในรายการที่บล็อกหมายความว่า ส่วนขยายทั้งหมดถูกบล็อก และผู้ใช้จะติดตั้งได้เฉพาะส่วนขยายที่ระบุไว้ในรายการที่อนุญาต\n\nส่วนขยายทั้งหมดได้รับอนุญาตโดยค่าเริ่มต้น แต่ถ้าคุณห้ามส่วนขยายด้วยนโยบาย ให้ใช้รายการส่วนขยายที่อนุญาตเพื่อเปลี่ยนแปลงนโยบายนั้น\n\nหมายเหตุ: นโยบายนี้มีผลเฉพาะกับแพลตฟอร์มที่รองรับส่วนขยาย";
ExtensionInstallBlocklist.pfm_title = "รหัสส่วนขยายที่ผู้ใช้ควรป้องกันไม่ให้มีการติดตั้ง (หรือ * สำหรับทั้งหมด)";
ExtensionInstallBlocklist.pfm_description = "ให้คุณระบุว่าส่วนขยายใดบ้างที่ผู้ใช้ติดตั้งไม่ได้ ระบบจะปิดใช้ส่วนขยายที่ติดตั้งแล้วหากถูกบล็อกโดยไม่มีวิธีให้ผู้ใช้เปิดใช้ เมื่อนำส่วนขยายที่ปิดใช้เนื่องจากอยู่ในรายการที่บล็อกออกแล้ว ระบบจะเปิดใช้อีกครั้งโดยอัตโนมัติ\n\nค่า \"*\" ในรายการที่บล็อกหมายความว่าส่วนขยายทั้งหมดถูกบล็อกโดยค่าเริ่มต้น ส่วนขยายที่แสดงอยู่ในรายการที่อนุญาตอย่างชัดเจนจะได้รับอนุญาต หากมีการลงนาม (การแพคข้อมูล) บล็อกส่วนขยายทั้งหมดที่ยังไม่ได้คลายการแพคข้อมูล\n\nหากไม่ได้ตั้งค่านโยบายนี้ ผู้ใช้จะติดตั้งส่วนขยายใดก็ได้ใน Brave\n\nหมายเหตุ: นโยบายนี้มีผลเฉพาะกับแพลตฟอร์มที่รองรับส่วนขยาย";
ExtensionInstallForcelist.pfm_title = "รหัสส่วนขยาย/แอปและ URL การอัปเดตจะติดตั้งอยู่ในพื้นหลัง";
ExtensionInstallForcelist.pfm_description = "การตั้งค่านโยบายจะระบุรายชื่อแอปและส่วนขยายที่ติดตั้งแบบเงียบ (ไม่ต้องมีการโต้ตอบจากผู้ใช้) และผู้ใช้จะถอนการติดตั้งหรือปิดใช้ผ่านอินเทอร์เฟซ Brave ไม่ได้ ระบบจะให้สิทธิ์โดยปริยาย ซึ่งรวมถึงสิทธิ์การใช้ API ของส่วนขยาย enterprise.deviceAttributes และ enterprise.platformKeys (API ทั้งสองนี้ใช้ไม่ได้กับแอปและส่วนขยายที่ไม่ได้บังคับติดตั้ง)\n\nแม้ว่า Brave มีเป้าหมายที่จะป้องกันไม่ให้ผู้ใช้ถอนการติดตั้งส่วนขยายเหล่านี้ แต่ระบบปฏิบัติการบางระบบทำให้ Brave ไม่สามารถป้องกันได้อย่างมีประสิทธิภาพหากมีการแก้ไขส่วนขยายจากภายนอก ดังนั้นการดำเนินการป้องกันนี้จึงนับว่าทำได้ดีที่สุดแล้ว\n\nหากไม่ตั้งค่านโยบายนี้ จะไม่มีแอปหรือส่วนขยายใดที่ติดตั้งโดยอัตโนมัติ และผู้ใช้จะถอนการติดตั้งแอปหรือส่วนขยายใดก็ได้ใน Brave\n\nนโยบายนี้จะมีผลแทนนโยบาย ExtensionInstallBlocklist หากมีการนำแอปหรือส่วนขยายที่บังคับติดตั้งก่อนหน้านี้ออกจากรายชื่อนี้ Brave จะถอนการติดตั้งแอปหรือส่วนขยายนั้นโดยอัตโนมัติ\n\nผู้ใช้จะแก้ไขซอร์สโค้ดของส่วนขยายใดๆ ผ่านเครื่องมือสำหรับนักพัฒนาซอฟต์แวร์ได้ ซึ่งอาจทำให้ส่วนขยายทำงานผิดปกติ หากกังวลว่าจะเกิดปัญหานี้ขึ้น ให้ตั้งค่านโยบาย DeveloperToolsDisabled\n\nแต่ละรายการของนโยบายเป็นสตริงที่มีรหัสส่วนขยาย และอาจมี URL อัปเดตที่คั่นด้วยเซมิโคลอน (;) รหัสส่วนขยายคือสตริงตัวอักษร 32 ตัว เช่น ที่พบใน chrome://extensions เมื่ออยู่ในโหมดนักพัฒนาซอฟต์แวร์ URL อัปเดต (หากระบุไว้) ควรชี้ไปยังเอกสาร Manifest XML ของการอัปเดต (https://developer.chrome.com/extensions/autoupdate) URL อัปเดตควรใช้รูปแบบ http, https หรือ file ระบบจะใช้ URL อัปเดตของ Chrome เว็บสโตร์โดยค่าเริ่มต้น URL อัปเดตที่กำหนดไว้ในนโยบายนี้จะใช้สำหรับการติดตั้งครั้งแรกเท่านั้น ส่วนการอัปเดตส่วนขยายในครั้งต่อๆ ไปจะใช้ URL อัปเดตในไฟล์ Manifest ของส่วนขยาย ลบล้าง URL อัปเดตสำหรับการอัปเดตในครั้งต่อๆ ไปได้โดยใช้นโยบาย ExtensionSettings โปรดดูที่ http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy\n\nในอินสแตนซ์ Microsoft® Windows® จะบังคับติดตั้งแอปและส่วนขยายที่ไม่ได้มาจาก Chrome เว็บสโตร์ได้เฉพาะในกรณีที่อินสแตนซ์นั้นเข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nในอินสแตนซ์ macOS จะบังคับติดตั้งแอปและส่วนขยายที่ไม่ได้มาจาก Chrome เว็บสโตร์ได้เฉพาะในกรณีที่อินสแตนซ์นั้นจัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core\n\nหมายเหตุ: นโยบายนี้ไม่มีผลกับโหมดไม่ระบุตัวตน อ่านเกี่ยวกับการโฮสต์ส่วนขยาย ( https://developer.chrome.com/extensions/hosting)\n\nหมายเหตุ: นโยบายนี้มีผลเฉพาะกับแพลตฟอร์มที่รองรับส่วนขยาย";
ExtensionInstallSources.pfm_title = "รูปแบบ URL ที่อนุญาตส่วนขยาย แอปพลิเคชัน และการติดตั้งสคริปต์ของผู้ใช้จาก";
ExtensionInstallSources.pfm_description = "การตั้งค่านโยบายจะระบุ URL ที่ติดตั้งส่วนขยาย แอป และธีมได้ ก่อน Brave 21 ผู้ใช้คลิกลิงก์เพื่อไปยังไฟล์ *.crx ได้ จากนั้น Brave จะเสนอให้ติดตั้งไฟล์หลังจากแสดงคำเตือน 2-3 รายการ แต่ในเวอร์ชันต่อมา จะต้องมีการดาวน์โหลดไฟล์ดังกล่าวและลากไปที่หน้าการตั้งค่า Brave การตั้งค่านี้อนุญาตให้บาง URL มีขั้นตอนการติดตั้งแบบเก่าแต่ใช้งานง่ายกว่าได้\n\nแต่ละรายการในลิสต์นี้เป็นรูปแบบการจับคู่สไตล์ส่วนขยาย (ดู https://developer.chrome.com/extensions/match_patterns) ผู้ใช้จะติดตั้งรายการต่างๆ ได้โดยง่ายจาก URL ที่ตรงกับรายการในลิสต์นี้ ทั้งตำแหน่งของไฟล์ *.crx และหน้าเว็บที่เริ่มการดาวน์โหลด (URL ที่มา) จะต้องได้รับอนุญาตจากรูปแบบเหล่านี้\n\nExtensionInstallBlocklist จะมีความสำคัญเหนือนโยบายนี้ ซึ่งหมายความว่าระบบจะไม่ติดตั้งส่วนขยายที่อยู่ในรายการที่บล็อก แม้ว่าจะปรากฏอยู่ในเว็บไซต์ในลิสต์นี้ก็ตาม\n\nหมายเหตุ: นโยบายนี้มีผลเฉพาะกับแพลตฟอร์มที่รองรับส่วนขยาย";
ExtensionInstallTypeBlocklist.pfm_title = "รายการที่บล็อกสำหรับประเภทส่วนขยายที่ติดตั้ง";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - บล็อกไม่ให้โหลดส่วนขยายจากบรรทัดคำสั่ง\nรายการที่บล็อกจะควบคุมว่าส่วนขยายประเภทใดที่ไม่อนุญาตให้ติดตั้ง\n\nการตั้งค่า \"command_line\" จะบล็อกไม่ให้โหลดส่วนขยายจากบรรทัดคำสั่ง";
ExtensionReviewPromptsEnabled.pfm_title = "ควบคุมพรอมต์รีวิวส่วนขยายและลิงก์การให้คะแนน";
ExtensionReviewPromptsEnabled.pfm_description = "ควบคุมว่าจะให้พรอมต์รีวิวและลิงก์การให้คะแนนแบบเนทีฟ (เช่น \"ให้คะแนน\") สำหรับส่วนขยาย Chrome ที่ติดตั้งไว้พร้อมใช้งานในอินเทอร์เฟซผู้ใช้ Chrome หรือไม่\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ผู้ใช้อาจเห็นจุดแรกเข้าแบบเนทีฟเพื่อตรวจสอบและให้คะแนนส่วนขยายที่มีสิทธิ์ในแถบเครื่องมือ เมนูตามบริบท และหน้าการจัดการส่วนขยาย (chrome://extensions)\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ระบบจะระงับและไม่แสดงพรอมต์รีวิวและลิงก์การให้คะแนนแบบเนทีฟทั้งหมด";
ExtensionSettings.pfm_title = "การตั้งค่าการจัดการส่วนขยาย";
ExtensionSettings.pfm_description = "การตั้งค่านโยบายนี้จะควบคุมการตั้งค่าการจัดการส่วนขยายสำหรับ Brave ซึ่งรวมถึงการตั้งค่าที่ควบคุมโดยนโยบายเกี่ยวกับส่วนขยายที่มีอยู่\n\nนโยบายนี้จะจับคู่รหัสส่วนขยายหรือ URL อัปเดตกับการตั้งค่าที่เฉพาะเจาะจงของรายการนั้นๆ เท่านั้น คุณกำหนดค่าเริ่มต้นสำหรับรหัสพิเศษ \"*\" ได้ ซึ่งระบบจะใช้กับส่วนขยายทั้งหมดที่ไม่มีการกำหนดค่าเองในนโยบายนี้\n\nนโยบายนี้สามารถลบล้างการกำหนดค่าต่อส่วนขยายจากนโยบายเดิมได้\n\nโปรดทราบว่าการตั้งค่าส่วนขยายต่อรหัสจาก ExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist หรือ ExtensionSettings อย่างใดอย่างหนึ่งนี้ จะรับค่า \"installation_mode\" และ \"update_url\" จากค่าเริ่มต้นของ \"*\" มาใช้ต่อเท่านั้น โดยจะไม่รับค่าพร็อพเพอร์ตี้อื่นๆ เมื่อใช้ URL อัปเดต ระบบจะใช้การกำหนดค่ากับส่วนขยายที่มี URL อัปเดตตรงกับที่ระบุไว้ในไฟล์ Manifest ของส่วนขยาย ( http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy ) หากตั้งค่า Flag \"override_update_url\" เป็น \"จริง\" ระบบจะติดตั้งและอัปเดตส่วนขยายโดยใช้ URL \"อัปเดต\" ที่ระบุในนโยบาย ExtensionInstallForcelist หรือในช่อง \"update_url\" ในนโยบายนี้ ระบบจะไม่สนใจ Flag \"override_update_url\" หาก \"update_url\" คือ URL Chrome เว็บสโตร์\n\nตั้งแต่ Brave เวอร์ชัน 154 เป็นต้นไป การใช้ \"runtime_blocked_hosts\" กับส่วนขยายที่มีสิทธิ์ \"debugger\" จะปิดใช้ \"chrome.debugger.attach()\" ในเป้าหมายทั้งหมดโดยสมบูรณ์\n\nในอินสแตนซ์ Microsoft® Windows® จะบังคับติดตั้งแอปและส่วนขยายที่ไม่ได้มาจาก Chrome เว็บสโตร์ได้เฉพาะในกรณีที่อินสแตนซ์นั้นเข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nในอินสแตนซ์ macOS จะบังคับติดตั้งแอปและส่วนขยายที่ไม่ได้มาจาก Chrome เว็บสโตร์ได้เฉพาะในกรณีที่อินสแตนซ์นั้นจัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core\n\nหมายเหตุ: นโยบายนี้มีผลเฉพาะกับแพลตฟอร์มที่รองรับส่วนขยาย\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=ExtensionSettings";
ExtensionUnpublishedAvailability.pfm_title = "ควบคุมความพร้อมใช้งานของส่วนขยายที่ไม่ได้เผยแพร่ใน Chrome เว็บสโตร์";
ExtensionUnpublishedAvailability.pfm_description = "0 - อนุญาตส่วนขยายที่ไม่ได้เผยแพร่\n1 - ปิดใช้ส่วนขยายที่ไม่ได้เผยแพร่\nหากเปิดใช้นโยบายนี้ ระบบจะปิดใช้ส่วนขยายที่ไม่ได้เผยแพร่บน Chrome เว็บสโตร์ใน Brave\nนโยบายนี้มีผลกับส่วนขยายที่ติดตั้งและอัปเดตจาก Chrome เว็บสโตร์เท่านั้น\n\nระบบจะไม่สนใจส่วนขยายจากนอกสโตร์ เช่น ส่วนขยายที่คลายการแพคข้อมูลซึ่งติดตั้งโดยใช้โหมดนักพัฒนาซอฟต์แวร์และส่วนขยายที่ติดตั้งโดยใช้การเปลี่ยนบรรทัดคำสั่ง\nระบบจะไม่สนใจส่วนขยายที่บังคับติดตั้งซึ่งโฮสต์ด้วยตนเอง นอกจากนี้ ระบบจะไม่สนใจส่วนขยายที่ปักหมุดทุกเวอร์ชัน\n\nหากตั้งค่านโยบายเป็น AllowUnpublished (0) หรือไม่ได้ตั้งค่า ระบบจะอนุญาตส่วนขยายที่ไม่ได้เผยแพร่ใน Chrome เว็บสโตร์\nหากตั้งค่านโยบายเป็น DisableUnpublished (1) ระบบจะปิดใช้ส่วนขยายที่ไม่ได้เผยแพร่ใน Chrome เว็บสโตร์";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "แสดงช่องทำเครื่องหมาย \"เปิดตลอดเวลา\" ในกล่องโต้ตอบของโปรโตคอลภายนอก";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "นโยบายนี้กำหนดว่าจะมีการแสดงช่องทำเครื่องหมาย \"เปิดตลอดเวลา\" ในข้อความแจ้งยืนยันการเปิดใช้โปรโตคอลภายนอกหรือไม่\n\n     หากตั้งค่านโยบายนี้เป็น \"จริง\" หรือไม่ได้ตั้งค่า เมื่อการยืนยันโปรโตคอลภายนอกแสดงขึ้น ผู้ใช้จะเลือก \"อนุญาตเสมอ\" เพื่อข้ามข้อความแจ้งยืนยันทั้งหมดในอนาคตสำหรับโปรโตคอลดังกล่าวในเว็บไซต์นี้ได้\n\n     หากตั้งค่านโยบายนี้เป็น \"เท็จ\" ช่องทำเครื่องหมาย \"อนุญาตเสมอ\" จะไม่แสดง และระบบจะแสดงข้อความแจ้งแก่ผู้ใช้ทุกครั้งที่มีการเรียกใช้โปรโตคอลภายนอก";
FeedbackSurveysEnabled.pfm_title = "ระบุว่าจะแสดงแบบสำรวจในผลิตภัณฑ์ของ Brave ให้ผู้ใช้เห็นหรือไม่";
FeedbackSurveysEnabled.pfm_description = "แบบสำรวจในผลิตภัณฑ์ของ Brave จะรวบรวมความคิดเห็นของผู้ใช้สำหรับเบราว์เซอร์นี้ คำตอบจากแบบสำรวจจะไม่เชื่อมโยงกับบัญชีผู้ใช้\nเมื่อเปิดใช้นโยบายนี้หรือไม่ได้ตั้งค่า ระบบอาจแสดงแบบสำรวจในผลิตภัณฑ์ต่อผู้ใช้\nเมื่อปิดใช้นโยบายนี้ ระบบจะไม่แสดงแบบสำรวจในผลิตภัณฑ์ให้ผู้ใช้เห็น\n\nนโยบายนี้จะไม่มีผลหากตั้งค่า MetricsReportingEnabled เป็น \"ปิดใช้\" ซึ่งจะปิดใช้แบบสำรวจในผลิตภัณฑ์ด้วย";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "ดึงข้อมูลระยะเวลา Keepalive เมื่อปิดเบราว์เซอร์";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "ควบคุมระยะเวลา (เป็นวินาที) ที่อนุญาตให้มีคำขอ Keepalive เมื่อปิดเบราว์เซอร์\n\nเมื่อระบุ จะมีการบล็อกไม่ให้ปิดเบราว์เซอร์จนถึงจำนวนวินาทีที่ระบุเพื่อประมวลผลคำขอ Keepalive (https://fetch.spec.whatwg.org/#request-keepalive-flag)\n\nค่าเริ่มต้น (0) หมายถึงฟีเจอร์นี้ปิดใช้อยู่";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "อนุญาตให้เรียกใช้ File API หรือ Directory Picker API โดยไม่ต้องมีท่าทางสัมผัสของผู้ใช้ก่อนหน้า";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "เนื่องด้วยเหตุผลด้านความปลอดภัย API ของเว็บ\nshowOpenFilePicker(),\nshowSaveFilePicker() และ\nshowDirectoryPicker() จำเป็นต้องเรียกใช้การโต้ตอบจากผู้ใช้ก่อนหน้า (\"Transient Activation\") มิเช่นนั้นจะดำเนินการไม่สำเร็จ\n\nเมื่อตั้งค่านโยบายนี้ ผู้ดูแลระบบสามารถระบุต้นทางที่จะเรียกใช้ API เหล่านี้ได้โดยไม่ต้องมีการโต้ตอบจากผู้ใช้ก่อนหน้า\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่\nhttps://chromeenterprise.google/policies/url-patterns/ * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้\n\nหากไม่ได้ตั้งค่านโยบายนี้ ต้นทางทั้งหมดจะกำหนดให้ต้องมีการโต้ตอบจากผู้ใช้ก่อนหน้าเพื่อเรียกใช้ API เหล่านี้";
FileSystemReadAskForUrls.pfm_title = "อนุญาตสิทธิ์การเข้าถึงในการอ่านผ่าน File System API ในเว็บไซต์เหล่านี้";
FileSystemReadAskForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ขอให้ผู้ใช้ให้สิทธิ์การเข้าถึงในการอ่านไฟล์หรือไดเรกทอรีในระบบไฟล์ของระบบปฏิบัติการของโฮสต์ผ่าน File System API ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultFileSystemReadGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nรูปแบบ URL ต้องไม่ขัดแย้งกับ FileSystemReadBlockedForUrls ไม่มีนโยบายที่จะมีความสำคัญสูงกว่าหาก URL ตรงกับทั้ง 2 นโยบาย\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
FileSystemReadBlockedForUrls.pfm_title = "บล็อกสิทธิ์การเข้าถึงในการอ่านผ่าน File System API ในเว็บไซต์เหล่านี้";
FileSystemReadBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่สามารถขอให้ผู้ใช้ให้สิทธิ์การเข้าถึงในการอ่านไฟล์หรือไดเรกทอรีในระบบไฟล์ของระบบปฏิบัติการของโฮสต์ผ่าน File System API ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultFileSystemReadGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nรูปแบบ URL ต้องไม่ขัดแย้งกับ FileSystemReadAskForUrls ไม่มีนโยบายที่จะมีความสำคัญสูงกว่าหาก URL ตรงกับทั้ง 2 นโยบาย\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
FileSystemWriteAskForUrls.pfm_title = "อนุญาตสิทธิ์การเข้าถึงในการเขียนไฟล์และไดเรกทอรีในเว็บไซต์เหล่านี้";
FileSystemWriteAskForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ขอให้ผู้ใช้ให้สิทธิ์การเข้าถึงในการเขียนไฟล์หรือไดเรกทอรีในระบบไฟล์ของระบบปฏิบัติการของโฮสต์ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultFileSystemWriteGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nรูปแบบ URL ต้องไม่ขัดแย้งกับ FileSystemWriteBlockedForUrls ไม่มีนโยบายที่จะมีความสำคัญสูงกว่าหาก URL ตรงกับทั้ง 2 นโยบาย\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
FileSystemWriteBlockedForUrls.pfm_title = "บล็อกสิทธิ์การเข้าถึงในการเขียนไฟล์และไดเรกทอรีในเว็บไซต์เหล่านี้";
FileSystemWriteBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่สามารถขอให้ผู้ใช้ให้สิทธิ์การเข้าถึงในการอ่านไฟล์หรือไดเรกทอรีในระบบไฟล์ของระบบปฏิบัติการของโฮสต์ผ่าน File System API ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultFileSystemWriteGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nรูปแบบ URL ต้องไม่ขัดแย้งกับ FileSystemWriteAskForUrls ไม่มีนโยบายที่จะมีความสำคัญสูงกว่าหาก URL ตรงกับทั้ง 2 นโยบาย\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
ForceEphemeralProfiles.pfm_title = "โปรไฟล์ชั่วคราว";
ForceEphemeralProfiles.pfm_description = "หากตั้งค่าเป็นเปิดใช้นโยบาย นโยบายนี้จะบังคับให้โปรไฟล์เปลี่ยนเป็นโหมดชั่วคราว หากระบุนโยบายนี้เป็นนโยบาย OS (เช่น GPO ใน Windows) นโยบายจะใช้กับทุกโปรไฟล์บนระบบ หากตั้งค่านโยบายเป็นนโยบายระบบคลาวด์ นโยบายจะใช้กับโปรไฟล์ที่ลงชื่อเข้าใช้ด้วยบัญชีที่มีการจัดการเท่านั้น\n\nในโหมดนี้ ข้อมูลโปรไฟล์จะยังอยู่ในดิสก์เป็นเวลาเท่ากับเซสชันของผู้ใช้เท่านั้น จะไม่มีการเก็บฟีเจอร์ต่างๆ หลังปิดเบราว์เซอร์ เช่น ประวัติการเข้าชมของเบราว์เซอร์ ส่วนขยายและข้อมูลของส่วนขยาย ข้อมูลเว็บ เช่น คุกกี้และฐานข้อมูลเว็บ อย่างไรก็ตาม ผู้ใช้ยังคงสามารถดาวน์โหลดข้อมูลต่างๆ ลงในดิสก์ บันทึกหน้าหรือพิมพ์หน้าดังกล่าวด้วยตนเอง\n\nหากผู้ใช้ได้เปิดใช้การซิงค์ ข้อมูลทั้งหมดนี้จะเก็บไว้ในโปรไฟล์การซิงค์ของพวกเขาเหมือนกับโปรไฟล์ทั่วไป ทั้งนี้โหมดไม่ระบุตัวตนยังสามารถใช้งานได้หากไม่ได้ปิดใช้ตามนโยบาย\n\nหากตั้งค่าปิดใช้นโยบายหรือไม่ตั้งค่า การลงชื่อเข้าใช้จะนำไปสู่โปรไฟล์ทั่วไป";
ForceForegroundPriorityForAllTabs.pfm_title = "บังคับให้ทุกแท็บทำงานที่ลำดับความสำคัญเบื้องหน้า";
ForceForegroundPriorityForAllTabs.pfm_description = "นโยบายนี้ควบคุมว่าจะบังคับให้เนื้อหาเว็บเบื้องหลังทำงานที่ลำดับความสำคัญเบื้องหน้าหรือไม่\n\nโดยค่าเริ่มต้น เบราว์เซอร์จะเพิ่มประสิทธิภาพทรัพยากรโดยลดความสำคัญของเนื้อหาในแท็บเบื้องหลัง การเปิดใช้นโยบายนี้จะลบล้างลักษณะการทำงานดังกล่าว ทำให้ระบบกำหนดเวลาแท็บเบื้องหลังในลักษณะเดียวกับแท็บที่ใช้งานอยู่\n\nโปรดทราบว่าการบังคับให้เนื้อหาเบื้องหลังทำงานที่ลำดับความสำคัญเบื้องหน้าอาจส่งผลต่อการตอบสนองของแท็บที่ใช้งานอยู่เล็กน้อย\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" เนื้อหาเว็บทั้งหมดจะทำงานที่ลำดับความสำคัญเบื้องหน้า โดยไม่คำนึงถึงสถานะการมองเห็น\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า เบราว์เซอร์จะกำหนดลำดับความสำคัญตามแบบมาตรฐาน (เช่น ลดลำดับความสำคัญของเนื้อหาที่มองไม่เห็น ไม่เล่นเสียง ไม่เข้าร่วมวิดีโอคอล...)";
ForceForegroundPriorityForUrls.pfm_title = "บังคับให้ URL ที่ระบุทำงานที่ลำดับความสำคัญเบื้องหน้า";
ForceForegroundPriorityForUrls.pfm_description = "นโยบายนี้ช่วยให้คุณระบุรายการรูปแบบ URL ได้ ระบบจะบังคับให้เนื้อหาเว็บเบื้องหลังที่ตรงกับรูปแบบเหล่านี้ทำงานที่ลำดับความสำคัญเบื้องหน้า\n\nหากเปิดใช้นโยบาย ForceForegroundPriorityForAllTabs ระบบจะไม่สนใจรายการนี้เนื่องจากแท็บทั้งหมดจะถูกบังคับให้มีลำดับความสำคัญเบื้องหน้า\n\nหากปิดใช้หรือไม่ได้ตั้งค่า ForceForegroundPriorityForAllTabs ระบบจะบังคับใช้เฉพาะเนื้อหาที่ตรงกับรูปแบบในรายการนี้\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://support.google.com/chrome/a?p=url_blocklist_filter_format\n\nหากรายการนี้ว่างเปล่าหรือไม่ได้ตั้งค่าไว้ ระบบจะไม่บังคับให้เนื้อหาเบื้องหลังมีลำดับความสำคัญเบื้องหน้า";
ForceGoogleSafeSearch.pfm_title = "บังคับใช้ ฟีเจอร์ค้นหาปลอดภัยโดย Google";
ForceGoogleSafeSearch.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หมายความว่า \"ฟีเจอร์ค้นหาปลอดภัย\" ใน Google Search จะทำงานตลอดเวลาและผู้ใช้เปลี่ยนการตั้งค่านี้ไม่ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าหมายความว่า \"ฟีเจอร์ค้นหาปลอดภัย\" ใน Google Search จะไม่ทำงาน";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "ควบคุมว่าจะปิดใช้ตัวแฮนเดิลเหตุการณ์ unload ได้หรือไม่";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "ตัวแฮนเดิลเหตุการณ์ unload อยู่ระหว่างการเลิกใช้งาน ตัวแฮนเดิลเหล่านี้มีการทำงานหรือไม่ขึ้นอยู่กับ Permissions-Policy ของ unload ในปัจจุบัน โดยค่าเริ่มต้นตัวแฮนเดิลเหล่านี้ได้รับอนุญาตจากนโยบาย ในอนาคต สถานะของตัวแฮนเดิลดังกล่าวจะค่อยๆ เปลี่ยนไปเป็นไม่อนุญาตโดยค่าเริ่มต้น และเว็บไซต์ต่างๆ จะต้องเปิดใช้ตัวแฮนเดิลดังกล่าวอย่างชัดแจ้งโดยใช้ส่วนหัว Permissions-Policy คุณสามารถใช้นโยบายระดับองค์กรนี้เพื่อเลือกไม่รับการทยอยเลิกใช้งานนี้โดยบังคับให้ค่าเริ่มต้นยังคงเป็นเปิดใช้อยู่\n\nหน้าเว็บอาจต้องอาศัยตัวแฮนเดิลเหตุการณ์ unload เพื่อบันทึกข้อมูลหรือส่งสัญญาณการสิ้นสุดเซสชันของผู้ใช้ไปยังเซิร์ฟเวอร์ ซึ่งเราไม่แนะนำให้ใช้วิธีนี้เนื่องจากไม่น่าเชื่อถือและส่งผลต่อประสิทธิภาพจากการบล็อกการใช้ BackForwardCache ทั้งนี้มีทางเลือกอื่นที่แนะนำให้ใช้ อย่างไรก็ตาม มีการใช้เหตุการณ์ unload มานานแล้ว ซึ่งแอปพลิเคชันบางรายการอาจยังคงต้องอาศัยตัวแฮนเดิลเหล่านี้\n\nหากตั้งค่านโยบายนี้เป็น \"เท็จ\" หรือไม่ได้ตั้งค่า จะค่อยๆ มีการเลิกใช้งานตัวแฮนเดิลเหตุการณ์ unload ตามกำหนดการทยอยเลิกใช้งาน และเว็บไซต์ที่ไม่ได้ตั้งค่าส่วนหัว Permissions-Policy จะทำให้เหตุการณ์ \"ยกเลิกการโหลด\" เริ่มขึ้นไม่ได้\n\nหากตั้งค่านโยบายนี้เป็น \"จริง\" ตัวแฮนเดิลเหตุการณ์ unload จะยังคงทำงานต่อไปโดยค่าเริ่มต้น\n\nหมายเหตุ: นโยบายนี้มีค่าเริ่มต้นเป็น \"จริง\" ที่บันทึกไว้อย่างไม่ถูกต้องใน M117 เหตุการณ์ยกเลิกการโหลดไม่ได้มีการเปลี่ยนแปลงและจะไม่เปลี่ยนแปลงใน M117 นโยบายนี้จึงไม่ส่งผลใดๆ ในเวอร์ชันดังกล่าว\n";
ForceYouTubeRestrict.pfm_title = "บังคับใช้โหมดที่จำกัดระดับ YouTube เป็นอย่างน้อย";
ForceYouTubeRestrict.pfm_description = "0 - ไม่บังคับใช้โหมดที่จำกัดใน YouTube\n1 - บังคับใช้โหมดที่จำกัดปานกลางใน YouTube เป็นอย่างน้อย\n2 - บังคับใช้โหมดที่จำกัดอย่างเข้มงวดสำหรับ YouTube\nการตั้งค่านโยบายจะบังคับใช้โหมดที่จำกัดขั้นต่ำใน YouTube และป้องกันไม่ให้ผู้ใช้เลือกโหมดที่จำกัดต่ำกว่านี้ หากตั้งค่านี้เป็น\n\n* \"เข้มงวด\" ระบบจะใช้โหมดที่จำกัดเข้มงวดใน YouTube เสมอ\n\n* \"ปานกลาง\" ผู้ใช้อาจเลือกได้เฉพาะโหมดที่จำกัดปานกลางและโหมดที่จำกัดเข้มงวดใน YouTube แต่จะปิดใช้โหมดที่จำกัดไม่ได้\n\n* \"ปิด\" หรือไม่ได้ตั้งค่า Chrome จะไม่บังคับใช้โหมดที่จำกัดใน YouTube แต่นโยบายภายนอก เช่น นโยบายของ YouTube อาจยังคงบังคับใช้โหมดที่จำกัด";
ForcedLanguages.pfm_title = "กำหนดค่าเนื้อหาและลำดับภาษาที่ต้องการ";
ForcedLanguages.pfm_description = "นโยบายนี้ให้ผู้ดูแลระบบกำหนดค่าลำดับของภาษาที่ต้องการในการตั้งค่าของ Brave\n\nลำดับของรายการจะปรากฏในลำดับเดียวกันในส่วน \"เรียงลำดับภาษาตามความต้องการของคุณ\" ที่ chrome://settings/languages ผู้ใช้จะนำภาษาออกหรือเปลี่ยนลำดับภาษาที่นโยบายกำหนดไว้ไม่ได้ แต่จะเพิ่มภาษาใต้รายการที่นโยบายกำหนดไว้ได้ นอกจากนี้ยังสามารถควบคุมภาษาสำหรับ UI และการตั้งค่าการแปล/การตรวจตัวสะกดของเบราว์เซอร์ได้เต็มที่ เว้นแต่จะมีการบังคับใช้โดยนโยบายอื่น\n\nการไม่ตั้งค่านโยบายจะทำให้ผู้ใช้ดัดแปลงรายการภาษาที่ต้องการทั้งหมดได้";
GeminiActOnWebAllowedForURLs.pfm_title = "อนุญาตให้การผสานรวมแอป Gemini ดำเนินการในเว็บไซต์ที่ระบุโดยตรง";
GeminiActOnWebAllowedForURLs.pfm_description = "อนุญาตให้ตั้งค่ารายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่การผสานรวมแอป Gemini สามารถดำเนินการในหน้าเว็บโดยตรง\n\nURL ที่ไม่ตรงกับรายการที่อนุญาตหรือรายการที่บล็อกจะใช้ GeminiActOnWebSettings\n\nURL ที่ตรงกับทั้งรายการที่อนุญาตและรายการที่บล็อกจะได้รับอนุญาต\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://support.google.com/chrome/a?p=url_blocklist_filter_format";
GeminiActOnWebBlockedForURLs.pfm_title = "บล็อกการผสานรวมแอป Gemini เพื่อดำเนินการในเว็บไซต์ที่ระบุโดยตรง";
GeminiActOnWebBlockedForURLs.pfm_description = "อนุญาตให้ตั้งค่ารายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่การผสานรวมแอป Gemini ไม่สามารถดำเนินการในหน้าเว็บโดยตรง\n\nURL ที่ไม่ตรงกับรายการที่อนุญาตหรือรายการที่บล็อกจะใช้ GeminiActOnWebSettings\n\nURL ที่ตรงกับทั้งรายการที่อนุญาตและรายการที่บล็อกจะได้รับอนุญาต\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://support.google.com/chrome/a?p=url_blocklist_filter_format";
GeminiActOnWebSettings.pfm_title = "อนุญาตให้การผสานรวมแอป Gemini ดำเนินการในหน้าเว็บโดยตรง";
GeminiActOnWebSettings.pfm_description = "0 - อนุญาตให้แอป Gemini ดำเนินการในหน้าเว็บ\n1 - ไม่อนุญาตให้แอป Gemini ดำเนินการในหน้าเว็บ\nควบคุมว่าจะอนุญาตให้แอป Gemini ดำเนินการในหน้าเว็บในนามของผู้ใช้หรือไม่\n\n0/ไม่ได้ตั้งค่า  = แอป Gemini ได้รับอนุญาตให้ดำเนินการในหน้าเว็บ\n\n1 = แอป Gemini ไม่ได้รับอนุญาตให้ดำเนินการในหน้าเว็บ\n\nนโยบายนี้จะไม่มีผลเมื่อปิดใช้แอป Gemini เช่น นโยบาย GeminiSettings ปิดใช้งานแอป Gemini ได้\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับ Gemini ใน Chrome ได้ที่ https://support.google.com/chrome/a/answer/16291696\n\nการเปิดใช้งาน Gemini ไม่พร้อมให้บริการในบางประเทศหรือบางภาษา การตั้งค่านโยบายนี้ไม่ได้รับประกันว่าฟีเจอร์จะเปิดใช้งานได้ โดยจะขึ้นอยู่กับความพร้อมให้บริการ ดูข้อมูลเพิ่มเติมเกี่ยวกับการเปิดตัวได้ที่บันทึกประจำรุ่นของ Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=th";
GeminiSettings.pfm_title = "การตั้งค่าสำหรับการผสานรวม Gemini";
GeminiSettings.pfm_description = "0 - อนุญาตการผสานรวม Gemini\n1 - ไม่อนุญาตการผสานรวม Gemini\nการตั้งค่านี้อนุญาตให้มีการผสานรวมแอป Gemini\n\n0 = ผู้ใช้จะผสานรวม Gemini ได้\n\n1 = ผู้ใช้จะผสานรวม Gemini ไม่ได้\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nดูข้อมูลเพิ่มเติมได้ที่บทความในศูนย์ช่วยเหลือ https://support.google.com/chrome/a?p=gemini_in_chrome";
GeminiSparkSettings.pfm_title = "อนุญาตให้ Gemini Spark เชื่อมต่อกับ Brave และใช้การท่องเว็บอัตโนมัติผ่าน Gemini ใน Chrome";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark ได้รับอนุญาตให้เชื่อมต่อและใช้การท่องเว็บอัตโนมัติของ Brave\n1 - Gemini Spark ไม่ได้รับอนุญาตให้เชื่อมต่อหรือใช้การท่องเว็บอัตโนมัติของ Brave\nควบคุมว่าจะอนุญาตให้เอเจนต์ Gemini Spark เชื่อมต่อกับ Brave และใช้การท่องเว็บอัตโนมัติหรือไม่ องค์กรของคุณอาจใช้ Gemini Spark ไม่ได้\n\n0 = Gemini Spark ได้รับอนุญาตให้เชื่อมต่อและใช้การท่องเว็บอัตโนมัติของ Brave\n\n1 = Gemini Spark ไม่ได้รับอนุญาตให้เชื่อมต่อหรือใช้การท่องเว็บอัตโนมัติของ Brave\n\nคำเตือน: การอนุญาตให้ Gemini Spark เชื่อมต่อกับ Brave และใช้การท่องเว็บอัตโนมัติจะทำให้เอเจนต์ Gemini Spark ดำเนินการแบบอัตโนมัติหลายขั้นตอนในไคลเอ็นต์ Brave โดยใช้เซสชันเบราว์เซอร์ที่ใช้งานอยู่ได้ ซึ่งมีความเสี่ยงด้านความปลอดภัยที่สำคัญ รวมถึงความเสี่ยงด้านข้อมูลเข้าสู่ระบบ ขาเข้าของเครือข่ายภายใน และการสูญเสียสัญญาณที่คำนึงถึงบริบท ระบบอาจไม่ปฏิบัติตามการควบคุมการจัดการและความปลอดภัยที่มีอยู่\n\nผู้ดูแลระบบควรประเมินโมเดลภัยคุกคามเครือข่าย หลักเกณฑ์ด้านการปฏิบัติตามข้อกำหนดและความเป็นส่วนตัวขององค์กรอย่างรอบคอบก่อนเปิดใช้ฟีเจอร์นี้\n\nนโยบายนี้จะไม่มีผลเมื่อปิดใช้แอป Google Gemini หรือนโยบายการท่องเว็บอัตโนมัติของ Brave ตัวอย่างเช่น นโยบาย GeminiSettings สามารถปิดใช้งานแอป Google Gemini ได้ ดูข้อมูลเพิ่มเติมเกี่ยวกับ Google Gemini ใน Brave ได้ที่ https://support.google.com/chrome/a?p=gemini_in_chrome\n\nการท่องเว็บอัตโนมัติของ Brave และ Gemini Spark ไม่พร้อมให้บริการในบางประเทศหรือบางภาษา การตั้งค่านโยบายนี้เป็น 0 - เปิดใช้ ไม่ได้รับประกันว่าฟีเจอร์จะเปิดใช้งานได้ โดยจะขึ้นอยู่กับความพร้อมให้บริการ ดูข้อมูลเพิ่มเติมเกี่ยวกับการเปิดตัวได้ที่บันทึกประจำรุ่นของ Enterprise https://chromeenterprise.google/resources/release-notes/";
GenAILocalFoundationalModelSettings.pfm_title = "การตั้งค่าโมเดลพื้นฐานเฉพาะพื้นที่ของ GenAI";
GenAILocalFoundationalModelSettings.pfm_description = "0 - ดาวน์โหลดโมเดลโดยอัตโนมัติ\n1 - ไม่ดาวน์โหลดโมเดล\nกำหนดค่าวิธีที่ Brave ดาวน์โหลดโมเดล GenAI พื้นฐานและใช้สำหรับการอนุมานเป็นการภายใน\n\nเมื่อตั้งค่านโยบายเป็น \"อนุญาต\" (0) หรือไม่ได้ตั้งค่า ระบบจะดาวน์โหลดโมเดลโดยอัตโนมัติและใช้สำหรับการอนุมาน\n\nเมื่อตั้งค่านโยบายเป็น \"ปิดใช้\" (1) ระบบจะไม่ดาวน์โหลดโมเดล และจะลบโมเดลที่มีอยู่ (หากดาวน์โหลดไว้แล้ว)\n\nในแพลตฟอร์มเดสก์ท็อป อาจปิดใช้การดาวน์โหลดโมเดลได้เช่นกันโดยให้ตั้งค่า ComponentUpdatesEnabled เป็นเท็จ";
GeolocationBlockedForUrls.pfm_title = "บล็อกตำแหน่งทางภูมิศาสตร์ในเว็บไซต์เหล่านี้";
GeolocationBlockedForUrls.pfm_description = "การตั้งค่านโยบายช่วยให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่ได้รับอนุญาตให้เข้าถึงตำแหน่งทางภูมิศาสตร์ของผู้ใช้ และยังป้องกันไม่ให้ขอการให้สิทธิ์จากผู้ใช้เพื่อดำเนินการดังกล่าว\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultGeolocationSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "เปิดใช้แคชการตรวจสอบสิทธิ์ HTTP ที่มีขอบเขตทั่วไป";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "นโยบายนี้กำหนดค่าแคชต่อโปรไฟล์ทั่วไปรายการเดียวที่มีข้อมูลเข้าสู่ระบบสำหรับการตรวจสอบสิทธิ์ของเซิร์ฟเวอร์ HTTP\n\nหากไม่ได้ตั้งค่าหรือปิดใช้นโยบายนี้ เบราว์เซอร์จะใช้ลักษณะการทำงานเริ่มต้นของการตรวจสอบสิทธิ์แบบข้ามเว็บไซต์ ลักษณะการทำงานนี้จะกำหนดขอบเขตข้อมูลเข้าสู่ระบบสำหรับการตรวจสอบสิทธิ์ของเซิร์ฟเวอร์ HTTP ตามเว็บไซต์ระดับบน ดังนั้นหากเว็บไซต์ 2 แห่งใช้ทรัพยากรจากโดเมนการตรวจสอบสิทธิ์เดียวกัน คุณจะต้องระบุข้อมูลเข้าสู่ระบบไว้แยกกันในบริบทของเว็บไซต์ทั้ง 2 แห่ง ระบบจะนำข้อมูลเข้าสู่ระบบพร็อกซีที่แคชไว้มาใช้ซ้ำในเว็บไซต์ต่างๆ\n\nหากเปิดใช้นโยบายนี้ ระบบจะนำข้อมูลเข้าสู่ระบบสำหรับการตรวจสอบสิทธิ์ HTTP ที่ป้อนในบริบทของเว็บไซต์หนึ่งไปใช้ในบริบทของอีกเว็บไซต์หนึ่งโดยอัตโนมัติ\n\nการเปิดใช้นโยบายนี้จะทำให้เว็บไซต์เสี่ยงต่อการโจมตีแบบข้ามเว็บไซต์บางประเภท และจะอนุญาตให้มีการติดตามผู้ใช้ในเว็บไซต์ต่างๆ แม้จะไม่มีคุกกี้ ด้วยการเพิ่มรายการในแคชการตรวจสอบสิทธิ์ HTTP โดยใช้ข้อมูลเข้าสู่ระบบที่ฝังไว้ใน URL\n\nนโยบายนี้มีไว้เพื่อให้องค์กรต่างๆ มีโอกาสอัปเดตขั้นตอนการเข้าสู่ระบบขององค์กร ทั้งนี้ขึ้นอยู่กับลักษณะการทำงานเดิม และเราจะนำนโยบายนี้ออกในอนาคต";
GoogleSearchSidePanelEnabled.pfm_title = "เปิดใช้ Google Search Side Panel";
GoogleSearchSidePanelEnabled.pfm_description = "หากตั้งค่าเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าไว้ Google Search Side Panel จะได้รับอนุญาตในหน้าเว็บทุกหน้า\n\nหากตั้งค่าเป็น \"ปิดใช้\" Google Search Side Panel จะใช้งานไม่ได้ในหน้าเว็บทุกหน้า\n\nความสามารถของ GenAI ที่เป็นส่วนหนึ่งของฟีเจอร์นี้ไม่พร้อมใช้งานสำหรับบัญชี Education หรือ Enterprise";
HSTSPolicyBypassList.pfm_title = "รายชื่อที่จะข้ามการตรวจสอบตามนโยบาย HSTS";
HSTSPolicyBypassList.pfm_description = "การตั้งค่านโยบายจะเป็นการระบุรายชื่อโฮสต์ที่ไม่ต้องมีการอัปเกรด HSTS แบบโหลดล่วงหน้าจาก http เป็น https\n\nนโยบายนี้อนุญาตเฉพาะชื่อโฮสต์แบบป้ายกำกับเดี่ยวเท่านั้น และมีผลเฉพาะกับรายการที่โหลด HSTS ไว้ล่วงหน้าแบบ \"คงที่\" (เช่น \"app\", \"new\", \"search\", \"play\") นโยบายนี้ไม่ได้ป้องกันการอัปเกรด HSTS สำหรับเซิร์ฟเวอร์ที่ขอการอัปเกรด HSTS แบบ \"ไดนามิก\" โดยใช้ส่วนหัวการตอบกลับ Strict-Transport-Security\n\nชื่อโฮสต์ที่ระบุไว้ต้องกำหนดเป็น Canonical ซึ่งหมายความว่าต้องแปลง IDN ทั้งหมดเป็นรูปแบบ A-label และตัวอักษร ASCII ทั้งหมดต้องเป็นตัวพิมพ์เล็ก นโยบายนี้มีผลเฉพาะกับชื่อโฮสต์แบบป้ายกำกับเดี่ยวบางชื่อเท่านั้น ไม่ใช่กับโดเมนย่อยของชื่อเหล่านั้น";
HappyEyeballsV3Enabled.pfm_title = "ใช้อัลกอริทึม Happy Eyeballs V3";
HappyEyeballsV3Enabled.pfm_description = "ฟีเจอร์นี้เปิดใช้อัลกอริทึม Happy Eyeballs V3 เพื่อพยายามเชื่อมต่อ ดูรายละเอียดได้ที่ https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" หมายความว่า Brave จะใช้อัลกอริทึม Happy Eyeballs V3 เพื่อพยายามเชื่อมต่อ\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิดอัลกอริทึม Happy Eyeballs V3\n\nหากไม่ได้ตั้งค่านโยบาย Brave จะเปิดหรือปิดอัลกอริทึม Happy Eyeballs V3 ตาม chrome://flags/#happy-eyeballs-v3\n\nนโยบายนี้รองรับการรีเฟรชแบบไดนามิก\n\nนโยบายนี้เป็นมาตรการชั่วคราวและจะถูกนำออกในBrave เวอร์ชันต่อๆ ไป";
HardwareAccelerationModeEnabled.pfm_title = "ใช้การเร่งกราฟิกเมื่อพร้อมใช้งาน";
HardwareAccelerationModeEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะเปิดการเร่งกราฟิก (หากมี)\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิดการเร่งกราฟิก";
HeadlessMode.pfm_title = "ควบคุมการใช้โหมดไม่มีส่วนหัว";
HeadlessMode.pfm_description = "1 - อนุญาตให้ใช้โหมดไม่มีส่วนหัว\n2 - ไม่อนุญาตให้ใช้โหมดไม่มีส่วนหัว\nการตั้งค่านโยบายนี้เป็น Enabled หรือไม่ตั้งค่าจะอนุญาตให้ใช้โหมดไม่มีส่วนหัว การตั้งค่านโยบายนี้เป็น Disabled จะปฏิเสธการใช้โหมดไม่มีส่วนหัว";
HelpMeWriteSettings.pfm_title = "การตั้งค่าสำหรับ \"ช่วยฉันเขียน\"";
HelpMeWriteSettings.pfm_description = "0 - อนุญาตให้ใช้ฟีเจอร์ช่วยฉันเขียนและปรับปรุงโมเดล AI\n1 - อนุญาตให้ใช้ฟีเจอร์ช่วยฉันเขียนโดยไม่ปรับปรุงโมเดล AI\n2 - ไม่อนุญาตให้ใช้ฟีเจอร์ช่วยฉันเขียน\nฟีเจอร์ช่วยฉันเขียนเป็นผู้ช่วยในการเขียนเนื้อหาแบบสั้นในเว็บโดยใช้ AI เนื้อหาที่แนะนำจะอิงตามพรอมต์ที่ผู้ใช้ป้อนและเนื้อหาของหน้าเว็บ\n\n0 = อนุญาตให้ใช้ฟีเจอร์ พร้อมกับอนุญาตให้ Google ใช้ข้อมูลที่เกี่ยวข้องเพื่อปรับปรุงโมเดล AI ข้อมูลที่เกี่ยวข้องอาจรวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร โดยทั้งนี้จะขึ้นอยู่กับฟีเจอร์นั้นๆ รวมถึงเจ้าหน้าที่อาจตรวจสอบข้อมูลดังกล่าวเพื่อปรับปรุงโมเดล AI 0 คือค่าเริ่มต้น เว้นแต่จะระบุไว้ด้านล่าง\n\n1 = อนุญาตให้ใช้ฟีเจอร์ แต่ไม่อนุญาตให้ Google ปรับปรุงโมเดลโดยใช้เนื้อหาของผู้ใช้ (รวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร) 1 คือค่าเริ่มต้นสำหรับผู้ใช้ระดับองค์กรที่จัดการโดย Google Admin console และบัญชี Education ที่จัดการโดย Google Workspace\n\n2 = ไม่อนุญาตให้ใช้ฟีเจอร์\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
HideWebStoreIcon.pfm_title = "ซ่อนเว็บสโตร์จากหน้าแท็บใหม่และเครื่องเรียกใช้งานแอป";
HideWebStoreIcon.pfm_description = "ซ่อนแอป Chrome เว็บสโตร์ และลิงก์ส่วนท้ายจากหน้าแท็บใหม่ และเครื่องเรียกใช้งานแอป Google Chrome OS\n\nเมื่อนโยบายนี้ตั้งค่าเป็น True จะมีการซ่อนไอคอนไป\nเมื่อนโยบายนี้ตั้งค่าเป็น False หรือไม่มีการกำหนดค่า จะสามารถมองเห็นไอคอนได้";
HighEfficiencyModeEnabled.pfm_title = "เปิดใช้โหมดประสิทธิภาพสูง";
HighEfficiencyModeEnabled.pfm_description = "นโยบายนี้จะเปิดใช้หรือปิดใช้การตั้งค่าโหมดประสิทธิภาพสูง การตั้งค่านี้จะช่วยปิดแท็บหลังจากทำงานเบื้องหลังไประยะหนึ่งเพื่อเรียกคืนหน่วยความจำได้\nหากไม่ได้ตั้งค่านโยบายนี้ ผู้ใช้ปลายทางจะควบคุมการตั้งค่านี้ได้ใน chrome://settings/performance\n";
HistoryClustersVisible.pfm_title = "แสดงมุมมองประวัติการเข้าชมใน Chrome โดยแบ่งหน้าเว็บเป็นกลุ่มๆ";
HistoryClustersVisible.pfm_description = "นโยบายนี้ควบคุมการแสดงหน้าประวัติการเข้าชมใน Chrome ที่แบ่งออกเป็นกลุ่มๆ\n\nหากตั้งค่านโยบายเป็น \"เปิดใช้\" หน้าประวัติการเข้าชมใน Chrome ที่แบ่งออกเป็นกลุ่มๆ จะปรากฏที่ chrome://history/grouped\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" หน้าเหล่านี้จะไม่ปรากฏที่ chrome://history/grouped\n\nแต่หากไม่ได้ตั้งค่านโยบายก็จะปรากฏอยู่ที่ chrome://history/grouped โดยค่าเริ่มต้น\n\nโปรดทราบว่าหากตั้งค่านโยบาย ComponentUpdatesEnabled เป็น \"ปิดใช้\" แต่ตั้งค่า HistoryClustersVisible เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า หน้าประวัติการเข้าชมใน Chrome ที่แบ่งออกเป็นกลุ่มๆ จะยังคงปรากฏที่ chrome://history/grouped แต่อาจมีความเกี่ยวข้องกับผู้ใช้น้อยลง\n";
HistorySearchSettings.pfm_title = "การตั้งค่าสำหรับการค้นหาประวัติการเข้าชมซึ่งทำงานด้วยระบบ AI";
HistorySearchSettings.pfm_description = "0 - อนุญาตให้ฟีเจอร์การค้นหาประวัติการเข้าชมด้วย AI และปรับปรุงโมเดล AI\n1 - อนุญาตให้ใช้ฟีเจอร์การค้นหาประวัติการเข้าชมด้วย AI โดยไม่ปรับปรุงโมเดล AI\n2 - ไม่อนุญาตให้ใช้ฟีเจอร์การค้นหาประวัติการเข้าชมด้วย AI\nการค้นหาประวัติการเข้าชมด้วย AI เป็นฟีเจอร์ที่ช่วยให้ผู้ใช้ค้นหาประวัติการท่องเว็บและรับคำตอบที่สร้างขึ้นได้โดยใช้เนื้อหาในหน้า ไม่ใช่แค่ชื่อหน้าและ URL\n\n0 = อนุญาตให้ใช้ฟีเจอร์ พร้อมกับอนุญาตให้ Google ใช้ข้อมูลที่เกี่ยวข้องเพื่อปรับปรุงโมเดล AI ข้อมูลที่เกี่ยวข้องอาจรวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร โดยทั้งนี้จะขึ้นอยู่กับฟีเจอร์นั้นๆ รวมถึงเจ้าหน้าที่อาจตรวจสอบข้อมูลดังกล่าวเพื่อปรับปรุงโมเดล AI 0 คือค่าเริ่มต้น เว้นแต่จะระบุไว้ด้านล่าง\n\n1 = อนุญาตให้ใช้ฟีเจอร์ แต่ไม่อนุญาตให้ Google ปรับปรุงโมเดลโดยใช้เนื้อหาของผู้ใช้ (รวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร) 1 คือค่าเริ่มต้นสำหรับผู้ใช้ระดับองค์กรที่จัดการโดย Google Admin console และบัญชี Education ที่จัดการโดย Google Workspace\n\n2 = ไม่อนุญาตให้ใช้ฟีเจอร์\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
HomepageIsNewTabPage.pfm_title = "ใช้หน้าแท็บใหม่เป็นหน้าแรก";
HomepageIsNewTabPage.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" ทำให้หน้าแท็บใหม่เป็นหน้าแรกของผู้ใช้ โดยจะไม่สนใจตำแหน่ง URL ใดๆ ของหน้าแรก การตั้งค่านโยบายเป็น \"ปิดใช้\" หมายความว่าหน้าแรกจะไม่เป็นหน้าแท็บใหม่ เว้นแต่ URL หน้าแรกของผู้ใช้จะตั้งค่าไว้เป็น chrome://newtab\n\nหากคุณตั้งค่านโยบายนี้ ผู้ใช้จะเปลี่ยนประเภทหน้าแรกของตนใน Brave ไม่ได้ หากไม่ได้ตั้งค่า ผู้ใช้จะเป็นผู้ตัดสินใจว่าจะใช้หน้าแท็บใหม่เป็นหน้าแรกหรือไม่\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
HomepageLocation.pfm_title = "URL ของหน้าแรก";
HomepageLocation.pfm_description = "การตั้งค่านโยบายจะตั้งค่า URL หน้าแรกเริ่มต้นใน Brave คุณเปิดหน้าแรกโดยใช้ปุ่มหน้าแรก ในเดสก์ท็อป นโยบาย RestoreOnStartup จะควบคุมหน้าที่เปิดเมื่อเริ่มต้นใช้งาน\n\nหากผู้ใช้หรือ HomepageIsNewTabPage ตั้งค่าหน้าแรกเป็นหน้าแท็บใหม่ นโยบายนี้จะไม่มีผล\n\nURL ต้องเป็นรูปแบบมาตรฐาน เช่น http://example.com หรือ https://example.com เมื่อตั้งค่านโยบายนี้ ผู้ใช้จะเปลี่ยน URL หน้าแรกของตนใน Brave ไม่ได้\n\nการไม่ตั้งค่าทั้ง HomepageLocation และ HomepageIsNewTabPage จะทำให้ผู้ใช้เลือกหน้าแรกเองได้\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
HttpAllowlist.pfm_title = "รายการที่อนุญาตสำหรับ HTTP";
HttpAllowlist.pfm_description = "การตั้งค่านโยบายจะระบุรายชื่อโฮสต์หรือรูปแบบชื่อโฮสต์ (เช่น \"[*.]example.com\") ที่จะไม่ได้รับการอัปเกรดเป็น HTTPS และจะไม่แสดงข้อผิดพลาดคั่นระหว่างหน้าหากมีการเปิดใช้โหมด \"HTTPS ลำดับแรก\" องค์กรสามารถใช้นโยบายนี้เพื่อรักษาสิทธิ์เข้าถึงเซิร์ฟเวอร์ที่ไม่รองรับ HTTPS โดยไม่ต้องปิดใช้การอัปเกรด HTTPS และ/หรือโหมด \"HTTPS ลำดับแรก\"\n\nชื่อโฮสต์ที่ระบุไว้ต้องกำหนดเป็น Canonical ซึ่งหมายความว่าต้องแปลง IDN ทั้งหมดเป็นรูปแบบ A-label และตัวอักษร ASCII ทั้งหมดต้องเป็นตัวพิมพ์เล็ก\n\nไม่อนุญาตให้ใช้ไวลด์การ์ดโฮสต์แบบครอบคลุม (เช่น \"*\" หรือ \"[*]\") แต่ควรปิดใช้โหมด \"HTTPS ลำดับแรก\" และการอัปเกรด HTTPS อย่างชัดเจนผ่านนโยบายที่เฉพาะเจาะจงแทน\n\nหมายเหตุ: นโยบายนี้ไม่มีผลกับการอัปเกรด HSTS";
HttpHeaderInjection.pfm_title = "กำหนดค่าการแทรกส่วนหัว HTTP สำหรับรูปแบบ URL ที่เจาะจง";
HttpHeaderInjection.pfm_description = "นโยบายนี้ช่วยให้คุณกำหนดรายการกฎเพื่อแทรกส่วนหัว HTTP ที่กำหนดเองลงในคำขอเว็บที่ตรงกับรูปแบบ URL ที่เจาะจงได้ ส่วนหัวที่ตั้งค่าโดยนโยบายนี้จะมีความสำคัญเหนือส่วนหัวที่อยู่ในคำขอในตอนแรก รวมถึงการแก้ไขที่ผู้ใช้หรือส่วนขยายพยายามดำเนินการ\n\nUse Case ทั่วไปของนโยบายนี้คือการบังคับใช้การควบคุมการเข้าถึงกลุ่มผู้ใช้โดยการแทรกส่วนหัวที่กำหนดเอง (เช่น X-Tenant-ID)\n\nนโยบายนี้ยอมรับรายการกฎ กฎแต่ละข้อประกอบด้วย\n\n* patterns: รายการรูปแบบ URL ที่จะจับคู่ ดูวิธีจัดรูปแบบ URL ( https://support.google.com/chrome/a?p=url_blocklist_filter_format )\n\n* headers: รายการออบเจ็กต์ที่แสดงส่วนหัวที่จะแทรก ซึ่งแต่ละรายการประกอบด้วย\n\n* name: ชื่อส่วนหัวที่จะแทรก\n\n* value: ค่าของส่วนหัวที่จะแทรก\n\nหากกฎหลายข้อตรงกับคำขอ ระบบจะใช้ส่วนหัวจากกฎที่ตรงกันทั้งหมด ในกรณีที่มีส่วนหัวหลายรายการที่มีชื่อเดียวกัน ระบบจะใช้ส่วนหัวที่มีรูปแบบ URL ที่เจาะจงที่สุด หากรูปแบบมีความเจาะจงเท่ากัน ระบบจะใช้รูปแบบที่ปรากฏเป็นรายการสุดท้าย\n\nชื่อส่วนหัวต้องเป็นไปตาม RFC 2616 ( https://www.rfc-editor.org/rfc/rfc2616 ) ค่าส่วนหัวต้องไม่มีสัญลักษณ์ NUL, CR หรือ LF ส่วนหัวแต่ละรายการต้องมีขนาดไม่เกิน 8 KB ระบบจะไม่สนใจส่วนหัวและรูปแบบ URL ที่ไม่ถูกต้อง\n\nนโยบายนี้จำกัดรูปแบบ URL ทั้งหมดไว้ที่ 500 รูปแบบในทุกกฎ กฎแต่ละข้อมีส่วนหัวได้สูงสุด 20 รายการ ระบบจะไม่สนใจรูปแบบและส่วนหัวที่เกินเกณฑ์เหล่านี้\n\nหมายเหตุ: หากรูปแบบ URL ตรงกับรูปแบบที่ไม่ได้เข้ารหัส (http://, ws:// หรือเมื่อละเว้นรูปแบบ) ส่วนหัวที่กำหนดค่าไว้อาจส่งเป็นข้อความธรรมดาผ่านช่องทางที่ไม่ได้เข้ารหัสและอาจเปิดเผยต่อผู้สังเกตการณ์เครือข่าย หากต้องการปกป้องค่าส่วนหัวที่ละเอียดอ่อนหรือระบุตัวตนได้ ให้จำกัดรูปแบบ URL เป็นรูปแบบที่เข้ารหัส (https:// หรือ wss://)\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=HttpHeaderInjection";
HttpsOnlyMode.pfm_title = "อนุญาตให้เปิดใช้โหมด \"HTTPS เท่านั้น\"";
HttpsOnlyMode.pfm_description = "allowed - ไม่จำกัดการตั้งค่าโหมด HTTPS เท่านั้นของผู้ใช้\ndisallowed - ปิดใช้โหมด HTTPS เท่านั้น\nforce_enabled - เปิดใช้โหมด HTTPS เท่านั้นในโหมดเข้มงวด\nforce_balanced_enabled - เปิดใช้โหมด HTTPS เท่านั้นในโหมดสมดุล\nนโยบายนี้ควบคุมว่าผู้ใช้เปิดใช้โหมด HTTPS เท่านั้น (ใช้การเชื่อมต่อที่ปลอดภัยทุกครั้ง) ในการตั้งค่าได้หรือไม่ โหมด HTTPS เท่านั้นจะอัปเกรดการนำทางทั้งหมดให้เป็นแบบ HTTPS\n\nหากไม่ได้ตั้งค่านี้ไว้ หรือตั้งค่าเป็น \"อนุญาต\" ผู้ใช้จะได้รับอนุญาตให้เปิดใช้โหมด HTTPS เท่านั้น\n\nหากตั้งค่านี้เป็น \"ไม่อนุญาต\" ระบบจะปิดใช้โหมด HTTPS เท่านั้น\n\nหากตั้งค่านี้เป็น \"force_enabled\" ระบบจะเปิดใช้โหมด HTTPS เท่านั้นในโหมดเข้มงวด\n\nหากตั้งค่านี้เป็น \"force_balanced_enabled\" ระบบจะเปิดใช้โหมด HTTPS เท่านั้นในโหมดสมดุล\n\nระบบรองรับ \"force_enabled\" ตั้งแต่เวอร์ชัน M112 เป็นต้นไป และรองรับ \"force_balanced_enabled\" ตั้งแต่เวอร์ชัน M129 เป็นต้นไป\n\nนอกจากนี้ยังสามารถแนะนำ \"force_enabled\" และ \"force_balanced_enabled\" ให้ผู้ใช้ได้ด้วย\nในขั้นเริ่มต้น ระบบจะตั้งโหมด HTTPS เท่านั้นไว้เป็น \"เข้มงวด\" หรือ \"สมดุล\" แต่ผู้ใช้สามารถ\nเปลี่ยนได้\n\nหากตั้งค่านโยบายนี้เป็นค่าที่ Chrome เวอร์ชันที่ได้รับนโยบายไม่รองรับ Chrome จะใช้การตั้งค่าที่อนุญาตโดยค่าเริ่มต้น\n\nฟีเจอร์นี้จะใช้นโยบาย HttpAllowlist แยกต่างหากเพื่อยกเว้นชื่อโฮสต์หรือรูปแบบชื่อโฮสต์ที่ต้องการไม่ให้อัปเกรดเป็น HTTPS ได้";
HttpsUpgradesEnabled.pfm_title = "เปิดใช้การอัปเกรด HTTPS อัตโนมัติ";
HttpsUpgradesEnabled.pfm_description = "Brave จะพยายามอัปเกรดการไปยังส่วนต่างๆ จาก HTTP เป็น HTTPS เมื่อทำได้ นโยบายนี้ใช้เพื่อปิดลักษณะการทำงานนี้ได้ หากตั้งค่าเป็น \"จริง\" หรือไม่ได้ตั้งค่า ระบบจะเปิดใช้ฟีเจอร์นี้โดยค่าเริ่มต้น\n\nฟีเจอร์นี้จะใช้นโยบาย HttpAllowlist แยกต่างหากเพื่อยกเว้นชื่อโฮสต์หรือรูปแบบชื่อโฮสต์ที่ต้องการไม่ให้อัปเกรดเป็น HTTPS ได้\n\nโปรดดูนโยบาย HttpsOnlyMode ด้วย";
IPv6ReachabilityOverrideEnabled.pfm_title = "เปิดใช้การลบล้างการตรวจสอบความสามารถในการเข้าถึงของ IPv6";
IPv6ReachabilityOverrideEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" จะลบล้างการตรวจสอบความสามารถในการเข้าถึงของ IPv6 ซึ่งหมายความว่าระบบจะค้นหาระเบียน AAAA เสมอเมื่อแปลงชื่อโฮสต์ การตั้งค่านี้จะมีผลกับผู้ใช้ทุกคนและอินเทอร์เฟซทั้งหมดในอุปกรณ์\n\nการตั้งค่านโยบายเป็น \"เท็จ\" หรือไม่ได้ตั้งค่าจะไม่ลบล้างการตรวจสอบความสามารถในการเข้าถึงของ IPv6\nระบบจะค้นหาระเบียน AAAA เฉพาะเมื่อเข้าถึงโฮสต์ IPv6 ส่วนกลางได้";
IdleDetectionAllowedForUrls.pfm_title = "เว็บไซต์ที่อนุญาตสำหรับการตรวจจับการไม่ได้ใช้งาน";
IdleDetectionAllowedForUrls.pfm_description = "ช่วยให้คุณกำหนดรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ได้รับอนุญาตให้ใช้ Idle Detection API โดยไม่ต้องขอสิทธิ์จากผู้ใช้ รายการที่บล็อกมีลำดับความสำคัญสูงกว่ารายการที่อนุญาต ส่วนรายการที่อนุญาตมีลำดับความสำคัญสูงกว่าค่าเริ่มต้นที่กำหนดไว้\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องของเว็บไซต์ได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้ นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะใช้ค่าเริ่มต้นส่วนกลางกับเว็บไซต์ทั้งหมด ซึ่งกำหนดโดยนโยบาย DefaultIdleDetectionSetting (การตั้งค่าการตรวจจับการไม่ได้ใช้งานเริ่มต้น) หากมีการตั้งค่าไว้ หรือโดยการกำหนดค่าส่วนตัวของผู้ใช้";
IdleDetectionBlockedForUrls.pfm_title = "เว็บไซต์ที่บล็อกสำหรับการตรวจจับการไม่ได้ใช้งาน";
IdleDetectionBlockedForUrls.pfm_description = "ให้คุณกำหนดรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่ได้รับอนุญาตให้ใช้ Idle Detection API\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องของเว็บไซต์ได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้ นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะใช้ค่าเริ่มต้นส่วนกลางกับเว็บไซต์ทั้งหมด ซึ่งกำหนดโดยนโยบาย DefaultIdleDetectionSetting (การตั้งค่าการตรวจจับการไม่ได้ใช้งานเริ่มต้น) หากมีการตั้งค่าไว้ หรือโดยการกำหนดค่าส่วนตัวของผู้ใช้";
IdleTimeout.pfm_title = "การหน่วงเวลาก่อนเรียกใช้การดำเนินการเมื่อไม่มีการใช้งาน";
IdleTimeout.pfm_description = "เรียกให้ทำงานเมื่อไม่มีการใช้งานคอมพิวเตอร์\n\nการตั้งค่านโยบายนี้จะเป็นการกำหนดระยะเวลาโดยไม่ต้องมีข้อมูลจากผู้ใช้ (เป็นนาที) ก่อนที่เบราว์เซอร์จะเรียกใช้การดำเนินการที่กำหนดค่าไว้ผ่านนโยบาย IdleTimeoutActions\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะไม่เรียกใช้การดำเนินการใดๆ\n\nเกณฑ์ขั้นต่ำที่อนุญาตคือ 1 นาที\n\n\"ข้อมูลจากผู้ใช้\" จะกำหนดโดย Operating System API ซึ่งรวมถึงการดำเนินการต่างๆ อย่างการเลื่อนเมาส์หรือการพิมพ์บนแป้นพิมพ์";
IdleTimeoutActions.pfm_title = "การดำเนินการที่เรียกใช้เมื่อไม่มีการใช้งานคอมพิวเตอร์";
IdleTimeoutActions.pfm_description = "close_browsers - ปิดเบราว์เซอร์\nshow_profile_picker - แสดงเครื่องมือเลือกโปรไฟล์\nclear_browsing_history - ล้างประวัติการท่องเว็บ\nclear_download_history - ล้างประวัติการดาวน์โหลด\nclear_cookies_and_other_site_data - ล้างคุกกี้และข้อมูลเว็บไซต์อื่นๆ\nclear_cached_images_and_files - ล้างรูปภาพและไฟล์ที่แคชไว้\nclear_password_signin - ล้างข้อมูลลงชื่อเข้าใช้รหัสผ่าน\nclear_autofill - ล้างการป้อนข้อความอัตโนมัติ\nclear_site_settings - ล้างการตั้งค่าเว็บไซต์\nclear_hosted_app_data - ล้างข้อมูลแอปที่โฮสต์\nreload_pages - โหลดหน้าเว็บซ้ำ\nsign_out - ออกจากระบบ\nclose_tabs - ปิดแท็บ\nรายการการดำเนินการที่จะเรียกใช้เมื่อหมดเวลาตามนโยบาย IdleTimeout\n\nคำเตือน: การตั้งค่านโยบายนี้อาจส่งผลกระทบและนำข้อมูลส่วนตัวในเครื่องออกอย่างถาวร เราขอแนะนำให้ทดสอบการตั้งค่าก่อนติดตั้งใช้งานเพื่อป้องกันการลบข้อมูลส่วนตัวโดยไม่ตั้งใจ\n\nหากไม่ได้ตั้งค่านโยบาย IdleTimeout ไว้ นโยบายนี้จะไม่มีผล\n\nเมื่อหมดเวลาตามนโยบาย IdleTimeout เบราว์เซอร์จะเรียกใช้การดำเนินการที่กำหนดค่าไว้ในนโยบายนี้\n\nหากนโยบายนี้ว่างเปล่าหรือไม่ได้ตั้งค่า นโยบาย IdleTimeout จะไม่มีผล\n\nการดำเนินการที่รองรับ ได้แก่ \"close_browsers\": ปิดหน้าต่างเบราว์เซอร์และ PWA ทั้งหมดสำหรับโปรไฟล์นี้ ไม่รองรับใน Android และ iOS\n\n\"close_tabs\": ปิดแท็บที่เปิดอยู่ทั้งหมดในหน้าต่างที่เปิดอยู่ รองรับเฉพาะใน iOS\n\n\"show_profile_picker\": แสดงหน้าต่างเครื่องมือเลือกโปรไฟล์ ไม่รองรับใน Android และ iOS\n\n\"sign_out\": นำผู้ใช้ที่ลงชื่อเข้าใช้อยู่ออกจากระบบ รองรับเฉพาะใน iOS\n\n\"clear_browsing_history\", \"clear_download_history\", \"clear_cookies_and_other_site_data\", \"clear_cached_images_and_files\", \"clear_password_signing\", \"clear_autofill\", \"clear_site_settings\", \"clear_hosted_app_data\": ล้างข้อมูลการท่องเว็บที่เกี่ยวข้อง ดูรายละเอียดเพิ่มเติมจากนโยบาย ClearBrowsingDataOnExitList ประเภทที่รองรับใน iOS คือ \"clear_browsing_history\", \"clear_cookies_and_other_site_data\", \"clear_cached_images_and_files\", \"clear_password_signing\" และ \"clear_autofill\"\n\n\"reload_pages\": โหลดหน้าเว็บทั้งหมดซ้ำ ในบางหน้า ผู้ใช้อาจได้รับแจ้งให้ยืนยันก่อน ไม่รองรับใน iOS\n\nผู้ใช้จะยังคงลงชื่อเข้าใช้บัญชี Google เมื่อลบคุกกี้โดยใช้ \"clear_cookies_and_other_site_data\"\n\nการตั้งค่า \"clear_browsing_history\", \"clear_password_signing\", \"clear_autofill\" และ \"clear_site_settings\" จะปิดใช้การซิงค์สำหรับประเภทข้อมูลที่เกี่ยวข้อง หากไม่ได้ปิดใช้ \"Chrome Sync\" ไว้โดยการตั้งค่านโยบาย SyncDisabled และ BrowserSignin ปิดใช้อยู่";
ImagesAllowedForUrls.pfm_title = "อนุญาตให้แสดงภาพบนไซต์เหล่านี้";
ImagesAllowedForUrls.pfm_description = "การตั้งค่านโยบายนี้จะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่อาจมีการแสดงรูปภาพได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultImagesSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้\n\nโปรดทราบว่าก่อนหน้านี้นโยบายนี้เปิดใช้อย่างไม่ถูกต้องใน Android แต่ Android ก็ไม่เคยรองรับฟังก์ชันนี้โดยสมบูรณ์";
ImagesBlockedForUrls.pfm_title = "บล็อกรูปภาพในเว็บไซต์เหล่านี้";
ImagesBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่แสดงรูปภาพไม่ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultImagesSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\n ดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้\n\n โปรดทราบว่าก่อนหน้านี้นโยบายนี้เปิดใช้อย่างไม่ถูกต้องใน Android แต่ Android ก็ไม่เคยรองรับฟังก์ชันนี้โดยสมบูรณ์";
ImportAutofillFormData.pfm_title = "นำเข้าข้อมูลแบบฟอร์มที่ป้อนอัตโนมัติจากเบราว์เซอร์เริ่มต้นเมื่อเรียกใช้ครั้งแรก";
ImportAutofillFormData.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะนำเข้าข้อมูลฟอร์มที่ป้อนอัตโนมัติจากเบราว์เซอร์เริ่มต้นก่อนหน้าเมื่อเรียกใช้ครั้งแรก การตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า หมายความว่าจะไม่มีการนำเข้าข้อมูลฟอร์มที่ป้อนอัตโนมัติเมื่อเรียกใช้ครั้งแรก\n\nผู้ใช้จะทริกเกอร์กล่องโต้ตอบการนำเข้า และจะมีการเลือกหรือไม่ได้เลือกช่องทำเครื่องหมายข้อมูลฟอร์มที่ป้อนอัตโนมัติไว้ เพื่อให้ตรงกับค่าของนโยบายนี้";
ImportBookmarks.pfm_title = "นำเข้าบุ๊กมาร์กจากเบราว์เซอร์เริ่มต้นในการเรียกใช้งานครั้งแรก";
ImportBookmarks.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะนำเข้าบุ๊กมาร์กจากเบราว์เซอร์เริ่มต้นก่อนหน้าเมื่อเรียกใช้ครั้งแรก การตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า หมายความว่าจะไม่มีการนำเข้าบุ๊กมาร์กเมื่อเรียกใช้ครั้งแรก\n\nผู้ใช้จะทริกเกอร์กล่องโต้ตอบการนำเข้า และจะมีการเลือกหรือไม่ได้เลือกช่องทำเครื่องหมายบุ๊กมาร์กไว้ เพื่อให้ตรงกับค่าของนโยบายนี้";
ImportHistory.pfm_title = "นำเข้าประวัติการเรียกดูจากเบราว์เซอร์เริ่มต้นในการเรียกใช้งานครั้งแรก";
ImportHistory.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะนำเข้าประวัติการท่องเว็บจากเบราว์เซอร์เริ่มต้นก่อนหน้าเมื่อเรียกใช้ครั้งแรก การตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า หมายความว่าจะไม่มีการนำเข้าประวัติการท่องเว็บเมื่อเรียกใช้ครั้งแรก\n\nผู้ใช้จะทริกเกอร์กล่องโต้ตอบการนำเข้า และจะมีการเลือกหรือไม่ได้เลือกช่องทำเครื่องหมายประวัติการท่องเว็บไว้ เพื่อให้ตรงกับค่าของนโยบายนี้";
ImportHomepage.pfm_title = "การนำเข้าหน้าแรกจากเบราว์เซอร์เริ่มต้นในการเรียกใช้งานครั้งแรก";
ImportHomepage.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะนำเข้าหน้าแรกจากเบราว์เซอร์เริ่มต้นก่อนหน้าเมื่อเรียกใช้ครั้งแรก การตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า หมายความว่าจะไม่มีการนำเข้าหน้าแรกเมื่อเรียกใช้ครั้งแรก\n\nผู้ใช้จะทริกเกอร์กล่องโต้ตอบการนำเข้า และจะมีการเลือกหรือไม่ได้เลือกช่องทำเครื่องหมายหน้าแรกไว้ เพื่อให้ตรงกับค่าของนโยบายนี้";
ImportSavedPasswords.pfm_title = "นำเข้ารหัสผ่านที่บันทึกไว้จากเบราว์เซอร์เริ่มต้นในการเรียกใช้งานครั้งแรก";
ImportSavedPasswords.pfm_description = "นโยบายนี้ควบคุมเฉพาะลักษณะการนําเข้าครั้งแรกหลังจากการติดตั้งเท่านั้น ซึ่งจะช่วยให้การเปลี่ยนไปใช้ Brave ในสภาพแวดล้อมที่มีการใช้เบราว์เซอร์อื่นอย่างกว้างขวางก่อนติดตั้งเบราว์เซอร์นี้เป็นไปอย่างราบรื่น นโยบายนี้ไม่มีผลต่อความสามารถของเครื่องมือจัดการรหัสผ่านสําหรับบัญชี Google\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" จะนําเข้ารหัสผ่านที่บันทึกไว้จากเบราว์เซอร์เริ่มต้นก่อนหน้าเมื่อเรียกใช้ครั้งแรก และทำให้สามารถนําเข้าด้วยตนเองจากหน้าการตั้งค่าได้ด้วย\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทําให้ไม่มีการนำเข้ารหัสผ่านที่บันทึกไว้เมื่อเรียกใช้ครั้งแรก และจะนำเข้าด้วยตนเองจากหน้าการตั้งค่าไม่ได้ด้วย\nการไม่ตั้งค่านโยบายจะทําให้ไม่มีการนําเข้ารหัสผ่านที่บันทึกไว้เมื่อเรียกใช้ครั้งแรก แต่ผู้ใช้สามารถเลือกที่จะนำเข้าได้จากหน้าการตั้งค่า";
ImportSearchEngine.pfm_title = "นำเข้าเครื่องมือค้นหาจากเบราว์เซอร์เริ่มต้นในการเรียกใช้งานครั้งแรก";
ImportSearchEngine.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะนำเข้าเครื่องมือค้นหาเริ่มต้นจากเบราว์เซอร์เริ่มต้นก่อนหน้าเมื่อเรียกใช้ครั้งแรก การตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า หมายความว่าจะไม่มีการนำเข้าเครื่องมือค้นหาเริ่มต้นเมื่อเรียกใช้ครั้งแรก\n\nผู้ใช้จะทริกเกอร์กล่องโต้ตอบการนำเข้า และจะมีการเลือกหรือไม่ได้เลือกช่องทำเครื่องหมายเครื่องมือค้นหาเริ่มต้นไว้ เพื่อให้ตรงกับค่าของนโยบายนี้";
IncognitoModeAvailability.pfm_title = "ความพร้อมใช้งานของโหมดไม่ระบุตัวตน";
IncognitoModeAvailability.pfm_description = "0 - โหมดไม่ระบุตัวตนพร้อมใช้งาน\n1 - ปิดใช้งานโหมดไม่ระบุตัวตน\n2 - บังคับใช้โหมดไม่ระบุตัวตน\nระบุว่าผู้ใช้จะเปิดหน้าด้วยโหมดไม่ระบุตัวตนใน Brave หรือไม่\n\nหากเลือก \"เปิดใช้\" หรือไม่ได้ตั้งนโยบายไว้ หน้าอาจเปิดด้วยโหมดไม่ระบุตัวตน\n\nหากเลือก \"ปิดใช้\" หน้าอาจไม่เปิดด้วยโหมดไม่ระบุตัวตน\n\nหากเลือก \"บังคับใช้\" หน้าอาจเปิดด้วยโหมดไม่ระบุตัวตนเท่านั้น โปรดทราบว่าการ \"บังคับใช้\" จะใช้ไม่ได้ใน Android ที่อยู่ใน Chrome\n\nนโยบาย IncognitoModeUrlAllowlist มีความสำคัญเหนือกว่านโยบายนี้และสามารถเปิดใช้โหมดไม่ระบุตัวตนอีกครั้งสำหรับ URL ที่เฉพาะเจาะจงได้ เมื่อนโยบายนี้ปิดใช้โหมดไม่ระบุตัวตนเมื่อมีการระบุรายการที่อนุญาต โหมดไม่ระบุตัวตนจะใช้ได้เฉพาะกับ URL ที่ตรงกับรายการที่อนุญาตเท่านั้น ส่วนหน้าอื่นๆ ทั้งหมดจะถูกบล็อก\n\nหมายเหตุ: ใน iOS หากมีการเปลี่ยนนโยบายระหว่างที่เข้าชม นโยบายใหม่จะมีผลต่อเมื่อเปิดเบราว์เซอร์อีกครั้ง";
IncognitoModeUrlAllowlist.pfm_title = "อนุญาตให้เข้าถึงรายการ URL ในโหมดไม่ระบุตัวตน";
IncognitoModeUrlAllowlist.pfm_description = "การตั้งค่านโยบายจะให้สิทธิ์เข้าถึง URL ที่ระบุไว้ในโหมดไม่ระบุตัวตน ใช้เพื่อเปิดข้อยกเว้นสำหรับรูปแบบ URL บางรูปแบบที่กำหนดไว้ใน IncognitoModeUrlBlocklist โดยใช้รูปแบบที่ระบุไว้ที่ ( https://support.google.com/chrome/a?p=url_blocklist_filter_format )\n\nหากตั้งค่านโยบายนี้และ IncognitoModeUrlBlocklist ไว้ทั้งคู่ รายการที่อนุญาตจะมีความสำคัญสูงกว่า หาก URL ตรงกับรูปแบบในรายการที่อนุญาต ระบบจะอนุญาต URL นั้น หากตรงกับรูปแบบในรายการที่บล็อก (แต่ไม่ตรงกับรายการที่อนุญาต) ระบบจะบล็อก URL นั้น หาก URL ไม่ตรงกับรูปแบบในรายการใดๆ เลย ระบบจะใช้นโยบายทั่วไปของ URLBlocklist/URLAllowlist เป็นตัวเลือกสำรอง\n\nหากตั้งค่านโยบายนี้และไม่ได้ตั้งค่า IncognitoModeUrlBlocklist ระบบจะบล็อก URL ทั้งหมดที่ไม่อยู่ในรายการที่อนุญาตในโหมดไม่ระบุตัวตน\n\nหากตั้งค่า IncognitoModeAvailability เป็นไม่อนุญาต (ค่า 1) แต่มีการกำหนดค่านโยบายนี้ โหมดไม่ระบุตัวตนจะใช้ได้เฉพาะกับ URL ที่ตรงกับรายการที่อนุญาต\n\nการไม่ตั้งค่านโยบายจะทำให้ไม่มีข้อยกเว้นสำหรับ IncognitoModeUrlBlocklist และ IncognitoModeAvailability\n\nนโยบายนี้มีผลกับโหมดไม่ระบุตัวตนเท่านั้น หากต้องการอนุญาต URL สำหรับโปรไฟล์ผู้ใช้ทั้งหมด โปรดใช้นโยบาย URLAllowlist\n\nไวลด์การ์ดโฮสต์แบบครอบคลุม (คือ ไม่อนุญาตให้ใช้ \"*\" หรือ \"[*]\") ให้ใช้นโยบาย IncognitoModeAvailability เพื่อเปิดใช้ฟีเจอร์ทั่วโลก\n\nนโยบายนี้ระบุรายการได้ไม่เกิน 1,000 รายการ";
IncognitoModeUrlBlocklist.pfm_title = "บล็อกการเข้าถึงรายการ URL ในโหมดไม่ระบุตัวตน";
IncognitoModeUrlBlocklist.pfm_description = "การตั้งค่านโยบาย IncognitoModeUrlBlocklist จะทำให้ระบบหยุดโหลดหน้าเว็บที่มี URL ต้องห้ามในโหมดไม่ระบุตัวตน ผู้ดูแลระบบสามารถระบุรายการรูปแบบ URL ที่จะบล็อกได้ ดูวิธีจัดรูปแบบ URL ( https://support.google.com/chrome/a?p=url_blocklist_filter_format )\n\nหากตั้งค่าทั้งนโยบายนี้และ IncognitoModeUrlAllowlist รายการที่อนุญาตจะมีความสำคัญเหนือกว่า หาก URL ตรงกับรูปแบบในรายการที่อนุญาต ระบบจะอนุญาต URL นั้น หากตรงกับรูปแบบในรายการที่บล็อกแต่ไม่ตรงกับรายการที่อนุญาต ระบบจะบล็อก URL นั้น หาก URL ไม่ตรงกับรูปแบบในรายการใดๆ เลย ระบบจะใช้นโยบายทั่วไปของ URLBlocklist/URLAllowlist เป็นตัวเลือกสำรอง\n\nหากตั้งค่านโยบาย IncognitoModeUrlAllowlist ไว้และไม่ได้ตั้งค่านโยบายนี้ ระบบจะบล็อก URL ทั้งหมดที่ไม่อยู่ในรายการที่อนุญาตในโหมดไม่ระบุตัวตน\n\nหากตั้งค่า IncognitoModeAvailability เป็นไม่อนุญาต (ค่า 1) แต่มีการกำหนดค่านโยบาย IncognitoModeUrlAllowlist โหมดไม่ระบุตัวตนจะใช้ได้เฉพาะกับ URL ที่ตรงกับรายการที่อนุญาต\n\nนโยบายนี้มีผลกับโหมดไม่ระบุตัวตนเท่านั้น หากต้องการบล็อก URL สำหรับโปรไฟล์ผู้ใช้ทั้งหมด โปรดใช้นโยบาย URLBlocklist\n\nนโยบายนี้ระบุรายการได้ไม่เกิน 1,000 รายการ";
InsecureContentAllowedForUrls.pfm_title = "อนุญาตเนื้อหาที่ไม่ปลอดภัยในเว็บไซต์เหล่านี้";
InsecureContentAllowedForUrls.pfm_description = "อนุญาตให้คุณกำหนดรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่อนุญาตให้แสดงเนื้อหาผสม (เช่น เนื้อหา HTTP ในเว็บไซต์ HTTPS) ที่บล็อกได้ (เช่น แบบแอ็กทีฟ) และที่ระบบจะปิดใช้การอัปเกรดเนื้อหาผสมที่เลือกบล็อกได้\n\nหากไม่ได้ตั้งค่านโยบายนี้ไว้ ระบบจะบล็อกเนื้อหาผสมที่บล็อกได้ ส่วนเนื้อหาผสมที่เลือกบล็อกได้จะได้รับการอัปเกรด และผู้ใช้จะตั้งค่าข้อยกเว้นให้แสดงเนื้อหาดังกล่าวในเว็บไซต์ที่เจาะจงได้\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
InsecureContentBlockedForUrls.pfm_title = "บล็อกเนื้อหาที่ไม่ปลอดภัยในเว็บไซต์เหล่านี้";
InsecureContentBlockedForUrls.pfm_description = "อนุญาตให้คุณกำหนดรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่อนุญาตให้แสดงเนื้อหาผสม (เช่น เนื้อหา HTTP ในเว็บไซต์ HTTPS) ที่บล็อกได้ (เช่น แบบแอ็กทีฟ) และที่ระบบจะอัปเกรดเนื้อหาผสมที่เลือกบล็อกได้ (เช่น แบบแพสซีฟ)\n\nหากไม่ได้ตั้งค่านโยบายนี้ไว้ ระบบจะบล็อกเนื้อหาผสมที่บล็อกได้ ส่วนเนื้อหาผสมที่เลือกบล็อกได้จะได้รับการอัปเกรด แต่ผู้ใช้จะตั้งค่าข้อยกเว้นให้แสดงเนื้อหาดังกล่าวในเว็บไซต์ที่เจาะจงได้\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
IntensiveWakeUpThrottlingEnabled.pfm_title = "ควบคุมฟีเจอร์ IntensiveWakeUpThrottling";
IntensiveWakeUpThrottlingEnabled.pfm_description = "เมื่อเปิดใช้ ฟีเจอร์ \"IntensiveWakeUpThrottling\" จะทำให้ตัวจับเวลา JavaScript ในแท็บเบื้องหลังถูกควบคุมและรวมเป็นหนึ่งมากเกินไป ซึ่งมีผลให้ทำงานได้เพียงนาทีละ 1 ครั้งหลังจากที่หน้าอยู่ในเบื้องหลังเป็นเวลา 5 นาทีขึ้นไป\n\nฟีเจอร์นี้เป็นฟีเจอร์ที่เป็นไปตามมาตรฐานของเว็บ แต่อาจทำให้บางเว็บไซต์ทำงานได้ไม่ถูกต้องโดยทำให้การทำงานบางอย่างล่าช้าได้ถึง 1 นาที แต่เมื่อเปิดใช้ จะช่วยประหยัดแบตเตอรี่และ CPU ได้อย่างมาก ดูรายละเอียดเพิ่มเติมที่ https://bit.ly/30b1XR4\n\nหากตั้งค่านโยบายนี้เป็นเปิดใช้ ระบบจะบังคับให้เปิดใช้ฟีเจอร์นี้และผู้ใช้จะลบล้างการตั้งค่านี้ไม่ได้\n\nหากตั้งค่านโยบายนี้เป็นปิดใช้ ระบบจะบังคับให้ปิดใช้ฟีเจอร์นี้และผู้ใช้จะลบล้างการตั้งค่านี้ไม่ได้\n\nหากไม่ได้ตั้งค่านโยบายนี้ ฟีเจอร์จะถูกควบคุมโดยตรรกะภายในตัวฟีเจอร์เอง ซึ่งผู้ใช้จะกำหนดค่าด้วยตนเองได้\n\nโปรดทราบว่านโยบายนี้มีผลตามการประมวลผลของโหมดแสดงภาพ โดยจะบังคับใช้ค่าล่าสุดในการตั้งค่านโยบายเมื่อเริ่มการประมวลผลของโหมดแสดงภาพ คุณต้องรีสตาร์ทโดยสมบูรณ์เพื่อให้แน่ใจว่าทุกแท็บที่โหลดไว้จะได้รับการตั้งค่านโยบายที่สอดคล้องกัน การประมวลผลต่างๆ ทำงานโดยใช้ค่าที่ต่างกันของนโยบายนี้ได้โดยไม่มีปัญหา\n";
IntranetRedirectBehavior.pfm_title = "ลักษณะการเปลี่ยนเส้นทางอินทราเน็ต";
IntranetRedirectBehavior.pfm_description = "0 - ใช้ลักษณะการทำงานเริ่มต้นของเบราว์เซอร์\n1 - ปิดใช้การตรวจสอบการสกัดกั้น DNS และแถบข้อมูล \"หรือคุณหมายถึง http://intranetsite/\"\n2 - ปิดใช้การตรวจสอบการสกัดกั้น DNS อนุญาตแถบข้อมูล \"หรือคุณหมายถึง http://intranetsite/\"\n3 - อนุญาตการตรวจสอบการสกัดกั้น DNS และแถบข้อมูล \"หรือคุณหมายถึง http://intranetsite/\"\nนโยบายนี้กำหนดลักษณะการเปลี่ยนเส้นทางอินทราเน็ตผ่านการตรวจสอบการสกัดกั้น DNS การตรวจสอบจะพยายามหาว่าเบราว์เซอร์อยู่หลังพร็อกซีที่เปลี่ยนเส้นทางชื่อโฮสต์ที่ไม่รู้จักหรือไม่\n\nหากไม่ได้ตั้งค่านโยบายนี้ เบราว์เซอร์จะใช้ลักษณะการทำงานเริ่มต้นของการตรวจสอบการสกัดกั้น DNS และคำแนะนำการเปลี่ยนเส้นทางอินทราเน็ต ลักษณะการทำงานเหล่านี้จะเปิดใช้อยู่โดยค่าเริ่มต้นในรุ่น M88 แต่จะปิดใช้โดยค่าเริ่มต้นในรุ่นต่อไป\n\nDNSInterceptionChecksEnabled เป็นนโยบายที่เกี่ยวข้องซึ่งอาจปิดใช้การตรวจสอบการสกัดกั้น DNS ด้วย นโยบายนี้เป็นเวอร์ชันที่ยืดหยุ่นมากกว่าซึ่งอาจควบคุมแถบข้อมูลการเปลี่ยนเส้นทางอินทราเน็ตแยกต่างหากและอาจมีการขยายการใช้งานในอนาคต\nหาก DNSInterceptionChecksEnabled หรือนโยบายนี้ขอปิดใช้การตรวจสอบการสกัดกั้น ระบบก็จะปิดใช้การตรวจสอบ";
IsolateOrigins.pfm_title = "เปิดใช้การแยกเว็บไซต์สำหรับต้นทางที่เจาะจง";
IsolateOrigins.pfm_description = "ระบุรายการต้นทางที่ทำงานในกระบวนการเฉพาะ\n\nใน Android นโยบายนี้จะทำงานในอุปกรณ์ที่มีหน่วยความจำเพียงพอเท่านั้น (RAM ต้องมากกว่า 3.2 GB) เนื่องจากอุปกรณ์ที่มีทรัพยากรจำกัดอาจเกิดปัญหาด้านประสิทธิภาพหากแยกเว็บไซต์มากเกินไป สำหรับอุปกรณ์ Android ที่มีทรัพยากรจำกัด โปรดใช้ IsolateOriginsShortlist แทน\n\nไม่แนะนำให้อุปกรณ์ที่มีหน่วยความจำน้อยกว่า 1 GB กำหนดค่าการแยกกระบวนการใดๆ โดยเฉพาะ\n\nกระบวนการของต้นทางแต่ละแห่งที่มีชื่อจะได้รับอนุญาตให้มีเอกสารจากต้นทางนั้นและโดเมนย่อยเท่านั้น ตัวอย่างเช่น การระบุ https://a1.example.com/ จะอนุญาต https://a2.a1.example.com/ ในกระบวนการเดียวกัน แต่ไม่อนุญาต https://example.com หรือ https://b.example.com\n\nตั้งแต่ Brave เวอร์ชัน 77 คุณจะระบุช่วงต้นทางเพื่อแยกโดยใช้ไวลด์การ์ดได้ด้วย ตัวอย่างเช่น การระบุ https://[*.]corp.example.com จะทำให้ทุกต้นทางภายใต้ https://corp.example.com มีกระบวนการเฉพาะของตนเอง ซึ่งรวมถึง https://corp.example.com, https://a1.corp.example.com และ https://a2.a1.corp.example.com\n\nโปรดทราบว่าเว็บไซต์ทั้งหมด (เช่น รูปแบบบวก eTLD+1 อย่าง https://example.com) จะแยกไว้อยู่แล้วโดยค่าเริ่มต้นบนแพลตฟอร์มเดสก์ท็อปตามที่ได้ระบุในนโยบาย SitePerProcess นโยบาย IsolateOrigins นี้เป็นประโยชน์ในการแยกต้นทางเฉพาะบางแห่งในระดับที่ละเอียดกว่า (เช่น https://a.example.com)\n\nโปรดทราบว่า Android จะแยกเว็บไซต์ที่มีความละเอียดอ่อนบางเว็บไซต์โดยค่าเริ่มต้นใน Brave เวอร์ชัน 77 เป็นต้นไป และนโยบายนี้จะขยายการทำงานของโหมดดังกล่าวให้แยกต้นทางบางรายการเพิ่มเติม\n\nนอกจากนี้ โปรดทราบว่าต้นทางที่แยกโดยนโยบายนี้จะสคริปต์ต้นทางอื่นๆ ในเว็บไซต์เดียวกันไม่ได้ แต่จะเป็นไปได้หากเอกสาร 2 รายการของเว็บไซต์เดียวกันแก้ไขค่า document.domain ให้ตรงกัน ผู้ดูแลระบบควรตรวจสอบว่าไม่มีการใช้ลักษณะการทำงานไม่ปกตินี้ในต้นทางก่อนที่จะแยก\n\nการตั้งค่านโยบายเป็นสตริงว่างหรือไม่ได้ตั้งค่าหมายความว่าจะไม่จำเป็นต้องมีการแยกเว็บไซต์สำหรับต้นทางที่เฉพาะเจาะจง ผู้ใช้ยังคงเปิดใช้การแยกกระบวนการด้วยตนเองได้ผ่าน Flag บรรทัดคำสั่ง";
JavaScriptAllowedForUrls.pfm_title = "อนุญาตให้ใช้ JavaScript บนไซต์เหล่านี้";
JavaScriptAllowedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณกำหนดรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่เรียกใช้ JavaScript ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultJavaScriptSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
JavaScriptBlockedForUrls.pfm_title = "ปิดกั้น JavaScript บนไซต์เหล่านี้";
JavaScriptBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่เรียกใช้ JavaScript ไม่ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultJavaScriptSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้\n\nโปรดทราบว่านโยบายนี้จะบล็อก JavaScript โดยขึ้นอยู่กับว่าต้นทางของเอกสารระดับบนสุด (โดยปกติคือ URL ของหน้าเว็บที่แสดงในแถบที่อยู่ด้วยเช่นกัน) ตรงกับรูปแบบใดรูปแบบหนึ่งหรือไม่ ดังนั้นนโยบายนี้จึงไม่เหมาะสำหรับใช้ลดการโจมตีซัพพลายเชนในอินเทอร์เน็ต ตัวอย่างเช่น การใช้รูปแบบ \"https://[*.]foo.com/\" จะไม่ป้องกันหน้าเว็บที่โฮสต์ใน https://example.com จากการเรียกใช้สคริปต์ที่โหลดจาก https://www.foo.com/example.js นอกจากนี้ การใช้รูปแบบ \"https://example.com/\" จะไม่ป้องกันเอกสารจาก https://example.com ในการเรียกใช้สคริปต์ หากเอกสารนั้นไม่ใช่เอกสารระดับบนสุด แต่ฝังเป็นเฟรมย่อยในหน้าเว็บที่โฮสต์อยู่ในต้นทางอื่น เช่น https://www.bar.com";
JavaScriptJitAllowedForSites.pfm_title = "อนุญาตให้ JavaScript ใช้ JIT ในเว็บไซต์เหล่านี้";
JavaScriptJitAllowedForSites.pfm_description = "ให้คุณกำหนดรายการรูปแบบ URL ของเว็บไซต์ซึ่งระบุเว็บไซต์ที่ได้รับอนุญาตให้เรียกใช้ JavaScript ที่เปิดใช้คอมไพเลอร์ JIT (Just In Time)\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องของเว็บไซต์ได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้\n\nคุณสามารถตั้งค่าข้อยกเว้นของนโยบายสำหรับโดเมนย่อยที่เฉพาะเจาะจง รวมถึงทั้งเว็บไซต์ได้ ตัวอย่างเช่น นโยบายที่ตั้งค่าไว้เฉพาะสำหรับ subdomain.site.com จะมีผลกับ subdomain.site.com โดยไม่ส่งผลต่อ site.com ในบางกรณีที่โดเมนย่อยไม่สามารถแยกออกจากเว็บไซต์หลักได้ โดเมนย่อยอาจรับนโยบายที่ตั้งค่าไว้ใน site.com นอกจากนี้ ข้อยกเว้นอาจไม่มีผลกับเฟรมที่โหลดในแท็บที่มีอยู่จนกว่าจะเปิดเว็บไซต์ในแท็บใหม่ ในอุปกรณ์ Android ที่มีหน่วยความจำต่ำ ระบบอาจไม่บังคับใช้ข้อยกเว้นเฉพาะเว็บไซต์ และเว็บไซต์จะใช้นโยบายจาก DefaultJavaScriptJitSetting แทน หากมีการตั้งค่าไว้ หรือค่าเริ่มต้นเป็นการตั้งค่า JavaScript JIT ของโปรไฟล์\n\nหากต้องการบังคับใช้ข้อยกเว้น Brave อาจวางเว็บไซต์หรือโดเมนย่อยที่มีการตั้งค่าแตกต่างจากค่าเริ่มต้นลงในกระบวนการเฉพาะ ซึ่งอาจเพิ่มการใช้งานหน่วยความจำ โดยเฉพาะใน Android หรือเมื่อรูปแบบไวลด์การ์ดตรงกับโดเมนย่อยหลายรายการ เนื่องจากต้นทางที่ตรงกันแต่ละรายการอาจแยกกัน นอกจากนี้ ซับโดเมนที่แยกต่างหากจะใช้ document.domain เพื่อเข้าถึงเว็บไซต์หลักไม่ได้\n\nหมายเหตุ: ในเวอร์ชัน 155 และเก่ากว่า การยกเว้นนโยบายจะบังคับใช้ที่รายละเอียดระดับเว็บไซต์ (eTLD+1) เท่านั้น นโยบายที่ตั้งค่าไว้เฉพาะสำหรับ subdomain.site.com จะไม่มีผล แม้แต่กับ subdomain.site.com โดยจะต้องตั้งค่าใน site.com เพื่อให้มีผลกับทั้ง site.com และ subdomain.site.com\n\nนโยบายนี้มีผลแบบทีละเฟรมและไม่ได้อิงตาม URL ต้นทางระดับบนสุดเพียงอย่างเดียว เช่น หาก site-one.com อยู่ในนโยบาย JavaScriptJitAllowedForSites แต่ site-one.com โหลดเฟรมที่มี site-two.com อยู่ site-one.com จะเปิดใช้ JIT ใน JavaScript แต่ site-two.com จะใช้นโยบายจาก DefaultJavaScriptJitSetting หากตั้งค่าไว้ หรือค่าเริ่มต้นเป็นเปิดใช้ JIT ใน JavaScript รายการที่บล็อกมีลำดับความสำคัญสูงกว่ารายการที่อนุญาต ส่วนรายการที่อนุญาตมีลำดับความสำคัญสูงกว่าค่าเริ่มต้นที่กำหนดไว้\n\nหากไม่ได้ตั้งค่านโยบายนี้สำหรับเว็บไซต์ นโยบายจาก DefaultJavaScriptJitSetting ก็จะมีผลกับเว็บไซต์เมื่อตั้งค่าไว้ ไม่เช่นนั้นจะมีการเปิดใช้ JIT ใน JavaScript ในเว็บไซต์";
JavaScriptJitBlockedForSites.pfm_title = "บล็อก JavaScript ไม่ให้ใช้ JIT ในเว็บไซต์เหล่านี้";
JavaScriptJitBlockedForSites.pfm_description = "ให้คุณกำหนดรายการรูปแบบ URL ของเว็บไซต์ซึ่งระบุเว็บไซต์ที่ไม่ได้รับอนุญาตให้เรียกใช้ JavaScript ที่เปิดใช้คอมไพเลอร์ JIT (Just In Time)\n\nการปิดใช้ JIT ใน JavaScript อาจทำให้ Brave แสดงเนื้อหาเว็บช้าลงและปิดใช้ส่วนต่างๆ ของ JavaScript รวมถึง WebAssembly การปิดใช้ JIT ใน JavaScript อาจช่วยให้ Brave แสดงเนื้อหาเว็บในการกำหนดค่าที่ปลอดภัยขึ้น\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้\n\nคุณสามารถกำหนดข้อยกเว้นของนโยบายสำหรับโดเมนย่อยที่เฉพาะเจาะจง รวมถึงทั้งเว็บไซต์ได้ ตัวอย่างเช่น นโยบายที่ตั้งค่าไว้เฉพาะสำหรับ subdomain.site.com จะมีผลกับ subdomain.site.com โดยไม่ส่งผลต่อ site.com ในบางกรณีที่โดเมนย่อยไม่สามารถแยกออกจากเว็บไซต์หลักได้ โดเมนย่อยอาจรับนโยบายที่ตั้งค่าไว้ใน site.com นอกจากนี้ ข้อยกเว้นอาจไม่มีผลกับเฟรมที่โหลดในแท็บที่มีอยู่จนกว่าจะเปิดเว็บไซต์ในแท็บใหม่ ในอุปกรณ์ Android ที่มีหน่วยความจำต่ำ ระบบอาจไม่บังคับใช้ข้อยกเว้นเฉพาะเว็บไซต์ และเว็บไซต์จะใช้นโยบายจาก DefaultJavaScriptJitSetting แทน หากมีการตั้งค่าไว้ หรือค่าเริ่มต้นเป็นการตั้งค่า JIT ใน JavaScript ของโปรไฟล์\n\nหากต้องการบังคับใช้ข้อยกเว้น Brave อาจวางเว็บไซต์หรือโดเมนย่อยที่มีการตั้งค่าแตกต่างจากค่าเริ่มต้นลงในกระบวนการเฉพาะ ซึ่งอาจเพิ่มการใช้งานหน่วยความจำ โดยเฉพาะใน Android หรือเมื่อรูปแบบไวลด์การ์ดตรงกับโดเมนย่อยหลายรายการ เนื่องจากต้นทางที่ตรงกันแต่ละรายการอาจแยกกัน นอกจากนี้ โดเมนย่อยที่แยกต่างหากจะใช้ document.domain เพื่อเข้าถึงเว็บไซต์หลักไม่ได้\n\nหมายเหตุ: ในเวอร์ชัน 155 และเก่ากว่า การยกเว้นนโยบายจะบังคับใช้ที่รายละเอียดระดับเว็บไซต์ (eTLD+1) เท่านั้น นโยบายที่ตั้งค่าไว้เฉพาะสำหรับ subdomain.site.com จะไม่มีผล แม้แต่กับ subdomain.site.com โดยจะต้องตั้งค่าใน site.com เพื่อให้มีผลกับทั้ง site.com และ subdomain.site.com\n\nนโยบายนี้มีผลแบบทีละเฟรมและไม่ได้อิงตาม URL ต้นทางระดับบนสุดเพียงอย่างเดียว เช่น หาก site-one.com อยู่ในนโยบาย JavaScriptJitBlockedForSites แต่ site-one.com โหลดเฟรมที่มี site-two.com อยู่ site-one.com จะปิดใช้ JIT ใน JavaScript แต่ site-two.com จะใช้นโยบายจาก DefaultJavaScriptJitSetting หากตั้งค่าไว้ หรือเปิดใช้ JIT ใน JavaScript โดยค่าเริ่มต้น รายการที่บล็อกมีลำดับความสำคัญสูงกว่ารายการที่อนุญาต ส่วนรายการที่อนุญาตมีลำดับความสำคัญสูงกว่าค่าเริ่มต้นที่กำหนดไว้\n\nหากไม่ได้ตั้งค่านโยบายนี้สำหรับเว็บไซต์ นโยบายจาก DefaultJavaScriptJitSetting ก็จะมีผลกับเว็บไซต์เมื่อตั้งค่าไว้ ไม่เช่นนั้นจะมีการเปิดใช้ JIT ใน JavaScript ในเว็บไซต์";
JavaScriptOptimizerAllowedForSites.pfm_title = "อนุญาตการเพิ่มประสิทธิภาพ JavaScript ในเว็บไซต์เหล่านี้";
