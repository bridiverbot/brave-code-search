<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/page_action_internals_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/page_action_internals_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/page_action_internals_resources_map.h"
            type="resource_map_header" />
    <output filename="page_action_internals_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_PAGE_ACTION_INTERNALS_PAGE_ACTION_INTERNALS_HTML" file="${root_gen_dir}/chrome/browser/resources/page_action_internals/preprocessed/page_action_internals.html" resource_path="page_action_internals.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PAGE_ACTION_INTERNALS_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/page_action_internals/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PAGE_ACTION_INTERNALS_APP_JS" file="${root_gen_dir}/chrome/browser/resources/page_action_internals/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PAGE_ACTION_INTERNALS_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/page_action_internals/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PAGE_ACTION_INTERNALS_PAGE_ACTION_INTERNALS_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/page_action_internals/minified/page_action_internals.mojom-webui.js" resource_path="page_action_internals.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
