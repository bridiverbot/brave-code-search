--crate-name
std
--crate-type
rlib
--cfg=backtrace_in_libstd
-Zforce-unstable-if-unmarked
--cap-lints=allow
--cfg
backtrace_in_libstd
--cfg=feature="object"
--edition=2024
-Cforce-unwind-tables=yes
-Crelocation-model=pic
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--color=always
--target=x86_64-unknown-linux-gnu
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
--cfg
cr_rustc_revision="110108a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-8a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-1-24-14453-ge063be79"
-Copt-level=3
-Cforce-frame-pointers=yes
-Cdebug-assertions
-Zdefault-visibility=hidden
-Dwarnings
--sysroot=local_rustc_sysroot
-Ldependency=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib
-Clink-arg=../../third_party/llvm-build/Release+Asserts/lib/clang/24/lib/x86_64-unknown-linux-gnu/libclang_rt.builtins.a
--extern
alloc=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/liballoc_alloc.rlib
--extern
core=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/libcore_core.rlib
--extern
cfg_if=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/libcfg_if_cfg_if.rlib
--extern
hashbrown=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/libhashbrown_hashbrown.rlib
--extern
panic_abort=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/libpanic_abort_panic_abort.rlib
--extern
rustc_demangle=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/librustc_demangle_rustc_demangle.rlib
--extern
std_detect=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/libstd_detect_std_detect.rlib
--extern
libc=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/liblibc_libc.rlib
--extern
unwind=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/libunwind_unwind.rlib
--extern
object=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/libobject_object.rlib