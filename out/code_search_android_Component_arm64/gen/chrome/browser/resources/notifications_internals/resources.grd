<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/notifications_internals_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/notifications_internals_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/notifications_internals_resources_map.h"
            type="resource_map_header" />
    <output filename="notifications_internals_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_NOTIFICATIONS_INTERNALS_NOTIFICATIONS_INTERNALS_HTML" file="${root_gen_dir}/chrome/browser/resources/notifications_internals/preprocessed/notifications_internals.html" resource_path="notifications_internals.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NOTIFICATIONS_INTERNALS_NOTIFICATIONS_INTERNALS_JS" file="${root_gen_dir}/chrome/browser/resources/notifications_internals/minified/notifications_internals.js" resource_path="notifications_internals.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NOTIFICATIONS_INTERNALS_NOTIFICATIONS_INTERNALS_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/notifications_internals/minified/notifications_internals.mojom-webui.js" resource_path="notifications_internals.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
