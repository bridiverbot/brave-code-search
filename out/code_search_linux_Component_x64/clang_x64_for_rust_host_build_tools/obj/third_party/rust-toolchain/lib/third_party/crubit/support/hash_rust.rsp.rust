--crate-name
hash_rust
--crate-type
rlib
--edition=2024
-Cforce-unwind-tables=yes
-Crelocation-model=pic
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--color=always
--target=x86_64-unknown-linux-gnu
-Cembed-bitcode=no
-Clto=no
--cfg
cr_rustc_revision="110108a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-8a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-1-24-14453-ge063be79"
-Copt-level=3
-Cforce-frame-pointers=yes
-Cdebug-assertions
-Zdefault-visibility=hidden
-Dwarnings
-Zallow-features=abi_vectorcall,adt_const_params,allocator_api,allow_internal_unstable,arbitrary_self_types,auto_traits,c_variadic,cfg_accessible,cfg_sanitize,cfi_encoding,custom_inner_attributes,extern_types,impl_trait_in_assoc_type,negative_impls,never_type,proc_macro_hygiene,sized_hierarchy,stmt_expr_attributes,super_let,unsized_const_params
-Ldependency=clang_x64_for_rust_host_build_tools/obj/third_party/rust-toolchain/lib/third_party/crubit/support
-Ldependency=clang_x64_for_rust_host_build_tools/obj/third_party/rust-toolchain/lib/third_party/crubit/support/ffi_11
