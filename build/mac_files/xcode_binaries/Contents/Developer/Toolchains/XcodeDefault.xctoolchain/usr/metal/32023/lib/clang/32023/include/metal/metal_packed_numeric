#if defined(__HAVE_PACKED_NUMERIC_TYPE_PACK_UNPACK__)
enum class saturation_mode : char
{
  none,
  saturate,
  symmetric_saturate,
};

namespace __packed_numeric_detail
{
template <class Format, saturation_mode Sm>
constant constexpr bool _valid_saturation_mode_v =
    ((is_same_v<Format, metal_fp4_e2m1_format> ||
      is_same_v<Format, metal_fp8_e4m3_format> ||
      is_same_v<Format, uint4b_format> ||
      is_same_v<Format, uchar>) &&
     Sm == saturation_mode::saturate) ||
    (is_same_v<Format, metal_fp8_e5m2_format> && (Sm == saturation_mode::none || Sm == saturation_mode::saturate)) ||
    ((is_same_v<Format, int4b_format> ||
      is_same_v<Format, char> ||
      is_same_v<Format, signed char>) &&
     (Sm == saturation_mode::saturate || Sm == saturation_mode::symmetric_saturate));
template <class Format, saturation_mode Sm, class T, size_t N>
constant constexpr bool _valid_pack_v =
    _valid_arithmetic_type_v<T> &&
    _valid_packed_numeric_pack_unpack_v<Format, N> &&
    _valid_saturation_mode_v<Format, Sm>;
template <class T, class Format, size_t N>
constant constexpr bool _valid_unpack_v =
    _valid_arithmetic_type_v<T> && _valid_packed_numeric_pack_unpack_v<Format, N>;
template <class Format, class Enable = void>
struct _default_rounding_mode : integral_constant<rounding_mode, rounding_mode::toward_zero>
{
};
template <class Format>
struct _default_rounding_mode<Format, enable_if_t<is_same_v<Format, metal_fp4_e2m1_format> ||
                                                  is_same_v<Format, metal_fp8_e4m3_format> ||
                                                  is_same_v<Format, metal_fp8_e5m2_format>>> : integral_constant<rounding_mode, rounding_mode::to_nearest_even>
{
};
template <class Format>
constant constexpr rounding_mode _default_rounding_mode_v = _default_rounding_mode<Format>::value;
template <class Format, class Enable = void>
struct _default_saturation_mode : integral_constant<saturation_mode, saturation_mode::saturate>
{
};
template <class Format>
struct _default_saturation_mode<Format, enable_if_t<is_same_v<Format, metal_fp8_e5m2_format>>> : integral_constant<saturation_mode, saturation_mode::none>
{
};
template <class Format>
constant constexpr saturation_mode _default_saturation_mode_v = _default_saturation_mode<Format>::value;
} // namespace __packed_numeric_detail

template <class Format, rounding_mode Rm = __packed_numeric_detail::_default_rounding_mode_v<Format>, saturation_mode Sm = __packed_numeric_detail::_default_saturation_mode_v<Format>, class T, size_t N>
METAL_FUNC enable_if_t<__packed_numeric_detail::_valid_pack_v<Format, Sm, T, N>, packed_numeric_type<Format, N>> pack(vec<T, N> v)
{
  return packed_numeric_type<Format, N>(__metal_pack(v, char(Rm), char(Sm), typename packed_numeric_type<Format, N>::storage_type(), Format()));
}

template <class T, class Format, size_t N>
METAL_FUNC enable_if_t<__packed_numeric_detail::_valid_unpack_v<T, Format, N>, vec<T, N>> unpack(packed_numeric_type<Format, N> v)
{
  return __metal_unpack(v.as_storage_type(), vec<T, N>(), Format());
}
