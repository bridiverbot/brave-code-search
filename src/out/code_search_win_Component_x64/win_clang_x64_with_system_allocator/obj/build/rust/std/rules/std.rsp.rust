-Clinker=../../third_party/llvm-build/Release+Asserts/bin/lld-link
-Clink-arg=--rsp-quoting=posix
--crate-name
std
--crate-type
rlib
--cfg=backtrace_in_libstd
-Zforce-unstable-if-unmarked
--cap-lints=allow
--cfg
backtrace_in_libstd
--cfg=feature="object"
--edition=2024
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--target=x86_64-pc-windows-msvc
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
