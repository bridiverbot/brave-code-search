{
    "rustenv": {
        "OUT_DIR": "clang_x64_for_rust_host_build_tools/gen/third_party/rust/proc_macro2/v1/proc_macro2_lib_v1_build_script",
        "CLIPPY_CONF_DIR": "../../build/config",
        "CARGO_PKG_AUTHORS": "David Tolnay <dtolnay@gmail.com>, Alex Crichton <alex@alexcrichton.com>",
        "CARGO_PKG_VERSION": "1.0.107",
        "CARGO_PKG_VERSION_MAJOR": "1",
        "CARGO_PKG_VERSION_MINOR": "0",
        "CARGO_PKG_VERSION_PATCH": "107",
        "CARGO_PKG_VERSION_PRE": "",
        "CARGO_PKG_NAME": "proc-macro2",
        "CARGO_PKG_DESCRIPTION": "A substitute implementation of the compiler's `proc_macro` API to decouple token-based libraries from the procedural macro use case.",
        "CARGO_PKG_REPOSITORY": "https://github.com/dtolnay/proc-macro2",
        "CARGO_MANIFEST_DIR": "."
    },
    "rustflags": [
        "-Clinker=../../third_party/llvm-build/Release+Asserts/bin/clang++",
        "../../third_party/rust/chromium_crates_io/vendor/proc-macro2-v1/build.rs",
        "-Clink-arg=-fPIC",
        "-Clink-arg=--target=x86_64-unknown-linux-gnu",
        "-Clink-arg=-no-canonical-prefixes",
        "-Clink-arg=-Wl,--gc-sections",
        "-Clink-arg=-Wl,-z,defs",
        "-Clink-arg=-Wl,--as-needed",
        "-Clink-arg=-nostdlib++",
        "-Clink-arg=--sysroot=../../build/linux/debian_bullseye_amd64-sysroot",
        "-Clink-arg=-fuse-ld=lld",
        "-Clink-arg=-Wl,--fatal-warnings",
        "-Clink-arg=-Wl,--build-id=fast",
        "-Clink-arg=-Wl,-z,noexecstack",
        "-Clink-arg=-Wl,-z,relro",
        "-Clink-arg=-Wl,-z,now",
        "-Clink-arg=-Wl,--icf=all",
        "-Clink-arg=-Wl,--color-diagnostics",
        "-Clink-arg=-Wl,--undefined-version",
        "-Clink-arg=-Wl,--no-call-graph-profile-sort",
        "-Clink-arg=-rdynamic",
        "-Clink-arg=-pie",
        "-Clink-arg=-Wl,--disable-new-dtags",
        "-Clink-arg=-Werror",
        "@clang_x64_for_rust_host_build_tools/obj/third_party/rust/proc_macro2/v1/proc_macro2_lib_v1_build_script.rsp.rust"
    ]
}