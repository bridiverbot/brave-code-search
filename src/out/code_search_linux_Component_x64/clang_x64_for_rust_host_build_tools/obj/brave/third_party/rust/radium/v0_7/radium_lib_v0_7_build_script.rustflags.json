{
    "rustenv": {
        "OUT_DIR": "clang_x64_for_rust_host_build_tools/gen/brave/third_party/rust/radium/v0_7/radium_lib_v0_7_build_script",
        "CLIPPY_CONF_DIR": "../../build/config",
        "CARGO_PKG_AUTHORS": "Nika Layzell <nika@thelayzells.com>, myrrlyn <self@myrrlyn.dev>",
        "CARGO_PKG_VERSION": "0.7.0",
        "CARGO_PKG_VERSION_MAJOR": "0",
        "CARGO_PKG_VERSION_MINOR": "7",
        "CARGO_PKG_VERSION_PATCH": "0",
        "CARGO_PKG_VERSION_PRE": "",
        "CARGO_PKG_NAME": "radium",
        "CARGO_PKG_DESCRIPTION": "Portable interfaces for maybe-atomic types",
        "CARGO_PKG_REPOSITORY": "https://github.com/bitvecto-rs/radium",
        "CARGO_MANIFEST_DIR": "."
    },
    "rustflags": [
        "-Clinker=../../third_party/llvm-build/Release+Asserts/bin/clang++",
        "../../brave/third_party/rust/chromium_crates_io/vendor/radium-v0_7/build.rs",
        "-Clink-arg=-fPIC",
        "-Clink-arg=--target=x86_64-unknown-linux-gnu",
        "-Clink-arg=-no-canonical-prefixes",
        "-Clink-arg=-Wl,--gc-sections",
        "-Clink-arg=-Wl,-z,defs",
        "-Clink-arg=-Wl,--as-needed",
        "-Clink-arg=-nostdlib++",
        "-Clink-arg=--sysroot=../../build/linux/debian_bullseye_amd64-sysroot",
        "-Clink-arg=--ld-path=../../buildtools/third_party/mold/cipd/mold",
        "-Clink-arg=-Wl,--fatal-warnings",
        "-Clink-arg=-Wl,--build-id",
        "-Clink-arg=-Wl,-z,noexecstack",
        "-Clink-arg=-Wl,-z,relro",
        "-Clink-arg=-Wl,-z,now",
        "-Clink-arg=-Wl,--icf=all",
        "-Clink-arg=-Wl,--undefined-version",
        "-Clink-arg=-rdynamic",
        "-Clink-arg=-pie",
        "-Clink-arg=-Wl,--disable-new-dtags",
        "-Clink-arg=-Werror",
        "@clang_x64_for_rust_host_build_tools/obj/brave/third_party/rust/radium/v0_7/radium_lib_v0_7_build_script.rsp.rust"
    ]
}