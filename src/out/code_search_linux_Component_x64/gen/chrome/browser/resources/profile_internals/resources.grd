<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/profile_internals_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/profile_internals_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/profile_internals_resources_map.h"
            type="resource_map_header" />
    <output filename="profile_internals_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_PROFILE_INTERNALS_PROFILE_INTERNALS_HTML" file="${root_gen_dir}/chrome/browser/resources/profile_internals/preprocessed/profile_internals.html" resource_path="profile_internals.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PROFILE_INTERNALS_PROFILE_INTERNALS_APP_JS" file="${root_gen_dir}/chrome/browser/resources/profile_internals/minified/profile_internals_app.js" resource_path="profile_internals_app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PROFILE_INTERNALS_PROFILE_INTERNALS_BROWSER_PROXY_JS" file="${root_gen_dir}/chrome/browser/resources/profile_internals/minified/profile_internals_browser_proxy.js" resource_path="profile_internals_browser_proxy.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PROFILE_INTERNALS_PROFILE_INTERNALS_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/profile_internals/minified/profile_internals_app.html.js" resource_path="profile_internals_app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PROFILE_INTERNALS_PROFILE_INTERNALS_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/profile_internals/minified/profile_internals_app.css.js" resource_path="profile_internals_app.css.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
