<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/organizer_panel_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/organizer_panel_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/organizer_panel_resources_map.h"
            type="resource_map_header" />
    <output filename="organizer_panel_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_ORGANIZER_PANEL_ORGANIZER_PANEL_CSS" file="${root_gen_dir}/chrome/browser/resources/organizer_panel/preprocessed/organizer_panel.css" resource_path="organizer_panel.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_ORGANIZER_PANEL_ORGANIZER_PANEL_HTML" file="${root_gen_dir}/chrome/browser/resources/organizer_panel/preprocessed/organizer_panel.html" resource_path="organizer_panel.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ORGANIZER_PANEL_ORGANIZER_PANEL_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/organizer_panel/minified/organizer_panel.rollup.js" resource_path="organizer_panel.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
