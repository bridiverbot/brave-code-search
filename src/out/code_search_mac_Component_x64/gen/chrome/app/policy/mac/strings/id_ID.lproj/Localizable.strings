/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Preferensi Brave";
AIModeSettings.pfm_title = "Setelan untuk integrasi Mode AI Google di kolom URL dan kotak penelusuran halaman Tab Baru.";
AIModeSettings.pfm_description = "0 - Izinkan integrasi Mode AI.\n1 - Jangan izinkan integrasi Mode AI.\nKebijakan ini mengontrol integrasi Mode AI Google di kolom URL dan kotak penelusuran halaman Tab Baru.\n\nUntuk mengakses fitur ini, Google harus disetel sebagai mesin telusur default pengguna.\n\nNilai 0 = Fitur tersebut akan tersedia bagi pengguna.\n\nNilai 1 = Fitur tidak akan tersedia bagi pengguna.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.";
AbusiveExperienceInterventionEnforce.pfm_title = "Penerapan Pencegahan Pengalaman yang Menyinggung";
AbusiveExperienceInterventionEnforce.pfm_description = "Jika SafeBrowsingEnabled tidak Dinonaktifkan, menyetel AbusiveExperienceInterventionEnforce ke Aktif atau tidak menyetelnya akan mencegah situs dengan elemen menyesatkan terbuka di jendela atau tab baru.\n\nJika SafeBrowsingEnabled atau AbusiveExperienceInterventionEnforce disetel ke Nonaktif, situs dengan elemen menyesatkan akan terbuka di jendela dan tab baru.";
AccessCodeCastDeviceDuration.pfm_title = "Menentukan durasi (dalam detik) perangkat transmisi yang dipilih dengan kode akses atau kode QR untuk tetap berada dalam daftar perangkat transmisi pada menu Google Cast.";
AccessCodeCastDeviceDuration.pfm_description = "Kebijakan ini menentukan durasi (dalam detik) perangkat transmisi yang sebelumnya dipilih melalui kode akses atau kode QR dapat dilihat di menu perangkat transmisi Google Cast.\nMasa aktif entri dimulai pada waktu kode akses pertama kali dimasukkan atau kode QR pertama kali dipindai.\nSelama periode ini, perangkat transmisi akan muncul di daftar perangkat transmisi pada menu Google Cast.\nSetelah periode ini, kode akses harus dimasukkan ulang atau kode QR harus dipindai ulang untuk menggunakan perangkat transmisi lagi.\nSecara default, durasi periode ini adalah nol detik, sehingga perangkat transmisi tidak akan berada di menu Google Cast, dan kode akses harus dimasukkan ulang atau kode QR harus dipindai ulang untuk memulai sesi transmisi baru.\nPerlu diperhatikan bahwa kebijakan ini hanya memengaruhi durasi kemunculan perangkat transmisi di menu Google Cast, dan tidak memengaruhi sesi transmisi yang sedang berlangsung yang akan tetap dilanjutkan meskipun periode telah berakhir.\nKebijakan ini tidak akan berpengaruh kecuali jika kebijakan AccessCodeCastEnabled disetel ke Aktif.";
AccessCodeCastEnabled.pfm_title = "Mengizinkan pengguna memilih perangkat transmisi dengan akses kode atau kode QR dari dalam menu Google Cast.";
AccessCodeCastEnabled.pfm_description = "Kebijakan ini mengontrol apakah pengguna akan diberi opsi, dalam menu Google Cast yang memungkinkan mereka melakukan transmisi ke perangkat transmisi yang tidak muncul di menu Google Cast, menggunakan kode akses atau kode QR yang ditampilkan di layar perangkat transmisi.\nSecara default, pengguna harus memasukkan ulang kode akses atau memindai ulang kode QR untuk memulai sesi transmisi selanjutnya, tetapi jika kebijakan AccessCodeCastDeviceDuration telah disetel ke nilai bukan nol (nilai default adalah nol), perangkat transmisi akan tetap berada di daftar perangkat transmisi yang tersedia hingga periode waktu yang telah ditentukan berakhir.\nJika kebijakan ini disetel ke Aktif, pengguna akan diberi opsi untuk memilih perangkat transmisi dengan menggunakan kode akses atau dengan memindai kode QR.\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, pengguna tidak akan diberi opsi untuk memilih perangkat transmisi dengan menggunakan kode akses atau dengan memindai kode QR.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "Menyesuaikan pencocokan Access-Control-Allow-Methods di spesifikasi preflight CORS";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Kebijakan ini mengontrol apakah metode permintaan akan ditulis dengan huruf kapital saat mencocokkan dengan header respons Access-Control-Allow-Methods di preflight CORS.\n\nJika kebijakan disetel ke Nonaktif, metode permintaan akan menggunakan huruf kapital.\nIni adalah perilaku pada atau sebelum Brave 108.\n\nJika kebijakan disetel ke Aktif atau tidak disetel, metode permintaan tidak akan ditulis dengan huruf kapital, kecuali jika pencocokan dengan DELETE, GET, HEAD, OPTIONS, POST, atauPUT tidak peka huruf besar/kecil.\nTindakan ini akan menolak header respons fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\",\ndan akan menerima header respons fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\".\n\nCatatan: metode permintaan \"post\" dan \"put\" tidak akan terpengaruh, sedangkan \"patch\" akan terpengaruh.\n\nKebijakan ini bersifat sementara dan akan dihapus pada masa mendatang.";
AccessibilityImageLabelsEnabled.pfm_title = "Mengaktifkan Get Image Descriptions from Google";
AccessibilityImageLabelsEnabled.pfm_description = "Fitur aksesibilitas Get Image Descriptions from Google\nmemungkinkan pengguna pembaca layar yang merupakan penyandang gangguan penglihatan untuk\nmendapatkan deskripsi gambar tanpa label di web. Pengguna yang memilih untuk mengaktifkannya\nakan memiliki opsi untuk menggunakan layanan Google anonim agar memberikan\ndeskripsi otomatis terkait gambar tanpa label yang ditemukan di web.\n\nJika fitur ini diaktifkan, konten gambar akan dikirimkan ke server\nGoogle untuk membuat deskripsi. Tidak ada cookie atau data pengguna lainnya\nyang dikirimkan, dan Google tidak menyimpan atau mencatat log konten gambar apa pun.\n\nJika kebijakan ini disetel ke Aktif, fitur\nGet Image Descriptions from Google\nakan diaktifkan, meskipun hanya akan memengaruhi pengguna yang menggunakan\npembaca layar atau teknologi pendukung lain yang serupa.\n\nJika kebijakan ini disetel ke Nonaktif, pengguna tidak akan memiliki opsi untuk mengaktifkan\nfitur tersebut.\n\nJika kebijakan ini tidak disetel, pengguna dapat memilih untuk menggunakan fitur ini atau tidak.\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "Mengizinkan kueri DNS untuk jenis data DNS tambahan";
AdditionalDnsQueryTypesEnabled.pfm_description = "Kebijakan ini mengontrol apakah Brave dapat mengkueri jenis data DNS tambahan saat membuat permintaan DNS yang tidak aman. Kebijakan ini tidak memengaruhi kueri DNS yang dibuat melalui DNS Aman, yang selalu dapat mengkueri jenis DNS tambahan.\n\nJika kebijakan ini tidak disetel atau disetel ke Aktif, jenis tambahan seperti HTTPS (DNS jenis 65) dapat dikueri, selain A (DNS jenis 1) dan AAAA (DNS jenis 28).\n\nJika kebijakan ini disetel ke Nonaktif, DNS hanya akan dikueri untuk A (DNS jenis 1) dan/atau AAAA (DNS jenis 28).\n\nKebijakan ini adalah tindakan sementara dan akan dihapus di Brave versi mendatang. Setelah kebijakan dihapus, Brave akan dapat mengkueri jenis DNS tambahan kapan saja.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Setelan iklan untuk situs yang menayangkan iklan mengganggu";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Izinkan iklan di semua situs\n2 - Jangan izinkan iklan di situs yang menayangkan iklan mengganggu\nJika AdsSettingForIntrusiveAdsSites disetel ke 1 atau tidak disetel, iklan akan diizinkan di semua situs, kecuali SafeBrowsingEnabled disetel ke Salah (False).\n\nJika kebijakan disetel ke 2, iklan akan diblokir di situs yang menayangkan iklan mengganggu.";
AdvancedProtectionAllowed.pfm_title = "Mengaktifkan perlindungan tambahan untuk pengguna yang terdaftar di Program Perlindungan Lanjutan";
AdvancedProtectionAllowed.pfm_description = "Kebijakan ini mengontrol apakah pengguna yang terdaftar dalam Program Perlindungan Lanjutan menerima perlindungan tambahan. Beberapa fitur ini dapat mencakup pembagian data kepada Google (misalnya, pengguna Perlindungan Lanjutan akan dapat mengirimkan hasil downloadnya ke Google untuk pemindaian malware). Jika ditetapkan ke Benar atau tidak ditetapkan, pengguna terdaftar akan menerima perlindungan tambahan. Jika ditetapkan ke Salah, pengguna Perlindungan Lanjutan hanya akan menerima fitur konsumen standar.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Daftar asal yang mengizinkan semua autentikasi HTTP";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "Jika kebijakan ini disetel, hal ini akan menentukan origin yang akan mengizinkan semua skema autentikasi HTTP yang didukung Brave, terlepas dari nilai kebijakan AuthSchemes.\n\nMulai Brave versi 161, kebijakan ini hanya berlaku untuk origin server tujuan dan tidak berlaku untuk permintaan autentikasi server proxy. Untuk mengizinkan semua skema autentikasi HTTP bagi server proxy, gunakan kebijakan AllHttpAuthSchemesAllowedForProxies. Sebelum versi 161, server proxy yang cocok dengan kebijakan ini juga diizinkan untuk menggunakan semua skema autentikasi HTTP, kecuali jika AllHttpAuthSchemesAllowedForProxies disetel.\n\nFormat pola origin sesuai dengan format ini (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Hingga 1.000 pengecualian dapat ditentukan di AllHttpAuthSchemesAllowedForOrigins.\nKarakter pengganti diizinkan untuk komponen host (misalnya, '*:8000' cocok dengan semua host di port 8000). Untuk mencocokkan semua skema atau semua port, hapus komponen sepenuhnya (misalnya, 'example.com' cocok dengan skema dan port apa pun). Nama host (misalnya, 'example.com') juga cocok dengan subdomainnya. Untuk mencocokkan host secara persis dan mengecualikan subdomainnya, tambahkan titik di depannya (misalnya, '.example.com'). Untuk mencocokkan semua origin, gunakan satu tanda bintang ('*').";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Daftar server proxy yang mengizinkan semua skema autentikasi HTTP";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "Jika kebijakan ini disetel, hal ini akan menentukan server proxy yang akan mengizinkan semua skema autentikasi HTTP yang didukung Brave, terlepas dari nilai kebijakan AuthSchemes.\n\nPastikan format pola server proxy sesuai dengan format filter daftar URL yang tidak diizinkan (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Hingga 1.000 pengecualian dapat ditentukan.\nKarakter pengganti diizinkan untuk komponen host (misalnya, '*:8080' cocok dengan semua proxy di port 8080). Nama host (misalnya, 'proxy.example.com') juga cocok dengan subdomainnya. Untuk mencocokkan host secara persis dan mengecualikan subdomainnya, tambahkan titik di depannya (misalnya, '.proxy.example.com').\n\nJika kebijakan ini tidak disetel, hanya skema autentikasi HTTP yang ditentukan di AuthSchemes (atau skema default jika tidak disetel) yang didukung untuk autentikasi proxy.";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Izinkan halaman dengan header Cache-Control: no-store masuk ke back-forward cache";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Kebijakan ini mengontrol apakah halaman dengan header Cache-Control: no-store dapat disimpan dalam back-forward cache. Situs yang menyetel header ini mungkin tidak mengharapkan halaman tersebut dipulihkan dari back-forward cache karena beberapa informasi sensitif masih dapat ditampilkan setelah pemulihan, meskipun tidak dapat diakses lagi.\n\nJika kebijakan ini disetel ke aktif atau tidak disetel, halaman dengan header Cache-Control: no-store dapat dipulihkan dari back-forward cache, kecuali jika penghapusan cache dipicu (misalnya, saat ada perubahan cookie khusus HTTP pada situs).\n\nJika kebijakan ini disetel ke nonaktif, halaman dengan header Cache-Control: no-store tidak akan disimpan dalam back-forward cache.";
AllowCrossOriginAuthPrompt.pfm_title = "Permintaan Autentikasi HTTP lintas asal";
AllowCrossOriginAuthPrompt.pfm_description = "Jika kebijakan disetel ke Aktif, gambar pihak ketiga di halaman dapat menampilkan perintah autentikasi.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, gambar pihak ketiga tidak dapat menampilkan perintah autentikasi.\n\nKebijakan ini biasanya Dinonaktifkan sebagai pertahanan terhadap phishing.";
AllowDeletingBrowserHistory.pfm_title = "Aktifkan penghapusan histori download atau browser";
AllowDeletingBrowserHistory.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, histori browser dan histori download dapat dihapus di Chrome, dan pengguna tidak dapat mengubah setelan ini.\n\nJika kebijakan disetel ke Nonaktif, histori browser dan histori download tidak dapat dihapus. Meskipun kebijakan ini dinonaktifkan, histori penjelajahan dan download tidak dijamin akan dipertahankan. Pengguna dapat langsung mengedit atau menghapus file database histori, dan browser dapat tidak berlaku lagi atau mengarsipkan beberapa atau semua item histori setiap saat.";
AllowDinosaurEasterEgg.pfm_title = "Izinkan Game Dinosaur Easter Egg";
AllowDinosaurEasterEgg.pfm_description = "Jika kebijakan disetel ke Benar (True), pengguna akan diizinkan untuk memainkan game dinosaurus. Jika kebijakan disetel ke Salah (False), pengguna tidak dapat memainkan game dinosaurus sebagai fitur tersembunyi saat perangkat offline.\n\nJika kebijakan tidak disetel, pengguna tidak dapat memainkan game di Google Chrome OS yang terdaftar, tetapi dapat memainkannya dalam kondisi lain.";
AllowFileSelectionDialogs.pfm_title = "Izinkan permintaan dialog pemilihan file";
AllowFileSelectionDialogs.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, Chrome akan dapat menampilkan dialog pemilihan file, dan pengguna dapat membukanya.\n\nJika kebijakan disetel ke Nonaktif, pesan akan muncul setiap kali pengguna melakukan tindakan yang memicu dialog pemilihan file, seperti mengimpor bookmark, mengupload file, atau menyimpan link. Pengguna dianggap telah mengklik Batal pada dialog pemilihan file.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Izinkan pengacakan ukuran pool soket untuk proxy";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "Pengacakan ukuran pool soket adalah mekanisme keamanan yang mencegah penyerang mengeksploitasi batas kapasitas deterministik untuk mempelajari informasi lintas situs.\nJika kapasitas normal sebuah pool adalah 128 soket, mekanisme ini akan membatasi kapasitas pool tersebut secara acak di rentang antara 128 hingga 256.\nHal ini memungkinkan jumlah koneksi ke proxy hingga 2x lipat lebih banyak, meski pada praktiknya nilai yang dihasilkan biasanya berkisar di angka 1,2x.\n\nHal ini memengaruhi setelan dari MaxConnectionsPerProxy dan MaxConnectionsPerProxyForWebSocket.\nAlih-alih menjadi penentu batas atas, batas atas yang sebenarnya adalah 2x dari nilai tersebut (meskipun nilai yang diharapkan pada praktiknya berkisar di angka 1,2x).\n\nFitur ini diaktifkan secara default untuk semua pool, tetapi kebijakan ini memungkinkan fitur tersebut dinonaktifkan khusus untuk pool proxy.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Mengizinkan permintaan Autentikasi Web di situs dengan sertifikat TLS yang rusak.";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Jika kebijakan disetel ke Aktif, Brave akan\nmengizinkan permintaan Autentikasi Web di situs yang memiliki sertifikat TLS yang mengalami\nerror (yaitu, situs yang dianggap tidak aman).\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, perilaku default\npemblokiran permintaan semacam itu akan diterapkan.";
AllowedDomainsForApps.pfm_title = "Menentukan domain yang diizinkan untuk mengakses Google Workspace";
AllowedDomainsForApps.pfm_description = "Jika kebijakan disetel, fitur login terbatas Chrome di Google Workspace akan diaktifkan dan pengguna tidak dapat mengubah setelan ini. Pengguna hanya dapat mengakses alat Google menggunakan akun dari domain yang telah ditentukan (untuk mengizinkan akun gmail atau googlemail, tambahkan consumer_accounts ke daftar domain). Setelan ini mencegah pengguna untuk login dan menambahkan Akun Sekunder di perangkat terkelola yang memerlukan autentikasi Google, jika akun tersebut bukan milik salah satu domain yang diizinkan secara eksplisit.\n\nJika setelan ini dibiarkan kosong atau tidak disetel, pengguna dapat mengakses Google Workspace dengan akun apa pun.\n\nPengguna tidak dapat mengubah atau mengganti setelan ini.\n\nCatatan: Kebijakan ini menyebabkan header X-GoogApps-Allowed-Domains ditambahkan ke semua permintaan HTTP dan HTTPS di semua domain google.com, seperti yang dijelaskan di https://support.google.com/a/answer/1668854.";
AlternateErrorPagesEnabled.pfm_title = "Mengaktifkan halaman kesalahan alternatif";
AlternateErrorPagesEnabled.pfm_description = "Jika kebijakan disetel ke Benar (True), Brave akan menggunakan halaman error alternatif yang telah disertakan dalam browser tersebut (seperti \"halaman tidak ditemukan\"). Jika kebijakan disetel ke Salah (False), Brave tidak akan pernah menggunakan halaman error alternatif.\n\nJika Anda menyetel kebijakan, pengguna tidak dapat mengubahnya. Jika tidak disetel, kebijakan akan aktif tetapi pengguna dapat mengubah setelan ini.";
AlternativeBrowserParameters.pfm_title = "Parameter command line untuk browser alternatif.";
AlternativeBrowserParameters.pfm_description = "Menyetel kebijakan ke daftar string berarti setiap string akan diteruskan ke browser alternatif sebagai parameter command line yang berbeda. Pada Microsoft® Windows®, parameter digabungkan dengan spasi. Pada macOS dan Linux®, parameter dapat berisi spasi dan masih diperlakukan sebagai parameter tunggal.\n\nJika parameter berisi ${url}, ${url} akan diganti dengan URL halaman yang akan dibuka. Jika tidak ada parameter yang berisi ${url}, URL akan ditambahkan di akhir command line.\n\nVariabel lingkungan diperluas. Pada Microsoft® Windows®, %ABC% akan diganti dengan nilai variabel lingkungan ABC. Pada macOS dan Linux®, ${ABC} akan diganti dengan nilai variabel lingkungan ABC.\n\nJika kebijakan tidak disetel, hanya URL yang akan diteruskan sebagai parameter command line.";
AlternativeBrowserPath.pfm_title = "Browser alternatif untuk membuka situs yang dikonfigurasi.";
AlternativeBrowserPath.pfm_description = "Menyetel kebijakan akan mengontrol perintah yang digunakan untuk membuka URL dalam browser alternatif. Kebijakan ini dapat disetel ke salah satu dari ${ie}, ${firefox}, ${safari}, ${opera}, ${edge}, atau jalur file. Ketika kebijakan ini disetel ke jalur file, file tersebut akan digunakan sebagai file yang dapat dieksekusi. ${ie} hanya tersedia di Microsoft® Windows®. ${safari} dan ${edge} hanya tersedia di Microsoft® Windows® dan macOS.\n\nJika kebijakan tidak disetel, kebijakan default khusus platform akan digunakan: Internet Explorer® untuk Microsoft® Windows®, atau Safari® untuk macOS. Di Linux®, peluncuran browser alternatif akan gagal.";
AlwaysOpenPdfExternally.pfm_title = "Selalu Buka file PDF secara eksternal";
AlwaysOpenPdfExternally.pfm_description = "Jika kebijakan disetel ke Aktif, penampil PDF internal di Brave akan dinonaktifkan, file PDF akan dianggap sebagai hasil download, dan pengguna akan diizinkan membuka PDF dengan aplikasi default.\n\nJika kebijakan disetel ke Nonaktif, file PDF akan dibuka kecuali jika pengguna menonaktifkan plugin PDF.\n\nJika Anda menyetel kebijakan, pengguna tidak dapat mengubahnya di Brave. Jika kebijakan tidak disetel, pengguna dapat memilih apakah akan membuka PDF secara eksternal atau tidak.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Mengaktifkan Autentikasi Pasif untuk jenis profil.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Mengaktifkan autentikasi pasif di sesi reguler saja.\n1 - Mengaktifkan autentikasi pasif di sesi samaran dan reguler.\n2 - Mengaktifkan autentikasi pasif di sesi tamu dan reguler.\n3 - Mengaktifkan autentikasi pasif di sesi reguler, samaran, dan tamu.\nJika kebijakan ini dikonfigurasi, profil Samaran dan Tamu di Brave akan diizinkan/dilarang untuk melakukan autentikasi pasif.\n\nAutentikasi Pasif adalah autentikasi http dengan kredensial default jika kredensial eksplisit tidak diberikan melalui skema verifikasi/respons NTLM/Kerberos/Negotiate.\n\nJika RegularOnly (nilai 0) ditetapkan, hanya sesi Reguler yang akan diizinkan untuk melakukan autentikasi pasif. Sesi Samaran dan Tamu tidak akan diizinkan untuk melakukan autentikasi pasif.\n\nJika IncognitoAndRegular (nilai 1) ditetapkan, sesi Samaran dan Reguler akan diizinkan untuk melakukan autentikasi pasif. Sesi Tamu tidak akan diizinkan untuk melakukan autentikasi pasif.\n\nJika GuestAndRegular (nilai 2) ditetapkan, sesi Tamu dan Reguler akan diizinkan untuk melakukan autentikasi pasif. Sesi Samaran tidak akan diizinkan untuk melakukan autentikasi pasif.\n\nJika All (nilai 3) ditetapkan, semua sesi akan diizinkan untuk melakukan autentikasi pasif.\n\nPerlu diketahui, autentikasi pasif selalu diizinkan pada profil reguler.\n\nDalam Brave versi 81 dan setelahnya, jika kebijakan tidak ditetapkan, autentikasi pasif hanya akan diaktifkan di sesi reguler.";
AudioCaptureAllowed.pfm_title = "Izinkan atau tolak penangkapan audio";
AudioCaptureAllowed.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna akan dimintai akses perekaman audio kecuali untuk URL yang ditentukan dalam daftar AudioCaptureAllowedUrls.\n\nJika kebijakan disetel ke Nonaktif, permintaan izin akan dinonaktifkan dan perekaman audio hanya tersedia untuk URL yang ditentukan dalam daftar AudioCaptureAllowedUrls.\n\nCatatan: Kebijakan ini memengaruhi semua input audio (tidak hanya mikrofon bawaan).";
AudioCaptureAllowedUrls.pfm_title = "URL yang akan diberi akses ke perangkat perekam audio tanpa peringatan";
AudioCaptureAllowedUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan menentukan daftar URL yang polanya cocok dengan origin keamanan URL yang meminta. Jika terdapat kecocokan, akses ke perangkat perekaman audio akan diberikan tanpa permintaan izin\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns/. Namun, perlu diperhatikan bahwa pola \"*\", yang cocok dengan URL apa pun, tidak didukung oleh kebijakan ini.";
AudioSandboxEnabled.pfm_title = "Mengizinkan sandbox audio berjalan";
AudioSandboxEnabled.pfm_description = "Kebijakan ini mengontrol proses audio dalam sandbox.\nJika kebijakan ini diaktifkan, proses audio akan berjalan dalam sandbox.\nJika kebijakan ini dinonaktifkan, proses audio akan berjalan di luar sandbox dan modul pemrosesan audio WebRTC akan berjalan dalam proses perender.\nHal ini akan membuat pengguna rentan terhadap risiko keamanan terkait proses menjalankan subsistem audio di luar sandbox.\nJika kebijakan ini tidak ditetapkan, konfigurasi default untuk sandbox audio akan digunakan, yang mungkin berbeda per platform.\nKebijakan ini ditujukan untuk memberikan fleksibilitas kepada perusahaan untuk menonaktifkan sandbox audio jika menggunakan penyiapan software keamanan yang mengganggu sandbox.";
AuthNegotiateDelegateAllowlist.pfm_title = "Daftar server delegasi Kerberos yang diizinkan";
AuthNegotiateDelegateAllowlist.pfm_description = "Menyetel kebijakan akan menetapkan server mana yang menjadi tujuan delegasi Brave. Pisahkan beberapa nama server dengan koma. Karakter pengganti, *, diizinkan.\n\nJika kebijakan tidak disetel, Brave tidak akan mendelegasikan kredensial pengguna, meskipun server terdeteksi sebagai intranet.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Gunakan kebijakan KDC untuk mendelegasikan kredensial.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Jika kebijakan disetel ke Aktif, autentikasi HTTP akan mematuhi persetujuan dari kebijakan KDC. Dengan kata lain, Brave akan mendelegasikan kredensial pengguna ke layanan yang sedang diakses jika KDC menyetel OK-AS-DELEGATE pada tiket layanan. Lihat RFC 5896 ( https://tools.ietf.org/html/rfc5896.html ). Layanan juga harus diizinkan oleh AuthNegotiateDelegateAllowlist.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, kebijakan KDC akan diabaikan di platform yang didukung dan hanya AuthNegotiateDelegateAllowlist yang akan dipatuhi.\n\nDi Microsoft® Windows®, kebijakan KDC selalu dipatuhi.";
AuthSchemes.pfm_title = "Skema autentikasi yang didukung";
AuthSchemes.pfm_description = "Menyetel kebijakan akan menentukan skema autentikasi HTTP mana yang didukung oleh Brave.\n\nJika kebijakan tidak disetel, 4 skema akan diterapkan.\n\nNilai valid:\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nCatatan: Pisahkan beberapa nilai dengan koma.";
AuthServerAllowlist.pfm_title = "Daftar server autentikasi yang diizinkan";
AuthServerAllowlist.pfm_description = "Menyetel kebijakan akan menentukan server mana yang diizinkan untuk autentikasi terintegrasi. Autentikasi terintegrasi hanya aktif jika Brave mendapat pernyataan autentikasi dari proxy atau dari server yang ada di daftar yang diizinkan.\n\nJika kebijakan tidak disetel, Brave akan mencoba mendeteksi apakah server ada di intranet. Setelah itu, barulah permintaan IWA akan direspons. Jika server dideteksi sebagai intranet, Brave akan mengabaikan permintaan IWA darinya.\n\nCatatan: Pisahkan beberapa nama server dengan koma. Karakter pengganti, *, diizinkan.";
AutoLaunchProtocolsFromOrigins.pfm_title = "Menentukan daftar protokol yang dapat meluncurkan aplikasi eksternal dari asal yang tercantum tanpa meminta izin pengguna";
AutoLaunchProtocolsFromOrigins.pfm_description = "Memungkinkan Anda menyetel daftar protokol, dan daftar terkait pola origin yang diizinkan untuk setiap protokol, yang dapat meluncurkan aplikasi eksternal tanpa meminta izin pengguna. Pemisah di akhir tidak boleh disertakan saat mencantumkan protokol, jadi cantumkan \"skype\" bukan \"skype:\" atau \"skype://\".\n\nJika kebijakan ini disetel, protokol hanya akan diizinkan oleh kebijakan untuk meluncurkan aplikasi eksternal tanpa meminta izin jika protokol tersebut tercantum, dan origin situs yang mencoba meluncurkan protokol tersebut cocok dengan pola origin dalam daftar allowed_origins protokol. Jika salah satu kondisinya tidak terpenuhi, permintaan izin peluncuran protokol eksternal tidak akan dihilangkan oleh kebijakan.\n\nJika kebijakan ini tidak disetel, secara default tidak ada protokol yang dapat diluncurkan tanpa meminta izin. Pengguna dapat memilih tidak dimintai izin per protokol/per situs kecuali jika kebijakan ExternalProtocolDialogShowAlwaysOpenCheckbox disetel ke Nonaktif. Kebijakan ini tidak memengaruhi pengecualian permintaan izin per protokol/per situs yang disetel pengguna.\n\nPola yang cocok dengan origin akan menggunakan format serupa dengan kebijakan 'URLBlocklist' yang didokumentasikan di https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nNamun, pola yang cocok dengan origin untuk kebijakan ini tidak boleh berisi elemen \"/path\" atau \"@query\". Semua pola yang berisi elemen \"/path\" atau \"@query\" akan diabaikan.\nBuka https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins untuk informasi lebih lanjut terkait skema dan pemformatan.";
AutoOpenAllowedForURLs.pfm_title = "URL tempat AutoOpenFileTypes dapat diterapkan";
AutoOpenAllowedForURLs.pfm_description = "Daftar URL yang menentukan URL tempat AutoOpenFileTypes akan diterapkan. Kebijakan ini tidak berpengaruh pada nilai yang terbuka otomatis yang disetel oleh pengguna.\n\nJika kebijakan ini disetel, file hanya akan otomatis dibuka oleh kebijakan jika URL merupakan bagian dari daftar ini dan jenis file tercantum di AutoOpenFileTypes. Jika salah satu kondisinya tidak terpenuhi, hasil download tidak akan otomatis dibuka oleh kebijakan.\n\nJika kebijakan ini tidak disetel, semua hasil download yang jenis filenya tercantum di AutoOpenFileTypes akan otomatis terbuka.\n\nPola URL harus diformat sesuai dengan https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
AutoOpenFileTypes.pfm_title = "Daftar jenis file yang harus dibuka secara otomatis di hasil download";
AutoOpenFileTypes.pfm_description = "Daftar jenis file yang seharusnya terbuka otomatis saat didownload. Karakter pemisah yang ada di depan tidak boleh disertakan saat Anda mencantumkan jenis file, jadi cantumkan \"txt\", bukan \".txt\".\n\nFile dengan jenis yang seharusnya terbuka otomatis akan tetap melalui pemeriksaan Safe Browsing yang diaktifkan dan tidak akan dibuka jika tidak lolos pemeriksaan tersebut.\n\nJika kebijakan ini tidak ditetapkan, hanya jenis file yang telah ditentukan pengguna yang akan terbuka otomatis saat didownload.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
AutoSelectCertificateForUrls.pfm_title = "Memilih sertifikat klien untuk situs ini secara otomatis";
AutoSelectCertificateForUrls.pfm_description = "Menyetel kebijakan memungkinkan Anda membuat daftar pola URL yang menentukan untuk situs mana Chrome dapat memilih sertifikat klien secara otomatis. Nilai berupa array kamus dengan string JSON, dan setiap kamus memiliki bentuk { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER }, dengan pola setelan kontennya berupa $URL_PATTERN. $FILTER akan membatasi sertifikat klien yang dapat dipilih browser secara otomatis. Terlepas dari filter, hanya sertifikat yang cocok dengan permintaan sertifikat server yang akan dipilih. Di Android dan iOS, Chrome hanya dapat memilih sertifikat klien yang telah disediakan sendiri; Chrome tidak dapat mengakses sertifikat yang diinstal di tingkat sistem operasi.\n\nContoh untuk penggunaan bagian $FILTER:\n\n* Jika $FILTER disetel ke { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } }, hanya sertifikat klien yang diterbitkan oleh sertifikat dengan CommonName $ISSUER_CN yang akan dipilih.\n\n* Jika $FILTER berisi bagian \"ISSUER\" dan \"SUBJECT\", hanya sertifikat klien yang memenuhi kedua kondisi yang akan dipilih.\n\n* Jika $FILTER berisi bagian \"SUBJECT\" dengan nilai \"O\", sertifikat perlu minimal satu organisasi yang cocok dengan nilai yang ditentukan agar dapat dipilih.\n\n* Jika $FILTER berisi bagian \"SUBJECT\" dengan nilai \"OU\", sertifikat perlu minimal satu unit organisasi yang cocok dengan nilai yang ditentukan agar dapat dipilih.\n\n* Jika $FILTER disetel ke {}, pemilihan sertifikat klien tidak akan dibatasi lebih lanjut. Perhatikan bahwa filter yang diberikan oleh server web masih berlaku.\n\nJika kebijakan tidak disetel, tidak akan ada pemilihan otomatis untuk situs apa pun.\nBuka https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls untuk informasi lebih lanjut terkait skema dan pemformatan.";
AutofillGenAiSettings.pfm_title = "Setelan untuk fitur AI generatif di Isi Otomatis";
AutofillGenAiSettings.pfm_description = "0 - Izinkan fitur AI generatif di Isi Otomatis dan tingkatkan kualitas model AI.\n1 - Izinkan fitur AI generatif di Isi Otomatis tanpa meningkatkan kualitas model AI.\n2 - Jangan izinkan fitur AI generatif di Isi Otomatis.\nFitur di Brave ini menggunakan model AI generatif untuk membantu pengguna mengisi formulir di web. Untuk menggunakan fitur ini, Brave harus mengumpulkan data seperti struktur formulir yang diisi oleh pengguna dan, untuk fitur Temukan dan Isi dengan Gemini, kueri teks bebas yang dimasukkan pengguna untuk menelusuri aplikasi Gemini yang terhubung, lalu mengirimkan data tersebut ke server milik Google yang menjalankan model AI generatif.\n\nJika kebijakan ini disetel ke 0 (Izinkan fitur AI generatif di Isi Otomatis dan tingkatkan kualitas model AI), fitur tersebut akan diizinkan untuk digunakan, sekaligus mengizinkan Google menggunakan data yang relevan untuk meningkatkan kualitas model AI-nya. Data yang relevan mungkin mencakup perintah, input, output, materi referensi, dan masukan tertulis, bergantung pada fiturnya. Nilai 0 adalah nilai default, kecuali jika dinyatakan lain di bawah.\n\nJika kebijakan ini disetel ke 1 (Izinkan fitur AI generatif di Isi Otomatis tanpa meningkatkan kualitas model AI), fitur tersebut akan diizinkan untuk digunakan, tetapi Google tidak akan diizinkan untuk meningkatkan kualitas model menggunakan konten pengguna (termasuk perintah, input, output, materi referensi, dan masukan tertulis). Nilai 1 adalah nilai default untuk pengguna Enterprise yang dikelola oleh Google Admin console dan untuk akun Education yang dikelola oleh Google Workspace.\n\nJika kebijakan ini disetel ke 2 (Jangan izinkan fitur AI generatif di Isi Otomatis), fitur tersebut tidak akan diizinkan.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nFitur AI generatif di Isi Otomatis mencakup:\n\n- Pemahaman formulir yang lebih cerdas: menggunakan AI untuk mengidentifikasi dan mengklasifikasikan kolom formulir, sehingga lebih banyak kolom yang dapat diisi.\n\n- Temukan dan Isi dengan Gemini: menemukan informasi dari aplikasi yang telah dihubungkan pengguna ke Gemini dan menawarkannya untuk pengisian, baik sebagai saran proaktif pada formulir atau sebagai respons terhadap kueri yang ditulis pengguna.\n\nKebijakan ini menggantikan kebijakan AutofillPredictionSettings, yang masih berlaku jika kebijakan ini tidak disetel. Fitur \"Temukan dan Isi dengan Gemini\" juga mengharuskan kebijakan GeminiSettings tidak dinonaktifkan.\n\nKebijakan ini tidak mengontrol fitur Isi Otomatis yang tidak menggunakan AI generatif.\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
AutofillSettings.pfm_title = "Memblokir jenis data Isi Otomatis untuk situs tertentu";
AutofillSettings.pfm_description = "Jika kebijakan ini disetel, Anda dapat menentukan jenis data Isi Otomatis yang diblokir pada pola URL tertentu.\n\nKebijakan ini disusun dalam bentuk daftar kamus. Setiap kamus harus berisi:\n* \"url_pattern\": Pola URL setelan konten untuk bingkai utama (mis., \"https://[*.]example.com\").\n* \"blocked_types\": Daftar string yang mewakili kategori data Isi Otomatis yang akan diblokir.\n\nNilai yang didukung untuk \"blocked_types\" adalah:\n* \"contact_info\": Memblokir pengisian dan penyimpanan informasi kontak.\n* \"payments\": Memblokir pengisian dan penyimpanan kartu kredit serta metode pembayaran.\n* \"identity_docs\": Memblokir pengisian dan penyimpanan dokumen identitas (mis., paspor, surat izin mengemudi, kartu identitas nasional).\n* \"travel\": Memblokir pengisian dan penyimpanan informasi perjalanan (mis., reservasi penerbangan, pendaftaran kendaraan).\n* \"shopping\": Memblokir pengisian dan penyimpanan informasi belanja (mis., pesanan online, pengiriman).\n* \"all\": Memblokir pengisian dan penyimpanan semua jenis data Isi Otomatis.\n\nJika jenis data diblokir untuk suatu situs, pembuatan saran maupun perintah untuk menyimpan/mengimpor data baru dari jenis tersebut akan dinonaktifkan di situs tersebut.\n\nJika URL cocok dengan beberapa entri pola dalam daftar, jenis data yang diblokir dari semua entri yang cocok akan digabungkan (union-merged). Pola URL yang tidak valid dalam daftar akan diabaikan.\n\nJika kebijakan ini tidak disetel, tidak ada jenis data Isi Otomatis yang diblokir berdasarkan domain.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, buka:\nhttps://chromeenterprise.google/policies/url-patterns. Karakter pengganti * didukung. Pola ini cocok dengan URL apa pun, dengan skema, port, dan jalur apa pun.\nBuka https://chromeenterprise.google/policies/?policy=AutofillSettings untuk informasi lebih lanjut terkait skema dan pemformatan.";
AutomatedPasswordChangeSettings.pfm_title = "Aktifkan perubahan otomatis sandi";
AutomatedPasswordChangeSettings.pfm_description = "0 - Izinkan penggunaan fitur dan peningkatan kualitas model AI\n1 - Izinkan penggunaan fitur tanpa meningkatkan kualitas model AI\n2 - Jangan izinkan fitur\nKebijakan ini mengontrol ketersediaan fitur perubahan otomatis sandi Brave.\n\nJika diaktifkan, pengguna dapat memicu proses saat browser mencoba mengubah sandi mereka di situs secara otomatis. Proses ini dikelola oleh AI Generatif. Sandi baru disimpan di pengelola sandi browser.\n\nNilai 0 = Mengizinkan penggunaan fitur ini, sekaligus mengizinkan Google menggunakan data yang relevan untuk meningkatkan kualitas model AI-nya. Data yang relevan mungkin mencakup perintah, input, output, materi referensi, dan masukan tertulis, bergantung pada fiturnya. Data ini juga mungkin ditinjau secara manual untuk meningkatkan kualitas model AI. Nilai 0 adalah nilai default, kecuali jika dinyatakan lain di bawah.\n\nNilai 1 = Mengizinkan penggunaan fitur ini, tetapi tidak mengizinkan Google meningkatkan kualitas model menggunakan konten pengguna (termasuk perintah, input, output, materi referensi, dan masukan tertulis). Nilai 1 adalah nilai default untuk pengguna Enterprise yang dikelola oleh konsol Google Admin dan untuk akun Education yang dikelola oleh Google Workspace.\n\nNilai 2 = Tidak mengizinkan penggunaan fitur ini.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Izinkan download otomatis di situs ini";
AutomaticDownloadsAllowedForUrls.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL yang menentukan situs yang diizinkan mendownload beberapa file secara otomatis.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, buka https://chromeenterprise.google/policies/url-patterns.\n\nJika URL cocok dengan AutomaticDownloadsAllowedForUrls dan AutomaticDownloadsBlockedForUrls, AutomaticDownloadsBlockedForUrls akan diprioritaskan.\n\nJika kebijakan ini tidak disetel, DefaultAutomaticDownloadsSetting akan berlaku untuk semua situs, jika disetel. Jika tidak, setelan pribadi pengguna akan digunakan.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Blokir download otomatis di situs ini";
AutomaticDownloadsBlockedForUrls.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL yang menentukan situs yang tidak diizinkan mendownload beberapa file secara otomatis.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, buka https://chromeenterprise.google/policies/url-patterns.\n\nJika URL cocok dengan AutomaticDownloadsAllowedForUrls dan AutomaticDownloadsBlockedForUrls, AutomaticDownloadsBlockedForUrls akan diprioritaskan.\n\nJika kebijakan ini tidak disetel, DefaultAutomaticDownloadsSetting akan berlaku untuk semua situs, jika disetel. Jika tidak, setelan pribadi pengguna akan digunakan.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Mengizinkan mode layar penuh otomatis di situs ini";
AutomaticFullscreenAllowedForUrls.pfm_description = "Untuk alasan keamanan,\nrequestFullscreen() web API\nmemerlukan gestur pengguna sebelumnya (\"aktivasi sementara\") untuk dipanggil.\nJika tidak ada gestur pengguna sebelumnya, panggilan API ini akan gagal. Setelan pribadi pengguna dapat mengizinkan origin tertentu memanggil\nAPI ini tanpa gestur pengguna sebelumnya, seperti dijelaskan dalam\nhttps://chromestatus.com/feature/6218822004768768.\n\nKebijakan ini akan menggantikan setelan pribadi pengguna dan mengizinkan origin yang cocok\nmemanggil API tanpa gestur pengguna sebelumnya.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat\nhttps://chromeenterprise.google/policies/url-patterns.\nKarakter pengganti, *, diizinkan.\n\nOrigin yang cocok dengan pola kebijakan yang diblokir dan diizinkan akan diblokir.\nOrigin yang tidak ditentukan oleh kebijakan atau setelan pengguna akan memerlukan gestur pengguna sebelumnya\nuntuk memanggil API ini.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Memblokir mode layar penuh otomatis di situs ini";
AutomaticFullscreenBlockedForUrls.pfm_description = "Untuk alasan keamanan,\nrequestFullscreen() web API\nmemerlukan gestur pengguna sebelumnya (\"aktivasi sementara\") untuk dipanggil.\nJika tidak ada gestur pengguna sebelumnya, panggilan API ini akan gagal. Setelan pribadi pengguna dapat mengizinkan origin tertentu memanggil\nAPI ini tanpa gestur pengguna sebelumnya, seperti dijelaskan dalam\nhttps://chromestatus.com/feature/6218822004768768.\n\nKebijakan ini akan menggantikan setelan pribadi pengguna dan memblokir origin yang cocok\nagar tidak memanggil API tanpa gestur pengguna sebelumnya.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat\nhttps://chromeenterprise.google/policies/url-patterns.\nKarakter pengganti, *, diizinkan.\n\nOrigin yang cocok dengan pola kebijakan yang diblokir dan diizinkan akan diblokir.\nOrigin yang tidak ditentukan oleh kebijakan atau setelan pengguna akan memerlukan gestur pengguna sebelumnya\nuntuk memanggil API ini.";
AutoplayAllowed.pfm_title = "Izinkan pemutaran otomatis media";
AutoplayAllowed.pfm_description = "Jika kebijakan disetel ke Benar (True), Brave akan dapat memutar otomatis media. Jika kebijakan disetel ke Salah (False), Brave akan berhenti memutar otomatis media.\n\nJika kebijakan ini tidak disetel, Brave tidak memutar media secara otomatis. Tetapi, untuk pola URL tertentu, Anda dapat menggunakan kebijakan AutoplayAllowlist untuk mengubah setelan ini.\n\nJika kebijakan ini berubah saat Brave sedang berjalan, kebijakan hanya akan berlaku untuk tab yang baru dibuka.";
AutoplayAllowlist.pfm_title = "Izinkan pemutaran otomatis media pada pola URL yang diizinkan";
AutoplayAllowlist.pfm_description = "Jika kebijakan ini disetel, video akan dapat diputar secara otomatis (tanpa persetujuan pengguna) dengan konten audio di Brave. Jika kebijakan AutoplayAllowed disetel ke Benar (True), kebijakan ini tidak akan berpengaruh. Jika kebijakan AutoplayAllowed disetel ke Salah (False), pola URL yang disetel di kebijakan ini tetap dapat diputar. Jika kebijakan ini berubah saat Brave sedang berjalan, kebijakan hanya akan berlaku untuk tab yang baru dibuka.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat https://chromeenterprise.google/policies/url-patterns/.";
BackgroundTabFreezingEnabled.pfm_title = "Aktifkan pembekuan tab di latar belakang";
BackgroundTabFreezingEnabled.pfm_description = "Mengontrol apakah Brave membekukan tab latar belakang yang tidak aktif untuk menghemat CPU dan memori.\n\nSaat pembekuan tab latar belakang aktif, tab yang tidak aktif di latar belakang selama jangka waktu tertentu akan dibekukan dengan menjeda eksekusi JavaScript dan tugas timer. Tab yang dibekukan tetap dimuat dalam memori dan langsung dilanjutkan saat dipilih oleh pengguna. Tab dengan tugas latar belakang aktif—seperti tab yang memutar audio atau video, merekam layar atau streaming kamera, mempertahankan koneksi WebRTC aktif, atau menyimpan Web Locks—tidak memenuhi syarat untuk dibekukan dan akan terus berjalan. Situs yang dikonfigurasi dalam kebijakan TabDiscardingExceptions atau dalam pengecualian penghapusan tab pengguna juga dikecualikan dari pembekuan.\n\nJika kebijakan disetel ke Aktif, pembekuan tab latar belakang otomatis akan diaktifkan untuk tab latar belakang yang memenuhi syarat. Pengguna tidak dapat mengubah setelan ini.\n\nJika kebijakan disetel ke Nonaktif, tab latar belakang tidak akan dibekukan. Pengguna tidak dapat mengubah setelan ini.\n\nJika kebijakan ini tidak disetel, pembekuan tab latar belakang akan diaktifkan secara default, tetapi pengguna dapat mengaktifkan atau menonaktifkannya di setelan Brave.";
BasicAuthOverHttpEnabled.pfm_title = "Mengizinkan autentikasi Basic untuk HTTP";
BasicAuthOverHttpEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, verifikasi autentikasi Basic akan diizinkan diterima melalui HTTP yang tidak aman.\n\nJika kebijakan disetel ke Nonaktif, permintaan HTTP yang tidak aman akan dilarang menggunakan skema autentikasi Basic; hanya HTTPS yang diizinkan.\n\nSetelan kebijakan ini akan diabaikan (dan Basic akan selalu dilarang) jika kebijakan AuthSchemes disetel dan Basic tidak disertakan.";
BatterySaverModeAvailability.pfm_title = "Mengaktifkan Mode Penghemat Baterai";
BatterySaverModeAvailability.pfm_description = "0 - Mode Penghemat Baterai akan dinonaktifkan.\n1 - Mode Penghemat Baterai akan diaktifkan saat perangkat menggunakan daya baterai dan level baterai rendah.\n2 - Mulai M121, nilai ini tidak digunakan lagi. Pada M121 dan selanjutnya, nilai akan diperlakukan sebagai EnabledBelowThreshold.\nKebijakan ini mengaktifkan atau menonaktifkan setelan Mode Penghemat Baterai.\nDi Chrome, setelan ini membuat kecepatan frame di-throttle agar mengurangi konsumsi daya. Jika kebijakan ini tidak disetel, pengguna akhir dapat mengontrol setelan ini di chrome://settings/performance.\nDi ChromeOS, setelan ini membuat kecepatan frame dan frekuensi CPU di-throttle, lampu latar diredupkan, dan Android disetel ke Mode Penghemat Baterai. Pada perangkat dengan beberapa CPU, sebagian CPU akan dinonaktifkan.\nLevel yang berbeda adalah:\nDisabled (0): Mode Penghemat Baterai akan dinonaktifkan.\nEnabledBelowThreshold (1): Mode Penghemat Baterai akan diaktifkan saat perangkat menggunakan daya baterai dan level baterai rendah.\nEnabledOnBattery (2): Nilai ini tidak digunakan lagi mulai M121. Mulai M121 dan seterusnya, nilai akan      diperlakukan sebagai EnabledBelowThreshold.\n";
BlockExternalExtensions.pfm_title = "Memblokir ekstensi eksternal sehingga tidak dapat diinstal";
BlockExternalExtensions.pfm_description = "Mengontrol penginstalan ekstensi eksternal.\n\nJika kebijakan ini disetel ke Aktif, ekstensi eksternal tidak akan dapat diinstal.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, ekstensi eksternal akan dapat diinstal.\n\nEkstensi eksternal dan penginstalannya didokumentasikan di https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions.\n\nCatatan: Kebijakan ini hanya berlaku untuk platform yang mendukung ekstensi.";
BlockThirdPartyCookies.pfm_title = "Blokir cookie pihak ketiga";
BlockThirdPartyCookies.pfm_description = "Jika kebijakan disetel ke Aktif, elemen halaman web yang tidak berasal dari domain di kolom URL browser tidak dapat menyetel cookie. Jika kebijakan disetel ke Nonaktif, elemen tersebut akan dapat menyetel cookie dan pengguna tidak dapat mengubah setelan ini.\n\nJika kebijakan tidak disetel, cookie pihak ketiga akan diizinkan, tetapi pengguna dapat mengubah setelan ini.\n\nCatatan: Kebijakan ini tidak berlaku di mode Samaran, tempat cookie pihak ketiga diblokir dan hanya dapat diizinkan di tingkat situs. Untuk mengizinkan cookie di tingkat situs, gunakan kebijakan CookiesAllowedForUrls.";
BookmarkBarEnabled.pfm_title = "Aktifkan Bilah Bookmark";
BookmarkBarEnabled.pfm_description = "Jika kebijakan ditetapkan ke Benar (True), kolom bookmark akan ditampilkan di Brave. Jika kebijakan ditetapkan ke Salah (False), pengguna tidak akan melihat kolom bookmark.\n\nJika Anda menetapkan kebijakan, pengguna tidak dapat mengubahnya. Jika tidak ditetapkan, pengguna akan menentukan untuk menggunakan fungsi ini atau tidak.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "Mengaktifkan penambahan orang di pengelola pengguna";
BrowserAddPersonEnabled.pfm_description = "Jika kebijakan ini disetel ke benar (true) atau tidak dikonfigurasi, Brave dan Lacros akan diizinkan menambahkan pengguna baru dari pengelola pengguna.\n\nJika kebijakan ini disetel ke salah (false), Brave dan Lacros tidak akan diizinkan menambahkan pengguna baru dari pengelola pengguna.";
BrowserGuestModeEnabled.pfm_title = "Mengaktifkan mode tamu dalam browser";
BrowserGuestModeEnabled.pfm_description = "Jika kebijakan ini disetel ke Aktif atau tidak dikonfigurasi, Brave akan mengaktifkan login tamu. Login tamu adalah profil Brave saat semua jendela berada dalam mode Samaran.\n\nJika kebijakan ini disetel ke Nonaktif, Brave tidak akan mengizinkan profil tamu dimulai.";
BrowserGuestModeEnforced.pfm_title = "Terapkan mode tamu browser";
BrowserGuestModeEnforced.pfm_description = "Jika kebijakan disetel ke Aktif, Brave akan menerapkan sesi tamu dan mencegah login profil. Login tamu adalah profil Brave saat semua jendela berada dalam mode Samaran.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, atau Mode tamu browser dinonaktifkan (melalui BrowserGuestModeEnabled), penggunaan profil baru atau yang sudah ada akan diizinkan.";
BrowserLabsEnabled.pfm_title = "Ikon eksperimen browser di toolbar";
BrowserLabsEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna akan dapat mengakses fitur eksperimental browser melalui ikon di toolbar\n\nJika kebijakan disetel ke Nonaktif, ikon fitur eksperimental browser akan dihapus dari toolbar.\n\nchrome://flags dan cara lain untuk menonaktifkan dan mengaktifkan fitur browser akan tetap berperilaku sebagaimana mestinya terlepas dari apakah kebijakan ini disetel ke Aktif atau Nonaktif.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Izinkan kueri ke layanan waktu Google";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, Brave akan sesekali mengirimkan kueri ke server Google untuk mengambil stempel waktu yang akurat.\n\nJika kebijakan disetel ke Nonaktif, Brave akan berhenti mengirimkan kueri tersebut.";
BrowserSignin.pfm_title = "Setelan login browser";
BrowserSignin.pfm_description = "0 - Nonaktifkan login browser\n1 - Aktifkan login browser\n2 - Paksa pengguna login untuk menggunakan browser\nKebijakan ini mengontrol perilaku login browser. Kebijakan ini memungkinkan Anda menentukan apakah pengguna dapat login ke Brave dengan akun mereka dan menggunakan layanan terkait akun seperti Sinkronisasi Brave.\n\nJika kebijakan disetel ke \"Nonaktifkan login browser\", pengguna tidak akan dapat login ke browser dan menggunakan layanan berbasis akun. Dengan demikian, fitur tingkat browser seperti Sinkronisasi Brave tidak dapat digunakan dan tidak akan tersedia. Di iOS, jika pengguna telah login dan kebijakan disetel ke \"Nonaktif\", pengguna akan segera logout. Di platform lain, pengguna akan logout saat mereka menjalankan Brave pada waktu berikutnya. Di semua platform, data profil lokal mereka seperti bookmark, sandi, dll. akan disimpan dan masih dapat digunakan. Pengguna masih dapat login dan menggunakan layanan web Google seperti Gmail.\n\nJika kebijakan disetel ke \"Aktifkan login browser\", pengguna akan diizinkan untuk login ke browser. Di semua platform kecuali iOS, pengguna akan otomatis login ke browser saat login ke layanan web Google seperti Gmail. Login ke browser berarti informasi akun pengguna akan disimpan oleh browser. Namun, ini tidak berarti Sinkronisasi Brave akan diaktifkan secara default; pengguna harus memilih untuk menggunakan fitur ini secara terpisah. Mengaktifkan kebijakan ini akan mencegah pengguna menonaktifkan setelan yang mengizinkan login browser. Untuk mengontrol ketersediaan Sinkronisasi Brave, gunakan kebijakan SyncDisabled.\n\nJika kebijakan disetel ke \"Paksa login browser\", dialog pilihan akun akan ditampilkan dan pengguna harus memilih serta login ke akun untuk menggunakan browser. Tindakan ini memastikan bahwa kebijakan yang dikaitkan dengan akun akan diberlakukan dan diterapkan bagi akun terkelola. Nilai default BrowserGuestModeEnabled akan disetel ke nonaktif. Perlu diketahui bahwa profil yang ada dan belum ditandatangani akan dikunci dan tidak dapat diakses setelah kebijakan ini diaktifkan. Untuk mengetahui informasi selengkapnya, lihat artikel pusat bantuan: https://support.google.com/chrome/?p=force_browser_signin . Opsi ini tidak didukung di Google Chrome OS atau Android, yang akan kembali ke \"Aktifkan login browser\" jika digunakan.\n\nJika kebijakan ini tidak disetel, pengguna dapat menentukan apakah akan mengaktifkan login browser di setelan Brave dan menggunakannya jika dirasa sesuai.";
BrowserSwitcherDelay.pfm_title = "Penundaan sebelum meluncurkan browser alternatif (milidetik)";
BrowserSwitcherDelay.pfm_description = "Jika kebijakan disetel ke angka, Brave akan menampilkan pesan untuk angka milidetik tersebut, kemudian membuka browser alternatif.\n\nJika kebijakan tidak disetel atau disetel ke 0, navigasi ke URL yang ditetapkan akan segera membuka kebijakan tersebut di browser alternatif.";
BrowserSwitcherEnabled.pfm_title = "Mengaktifkan fitur Dukungan Browser Lama.";
BrowserSwitcherEnabled.pfm_description = "Jika kebijakan disetel ke Aktif, Brave akan mencoba meluncurkan beberapa URL dalam browser alternatif, seperti Internet Explorer®. Fitur ini disetel menggunakan kebijakan dalam grup Legacy Browser support.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, Brave tidak akan mencoba meluncurkan URL yang ditetapkan dalam browser alternatif.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "URL file XML yang berisi URL yang tidak akan memicu pengalihan browser.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Jika kebijakan disetel ke URL yang valid, Brave akan mendownload daftar situs dari URL tersebut dan menerapkan aturan seolah-olah aturan tersebut disiapkan dengan kebijakan BrowserSwitcherUrlGreylist. Kebijakan ini akan mencegah Brave dan browser alternatif membuka satu sama lain.\n\nJika kebijakan tidak disetel (atau disetel ke URL yang tidak valid), Brave tidak akan menggunakan kebijakan sebagai sumber aturan untuk tidak beralih browser.\n\nCatatan: Kebijakan ini mengarah ke file XML dalam format yang sama seperti kebijakan SiteList Internet Explorer®. Kebijakan ini akan memuat aturan dari file XML, tanpa membagikan aturan tersebut ke Internet Explorer®. Baca selengkapnya terkait kebijakan SiteList Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL file XML yang berisi URL yang akan dimuat di browser alternatif.";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Jika kebijakan disetel ke URL yang valid, Brave akan mendownload daftar situs dari URL tersebut dan menerapkan aturan seolah-olah aturan tersebut disiapkan dengan kebijakan BrowserSwitcherUrlList.\n\nJika kebijakan tidak disetel (atau disetel ke URL yang tidak valid), Brave tidak akan menggunakannya sebagai sumber aturan untuk beralih browser.\n\nCatatan: Kebijakan ini mengarah ke file XML dalam format yang sama seperti kebijakan SiteList Internet Explorer®. Kebijakan ini akan memuat aturan dari file XML, tanpa membagikan aturan tersebut ke Internet Explorer®. Baca selengkapnya terkait kebijakan SiteList Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Biarkan tab terakhir terbuka di Chrome.";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, Brave akan menyimpan setidaknya satu tab terbuka setelah beralih ke browser alternatif.\n\nJika kebijakan disetel ke Nonaktif, Brave akan menutup tab setelah beralih ke browser alternatif, meskipun tab tersebut adalah tab terakhir. Hal ini menyebabkan Brave keluar sepenuhnya.";
BrowserSwitcherParsingMode.pfm_title = "Mode penguraian sitelist";
BrowserSwitcherParsingMode.pfm_description = "0 - Perilaku default untuk LBS.\n1 - Lebih kompatibel dengan Enterprise Mode Site List Microsoft IE/Edge.\nKebijakan ini mengontrol cara Google Chrome menafsirkan kebijakan sitelist/daftar abu-abu untuk fitur Dukungan Browser Lama. Kebijakan ini akan memengaruhi kebijakan berikut: BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl, dan BrowserSwitcherExternalGreylistUrl.\n\nJika disetel ke 'Default' (0) atau tidak disetel, pencocokan URL kurang ketat. Aturan yang tidak berisi \"/\" akan mencari substring di mana pun di nama host URL. Pencocokan komponen jalur URL peka huruf besar/kecil.\n\nJika disetel ke 'IESiteListMode' (1), pencocokan URL akan lebih ketat. Aturan yang tidak berisi \"/\" hanya akan dicocokkan pada akhir nama host. Aturan juga harus berada di batas nama domain. Pencocokan komponen jalur URL tidak peka huruf besar/kecil. Aturan ini lebih kompatibel dengan Microsoft® Internet Explorer® dan Microsoft® Edge®.\n\nMisalnya, dengan aturan \"example.com\" dan \"acme.com/abc\":\n\n\"http://example.com/\", \"http://subdomain.example.com/\", dan \"http://acme.com/abc\" cocok, apa pun mode penguraiannya.\n\n\"http://notexample.com/\", \"http://example.com.invalid.com/\", \"http://example.comabc/\" hanya cocok dalam mode 'Default'.\n\n\"http://acme.com/ABC\" hanya cocok dalam mode 'IESiteListMode'.";
BrowserSwitcherUrlGreylist.pfm_title = "Situs yang seharusnya tidak pernah memicu pengalihan browser.";
BrowserSwitcherUrlGreylist.pfm_description = "Menyetel kebijakan akan mengontrol daftar situs yang tidak pernah menyebabkan pengalihan browser. Setiap item diperlakukan sebagai aturan. Aturan yang cocok tidak akan membuka browser alternatif. Tidak seperti kebijakan BrowserSwitcherUrlList, aturan berlaku untuk kedua arah. Jika diaktifkan, add-in Internet Explorer® juga akan mengontrol apakah Internet Explorer® harus membuka URL ini di Brave.\n\nJika kebijakan tidak disetel, tidak ada situs yang akan ditambahkan ke daftar.\n\nCatatan: Elemen juga dapat ditambahkan ke daftar ini melalui kebijakan BrowserSwitcherExternalGreylistUrl.";
BrowserSwitcherUrlList.pfm_title = "Situs yang akan dibuka di browser alternatif";
BrowserSwitcherUrlList.pfm_description = "Menyetel kebijakan ini akan mengontrol daftar situs untuk dibuka pada browser alternatif. Tiap item diperlakukan sebagai aturan untuk sesuatu yang akan dibuka di browser alternatif. Brave menggunakan aturan tersebut saat memilih apakah URL harus dibuka di browser alternatif. Jika add-in Internet Explorer® diaktifkan, Internet Explorer® akan beralih kembali ke Brave saat aturan tidak cocok. Jika aturan bentrok satu sama lain, Brave akan menggunakan aturan yang paling spesifik.\n\nJika kebijakan tidak disetel, tidak ada situs yang akan ditambahkan ke daftar.\n\nCatatan: Elemen juga dapat ditambahkan ke daftar ini melalui kebijakan BrowserSwitcherUseIeSitelist dan BrowserSwitcherExternalSitelistUrl.";
BrowserThemeColor.pfm_title = "Mengonfigurasi warna tema browser";
BrowserThemeColor.pfm_description = "Kebijakan ini memungkinkan admin mengonfigurasi warna tema Brave. String input harus berupa string warna hex valid yang sesuai dengan format \"#RRGGBB\".\n\nJika kebijakan disetel ke warna hex yang valid, tema yang didasarkan pada warna tersebut akan otomatis dibuat dan diterapkan ke browser. Pengguna tidak akan dapat mengubah tema yang disetel oleh kebijakan ini.\n\nJika kebijakan tidak disetel, pengguna akan dapat mengubah tema browser sesuai keinginan.";
BrowsingDataLifetime.pfm_title = "Setelan Masa Penyimpanan Data Penjelajahan";
BrowsingDataLifetime.pfm_description = "Mengonfigurasi setelan masa berlaku data penjelajahan untuk Brave. Kebijakan ini mengizinkan admin mengonfigurasi (per jenis data) kapan data akan dihapus oleh browser. Hal ini berguna bagi pelanggan yang bekerja dengan data pelanggan yang sensitif.\n\nPeringatan: Menyetel kebijakan ini dapat memengaruhi dan menghapus data pribadi lokal secara permanen. Sebaiknya uji setelan Anda sebelum men-deploy untuk mencegah penghapusan data pribadi secara tidak sengaja.\n\nJenis data yang tersedia adalah 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings', dan 'hosted_app_data'. 'download_history' dan 'hosted_app_data' tidak didukung di Android.\n\nBrowser akan otomatis menghapus jenis data yang dipilih yang lebih lama dari 'time_to_live_in_hours'. Nilai minimum yang dapat disetel adalah 1 jam.\n\nPenghapusan data yang habis masa berlakunya akan dilakukan 15 detik setelah browser dimulai, lalu setiap 30 menit saat browser sedang berjalan.\n\nPengguna akan tetap login ke Akun Google mereka saat menghapus cookie.\n\nHingga Chrome 114, kebijakan ini mewajibkan kebijakan SyncDisabled disetel ke benar (true). Mulai Chrome 115, menyetel kebijakan ini akan menonaktifkan sinkronisasi untuk setiap jenis data jika `Chrome Sync` tidak dinonaktifkan dengan menyetel kebijakan SyncDisabled atau BrowserSignin dinonaktifkan.\nBuka https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime untuk informasi lebih lanjut terkait skema dan pemformatan.";
BuiltInAIAPIsEnabled.pfm_title = "Mengizinkan halaman menggunakan API AI bawaan.";
BuiltInAIAPIsEnabled.pfm_description = "Kebijakan ini mengontrol apakah halaman dapat menggunakan API AI bawaan (seperti LanguageModel API, Summarization API, Writer API, dan Rewriter API).\n\nJika kebijakan ini disetel ke aktif atau tidak disetel, API akan aktif dan dapat digunakan.\n\nJika kebijakan ini disetel ke nonaktif, upaya penggunaan API akan menampilkan error.";
BuiltInDnsClientEnabled.pfm_title = "Gunakan klien DNS di dalamnya";
BuiltInDnsClientEnabled.pfm_description = "Kebijakan ini mengontrol stack software yang digunakan untuk berkomunikasi dengan server DNS: klien DNS Sistem Operasi, atau klien DNS bawaan dari Brave. Kebijakan ini tidak memengaruhi server DNS mana yang digunakan: misalnya, jika sistem operasi dikonfigurasi untuk menggunakan server DNS perusahaan, server yang sama tersebut akan digunakan oleh klien DNS bawaan. Kebijakan ini juga tidak akan mengontrol jika DNS-over-HTTPS digunakan; Brave akan selalu menggunakan resolver bawaan untuk permintaan DNS-over-HTTPS. Harap lihat kebijakan DnsOverHttpsMode untuk mengetahui informasi tentang mengontrol DNS-over-HTTPS.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, klien DNS bawaan akan digunakan.\n\nJika kebijakan ini disetel ke Nonaktif, klien DNS bawaan hanya akan digunakan jika DNS-over-HTTPS sedang digunakan.";
CACertificateManagementAllowed.pfm_title = "Izinkan pengguna mengelola sertifikat CA yang terinstal.";
CACertificateManagementAllowed.pfm_description = "0 - Izinkan pengguna mengelola semua sertifikat\n1 - Izinkan pengguna mengelola sertifikat pengguna\n2 - Jangan izinkan pengguna mengelola sertifikat\nJika kebijakan disetel ke Semua (0) atau tidak disetel, pengguna akan dapat mengedit setelan kepercayaan untuk semua Sertifikat CA, menghapus sertifikat yang diimpor oleh pengguna, dan mengimpor sertifikat menggunakan Pengelola Sertifikat. Jika kebijakan disetel ke Khusus Pengguna (1), pengguna hanya dapat mengelola sertifikat yang diimpor pengguna, dan tidak dapat mengubah setelan kepercayaan dari sertifikat bawaan. Jika kebijakan disetel ke Tidak Ada (2), pengguna akan dapat melihat (tidak mengelola) Sertifikat CA.";
CACertificates.pfm_title = "Sertifikat TLS yang harus dipercaya oleh Brave untuk autentikasi server";
CACertificates.pfm_description = "Daftar sertifikat TLS yang harus dipercaya oleh Brave untuk autentikasi server.\nSertifikat harus dienkode dengan base64.";
CACertificatesWithConstraints.pfm_title = "Sertifikat TLS yang seharusnya dipercaya oleh Brave untuk autentikasi server dengan batasan";
CACertificatesWithConstraints.pfm_description = "Daftar sertifikat TLS yang seharusnya dipercaya oleh Brave untuk autentikasi server, dengan batasan yang ditambahkan di luar sertifikat. Jika tidak ada batasan jenis tertentu, semua nama jenis tersebut akan diizinkan.\nSertifikat harus dienkode dengan base64. Minimal satu batasan harus ditentukan untuk setiap sertifikat.\nBuka https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints untuk informasi lebih lanjut terkait skema dan pemformatan.";
CADistrustedCertificates.pfm_title = "Sertifikat TLS yang seharusnya tidak dipercaya oleh Brave untuk autentikasi server";
CADistrustedCertificates.pfm_description = "Daftar kunci publik sertifikat yang seharusnya tidak dipercaya oleh Brave untuk autentikasi server\nTLS.\n\nNilai kebijakan ini adalah daftar sertifikat X.509 berenkode base64. Sertifikat\napa pun dengan SPKI yang cocok (SubjectPublicKeyInfo) akan tidak dipercaya.";
CAHintCertificates.pfm_title = "Sertifikat TLS yang tidak tepercaya, tetapi dapat digunakan dalam pembuatan jalur untuk autentikasi server";
CAHintCertificates.pfm_description = "Daftar sertifikat yang tidak tepercaya di Brave,\ntetapi dapat digunakan sebagai petunjuk untuk membuat jalur. Sertifikat harus dienkode dengan base64.";
CAPlatformIntegrationEnabled.pfm_title = "Menggunakan sertifikat TLS yang ditambahkan pengguna dari trust store platform untuk autentikasi server";
CAPlatformIntegrationEnabled.pfm_description = "Jika diaktifkan (atau tidak disetel), sertifikat TLS yang ditambahkan pengguna dari trust store platform akan digunakan dalam pembuatan jalur untuk autentikasi server TLS.\n\nJika dinonaktifkan, sertifikat TLS yang ditambahkan pengguna dari trust store platform tidak akan digunakan dalam pembuatan jalur untuk autentikasi server TLS.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "Dukungan header permintaan non-karakter pengganti CORS";
CORSNonWildcardRequestHeadersSupport.pfm_description = "Mengonfigurasi dukungan header permintaan non-karakter pengganti CORS.\n\nBrave versi 97 memperkenalkan dukungan untuk header permintaan non-karakter pengganti CORS. Jika skrip membuat permintaan jaringan lintas asal melalui fetch() dan XMLHttpRequest dengan header Authorization yang ditambah skrip, header tersebut harus diizinkan secara eksplisit oleh header Access-Control-Allow-Headers dalam respons preflight CORS. \"Secara eksplisit\" di sini berarti simbol karakter pengganti \"*\" tidak mencakup header Authorization. Lihat https://chromestatus.com/feature/5742041264816128 untuk mengetahui detail selengkapnya.\n\nJika kebijakan ini tidak disetel atau disetel ke Benar (True), Brave akan mendukung header permintaan non-karakter pengganti CORS dan berperilaku seperti yang dijelaskan di atas.\n\nJika kebijakan ini disetel ke Salah (False), Chrome akan mengizinkan simbol karakter pengganti (\"*\") di header Access-Control-Allow-Headers dalam respons preflight CORS untuk mencakup header Authorization.\n\nKebijakan Perusahaan ini bersifat sementara dan akan dihapus pada masa mendatang.";
CacheEncryptionEnabled.pfm_title = "Kebijakan ini memungkinkan administrator mengenkripsi cache http di disk.";
CacheEncryptionEnabled.pfm_description = "Kebijakan ini memungkinkan administrator mengenkripsi cache http browser di disk.\n\nJika kebijakan ini disetel ke Aktif, cache browser akan dienkripsi.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, cache browser tidak akan dienkripsi.\n\nEnkripsi cache browser dapat menyebabkan dampak performa.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "Nonaktifkan penerapan Transparansi Sertifikat untuk daftar hash subjectPublicKeyInfo";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "Jika kebijakan ditetapkan, penerapan persyaratan pengungkapan Transparansi Sertifikat akan dinonaktifkan untuk daftar hash subjectPublicKeyInfo. Host perusahaan tetap dapat menggunakan sertifikat yang tidak tepercaya (karena tidak diungkapkan secara publik dengan sesuai). Untuk menonaktifkan penerapan, hash harus memenuhi salah satu ketentuan berikut:\n\n* Berasal dari subjectPublicKeyInfo sertifikat server.\n\n* Berasal dari subjectPublicKeyInfo yang muncul di sertifikat Certificate Authority (CA) di rantai sertifikat. Sertifikat CA tersebut dibatasi melalui ekstensi nameConstraints X.509v3, satu atau beberapa nameConstraints directoryName terdapat di permittedSubtrees, dan directoryName tersebut memiliki atribut organizationName.\n\n* Berasal dari subjectPublicKeyInfo yang muncul di sertifikat CA dalam rantai sertifikat, sertifikat CA memiliki satu atau beberapa atribut organizationName dalam Subjek sertifikat, dan sertifikat server memiliki jumlah atribut organizationName yang sama, dalam urutan yang sama, dan dengan nilai identik byte per byte.\n\nTentukan hash subjectPublicKeyInfo dengan menggabungkan nama algoritme hash, garis miring, dan encoding Base64 dari algoritme hash yang diterapkan ke subjectPublicKeyInfo yang dienkode DER dari sertifikat yang ditentukan. Format encoding Base64 cocok dengan Sidik Jari SPKI. Satu-satunya algoritme hash yang dikenali adalah sha256; selain itu diabaikan.\n\nJika kebijakan tidak ditetapkan, itu berarti saat sertifikat yang memerlukan pengungkapan melalui Transparansi Sertifikat tidak diungkapkan, Brave tidak akan memercayai sertifikat tersebut.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "Nonaktifkan penerapan Transparansi Sertifikat untuk daftar URL";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "Menyetel kebijakan akan menonaktifkan persyaratan pengungkapan Transparansi Sertifikat untuk nama host di URL yang ditentukan. Meskipun mempersulit deteksi salah terbit sertifikat, host tetap dapat menggunakan sertifikat yang tidak tepercaya (karena tidak diungkapkan secara publik dengan sesuai).\n\nJika kebijakan ini tidak disetel, berarti saat sertifikat yang memerlukan pengungkapan melalui Transparansi Sertifikat tidak diungkapkan, Brave tidak akan memercayai sertifikat tersebut.\n\nPola URL mengikuti format ini ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ). Namun, karena validitas sertifikat untuk nama host tertentu tidak bergantung pada skema, port, atau jalur, Brave hanya mempertimbangkan bagian nama host URL. Host karakter pengganti tidak didukung.";
ChromeForTestingAllowed.pfm_title = "Mengizinkan Chrome for Testing";
ChromeForTestingAllowed.pfm_description = "Mengontrol apakah pengguna dapat menggunakan Chrome for Testing.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, pengguna dapat menginstal dan menjalankan Chrome for Testing.\n\nJika kebijakan ini disetel ke Nonaktif, pengguna tidak akan diizinkan menjalankan Chrome for Testing. Pengguna tetap dapat menginstal Chrome for Testing, tetapi tidak akan dijalankan dengan profil yang menyetel kebijakan ini ke Nonaktif.";
ChromeSuggestionsSettings.pfm_title = "Setelan untuk ChromeSuggestions";
ChromeSuggestionsSettings.pfm_description = "Setelan ini memungkinkan Chrome menyarankan kemampuan AI pada saat yang relevan.\n\nNilai 0/tidak disetel = Saran Chrome akan diaktifkan untuk pengguna.\n\nNilai 1 = Saran Chrome dinonaktifkan untuk pengguna.\n\nUntuk mengetahui informasi selengkapnya, baca artikel pusat bantuan: https://support.google.com/chrome/a?p=chrome_suggestions";
ChromeVariations.pfm_title = "Menentukan ketersediaan variasi";
ChromeVariations.pfm_description = "0 - Aktifkan semua variasi\n1 - Aktifkan variasi terkait perbaikan penting saja\n2 - Nonaktifkan semua variasi\nDengan mengonfigurasi kebijakan ini, Anda dapat menentukan variasi mana yang diizinkan untuk diterapkan ke Brave.\n\nVariasi memberikan cara untuk menawarkan modifikasi pada Brave tanpa mengirimkan versi baru browser, dengan mengaktifkan atau menonaktifkan fitur yang sudah ada secara selektif. Lihat https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework untuk informasi selengkapnya.\n\nJika VariationsEnabled (nilai 0) disetel, atau jika kebijakan ini tidak disetel, semua variasi akan diterapkan ke browser.\n\nJika CriticalFixesOnly (nilai 1) disetel, hanya variasi yang dianggap sebagai perbaikan keamanan atau stabilitas penting yang akan diterapkan ke Brave.\n\nJika VariationsDisabled (nilai 2) disetel, semua variasi tidak akan dapat diterapkan ke browser. Perlu diketahui, mode ini tidak direkomendasikan karena berpotensi menyebabkan developer Brave tidak dapat menyediakan perbaikan keamanan penting secara tepat waktu.";
ClearBrowsingDataOnExitList.pfm_title = "Menghapus Data Penjelajahan saat Keluar";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - Histori penjelajahan\ndownload_history - Histori download\ncookies_and_other_site_data - Cookie dan data situs lainnya\ncached_images_and_files - Gambar dan file dalam cache\npassword_signin - Login sandi\nautofill - Isi otomatis\nsite_settings - Setelan situs\nhosted_app_data - Data aplikasi yang dihosting\nMengonfigurasi daftar jenis data penjelajahan yang harus dihapus saat pengguna menutup semua jendela browser.\n\nPeringatan: Menyetel kebijakan ini dapat memengaruhi dan menghapus data pribadi lokal secara permanen. Sebaiknya uji setelan Anda sebelum men-deploy untuk mencegah penghapusan data pribadi secara tidak sengaja.\n\nJenis data yang tersedia adalah histori penjelajahan (browsing_history), histori download (download_history), cookie (cookies_and_other_site_data), cache (cached_images_and_files), isi otomatis (autofill), sandi (password_signin), setelan situs (site_settings), dan data aplikasi yang dihosting (hosted_app_data). Kebijakan ini tidak akan lebih diprioritaskan daripada AllowDeletingBrowserHistory.\n\nPengguna akan tetap login ke Akun Google mereka saat menghapus cookie.\n\nHingga Chrome 114, kebijakan ini mewajibkan kebijakan SyncDisabled disetel ke benar (true). Mulai Chrome 115, menyetel kebijakan ini akan menonaktifkan sinkronisasi untuk setiap jenis data jika `Chrome Sync` tidak dinonaktifkan dengan menyetel kebijakan SyncDisabled atau BrowserSignin dinonaktifkan.\n\nJika karena alasan tertentu penghapusan data dimulai dan tidak selesai, data penjelajahan akan dihapus saat berikutnya profil dimuat.\n\nJika Brave tidak ditutup dengan benar (misalnya, browser atau OS mengalami error), data penjelajahan tidak akan dihapus karena penutupan browser bukan disebabkan oleh pengguna menutup semua jendela browser.";
ClipboardAllowedForUrls.pfm_title = "Mengizinkan papan klip di situs ini";
ClipboardAllowedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang dapat menggunakan izin situs papan klip. Izin ini tidak termasuk semua operasi papan klip pada origin yang cocok dengan pola. Misalnya, pengguna masih dapat menempelkan dengan pintasan keyboard karena tindakan ini tidak dibatasi oleh izin situs papan klip.\n\n\nJika kebijakan ini tidak disetel, DefaultClipboardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
ClipboardBlockedForUrls.pfm_title = "Memblokir papan klip di situs ini";
ClipboardBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang tidak dapat menggunakan izin situs papan klip. Izin ini tidak termasuk semua operasi papan klip pada origin yang cocok dengan pola. Misalnya, pengguna masih dapat menempelkan dengan pintasan keyboard karena tindakan ini tidak dibatasi oleh izin situs papan klip.\n\nJika kebijakan ini tidak disetel, DefaultClipboardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
CloudManagementEnrollmentMandatory.pfm_title = "Aktifkan pendaftaran pengelolaan cloud wajib";
CloudManagementEnrollmentMandatory.pfm_description = "Jika kebijakan ini disetel ke Aktif, pendaftaran browser Chrome Enterprise Core akan diwajibkan dan proses peluncuran Brave akan diblokir jika gagal.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, pendaftaran browser Chrome Enterprise Core akan menjadi opsional dan proses peluncuran Brave tidak akan diblokir jika gagal.\n\nPendaftaran kebijakan cloud cakupan perangkat di desktop menggunakan kebijakan ini. Lihat https://support.google.com/chrome/a/answer/9301891 untuk mengetahui detail selengkapnya.";
CloudManagementEnrollmentToken.pfm_title = "Token pendaftaran kebijakan cloud";
CloudManagementEnrollmentToken.pfm_description = "Jika kebijakan ini disetel, Brave akan mencoba mendaftarkan diri ke pengelolaan browser Chrome Enterprise Core. Nilai kebijakan ini adalah token pendaftaran yang dapat Anda ambil dari Google Admin console.\n\nLihat https://support.google.com/chrome/a/answer/9301891 untuk mengetahui detail selengkapnya.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "Kebijakan cloud Brave menggantikan kebijakan Platform.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Jika kebijakan ini disetel ke Aktif, kebijakan cloud akan diprioritaskan jika bertentangan dengan kebijakan platform.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, kebijakan platform akan diprioritaskan jika bertentangan dengan kebijakan cloud.\n\nKebijakan wajib ini memengaruhi kebijakan cloud cakupan perangkat.\n\nKebijakan ini berlaku khusus untuk Brave dan tidak memengaruhi Google Update karena keduanya adalah aplikasi independen.\nGoogle Update memiliki kebijakan terpisah dengan nama yang sama.";
CloudUserPolicyMerge.pfm_title = "Memungkinkan penggabungan kebijakan cloud tingkat pengguna ke kebijakan tingkat mesin";
CloudUserPolicyMerge.pfm_description = "Jika kebijakan ini disetel ke Aktif, kebijakan yang terkait dengan akun terkelola akan diizinkan untuk digabungkan ke kebijakan tingkat perangkat.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, kebijakan cloud tingkat pengguna tidak akan digabungkan dengan kebijakan dari sumber lain.\n\nHanya kebijakan yang berasal dari pengguna aman yang dapat diprioritaskan. Pengguna aman berafiliasi dengan organisasi yang mengelola browser mereka menggunakan Chrome Enterprise Core. Semua kebijakan tingkat pengguna lainnya akan memiliki prioritas default.\n\nKebijakan yang perlu digabungkan juga harus disetel di PolicyListMultipleSourceMergeList atau PolicyDictionaryMultipleSourceMergeList. Kebijakan ini akan diabaikan jika tidak satu pun dari dua kebijakan yang disebutkan sebelumnya dikonfigurasi.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Mengizinkan kebijakan cloud pengguna mengabaikan kebijakan Chrome Browser Cloud Management.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Jika kebijakan ini disetel ke Aktif, kebijakan yang berkaitan dengan akun terkelola akan diprioritaskan jika bertentangan dengan kebijakan browser Chrome Enterprise Core.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, kebijakan cloud tingkat pengguna akan memiliki prioritas default.\n\nHanya kebijakan yang berasal dari pengguna aman yang dapat diprioritaskan. Pengguna aman berafiliasi dengan organisasi yang mengelola browser mereka menggunakan Chrome Enterprise Core. Semua kebijakan tingkat pengguna lainnya akan memiliki prioritas default.\n\nKebijakan ini dapat digabungkan dengan CloudPolicyOverridesPlatformPolicy. Jika kedua kebijakan ini disetel ke aktif, kebijakan cloud pengguna juga akan lebih diprioritaskan daripada kebijakan platform yang bertentangan.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Aktifkan peringatan keamanan untuk tanda command line";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, peringatan keamanan akan muncul saat tanda command line yang berpotensi bahaya digunakan untuk meluncurkan Chrome.\n\nJika kebijakan disetel ke Nonaktif, peringatan keamanan akan dicegah muncul saat Chrome diluncurkan dengan tanda command line yang berpotensi berbahaya.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
ComponentUpdatesEnabled.pfm_title = "Aktifkan update komponen di Brave";
ComponentUpdatesEnabled.pfm_description = "Mengaktifkan update komponen untuk semua komponen di Brave jika tidak disetel atau disetel ke aktif.\n\nJika disetel ke nonaktif, update komponen akan dinonaktifkan. Namun, beberapa komponen akan dikecualikan dari kebijakan ini: update komponen apa pun yang tidak berisi kode yang dapat dieksekusi dan yang penting bagi keamanan browser, tidak akan dinonaktifkan.\nContoh komponen tersebut meliputi daftar pencabutan sertifikat dan filter subresource.";
CompressionDictionaryTransportEnabled.pfm_title = "Mengaktifkan dukungan transpor kamus kompresi";
CompressionDictionaryTransportEnabled.pfm_description = "Fitur ini memungkinkan penggunaan encoding konten khusus kamus di header permintaan Accept-Encoding (\"sbr\" dan \"zst-d\") saat kamus tersedia untuk digunakan.\n\nJika kebijakan disetel ke Aktif atau tidak disetel, Brave akan menerima konten web yang menggunakan fitur transpor kamus kompresi.\nJika kebijakan disetel ke Nonaktif, fitur transpor kamus kompresi akan dinonaktifkan.";
CookiesAllowedForUrls.pfm_title = "Izinkan cookie di situs ini";
CookiesAllowedForUrls.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL yang menentukan situs yang diizinkan menyetel cookie.\n\nPola URL dapat berupa satu URL yang menunjukkan bahwa situs tersebut mungkin menggunakan cookie di semua situs tingkat atas.\n\nPola juga dapat berupa dua URL yang dipisahkan oleh koma. URL pertama menentukan situs yang harus diizinkan untuk menggunakan cookie. URL kedua menentukan situs tingkat atas tempat nilai pertama harus diterapkan.\n\nJika Anda menggunakan sepasang URL, nilai pertama dalam pasangan tersebut mendukung *, tetapi nilai kedua tidak mendukungnya. Penggunaan * untuk nilai pertama menunjukkan bahwa semua situs mungkin menggunakan cookie jika URL kedua adalah situs tingkat atas.\n\nJika kebijakan ini tidak disetel, nilai default global akan digunakan untuk semua situs, baik dari kebijakan DefaultCookiesSetting maupun BlockThirdPartyCookies jika disetel, atau konfigurasi pribadi pengguna jika kebijakan tidak disetel.\n\nLihat juga kebijakan CookiesBlockedForUrls dan CookiesSessionOnlyForUrls. Perlu diketahui bahwa tidak boleh ada pola URL yang bertentangan antara tiga kebijakan ini, dan tidak ditentukan kebijakan mana yang akan diprioritaskan.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
CookiesBlockedForUrls.pfm_title = "Blokir cookie di situs ini";
CookiesBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat membuat daftar pola URL yang menentukan situs mana yang tidak dapat menyetel cookie.\n\nJika kebijakan ini tidak disetel, DefaultCookiesSetting akan digunakan untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nJika tidak ada kebijakan tertentu yang diprioritaskan, lihat CookiesAllowedForUrls dan CookiesSessionOnlyForUrls. Pola URL di antara 3 kebijakan ini tidak boleh bertentangan.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
CookiesSessionOnlyForUrls.pfm_title = "Membatasi cookie dari URL yang cocok ke sesi saat ini";
CookiesSessionOnlyForUrls.pfm_description = "Jika kebijakan CookiesSessionOnlyForUrls disetel, Anda akan dapat membuat daftar pola URL yang menentukan situs yang dapat dan tidak dapat menyetel cookie untuk satu sesi, kecuali jika kebijakan RestoreOnStartup disetel untuk memulihkan permanen URL dari sesi sebelumnya.\n\nJika kebijakan ini tidak disetel, DefaultCookiesSetting akan digunakan untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku. Jika URL tidak dicakup oleh pola yang ditentukan, setelan default juga akan digunakan.\n\nJika tidak ada kebijakan tertentu yang diprioritaskan, lihat CookiesBlockedForUrls dan CookiesAllowedForUrls. Pola URL di antara 3 kebijakan ini tidak boleh bertentangan.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
CpuPerformanceTierOverride.pfm_title = "Penggantian untuk tingkat performa CPU";
CpuPerformanceTierOverride.pfm_description = "Jika kebijakan ini disetel, perusahaan dapat mengganti nilai yang ditampilkan oleh\nCPU Performance API (yaitu,\nnavigator.cpuPerformance,\nlihat https://github.com/WICG/cpu-performance untuk mengetahui detailnya).\n\nJika kebijakan ini disetel, nilai\nnavigator.cpuPerformance\nakan diganti ke nilai yang ditentukan. Jika kebijakan ini tidak disetel\nperhitungan tingkat performa default akan digunakan.\n\nNilai yang mungkin untuk kebijakan ini adalah 0 hingga 4.";
CreatePasskeysInICloudKeychain.pfm_title = "Mengontrol apakah pembuatan kunci sandi akan ditetapkan secara default ke Rantai Kunci iCloud.";
CreatePasskeysInICloudKeychain.pfm_description = "Brave dapat mengarahkan\npermintaan pembuatan kunci sandi/WebAuthn langsung ke Rantai Kunci iCloud di macOS 13.5\natau yang lebih baru. Jika sinkronisasi Rantai Kunci iCloud belum diaktifkan, pengguna akan\ndiminta untuk login dengan iCloud atau mungkin diminta untuk mengaktifkan sinkronisasi\nRantai Kunci iCloud.\n\nJika kebijakan ini disetel ke salah (false), Rantai Kunci iCloud tidak akan digunakan secara default\ndan perilaku sebelumnya (pembuatan kredensial di profil Brave) mungkin akan digunakan\nsebagai gantinya. Pengguna akan tetap dapat memilih Rantai Kunci iCloud sebagai opsi, dan\nmungkin masih melihat kredensial Rantai Kunci iCloud saat login.\n\nJika kebijakan ini disetel ke \"true\" (benar), Rantai Kunci iCloud akan menjadi pilihan default\nsetiap kali permintaan WebAuthn kompatibel dengan pilihan tersebut.\n\nJika kebijakan ini tidak disetel, penyimpanan default bergantung pada beberapa faktor seperti\napakah iCloud Drive diaktifkan dan apakah pengguna baru saja menggunakan atau\nmembuat kredensial di\nprofil Brave.";
CreateThemesSettings.pfm_title = "Setelan untuk Buat Tema dengan AI";
CreateThemesSettings.pfm_description = "0 - Izinkan Buat Tema dan tingkatkan kualitas model AI.\n1 - Izinkan Buat Tema tanpa meningkatkan kualitas model AI.\n2 - Jangan izinkan Buat Tema.\nBuat Tema dengan AI memungkinkan pengguna membuat tema/wallpaper kustom dengan memilih berbagai pilihan dari daftar opsi.\n\nNilai 0 = Mengizinkan penggunaan fitur ini, sekaligus mengizinkan Google menggunakan data yang relevan untuk meningkatkan kualitas model AI-nya. Data yang relevan mungkin mencakup perintah, input, output, materi sumber, dan masukan tertulis, bergantung pada fiturnya. Data ini juga mungkin ditinjau secara manual untuk meningkatkan kualitas model AI. Nilai 0 adalah nilai default, kecuali jika dinyatakan lain di bawah.\n\nNilai 1 = Mengizinkan penggunaan fitur ini, tetapi tidak mengizinkan Google meningkatkan kualitas model menggunakan konten pengguna (termasuk perintah, input, output, materi sumber, dan masukan tertulis). Nilai 1 adalah nilai default untuk pengguna Enterprise yang dikelola oleh Google Admin console dan untuk akun Education yang dikelola oleh Google Workspace.\n\nNilai 2 = Tidak mengizinkan penggunaan fitur ini.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
DNSInterceptionChecksEnabled.pfm_title = "Pemeriksaan intersepsi DNS diaktifkan";
DNSInterceptionChecksEnabled.pfm_description = "Kebijakan ini mengonfigurasi tombol lokal yang dapat digunakan untuk menonaktifkan pemeriksaan intersepsi DNS. Pemeriksaan ini berupaya mencari tahu apakah browser berada di balik proxy yang mengalihkan nama host tidak dikenal.\n\nDeteksi ini mungkin tidak diperlukan dalam lingkungan perusahaan yang konfigurasi jaringannya dikenal, karena kebijakan ini menyebabkan adanya sejumlah traffic DNS dan HTTP pada saat proses memulai dan setiap perubahan konfigurasi DNS.\n\nSaat kebijakan ini tidak ditetapkan, atau diaktifkan, pemeriksaan intersepsi DNS akan dilakukan. Pemeriksaan tidak dilakukan ketika kebijakan dinonaktifkan secara eksplisit.";
DataURLWhitespacePreservationEnabled.pfm_title = "Pertahankan Spasi Kosong DataURL untuk semua jenis media";
DataURLWhitespacePreservationEnabled.pfm_description = "Kebijakan ini memberikan penghentian sementara untuk perubahan cara Chrome menangani spasi di URL data.\nSebelumnya, spasi kosong hanya akan dipertahankan jika jenis media tingkat atas adalah text atau berisi string jenis media xml.\nSekarang, spasi kosong akan dipertahankan di semua URL data, terlepas dari jenis medianya.\n\nJika kebijakan ini tidak disetel atau disetel ke Benar (True), perilaku baru akan diaktifkan.\n\nJika kebijakan ini disetel ke Salah (False), perilaku lama akan diaktifkan.";
DataUrlInSvgUseEnabled.pfm_title = "Dukungan URL data untuk SVGUseElement.";
DataUrlInSvgUseEnabled.pfm_description = "Kebijakan ini mengaktifkan dukungan URL Data untuk SVGUseElement, yang akan dinonaktifkan\nsecara default mulai M119.\nJika kebijakan ini disetel ke Aktif, URL Data akan terus berfungsi di SVGUseElement.\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, URL Data tidak akan berfungsi di SVGUseElement.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Aktifkan origin buram untuk URL data di Web Worker";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Mengontrol apakah Web Worker yang dibuat dari URL data akan diberi origin unik yang buram.\n\nWeb Worker dapat dibuat menggunakan URL data yang berisi skrip worker. Sebelumnya, worker ini mewarisi origin halaman yang membuatnya, sehingga mereka dapat mengakses penyimpanan lokal, cookie, dan data lain yang terikat dengan origin yang sama. Untuk meningkatkan keamanan dan menyesuaikan dengan spesifikasi HTML, Chrome mengubah perilaku defaultnya di pencapaian 149 sehingga worker yang dibuat dari URL data kini akan memiliki origin unik yang buram. Tindakan ini memisahkan worker dari data halaman kreator.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, perilaku default baru (yang lebih aman) akan digunakan, dan Web Worker yang dibuat dari URL data akan memiliki origin unik yang buram.\n\nJika kebijakan ini disetel ke Nonaktif, Chrome akan kembali ke perilaku lama, dan Web Worker yang dibuat dari URL data akan mewarisi origin pembuatnya. Hal ini memungkinkan administrator untuk mengatasi masalah kompatibilitas untuk sementara jika aplikasi internal tidak berfungsi karena perubahan keamanan.\n\nKebijakan ini bersifat sementara dan akan dihapus di pencapaian 157.";
DefaultAutomaticDownloadsSetting.pfm_title = "Setelan download otomatis default";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Izinkan situs mendownload beberapa file secara otomatis\n2 - Jangan izinkan situs apa pun mendownload beberapa file secara otomatis\n3 - Tanyakan setiap kali situs ingin mendownload beberapa file secara otomatis\nJika kebijakan ini disetel ke 1, situs akan dapat mendownload beberapa file secara otomatis. Jika kebijakan disetel ke 2, izin ini akan ditolak. Anda dapat menyetel kebijakan untuk menanyakan setiap kali situs ingin mendownload beberapa file secara otomatis.\n\nJika kebijakan tidak disetel, kebijakan AskAutomaticDownloads akan berlaku, tetapi pengguna dapat mengubah setelan ini.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Setel Brave sebagai Browser Default";
DefaultBrowserSettingEnabled.pfm_description = "Jika kebijakan ditetapkan ke Benar (True), Brave akan selalu memeriksa apakah browser merupakan default saat memulai dan, jika mungkin, mendaftarkan sendiri secara otomatis. Jika kebijakan ditetapkan ke Salah (False), Brave akan berhenti memeriksa apakah browser tersebut merupakan default dan menonaktifkan kontrol pengguna untuk opsi ini.\n\nJika kebijakan tidak ditetapkan, Brave akan mengizinkan pengguna mengontrol apakah browser merupakan default dan, jika tidak, apakah notifikasi pengguna seharusnya muncul.\n\nCatatan: Untuk administrator Microsoft®Windows®, mengaktifkan setelan ini hanya akan berfungsi pada mesin yang menjalankan Windows 7. Untuk versi setelahnya, Anda harus men-deploy file \"asosiasi aplikasi default\" yang menjadikan Brave sebagai pengendali untuk protokol https dan http (dan secara opsional, protokol ftp dan format file lainnya). Lihat Bantuan Chrome ( https://support.google.com/chrome?p=make_chrome_default_win ).";
DefaultClipboardSetting.pfm_title = "Setelan papan klip default";
DefaultClipboardSetting.pfm_description = "2 - Jangan izinkan situs apa pun menggunakan izin situs papan klip\n3 - Izinkan situs meminta pengguna untuk memberikan izin situs papan klip\nJika kebijakan disetel ke 2, situs akan diblokir agar tidak menggunakan izin situs papan klip. Jika kebijakan ini disetel ke 3 atau tidak disetel, pengguna dapat mengubah setelan dan menentukan apakah API papan klip tersedia saat situs ingin menggunakannya.\n\nKebijakan ini dapat diganti untuk pola URL tertentu menggunakan kebijakan ClipboardAllowedForUrls dan ClipboardBlockedForUrls.\n\nKebijakan ini hanya memengaruhi operasi papan klip yang dikontrol oleh izin situs papan klip, dan tidak memengaruhi penulisan papan klip yang dibersihkan atau operasi salin dan tempel tepercaya.";
DefaultCookiesSetting.pfm_title = "Setelan cookie default";
DefaultCookiesSetting.pfm_description = "1 - Izinkan semua situs menyetel data lokal\n2 - Jangan izinkan situs mana pun menyetel data lokal\n4 - Menyimpan cookie selama durasi sesi\nMenyetel CookiesSessionOnlyForUrls memungkinkan Anda membuat daftar pola URL yang menentukan situs yang dapat dan tidak dapat menyetel cookie untuk satu sesi, kecuali jika kebijakan RestoreOnStartup disetel untuk memulihkan URL dari sesi sebelumnya secara permanen.\n\nJika kebijakan tidak disetel berarti DefaultCookiesSetting akan digunakan untuk semua situs, jika disetel. Jika tidak, setelan pribadi pengguna akan digunakan. Jika URL tidak dicakup oleh pola yang ditentukan, setelan default juga akan digunakan.\n\nJika tidak ada kebijakan tertentu yang diprioritaskan, lihat CookiesBlockedForUrls dan CookiesAllowedForUrls. Pola URL di antara 3 kebijakan ini tidak boleh bertentangan.";
DefaultDownloadDirectory.pfm_title = "Setel direktori download default";
DefaultDownloadDirectory.pfm_description = "Menyetel kebijakan akan mengubah direktori default tempat Chrome mendownload file, tetapi pengguna dapat mengubah direktori tersebut.\n\nJika kebijakan tidak disetel, Chrome akan menggunakan direktori default khusus platform.\n\nKebijakan ini tidak akan berpengaruh jika kebijakan DownloadDirectory disetel.\n\nCatatan: Lihat daftar variabel yang dapat Anda gunakan ( https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables ).";
DefaultFileSystemReadGuardSetting.pfm_title = "Mengontrol penggunaan File System API untuk membaca";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - Jangan izinkan situs apa pun meminta akses baca ke file dan direktori melalui File System API\n3 - Izinkan situs meminta pengguna memberikan akses baca ke file dan direktori melalui File System API\nJika kebijakan disetel ke 3, situs web akan diizinkan meminta akses baca ke file, dan direktori, di sistem file pada sistem operasi host melalui File System API. Jika kebijakan disetel ke 2, akses akan ditolak.\n\nJika tidak disetel, situs dapat meminta akses tetapi pengguna dapat mengubah setelan ini.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Mengontrol penggunaan File System API untuk menulis";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - Jangan izinkan situs apa pun meminta akses tulis ke file atau direktori\n3 - Izinkan situs meminta pengguna memberikan akses tulis ke file dan direktori\nJika kebijakan disetel ke 3, situs web akan diizinkan meminta akses tulis ke file dan direktori di sistem file sistem operasi host. Jika kebijakan disetel ke 2, akses akan ditolak.\n\nJika tidak disetel, situs dapat meminta akses tetapi pengguna dapat mengubah setelan ini.";
DefaultGeolocationSetting.pfm_title = "Setelan geolokasi default";
DefaultGeolocationSetting.pfm_description = "1 - Izinkan situs melacak lokasi fisik pengguna\n2 - Jangan izinkan situs mana pun melacak lokasi fisik pengguna\n3 - Tanyakan setiap kali situs ingin melacak lokasi fisik pengguna\nJika kebijakan disetel ke 1, situs akan dapat melacak lokasi fisik pengguna secara default. Jika kebijakan disetel ke 2, situs tidak akan dapat melacak lokasi fisik pengguna secara default. Anda dapat menyetel kebijakan untuk menanyakan setiap kali situs ingin melacak lokasi fisik pengguna.\n\nJika kebijakan tidak disetel, kebijakan AskGeolocation akan berlaku, tetapi pengguna dapat mengubah setelan ini.";
DefaultIdleDetectionSetting.pfm_title = "Deteksi tidak ada aktivitas";
DefaultIdleDetectionSetting.pfm_description = "1 - Izinkan situs mendeteksi status tidak ada aktivitas tanpa meminta izin pengguna\n2 - Jangan izinkan situs mana pun mendeteksi status tidak ada aktivitas pengguna\n3 - Tanyakan setiap kali situs ingin mendeteksi status tidak ada aktivitas pengguna\nMemungkinkan Anda menetapkan apakah situs diizinkan menggunakan Idle Detection API.\n\nJika kebijakan ini disetel ke 1 - AllowIdleDetection, situs dapat menggunakan API tanpa meminta izin kepada pengguna.\n\nJika kebijakan ini disetel ke 2 - BlockIdleDetection, situs tidak dapat menggunakan API, terlepas dari izin pengguna.\n\nJika kebijakan ini disetel ke 3 - AskIdleDetection atau tidak disetel, situs tidak dapat menggunakan API tanpa izin pengguna.";
DefaultImagesSetting.pfm_title = "Setelan gambar default";
DefaultImagesSetting.pfm_description = "1 - Izinkan semua situs menampilkan semua gambar\n2 - Jangan izinkan situs apa pun menampilkan gambar\nJika kebijakan disetel ke 1, semua situs akan dapat menampilkan gambar. Jika kebijakan disetel ke 2, situs tidak akan dapat menampilkan gambar.\n\nJika kebijakan tidak disetel, kebijakan akan mengizinkan gambar, tetapi pengguna dapat mengubah setelan ini.";
DefaultInsecureContentSetting.pfm_title = "Mengontrol penggunaan pengecualian konten tidak aman";
DefaultInsecureContentSetting.pfm_description = "2 - Jangan izinkan situs apa pun memuat konten campuran\n3 - Izinkan pengguna menambahkan pengecualian untuk mengizinkan konten campuran\nMengizinkan Anda menetapkan apakah pengguna dapat menambahkan pengecualian untuk mengizinkan konten campuran bagi situs tertentu.\n\nKebijakan ini dapat diganti dengan pola URL tertentu menggunakan kebijakan 'InsecureContentAllowedForUrls' dan 'InsecureContentBlockedForUrls'.\n\nJika kebijakan ini tidak disetel, pengguna akan diizinkan untuk menambahkan pengecualian guna mengizinkan konten campuran yang dapat diblokir dan menonaktifkan upgrade otomatis untuk konten campuran yang dapat diblokir secara opsional.";
DefaultJavaScriptJitSetting.pfm_title = "Mengontrol penggunaan JIT JavaScript";
DefaultJavaScriptJitSetting.pfm_description = "1 - Mengizinkan situs apa pun menjalankan JIT JavaScript\n2 - Jangan izinkan situs apa pun menjalankan JIT JavaScript\nMemungkinkan Anda menyetel apakah Brave akan menjalankan mesin JavaScript v8 dengan compiler JIT (Just In Time) yang diaktifkan atau tidak.\n\nJika JIT JavaScript dinonaktifkan, Brave dapat merender konten web dengan lebih lambat, serta dapat menonaktifkan bagian JavaScript termasuk WebAssembly. Jika JIT JavaScript dinonaktifkan, Brave dapat merender konten web dalam konfigurasi yang lebih aman.\n\nKebijakan ini dapat diganti untuk pola URL tertentu menggunakan kebijakan JavaScriptJitAllowedForSites dan JavaScriptJitBlockedForSites.\n\nJika kebijakan ini tidak disetel, JIT JavaScript akan diaktifkan.";
DefaultJavaScriptOptimizerSetting.pfm_title = "Mengontrol penggunaan pengoptimal JavaScript";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Mengaktifkan pengoptimalan JavaScript lanjutan di semua situs\n2 - Menonaktifkan pengoptimalan JavaScript lanjutan di semua situs\nMemungkinkan Anda menyetel apakah Brave\nakan menjalankan mesin JavaScript v8 yang mengaktifkan pengoptimalan JavaScript yang lebih canggih.\n\nJika pengoptimalan JavaScript dinonaktifkan (dengan menyetel nilai kebijakan ini ke 2),\nBrave mungkin merender konten\nweb dengan lebih lambat.\n\nKebijakan ini dapat diganti untuk pola URL tertentu menggunakan kebijakan JavaScriptOptimizerAllowedForSites dan JavaScriptOptimizerBlockedForSites.\n\nJika kebijakan ini tidak disetel, pengoptimalan JavaScript akan diaktifkan.";
DefaultJavaScriptSetting.pfm_title = "Setelan JavaScript default";
DefaultJavaScriptSetting.pfm_description = "1 - Izinkan semua situs menjalankan JavaScript\n2 - Jangan izinkan situs apa pun menjalankan JavaScript\nJika kebijakan disetel ke 1, situs akan dapat menjalankan JavaScript. Jika kebijakan disetel ke 2, situs tidak akan dapat menjalankan JavaScript.\n\nJika kebijakan tidak disetel, JavaScript akan diizinkan, tetapi pengguna dapat mengubah setelan ini.";
DefaultLocalFontsSetting.pfm_title = "Setelan default izin Font Lokal";
DefaultLocalFontsSetting.pfm_description = "2 - Tolak izin Font Lokal di semua situs secara default\n3 - Tanyakan setiap kali situs ingin mendapatkan izin Font Lokal\nJika kebijakan ini disetel ke BlockLocalFonts (nilai 2), izin font lokal untuk situs akan otomatis ditolak secara default. Hal ini akan membatasi kemampuan situs untuk melihat informasi tentang font lokal.\n\nJika kebijakan ini disetel ke AskLocalFonts (nilai 3), pengguna akan diminta untuk menentukan kapan izin font lokal diminta secara default. Jika pengguna memberikan izin, hal ini akan memperluas kemampuan situs untuk melihat informasi tentang font lokal.\n\nJika kebijakan ini tidak disetel, perilaku default akan berlaku, yaitu meminta pengguna. Namun, pengguna dapat mengubah setelan ini";
DefaultNotificationsSetting.pfm_title = "Setelan pemberitahuan default";
DefaultNotificationsSetting.pfm_description = "1 - Izinkan situs menampilkan pemberitahuan desktop\n2 - Jangan izinkan situs apa pun menampilkan pemberitahuan desktop\n3 - Tanyakan setiap kali situs ingin menampilkan pemberitahuan desktop\nJika kebijakan disetel ke 1, situs akan dapat menampilkan notifikasi desktop. Jika kebijakan disetel ke 2, situs tidak akan dapat menampilkan notifikasi desktop.\n\nJika kebijakan tidak disetel, AskNotifications akan berlaku, tetapi pengguna dapat mengubah setelan ini.";
DefaultPopupsSetting.pfm_title = "Setelan pop-up default";
DefaultPopupsSetting.pfm_description = "1 - Izinkan semua situs menampilkan pop-up\n2 - Jangan izinkan situs mana pun menampilkan pop-up\nJika kebijakan disetel ke 1, situs akan dapat menampilkan pop-up. Jika kebijakan disetel ke 2, situs tidak akan dapat menampilkan pop-up.\n\nJika kebijakan tidak disetel, BlockPopups akan berlaku, tetapi pengguna dapat mengubah setelan ini.";
DefaultPrinterSelection.pfm_title = "Aturan pemilihan printer default";
DefaultPrinterSelection.pfm_description = "Jika kebijakan disetel, aturan pemilihan printer default di Brave akan disetel juga dengan mengabaikan aturan default. Pemilihan printer dilakukan pada saat pengguna mencoba mencetak untuk pertama kalinya, saat Brave mencari printer yang cocok dengan atribut yang ditentukan. Jika kecocokan kurang dari sempurna, Brave dapat disetel untuk memilih printer yang cocok, bergantung pada urutan printer ditemukan.\n\nJika kebijakan tidak disetel atau disetel ke atribut yang tidak memiliki kecocokan, artinya printer PDF bawaan menjadi default-nya. Jika tidak ada printer PDF, Brave disetel default ke tidak ada.\n\nSaat ini, semua printer diklasifikasikan sebagai \"local\". Printer yang terhubung ke Google Cloud Print dianggap sebagai \"cloud\", tetapi Google Cloud Print tidak lagi didukung.\n\nCatatan: Jika nilai suatu kolom tidak ditetapkan, semua nilai akan cocok untuk kolom tersebut. Misalnya, jika idPattern tidak ditetapkan, Pratinjau Cetak akan menerima semua ID printer. Pola ekspresi reguler harus mengikuti sintaksis RegExp JavaScript, dan pencocokan bersifat peka huruf besar/kecil.\nBuka https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection untuk informasi lebih lanjut terkait skema dan pemformatan.";
DefaultSearchProviderAlternateURLs.pfm_title = "Daftar URL pengganti untuk penyedia penelusuran default";
DefaultSearchProviderAlternateURLs.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderAlternateURLs akan menentukan daftar URL alternatif untuk mengekstrak istilah penelusuran dari mesin telusur. URL harus menyertakan string '{searchTerms}'.\n\nJika DefaultSearchProviderAlternateURLs tidak disetel, tidak ada URL alternatif yang digunakan untuk mengekstrak istilah penelusuran.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Mengizinkan akses menu konteks penyedia penelusuran default";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "Mengaktifkan penggunaan penyedia penelusuran default di menu konteks.\n\nJika kebijakan ini disetel ke nonaktif, item menu konteks penelusuran yang mengandalkan penyedia penelusuran default Anda tidak akan tersedia.\n\nJika kebijakan ini disetel ke aktif atau tidak disetel, item menu konteks untuk penyedia penelusuran default Anda akan tersedia.\n\nNilai kebijakan ini hanya akan berlaku jika kebijakan DefaultSearchProviderEnabled diaktifkan, dan tidak berlaku jika sebaliknya.";
DefaultSearchProviderEnabled.pfm_title = "Aktifkan penyedia penelusuran default";
DefaultSearchProviderEnabled.pfm_description = "Jika kebijakan disetel ke Aktif, penelusuran default akan dilakukan saat pengguna memasukkan teks non-URL ke kolom URL. Untuk menentukan penyedia penelusuran default, setel kebijakan penelusuran default lainnya. Jika kebijakan tersebut dibiarkan kosong, pengguna dapat memilih penyedia default. Jika kebijakan disetel ke Nonaktif, penelusuran tidak akan dilakukan saat pengguna memasukkan teks non-URL di kolom URL. Nilai Nonaktif tidak didukung oleh Google Admin console.\n\nJika Anda menyetel kebijakan, pengguna tidak dapat mengubahnya di Brave. Jika tidak disetel, penyedia penelusuran default akan diaktifkan, dan pengguna dapat menyetel daftar penyedia penelusuran.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
DefaultSearchProviderEncodings.pfm_title = "Penyandiaksaraan penyedia penelusuran default";
DefaultSearchProviderEncodings.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderEncodings akan menentukan encoding karakter yang didukung oleh penyedia penelusuran. Encoding adalah nama halaman kode seperti UTF-8, GB2312, dan ISO-8859-1. Encoding dicoba sesuai urutan yang diberikan.\n\nJika DefaultSearchProviderEncodings tidak disetel, UTF-8 akan digunakan.";
DefaultSearchProviderImageURL.pfm_title = "Parameter menyediakan fitur telusuri pakai gambar untuk penyedia penelusuran default";
DefaultSearchProviderImageURL.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderImageURL akan menentukan URL mesin telusur yang digunakan untuk penelusuran gambar. (Jika DefaultSearchProviderImageURLPostParams disetel, permintaan penelusuran gambar akan menggunakan metode POST.)\n\nJika DefaultSearchProviderImageURL tidak disetel, tidak ada penelusuran gambar yang digunakan.\n\nJika penelusuran gambar menggunakan metode GET, URL harus menentukan parameter\ngambar menggunakan kombinasi valid dari placeholder berikut:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "Parameter untuk URL gambar yang menggunakan POST";
DefaultSearchProviderImageURLPostParams.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderImageURLPostParams akan menentukan parameter selama melakukan penelusuran gambar dengan POST. Kebijakan terdiri dari pasangan nama-nilai yang dipisahkan koma. Jika nilai adalah parameter template seperti {imageThumbnail}, data thumbnail gambar nyata akan menggantikannya.\n\nJika DefaultSearchProviderImageURLPostParams tidak disetel, permintaan penelusuran gambar akan dikirimkan menggunakan metode GET.\n\nURL harus menentukan parameter gambar menggunakan kombinasi valid dari\nplaceholder berikut, bergantung pada apa yang didukung penyedia penelusuran:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Kata kunci penyedia penelusuran default";
DefaultSearchProviderKeyword.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderKeyword akan menentukan kata kunci atau pintasan yang digunakan di kolom URL untuk memicu penelusuran bagi penyedia ini.\n\nJika DefaultSearchProviderKeyword tidak disetel, tidak ada kata kunci untuk mengaktifkan penyedia penelusuran.";
DefaultSearchProviderName.pfm_title = "Nama penyedia penelusuran default";
DefaultSearchProviderName.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderName akan menentukan nama penyedia penelusuran default.\n\nJika DefaultSearchProviderName tidak disetel, hostname yang ditentukan oleh URL penelusuran akan digunakan.";
DefaultSearchProviderNewTabURL.pfm_title = "URL halaman tab baru penyedia penelusuran default";
DefaultSearchProviderNewTabURL.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderNewTabURL akan menentukan URL mesin telusur yang digunakan untuk menyediakan halaman Tab Baru.\n\nJika DefaultSearchProviderNewTabURL tidak disetel, tidak ada tab baru yang disediakan.";
DefaultSearchProviderSearchURL.pfm_title = "URL penelusuran penyedia penelusuran default";
DefaultSearchProviderSearchURL.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderSearchURL akan menentukan URL mesin telusur yang digunakan saat penelusuran default. URL harus menyertakan string '{searchTerms}', yang diganti di kueri dengan istilah penelusuran pengguna.\n\nAnda dapat menentukan URL penelusuran Google sebagai: '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "Parameter untuk URL penelusuran yang menggunakan POST";
DefaultSearchProviderSearchURLPostParams.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderSearchURLPostParams akan menentukan parameter saat menelusuri URL dengan POST. Kebijakan terdiri dari pasangan nama kunci yang dipisahkan koma. Jika nilai adalah parameter template seperti '{searchTerms}', data istilah penelusuran nyata akan menggantikannya.\n\nJika DefaultSearchProviderSearchURLPostParams tidak disetel, permintaan penelusuran akan dikirimkan menggunakan metode GET.";
DefaultSearchProviderSuggestURL.pfm_title = "URL saran penyedia penelusuran default";
DefaultSearchProviderSuggestURL.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderSuggestURL akan menentukan URL mesin telusur untuk menyediakan saran penelusuran. URL harus menyertakan string '{searchTerms}', yang diganti di kueri dengan istilah penelusuran pengguna.\n\nAnda dapat menentukan URL penelusuran Google sebagai: '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "Parameter untuk URL yang disarankan yang menggunakan POST";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "Jika DefaultSearchProviderEnabled aktif, menyetel DefaultSearchProviderSuggestURLPostParams akan menentukan parameter ketika melakukan penelusuran saran dengan POST. Kebijakan terdiri dari pasangan nama kunci yang dipisahkan koma. Jika nilai adalah parameter template seperti '{searchTerms}', data istilah penelusuran nyata akan menggantikannya.\n\nJika DefaultSearchProviderSuggestURLPostParams tidak disetel, permintaan penelusuran saran dikirimkan menggunakan metode GET.";
DefaultSensorsSetting.pfm_title = "Setelan default sensor";
DefaultSensorsSetting.pfm_description = "1 - Izinkan situs mengakses sensor\n2 - Jangan izinkan situs apa pun mengakses sensor\n3 - Tanyakan setiap kali situs ingin mengakses sensor\nJika kebijakan disetel ke 1, situs akan dapat mengakses dan menggunakan sensor seperti sensor gerakan dan cahaya. Jika kebijakan disetel ke 2, akses ke sensor akan ditolak. Jika kebijakan ini disetel ke 3, pengguna akan diminta untuk menentukan kapan situs meminta akses ke sensor jika tombol fitur tiga status diaktifkan. Jika tidak, kebijakan ini akan secara default mengizinkan akses ke sensor.\n\nJika kebijakan tidak disetel, AllowSensors akan berlaku, tetapi pengguna dapat mengubah setelan ini.";
DefaultSerialGuardSetting.pfm_title = "Mengontrol penggunaan Serial API";
DefaultSerialGuardSetting.pfm_description = "2 - Jangan izinkan situs apa pun meminta akses ke port serial lewat Serial API\n3 - Izinkan situs meminta pengguna memberikan akses ke port serial\nJika kebijakan disetel ke 3, situs akan dapat meminta akses ke port serial. Jika kebijakan disetel ke 2, akses ke port serial akan ditolak.\n\nJika tidak disetel, situs akan dapat meminta akses tetapi pengguna dapat mengubah setelan ini.";
DefaultWebBluetoothGuardSetting.pfm_title = "Mengontrol penggunaan API Bluetooth Web";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - Jangan izinkan situs apa pun meminta akses ke perangkat Bluetooth melalui API Bluetooth Web\n3 - Izinkan situs meminta pengguna memberikan akses ke perangkat Bluetooth di sekitar\nJika kebijakan disetel ke 3, situs akan meminta akses ke perangkat Bluetooth di sekitar. Jika kebijakan disetel ke 2, akses ke perangkat Bluetooth di sekitar akan ditolak.\n\nJika kebijakan tidak disetel, situs akan meminta akses, tetapi pengguna dapat mengubah setelan ini.";
DefaultWebHidGuardSetting.pfm_title = "Mengontrol penggunaan WebHID API";
DefaultWebHidGuardSetting.pfm_description = "2 - Jangan izinkan situs apa pun meminta akses ke perangkat HID melalui WebHID API\n3 - Izinkan situs meminta kepada pengguna untuk memberikan akses ke perangkat HID\nJika kebijakan disetel ke 3, situs akan diizinkan meminta akses ke perangkat HID. Jika kebijakan disetel ke 2, situs akan dilarang meminta akses ke perangkat HID.\n\nJika tidak disetel, situs akan dapat meminta akses tetapi pengguna dapat mengubah setelan ini.\n\nKebijakan ini dapat diganti untuk pola url tertentu menggunakan kebijakan WebHidAskForUrls dan WebHidBlockedForUrls.";
DefaultWebUsbGuardSetting.pfm_title = "Penggunaan kontrol WebUSB API";
DefaultWebUsbGuardSetting.pfm_description = "2 - Jangan izinkan situs apa pun meminta akses ke perangkat USB melalui WebUSB API\n3 - Izinkan situs meminta pengguna memberikan akses ke perangkat USB yang terhubung\nJika kebijakan disetel ke 3, situs akan meminta akses ke perangkat USB yang terhubung. Jika kebijakan disetel ke 2, akses ke perangkat USB yang terhubung akan ditolak.\n\nJika tidak disetel, situs akan meminta akses tetapi pengguna dapat mengubah setelan ini.";
DefaultWindowManagementSetting.pfm_title = "Setelan izin Pengelolaan Jendela Default";
DefaultWindowManagementSetting.pfm_description = "2 - Tolak izin Pengelolaan Jendela di semua situs secara default\n3 - Tanyakan setiap kali situs ingin mendapatkan izin Pengelolaan Jendela\nJika kebijakan ini disetel ke BlockWindowManagement (nilai 2), izin pengelolaan jendela untuk situs akan otomatis ditolak secara default. Hal ini akan membatasi kemampuan situs untuk melihat informasi tentang layar perangkat dan menggunakan informasi tersebut untuk membuka dan menempatkan jendela atau meminta mode layar penuh pada layar tertentu.\n\nJika kebijakan disetel ini ke AskWindowManagement (nilai 3), pengguna akan diminta untuk menentukan kapan izin pengelolaan jendela diminta secara default. Jika pengguna memberikan izin, hal ini akan memperluas kemampuan situs untuk melihat informasi tentang layar perangkat dan menggunakan informasi tersebut untuk membuka dan menempatkan jendela atau meminta mode layar penuh di layar tertentu.\n\nJika kebijakan ini tidak disetel, kebijakanAskWindowManagement akan berlaku, tetapi pengguna dapat mengubah setelan ini.\n\nTindakan ini akan menggantikan kebijakan DefaultWindowPlacementSetting yang sudah tidak digunakan lagi.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Aktifkan penghapusan sandi yang tidak dapat didekripsi";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Kebijakan ini mengontrol apakah pengelola sandi bawaan dapat menghapus sandi yang tidak dapat didekripsi dari database-nya. Tindakan ini diperlukan untuk memulihkan fungsi penuh pengelola sandi bawaan, tetapi hal ini dapat menyebabkan kehilangan data permanen. Nilai sandi yang tidak dapat didekripsi tidak akan dapat didekripsi dengan sendirinya. Jika perbaikan dapat dilakukan, biasanya diperlukan tindakan pengguna yang kompleks.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, pengguna dengan sandi yang tidak dapat didekripsi dan disimpan ke pengelola sandi bawaan akan kehilangan sandi tersebut. Sandi yang masih dalam keadaan berfungsi akan tetap tidak tersentuh.\n\nJika kebijakan ini disetel ke Nonaktif, data pengelola sandi pengguna tidak akan disentuh, tetapi akan mengalami kerusakan pada fungsi pengelola sandi.\n\nJika kebijakan ini disetel, pengguna tidak dapat mengubahnya di Brave.";
DesktopSharingHubEnabled.pfm_title = "Mengaktifkan berbagi desktop di omnibox dan menu 3 titik";
DesktopSharingHubEnabled.pfm_description = "Jika kebijakan disetel ke Benar (True) atau tidak disetel, pengguna akan dapat membagikan atau menyimpan halaman web saat ini menggunakan tindakan yang disediakan oleh hub berbagi desktop. Hub berbagi dapat diakses melalui ikon omnibox atau menu 3 titik.\n\nJika kebijakan disetel ke Salah (False), ikon berbagi akan dihapus dari omnibox dan entri berbagi juga akan dihapus dari menu 3 titik.";
DevToolsGenAiSettings.pfm_title = "Setelan untuk Fitur AI Generatif Chrome DevTools";
DevToolsGenAiSettings.pfm_description = "0 - Izinkan Fitur AI Generatif Chrome DevTools dan tingkatkan kualitas model AI.\n1 - Izinkan Fitur AI Generatif Chrome DevTools tanpa meningkatkan kualitas model AI.\n2 - Jangan izinkan Fitur AI Generatif Chrome DevTools.\nFitur di Chrome DevTools ini menggunakan model AI generatif untuk memberikan informasi proses debug tambahan. Untuk menggunakan fitur ini, Brave harus mengumpulkan data seperti pesan error, stack trace, cuplikan kode, dan permintaan jaringan, lalu mengirimkannya ke server milik Google, yang menjalankan model AI generatif. Isi respons atau autentikasi dan header cookie dalam permintaan jaringan tidak disertakan dalam data yang dikirim ke server.\n\nNilai 0 = Mengizinkan penggunaan fitur ini, sekaligus mengizinkan Google menggunakan data yang relevan untuk meningkatkan kualitas model AI-nya. Data yang relevan mungkin mencakup perintah, input, output, materi referensi, dan masukan tertulis, bergantung pada fiturnya. Data ini juga mungkin ditinjau secara manual untuk meningkatkan kualitas model AI. Nilai 0 adalah nilai default, kecuali jika dinyatakan lain di bawah.\n\nNilai 1 = Mengizinkan penggunaan fitur ini, tetapi tidak mengizinkan Google meningkatkan kualitas model menggunakan konten pengguna (termasuk perintah, input, output, materi referensi, dan masukan tertulis). Nilai 1 adalah nilai default untuk pengguna Enterprise yang dikelola oleh Google Admin console dan untuk akun Education yang dikelola oleh Google Workspace.\n\nNilai 2 = Tidak mengizinkan penggunaan fitur ini.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nFitur AI Generatif Chrome DevTools mencakup:\n\n- Console Insights: menjelaskan pesan konsol dan menawarkan saran cara memperbaiki error konsol.\n\n- Bantuan AI: dapatkan bantuan untuk memahami gaya CSS (sejak versi 131), permintaan jaringan, performa, dan file (semuanya sejak versi 132).\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Aktifkan Profil Google Developer Program di Chrome DevTools";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Aktifkan integrasi Google Developer Program di Chrome DevTools.\n1 - Aktifkan integrasi Google Developer Program di Chrome DevTools, tetapi tanpa membagikan penggunaan alat (untuk pemberian badge).\n2 - Jangan aktifkan integrasi Google Developer Program di Chrome DevTools.\nKebijakan ini mengontrol integrasi Google Developer Program dengan Chrome DevTools. Profil Google Developer Program pengguna ditampilkan di Chrome DevTools, dan pengguna menerima badge karena melakukan tindakan tertentu dalam Chrome DevTools.\n\nJika kebijakan ini disetel ke 0 - 'Diaktifkan', atau jika nilai kebijakan tidak disetel, integrasi Google Developer Program dengan Chrome DevTools akan diizinkan, dan penggunaan alat Chrome DevTools akan diizinkan untuk dibagikan agar badge dapat diberikan.\n\nJika kebijakan ini disetel ke 1 - 'Diaktifkan tanpa badge', integrasi Google Developer Program dengan Chrome DevTools akan diizinkan, tetapi penggunaan alat Chrome DevTools tidak akan dapat dibagikan ke Google Developer Program. Tidak ada badge yang akan diberikan.\n\nJika kebijakan ini disetel ke 2 - 'Nonaktif', integrasi Google Developer Program dengan Chrome DevTools tidak akan diizinkan.";
DeveloperToolsAvailability.pfm_title = "Mengontrol tempat Chrome DevTools dapat digunakan";
DeveloperToolsAvailability.pfm_description = "0 - Tidak mengizinkan penggunaan Chrome DevTools pada aplikasi dan ekstensi yang diinstal oleh kebijakan perusahaan atau, sejak versi 114 dan jika ini adalah pengguna terkelola, ekstensi akan disertakan dalam browser. Izinkan penggunaan Chrome DevTools dalam konteks lainnya\n1 - Mengizinkan penggunaan Chrome DevTools\n2 - Jangan izinkan penggunaan Chrome DevTools\nJika kebijakan ini disetel ke 0 (default), Anda akan dapat mengakses Chrome DevTools dan konsol JavaScript. Namun, hal ini tidak berlaku dalam konteks ekstensi yang diinstal oleh kebijakan perusahaan atau, sejak versi 114 dan jika pengguna adalah pengguna terkelola, ekstensi bawaan browser. Jika kebijakan disetel ke 1, Anda akan dapat mengakses Chrome DevTools dan konsol JavaScript di semua konteks, termasuk dalam konteks ekstensi yang diinstal oleh kebijakan perusahaan. Jika kebijakan disetel ke 2, Anda tidak akan dapat mengakses Chrome DevTools, dan Anda tidak dapat memeriksa elemen situs.\n\nSetelan ini juga menonaktifkan pintasan keyboard dan entri menu atau menu konteks untuk membuka Chrome DevTools atau konsol JavaScript.\n\nMulai Brave versi 99, setelan ini juga mengontrol titik entri untuk fitur 'Lihat sumber halaman'. Jika Anda menyetel kebijakan ini ke 'DeveloperToolsDisallowed' (nilai 2), pengguna tidak dapat mengakses tampilan sumber melalui pintasan keyboard atau menu konteks. Untuk memblokir tampilan sumber sepenuhnya, Anda juga harus menambahkan 'view-source:*' ke kebijakan URLBlocklist.\n\nMulai Brave versi 119, setelan ini juga mengontrol apakah mode developer untuk Aplikasi Web Terisolasi (IWA) dapat diaktifkan dan digunakan.\n\nMulai Brave versi 128, setelan ini tidak akan mengontrol mode developer di halaman ekstensi jika kebijakan ExtensionDeveloperModeSettings disetel.\n\nKebijakan ini memengaruhi Chrome DevTools, akses langsung Chrome DevTools Protocol (CDP) (misalnya, saat diluncurkan dengan --remote-debugging-port atau --remote-debugging-pipe), dan akses Chrome DevTools Protocol (CDP) melalui API chrome.debugger. Kebijakan ini dan kebijakan RemoteDebuggingAllowed berlaku: RemoteDebuggingAllowed mengontrol apakah proses debug jarak jauh dapat dimulai, sedangkan kebijakan ini membatasi apakah target tertentu dapat diperiksa meskipun proses debug jarak jauh sedang berjalan.\n\nKebijakan DeveloperToolsAvailabilityAllowlist dan DeveloperToolsAvailabilityBlocklist lebih diprioritaskan daripada kebijakan ini. Ketersediaan Chrome DevTools ditentukan dalam urutan prioritas berikut:\n\n1. Jika URL cocok dengan pola di kebijakan DeveloperToolsAvailabilityAllowlist, Chrome DevTools akan diizinkan.\n2. Jika DeveloperToolsAvailabilityAllowlist disetel dan DeveloperToolsAvailabilityBlocklist tidak disetel, URL apa pun yang tidak ada dalam daftar yang diizinkan akan diblokir.\n3. Jika URL cocok dengan pola di kebijakan DeveloperToolsAvailabilityBlocklist, Chrome DevTools akan diblokir.\n4. Jika tidak ada kebijakan yang disetel, atau jika URL tidak cocok dengan kedua daftar, kebijakan ini (DeveloperToolsAvailability) akan digunakan sebagai mekanisme penggantian.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Daftar pola URL yang diizinkan untuk dibuka dengan Chrome DevTools";
DeveloperToolsAvailabilityAllowlist.pfm_description = "Kebijakan ini dapat digunakan untuk mengizinkan Chrome DevTools di URL tertentu.\n\nKetersediaan Chrome DevTools dievaluasi di tingkat target. Pola URL dicocokkan dengan URL setiap target yang diperiksa (seperti frame utama halaman, subframe yang disematkan, ekstensi, atau aplikasi web). Perilaku yang dihasilkan bergantung pada apakah kebijakan DeveloperToolsAvailabilityBlocklist juga disetel.\n\nJika kebijakan ini disetel dan DeveloperToolsAvailabilityBlocklist tidak disetel, URL target harus cocok dengan pola di daftar yang diizinkan ini agar Chrome DevTools diizinkan untuk target tersebut. Jika URL target tidak cocok dengan daftar yang diizinkan ini, Chrome DevTools akan diblokir untuk target tersebut (misalnya, subframe yang URL-nya tidak ada dalam daftar yang diizinkan tidak dapat diperiksa, tetapi halaman utama tetap dapat diperiksa jika URL-nya ada dalam daftar yang diizinkan). Untuk mengetahui informasi tentang format URL, lihat https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nJika kebijakan ini dan kebijakan DeveloperToolsAvailabilityBlocklist disetel, daftar yang diizinkan ini akan diprioritaskan. Jika URL target cocok dengan pola di daftar yang diizinkan ini, URL akan tetap diizinkan, meskipun juga cocok dengan pola di daftar yang tidak diizinkan. Jika URL target cocok dengan pola di daftar yang tidak diizinkan ini (tetapi tidak cocok dengan pola di daftar yang diizinkan), URL akan diblokir. Jika URL target tidak cocok dengan keduanya, kebijakan DeveloperToolsAvailability akan digunakan sebagai gantinya.\n\nJika kebijakan ini tidak disetel, ketersediaan Chrome DevTools akan ditentukan oleh kebijakan DeveloperToolsAvailabilityBlocklist dan DeveloperToolsAvailability.\n\nKarakter pengganti host menyeluruh (yaitu, \"*\" atau \"[*]\") tidak diperbolehkan; gunakan kebijakan DeveloperToolsAvailability untuk mengaktifkan fitur ini secara global.\n\nKebijakan ini memengaruhi Chrome DevTools, akses langsung Chrome DevTools Protocol (CDP) (misalnya, saat diluncurkan dengan --remote-debugging-port atau --remote-debugging-pipe), dan akses Chrome DevTools Protocol (CDP) melalui API chrome.debugger. Kebijakan ini dan kebijakan RemoteDebuggingAllowed berlaku: RemoteDebuggingAllowed mengontrol apakah proses debug jarak jauh dapat dimulai, sedangkan kebijakan ini membatasi apakah target tertentu dapat diperiksa meskipun proses debug jarak jauh sedang berjalan.\n\nKebijakan ini terbatas untuk 1.000 entri.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Daftar pola URL yang Chrome DevTools-nya diblokir";
DeveloperToolsAvailabilityBlocklist.pfm_description = "Kebijakan ini dapat digunakan untuk memblokir Chrome DevTools di URL tertentu. Untuk mengetahui informasi tentang format URL, lihat https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nKetersediaan Chrome DevTools dievaluasi di tingkat target. Pola URL dicocokkan dengan URL setiap target yang diperiksa (seperti frame utama halaman, subframe yang disematkan, ekstensi, atau aplikasi web). Perilaku yang dihasilkan bergantung pada apakah kebijakan DeveloperToolsAvailabilityAllowlist juga disetel.\n\nJika kebijakan ini disetel dan DeveloperToolsAvailabilityAllowlist tidak disetel, URL target yang cocok dengan pola di daftar yang tidak diizinkan ini akan memblokir Chrome DevTools untuk target tersebut (misalnya, subframe yang URL-nya cocok dengan daftar yang tidak diizinkan ini tidak dapat diperiksa, tetapi halaman utama tetap dapat diperiksa jika URL-nya tidak ada dalam daftar yang tidak diizinkan). Jika URL target tidak cocok dengan pola apa pun, ketersediaan akan ditentukan oleh kebijakan DeveloperToolsAvailability.\n\nJika kebijakan ini dan kebijakan DeveloperToolsAvailabilityAllowlist disetel, daftar yang diizinkan akan diprioritaskan. Jika URL target cocok dengan pola di daftar yang diizinkan, URL akan diizinkan, meskipun juga cocok dengan pola di daftar yang tidak diizinkan ini. Jika URL target cocok dengan pola di daftar yang tidak diizinkan ini (tetapi tidak cocok dengan pola di daftar yang diizinkan), URL akan diblokir. Jika URL target tidak cocok dengan keduanya, kebijakan DeveloperToolsAvailability akan digunakan sebagai gantinya.\n\nJika kebijakan ini tidak disetel, ketersediaan Chrome DevTools akan ditentukan oleh kebijakan DeveloperToolsAvailabilityAllowlist dan DeveloperToolsAvailability.\n\nKebijakan ini memengaruhi Chrome DevTools, akses langsung Chrome DevTools Protocol (CDP) (misalnya, saat diluncurkan dengan --remote-debugging-port atau --remote-debugging-pipe), dan akses Chrome DevTools Protocol (CDP) melalui API chrome.debugger. Kebijakan ini dan kebijakan RemoteDebuggingAllowed berlaku: RemoteDebuggingAllowed mengontrol apakah proses debug jarak jauh dapat dimulai, sedangkan kebijakan ini membatasi apakah target tertentu dapat diperiksa meskipun proses debug jarak jauh sedang berjalan.\n\nKebijakan ini terbatas untuk 1.000 entri.";
Disable3DAPIs.pfm_title = "Nonaktifkan dukungan untuk API grafis 3D";
Disable3DAPIs.pfm_description = "Jika kebijakan ini disetel ke Benar (True) (atau HardwareAccelerationModeEnabled disetel ke Salah (False)), halaman web tidak akan dapat mengakses WebGL API.\n\nJika kebijakan disetel ke Salah (False) atau tidak disetel, halaman web akan menggunakan WebGL API, tetapi setelan browser default mungkin masih memerlukan argumen command line untuk menggunakan API ini.";
DisableAuthNegotiateCnameLookup.pfm_title = "Nonaktifkan pencarian CNAME saat menegosiasikan autentikasi Kerberos";
DisableAuthNegotiateCnameLookup.pfm_description = "Jika kebijakan disetel ke Aktif, pencarian CNAME akan dilewati. Nama server akan digunakan sebagaimana dimasukkan saat menghasilkan SPN Kerberos.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, pencarian CNAME akan menentukan nama kanonis server saat menghasilkan SPN Kerberos.";
DisablePrintPreview.pfm_title = "Nonaktifkan Pratinjau Cetak";
DisablePrintPreview.pfm_description = "Jika kebijakan disetel ke Aktif, Brave akan membuka dialog cetak sistem, bukan pratinjau cetak bawaan saat pengguna meminta hasil cetak.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, perintah cetak akan memicu layar pratinjau cetak.";
DisableSafeBrowsingProceedAnyway.pfm_title = "Menonaktifkan untuk melanjutkan dari halaman peringatan Safe Browsing";
DisableSafeBrowsingProceedAnyway.pfm_description = "Jika kebijakan disetel ke Aktif, pengguna dilarang melewati halaman peringatan layanan Safe Browsing yang menampilkan situs berbahaya. Kebijakan ini hanya mencegah pengguna agar tidak melanjutkan penelusuran pada halaman peringatan Safe Browsing seperti malware dan phishing, bukan untuk masalah terkait sertifikat SSL seperti sertifikat yang masa berlakunya habis atau tidak valid.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, pengguna dapat memilih melanjutkan penelusuran di halaman yang ditandai setelah peringatan muncul.\n\nBaca selengkapnya tentang Safe Browsing ( https://developers.google.com/safe-browsing ).";
DisableScreenshots.pfm_title = "Menonaktifkan pengambilan screenshot";
DisableScreenshots.pfm_description = "Jika kebijakan ini disetel ke Aktif, screenshot yang diambil dengan pintasan keyboard\natau API ekstensi tidak akan diizinkan. Jika kebijakan ini disetel ke Nonaktif atau tidak disetel, screenshot akan diizinkan.\n\nMulai Brave versi 154, mengaktifkan kebijakan ini juga akan mencegah ekstensi melampirkan debugger melalui 'chrome.debugger.attach()'.\n\nPerhatikan bahwa pada Microsoft® Windows®, macOS, dan Linux,\nkebijakan ini tidak mencegah screenshot yang diambil dengan aplikasi sistem operasi atau pihak ketiga.";
DiskCacheDir.pfm_title = "Setel direktori cache disk";
DiskCacheDir.pfm_description = "Jika kebijakan ditetapkan, Brave akan menggunakan direktori yang Anda sediakan untuk menyimpan file cache di disk, baik pengguna menentukan tanda --dir-cache-disk maupun tidak.\n\nJika tidak ditetapkan, Brave akan menggunakan direktori cache default, tetapi pengguna dapat mengubah setelan tersebut dengan tanda command line --dir-cache-disk.\n\nBrave akan mengelola konten direktori utama volume. Agar tidak kehilangan data atau mengalami error lainnya, jangan menetapkan kebijakan ini ke direktori utama atau semua direktori yang digunakan untuk tujuan lainnya. Lihat variabel yang dapat Anda gunakan (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DiskCacheSize.pfm_title = "Setel ukuran cache disk";
DiskCacheSize.pfm_description = "Jika kebijakan disetel ke Tidak Ada (None), Brave akan menggunakan ukuran cache default untuk menyimpan file dalam cache di disk. Pengguna tidak dapat mengubahnya.\n\nJika kebijakan disetel, Brave akan menggunakan ukuran cache yang Anda sediakan, baik pengguna menentukan tanda --disk-cache-size atau tidak. (Nilai yang kurang dari beberapa megabyte akan dibulatkan ke atas).\n\nJika tidak disetel, Brave akan menggunakan ukuran default. Pengguna dapat mengubah setelan tersebut menggunakan tanda --disk-cache-size.\n\nCatatan: Nilai yang ditentukan dalam kebijakan ini digunakan sebagai petunjuk untuk berbagai subsistem cache di browser. Oleh karena itu, total pemakaian disk semua cache yang sebenarnya akan lebih tinggi tetapi dalam orde magnitudo yang sama dengan nilai yang ditentukan.";
DnsOverHttpsMode.pfm_title = "Mengontrol mode DNS-over-HTTPS";
DnsOverHttpsMode.pfm_description = "off - Nonaktifkan DNS-over-HTTPS\nautomatic - Aktifkan DNS-over-HTTPS dengan fallback yang tidak aman\nsecure - Aktifkan DNS-over-HTTPS tanpa fallback yang tidak aman\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "Menentukan template URI pada resolver DNS-over-HTTPS yang diinginkan";
DnsOverHttpsTemplates.pfm_description = "Template URI pada resolver DNS-over-HTTPS yang diinginkan. Untuk menentukan beberapa resolver DNS-over-HTTPS, pisahkan template URI terkait dengan spasi.\n\nJika DnsOverHttpsMode disetel ke \"secure\", kebijakan ini harus disetel dan tidak boleh kosong. Khusus di Google Chrome OS, kebijakan ini atau DnsOverHttpsTemplatesWithIdentifiers harus disetel. Jika tidak, resolusi DNS akan gagal.\n\nJika DnsOverHttpsMode disetel ke \"automatic\" dan kebijakan ini disetel, template URI yang ditentukan akan digunakan. Namun, jika kebijakan ini tidak disetel, pemetaan hardcode akan digunakan sebagai upaya untuk mengupgrade DNS resolver pengguna saat ini ke DoH resolver yang dioperasikan oleh penyedia yang sama.\n\nJika template URI berisi variabel dns, permintaan untuk resolver akan menggunakan GET. Jika tidak, permintaan akan menggunakan POST.\n\nTemplate dengan format yang salah akan diabaikan.";
DomainReliabilityAllowed.pfm_title = "Mengizinkan pelaporan data terkait keandalan domain";
DomainReliabilityAllowed.pfm_description = "Jika kebijakan ini disetel ke salah (false), pelaporan data diagnostik keandalan domain akan dinonaktifkan dan tidak ada data yang akan dikirim ke Google.\nJika kebijakan ini disetel ke benar (true) atau tidak disetel, pelaporan data diagnostik keandalan domain akan mengikuti perilaku MetricsReportingEnabled untuk Brave atau DeviceMetricsReportingEnabled untuk Google Chrome OS.";
DownloadDirectory.pfm_title = "Setel direktori download";
DownloadDirectory.pfm_description = "Menyetel kebijakan akan menyiapkan direktori yang digunakan Chrome untuk mendownload file. Kebijakan akan menggunakan direktori yang disediakan, terlepas apakah pengguna menentukan direktori atau mengaktifkan tanda untuk dimintai lokasi download setiap waktu.\n\nKebijakan ini menggantikan kebijakan DefaultDownloadDirectory.\n\nJika kebijakan tidak disetel, Chrome akan menggunakan direktori download default, dan pengguna dapat mengubahnya.\n\nDi Google Chrome OS, Anda hanya dapat menyetelnya ke direktori Google Drive.\n\nCatatan: Lihat daftar variabel yang dapat Anda gunakan (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DownloadRestrictions.pfm_title = "Batasan download";
DownloadRestrictions.pfm_description = "0 - Tidak ada batasan khusus. Default.\n1 - Blokir download dan jenis file berbahaya.\n2 - Blokir download berbahaya, download tidak biasa atau tidak diinginkan, dan jenis file berbahaya.\n3 - Blokir semua download.\n4 - Blokir download berbahaya. Direkomendasikan.\nJika kebijakan ini disetel, pengguna tidak dapat mengabaikan keputusan keamanan download.\n\nAda banyak jenis peringatan download dalam Chrome, yang secara umum dibagi menjadi kategori berikut (pelajari lebih lanjut keputusan Safe Browsing https://support.google.com/chrome/?p=ib_download_blocked):\n\n* Berbahaya, seperti yang ditandai oleh server Safe Browsing\n* Tidak biasa atau tidak diinginkan, seperti yang ditandai oleh server Safe Browsing\n* Jenis file berbahaya (misalnya, semua download SWF dan sebagian besar download EXE)\n\nJika kebijakan ini disetel, subset yang berbeda dari kategori berikut akan diblokir, bergantung pada nilainya:\n\n0: Tidak ada batasan khusus. Default.\n\n1: Memblokir file berbahaya yang ditandai oleh server Safe Browsing DAN Memblokir semua jenis file berbahaya. Hanya direkomendasikan untuk OU/browser/pengguna yang memiliki toleransi tinggi terhadap Positif Palsu.\n\n2: Memblokir file berbahaya yang ditandai oleh server Safe Browsing DAN Memblokir file yang tidak biasa atau tidak diinginkan yang ditandai oleh server Safe Browsing DAN Memblokir semua jenis file berbahaya. Hanya direkomendasikan untuk OU/browser/pengguna yang memiliki toleransi tinggi terhadap Positif Palsu.\n\n3: Memblokir semua download. Tidak direkomendasikan, kecuali untuk kasus penggunaan khusus.\n\n4: Memblokir file berbahaya yang ditandai oleh server Safe Browsing; tidak memblokir jenis file berbahaya. Direkomendasikan.\n\nCatatan: Batasan ini berlaku untuk download yang dipicu dari konten halaman web, serta dari opsi menu Download link…. Batasan ini tidak berlaku untuk download halaman yang sedang ditampilkan, atau untuk penyimpanan sebagai PDF dari opsi pencetakan. Baca selengkapnya tentang Safe Browsing ( https://developers.google.com/safe-browsing ).";
EditBookmarksEnabled.pfm_title = "Aktifkan atau nonaktifkan pengeditan bookmark";
EditBookmarksEnabled.pfm_description = "Jika kebijakan ini disetel ke Aktif atau tidak disetel, pengguna akan dapat menambahkan, menghapus, mengubah, atau mengupload bookmark.\n\nJika kebijakan ini disetel ke Nonaktif, pengguna tidak akan dapat menambahkan, menghapus, mengubah, atau mengupload bookmark. Pengguna tetap dapat menggunakan bookmark yang ada.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Sertakan port non-standar di SPN Kerberos";
EnableAuthNegotiatePort.pfm_description = "Jika kebijakan disetel ke Aktif dan port non-standar dimasukkan (selain port 80 atau 443), port tersebut akan disertakan dalam SPN Kerberos yang dihasilkan.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, SPN Kerberos yang dihasilkan tidak akan menyertakan port.";
EnableExperimentalPolicies.pfm_title = "Mengaktifkan kebijakan eksperimental";
EnableExperimentalPolicies.pfm_description = "Mengizinkan Brave memuat kebijakan eksperimental.\n\nPERINGATAN: Kebijakan eksperimental tidak didukung dan dapat berubah atau dihapus tanpa pemberitahuan di versi browser mendatang.\n\nKebijakan eksperimental mungkin tidak selesai atau masih memiliki kerusakan yang diketahui atau tidak diketahui. Kebijakan dapat berubah atau bahkan dihapus tanpa notifikasi apa pun. Jika mengaktifkan kebijakan eksperimental, Anda dapat kehilangan data penjelajahan atau membahayakan keamanan atau privasi Anda.\n\nJika kebijakan tidak tercantum dalam daftar dan tidak dirilis secara resmi, nilainya akan diabaikan di saluran Beta dan Stabil.\n\nJika kebijakan tercantum dalam daftar dan tidak dirilis secara resmi, nilainya akan diterapkan.\n\nKebijakan ini tidak memengaruhi kebijakan yang sudah dirilis.";
EnableMediaRouter.pfm_title = "Aktifkan Google Cast";
EnableMediaRouter.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, Google Cast akan diaktifkan dan pengguna dapat meluncurkannya dari menu aplikasi, menu konteks halaman, kontrol media di situs yang kompatibel untuk Cast, dan ikon toolbar Cast (jika ditampilkan).\n\nJika kebijakan disetel ke Nonaktif, Google Cast akan dinonaktifkan.";
EnableOnlineRevocationChecks.pfm_title = "Mengaktifkan pemeriksaan OCSP/CRL online";
EnableOnlineRevocationChecks.pfm_description = "Jika kebijakan disetel ke Benar (True), pemeriksaan OCSP/CRL online akan dilakukan.\n\nJika kebijakan disetel ke Salah (False) atau tidak disetel, Brave tidak akan melakukan pemeriksaan pencabutan online pada Brave 19 dan yang lebih baru.\n\nCatatan: Pemeriksaan OCSP/CRL tidak memberikan manfaat keamanan yang efektif.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "Mengontrol pengguna terkelola mana yang dapat menetapkan kebijakan ProxyOverrideRules dan ProxyProvisioningDomains.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Jika kebijakan ini disetel ke 0 atau tidak disetel, kebijakan ProxyOverrideRules dan ProxyProvisioningDomains hanya akan diterapkan pada cakupan pengguna bagi pengguna terafiliasi di browser terkelola.\nJika kebijakan ini disetel ke 1, kebijakan ProxyOverrideRules dan ProxyProvisioningDomains akan diterapkan pada cakupan pengguna, meskipun pengguna tersebut tidak terafiliasi.";
EnableUnsafeSwiftShader.pfm_title = "Izinkan penggantian WebGL berbasis software menggunakan SwiftShader";
EnableUnsafeSwiftShader.pfm_description = "Kebijakan yang mengontrol apakah SwiftShader akan digunakan sebagai penggantian WebGL saat akselerasi GPU hardware tidak tersedia.\n\nSwiftShader telah digunakan untuk mendukung WebGL di sistem tanpa akselerasi GPU seperti sistem headless atau mesin virtual, tetapi telah dihentikan penggunaannya karena masalah keamanan. Mulai versi M139, pembuatan konteks WebGL akan gagal jika sebelumnya menggunakan SwiftShader. Kebijakan ini memungkinkan browser atau administrator menunda penghentian untuk sementara.\n\nJika kebijakan ini disetel ke Aktif, SwiftShader akan digunakan sebagai pengganti WebGL berbasis software.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, pembuatan konteks WebGL mungkin gagal jika akselerasi GPU hardware tidak tersedia. Halaman web mungkin tidak berfungsi dengan baik jika tidak menangani kegagalan pembuatan konteks WebGL dengan baik.\n\nKebijakan ini adalah kebijakan sementara yang akan dihapus di masa mendatang.";
EncryptedClientHelloEnabled.pfm_title = "Mengaktifkan Encrypted ClientHello TLS";
EncryptedClientHelloEnabled.pfm_description = "Encrypted ClientHello (ECH) adalah ekstensi ke TLS untuk mengenkripsi kolom sensitif ClientHello dan meningkatkan privasi.\n\nJika kebijakan ini tidak dikonfigurasi atau disetel ke aktif, Brave akan mengikuti proses peluncuran default untuk ECH. Jika kebijakan ini disetel ke nonaktif, Brave tidak akan mengaktifkan ECH.\n\nSaat fitur ini diaktifkan, Brave mungkin menggunakan atau tidak menggunakan ECH bergantung pada dukungan server, ketersediaan data DNS HTTPS, atau status peluncuran.\n\nECH adalah protokol yang berkembang, sehingga penerapan Brave dapat berubah sewaktu-waktu. Oleh karena itu, kebijakan ini merupakan tindakan sementara untuk mengontrol penerapan eksperimental awal. Kebijakan ini akan diganti dengan kontrol akhir saat protokol diselesaikan.";
EnterpriseCustomLabel.pfm_title = "Menetapkan label perusahaan kustom untuk profil terkelola";
EnterpriseCustomLabel.pfm_description = "Kebijakan ini mengontrol label khusus yang digunakan untuk mengidentifikasi profil terkelola. Untuk profil terkelola, label ini akan ditampilkan di samping avatar di toolbar. Label khusus tidak akan diterjemahkan.\n\nSaat kebijakan ini diterapkan, string apa pun yang melebihi 16 karakter akan dipotong dengan “...”. Jangan gunakan nama yang terlalu panjang.\n\nKebijakan ini hanya dapat disetel sebagai kebijakan pengguna.\n\nPerhatikan bahwa kebijakan ini tidak akan berpengaruh jika kebijakan EnterpriseProfileBadgeToolbarSettings disetel ke hide_expanded_enterprise_toolbar_badge (nilai 1).";
EnterpriseCustomLabelForBrowser.pfm_title = "Menetapkan label perusahaan kustom untuk browser terkelola";
EnterpriseCustomLabelForBrowser.pfm_description = "Kebijakan ini mengontrol label khusus yang digunakan untuk menunjukkan browser terkelola. Untuk browser terkelola, label ini akan ditampilkan dalam pernyataan penyangkalan pengelolaan di footer pada halaman Tab Baru. Label khusus tidak akan diterjemahkan.\n\nPerhatikan bahwa kebijakan ini hanya diterapkan untuk browser terkelola, sehingga tidak akan memengaruhi pengguna terkelola di browser tidak terkelola.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia pada instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia pada instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Memungkinkan ekstensi terkelola untuk menggunakan Enterprise Hardware Platform API";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Jika kebijakan disetel ke Benar (True), ekstensi yang diinstal oleh kebijakan perusahaan akan menggunakan API Platform Hardware Perusahaan.\n\nJika kebijakan disetel ke Salah (False) atau tidak disetel, ekstensi tidak akan dapat menggunakan API ini.\n\nCatatan: Kebijakan ini juga berlaku untuk ekstensi komponen, seperti ekstensi Layanan Hangout.";
EnterpriseLogoUrl.pfm_title = "URL Logo Perusahaan untuk profil terkelola";
EnterpriseLogoUrl.pfm_description = "URL ke gambar yang akan digunakan sebagai badge perusahaan untuk profil terkelola. URL harus mengarah ke gambar.\n\nKebijakan ini hanya dapat disetel sebagai kebijakan pengguna.\n\nSebaiknya gunakan favicon (contoh: https://www.google.com/favicon.ico) atau ikon yang tidak lebih kecil dari 48x48 piksel.";
EnterpriseLogoUrlForBrowser.pfm_title = "URL Logo Perusahaan untuk browser terkelola";
EnterpriseLogoUrlForBrowser.pfm_description = "URL ke gambar yang akan digunakan sebagai badge perusahaan untuk browser terkelola. URL harus mengarah ke gambar.\n\nSebaiknya gunakan favicon (contoh: https://www.google.com/favicon.ico) atau ikon yang tidak lebih kecil dari 48x48 piksel.\n\nPerhatikan bahwa kebijakan ini hanya diterapkan untuk browser terkelola, sehingga tidak akan memengaruhi pengguna terkelola di browser tidak terkelola.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia pada instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia pada instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Mengontrol visibilitas badge profil perusahaan di toolbar";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Tampilkan badge toolbar perusahaan yang diperluas\n1 - Sembunyikan badge perusahaan yang diperluas di toolbar\nUntuk profil kerja dan sekolah, toolbar akan menampilkan label \"Kerja\" atau \"Sekolah\" secara default di samping avatar toolbar. Label hanya akan ditampilkan jika akun yang digunakan untuk login adalah akun terkelola.\n\nJika kebijakan ini disetel ke hide_expanded_enterprise_toolbar_badge (nilai 1), badge perusahaan untuk profil terkelola tidak akan ditampilkan di toolbar.\n\nJika kebijakan ini tidak disetel atau disetel ke show_expanded_enterprise_toolbar_badge (nilai 0), badge perusahaan akan ditampilkan.\n\nLabel ini dapat disesuaikan melalui kebijakan EnterpriseCustomLabel.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "Menyimpan data penjelajahan saat membuat profil perusahaan secara default";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Jika kebijakan ini disetel ke Aktif, opsi untuk menyimpan data penjelajahan yang ada saat membuat profil perusahaan akan dicentang secara default.\n\nJika kebijakan ini tidak disetel atau disetel ke Nonaktif, opsi untuk menyimpan data penjelajahan yang ada saat membuat profil perusahaan tidak akan dicentang secara default.\n\nApa pun nilai yang dipilih, pengguna akan dapat memutuskan apakah akan menyimpan data penjelajahan yang ada saat membuat profil perusahaan.\n\nKebijakan ini tidak akan berpengaruh jika opsi untuk menyimpan data penjelajahan yang ada tidak tersedia; hal ini terjadi jika pemisahan profil perusahaan diterapkan secara ketat, atau jika data berasal dari profil yang sudah dikelola.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Setelan agregator penelusuran perusahaan";
EnterpriseSearchAggregatorSettings.pfm_description = "Kebijakan ini memungkinkan administrator menyetel agregator penelusuran perusahaan khusus yang akan memberikan rekomendasi dan hasil penelusuran dalam omnibox (kolom URL) dan kotak penelusuran di halaman Tab Baru.\n\nSecara default, saran penelusuran perusahaan akan digabungkan dan ditampilkan bersamaan dengan rekomendasi Brave reguler. Pengguna dapat secara eksplisit membatasi penelusurannya hanya pada agregator penelusuran perusahaan dengan mengetik kata kunci yang ditentukan di kolom shortcut dengan atau tanpa imbuhan @ (mis. @work), lalu tekan Spasi atau Tab di omnibox. Penelusuran perusahaan terbatas (yang dipicu oleh kata kunci) saat ini hanya didukung di omnibox dan tidak didukung di kotak penelusuran pada halaman Tab Baru.\n\nKolom berikut diperlukan: name, shortcut, search_url, suggest_url.\n\nKolom name sesuai dengan nama mesin telusur yang ditampilkan kepada pengguna di kolom URL.\n\nKolom shortcut sesuai dengan kata kunci yang dimasukkan pengguna untuk memicu penelusuran. Pintasan dapat berisi kata dan karakter biasa, tetapi tidak boleh menyertakan spasi atau diawali dengan simbol @. Pintasan harus unik.\n\nKolom search_url menentukan URL yang akan ditelusuri. Masukkan alamat web untuk halaman hasil mesin telusur, lalu gunakan '{searchTerms}' sebagai pengganti kueri.\n\nKolom suggest_url menentukan URL yang menyediakan saran penelusuran. Permintaan POST akan dibuat dan kueri pengguna akan diteruskan dalam parameter POST di bagian kunci 'query'.\n\nKolom icon_url menentukan URL ke gambar yang akan digunakan di saran penelusuran. Ikon default akan digunakan jika kolom ini tidak disetel. Sebaiknya gunakan favicon (contoh https://www.google.com/favicon.ico). Format file gambar yang didukung: JPEG, PNG, dan ICO.\n\nKolom require_shortcut menentukan apakah shortcut kolom URL diperlukan untuk melihat rekomendasi penelusuran. Jika diperlukan, saran tidak akan ditampilkan di kotak penelusuran pada halaman Tab Baru, tetapi akan tetap ditampilkan di omnibox (kolom URL) dalam mode penelusuran terbatas. Jika kolom ini tidak disetel, shortcut kolom URL tidak diperlukan.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia pada instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia pada instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.\nBuka https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings untuk informasi lebih lanjut terkait skema dan pemformatan.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "Menonaktifkan peringatan berbasis ekstensi jenis file download untuk jenis file tertentu di domain";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Anda dapat mengaktifkan kebijakan ini untuk membuat kamus ekstensi jenis file beserta daftar domain yang sesuai yang tidak akan muncul di peringatan download berbasis ekstensi jenis file. Kebijakan ini memungkinkan administrator perusahaan memblokir peringatan download berbasis ekstensi jenis file untuk file yang dikaitkan dengan domain yang tercantum. Misalnya, jika ekstensi \"jnlp\" dikaitkan dengan \"website1.com\", pengguna tidak akan melihat peringatan saat mendownload file \"jnlp\" dari \"website1.com\", tetapi akan melihat peringatan download saat mendownload file \"jnlp\" dari \"website2.com\".\n\nFile dengan ekstensi jenis file yang ditentukan untuk domain yang diidentifikasi oleh kebijakan ini akan tetap mendapatkan peringatan keamanan berbasis ekstensi non-jenis file seperti peringatan download konten campuran dan peringatan Safe Browsing.\n\nJika kebijakan ini dinonaktifkan atau tidak dikonfigurasi, jenis file yang memicu peringatan download berbasis ekstensi akan menampilkan peringatan kepada pengguna.\n\nJika kebijakan ini diaktifkan:\n\n* Pola URL harus diformat sesuai dengan https://chromeenterprise.google/policies/url-patterns/.\n\n* Ekstensi jenis file yang dimasukkan harus dalam huruf kecil ASCII. Pemisah di awal tidak boleh disertakan saat mencantumkan ekstensi jenis file, sehingga Anda harus menggunakan daftar \"jnlp\", bukan \".jnlp\".\n\nContoh:\n\nContoh nilai berikut akan mencegah peringatan download berbasis ekstensi jenis file pada ekstensi \"exe\" dan \"jnlp\" untuk domain *.example.com, dan pada ekstensi \"swf\" untuk semua domain. Pengguna akan melihat peringatan download berbasis ekstensi jenis file di domain lain untuk file exe dan jnlp, tetapi bukan untuk file swf.\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nPerhatikan bahwa meskipun contoh sebelumnya menunjukkan penekanan pada peringatan download berbasis ekstensi jenis file untuk file \"swf\" bagi semua domain, sebaiknya Anda tidak menerapkan penekanan pada peringatan tersebut bagi semua domain untuk ekstensi jenis file berbahaya demi alasan keamanan. Contoh ini diberikan hanya untuk mendemonstrasikan bahwa hal tersebut dapat dilakukan.\n\nJika kebijakan ini diaktifkan bersama DownloadRestrictions, pengecualian untuk peringatan berbasis ekstensi jenis file yang ditentukan oleh kebijakan ini akan diprioritaskan daripada setelan DownloadRestrictions yang akan memblokir jenis file berbahaya. Pengecualian yang ditentukan oleh kebijakan ini hanya berlaku untuk perilaku \"blokir jenis file berbahaya\" yang ditentukan oleh nilai 1 dan 2 dari DownloadRestrictions.\n\nMisalnya, jika kebijakan ini menentukan pengecualian untuk download \"exe\" dari \"website1.com\", dan DownloadRestrictions disetel untuk memblokir download dan jenis file berbahaya (nilai 1), download \"exe\" dari \"website1.com\" akan dikecualikan dari pemblokiran berbasis ekstensi jenis file, tetapi tetap akan diblokir jika berbahaya.\n\nInformasi selengkapnya tentang DownloadRestrictions dapat ditemukan di https://chromeenterprise.google/policies/?policy=DownloadRestrictions.\nBuka https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings untuk informasi lebih lanjut terkait skema dan pemformatan.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Secara eksplisit mengizinkan port jaringan";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - port 554 (blokir dapat dibatalkan hingga 15/10/2021)\n10080 - port 10080 (blokir dapat dibatalkan hingga 01/04/2022)\n6566 - port 6566 (blokir dapat dibatalkan hingga 15/10/2021)\n989 - port 989 (blokir dapat dibatalkan hingga 01/02/2022)\n990 - port 990 (blokir dapat dibatalkan hingga 01/02/2022)\nAda daftar port yang dibatasi yang dibuat di Brave. Koneksi ke port ini akan gagal. Setelan ini mengizinkan pengabaian daftar tersebut. Nilai berupa daftar yang dipisahkan koma dari nol atau lebih banyak port yang akan mengizinkan koneksi keluar.\n\nPort dibatasi guna mencegah Brave digunakan sebagai vektor untuk mengeksploitasi berbagai kerentanan jaringan. Menyetel kebijakan ini dapat membuat jaringan Anda terkena serangan. Kebijakan ini ditujukan sebagai solusi sementara untuk error dengan kode \"ERR_UNSAFE_PORT\" saat memigrasikan layanan yang berjalan di port yang diblokir ke port standar (yaitu, port 80 atau 443).\n\nSitus berbahaya dapat mudah mendeteksi bahwa kebijakan ini disetel, dan untuk port mana, serta menggunakan informasi tersebut untuk menargetkan serangan.\n\nSetiap port di sini diberi label dengan tanggal hingga kapan pemblokiran port dapat dibatalkan. Setelah tanggal tersebut, port akan dibatasi terlepas dari nilai setelan ini.\n\nJika kebijakan ini disetel ke nilai kosong atau tidak disetel, semua port yang dibatasi akan diblokir. Jika ada campuran nilai yang valid dan tidak valid, nilai yang valid akan diterapkan.\n\nKebijakan ini menggantikan opsi command line \"--explicitly-allowed-ports\".";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Daftar yang tidak diizinkan dari penyedia identitas yang tidak dapat menggunakan SSO Perusahaan yang Dapat Diperluas untuk browser";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Semua penyedia identitas\nmicrosoft - Penyedia identitas cloud Microsoft®\nokta - Penyedia identitas cloud Okta®\nping - Penyedia identitas cloud Ping®\nNonaktifkan Single Sign-On menggunakan Extensible Enterprise SSO untuk penyedia identitas yang tercantum.\n\nDengan menambahkan nilai 'all', semua penyedia identitas yang didukung untuk SSO akan dinonaktifkan.\n\nDengan menambahkan nilai 'microsoft', dukungan untuk Single Sign-On bagi penyedia identitas cloud Microsoft® di Chrome akan dinonaktifkan.\n\nJika kebijakan ini tidak disetel, semua penyedia identitas yang didukung oleh Brave akan diaktifkan.\n\nPengguna yang login ke akunnya di aplikasi apa pun yang mendukung Extensible Enterprise SSO, menggunakan penyedia identitas yang diaktifkan di Brave dan dikonfigurasi di perangkat oleh administrator, dapat login ke properti web menggunakan penyedia identitas tersebut secara otomatis. Informasi yang berkaitan dengan informasi autentikasi pengguna akan dikirimkan ke penyedia identitas cloud pengguna untuk setiap peristiwa autentikasi.\n\nCatatan:\n\nBrave tidak mendukung Single Sign-On menggunakan Extensible Enterprise SSO dalam mode Samaran atau Tamu.\n\nBrave hanya mendukung Single Sign-On menggunakan Extensible Enterprise SSO untuk penyedia identitas berikut: Microsoft, Okta, Ping.\n\nFitur ini tersedia mulai macOS 10.15.";
ExtensionAllowedTypes.pfm_title = "Ketik ekstensi/aplikasi yang diizinkan untuk dipasang";
ExtensionAllowedTypes.pfm_description = "extension - Ekstensi\ntheme - Tema\nuser_script - Skrip pengguna\nhosted_app - Aplikasi yang dihosting\nlegacy_packaged_app - Aplikasi terpaket lama\nplatform_app - Aplikasi platform\nMenyetel kebijakan akan mengontrol aplikasi dan ekstensi mana yang dapat diinstal di Brave, host mana yang dapat berinteraksi dengannya, dan membatasi akses runtime.\n\nTidak menyetel kebijakan akan menyebabkan tidak adanya batasan pada jenis ekstensi dan aplikasi yang dapat diterima.\n\nEkstensi dan aplikasi dengan jenis yang tidak tercantum dalam daftar tidak akan diinstal. Setiap nilai harus berupa salah satu dari string ini:\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\nLihat dokumentasi ekstensi Brave untuk mengetahui informasi selengkapnya tentang jenis-jenis tersebut.\n\nVersi lebih lama dari 75 yang menggunakan beberapa ID ekstensi yang dipisahkan koma tidak didukung dan akan dilewati. Kebijakan lainnya akan berlaku.\n\nCatatan: Kebijakan ini juga memengaruhi ekstensi dan aplikasi yang akan diinstal otomatis menggunakan ExtensionInstallForcelist.\n\nCatatan: Kebijakan ini hanya berlaku untuk platform yang mendukung ekstensi.";
ExtensionDeveloperModeSettings.pfm_title = "Mengontrol ketersediaan mode developer di halaman ekstensi";
ExtensionDeveloperModeSettings.pfm_description = "0 - Izinkan penggunaan mode developer di halaman ekstensi\n1 - Jangan izinkan penggunaan mode developer di halaman ekstensi\nMengontrol apakah pengguna dapat mengaktifkan Mode Developer di chrome://extensions.\n\nJika kebijakan ini tidak disetel, pengguna dapat mengaktifkan mode developer di halaman ekstensi kecuali jika kebijakan DeveloperToolsAvailability disetel ke DeveloperToolsDisallowed (2).\nJika kebijakan ini disetel ke Allow (0), pengguna dapat mengaktifkan mode developer di halaman ekstensi.\nJika kebijakan ini disetel ke Disallow (1), pengguna tidak dapat mengaktifkan mode developer di halaman ekstensi.\n\nJika kebijakan ini disetel, DeveloperToolsAvailability tidak dapat lagi mengontrol mode developer ekstensi.\n\nCatatan: Kebijakan ini hanya berlaku untuk platform yang mendukung ekstensi.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Mengonfigurasi daftar origin yang memberikan perpanjangan masa aktif di latar belakang untuk ekstensi yang terhubung.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "Ekstensi yang terhubung ke salah satu origin ini akan tetap berjalan selama port terhubung.\n\nJika tidak disetel, nilai default kebijakan akan digunakan. Berikut adalah origin aplikasi yang menawarkan SDK yang diketahui tidak menawarkan kemungkinan untuk memulai ulang koneksi tertutup ke status sebelumnya:\n- Smart Card Connector\n- Citrix Receiver (stabil, beta, cadangan)\n- VMware Horizon (stabil, beta)\n\nJika ditetapkan, daftar nilai default akan diperluas dengan nilai yang baru dikonfigurasi. Entri default dan entri yang disediakan oleh kebijakan akan memberikan pengecualian ke ekstensi yang terhubung, selama port terhubung.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Aktifkan ekstensi yang diinstal melalui kebijakan yang mengganti setelan penelusuran default atau Halaman Tab Baru";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Mengontrol apakah ekstensi yang diinstal melalui kebijakan (diinstal otomatis atau direkomendasikan) yang mengganti setelan mesin telusur default atau Halaman Tab Baru diizinkan di lingkungan dengan tingkat kepercayaan rendah.\n\nKebijakan ini hanya berlaku untuk lingkungan dengan tingkat kepercayaan rendah (seperti perangkat yang kebijakannya dikonfigurasi secara lokal tanpa pengelolaan domain atau cloud). Lingkungan dengan tingkat kepercayaan tinggi tidak terpengaruh:\n\nDi Microsoft® Windows®, kebijakan ini tidak tersedia pada instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini tidak tersedia pada instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.\n\nEkstensi yang diinstal melalui kebijakan yang mengganti setelan mesin telusur default atau Halaman Tab Baru akan tetap aktif pada instance dengan tingkat kepercayaan tinggi ini.\n\nJika disetel ke Aktif, Brave akan mengizinkan penginstalan ekstensi melalui kebijakan yang mengganti setelan mesin telusur default atau Halaman Tab Baru, serta membiarkannya tetap aktif di lingkungan dengan tingkat kepercayaan rendah.\n\nJika disetel ke Nonaktif atau tidak dikonfigurasi, Brave akan mencegah penginstalan ekstensi yang diinstal melalui kebijakan yang mengganti setelan mesin telusur default atau Halaman Tab Baru di lingkungan dengan tingkat kepercayaan rendah, serta akan menghapusnya jika sudah terinstal.\n\nJika ekstensi yang terpengaruh diperbarui agar tidak lagi mengganti setelan ini, Brave akan otomatis menginstalnya dalam waktu 7 hari.\n\nKebijakan ini bersifat sementara dan akan dihapus dalam rilis mendatang.";
ExtensionInstallAllowlist.pfm_title = "ID Ekstensi yang dikeluarkan dari daftar yang tidak diizinkan";
ExtensionInstallAllowlist.pfm_description = "Menyetel kebijakan akan menentukan ekstensi yang tidak tunduk pada daftar yang tidak diizinkan.\n\nNilai * untuk daftar yang tidak diizinkan berarti semua ekstensi diblokir dan pengguna hanya dapat menginstal ekstensi yang tercantum dalam daftar yang diizinkan.\n\nSecara default, semua ekstensi akan diizinkan. Namun, jika Anda melarang ekstensi berdasarkan kebijakan, gunakan daftar ekstensi yang diizinkan untuk mengubah kebijakan tersebut.\n\nCatatan: Kebijakan ini hanya berlaku untuk platform yang mendukung ekstensi.";
ExtensionInstallBlocklist.pfm_title = "ID ekstensi yang tidak diizinkan dipasang pengguna (atau * untuk semua)";
ExtensionInstallBlocklist.pfm_description = "Memungkinkan Anda menentukan ekstensi mana yang TIDAK dapat diinstal pengguna. Ekstensi yang sudah diinstal akan dinonaktifkan jika diblokir, tanpa memberikan opsi kepada pengguna untuk mengaktifkannya. Setelah ekstensi yang dinonaktifkan dihapus dari daftar yang tidak diizinkan, ekstensi akan kembali diaktifkan secara otomatis.\n\nNilai '*' untuk daftar yang tidak diizinkan berarti semua ekstensi diblokir secara default. Ekstensi yang tercantum secara eksplisit dalam daftar yang diizinkan akan diizinkan jika sudah ditandatangani (dikemas). Semua ekstensi mode developer akan diblokir.\n\nJika kebijakan ini tidak disetel, pengguna dapat menginstal ekstensi apa pun di Brave.\n\nCatatan: Kebijakan ini hanya berlaku untuk platform yang mendukung ekstensi.";
ExtensionInstallForcelist.pfm_title = "ID Ekstensi/Aplikasi dan URL pembaruan akan dipasang di latar belakang";
ExtensionInstallForcelist.pfm_description = "Menyetel kebijakan akan menentukan daftar aplikasi dan ekstensi yang diinstal otomatis, tanpa interaksi pengguna, dan yang tidak dapat di-uninstal atau dinonaktifkan pengguna melalui antarmuka Brave. Izin akan diberikan secara implisit, termasuk untuk API ekstensi enterprise.deviceAttributes dan enterprise.platformKeys. (Dua API ini tidak tersedia untuk aplikasi dan ekstensi yang tidak diinstal otomatis.)\n\nMeskipun Brave mencegah pengguna meng-uninstal ekstensi ini, beberapa sistem operasi membuat Brave tidak dapat melindungi dengan baik ekstensi dari modifikasi eksternal, sehingga pencegahan ini adalah upaya terbaik.\n\nJika kebijakan tidak disetel, tidak ada aplikasi atau ekstensi yang diinstal otomatis, dan pengguna dapat meng-uninstal aplikasi atau ekstensi apa pun di Brave.\n\nKebijakan ini menggantikan kebijakan ExtensionInstallBlocklist. Jika aplikasi atau ekstensi yang sebelumnya diinstal otomatis dihapus dari daftar ini, Brave akan otomatis meng-uninstal-nya.\n\nKode sumber ekstensi apa pun dapat diubah oleh pengguna melalui alat developer, yang berpotensi menyebabkan ekstensi tersebut tidak berfungsi lagi. Jika hal ini menjadi masalah, setel kebijakan DeveloperToolsDisabled.\n\nSetiap item daftar kebijakan merupakan string yang berisi ID ekstensi dan, terkadang, URL update yang dipisahkan titik koma (;). ID ekstensi adalah string 32 huruf yang ditemukan, misalnya, di chrome://extensions saat dalam mode Developer. Jika ditentukan, URL update akan mengarah ke dokumen XML Manifes Update ( https://developer.chrome.com/extensions/autoupdate ). URL update harus menggunakan salah satu skema berikut: http, https, atau file. Secara default, URL update Chrome Web Store akan digunakan. URL update yang disetel dalam kebijakan ini hanya digunakan untuk penginstalan awal; update ekstensi berikutnya akan menggunakan URL update dalam manifes ekstensi. URL update untuk update berikutnya dapat diganti menggunakan kebijakan ExtensionSettings. Lihat http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy.\n\nDi instance Microsoft® Windows®, aplikasi dan ekstensi yang bukan dari Chrome Web Store hanya dapat diinstal otomatis jika instance dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi instance macOS, aplikasi dan ekstensi yang bukan dari Chrome Web Store hanya dapat diinstal otomatis jika instance dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.\n\nCatatan: Kebijakan ini tidak berlaku untuk mode Samaran. Baca informasi terkait ekstensi hosting ( https://developer.chrome.com/extensions/hosting ).\n\nCatatan: Kebijakan ini hanya berlaku untuk platform yang mendukung ekstensi.";
ExtensionInstallSources.pfm_title = "Pola URL untuk memungkinkan pemasangan skrip pengguna, aplikasi, dan ekstensi dari";
ExtensionInstallSources.pfm_description = "Menyetel kebijakan akan menentukan URL mana yang dapat menginstal ekstensi, aplikasi, dan tema. Sebelum Brave 21, pengguna dapat mengklik link ke file *.crx, dan Brave akan menawarkan untuk menginstal file setelah menampilkan beberapa peringatan. Setelah itu, file tersebut harus didownload dan ditarik ke halaman setelan Brave. Setelan ini memungkinkan URL tertentu menggunakan alur penginstalan lama yang lebih mudah.\n\nSetiap item dalam daftar ini merupakan pola kecocokan gaya ekstensi (buka https://developer.chrome.com/extensions/match_patterns). Pengguna dapat dengan mudah menginstal item dari URL apa pun yang cocok dengan item dalam daftar ini. Baik lokasi file *.crx maupun halaman tempat dimulainya download (halaman perujuk) harus diizinkan oleh pola ini.\n\nExtensionInstallBlocklist lebih diprioritaskan daripada kebijakan ini. Artinya, ekstensi dalam daftar yang tidak diizinkan tidak akan diinstal, meskipun berasal dari situs dalam daftar ini.\n\nCatatan: Kebijakan ini hanya berlaku untuk platform yang mendukung ekstensi.";
ExtensionInstallTypeBlocklist.pfm_title = "Daftar yang tidak diizinkan untuk jenis penginstalan ekstensi";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Blokir ekstensi agar tidak dimuat dari command line\nDaftar yang tidak diizinkan mengontrol jenis penginstalan ekstensi yang tidak diizinkan.\n\nMenyetel \"command_line\" akan memblokir ekstensi agar tidak dimuat dari\ncommand line.";
ExtensionReviewPromptsEnabled.pfm_title = "Kontrol dialog ulasan dan link rating ekstensi";
ExtensionReviewPromptsEnabled.pfm_description = "Mengontrol apakah dialog ulasan dan link rating (seperti \"Beri rating\") native untuk ekstensi Chrome yang terinstal tersedia di seluruh antarmuka pengguna Chrome.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, pengguna dapat menemukan titik entri native untuk mengulas dan memberi rating ekstensi yang memenuhi syarat di toolbar, menu konteks, serta halaman pengelolaan ekstensi (chrome://extensions).\n\nJika kebijakan ini disetel ke Nonaktif, semua dialog ulasan dan link rating native akan disembunyikan dan tidak tersedia.";
ExtensionSettings.pfm_title = "Setelan pengelolaan ekstensi";
ExtensionSettings.pfm_description = "Menyetel kebijakan akan mengontrol setelan pengelolaan ekstensi untuk Brave, termasuk setelan apa pun yang dikontrol oleh kebijakan terkait ekstensi yang sudah ada.\n\nKebijakan ini hanya memetakan ID ekstensi atau URL update ke setelan khususnya. Konfigurasi default dapat disetel bagi ID khusus \"*\", yang berlaku untuk semua ekstensi tanpa konfigurasi khusus dalam kebijakan ini.\n\nKebijakan ini dapat mengganti konfigurasi per ekstensi dari kebijakan lama.\n\nPerhatikan bahwa setelan ekstensi per ID dari ExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist, atau ExtensionSettings hanya akan mewarisi 'installation_mode' dan 'update_url' dari setelan default \"*\". Properti ini tidak akan mewarisi properti lainnya. Dengan URL update, konfigurasi akan berlaku untuk ekstensi dengan URL update tepat yang disebutkan dalam manifes ekstensi (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy). Jika tanda 'override_update_url' disetel ke benar (true), ekstensi akan diinstal dan diupdate menggunakan URL \"update\" yang ditentukan dalam kebijakan ExtensionInstallForcelist atau kolom 'update_url' dalam kebijakan ini. Tanda 'override_update_url' akan diabaikan jika 'update_url' adalah URL Chrome Web Store.\n\nMulai Brave versi 154, penerapan 'runtime_blocked_hosts' ke ekstensi dengan izin 'debugger' akan sepenuhnya menonaktifkan 'chrome.debugger.attach()' di semua target.\n\nDi instance Microsoft® Windows®, aplikasi dan ekstensi yang bukan dari Chrome Web Store hanya dapat diinstal otomatis jika instance dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi instance macOS, aplikasi dan ekstensi yang bukan dari Chrome Web Store hanya dapat diinstal otomatis jika instance dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.\n\nCatatan: Kebijakan ini hanya berlaku untuk platform yang mendukung ekstensi.\nBuka https://chromeenterprise.google/policies/?policy=ExtensionSettings untuk informasi lebih lanjut terkait skema dan pemformatan.";
ExtensionUnpublishedAvailability.pfm_title = "Mengontrol ketersediaan ekstensi yang tidak dipublikasikan di Chrome Web Store.";
ExtensionUnpublishedAvailability.pfm_description = "0 - Izinkan ekstensi yang tidak dipublikasikan\n1 - Nonaktifkan ekstensi yang tidak dipublikasikan\nJika kebijakan ini disetel ke aktif, ekstensi yang tidak dipublikasikan di Chrome Web\nStore akan dinonaktifkan di Brave.\nKebijakan ini hanya berlaku untuk ekstensi yang diinstal dan diupdate dari\nChrome Web Store.\n\nEkstensi dari luar Chrome Web Store seperti ekstensi mode\ndeveloper yang diinstal menggunakan mode developer dan ekstensi yang diinstal menggunakan tombol command line akan diabaikan.\nEkstensi yang diinstal otomatis yang dihosting sendiri akan diabaikan. Semua\nekstensi yang ditetapkan ke versi tertentu juga akan diabaikan.\n\nJika kebijakan disetel ke AllowUnpublished (0) atau tidak disetel, ekstensi yang tidak dipublikasikan di Chrome Web Store akan diizinkan.\nJika kebijakan disetel ke DisableUnpublished (1), ekstensi yang tidak dipublikasikan di Chrome Web Store akan dinonaktifkan.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Menampilkan kotak centang \"Always open\" pada dialog protokol eksternal.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Kebijakan ini mengontrol apakah kotak centang \"Selalu buka\" ditampilkan atau tidak pada perintah konfirmasi peluncuran protokol eksternal.\n\n     Jika kebijakan ini ditetapkan ke Benar atau tidak ditetapkan, saat konfirmasi protokol eksternal ditampilkan, pengguna dapat memilih \"Selalu izinkan\" untuk melewati semua perintah konfirmasi pada waktu berikutnya di situs ini.\n\n     Jika kebijakan ini ditetapkan ke Salah, kotak centang \"Selalu izinkan\" tidak akan ditampilkan dan pengguna akan diminta untuk mengonfirmasi setiap kali protokol eksternal dipanggil.";
FeedbackSurveysEnabled.pfm_title = "Menentukan apakah survei Brave dalam produk ditampilkan kepada pengguna.";
FeedbackSurveysEnabled.pfm_description = "Survei dalam produk Brave mengumpulkan masukan pengguna untuk browser. Respons survei tidak dikaitkan dengan akun pengguna.\nJika kebijakan ini disetel ke Aktif atau tidak disetel, survei dalam produk dapat ditampilkan kepada pengguna.\nJika kebijakan ini disetel ke Nonaktif, survei dalam produk tidak akan ditampilkan kepada pengguna.\n\nKebijakan ini tidak akan berpengaruh jika MetricsReportingEnabled disetel ke Nonaktif, yang juga menonaktifkan survei dalam produk.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Mengambil durasi keepalive saat Penutupan";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Mengontrol durasi (dalam detik) yang diizinkan untuk permintaan keepalive saat browser ditutup.\n\nJika ditentukan, penutupan browser dapat diblokir hingga durasi dalam detik yang telah ditentukan,\nuntuk memproses permintaan keepalive (https://fetch.spec.whatwg.org/#request-keepalive-flag).\n\nNilai default (0) berarti fitur ini dinonaktifkan.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Mengizinkan API pemilih file atau direktori dipanggil tanpa gestur pengguna sebelumnya";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "Untuk alasan keamanan, showOpenFilePicker(),\nshowSaveFilePicker(), dan showDirectoryPicker() web API\nmemerlukan gestur pengguna sebelumnya (\"aktivasi sementara\") untuk dipanggil. Jika tidak ada gestur pengguna sebelumnya,\npanggilan API ini akan gagal.\n\nJika kebijakan ini disetel, admin akan dapat menentukan origin tempat API ini dapat\ndipanggil tanpa gestur pengguna sebelumnya.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat\nhttps://chromeenterprise.google/policies/url-patterns/. * bukanlah\nnilai yang diterima untuk kebijakan ini.\n\nJika kebijakan ini tidak disetel, semua origin akan memerlukan gestur pengguna sebelumnya untuk memanggil\nAPI ini.";
FileSystemReadAskForUrls.pfm_title = "Izinkan akses baca melalui File System API di situs ini";
FileSystemReadAskForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang dapat meminta pengguna akses baca ke file atau direktori di sistem file pada sistem operasi host melalui File System API.\n\nJika kebijakan ini tidak disetel, DefaultFileSystemReadGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nPola URL tidak boleh bertentangan dengan FileSystemReadBlockedForUrls. Tidak ada kebijakan yang diprioritaskan jika URL cocok dengan keduanya.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
FileSystemReadBlockedForUrls.pfm_title = "Blokir akses baca melalui File System API di situs ini";
FileSystemReadBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang tidak dapat meminta pengguna akses baca ke file atau direktori di sistem file pada sistem operasi host melalui File System API.\n\nJika kebijakan ini tidak disetel, DefaultFileSystemReadGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nPola URL tidak boleh bertentangan dengan FileSystemReadAskForUrls. Tidak ada kebijakan yang diprioritaskan jika URL cocok dengan keduanya.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
FileSystemWriteAskForUrls.pfm_title = "Izinkan akses tulis ke file dan direktori di situs ini";
FileSystemWriteAskForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang dapat meminta pengguna akses tulis ke file atau direktori di sistem file pada sistem operasi host.\n\nJika kebijakan ini tidak disetel, DefaultFileSystemWriteGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nPola URL tidak boleh bertentangan dengan FileSystemWriteBlockedForUrls. Tidak ada kebijakan yang diprioritaskan jika URL cocok dengan keduanya.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
FileSystemWriteBlockedForUrls.pfm_title = "Blokir akses tulis ke file dan direktori di situs ini";
FileSystemWriteBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang tidak dapat meminta pengguna akses tulis ke file atau direktori di sistem file pada sistem operasi host.\n\nJika kebijakan ini tidak disetel, DefaultFileSystemWriteGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nPola URL tidak boleh bertentangan dengan FileSystemWriteAskForUrls. Tidak ada kebijakan yang diprioritaskan jika URL cocok dengan keduanya.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
ForceEphemeralProfiles.pfm_title = "Profil singkat";
ForceEphemeralProfiles.pfm_description = "Jika disetel ke aktif, kebijakan ini akan memaksa profil dialihkan ke mode singkat. Jika ditetapkan sebagai kebijakan OS (misalnya, GPO di Windows), kebijakan ini akan berlaku untuk setiap profil di sistem; jika disetel sebagai kebijakan Awan, kebijakan ini hanya akan berlaku untuk profil tempat masuk dengan akun terkelola.\n\nDalam mode ini, data profil hanya akan dipertahankan di disk selama durasi sesi pengguna. Beberapa fitur seperti histori browser, ekstensi dan datanya, data web seperti cookie dan basis data web, tidak akan dipertahankan setelah browser ditutup. Namun, hal ini tidak mencegah pengguna mendownload data apa pun ke disk secara manual, menyimpan halaman, atau mencetak halaman\n\nJika pengguna mengaktifkan sinkronkan semua, data ini akan dipertahankan di profil sinkronisasinya layaknya di profil reguler. Mode samaran juga tersedia jika tidak dinonaktifkan secara eksplisit oleh kebijakan.\n\nJika kebijakan ini disetel ke nonaktif atau dibiarkan tidak disetel, proses masuk akan mengarahkan ke profil reguler.";
ForceForegroundPriorityForAllTabs.pfm_title = "Terapkan prioritas latar depan untuk semua tab";
ForceForegroundPriorityForAllTabs.pfm_description = "Kebijakan ini mengontrol apakah konten web latar belakang dipaksa berjalan pada\nprioritas latar depan.\n\nSecara default, browser mengoptimalkan resource dengan menurunkan prioritas konten di\ntab latar belakang. Mengaktifkan kebijakan ini akan mengganti perilaku tersebut, sehingga tab latar belakang dijadwalkan dengan cara yang sama seperti tab aktif.\n\nPerhatikan bahwa memaksa konten latar belakang untuk berjalan pada prioritas latar depan dapat sedikit memengaruhi responsivitas tab aktif.\n\nJika kebijakan ini disetel ke Aktif, semua konten web akan berjalan pada prioritas latar depan\nterlepas dari status visibilitasnya.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, browser akan menentukan prioritas\nberdasarkan heuristik standar (misalnya, menurunkan prioritas konten yang tidak\nterlihat, tidak memutar audio, tidak berpartisipasi dalam panggilan video...).";
ForceForegroundPriorityForUrls.pfm_title = "Menerapkan paksa prioritas latar depan untuk URL tertentu";
ForceForegroundPriorityForUrls.pfm_description = "Kebijakan ini memungkinkan Anda menentukan daftar pola URL. Konten web latar belakang yang cocok dengan pola ini akan dijalankan secara paksa pada prioritas latar depan.\n\nJika kebijakan ForceForegroundPriorityForAllTabs disetel ke aktif, daftar ini akan diabaikan karena semua tab akan dipaksa ke prioritas latar depan.\n\nJika ForceForegroundPriorityForAllTabs disetel ke nonaktif atau tidak disetel, hanya konten yang cocok dengan pola dalam daftar ini yang akan dipaksakan.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nJika daftar ini kosong atau tidak disetel, tidak ada konten latar belakang yang dipaksa ke prioritas latar depan.";
ForceGoogleSafeSearch.pfm_title = "Paksa Google SafeSearch";
ForceGoogleSafeSearch.pfm_description = "Jika kebijakan disetel ke Aktif, SafeSearch di Google Penelusuran akan selalu aktif, dan pengguna tidak dapat mengubah setelan ini.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, SafeSearch di Google Penelusuran tidak akan diterapkan.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "Mengontrol apakah pengendali peristiwa unload dapat dinonaktifkan.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "Pengendali peristiwa unload tidak digunakan lagi. Diaktifkan atau tidaknya pengendali tersebut bergantung pada Permissions-Policy unload. Saat ini, pengendali tersebut diizinkan oleh kebijakan secara default. Pada masa mendatang, pengendali peristiwa akan secara bertahap tidak lagi diizinkan secara default, dan situs harus secara eksplisit mengaktifkannya menggunakan header Permissions-Policy. Kebijakan perusahaan ini dapat digunakan untuk memilih tidak mengikuti penghentian bertahap ini dengan memaksa setelan default tetap aktif.\n\nHalaman mungkin bergantung pada pengendali peristiwa unload untuk menyimpan data atau memberi sinyal akhir sesi pengguna ke server. Tindakan ini tidak direkomendasikan karena tidak dapat diandalkan dan memengaruhi performa dengan memblokir penggunaan BackForwardCache. Alternatif yang direkomendasikan tersedia, tetapi peristiwa unload telah digunakan dalam waktu yang lama. Beberapa aplikasi mungkin masih mengandalkannya.\n\nJika kebijakan ini disetel ke salah (false) atau tidak disetel, pengendali peristiwa unload akan dihentikan secara bertahap sesuai dengan peluncuran penghentian, dan situs yang tidak menyetel header Permissions-Policy akan berhenti mengaktifkan peristiwa `unload`.\n\nJika kebijakan ini disetel ke benar (true), pengendali peristiwa unload akan terus berfungsi secara default.\n\nCATATAN: Kebijakan ini salah didokumentasikan di M117, yaitu dengan setelan defaultnya adalah `true`. Peristiwa penghapusan muatan tidak dan tidak akan berubah di M117, sehingga kebijakan ini tidak akan berpengaruh pada versi tersebut.\n";
ForceYouTubeRestrict.pfm_title = "Paksa Mode Terbatas minimum YouTube";
ForceYouTubeRestrict.pfm_description = "0 - Jangan terapkan Mode Terbatas di YouTube\n1 - Terapkan setidaknya Mode Terbatas Sedang di YouTube\n2 - Terapkan Mode Terbatas Ketat untuk YouTube\nMenyetel kebijakan akan menerapkan mode Terbatas minimum di YouTube dan mencegah pengguna memilih mode yang kurang dibatasi. Jika disetel ke:\n\n* Ketat, mode Terbatas Ketat di YouTube selalu aktif.\n\n* Sedang, pengguna hanya dapat memilih mode Terbatas Sedang atau Ketat di YouTube tetapi tidak dapat menonaktifkan mode Terbatas.\n\n* Nonaktif atau jika tidak ada nilai yang ditetapkan, Chrome tidak akan menerapkan mode Terbatas di YouTube. Kebijakan eksternal seperti kebijakan YouTube tetap dapat memberlakukan mode Terbatas.";
ForcedLanguages.pfm_title = "Mengonfigurasi konten dan urutan bahasa pilihan";
ForcedLanguages.pfm_description = "Kebijakan ini memungkinkan admin mengonfigurasi urutan bahasa pilihan di setelan Brave.\n\nUrutan daftar akan muncul dalam urutan yang sama di bagian \"Urutkan bahasa berdasarkan preferensi Anda\" di chrome://settings/languages. Pengguna tidak akan dapat menghapus atau mengurutkan ulang bahasa yang ditetapkan oleh kebijakan, tetapi akan dapat menambahkan bahasa di bawah daftar yang ditetapkan oleh kebijakan. Pengguna juga akan memiliki kontrol penuh atas setelan bahasa UI dan terjemahan/periksa ejaan browser, kecuali diterapkan oleh kebijakan lainnya.\n\nJika kebijakan tidak disetel, pengguna akan dapat memanipulasi seluruh daftar bahasa pilihan.";
GeminiActOnWebAllowedForURLs.pfm_title = "Mengizinkan integrasi aplikasi Gemini untuk langsung bertindak di situs tertentu";
GeminiActOnWebAllowedForURLs.pfm_description = "Memungkinkan untuk menetapkan daftar pola URL yang menentukan situs tempat integrasi aplikasi Gemini dapat langsung bertindak di halaman web.\n\nURL yang tidak cocok dengan daftar yang diizinkan atau daftar yang tidak diizinkan menggunakan GeminiActOnWebSettings.\n\nURL yang cocok dengan daftar yang diizinkan dan daftar yang tidak diizinkan akan diizinkan.\n\nUntuk informasi selengkapnya tentang pola yang valid, lihat https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebBlockedForURLs.pfm_title = "Memblokir integrasi aplikasi Gemini untuk langsung bertindak di situs tertentu";
GeminiActOnWebBlockedForURLs.pfm_description = "Memungkinkan untuk menetapkan daftar pola URL yang menentukan situs tempat integrasi aplikasi Gemini tidak dapat langsung bertindak di halaman web.\n\nURL yang tidak cocok dengan daftar yang diizinkan atau daftar yang tidak diizinkan menggunakan GeminiActOnWebSettings.\n\nURL yang cocok dengan daftar yang diizinkan dan daftar yang tidak diizinkan akan diizinkan.\n\nUntuk informasi selengkapnya tentang pola yang valid, lihat https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebSettings.pfm_title = "Mengizinkan integrasi aplikasi Gemini untuk langsung bertindak di halaman web";
GeminiActOnWebSettings.pfm_description = "0 - Izinkan aplikasi Gemini melakukan tindakan di halaman web.\n1 - Jangan izinkan aplikasi Gemini mengambil tindakan di halaman web.\nMengontrol apakah aplikasi Gemini diizinkan untuk mengambil tindakan di halaman web atas nama pengguna.\n\n0/tidak disetel = Aplikasi Gemini diizinkan untuk mengambil tindakan di halaman web.\n\n1 = Aplikasi Gemini tidak diizinkan untuk mengambil tindakan di halaman web.\n\nKebijakan ini tidak akan berpengaruh jika aplikasi Gemini dinonaktifkan. Misalnya, aplikasi Gemini dapat dinonaktifkan oleh kebijakan GeminiSettings.\n\nUntuk mengetahui informasi selengkapnya tentang Gemini di Chrome, lihat https://support.google.com/chrome/a/answer/16291696.\n\nAktivasi Gemini hanya tersedia di negara atau bahasa tertentu. Menyetel kebijakan ini tidak menjamin fitur akan diaktifkan; fitur tetap bergantung pada ketersediaan. Untuk mengetahui info selengkapnya tentang peluncuran, baca Catatan Rilis Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=id";
GeminiSettings.pfm_title = "Setelan untuk integrasi Gemini";
GeminiSettings.pfm_description = "0 - Izinkan integrasi Gemini.\n1 - Jangan izinkan integrasi Gemini.\nSetelan ini mengizinkan integrasi aplikasi Gemini.\n\nNilai 0 = Integrasi Gemini akan tersedia untuk pengguna.\n\nNilai 1 = Integrasi Gemini tidak akan tersedia untuk pengguna.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nUntuk mengetahui informasi selengkapnya, buka artikel Pusat Bantuan https://support.google.com/chrome/a?p=gemini_in_chrome.";
GeminiSparkSettings.pfm_title = "Mengizinkan Gemini Spark terhubung ke Brave dan menggunakan fitur penjelajahan otomatis melalui Gemini di Chrome";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark diizinkan untuk terhubung ke dan menggunakan penjelajahan otomatis Brave.\n1 - Gemini Spark tidak diizinkan untuk terhubung ke atau menggunakan penjelajahan otomatis Brave.\nMengontrol apakah agen Gemini Spark diizinkan untuk terhubung ke Brave dan menggunakan fitur penjelajahan otomatis. Gemini Spark mungkin tidak tersedia untuk organisasi Anda.\n\nNilai 0 = Gemini Spark diizinkan untuk terhubung ke dan menggunakan fitur penjelajahan otomatis Brave\n\nNilai 1 = Gemini Spark tidak diizinkan untuk terhubung ke atau menggunakan fitur penjelajahan otomatis Brave\n\nPeringatan: Mengizinkan Gemini Spark terhubung ke Brave dan menggunakan fitur penjelajahan otomatis akan mengizinkan agen Gemini Spark melakukan tindakan multilangkah otonom di klien Brave menggunakan sesi penjelajahan aktif. Hal ini menimbulkan risiko keamanan yang signifikan, termasuk risiko kredensial, Ingress Jaringan Lokal, dan hilangnya sinyal kontekstual. Kontrol pengelolaan dan keamanan yang ada mungkin tidak dipatuhi.\n\nAdministrator disarankan untuk mengevaluasi dengan cermat model ancaman jaringan, kepatuhan, dan panduan privasi organisasi sebelum mengaktifkan fitur ini.\n\nKebijakan ini tidak akan berpengaruh jika kebijakan aplikasi Google Gemini atau penjelajahan otomatis Brave dinonaktifkan. Misalnya, aplikasi Google Gemini dapat dinonaktifkan oleh kebijakan GeminiSettings. Untuk mengetahui informasi selengkapnya tentang Google Gemini di Brave, lihat https://support.google.com/chrome/a?p=gemini_in_chrome.\n\nPenjelajahan otomatis Brave dan Gemini Spark hanya tersedia di negara atau bahasa tertentu. Jika kebijakan ini disetel ke nilai 0 - Aktif, tidak ada jaminan bahwa fitur akan diaktifkan; fitur tetap bergantung pada ketersediaan. Untuk mengetahui info selengkapnya tentang peluncuran, baca Catatan Rilis Enterprise: https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Setelan untuk model dasar lokal AI Generatif";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Mendownload model secara otomatis\n1 - Jangan download model\nMengonfigurasi cara Brave mendownload model AI Generatif dasar dan menggunakannya untuk inferensi secara lokal.\n\nJika kebijakan disetel ke Diizinkan (0) atau tidak disetel, model akan otomatis didownload dan digunakan untuk inferensi.\n\nJika kebijakan ini disetel ke Nonaktif (1), model tidak akan didownload, dan model yang ada (jika sudah didownload) akan dihapus.\n\nDi platform desktop, download model juga dapat dinonaktifkan dengan menyetel ComponentUpdatesEnabled ke salah (false).";
GeolocationBlockedForUrls.pfm_title = "Blokir geolokasi di situs ini";
GeolocationBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda dapat menetapkan daftar pola URL yang menentukan situs yang tidak diizinkan untuk mengakses geolokasi pengguna, dan juga tidak diizinkan untuk meminta izin pengguna untuk melakukannya.\n\nJika kebijakan ini tidak disetel, DefaultGeolocationSetting akan berlaku untuk semua situs, jika disetel. Jika tidak, setelan pribadi pengguna akan digunakan.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "Mengaktifkan cache autentikasi HTTP yang tercakup secara global";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Kebijakan ini akan mengonfigurasi satu cache global per profil dengan kredensial autentikasi server HTTP.\n\nJika kebijakan ini tidak ditetapkan atau dinonaktifkan, browser akan menggunakan perilaku autentikasi lintas situs default, perilaku ini akan membatasi kredensial autentikasi server HTTP kepada situs teratas, sehingga ketika dua situs menggunakan resource dari domain autentikasi yang sama, kredensial harus disediakan secara terpisah dalam konteks kedua situs. Kredensial proxy yang disimpan dalam cache akan digunakan kembali di seluruh situs.\n\nJika kebijakan tersebut diaktifkan, kredensial autentikasi HTTP yang dimasukkan dalam konteks satu situs akan otomatis digunakan dalam konteks lainnya.\n\nJika kebijakan ini diaktifkan, situs akan rentan terhadap beberapa jenis serangan lintas situs, dan memungkinkan pengguna dilacak di seluruh situs meskipun tanpa cookie dengan menambahkan entri ke cache autentikasi HTTP menggunakan kredensial yang disematkan dalam URL.\n\nKebijakan ini dimaksudkan untuk memberi kesempatan kepada perusahaan guna memperbarui prosedur login mereka, bergantung pada perilaku lama, dan akan dihapus pada waktu mendatang.";
GoogleSearchSidePanelEnabled.pfm_title = "Aktifkan Google Search Side Panel";
GoogleSearchSidePanelEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, Google Search Side Panel akan diizinkan di semua halaman web.\n\nJika kebijakan disetel ke Nonaktif, Google Search Side Panel tidak akan tersedia di halaman web mana pun.\n\nKemampuan GenAI yang merupakan bagian dari fitur ini tidak tersedia untuk akun Education atau Enterprise.";
HSTSPolicyBypassList.pfm_title = "Daftar nama yang akan melewati pemeriksaan kebijakan HSTS";
HSTSPolicyBypassList.pfm_description = "Menyetel kebijakan akan menentukan daftar nama host yang mengabaikan upgrade HSTS yang dipramuat dari HTTP menjadi HTTPS.\n\nHanya nama host berlabel tunggal yang diizinkan di kebijakan ini, dan kebijakan ini hanya berlaku pada entri HSTS yang dipramuat \"statis\" (contohnya, \"app\", \"new\", \"search\", \"play\"). Kebijakan ini tidak mencegah upgrade HSTS untuk server yang memiliki upgrade HSTS yang diminta \"secara dinamis\" menggunakan header respons Strict-Transport-Security.\n\nNama host yang diberikan harus dikanonikalisasi: Semua IDN harus dikonversi ke format berlabel A, dan semua huruf ASCII harus berupa huruf kecil. Kebijakan ini hanya berlaku untuk nama host berlabel tunggal spesifik yang telah ditentukan, bukan subdomain dari nama host tersebut.";
HappyEyeballsV3Enabled.pfm_title = "Menggunakan algoritma Happy Eyeballs V3";
HappyEyeballsV3Enabled.pfm_description = "Fitur ini mengizinkan algoritma Happy Eyeballs V3 melakukan upaya koneksi. Lihat https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3 untuk mengetahui detailnya.\n\nJika kebijakan ini disetel ke Aktif, Brave akan menggunakan algoritma Happy Eyeballs V3 untuk melakukan upaya koneksi.\n\nJika kebijakan ini disetel ke Nonaktif, algoritma Happy Eyeballs V3 akan dinonaktifkan.\n\nJika kebijakan ini tidak disetel, Brave akan mengaktifkan atau menonaktifkan algoritma Happy Eyeballs V3 berdasarkan setelan di chrome://flags/#happy-eyeballs-v3.\n\nKebijakan ini mendukung pembaruan dinamis.\n\nKebijakan ini adalah tindakan sementara dan akan dihapus di Brave versi mendatang.";
HardwareAccelerationModeEnabled.pfm_title = "Menggunakan akselerasi grafis jika tersedia";
HardwareAccelerationModeEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, akselerasi grafis akan diaktifkan jika tersedia.\n\nJika kebijakan disetel ke Nonaktif, akselerasi grafis akan dinonaktifkan.";
HeadlessMode.pfm_title = "Mengontrol penggunaan Mode Headless";
HeadlessMode.pfm_description = "1 - Izinkan penggunaan Mode Headless\n2 - Jangan izinkan penggunaan Mode Headless\nJika kebijakan ini disetel ke Enabled atau tidak disetel, penggunaan mode headless akan diizinkan. Jika kebijakan ini disetel ke Disabled, penggunaan mode headless tidak akan diizinkan.";
HelpMeWriteSettings.pfm_title = "Setelan Bantu Menulis";
HelpMeWriteSettings.pfm_description = "0 - Izinkan Bantu Tulis dan tingkatkan kualitas model AI.\n1 - Izinkan Bantu Tulis tanpa meningkatkan kualitas model AI.\n2 - Jangan izinkan Bantu Tulis.\nBantu Tulis adalah asisten penulisan berbasis AI untuk konten pendek di web. Saran konten didasarkan pada perintah yang dimasukkan oleh pengguna dan konten halaman web.\n\nNilai 0 = Mengizinkan penggunaan fitur ini, sekaligus mengizinkan Google menggunakan data yang relevan untuk meningkatkan kualitas model AI-nya. Data yang relevan mungkin mencakup perintah, input, output, materi sumber, dan masukan tertulis, bergantung pada fiturnya. Data ini juga mungkin ditinjau secara manual untuk meningkatkan kualitas model AI. Nilai 0 adalah nilai default, kecuali jika dinyatakan lain di bawah.\n\nNilai 1 = Mengizinkan penggunaan fitur ini, tetapi tidak mengizinkan Google meningkatkan kualitas model menggunakan konten pengguna (termasuk perintah, input, output, materi sumber, dan masukan tertulis). Nilai 1 adalah nilai default untuk pengguna Enterprise yang dikelola oleh Google Admin console dan untuk akun Education yang dikelola oleh Google Workspace.\n\nNilai 2 = Tidak mengizinkan penggunaan fitur ini.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
HideWebStoreIcon.pfm_title = "Menyembunyikan toko web dari Halaman Tab Baru dan peluncur aplikasi";
HideWebStoreIcon.pfm_description = "Menyembunyikan aplikasi Chrome Webstore serta link footer dari Halaman Tab Baru dan peluncur aplikasi Google Chrome OS.\n\nJika kebijakan ini disetel ke true, ikon akan disembunyikan.\n\nJika kebijakan ini disetel ke false atau tidak dikonfigurasikan, ikon akan terlihat.";
HighEfficiencyModeEnabled.pfm_title = "Mengaktifkan Mode Efisiensi Tinggi";
HighEfficiencyModeEnabled.pfm_description = "Kebijakan ini mengaktifkan atau menonaktifkan setelan Mode Efisiensi Tinggi. Setelan ini membuat tab ditutup setelah jangka waktu tertentu di latar belakang untuk mengklaim kembali memori.\nJika kebijakan ini tidak disetel, pengguna akhir dapat mengontrol setelan ini di chrome://settings/performance.\n";
HistoryClustersVisible.pfm_title = "Menampilkan tampilan histori Chrome dengan grup halaman";
HistoryClustersVisible.pfm_description = "Kebijakan ini mengontrol visibilitas halaman histori Chrome yang diatur ke dalam grup halaman.\n\nJika kebijakan ini disetel ke Aktif, halaman histori Chrome yang diatur ke dalam grup akan dapat dilihat di chrome://history/grouped.\n\nJika kebijakan ini disetel ke Nonaktif, halaman histori Chrome yang diatur ke dalam grup tidak akan dapat dilihat di chrome://history/grouped.\n\nJika kebijakan ini tidak disetel, halaman histori Chrome yang diatur ke dalam grup akan dapat dilihat di chrome://history/grouped secara default.\n\nPerlu diketahui, jika kebijakan ComponentUpdatesEnabled disetel ke Nonaktif, tetapi HistoryClustersVisible disetel ke Aktif atau tidak disetel, halaman histori Chrome yang diatur ke dalam grup akan tetap tersedia di chrome://history/grouped, tetapi mungkin kurang relevan bagi pengguna.\n";
HistorySearchSettings.pfm_title = "Setelan untuk Penelusuran Histori yang didukung AI";
HistorySearchSettings.pfm_description = "0 - Izinkan Penelusuran Histori AI dan tingkatkan kualitas model AI.\n1 - Izinkan Penelusuran Histori AI tanpa meningkatkan kualitas model AI.\n2 - Jangan izinkan Penelusuran Histori AI.\nPenelusuran Histori AI adalah fitur yang memungkinkan pengguna menelusuri histori penjelajahan dan menerima jawaban yang dibuat berdasarkan konten halaman, bukan hanya URL dan judul halaman.\n\nNilai 0 = Mengizinkan penggunaan fitur ini, sekaligus mengizinkan Google menggunakan data yang relevan untuk meningkatkan kualitas model AI-nya. Data yang relevan mungkin mencakup perintah, input, output, materi sumber, dan masukan tertulis, bergantung pada fiturnya. Data ini juga mungkin ditinjau secara manual untuk meningkatkan kualitas model AI. Nilai 0 adalah nilai default, kecuali jika dinyatakan lain di bawah.\n\nNilai 1 = Mengizinkan penggunaan fitur ini, tetapi tidak mengizinkan Google meningkatkan kualitas model menggunakan konten pengguna (termasuk perintah, input, output, materi sumber, dan masukan tertulis). Nilai 1 adalah nilai default untuk pengguna Enterprise yang dikelola oleh Google Admin console dan untuk akun Education yang dikelola oleh Google Workspace.\n\nNilai 2 = Tidak mengizinkan penggunaan fitur ini.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
HomepageIsNewTabPage.pfm_title = "Gunakan Halaman Tab Baru sebagai beranda";
HomepageIsNewTabPage.pfm_description = "Jika kebijakan disetel ke Aktif, halaman beranda pengguna akan menjadi halaman Tab Baru dan lokasi URL halaman beranda lain akan diabaikan. Jika kebijakan disetel ke Nonaktif, halaman beranda pengguna tidak akan pernah menjadi halaman Tab Baru, kecuali jika URL halaman beranda pengguna disetel ke chrome://newtab.\n\nJika Anda menyetel kebijakan, pengguna tidak dapat mengubah jenis halaman berandanya di Brave. Jika tidak disetel, pengguna dapat memutuskan apakah halaman Tab Baru akan menjadi halaman berandanya atau tidak.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
HomepageLocation.pfm_title = "URL beranda";
HomepageLocation.pfm_description = "Menyetel kebijakan akan menentukan URL halaman beranda default di Brave. Anda membuka halaman beranda menggunakan tombol Beranda. Di desktop, kebijakan RestoreOnStartup mengontrol halaman yang dibuka saat browser mulai dijalankan.\n\nJika halaman beranda disetel ke Halaman Tab Baru, oleh pengguna atau HomepageIsNewTabPage, kebijakan ini tidak akan berpengaruh.\n\nURL memerlukan skema standar, seperti http://example.com atau https://example.com. Jika kebijakan ini disetel, pengguna tidak dapat mengubah URL halaman berandanya di Brave.\n\nJika HomepageLocation dan HomepageIsNewTabPage tidak disetel, pengguna dapat memilih halaman berandanya.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
HttpAllowlist.pfm_title = "Daftar HTTP yang Diizinkan";
HttpAllowlist.pfm_description = "Menyetel kebijakan akan menentukan daftar nama host atau pola nama host (seperti\n'[*.]example.com') yang tidak akan diupgrade ke HTTPS dan tidak akan menampilkan\nerror interstisial jika Mode HTTPS-First diaktifkan. Organisasi dapat menggunakan\nkebijakan ini untuk mengelola akses ke server yang tidak mendukung HTTPS, tanpa perlu\nmenonaktifkan Upgrade HTTPS dan/atau Mode HTTPS-First.\n\nNama host yang diberikan harus dikanonikalisasi: Semua IDN harus dikonversi ke\nformat berlabel A, dan semua huruf ASCII harus berupa huruf kecil.\n\nKarakter pengganti host (yaitu, \"*\" atau \"[*]\") tidak diizinkan. Sebaliknya,\nMode HTTPS-First dan Upgrade HTTPS harus dinonaktifkan secara eksplisit melalui\nkebijakan khususnya.\n\nCatatan: Kebijakan ini tidak berlaku untuk upgrade HSTS.";
HttpHeaderInjection.pfm_title = "Konfigurasi Injeksi Header HTTP untuk pola URL tertentu";
HttpHeaderInjection.pfm_description = "Kebijakan ini memungkinkan penentuan daftar aturan untuk memasukkan header HTTP kustom ke dalam permintaan web yang cocok dengan pola URL tertentu. Header yang ditetapkan oleh kebijakan ini lebih diutamakan daripada header yang awalnya ada dalam permintaan, serta modifikasi yang dicoba dilakukan oleh pengguna atau ekstensi.\n\nKasus penggunaan umum untuk kebijakan ini adalah untuk menerapkan kontrol akses tenant dengan memasukkan header kustom (mis., X-Tenant-ID).\n\nKebijakan ini menerima daftar Aturan. Setiap Aturan berisi:\n\n* patterns: Daftar pola URL yang harus dicocokkan. Lihat cara memformat pola URL ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ).\n\n* headers: Daftar objek yang mewakili header yang akan dimasukkan, yang masing-masing berisi:\n\n* name: Nama header yang akan dimasukkan.\n\n* value: Nilai header yang akan dimasukkan.\n\nJika beberapa aturan cocok dengan permintaan, header dari semua aturan yang cocok akan diterapkan. Jika ada beberapa header dengan nama yang sama, header dengan pola URL yang paling spesifik akan diterapkan. Jika pola sama-sama spesifik, pola yang muncul terakhir dalam daftar akan diterapkan.\n\nNama header harus mematuhi RFC 2616 ( https://www.rfc-editor.org/rfc/rfc2616 ). Nilai header tidak boleh berisi simbol NUL, CR, atau LF. Ukuran setiap header tidak boleh melebihi 8 KB. Header dan pola URL yang tidak valid akan diabaikan.\n\nKebijakan ini dibatasi hingga total 500 pola URL di semua aturan. Setiap aturan dapat berisi maksimal 20 header. Pola dan header di luar batas ini akan diabaikan.\n\nCatatan: Jika pola URL cocok dengan skema yang tidak dienkripsi (http://, ws://, atau saat skema dihilangkan), header yang dikonfigurasi mungkin dikirim dalam bentuk teks biasa melalui saluran yang tidak dienkripsi dan mungkin terekspos ke pengamat jaringan. Untuk melindungi nilai header yang sensitif atau bersifat mengidentifikasi, batasi pola URL hanya pada skema terenkripsi (https:// atau wss://).\nBuka https://chromeenterprise.google/policies/?policy=HttpHeaderInjection untuk informasi lebih lanjut terkait skema dan pemformatan.";
HttpsOnlyMode.pfm_title = "Mengizinkan pengaktifan Mode Khusus HTTPS";
HttpsOnlyMode.pfm_description = "allowed - Jangan batasi setelan Mode Khusus HTTPS pengguna\ndisallowed - Nonaktifkan Mode Khusus HTTPS\nforce_enabled - Aktifkan Mode Khusus HTTPS dalam mode Ketat\nforce_balanced_enabled - Aktifkan Mode Khusus HTTPS dalam Mode Seimbang\nKebijakan ini mengontrol apakah pengguna dapat mengaktifkan Mode Khusus HTTPS (Selalu Gunakan Koneksi Aman) di Setelan. Mode Khusus HTTPS mengupgrade semua navigasi ke HTTPS.\n\nJika setelan ini tidak disetel atau disetel ke \"allowed\", pengguna akan diizinkan mengaktifkan Mode Khusus HTTPS.\n\nJika setelan ini disetel ke \"disallowed\", Mode Khusus HTTPS akan dinonaktifkan.\n\nJika setelan ini disetel ke \"force_enabled\", Mode Khusus HTTPS akan diaktifkan dalam mode Ketat.\n\nJika setelan ini disetel ke \"force_balanced_enabled\", Mode Khusus HTTPS akan diaktifkan dalam mode Seimbang.\n\n\"force_enabled\" didukung mulai M112 dan seterusnya, \"force_balanced_enabled\" didukung mulai M129 dan seterusnya.\n\n\"force_enabled\" dan \"force_balanced_enabled\" juga dapat direkomendasikan kepada pengguna.\nMode Khusus HTTPS akan disetel ke Ketat atau Seimbang pada awalnya, tetapi pengguna diizinkan untuk\nmengubahnya.\n\nJika Anda menyetel kebijakan ini ke nilai yang tidak didukung oleh versi Chrome yang menerima kebijakan, Chrome akan secara default ditetapkan ke setelan yang diizinkan.\n\nKebijakan HttpAllowlist terpisah\ndapat digunakan untuk mengecualikan nama host atau pola nama host tertentu agar tidak\ndiupgrade ke HTTPS oleh fitur ini.";
HttpsUpgradesEnabled.pfm_title = "Mengaktifkan upgrade HTTPS otomatis";
HttpsUpgradesEnabled.pfm_description = "Brave mencoba mengupgrade beberapa\nnavigasi dari HTTP ke HTTPS, jika memungkinkan. Kebijakan ini dapat digunakan untuk\nmenonaktifkan perilaku ini. Jika disetel ke \"true\" atau tidak disetel, fitur ini akan\ndiaktifkan secara default.\n\nKebijakan HttpAllowlist terpisah\ndapat digunakan untuk mengecualikan nama host atau pola nama host tertentu agar tidak\ndiupgrade ke HTTPS oleh fitur ini.\n\nLihat juga kebijakan HttpsOnlyMode.";
IPv6ReachabilityOverrideEnabled.pfm_title = "Mengaktifkan penggantian pemeriksaan keterjangkauan IPv6";
IPv6ReachabilityOverrideEnabled.pfm_description = "Jika kebijakan disetel ke benar (true), pemeriksaan keterjangkauan IPv6 akan diganti. Hal ini berarti bahwa\nsistem akan selalu mengkueri data AAAA ketika me-resolve nama host. Hal ini berlaku untuk\nsemua pengguna dan antarmuka di perangkat.\n\nJika kebijakan disetel ke salah (false) atau tidak disetel, pemeriksaan keterjangkauan IPv6 tidak akan diganti.\nSistem hanya akan mengkueri data AAAA ketika perangkat dapat menjangkau host IPv6 global.";
IdleDetectionAllowedForUrls.pfm_title = "Situs yang diizinkan untuk deteksi tidak ada aktivitas";
IdleDetectionAllowedForUrls.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL yang menentukan situs yang diizinkan menggunakan Idle Detection API tanpa meminta izin pengguna. Entri daftar yang tidak diizinkan memiliki prioritas lebih tinggi daripada entri daftar yang diizinkan, yang berarti bahwa entri daftar yang tidak diizinkan juga memiliki prioritas lebih tinggi daripada nilai default yang dikonfigurasi.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL situs yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan. Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.\n\nJika kebijakan ini tidak disetel, nilai default global akan digunakan untuk semua situs, yang dikonfigurasi oleh kebijakan DefaultIdleDetectionSetting (Setelan deteksi tidak ada aktivitas default), jika disetel, atau oleh konfigurasi pribadi pengguna jika kebijakan tidak disetel.";
IdleDetectionBlockedForUrls.pfm_title = "Situs yang diblokir untuk deteksi tidak ada aktivitas";
IdleDetectionBlockedForUrls.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL yang menentukan situs yang tidak diizinkan menggunakan Idle Detection API.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL situs yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan. Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.\n\nJika kebijakan ini tidak disetel, nilai default global akan digunakan untuk semua situs, yang dikonfigurasi oleh kebijakan DefaultIdleDetectionSetting (Setelan deteksi tidak ada aktivitas default), jika disetel, atau oleh konfigurasi pribadi pengguna jika kebijakan tidak disetel.";
IdleTimeout.pfm_title = "Penundaan sebelum menjalankan tindakan tidak ada aktivitas";
IdleTimeout.pfm_description = "Memicu tindakan saat komputer sedang tidak ada aktivitas.\n\nJika disetel, kebijakan ini akan menentukan durasi waktu tanpa input pengguna (dalam menit) sebelum browser menjalankan tindakan yang dikonfigurasi melalui kebijakan IdleTimeoutActions.\n\nJika kebijakan ini tidak disetel, tidak ada tindakan yang akan dijalankan.\n\nNilai minimumnya adalah 1 menit.\n\n\"Input pengguna\" ditentukan oleh Operating System API, dan menyertakan hal-hal seperti menggerakkan mouse atau mengetik di keyboard.";
IdleTimeoutActions.pfm_title = "Tindakan yang akan dijalankan saat komputer sedang tidak ada aktivitas";
IdleTimeoutActions.pfm_description = "close_browsers - Tutup Browser\nshow_profile_picker - Tampilkan Pemilih Profil\nclear_browsing_history - Hapus Histori Penjelajahan\nclear_download_history - Hapus Histori Download\nclear_cookies_and_other_site_data - Hapus Cookie dan Data Situs Lainnya\nclear_cached_images_and_files - Hapus Gambar dan File dalam Cache\nclear_password_signin - Hapus Login Sandi\nclear_autofill - Hapus Isi Otomatis\nclear_site_settings - Hapus Setelan Situs\nclear_hosted_app_data - Hapus Data Aplikasi yang Dihosting\nreload_pages - Muat Ulang Halaman\nsign_out - Keluar\nclose_tabs - Tutup Tab\nDaftar tindakan yang akan dijalankan saat waktu tunggu dari kebijakan IdleTimeout tercapai.\n\nPeringatan: Menyetel kebijakan ini dapat memengaruhi dan menghapus data pribadi lokal secara permanen. Sebaiknya uji setelan Anda sebelum men-deploy untuk mencegah penghapusan data pribadi secara tidak sengaja.\n\nJika kebijakan IdleTimeout tidak disetel, kebijakan ini tidak akan berpengaruh.\n\nSaat waktu tunggu dari kebijakan IdleTimeout tercapai, browser akan menjalankan tindakan yang dikonfigurasi di kebijakan ini.\n\nJika kebijakan ini disetel ke kosong atau tidak disetel, kebijakan IdleTimeout tidak akan berpengaruh.\n\nTindakan yang didukung adalah:\n\n'close_browsers': menutup semua jendela browser dan PWA untuk profil ini. Tidak didukung di Android dan iOS.\n\n'close_tabs': menutup semua tab yang terbuka di jendela yang terbuka. Hanya didukung di iOS.\n\n'show_profile_picker': menampilkan jendela Pemilih Profil. Tidak didukung di Android dan iOS.\n\n'sign_out': Membuat pengguna login saat ini logout. Hanya didukung di iOS.\n\n'clear_browsing_history', 'clear_download_history', 'clear_cookies_and_other_site_data', 'clear_cached_images_and_files', 'clear_password_signing', 'clear_autofill', 'clear_site_settings', 'clear_hosted_app_data': menghapus data penjelajahan yang sesuai. Lihat kebijakan ClearBrowsingDataOnExitList untuk mengetahui detail selengkapnya. Jenis yang didukung di iOS adalah 'clear_browsing_history', 'clear_cookies_and_other_site_data', 'clear_cached_images_and_files', 'clear_password_signing', dan 'clear_autofill'\n\n'reload_pages': memuat ulang semua halaman web. Untuk beberapa halaman, pengguna mungkin diminta untuk mengonfirmasi terlebih dahulu. Tidak didukung di iOS.\n\nPengguna akan tetap login ke Akun Google mereka saat menghapus cookie menggunakan 'clear_cookies_and_other_site_data'.\n\nMenyetel 'clear_browsing_history', 'clear_password_signing', 'clear_autofill', dan 'clear_site_settings' akan menonaktifkan sinkronisasi untuk setiap jenis data jika `Chrome Sync` tidak dinonaktifkan dengan menyetel kebijakan SyncDisabled atau BrowserSignin tidak dinonaktifkan.";
ImagesAllowedForUrls.pfm_title = "Izinkan gambar di situs ini";
ImagesAllowedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang dapat menampilkan gambar.\n\nJika kebijakan ini tidak disetel, DefaultImagesSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.\n\nPerlu diperhatikan bahwa sebelumnya kebijakan ini keliru diaktifkan di Android, tetapi fungsi ini belum pernah sepenuhnya didukung di Android.";
ImagesBlockedForUrls.pfm_title = "Blokir gambar di situs ini";
ImagesBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang tidak dapat menampilkan gambar.\n\nJika kebijakan ini tidak disetel, DefaultImagesSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\n Untuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.\n\n Perlu diperhatikan bahwa sebelumnya kebijakan ini keliru diaktifkan di Android, tetapi fungsi ini belum pernah sepenuhnya didukung di Android.";
ImportAutofillFormData.pfm_title = "Mengimpor data formulir isi-otomatis dari browser default saat pertama kali dijalankan";
ImportAutofillFormData.pfm_description = "Jika kebijakan disetel ke Aktif, data formulir isi otomatis akan diimpor dari browser default sebelumnya saat pertama kali dijalankan. Jika kebijakan disetel ke Nonaktif atau tidak disetel, tidak ada data formulir isi otomatis yang akan diimpor saat pertama kali dijalankan.\n\nPengguna dapat memicu dialog impor dan kontak centang data formulir isi otomatis akan dicentang atau dihapus centangnya agar cocok dengan nilai kebijakan ini.";
ImportBookmarks.pfm_title = "Impor bookmark dari browser default saat pertama kali dijalankan";
ImportBookmarks.pfm_description = "Jika kebijakan disetel ke Aktif, bookmark akan diimpor dari browser default sebelumnya saat pertama kali dijalankan. Jika kebijakan disetel ke Nonaktif atau tidak disetel, tidak ada bookmark yang akan diimpor saat pertama kali dijalankan.\n\nPengguna dapat memicu dialog impor dan kotak centang bookmark akan dicentang atau dihapus centangnya agar cocok dengan nilai kebijakan ini.";
ImportHistory.pfm_title = "Impor histori browseran dari browser default saat pertama kali dijalankan";
ImportHistory.pfm_description = "Jika kebijakan disetel ke Aktif, histori penjelajahan akan diimpor dari browser default sebelumnya saat pertama kali dijalankan. Jika kebijakan disetel ke Nonaktif atau tidak disetel, tidak ada histori penjelajahan yang akan diimpor saat pertama kali dijalankan.\n\nPengguna dapat memicu dialog impor dan kotak centang histori penjelajahan akan dicentang atau dihapus centangnya agar cocok dengan nilai kebijakan ini.";
ImportHomepage.pfm_title = "Impor beranda dari browser default saat pertama kali dijalankan";
ImportHomepage.pfm_description = "Jika kebijakan disetel ke Aktif, halaman beranda akan diimpor dari browser default sebelumnya saat pertama kali dijalankan. Jika kebijakan disetel ke Nonaktif atau tidak disetel, halaman beranda tidak akan diimpor saat pertama kali dijalankan.\n\nPengguna dapat memicu dialog impor dan kotak centang halaman beranda akan dicentang atau dihapus centangnya agar cocok dengan nilai kebijakan ini.";
ImportSavedPasswords.pfm_title = "Impor sandi yang disimpan dari browser default saat pertama kali dijalankan";
ImportSavedPasswords.pfm_description = "Kebijakan ini hanya mengontrol perilaku impor pertama yang dijalankan setelah penginstalan. Kebijakan ini memungkinkan transisi yang lebih lancar ke Brave di lingkungan dengan browser yang berbeda digunakan secara ekstensif sebelum menginstal browser. Kebijakan ini tidak memengaruhi kemampuan pengelola sandi untuk Akun Google.\n\nJika kebijakan disetel ke Aktif, sandi tersimpan akan diimpor dari browser default sebelumnya saat browser pertama kali dijalankan dan impor manual dari halaman setelan juga dapat dilakukan.\nJika kebijakan disetel ke Nonaktif, sandi tersimpan tidak akan diimpor saat browser pertama kali dijalankan dan impor manual dari halaman Setelan akan diblokir.\nJika kebijakan tidak disetel, sandi tersimpan tidak akan diimpor saat browser pertama kali dijalankan, tetapi pengguna dapat memilih untuk melakukannya dari halaman setelan.";
ImportSearchEngine.pfm_title = "Impor mesin telusur dari browser default saat pertama kali dijalankan";
ImportSearchEngine.pfm_description = "Jika kebijakan disetel ke Aktif, mesin telusur default akan diimpor dari browser default sebelumnya saat pertama kali dijalankan. Jika kebijakan disetel ke Nonaktif atau tidak disetel, tidak ada mesin telusur default yang akan diimpor saat pertama kali dijalankan.\n\nPengguna dapat memicu dialog impor dan kotak centang mesin telusur default akan dicentang atau dihapus centangnya agar cocok dengan nilai kebijakan ini.";
IncognitoModeAvailability.pfm_title = "Ketersediaan mode samaran";
IncognitoModeAvailability.pfm_description = "0 - Mode samaran tersedia\n1 - Mode samaran dinonaktifkan\n2 - Mode samaran dipaksakan\nMenentukan apakah pengguna dapat membuka halaman dalam mode Samaran di Brave.\n\nJika 'Enabled' dipilih atau kebijakan tidak disetel, halaman dapat dibuka dalam mode Samaran.\n\nJika 'Disabled' dipilih, halaman tidak dapat dibuka dalam mode Samaran.\n\nJika 'Forced' dipilih, halaman dapat dibuka HANYA dalam mode Samaran. Perhatikan bahwa 'Dipaksa' tidak berfungsi untuk Android di Chrome\n\nKebijakan IncognitoModeUrlAllowlist lebih diutamakan daripada kebijakan ini dan dapat mengaktifkan kembali mode Samaran untuk URL tertentu. Jika mode Samaran dinonaktifkan oleh kebijakan ini saat daftar yang diizinkan diberikan, mode Samaran hanya tersedia untuk URL yang cocok dengan daftar yang diizinkan, sedangkan semua halaman lainnya diblokir.\n\nCatatan: Di iOS, jika kebijakan diubah selama sesi, perubahan hanya akan diterapkan saat peluncuran ulang.";
IncognitoModeUrlAllowlist.pfm_title = "Mengizinkan akses ke daftar URL dalam mode Samaran.";
IncognitoModeUrlAllowlist.pfm_description = "Jika kebijakan ini disetel, akses ke URL yang tercantum akan diberikan di mode Samaran. Gunakan kebijakan ini untuk membuka pengecualian untuk pola URL tertentu yang ditentukan dalam IncognitoModeUrlBlocklist, menggunakan format yang ditentukan di ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ).\n\nJika kebijakan ini dan IncognitoModeUrlBlocklist disetel, daftar yang diizinkan akan diprioritaskan. Jika cocok dengan pola di daftar yang diizinkan, URL akan diizinkan. Jika cocok dengan pola di daftar yang tidak diizinkan (tetapi tidak cocok dengan pola di daftar yang diizinkan), URL akan diblokir. Jika URL tidak cocok dengan keduanya, kebijakan umum URLBlocklist/URLAllowlist akan digunakan sebagai penggantian.\n\nJika kebijakan ini disetel dan IncognitoModeUrlBlocklist tidak disetel, URL apa pun yang tidak ada dalam daftar yang diizinkan akan diblokir dalam mode Samaran.\n\nJika IncognitoModeAvailability disetel ke tidak diizinkan (nilai 1), tetapi kebijakan ini dikonfigurasi, mode Samaran hanya akan tersedia untuk URL yang cocok dengan daftar yang diizinkan.\n\nJika kebijakan ini tidak disetel, tidak ada pengecualian untuk IncognitoModeUrlBlocklist dan IncognitoModeAvailability.\n\nKebijakan ini hanya memengaruhi mode Samaran. Untuk mengizinkan URL bagi semua profil pengguna, gunakan kebijakan URLAllowlist.\n\nKarakter pengganti host menyeluruh (yaitu, \"*\" atau \"[*]\") tidak diperbolehkan; gunakan kebijakan IncognitoModeAvailability untuk mengaktifkan fitur ini secara global.\n\nKebijakan ini terbatas untuk 1.000 entri.";
IncognitoModeUrlBlocklist.pfm_title = "Memblokir akses ke daftar URL dalam mode Samaran.";
IncognitoModeUrlBlocklist.pfm_description = "Jika kebijakan IncognitoModeUrlBlocklist disetel, pemuatan halaman web yang berisi URL terlarang akan dihentikan di mode Samaran. Administrator dapat menentukan daftar pola URL yang akan diblokir. Lihat cara memformat pola URL ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ).\n\nJika kebijakan ini dan kebijakan IncognitoModeUrlAllowlist disetel, daftar yang diizinkan akan diprioritaskan. Jika URL cocok dengan pola di daftar yang diizinkan, URL tersebut akan diizinkan. Jika cocok dengan pola di daftar yang tidak diizinkan (tetapi tidak cocok dengan pola di daftar yang diizinkan), URL akan diblokir. Jika URL tidak cocok dengan keduanya, kebijakan umum URLBlocklist/URLAllowlist akan digunakan sebagai penggantian.\n\nJika kebijakan IncognitoModeUrlAllowlist disetel dan kebijakan ini tidak disetel, URL apa pun yang tidak ada dalam daftar yang diizinkan akan diblokir dalam mode Samaran.\n\nJika IncognitoModeAvailability disetel ke tidak diizinkan (nilai 1), tetapi kebijakan IncognitoModeUrlAllowlist dikonfigurasi, mode Samaran hanya akan tersedia untuk URL yang cocok dengan daftar yang diizinkan.\n\nKebijakan ini hanya memengaruhi mode Samaran. Untuk memblokir URL bagi semua profil pengguna, gunakan kebijakan URLBlocklist.\n\nKebijakan ini terbatas untuk 1.000 entri.";
InsecureContentAllowedForUrls.pfm_title = "Izinkan konten tidak aman di situs ini";
InsecureContentAllowedForUrls.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL yang menentukan situs yang diizinkan untuk menampilkan konten campuran (yaitu, konten HTTP di situs HTTPS) yang dapat diblokir (aktif). Daftar tersebut juga dapat menentukan situs yang upgrade konten campurannya yang dapat diblokir secara opsional akan dinonaktifkan.\n\nJika kebijakan ini tidak disetel, konten campuran yang dapat diblokir akan diblokir dan konten campuran yang dapat diblokir secara opsional akan diupgrade, serta pengguna akan diizinkan untuk menyetel pengecualian guna mengizinkan konten tersebut untuk situs tertentu.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
InsecureContentBlockedForUrls.pfm_title = "Blokir konten tidak aman di situs ini";
InsecureContentBlockedForUrls.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL yang menentukan situs yang tidak diizinkan untuk menampilkan konten campuran (yaitu konten HTTP di situs HTTPS) yang dapat diblokir (aktif). Daftar tersebut juga dapat menentukan situs yang konten campurannya yang dapat diblokir secara opsional (pasif) akan diupgrade.\n\nJika kebijakan ini tidak disetel, konten campuran yang dapat diblokir akan diblokir dan konten campuran yang dapat diblokir secara opsional akan diupgrade, tetapi pengguna akan diizinkan untuk menetapkan pengecualian guna mengizinkan konten tersebut untuk situs tertentu.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
IntensiveWakeUpThrottlingEnabled.pfm_title = "Mengontrol fitur IntensiveWakeUpThrottling.";
IntensiveWakeUpThrottlingEnabled.pfm_description = "Jika diaktifkan, fitur IntensiveWakeUpThrottling akan menyebabkan timer JavaScript di tab latar belakang di-throttle dan digabungkan secara agresif, berjalan tidak lebih dari satu kali per menit setelah halaman berada di latar belakang selama 5 menit atau lebih.\n\nIni merupakan fitur kepatuhan standar web, tetapi mungkin merusak fungsi\ndi beberapa situs dengan menyebabkan tindakan tertentu tertunda hingga beberapa\nsaat. Namun, fitur ini membuat penggunaan CPU dan baterai menjadi lebih hemat secara signifikan jika\ndiaktifkan. Lihat https://bit.ly/30b1XR4 untuk detail selengkapnya.\n\nJika kebijakan ini disetel ke aktif, fitur akan diaktifkan secara paksa dan\npengguna tidak akan dapat menggantinya.\n\nJika kebijakan ini disetel ke nonaktif, fitur akan dinonaktifkan secara paksa dan\npengguna tidak akan dapat menggantinya.\n\nJika kebijakan ini tidak disetel, fitur akan dikontrol oleh\nlogika internalnya sendiri, yang dapat dikonfigurasi pengguna secara manual.\n\nPerlu diperhatikan bahwa kebijakan diterapkan per proses perender, dengan nilai terbaru\nsetelan kebijakan yang digunakan saat proses perender dimulai. Mulai ulang\nsepenuhnya diperlukan untuk memastikan bahwa semua tab yang dimuat akan menerima setelan kebijakan\nyang konsisten. Proses yang berjalan dengan nilai kebijakan yang berbeda\ntidak berbahaya.\n";
IntranetRedirectBehavior.pfm_title = "Perilaku Pengalihan Intranet";
IntranetRedirectBehavior.pfm_description = "0 - Gunakan perilaku browser default.\n1 - Nonaktifkan pemeriksaan intersepsi DNS dan infobar \"Mungkin maksud Anda http://intranetsite/\".\n2 - Nonaktifkan pemeriksaan intersepsi DNS; izinkan infobar \"Mungkin maksud Anda http://intranetsite/\".\n3 - Izinkan pemeriksaan intersepsi DNS dan infobar \"Mungkin maksud Anda http://intranetsite/\".\nKebijakan ini mengonfigurasi perilaku untuk pengalihan intranet melalui pemeriksaan intersepsi DNS. Pemeriksaan tersebut berupaya mencari tahu apakah browser berada di balik proxy yang mengalihkan nama host tidak dikenal.\n\nJika kebijakan ini disetel, browser akan menggunakan perilaku default dari pemeriksaan intersepsi DNS dan saran pengalihan intranet. Di M88, perilaku ini diaktifkan secara default, tetapi akan dinonaktifkan secara default pada rilis mendatang.\n\nDNSInterceptionChecksEnabled adalah kebijakan terkait yang juga dapat menonaktifkan pemeriksaan intersepsi DNS. Kebijakan tersebut merupakan versi lebih fleksibel yang mengontrol infobar pengalihan intranet secara terpisah dan dapat diperluas di masa mendatang.\nJika DNSInterceptionChecksEnabled atau kebijakan ini meminta penonaktifan pemeriksaan intersepsi, pemeriksaan akan dinonaktifkan.";
IsolateOrigins.pfm_title = "Aktifkan Isolasi Situs untuk asal yang ditetapkan";
IsolateOrigins.pfm_description = "Tentukan daftar origin yang berjalan dalam proses khusus.\n\nDi Android, kebijakan ini hanya berfungsi di perangkat dengan memori yang cukup (lebih dari 3,2 GB RAM), karena mengisolasi terlalu banyak situs di perangkat dengan resource terbatas dapat menyebabkan masalah performa. Untuk perangkat Android yang memiliki resource terbatas, gunakan IsolateOriginsShortlist.\n\nKonfigurasi isolasi proses secara khusus tidak direkomendasikan untuk perangkat dengan memori kurang dari 1 GB.\n\nSetiap proses origin bernama hanya akan diizinkan untuk memuat dokumen dari origin tersebut dan subdomainnya. Misalnya, menentukan https://a1.example.com/ akan mengizinkan https://a2.a1.example.com/ dalam proses yang sama, tetapi tidak mengizinkan https://example.com atau https://b.example.com.\n\nSejak Brave versi 77, Anda juga dapat menentukan rentang origin yang akan diisolasi menggunakan karakter pengganti. Misalnya, menentukan https://[*.]corp.example.com akan memberikan proses khusus tersendiri bagi setiap origin di bawah https://corp.example.com, termasuk https://corp.example.com itu sendiri, https://a1.corp.example.com, dan https://a2.a1.corp.example.com.\n\nPerhatikan bahwa semua situs (yaitu, skema plus eTLD+1, seperti https://example.com) sudah diisolasi secara default di platform desktop, sebagaimana tercantum dalam kebijakan SitePerProcess. Kebijakan IsolateOrigins ini berguna untuk mengisolasi origin tertentu pada tingkat perincian yang lebih jauh (misalnya, https://a.example.com).\n\nPerhatikan bahwa Android mengisolasi situs sensitif tertentu secara default mulai dari Brave versi 77, dan kebijakan ini memperluas mode tersebut untuk mengisolasi origin tambahan tertentu.\n\nPerhatikan juga bahwa origin yang diisolasi oleh kebijakan ini tidak akan dapat menjalankan skrip pada origin lain di situs yang sama, yang sebenarnya dapat dilakukan jika dua dokumen dari situs yang sama mengubah nilai document.domain masing-masing agar cocok. Administrator sebaiknya memastikan bahwa perilaku yang tidak lazim ini tidak digunakan pada suatu origin sebelum mengisolasinya.\n\nJika kebijakan ini disetel ke string kosong atau tidak disetel, isolasi situs tidak akan diperlukan untuk origin tertentu. Pengguna masih dapat mengaktifkan isolasi proses secara manual melalui tanda command line.";
JavaScriptAllowedForUrls.pfm_title = "Izinkan JavaScript di situs ini";
JavaScriptAllowedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang dapat menjalankan JavaScript.\n\nJika kebijakan ini tidak disetel, DefaultJavaScriptSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
JavaScriptBlockedForUrls.pfm_title = "Blokir JavaScript di situs ini";
JavaScriptBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang tidak dapat menjalankan JavaScript.\n\nJika kebijakan ini tidak disetel, DefaultJavaScriptSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.\n\nPerlu diperhatikan bahwa kebijakan ini memblokir JavaScript berdasarkan apakah origin dokumen tingkat atas (biasanya URL halaman yang juga ditampilkan di kolom URL) cocok dengan pola apa pun. Oleh karena itu, kebijakan ini tidak sesuai untuk memitigasi serangan supply-chain web. Misalnya, menyediakan pola \"https://[*.]foo.com/\" tidak akan mencegah halaman yang dihosting di, misalnya, https://example.com, untuk menjalankan skrip yang dimuat dari https://www.foo.com/example.js. Selain itu, menyediakan pola \"https://example.com/\" tidak akan mencegah dokumen dari https://example.com untuk menjalankan skrip jika dokumen tersebut bukan dokumen tingkat atas, tetapi disematkan sebagai sub-frame ke halaman yang dihosting di origin lain, misalnya, https://www.bar.com.";
JavaScriptJitAllowedForSites.pfm_title = "Mengizinkan JavaScript menggunakan JIT di situs ini";
JavaScriptJitAllowedForSites.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL yang menentukan situs yang diizinkan untuk menjalankan JavaScript dengan compiler JIT (Just In Time) yang diaktifkan.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL situs yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.\n\nPengecualian kebijakan dapat disetel untuk subdomain tertentu maupun seluruh situs. Misalnya, kebijakan yang disetel khusus untuk subdomain.site.com akan berlaku pada subdomain.site.com tanpa memengaruhi site.com. Dalam beberapa kasus saat subdomain tidak dapat diisolasi dari situs induknya, subdomain tersebut mungkin mewarisi kebijakan yang disetel di site.com. Pengecualian juga mungkin tidak berlaku untuk frame yang dimuat di tab yang ada hingga situs tersebut dibuka di tab baru. Pada perangkat Android dengan memori rendah, pengecualian khusus situs mungkin tidak diterapkan. Sebagai gantinya, situs akan menggunakan kebijakan dari DefaultJavaScriptJitSetting, jika disetel, atau mengikuti setelan default JIT JavaScript pada profil tersebut.\n\nUntuk menerapkan pengecualian, Brave mungkin menempatkan situs atau subdomain yang setelannya berbeda dari setelan default ke dalam proses khusus. Hal ini dapat meningkatkan penggunaan memori, terutama di Android atau saat pola karakter pengganti cocok dengan banyak subdomain, karena setiap origin yang cocok mungkin akan diisolasi secara terpisah. Subdomain yang diisolasi juga tidak dapat menggunakan document.domain untuk mengakses situs induknya.\n\nCatatan: Di versi 155 dan yang lebih lama, pengecualian kebijakan hanya diterapkan pada perincian situs (eTLD+1). Kebijakan yang disetel khusus untuk subdomain.site.com tidak akan berjalan, termasuk pada subdomain.site.com; kebijakan tersebut harus disetel pada site.com agar dapat berlaku ke site.com dan subdomain.site.com.\n\nKebijakan ini diterapkan pada setiap frame dan bukan hanya berdasarkan URL origin tingkat teratas. Jadi, misalnya jika site-one.com tercantum dalam kebijakan JavaScriptJitAllowedForSites tetapi site-one.com memuat frame berisi site-two.com, maka JIT JavaScript akan diaktifkan di site-one.com, sedangkan site-two.com akan mengikuti kebijakan dari DefaultJavaScriptJitSetting, jika disetel, atau mengikuti setelan default dengan JIT JavaScript aktif. Entri daftar yang tidak diizinkan memiliki prioritas lebih tinggi daripada entri daftar yang diizinkan, yang berarti bahwa entri daftar yang tidak diizinkan juga memiliki prioritas lebih tinggi daripada nilai default yang dikonfigurasi.\n\nJika kebijakan ini tidak disetel untuk suatu situs, kebijakan dari DefaultJavaScriptJitSetting akan berlaku untuk situs tersebut, jika disetel, atau JIT JavaScript akan diaktifkan untuk situs tersebut.";
JavaScriptJitBlockedForSites.pfm_title = "Memblokir JavaScript agar tidak menggunakan JIT di situs ini";
JavaScriptJitBlockedForSites.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL situs yang menentukan situs yang tidak diizinkan untuk menjalankan JavaScript dengan compiler JIT (Just In Time) yang diaktifkan.\n\nJika JIT JavaScript dinonaktifkan, Brave mungkin merender konten web dengan lebih lambat, serta mungkin menonaktifkan bagian JavaScript termasuk WebAssembly. Jika JIT JavaScript dinonaktifkan, Brave mungkin merender konten web dalam konfigurasi yang lebih aman.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.\n\nPengecualian kebijakan dapat disetel untuk subdomain tertentu maupun seluruh situs. Misalnya, kebijakan yang disetel khusus untuk subdomain.site.com akan berlaku pada subdomain.site.com tanpa memengaruhi site.com. Dalam beberapa kasus saat subdomain tidak dapat diisolasi dari situs induknya, subdomain tersebut mungkin mewarisi kebijakan yang disetel di site.com. Pengecualian juga mungkin tidak berlaku untuk frame yang dimuat di tab yang ada hingga situs tersebut dibuka di tab baru. Pada perangkat Android dengan memori rendah, pengecualian khusus situs mungkin tidak diterapkan. Sebagai gantinya, situs akan menggunakan kebijakan dari DefaultJavaScriptJitSetting, jika disetel, atau mengikuti setelan default JIT JavaScript pada profil tersebut.\n\nUntuk menerapkan pengecualian, Brave mungkin menempatkan situs atau subdomain yang setelannya berbeda dari setelan default ke dalam proses khusus. Hal ini dapat meningkatkan penggunaan memori, terutama di Android atau saat pola karakter pengganti cocok dengan banyak subdomain, karena setiap origin yang cocok mungkin akan diisolasi secara terpisah. Subdomain yang diisolasi juga tidak dapat menggunakan document.domain untuk mengakses situs induknya.\n\nCatatan: Di versi 155 dan yang lebih lama, pengecualian kebijakan hanya diterapkan pada perincian situs (eTLD+1). Kebijakan yang disetel khusus untuk subdomain.site.com tidak akan berjalan, termasuk pada subdomain.site.com; kebijakan tersebut harus disetel pada site.com agar dapat berlaku ke site.com dan subdomain.site.com.\n\nKebijakan ini diterapkan pada setiap frame dan bukan hanya berdasarkan URL origin tingkat teratas. Jadi, misalnya jika site-one.com tercantum dalam kebijakan JavaScriptJitBlockedForSites tetapi site-one.com memuat frame berisi site-two.com, maka JIT JavaScript akan dinonaktifkan di site-one.com, sedangkan site-two.com akan mengikuti kebijakan dari DefaultJavaScriptJitSetting, jika disetel, atau mengikuti setelan default dengan JIT JavaScript aktif. Entri daftar yang tidak diizinkan memiliki prioritas lebih tinggi daripada entri daftar yang diizinkan, yang berarti bahwa entri daftar yang tidak diizinkan juga memiliki prioritas lebih tinggi daripada nilai default yang dikonfigurasi.\n\nJika kebijakan ini tidak disetel untuk suatu situs, kebijakan dari DefaultJavaScriptJitSetting akan berlaku untuk situs tersebut, jika disetel, atau JIT JavaScript akan diaktifkan untuk situs tersebut.";
JavaScriptOptimizerAllowedForSites.pfm_title = "Mengizinkan pengoptimalan JavaScript di situs ini";
JavaScriptOptimizerAllowedForSites.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL situs yang menentukan situs\ndengan pengoptimalan JavaScript lanjutan yang diaktifkan.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL situs yang valid, lihat\nhttps://chromeenterprise.google/policies/url-patterns.\nKarakter pengganti, *, diizinkan.\n\nPengecualian kebijakan dapat disetel untuk subdomain tertentu maupun seluruh situs.\nMisalnya, kebijakan yang disetel khusus untuk subdomain.site.com berlaku untuk\nsubdomain.site.com tanpa memengaruhi site.com. Dalam beberapa kasus saat\nsubdomain tidak dapat diisolasi dari situs induknya, subdomain tersebut mungkin mewarisi kebijakan\nyang disetel di site.com. Pengecualian juga mungkin tidak berlaku untuk frame yang dimuat di\ntab yang ada hingga situs dibuka di tab baru. Pada perangkat\nAndroid dengan memori rendah, pengecualian khusus situs mungkin\ntidak diterapkan. Sebagai gantinya, situs akan menggunakan kebijakan dari\nDefaultJavaScriptOptimizerSetting,\njika disetel, atau mengikuti setelan default pengoptimalan JavaScript pada profil tersebut.\n\nUntuk menerapkan pengecualian, Brave\nmungkin menempatkan situs atau subdomain yang setelannya berbeda dari setelan default ke dalam\nproses khusus. Hal ini dapat meningkatkan penggunaan memori, terutama di\nAndroid atau saat pola karakter pengganti cocok dengan banyak\nsubdomain, karena setiap origin yang cocok mungkin akan diisolasi secara terpisah. Subdomain\nyang diisolasi juga tidak dapat menggunakan document.domain untuk mengakses situs induknya.\n\nCatatan: Di versi 138 dan yang lebih lama, pengecualian kebijakan hanya diterapkan pada\nperincian situs (eTLD+1). Kebijakan yang disetel khusus untuk subdomain.site.com tidak akan\nberjalan, termasuk pada subdomain.site.com; kebijakan tersebut harus disetel di site.com agar\ndapat berlaku ke site.com dan subdomain.site.com.\n\nKebijakan ini diterapkan pada setiap frame dan bukan hanya berdasarkan URL origin\ntingkat teratas, jadi misalnya jika site-one.com tercantum dalam kebijakan JavaScriptOptimizerAllowedForSites, tetapi site-one.com memuat frame\nberisi site-two.com, pengoptimalan JavaScript akan diaktifkan\nuntuk site-one.com, sedangkan site-two.com akan menggunakan kebijakan dari DefaultJavaScriptOptimizerSetting, jika disetel, atau mengikuti setelan default dengan pengoptimalan\nJavaScript aktif. Entri daftar yang tidak diizinkan memiliki prioritas lebih tinggi daripada entri daftar yang diizinkan,\nyang berarti bahwa entri daftar yang tidak diizinkan juga memiliki prioritas lebih tinggi daripada nilai default yang dikonfigurasi.\n\nJika kebijakan ini tidak disetel untuk suatu situs, kebijakan dari DefaultJavaScriptOptimizerSetting akan berlaku untuk situs tersebut, jika disetel, atau\npengoptimalan JavaScript akan diaktifkan untuk situs tersebut.";
JavaScriptOptimizerBlockedForSites.pfm_title = "Memblokir pengoptimalan JavaScript di situs ini";
JavaScriptOptimizerBlockedForSites.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL situs yang menentukan situs\ndengan pengoptimalan JavaScript lanjutan yang dinonaktifkan.\n\nJika pengoptimalan JavaScript dinonaktifkan, Brave mungkin akan merender konten web dengan lebih lambat.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat\nhttps://chromeenterprise.google/policies/url-patterns.\nKarakter pengganti, *, diizinkan.\n\nPengecualian kebijakan dapat disetel untuk subdomain tertentu maupun seluruh situs.\nMisalnya, kebijakan yang disetel khusus untuk subdomain.site.com berlaku untuk\nsubdomain.site.com tanpa memengaruhi site.com. Dalam beberapa kasus saat\nsubdomain tidak dapat diisolasi dari situs induknya, subdomain tersebut mungkin mewarisi kebijakan\nyang disetel di site.com. Pengecualian juga mungkin tidak berlaku untuk frame yang dimuat di\ntab yang ada hingga situs dibuka di tab baru. Pada perangkat\nAndroid dengan memori rendah, pengecualian khusus situs mungkin\ntidak diterapkan. Sebagai gantinya, situs akan menggunakan kebijakan dari\nDefaultJavaScriptOptimizerSetting,\njika disetel, atau mengikuti setelan default pengoptimalan JavaScript pada profil tersebut.\n\nUntuk menerapkan pengecualian, Brave\nmungkin menempatkan situs atau subdomain yang setelannya berbeda dari setelan default ke dalam\nproses khusus. Hal ini dapat meningkatkan penggunaan memori, terutama di\nAndroid atau saat pola karakter pengganti cocok dengan banyak\nsubdomain, karena setiap origin yang cocok mungkin akan diisolasi secara terpisah. Subdomain\nyang diisolasi juga tidak dapat menggunakan document.domain untuk mengakses situs induknya.\n\nCatatan: Di versi 138 dan yang lebih lama, pengecualian kebijakan hanya diterapkan pada\nperincian situs (eTLD+1). Kebijakan yang disetel khusus untuk subdomain.site.com tidak akan\nberjalan, termasuk pada subdomain.site.com; kebijakan tersebut harus disetel di site.com agar\ndapat berlaku ke site.com dan subdomain.site.com.\n\nKebijakan ini diterapkan pada setiap frame dan bukan hanya berdasarkan URL origin\ntingkat teratas, jadi misalnya jika site-one.com tercantum dalam kebijakan JavaScriptOptimizerBlockedForSites, tetapi site-one.com memuat frame\nberisi site-two.com, pengoptimalan JavaScript akan dinonaktifkan\nuntuk site-one.com, sedangkan site-two.com akan menggunakan kebijakan dari DefaultJavaScriptOptimizerSetting, jika disetel, atau mengikuti setelan default dengan pengoptimalan\nJavaScript aktif. Entri daftar yang tidak diizinkan memiliki prioritas lebih tinggi daripada entri daftar yang diizinkan,\nyang berarti bahwa entri daftar yang tidak diizinkan juga memiliki prioritas lebih tinggi daripada nilai default yang dikonfigurasi.\n\nJika kebijakan ini tidak disetel untuk suatu situs, kebijakan dari DefaultJavaScriptOptimizerSetting akan berlaku untuk situs tersebut, jika disetel, atau\npengoptimalan JavaScript akan diaktifkan untuk situs tersebut.";
LiveCaptionEnabled.pfm_title = "Aktifkan Teks Otomatis";
LiveCaptionEnabled.pfm_description = "Aktifkan fitur Teks Otomatis.\n\nJika kebijakan ini disetel ke Aktif, fitur Teks Otomatis akan selalu diaktifkan.\n\nJika kebijakan ini disetel ke Nonaktif, fitur Teks Otomatis akan selalu dinonaktifkan.\n\nJika Anda menyetel kebijakan ini sebagai wajib, pengguna tidak akan dapat mengubah atau menggantinya.\n\nJika kebijakan ini tidak disetel, fitur Teks Otomatis mula-mula akan dinonaktifkan, tetapi dapat diaktifkan oleh pengguna kapan saja.";
LiveTranslateEnabled.pfm_title = "Aktifkan fitur Terjemahan Langsung";
LiveTranslateEnabled.pfm_description = "Mengaktifkan terjemahan teks otomatis. Teks akan dikirim ke Google untuk diterjemahkan.\n\nJika kebijakan ini disetel ke Aktif, fitur Terjemahan Langsung akan selalu diaktifkan.\n\nJika kebijakan ini disetel ke Nonaktif, fitur Terjemahan Langsung akan selalu dinonaktifkan.\n\nJika Anda menyetel kebijakan ini sebagai wajib, pengguna tidak akan dapat mengubah atau menggantinya.\n\nJika kebijakan ini tidak disetel, fitur Terjemahan Langsung mula-mula akan dinonaktifkan, tetapi dapat diaktifkan oleh pengguna kapan saja.\n\nJika LiveCaptionEnabled disetel ke Nonaktif, Terjemahan Langsung akan dinonaktifkan terlepas dari setelan kebijakan ini.";
LocalFontsAllowedForUrls.pfm_title = "Memberikan izin Font Lokal di situs ini";
LocalFontsAllowedForUrls.pfm_description = "Menetapkan daftar pola URL situs yang menentukan situs yang akan otomatis memberikan izin font lokal. Hal ini akan memperluas kemampuan situs untuk melihat informasi tentang font lokal.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL situs yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan. Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.\n\nJika kebijakan ini tidak disetel untuk suatu situs, kebijakan dari DefaultLocalFontsSetting akan berlaku untuk situs tersebut, jika disetel, atau izin akan mengikuti setelan default browser dan memungkinkan pengguna memilih izin ini untuk setiap situs.";
LocalFontsBlockedForUrls.pfm_title = "Memblokir izin Font Lokal di situs ini";
LocalFontsBlockedForUrls.pfm_description = "Menetapkan daftar pola URL situs yang menentukan situs yang akan otomatis menolak izin font lokal. Hal ini akan membatasi kemampuan situs untuk melihat informasi tentang font lokal.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL situs yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan. Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.\n\nJika kebijakan ini tidak disetel untuk suatu situs, kebijakan dari DefaultLocalFontsSetting akan berlaku untuk situs tersebut, jika disetel, atau izin akan mengikuti setelan default browser dan memungkinkan pengguna memilih izin ini untuk setiap situs.";
LocalNetworkAccessAllowedForUrls.pfm_title = "Mengizinkan situs membuat permintaan jaringan ke perangkat lokal dan endpoint jaringan lokal.";
LocalNetworkAccessAllowedForUrls.pfm_description = "Daftar Pola URL. Permintaan yang dimulai dari situs yang disajikan dengan pencocokan origin tidak tunduk pada pemeriksaan Local Network Access.\n\nUntuk origin yang tidak dicakup oleh pola yang ditentukan di sini, konfigurasi pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, kunjungi https://chromeenterprise.google/policies/url-patterns/.\n\nLihat https://wicg.github.io/local-network-access/ untuk mengetahui batasan Local Network Access.\n\nAda beberapa kebijakan yang mencantumkan origin yang memengaruhi permintaan ke perangkat lokal dan endpoint jaringan lokal. Jika origin cocok dengan lebih dari satu kebijakan berikut, kebijakan akan diprioritaskan dalam urutan berikut:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "Memblokir situs agar tidak membuat permintaan jaringan ke perangkat lokal dan endpoint jaringan lokal.";
LocalNetworkAccessBlockedForUrls.pfm_description = "Daftar Pola URL. Permintaan jaringan yang dimulai dari situs yang disajikan dengan pencocokan origin akan diblokir untuk mengajukan permintaan Local Network Access.\n\nUntuk origin yang tidak dicakup oleh pola yang ditentukan di sini, konfigurasi pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, kunjungi https://chromeenterprise.google/policies/url-patterns/.\n\nLihat https://wicg.github.io/local-network-access/ untuk mengetahui batasan Local Network Access.\n\nAda beberapa kebijakan yang mencantumkan origin yang memengaruhi permintaan ke perangkat lokal dan endpoint jaringan lokal. Jika origin cocok dengan lebih dari satu kebijakan berikut, kebijakan akan diprioritaskan dalam urutan berikut:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "Ganti pemetaan ruang alamat IP";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "Kebijakan ini dapat digunakan untuk memperlakukan rentang alamat internal tertentu sebagai \"publik\" sehingga tidak melalui pemeriksaan Local Network Access. Sebaliknya, kebijakan ini dapat digunakan untuk memperlakukan rentang alamat publik tertentu yang mungkin digunakan secara internal sebagai \"lokal\" sehingga dilindungi dengan pemeriksaan Local Network Access.\n\nPenggantian ruang alamat IP memiliki dua bentuk:\n\n[cidr]=[public|local|loopback]\n\ndengan [cidr] adalah rentang alamat IP dalam notasi CIDR (lihat bagian 3.1 dari https://tools.ietf.org/html/rfc4632 untuk IPv4 dan bagian 2.3 dari https://tools.ietf.org/html/rfc4291 untuk IPv6). Alamat IPv6 harus ditentukan dalam format yang aman untuk URL (dalam tanda kurung). Penggantian CIDR berlaku untuk semua port.\n\natau\n\n[ip-address]:[port]=[public|local|loopback]\n\nUntuk mengetahui informasi selengkapnya tentang Local Network Access, lihat https://wicg.github.io/local-network-access/ dan https://developer.chrome.com/blog/local-network-access.\n\nKebijakan ini tidak mendukung pemuatan ulang dinamis.\n\nPenggantian yang berasal dari switch command line --ip-address-space-overrides lebih diprioritaskan daripada penggantian yang ditetapkan oleh kebijakan ini.";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "Izinkan permintaan Akses Jaringan Lokal (LNA) di subframe tanpa pendelegasian eksplisit";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "Secara default, izin untuk Akses Jaringan Lokal (LNA) hanya dapat diminta di subframe lintas origin jika izin tersebut didelegasikan secara eksplisit. Kebijakan ini dapat digunakan untuk mengganti perilaku default ini sehingga izin LNA diwariskan secara default ke subframe, kecuali jika permintaan ditolak secara eksplisit dalam kebijakan izin.\n\nJika kebijakan ini disetel ke aktif, subframe secara default mewarisi semua fitur kebijakan izin LNA dan dapat membuat permintaan jaringan lokal (memicu dialog izin).\n\nJika kebijakan ini disetel ke nonaktif atau tidak disetel, fitur kebijakan izin harus diwariskan secara eksplisit ke subframe agar dapat membuat permintaan jaringan lokal dan memicu dialog izin.\n\nKebijakan ini berlaku untuk fitur kebijakan izin \"local-network-access\", \"loopback-network\", dan \"local-network\".\n\nUntuk mengetahui informasi selengkapnya tentang Akses Jaringan Lokal, lihat https://wicg.github.io/local-network-access/ dan https://developer.chrome.com/blog/local-network-access.\n\nUntuk mengetahui informasi selengkapnya tentang kebijakan izin, lihat https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy.";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "Menentukan apakah akan (sementara) menonaktifkan pembatasan Akses Jaringan Lokal";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "Jika kebijakan ini disetel ke Aktif, permintaan Local Network Access\nhanya akan menampilkan peringatan di Chrome DevTools karena pemeriksaan Local Network Access gagal.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, permintaan Local Network Access akan menggunakan\npenanganan default untuk permintaan ini.\n\nLihat https://wicg.github.io/local-network-access/ untuk mengetahui batasan Local Network Access.\n\nKebijakan perusahaan ini bersifat sementara, dan akan dihapus setelah M163.\n\nDalam jangka panjang, kebijakan LocalNetworkAccessAllowedForUrls\ndapat digunakan untuk memasukkan pola URL ke daftar yang diizinkan yang harus otomatis diberi\nizin Local Network Access.";
LocalNetworkAllowedForUrls.pfm_title = "Mengizinkan situs membuat permintaan jaringan ke endpoint jaringan lokal.";
LocalNetworkAllowedForUrls.pfm_description = "Daftar pola URL. Permintaan jaringan yang dimulai dari situs yang disajikan dengan pencocokan origin ke endpoint jaringan lokal tidak tunduk pada pemeriksaan Local Network Access.\n\nUntuk origin yang tidak dicakup oleh pola yang ditentukan di sini, konfigurasi pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, kunjungi https://chromeenterprise.google/policies/url-patterns/.\n\nKunjungi https://wicg.github.io/local-network-access/ untuk mengetahui batasan Local Network Access.\n\nAda beberapa kebijakan yang mencantumkan origin yang memengaruhi permintaan ke endpoint jaringan lokal. Jika origin cocok dengan lebih dari satu kebijakan berikut, kebijakan akan diprioritaskan dalam urutan berikut:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkBlockedForUrls.pfm_title = "Memblokir situs agar tidak membuat permintaan jaringan ke endpoint jaringan lokal.";
LocalNetworkBlockedForUrls.pfm_description = "Daftar pola URL. Permintaan jaringan yang dimulai dari situs yang disajikan dengan pencocokan origin ke endpoint jaringan lokal akan diblokir untuk mengajukan permintaan Local Network Access.\n\nUntuk origin yang tidak dicakup oleh pola yang ditentukan di sini, konfigurasi pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, kunjungi https://chromeenterprise.google/policies/url-patterns/.\n\nKunjungi https://wicg.github.io/local-network-access/ untuk mengetahui batasan Local Network Access.\n\nAda beberapa kebijakan yang mencantumkan origin yang memengaruhi permintaan ke endpoint jaringan lokal. Jika origin cocok dengan lebih dari satu kebijakan berikut, kebijakan akan diprioritaskan dalam urutan berikut:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LookalikeWarningAllowlistDomains.pfm_title = "Menyembunyikan peringatan domain yang mirip di domain";
LookalikeWarningAllowlistDomains.pfm_description = "Kebijakan ini mencegah tampilnya peringatan URL yang mirip di situs yang tercantum. Peringatan ini biasanya ditampilkan di situs yang diyakini Brave mencoba melakukan spoofing pada situs lain yang biasa dikunjungi pengguna.\n\nJika kebijakan ini diaktifkan dan disetel ke satu atau beberapa domain, halaman peringatan URL yang mirip tidak akan ditampilkan saat pengguna mengunjungi halaman di domain tersebut.\n\nJika kebijakan ini tidak disetel, atau disetel ke daftar kosong, peringatan dapat muncul di situs yang dikunjungi pengguna.\n\nNama host dapat diizinkan menggunakan pencocokan host lengkap, atau pencocokan domain apa pun. Misalnya, peringatan untuk URL seperti \"https://foo.example.com/bar\" dapat disembunyikan jika daftar ini menyertakan \"foo.example.com\" atau \"example.com\".";
LoopbackNetworkAllowedForUrls.pfm_title = "Mengizinkan situs membuat permintaan jaringan ke perangkat lokal.";
LoopbackNetworkAllowedForUrls.pfm_description = "Daftar pola URL. Permintaan jaringan yang dimulai dari situs yang disajikan dengan pencocokan origin ke perangkat lokal tidak tunduk pada pemeriksaan Local Network Access.\n\nUntuk origin yang tidak dicakup oleh pola yang ditentukan di sini, konfigurasi pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, kunjungi https://chromeenterprise.google/policies/url-patterns/.\n\nKunjungi https://wicg.github.io/local-network-access/ untuk mengetahui batasan Local Network Access.\n\nAda beberapa kebijakan yang mencantumkan origin yang memengaruhi permintaan ke perangkat lokal. Jika origin cocok dengan lebih dari satu kebijakan berikut, kebijakan akan diprioritaskan dalam urutan berikut:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LoopbackNetworkBlockedForUrls.pfm_title = "Memblokir situs agar tidak membuat permintaan jaringan ke perangkat lokal.";
LoopbackNetworkBlockedForUrls.pfm_description = "Daftar pola URL. Permintaan jaringan yang dimulai dari situs yang disajikan dengan pencocokan origin ke perangkat lokal akan diblokir untuk mengajukan permintaan Local Network Access.\n\nUntuk origin yang tidak dicakup oleh pola yang ditentukan di sini, konfigurasi pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, kunjungi https://chromeenterprise.google/policies/url-patterns/.\n\nKunjungi https://wicg.github.io/local-network-access/ untuk mengetahui batasan Local Network Access.\n\nAda beberapa kebijakan yang mencantumkan origin yang memengaruhi permintaan ke perangkat lokal. Jika origin cocok dengan lebih dari satu kebijakan berikut, kebijakan akan diprioritaskan dalam urutan berikut:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
ManagedBookmarks.pfm_title = "Bookmark Terkelola";
ManagedBookmarks.pfm_description = "Menyetel kebijakan akan menyiapkan daftar bookmark yang setiap bookmarknya merupakan kamus dengan kunci \"name\" dan \"url\". Kunci ini memiliki nama dan target bookmark. Admin dapat menyiapkan subfolder dengan menentukan bookmark tanpa kunci \"url\", tetapi dengan kunci \"children\" tambahan. Kunci ini juga memiliki daftar bookmark, yang beberapa di antaranya juga merupakan folder. Chrome akan mengubah URL tidak lengkap seolah-olah URL tersebut dikirimkan melalui kolom URL. Misalnya, \"google.com\" menjadi \"https://google.com/\".\n\nPengguna tidak dapat mengubah folder lokasi bookmark (meskipun pengguna dapat menyembunyikannya dari kolom bookmark). Nama folder default untuk bookmark terkelola adalah \"Bookmark terkelola (Managed bookmarks)\", tetapi dapat diubah dengan menambahkan sub-kamus baru ke kebijakan dengan kunci tunggal bernama \"toplevel_name\" yang berisi nama folder yang diinginkan sebagai nilainya. Bookmark terkelola tidak disinkronkan ke akun pengguna dan ekstensi tidak dapat mengubahnya.\nBuka https://chromeenterprise.google/policies/?policy=ManagedBookmarks untuk informasi lebih lanjut terkait skema dan pemformatan.";
ManagedConfigurationPerOrigin.pfm_title = "Menyetel nilai konfigurasi terkelola bagi situs untuk sumber tertentu";
ManagedConfigurationPerOrigin.pfm_description = "Nilai Managed Configuration API yang ditampilkan untuk sumber tertentu ditentukan saat kebijakan ditetapkan.\n\n Managed Configuration API adalah konfigurasi kunci-nilai yang dapat diakses melalui panggilan JavaScript navigator.managed.getManagedConfiguration(). API ini hanya tersedia untuk sumber yang sesuai dengan aplikasi web yang diinstal otomatis melalui WebAppInstallForceList.\n\nBuka https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin untuk informasi lebih lanjut terkait skema dan pemformatan.";
MaxConnectionsPerProxy.pfm_title = "Jumlah maksimal koneksi serentak per server proxy untuk permintaan non-WebSocket";
MaxConnectionsPerProxy.pfm_description = "Jika kebijakan ini disetel, jumlah maksimal koneksi simultan per server proxy untuk permintaan non-WebSocket akan ditentukan.\n\nUntuk mengubah batas permintaan WebSocket, lihat MaxConnectionsPerProxyForWebSocket.\n\nJika kebijakan ini tidak disetel, nilai default 128 akan digunakan.\n\nBeberapa aplikasi web diketahui memakai banyak koneksi dengan GET yang macet. Jadi, jika Anda menetapkan nilai lebih rendah dari 128, jaringan browser akan macet ketika ada terlalu banyak aplikasi web yang terbuka dengan jaringan macet.\nBeberapa server proxy tidak dapat menangani koneksi serentak per klien dalam jumlah besar. Masalah ini dapat diselesaikan dengan menyetel kebijakan ini ke nilai lebih rendah.\n\nNilai ini harus sama dengan atau lebih tinggi dari 6.\nJika nilai yang ditetapkan di bawah batas tersebut, nilai 6 akan digunakan.\nJika menurunkan nilai di bawah nilai default (128), Anda harus menanggung sendiri risikonya.\n\nNilai ini harus sama dengan atau lebih rendah dari 256 (99 di Brave 147 dan versi sebelumnya).\nJika nilai yang ditetapkan di atas batas tersebut, nilai yang akan digunakan adalah 256 (99 di Brave 147 dan versi sebelumnya).\nJika menaikkan nilai di atas nilai default (128), Anda harus menanggung sendiri risikonya.\n\nPerlu diperhatikan bahwa batas yang diterapkan dipengaruhi oleh AllowSocketPoolSizeRandomizationForProxies.";
MaxConnectionsPerProxyForWebSocket.pfm_title = "Jumlah maksimal koneksi serentak per server proxy untuk permintaan WebSocket";
MaxConnectionsPerProxyForWebSocket.pfm_description = "Jika kebijakan ini disetel, jumlah maksimal koneksi simultan per server proxy untuk permintaan WebSocket akan ditentukan.\n\nUntuk mengubah batas permintaan non-WebSocket, lihat MaxConnectionsPerProxy.\n\nJika kebijakan ini tidak disetel, nilai default 128 akan digunakan.\n\nBeberapa aplikasi web diketahui memakai banyak koneksi dengan GET yang macet. Jadi, jika Anda menetapkan nilai lebih rendah dari 128, jaringan browser akan macet ketika ada terlalu banyak aplikasi web yang terbuka dengan jaringan macet.\nBeberapa server proxy tidak dapat menangani koneksi serentak per klien dalam jumlah besar. Masalah ini dapat diselesaikan dengan menyetel kebijakan ini ke nilai lebih rendah.\n\nNilai ini harus sama dengan atau lebih tinggi dari 6.\nJika nilai yang ditetapkan di bawah batas tersebut, nilai 6 akan digunakan.\nJika menurunkan nilai di bawah nilai default (128), Anda harus menanggung sendiri risikonya.\n\nNilai ini harus sama dengan atau lebih rendah dari 256.\nJika nilai yang ditetapkan melebihi batas tersebut, nilai yang akan digunakan adalah 256.\nJika menaikkan nilai di atas nilai default (128), Anda harus menanggung sendiri risikonya.\n\nPerlu diperhatikan bahwa batas yang diterapkan dipengaruhi oleh AllowSocketPoolSizeRandomizationForProxies.";
MaxInvalidationFetchDelay.pfm_title = "Penundaan mengambil maksimum setelah kebijakan invalidasi";
MaxInvalidationFetchDelay.pfm_description = "Jika kebijakan disetel, penundaan maksimum dalam milidetik akan ditentukan antara menerima invalidasi kebijakan dan mengambil kebijakan baru dari layanan pengelolaan perangkat. Nilai yang valid berkisar dari 1.000 (1 detik) hingga 300.000 (5 menit). Nilai di luar rentang ini akan dikunci ke masing-masing batas.\n\nJika kebijakan tidak disetel, Brave akan menggunakan nilai default 10 detik.";
MediaRecommendationsEnabled.pfm_title = "Mengaktifkan Rekomendasi Media";
MediaRecommendationsEnabled.pfm_description = "Secara default, browser akan menampilkan rekomendasi media yang dipersonalisasi kepada pengguna. Jika kebijakan ini disetel ke Nonaktif, rekomendasi ini akan disembunyikan dari pengguna. Jika kebijakan ini disetel ke Aktif atau tidak disetel, rekomendasi media akan ditampilkan kepada pengguna.";
MediaRouterCastAllowAllIPs.pfm_title = "Izinkan Google Cast untuk terhubung ke perangkat Cast di semua alamat IP.";
MediaRouterCastAllowAllIPs.pfm_description = "Kecuali EnableMediaRouter disetel ke Nonaktif, menyetel MediaRouterCastAllowAllIPs ke Aktif akan menghubungkan Google Cast ke perangkat Transmisi di semua alamat IP, bukan hanya alamat pribadi RFC1918/RFC4193.\n\nJika kebijakan disetel ke Nonaktif, Google Cast hanya akan terhubung ke perangkat Transmisi di RFC1918/RFC4193.\n\nJika kebijakan tidak disetel, Google Cast hanya akan terhubung ke perangkat Transmisi di RFC1918/RFC4193, kecuali fitur CastAllowAllIPs diaktifkan.";
MemorySaverModeSavings.pfm_title = "Ubah Penghematan Mode Penghemat Memori";
MemorySaverModeSavings.pfm_description = "0 - Penghematan memori sedang.\n1 - Penghematan memori seimbang.\n2 - Penghematan memori maksimum.\nKebijakan ini mengubah tingkat penghematan Penghemat Memori.\n\nTindakan ini hanya berlaku saat Penghemat Memori diaktifkan melalui setelan atau melalui kebijakan HighEfficiencyModeEnabled, dan akan memengaruhi cara heuristik digunakan untuk menentukan kapan harus menghapus tab. Misalnya, mengurangi masa pakai tab yang tidak aktif sebelum menghapusnya dapat menghemat memori, tetapi juga berarti tab akan lebih sering dimuat ulang sehingga dapat menyebabkan pengalaman pengguna yang buruk dan menimbulkan biaya traffic jaringan yang lebih besar.\n\nJika kebijakan disetel ke 0 - Penghemat Memori akan mendapatkan penghematan memori sedang. Tab menjadi tidak aktif setelah jangka waktu yang lebih lama\n\nJika kebijakan disetel ke 1 - Penghemat Memori akan mendapatkan penghematan memori yang seimbang. Tab menjadi tidak aktif setelah jangka waktu yang optimal.\n\nJika kebijakan disetel ke 2 - Penghemat Memori akan mendapatkan penghematan memori maksimum. Tab menjadi tidak aktif setelah jangka waktu yang lebih singkat.\n\nJika kebijakan ini tidak disetel, pengguna akhir dapat mengontrol setelan ini di chrome://settings/performance.";
MetricsReportingEnabled.pfm_title = "Aktifkan laporan data penggunaan dan yang terkait error";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "Tampilkan kartu di Halaman Tab Baru";
NTPCardsVisible.pfm_description = "Kebijakan ini mengontrol visibilitas kartu di Halaman Tab Baru. Kartu memunculkan titik masuk untuk meluncurkan perjalanan pengguna umum berdasarkan perilaku penelusuran pengguna.\n\nJika kebijakan disetel ke Aktif, Halaman Tab Baru akan menampilkan kartu jika konten tersedia.\n\nJika kebijakan disetel ke Nonaktif, Halaman Tab Baru tidak akan menampilkan kartu.\n\nJika kebijakan tidak disetel, pengguna dapat mengontrol visibilitas kartu. Default-nya adalah kartu terlihat.\n";
NTPCustomBackgroundEnabled.pfm_title = "Izinkan pengguna menyesuaikan latar belakang di halaman Tab Baru";
NTPCustomBackgroundEnabled.pfm_description = "Jika kebijakan disetel ke salah (false), halaman Tab Baru tidak akan mengizinkan pengguna untuk menyesuaikan latar belakang. Latar belakang kustom yang ada akan dihapus secara permanen meskipun nantinya kebijakan disetel ke benar (true).\n\nJika kebijakan disetel ke benar (true) atau tidak disetel, pengguna dapat menyesuaikan latar belakang di halaman Tab Baru.\n\nCatatan: Di Android, kebijakan diterapkan ke browser hanya setelah dimulai ulang.";
NTPFooterExtensionAttributionEnabled.pfm_title = "Mengontrol visibilitas atribusi ekstensi di halaman Tab Baru";
NTPFooterExtensionAttributionEnabled.pfm_description = "Kebijakan ini menentukan apakah atribusi terhadap ekstensi yang memodifikasi Halaman Tab Baru (NTP) akan ditampilkan di bagian footer NTP.\n\nSecara default, jika ekstensi telah menggantikan NTP standar, akan muncul pesan pada footer yang menunjukkan bahwa perubahan tersebut dilakukan oleh ekstensi tertentu. Atribusi ini biasanya menyertakan link ke ekstensi terkait di Chrome Web Store.\n\nJika kebijakan ini tidak disetel atau disetel ke benar (true), atribusi terhadap ekstensi akan ditampilkan di footer NTP ketika NTP dikendalikan oleh ekstensi.\n\nJika kebijakan ini disetel ke salah (false), atribusi terhadap ekstensi tidak akan ditampilkan di footer NTP.";
NTPFooterManagementNoticeEnabled.pfm_title = "Mengontrol visibilitas notifikasi pengelolaan di Halaman Tab Baru untuk browser terkelola";
NTPFooterManagementNoticeEnabled.pfm_description = "Kebijakan ini mengontrol visibilitas notifikasi pengelolaan dalam footer Halaman Tab Baru (NTP). Secara default, footer NTP menampilkan informasi saat browser dikelola oleh organisasi (ditunjukkan dengan ikon bangunan dan \"Dikelola oleh [nama domain]\"). Hal ini dapat disesuaikan menggunakan kebijakan EnterpriseCustomLabelForBrowser dan EnterpriseLogoUrlForBrowser.\n\nJika kebijakan ini tidak disetel atau disetel ke benar (true), browser terkelola akan menampilkan notifikasi “Dikelola oleh…” dengan ikon.\n\nJika kebijakan ini disetel ke salah (false), notifikasi pengelolaan akan disembunyikan.\n\nPerhatikan bahwa kebijakan ini hanya diterapkan untuk browser terkelola, sehingga tidak akan memengaruhi pengguna terkelola di browser tidak terkelola.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia pada instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
NTPOutlookCardVisible.pfm_title = "Menampilkan kartu Kalender Outlook di Halaman Tab Baru";
NTPOutlookCardVisible.pfm_description = "Kebijakan ini mengontrol visibilitas Kartu Outlook di Halaman Tab Baru. Kartu ini hanya akan ditampilkan di Halaman Tab Baru jika kebijakan ini disetel ke aktif dan organisasi Anda mengizinkan penggunaan data Outlook Calendar di browser.\n\nData Outlook tidak akan disimpan oleh browser.\n\nKartu Outlook menampilkan acara kalender berikutnya, beserta tampilan sekilas rapat pada hari itu. Kartu ini bertujuan untuk mengatasi masalah pergantian konteks dan meningkatkan produktivitas dengan memberi pengguna pintasan ke rapat berikutnya.\n\nKartu Microsoft Outlook memerlukan konfigurasi admin tambahan. Untuk mengetahui informasi selengkapnya tentang cara menghubungkan Kartu Halaman Tab Baru Chrome ke Outlook, lihat https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nJika NTPCardsVisible disetel ke nonaktif, Kartu Outlook tidak akan ditampilkan. Jika NTPCardsVisible disetel ke aktif, kartu Outlook akan ditampilkan jika kebijakan ini juga disetel ke aktif dan ada data yang dapat ditampilkan. Jika NTPCardsVisible tidak disetel, kartu Outlook akan ditampilkan jika kebijakan ini juga disetel ke aktif, pengguna telah mengaktifkan kartu di Sesuaikan Chrome, dan ada data yang dapat ditampilkan.";
NTPSharepointCardVisible.pfm_title = "Menampilkan Kartu SharePoint dan OneDrive File di Halaman Tab Baru";
NTPSharepointCardVisible.pfm_description = "Kebijakan ini mengontrol visibilitas Kartu SharePoint dan OneDrive File di Halaman Tab Baru. Kartu ini hanya akan ditampilkan di Halaman Tab Baru jika kebijakan ini disetel ke aktif dan organisasi Anda mengizinkan penggunaan data SharePoint dan OneDrive File di browser.\n\nData SharePoint dan OneDrive tidak akan disimpan oleh browser.\n\nKartu rekomendasi SharePoint dan OneDrive File menampilkan daftar file yang direkomendasikan.  Kartu ini bertujuan untuk mengatasi masalah pergantian konteks dan meningkatkan produktivitas dengan memberi pengguna pintasan ke dokumen terpenting.\n\nKartu Microsoft SharePoint dan OneDrive memerlukan konfigurasi admin tambahan. Untuk mengetahui informasi selengkapnya tentang cara menghubungkan Kartu Halaman Tab Baru Chrome ke SharePoint, lihat https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nJika NTPCardsVisible disetel ke nonaktif, Kartu SharePoint dan OneDrive tidak akan ditampilkan. Jika NTPCardsVisible disetel ke aktif, kartu SharePoint dan OneDrive akan ditampilkan jika kebijakan ini juga disetel ke aktif dan ada data yang dapat ditampilkan. Jika NTPCardsVisible tidak disetel, kartu SharePoint dan OneDrive akan ditampilkan jika kebijakan ini juga disetel ke aktif, pengguna telah mengaktifkan kartu di Sesuaikan Chrome, dan ada data yang dapat ditampilkan.";
NTPShortcuts.pfm_title = "Menyetel pintasan di Halaman Tab Baru";
NTPShortcuts.pfm_description = "Menyetel kebijakan ini akan membuat prakonfigurasi pada hingga 10 pintasan khusus di halaman Tab Baru Brave.\n\nJika kebijakan ini disetel, pengguna akan melihat pintasan ini secara default, selain pintasan pribadi mereka. Pengguna dapat mengontrol visibilitas pintasan organisasi mereka di panel \"Sesuaikan Chrome\".\n\nURL pintasan harus unik.\n\nJika allow_user_edit disetel ke benar (true), pengguna dapat mengubah nama pintasan. Jika disetel ke salah (false) atau tidak disetel, pengguna tidak dapat mengubah nama pintasan.\n\nJika allow_user_delete disetel ke benar (true), pengguna dapat menghapus pintasan. Jika disetel ke salah (false) atau tidak disetel, pengguna tidak dapat menghapus pintasan.\nBuka https://chromeenterprise.google/policies/?policy=NTPShortcuts untuk informasi lebih lanjut terkait skema dan pemformatan.";
NativeMessagingAllowlist.pfm_title = "Nama hosting pesan native untuk dikeluarkan dari daftar yang tidak diizinkan";
NativeMessagingAllowlist.pfm_description = "Menyetel kebijakan akan menentukan host pesan native mana yang tidak termasuk dalam daftar yang ditolak. Nilai * untuk daftar yang ditolak berarti semua host pesan native ditolak, kecuali diizinkan secara eksplisit.\n\nSemua host pesan native diizinkan secara default. Namun, jika semua host pesan native ditolak oleh kebijakan, admin dapat menggunakan daftar yang diizinkan untuk mengubah kebijakan tersebut.";
NativeMessagingBlocklist.pfm_title = "Nama hosting perpesanan asli yang dilarang (atau * untuk semua)";
NativeMessagingBlocklist.pfm_description = "Menyetel kebijakan akan menentukan host pesan native mana yang tidak boleh dimuat. Nilai * untuk daftar yang ditolak berarti semua host pesan native ditolak, kecuali diizinkan secara eksplisit.\n\nJika kebijakan tidak disetel, Brave akan memuat semua host pesan native yang terinstal.";
NativeMessagingUserLevelHosts.pfm_title = "Mengizinkan host Native Messaging level pengguna (diinstal tanpa izin admin)";
NativeMessagingUserLevelHosts.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, Brave dapat menggunakan host pesan native yang diinstal di tingkat pengguna.\n\nMenyetel kebijakan ke Nonaktif berarti Brave hanya dapat menggunakan host ini jika diinstal di tingkat sistem.";
NetworkPredictionOptions.pfm_title = "Aktifkan prediksi jaringan";
NetworkPredictionOptions.pfm_description = "0 - Prediksi tindakan jaringan di koneksi jaringan apa pun\n1 - Memprediksi tindakan jaringan pada jaringan apa pun yang bukan seluler.\n(Penggunaan dihentikan di nilai 50, dihapus di nilai 52. Setelah 52, jika nilai 1 disetel, nilai akan diperlakukan sebagai 0 - memprediksi tindakan jaringan di koneksi jaringan apa pun.)\n2 - Jangan memprediksi tindakan jaringan di koneksi jaringan apa pun\nKebijakan ini mengontrol prediksi jaringan di Brave. Kebijakan ini mengontrol pengambilan data DNS, prakoneksi TCP dan SSL, serta pra-rendering halaman.\n\nJika kebijakan disetel, pengguna tidak dapat mengubahnya. Jika tidak disetel, prediksi jaringan akan diaktifkan, tetapi pengguna dapat mengubahnya.";
NewTabPageLocation.pfm_title = "URL halaman Tab Baru";
NewTabPageLocation.pfm_description = "Menyetel kebijakan akan mengonfigurasi URL halaman Tab Baru default dan mencegah pengguna mengubahnya.\n\nHalaman Tab Baru akan dibuka dengan tab dan jendela baru.\n\nKebijakan ini tidak menentukan halaman mana yang akan dibuka saat browser mulai dijalankan. Halaman tersebut dikontrol oleh kebijakan RestoreOnStartup. Kebijakan ini memengaruhi halaman beranda dan halaman awal jika disetel untuk membuka halaman Tab Baru.\n\nIni merupakan praktik terbaik untuk memberikan URL yang dikanonikalisasi sepenuhnya. Jika URL tidak dikanonikalisasi sepenuhnya, Brave secara default akan menggunakan https://.\n\nJika kebijakan tidak disetel atau disetel ke kosong, halaman Tab Baru default akan digunakan.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
NotificationsAllowedForUrls.pfm_title = "Izinkan pemberitahuan di situs ini";
NotificationsAllowedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang dapat menampilkan notifikasi.\n\nJika kebijakan ini tidak disetel, DefaultNotificationsSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
NotificationsBlockedForUrls.pfm_title = "Memblokir pemberitahuan di situs ini";
NotificationsBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang tidak dapat menampilkan notifikasi.\n\nJika kebijakan ini tidak disetel, DefaultNotificationsSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
NtlmV2Enabled.pfm_title = "Mengaktifkan autentikasi NTLMv2.";
NtlmV2Enabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, NTLMv2 akan diaktifkan.\n\nJika kebijakan disetel ke Nonaktif, NTLMv2 akan dinonaktifkan.\n\nSemua versi terbaru Samba dan server Microsoft® Windows® akan mendukung NTLMv2. Ini seharusnya hanya dinonaktifkan untuk kompatibilitas mundur karena akan mengurangi keamanan autentikasi.";
OopPrintDriversAllowed.pfm_title = "Driver cetak di luar proses diizinkan";
OopPrintDriversAllowed.pfm_description = "Mengontrol apakah Brave berinteraksi dengan driver printer dari proses layanan yang terpisah. Panggilan pencetakan platform untuk mengkueri printer yang tersedia, mendapatkan setelan driver cetak, dan mengirim dokumen untuk dicetak ke printer lokal dilakukan dari proses layanan. Memindahkan panggilan tersebut dari proses browser akan membantu meningkatkan stabilitas dan mengurangi perilaku UI yang terhenti dalam Pratinjau Cetak.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, Brave akan menggunakan proses layanan yang terpisah untuk tugas pencetakan platform.\n\nJika kebijakan ini disetel ke Nonaktif, Brave akan menggunakan proses browser untuk tugas pencetakan platform.\n\nKebijakan ini akan dihapus pada masa mendatang, setelah fitur driver cetak di luar proses diluncurkan sepenuhnya.";
OriginAgentClusterDefaultEnabled.pfm_title = "Mengizinkan pengelompokan cluster agen dengan kunci asal secara default.";
OriginAgentClusterDefaultEnabled.pfm_description = "Kebijakan ini mengizinkan pengelompokan cluster agen dengan kunci origin secara default.\n\nHeader HTTP Origin-Agent-Cluster mengontrol apakah dokumen\ndiisolasi di cluster agen dengan kunci origin atau di cluster agen\ndengan kunci situs. Hal ini berdampak pada keamanan karena cluster agen dengan kunci origin\nmemungkinkan isolasi dokumen menurut origin. Akibatnya,\ndeveloper tidak lagi dapat menyetel pengakses\ndocument.domain.\n\nJika tidak ada header Origin-Agent-Cluster yang disetel,\nperilaku default akan berubah dari kunci situs ke kunci origin di M111.\n\nJika kebijakan ini disetel ke aktif atau tidak disetel, browser akan mengikuti\nperilaku default baru ini mulai versi tersebut.\n\nJika kebijakan ini disetel ke nonaktif, perubahan tersebut akan diurungkan dan\ndokumen tanpa header Origin-Agent-Cluster akan ditetapkan ke\ncluster agen dengan kunci situs. Dengan begitu, pengakses document.domain\ntetap dapat disetel secara default. Perilaku ini cocok dengan perilaku lama.\n\nLihat https://developer.chrome.com/blog/immutable-document-domain/ untuk\nmengetahui detail tambahan.";
OriginKeyedProcessesEnabled.pfm_title = "Mengaktifkan isolasi proses sesuai origin secara default.";
OriginKeyedProcessesEnabled.pfm_description = "Mengaktifkan isolasi proses sesuai origin untuk sebagian besar halaman (misalnya, halaman yang secara default ditetapkan ke kelompok agen sesuai origin). Tindakan ini meningkatkan keamanan, tetapi juga menambah jumlah proses yang dibuat. Pengguna diizinkan untuk mengganti nilai kebijakan yang ditetapkan melalui tanda command line atau chrome://flags (baik untuk mengaktifkan maupun menonaktifkan fitur ini).\n\nJika kebijakan ini disetel ke Aktif, sebagian besar origin akan diisolasi, bahkan dari origin lain di situs yang sama. Lihat juga kebijakan IsolateOrigins dan SitePerProcess.\n\nJika kebijakan ini disetel ke Nonaktif, tidak ada origin yang diisolasi dari bagian situs lainnya, kecuali jika origin tersebut secara eksplisit memintanya.\n\nJika kebijakan ini tidak disetel, browser akan menentukan origin mana yang akan diisolasi dan kapan origin tersebut akan diisolasi.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "Origin atau pola nama host yang semestinya tidak dikenai pembatasan untuk origin yang tidak aman";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "Menetapkan kebijakan akan menentukan daftar origin (URL) atau pola nama host (seperti *.example.com) yang tidak dikenai pembatasan keamanan untuk origin yang tidak aman. Pola hanya diterima untuk nama host; URL/origin dengan skema harus berupa string yang sama persis. Organisasi dapat menentukan origin untuk aplikasi lama yang tidak dapat men-deploy TLS atau menyiapkan server staging untuk pengembangan web internal, sehingga developer dapat menguji fitur yang memerlukan konteks aman tanpa harus men-deploy TLS di server staging. Dengan kebijakan ini, origin tidak akan dilabeli \"Not Secure\" (Tidak Aman) di kolom URL.\n\nMenetapkan daftar URL dalam kebijakan ini memiliki efek yang sama dengan menetapkan tanda command line --unsafely-treat-insecure-origin-as-secure ke comma separated list, yang berisi URL yang sama. Jika ditetapkan, kebijakan ini akan menggantikan tanda command line dan UnsafelyTreatInsecureOriginAsSecure.\n\nUntuk informasi selengkapnya tentang konteks aman, lihat Konteks Aman (https://www.w3.org/TR/secure-contexts ).";
PartitionedBlobUrlUsage.pfm_title = "Memilih apakah URL Blob akan dipartisi selama pengambilan dan navigasi";
PartitionedBlobUrlUsage.pfm_description = "Kebijakan ini mengontrol apakah URL Blob dipartisi selama pengambilan dan navigasi.\nJika kebijakan ini disetel ke Aktif atau tidak disetel, URL Blob akan dipartisi.\nJika kebijakan ini disetel ke Nonaktif, URL Blob tidak akan dipartisi.\n\nJika Anda harus menggunakan kebijakan ini, laporkan bug di\nBrave\ndengan menjelaskan kasus penggunaan Anda. Kebijakan ini dijadwalkan untuk ditawarkan hingga\nversi Brave 146. Setelah itu,\nimplementasi lama akan dihapus.\n\nCATATAN: Hanya proses perender yang baru dimulai yang akan menunjukkan perubahan pada\nkebijakan ini saat browser berjalan.\n\nUntuk mengetahui informasi mendetail tentang partisi penyimpanan pihak ketiga, lihat\nhttps://developers.google.com/privacy-sandbox/cookies/storage-partitioning.";
PasswordDismissCompromisedAlertEnabled.pfm_title = "Mengaktifkan penutupan notifikasi sandi yang telah dibobol untuk kredensial yang dimasukkan";
PasswordDismissCompromisedAlertEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna akan memiliki opsi untuk menutup/memulihkan notifikasi sandi yang telah dibobol.\n\nJika Anda menonaktifkan setelan ini, pengguna tidak akan dapat menutup notifikasi sandi yang telah dibobol. Jika Anda mengaktifkan setelan ini, pengguna akan dapat menutup notifikasi sandi yang telah dibobol.";
PasswordLeakDetectionEnabled.pfm_title = "Aktifkan deteksi kebocoran untuk kredensial yang dimasukkan";
PasswordLeakDetectionEnabled.pfm_description = "Jika kebijakan ini disetel ke Aktif, pengguna dapat membuat Brave memeriksa apakah nama pengguna dan sandi yang dimasukkan adalah bagian dari kebocoran.\n\nJika kebijakan ini disetel ke Nonaktif, pengguna tidak diizinkan menjalankan fungsi ini.\n\nJika kebijakan ini disetel, pengguna tidak dapat mengubahnya di Brave. Jika kebijakan ini tidak disetel, pemeriksaan kebocoran kredensial akan diizinkan, tetapi pengguna dapat menonaktifkannya.";
PasswordManagerBlocklist.pfm_title = "Mengonfigurasi daftar domain yang akan menonaktifkan Password Manager (Simpan dan Isi Otomatis)";
PasswordManagerBlocklist.pfm_description = "Konfigurasi daftar domain tempat Brave harus menonaktifkan Password Manager. Artinya, alur kerja Simpan dan Isi Otomatis akan dinonaktifkan, sehingga sandi untuk situs tersebut tidak dapat disimpan atau diisi otomatis ke formulir web.\n\nJika ada domain dalam daftar, Password Manager akan dinonaktifkan untuk domain tersebut.\n\nJika domain tidak ada dalam daftar, Password Manager akan tersedia untuk domain tersebut.\n\nJika kebijakan ini tidak disetel, Password Manager akan tersedia untuk semua domain.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
PasswordManagerEnabled.pfm_title = "Aktifkan penyimpanan sandi di pengelola sandi";
PasswordManagerEnabled.pfm_description = "Kebijakan ini mengontrol kemampuan browser untuk otomatis mengingat sandi di situs dan menyimpannya di pengelola sandi bawaan. Kebijakan ini tidak membatasi akses atau mengubah konten sandi yang disimpan di pengelola sandi serta mungkin disinkronkan ke profil Akun Google dan Android.\n\nJika kebijakan disetel ke Aktif, pengguna dapat membuat Brave mengingat sandi dan memberikan sandi saat pengguna kembali login ke situs.\n\nJika kebijakan disetel ke Nonaktif, pengguna tidak dapat menyimpan sandi baru, tetapi sandi yang disimpan sebelumnya masih berfungsi.\n\nJika kebijakan disetel, pengguna tidak dapat mengubahnya di Brave. Jika tidak disetel, pengguna dapat menonaktifkan penyimpanan sandi.";
PasswordManagerPasskeysEnabled.pfm_title = "Aktifkan penyimpanan kunci sandi ke pengelola sandi";
PasswordManagerPasskeysEnabled.pfm_description = "Kebijakan ini mengontrol kemampuan browser untuk menyimpan kunci sandi di pengelola sandi bawaan. Kebijakan ini tidak membatasi akses ke, atau mengubah konten, kunci sandi yang sudah disimpan di pengelola sandi. Jika kebijakan PasswordManagerEnabled disetel ke Nonaktif, penyimpanan di pengelola sandi bawaan akan dinonaktifkan secara umum, termasuk kunci sandi dan sandi, sehingga kebijakan ini tidak berlaku.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, pengguna dapat menyimpan kunci sandi di pengelola sandi bawaan jika login ke Brave.\n\nJika kebijakan ini disetel ke Nonaktif, pengguna tidak dapat menyimpan kunci sandi di pengelola sandi bawaan, tetapi kunci sandi yang disimpan sebelumnya akan tetap berfungsi.";
PasswordProtectionChangePasswordURL.pfm_title = "Mengonfigurasi URL ubah sandi.";
PasswordProtectionChangePasswordURL.pfm_description = "Menyetel kebijakan akan menentukan URL yang dapat dipakai pengguna untuk mengubah sandinya setelah melihat peringatan di browser. Layanan perlindungan sandi mengirimkan pengguna ke URL (hanya protokol HTTP dan HTTPS) yang Anda tentukan melalui kebijakan ini. Agar Brave dapat merekam hash sandi baru yang dilengkapi salt dengan benar di halaman ubah sandi ini, pastikan halaman ubah sandi Anda mengikuti pedoman ( https://www.chromium.org/developers/design-documents/create-amazing-password-forms ).\n\nJika kebijakan dinonaktifkan atau tidak disetel, layanan akan mengirimkan pengguna ke https://myaccount.google.com untuk mengubah sandinya.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
PasswordProtectionLoginURLs.pfm_title = "Mengonfigurasi daftar URL login perusahaan tempat layanan perlindungan sandi harus merekam hash sandi yang dilengkapi salt.";
PasswordProtectionLoginURLs.pfm_description = "Menyetel kebijakan akan menetapkan daftar URL Login perusahaan (hanya protokol HTTP dan HTTPS). Layanan perlindungan sandi akan merekam hash sandi yang dilengkapi salt di URL ini dan menggunakannya untuk deteksi penggunaan ulang sandi. Agar Brave dapat merekam hash sandi yang dilengkapi salt dengan benar, pastikan halaman login mengikuti pedoman ( https://www.chromium.org/developers/design-documents/create-amazing-password-forms ).\n\nJika setelan ini dinonaktifkan atau tidak disetel, layanan perlindungan sandi hanya merekam hash sandi yang dilengkapi salt di https://accounts.google.com.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
PasswordProtectionWarningTrigger.pfm_title = "Pemicu peringatan perlindungan sandi";
PasswordProtectionWarningTrigger.pfm_description = "0 - Peringatan perlindungan sandi nonaktif\n1 - Peringatan perlindungan sandi dipicu oleh penggunaan ulang sandi\n2 - Peringatan perlindungan sandi dipicu oleh penggunaan ulang sandi di halaman phishing\nJika menyetel kebijakan ini, Anda dapat mengontrol terpicunya peringatan perlindungan sandi. Perlindungan sandi memberi tahu pengguna saat mereka menggunakan kembali sandi yang dilindungi di situs yang berpotensi mencurigakan.\n\nGunakan PasswordProtectionLoginURLs dan PasswordProtectionChangePasswordURL untuk menetapkan sandi mana yang akan dilindungi.\n\nJika kebijakan ini disetel ke:\n\n* PasswordProtectionWarningOff, peringatan perlindungan sandi tidak akan ditampilkan.\n\n* PasswordProtectionWarningOnPasswordReuse, peringatan perlindungan sandi akan ditampilkan saat pengguna menggunakan kembali sandi yang dilindungi di situs yang tidak diizinkan.\n\n* PasswordProtectionWarningOnPhishingReuse, peringatan perlindungan sandi akan ditampilkan saat pengguna menggunakan kembali sandi yang dilindungi di situs phishing.\n\nJika kebijakan ini tidak disetel, layanan perlindungan sandi hanya akan melindungi sandi Google, tetapi pengguna dapat mengubah setelan ini.";
PasswordSharingEnabled.pfm_title = "Mengaktifkan berbagi kredensial pengguna dengan pengguna lain";
PasswordSharingEnabled.pfm_description = "Jika kebijakan disetel ke Aktif, pengguna akan dapat mengirim sandi kepada dan menerima sandi dari anggota keluarga (sesuai dengan Layanan Keluarga).\nJika kebijakan disetel ke Aktif atau tidak disetel, akan ada tombol di Pengelola Sandi yang memungkinkan pengiriman sandi.\nSandi yang diterima disimpan ke akun pengguna dan tersedia di Pengelola Sandi.\n\nJika kebijakan disetel ke Nonaktif, pengguna tidak dapat mengirim sandi dari Pengelola Sandi kepada pengguna lain, dan tidak dapat menerima sandi dari pengguna lain.\n\nFitur ini tidak tersedia jika sinkronisasi Sandi dinonaktifkan (melalui setelan pengguna ataupun dengan menyetel kebijakan SyncDisabled ke Aktif).\n\nAkun terkelola tidak memenuhi syarat untuk bergabung atau membuat grup keluarga, sehingga tidak dapat berbagi sandi.";
PaymentMethodQueryEnabled.pfm_title = "Izinkan situs membuat kueri untuk metode pembayaran yang tersedia.";
PaymentMethodQueryEnabled.pfm_description = "Memungkinkan Anda menentukan situs diizinkan atau tidak untuk memeriksa apakah pengguna telah menyimpan metode pembayaran.\n\nJika kebijakan ini ditetapkan ke nonaktif, situs yang menggunakan PaymentRequest.canMakePayment atau PaymentRequest.hasEnrolledInstrument API akan diberi tahu bahwa tidak ada metode pembayaran yang tersedia.\n\nJika setelan diaktifkan atau tidak ditetapkan, situs diizinkan untuk memeriksa apakah pengguna telah menyimpan metode pembayaran.";
PdfAnnotationsEnabled.pfm_title = "Mengaktifkan Anotasi PDF";
PdfAnnotationsEnabled.pfm_description = "Mengontrol apakah penampil PDF di Brave dapat menganotasi PDF.\n\nJika kebijakan ini tidak disetel atau disetel ke benar (true), penampil PDF akan dapat menganotasi PDF.\n\nJika kebijakan ini disetel ke salah (false), penampil PDF tidak akan dapat menganotasi PDF.";
PdfLocalFileAccessAllowedForDomains.pfm_title = "Mengizinkan akses file lokal ke URL file:// di situs ini di Penampil PDF";
PdfLocalFileAccessAllowedForDomains.pfm_description = "Jika kebijakan ini disetel, domain yang tercantum akan dapat mengakses URL file:// di Penampil PDF.\nJika ditambahkan ke kebijakan ini, domain dapat mengakses URL file:// di Penampil PDF.\nJika dihapus dari kebijakan, domain tidak dapat mengakses URL file:// di Penampil PDF.\nJika kebijakan ini tidak disetel, semua domain tidak akan dapat mengakses URL file:// di Penampil PDF.";
PdfUseSkiaRendererEnabled.pfm_title = "Menggunakan perender Skia untuk rendering PDF";
PdfUseSkiaRendererEnabled.pfm_description = "Mengontrol apakah penampil PDF di Brave menggunakan perender Skia.\n\nJika kebijakan ini disetel ke aktif, penampil PDF akan menggunakan perender Skia.\n\nJika kebijakan ini disetel ke nonaktif, penampil PDF akan menggunakan perender AGG saat ini.\n\nJika kebijakan ini tidak disetel, perender PDF akan dipilih oleh browser.";
PolicyAtomicGroupsEnabled.pfm_title = "Mengaktifkan konsep grup atom kebijakan";
PolicyAtomicGroupsEnabled.pfm_description = "Jika kebijakan disetel ke Aktif, kebijakan yang berasal dari grup atom yang tidak membagikan sumbernya dengan prioritas tertinggi grup akan diabaikan.\n\nJika kebijakan disetel ke Nonaktif, tidak akan ada kebijakan yang diabaikan karena sumbernya. Kebijakan hanya akan diabaikan jika bertentangan, dan kebijakan tersebut tidak memiliki prioritas tertinggi.\n\nJika kebijakan ini disetel dari sumber cloud, kebijakan tidak akan dapat menargetkan pengguna tertentu.";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "Mengizinkan penggabungan kebijakan kamus dari sumber berbeda";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - URL pengecualian manual pengguna terkelola\nDeviceLoginScreenPowerManagement - Pengelolaan daya di layar masuk\nExtensionSettings - Setelan pengelolaan ekstensi\nKeyPermissions - Izin Kunci\nPowerManagementIdleSettings - Setelan pengelolaan daya saat pengguna sedang menganggur\nScreenBrightnessPercent - Persentase kecerahan layar\nScreenLockDelays - Penundaan kunci layar\nJika kebijakan disetel, penggabungan kebijakan yang dipilih akan memungkinkan jika kebijakan tersebut berasal dari sumber yang berbeda, dengan cakupan dan level yang sama. Penggabungan ini ada di kunci level pertama kamus dari setiap sumber. Kunci yang berasal dari sumber prioritas tertinggi akan diutamakan.\n\nGunakan karakter pengganti '*' untuk mengizinkan penggabungan semua kebijakan kamus yang didukung.\n\nJika suatu kebijakan ada dalam daftar dan terdapat pertentangan antara sumber dengan:\n\n* Cakupan dan level yang sama: Nilai-nilai tersebut akan digabungkan ke dalam kamus kebijakan baru.\n\n* Cakupan atau level berbeda: Kebijakan dengan prioritas tertinggi akan diterapkan.\n\nJika suatu kebijakan tidak tercantum dalam daftar dan terdapat pertentangan antara sumber, cakupan, atau level, kebijakan dengan prioritas tertinggi akan diterapkan.";
PolicyListMultipleSourceMergeList.pfm_title = "Mengizinkan penggabungan kebijakan yang ada dalam daftar dari sumber berbeda";
PolicyListMultipleSourceMergeList.pfm_description = "Jika kebijakan disetel, penggabungan kebijakan yang dipilih akan memungkinkan jika kebijakan tersebut berasal dari sumber yang berbeda, dengan cakupan dan level yang sama.\n\nGunakan karakter pengganti '*' untuk mengizinkan penggabungan semua kebijakan dalam daftar.\n\nJika suatu kebijakan ada dalam daftar dan terdapat pertentangan antara sumber dengan:\n\n* Cakupan dan level yang sama: Nilai-nilai tersebut akan digabungkan ke dalam daftar kebijakan baru.\n\n* Cakupan atau level berbeda: Kebijakan dengan prioritas tertinggi akan diterapkan.\n\nJika suatu kebijakan tidak tercantum dalam daftar dan terdapat pertentangan antara sumber, cakupan, atau level, kebijakan dengan prioritas tertinggi akan diterapkan.";
PolicyRefreshRate.pfm_title = "Segarkan peringkat untuk kebijakan pengguna";
PolicyRefreshRate.pfm_description = "Jika kebijakan disetel, periode dalam milidetik akan ditentukan guna mengkueri layanan pengelolaan perangkat untuk informasi kebijakan pengguna. Nilai yang valid berkisar dari 1.800.000 (30 menit) hingga 86.400.000 (1 hari). Nilai di luar rentang ini akan dikunci ke masing-masing batas.\n\nJika kebijakan tidak disetel, nilai default 3 jam akan digunakan.\n\nCatatan: Pemberitahuan kebijakan memaksa refresh ketika kebijakan berubah, sehingga tidak perlu sering me-refresh. Jadi, jika platform mendukung pemberitahuan ini, refresh ditunda selama 24 jam (mengabaikan default dan nilai kebijakan ini).";
PopupsAllowedForUrls.pfm_title = "Mengizinkan pop-up di situs ini";
PopupsAllowedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang dapat membuka pop-up.\n\nJika kebijakan ini tidak disetel, DefaultPopupsSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
PopupsBlockedForUrls.pfm_title = "Memblokir pop-up di situs ini";
PopupsBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang tidak dapat membuka pop-up.\n\nJika kebijakan ini tidak disetel, DefaultPopupsSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
PreciseGeolocationAllowedForUrls.pfm_title = "Izinkan geolokasi presisi di situs ini";
PreciseGeolocationAllowedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang diizinkan untuk mengakses geolokasi akurasi tinggi pengguna tanpa harus meminta izin kepada pengguna terlebih dahulu untuk melakukannya.\n\nJika kebijakan ini tidak disetel, DefaultGeolocationSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
PreferSlowCiphers.pfm_title = "Memilih algoritma cipher enkripsi tertentu untuk TLS";
PreferSlowCiphers.pfm_description = "cnsa - Pilih cipher yang memenuhi persyaratan CNSA 1.0 dan 2.0\ndefault - Gunakan urutan cipher default Brave\nKebijakan ini mengonfigurasi Brave untuk mengurutkan cipher enkripsi pilihannya di TLS 1.3 agar sesuai dengan algoritma yang telah disetujui berdasarkan skema kepatuhan tertentu.\n\nMenyetel kebijakan ini tidak menjamin bahwa algoritma tertentu akan digunakan.\n\nKebijakan ini dibuat bagi operator server, yang ingin mendukung klien dengan maupun tanpa persyaratan kepatuhan, agar dapat membedakan kedua klien tersebut. Kebijakan ini hanya menggunakan algoritma non-default tertentu dengan peningkatan kekuatan kriptografi untuk klien yang secara eksplisit dikonfigurasi agar memilih algoritma.\n\nMenyetel kebijakan ke 'cnsa' akan mengonfigurasi Brave untuk memilih cipher yang diperlukan agar mematuhi Commercial National Security Algorithm Suite versi 1.0 dan 2.0 (CNSA 1.0 dan 2.0).\n\nJika kebijakan ini tidak disetel atau disetel ke 'default', Brave akan dikonfigurasi untuk menggunakan cipher defaultnya.\n\nSetelan kebijakan ini tidak diperlukan untuk keamanan. Kriptografi default yang digunakan oleh Brave sudah cukup kuat untuk menahan serangan brute force bahkan dengan daya sebesar Matahari.\n\nJika kebijakan ini disetel, Brave akan menjadi lebih lambat saat mengakses situs.\n\nKebijakan ini hanya memengaruhi TLS 1.3 dan QUIC; kebijakan ini tidak memengaruhi TLS versi sebelumnya.\n\nKebijakan ini dapat disetel untuk perangkat dan pengguna. Jika disetel untuk pengguna, kebijakan ini hanya memengaruhi permintaan jaringan yang dipicu oleh profil pengguna, dan mungkin tidak memengaruhi permintaan jaringan yang dibuat oleh Brave untuk menjalankan tugas latar belakang di seluruh browser; hal tersebut dikontrol oleh nilai di tingkat perangkat. Jika kebijakan ini disetel di tingkat perangkat dan tingkat pengguna, nilai di tingkat perangkat akan berlaku, kecuali jika urutan prioritas kebijakan telah diubah oleh kebijakan CloudUserPolicyOverridesCloudMachinePolicy.\n\nUntuk versi 155 dan yang lebih lama, kebijakan ini hanya berlaku di seluruh perangkat.";
PreferSlowKexAlgorithms.pfm_title = "Pilih algoritma pertukaran kunci tertentu untuk TLS";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - Pilih metode pertukaran kunci yang memenuhi persyaratan CNSA 2.0\ndefault - Gunakan grup default yang didukung Brave\nKebijakan ini mengonfigurasi Brave untuk mengurutkan algoritma perjanjian kunci pilihannya (grup yang didukung) di TLS 1.3 agar sesuai dengan algoritma yang telah disetujui berdasarkan skema kepatuhan tertentu.\n\nMenyetel kebijakan ini tidak menjamin bahwa algoritma tertentu akan digunakan.\n\nKebijakan ini dibuat bagi operator server, yang ingin mendukung klien dengan maupun tanpa persyaratan kepatuhan, agar dapat membedakan kedua klien tersebut. Kebijakan ini hanya menggunakan algoritma non-default tertentu dengan peningkatan kekuatan kriptografi untuk klien yang secara eksplisit dikonfigurasi agar memilih algoritma.\n\nMenyetel kebijakan ke 'cnsa2' akan mengonfigurasi Brave untuk memilih metode pertukaran kunci yang diperlukan agar sesuai dengan Commercial National Security Algorithm Suite 2.0 (CNSA 2.0).\n\nJika kebijakan ini tidak disetel, atau disetel ke 'default', Brave akan dikonfigurasi untuk menggunakan metode pertukaran kunci defaultnya.\n\nSetelan kebijakan ini tidak diperlukan untuk keamanan. Kriptografi default yang digunakan oleh Brave sudah cukup kuat untuk menahan serangan brute force bahkan dengan daya sebesar Matahari.\n\nJika kebijakan ini disetel, Brave akan menjadi lebih lambat saat mengakses situs.\n\nKebijakan ini hanya memengaruhi TLS 1.3 dan QUIC; kebijakan ini tidak memengaruhi TLS versi sebelumnya.\n\nKebijakan ini dapat disetel untuk perangkat dan pengguna. Jika disetel untuk pengguna, kebijakan ini hanya memengaruhi permintaan jaringan yang dipicu oleh profil pengguna, dan mungkin tidak memengaruhi permintaan jaringan yang dibuat oleh Brave untuk menjalankan tugas latar belakang di seluruh browser; hal tersebut dikontrol oleh nilai di tingkat perangkat. Jika kebijakan ini disetel di tingkat perangkat dan tingkat pengguna, nilai di tingkat perangkat akan berlaku, kecuali jika urutan prioritas kebijakan telah diubah oleh kebijakan CloudUserPolicyOverridesCloudMachinePolicy.\n\nUntuk versi 155 dan yang lebih lama, kebijakan ini hanya berlaku di seluruh perangkat.";
PrefetchWithServiceWorkerEnabled.pfm_title = "Mengizinkan pengambilan data SpeculationRules ke URL yang dikontrol ServiceWorker";
PrefetchWithServiceWorkerEnabled.pfm_description = "Pengambilan data SpeculationRules dapat diberikan ke URL yang dikontrol oleh\nServiceWorker. Namun, kode lama tidak mengizinkannya dan membatalkan permintaan pengambilan data\ntersebut. Kebijakan ini memungkinkan Anda mengontrol perilaku tersebut.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, SpeculationRules akan diizinkan melakukan pengambilan data ke\nURL yang dikontrol ServiceWorker (jika tombol fitur PrefetchServiceWorker disetel ke\naktif). Ini adalah perilaku default saat ini dan telah disesuaikan dengan\nspesifikasi.\n\nJika kebijakan ini disetel ke Nonaktif, pengambilan SpeculationRules tidak akan diizinkan melakukan pengambilan data ke\nURL yang dikontrol ServiceWorker. Ini adalah perilaku lama.\n\nKebijakan ini bersifat sementara dan akan dihapus pada masa mendatang.";
PrintHeaderFooter.pfm_title = "Cetak Header dan Footer";
PrintHeaderFooter.pfm_description = "Jika kebijakan disetel ke Aktif, header dan footer akan diaktifkan dalam pratinjau cetak. Jika kebijakan disetel ke Nonaktif, header dan footer akan dinonaktifkan dalam pratinjau cetak.\n\nJika kebijakan disetel, pengguna tidak dapat mengubahnya. Jika tidak disetel, pengguna akan menentukan apakah header dan footer akan muncul.";
PrintPdfAsImageAvailability.pfm_title = "Mencetak PDF sebagai Gambar Tersedia";
PrintPdfAsImageAvailability.pfm_description = "Mengontrol cara Brave menyediakan opsi Cetak sebagai gambar di Microsoft® Windows® dan macOS saat mencetak PDF.\n\nSaat mencetak PDF di Microsoft® Windows® atau macOS, terkadang tugas pencetakan perlu diraster ke gambar untuk printer tertentu agar mendapatkan output yang terlihat benar.\n\nJika kebijakan ini disetel ke Aktif, Brave akan menyediakan opsi Cetak sebagai gambar di Pratinjau Cetak saat mencetak PDF.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, opsi Cetak sebagai gambar di Brave tidak akan tersedia bagi pengguna di Pratinjau Cetak dan PDF akan dicetak seperti biasa tanpa diraster ke gambar sebelum dikirim ke tujuan.";
PrintPdfAsImageDefault.pfm_title = "Mencetak PDF sebagai Gambar secara Default";
PrintPdfAsImageDefault.pfm_description = "Mengontrol apakah Brave menjadikan opsi Cetak sebagai gambar sebagai setelan default saat mencetak PDF.\n\nJika kebijakan ini disetel ke Aktif, Brave akan menjadikan opsi Cetak sebagai gambar sebagai setelan default di Pratinjau Cetak saat mencetak PDF.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, Brave awalnya akan menyetel opsi Cetak sebagai gambar sebagai tidak disetel.  Pengguna akan diizinkan memilih setelan untuk setiap tugas pencetakan PDF, jika opsi tersebut tersedia.\n\nUntuk Microsoft® Windows® atau macOS, kebijakan ini hanya akan berpengaruh jika PrintPdfAsImageAvailability juga diaktifkan.";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "Menggunakan Printer Default Sistem sebagai Default";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "Jika kebijakan disetel ke Aktif, Brave akan menggunakan printer default OS sebagai tujuan default untuk pratinjau cetak.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, Brave akan menggunakan printer yang terakhir digunakan sebagai tujuan default untuk pratinjau cetak.";
PrintRasterizePdfDpi.pfm_title = "Mencetak DPI PDF Raster";
PrintRasterizePdfDpi.pfm_description = "Mengontrol resolusi gambar cetak saat Brave mencetak PDF dengan rasterisasi.\n\nSaat mencetak PDF menggunakan opsi Cetak sebagai gambar, akan bermanfaat jika menentukan resolusi cetak selain ke setelan printer perangkat atau default PDF.  Resolusi tinggi akan secara signifikan meningkatkan waktu pemrosesan dan pencetakan, sedangkan resolusi rendah dapat menyebabkan kualitas gambar buruk.\n\nKebijakan ini memungkinkan penentuan resolusi tertentu yang akan digunakan saat meraster PDF untuk pencetakan.\n\nJika kebijakan ini disetel ke nol atau tidak disetel sama sekali, resolusi default sistem akan digunakan selama rasterisasi gambar halaman.";
PrinterTypeDenyList.pfm_title = "Menonaktifkan jenis printer di daftar tolak";
PrinterTypeDenyList.pfm_description = "privet - Tujuan protokol berbasis Zeroconf (mDNS + DNS-SD/Tidak digunakan lagi)\nextension - Tujuan berbasis ekstensi\npdf - Tujuan 'Simpan sebagai PDF', serta tujuan 'Simpan ke Google Drive' di perangkat Google Chrome OS\nlocal - Tujuan printer lokal\ncloud - Google Cloud Print (Tidak digunakan lagi)\nJenis printer yang tercantum dalam daftar tolak akan dinonaktifkan agar tidak dapat ditemukan atau digunakan.\n\nMencantumkan semua jenis printer dalam daftar tolak akan menonaktifkan pencetakan secara efektif, karena tidak tersedianya tujuan untuk mengirim dokumen yang akan dicetak.\n\nPada versi sebelum 102, menyertakan cloud ke daftar tolak memiliki efek yang sama dengan menyetel kebijakan CloudPrintSubmitEnabled ke salah (false). Agar tujuan Google Cloud Print tetap dapat ditemukan, kebijakan CloudPrintSubmitEnabled harus disetel ke benar (true) dan cloud tidak boleh berada dalam daftar tolak. Mulai versi 102, tujuan Google Cloud Print tidak didukung dan tidak akan muncul, apa pun nilai kebijakan yang disetel.\n\nJika kebijakan ini tidak disetel atau disetel ke daftar kosong, semua jenis printer akan dapat ditemukan.\n\nPrinter ekstensi juga disebut sebagai tujuan penyedia cetak, dan menyertakan semua tujuan yang termasuk dalam ekstensi Brave.\n\nPrinter lokal juga disebut sebagai tujuan cetak native, dan menyertakan tujuan yang tersedia untuk mesin lokal dan printer jaringan bersama.";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "Membatasi mode pencetakan grafis latar belakang";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - Izinkan pencetakan dengan dan tanpa grafis latar belakang\nenabled - Izinkan pencetakan hanya dengan grafis latar belakang\ndisabled - Izinkan pencetakan hanya tanpa grafis latar belakang\nMembatasi mode pencetakan grafis latar belakang. Kebijakan yang tidak ditetapkan dianggap sebagai tidak ada batasan.";
PrintingBackgroundGraphicsDefault.pfm_title = "Mode pencetakan grafis latar belakang default";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - Aktifkan mode pencetakan grafis latar belakang secara default\ndisabled - Nonaktifkan mode pencetakan grafis latar belakang secara default\nMengganti mode pencetakan grafis latar belakang default.";
PrintingEnabled.pfm_title = "Aktifkan pencetakan";
PrintingEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna dapat mencetak dalam Brave, tetapi pengguna tidak dapat mengganti setelan ini.\n\nJika kebijakan disetel ke Nonaktif, pengguna tidak dapat mencetak dari Brave. Pencetakan nonaktif di menu tiga titik, ekstensi, dan aplikasi JavaScript.";
PrintingPaperSizeDefault.pfm_title = "Ukuran halaman pencetakan default";
PrintingPaperSizeDefault.pfm_description = "Mengganti ukuran halaman pencetakan default.\n\nname harus berisi salah satu format yang tercantum atau 'kustom' jika ukuran kertas yang diminta tidak ada dalam daftar. Jika nilai 'kustom' ditetapkan, properti custom_size harus ditentukan. Nilai ini menjelaskan tinggi dan lebar yang diinginkan dalam satuan mikrometer. Jika tidak, properti custom_size tidak harus ditentukan. Kebijakan yang melanggar aturan ini akan diabaikan.\n\nJika ukuran halaman tidak tersedia pada printer yang dipilih pengguna, kebijakan ini diabaikan.\nBuka https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault untuk informasi lebih lanjut terkait skema dan pemformatan.";
ProfilePickerOnStartupAvailability.pfm_title = "Ketersediaan pemilih profil saat browser dimulai";
ProfilePickerOnStartupAvailability.pfm_description = "0 - Pemilih profil tersedia saat browser dimulai\n1 - Pemilih profil dinonaktifkan saat browser dimulai\n2 - Pemilih profil dipaksa saat browser dimulai\nMenentukan apakah pemilih profil akan diaktifkan, dinonaktifkan, atau dipaksa saat browser dimulai.\n\nSecara default, pemilih profil tidak akan ditampilkan jika browser dimulai dalam mode tamu atau Samaran, direktori dan/atau URL profil ditentukan oleh command line, aplikasi secara eksplisit diminta terbuka, browser diluncurkan oleh notifikasi native, hanya tersedia satu profil, atau kebijakan ForceBrowserSignin disetel ke benar (true).\n\nJika 'Enabled' (0) dipilih atau kebijakan tidak disetel, secara default pemilih profil akan ditampilkan saat browser dimulai, tetapi pengguna dapat mengaktifkan/menonaktifkannya.\n\nJika 'Disabled' (1) dipilih, pemilih profil tidak akan pernah ditampilkan dan pengguna tidak dapat mengubah setelan.\n\nJika 'Forced' (2) dipilih, pemilih profil tidak dapat disembunyikan oleh pengguna. Pemilih profil akan ditampilkan meski hanya tersedia satu profil.";
ProfileReauthPrompt.pfm_title = "Meminta pengguna untuk melakukan autentikasi ulang ke profil";
ProfileReauthPrompt.pfm_description = "0 - Jangan minta autentikasi ulang\n1 - Minta autentikasi ulang di tab\nJika kebijakan ini disetel ke DoNotPrompt atau tidak disetel, Brave tidak akan otomatis meminta pengguna untuk melakukan autentikasi ulang ke browser.\n\nJika kebijakan ini disetel ke PromptInTab, tab baru dengan halaman login Google akan langsung dibuka ketika masa berlaku autentikasi pengguna berakhir. Hal ini hanya terjadi jika menggunakan Chrome Sync.";
ProfileSeparationDomainExceptionList.pfm_title = "Daftar domain sekunder pemisahan profil perusahaan yang diizinkan";
ProfileSeparationDomainExceptionList.pfm_description = "Jika kebijakan ini tidak disetel, login akun tidak akan diperlukan untuk membuat profil baru yang terpisah.\n\nJika kebijakan ini disetel, login akun dari domain yang tercantum tidak akan diperlukan untuk membuat profil baru yang terpisah.\n\nKebijakan ini dapat disetel ke string kosong sehingga semua login akun diwajibkan untuk membuat profil baru yang terpisah.";
PromotionsEnabled.pfm_title = "Mengaktifkan tampilan konten promosi";
PromotionsEnabled.pfm_description = "Jika kebijakan disetel ke Benar (True) atau tidak disetel, Brave akan dapat menampilkan konten promosi produk kepada pengguna.\n\nJika kebijakan disetel ke Salah (False), Brave tidak akan dapat menampilkan konten promosi produk.\n\nMenyetel kebijakan ini akan mengontrol tampilan konten promosi, termasuk halaman sambutan yang membantu pengguna login ke Brave, menyetel Brave sebagai browser default pengguna, atau memberitahukan fitur produk kepada pengguna.";
PromptForDownloadLocation.pfm_title = "Tanyakan lokasi penyimpanan setiap file sebelum mendownload";
PromptForDownloadLocation.pfm_description = "Jika kebijakan disetel ke Aktif, pengguna akan ditanyai lokasi penyimpanan file sebelum mendownload. Jika kebijakan disetel ke Nonaktif, download akan dimulai secara otomatis dan pengguna tidak akan ditanyai lokasi penyimpanan file.\n\nJika kebijakan tidak disetel, pengguna akan dapat mengubah setelan ini.";
PromptOnMultipleMatchingCertificates.pfm_title = "Tampilkan dialog saat ada beberapa sertifikat yang cocok";
PromptOnMultipleMatchingCertificates.pfm_description = "Kebijakan ini mengontrol apakah pengguna akan diminta memilih sertifikat klien saat lebih dari satu sertifikat cocok dengan AutoSelectCertificateForUrls.\nJika kebijakan ini disetel ke Aktif, pengguna akan diminta memilih sertifikat klien setiap kali kebijakan pemilihan otomatis cocok dengan beberapa sertifikat.\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, pengguna mungkin hanya diminta saat tidak ada sertifikat yang cocok dengan pemilihan otomatis.";
ProxySettings.pfm_title = "Setelan proxy";
ProxySettings.pfm_description = "Menyetel kebijakan akan mengonfigurasi setelan proxy untuk Chrome dan aplikasi ARC, yang mengabaikan semua opsi terkait proxy yang ditentukan dari command line.\n\nJika kebijakan ini tidak disetel, pengguna dapat memilih setelan proxy mereka.\n\nJika kebijakan ProxySettings disetel, kolom berikut akan disetujui:\n\n* ProxyMode, yang memungkinkan Anda menentukan server proxy yang digunakan Chrome dan mencegah pengguna mengubah setelan proxy\n\n* ProxyPacUrl, URL ke file .pac proxy, atau skrip PAC yang dienkode sebagai URL data dengan application/x-ns-proxy-autoconfig jenis MIME\n\n* ProxyPacMandatory, yang mencegah stack jaringan beralih kembali ke koneksi langsung dengan skrip PAC yang tidak valid atau tidak tersedia\n\n* ProxyServer, URL server proxy\n\n* ProxyBypassList, daftar host yang proxy-nya akan diabaikan\n\nKolom ProxyServerMode tidak digunakan lagi dan digantikan dengan kolom ProxyMode. Untuk ProxyMode, jika Anda memilih nilai:\n\n* direct, proxy tidak akan pernah digunakan dan semua kolom lainnya akan diabaikan.\n\n* system, proxy sistem akan digunakan dan semua kolom lainnya akan diabaikan.\n\n* auto_detect, semua kolom lainnya akan diabaikan.\n\n* fixed_servers, kolom ProxyServer dan ProxyBypassList akan digunakan.\n\n* pac_script, kolom ProxyPacUrl, ProxyPacMandatory, dan ProxyBypassList akan digunakan.\n\nCatatan: Untuk contoh yang lebih mendetail, buka Project Chromium ( https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings ).\nBuka https://chromeenterprise.google/policies/?policy=ProxySettings untuk informasi lebih lanjut terkait skema dan pemformatan.";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "Mengaktifkan Generator Kode QR";
QRCodeGeneratorEnabled.pfm_description = "Kebijakan ini mengaktifkan fitur generator Kode QR di Brave.\n\nJika kebijakan ini diaktifkan atau tidak dikonfigurasi, fitur Generator Kode QR akan diaktifkan.\n\nJika Anda menonaktifkan kebijakan ini, fitur Generator Kode QR akan dinonaktifkan.";
QuicAllowed.pfm_title = "Izinkan protokol QUIC";
QuicAllowed.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, penggunaan protokol QUIC di Brave akan diizinkan.\n\nJika kebijakan disetel ke Nonaktif, penggunaan protokol QUIC tidak akan diizinkan.";
RegisteredProtocolHandlers.pfm_title = "Daftarkan penangan protokol";
RegisteredProtocolHandlers.pfm_description = "Jika menyetel kebijakan (sebagai direkomendasikan saja), Anda akan dapat mendaftarkan daftar pengendali protokol, yang digabungkan dengan yang didaftarkan pengguna, sehingga keduanya dapat digunakan. Setel properti \"protokol\" ke skema, seperti \"mailto\", dan setel properti \"URL\" ke pola URL aplikasi yang menangani skema yang ditentukan dalam kolom \"protokol\". Pola dapat mencakup placeholder \"%s\", yang diganti dengan URL yang ditangani.\n\nPengguna tidak dapat menghapus pengendali protokol yang didaftarkan oleh kebijakan. Namun, dengan menginstal pengendali default baru, pengguna dapat mengubah pengendali protokol yang diinstal oleh kebijakan.\nBuka https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers untuk informasi lebih lanjut terkait skema dan pemformatan.";
RelaunchFastIfOutdated.pfm_title = "Jangka waktu (hari)";
RelaunchFastIfOutdated.pfm_description = "Menentukan batas minimum usia rilis. Jika batas ini terlampaui, notifikasi peluncuran kembali akan lebih sering ditampilkan. Usia dihitung sejak versi yang sedang berjalan terakhir kali diluncurkan kepada klien.\n\nJika browser perlu diluncurkan kembali atau perangkat perlu dimulai ulang untuk menyelesaikan update yang tertunda dan versi saat ini sudah usang selama lebih dari jumlah hari yang ditentukan oleh setelan ini, kebijakan RelaunchNotificationPeriod-nya akan diganti menjadi 2 jam. Jika kebijakan RelaunchNotification disetel ke 1 ('Diperlukan'), pengguna akan dipaksa untuk meluncurkan kembali browser atau memulai ulang perangkat pada akhir periode yang ditentukan.\n\nJika kebijakan tidak disetel, atau jika usia rilis tidak dapat ditentukan, kebijakan RelaunchNotificationPeriod akan digunakan untuk semua update.";
RelaunchNotification.pfm_title = "Beri tahu pengguna bahwa meluncurkan ulang browser atau memulai ulang perangkat direkomendasikan atau diperlukan";
RelaunchNotification.pfm_description = "1 - Tampilkan permintaan berulang kepada pengguna yang menunjukkan bahwa peluncuran ulang direkomendasikan\n2 - Tampilkan permintaan berulang kepada pengguna yang menunjukkan bahwa peluncuran ulang diperlukan\nBeri tahu pengguna bahwa Brave harus diluncurkan ulang atau Google Chrome OS harus dimulai ulang untuk menerapkan update yang tertunda.\n\nSetelan kebijakan ini mengaktifkan notifikasi untuk memberi tahu pengguna bahwa meluncurkan ulang browser atau memulai ulang perangkat direkomendasikan atau diperlukan. Jika tidak disetel, Brave menunjukkan kepada pengguna bahwa peluncuran ulang diperlukan melalui sedikit perubahan pada menunya, sementara Google Chrome OS menunjukkan hal tersebut melalui notifikasi di area notifikasi. Jika disetel ke 'Recommended', akan muncul peringatan berulang yang menunjukkan bahwa peluncuran ulang direkomendasikan. Pengguna dapat menutup peringatan ini untuk menunda peluncuran ulang. Jika disetel ke 'Required', akan muncul peringatan berulang yang menunjukkan bahwa peluncuran ulang browser akan dilakukan secara paksa setelah periode notifikasi terlampaui. Periode ini akan disetel secara default menjadi tujuh hari untuk Brave dan empat hari untuk Google Chrome OS, serta dapat dikonfigurasi melalui setelan kebijakan RelaunchNotificationPeriod.\n\nSesi pengguna dipulihkan setelah peluncuran ulang/mulai ulang.";
RelaunchNotificationPeriod.pfm_title = "Periode waktu (milidetik)";
RelaunchNotificationPeriod.pfm_description = "Memungkinkan Anda menyetel jangka waktu, dalam milidetik, untuk memberi tahu pengguna bahwa Brave harus diluncurkan kembali atau bahwa perangkat Google Chrome OS harus dimulai ulang untuk menerapkan update yang tertunda.\n\nSelama jangka waktu ini, pengguna akan berulang-ulang diberi tahu tentang perlunya update. Untuk perangkat Google Chrome OS, notifikasi mulai ulang akan muncul di area notifikasi sesuai dengan kebijakan RelaunchHeadsUpPeriod. Untuk browser Brave, menu aplikasi akan berubah untuk menunjukkan bahwa peluncuran ulang diperlukan setelah sepertiga periode notifikasi berlalu. Warna notifikasi akan berubah setelah dua pertiga periode notifikasi berlalu, dan berubah lagi setelah seluruh periode notifikasi berlalu. Notifikasi tambahan yang diaktifkan oleh kebijakan RelaunchNotification mengikuti jadwal yang sama seperti ini.\n\nJika tidak ditetapkan, jangka waktu default selama 604800000 milidetik (satu minggu) akan digunakan.";
RelaunchWindow.pfm_title = "Interval waktu peluncuran kembali";
RelaunchWindow.pfm_description = "Menentukan interval waktu target untuk batas akhir periode notifikasi peluncuran kembali.\n\nPengguna akan diberi tahu saat browser perlu diluncurkan kembali atau perangkat perlu dimulai ulang berdasarkan setelan kebijakan RelaunchNotification dan RelaunchNotificationPeriod. Browser dan perangkat dimulai ulang dengan paksa pada batas akhir periode notifikasi jika kebijakan RelaunchNotification disetel ke 'Required'. Kebijakan RelaunchWindow ini dapat digunakan untuk menunda batas akhir periode notifikasi agar batas akhir berada pada interval waktu tertentu.\n\nJika kebijakan ini tidak disetel, interval waktu target default untuk Google Chrome OS adalah antara pukul 2 AM dan 4 AM. Interval waktu target default untuk Brave adalah sepanjang hari (yang berarti batas akhir periode notifikasi tidak pernah ditunda).\n\nCatatan: Meskipun kebijakan dapat menerima beberapa item dalam entries, semua item kecuali yang pertama akan diabaikan.\nPeringatan: Jika kebijakan ini disetel, penerapan update software mungkin tertunda.\nBuka https://chromeenterprise.google/policies/?policy=RelaunchWindow untuk informasi lebih lanjut terkait skema dan pemformatan.";
RemoteAccessHostAllowClientPairing.pfm_title = "Mengaktifkan atau menonaktifkan autentikasi tanpa PIN untuk host akses jarak jauh";
RemoteAccessHostAllowClientPairing.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna akan dapat menyambungkan klien dan host pada waktu koneksi, tanpa perlu memasukkan PIN setiap waktu.\n\nJika kebijakan disetel ke Nonaktif, fitur ini tidak akan tersedia.";
RemoteAccessHostAllowFileTransfer.pfm_title = "Izinkan pengguna dengan akses jarak jauh untuk mentransfer file ke/dari host";
RemoteAccessHostAllowFileTransfer.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna yang terhubung ke host akses jarak jauh akan diizinkan untuk mentransfer file antara klien dan host. Ini tidak berlaku untuk koneksi bantuan jarak jauh, yang tidak mendukung transfer file.\n\nJika kebijakan disetel ke Nonaktif, transfer file tidak akan diizinkan.";
RemoteAccessHostAllowPinAuthentication.pfm_title = "Mengizinkan metode autentikasi PIN dan penyambungan untuk host akses jarak jauh";
RemoteAccessHostAllowPinAuthentication.pfm_description = "Jika kebijakan ini disetel ke Aktif, host akses jarak jauh dapat menggunakan autentikasi PIN dan penyambungan saat menerima koneksi klien.\n\nJika kebijakan ini disetel ke Nonaktif, autentikasi PIN atau penyambungan tidak akan diizinkan.\n\nJika kebijakan ini tidak disetel, host dapat memutuskan apakah autentikasi PIN dan/atau penyambungan dapat digunakan.\n\nCatatan: Jika setelah kebijakan disetel, tetapi tidak ada metode autentikasi yang sama-sama didukung oleh host dan klien, koneksi akan ditolak.";
RemoteAccessHostAllowRelayedConnection.pfm_title = "Aktifkan penggunaan server relay oleh hosting akses jarak jauh";
RemoteAccessHostAllowRelayedConnection.pfm_description = "Jika RemoteAccessHostFirewallTraversal disetel ke Aktif, menyetel RemoteAccessHostAllowRelayedConnection ke Aktif atau tidak menyetelnya akan mengizinkan klien jarak jauh untuk menggunakan server relai agar terhubung ke perangkat ini saat koneksi langsung tidak tersedia, misalnya karena batasan firewall.\n\nJika kebijakan disetel ke Nonaktif, akses jarak jauh tidak akan dinonaktifkan, tetapi koneksi hanya akan diizinkan dari jaringan yang sama (bukan NAT traversal atau relai).";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "Izinkan koneksi akses jarak jauh ke perangkat ini";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "Jika kebijakan ini disetel ke Nonaktif, layanan host akses jarak jauh tidak dapat dimulai atau dikonfigurasi untuk menerima koneksi masuk.  Kebijakan ini tidak memengaruhi skenario dukungan jarak jauh.\n\nKebijakan ini tidak berpengaruh jika disetel ke Aktif, dibiarkan kosong, atau tidak disetel.";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "Izinkan koneksi dukungan jarak jauh ke perangkat ini";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "Jika kebijakan ini disetel ke nonaktif, host dukungan jarak jauh tidak dapat dimulai atau dikonfigurasi untuk menerima koneksi masuk.\n\nKebijakan ini tidak memengaruhi skenario akses jarak jauh.\n\nKebijakan ini tidak mencegah admin perusahaan terhubung ke perangkat Google Chrome OS terkelola.\n\nKebijakan ini tidak berpengaruh jika disetel ke aktif, dibiarkan kosong, atau tidak disetel.";
RemoteAccessHostAllowUrlForwarding.pfm_title = "Mengizinkan pengguna akses jarak jauh untuk membuka URL sisi host di browser klien lokal mereka";
RemoteAccessHostAllowUrlForwarding.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna yang terhubung ke host akses jarak jauh akan diizinkan membuka URL sisi host di browser klien lokal mereka.\n\nJika kebijakan disetel ke Nonaktif, host akses jarak jauh tidak akan dapat mengirimkan URL ke klien.\n\nSetelan ini tidak berlaku untuk koneksi bantuan jarak jauh karena fitur ini tidak didukung untuk mode koneksi tersebut.\n\nCatatan: Fitur ini belum tersedia secara umum, sehingga mengaktifkannya tidak berarti bahwa fitur tersebut akan terlihat di UI klien.";
RemoteAccessHostClientDomainList.pfm_title = "Mengonfigurasi nama domain wajib untuk klien akses jarak jauh";
RemoteAccessHostClientDomainList.pfm_description = "Menyetel kebijakan akan menentukan nama domain klien yang diberlakukan pada klien akses jarak jauh, dan pengguna tidak dapat mengubahnya. Hanya klien dari salah satu domain yang telah ditentukan yang dapat terhubung ke host.\n\nJika kebijakan disetel ke daftar kosong atau tidak disetel, kebijakan default untuk jenis koneksi akan berlaku. Untuk bantuan jarak jauh, setelan ini mengizinkan klien dari domain mana pun terhubung ke host. Untuk akses jarak jauh kapan saja, hanya pemilik host yang dapat terhubung.\n\nLihat juga RemoteAccessHostDomainList.\n\nCatatan: Setelan ini menggantikan RemoteAccessHostClientDomain, jika ada.";
RemoteAccessHostClipboardSizeBytes.pfm_title = "Ukuran maksimum, dalam byte, yang dapat ditransfer antara klien dan host melalui sinkronisasi papan klip";
RemoteAccessHostClipboardSizeBytes.pfm_description = "Jika kebijakan ini disetel, data papan klip yang dikirim ke dan dari host akan dipotong ke batas yang disetel oleh kebijakan ini.\n\nJika nilai yang disetel adalah 0, sinkronisasi papan klip akan dinonaktifkan.\n\nKebijakan ini memengaruhi skenario akses jarak jauh dan dukungan jarak jauh.\n\nKebijakan ini tidak berpengaruh jika tidak disetel.\n\nMenyetel kebijakan ke nilai yang tidak ada dalam rentang minimum/maksimum dapat mencegah host dimulai.\n\nPerlu diperhatikan bahwa batas atas yang sebenarnya untuk ukuran papan klip didasarkan pada ukuran pesan saluran data WebRTC maksimum yang tidak dikontrol oleh kebijakan ini.";
RemoteAccessHostDomainList.pfm_title = "Mengonfigurasi nama domain wajib untuk host akses jarak jauh";
RemoteAccessHostDomainList.pfm_description = "Menyetel kebijakan akan menentukan nama domain host yang diberlakukan pada host akses jarak jauh, dan pengguna tidak dapat mengubahnya. Host hanya dapat dibagikan menggunakan akun yang terdaftar pada salah satu nama domain yang telah ditentukan.\n\nJika kebijakan disetel ke daftar kosong atau tidak disetel, host akan dapat dibagikan menggunakan akun mana pun.\n\nLihat juga RemoteAccessHostClientDomainList.\n\nCatatan: Setelan ini akan menggantikan RemoteAccessHostDomain, jika ada.";
RemoteAccessHostFirewallTraversal.pfm_title = "Mengaktifkan firewall traversal dari host akses jarak jauh";
RemoteAccessHostFirewallTraversal.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, penggunaan server STUN akan diizinkan sehingga klien jarak jauh dapat menemukan serta terhubung ke perangkat ini, meskipun dipisahkan oleh firewall.\n\nJika kebijakan disetel ke Nonaktif saat koneksi UDP keluar difilter oleh firewall, perangkat hanya akan mengizinkan koneksi dari perangkat klien dalam jaringan lokal.";
RemoteAccessHostMatchUsername.pfm_title = "Wajibkan pencocokan nama pengguna lokal dengan pemilik host akses jarak jauh";
RemoteAccessHostMatchUsername.pfm_description = "Jika kebijakan disetel ke Aktif, host akses jarak jauh akan membandingkan nama pengguna lokal yang dikaitkan dengan host dan nama Akun Google yang terdaftar sebagai pemilik host (misalnya, \"johan\" jika host dimiliki oleh \"johan@example.com\"). Host ini tidak akan dimulai jika nama pemilik host berbeda dengan nama pengguna lokal yang dikaitkan dengan host. Gunakan kebijakan dengan RemoteAccessHostDomain untuk menegaskan bahwa Akun Google pemilik dikaitkan dengan domain tertentu.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, host akses jarak jauh akan dapat dikaitkan dengan pengguna lokal mana pun.";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "Durasi sesi maksimum yang diizinkan untuk koneksi akses jarak jauh";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "Jika kebijakan ini disetel, koneksi akses jarak jauh akan otomatis terputus setelah jumlah menit yang ditentukan di kebijakan telah dilalui. Ini tidak akan mencegah klien menghubungkan kembali setelah durasi sesi maksimum tercapai. Menyetel kebijakan ke nilai yang tidak ada dalam rentang minimum/maksimum dapat mencegah host dimulai. Kebijakan ini tidak memengaruhi skenario dukungan jarak jauh.\n\nKebijakan ini tidak berpengaruh jika tidak disetel. Dalam hal ini, koneksi akses jarak jauh tidak akan memiliki durasi maksimum di perangkat ini.";
RemoteAccessHostRequireCurtain.pfm_title = "Mengaktifkan pemberian tirai hosting akses jarak jauh";
RemoteAccessHostRequireCurtain.pfm_description = "Jika disetel ke Aktif, perangkat input dan output fisik host akses jarak jauh akan dinonaktifkan selama koneksi jarak jauh berlangsung.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, pengguna lokal dan jarak jauh akan diizinkan untuk berinteraksi dengan host saat host dibagikan.";
RemoteAccessHostUdpPortRange.pfm_title = "Batasi jangkauan port UDP yang digunakan oleh hosting akses jarak jauh";
RemoteAccessHostUdpPortRange.pfm_description = "Menyetel kebijakan akan membatasi rentang port UDP yang digunakan oleh host akses jarak jauh di perangkat ini.\n\nJika kebijakan tidak disetel atau disetel ke string kosong, host akses jarak jauh akan dapat menggunakan port mana pun yang tersedia.\n\nCatatan: Jika RemoteAccessHostFirewallTraversal Dinonaktifkan, host akses jarak jauh akan menggunakan port UDP dalam rentang 12400-12409.";
RemoteDebuggingAllowed.pfm_title = "Mengizinkan proses debug jarak jauh";
RemoteDebuggingAllowed.pfm_description = "Mengontrol apakah pengguna dapat menggunakan proses debug jarak jauh.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, pengguna dapat menggunakan proses debug jarak jauh dengan menentukan tombol command line --remote-debugging-port dan --remote-debugging-pipe di platform desktop, atau dengan mengaktifkan setelan sistem mode debug USB di Android.\n\nJika kebijakan ini disetel ke Nonaktif, pengguna tidak diizinkan menggunakan proses debug jarak jauh.";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "Mewajibkan pemeriksaan OCSP/CRL online untuk trust anchor lokal";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "Jika kebijakan disetel ke Benar (True), Brave akan selalu melakukan pemeriksaan pencabutan sertifikat server yang berhasil divalidasi yang ditandatangani oleh sertifikat CA yang diinstal secara lokal. Jika Brave tidak mendapat informasi status pencabutan, Brave akan memperlakukan sertifikat ini sebagai dicabut (kegagalan fatal).\n\nJika kebijakan disetel ke Salah (False) atau tidak disetel, Brave akan menggunakan setelan pemeriksaan pencabutan online yang ada.\n\nDi macOS, kebijakan ini tidak akan berpengaruh jika kebijakan ChromeRootStoreEnabled disetel ke Salah (False).";
RestoreOnStartup.pfm_title = "Tindakan saat permulaan";
RestoreOnStartup.pfm_description = "5 - Buka Halaman Tab Baru\n1 - Mengembalikan sesi terakhir\n4 - Buka daftar URL\n6 - Buka daftar URL dan pulihkan sesi sebelumnya\nMenyetel kebijakan memungkinkan Anda menentukan perilaku sistem saat browser mulai dijalankan. Menonaktifkan setelan ini memiliki efek yang sama dengan tidak menyetelnya, karena Brave sudah menetapkan perilaku saat browser mulai dijalankan.\n\nJika Anda menyetel kebijakan, pengguna tidak dapat mengubahnya di Brave. Jika tidak disetel, pengguna dapat mengubahnya.\n\nMenyetel kebijakan ini ke RestoreOnStartupIsLastSession atau RestoreOnStartupIsLastSessionAndURLs akan menonaktifkan beberapa setelan yang mengandalkan sesi atau yang melakukan tindakan saat keluar, seperti menghapus data penjelajahan saat keluar atau cookie khusus sesi.\n\nJika kebijakan ini disetel ke RestoreOnStartupIsLastSessionAndURLs, browser akan memulihkan sesi sebelumnya dan membuka jendela terpisah untuk menampilkan URL yang disetel dari RestoreOnStartupURLs. Perlu diperhatikan bahwa pengguna dapat memilih untuk membiarkan URL tersebut dibuka dan URL tersebut juga akan dipulihkan pada sesi mendatang.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
RestoreOnStartupURLs.pfm_title = "URL untuk membuka saat permulaan";
RestoreOnStartupURLs.pfm_description = "Jika RestoreOnStartup ditetapkan menjadi RestoreOnStartupIsURLs, maka daftar URL yang ditetapkan untuk RestoreOnStartupURLs akan menentukan URL yang akan dibuka.\n\nJika kebijakan ini tidak ditetapkan, halaman Tab Baru akan dibuka saat browser mulai dijalankan.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "Batasi Background Fetch API saat dipanggil dari Service Worker";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "Kebijakan ini mengontrol apakah permintaan pengambilan latar belakang dari Service Worker dibatasi. Jika fitur yang mendownload file di latar belakang terpengaruh, kebijakan ini mungkin relevan.\n\nJika kebijakan ini disetel ke Aktif, atau tidak disetel, pembatasan akan aktif, dan permintaan pengambilan latar belakang dari konteks Service Worker dapat diblokir.\n\nJika kebijakan ini disetel ke Nonaktif, pembatasan akan dilewati, sehingga semua Service Worker dapat membuat permintaan pengambilan data latar belakang.\n\nKebijakan perusahaan ini bersifat sementara, dan akan dihapus setelah M152.";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "Batasi Akun Google yang memenuhi syarat untuk menyimpan file PDF ke Google Drive dari Penampil PDF Brave";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "Berisi ekspresi reguler untuk menentukan Akun Google yang memenuhi syarat untuk menyimpan file PDF ke Google Drive dari Penampil PDF Brave.\n\nError akan ditampilkan jika pengguna mencoba mengupload file PDF ke Google Drive menggunakan akun yang tidak cocok dengan pola ini.\n\nJika kebijakan ini tidak disetel atau dibiarkan kosong, pengguna dapat menggunakan Akun Google mana pun untuk menyimpan file PDF ke Google Drive.";
RestrictSigninToPattern.pfm_title = "Batasi akun Google mana yang diizinkan untuk disetel sebagai akun utama browser di Brave";
RestrictSigninToPattern.pfm_description = "Berisi regular expression yang digunakan untuk menentukan akun Google mana yang dapat disetel sebagai akun utama browser di Brave (akun yang dipilih selama alur keikutsertaan Sinkronisasi).\n\nError yang sesuai ditampilkan jika pengguna mencoba untuk menyetel akun utama browser dengan nama pengguna yang tidak cocok dengan pola ini.\n\nJika kebijakan ini tidak disetel atau kosong, pengguna dapat menyetel akun Google apa pun sebagai akun utama browser di Brave.";
RestrictYouTubeCookiesDeletion.pfm_title = "Batasi penghapusan cookie YouTube";
RestrictYouTubeCookiesDeletion.pfm_description = "Mencegah penghapusan cookie YouTube secara manual.\n\nKebijakan ini dirancang untuk mencegah pengguna mengakses YouTube yang tidak sah setelah mereka menghapus cookie YouTube secara manual melalui halaman setelan situs.\n\nJika kebijakan ini disetel ke Aktif, cookie YouTube tidak dapat dihapus secara manual.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, cookie YouTube dapat dihapus secara normal.\n\nCatatan: Kebijakan ini hanya mencegah penghapusan manual dari UI setelan situs. Kebijakan ini tidak mencegah penghapusan otomatis oleh kebijakan ClearBrowsingDataOnExitList atau BrowsingDataLifetime. Selain itu, jika kebijakan AllowDeletingBrowserHistory disetel ke aktif, pengguna masih dapat menghapus semua cookie mereka melalui dialog Hapus Data Penjelajahan.";
SSLErrorOverrideAllowed.pfm_title = "Memungkinkan melanjutkan dari halaman peringatan SSL";
SSLErrorOverrideAllowed.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna dapat mengklik semua halaman peringatan yang ditampilkan Brave saat pengguna membuka situs yang menampilkan error SSL.\n\nJika kebijakan disetel ke Nonaktif, pengguna tidak dapat mengklik halaman peringatan apa pun.";
SSLErrorOverrideAllowedForOrigins.pfm_title = "Mengizinkan untuk melanjutkan dari halaman peringatan SSL di asal tertentu";
SSLErrorOverrideAllowedForOrigins.pfm_description = "Jika SSLErrorOverrideAllowed disetel ke Nonaktif, menyetel kebijakan akan memungkinkan Anda menetapkan daftar pola origin yang menentukan situs tempat pengguna dapat mengklik semua halaman peringatan yang ditampilkan Brave saat pengguna membuka situs yang menampilkan error SSL. Pengguna tidak akan dapat mengklik halaman peringatan SSL di origin yang tidak ada di daftar ini.\n\nJika SSLErrorOverrideAllowed disetel ke Aktif atau tidak disetel, kebijakan ini tidak akan berpengaruh.\n\nJika kebijakan tidak disetel, SSLErrorOverrideAllowed akan berlaku untuk semua situs.\n\nUntuk mengetahui informasi selengkapnya tentang pola input yang valid, lihat https://chromeenterprise.google/policies/url-patterns/. * bukanlah nilai yang diterima untuk kebijakan ini. Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.";
SafeBrowsingAllowlistDomains.pfm_title = "Mengonfigurasi daftar domain tempat Safe Browsing tidak akan memicu peringatan.";
SafeBrowsingAllowlistDomains.pfm_description = "Jika kebijakan disetel ke Aktif, Safe Browsing akan memercayai domain yang Anda tentukan. Domain tidak akan diperiksa jika ada resource berbahaya misalnya phishing, malware, atau software yang tidak diinginkan. Layanan perlindungan download Safe Browsing tidak akan memeriksa download yang dihosting di domain ini. Layanan perlindungan sandi Safe Browsing tidak akan memeriksa penggunaan ulang sandi.\n\nJika kebijakan tidak disetel, perlindungan Safe Browsing default akan berlaku untuk semua resource.\n\nKebijakan ini tidak mendukung ekspresi reguler; tetapi, subdomain dari domain tertentu dimasukkan ke daftar yang diizinkan. Nama domain yang sepenuhnya memenuhi syarat (FQDN) tidak diperlukan.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia di instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia di instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.";
SafeBrowsingDeepScanningEnabled.pfm_title = "Mengizinkan pemindaian mendalam download untuk pengguna yang mengaktifkan Safe Browsing";
SafeBrowsingDeepScanningEnabled.pfm_description = "Jika kebijakan ini disetel ke aktif atau tidak disetel, Brave dapat mengirim download yang mencurigakan dari pengguna yang mengaktifkan Safe Browsing ke Google untuk memindai malware, atau meminta pengguna memberikan sandi untuk arsip terenkripsi.\nJika kebijakan ini disetel ke nonaktif, pemindaian ini tidak akan dilakukan.\nKebijakan ini tidak memengaruhi analisis konten download yang dikonfigurasi oleh Chrome Enterprise Connectors.";
SafeBrowsingProtectionLevel.pfm_title = "Tingkat Perlindungan Safe Browsing";
SafeBrowsingProtectionLevel.pfm_description = "0 - Safe Browsing selalu tidak aktif.\n1 - Safe Browsing aktif dalam mode standar.\n2 - Safe Browsing aktif dalam mode yang disempurnakan. Mode ini memberikan keamanan yang lebih baik, tetapi perlu membagikan lebih banyak informasi penjelajahan kepada Google.\nMemungkinkan Anda mengontrol apakah fitur Safe Browsing Brave diaktifkan dan dalam mode apa fitur tersebut beroperasi.\n\nJika kebijakan ini disetel ke 'NoProtection' (nilai 0), Safe Browsing selalu tidak aktif.\n\nJika kebijakan ini disetel ke 'StandardProtection' (nilai 1, yang merupakan default), Safe Browsing selalu aktif dalam mode standar.\n\nJika kebijakan ini disetel ke 'EnhancedProtection' (nilai 2), Safe Browsing selalu aktif dalam mode yang ditingkatkan, yang memberikan keamanan lebih baik, tetapi perlu membagikan lebih banyak informasi penjelajahan kepada Google.\n\nJika Anda menyetel kebijakan ini sebagai sesuatu yang wajib, pengguna tidak dapat mengubah atau mengganti setelan Safe Browsing di Brave.\n\nJika kebijakan ini tidak disetel, Safe Browsing akan beroperasi dalam mode Perlindungan Standar tetapi pengguna dapat mengubah setelan ini.\n\nLihat https://support.google.com/chrome?p=safe_browsing_preferences untuk info selengkapnya tentang Safe Browsing.";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "Mengizinkan Pemeriksaan Real-Time lewat Proxy Safe Browsing";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "Kebijakan ini mengontrol apakah mode perlindungan standar Safe Browsing diizinkan\nuntuk mengirim hash sebagian dari URL ke Google melalui proxy via Oblivious HTTP\nuntuk menentukan apakah URL aman untuk dibuka atau tidak.\n\nProxy memungkinkan browser mengupload hash sebagian dari URL ke Google\ntanpa dikaitkan ke alamat IP pengguna. Kebijakan ini juga memungkinkan\nbrowser mengupload hash sebagian dari URL dengan frekuensi yang lebih tinggi untuk\nkualitas perlindungan Safe Browsing yang lebih baik.\n\nKebijakan ini akan diabaikan jika Safe Browsing dinonaktifkan atau disetel ke mode\nperlindungan yang ditingkatkan.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, pemeriksaan\nlewat proxy dengan perlindungan yang lebih tinggi akan diizinkan.\n\nJika kebijakan ini disetel ke Nonaktif, pemeriksaan lewat proxy dengan perlindungan yang lebih tinggi\ntidak akan diizinkan. Hash sebagian dari URL akan diupload ke Google secara langsung dengan frekuensi\nyang jauh lebih rendah, yang akan menurunkan perlindungan.";
SafeBrowsingSurveysEnabled.pfm_title = "Mengizinkan Survei Safe Browsing";
SafeBrowsingSurveysEnabled.pfm_description = "Jika kebijakan ini disetel ke aktif atau tidak disetel, pengguna mungkin akan menerima survei yang terkait dengan Safe Browsing.\nJika kebijakan ini disetel ke nonaktif, pengguna tidak akan menerima survei yang terkait dengan Safe Browsing.";
SafeSitesFilterBehavior.pfm_title = "Mengontrol pemfilteran konten khusus dewasa SafeSites.";
SafeSitesFilterBehavior.pfm_description = "0 - Jangan filter konten khusus dewasa dari situs\n1 - Filter konten khusus dewasa dari situs\nMenyetel kebijakan akan mengontrol filter URL SafeSites, yang menggunakan Google Safe Search API untuk mengklasifikasikan URL bersifat pornografi atau bukan.\n\nSaat kebijakan ini disetel ke:\n\n* Jangan filter konten khusus dewasa dari situs, atau tidak disetel, situs tidak akan difilter\n\n* Filter konten khusus dewasa dari situs, situs pornografi akan difilter\n\nKebijakan ini berlaku untuk URL yang dibuka pengguna dan untuk iframe. Kebijakan URLAllowlist lebih diprioritaskan daripada kebijakan ini dan dapat digunakan untuk mengganti verdict dari Google Safe Search API.";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "Mengizinkan tangkapan Tab Asal yang Sama berdasarkan asal berikut";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang dapat menangkap gambar tab dengan Origin yang sama.\n\nJika kebijakan tidak disetel, situs tidak akan dianggap sebagai penggantian pada tingkat tangkapan ini.\n\nPerlu diperhatikan bahwa Aplikasi Chrome yang memiliki jendela dengan origin yang sama dengan situs ini akan tetap diizinkan untuk ditangkap gambarnya.\n\nJika situs cocok dengan pola URL di kebijakan ini, kebijakan berikut akan diabaikan: TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns/.  Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.";
SandboxExternalProtocolBlocked.pfm_title = "Mengizinkan Chrome memblokir navigasi ke protokol eksternal di iframe sandbox";
SandboxExternalProtocolBlocked.pfm_description = "Chrome akan memblokir navigasi ke protokol eksternal di dalam\niframe sandbox. Lihat https://chromestatus.com/features/5680742077038592.\n\nJika kebijakan disetel ke Benar (True), Chrome akan diizinkan memblokir navigasi tersebut.\n\nJika kebijakan disetel ke Salah (False), Chrome tidak akan diizinkan memblokir navigasi tersebut.\n\nSetelan default untuk kebijakan ini adalah Benar (True): fitur keamanan akan diaktifkan.\n\nKebijakan ini dapat digunakan oleh administrator yang memerlukan waktu tambahan untuk memperbarui situs internalnya yang terpengaruh oleh pembatasan baru ini. Kebijakan Perusahaan ini bersifat sementara dan akan dihapus setelah Brave versi 117.\n";
SavingBrowserHistoryDisabled.pfm_title = "Menonaktifkan penyimpanan histori browser";
SavingBrowserHistoryDisabled.pfm_description = "Jika kebijakan disetel ke Aktif, histori penjelajahan tidak akan disimpan, sinkronisasi tab akan dinonaktifkan, dan pengguna tidak dapat mengubah setelan ini.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, histori penjelajahan akan disimpan.";
ScreenCaptureAllowed.pfm_title = "Mengizinkan atau menolak tangkapan layar";
ScreenCaptureAllowed.pfm_description = "Jika diaktifkan atau tidak dikonfigurasi (default), suatu Halaman web dapat menggunakan\nAPI berbagi layar (misalnya, getDisplayMedia() atau API ekstensi Desktop Capture)\nuntuk meminta pengguna memilih tab, jendela, atau desktop yang akan direkam.\n\nJika kebijakan ini dinonaktifkan, setiap panggilan ke API berbagi layar akan gagal\ndengan error; namun kebijakan ini akan diabaikan (dan situs akan\ndiizinkan menggunakan API berbagi layar) jika situs cocok dengan pola asal di\nsalah satu kebijakan berikut:\nScreenCaptureAllowedByOrigins,\nWindowCaptureAllowedByOrigins,\nTabCaptureAllowedByOrigins,\nSameOriginTabCaptureAllowedByOrigins.\n";
ScreenCaptureAllowedByOrigins.pfm_title = "Mengizinkan tangkapan Desktop, Jendela, dan Tab berdasarkan asal berikut";
ScreenCaptureAllowedByOrigins.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang dapat menggunakan Tangkapan Desktop, Jendela, dan Tab.\n\nJika kebijakan ini tidak disetel, situs tidak akan dianggap sebagai penggantian pada tingkat Tangkapan ini.\n\nKebijakan ini akan diabaikan jika situs cocok dengan pola URL di salah satu kebijakan berikut: WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nJika situs cocok dengan pola URL di kebijakan ini, ScreenCaptureAllowed akan diabaikan.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns/.  Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "Mengizinkan screenshot tanpa gestur pengguna sebelumnya";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "Untuk alasan keamanan, getDisplayMedia() web API memerlukan\ngestur pengguna sebelumnya (\"aktivasi sementara\") untuk dipanggil. Jika tidak ada gestur pengguna sebelumnya,\npanggilan API ini akan gagal.\n\nJika kebijakan ini disetel, admin akan dapat menentukan origin tempat API ini dapat\ndipanggil tanpa gestur pengguna sebelumnya.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL yang valid, lihat\nhttps://chromeenterprise.google/policies/url-patterns/. * bukanlah\nnilai yang diterima untuk kebijakan ini.\n\nJika kebijakan ini tidak disetel, semua origin akan memerlukan gestur pengguna sebelumnya untuk memanggil\nAPI ini.";
ScrollToTextFragmentEnabled.pfm_title = "Mengaktifkan scroll ke teks yang ditentukan di fragmen URL";
ScrollToTextFragmentEnabled.pfm_description = "Fitur ini akan mengizinkan hyperlink dan navigasi URL kolom URL untuk menargetkan teks tertentu di halaman web. Halaman web akan di-scroll ke teks tersebut setelah selesai dimuat.\n\nJika Anda mengaktifkan atau tidak mengonfigurasi kebijakan ini, scroll halaman web ke fragmen teks tertentu melalui URL akan diaktifkan.\n\nJika Anda menonaktifkan kebijakan ini, scroll halaman web ke fragmen teks tertentu melalui URL akan dinonaktifkan.";
SearchContentSharingSettings.pfm_title = "Aktifkan berbagi konten dengan integrasi Google AI Mode dan Lens";
SearchContentSharingSettings.pfm_description = "0 - Izinkan berbagi konten dengan integrasi Google AI Mode.\n1 - Jangan izinkan berbagi konten dengan integrasi Google AI Mode.\nKebijakan ini mengontrol berbagi konten halaman dan file dengan Google AI Mode dan Lens melalui panel samping atau tab Google Chrome.\n\nPerhatikan bahwa kebijakan ini tidak memengaruhi Google AI Mode di web. Kebijakan ini hanya mengontrol cara pengguna dapat berbagi informasi dengannya saat menggunakan Google Chrome.\n\nNilai 0 = pengguna dapat membagikan konten halaman atau file ke Google AI Mode.\n\nNilai 1 = pengguna tidak dapat membagikan konten halaman atau file ke Google AI Mode. Titik entri untuk berbagi konteks dan panel samping akan dinonaktifkan atau disembunyikan.\n\nKebijakan ini akan diabaikan jika Google Search bukan mesin telusur default pengguna karena fitur ini dinonaktifkan.\n\nKebijakan ini terpisah dari kebijakan AIModeSettings. Kebijakan AIModeSettings hanya mengontrol titik entri di kotak penelusuran omnibox atau NTP, sedangkan kebijakan ini mengontrol berbagi konteks melalui panel samping atau tab.\n\nKebijakan ini juga tidak mengontrol integrasi Google Gemini yang dapat dinonaktifkan oleh GeminiSettings.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
SearchSuggestEnabled.pfm_title = "Aktifkan saran penelusuran";
SearchSuggestEnabled.pfm_description = "Jika kebijakan disetel ke Benar (True), saran penelusuran akan diaktifkan di kolom URL Brave. Jika kebijakan disetel ke Salah (False), saran penelusuran akan dinonaktifkan.\n\nSaran yang didasarkan pada bookmark atau histori tidak akan terpengaruh oleh kebijakan ini.\n\nJika kebijakan disetel, pengguna tidak dapat mengubahnya. Jika kebijakan tidak disetel, saran penelusuran mula-mula akan diaktifkan, tetapi pengguna dapat menonaktifkannya kapan saja.";
SecurityKeyPermitAttestation.pfm_title = "URL/domain otomatis mengizinkan pengesahan langsung Kunci Keamanan";
SecurityKeyPermitAttestation.pfm_description = "Menyetel kebijakan akan menentukan ID WebAuthn RP yang tidak akan muncul saat sertifikat pengesahan dari kunci keamanan diminta. Sinyal juga dikirimkan ke kunci keamanan yang menunjukkan bahwa pengesahan perusahaan dapat digunakan. Jika tidak disetel, pengguna akan dimintai pengesahan kunci keamanan di Brave versi 65 dan yang lebih baru saat situs memintanya.";
SensorsAllowedForUrls.pfm_title = "Mengizinkan akses ke sensor di situs ini";
SensorsAllowedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang dapat mengakses sensor seperti sensor gerakan dan cahaya.\n\nJika kebijakan ini tidak disetel, DefaultSensorsSetting akan berlaku untuk semua situs, jika disetel. Jika kebijakan tersebut tidak disetel, setelan pribadi pengguna akan digunakan.\n\nJika pola URL yang sama ada di kebijakan ini dan kebijakan SensorsBlockedForUrls, kebijakan yang kedua akan diprioritaskan dan akses ke sensor gerakan dan cahaya akan diblokir.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
SensorsBlockedForUrls.pfm_title = "Memblokir akses ke sensor di situs ini";
SensorsBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs yang tidak dapat mengakses sensor seperti sensor gerakan dan cahaya.\n\nJika kebijakan ini tidak disetel, DefaultSensorsSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nJika pola URL yang sama ada di kebijakan ini dan kebijakan SensorsAllowedForUrls, kebijakan ini akan diprioritaskan dan akses ke sensor gerakan dan cahaya akan diblokir.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan.";
SerialAllowAllPortsForUrls.pfm_title = "Otomatis memberikan izin ke situs untuk menghubungkan semua port serial.";
SerialAllowAllPortsForUrls.pfm_description = "Menyetel kebijakan memungkinkan Anda menetapkan daftar situs yang otomatis diizinkan untuk mengakses semua port serial yang tersedia.\n\nURL harus valid. Jika tidak, kebijakan akan diabaikan. Hanya asal (skema, host, dan port) URL yang dipertimbangkan.\n\nDi Google Chrome OS, kebijakan ini hanya berlaku untuk pengguna terafiliasi.\n\nKebijakan ini menggantikan DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls, dan preferensi pengguna.";
SerialAllowUsbDevicesForUrls.pfm_title = "Otomatis memberikan izin ke situs untuk terhubung ke perangkat serial USB.";
SerialAllowUsbDevicesForUrls.pfm_description = "Menyetel kebijakan ini memungkinkan Anda menetapkan daftar situs yang otomatis diizinkan untuk mengakses perangkat serial USB dengan ID vendor dan produk yang cocok dengan kolom vendor_id dan product_id. Jika kolom product_id tidak ada, situs tertentu akan diizinkan untuk mengakses perangkat dengan ID vendor yang cocok dengan kolom vendor_id dan ID produk apa pun.\n\nURL harus valid. Jika tidak, kebijakan akan diabaikan. Hanya asal (skema, host, dan port) URL yang dipertimbangkan.\n\nDi ChromeOS, kebijakan ini hanya berlaku untuk pengguna terafiliasi.\n\nKebijakan ini menggantikan DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls, dan preferensi pengguna.\n\nKebijakan ini hanya memengaruhi akses ke perangkat USB melalui Web Serial API. Untuk memberikan akses ke perangkat USB melalui WebUSB API, lihat kebijakan WebUsbAllowDevicesForUrls.\nBuka https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls untuk informasi lebih lanjut terkait skema dan pemformatan.";
SerialAskForUrls.pfm_title = "Mengizinkan Serial API di situs ini";
SerialAskForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang dapat meminta izin kepada pengguna untuk mengakses port serial.\n\nJika kebijakan ini tidak disetel, DefaultSerialGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk pola URL yang tidak cocok dengan kebijakan, maka SerialBlockedForUrls (jika ada kecocokan), DefaultSerialGuardSetting (jika disetel), atau setelan pribadi pengguna akan diprioritaskan dalam urutan tersebut.\n\nJika pola URL bertentangan dengan SerialBlockedForUrls, pola tersebut akan diabaikan.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
SerialBlockedForUrls.pfm_title = "Memblokir Serial API di situs ini";
SerialBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang tidak dapat meminta izin kepada pengguna untuk mengakses port serial.\n\nJika kebijakan ini tidak disetel, DefaultSerialGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk pola URL yang tidak cocok dengan kebijakan, maka SerialAskForUrls (jika ada kecocokan), DefaultSerialGuardSetting (jika disetel), atau setelan pribadi pengguna akan diprioritaskan dalam urutan tersebut.\n\nJika pola URL bertentangan dengan SerialAskForUrls, kebijakan ini akan diprioritaskan.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
ServiceWorkerAutoPreloadEnabled.pfm_title = "Mengizinkan ServiceWorker mengirim permintaan navigasi tanpa menunggu ServiceWorker dimulai";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nFitur ServiceWorkerAutoPreload mengirimkan permintaan jaringan untuk resource utama pada saat yang sama ketika proses bootstrap ServiceWorker dimulai.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel,\nBrave akan mengaktifkan ServiceWorkerAutoPreload. Permintaan navigasi secara otomatis dikirim saat ServiceWorker dimulai dalam beberapa skenario, misalnya ketika ServiceWorker tidak sedang berjalan,\n\nJika dinonaktifkan, Brave tidak akan mengaktifkan ServiceWorkerAutoPreload. Permintaan navigasi selalu dikirim setelah ServiceWorker dimulai.\n\nKebijakan ini merupakan tindakan sementara untuk mengontrol fitur dan akan dihapus di M154.";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "Mengizinkan ServiceWorker mengontrol iframe srcdoc";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "https://github.com/w3c/ServiceWorker/issues/765 meminta iframe srcdoc dengan\natribut sandbox \"allow-same-origin\" untuk berada di bawah kendali ServiceWorker.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel,\nBrave akan membuat iframe srcdoc\ndengan atribut sandbox \"allow-same-origin\" berada di bawah kendali ServiceWorker.\n\nJika kebijakan ini disetel ke Nonaktif, iframe srcdoc tidak akan dikontrol oleh\nServiceWorker.\n\nKebijakan ini bersifat sementara dan akan dihapus pada tahun 2026.";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "Menentukan apakah SharedArrayBuffer dapat digunakan dalam konteks yang tidak diisolasi lintas asal";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\nMenentukan apakah SharedArrayBuffer dapat digunakan dalam konteks yang tidak diisolasi lintas asal. Brave akan memerlukan isolasi lintas asal saat menggunakan SharedArrayBuffer mulai dari Brave 91 dan selanjutnya (25-05-2021) untuk alasan Kompatibilitas Web. Detail tambahan dapat ditemukan di: https://developer.chrome.com/blog/enabling-shared-array-buffer/.\n\nJika disetel ke Aktif, situs dapat menggunakan SharedArrayBuffer tanpa batasan.\n\nJika disetel ke Nonaktif atau tidak disetel, situs hanya dapat menggunakan SharedArrayBuffer saat diisolasi lintas asal.";
SharedWorkerBlobURLFixEnabled.pfm_title = "Membuat perilaku URL blob SharedWorker sesuai dengan spesifikasi";
SharedWorkerBlobURLFixEnabled.pfm_description = "Menurut deskripsi di https://w3c.github.io/ServiceWorker/#control-and-use-worker-client,\nworker harus mewarisi pengontrol untuk URL blob.  Namun, kode yang ada\nhanya mengizinkan DedicatedWorker mewarisi pengontrol, dan SharedWorker tidak\nmewarisi pengontrol.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel,\nBrave akan mewarisi pengontrol\njika URL blob digunakan sebagai URL SharedWorker.\n\nJika kebijakan ini disetel ke Nonaktif, perilaku URL blob SharedWorker menjadi tidak sesuai dengan\nspesifikasi yang ada.\n\nKebijakan ini bersifat sementara dan akan dihapus pada masa mendatang.";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "Memungkinkan masa aktif yang diperpanjang untuk SharedWorker";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "SharedWorker dapat memiliki masa aktif yang diperpanjang jika opsi \"extendedLifetime\" disetel ke benar (true) di konstruktor SharedWorker.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, SharedWorker dapat memiliki masa aktif yang diperpanjang.\n\nJika kebijakan ini disetel ke Nonaktif, SharedWorker tidak dapat memiliki masa aktif yang diperpanjang, meskipun opsi ini disetel ke benar (true).\n\nKebijakan ini bersifat sementara dan akan dihapus pada masa mendatang.";
ShoppingListEnabled.pfm_title = "Mengizinkan fitur daftar belanja diaktifkan";
ShoppingListEnabled.pfm_description = "Kebijakan ini mengontrol ketersediaan fitur daftar belanja.\nJika diaktifkan, pengguna akan melihat UI untuk memantau harga produk yang ditampilkan di halaman saat ini. Produk yang dipantau akan ditampilkan di panel samping bookmark.\nJika kebijakan ini disetel ke Aktif atau tidak disetel, fitur daftar belanja akan tersedia bagi pengguna.\nJika kebijakan ini disetel ke Nonaktif, fitur daftar belanja tidak akan tersedia.\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "Tampilkan pintasan aplikasi di bilah bookmark";
ShowAppsShortcutInBookmarkBar.pfm_description = "Jika kebijakan ditetapkan ke Benar (True), pintasan aplikasi akan ditampilkan. Jika kebijakan ditetapkan ke Salah (False), pintasan tidak akan pernah muncul.\n\nJika Anda menetapkan kebijakan, pengguna tidak dapat mengubahnya. Jika tidak ditetapkan, pengguna perlu menentukan untuk menampilkan atau menyembunyikan pintasan aplikasi dari menu konteks kolom bookmark.";
ShowCastIconInToolbar.pfm_title = "Tampilkan ikon toolbar Google Cast";
ShowCastIconInToolbar.pfm_description = "Jika kebijakan disetel ke Aktif, ikon toolbar Cast akan ditampilkan di toolbar atau menu tambahan, dan pengguna tidak dapat menghapusnya.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, pengguna akan dapat menyematkan atau menghapus ikon melalui menu kontekstualnya.\n\nJika kebijakan EnableMediaRouter disetel ke Nonaktif, nilai kebijakan ini tidak akan berpengaruh dan ikon toolbar tidak akan ditampilkan.";
ShowCastSessionsStartedByOtherDevices.pfm_title = "Menampilkan kontrol media untuk sesi Google Cast yang dimulai oleh perangkat lain di jaringan lokal";
ShowCastSessionsStartedByOtherDevices.pfm_description = "Jika kebijakan ini disetel ke aktif, UI kontrol pemutaran media akan tersedia untuk sesi Google Cast yang dimulai oleh perangkat lain di jaringan lokal.\n\nJika kebijakan ini disetel ke nonaktif, atau tidak disetel untuk pengguna versi bisnis, UI kontrol pemutaran media tidak akan tersedia untuk sesi Google Cast yang dimulai oleh perangkat lain di jaringan lokal.\n\nJika kebijakan EnableMediaRouter disetel ke nonaktif, nilai kebijakan ini tidak akan berpengaruh karena seluruh fungsi Google Cast dinonaktifkan.";
ShowFullUrlsInAddressBar.pfm_title = "Menampilkan URL Lengkap";
ShowFullUrlsInAddressBar.pfm_description = "Fitur ini memungkinkan tampilan URL lengkap di kolom URL.\nJika kebijakan ini disetel ke Benar (True), URL lengkap akan ditampilkan di kolom URL, termasuk skema dan subdomain.\nJika kebijakan ini disetel ke Salah (False), tampilan URL default akan diterapkan.\nJika kebijakan ini tidak disetel, tampilan URL default akan diterapkan dan pengguna akan dapat beralih antara tampilan URL lengkap dan default dengan opsi menu konteks.\n";
ShowHomeButton.pfm_title = "Tampilkan tombol Layar Utama di toolbar";
ShowHomeButton.pfm_description = "Jika kebijakan disetel ke Aktif, tombol Beranda akan ditampilkan di toolbar Brave. Jika kebijakan disetel ke Nonaktif, tombol Beranda tidak akan muncul.\n\nJika Anda menyetel kebijakan, pengguna tidak dapat mengubahnya di Brave. Jika tidak disetel, pengguna dapat memilih untuk menampilkan tombol Beranda atau tidak.";
SideSearchEnabled.pfm_title = "Mengizinkan halaman hasil penelusuran mesin telusur default terbaru ditampilkan di panel samping Browser";
SideSearchEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna akan dapat menampilkan halaman hasil penelusuran mesin telusur default terbaru di panel samping dengan mengalihkan ikon di toolbar.\n\nJika kebijakan disetel ke Nonaktif, ikon dari toolbar yang membuka panel samping yang berisi halaman hasil penelusuran mesin telusur default akan dihapus.";
SignedHTTPExchangeEnabled.pfm_title = "Aktifkan dukungan Signed HTTP Exchange (SXG)";
SignedHTTPExchangeEnabled.pfm_description = "Jika kebijakan disetel ke True (Benar) atau tidak disetel, Brave akan menerima konten web yang ditayangkan sebagai Signed HTTP Exchange.\n\nJika kebijakan disetel ke Salah (False), Signed HTTP Exchange tidak akan dimuat.";
SigninInterceptionEnabled.pfm_title = "Aktifkan intersepsi login";
SigninInterceptionEnabled.pfm_description = "Setelan ini mengaktifkan atau menonaktifkan intersepsi login.\n\nJika kebijakan ini diaktifkan atau tidak disetel, dialog intersepsi login akan dipicu saat akun Google ditambahkan di web, dan pengguna mungkin sebaiknya memindahkan akun ini ke profil lain (profil baru atau yang sudah ada).\n\nJika kebijakan ini dinonaktifkan, dialog intersepsi login tidak akan dipicu.\nJika kebijakan dinonaktifkan, dialog akan tetap ditampilkan jika pemisahan profil akun terkelola diterapkan oleh ManagedAccountsSigninRestriction.";
SilentPrintingEnabled.pfm_title = "Aktifkan Pencetakan Senyap";
SilentPrintingEnabled.pfm_description = "Mengatur kebijakan ini ke benar (true) akan mengaktifkan pencetakan senyap, yang akan langsung menutup\njendela pratinjau cetak saat dibuka dan mencetak ke printer default dengan\nopsi default. Jika printer default adalah 'Simpan sebagai PDF', file akan\ndisimpan ke folder Download.\n\nJika kebijakan ini tidak disetel atau disetel ke salah (false), pencetakan\nsenyap akan dinonaktifkan, yang tidak otomatis menutup jendela pratinjau cetak dan mengharuskan\npengguna untuk membuat pilihan seperti biasa.";
SitePerProcess.pfm_title = "Memerlukan Isolasi Situs untuk setiap situs";
SitePerProcess.pfm_description = "Sejak Brave 67, isolasi situs telah diaktifkan secara default di semua platform Desktop, yang menyebabkan setiap situs berjalan dalam prosesnya sendiri. Situs adalah skema plus eTLD+1 (misalnya, https://example.com). Menyetel kebijakan ke Aktif tidak mengubah perilaku tersebut; hanya mencegah pengguna menonaktifkannya (misalnya, menggunakan Nonaktifkan isolasi situs di chrome://flags). Sejak Brave 76, menyetel kebijakan ini ke Nonaktif atau membiarkannya tanpa disetel tidak akan menonaktifkan isolasi situs, tetapi memungkinkan pengguna untuk menonaktifkannya.\n\nIsolateOrigins mungkin juga berguna untuk mengisolasi asal tertentu pada tingkat perincian yang lebih baik daripada situs (misalnya, https://a.example.com).\n\nDi Google Chrome OS versi 76 dan yang lebih lama, setel kebijakan perangkat DeviceLoginScreenSitePerProcess ke nilai yang sama. (Jika nilai tidak cocok, penundaan dapat terjadi saat memasuki sesi pengguna.)\n\nCatatan: Untuk Android, gunakan kebijakan SitePerProcessAndroid.";
SiteSearchSettings.pfm_title = "Setelan penelusuran situs";
SiteSearchSettings.pfm_description = "Kebijakan ini menyediakan daftar situs yang dapat ditelusuri dengan cepat oleh pengguna menggunakan pintasan di kolom URL. Pengguna dapat memulai penelusuran dengan mengetik pintasan atau @pintasan (mis. @kerja), diikuti dengan Spasi atau Tab, di kolom URL.\n\nKolom berikut wajib diisi untuk setiap situs: name, shortcut, url.\n\nKolom name sesuai dengan nama situs atau mesin telusur yang akan ditampilkan kepada pengguna di kolom URL.\n\nshortcut dapat berisi kata dan karakter biasa, tetapi tidak boleh menyertakan spasi atau diawali dengan simbol @. Pintasan juga harus unik.\n\nUntuk setiap entri, kolom url menentukan URL mesin telusur yang digunakan saat melakukan penelusuran dengan kata kunci yang sesuai. URL harus menyertakan string '{searchTerms}', yang akan diganti dengan istilah penelusuran pengguna di kueri. Entri yang tidak valid dan entri dengan pintasan duplikat akan diabaikan.\n\nEntri penelusuran situs yang dikonfigurasi sebagai unggulan ditampilkan di kolom URL saat pengguna mengetik \"@\". Anda dapat memilih maksimal tiga entri sebagai unggulan.\n\nUntuk entri penelusuran situs dengan nilai allow_user_override adalah benar (true), pengguna dapat mengedit atau menonaktifkan entri tersebut. Namun, mesin telusur unggulan (yang diawali \"@\") hanya dapat dinonaktifkan. Jika pengguna mengubah entri yang awalnya dibuat oleh kebijakan ini, entri tersebut tidak akan lagi dikelola oleh kebijakan dan akan dianggap sebagai pintasan buatan pengguna. Jika allow_user_override bernilai salah (false) atau belum ditentukan untuk suatu entri penelusuran situs, pengguna tidak dapat mengedit atau menonaktifkan entri tersebut. Setelan untuk mengizinkan penggantian oleh pengguna hanya didukung di M139 dan yang lebih baru. Versi sebelumnya akan menonaktifkan penggantian oleh pengguna secara default.\n\nPengguna tidak dapat membuat entri penelusuran situs baru dengan pintasan yang sebelumnya dibuat melalui kebijakan ini, kecuali jika allow_user_override disetel ke benar (true) untuk entri penelusuran situs tersebut.\n\nJika terjadi konflik dengan pintasan yang sebelumnya dibuat oleh pengguna, setelan pengguna akan lebih diprioritaskan. Namun, pengguna tetap dapat memicu opsi yang dibuat oleh kebijakan tersebut dengan mengetik \"@\" di kotak penelusuran. Misalnya, jika pengguna telah menetapkan \"kerja\" sebagai pintasan ke URL1 dan kebijakan menetapkan \"kerja\" sebagai pintasan ke URL2, mengetik \"kerja\" di kotak penelusuran akan memicu penelusuran ke URL1, tetapi mengetik \"@kerja\" di kotak penelusuran akan memicu penelusuran ke URL2.\n\nDi Microsoft® Windows®, kebijakan ini hanya tersedia pada instance yang dihubungkan ke domain Microsoft® Active Directory®, dihubungkan ke Microsoft® Azure® Active Directory®, atau didaftarkan di Chrome Enterprise Core.\n\nDi macOS, kebijakan ini hanya tersedia pada instance yang dikelola melalui MDM, dihubungkan ke domain melalui MCX, atau didaftarkan di Chrome Enterprise Core.\nBuka https://chromeenterprise.google/policies/?policy=SiteSearchSettings untuk informasi lebih lanjut terkait skema dan pemformatan.";
SmartTabSharingSettings.pfm_title = "Setelan berbagi tab cerdas";
SmartTabSharingSettings.pfm_description = "0 - Izinkan berbagi tab cerdas dengan integrasi Google AI Mode.\n1 - Jangan izinkan berbagi tab cerdas dengan integrasi Google AI Mode.\nKebijakan ini mengontrol fitur berbagi tab cerdas Google AI Mode melalui panel samping atau tab Google Chrome.\n\nPerhatikan bahwa kebijakan ini tidak memengaruhi Google AI Mode di web. Kebijakan ini hanya mengontrol cara pengguna dapat berbagi informasi dengannya saat menggunakan Google Chrome.\n\n0 = pengguna dapat membagikan konten halaman atau file ke Google AI Mode.\n\n1 = pengguna tidak dapat membagikan konten halaman atau file ke Google AI Mode. Titik entri untuk berbagi konteks dan panel samping akan dinonaktifkan atau disembunyikan.\n\nKebijakan ini akan diabaikan jika Google Search bukan mesin telusur default pengguna karena fitur ini dinonaktifkan.\n\nKebijakan ini terpisah dari kebijakan AIModeSettings. Kebijakan AIModeSettings hanya mengontrol titik entri di kotak penelusuran omnibox atau NTP, sementara kebijakan ini mengontrol berbagi konteks melalui panel samping atau tab.\n\nKebijakan ini juga tidak mengontrol integrasi Google Gemini yang dapat dinonaktifkan oleh GeminiSettings.\n\nPerhatikan bahwa jika SearchContentSharingSettings dinonaktifkan, kebijakan ini akan diabaikan.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
SpellCheckServiceEnabled.pfm_title = "Mengaktifkan atau menonaktifkan layanan web memeriksa ejaan";
SpellCheckServiceEnabled.pfm_description = "Jika kebijakan disetel ke Aktif, layanan web Google akan digunakan untuk memperbaiki kesalahan eja. Kebijakan ini hanya mengontrol penggunaan layanan online. Jika kebijakan disetel ke Nonaktif, layanan ini tidak akan pernah digunakan.\n\nJika kebijakan tidak disetel, pengguna dapat memilih apakah akan menggunakan layanan periksa ejaan.\n\nPeriksa ejaan dapat selalu menggunakan kamus yang didownload secara lokal, kecuali jika fitur ini dinonaktifkan oleh SpellcheckEnabled sehingga kebijakan ini tidak akan berpengaruh.";
SpellcheckEnabled.pfm_title = "Aktifkan fitur pemeriksa ejaan";
SpellcheckEnabled.pfm_description = "Jika kebijakan disetel ke Aktif, periksa ejaan akan diaktifkan dan pengguna tidak dapat menonaktifkannya. Di Microsoft® Windows®, Google Chrome OS, dan Linux®, bahasa periksa ejaan dapat diaktifkan atau dinonaktifkan satu per satu, sehingga pengguna tetap dapat menonaktifkan periksa ejaan dengan menonaktifkan setiap bahasa periksa ejaan. Untuk menghindari hal tersebut, gunakan SpellcheckLanguage untuk mengaktifkan paksa bahasa periksa ejaan tertentu.\n\nJika kebijakan disetel ke Nonaktif, periksa ejaan akan dinonaktifkan dari semua sumber, dan pengguna tidak dapat mengaktifkannya. Kebijakan SpellCheckServiceEnabled, SpellcheckLanguage, dan SpellcheckLanguageBlocklist tidak akan berpengaruh jika kebijakan ini disetel ke Salah (False).\n\nJika kebijakan tidak disetel, pengguna akan dapat mengaktifkan atau menonaktifkan periksa ejaan di setelan bahasa.";
StandardizedBrowserZoomEnabled.pfm_title = "Aktifkan Perilaku Zoom Browser Standar";
StandardizedBrowserZoomEnabled.pfm_description = "Kebijakan ini memungkinkan kesesuaian dengan spesifikasi zoom CSS yang baru diterapkan.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, \"zoom\" CSS akan mematuhi spesifikasi:\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\nJika Dinonaktifkan, properti \"zoom\" CSS akan kembali ke perilaku pra-standar lamanya.\n\nKebijakan ini adalah penangguhan sementara agar pengguna memiliki waktu untuk memigrasikan konten web ke perilaku baru. Ada juga uji coba origin (\"DisableStandardizedBrowserZoom\") yang sesuai dengan perilaku saat kebijakan ini disetel ke Nonaktif. Kebijakan ini akan dihapus dan perilaku yang \"Diaktifkan\" akan dibuat permanen pada pencapaian 134.";
StaticStorageQuotaEnabled.pfm_title = "Mengontrol apakah API kuota penyimpanan akan menampilkan nilai statis";
StaticStorageQuotaEnabled.pfm_description = "Jika kebijakan ini diaktifkan, API kuota penyimpanan akan menampilkan nilai statis yang sama dengan penggunaan + min(10 GiB, disk dibulatkan ke 1 GiB terdekat).\nJika kebijakan ini dinonaktifkan, API kuota penyimpanan umumnya akan menampilkan nilai dinamis yang proporsional dengan total ruang yang tersedia di perangkat, terlepas dari penggunaan.\nJika kebijakan ini tidak disetel, API kuota penyimpanan akan menggunakan perilaku Chrome default.\nSitus dengan izin penyimpanan tak terbatas tidak akan terpengaruh oleh setelan ini. Kuota yang diterapkan juga tidak akan terpengaruh.";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "Mengaktifkan pemeriksaan jenis MIME yang ketat untuk skrip pekerja";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "Kebijakan ini mengaktifkan pemeriksaan jenis MIME yang ketat untuk skrip pekerja.\n\nJika kebijakan disetel ke aktif atau tidak disetel, skrip pekerja akan menggunakan pemeriksaan jenis MIME yang ketat untuk JavaScript, yang merupakan perilaku default baru. Skrip pekerja dengan jenis MIME lama akan ditolak.\n\nJika kebijakan disetel ke nonaktif, skrip pekerja akan menggunakan pemeriksaan jenis MIME longgar, sehingga skrip pekerja dengan jenis MIME lama, misalnya text/ascii, akan terus dimuat dan dieksekusi.\n\nBrowser secara tradisional menggunakan pemeriksaan jenis MIME longgar, sehingga resource dengan sejumlah jenis MIME lama tetap didukung. Misalnya, untuk resource JavaScript, text/ascii adalah jenis MIME lama yang didukung. Hal ini dapat menyebabkan masalah keamanan, dengan mengizinkan pemuatan resource sebagai skrip yang tidak pernah dimaksudkan untuk digunakan. Chrome akan beralih menggunakan pemeriksaan jenis MIME yang ketat dalam waktu dekat. Kebijakan yang diaktifkan akan melacak perilaku default. Menonaktifkan kebijakan ini memungkinkan administrator mempertahankan perilaku lama, jika diinginkan.\n\nLihat https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage untuk detail tentang jenis media JavaScript/ECMAScript.\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "Menyembunyikan Dialog JavaScript yang dipicu dari subframe asal yang berbeda";
SuppressDifferentOriginSubframeDialogs.pfm_description = "Sebagaimana dijelaskan di https://www.chromestatus.com/feature/5148698084376576, dialog modal JavaScript, yang dipicu oleh window.alert, window.confirm, dan window.prompt, akan diblokir di Brave jika dipicu dari subframe yang memiliki origin berbeda dari origin frame utama.\n\nKebijakan ini memungkinkan penggantian perubahan tersebut.\nJika kebijakan disetel ke aktif atau tidak disetel, dialog JavaScript yang dipicu dari subframe origin yang berbeda akan diblokir.\nJika kebijakan disetel ke nonaktif, dialog JavaScript yang dipicu dari subframe origin yang berbeda tidak akan diblokir.\n\nKebijakan ini akan dihapus dari Brave pada masa mendatang.";
SuppressUnsupportedOSWarning.pfm_title = "Sembunyikan peringatan OS tidak didukung";
SuppressUnsupportedOSWarning.pfm_description = "Menyetel kebijakan ke Aktif akan menyembunyikan peringatan yang muncul saat Brave berjalan di komputer atau sistem operasi yang tidak didukung.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, peringatan akan muncul di sistem operasi yang tidak didukung.";
SyncDisabled.pfm_title = "Nonaktifkan sinkronisasi data dengan Google";
SyncDisabled.pfm_description = "Jika kebijakan disetel ke Aktif, sinkronisasi data akan dinonaktifkan di Brave menggunakan layanan sinkronisasi yang dihosting oleh Google.\nUntuk sepenuhnya menonaktifkan layanan Chrome Sync, sebaiknya nonaktifkan layanan di Google Admin console.\n\nJika kebijakan disetel ke Nonaktif atau tidak disetel, pengguna akan diizinkan memilih apakah akan menggunakan Chrome Sync.\n\nCatatan: Jangan aktifkan kebijakan ini jika RoamingProfileSupportEnabled disetel ke Aktif, karena fitur tersebut berbagi fungsi sisi klien yang sama. Dalam hal ini, sinkronisasi yang dihosting oleh Google akan nonaktif sepenuhnya.";
SyncTypesListDisabled.pfm_title = "Daftar jenis yang harus dikecualikan dari sinkronisasi";
SyncTypesListDisabled.pfm_description = "Jika kebijakan ini disetel, semua jenis data yang ditentukan akan dikecualikan dari sinkronisasi, baik untuk Chrome Sync maupun sinkronisasi profil roaming. Hal ini berguna untuk mengurangi ukuran profil roaming atau membatasi jenis data yang diupload ke Server Chrome Sync.\n\nJenis data saat ini untuk kebijakan ini adalah: \"apps\", \"autofill\", \"bookmarks\", \"extensions\", \"preferences\", \"passwords\", \"payments\", \"productComparison\", \"readingList\", \"tabs\", \"themes\", \"typedUrls\", \"wifiConfigurations\". Nama-nama tersebut peka huruf besar/kecil.\n\nCatatan: Pembaruan Kebijakan Dinamis hanya didukung di Brave versi 123 dan yang lebih baru. Menonaktifkan \"autofill\" juga akan menonaktifkan \"payments\". \"typedUrls\" merujuk pada semua histori penjelajahan.";
TLS13EarlyDataEnabled.pfm_title = "Mengaktifkan TLS 1.3 Early Data";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Early Data adalah ekstensi ke TLS 1.3 untuk mengirim permintaan HTTP secara bersamaan dengan TLS handshake.\n\nJika kebijakan ini tidak dikonfigurasi, Brave akan mengikuti proses peluncuran default untuk TLS 1.3 Early Data.\n\nJika kebijakan ini disetel ke aktif, Brave akan mengaktifkan TLS 1.3 Early Data.\n\nJika kebijakan ini disetel ke nonaktif, Brave tidak akan mengaktifkan TLS 1.3 Early Data.\n\nSaat fitur ini diaktifkan, Brave mungkin menggunakan atau tidak menggunakan TLS 1.3 Early Data bergantung pada dukungan server.\n\nTLS 1.3 Early Data adalah protokol yang sudah ada. Server TLS, middlebox, dan software keamanan yang ada diharapkan dapat menangani atau menolak TLS 1.3 Early Data tanpa memutuskan koneksi.\n\nNamun, perangkat yang tidak menerapkan TLS dengan tepat mungkin berhenti berfungsi dan berhenti terhubung saat TLS 1.3 Early Data digunakan. Jika hal ini terjadi, administrator harus menghubungi vendor untuk memperbaikinya.\n\nKebijakan ini adalah tindakan sementara untuk mengontrol fitur dan akan dihapus setelahnya. Kebijakan ini mungkin akan disetel ke aktif supaya Anda dapat melakukan pengujian untuk mendeteksi masalah, dan mungkin akan disetel ke nonaktif saat masalah sedang diselesaikan.";
TabCaptureAllowedByOrigins.pfm_title = "Mengizinkan tangkapan Tab berdasarkan asal berikut";
TabCaptureAllowedByOrigins.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang dapat menggunakan Tangkapan Tab.\n\nJika kebijakan ini tidak disetel, situs tidak akan dianggap sebagai penggantian pada tingkat tangkapan ini.\n\nPerlu diperhatikan bahwa Aplikasi Chrome yang memiliki jendela akan tetap diizinkan untuk ditangkap gambarnya.\n\nKebijakan ini akan diabaikan jika situs cocok dengan pola URL di kebijakan SameOriginTabCaptureAllowedByOrigins.\n\nJika situs cocok dengan pola URL di kebijakan ini, kebijakan berikut akan diabaikan: WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns/.  Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.";
TabCompareSettings.pfm_title = "Setelan Tab Compare";
TabCompareSettings.pfm_description = "0 - Izinkan Tab Perbandingan Produk dan tingkatkan kualitas model AI.\n1 - Izinkan Tab Perbandingan Produk tanpa meningkatkan kualitas model AI.\n2 - Jangan izinkan Tab Perbandingan Produk.\nTab Perbandingan Produk adalah alat berteknologi AI untuk membandingkan informasi di berbagai tab pengguna. Sebagai contoh, fitur ini dapat ditawarkan kepada pengguna saat beberapa tab terbuka berisi produk dalam kategori serupa.\n\nNilai 0 = Mengizinkan penggunaan fitur ini, sekaligus mengizinkan Google menggunakan data yang relevan untuk meningkatkan kualitas model AI-nya. Data yang relevan mungkin mencakup perintah, input, output, materi sumber, dan masukan tertulis, bergantung pada fiturnya. Data ini juga mungkin ditinjau secara manual untuk meningkatkan kualitas model AI. Nilai 0 adalah nilai default, kecuali jika dinyatakan lain di bawah.\n\nNilai 1 = Mengizinkan penggunaan fitur ini, tetapi tidak mengizinkan Google meningkatkan kualitas model menggunakan konten pengguna (termasuk perintah, input, output, materi sumber, dan masukan tertulis). Nilai 1 adalah nilai default untuk pengguna Enterprise yang dikelola oleh Google Admin console dan untuk akun Education yang dikelola oleh Google Workspace.\n\nNilai 2 = Tidak mengizinkan penggunaan fitur ini.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
TabDiscardingExceptions.pfm_title = "Pengecualian pola URL untuk penghapusan tab";
TabDiscardingExceptions.pfm_description = "Kebijakan ini membuat URL apa pun yang cocok dengan satu atau beberapa pola yang ditentukan (menggunakan format filter URLBlocklist) tidak akan dihapus oleh browser.\nKebijakan ini berlaku untuk menghentikan tekanan memori dan mode efisiensi tinggi.\nHalaman yang dihapus akan dihapus muatannya dan resource-nya akan diklaim kembali sepenuhnya. Tab yang terkait dengannya tetap berada di tab setrip. Namun, jika tab disetel agar terlihat, pemuatan ulang penuh akan dipicu.\n";
TaskManagerEndProcessEnabled.pfm_title = "Aktifkan proses diakhiri di Pengelola Tugas";
TaskManagerEndProcessEnabled.pfm_description = "Jika kebijakan disetel ke Nonaktif, pengguna akan dicegah untuk mengakhiri proses di Pengelola Tugas.\n\nJika kebijakan disetel ke Aktif atau tidak disetel, pengguna diizinkan untuk mengakhiri proses di Pengelola Tugas.";
ThirdPartyAiChatSettings.pfm_title = "Setelan untuk integrasi Mode AI pihak ketiga di kolom URL dan kotak penelusuran halaman Tab Baru.";
ThirdPartyAiChatSettings.pfm_description = "0 - Izinkan integrasi Mode AI pihak ketiga.\n1 - Jangan izinkan integrasi Mode AI pihak ketiga.\nKebijakan ini mengontrol integrasi Mode AI pihak ketiga di kolom URL dan kotak penelusuran halaman Tab Baru.\n\nUntuk mengakses fitur ini, mesin telusur pihak ketiga yang mendukung Mode AI harus disetel sebagai mesin telusur default pengguna.\n\nNilai 0 = Fitur akan tersedia bagi pengguna.\n\nNilai 1 = Fitur tidak akan tersedia bagi pengguna.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "Menetapkan batas memori untuk instance Chrome";
TotalMemoryLimitMb.pfm_description = "Mengonfigurasi jumlah memori yang dapat digunakan oleh satu instance Brave sebelum tab mulai dihapus (artinya, memori yang digunakan oleh tab akan dibebaskan dan tab harus dimuat ulang saat dialihkan) untuk menghemat memori.\n\nJika kebijakan ini ditetapkan, browser akan mulai menghapus tab untuk menghemat memori setelah melampaui batas. Namun, tidak ada jaminan bahwa browser selalu berjalan di bawah batas. Setiap nilai yang kurang dari 1024 akan dibulatkan ke 1024.\n\nJika kebijakan ini tidak ditetapkan, browser hanya akan mulai mencoba menghemat memori setelah mendeteksi bahwa perangkatnya memiliki jumlah memori fisik yang rendah.";
TranslateEnabled.pfm_title = "Aktifkan Terjemahan";
TranslateEnabled.pfm_description = "Jika kebijakan disetel ke Benar (True), fungsi terjemahan akan diberikan pada waktu yang tepat bagi pengguna dengan menampilkan toolbar terjemahan terintegrasi di Brave dan opsi terjemahan di menu konteks yang muncul dengan mengklik kanan. Jika kebijakan disetel ke Salah (False), semua fitur terjemahan bawaan akan dinonaktifkan.\n\nJika Anda menyetel kebijakan, pengguna tidak dapat mengubah fungsi ini. Jika Anda tidak menyetelnya, pengguna akan diizinkan mengubah setelan.";
TranslatorAPIAllowed.pfm_title = "Mengizinkan Translator API";
TranslatorAPIAllowed.pfm_description = "Jika kebijakan ini disetel ke Aktif atau tidak disetel, penggunaan Translator API di Brave akan diizinkan.\n\nJika kebijakan ini disetel ke Nonaktif, penggunaan Translator API tidak akan diizinkan.";
TryOnYouSettings.pfm_title = "Setelan fitur Coba untuk Anda.";
TryOnYouSettings.pfm_description = "0 - Aktifkan fitur Coba untuk Anda dengan peningkatan kualitas model.\n1 - Aktifkan fitur Coba untuk Anda tanpa peningkatan kualitas model.\n2 - Nonaktifkan fitur Coba untuk Anda.\nFitur Coba untuk Anda adalah fitur berteknologi AI yang memungkinkan pengguna mencoba pakaian dari gambar di web secara virtual. Fitur ini juga akan memberikan analisis belanja di Gemini di Chrome, jika Gemini diaktifkan.\n\nNilai 0 = Mengizinkan penggunaan fitur ini, sekaligus mengizinkan Google menggunakan data yang relevan untuk meningkatkan kualitas model AI-nya. Data yang relevan mungkin mencakup gambar, input, output, materi referensi, dan masukan, bergantung pada fiturnya. Data ini juga mungkin ditinjau secara manual untuk meningkatkan kualitas model AI. Nilai 0 adalah nilai default, kecuali jika dinyatakan lain di bawah.\n\nNilai 1 = Mengizinkan penggunaan fitur ini, tetapi tidak mengizinkan Google meningkatkan kualitas model menggunakan konten pengguna (termasuk gambar, input, output, materi referensi, dan masukan). Nilai 1 adalah nilai default untuk pengguna Enterprise yang dikelola oleh Google Admin console dan untuk akun Education yang dikelola oleh Google Workspace.\n\nNilai 2 = Tidak mengizinkan penggunaan fitur ini.\n\nCatatan: Pembatasan pada peningkatan kualitas model (nilai 1) hanya berlaku jika fitur Coba untuk Anda dipicu melalui alur browser Chrome. Kebijakan ini tidak berlaku jika fitur digunakan melalui alur lain.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings. Untuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.\n\nFitur Coba untuk Anda hanya tersedia di negara atau dalam bahasa tertentu. Menyetel kebijakan ini tidak menjamin fitur akan diaktifkan; fitur tetap bergantung pada ketersediaan. Untuk mengetahui info selengkapnya tentang peluncuran, baca Catatan Rilis Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=id";
URLAllowlist.pfm_title = "Izinkan akses ke daftar URL";
URLAllowlist.pfm_description = "Jika kebijakan disetel, akses ke URL yang tercantum akan diberikan sebagai pengecualian untuk URLBlocklist. Lihat deskripsi kebijakan tersebut untuk mengetahui format entri daftar ini. Misalnya, menyetel URLBlocklist ke * akan memblokir semua permintaan, dan Anda dapat menggunakan kebijakan ini untuk mengizinkan akses ke URL yang ada dalam daftar terbatas. Gunakan kebijakan ini untuk membuka pengecualian untuk skema tertentu, subdomain dari domain lain, port, atau jalur khusus, menggunakan format yang ditentukan di ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ). Filter paling spesifik akan menentukan apakah URL diblokir atau diizinkan. Kebijakan URLAllowlist akan lebih diprioritaskan daripada URLBlocklist. Kebijakan ini terbatas untuk 1.000 entri.\n\nDengan kebijakan ini, panggilan otomatis dapat dilakukan oleh browser aplikasi eksternal yang terdaftar sebagai pengendali protokol untuk protokol yang tercantum seperti \"tel:\" atau \"ssh:\".\n\nJika kebijakan ini tidak disetel, tidak akan ada pengecualian untuk URLBlocklist.\n\nMulai Brave versi 92, kebijakan ini juga didukung dalam mode headless.";
URLBlocklist.pfm_title = "Blokir akses ke daftar URL";
URLBlocklist.pfm_description = "Menyetel kebijakan URLBlocklist akan menghentikan pemuatan halaman web yang berisi URL terlarang. Administrator dapat menentukan daftar pola URL yang akan diblokir. Jika kebijakan ini tidak disetel, tidak ada URL yang akan diblokir di browser. Hingga 1.000 pengecualian dapat ditentukan di URLAllowlist. Lihat cara memformat pola URL (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nCatatan: Kebijakan ini tidak berlaku untuk URL JavaScript dalam halaman dengan data yang dimuat secara dinamis. Jika Anda memblokir example.com/abc, example.com tetap dapat memuatnya menggunakan XMLHTTPRequest. Selain itu, kebijakan ini tidak mencegah halaman web memperbarui URL yang ditampilkan di omnibox menjadi URL yang diblokir menggunakan JavaScript History API.\n\nMulai Brave versi 73, Anda dapat memblokir URL javascript://*. Namun, ini hanya akan memengaruhi JavaScript yang dimasukkan di kolom URL atau, misalnya, bookmarklet.\n\nMulai Brave versi 92, kebijakan ini juga didukung dalam mode headless.\n\nMulai Brave versi 147, karakter pengganti * sendiri tidak berlaku untuk URL chrome:// internal. Untuk memblokirnya, Anda harus menggunakan pola chrome://* secara eksplisit.\n\nCatatan: Jika diblokir, URL chrome://* dan chrome-untrusted://* internal dapat menyebabkan error yang tidak terduga atau dapat dilewati dalam beberapa kasus. Daripada memblokir URL internal tertentu, sebaiknya periksa apakah tersedia kebijakan yang lebih spesifik. Misalnya:\n\n- Daripada memblokir chrome://settings/certificates, gunakan CACertificateManagementAllowed.\n\n- Daripada memblokir chrome-untrusted://crosh, gunakan SystemFeaturesDisableList.\n\n- Daripada memblokir devtools://*, gunakan salah satu kebijakan DeveloperToolsAvailability, DeveloperToolsAvailabilityAllowlist, atau DeveloperToolsAvailabilityBlocklist.";
UpdateOnZeroWindowEnabled.pfm_title = "Mengontrol peluncuran kembali otomatis di latar belakang saat semua jendela browser ditutup";
UpdateOnZeroWindowEnabled.pfm_description = "Mengontrol perilaku mulai ulang otomatis di latar belakang di macOS saat ada update keamanan yang tertunda dan semua jendela browser ditutup.\n\nJika kebijakan ini disetel ke Benar (True) atau tidak disetel, Brave diizinkan untuk memulai ulang otomatis guna menerapkan update yang tertunda saat semua jendela browser ditutup.\n\nJika kebijakan ini disetel ke Salah (False), peluncuran kembali otomatis akan dinonaktifkan saat semua jendela browser ditutup.";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "Mengaktifkan pengumpulan data anonim yang menyertakan URL";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "Jika kebijakan ini disetel ke Aktif, pengumpulan data anonim yang menyertakan URL, yang mengirimkan informasi URL halaman yang dikunjungi pengguna kepada Google untuk meningkatkan kualitas penelusuran dan penjelajahan, akan selalu aktif.\n\nJika kebijakan disetel ke Nonaktif, pengumpulan data anonim yang menyertakan URL tidak diaktifkan.\n\nJika kebijakan ini tidak disetel, pengguna akan dapat mengubah setelan ini secara manual.\n\nDi Kios Google Chrome OS, kebijakan ini tidak menawarkan opsi \"Izinkan pengguna untuk memutuskan\". Jika kebijakan ini tidak ditetapkan untuk Kios Google Chrome OS, pengumpulan data anonim yang menyertakan URL akan selalu aktif.\nJika disetel untuk Google Chrome OS Kiosk, kebijakan ini akan mengaktifkan pengumpulan metrik yang menyertakan URL untuk aplikasi kios.";
UserDataDir.pfm_title = "Menyetel direktori data pengguna";
UserDataDir.pfm_description = "Mengonfigurasi direktori yang akan digunakan Brave untuk menyimpan data pengguna.\n\nJika Anda menyetel kebijakan ini, Brave akan menggunakan direktori yang disediakan, terlepas apakah pengguna telah menetapkan tanda '--user-data-dir' atau belum. Agar tidak kehilangan data atau mengalami error tak terduga, kebijakan ini tidak boleh disetel ke direktori yang digunakan untuk tujuan lain, karena Brave mengelola kontennya.\n\nLihat https://support.google.com/chrome/a?p=Supported_directory_variables untuk mengetahui daftar variabel yang dapat digunakan.\n\nJika kebijakan ini tidak disetel, jalur profil default akan digunakan dan pengguna akan dapat menggantinya dengan tanda command line '--user-data-dir'.";
UserDataSnapshotRetentionLimit.pfm_title = "Membatasi jumlah ringkasan data pengguna yang disimpan untuk digunakan ketika terjadi rollback darurat.";
UserDataSnapshotRetentionLimit.pfm_description = "Setelah masing-masing update versi utama, Chrome akan membuat rekaman bagian tertentu dari data penjelajahan pengguna untuk digunakan ketika terjadi rollback versi darurat nantinya. Jika rollback darurat dilakukan ke versi yang rekaman terkaitnya dimiliki pengguna, data di rekaman tersebut akan dipulihkan. Ini memungkinkan pengguna mempertahankan setelan seperti bookmark dan data isi otomatis.\n\nJika kebijakan ini tidak ditetapkan, nilai default 3 akan digunakan\n\nJika kebijakan ditetapkan, rekaman data lama akan dihapus seperlunya untuk mematuhi batas. Jika kebijakan ditetapkan ke 0, tidak ada rekaman data yang akan diambil";
UserFeedbackAllowed.pfm_title = "Izinkan masukan pengguna";
UserFeedbackAllowed.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna akan dapat mengirimkan masukan ke Google melalui Menu > Bantuan > Laporkan Masalah atau kombinasi tombol.\n\nJika kebijakan disetel ke Nonaktif, pengguna tidak akan dapat mengirimkan masukan ke Google.";
VideoCaptureAllowed.pfm_title = "Izinkan atau tolak penangkapan video";
VideoCaptureAllowed.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengguna akan dimintai akses perekaman video kecuali untuk URL yang ditentukan dalam daftar VideoCaptureAllowedUrls.\n\nJika kebijakan disetel ke Nonaktif, permintaan izin akan dinonaktifkan dan perekaman video hanya tersedia untuk URL yang ditentukan dalam daftar VideoCaptureAllowedUrls.\n\nCatatan: Kebijakan ini memengaruhi semua input video (tidak hanya kamera bawaan).";
VideoCaptureAllowedUrls.pfm_title = "URL yang akan diberi akses ke perangkat perekam video tanpa peringatan";
VideoCaptureAllowedUrls.pfm_description = "Jika kebijakan ini disetel, artinya Anda menentukan daftar URL yang polanya cocok dengan origin keamanan URL yang meminta. Jika terdapat kecocokan, akses ke perangkat perekaman video akan diberikan tanpa permintaan izin\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns/. Namun, perlu diperhatikan bahwa pola \"*\", yang cocok dengan URL apa pun, tidak didukung oleh kebijakan ini.";
VoiceTypingSettings.pfm_title = "Setelan untuk fitur Bicara untuk mengetik";
VoiceTypingSettings.pfm_description = "0 - Izinkan fitur Bicara untuk mengetik.\n1 - Izinkan fitur Bicara untuk mengetik tanpa pengumpulan data.\n2 - Jangan izinkan fitur Bicara untuk mengetik.\nFitur Bicara untuk mengetik adalah fitur berbasis AI yang memungkinkan pengguna memasukkan dan mengedit teks menggunakan suara mereka, yang didukung oleh model AI generatif untuk memberikan transkripsi dan pemformatan berkualitas tinggi.\n\nNilai 0 = Mengizinkan penggunaan fitur ini, sekaligus mengizinkan Google menggunakan data yang relevan untuk meningkatkan kualitas model AI-nya. Data yang relevan mungkin mencakup perintah, input, output, materi referensi, dan masukan tertulis, bergantung pada fiturnya. Data ini juga mungkin ditinjau secara manual untuk meningkatkan kualitas model AI. Nilai 0 adalah nilai default, kecuali jika dinyatakan lain di bawah.\n\nNilai 1 = Mengizinkan penggunaan fitur ini, tetapi tidak mengizinkan Google meningkatkan kualitas model menggunakan konten pengguna (termasuk perintah, input, output, materi referensi, dan masukan tertulis). Nilai 1 adalah nilai default untuk pengguna Enterprise yang dikelola oleh Google Admin console dan untuk akun Education yang dikelola oleh Google Workspace.\n\nNilai 2 = Tidak mengizinkan penggunaan fitur ini.\n\nJika kebijakan ini tidak disetel, perilakunya akan ditentukan oleh kebijakan GenAiDefaultSettings.\n\nUntuk mengetahui informasi selengkapnya tentang penanganan data untuk fitur AI generatif, lihat https://support.google.com/chrome/a?p=generative_ai_settings.";
WPADQuickCheckEnabled.pfm_title = "Aktifkan pengoptimalan WPAD";
WPADQuickCheckEnabled.pfm_description = "Jika kebijakan disetel ke Aktif atau tidak disetel, pengoptimalan WPAD (Web Proxy Auto-Discovery) akan diaktifkan di Brave.\n\nJika kebijakan disetel ke Nonaktif, pengoptimalan WPAD akan dinonaktifkan, yang menyebabkan Brave menunggu lebih lama untuk server WPAD berbasis DNS.\n\nTanpa mempertimbangkan apakah kebijakan ini disetel atau tidak disetel, pengguna tidak dapat mengubah setelan pengoptimalan WPAD.";
WarnBeforeQuittingEnabled.pfm_title = "Tampilkan dialog peringatan saat pengguna mencoba menutup browser";
WarnBeforeQuittingEnabled.pfm_description = "Mengontrol dialog \"Peringatkan Sebelum Menutup (⌘Q)\" saat pengguna mencoba menutup browser.\n\nJika kebijakan ini disetel ke Aktif atau tidak disetel, dialog peringatan akan ditampilkan saat pengguna mencoba menutup browser.\n\nJika kebijakan ini disetel ke Nonaktif, dialog peringatan tidak akan ditampilkan saat pengguna mencoba menutup browser.";
WebAppInstallByUserEnabled.pfm_title = "Aktifkan Penginstalan Aplikasi Web Pengguna dari Browser";
WebAppInstallByUserEnabled.pfm_description = "Kebijakan ini mengontrol apakah pengguna dapat menginstal aplikasi web melalui browser.\nJika Anda mengaktifkan atau tidak mengonfigurasi kebijakan ini, pengguna dapat menginstal aplikasi web melalui browser.\nJika Anda menonaktifkan kebijakan ini, pengguna tidak dapat menginstal aplikasi web melalui browser dan jenis data \"aplikasi\" akan dikecualikan dari sinkronisasi untuk Chrome Sync.\nKebijakan ini tidak mendukung pemuatan ulang dinamis. Semua perubahan, baik mengaktifkan, menonaktifkan, atau menghapus setelan, hanya akan berlaku setelah browser dimulai ulang.\nKebijakan ini tidak memengaruhi kebijakan 'WebAppInstallForceList'.";
WebAppInstallForceList.pfm_title = "URL untuk Aplikasi Web diinstal otomatis.";
WebAppInstallForceList.pfm_description = "Menyetel kebijakan akan menentukan daftar aplikasi web yang diinstal otomatis, tanpa interaksi pengguna, dan yang tidak dapat di-uninstal atau dinonaktifkan pengguna.\n\nSetiap item daftar kebijakan adalah objek yang berisi satu elemen wajib:\nurl (URL aplikasi web yang akan diinstal)\n\ndan 6 elemen opsional:\n- default_launch_container\n(untuk cara aplikasi web terbuka—tab baru adalah default)\n\n- create_desktop_shortcut\n(Berlaku jika Anda ingin membuat pintasan desktop Linux dan\nMicrosoft® Windows®).\n\n- fallback_app_name\n(Mulai dari Brave versi 90,\nmemungkinkan Anda untuk mengganti nama aplikasi jika aplikasi tersebut bukan\nProgressive Web App (PWA), atau mengganti nama aplikasi yang diinstal\nsementara jika aplikasi tersebut adalah PWA, tetapi perlu diautentikasi sebelum\npenginstalan dapat diselesaikan. Jika\ncustom_name dan\nfallback_app_name tersedia,\nyang kedua akan diabaikan).\n\n- custom_name\n(Mulai dari Google Chrome OS versi 99,\ndan versi 112 di semua sistem operasi desktop lain, memungkinkan Anda\nmengganti nama aplikasi untuk semua aplikasi web dan PWA secara permanen).\n\n- custom_icon\n(Mulai dari Google Chrome OS versi 99,\ndan versi 112 di semua sistem operasi desktop lain, memungkinkan Anda untuk\nmengganti ikon aplikasi yang diinstal. Ikon harus berbentuk persegi,\nberukuran maksimal 1 MB, dan dalam salah satu format berikut: jpeg, png, gif, webp, ico.\nNilai hash file ikon harus hash SHA256. url\nharus dapat diakses tanpa autentikasi untuk memastikan ikon dapat digunakan\nsaat aplikasi diinstal.)\n\n- install_as_shortcut\n(Mulai dari Brave versi 107\n). Jika diaktifkan, url\nyang disediakan akan diinstal sebagai pintasan, seolah-olah dilakukan melalui opsi \"Buat Pintasan...\"\ndi GUI browser desktop.\nPerlu diperhatikan bahwa jika diinstal sebagai pintasan, URL tersebut tidak akan diupdate jika\nmanifes pada url berubah.\nJika dinonaktifkan atau tidak disetel, aplikasi web di\nurl yang disediakan akan diinstal secara normal.\n\nLihat PinnedLauncherApps untuk menyematkan aplikasi ke panel aplikasi Google Chrome OS.\nBuka https://chromeenterprise.google/policies/?policy=WebAppInstallForceList untuk informasi lebih lanjut terkait skema dan pemformatan.";
WebAppSettings.pfm_title = "Setelan pengelolaan Aplikasi Web";
WebAppSettings.pfm_description = "Kebijakan ini memungkinkan admin menentukan setelan untuk aplikasi web terinstal. Kebijakan ini memetakan ID Aplikasi Web ke setelan tertentu. Konfigurasi default dapat disetel menggunakan ID khusus *, yang berlaku untuk semua aplikasi web tanpa konfigurasi khusus dalam kebijakan ini.\n\nKolom manifest_id adalah ID Manifes untuk Aplikasi Web. Lihat https://developer.chrome.com/blog/pwa-manifest-id/ guna mendapatkan petunjuk cara menentukan ID Manifes untuk aplikasi web terinstal.\nKolom run_on_os_login menentukan apakah aplikasi web dapat dijalankan selama login OS. Jika kolom ini disetel ke blocked, aplikasi web tidak akan dijalankan selama login OS dan pengguna tidak akan dapat mengaktifkannya nanti. Jika kolom ini disetel ke run_windowed, aplikasi web akan dijalankan selama login OS dan pengguna tidak akan dapat menonaktifkannya nanti. Jika kolom ini disetel ke allowed, pengguna akan dapat mengonfigurasi aplikasi web untuk dijalankan saat login OS. Konfigurasi default hanya mengizinkan nilai allowed dan blocked.\n(Sejak versi 117) Kolom prevent_close_after_run_on_os_login menentukan apakah aplikasi web harus dicegah agar tidak ditutup dengan cara apa pun (mis. oleh pengguna, pengelola tugas, API web). Perilaku ini hanya dapat diaktifkan jika run_on_os_login disetel ke run_windowed. Jika aplikasi sudah berjalan, properti ini hanya akan berlaku setelah aplikasi dimulai ulang. Jika kolom ini tidak ditentukan, aplikasi akan dapat ditutup oleh pengguna.\n(Sejak versi 118) Kolom force_unregister_os_integration menentukan apakah semua integrasi OS untuk aplikasi web, yaitu pintasan, pengendali file, pengendali protokol, dll. akan dihapus atau tidak. Jika aplikasi sudah berjalan, properti ini akan berlaku setelah aplikasi dimulai ulang. Tindakan ini harus digunakan dengan hati-hati, karena hal ini dapat mengganti integrasi OS apa pun yang disetel otomatis saat sistem aplikasi web dimulai. Saat ini hanya berfungsi di platform Windows, Mac, dan Linux.\nBuka https://chromeenterprise.google/policies/?policy=WebAppSettings untuk informasi lebih lanjut terkait skema dan pemformatan.";
WebAudioOutputBufferingEnabled.pfm_title = "Mengaktifkan buffering adaptif untuk Web Audio";
WebAudioOutputBufferingEnabled.pfm_description = "Kebijakan ini mengontrol apakah browser akan menggunakan buffering adaptif untuk Web Audio, yang mungkin mengurangi gangguan audio tetapi juga mungkin meningkatkan latensi sebesar jumlah variabel.\n\nJika kebijakan ini disetel ke Aktif, buffering adaptif akan selalu digunakan.\n\nJika kebijakan ini disetel ke Nonaktif atau tidak disetel, browser\nakan menggunakan proses peluncuran fitur untuk menentukan apakah buffering adaptif akan digunakan.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "Mengizinkan Origin untuk Permintaan WebAuthn yang Di-proxy dari Aplikasi Desktop Jarak Jauh.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "Daftar origin aplikasi klien desktop jarak jauh yang dapat mengeksekusi permintaan WebAuthn API\nyang berasal dari sesi penjelajahan pada host jarak jauh.\n\nSetiap origin yang dikonfigurasi dalam kebijakan ini dapat membuat permintaan WebAuthn untuk ID Pihak\nTepercaya (RP ID) yang biasanya tidak diizinkan untuk diklaim.\n\nHanya origin HTTPS yang valid yang diizinkan. Karakter pengganti tidak didukung.\nEntri yang tidak valid akan diabaikan.\n\nKebijakan ini hanya berlaku untuk pengguna terafiliasi.";
WebHidAllowAllDevicesForUrls.pfm_title = "Otomatis memberikan izin ke situs untuk terhubung ke semua perangkat HID.";
WebHidAllowAllDevicesForUrls.pfm_description = "Menyetel kebijakan memungkinkan Anda menetapkan daftar situs yang otomatis diizinkan untuk mengakses semua perangkat yang tersedia.\n\nURL harus valid. Jika tidak, kebijakan akan diabaikan. Hanya asal (skema, host, dan port) URL yang dipertimbangkan.\n\nDi ChromeOS, kebijakan ini hanya berlaku untuk pengguna terafiliasi.\n\nKebijakan ini menggantikan DefaultWebHidGuardSetting, WebHidAskForUrls, WebHidBlockedForUrls, dan preferensi pengguna.";
WebHidAllowDevicesForUrls.pfm_title = "Otomatis memberikan izin ke situs ini untuk terhubung ke perangkat HID dengan ID produk dan vendor tertentu.";
WebHidAllowDevicesForUrls.pfm_description = "Menyetel kebijakan memungkinkan Anda menetapkan daftar URL yang menentukan situs mana yang otomatis diizinkan untuk mengakses perangkat HID dengan ID vendor dan produk tertentu. Setiap item dalam daftar memerlukan kolom devices dan urls agar item menjadi valid. Jika tidak, item akan diabaikan. Setiap item di kolom devices harus memiliki kolom vendor_id dan dapat memiliki kolom product_id. Jika kolom product_id tidak ada, kebijakan akan cocok dengan perangkat apa pun yang memiliki ID vendor tertentu. Item yang memiliki kolom product_id tanpa kolom vendor_id menjadi tidak valid dan akan diabaikan.\n\nTidak menyetel kebijakan berarti DefaultWebHidGuardSetting akan berlaku, jika disetel. Jika tidak, setelan pribadi pengguna akan digunakan.\n\nURL dalam kebijakan ini tidak boleh bertentangan dengan URL yang dikonfigurasi melalui WebHidBlockedForUrls. Jika bertentangan, kebijakan ini akan lebih diprioritaskan daripada WebHidBlockedForUrls.\nBuka https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls untuk informasi lebih lanjut terkait skema dan pemformatan.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "Otomatis memberikan izin ke situs ini untuk terhubung ke perangkat HID yang berisi koleksi tingkat atas dengan penggunaan HID tertentu.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "Menyetel kebijakan memungkinkan Anda menetapkan daftar URL yang menentukan situs mana yang otomatis diizinkan untuk mengakses perangkat HID yang berisi koleksi tingkat atas dengan penggunaan HID tertentu. Setiap item dalam daftar memerlukan kolom usages dan urls agar kebijakan menjadi valid. Setiap item di kolom usages harus memiliki kolom usage_page dan dapat memiliki kolom usage. Jika kolom usage tidak ada, kebijakan akan cocok dengan perangkat yang berisi koleksi tingkat atas dengan penggunaan dari halaman penggunaan tertentu. Item yang memiliki kolom usage tanpa kolom usage_page menjadi tidak valid dan akan diabaikan.\n\nTidak menyetel kebijakan berarti DefaultWebHidGuardSetting akan berlaku, jika disetel. Jika tidak, setelan pribadi pengguna akan digunakan.\n\nURL dalam kebijakan ini tidak boleh bertentangan dengan URL yang dikonfigurasi melalui WebHidBlockedForUrls. Jika bertentangan, kebijakan ini akan lebih diprioritaskan daripada WebHidBlockedForUrls.\nBuka https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls untuk informasi lebih lanjut terkait skema dan pemformatan.";
WebHidAskForUrls.pfm_title = "Mengizinkan WebHID API di situs ini";
WebHidAskForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang dapat meminta izin kepada pengguna untuk mengakses perangkat HID.\n\nJika kebijakan ini tidak disetel, DefaultWebHidGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk pola URL yang tidak cocok dengan kebijakan, maka kebijakan berikut akan diprioritaskan, dalam urutan ini:\n\n  * WebHidBlockedForUrls (jika ada kecocokan),\n\n  * DefaultWebHidGuardSetting (jika disetel), atau\n\n  * Setelan pribadi pengguna.\n\nPola URL tidak boleh bertentangan dengan WebHidBlockedForUrls. Tidak ada kebijakan yang diprioritaskan jika URL cocok dengan keduanya.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
WebHidBlockedForUrls.pfm_title = "Memblokir WebHID API di situs ini";
WebHidBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang tidak dapat meminta izin kepada pengguna untuk mengakses perangkat HID.\n\nJika kebijakan ini tidak disetel, DefaultWebHidGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nUntuk pola URL yang tidak cocok dengan kebijakan, maka kebijakan berikut akan diprioritaskan, dalam urutan ini:\n\n  * WebHidAskForUrls (jika ada kecocokan),\n\n  * DefaultWebHidGuardSetting (jika disetel), atau\n\n  * Setelan pribadi pengguna.\n\nPola URL tidak boleh bertentangan dengan WebHidAskForUrls. Tidak ada kebijakan yang diprioritaskan jika URL cocok dengan keduanya.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "Aktifkan pengumpulan log diagnostik WebRTC untuk origin tertentu";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "Kebijakan ini memungkinkan pengaktifan pengumpulan log diagnostik untuk WebRTC bagi origin tertentu.\n\nUntuk informasi selengkapnya tentang pola input yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukan nilai yang diterima untuk kebijakan ini. Kebijakan ini hanya melakukan pencocokan berdasarkan origin, jadi semua jalur di pola URL diabaikan. Skema dan subdomain didukung.\n\nJika kebijakan ini disetel, pengumpulan log diagnostik akan diaktifkan untuk origin yang cocok dengan pola di daftar.\n\nJika kebijakan ini tidak disetel, pengumpulan log diagnostik akan dinonaktifkan secara default.";
WebRtcEventLogCollectionAllowed.pfm_title = "Mengizinkan pengumpulan log aktivitas WebRTC dari layanan Google";
WebRtcEventLogCollectionAllowed.pfm_description = "Jika kebijakan tersebut disetel ke Aktif, Brave dapat mengumpulkan log aktivitas WebRTC dari layanan Google seperti Hangouts Meet dan menguploadnya ke Google. Log ini berisi informasi diagnostik untuk menangani masalah proses debug pada audio atau rapat video di Brave, seperti waktu dan ukuran paket RTP, masukan tentang kemacetan pada jaringan, dan metadata tentang waktu dan kualitas frame audio dan video. Log ini tidak berisi konten audio atau video dari rapat. Untuk mempermudah proses debug, Google dapat mengaitkan log ini dengan log lain, yang dikumpulkan oleh layanan Google sendiri, menggunakan ID sesi.\n\nJika kebijakan disetel ke Nonaktif, log tersebut tidak akan dikumpulkan atau diupload.\n\nJika kebijakan pada versi hingga dan termasuk M76 tidak disetel, berarti default Brave tidak dapat mengumpulkan atau mengupload log tersebut. Mulai versi M77, default Brave akan dapat mengumpulkan dan mengupload log tersebut dari sebagian besar profil yang terdampak oleh kebijakan perusahaan tingkat pengguna berbasis cloud. Mulai versi M77 hingga dan termasuk M80, Brave juga dapat mengumpulkan dan mengupload log secara default dari profil yang terdampak oleh manajemen lokal Brave.";
WebRtcIPHandling.pfm_title = "Penanganan IP WebRTC";
WebRtcIPHandling.pfm_description = "default - WebRTC akan menggunakan antarmuka yang tersedia saat menelusuri jalur terbaik.\ndefault_public_and_private_interfaces - WebRTC hanya akan menggunakan antarmuka yang terhubung ke internet publik, tetapi dapat terhubung menggunakan alamat IP pribadi.\ndefault_public_interface_only - WebRTC hanya akan menggunakan antarmuka yang terhubung ke internet publik, tetapi tidak dapat terhubung menggunakan alamat IP pribadi.\ndisable_non_proxied_udp - WebRTC akan menggunakan TCP pada antarmuka yang ditampilkan kepada publik, dan hanya akan menggunakan UDP jika didukung oleh proxy yang dikonfigurasi.\nKebijakan ini memungkinkan pembatasan alamat IP dan antarmuka yang dapat digunakan oleh WebRTC saat mencoba menemukan koneksi terbaik yang tersedia.\n\nNilai yang valid:\n\n* default - WebRTC menggunakan semua antarmuka jaringan yang tersedia.\n\n* default_public_and_private_interfaces - WebRTC menggunakan semua antarmuka publik dan pribadi.\n\n* default_public_interface_only - WebRTC menggunakan semua antarmuka publik, tetapi tidak menggunakan antarmuka pribadi.\n\n* disable_non_proxied_udp - WebRTC menggunakan proxy SOCKS UDP atau akan beralih ke proxy TCP.\n\nJika tidak ditetapkan, semua antarmuka jaringan yang tersedia akan digunakan secara default.\n\nLihat RFC 8828 bagian 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2) untuk melihat deskripsi terperinci tentang semua nilai penanganan.";
WebRtcIPHandlingUrl.pfm_title = "Penanganan IP WebRTC per URL";
WebRtcIPHandlingUrl.pfm_description = "Kebijakan ini memungkinkan pembatasan alamat IP dan antarmuka yang dapat digunakan oleh WebRTC saat mencoba menemukan koneksi terbaik yang tersedia untuk setiap pola URL tertentu.\n\nKebijakan ini menerima daftar pasangan pola URL dan jenis penanganan. Pola URL diperiksa secara berurutan dan kecocokan pertama akan mengonfigurasi penanganan yang digunakan oleh WebRTC untuk domain tersebut. Jika URL dokumen saat ini tidak cocok dengan entri apa pun, dokumen tersebut akan menggunakan konfigurasi yang ditetapkan oleh kebijakan WebRtcIPHandling.\n\nUntuk mengetahui informasi selengkapnya tentang pola input yang valid, lihat https://chromeenterprise.google/policies/url-patterns/. Karakter pengganti, *, diizinkan. Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.\n\nNilai penanganan yang valid:\n\n* default - WebRTC menggunakan semua antarmuka jaringan.\n\n* default_public_and_private_interfaces - WebRTC menggunakan semua antarmuka publik dan pribadi.\n\n* default_public_interface_only - WebRTC menggunakan semua antarmuka publik, tetapi tidak menggunakan antarmuka pribadi.\n\n* disable_non_proxied_udp - WebRTC menggunakan proxy SOCKS UDP atau akan beralih ke proxy TCP.\n\nLihat RFC 8828 bagian 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2) untuk melihat deskripsi terperinci tentang semua nilai penanganan.\nBuka https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl untuk informasi lebih lanjut terkait skema dan pemformatan.";
WebRtcLocalIpsAllowedUrls.pfm_title = "URL yang akan menampilkan IP lokal dalam kandidat WebRTC ICE";
WebRtcLocalIpsAllowedUrls.pfm_description = "Pola dalam daftar ini akan dicocokkan dengan asal keamanan URL yang meminta.\nJika kecocokan ditemukan atau chrome://flags/#enable-webrtc-hide-local-ips-with-mdns Nonaktif, alamat IP lokal akan ditampilkan dalam kandidat WebRTC ICE.\nJika tidak, alamat IP lokal akan disembunyikan dengan hostname mDNS.\nPerlu diingat bahwa kebijakan ini akan melemahkan perlindungan IP lokal jika dibutuhkan oleh administrator.";
WebRtcPostQuantumKeyAgreement.pfm_title = "Aktifkan perjanjian kunci pasca-kuantum untuk WebRTC";
WebRtcPostQuantumKeyAgreement.pfm_description = "Kebijakan ini memungkinkan Anda mengontrol perjanjian kunci pasca-kuantum untuk WebRTC.\n\nJika kebijakan ini disetel ke Aktif, perjanjian kunci pasca-kuantum akan ditawarkan untuk\nWebRTC.\n\nJika kebijakan ini disetel ke Nonaktif, perjanjian kunci pasca-kuantum tidak akan ditawarkan\nuntuk WebRTC.\n\nJika kebijakan ini tidak disetel, nilai akan disetel oleh proses peluncuran default\nuntuk menawarkan perjanjian kunci pasca-kuantum untuk WebRTC.\n\nPenawaran perjanjian kunci pasca-kuantum kompatibel dengan versi lama. Middleware jaringan\ndan peer DTLS yang ada akan disetel untuk mengabaikan opsi baru ini dan\ntetap memilih opsi sebelumnya.\n\nNamun, perangkat yang tidak menerapkan DTLS dengan tepat mungkin berhenti berfungsi saat\nditawarkan opsi baru ini. Misalnya, perangkat mungkin akan berhenti terhubung jika\ndiberikan opsi yang tidak dikenal atau jika pesan yang dihasilkan jumlahnya lebih besar. Perangkat tersebut belum siap digunakan untuk\npasca-kuantum dan akan mengganggu proses transisi ke algoritma pasca-kuantum\nyang dilakukan oleh perusahaan. Jika hal tersebut terjadi, administrator harus menghubungi vendor untuk memperbaikinya.\n\nKebijakan ini merupakan tindakan sementara dan akan dihapus setelah beberapa versi.";
WebRtcTextLogCollectionAllowed.pfm_title = "Mengizinkan pengumpulan log teks WebRTC dari Layanan Google";
WebRtcTextLogCollectionAllowed.pfm_description = "Jika kebijakan tersebut disetel ke aktif, Brave dapat mengumpulkan log teks WebRTC dari layanan Google, seperti Google Meet, dan menguploadnya ke Google. Log ini berisi informasi diagnostik untuk menangani masalah proses debug pada audio atau rapat video di Brave, seperti metadata teks yang menjelaskan stream WebRTC masuk dan keluar, entri log khusus WebRTC, dan informasi sistem tambahan. Log ini tidak berisi konten audio atau video dari rapat.\nJika kebijakan disetel ke nonaktif, log tersebut tidak akan diupload ke Google. Log masih akan diakumulasi secara lokal di perangkat pengguna.\nJika kebijakan tidak disetel, Brave akan mengumpulkan dan mengupload log ini secara default.";
WebRtcUdpPortRange.pfm_title = "Membatasi rentang port UDP lokal yang digunakan oleh WebRTC";
WebRtcUdpPortRange.pfm_description = "Jika kebijakan disetel, rentang port UDP yang digunakan oleh WebRTC dibatasi ke interval port yang ditentukan (termasuk titik akhir).\n\nJika kebijakan tidak disetel, atau jika disetel menjadi string kosong maupun rentang port yang tidak valid, WebRTC diizinkan untuk menggunakan port UDP lokal mana pun yang tersedia.";
WebUsbAllowDevicesForUrls.pfm_title = "Otomatis berikan izin ke situs ini untuk terhubung ke perangkat USB dengan ID produk dan vendor yang ditentukan.";
WebUsbAllowDevicesForUrls.pfm_description = "Menyetel kebijakan memungkinkan Anda menetapkan daftar pola URL yang menentukan situs mana yang otomatis diizinkan untuk mengakses perangkat USB dengan ID vendor dan produk yang ditetapkan. Setiap item dalam daftar memerlukan kolom devices dan urls agar kebijakan menjadi valid. Setiap item di kolom devices dapat memiliki kolom vendor_id dan product_id. Jika kolom vendor_id tidak ada, kebijakan akan cocok dengan perangkat apa pun. Jika kolom product_id tidak ada, kebijakan akan cocok dengan perangkat apa pun yang memiliki ID vendor yang ditetapkan. Kebijakan yang memiliki kolom product_id tanpa kolom vendor_id menjadi tidak valid.\n\nModel izin USB akan mengizinkan URL yang telah ditentukan untuk mengakses perangkat USB sebagai origin level atas. Jika bingkai sematan memerlukan akses ke perangkat USB, header feature-policy 'usb' harus digunakan untuk memberikan akses. URL harus valid. Jika tidak, kebijakan akan diabaikan.\n\nTidak digunakan lagi: Model izin USB yang digunakan untuk mendukung penentuan URL peminta dan sematan. Model izin ini tidak digunakan lagi dan hanya didukung untuk kompatibilitas mundur dengan cara berikut: jika URL peminta dan sematan ditentukan, URL sematan akan diizinkan sebagai origin level atas dan URL peminta akan diabaikan sepenuhnya.\n\nKebijakan ini menggantikan DefaultWebUsbGuardSetting, WebUsbAskForUrls, WebUsbBlockedForUrls, dan preferensi pengguna.\n\nKebijakan ini hanya memengaruhi akses ke perangkat USB melalui WebUSB API. Untuk memberikan akses ke perangkat USB melalui Web Serial API, lihat kebijakan SerialAllowUsbDevicesForUrls.\nBuka https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls untuk informasi lebih lanjut terkait skema dan pemformatan.";
WebUsbAskForUrls.pfm_title = "Izinkan WebUSB di situs ini";
WebUsbAskForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang dapat meminta izin kepada pengguna untuk mengakses perangkat USB.\n\nJika kebijakan ini tidak disetel, DefaultWebUsbGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nPola URL tidak boleh bertentangan dengan WebUsbAskForUrls. Tidak ada kebijakan yang diprioritaskan jika URL cocok dengan keduanya.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
WebUsbBlockedForUrls.pfm_title = "Blokir WebUSB di situs ini";
WebUsbBlockedForUrls.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang menentukan situs mana yang dapat meminta izin kepada pengguna untuk mengakses perangkat USB.\n\nJika kebijakan ini tidak disetel, DefaultWebUsbGuardSetting akan berlaku untuk semua situs, jika disetel. Jika tidak disetel, setelan pribadi pengguna akan berlaku.\n\nPola URL tidak boleh bertentangan dengan WebUsbAskForUrls. Tidak ada kebijakan yang diprioritaskan jika URL cocok dengan keduanya.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns. * bukanlah nilai yang diterima untuk kebijakan ini.";
WindowCaptureAllowedByOrigins.pfm_title = "Mengizinkan tangkapan Jendela dan Tab berdasarkan asal berikut";
WindowCaptureAllowedByOrigins.pfm_description = "Jika kebijakan ini disetel, Anda akan dapat menetapkan daftar pola URL yang dapat menggunakan Tangkapan Jendela dan Tab.\n\nJika kebijakan ini tidak disetel, situs tidak akan dianggap sebagai penggantian pada tingkat Tangkapan ini.\n\nKebijakan ini akan diabaikan jika situs cocok dengan pola URL di salah satu kebijakan berikut: TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nJika situs cocok dengan pola URL di kebijakan ini, kebijakan berikut akan diabaikan: ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nUntuk mengetahui informasi selengkapnya tentang pola url yang valid, lihat https://chromeenterprise.google/policies/url-patterns/.  Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.";
WindowManagementAllowedForUrls.pfm_title = "Memberikan izin Pengelolaan Jendela di situs ini";
WindowManagementAllowedForUrls.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL situs yang menentukan situs yang akan otomatis memberikan izin pengelolaan jendela. Hal ini akan memperluas kemampuan situs untuk melihat informasi tentang layar perangkat dan menggunakan informasi tersebut untuk membuka dan menempatkan jendela atau meminta mode layar penuh pada layar tertentu.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL situs yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan. Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.\n\nJika kebijakan ini tidak disetel untuk suatu situs, kebijakan dari DefaultWindowManagementSetting akan berlaku untuk situs tersebut, jika disetel, atau izin akan mengikuti setelan default browser dan memungkinkan pengguna memilih izin ini untuk setiap situs.\n\nPerilaku ini akan menggantikan kebijakan WindowPlacementAllowedForUrls yang sudah tidak digunakan lagi.";
WindowManagementBlockedForUrls.pfm_title = "Memblokir izin Pengelolaan Jendela di situs ini";
WindowManagementBlockedForUrls.pfm_description = "Memungkinkan Anda menetapkan daftar pola URL situs yang menentukan situs yang akan otomatis menolak izin pengelolaan jendela. Hal ini akan membatasi kemampuan situs untuk melihat informasi tentang layar perangkat dan menggunakan informasi tersebut untuk membuka dan menempatkan jendela atau meminta mode layar penuh pada layar tertentu.\n\nUntuk mengetahui informasi selengkapnya tentang pola URL situs yang valid, lihat https://chromeenterprise.google/policies/url-patterns. Karakter pengganti, *, diizinkan. Kebijakan ini hanya mencocokkan berdasarkan origin, sehingga jalur apa pun di pola URL akan diabaikan.\n\nJika kebijakan ini tidak disetel untuk suatu situs, kebijakan dari DefaultWindowManagementSetting akan berlaku untuk situs tersebut, jika disetel, atau izin akan mengikuti setelan default browser dan memungkinkan pengguna memilih izin ini untuk setiap situs.\n\nPerilaku ini akan menggantikan kebijakan WindowPlacementBlockedForUrls yang sudah tidak digunakan lagi.";
XSLTEnabled.pfm_title = "Mengontrol ketersediaan fitur XSLT";
XSLTEnabled.pfm_description = "Kebijakan ini mengontrol ketersediaan fitur XSLT (XSLTProcessor JavaScript API dan petunjuk pemrosesan XSL).\nJika kebijakan ini disetel ke Aktif, XSLT akan tersedia terlepas dari status default fitur tersebut di browser.\nJika kebijakan ini disetel ke Nonaktif, XSLT tidak akan tersedia terlepas dari status default fitur tersebut di browser.\nJika kebijakan ini tidak disetel, ketersediaan XSLT akan ditentukan oleh setelan default browser dan uji coba di lingkungan sebenarnya.\nKebijakan ini bersifat sementara, dan akan dihapus di M176.";