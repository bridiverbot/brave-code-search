{
    "rustenv": {
        "OUT_DIR": "clang_x64_for_rust_host_build_tools/gen/build/rust/std/rules/compiler_builtins_compiler_builtins_vunknown_build_script",
        "CLIPPY_CONF_DIR": "../../build/config",
        "CFG_DISABLE_UNSTABLE_FEATURES": "0",
        "STD_ENV_ARCH": "x86_64",
        "CARGO_PKG_AUTHORS": "Alex Crichton <alex@alexcrichton.com>, Amanieu d'Antras <amanieu@gmail.com>, Jorge Aparicio <japaricious@gmail.com>, Trevor Gross <tg@trevorgross.com>",
        "CARGO_PKG_VERSION": "0.1.160",
        "CARGO_PKG_VERSION_MAJOR": "0",
        "CARGO_PKG_VERSION_MINOR": "1",
        "CARGO_PKG_VERSION_PATCH": "160",
        "CARGO_PKG_VERSION_PRE": "",
        "CARGO_PKG_NAME": "compiler_builtins",
        "CARGO_PKG_DESCRIPTION": "Compiler intrinsics used by the Rust compiler.",
        "CARGO_PKG_REPOSITORY": "https://github.com/rust-lang/compiler-builtins",
        "CARGO_MANIFEST_DIR": "."
    },
    "rustflags": [
        "-Clinker=../../third_party/llvm-build/Release+Asserts/bin/clang++",
        "../../third_party/rust-toolchain/lib/rustlib/src/rust/library/compiler-builtins/compiler-builtins/build.rs",
        "-Clink-arg=-fPIC",
        "-Clink-arg=--target=x86_64-unknown-linux-gnu",
        "-Clink-arg=-no-canonical-prefixes",
        "-Clink-arg=-Wl,--gc-sections",
        "-Clink-arg=-Wl,-z,defs",
        "-Clink-arg=-Wl,--as-needed",
        "-Clink-arg=-nostdlib++",
        "-Clink-arg=--sysroot=../../build/linux/debian_bullseye_amd64-sysroot",
        "-Clink-arg=-fuse-ld=lld",
        "-Clink-arg=-Wl,--fatal-warnings",
        "-Clink-arg=-Wl,--build-id=fast",
        "-Clink-arg=-Wl,-z,noexecstack",
        "-Clink-arg=-Wl,-z,relro",
        "-Clink-arg=-Wl,-z,now",
        "-Clink-arg=-Wl,--icf=all",
        "-Clink-arg=-Wl,--color-diagnostics",
        "-Clink-arg=-Wl,--undefined-version",
        "-Clink-arg=-Wl,--no-call-graph-profile-sort",
        "-Clink-arg=-rdynamic",
        "-Clink-arg=-pie",
        "-Clink-arg=-Wl,--disable-new-dtags",
        "-Clink-arg=-Werror",
        "@clang_x64_for_rust_host_build_tools/obj/build/rust/std/rules/compiler_builtins_compiler_builtins_vunknown_build_script.rsp.rust"
    ]
}