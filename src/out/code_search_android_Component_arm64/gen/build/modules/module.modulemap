}
module std_wctype_h {
  header "../../../../../third_party/libc++/src/include/wctype.h"
  export *
}

// This header is used by other C compatibility headers so it needs to be in its own module.
module std_private_mbstate_t {
  header "../../../../../third_party/libc++/src/include/__mbstate_t.h"
  export *
}

