LiveCaptionEnabled.pfm_title = "เปิดคำบรรยายสด";
LiveCaptionEnabled.pfm_description = "เปิดใช้ฟีเจอร์คำบรรยายสด\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" ระบบจะเปิดฟีเจอร์ \"คำบรรยายสด\" ไว้เสมอ\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ระบบจะปิดฟีเจอร์ \"คำบรรยายสด\" ไว้เสมอ\n\nหากตั้งค่านโยบายนี้เป็นแบบบังคับ ผู้ใช้จะเปลี่ยนหรือลบล้างไม่ได้\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะปิดฟีเจอร์ \"คำบรรยายสด\" ไว้ในขั้นต้น แต่ผู้ใช้จะเปิดใช้ได้ทุกเมื่อ";
LiveTranslateEnabled.pfm_title = "เปิดใช้ฟีเจอร์แปลสด";
LiveTranslateEnabled.pfm_description = "เปิดใช้การแปลคำบรรยายสด ระบบจะส่งคำบรรยายแทนเสียงไปยัง Google เพื่อแปลภาษา\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" ระบบจะเปิดฟีเจอร์ \"แปลสด\" ไว้เสมอ\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ระบบจะปิดฟีเจอร์ \"แปลสด\" ไว้เสมอ\n\nหากตั้งค่านโยบายนี้เป็นแบบบังคับ ผู้ใช้จะเปลี่ยนหรือลบล้างไม่ได้\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะปิดฟีเจอร์ \"แปลสด\" ไว้ในขั้นต้น แต่ผู้ใช้จะเปิดใช้ได้ทุกเมื่อ\n\nหากตั้งค่า LiveCaptionEnabled เป็น \"ปิดใช้\" ระบบจะปิดฟีเจอร์ \"แปลสด\" ไม่ว่าการตั้งค่านโยบายนี้จะเป็นอย่างไร";
LocalFontsAllowedForUrls.pfm_title = "อนุญาตสิทธิ์สำหรับแบบอักษรในเครื่องในเว็บไซต์เหล่านี้";
LocalFontsAllowedForUrls.pfm_description = "สร้างรายการรูปแบบ URL ของเว็บไซต์ซึ่งระบุเว็บไซต์ที่จะให้สิทธิ์สำหรับแบบอักษรในเครื่องโดยอัตโนมัติ การดำเนินการนี้จะทำให้เว็บไซต์ดูข้อมูลเกี่ยวกับแบบอักษรในเครื่องได้\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องของเว็บไซต์ได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้ นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL\n\nหากไม่ได้ตั้งค่านโยบายนี้สำหรับเว็บไซต์ นโยบายจาก DefaultLocalFontsSetting จะมีผลกับเว็บไซต์เมื่อตั้งค่าไว้ ไม่เช่นนั้นสิทธิ์ดังกล่าวจะเป็นไปตามค่าเริ่มต้นของเบราว์เซอร์และอนุญาตให้ผู้ใช้เลือกสิทธิ์สำหรับแต่ละเว็บไซต์";
LocalFontsBlockedForUrls.pfm_title = "บล็อกสิทธิ์สำหรับแบบอักษรในเครื่องในเว็บไซต์เหล่านี้";
LocalFontsBlockedForUrls.pfm_description = "สร้างรายการรูปแบบ URL ของเว็บไซต์ซึ่งระบุเว็บไซต์ที่จะปฏิเสธการให้สิทธิ์สำหรับแบบอักษรในเครื่องโดยอัตโนมัติ การดำเนินการนี้จะจำกัดไม่ให้เว็บไซต์ดูข้อมูลเกี่ยวกับแบบอักษรในเครื่องได้\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องของเว็บไซต์ได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้ นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL\n\nหากไม่ได้ตั้งค่านโยบายนี้สำหรับเว็บไซต์ นโยบายจาก DefaultLocalFontsSetting ก็จะมีผลกับเว็บไซต์เมื่อตั้งค่าไว้ ไม่เช่นนั้นสิทธิ์ดังกล่าวจะเป็นไปตามค่าเริ่มต้นของเบราว์เซอร์และอนุญาตให้ผู้ใช้เลือกสิทธิ์สำหรับแต่ละเว็บไซต์";
LocalNetworkAccessAllowedForUrls.pfm_title = "อนุญาตให้เว็บไซต์ส่งคำขอเครือข่ายไปยังอุปกรณ์ที่ใช้และอุปกรณ์ปลายทางของเครือข่ายภายใน";
LocalNetworkAccessAllowedForUrls.pfm_description = "รายการรูปแบบ URL คำขอเครือข่ายที่เริ่มต้นมาจากเว็บไซต์ที่แสดงโดยต้นทางที่ตรงกันจะไม่ต้องมีการตรวจสอบLocal Network Access\n\nสำหรับต้นทางที่ไม่รวมอยู่ในรูปแบบที่ระบุไว้ที่นี่ ระบบจะใช้การกำหนดค่าส่วนตัวของผู้ใช้\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/\n\nดูข้อจำกัดของ Local Network Access ได้ที่ https://wicg.github.io/local-network-access/\n\nมีนโยบายหลายรายการที่ระบุต้นทางซึ่งส่งผลต่อการส่งคำขอไปยังอุปกรณ์ที่ใช้และอุปกรณ์ปลายทางของเครือข่ายภายใน หากต้นทางตรงกับนโยบายต่อไปนี้มากกว่า 1 รายการ นโยบายจะมีผลก่อนหลังตามลำดับดังนี้\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "บล็อกเว็บไซต์ไม่ให้ส่งคำขอเครือข่ายไปยังอุปกรณ์ที่ใช้และอุปกรณ์ปลายทางของเครือข่ายภายใน";
LocalNetworkAccessBlockedForUrls.pfm_description = "รายการรูปแบบ URL คำขอเครือข่ายที่เริ่มต้นมาจากเว็บไซต์ที่แสดงโดยต้นทางที่ตรงกันจะถูกบล็อกไม่ให้ส่งคําขอLocal Network Access\n\nสำหรับต้นทางที่ไม่รวมอยู่ในรูปแบบที่ระบุไว้ที่นี่ ระบบจะใช้การกำหนดค่าส่วนตัวของผู้ใช้\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/\n\nดูข้อจำกัดของ Local Network Access ได้ที่ https://wicg.github.io/local-network-access/\n\nมีนโยบายหลายรายการที่ระบุต้นทางซึ่งส่งผลต่อการส่งคำขอไปยังอุปกรณ์ที่ใช้และอุปกรณ์ปลายทางของเครือข่ายภายใน หากต้นทางตรงกับนโยบายต่อไปนี้มากกว่า 1 รายการ นโยบายจะมีผลก่อนหลังตามลำดับดังนี้\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "ลบล้างการแมปพื้นที่ที่อยู่ IP";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "ซึ่งสามารถใช้เพื่อถือว่าช่วงที่อยู่ภายในบางช่วงเป็น \"สาธารณะ\" และจึงไม่ต้องมีการตรวจสอบ Local Network Access ในทางกลับกัน คุณสามารถใช้ตัวเลือกนี้เพื่อถือว่าช่วงที่อยู่สาธารณะบางช่วงที่อาจใช้ภายในเป็น \"ในระบบ\" เพื่อให้ได้รับการปกป้องโดยการตรวจสอบ Local Network Access\n\nการลบล้างพื้นที่ที่อยู่ IP มี 2 รูปแบบดังนี้\n\n[cidr]=[public|local|loopback]\n\nโดยที่ [cidr] คือช่วงที่อยู่ IP ในรูปแบบ CIDR (ดูส่วนที่ 3.1 ของ https://tools.ietf.org/html/rfc4632 สำหรับ IPv4 และส่วนที่ 2.3 ของ https://tools.ietf.org/html/rfc4291 สำหรับ IPv6) ต้องระบุที่อยู่ IPv6 ในรูปแบบที่ปลอดภัยสำหรับ URL (อยู่ในวงเล็บ) การลบล้าง CIDR มีผลกับพอร์ตทั้งหมด\n\nหรือ\n\n[ip-address]:[port]=[public|local|loopback]\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับ Local Network Access ได้ที่ https://wicg.github.io/local-network-access/ และ https://developer.chrome.com/blog/local-network-access\n\nนโยบายนี้ไม่รองรับการรีเฟรชแบบไดนามิก\n\nการลบล้างจากการเปลี่ยนบรรทัดคำสั่ง --ip-address-space-overrides จะมีความสำคัญเหนือกว่าการลบล้างที่ตั้งค่าโดยนโยบายนี้";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "อนุญาตคำขอเข้าถึงเครือข่ายภายใน (LNA) ในเฟรมย่อยโดยที่ไม่มีการมอบสิทธิ์อย่างชัดเจน";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "โดยค่าเริ่มต้นแล้ว จะอนุญาตให้ขอสิทธิ์เข้าถึงเครือข่ายภายใน (LNA) ในเฟรมย่อยแบบข้ามต้นทางได้ต่อเมื่อมีการมอบสิทธิ์อย่างชัดเจนเท่านั้น นโยบายนี้ใช้เพื่อลบล้างลักษณะการทำงานเริ่มต้นนี้ โดยกำหนดค่าเริ่มต้นให้เฟรมย่อยรับช่วงสิทธิ์ LNA มา เว้นแต่จะมีการปฏิเสธอย่างชัดเจนในนโยบายสิทธิ์\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" เฟรมย่อยก็จะได้รับมอบสิทธิ์ฟีเจอร์นโยบายสิทธิ์ LNA ทั้งหมดโดยค่าเริ่มต้น และสามารถส่งคำขอเข้าถึงเครือข่ายภายในได้ (ซึ่งจะเรียกให้แสดงข้อความขออนุญาต)\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าไว้ เฟรมย่อยก็จำเป็นต้องได้รับมอบสิทธิ์ฟีเจอร์นโยบายสิทธิ์อย่างชัดเจน จึงจะสามารถส่งคำขอเข้าถึงเครือข่ายภายในและเรียกให้แสดงข้อความขออนุญาต\n\nนโยบายนี้จะใช้กับฟีเจอร์นโยบายสิทธิ์ \"local-network-access\", \"loopback-network\" และ \"local-network\"\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการเข้าถึงเครือข่ายภายในได้ที่ https://wicg.github.io/local-network-access/ และ https://developer.chrome.com/blog/local-network-access\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับนโยบายสิทธิ์ได้ที่ https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "ระบุว่าจะเลือกไม่ใช้ข้อจำกัดการเข้าถึงเครือข่ายภายใน (ชั่วคราว) หรือไม่";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "เมื่อตั้งค่านโยบายนี้เป็น \"เปิดใช้\" คำขอ Local Network Access จะแสดงคำเตือนใน Chrome DevTools เท่านั้นเนื่องจากการตรวจสอบ Local Network Access ล้มเหลว\n\nเมื่อตั้งค่านโยบายนี้เป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า คำขอ Local Network Access จะใช้การจัดการเริ่มต้นสำหรับคำขอเหล่านี้\n\nดูข้อจำกัดของ Local Network Access ได้ที่ https://wicg.github.io/local-network-access/\n\nนโยบายระดับองค์กรนี้เป็นนโยบายชั่วคราวและจะถูกนำออกหลังจาก M163\n\nในระยะยาว คุณสามารถใช้นโยบาย LocalNetworkAccessAllowedForUrls เพื่อสร้างรายการที่อนุญาตสำหรับรูปแบบ URL ที่ควรได้รับสิทธิ์ Local Network Access โดยอัตโนมัติ";
LocalNetworkAllowedForUrls.pfm_title = "อนุญาตให้เว็บไซต์ส่งคำขอเครือข่ายไปยังอุปกรณ์ปลายทางของเครือข่ายภายใน";
