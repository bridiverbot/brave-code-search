ManagedBookmarks.pfm_title = "บุ๊กมาร์กที่มีการจัดการ";
ManagedBookmarks.pfm_description = "การตั้งค่านโยบายนี้จะสร้างรายการบุ๊กมาร์กที่แต่ละรายการเป็นพจนานุกรมที่มีคีย์ \"name\" และ \"url\" คีย์เหล่านี้เก็บชื่อและเป้าหมายของบุ๊กมาร์กไว้ ผู้ดูแลระบบสร้างโฟลเดอร์ย่อยได้โดยกำหนดบุ๊กมาร์กที่ไม่มีคีย์ \"url\" แต่มีคีย์ \"children\" เพิ่มเติม คีย์นี้ยังมีรายการบุ๊กมาร์กด้วย ซึ่งบุ๊กมาร์กบางอันอาจเป็นโฟลเดอร์ด้วยก็ได้ Chrome จะแก้ไข URL ที่ไม่สมบูรณ์ให้เหมือนว่า URL เหล่านั้นได้รับการส่งผ่านทางแถบที่อยู่ เช่น \"google.com\" จะเปลี่ยนเป็น \"https://google.com/\"\n\nผู้ใช้เปลี่ยนโฟลเดอร์ที่บุ๊กมาร์กอยู่ไม่ได้ (แต่ซ่อนโฟลเดอร์จากแถบบุ๊กมาร์กได้) ชื่อโฟลเดอร์เริ่มต้นของบุ๊กมาร์กที่มีการจัดการคือ \"บุ๊กมาร์กที่มีการจัดการ\" แต่ก็เปลี่ยนได้โดยเพิ่มพจนานุกรมย่อยใหม่ที่มีคีย์เดียวชื่อ \"toplevel_name\" ลงในนโยบาย โดยมีชื่อโฟลเดอร์ที่ต้องการเป็นค่า บุ๊กมาร์กที่มีการจัดการจะไม่ซิงค์กับบัญชีผู้ใช้และส่วนขยายจะแก้ไขบุ๊กมาร์กเหล่านี้ไม่ได้\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=ManagedBookmarks";
ManagedConfigurationPerOrigin.pfm_title = "ตั้งค่าการกำหนดค่าที่มีการจัดการสำหรับต้นทางที่เจาะจงของเว็บไซต์";
ManagedConfigurationPerOrigin.pfm_description = "การตั้งค่านโยบายนี้จะกำหนดค่าส่งคืนของ Managed Configuration API สำหรับต้นทางนั้น\n\n Managed Configuration API คือการกำหนดค่าคีย์-ค่าที่เข้าถึงผ่านการเรียกใช้ JavaScript navigator.managed.getManagedConfiguration() ได้ API นี้ใช้ได้เฉพาะกับต้นทางที่สอดคล้องกับเว็บแอปพลิเคชันที่บังคับติดตั้งแล้วผ่าน WebAppInstallForceList\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin";
MaxConnectionsPerProxy.pfm_title = "จำนวนสูงสุดของการเชื่อมต่อที่เกิดขึ้นพร้อมกันต่อพร็อกซีเซิร์ฟเวอร์สำหรับคำขอที่ไม่ใช่ WebSocket";
MaxConnectionsPerProxy.pfm_description = "การตั้งค่านโยบายจะระบุจำนวนการเชื่อมต่อที่เกิดขึ้นพร้อมกันสูงสุดต่อพร็อกซีเซิร์ฟเวอร์สำหรับคำขอที่ไม่ใช่ WebSocket\n\nหากต้องการแก้ไขขีดจำกัดคำขอ WebSocket โปรดดูที่ MaxConnectionsPerProxyForWebSocket\n\nการไม่ตั้งค่านโยบายจะทำให้ระบบใช้ค่าเริ่มต้นที่ 128\n\nเว็บแอปบางรายการนั้นเป็นที่ทราบว่าต้องใช้การเชื่อมต่อจำนวนมากเนื่องจากใช้ Hanging GET การตั้งค่าที่ต่ำกว่า 128 จึงอาจส่งผลให้การเชื่อมโยงเครือข่ายของเบราว์เซอร์ค้างได้ในกรณีที่เปิดเว็บแอปที่ใช้การเชื่อมต่อ Hanging เป็นจำนวนมากเกินไป\nบางพร็อกซีเซิร์ฟเวอร์จัดการการเชื่อมต่อที่เกิดขึ้นพร้อมกันจำนวนมากต่อไคลเอ็นต์ไม่ได้ ปัญหานี้แก้ไขได้โดยการตั้งค่านโยบายนี้ให้มีค่าต่ำลง\n\nค่าควรเท่ากับหรือมากกว่า 6\nการตั้งค่าที่ต่ำกว่าขีดจำกัดดังกล่าวจะทำให้ระบบใช้ค่า 6\nคุณต้องยอมรับความเสี่ยงเองหากตั้งค่าต่ำกว่าค่าเริ่มต้น (128)\n\nค่าควรเท่ากับหรือต่ำกว่า 256 (99 ใน Brave 147 และเวอร์ชันก่อนหน้า)\nการตั้งค่าที่สูงกว่าขีดจำกัดดังกล่าวจะทำให้ระบบใช้ค่า 256 (99 ใน Brave 147 และเวอร์ชันก่อนหน้า)\nคุณต้องยอมรับความเสี่ยงเองหากตั้งค่าให้สูงกว่าค่าเริ่มต้น (128)\n\nโปรดทราบว่าขีดจำกัดที่บังคับใช้ได้รับผลกระทบจาก AllowSocketPoolSizeRandomizationForProxies";
MaxConnectionsPerProxyForWebSocket.pfm_title = "จำนวนสูงสุดของการเชื่อมต่อที่เกิดขึ้นพร้อมกันต่อพร็อกซีเซิร์ฟเวอร์สำหรับคำขอ WebSocket";
MaxConnectionsPerProxyForWebSocket.pfm_description = "การตั้งค่านโยบายจะระบุจำนวนการเชื่อมต่อที่เกิดขึ้นพร้อมกันสูงสุดต่อพร็อกซีเซิร์ฟเวอร์สำหรับคำขอ WebSocket\n\nหากต้องการแก้ไขขีดจำกัดคำขอที่ไม่ใช่ WebSocket โปรดดูที่ MaxConnectionsPerProxy\n\nการไม่ตั้งค่านโยบายจะทำให้ระบบใช้ค่าเริ่มต้นที่ 128\n\nเว็บแอปบางรายการนั้นเป็นที่ทราบว่าต้องใช้การเชื่อมต่อจำนวนมากเนื่องจากใช้ Hanging GET การตั้งค่าที่ต่ำกว่า 128 จึงอาจส่งผลให้การเชื่อมโยงเครือข่ายของเบราว์เซอร์ค้างได้ในกรณีที่เปิดเว็บแอปที่ใช้การเชื่อมต่อ Hanging เป็นจำนวนมากเกินไป\nบางพร็อกซีเซิร์ฟเวอร์จัดการการเชื่อมต่อที่เกิดขึ้นพร้อมกันจำนวนมากต่อไคลเอ็นต์ไม่ได้ ปัญหานี้แก้ไขได้โดยการตั้งค่านโยบายนี้ให้มีค่าต่ำลง\n\nค่าควรเท่ากับหรือมากกว่า 6\nการตั้งค่าที่ต่ำกว่าขีดจำกัดดังกล่าวจะทำให้ระบบใช้ค่า 6\nคุณต้องยอมรับความเสี่ยงเองหากตั้งค่าต่ำกว่าค่าเริ่มต้น (128)\n\nค่าควรเท่ากับหรือต่ำกว่า 256\nการตั้งค่าที่สูงกว่าขีดจำกัดดังกล่าวจะทำให้ระบบใช้ค่า 256\nคุณต้องยอมรับความเสี่ยงเองหากตั้งค่าให้สูงกว่าค่าเริ่มต้น (128)\n\nโปรดทราบว่าขีดจำกัดที่บังคับใช้ได้รับผลกระทบจาก AllowSocketPoolSizeRandomizationForProxies";
MaxInvalidationFetchDelay.pfm_title = "การหน่วงเวลาสูงสุดในการดึงข้อมูลภายหลังการลบล้างนโยบาย";
MaxInvalidationFetchDelay.pfm_description = "การตั้งค่านโยบายจะระบุการหน่วงเวลาสูงสุดเป็นมิลลิวินาทีสำหรับช่วงเวลาระหว่างการรับข้อมูลการลบล้างนโยบายและการดึงข้อมูลนโยบายใหม่จากบริการจัดการอุปกรณ์ ค่าที่ใช้ได้จะอยู่ในช่วง 1,000 (1 วินาที) ถึง 300,000 (5 นาที) ค่าที่ไม่ได้อยู่ในช่วงนี้จะถูกบีบให้อยู่ภายในขอบเขตที่เกี่ยวข้อง\n\nการไม่ตั้งค่านโยบายจะทำให้ Brave ใช้ค่าเริ่มต้นเป็น 10 วินาที";
MediaRecommendationsEnabled.pfm_title = "เปิดใช้คำแนะนำสื่อ";
MediaRecommendationsEnabled.pfm_description = "โดยค่าเริ่มต้น เบราว์เซอร์จะแสดงคำแนะนำสื่อที่มีการปรับเปลี่ยนในแบบของผู้ใช้ การตั้งค่านโยบายนี้เป็น \"ปิดใช้\" จะทำให้ระบบซ่อนคำแนะนำเหล่านี้ไม่ให้ผู้ใช้เห็น การตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้ระบบแสดงคำแนะนำสื่อต่อผู้ใช้";
MediaRouterCastAllowAllIPs.pfm_title = "อนุญาตให้ Google Cast เชื่อมต่อกับอุปกรณ์แคสต์ในที่อยู่ IP ทั้งหมด";
MediaRouterCastAllowAllIPs.pfm_description = "นอกจากจะตั้งค่า EnableMediaRouter เป็น \"ปิดใช้\" การตั้งค่า MediaRouterCastAllowAllIPs เป็น \"เปิดใช้\" จะเชื่อมต่อ Google Cast กับอุปกรณ์แคสต์ในทุกที่อยู่ IP ไม่ใช่แค่ที่อยู่ส่วนตัว RFC1918/RFC4193\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะเชื่อมต่อ Google Cast กับอุปกรณ์แคสต์เฉพาะในที่อยู่ RFC1918/RFC4193 เท่านั้น\n\nการไม่ตั้งค่านโยบายจะเชื่อมต่อ Google Cast กับอุปกรณ์แคสต์เฉพาะในที่อยู่ RFC1918/RFC4193 เท่านั้น เว้นเสียแต่ว่ามีการเปิดใช้ฟีเจอร์ CastAllowAllIPs";
MemorySaverModeSavings.pfm_title = "เปลี่ยนการประหยัดหน่วยความจำในโหมดประหยัดหน่วยความจำ";
MemorySaverModeSavings.pfm_description = "0 - ประหยัดหน่วยความจำได้ปานกลาง\n1 - ประหยัดหน่วยความจำได้อย่างสมดุล\n2 - ประหยัดหน่วยความจำได้สูงสุด\nนโยบายนี้จะเปลี่ยนระดับการประหยัดหน่วยความจำของโหมดประหยัดหน่วยความจำ\n\nนโยบายนี้จะมีผลก็ต่อเมื่อเปิดใช้โหมดประหยัดหน่วยความจําผ่านการตั้งค่าหรือนโยบาย HighEfficiencyModeEnabled และจะมีผลกับวิธีที่ใช้การคาดการณ์เพื่อกําหนดเวลาที่จะทิ้งแท็บ ตัวอย่างเช่น การลดอายุการใช้งานของแท็บที่ไม่ได้ใช้งานก่อนที่จะทิ้งแท็บจะช่วยประหยัดหน่วยความจำได้ แต่ก็หมายความว่าจะมีการโหลดซ้ำแท็บต่างๆ บ่อยขึ้น ซึ่งอาจทำให้ผู้ใช้ได้รับประสบการณ์ที่ไม่ดีและส่งผลให้การจราจรของข้อมูลในเครือข่ายเพิ่มขึ้น\n\nการตั้งค่านโยบายเป็น 0 - โหมดประหยัดหน่วยความจำจะประหยัดหน่วยความจำได้ปานกลาง แท็บจะไม่ทำงานหลังจากผ่านช่วงระยะเวลาที่นานขึ้น\n\nการตั้งค่านโยบายเป็น 1 - โหมดประหยัดหน่วยความจำจะประหยัดหน่วยความจำได้อย่างสมดุล แท็บจะไม่ทำงานหลังจากผ่านช่วงระยะเวลาที่เหมาะสม\n\nการตั้งค่านโยบายเป็น 2 - โหมดประหยัดหน่วยความจำจะประหยัดหน่วยความจำได้สูงสุด แท็บจะไม่ทำงานหลังจากผ่านช่วงระยะเวลาที่สั้นลง\n\nหากไม่ได้ตั้งค่านโยบายนี้ ผู้ใช้ปลายทางจะควบคุมการตั้งค่านี้ได้ใน chrome://settings/performance";
MetricsReportingEnabled.pfm_title = "เปิดใช้งานการรายงานการใช้และข้อมูลเกี่ยวกับการขัดข้อง";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "แสดงการ์ดในหน้าแท็บใหม่";
NTPCardsVisible.pfm_description = "นโยบายนี้จะควบคุมการแสดงการ์ดในหน้าแท็บใหม่ การ์ดจะแสดงจุดเข้าใช้งานเพื่อเริ่มการเข้าชมทั่วไปของผู้ใช้โดยอิงตามพฤติกรรมการท่องเว็บของผู้ใช้\n\nหากตั้งค่านโยบายเป็น \"เปิดใช้\" หน้าแท็บใหม่จะแสดงการ์ดหากมีเนื้อหา\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" หน้าแท็บใหม่จะไม่แสดงการ์ด\n\nหากไม่ได้ตั้งค่านโยบาย ผู้ใช้จะควบคุมการแสดงการ์ดได้ ค่าเริ่มต้นคือแสดงการ์ด\n";
NTPCustomBackgroundEnabled.pfm_title = "อนุญาตให้ผู้ใช้ปรับแต่งพื้นหลังในหน้าแท็บใหม่";
NTPCustomBackgroundEnabled.pfm_description = "หากตั้งค่านโยบายนี้เป็น \"เท็จ\" หน้าแท็บใหม่จะไม่อนุญาตให้ผู้ใช้ปรับแต่งพื้นหลัง ระบบจะนำพื้นหลังที่กำหนดเองที่มีอยู่ทั้งหมดออกอย่างถาวร แม้จะมีการตั้งค่านโยบายเป็น \"จริง\" ในภายหลัง\n\nหากตั้งค่านโยบายเป็น \"จริง\" หรือไม่ได้ตั้งค่า ผู้ใช้จะปรับแต่งพื้นหลังในหน้าแท็บใหม่ได้\n\nหมายเหตุ: ใน Android นโยบายจะมีผลกับเบราว์เซอร์หลังจากรีสตาร์ทเท่านั้น";
NTPFooterExtensionAttributionEnabled.pfm_title = "ควบคุมการแสดงที่มาของส่วนขยายในหน้าแท็บใหม่";
NTPFooterExtensionAttributionEnabled.pfm_description = "นโยบายนี้กำหนดว่าจะแสดงที่มาของส่วนขยายซึ่งแก้ไขหน้าแท็บใหม่ (NTP) ในส่วนท้ายของ NTP หรือไม่\n\nโดยค่าเริ่มต้น หากส่วนขยายลบล้าง NTP มาตรฐาน ข้อความที่ระบุถึงส่วนขยายที่ทำให้เกิดการเปลี่ยนแปลงนี้จะปรากฏในส่วนท้าย ปกติแล้วการแสดงที่มานี้จะมีลิงก์ไปยังส่วนขยายที่เกี่ยวข้องใน Chrome เว็บสโตร์\n\nหากไม่ได้ตั้งค่านโยบายนี้หรือตั้งค่าเป็น \"จริง\" การแสดงที่มาของส่วนขยายจะปรากฏในส่วนท้ายของ NTP เมื่อส่วนขยายควบคุม NTP\n\nหากตั้งค่านโยบายนี้เป็น \"เท็จ\" ระบบจะระงับการแสดงที่มาของส่วนขยายในส่วนท้ายของ NTP";
NTPFooterManagementNoticeEnabled.pfm_title = "ควบคุมการมองเห็นประกาศการจัดการในหน้าแท็บใหม่สำหรับเบราว์เซอร์ที่มีการจัดการ";
NTPFooterManagementNoticeEnabled.pfm_description = "นโยบายนี้ควบคุมการแสดงประกาศการจัดการในส่วนท้ายของหน้าแท็บใหม่ (NTP) โดยค่าเริ่มต้น ส่วนท้ายของ NTP จะแสดงข้อมูลเมื่อเบราว์เซอร์ได้รับการจัดการโดยองค์กร (ระบุด้วยไอคอนอาคารและ \"จัดการโดย [ชื่อโดเมน]\") สามารถกำหนดเองได้โดยใช้นโยบาย EnterpriseCustomLabelForBrowser และ EnterpriseLogoUrlForBrowser\n\nหากไม่ได้ตั้งค่านโยบายนี้หรือตั้งค่าเป็น \"จริง\" เบราว์เซอร์ที่มีการจัดการจะแสดงประกาศ \"จัดการโดย…\" พร้อมไอคอน\n\nหากตั้งค่านโยบายนี้เป็น \"เท็จ\" ระบบจะซ่อนประกาศการจัดการ\n\nโปรดทราบว่านโยบายนี้มีผลกับเบราว์เซอร์ที่มีการจัดการเท่านั้น ดังนั้นจะไม่มีผลกับผู้ใช้ที่มีการจัดการในเบราว์เซอร์ที่ไม่มีการจัดการ\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
NTPOutlookCardVisible.pfm_title = "แสดงการ์ดปฏิทิน Outlook ในหน้าแท็บใหม่";
NTPOutlookCardVisible.pfm_description = "นโยบายนี้ควบคุมการแสดงการ์ด Outlook ในหน้าแท็บใหม่ การ์ดดังกล่าวจะแสดงในหน้าแท็บใหม่ก็ต่อเมื่อมีการเปิดใช้นโยบายดังกล่าวและองค์กรให้สิทธิ์ในการใช้งานข้อมูลปฏิทิน Outlook ในเบราว์เซอร์\n\nเบราว์เซอร์จะไม่จัดเก็บข้อมูล Outlook\n\nการ์ด Outlook แสดงกิจกรรมถัดไปในปฏิทิน พร้อมทั้งให้คุณดูข้อมูลการประชุมที่เหลือของวันได้อย่างรวดเร็ว การ์ดนี้มีจุดประสงค์เพื่อแก้ปัญหาการเปลี่ยนบริบทและเพิ่มประสิทธิภาพการทำงานโดยให้ทางลัดไปยังการประชุมครั้งถัดไปแก่ผู้ใช้\n\nการ์ด Microsoft Outlook จะต้องมีการกำหนดค่าเพิ่มเติมโดยผู้ดูแลระบบ ดูข้อมูลโดยละเอียดเกี่ยวกับการเชื่อมต่อการ์ดในหน้าแท็บใหม่ของ Chrome กับ Outlook ได้ที่ https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards\n\nหากปิดใช้ NTPCardsVisible ไว้ การ์ด Outlook จะไม่แสดง หากเปิดใช้ NTPCardsVisible ไว้ การ์ด Outlook จะแสดงขึ้นหากมีการเปิดใช้นโยบายนี้ด้วยและมีข้อมูลที่จะแสดง หากไม่ได้ตั้งค่า NTPCardsVisible ไว้ การ์ด Outlook จะแสดงหากมีการเปิดใช้นโยบายนี้ด้วย ผู้ใช้ได้เปิดใช้การ์ดดังกล่าวใน \"ปรับแต่ง Chrome\" รวมทั้งมีข้อมูลที่จะแสดง";
NTPSharepointCardVisible.pfm_title = "แสดงการ์ดไฟล์ SharePoint และ OneDrive ในหน้าแท็บใหม่";
NTPSharepointCardVisible.pfm_description = "นโยบายนี้ควบคุมการแสดงการ์ดไฟล์ SharePoint และ OneDrive ในหน้าแท็บใหม่ การ์ดนี้จะแสดงในหน้าแท็บใหม่ก็ต่อเมื่อมีการเปิดใช้นโยบายดังกล่าวและองค์กรให้สิทธิ์ในการใช้งานข้อมูลไฟล์ SharePoint และ OneDrive ในเบราว์เซอร์\n\nเบราว์เซอร์จะไม่จัดเก็บข้อมูล SharePoint และ OneDrive\n\nการ์ดคำแนะนำเกี่ยวกับไฟล์ SharePoint และ OneDrive จะแสดงรายการไฟล์ที่แนะนำ  การ์ดนี้มีจุดประสงค์เพื่อแก้ปัญหาการเปลี่ยนบริบทและเพิ่มประสิทธิภาพการทำงานด้วยการให้ทางลัดแก่ผู้ใช้ในการไปยังเอกสารที่สำคัญที่สุดของตน\n\nการ์ด Microsoft SharePoint และ OneDrive จะต้องมีการกำหนดค่าเพิ่มเติมโดยผู้ดูแลระบบ ดูข้อมูลโดยละเอียดเกี่ยวกับการเชื่อมต่อการ์ดในหน้าแท็บใหม่ของ Chrome กับ Sharepoint ได้ที่ https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards\n\nหากปิดใช้ NTPCardsVisible ไว้ การ์ด SharePoint และ OneDrive จะไม่แสดง หากเปิดใช้ NTPCardsVisible ไว้ การ์ด SharePoint และ OneDrive จะแสดงขึ้นหากมีการเปิดใช้นโยบายนี้ด้วยและมีข้อมูลที่จะแสดง หากไม่ได้ตั้งค่า NTPCardsVisible ไว้ การ์ด SharePoint และ OneDrive จะแสดงหากมีการเปิดใช้นโยบายนี้ด้วย ผู้ใช้ได้เปิดใช้การ์ดดังกล่าวใน \"ปรับแต่ง Chrome\" รวมทั้งมีข้อมูลที่จะแสดง";
NTPShortcuts.pfm_title = "การตั้งค่าทางลัดในหน้าแท็บใหม่";
NTPShortcuts.pfm_description = "การตั้งค่านโยบายจะกำหนดค่าทางลัดที่กำหนดเองไว้ล่วงหน้าสูงสุด 10 รายการในหน้าแท็บใหม่ของ Brave\n\nหากตั้งค่าไว้ ผู้ใช้จะเห็นทางลัดเหล่านี้โดยค่าเริ่มต้น นอกเหนือจากทางลัดส่วนตัว ผู้ใช้สามารถควบคุมระดับการมองเห็นทางลัดขององค์กรได้ในแผง \"ปรับแต่ง Chrome\"\n\nURL ทางลัดต้องไม่ซ้ำกัน\n\nหากตั้งค่า allow_user_edit เป็น \"จริง\" ผู้ใช้จะเปลี่ยนชื่อทางลัดได้ หากตั้งค่าเป็น \"เท็จ\" หรือไม่ได้ตั้งค่า ผู้ใช้จะแก้ไขชื่อไม่ได้\n\nหากตั้งค่า allow_user_delete เป็น \"จริง\" ผู้ใช้จะนำทางลัดออกได้ หากตั้งค่าเป็น \"เท็จ\" หรือไม่ได้ตั้งค่า ผู้ใช้จะนำทางลัดออกไม่ได้\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=NTPShortcuts";
NativeMessagingAllowlist.pfm_title = "ชื่อของโฮสต์การรับส่งข้อความดั้งเดิมที่จะยกเว้นจากรายการที่บล็อก";
NativeMessagingAllowlist.pfm_description = "การตั้งค่านโยบายจะระบุโฮสต์การรับส่งข้อความดั้งเดิมที่ไม่อยู่ในรายการปฏิเสธ ค่ารายการปฏิเสธ \"*\" จะทำให้โฮสต์การรับส่งข้อความดั้งเดิมทั้งหมดถูกปฏิเสธ เว้นแต่จะได้รับอนุญาตอย่างชัดแจ้ง\n\nระบบจะอนุญาตโฮสต์การรับส่งข้อความดั้งเดิมทั้งหมดโดยค่าเริ่มต้น แต่หากนโยบายปฏิเสธโฮสต์การรับส่งข้อความดั้งเดิมทั้งหมด ผู้ดูแลระบบจะใช้รายการอนุญาตเพื่อเปลี่ยนนโยบายนั้นได้";
NativeMessagingBlocklist.pfm_title = "ชื่อของโฮสต์การรับส่งข้อความดั้งเดิมต้องห้าม (หรือ * สำหรับทั้งหมด)";
NativeMessagingBlocklist.pfm_description = "การตั้งค่านโยบายจะระบุโฮสต์การรับส่งข้อความดั้งเดิมที่ระบบไม่ควรโหลด ค่ารายการปฏิเสธ \"*\" จะทำให้โฮสต์การรับส่งข้อความดั้งเดิมทั้งหมดถูกปฏิเสธ เว้นแต่จะได้รับอนุญาตอย่างชัดแจ้ง\n\nการไม่ตั้งค่านโยบายจะทำให้ Brave โหลดโฮสต์การรับส่งข้อความดั้งเดิมที่ติดตั้งไว้ทั้งหมด";
NativeMessagingUserLevelHosts.pfm_title = "อนุญาตให้ใช้โฮสต์การรับส่งข้อความดั้งเดิมระดับผู้ใช้ (ติดตั้งโดยไม่มีสิทธิ์ของผู้ดูแลระบบ)";
NativeMessagingUserLevelHosts.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้ Brave ใช้โฮสต์การรับส่งข้อความดั้งเดิมที่ติดตั้งไว้ที่ระดับผู้ใช้ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ Brave ใช้โฮสต์เหล่านี้ได้เฉพาะเมื่อติดตั้งไว้ที่ระดับระบบเท่านั้น";
NetworkPredictionOptions.pfm_title = "เปิดใช้งานการคาดการณ์เครือข่าย";
NetworkPredictionOptions.pfm_description = "0 - คาดการณ์การทำงานของเครือข่ายจากการเชื่อมต่อเครือข่ายต่างๆ\n1 - คาดคะเนการทำงานของเครือข่ายบนเครือข่ายต่างๆ ที่ไม่ใช่เครือข่ายมือถือ\n(เลิกใช้งานใน 50, นำออกใน 52 หลังจาก 52 หากมีการกำหนดค่า 1 ระบบจะถือว่าเป็นค่า 0 - คาดคะเนการทำงานของเครือข่ายบนการเชื่อมต่อเครือข่ายต่างๆ)\n2 - อย่าคาดการณ์การทำงานของเครือข่ายจากการเชื่อมต่อเครือข่ายใดๆ\nนโยบายนี้ควบคุมการคาดคะเนเครือข่ายใน Brave โดยจะควบคุมการดึงข้อมูล DNS ล่วงหน้า, TCP, การเชื่อมต่อ SSL ล่วงหน้า และการแสดงผลหน้าเว็บล่วงหน้า\n\nหากคุณตั้งค่านโยบายไว้ ผู้ใช้จะเปลี่ยนไม่ได้ การไม่ตั้งค่าจะเปิดการคาดคะเนเครือข่าย แต่ผู้ใช้เปลี่ยนได้";
NewTabPageLocation.pfm_title = "URL หน้าแท็บใหม่";
NewTabPageLocation.pfm_description = "การตั้งค่านโยบายจะกำหนดค่า URL หน้าแท็บใหม่เริ่มต้นและป้องกันไม่ให้ผู้ใช้เปลี่ยนแปลงหน้าดังกล่าว\n\nหน้าแท็บใหม่จะเปิดขึ้นโดยมีแท็บและหน้าต่างใหม่\n\nนโยบายนี้ไม่ได้กำหนดว่าหน้าใดจะเปิดขึ้นมาเมื่อเริ่มต้นใช้งาน นโยบาย RestoreOnStartup จะเป็นตัวควบคุมหน้าเหล่านั้น นโยบายนี้จะส่งผลกระทบต่อหน้าแรก หากตั้งค่าหน้าแรกให้เปิดหน้าแท็บใหม่ และจะส่งผลกระทบต่อหน้าเริ่มต้นใช้งานเช่นกัน หากตั้งค่าให้เปิดหน้าแท็บใหม่\n\nแนวทางปฏิบัติแนะนำคือการระบุ URL ที่กำหนดหน้า Canonical แบบเต็ม หาก URL ไม่ได้กำหนดหน้า Canonical แบบเต็ม Brave จะใช้ https:// เป็นค่าเริ่มต้น\n\nการไม่ตั้งค่านโยบายหรือปล่อยว่างไว้จะทำให้ระบบใช้หน้าแท็บใหม่เริ่มต้น\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
NotificationsAllowedForUrls.pfm_title = "อนุญาตการแจ้งเตือนในไซต์เหล่านี้";
NotificationsAllowedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่แสดงการแจ้งเตือนได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultNotificationsSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
NotificationsBlockedForUrls.pfm_title = "บล็อกการแจ้งเตือนในไซต์เหล่านี้";
NotificationsBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่แสดงการแจ้งเตือนไม่ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultNotificationsSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
NtlmV2Enabled.pfm_title = "เปิดใช้การตรวจสอบสิทธิ์ NTLMv2";
NtlmV2Enabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า จะเปิด NTLMv2\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิด NTLMv2\n\nเซิร์ฟเวอร์ Samba และ Microsoft® Windows® เวอร์ชันล่าสุดทั้งหมดรองรับ NTLMv2 ควรปิดใช้การตั้งค่านี้เฉพาะเมื่อต้องการความเข้ากันได้แบบย้อนหลังเท่านั้น เพราะการปิดใช้จะทำให้ความปลอดภัยในการตรวจสอบสิทธิ์ลดลง";
OopPrintDriversAllowed.pfm_title = "อนุญาตไดรเวอร์การพิมพ์นอกกระบวนการ";
OopPrintDriversAllowed.pfm_description = "ควบคุมว่าจะให้ Brave โต้ตอบกับไดรเวอร์เครื่องพิมพ์จากกระบวนการของบริการที่แยกต่างหากหรือไม่ การเรียกใช้การพิมพ์ของแพลตฟอร์มเพื่อค้นหาเครื่องพิมพ์ที่พร้อมใช้งาน รับการตั้งค่าไดรเวอร์การพิมพ์ และส่งเอกสารไปพิมพ์ที่เครื่องพิมพ์ในพื้นที่จะมาจากกระบวนการของบริการ การย้ายการเรียกใช้ดังกล่าวออกจากกระบวนการของเบราว์เซอร์จะช่วยปรับปรุงความเสถียรและลดลักษณะการทำงานของ UI ที่ค้างในตัวอย่างก่อนพิมพ์\n\nเมื่อตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า Brave จะใช้กระบวนการของบริการที่แยกต่างหากสำหรับงานพิมพ์ของแพลตฟอร์ม\n\nเมื่อตั้งค่านโยบายนี้เป็น \"ปิดใช้\" Brave จะใช้กระบวนการของเบราว์เซอร์สำหรับงานพิมพ์ของแพลตฟอร์ม\n\nเราจะนำนโยบายนี้ออกในอนาคต หลังจากที่เปิดตัวฟีเจอร์ไดรเวอร์การพิมพ์นอกกระบวนการโดยสมบูรณ์แล้ว";
OriginAgentClusterDefaultEnabled.pfm_title = "อนุญาตการสร้างคลัสเตอร์ Agent ที่ผูกกับต้นทางโดยค่าเริ่มต้น";
OriginAgentClusterDefaultEnabled.pfm_description = "นโยบายนี้อนุญาตการสร้างคลัสเตอร์ Agent ที่ผูกกับต้นทางโดยค่าเริ่มต้น\n\nส่วนหัว HTTP Origin-Agent-Cluster จะควบคุมว่าเอกสารจะถูกแยกไว้ในคลัสเตอร์ Agent ที่ผูกกับต้นทาง หรือในคลัสเตอร์ Agent ที่ผูกกับเว็บไซต์ ซึ่งจะมีนัยด้านความปลอดภัย เนื่องจากคลัสเตอร์ Agent ที่ผูกกับต้นทางอนุญาตให้แยกเอกสารตามต้นทางได้ ผลที่ตามมาที่นักพัฒนาซอฟต์แวร์จะมองเห็นคือตัวช่วยเข้าถึง document.domain จะตั้งค่าไม่ได้อีก\n\nลักษณะการทำงานเริ่มต้น (เมื่อไม่ได้ตั้งค่าส่วนหัว Origin-Agent-Cluster ไว้) ใน M111 จะเปลี่ยนจากผูกกับเว็บไซต์ไปเป็นผูกกับต้นทาง\n\nหากเปิดใช้นโยบายนี้หรือไม่ได้ตั้งค่า เบราว์เซอร์จะทำตามค่าเริ่มต้นใหม่จากเวอร์ชันดังกล่าวเป็นต้นไป\n\nหากปิดใช้นโยบาย การเปลี่ยนแปลงนี้จะย้อนกลับและเอกสารที่ไม่มีส่วนหัว Origin-Agent-Cluster จะได้รับการกำหนดให้กับคลัสเตอร์ Agent ที่ผูกกับเว็บไซต์ ผลที่ตามมาคือตัวช่วยเข้าถึง document.domain จะยังคงตั้งค่าได้อยู่โดยค่าเริ่มต้น ซึ่งจะตรงกันกับลักษณะการทำงานเดิม\n\nดูรายละเอียดเพิ่มเติมได้ที่ https://developer.chrome.com/blog/immutable-document-domain/";
OriginKeyedProcessesEnabled.pfm_title = "เปิดใช้การแยกกระบวนการที่ผูกกับต้นทางโดยค่าเริ่มต้น";
OriginKeyedProcessesEnabled.pfm_description = "เปิดใช้การแยกกระบวนการที่ผูกกับต้นทางสำหรับหน้าเว็บส่วนใหญ่ (เช่น หน้าเว็บที่กำหนดให้กับคลัสเตอร์ Agent ที่ผูกกับต้นทางโดยค่าเริ่มต้น) ซึ่งจะช่วยเพิ่มความปลอดภัย แต่ก็เพิ่มจำนวนกระบวนการที่สร้างขึ้นด้วย ผู้ใช้ได้รับอนุญาตให้ลบล้างค่าของนโยบายที่ตั้งไว้ผ่าน Flag บรรทัดคำสั่งหรือ chrome://flags (ทั้งเพื่อเปิดหรือปิดฟีเจอร์นี้)\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" จะทำให้ต้นทางส่วนใหญ่ถูกแยก แม้จากต้นทางอื่นๆ ในเว็บไซต์เดียวกัน โปรดดูนโยบาย IsolateOrigins และ SitePerProcess ด้วย\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ไม่มีการแยกต้นทางออกจากส่วนที่เหลือของเว็บไซต์ เว้นแต่ต้นทางจะขอให้แยกอย่างชัดแจ้ง\n\nการไม่ตั้งค่านโยบายจะทำให้เบราว์เซอร์เป็นผู้กำหนดต้นทางที่จะแยกและเวลาที่จะแยก";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "ต้นทางหรือรูปแบบชื่อโฮสต์ที่จะไม่ใช้ข้อจำกัดกับต้นทางที่ไม่ปลอดภัย";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "การตั้งค่านโยบายจะระบุรายการของต้นทาง (URL) หรือรูปแบบชื่อโฮสต์ (เช่น *.example.com) ที่จะไม่ใช้ข้อจำกัดด้านความปลอดภัยกับต้นทางที่ไม่ปลอดภัย รูปแบบใช้ได้กับชื่อโฮสต์เท่านั้น URL/ต้นทางที่มีรูปแบบต้องตรงกับสตริง องค์กรอาจระบุต้นทางของแอปพลิเคชันเดิมที่ใช้งาน TLS ไม่ได้ หรือกำหนดเซิร์ฟเวอร์ชั่วคราวสำหรับการพัฒนาเว็บภายในเพื่อให้นักพัฒนาซอฟต์แวร์ทดสอบฟีเจอร์ที่ต้องใช้บริบทที่ปลอดภัยโดยไม่ต้องทำให้ TLS ใช้งานได้ในเซิร์ฟเวอร์ชั่วคราว นโยบายนี้ยังป้องกันไม่ให้ระบบติดป้ายกำกับต้นทางว่า \"ไม่ปลอดภัย\" ในแถบที่อยู่ด้วย\n\nการกำหนดรายการ URL ในนโยบายนี้มีผลเหมือนกับการตั้งค่า Flag บรรทัดคำสั่ง --unsafely-treat-insecure-origin-as-secure เป็นรายการ URL เดียวกันที่คั่นด้วยคอมมา นโยบายจะลบล้าง Flag บรรทัดคำสั่งและ UnsafelyTreatInsecureOriginAsSecure (หากมี)\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับบริบทที่ปลอดภัยได้ที่ Secure Contexts (https://www.w3.org/TR/secure-contexts)";
PartitionedBlobUrlUsage.pfm_title = "เลือกว่าจะมีการแบ่งพาร์ติชัน URL ของ BLOB ในระหว่างการดึงข้อมูลและไปยังส่วนต่างๆ หรือไม่";
PartitionedBlobUrlUsage.pfm_description = "นโยบายนี้ควบคุมว่าจะมีการแบ่งพาร์ติชัน URL ของ BLOB ในระหว่างการดึงข้อมูลและไปยังส่วนต่างๆ หรือไม่\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ระบบจะแบ่งพาร์ติชัน URL ของ BLOB\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ระบบจะไม่แบ่งพาร์ติชัน URL ของ BLOB\n\nหากคุณต้องใช้นโยบาย โปรดรายงานข้อบกพร่องที่\nBrave\nโดยอธิบาย Use Case นโยบายนี้มีกำหนดเวลาที่จะให้บริการผ่าน\nBrave เวอร์ชัน 146\nซึ่งหลังจากนั้นระบบจะนำการใช้งานเดิมออก\n\nหมายเหตุ: เฉพาะกระบวนการแสดงผลที่เพิ่งเริ่มใหม่เท่านั้นที่จะแสดงการเปลี่ยนแปลงนโยบายนี้ขณะที่เบราว์เซอร์ทำงานอยู่\n\nดูข้อมูลโดยละเอียดเกี่ยวกับการแบ่งพาร์ติชันพื้นที่เก็บข้อมูลของบุคคลที่สามได้ใน https://developers.google.com/privacy-sandbox/cookies/storage-partitioning";
PasswordDismissCompromisedAlertEnabled.pfm_title = "เปิดใช้การปิดการแจ้งเตือนรหัสผ่านที่ถูกละเมิดสำหรับข้อมูลเข้าสู่ระบบที่ป้อน";
PasswordDismissCompromisedAlertEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ผู้ใช้มีตัวเลือกในการปิด/คืนค่าการแจ้งเตือนรหัสผ่านที่ถูกละเมิด\n\nหากปิดใช้การตั้งค่านี้ ผู้ใช้จะไม่สามารถปิดการแจ้งเตือนเกี่ยวกับรหัสผ่านที่ถูกละเมิด หากเปิดใช้ ผู้ใช้จะปิดการแจ้งเตือนเกี่ยวกับรหัสผ่านที่ถูกละเมิดได้";
PasswordLeakDetectionEnabled.pfm_title = "เปิดใช้นโยบายการตรวจหาการรั่วไหลของข้อมูลเข้าสู่ระบบที่ป้อน";
PasswordLeakDetectionEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" ช่วยให้ผู้ใช้สามารถให้ Brave ตรวจสอบว่าชื่อผู้ใช้และรหัสผ่านที่ป้อนรวมอยู่ในข้อมูลที่รั่วไหลด้วยหรือไม่\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ผู้ใช้ไม่สามารถใช้ฟังก์ชันนี้ได้\n\nหากตั้งค่านโยบายไว้ ผู้ใช้จะเปลี่ยนการตั้งค่าดังกล่าวใน Brave ไม่ได้ หากไม่ได้ตั้งค่า ระบบจะอนุญาตให้มีการตรวจสอบการรั่วไหลของข้อมูลเข้าสู่ระบบ แต่ผู้ใช้ปิดการตั้งค่านี้ได้";
PasswordManagerBlocklist.pfm_title = "กำหนดค่ารายการโดเมนที่จะปิดใช้ Password Manager (บันทึกและป้อนข้อมูล)";
PasswordManagerBlocklist.pfm_description = "กำหนดค่ารายการโดเมนที่ Brave ควรปิดใช้ Password Manager ซึ่งหมายความว่าระบบจะปิดใช้เวิร์กโฟลว์ \"บันทึกและป้อนข้อมูล\" เพื่อป้องกันไม่ให้บันทึกหรือป้อนรหัสผ่านของเว็บไซต์เหล่านั้นลงในแบบฟอร์มบนเว็บโดยอัตโนมัติ\n\nหากโดเมนอยู่ในรายการ ระบบจะปิดใช้ Password Manager สำหรับโดเมนนั้น\n\nหากโดเมนไม่อยู่ในรายการ Password Manager จะพร้อมใช้งานสำหรับโดเมนนั้น\n\nหากไม่ได้ตั้งค่านโยบาย Password Manager จะพร้อมใช้งานสำหรับโดเมนทั้งหมด\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่ https://support.google.com/chrome/a?p=url_blocklist_filter_format";
PasswordManagerEnabled.pfm_title = "เปิดการบันทึกรหัสผ่านไปยังโปรแกรมจัดการรหัสผ่าน";
PasswordManagerEnabled.pfm_description = "นโยบายนี้ควบคุมความสามารถของเบราว์เซอร์ในการจดจํารหัสผ่านในเว็บไซต์โดยอัตโนมัติ และบันทึกไว้ในเครื่องมือจัดการรหัสผ่านในตัว โดยไม่จํากัดสิทธิ์เข้าถึงหรือเปลี่ยนแปลงเนื้อหาของรหัสผ่านที่บันทึกไว้ในเครื่องมือจัดการรหัสผ่าน และอาจซิงค์กับโปรไฟล์บัญชี Google และ Android\n\nหากตั้งค่านโยบายเป็น \"เปิดใช้\" ผู้ใช้จะให้ Brave จดจำและบอกรหัสผ่านเมื่อลงชื่อเข้าใช้เว็บไซต์ครั้งต่อไปได้\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" ผู้ใช้จะบันทึกรหัสผ่านใหม่ไม่ได้ แต่รหัสผ่านที่บันทึกไว้ก่อนหน้านี้จะยังใช้ได้อยู่\n\nหากตั้งค่านโยบาย ผู้ใช้จะไปเปลี่ยนค่าใน Brave ไม่ได้ หากไม่ได้ตั้งค่า ผู้ใช้จะปิดการบันทึกรหัสผ่านได้";
PasswordManagerPasskeysEnabled.pfm_title = "เปิดการบันทึกพาสคีย์ไปยังโปรแกรมจัดการรหัสผ่าน";
PasswordManagerPasskeysEnabled.pfm_description = "นโยบายนี้ควบคุมความสามารถของเบราว์เซอร์ในการบันทึกพาสคีย์ในเครื่องมือจัดการรหัสผ่านในตัว โดยจะไม่จํากัดสิทธิ์เข้าถึงหรือเปลี่ยนแปลงเนื้อหาของพาสคีย์ที่บันทึกไว้ในเครื่องมือจัดการรหัสผ่านอยู่แล้ว หากตั้งค่านโยบาย PasswordManagerEnabled เป็น \"ปิดใช้\" ระบบจะปิดใช้การบันทึกในเครื่องมือจัดการรหัสผ่านในตัวซึ่งโดยทั่วไปแล้วรวมถึงพาสคีย์และรหัสผ่าน ดังนั้นนโยบายนี้จึงไม่เกี่ยวข้อง\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าหมายความว่าผู้ใช้จะบันทึกพาสคีย์ในเครื่องมือจัดการรหัสผ่านในตัวได้หากลงชื่อเข้าใช้ Brave\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" หมายความว่าผู้ใช้จะบันทึกพาสคีย์ลงในเครื่องมือจัดการรหัสผ่านในตัวไม่ได้ แต่พาสคีย์ที่บันทึกไว้ก่อนหน้านี้จะยังคงใช้ได้";
PasswordProtectionChangePasswordURL.pfm_title = "กำหนดค่า URL การเปลี่ยนรหัสผ่าน";
PasswordProtectionChangePasswordURL.pfm_description = "การตั้งค่านโยบายจะกำหนด URL ที่ให้ผู้ใช้ไปเปลี่ยนรหัสผ่านหลังจากเห็นคำเตือนในเบราว์เซอร์ บริการปกป้องรหัสผ่านจะส่งผู้ใช้ไปยัง URL (โปรโตคอล HTTP และ HTTPS เท่านั้น) ที่คุณกำหนดผ่านนโยบายนี้ โปรดตรวจสอบว่าหน้าเปลี่ยนรหัสผ่านของคุณเป็นไปตามหลักเกณฑ์เหล่านี้ ( https://www.chromium.org/developers/design-documents/create-amazing-password-forms ) เพื่อให้ Brave บันทึกแฮชที่ใช้ Salt ของรหัสผ่านใหม่ได้อย่างถูกต้องในหน้าเปลี่ยนรหัสผ่านนี้\n\nการปิดใช้นโยบายหรือไม่ได้ตั้งค่าจะทำให้บริการส่งผู้ใช้ไปที่ https://myaccount.google.com เพื่อเปลี่ยนรหัสผ่าน\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
PasswordProtectionLoginURLs.pfm_title = "กำหนดค่ารายการ URL สำหรับเข้าสู่ระบบขององค์กรที่บริการป้องกันด้วยรหัสผ่านควรบันทึกแฮชที่ใช้ Salt ของรหัสผ่าน";
PasswordProtectionLoginURLs.pfm_description = "การตั้งค่านโยบายจะกำหนดรายการ URL สำหรับเข้าสู่ระบบขององค์กร (โปรโตคอล HTTP และ HTTPS เท่านั้น) บริการปกป้องรหัสผ่านจะบันทึกแฮชที่ใช้ Salt ของรหัสผ่านใน URL เหล่านี้และนำไปใช้เพื่อตรวจหาการใช้รหัสผ่านซ้ำ โปรดตรวจสอบว่าหน้าลงชื่อเข้าใช้เป็นไปตามหลักเกณฑ์เหล่านี้ (https://www.chromium.org/developers/design-documents/create-amazing-password-forms) เพื่อให้ Brave บันทึกแฮชที่ใช้ Salt ของรหัสผ่านได้อย่างถูกต้อง\n\nการปิดการตั้งค่านี้หรือไม่ได้ตั้งค่าจะทำให้บริการปกป้องรหัสผ่านบันทึกแฮชที่ใช้ Salt ของรหัสผ่านใน https://accounts.google.com เท่านั้น\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
PasswordProtectionWarningTrigger.pfm_title = "ทริกเกอร์การแจ้งเตือนการป้องกันด้วยรหัสผ่าน";
PasswordProtectionWarningTrigger.pfm_description = "0 - การแจ้งเตือนการป้องกันด้วยรหัสผ่านปิดอยู่\n1 - เรียกใช้การแจ้งเตือนการป้องกันด้วยรหัสผ่านเมื่อมีการใช้รหัสผ่านซ้ำ\n2 - เรียกใช้การแจ้งเตือนการป้องกันด้วยรหัสผ่านเมื่อมีการใช้รหัสผ่านซ้ำบนหน้าฟิชชิง\nการตั้งค่านโยบายจะให้คุณควบคุมการแสดงคำเตือนของการปกป้องรหัสผ่าน การปกป้องรหัสผ่านจะแจ้งเตือนผู้ใช้เมื่อใช้รหัสผ่านที่มีการปกป้องซ้ำในเว็บไซต์ที่น่าสงสัย\n\nใช้ PasswordProtectionLoginURLs และ PasswordProtectionChangePasswordURL เพื่อระบุรหัสผ่านที่จะปกป้อง\n\nหากตั้งค่านโยบายนี้เป็น\n\n* PasswordProtectionWarningOff จะไม่มีการแสดงคำเตือนการปกป้องรหัสผ่าน\n\n* PasswordProtectionWarningOnPasswordReuse คำเตือนการปกป้องรหัสผ่านจะแสดงเมื่อผู้ใช้ใช้รหัสผ่านที่มีการปกป้องซ้ำในเว็บไซต์ที่ไม่อนุญาต\n\n* PasswordProtectionWarningOnPhishingReuse คำเตือนการปกป้องรหัสผ่านจะแสดงเมื่อผู้ใช้ใช้รหัสผ่านที่มีการปกป้องซ้ำในเว็บไซต์ฟิชชิง\n\nการไม่ตั้งค่านโยบายจะทำให้บริการปกป้องรหัสผ่านปกป้องเฉพาะรหัสผ่านของ Google แต่ผู้ใช้เปลี่ยนการตั้งค่านี้ได้";
PasswordSharingEnabled.pfm_title = "เปิดใช้การแชร์ข้อมูลเข้าสู่ระบบของผู้ใช้กับผู้ใช้คนอื่นๆ";
PasswordSharingEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะทำให้ผู้ใช้ส่งและรับรหัสผ่านจากสมาชิกในครอบครัว (ตามบริการครอบครัว) ได้\nเมื่อเปิดใช้นโยบายหรือไม่ได้ตั้งค่า ระบบจะแสดงปุ่มในเครื่องมือจัดการรหัสผ่านเพื่ออนุญาตให้ส่งรหัสผ่านได้\nรหัสผ่านที่ได้รับจะเก็บไว้ในบัญชีของผู้ใช้และแสดงในเครื่องมือจัดการรหัสผ่าน\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หมายความว่าผู้ใช้จะส่งรหัสผ่านจากเครื่องมือจัดการรหัสผ่านให้ผู้ใช้รายอื่นไม่ได้และจะไม่ได้รับรหัสผ่านจากผู้ใช้รายอื่น\n\nฟีเจอร์นี้จะใช้งานไม่ได้หากการซิงค์รหัสผ่านปิดอยู่ (ไม่ว่าจะเป็นการปิดผ่านการตั้งค่าของผู้ใช้หรือการปิดเนื่องจากนโยบาย SyncDisabled เปิดใช้อยู่)\n\nบัญชีที่จัดการไม่มีสิทธิ์เข้าร่วมหรือสร้างกลุ่มครอบครัว จึงไม่สามารถแชร์รหัสผ่านได้";
PaymentMethodQueryEnabled.pfm_title = "อนุญาตให้เว็บไซต์ถามหาวิธีการชำระเงินที่พร้อมใช้งาน";
PaymentMethodQueryEnabled.pfm_description = "อนุญาตให้คุณตั้งค่าว่าจะอนุญาตให้เว็บไซต์ตรวจสอบว่าผู้ใช้บันทึกวิธีการชำระเงินไว้ได้หรือไม่\n\nหากตั้งค่านโยบายนี้เป็นปิดใช้ ระบบจะแจ้งเว็บไซต์ที่ใช้ API PaymentRequest.canMakePayment หรือ PaymentRequest.hasEnrolledInstrument ว่าไม่มีวิธีการชำระเงินพร้อมใช้งาน\n\nหากตั้งค่าเป็นเปิดใช้หรือไม่ได้ตั้งค่าไว้ เว็บไซต์จะได้รับอนุญาตให้ตรวจสอบว่าผู้ใช้บันทึกวิธีการชำระเงินไว้หรือไม่";
PdfAnnotationsEnabled.pfm_title = "เปิดใช้คำอธิบายประกอบ PDF";
PdfAnnotationsEnabled.pfm_description = "ควบคุมว่าโปรแกรมอ่าน PDF ใน Brave จะใส่คำอธิบายประกอบใน PDF ได้หรือไม่\n\nเมื่อไม่ได้ตั้งค่านโยบายนี้ หรือตั้งค่าเป็น \"จริง\" โปรแกรมอ่าน PDF จะใส่คำอธิบายประกอบใน PDF ได้\n\nเมื่อตั้งค่านโยบายนี้เป็น \"เท็จ\" โปรแกรมอ่าน PDF จะใส่คำอธิบายประกอบใน PDF ไม่ได้";
PdfLocalFileAccessAllowedForDomains.pfm_title = "อนุญาตให้เข้าถึงไฟล์ในเครื่องผ่าน URL รูปแบบ file:// ในโปรแกรมอ่าน PDF สำหรับเว็บไซต์เหล่านี้";
PdfLocalFileAccessAllowedForDomains.pfm_description = "การตั้งค่านโยบายนี้อนุญาตให้โดเมนที่แสดงอยู่เข้าถึง URL รูปแบบ file:// ในโปรแกรมอ่าน PDF\nการเพิ่มนโยบายจะอนุญาตให้โดเมนเข้าถึง URL รูปแบบ file:// ในโปรแกรมอ่าน PDF\nการนำนโยบายออกเป็นการไม่อนุญาตให้โดเมนเข้าถึง URL รูปแบบ file:// ในโปรแกรมอ่าน PDF\nการไม่ตั้งค่านโยบายจะทำให้โดเมนทั้งหมดไม่สามารถเข้าถึง URL รูปแบบ file:// ในโปรแกรมอ่าน PDF";
PdfUseSkiaRendererEnabled.pfm_title = "ใช้ตัวแสดงผล Skia สำหรับการแสดงผล PDF";
PdfUseSkiaRendererEnabled.pfm_description = "กำหนดว่าจะให้โปรแกรมอ่าน PDF ใน Brave ใช้ตัวแสดงผล Skia หรือไม่\n\nเมื่อเปิดใช้นโยบายนี้ โปรแกรมอ่าน PDF จะใช้ตัวแสดงผล Skia\n\nเมื่อปิดใช้นโยบายนี้ โปรแกรมอ่าน PDF จะใช้ตัวแสดงผล AGG ในปัจจุบัน\n\nเมื่อไม่ได้ตั้งค่านโยบายนี้ เบราว์เซอร์จะเลือกตัวแสดงผล PDF";
PolicyAtomicGroupsEnabled.pfm_title = "เปิดใช้แนวคิดนโยบายที่มาจากกลุ่มขนาดเล็ก";
PolicyAtomicGroupsEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หมายความว่าระบบจะไม่สนใจนโยบายที่มีผลกับกลุ่มขนาดเล็กซึ่งไม่แชร์แหล่งที่มากับนโยบายที่มีลำดับความสำคัญสูงสุดในกลุ่ม\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หมายความว่าระบบจะพิจารณานโยบายทั้งหมดไม่ว่าจะมาจากแหล่งที่มาใดก็ตาม ระบบจะไม่สนใจนโยบายในกรณีที่มีความขัดแย้งและนโยบายดังกล่าวไม่ได้มีลำดับความสำคัญสูงสุดในกลุ่มเท่านั้น\n\nหากตั้งค่านโยบายนี้จากแหล่งที่มาในระบบคลาวด์ นโยบายจะกำหนดเป้าหมายเป็นผู้ใช้ที่เจาะจงไม่ได้";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "อนุญาตให้รวมนโยบายพจนานุกรมจากแหล่งที่มาต่างๆ";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - URL ข้อยกเว้นแบบกำหนดเองของผู้ใช้ที่ได้รับการจัดการ\nDeviceLoginScreenPowerManagement - การจัดการพลังงานบนหน้าจอการเข้าสู่ระบบ\nExtensionSettings - การตั้งค่าการจัดการส่วนขยาย\nKeyPermissions - สิทธิ์ของคีย์\nPowerManagementIdleSettings - การตั้งค่าการจัดการพลังงานเมื่อผู้ใช้ไม่มีการใช้งาน\nScreenBrightnessPercent - เปอร์เซ็นต์ความสว่างหน้าจอ\nScreenLockDelays - การหน่วงเวลาในการล็อกหน้าจอ\nการตั้งค่านโยบายทำให้สามารถรวมนโยบายที่เลือกเมื่อนโยบายมาจากแหล่งที่มาต่างๆ ซึ่งมีขอบเขตและระดับเดียวกัน การรวมจะอยู่ในคีย์ระดับแรกๆ ของพจนานุกรมจากแหล่งที่มาแต่ละแห่ง คีย์ที่มาจากแหล่งที่มีลำดับความสำคัญสูงสุดจะมีความสำคัญเหนือกว่า\n\nใช้อักขระไวลด์การ์ด \"*\" เพื่ออนุญาตให้รวมนโยบายพจนานุกรมทั้งหมดที่รองรับ\n\nหากนโยบายอยู่ในรายการและมีความขัดแย้งระหว่างแหล่งที่มาซึ่งมี\n\n* ขอบเขตและระดับเดียวกัน: ค่าจะรวมอยู่ในพจนานุกรมนโยบายใหม่\n\n* ขอบเขตหรือระดับที่ต่างกัน: ระบบจะใช้นโยบายที่มีลำดับความสำคัญสูงสุด\n\nหากนโยบายไม่ได้อยู่ในรายการและมีความขัดแย้งระหว่างแหล่งที่มา ขอบเขต หรือระดับ ระบบจะใช้นโยบายที่มีลำดับความสำคัญสูงสุด";
PolicyListMultipleSourceMergeList.pfm_title = "อนุญาตให้รวมนโยบายรายการจากแหล่งที่มาหลายแห่ง";
PolicyListMultipleSourceMergeList.pfm_description = "การตั้งค่านโยบายทำให้สามารถรวมนโยบายที่เลือกเมื่อนโยบายมาจากแหล่งที่มาต่างๆ ซึ่งมีขอบเขตและระดับเดียวกัน\n\nใช้อักขระไวลด์การ์ด \"*\" เพื่ออนุญาตให้รวมนโยบายรายการทั้งหมด\n\nหากนโยบายอยู่ในรายการและมีความขัดแย้งระหว่างแหล่งที่มาซึ่งมี\n\n* ขอบเขตและระดับเดียวกัน: ค่าจะรวมอยู่ในรายการนโยบายใหม่\n\n* ขอบเขตหรือระดับที่ต่างกัน: ระบบจะใช้นโยบายที่มีลำดับความสำคัญสูงสุด\n\nหากนโยบายไม่ได้อยู่ในรายการและมีความขัดแย้งระหว่างแหล่งที่มา ขอบเขต หรือระดับ ระบบจะใช้นโยบายที่มีลำดับความสำคัญสูงสุด";
PolicyRefreshRate.pfm_title = "อัตราการรีเฟรชสำหรับนโยบายผู้ใช้";
PolicyRefreshRate.pfm_description = "การตั้งค่านโยบายจะมีระยะเวลาเป็นมิลลิวินาทีที่ใช้ในการค้นหาข้อมูลนโยบายผู้ใช้จากบริการจัดการอุปกรณ์ ค่าที่ใช้ได้จะอยู่ในช่วง 1,800,000 (30 นาที) ถึง 86,400,000 (1 วัน) ค่าที่ไม่ได้อยู่ในช่วงนี้จะถูกบีบให้อยู่ภายในขอบเขตที่เกี่ยวข้อง\n\nการไม่ตั้งค่านโยบายจะทำให้ระบบใช้ค่าเริ่มต้นเป็น 3 ชั่วโมง\n\nหมายเหตุ: การแจ้งเตือนเรื่องนโยบายจะบังคับรีเฟรชเมื่อนโยบายมีการเปลี่ยนแปลง ซึ่งทำให้ไม่จำเป็นต้องรีเฟรชบ่อยๆ ดังนั้น หากแพลตฟอร์มรองรับการแจ้งเตือนเหล่านี้ การหน่วงเวลาการรีเฟรชจะอยู่ที่ 24 ชั่วโมง (โดยไม่สนใจค่าเริ่มต้นและค่าของนโยบายนี้)";
PopupsAllowedForUrls.pfm_title = "อนุญาตให้แสดงป๊อปอัปในเว็บไซต์เหล่านี้";
PopupsAllowedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่เปิดป๊อปอัปได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultPopupsSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
PopupsBlockedForUrls.pfm_title = "บล็อกป๊อปอัปในเว็บไซต์เหล่านี้";
PopupsBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่เปิดป๊อปอัปไม่ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultPopupsSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
PreciseGeolocationAllowedForUrls.pfm_title = "อนุญาตตำแหน่งทางภูมิศาสตร์ที่แน่นอนในเว็บไซต์เหล่านี้";
PreciseGeolocationAllowedForUrls.pfm_description = "การตั้งค่านโยบายช่วยให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ได้รับอนุญาตให้เข้าถึงตำแหน่งทางภูมิศาสตร์ที่มีความแม่นยำสูงของผู้ใช้โดยไม่ต้องขอสิทธิ์จากผู้ใช้ก่อน\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultGeolocationSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
PreferSlowCiphers.pfm_title = "เลือกใช้อัลกอริทึมการเข้ารหัสลับที่เฉพาะเจาะจงสำหรับ TLS";
PreferSlowCiphers.pfm_description = "cnsa - เลือกใช้การเข้ารหัสที่เป็นไปตามข้อกำหนดของ CNSA 1.0 และ 2.0\ndefault - ใช้ลำดับการเข้ารหัสเริ่มต้นของ Brave\nนโยบายนี้กำหนดค่า Brave เพื่อจัดลำดับการเข้ารหัสลับที่ต้องการใน TLS 1.3 เพื่อแสดงถึงความต้องการอัลกอริทึมที่ได้รับการอนุมัติจากระเบียบการปฏิบัติตามข้อกำหนดที่เฉพาะเจาะจง\n\nการตั้งค่านโยบายนี้ไม่ได้รับประกันว่าอัลกอริทึมที่เฉพาะเจาะจงจะได้รับการเจรจา\n\nนโยบายนี้มีขึ้นเพื่อให้ผู้ให้บริการเซิร์ฟเวอร์ที่ต้องการรองรับไคลเอ็นต์ทั้งที่มีและไม่มีข้อกำหนดด้านการปฏิบัติตามข้อกำหนดสามารถแยกความแตกต่างระหว่างไคลเอ็นต์เหล่านั้น และเลือกใช้เฉพาะอัลกอริทึมที่ไม่ใช่ค่าเริ่มต้นบางรายการซึ่งมีวิทยาการเข้ารหัสที่มีความปลอดภัยระดับสูงขึ้นสำหรับไคลเอ็นต์ที่กำหนดค่าไว้อย่างชัดเจนให้ใช้อัลกอริทึมเหล่านั้น\n\nการตั้งค่านโยบายเป็น \"cnsa\" จะกำหนดค่า Brave ให้เลือกใช้การเข้ารหัสที่จำเป็นสำหรับการปฏิบัติตามข้อกำหนดของชุดอัลกอริทึมเพื่อความมั่นคงแห่งชาติเชิงพาณิชย์เวอร์ชัน 1.0 และ 2.0 (Commercial National Security Algorithm Suite 1.0 และ 2.0 หรือ CNSA 1.0 และ 2.0)\n\nการไม่ตั้งค่านโยบายหรือตั้งค่าเป็น \"default\" จะกำหนดค่า Brave ให้ใช้การเข้ารหัสตามค่าเริ่มต้น\n\nไม่จำเป็นต้องตั้งค่านโยบายนี้เพื่อความปลอดภัย วิทยาการเข้ารหัสเริ่มต้นที่ Brave ใช้มีความปลอดภัยเพียงพอที่จะป้องกันการโจมตีแบบบรูตฟอร์ซโดยใช้พลังงานทั้งหมดของดวงอาทิตย์\n\nการตั้งค่านโยบายนี้จะทำให้ Brave ทำงานช้าลงเมื่อเข้าถึงเว็บไซต์\n\nนโยบายนี้มีผลเฉพาะกับ TLS 1.3 และ QUIC เท่านั้น โดยไม่มีผลกับ TLS เวอร์ชันก่อนหน้า\n\nตั้งค่านโยบายนี้สำหรับเครื่องและผู้ใช้ได้ หากตั้งค่าไว้สำหรับผู้ใช้ นโยบายนี้จะมีผลกับคำขอเครือข่ายที่เริ่มต้นโดยโปรไฟล์ผู้ใช้เท่านั้น และอาจไม่มีผลกับคำขอเครือข่ายที่ Brave สร้างขึ้นเพื่อดำเนินงานเบื้องหลังทั่วทั้งเบราว์เซอร์ ซึ่งควบคุมโดยค่าระดับเครื่อง หากตั้งค่านโยบายนี้ไว้ทั้งในระดับเครื่องและระดับผู้ใช้ ระบบจะใช้ค่าระดับเครื่อง เว้นแต่ลำดับความสำคัญของนโยบายจะมีการเปลี่ยนแปลงโดยนโยบาย CloudUserPolicyOverridesCloudMachinePolicy\n\nสำหรับเวอร์ชัน 155 และต่ำกว่า นโยบายนี้จะมีผลทั้งเครื่องเท่านั้น";
PreferSlowKexAlgorithms.pfm_title = "เลือกใช้อัลกอริทึมการแลกเปลี่ยนคีย์ที่เฉพาะเจาะจงสำหรับ TLS";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - เลือกใช้วิธีการแลกเปลี่ยนคีย์ที่เป็นไปตามข้อกำหนดของ CNSA 2.0\ndefault - ใช้กลุ่มที่รองรับเริ่มต้นของ Brave\nนโยบายนี้กำหนดค่า Brave เพื่อจัดลำดับอัลกอริทึมของข้อตกลงเกี่ยวกับคีย์ที่ต้องการ (กลุ่มที่รองรับ) ใน TLS 1.3 เพื่อแสดงถึงความต้องการอัลกอริทึมที่ได้รับการอนุมัติจากระเบียบการปฏิบัติตามข้อกำหนดที่เฉพาะเจาะจง\n\nการตั้งค่านโยบายนี้ไม่ได้รับประกันว่าอัลกอริทึมที่เฉพาะเจาะจงจะได้รับการเจรจา\n\nนโยบายนี้มีขึ้นเพื่อให้ผู้ให้บริการเซิร์ฟเวอร์ที่ต้องการรองรับไคลเอ็นต์ทั้งที่มีและไม่มีข้อกำหนดด้านการปฏิบัติตามข้อกำหนดสามารถแยกความแตกต่างระหว่างไคลเอ็นต์เหล่านั้น และเลือกใช้เฉพาะอัลกอริทึมที่ไม่ใช่ค่าเริ่มต้นบางรายการซึ่งมีวิทยาการเข้ารหัสที่มีความปลอดภัยระดับสูงขึ้นสำหรับไคลเอ็นต์ที่กำหนดค่าไว้อย่างชัดเจนให้ใช้อัลกอริทึมเหล่านั้น\n\nการตั้งค่านโยบายเป็น \"cnsa2\" จะกำหนดค่า Brave ให้เลือกใช้วิธีการแลกเปลี่ยนคีย์ที่จำเป็นสำหรับการปฏิบัติตามข้อกำหนดของชุดอัลกอริทึมเพื่อความมั่นคงแห่งชาติเชิงพาณิชย์เวอร์ชัน 2.0 (Commercial National Security Algorithm Suite 2.0 หรือ CNSA 2.0)\n\nการไม่ตั้งค่านโยบาย หรือตั้งค่าเป็น \"default\" จะกำหนดค่า Brave ให้ใช้วิธีการแลกเปลี่ยนคีย์ตามค่าเริ่มต้น\n\nไม่จำเป็นต้องตั้งค่านโยบายนี้เพื่อความปลอดภัย วิทยาการเข้ารหัสเริ่มต้นที่ Brave ใช้มีความปลอดภัยเพียงพอที่จะป้องกันการโจมตีแบบบรูตฟอร์ซโดยใช้พลังงานทั้งหมดของดวงอาทิตย์\n\nการตั้งค่านโยบายนี้จะทำให้ Brave ทำงานช้าลงเมื่อเข้าถึงเว็บไซต์\n\nนโยบายนี้มีผลเฉพาะกับ TLS 1.3 และ QUIC เท่านั้น โดยไม่มีผลกับ TLS เวอร์ชันก่อนหน้า\n\nตั้งค่านโยบายนี้สำหรับเครื่องและผู้ใช้ได้ หากตั้งค่าไว้สำหรับผู้ใช้ นโยบายนี้จะมีผลกับคำขอเครือข่ายที่เริ่มต้นโดยโปรไฟล์ผู้ใช้เท่านั้น และอาจไม่มีผลกับคำขอเครือข่ายที่ Brave สร้างขึ้นเพื่อดำเนินงานเบื้องหลังทั่วทั้งเบราว์เซอร์ ซึ่งควบคุมโดยค่าระดับเครื่อง หากตั้งค่านโยบายนี้ไว้ทั้งในระดับเครื่องและระดับผู้ใช้ ระบบจะใช้ค่าระดับเครื่อง เว้นแต่ลำดับความสำคัญของนโยบายจะมีการเปลี่ยนแปลงโดยนโยบาย CloudUserPolicyOverridesCloudMachinePolicy\n\nสำหรับเวอร์ชัน 155 และต่ำกว่า นโยบายนี้จะมีผลทั้งเครื่องเท่านั้น";
PrefetchWithServiceWorkerEnabled.pfm_title = "อนุญาตให้ดึงข้อมูล SpeculationRules ล่วงหน้าไปยัง URL ที่ควบคุมโดย ServiceWorker";
PrefetchWithServiceWorkerEnabled.pfm_description = "ระบบสามารถใช้คำสั่งดึงข้อมูล SpeculationRules ล่วงหน้ากับ URL ที่ควบคุมโดย ServiceWorker อย่างไรก็ตาม โค้ดเดิมไม่อนุญาตให้ดำเนินการดังกล่าวและยกเลิกคําขอดึงข้อมูลล่วงหน้า นโยบายนี้เปิดใช้เพื่อควบคุมลักษณะการทํางาน\n\nการตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะอนุญาตให้ดึงข้อมูล SpeculationRules ล่วงหน้าไปยัง URL ที่ควบคุมโดย ServiceWorker (หากเปิดใช้แฟล็กฟีเจอร์ PrefetchServiceWorker) นี่เป็นลักษณะการทำงานเริ่มต้นปัจจุบันและสอดคล้องกับข้อมูลจำเพาะ\n\nการตั้งค่านโยบายนี้เป็น \"ปิดใช้\" จะไม่อนุญาตให้ดึงข้อมูล SpeculationRules ล่วงหน้าไปยัง URL ที่ควบคุมโดย ServiceWorker นี่เป็นลักษณะการทำงานเดิม\n\nนโยบายนี้มีไว้เพื่อใช้ชั่วคราวและจะนำออกในอนาคต";
PrintHeaderFooter.pfm_title = "ส่วนหัวและส่วนท้ายของการพิมพ์";
PrintHeaderFooter.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะเปิดส่วนหัวและส่วนท้ายในการแสดงตัวอย่างก่อนพิมพ์ การตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิดส่วนดังกล่าวในการแสดงตัวอย่างก่อนพิมพ์\n\nหากคุณตั้งค่านโยบายไว้ ผู้ใช้จะเปลี่ยนไม่ได้ หากไม่ได้ตั้งค่า ผู้ใช้จะเลือกได้เองว่าจะให้แสดงส่วนหัวและส่วนท้ายหรือไม่";
PrintPdfAsImageAvailability.pfm_title = "มีตัวเลือกในการพิมพ์ PDF เป็นรูปภาพ";
PrintPdfAsImageAvailability.pfm_description = "ควบคุมวิธีที่ Brave เสนอตัวเลือกการพิมพ์เป็นรูปภาพใน Microsoft® Windows® และ macOS เมื่อจะพิมพ์ PDF\n\nเมื่อพิมพ์ PDF ใน Microsoft® Windows® หรือ macOS บางครั้งงานพิมพ์ต้องมีการแรสเตอร์เป็นรูปภาพสำหรับเครื่องพิมพ์บางรุ่นเพื่อให้งานที่ออกมามีลักษณะถูกต้อง\n\nเมื่อตั้งค่านโยบายนี้เป็น \"เปิดใช้\" Brave จะเสนอตัวเลือกการพิมพ์เป็นรูปภาพในตัวอย่างก่อนพิมพ์เมื่อจะพิมพ์ PDF\n\nเมื่อตั้งค่านโยบายนี้เป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า Brave จะไม่เสนอตัวเลือกการพิมพ์เป็นรูปภาพแก่ผู้ใช้ในตัวอย่างก่อนพิมพ์ และจะพิมพ์ PDF ตามปกติโดยไม่ทำการแรสเตอร์เป็นรูปภาพก่อนส่งไปยังปลายทาง";
PrintPdfAsImageDefault.pfm_title = "ค่าเริ่มต้นการพิมพ์ PDF เป็นรูปภาพ";
PrintPdfAsImageDefault.pfm_description = "ควบคุมว่าจะให้ Brave มีค่าเริ่มต้นเป็นตั้งค่าตัวเลือกการพิมพ์เป็นรูปภาพเมื่อจะพิมพ์ PDF หรือไม่\n\nเมื่อตั้งค่านโยบายนี้เป็น \"เปิดใช้\" Brave จะมีค่าเริ่มต้นเป็นตั้งค่าตัวเลือกการพิมพ์เป็นรูปภาพในตัวอย่างก่อนพิมพ์เมื่อจะพิมพ์ PDF\n\nเมื่อตั้งค่านโยบายนี้เป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า Brave ในเบื้องต้นระบบจะไม่ได้ตั้งค่าให้ผู้ใช้เลือกตัวเลือกการพิมพ์เป็นรูปภาพ  ผู้ใช้จะเลือกงานพิมพ์ PDF แต่ละรายการได้หากตัวเลือกพร้อมใช้งาน\n\nสำหรับ Microsoft® Windows® หรือ macOS นโยบายนี้จะมีผลก็ต่อเมื่อเปิดใช้ PrintPdfAsImageAvailability ไว้ด้วย";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "ใช้เครื่องพิมพ์เริ่มต้นของระบบเป็นค่าเริ่มต้น";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "หากตั้งค่านโยบายเป็น \"เปิดใช้\" Brave จะใช้เครื่องพิมพ์เริ่มต้นของระบบปฏิบัติการเป็นปลายทางเริ่มต้นสำหรับการแสดงตัวอย่างก่อนพิมพ์\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ตั้งค่า Brave จะใช้เครื่องพิมพ์ที่ใช้ล่าสุดเป็นปลายทางเริ่มต้นสำหรับการแสดงตัวอย่างก่อนพิมพ์";
PrintRasterizePdfDpi.pfm_title = "DPI การพิมพ์ PDF แรสเตอร์";
PrintRasterizePdfDpi.pfm_description = "ควบคุมความละเอียดของรูปภาพพิมพ์เมื่อ Brave พิมพ์ PDF ที่มีการทำแรสเตอร์\n\nการพิมพ์ PDF โดยใช้ตัวเลือกการพิมพ์เป็นรูปภาพช่วยให้ระบุความละเอียดของการพิมพ์เป็นค่าอื่นนอกเหนือจากการตั้งค่าเครื่องพิมพ์ของอุปกรณ์หรือค่าเริ่มต้นของ PDF ได้  ความละเอียดสูงจะทำให้เวลาในการประมวลผลและการพิมพ์เพิ่มขึ้นอย่างมาก ในขณะที่ความละเอียดต่ำอาจทำให้รูปมีคุณภาพต่ำ\n\nนโยบายนี้อนุญาตให้ระบุความละเอียดสำหรับทำแรสเตอร์ PDF เพื่อการพิมพ์โดยเฉพาะ\n\nหากตั้งค่านโยบายนี้เป็น 0 หรือไม่ได้ตั้งค่าเลย จะมีการใช้ความละเอียดเริ่มต้นของระบบในระหว่างการทำแรสเตอร์รูปภาพในหน้าเนื้อหา";
PrinterTypeDenyList.pfm_title = "ปิดใช้ประเภทเครื่องพิมพ์ในรายการปฏิเสธ";
PrinterTypeDenyList.pfm_description = "privet - ปลายทางของโปรโตคอลที่ใช้ Zeroconf (mDNS + DNS-SD) (เลิกใช้งานแล้ว)\nextension - ปลายทางตามส่วนขยาย\npdf - ปลายทางของ \"บันทึกเป็น PDF\" และปลายทางของ \"บันทึกลงใน Google ไดรฟ์\" ในอุปกรณ์ Google Chrome OS\nlocal - ปลายทางเครื่องพิมพ์ในพื้นที่\ncloud - Google Cloud Print (เลิกใช้งานแล้ว)\nระบบจะปิดใช้เครื่องพิมพ์ที่มีประเภทตรงกับในรายการปฏิเสธไม่ให้ค้นพบหรือดึงข้อมูลความสามารถได้\n\nการใส่ประเภทเครื่องพิมพ์ทั้งหมดไว้ในรายการปฏิเสธจะปิดใช้การพิมพ์ได้อย่างมีประสิทธิภาพ เนื่องจากจะทำให้ไม่มีปลายทางให้ส่งเอกสารไปพิมพ์\n\nในเวอร์ชันก่อน 102 การรวม cloud ไว้ในรายการปฏิเสธจะมีผลเหมือนกับการตั้งค่านโยบาย CloudPrintSubmitEnabled เป็น \"เท็จ\" หากต้องการให้ค้นพบปลายทาง Google Cloud Print ได้ จะต้องตั้งค่านโยบาย CloudPrintSubmitEnabled เป็น \"จริง\" และต้องไม่รวม cloud ไว้ในรายการปฏิเสธ เริ่มตั้งแต่เวอร์ชัน 102 ระบบจะไม่รองรับปลายทาง Google Cloud Print และจะไม่ปรากฏไม่ว่าค่านโยบายจะเป็นอย่างไร\n\nหากไม่ได้ตั้งค่านโยบายหรือตั้งค่าเป็นรายการที่ว่างเปล่า จะทำให้ค้นพบเครื่องพิมพ์ทุกประเภทได้\n\nเครื่องพิมพ์ส่วนขยายเรียกอีกอย่างว่าปลายทางผู้ให้บริการการพิมพ์ โดยจะมีปลายทางทั้งหมดที่เป็นของส่วนขยาย Brave\n\nเครื่องพิมพ์ในพื้นที่เรียกอีกอย่างว่าปลายทางการพิมพ์เฉพาะที่ โดยจะมีปลายทางที่พร้อมใช้งานสำหรับคอมพิวเตอร์ในพื้นที่และเครื่องพิมพ์ของเครือข่ายที่แชร์";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "จำกัดโหมดการพิมพ์กราฟิกพื้นหลัง";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - อนุญาตการพิมพ์ทั้งกรณีที่มีและไม่มีกราฟิกพื้นหลัง\nenabled - อนุญาตเฉพาะการพิมพ์ที่มีกราฟิกพื้นหลังเท่านั้น\ndisabled - อนุญาตเฉพาะการพิมพ์ที่ไม่มีกราฟิกพื้นหลังเท่านั้น\nจำกัดโหมดการพิมพ์กราฟิกพื้นหลัง ระบบจะถือว่าไม่มีข้อจำกัดหากไม่ได้ตั้งค่านโยบาย";
PrintingBackgroundGraphicsDefault.pfm_title = "กำหนดค่าเริ่มต้นของโหมดการพิมพ์กราฟิกพื้นหลัง";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - เปิดใช้โหมดการพิมพ์กราฟิกพื้นหลังโดยค่าเริ่มต้น\ndisabled - ปิดใช้โหมดการพิมพ์กราฟิกพื้นหลังโดยค่าเริ่มต้น\nลบล้างโหมดการพิมพ์กราฟิกพื้นหลังที่เป็นค่าเริ่มต้น";
PrintingEnabled.pfm_title = "เปิดใช้งานการพิมพ์";
PrintingEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ผู้ใช้สั่งพิมพ์ใน Brave ได้ และผู้ใช้จะเปลี่ยนการตั้งค่านี้ไม่ได้\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" ผู้ใช้จะสั่งพิมพ์จาก Brave ไม่ได้ การสั่งพิมพ์จะปิดทั้งในเมนู 3 จุด ส่วนขยาย และแอปพลิเคชัน JavaScript";
PrintingPaperSizeDefault.pfm_title = "ขนาดหน้าของการพิมพ์เริ่มต้น";
PrintingPaperSizeDefault.pfm_description = "ลบล้างขนาดหน้าการพิมพ์เริ่มต้น\n\nname ควรมีรูปแบบที่อยู่ในรายการ 1 รูปแบบ หรือมีรูปแบบ \"ที่กำหนดเอง\" หากไม่มีขนาดกระดาษที่จำเป็นอยู่ในรายการ หากระบุค่า \"ที่กำหนดเอง\" ก็ควรระบุพร็อพเพอร์ตี้ custom_size ซึ่งอธิบายความสูงและความกว้างที่ต้องการเป็นไมโครเมตรด้วย มิเช่นนั้นก็ไม่ควรมีการระบุพร็อพเพอร์ตี้ custom_size ระบบจะไม่สนใจนโยบายที่ละเมิดกฎนี้\n\nหากไม่มีขนาดหน้าดังกล่าวในเครื่องพิมพ์ที่ผู้ใช้เลือก ระบบจะไม่สนใจนโยบายนี้\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault";
ProfilePickerOnStartupAvailability.pfm_title = "ความพร้อมใช้งานของเครื่องมือเลือกโปรไฟล์เมื่อเริ่มต้นระบบ";
ProfilePickerOnStartupAvailability.pfm_description = "0 - เครื่องมือเลือกโปรไฟล์พร้อมใช้งานเมื่อเริ่มต้นระบบ\n1 - ปิดใช้เครื่องมือเลือกโปรไฟล์เมื่อเริ่มต้นระบบ\n2 - บังคับใช้เครื่องมือเลือกโปรไฟล์เมื่อเริ่มต้นระบบ\nระบุว่าเครื่องมือเลือกโปรไฟล์เปิดใช้อยู่ ปิดใช้อยู่ หรือบังคับใช้เมื่อเริ่มเบราว์เซอร์\n\nเครื่องมือเลือกโปรไฟล์จะไม่แสดงอยู่โดยค่าเริ่มต้นหากเบราว์เซอร์เริ่มต้นในโหมดผู้มาเยือนหรือโหมดไม่ระบุตัวตน มีการระบุไดเรกทอรีโปรไฟล์และ/หรือ URL ด้วยบรรทัดคำสั่ง มีการขอให้เปิดแอปอย่างชัดแจ้ง มีการเปิดเบราว์เซอร์ด้วยการแจ้งเตือนแบบเนทีฟ มีให้เลือกเพียงโปรโฟล์เดียว หรือมีการตั้งค่านโยบาย ForceBrowserSignin เป็น \"จริง\"\n\nหากเลือก \"เปิดใช้\" (0) ไว้หรือไม่ได้ตั้งค่านโยบาย เครื่องมือเลือกโปรไฟล์จะแสดงเมื่อเริ่มต้นระบบโดยค่าเริ่มต้น แต่ผู้ใช้จะเปิด/ปิดใช้ได้\n\nหากเลือก \"ปิดใช้\" (1) ไว้ เครื่องมือเลือกโปรไฟล์จะไม่แสดงขึ้นมาและผู้ใช้จะเปลี่ยนการตั้งค่านี้ไม่ได้\n\nหากเลือก \"บังคับใช้\" (2) ไว้ ผู้ใช้จะระงับการใช้เครื่องมือเลือกโปรไฟล์ไม่ได้ เครื่องมือเลือกโปรไฟล์จะแสดงแม้ว่าจะมีให้เลือกเพียงโปรโฟล์เดียวเท่านั้น";
ProfileReauthPrompt.pfm_title = "แจ้งให้ผู้ใช้ตรวจสอบสิทธิ์กับโปรไฟล์อีกครั้ง";
ProfileReauthPrompt.pfm_description = "0 - ไม่ต้องแจ้งให้ตรวจสอบสิทธิ์อีกครั้ง\n1 - แจ้งให้ตรวจสอบสิทธิ์อีกครั้งในแท็บ\nหากตั้งค่าเป็น DoNotPrompt หรือไม่ได้ตั้งค่าไว้ Brave จะไม่แสดงข้อความแจ้งให้ผู้ใช้ตรวจสอบสิทธิ์กับเบราว์เซอร์อีกครั้งโดยอัตโนมัติ\n\nหากตั้งค่าเป็น PromptInTab ไว้ ระบบจะเปิดแท็บใหม่ที่เป็นหน้าเข้าสู่ระบบของ Google ขึ้นมา ทันทีที่การตรวจสอบสิทธิ์ของผู้ใช้หมดอายุลง ซึ่งกรณีนี้จะเกิดขึ้นเมื่อใช้ Chrome Sync เท่านั้น";
ProfileSeparationDomainExceptionList.pfm_title = "รายการที่อนุญาตสำหรับโดเมนรองที่มีการแยกโปรไฟล์องค์กร";
ProfileSeparationDomainExceptionList.pfm_description = "หากไม่ได้ตั้งค่านโยบายนี้ ระบบจะไม่กำหนดให้มีการเข้าสู่ระบบบัญชีเพื่อสร้างโปรไฟล์ใหม่แยกต่างหาก\n\nหากตั้งค่านโยบายนี้ ระบบจะไม่กำหนดให้มีการเข้าสู่ระบบบัญชีจากโดเมนที่ระบุไว้เพื่อสร้างโปรไฟล์ใหม่แยกต่างหาก\n\nคุณสามารถตั้งค่านโยบายนี้เป็นสตริงว่างเปล่า เพื่อกำหนดให้มีการเข้าสู่ระบบบัญชีทั้งหมดสำหรับการสร้างโปรไฟล์ใหม่แยกต่างหาก";
PromotionsEnabled.pfm_title = "เปิดการแสดงเนื้อหาส่งเสริมการขาย";
PromotionsEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" หรือไม่ได้ตั้งค่าทำให้ Brave แสดงเนื้อหาส่งเสริมการขายผลิตภัณฑ์แก่ผู้ใช้\n\nการตั้งค่านโยบายเป็น \"เท็จ\" ป้องกันไม่ให้ Brave แสดงเนื้อหาส่งเสริมการขายผลิตภัณฑ์\n\nการตั้งค่านโยบายจะควบคุมการนำเสนอเนื้อหาส่งเสริมการขาย รวมถึงหน้ายินดีต้อนรับซึ่งช่วยให้ผู้ใช้ลงชื่อเข้าใช้ Brave โดยกำหนดให้ Brave เป็นเบราว์เซอร์เริ่มต้นของผู้ใช้ หรือให้ข้อมูลเกี่ยวกับฟีเจอร์ของผลิตภัณฑ์";
PromptForDownloadLocation.pfm_title = "สอบถามที่เก็บไฟล์ก่อนดาวน์โหลด";
PromptForDownloadLocation.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หมายความว่าระบบจะถามผู้ใช้ว่าจะบันทึกไฟล์ไว้ที่ไหนก่อนที่จะดาวน์โหลด การตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้การดาวน์โหลดเริ่มต้นทันที และระบบจะไม่ถามผู้ใช้ว่าจะบันทึกไฟล์ไว้ที่ไหน\n\nการไม่ตั้งค่านโยบายจะทำให้ผู้ใช้เปลี่ยนการตั้งค่าได้";
PromptOnMultipleMatchingCertificates.pfm_title = "ข้อความแจ้งที่แสดงเมื่อมีใบรับรองที่ตรงกันหลายรายการ";
PromptOnMultipleMatchingCertificates.pfm_description = "นโยบายนี้ควบคุมว่าระบบจะแสดงข้อความแจ้งให้ผู้ใช้เลือกใบรับรองไคลเอ็นต์หรือไม่เมื่อมีใบรับรองที่ตรงกันมากกว่า 1 รายการ AutoSelectCertificateForUrls\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" ระบบจะแสดงข้อความแจ้งให้ผู้ใช้เลือกใบรับรองไคลเอ็นต์เมื่อนโยบายการเลือกอัตโนมัติพบใบรับรองที่ตรงกันหลายรายการ\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า ระบบอาจแสดงข้อความแจ้งผู้ใช้เฉพาะในกรณีที่ไม่มีใบรับรองตรงกับการเลือกอัตโนมัติ";
ProxySettings.pfm_title = "การตั้งค่าพร็อกซี";
ProxySettings.pfm_description = "การตั้งค่านโยบายนี้จะกำหนดค่าพร็อกซีสำหรับ Chrome และแอป ARC โดยไม่พิจารณาตัวเลือกเกี่ยวกับพร็อกซีทั้งหมดที่ระบุจากบรรทัดคำสั่ง\n\nการไม่ตั้งค่านโยบายนี้จะทำให้ผู้ใช้เลือกการตั้งค่าพร็อกซีได้\n\nการตั้งค่านโยบาย ProxySettings จะยอมรับช่องต่อไปนี้\n\n* ProxyMode ซึ่งช่วยให้คุณระบุพร็อกซีเซิร์ฟเวอร์ที่ Chrome จะใช้ได้ และป้องกันไม่ให้ผู้ใช้เปลี่ยนการตั้งค่าพร็อกซี\n\n* ProxyPacUrl URL ไปยังไฟล์ .pac ของพร็อกซี หรือสคริปต์ PAC ที่เข้ารหัสเป็น URL ข้อมูลที่มีประเภท MIME application/x-ns-proxy-autoconfig\n\n* ProxyPacMandatory สำหรับป้องกันไม่ให้สแต็กเครือข่ายเปลี่ยนไปใช้วิธีสำรอง นั่นคือการเชื่อมต่อโดยตรงกับสคริปต์ PAC ที่ไม่ถูกต้องหรือไม่พร้อมใช้งาน\n\n* ProxyServer คือ URL ของพร็อกซีเซิร์ฟเวอร์\n\n* ProxyBypassList คือรายการโฮสต์ที่จะข้ามพร็อกซี\n\nช่อง ProxyServerMode เลิกใช้งานแล้วเพื่อใช้ช่อง ProxyMode สำหรับ ProxyMode หากคุณเลือกค่าต่อไปนี้\n\n* direct ระบบจะไม่ใช้พร็อกซีและจะไม่พิจารณาช่องอื่นๆ ทั้งหมด\n\n* system ระบบจะใช้พร็อกซีของระบบและจะไม่พิจารณาช่องอื่นๆ ทั้งหมด\n\n* auto_detect ระบบจะไม่พิจารณาช่องอื่นๆ ทั้งหมด\n\n* fixed_servers ระบบจะใช้ช่อง ProxyServer และ ProxyBypassList\n\n* pac_script ระบบจะใช้ช่อง ProxyPacUrl, ProxyPacMandatory และ ProxyBypassList\n\nหมายเหตุ: ดูตัวอย่างโดยละเอียดเพิ่มเติมได้ที่ The Chromium Projects ( https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings )\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=ProxySettings";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "เปิดใช้เครื่องมือสร้างคิวอาร์โค้ด";
QRCodeGeneratorEnabled.pfm_description = "นโยบายนี้จะเปิดใช้ฟีเจอร์เครื่องมือสร้างคิวอาร์โค้ดใน Brave\n\nหากคุณเปิดใช้นโยบายนี้หรือไม่ได้กำหนดค่า ระบบจะเปิดใช้ฟีเจอร์เครื่องมือสร้างคิวอาร์โค้ด\n\nหากปิดใช้นโยบายนี้ ระบบจะปิดใช้ฟีเจอร์เครื่องมือสร้างคิวอาร์โค้ด";
QuicAllowed.pfm_title = "อนุญาตโปรโตคอล QUIC";
QuicAllowed.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้ใช้โปรโตคอล QUIC ใน Brave ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ใช้โปรโตคอล QUIC ไม่ได้";
RegisteredProtocolHandlers.pfm_title = "ลงทะเบียนเครื่องจัดการโปรโตคอล";
RegisteredProtocolHandlers.pfm_description = "การตั้งค่านโยบาย (ตามที่แนะนำเท่านั้น) จะให้คุณลงทะเบียนรายการเครื่องจัดการโปรโตคอล ซึ่งรวมเข้ากับรายการที่ผู้ใช้ลงทะเบียน และทำให้มีการนำทั้ง 2 ชุดไปใช้งาน ตั้งค่าพร็อพเพอร์ตี้ \"โปรโตคอล\" เป็นรูปแบบ เช่น \"mailto\" และตั้งค่าพร็อพเพอร์ตี้ \"URL\" เป็นรูปแบบ URL ของแอปพลิเคชันที่จัดการรูปแบบที่ระบุไว้ในช่อง \"โปรโตคอล\" รูปแบบ URL อาจมีตัวยึดตำแหน่ง \"%s\" ได้ ซึ่ง URL ที่มีการจัดการจะมาแทนที่\n\nผู้ใช้จะนำเครื่องจัดการโปรโตคอลที่นโยบายลงทะเบียนไว้ออกไม่ได้ แต่หากติดตั้งเครื่องจัดการเริ่มต้นเครื่องใหม่ ก็จะเปลี่ยนเครื่องจัดการโปรโตคอลที่นโยบายติดตั้งไว้ได้\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers";
RelaunchFastIfOutdated.pfm_title = "ระยะเวลา (วัน)";
RelaunchFastIfOutdated.pfm_description = "ระบุอายุขั้นต่ำของเวอร์ชันอัปเดตที่การแจ้งเตือนการเปิดใช้ใหม่จะเข้มงวดมากขึ้น โดยคำนวณอายุจากเวลาที่เวอร์ชันที่ทำงานอยู่ในปัจจุบันแสดงต่อลูกค้าครั้งล่าสุด\n\nหากจำเป็นต้องเปิดเบราว์เซอร์อีกครั้งหรือรีสตาร์ทอุปกรณ์เพื่อดำเนินการอัปเดตที่รอดำเนินการให้เสร็จสิ้น และเวอร์ชันปัจจุบันล้าสมัยนานกว่าจำนวนวันที่ระบุไว้ในการตั้งค่านี้ นโยบาย RelaunchNotificationPeriod จะเปลี่ยนเป็น 2 ชั่วโมง หากตั้งค่านโยบาย RelaunchNotification เป็น 1 (\"จำเป็น\") ผู้ใช้จะต้องเปิดอีกครั้งหรือรีสตาร์ทใหม่เมื่อสิ้นสุดระยะเวลาดังกล่าว\n\nหากไม่ได้ตั้งค่าหรือไม่สามารถระบุอายุของเวอร์ชันอัปเดตได้ ระบบจะใช้นโยบาย RelaunchNotificationPeriod สำหรับการอัปเดตทั้งหมด";
RelaunchNotification.pfm_title = "แจ้งผู้ใช้ว่าควรหรือจำเป็นต้องเปิดเบราว์เซอร์ขึ้นมาใหม่หรือรีสตาร์ทอุปกรณ์";
RelaunchNotification.pfm_description = "1 - แสดงข้อความแจ้งที่ปรากฏขึ้นซ้ำๆ แก่ผู้ใช้เพื่อแจ้งว่าควรเปิดเบราว์เซอร์ขึ้นมาใหม่\n2 - แสดงข้อความแจ้งที่ปรากฏขึ้นซ้ำๆ แก่ผู้ใช้เพื่อแจ้งว่าต้องเปิดเบราว์เซอร์ขึ้นมาใหม่\nแจ้งให้ผู้ใช้ทราบว่าต้องเปิด Brave ขึ้นมาใหม่หรือต้องรีสตาร์ท Google Chrome OS เพื่อนำอัปเดตที่รอดำเนินการไปใช้\n\nการตั้งค่านโยบายนี้จะเปิดใช้การแจ้งเตือนที่จะบอกว่าผู้ใช้ควรหรือจำเป็นต้องเปิดเบราว์เซอร์ขึ้นมาใหม่หรือรีสตาร์ทอุปกรณ์ หากไม่ได้ตั้งค่านโยบายนี้ Brave จะแจ้งผู้ใช้ว่าจำเป็นต้องมีการเปิดขึ้นมาใหม่ผ่านการเปลี่ยนแปลงเพียงเล็กน้อยในเมนู ส่วน Google Chrome OS จะแจ้งข้อความเช่นนี้ผ่านการแจ้งเตือนในถาดระบบ หากตั้งค่าเป็น \"แนะนำ\" ระบบจะแสดงคำเตือนที่เกิดซ้ำแก่ผู้ใช้ว่าขอแนะนำให้เปิดขึ้นมาใหม่ ผู้ใช้ปิดคำเตือนนี้เพื่อเลื่อนการเปิดใหม่ได้ หากตั้งค่าเป็น \"จำเป็น\" ระบบจะแสดงคำเตือนที่เกิดซ้ำแก่ผู้ใช้ว่าจะมีการบังคับเปิดเบราว์เซอร์ใหม่หลังจากสิ้นสุดระยะการแจ้งเตือน โดยค่าเริ่มต้น ระยะเวลาดังกล่าวคือ 7 วันสำหรับ Brave และ 4 วันสำหรับ Google Chrome OS แต่คุณกำหนดค่าผ่านการตั้งค่านโยบาย RelaunchNotificationPeriod ได้\nระบบจะคืนค่าเซสชันของผู้ใช้หลังการเปิดใหม่/รีสตาร์ท";
RelaunchNotificationPeriod.pfm_title = "ระยะเวลา (มิลลิวินาที)";
RelaunchNotificationPeriod.pfm_description = "อนุญาตให้คุณตั้งค่าระยะเวลา (หน่วยเป็นมิลลิวินาที) ที่จะแสดงการแจ้งเตือนให้ผู้ใช้ทราบว่าต้องเปิด Brave ขึ้นมาใหม่หรือต้องรีสตาร์ทอุปกรณ์ Google Chrome OS เพื่อนำอัปเดตที่รอดำเนินการไปใช้\n\nระหว่างช่วงเวลานี้ ผู้ใช้จะได้รับการแจ้งเตือนอยู่เรื่อยๆ ว่าต้องทำการอัปเดต สำหรับอุปกรณ์ Google Chrome OS การแจ้งเตือนให้รีสตาร์ทจะปรากฏในถาดระบบตามนโยบาย RelaunchHeadsUpPeriod สำหรับเบราว์เซอร์ Brave เมนูแอปจะเปลี่ยนไปเพื่อบ่งชี้ว่าผู้ใช้ต้องเปิดเบราว์เซอร์ขึ้นมาใหม่เมื่อระยะเวลาแจ้งเตือนผ่านไป 1 ใน 3 จากนั้นการแจ้งเตือนจะเปลี่ยนสีเมื่อระยะเวลาแจ้งเตือนผ่านไป 2 ใน 3 ของระยะเวลาทั้งหมด และเปลี่ยนสีอีกครั้งเมื่อการแจ้งเตือนครบกำหนด การแจ้งเตือนอื่นๆ ที่เปิดใช้โดยนโยบาย RelaunchNotification จะเป็นไปตามกำหนดเวลานี้\n\nหากไม่ได้ตั้งค่า ระบบจะใช้ระยะเวลาเริ่มต้น 604,800,000 มิลลิวินาที (1 สัปดาห์)";
RelaunchWindow.pfm_title = "กรอบเวลาการเปิดอีกครั้ง";
RelaunchWindow.pfm_description = "ระบุกรอบเวลาเป้าหมายสำหรับช่วงสิ้นสุดระยะเวลาการแจ้งเตือนการเปิดอีกครั้ง\n\nผู้ใช้ได้รับการแจ้งเตือนว่าต้องเปิดเบราว์เซอร์อีกครั้งหรือรีสตาร์ทอุปกรณ์ตามการตั้งค่านโยบาย RelaunchNotification และ RelaunchNotificationPeriod เบราว์เซอร์และอุปกรณ์จะถูกบังคับให้รีสตาร์ทเมื่อสิ้นสุดระยะเวลาการแจ้งเตือนหากมีการตั้งค่านโยบาย RelaunchNotification เป็น \"จำเป็น\" นโยบาย RelaunchWindow นี้ใช้เพื่อเลื่อนช่วงสิ้นสุดระยะเวลาการแจ้งเตือนให้อยู่ในกรอบเวลาหนึ่งๆ ได้\n\nหากไม่ได้ตั้งค่านโยบายนี้ กรอบเวลาเป้าหมายเริ่มต้นของ Google Chrome OS จะอยู่ระหว่าง 2:00 - 4:00 น. ส่วนกรอบเวลาเป้าหมายเริ่มต้นของ Brave คือทั้งวัน (ไม่มีการเลื่อนช่วงสิ้นสุดระยะเวลาการแจ้งเตือน)\n\nหมายเหตุ: แม้ว่านโยบายจะยอมรับได้หลายรายการใน entries แต่ระบบจะพิจารณาเฉพาะรายการแรก\nคำเตือน: การตั้งค่านโยบายนี้อาจทำให้การนำอัปเดตซอฟต์แวร์ไปใช้ล่าช้า\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=RelaunchWindow";
RemoteAccessHostAllowClientPairing.pfm_title = "เปิดหรือปิดใช้การตรวจสอบสิทธิ์โดยไม่ใช้ PIN สำหรับโฮสต์การเข้าถึงระยะไกล";
RemoteAccessHostAllowClientPairing.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ผู้ใช้จับคู่ไคลเอ็นต์และโฮสต์ในเวลาเชื่อมต่อได้โดยไม่จำเป็นต้องป้อน PIN ทุกครั้ง\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" ทำให้ฟีเจอร์นี้ไม่พร้อมใช้งาน";
RemoteAccessHostAllowFileTransfer.pfm_title = "อนุญาตให้ผู้ใช้ที่เข้าถึงจากระยะไกลโอนไฟล์ไปยัง/จากโฮสต์";
RemoteAccessHostAllowFileTransfer.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ผู้ใช้เชื่อมต่อกับโฮสต์การเข้าถึงระยะไกลเพื่อโอนไฟล์ระหว่างไคลเอ็นต์และโฮสต์ได้ นโยบายนี้ไม่มีผลกับการเชื่อมต่อความช่วยเหลือระยะไกล ซึ่งไม่รองรับการโอนไฟล์\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้โอนไฟล์ไม่ได้";
RemoteAccessHostAllowPinAuthentication.pfm_title = "อนุญาต PIN และวิธีการตรวจสอบสิทธิ์การจับคู่สำหรับโฮสต์การเข้าถึงระยะไกล";
RemoteAccessHostAllowPinAuthentication.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะอนุญาตให้โฮสต์การเข้าถึงระยะไกลใช้ PIN และการตรวจสอบสิทธิ์การจับคู่เมื่อยอมรับการเชื่อมต่อไคลเอ็นต์\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะไม่อนุญาตให้ใช้ PIN หรือการตรวจสอบสิทธิ์การจับคู่\n\nการไม่ตั้งค่าจะทำให้โฮสต์เลือกได้ว่าจะใช้ PIN และ/หรือการตรวจสอบสิทธิ์การจับคู่ได้หรือไม่\n\nหมายเหตุ: หากการตั้งค่าส่งผลให้ทั้งโฮสต์และไคลเอ็นต์ไม่มีวิธีการตรวจสอบสิทธิ์ที่รองรับร่วมกัน การเชื่อมต่อจะถูกปฏิเสธ";
RemoteAccessHostAllowRelayedConnection.pfm_title = "เปิดใช้รีเลย์เซิร์ฟเวอร์โดยโฮสต์การเข้าถึงระยะไกล";
RemoteAccessHostAllowRelayedConnection.pfm_description = "หากตั้งค่า RemoteAccessHostFirewallTraversal เป็น \"เปิดใช้\" การตั้งค่า RemoteAccessHostAllowRelayedConnection เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้สามารถใช้ไคลเอ็นต์ระยะไกลเพื่อใช้รีเลย์เซิร์ฟเวอร์ในการเชื่อมต่อกับเครื่องนี้เมื่อเชื่อมต่อโดยตรงไม่ได้ เช่น เนื่องจากข้อจำกัดด้านไฟร์วอลล์\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะไม่ปิดการเข้าถึงระยะไกล แต่จะอนุญาตการเชื่อมต่อจากเครือข่ายเดียวกันเท่านั้น (ไม่อนุญาตการส่งผ่าน NAT หรือรีเลย์)";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "อนุญาตให้เข้าถึงการเชื่อมต่อกับเครื่องนี้จากระยะไกล";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "หากปิดใช้นโยบายนี้ บริการโฮสต์การเข้าถึงระยะไกลจะไม่สามารถเริ่มต้นหรือกำหนดค่าให้ยอมรับการเชื่อมต่อขาเข้า  นโยบายนี้ไม่มีผลต่อสถานการณ์การสนับสนุนระยะไกล\n\nนโยบายนี้จะไม่มีผลหากตั้งค่าเป็น \"เปิดใช้\" ปล่อยว่างไว้ หรือไม่ได้ตั้งค่า";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "อนุญาตให้มีการเชื่อมต่อกับเครื่องนี้เพื่อให้การสนับสนุนระยะไกล";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "หากปิดใช้นโยบายนี้ โฮสต์การสนับสนุนระยะไกลจะไม่สามารถเริ่มต้นหรือกำหนดค่าให้ยอมรับการเชื่อมต่อขาเข้า\n\nนโยบายนี้ไม่มีผลต่อสถานการณ์การเข้าถึงระยะไกล\n\nนโยบายนี้ยังคงให้ผู้ดูแลระบบขององค์กรเชื่อมต่อกับอุปกรณ์ Google Chrome OS ที่มีการจัดการ\n\nนโยบายนี้จะไม่มีผลหากเปิดใช้ ปล่อยว่างไว้ หรือไม่ได้ตั้งค่า";
RemoteAccessHostAllowUrlForwarding.pfm_title = "อนุญาตให้ผู้ใช้ที่เข้าถึงจากระยะไกลเปิด URL ฝั่งโฮสต์ในเบราว์เซอร์ไคลเอ็นต์ในเครื่องได้";
RemoteAccessHostAllowUrlForwarding.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าอาจทำให้ผู้ใช้ที่เชื่อมต่อกับโฮสต์การเข้าถึงระยะไกลเปิด URL ฝั่งโฮสต์ในเบราว์เซอร์ไคลเอ็นต์ในเครื่องได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะป้องกันไม่ให้โฮสต์การเข้าถึงระยะไกลส่ง URL ไปยังไคลเอ็นต์\n\nการตั้งค่านี้ไม่มีผลกับการเชื่อมต่อเพื่อรับความช่วยเหลือระยะไกล เนื่องจากโหมดการเชื่อมต่อดังกล่าวไม่รองรับฟีเจอร์นี้\n\nหมายเหตุ: ฟีเจอร์นี้ยังไม่พร้อมใช้งานสำหรับผู้ใช้ทั่วไป การเปิดใช้จึงไม่ได้หมายความว่าฟีเจอร์จะปรากฏใน UI ของไคลเอ็นต์";
RemoteAccessHostClientDomainList.pfm_title = "กำหนดค่าชื่อโดเมนที่ต้องใช้สำหรับไคลเอ็นต์การเข้าถึงระยะไกล";
RemoteAccessHostClientDomainList.pfm_description = "การตั้งค่านโยบายจะระบุชื่อโดเมนของไคลเอ็นต์ซึ่งจะกำหนดให้กับไคลเอ็นต์การเข้าถึงระยะไกล และผู้ใช้จะเปลี่ยนแปลงชื่อไม่ได้ จะมีเฉพาะไคลเอ็นต์จากโดเมนที่ระบุที่เชื่อมต่อกับโฮสต์ได้\n\nการตั้งค่านโยบายเป็นรายการที่ว่างเปล่าหรือไม่ตั้งค่าจะทำให้มีการใช้นโยบายเริ่มต้นของการเชื่อมต่อประเภทนั้นๆ สำหรับความช่วยเหลือระยะไกล ระบบจะอนุญาตให้ไคลเอ็นต์จากโดเมนต่างๆ เชื่อมต่อกับโฮสต์ได้ สำหรับการเข้าถึงระยะไกลได้ตลอดเวลา จะมีเฉพาะเจ้าของโฮสต์ที่เชื่อมต่อได้\n\nดู RemoteAccessHostDomainList เพิ่มเติม\n\nหมายเหตุ: การตั้งค่านี้จะลบล้าง RemoteAccessHostClientDomain หากมี";
RemoteAccessHostClipboardSizeBytes.pfm_title = "ขนาดสูงสุด (หน่วยเป็นไบต์) ที่สามารถโอนระหว่างไคลเอ็นต์และโฮสต์ผ่านการซิงค์ข้อมูลในคลิปบอร์ด";
RemoteAccessHostClipboardSizeBytes.pfm_description = "หากตั้งค่านโยบายนี้ ข้อมูลในคลิปบอร์ดที่ส่งไปยังและส่งจากโฮสต์จะถูกตัดให้อยู่ในขีดจำกัดที่นโยบายกำหนด\n\nการตั้งค่าเป็น 0 เป็นการปิดใช้การซิงค์คลิปบอร์ด\n\nนโยบายนี้มีผลกับทั้งสถานการณ์การเข้าถึงและการสนับสนุนระยะไกล\n\nและจะไม่มีผลหากไม่ได้ตั้งค่า\n\nการตั้งค่านโยบายเป็นค่าที่ไม่ได้อยู่ในช่วงต่ำสุด/สูงสุดอาจทำให้โฮสต์ไม่เริ่มทำงาน\n\nโปรดทราบว่าขีดจำกัดสูงสุดจริงของขนาดคลิปบอร์ดขึ้นอยู่กับขนาดสูงสุดของข้อความช่องข้อมูล WebRTC";
RemoteAccessHostDomainList.pfm_title = "กำหนดค่าชื่อโดเมนที่จำเป็นสำหรับโฮสต์การเข้าถึงระยะไกล";
RemoteAccessHostDomainList.pfm_description = "การตั้งค่านโยบายจะระบุชื่อโดเมนของโฮสต์ซึ่งจะกำหนดให้กับโฮสต์การเข้าถึงระยะไกล และผู้ใช้จะเปลี่ยนแปลงชื่อไม่ได้ ระบบจะแชร์โฮสต์ได้ต่อเมื่อใช้บัญชีที่ลงทะเบียนในชื่อโดเมนที่ระบุไว้เท่านั้น\n\nการตั้งค่านโยบายเป็นรายการที่ว่างเปล่าหรือไม่ตั้งค่าจะทำให้ระบบแชร์โฮสต์โดยใช้บัญชีใดก็ได้\n\nดู RemoteAccessHostClientDomainList เพิ่มเติม\n\nหมายเหตุ: การตั้งค่านี้จะลบล้าง RemoteAccessHostDomain หากมี";
RemoteAccessHostFirewallTraversal.pfm_title = "เปิดใช้งานไฟร์วอลล์ Traversal จากโฮสต์สำหรับการเข้าถึงระยะไกล";
RemoteAccessHostFirewallTraversal.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ใช้เซิร์ฟเวอร์ STUN ได้ ซึ่งจะทำให้ไคลเอ็นต์ระยะไกลค้นพบและเชื่อมต่อกับเครื่องนี้ได้แม้ว่าจะถูกกั้นโดยไฟร์วอลล์\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" เมื่อไฟร์วอลล์กรองการเชื่อมต่อ UDP ขาออกจะทำให้เครื่องอนุญาตการเชื่อมต่อจากเครื่องไคลเอ็นต์ภายในเครือข่าย LAN เท่านั้น";
RemoteAccessHostMatchUsername.pfm_title = "กำหนดให้ชื่อผู้ใช้ในเครื่องและเจ้าของโฮสต์การเข้าถึงระยะไกลต้องตรงกัน";
RemoteAccessHostMatchUsername.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะทำให้โฮสต์การเข้าถึงระยะไกลเปรียบเทียบชื่อของผู้ใช้เครือข่ายภายในที่เชื่อมโยงกับโฮสต์กับชื่อบัญชี Google ที่ลงทะเบียนเป็นเจ้าของโฮสต์ (\"johndoe\" หากเจ้าของโฮสต์คือ \"johndoe@example.com\") โฮสต์นี้จะไม่เริ่มหากชื่อของเจ้าของโฮสต์แตกต่างจากชื่อผู้ใช้เครือข่ายภายในที่เชื่อมโยงกับโฮสต์ หากต้องการยืนยันให้บัญชี Google ของเจ้าของเชื่อมโยงกับโดเมนที่เจาะจง ให้ใช้นโยบายกับ RemoteAccessHostDomain\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ตั้งค่าจะทำให้โฮสต์การเข้าถึงระยะไกลเชื่อมโยงกับผู้ใช้เครือข่ายภายในรายใดก็ได้";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "ระยะเวลาเซสชันสูงสุดที่อนุญาตสำหรับการเชื่อมต่อของการเข้าถึงจากระยะไกล";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "หากตั้งค่านโยบายนี้ จะมีการยกเลิกการเชื่อมต่อของการเข้าถึงจากระยะไกลโดยอัตโนมัติหลังพ้นระยะเวลา (หน่วยเป็นนาที) ที่กำหนดไว้ในนโยบาย แต่ยังคงอนุญาตให้ไคลเอ็นต์เชื่อมต่ออีกครั้งหลังครบระยะเวลาเซสชันสูงสุด การตั้งค่านโยบายเป็นค่าที่ไม่ได้อยู่ในช่วงต่ำสุด/สูงสุดอาจทำให้โฮสต์ไม่เริ่มทำงาน นโยบายนี้ไม่มีผลต่อสถานการณ์การสนับสนุนระยะไกล\n\nและจะไม่มีผลหากไม่ได้ตั้งค่า ในกรณีนี้ การเชื่อมต่อของการเข้าถึงจากระยะไกลจะไม่กำหนดระยะเวลาสูงสุดสำหรับเครื่องนี้";
RemoteAccessHostRequireCurtain.pfm_title = "เปิดใช้งานการปิดม่านโฮสต์การเข้าถึงระยะไกล";
RemoteAccessHostRequireCurtain.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะปิดอุปกรณ์อินพุตและเอาต์พุตของโฮสต์การเข้าถึงระยะไกลระหว่างการเชื่อมต่อระยะไกล\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ตั้งค่าจะทำให้ทั้งผู้ใช้เครือข่ายภายในและผู้ใช้ระยะไกลโต้ตอบกับโฮสต์ระหว่างที่แชร์ได้";
RemoteAccessHostUdpPortRange.pfm_title = "จำกัดช่วงพอร์ต UDP ที่ใช้โดยโฮสต์การเข้าถึงระยะไกล";
RemoteAccessHostUdpPortRange.pfm_description = "การตั้งค่านโยบายจะจำกัดช่วงพอร์ต UDP ที่โฮสต์การเข้าถึงระยะไกลในเครื่องนี้ใช้\n\nการไม่ตั้งค่านโยบายหรือตั้งค่าเป็นสตริงว่างจะทำให้โฮสต์การเข้าถึงระยะไกลสามารถใช้พอร์ตใดก็ได้ที่ว่างอยู่\n\nหมายเหตุ: หากปิดใช้ RemoteAccessHostFirewallTraversal โฮสต์การเข้าถึงระยะไกลจะใช้พอร์ต UDP ในช่วง 12400-12409";
RemoteDebuggingAllowed.pfm_title = "อนุญาตให้ใช้การแก้ไขข้อบกพร่องจากระยะไกล";
RemoteDebuggingAllowed.pfm_description = "ควบคุมว่าผู้ใช้จะใช้การแก้ไขข้อบกพร่องจากระยะไกลได้หรือไม่\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ผู้ใช้อาจใช้การแก้ไขข้อบกพร่องจากระยะไกลได้โดยระบุการเปลี่ยนบรรทัดคำสั่ง --remote-debugging-port และ --remote-debugging-pipe ในแพลตฟอร์มเดสก์ท็อป หรือโดยการเปิดใช้การตั้งค่าระบบการแก้ไขข้อบกพร่อง USB ใน Android\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ผู้ใช้จะไม่ได้รับอนุญาตให้ใช้การแก้ไขข้อบกพร่องจากระยะไกล";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "ต้องใช้การตรวจสอบ OCSP/CRL ออนไลน์สำหรับ Trust Anchor ในพื้นที่";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" หมายความว่า Brave จะตรวจสอบการเพิกถอนใบรับรองเซิร์ฟเวอร์ที่ได้รับการรับรองว่าใช้ได้โดยใบรับรอง CA ที่ติดตั้งไว้ในเครื่องอยู่เสมอ หาก Brave ไม่ได้รับข้อมูลสถานะการเพิกถอน Brave จะถือว่าใบรับรองดังกล่าวถูกเพิกถอน (ดึงข้อมูลไม่สำเร็จ)\n\nการตั้งค่านโยบายเป็น \"เท็จ\" หรือไม่ได้ตั้งค่า หมายความว่า Brave จะใช้การตั้งค่าการตรวจสอบการเพิกถอนทางออนไลน์ที่มีอยู่\n\nใน macOS นโยบายนี้จะไม่มีผลหากตั้งค่านโยบาย ChromeRootStoreEnabled เป็น \"เท็จ\"";
RestoreOnStartup.pfm_title = "การดำเนินการเมื่อเริ่มต้นใช้งาน";
RestoreOnStartup.pfm_description = "5 - เปิดหน้าแท็บใหม่\n1 - คืนค่าเซสชันล่าสุด\n4 - เปิดรายการ URL\n6 - เปิดรายการ URL และคืนค่าเซสชันล่าสุด\nการตั้งค่านโยบายช่วยให้คุณระบุลักษณะการทำงานของระบบเมื่อเริ่มต้นใช้งานได้ การปิดการตั้งค่านี้จะเท่ากับไม่ได้ตั้งค่า เนื่องจาก Brave ต้องมีลักษณะการทำงานที่เจาะจงเมื่อเริ่มต้นใช้งาน\n\nหากคุณตั้งค่านโยบายไว้ ผู้ใช้จะเปลี่ยนการตั้งค่าดังกล่าวใน Brave ไม่ได้ หากไม่ได้ตั้งค่า ผู้ใช้จะเปลี่ยนแปลงค่านี้ได้\n\nการตั้งค่านโยบายนี้เป็น RestoreOnStartupIsLastSession หรือ RestoreOnStartupIsLastSessionAndURLs จะปิดการตั้งค่าบางอย่างที่ต้องอาศัยเซสชันหรือที่ปฏิบัติตามคำสั่งในขณะออกจากระบบ เช่น การล้างข้อมูลการท่องเว็บเมื่อออกจากระบบหรือคุกกี้เฉพาะเซสชัน\n\nหากตั้งค่านโยบายนี้เป็น RestoreOnStartupIsLastSessionAndURLs เบราว์เซอร์จะคืนค่าเซสชันก่อนหน้า และเปิดหน้าต่างแยกเพื่อแสดง URL ที่ตั้งค่าไว้จาก RestoreOnStartupURLs โปรดทราบว่าผู้ใช้เลือกเปิด URL เหล่านั้นเอาไว้ได้ และระบบจะคืนค่า URL ดังกล่าวในเซสชันครั้งต่อไปด้วย\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
RestoreOnStartupURLs.pfm_title = "URL ที่จะเปิดเมื่อเริ่มต้นใช้งาน";
RestoreOnStartupURLs.pfm_description = "หากตั้งค่า RestoreOnStartup เป็น RestoreOnStartupIsURLs การตั้งค่า RestoreOnStartupURLs เป็นรายการ URL จะระบุ URL ที่จะเปิดขึ้น\n\nหากไม่ได้ตั้งค่า หน้าแท็บใหม่จะเปิดเมื่อเริ่มต้นใช้งาน\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "จำกัด Background Fetch API เมื่อเรียกใช้จาก Service Worker";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "นโยบายนี้ควบคุมว่าจะจำกัดคำขอของ Service Worker ในการดึงข้อมูลในเบื้องหลังหรือไม่ หากฟีเจอร์ที่ดาวน์โหลดไฟล์ในเบื้องหลังได้รับผลกระทบ นโยบายนี้อาจมีความเกี่ยวข้อง\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ข้อจำกัดจะทำงาน และคำขอดึงข้อมูลในเบื้องหลังจากบริบทของ Service Worker อาจถูกบล็อก\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ระบบจะข้ามข้อจำกัดดังกล่าว ทำให้ Service Worker ทั้งหมดส่งคำขอดึงข้อมูลในเบื้องหลังได้\n\nนโยบายระดับองค์กรนี้เป็นนโยบายชั่วคราวและจะถูกนำออกหลังจาก M152";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "จำกัดบัญชี Google ที่มีสิทธิ์ในการบันทึกไฟล์ PDF ไปยัง Google ไดรฟ์จากโปรแกรมอ่าน PDF Brave";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "มีนิพจน์ทั่วไปเพื่อกำหนดบัญชี Google ที่มีสิทธิ์ในการบันทึกไฟล์ PDF ไปยัง Google ไดรฟ์จากโปรแกรมอ่าน PDF ของ Brave\n\nระบบจะแสดงข้อผิดพลาด หากผู้ใช้พยายามอัปโหลดไฟล์ PDF ไปยัง Google ไดรฟ์โดยใช้บัญชีที่ไม่ตรงกับรูปแบบนี้\n\nหากไม่ได้ตั้งค่านโยบายนี้หรือเว้นว่างไว้ ผู้ใช้จะใช้บัญชี Google ใดก็ได้เพื่อบันทึกไฟล์ PDF ไปยัง Google ไดรฟ์";
RestrictSigninToPattern.pfm_title = "จำกัดบัญชี Google ที่อนุญาตให้ตั้งค่าเป็นบัญชีหลักของเบราว์เซอร์ใน Brave";
RestrictSigninToPattern.pfm_description = "มีนิพจน์ทั่วไปซึ่งใช้เพื่อกำหนดบัญชี Google ที่ตั้งค่าเป็นบัญชีหลักของเบราว์เซอร์ใน Brave ได้ (นั่นคือ บัญชีที่เลือกระหว่างขั้นตอนการเลือกใช้การซิงค์)\n\nข้อผิดพลาดที่เกี่ยวข้องจะแสดงขึ้นหากผู้ใช้พยายามตั้งค่าบัญชีหลักของเบราว์เซอร์ด้วยชื่อผู้ใช้ที่ไม่ตรงกับรูปแบบนี้\n\nหากไม่ได้ตั้งค่านโยบายนี้หรือเว้นว่างไว้ ผู้ใช้จะตั้งค่าบัญชี Google ใดก็ได้ให้เป็นบัญชีหลักของเบราว์เซอร์ใน Brave";
RestrictYouTubeCookiesDeletion.pfm_title = "จำกัดการลบคุกกี้ YouTube";
RestrictYouTubeCookiesDeletion.pfm_description = "ป้องกันการลบคุกกี้ YouTube ด้วยตนเอง\n\nนโยบายนี้มีจุดประสงค์เพื่อป้องกันไม่ให้ผู้ใช้เข้าถึง YouTube ที่ไม่ได้รับอนุญาตหลังจากลบคุกกี้ YouTube ด้วยตนเองจากหน้าการตั้งค่าเว็บไซต์\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" จะป้องกันไม่ให้ลบคุกกี้ YouTube ด้วยตนเอง\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าจะอนุญาตให้ลบคุกกี้ของ YouTube ได้ตามปกติ\n\nหมายเหตุ: นโยบายนี้ป้องกันการลบด้วยตนเองจาก UI การตั้งค่าเว็บไซต์เท่านั้น แต่จะไม่ป้องกันการลบอัตโนมัติโดยนโยบาย ClearBrowsingDataOnExitList หรือ BrowsingDataLifetime นอกจากนี้ หากเปิดใช้นโยบาย AllowDeletingBrowserHistory ผู้ใช้จะยังล้างคุกกี้ทั้งหมดได้ผ่านกล่องโต้ตอบล้างข้อมูลการท่องเว็บ";
SSLErrorOverrideAllowed.pfm_title = "อนุญาตให้ดำเนินการจากหน้าคำเตือน SSL";
SSLErrorOverrideAllowed.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะอนุญาตให้ผู้ใช้คลิกผ่านหน้าคำเตือนที่ Brave แสดงขึ้นเมื่อผู้ใช้ไปที่เว็บไซต์ที่มีข้อผิดพลาด SSL\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ผู้ใช้คลิกผ่านหน้าคำเตือนใดๆ ไม่ได้";
SSLErrorOverrideAllowedForOrigins.pfm_title = "อนุญาตให้ดำเนินการจากหน้าคำเตือน SSL ในต้นทางเฉพาะบางแห่ง";
SSLErrorOverrideAllowedForOrigins.pfm_description = "หากปิดใช้ SSLErrorOverrideAllowed การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบต้นทาง ซึ่งระบุเว็บไซต์ที่ผู้ใช้สามารถคลิกผ่านหน้าคำเตือนที่ Brave แสดงขึ้นเมื่อผู้ใช้ไปยังเว็บไซต์ที่มีข้อผิดพลาด SSL ผู้ใช้จะไม่สามารถคลิกผ่านหน้าคำเตือน SSL ในต้นทางที่ไม่อยู่ในรายการนี้\n\nหากเปิดใช้ SSLErrorOverrideAllowed หรือไม่ได้ตั้งค่าไว้ นโยบายนี้จะไม่ดำเนินการใดๆ\n\nการไม่ตั้งค่านโยบายหมายความว่า SSLErrorOverrideAllowed จะมีผลกับทุกเว็บไซต์\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบอินพุตที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/ * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้ นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL";
SafeBrowsingAllowlistDomains.pfm_title = "กำหนดค่ารายการโดเมนที่ Safe Browsing จะไม่เรียกให้คำเตือนแสดง";
SafeBrowsingAllowlistDomains.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หมายความว่า Google Safe Browsing จะเชื่อถือโดเมนที่คุณระบุ และจะไม่ตรวจหาทรัพยากรที่เป็นอันตราย เช่น ฟิชชิง มัลแวร์ หรือซอฟต์แวร์ไม่พึงประสงค์ บริการปกป้องการดาวน์โหลดของ Google Safe Browsing จะไม่ตรวจสอบการดาวน์โหลดที่โฮสต์ในโดเมนเหล่านี้ และบริการปกป้องรหัสผ่านก็จะไม่ตรวจสอบการใช้รหัสผ่านซ้ำ\n\nการไม่ตั้งค่านโยบายจะทำให้การปกป้องด้วย Google Safe Browsing ตามค่าเริ่มต้นมีผลกับทรัพยากรทั้งหมด\n\nนโยบายนี้ไม่รองรับนิพจน์ทั่วไป แต่ระบบจะเพิ่มโดเมนย่อยของโดเมนที่กำหนดในรายการที่อนุญาต ไม่จําเป็นต้องใช้ชื่อโดเมนที่สมบูรณ์ในตัวเอง (FQDN)\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core";
SafeBrowsingDeepScanningEnabled.pfm_title = "อนุญาตให้ดาวน์โหลดการสแกนอย่างละเอียดสำหรับผู้ใช้ที่เปิดใช้ Google Safe Browsing";
SafeBrowsingDeepScanningEnabled.pfm_description = "เมื่อเปิดใช้นโยบายนี้หรือไม่ได้ตั้งค่า Brave จะส่งการดาวน์โหลดที่น่าสงสัยจากผู้ใช้ที่เปิดใช้ Google Safe Browsing ไปยัง Google เพื่อสแกนหามัลแวร์ได้ หรือแจ้งให้ผู้ใช้ระบุรหัสผ่านสำหรับที่เก็บถาวรที่เข้ารหัส\nเมื่อปิดใช้นโยบายนี้ ระบบจะไม่ทำการสแกนนี้\nนโยบายนี้ไม่มีผลต่อการวิเคราะห์เนื้อหาดาวน์โหลดที่กำหนดค่าโดยเครื่องมือเชื่อมต่อ Chrome Enterprise";
SafeBrowsingProtectionLevel.pfm_title = "ระดับการปกป้องของ Google Safe Browsing";
SafeBrowsingProtectionLevel.pfm_description = "0 - Safe Browsing จะไม่ทำงานเลย\n1 - Google Safe Browsing ทำงานในโหมดมาตรฐาน\n2 - Google Safe Browsing ทำงานในโหมดเพิ่มประสิทธิภาพ โหมดนี้รักษาความปลอดภัยได้ดีขึ้นแต่ต้องมีการแชร์ข้อมูลการท่องเว็บกับ Google มากขึ้น\nให้คุณควบคุมว่าจะเปิดหรือปิดใช้ฟีเจอร์ Google Safe Browsing ของ Brave และกำหนดโหมดการทำงานของฟีเจอร์นี้\n\nหากตั้งค่านโยบายนี้เป็น \"NoProtection\" (ค่า 0) Google Safe Browsing จะไม่ทำงานเลย\n\nหากตั้งค่านโยบายนี้เป็น \"StandardProtection\" (ค่า 1 ซึ่งเป็นค่าเริ่มต้น) Google Safe Browsing จะทำงานในโหมดมาตรฐานเสมอ\n\nหากตั้งค่านโยบายนี้เป็น \"EnhancedProtection\" (ค่า 2) Google Safe Browsing จะทำงานในโหมดเพิ่มประสิทธิภาพเสมอ ซึ่งรักษาความปลอดภัยได้ดีขึ้นแต่ต้องมีการแชร์ข้อมูลการท่องเว็บกับ Google มากขึ้น\n\nหากตั้งค่านโยบายนี้เป็นแบบบังคับ ผู้ใช้จะเปลี่ยนหรือลบล้างการตั้งค่า Google Safe Browsing ใน Brave ไม่ได้\n\nหากไม่ได้ตั้งค่านโยบายนี้ Google Safe Browsing จะทำงานในโหมดการปกป้องแบบมาตรฐาน แต่ผู้ใช้จะเปลี่ยนการตั้งค่านี้ได้\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับ Google Safe Browsing ได้ที่ https://support.google.com/chrome?p=safe_browsing_preferences";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "อนุญาตการตรวจสอบแบบเรียลไทม์ผ่านพร็อกซีของ Google Safe Browsing";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "นโยบายนี้ใช้กำหนดว่าจะอนุญาตให้โหมดการปกป้องแบบมาตรฐานของ Google Safe Browsing ส่งแฮชแบบบางส่วนของ URL ไปยัง Google ผ่านพร็อกซีทาง Oblivious HTTP ไหม เพื่อดูว่าสามารถเข้าชมได้อย่างปลอดภัยหรือไม่\n\nพร็อกซีจะอนุญาตให้เบราว์เซอร์อัปโหลดแฮชแบบบางส่วนของ URL ไปยัง Google โดยไม่ลิงก์กับที่อยู่ IP ของผู้ใช้ นโยบายยังอนุญาตให้เบราว์เซอร์อัปโหลดแฮชแบบบางส่วนของ URL ด้วยความถี่ที่สูงขึ้น เพื่อคุณภาพการปกป้องที่ดียิ่งขึ้นของ Google Safe Browsing\n\nระบบจะไม่สนใจนโยบายนี้หาก Google Safe Browsing ปิดใช้อยู่หรือตั้งค่าเป็นโหมดการปกป้องที่ดียิ่งขึ้น\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะอนุญาตให้ทำการค้นหาผ่านพร็อกซีที่มีการปกป้องสูงขึ้นได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะไม่อนุญาตให้ทำการค้นหาผ่านพร็อกซีที่มีการปกป้องสูงขึ้น ระบบจะอัปโหลดแฮชแบบบางส่วนของ URL ไปยัง Google โดยตรงด้วยความถี่ที่ต่ำลงมาก ซึ่งจะลดระดับการปกป้องลง";
SafeBrowsingSurveysEnabled.pfm_title = "อนุญาตแบบสำรวจเกี่ยวกับ Google Safe Browsing";
SafeBrowsingSurveysEnabled.pfm_description = "เมื่อเปิดใช้นโยบายนี้หรือไม่ได้ตั้งค่า ผู้ใช้อาจได้รับแบบสำรวจเกี่ยวกับ Google Safe Browsing\nเมื่อปิดใช้นโยบายนี้ ผู้ใช้จะไม่ได้รับแบบสำรวจเกี่ยวกับ Google Safe Browsing";
SafeSitesFilterBehavior.pfm_title = "ควบคุมการกรองเนื้อหาสำหรับผู้ใหญ่ของ SafeSites";
SafeSitesFilterBehavior.pfm_description = "0 - ไม่ต้องกรองเว็บไซต์ที่มีเนื้อหาสำหรับผู้ใหญ่\n1 - กรองเว็บไซต์ที่มีเนื้อหาสำหรับผู้ใหญ่\nการตั้งค่านโยบายจะควบคุมตัวกรอง URL ของ SafeSites ซึ่งใช้ Google Safe Search API เพื่อจำแนก URL ว่าเป็นประเภทลามกอนาจารหรือไม่\n\nเมื่อตั้งค่านโยบายนี้เป็น\n\n* \"ไม่ต้องกรองเว็บไซต์ที่มีเนื้อหาสำหรับผู้ใหญ่\" หรือไม่ได้ตั้งค่า ระบบจะไม่กรองเว็บไซต์\n\n* \"กรองเว็บไซต์ที่มีเนื้อหาสำหรับผู้ใหญ่\" ระบบจะกรองเว็บไซต์ที่อยู่ในประเภทลามกอนาจารออก\n\nนโยบายนี้มีผลกับทั้ง URL ที่ผู้ใช้เข้าชมและ iframe นโยบาย URLAllowlist จะมีความสำคัญเหนือนโยบายนี้และสามารถใช้เพื่อลบล้างผลการตัดสินจาก Google Safe Search API ได้";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "อนุญาตให้ต้นทางเหล่านี้จับภาพแท็บที่มีต้นทางเดียวกัน";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งบันทึกแท็บที่มีต้นทางเดียวกันได้\n\nการไม่ตั้งค่านโยบายจะทำให้ระบบไม่พิจารณาเว็บไซต์เพื่อทำการลบล้างที่การบันทึกระดับนี้\n\nโปรดทราบว่าจะยังมีการบันทึกแอป Chrome ในโหมดหน้าต่างซึ่งมีต้นทางเดียวกับเว็บไซต์นี้ได้อยู่\n\nหากเว็บไซต์ตรงกับรูปแบบ URL ในนโยบายนี้ ระบบจะไม่พิจารณานโยบาย TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins และ ScreenCaptureAllowed\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/  นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL";
SandboxExternalProtocolBlocked.pfm_title = "อนุญาตให้ Chrome บล็อกการเรียกออกไปยังโปรโตคอลนอก iframe ที่ทำแซนด์บ็อกซ์";
SandboxExternalProtocolBlocked.pfm_description = "Chrome จะบล็อกการเรียกออกไปยังโปรโตคอลนอก iframe ที่ทำแซนด์บ็อกซ์ ดู https://chromestatus.com/features/5680742077038592\n\nเมื่อเป็นจริง Chrome จะบล็อกการเรียกออกไปดังกล่าว\n\nเมื่อเป็นเท็จ Chrome จะไม่บล็อกการเรียกออกไปดังกล่าว\n\nค่าเริ่มต้นจะเป็นจริง นั่นคือฟีเจอร์ความปลอดภัยจะเปิดใช้อยู่\n\nซึ่งอาจใช้โดยผู้ดูแลระบบที่ต้องการเวลามากขึ้นในการอัปเดตเว็บไซต์ภายในซึ่งได้รับผลกระทบจากข้อจำกัดใหม่นี้ นโยบายองค์กรนี้เป็นนโยบายชั่วคราว และมีแผนที่จะนำออกหลัง Brave เวอร์ชัน 117\n";
SavingBrowserHistoryDisabled.pfm_title = "ปิดใช้งานการบันทึกประวัติเบราว์เซอร์";
SavingBrowserHistoryDisabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หมายความว่าจะไม่มีการบันทึกประวัติการท่องเว็บ การซิงค์แท็บจะปิด และผู้ใช้เปลี่ยนการตั้งค่านี้ไม่ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าจะบันทึกประวัติการท่องเว็บ";
ScreenCaptureAllowed.pfm_title = "อนุญาตหรือปฏิเสธการจับภาพหน้าจอ";
ScreenCaptureAllowed.pfm_description = "หากเปิดใช้หรือไม่ได้กำหนดค่า (ค่าเริ่มต้น) หน้าเว็บจะใช้ API การแชร์หน้าจอ (เช่น getDisplayMedia() หรือ API ส่วนขยายสำหรับการจับภาพเดสก์ท็อป) เพื่อแจ้งให้ผู้ใช้เลือกแท็บ หน้าต่าง หรือเดสก์ท็อปที่จะจับภาพได้\n\nเมื่อปิดใช้นโยบายนี้ การเรียกใช้ API การแชร์หน้าจอจะไม่สำเร็จและมีข้อความแสดงข้อผิดพลาด อย่างไรก็ตาม ระบบจะไม่พิจารณานโยบายนี้ (และเว็บไซต์จะได้รับอนุญาตให้ใช้ API การแชร์หน้าจอ) หากเว็บไซต์ตรงกับรูปแบบต้นทางในนโยบาย ScreenCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins หรือ SameOriginTabCaptureAllowedByOrigins\n";
ScreenCaptureAllowedByOrigins.pfm_title = "อนุญาตให้ต้นทางเหล่านี้จับภาพเดสก์ท็อป หน้าต่าง และแท็บ";
ScreenCaptureAllowedByOrigins.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งใช้การจับภาพเดสก์ท็อป หน้าต่าง และแท็บได้\n\nการไม่ตั้งค่านโยบายจะทำให้ระบบไม่พิจารณาเว็บไซต์เพื่อทำการลบล้างที่การจับภาพระดับนี้\n\nระบบจะไม่พิจารณานโยบายนี้หากเว็บไซต์ตรงกับรูปแบบ URL ในนโยบาย WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins หรือ SameOriginTabCaptureAllowedByOrigins\n\nหากเว็บไซต์ตรงกับรูปแบบ URL ในนโยบายนี้ ระบบจะไม่พิจารณา ScreenCaptureAllowed\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/  นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "อนุญาตให้จับภาพหน้าจอโดยไม่ต้องมีท่าทางสัมผัสของผู้ใช้ก่อนหน้า";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "เนื่องด้วยเหตุผลด้านความปลอดภัย API ของเว็บ getDisplayMedia() จำเป็นต้องเรียกใช้ด้วยการโต้ตอบจากผู้ใช้ก่อนหน้า (\"Transient Activation\") มิเช่นนั้นจะดำเนินการไม่สำเร็จ\n\nเมื่อตั้งค่านโยบายนี้ ผู้ดูแลระบบสามารถระบุต้นทางที่จะเรียกใช้ API นี้ได้โดยไม่ต้องมีการโต้ตอบจากผู้ใช้ก่อนหน้า\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องได้ที่\nhttps://chromeenterprise.google/policies/url-patterns/ * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้\n\nหากไม่ได้ตั้งค่านโยบายนี้ ต้นทางทั้งหมดจะกำหนดให้ต้องมีการโต้ตอบจากผู้ใช้ก่อนหน้าเพื่อเรียกใช้ API นี้";
ScrollToTextFragmentEnabled.pfm_title = "เปิดใช้การเลื่อนไปยังข้อความที่เจาะจงใน Fragment ของ URL";
ScrollToTextFragmentEnabled.pfm_description = "ฟีเจอร์นี้ช่วยให้นำทาง URL จากไฮเปอร์ลิงก์และแถบที่อยู่ไปยังข้อความเป้าหมายที่เจาะจงภายในหน้าเว็บได้ ซึ่งหน้าเว็บจะเลื่อนไปยังตำแหน่งดังกล่าวเมื่อโหลดเสร็จแล้ว\n\nหากเปิดใช้หรือไม่ได้กำหนดค่านโยบายนี้ ระบบจะเปิดใช้การเลื่อนหน้าเว็บไปยัง Fragment ของข้อความที่เจาะจงผ่าน URL\n\nหากคุณปิดใช้นโยบายนี้ ระบบจะปิดใช้การเลื่อนหน้าเว็บไปยัง Fragment ของข้อความที่เจาะจงผ่าน URL";
SearchContentSharingSettings.pfm_title = "เปิดใช้การแชร์เนื้อหาด้วยการผสานรวม Google AI Mode และ Lens";
SearchContentSharingSettings.pfm_description = "0 - อนุญาตให้แชร์เนื้อหากับการผสานรวม Google AI Mode\n1 - ไม่อนุญาตให้แชร์เนื้อหากับการผสานรวม Google AI Mode\nนโยบายนี้ควบคุมการแชร์เนื้อหาของหน้าและไฟล์กับ Google AI Mode และ Lens ผ่านแผงด้านข้างหรือแท็บของ Google Chrome\n\nโปรดทราบว่านโยบายนี้ไม่มีผลต่อ Google AI Mode บนเว็บ โดยจะควบคุมเฉพาะวิธีที่ผู้ใช้แชร์ข้อมูลกับแอปเมื่อใช้ Google Chrome\n\n0 = ผู้ใช้จะแชร์เนื้อหาของหน้าหรือไฟล์กับ Google AI Mode ได้\n\n1 = ผู้ใช้แชร์เนื้อหาในหน้าหรือไฟล์กับ Google AI Mode ไม่ได้ จุดแรกเข้าสำหรับการแชร์บริบทและแผงด้านข้างจะถูกปิดใช้หรือซ่อนไว้\n\nระบบจะไม่สนใจนโยบายนี้เมื่อ Google Search ไม่ใช่เครื่องมือค้นหาเริ่มต้นของผู้ใช้ เนื่องจากฟีเจอร์นี้ปิดใช้อยู่\n\nนโยบายนี้ไม่ขึ้นอยู่กับนโยบาย AIModeSettings นโยบาย AIModeSettings จะควบคุมเฉพาะจุดแรกเข้าในแถบอเนกประสงค์หรือช่องค้นหาใน NTP ขณะที่นโยบายนี้ควบคุมการแชร์บริบทผ่านแผงด้านข้างหรือแท็บ\n\nและนโยบายนี้ก็ไม่ได้ควบคุมการผสานรวม Google Gemini ซึ่ง GeminiSettings สามารถปิดใช้ได้\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
SearchSuggestEnabled.pfm_title = "เปิดใช้งานคำแนะนำในการค้นหา";
SearchSuggestEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" จะเปิดการแนะนำการค้นหาในแถบที่อยู่ของ Brave การตั้งค่านโยบายเป็น \"เท็จ\" จะปิดการแนะนำการค้นหาเหล่านี้\n\nคำแนะนำที่อิงตามบุ๊กมาร์กหรือประวัติการเข้าชมจะไม่ได้รับผลกระทบจากนโยบาย\n\nหากคุณตั้งค่านโยบายไว้ ผู้ใช้จะเปลี่ยนไม่ได้ หากไม่ได้ตั้งค่า การแนะนำการค้นหาจะเปิดอยู่ในตอนแรก แต่ผู้ใช้จะปิดได้ทุกเมื่อ";
SecurityKeyPermitAttestation.pfm_title = "URL/โดเมนอนุญาตการยืนยันกุญแจรักษาความปลอดภัยโดยตรงโดยอัตโนมัติ";
SecurityKeyPermitAttestation.pfm_description = "การตั้งค่านโยบายจะระบุ WebAuthn RP ID ที่จะไม่แสดงข้อความแจ้งเมื่อมีการขอใบรับรองสำหรับเอกสารรับรองจากคีย์ความปลอดภัย และจะมีการส่งสัญญาณไปยังคีย์ความปลอดภัยด้วยเพื่อระบุว่าอาจมีการใช้เอกสารรับรองขององค์กร หากไม่ได้ตั้งค่านโยบายนี้ไว้ เมื่อเว็บไซต์ขอเอกสารรับรองของคีย์ความปลอดภัย ผู้ใช้จะได้รับข้อความแจ้งใน Brave เวอร์ชัน 65 ขึ้นไป";
SensorsAllowedForUrls.pfm_title = "อนุญาตให้เข้าถึงเซ็นเซอร์ในเว็บไซต์เหล่านี้";
SensorsAllowedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ที่ระบุเว็บไซต์ที่เข้าถึงเซ็นเซอร์ เช่น เซ็นเซอร์ตรวจจับการเคลื่อนไหวและเซ็นเซอร์แสงได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultSensorsSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nหากมีรูปแบบ URL เดียวกันอยู่ทั้งในนโยบายนี้และนโยบาย SensorsBlockedForUrls ระบบจะให้ความสำคัญกับนโยบายหลังและสิทธิ์เข้าถึงเซ็นเซอร์ตรวจจับการเคลื่อนไหวหรือเซ็นเซอร์แสงจะถูกบล็อก\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
SensorsBlockedForUrls.pfm_title = "บล็อกสิทธิ์เข้าถึงเซ็นเซอร์ในเว็บไซต์เหล่านี้";
SensorsBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ที่ระบุเว็บไซต์ที่เข้าถึงเซ็นเซอร์ เช่น เซ็นเซอร์ตรวจจับการเคลื่อนไหวและเซ็นเซอร์แสงไม่ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultSensorsSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nหากมีรูปแบบ URL เดียวกันอยู่ทั้งในนโยบายนี้และนโยบาย SensorsAllowedForUrls ระบบจะให้ความสำคัญกับนโยบายนี้และสิทธิ์เข้าถึงเซ็นเซอร์ตรวจจับการเคลื่อนไหวหรือเซ็นเซอร์แสงจะถูกบล็อก\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้";
SerialAllowAllPortsForUrls.pfm_title = "ให้สิทธิ์เว็บไซต์โดยอัตโนมัติในการเชื่อมต่อกับพอร์ตอนุกรมทุกพอร์ต";
SerialAllowAllPortsForUrls.pfm_description = "การตั้งค่านโยบายนี้ให้คุณระบุเว็บไซต์ที่ได้รับสิทธิ์โดยอัตโนมัติในการเข้าถึงพอร์ตอนุกรมที่ใช้ได้ทุกพอร์ต\n\nURL ต้องใช้การได้ มิเช่นนั้น นโยบายจะไม่มีผล ระบบพิจารณาเฉพาะต้นทาง (รูปแบบ โฮสต์ และพอร์ต) ของ URL เท่านั้น\n\nใน Google Chrome OS นโยบายนี้จะมีผลเฉพาะกับผู้ใช้ที่เชื่อมโยงเท่านั้น\n\nนโยบายนี้จะลบล้าง DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls และค่ากำหนดของผู้ใช้";
SerialAllowUsbDevicesForUrls.pfm_title = "ให้สิทธิ์เว็บไซต์ต่างๆ โดยอัตโนมัติในการเชื่อมต่อกับอุปกรณ์ซีเรียล USB";
SerialAllowUsbDevicesForUrls.pfm_description = "การตั้งค่านโยบายนี้ให้คุณระบุเว็บไซต์ที่ได้รับสิทธิ์โดยอัตโนมัติในการเข้าถึงอุปกรณ์ซีเรียล USB ซึ่งมีรหัสผู้ให้บริการและรหัสสินค้าที่ตรงกับช่อง vendor_id และ product_id การไม่ระบุช่อง product_id จะทำให้เว็บไซต์ดังกล่าวมีสิทธิ์เข้าถึงอุปกรณ์ที่มีรหัสผู้ให้บริการตรงกับช่อง vendor_id แต่มีรหัสสินค้าใดก็ได้\n\nURL ต้องใช้การได้ มิเช่นนั้น นโยบายจะไม่มีผล ระบบพิจารณาเฉพาะต้นทาง (รูปแบบ โฮสต์ และพอร์ต) ของ URL เท่านั้น\n\nใน Chrome OS นโยบายนี้จะมีผลเฉพาะกับผู้ใช้ที่เชื่อมโยงเท่านั้น\n\nนโยบายนี้จะลบล้าง DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls และค่ากำหนดของผู้ใช้\n\nรวมถึงจะมีผลเฉพาะกับสิทธิ์เข้าถึงอุปกรณ์ USB ผ่าน Web Serial API เท่านั้น หากต้องการให้สิทธิ์เข้าถึงอุปกรณ์ USB ผ่าน WebUSB API ให้ดูนโยบาย WebUsbAllowDevicesForUrls\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls";
SerialAskForUrls.pfm_title = "อนุญาต Serial API ในเว็บไซต์เหล่านี้";
SerialAskForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ขอให้ผู้ใช้ให้สิทธิ์เข้าถึงพอร์ตอนุกรมได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultSerialGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nสำหรับรูปแบบ URL ที่ไม่ตรงกับนโยบาย SerialBlockedForUrls (หากมีการจับคู่) DefaultSerialGuardSetting (หากตั้งค่าไว้) หรือการตั้งค่าส่วนตัวของผู้ใช้จะมีความสำคัญเหนือกว่าตามลำดับข้างต้น\n\nหากรูปแบบ URL ขัดแย้งกับ SerialBlockedForUrls ระบบจะไม่สนใจรูปแบบดังกล่าว\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
SerialBlockedForUrls.pfm_title = "บล็อก Serial API ในเว็บไซต์เหล่านี้";
SerialBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่สามารถขอให้ผู้ใช้ให้สิทธิ์เข้าถึงพอร์ตอนุกรมได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultSerialGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nสำหรับรูปแบบ URL ที่ไม่ตรงกับนโยบาย SerialAskForUrls (หากมีการจับคู่) DefaultSerialGuardSetting (หากตั้งค่าไว้) หรือการตั้งค่าส่วนตัวของผู้ใช้จะมีความสำคัญเหนือกว่าตามลำดับข้างต้น\n\nหากรูปแบบ URL ขัดแย้งกับ SerialAskForUrls นโยบายนี้จะมีความสำคัญเหนือกว่า\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
ServiceWorkerAutoPreloadEnabled.pfm_title = "อนุญาตให้ ServiceWorker ส่งคำขอไปยังส่วนต่างๆ โดยไม่ต้องรอให้เริ่มต้น";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nฟีเจอร์ ServiceWorkerAutoPreload จะส่งคำขอเครือข่ายสำหรับทรัพยากรหลักในเวลาเดียวกันกับที่เริ่มกระบวนการเริ่มต้นระบบ ServiceWorker\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ Brave เปิดใช้ ServiceWorkerAutoPreload ระบบจะส่งคำขอไปยังส่วนต่างๆ โดยอัตโนมัติขณะเริ่มต้น ServiceWorker ในบางสถานการณ์ เช่น ServiceWorker ไม่ทำงาน\n\nหากปิดใช้แล้ว Brave จะไม่เปิดใช้ ServiceWorkerAutoPreload คำขอไปยังส่วนต่างๆ จะถูกส่งเสมอหลังจากเริ่มต้น Service Worker\n\nนโยบายนี้เป็นมาตรการชั่วคราวเพื่อควบคุมฟีเจอร์และจะถูกนำออกใน M154";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "อนุญาตให้ ServiceWorker ควบคุม iframe ของ srcdoc";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "https://github.com/w3c/ServiceWorker/issues/765 ขอให้ iframe ของ srcdoc ที่มีแอตทริบิวต์แซนด์บ็อกซ์ \"allow-same-origin\" อยู่ภายใต้การควบคุมของ ServiceWorker\n\nเมื่อตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าไว้ Brave จะทำให้ iframe ของ srcdoc ที่มีแอตทริบิวต์แซนด์บ็อกซ์ \"allow-same-origin\" อยู่ภายใต้การควบคุมของ ServiceWorker\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ iframe ของ srcdoc ไม่ได้รับการควบคุมโดย ServiceWorker\n\nนโยบายนี้มีไว้เพื่อใช้ชั่วคราวและจะนำออกในปี 2026";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "ระบุว่าสามารถใช้ SharedArrayBuffers ในบริบทที่แยกออกมาแบบไม่ข้ามต้นทางได้หรือไม่";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\nระบุว่าสามารถใช้ SharedArrayBuffers ในบริบทที่แยกแบบไม่ข้ามต้นทางได้หรือไม่ Brave จะต้องใช้การแยกแบบข้ามต้นทางเมื่อใช้ SharedArrayBuffers นับตั้งแต่ Brave 91 เป็นต้นไป (25-05-2021) ด้วยเหตุผลด้านความเข้ากันได้กับเว็บ ดูรายละเอียดเพิ่มเติมได้ที่ https://developer.chrome.com/blog/enabling-shared-array-buffer/\n\nเมื่อตั้งค่าเป็น \"เปิดใช้\" เว็บไซต์จะใช้ SharedArrayBuffer ได้โดยไม่มีข้อจำกัด\n\nเมื่อตั้งค่าเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า เว็บไซต์จะใช้ SharedArrayBuffers ได้เฉพาะเมื่อมีการแยกแบบข้ามต้นทาง";
SharedWorkerBlobURLFixEnabled.pfm_title = "ทำให้ลักษณะการทำงานที่ SharedWorker ทำกับ URL ของ BLOB สอดคล้องกับข้อมูลจำเพาะ";
SharedWorkerBlobURLFixEnabled.pfm_description = "ตาม https://w3c.github.io/ServiceWorker/#control-and-use-worker-client นั้น\nWorker ควรจะรับ Controller สำหรับ URL ของ BLOB มาใช้ต่อ  อย่างไรก็ตาม โค้ดที่มีอยู่จะอนุญาตเฉพาะ DedicatedWorker ให้รับ Controller มาใช้ต่อ และ SharedWorker จะไม่รับ Controller มาใช้ต่อ\n\nเมื่อตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าไว้ Brave จะรับ Controller มาใช้ต่อหากมีการใช้ URL ของ BLOB เป็น URL ของ SharedWorker\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ลักษณะการทํางานเป็นไปตามเดิมโดยไม่สอดคล้องกับข้อมูลจำเพาะ\n\nนโยบายนี้มีไว้เพื่อใช้งานชั่วคราวและจะนำออกในอนาคต";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "เปิดใช้การยืดอายุการใช้งานสำหรับ SharedWorker";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "SharedWorker สามารถยืดอายุการใช้งานได้หากตั้งค่าตัวเลือก \"extendedLifetime\" เป็น \"จริง\" ในตัวสร้าง SharedWorker\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า SharedWorker จะยืดอายุการใช้งานให้ยาวนานขึ้นได้\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" SharedWorker จะไม่สามารถยืดอายุการใช้งานได้ แม้ว่าจะตั้งค่าตัวเลือกเป็น \"จริง\" ก็ตาม\n\nนโยบายนี้มีไว้เพื่อใช้ชั่วคราวและจะนำออกในอนาคต";
ShoppingListEnabled.pfm_title = "อนุญาตให้เปิดใช้ฟีเจอร์รายการช็อปปิ้ง";
ShoppingListEnabled.pfm_description = "นโยบายนี้ควบคุมความพร้อมใช้งานของฟีเจอร์รายการช็อปปิ้ง\nหากเปิดใช้ ระบบจะแสดง UI แก่ผู้ใช้เพื่อติดตามราคาของสินค้าที่ปรากฏในหน้าปัจจุบัน สินค้าที่ติดตามจะแสดงในแผงด้านข้างของบุ๊กมาร์ก\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ฟีเจอร์รายการช็อปปิ้งจะพร้อมใช้งานสำหรับผู้ใช้\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ฟีเจอร์รายการช็อปปิ้งจะใช้งานไม่ได้\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "แสดงทางลัดของแอปในแถบบุ๊กมาร์ก";
ShowAppsShortcutInBookmarkBar.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" แสดงทางลัดของแอป การตั้งค่านโยบายเป็น \"เท็จ\" หมายความว่าทางลัดนี้จะไม่ปรากฏขึ้น\n\nหากคุณตั้งค่านโยบายนี้ ผู้ใช้จะเปลี่ยนไม่ได้ หากไม่ได้ตั้งค่า ผู้ใช้จะเป็นผู้เลือกว่าจะแสดงหรือซ่อนทางลัดของแอปในเมนูตามบริบทของแถบบุ๊กมาร์ก";
ShowCastIconInToolbar.pfm_title = "แสดงไอคอนแถบเครื่องมือของ Google Cast";
ShowCastIconInToolbar.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะแสดงไอคอน \"แคสต์\" ในแถบเครื่องมือหรือในเมนูรายการเพิ่มเติม และผู้ใช้จะนำออกไม่ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้ผู้ใช้ปักหมุดหรือนำไอคอนออกได้ผ่านทางเมนูตามบริบทของไอคอนนั้นๆ\n\nหากตั้งค่านโยบาย EnableMediaRouter เป็น \"ปิดใช้\" ค่าของนโยบายนี้ก็จะไม่มีผล และไอคอนแถบเครื่องมือจะไม่แสดงขึ้นมา";
ShowCastSessionsStartedByOtherDevices.pfm_title = "แสดงตัวควบคุมสื่อสำหรับเซสชัน Google Cast ที่เริ่มต้นโดยอุปกรณ์อื่นๆ ในเครือข่ายภายใน";
ShowCastSessionsStartedByOtherDevices.pfm_description = "เมื่อเปิดใช้นโยบายนี้ UI ตัวควบคุมการเล่นสื่อจะพร้อมใช้งานสำหรับเซสชัน Google Cast ที่เริ่มต้นโดยอุปกรณ์อื่นๆ ในเครือข่ายภายใน\n\nเมื่อไม่ได้ตั้งค่านโยบายนี้สำหรับผู้ใช้ระดับองค์กรหรือปิดใช้ไว้ UI ตัวควบคุมการเล่นสื่อจะไม่พร้อมใช้งานสำหรับเซสชัน Google Cast ที่เริ่มต้นโดยอุปกรณ์อื่นๆ ในเครือข่ายภายใน\n\nหากปิดใช้นโยบาย EnableMediaRouter ค่าของนโยบายนี้จะไม่มีผลเนื่องจากฟังก์ชันการทำงานทั้งหมดของ Google Cast ปิดใช้อยู่";
ShowFullUrlsInAddressBar.pfm_title = "แสดง URL แบบเต็ม";
ShowFullUrlsInAddressBar.pfm_description = "ฟีเจอร์นี้จะเปิดใช้การแสดง URL แบบเต็มในแถบที่อยู่\nหากตั้งค่านโยบายนี้เป็น \"จริง\" ระบบจะแสดง URL แบบเต็มในแถบที่อยู่ รวมถึงรูปแบบและโดเมนย่อยต่างๆ\nหากตั้งค่านโยบายนี้เป็น \"เท็จ\" ระบบจะใช้การแสดง URL โดยค่าเริ่มต้น\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะใช้การแสดง URL โดยค่าเริ่มต้น และผู้ใช้จะสลับระหว่างการแสดง URL โดยค่าเริ่มต้นและแบบเต็มได้ด้วยตัวเลือกเมนูตามบริบท\n";
ShowHomeButton.pfm_title = "แสดงปุ่ม \"หน้าแรก\" บนแถบเครื่องมือ";
ShowHomeButton.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะแสดงปุ่มหน้าแรกในแถบเครื่องมือของ Brave การตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ปุ่มหน้าแรกไม่ปรากฏขึ้นมา\n\nหากคุณตั้งค่านโยบายไว้ ผู้ใช้จะเปลี่ยนการตั้งค่าดังกล่าวใน Brave ไม่ได้ หากไม่ได้ตั้งค่า ผู้ใช้จะเลือกว่าจะแสดงปุ่มหน้าแรกหรือไม่";
SideSearchEnabled.pfm_title = "อนุญาตให้แสดงหน้าผลการค้นหาล่าสุดของเครื่องมือค้นหาเริ่มต้นในแผงด้านข้าง";
SideSearchEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่านโยบายหมายความว่าผู้ใช้สามารถแสดงหน้าผลการค้นหาล่าสุดของเครื่องมือค้นหาเริ่มต้นในแผงด้านข้างผ่านการเปิด/ปิดไอคอนในแถบเครื่องมือ\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะนำไอคอนดังกล่าวออกจากแถบเครื่องมือที่เปิดแผงด้านข้างซึ่งมีหน้าผลการค้นหาของเครื่องมือค้นหาเริ่มต้นอยู่";
SignedHTTPExchangeEnabled.pfm_title = "เปิดใช้การสนับสนุน Signed HTTP Exchange (SXG)";
SignedHTTPExchangeEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" หรือไม่ได้ตั้งค่าหมายความว่า Brave จะยอมรับเนื้อหาเว็บที่แสดงเป็น Signed HTTP Exchange\n\nการตั้งค่านโยบายเป็น \"เท็จ\" จะป้องกันไม่ให้ Signed HTTP Exchange โหลด";
SigninInterceptionEnabled.pfm_title = "เปิดใช้การสกัดกั้นการลงชื่อเข้าใช้";
SigninInterceptionEnabled.pfm_description = "การตั้งค่านี้จะเปิดหรือปิดใช้การสกัดกั้นการลงชื่อเข้าใช้\n\nเมื่อไม่ได้ตั้งค่านโยบายนี้หรือเปิดใช้ กล่องโต้ตอบการสกัดกั้นการลงชื่อเข้าใช้จะแสดงขึ้นมาเมื่อมีการเพิ่มบัญชี Google ในเว็บ และผู้ใช้อาจได้รับประโยชน์จากการย้ายบัญชีนี้ไปยังโปรไฟล์อื่น (โปรไฟล์ใหม่หรือที่มีอยู่แล้ว)\n\nเมื่อปิดใช้นโยบายนี้ กล่องโต้ตอบการสกัดกั้นการลงชื่อเข้าใช้จะไม่แสดงขึ้นมา\nเมื่อปิดใช้นโยบายนี้ กล่องโต้ตอบจะยังแสดงอยู่หากมีการบังคับใช้การแยกโปรไฟล์บัญชีที่จัดการโดย ManagedAccountsSigninRestriction";
SilentPrintingEnabled.pfm_title = "เปิดใช้การพิมพ์แบบเงียบ";
SilentPrintingEnabled.pfm_description = "การตั้งค่านโยบายนี้เป็น \"จริง\" จะเปิดใช้การพิมพ์แบบเงียบ ซึ่งจะปิดหน้าต่างแสดงตัวอย่างการพิมพ์ทันทีเมื่อเปิด และพิมพ์ไปยังเครื่องพิมพ์เริ่มต้นด้วยตัวเลือกเริ่มต้น หากเครื่องพิมพ์เริ่มต้นคือ \"บันทึกเป็น PDF\" ระบบจะบันทึกไฟล์ลงในโฟลเดอร์ดาวน์โหลด\n\nการไม่ตั้งค่านโยบายนี้หรือตั้งค่านโยบายนี้เป็น \"เท็จ\" จะปิดใช้การพิมพ์แบบเงียบ ซึ่งจะไม่ปิดหน้าต่างแสดงตัวอย่างการพิมพ์โดยอัตโนมัติ และกำหนดให้ผู้ใช้ต้องเลือกตามปกติ";
SitePerProcess.pfm_title = "ต้องมีการแยกเว็บไซต์สำหรับทุกเว็บไซต์";
SitePerProcess.pfm_description = "ตั้งแต่ Brave เวอร์ชัน 67 การแยกเว็บไซต์จะเปิดใช้ไว้โดยค่าเริ่มต้นในแพลตฟอร์มเดสก์ท็อปทั้งหมด ซึ่งทำให้ทุกเว็บไซต์ทำงานด้วยกระบวนการของตนเองได้ เว็บไซต์อยู่ในรูปแบบบวก eTLD+1 (เช่น https://example.com) การตั้งค่านโยบายนี้เป็น \"เปิดใช้\" ไม่ได้เปลี่ยนลักษณะการทำงานดังกล่าว เพียงแต่ป้องกันไม่ให้ผู้ใช้เลือกไม่ใช้ (เช่น การใช้ Disable site isolation (ปิดใช้การแยกเว็บไซต์) ใน chrome://flags) ตั้งแต่ Brave เวอร์ชัน 76 การตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าจะไม่ปิดการแยกเว็บไซต์ แต่จะอนุญาตให้ผู้ใช้สามารถเลือกไม่ใช้ได้\n\nIsolateOrigins อาจเป็นประโยชน์ในการแยกต้นทางเฉพาะบางแห่งในระดับที่ละเอียดกว่าเว็บไซต์ด้วย (เช่น https://a.example.com)\n\nใน Google Chrome OS เวอร์ชัน 76 และเวอร์ชันก่อนหน้า ให้ตั้งค่านโยบายด้านอุปกรณ์ DeviceLoginScreenSitePerProcess ด้วยค่าเดียวกันนี้ (หากค่าไม่ตรงกัน อาจเกิดความล่าช้าเมื่อเข้าสู่เซสชันของผู้ใช้)\n\nหมายเหตุ: สำหรับ Android ให้ใช้นโยบาย SitePerProcessAndroid แทน";
SiteSearchSettings.pfm_title = "การตั้งค่าการค้นหาเว็บไซต์";
SiteSearchSettings.pfm_description = "นโยบายนี้แสดงรายการเว็บไซต์ที่ผู้ใช้ค้นหาได้อย่างรวดเร็วโดยใช้ทางลัดในแถบที่อยู่ ผู้ใช้เริ่มการค้นหาได้โดยการพิมพ์ทางลัดหรือ @ทางลัด (เช่น @งาน) ตามด้วยการกด Space หรือ Tab ในแถบที่อยู่\n\nต้องระบุข้อมูลในช่องต่อไปนี้สำหรับแต่ละเว็บไซต์: name, shortcut, url\n\nช่อง name สอดคล้องกับชื่อเว็บไซต์หรือเครื่องมือค้นหาที่จะแสดงให้ผู้ใช้เห็นในแถบที่อยู่\n\nshortcut มีคำและอักขระธรรมดาได้ แต่ต้องไม่มีการเว้นวรรคหรือเริ่มต้นด้วยสัญลักษณ์ @ และทางลัดต้องไม่ซ้ำกันด้วย\n\nช่อง url ของแต่ละรายการจะระบุ URL ของเครื่องมือค้นหาที่ใช้ในระหว่างการค้นหาด้วยคีย์เวิร์ดที่เกี่ยวข้อง URL ดังกล่าวต้องมีสตริง '{searchTerms}' ซึ่งข้อความค้นหาของผู้ใช้จะมาแทนที่ในคำค้นหา ระบบจะไม่สนใจข้อมูลที่ไม่ถูกต้องและข้อมูลที่มีทางลัดซ้ำกัน\n\nรายการการค้นหาเว็บไซต์ที่กำหนดค่าไว้เป็น \"แนะนำ\" จะแสดงในแถบที่อยู่เมื่อผู้ใช้พิมพ์ \"@\" โดยสามารถเลือกรายการแนะนำได้สูงสุด 3 รายการ\n\nสำหรับรายการการค้นหาเว็บไซต์ที่ allow_user_override เป็น \"จริง\" ผู้ใช้จะสามารถแก้ไขหรือปิดใช้รายการนั้นได้ อย่างไรก็ตาม เครื่องมือที่แนะนำ (ขึ้นต้นด้วย \"@\") จะปิดใช้ได้เท่านั้น หากผู้ใช้แก้ไขรายการที่นโยบายนี้สร้างขึ้นในตอนแรก รายการดังกล่าวจะไม่ได้รับการจัดการโดยนโยบายอีกต่อไปและจะดำเนินการเหมือนทางลัดที่ผู้ใช้สร้างขึ้น เมื่อ allow_user_override เป็น \"เท็จ\" หรือไม่ระบุไว้สําหรับรายการการค้นหาเว็บไซต์ ผู้ใช้จะไม่สามารถแก้ไขหรือปิดใช้รายการนั้นได้ การตั้งค่าเพื่ออนุญาตให้ผู้ใช้ลบล้างได้รับการรองรับใน M139 ขึ้นไปเท่านั้น โดยเวอร์ชันก่อนหน้าจะปิดใช้การลบล้างของผู้ใช้โดยค่าเริ่มต้น\n\nผู้ใช้ไม่สามารถสร้างรายการการค้นหาเว็บไซต์ใหม่โดยใช้ทางลัดที่สร้างไว้ก่อนหน้านี้ผ่านทางนโยบายนี้ เว้นแต่จะมีการตั้งค่า allow_user_override เป็น \"จริง\" สำหรับรายการการค้นหาเว็บไซต์\n\nในกรณีที่ขัดแย้งกับทางลัดที่ผู้ใช้สร้างไว้ก่อนหน้านี้ การตั้งค่าของผู้ใช้จะมีความสำคัญเหนือกว่า อย่างไรก็ตาม ผู้ใช้ยังคงเรียกใช้ตัวเลือกที่นโยบายสร้างขึ้นได้โดยพิมพ์ \"@\" ในแถบค้นหา เช่น หากผู้ใช้กำหนด \"งาน\" เป็นทางลัดไปยัง URL1 ไว้แล้ว และนโยบายกำหนด \"งาน\" เป็นทางลัดไปยัง URL2 การพิมพ์คำว่า \"งาน\" ในแถบค้นหาจะเริ่มการค้นหาไปยัง URL1 แต่การพิมพ์ \"@งาน\" ในแถบค้นหาจะเริ่มการค้นหาไปยัง URL2\n\nใน Microsoft® Windows® นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่เข้าร่วมโดเมน Microsoft® Active Directory®, เข้าร่วม Microsoft® Azure® Active Directory® หรือลงทะเบียนใน Chrome Enterprise Core\n\nใน macOS นโยบายนี้ใช้ได้เฉพาะในอินสแตนซ์ที่จัดการผ่าน MDM, เข้าร่วมโดเมนผ่าน MCX หรือลงทะเบียนใน Chrome Enterprise Core\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=SiteSearchSettings";
SmartTabSharingSettings.pfm_title = "การตั้งค่าการแชร์แท็บอัจฉริยะ";
SmartTabSharingSettings.pfm_description = "0 - อนุญาตให้แชร์แท็บอัจฉริยะกับการผสานรวม Google AI Mode\n1 - ไม่อนุญาตให้แชร์แท็บอัจฉริยะกับการผสานรวม Google AI Mode\nนโยบายนี้ควบคุมฟีเจอร์การแชร์แท็บอัจฉริยะของ Google AI Mode ผ่านแผงด้านข้างหรือแท็บของ Google Chrome\n\nโปรดทราบว่านโยบายนี้ไม่มีผลต่อ Google AI Mode บนเว็บ โดยจะควบคุมเฉพาะวิธีที่ผู้ใช้แชร์ข้อมูลกับแอปเมื่อใช้ Google Chrome\n\n0 = ผู้ใช้แชร์เนื้อหาในหน้าหรือไฟล์กับ Google AI Mode ได้\n\n1 = ผู้ใช้แชร์เนื้อหาในหน้าหรือไฟล์กับ Google AI Mode ไม่ได้ จุดแรกเข้าสำหรับการแชร์บริบทและแผงด้านข้างจะถูกปิดใช้หรือซ่อนไว้\n\nระบบจะไม่สนใจนโยบายนี้เมื่อ Google Search ไม่ใช่เครื่องมือค้นหาเริ่มต้นของผู้ใช้ เนื่องจากฟีเจอร์นี้ปิดใช้อยู่\n\nนโยบายนี้ไม่ขึ้นอยู่กับนโยบาย AIModeSettings นโยบาย AIModeSettings จะควบคุมเฉพาะจุดแรกเข้าในแถบอเนกประสงค์หรือช่องค้นหาใน NTP ขณะที่นโยบายนี้ควบคุมการแชร์บริบทผ่านแผงด้านข้างหรือแท็บ\n\nนโยบายนี้ยังไม่ได้ควบคุมการผสานรวม Google Gemini ซึ่ง GeminiSettings สามารถปิดใช้ได้\n\nโปรดทราบว่าหากปิดใช้ SearchContentSharingSettings นโยบายนี้จะไม่มีผล\n\nหากไม่ได้ตั้งค่านโยบายนี้ ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
SpellCheckServiceEnabled.pfm_title = "เปิดหรือปิดใช้งานบริการเว็บสำหรับการตรวจสอบการสะกด";
SpellCheckServiceEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" ระบบจะใช้บริการเว็บของ Google เพื่อช่วยแก้ไขข้อผิดพลาดของการสะกดคำ นโยบายนี้ควบคุมเฉพาะการใช้บริการออนไลน์เท่านั้น หากตั้งค่านโยบายเป็น \"ปิดใช้\" ระบบจะไม่ใช้บริการนี้\n\nการไม่ตั้งค่านโยบายจะอนุญาตให้ผู้ใช้เลือกได้ว่าจะใช้บริการตรวจตัวสะกดหรือไม่\n\nการตรวจตัวสะกดสามารถใช้พจนานุกรมที่ดาวน์โหลดไว้ในเครื่องได้ทุกเมื่อ เว้นแต่จะมีการปิดใช้ฟีเจอร์โดย SpellcheckEnabled ซึ่งในกรณีนี้นโยบายจะไม่ส่งผลกระทบ";
SpellcheckEnabled.pfm_title = "เปิดใช้การตรวจการสะกด";
SpellcheckEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะเปิดการตรวจตัวสะกด และผู้ใช้จะปิดไม่ได้ ใน Microsoft® Windows®, Google Chrome OS และ Linux® ผู้ใช้จะเปิดหรือปิดการตรวจตัวสะกดของแต่ละภาษาแยกกันได้ ดังนั้นจึงยังปิดการตรวจตัวสะกดโดยการปิดการตรวจตัวสะกดของทุกภาษาได้อยู่ คุณอาจหลีกเลี่ยงปัญหานี้โดยใช้ SpellcheckLanguage เพื่อบังคับให้เปิดใช้การตรวจตัวสะกดของบางภาษา\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิดการตรวจตัวสะกดจากทุกแหล่งที่มา และผู้ใช้จะเปิดไม่ได้ นโยบาย SpellCheckServiceEnabled, SpellcheckLanguage และ SpellcheckLanguageBlocklist จะไม่ส่งผลกระทบเมื่อตั้งค่านโยบายนี้เป็น \"เท็จ\"\n\nการไม่ตั้งค่านโยบายจะทำให้ผู้ใช้เปิดหรือปิดการตรวจตัวสะกดได้ในการตั้งค่าภาษา";
StandardizedBrowserZoomEnabled.pfm_title = "เปิดใช้ลักษณะการซูมของเบราว์เซอร์แบบมาตรฐาน";
StandardizedBrowserZoomEnabled.pfm_description = "นโยบายนี้ช่วยให้เป็นไปตามข้อกำหนดใหม่ของการซูม CSS\n\nเมื่อเปิดใช้หรือไม่ได้ตั้งค่านโยบายนี้ พร็อพเพอร์ตี้ \"zoom\" ของ CSS จะเป็นไปตามข้อกำหนด:\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\nเมื่อปิดใช้ พร็อพเพอร์ตี้ \"zoom\" ของ CSS จะกลับไปใช้ลักษณะการทำงานเดิมที่ยังไม่ได้มาตรฐาน\n\nนโยบายนี้เป็นวิธีแก้ไขปัญหาเฉพาะหน้าชั่วคราวเพื่อให้มีเวลาย้ายข้อมูลเนื้อหาเว็บไปใช้ลักษณะการทํางานแบบใหม่ นอกจากนี้ยังมีช่วงทดลองใช้ (\"DisableStandardizedBrowserZoom\") จากต้นทางที่สอดคล้องกับลักษณะการทำงานเมื่อนโยบายนี้ถูกปิดใช้ เราจะนำนโยบายนี้ออกและทำให้ลักษณะการทำงาน \"เปิดใช้\" ถาวรในเวอร์ชัน 134";
StaticStorageQuotaEnabled.pfm_title = "ควบคุมว่า API โควต้าพื้นที่เก็บข้อมูลจะแสดงค่าแบบคงที่ไหม";
StaticStorageQuotaEnabled.pfm_description = "เมื่อเปิดใช้ API โควต้าพื้นที่เก็บข้อมูลจะแสดงค่าแบบคงที่ซึ่งเท่ากับการใช้งาน + ขั้นต่ำ (10 GiB, ปัดเศษดิสก์ขึ้นเป็น 1 GiB ที่ใกล้ที่สุด)\nเมื่อปิดใช้ API โควต้าพื้นที่เก็บข้อมูลจะแสดงค่าแบบไดนามิกซึ่งเป็นสัดส่วนกับพื้นที่ทั้งหมดที่พร้อมใช้งานในอุปกรณ์ โดยไม่คำนึงถึงการใช้งาน\nหากไม่ได้ตั้งค่า API โควต้าพื้นที่เก็บข้อมูลจะใช้ลักษณะการทำงานเริ่มต้นของ Chrome\nเว็บไซต์ที่มีสิทธิ์พื้นที่เก็บข้อมูลไม่จำกัดจะไม่ได้รับผลกระทบจากการตั้งค่านี้ โควต้าที่บังคับใช้จะไม่ได้รับผลกระทบเช่นกัน";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "เปิดใช้การตรวจสอบประเภท MIME ที่เข้มงวดกับสคริปต์สำหรับผู้ปฏิบัติงาน";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "นโยบายนี้จะเปิดใช้การตรวจสอบประเภท MIME ที่เข้มงวดกับสคริปต์สำหรับผู้ปฏิบัติงาน\n\nเมื่อเปิดใช้หรือไม่ได้ตั้งค่า สคริปต์สำหรับผู้ปฏิบัติงานจะใช้การตรวจสอบประเภท MIME ที่เข้มงวดกับ JavaScript ซึ่งเป็นลักษณะการทำงานเริ่มต้นแบบใหม่ สคริปต์สำหรับผู้ปฏิบัติงานที่มีประเภท MIME เดิมจะถูกปฏิเสธ\n\nเมื่อปิดใช้ สคริปต์สำหรับผู้ปฏิบัติงานจะใช้การตรวจสอบประเภท MIME แบบ Lax เพื่อให้ระบบโหลดและดำเนินการกับสคริปต์สำหรับผู้ปฏิบัติงานที่มีประเภท MIME เดิม เช่น text/ascii ต่อไป\n\nแต่เดิมเบราว์เซอร์ใช้การตรวจสอบประเภท MIME แบบ Lax เพื่อให้ทรัพยากรที่มีประเภท MIME เดิมจำนวนมากสามารถใช้งานได้ เช่น สำหรับทรัพยากร JavaScript text/ascii จะเป็นประเภท MIME ที่รองรับเวอร์ชันเดิม ซึ่งอาจก่อให้เกิดปัญหาด้านความปลอดภัยด้วยการอนุญาตให้โหลดทรัพยากรเป็นสคริปต์ซึ่งไม่ได้มีไว้เพื่อใช้ในกรณีนี้ Chrome จะเปลี่ยนไปใช้การตรวจสอบประเภท MIME ที่เข้มงวดในอนาคตอันใกล้นี้ นโยบายที่เปิดใช้ดังกล่าวจะติดตามลักษณะการทำงานเริ่มต้น การปิดใช้นโยบายนี้ช่วยให้ผู้ดูแลระบบคงลักษณะการทำงานเดิมไว้ได้หากต้องการ\n\nดูรายละเอียดเกี่ยวกับประเภทสื่อ JavaScript/ECMAScript ได้ที่ https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "ระงับกล่องโต้ตอบ JavaScript ที่เกิดจากเฟรมย่อยที่เป็นต้นทางเฟรมอื่น";
SuppressDifferentOriginSubframeDialogs.pfm_description = "ตามที่อธิบายไว้ใน https://www.chromestatus.com/feature/5148698084376576 กล่องโต้ตอบในโหมด JavaScript ที่เกิดจาก window.alert, window.confirm และ window.prompt จะถูกบล็อกใน \"Brave\" เมื่อมีการเรียกใช้จากเฟรมย่อยที่มีต้นทางต่างจากต้นทางของเฟรมหลัก\n\nนโยบายนี้อนุญาตให้ลบล้างการเปลี่ยนแปลงดังกล่าว\nหากตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ระบบจะบล็อกกล่องโต้ตอบ JavaScript ซึ่งเกิดจากเฟรมย่อยที่เป็นต้นทางเฟรมอื่น\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" ระบบจะไม่บล็อกกล่องโต้ตอบ JavaScript ซึ่งเกิดจากเฟรมย่อยที่เป็นต้นทางเฟรมอื่น\n\nเราจะนำนโยบายนี้ออกจาก \"Brave\" ในอนาคต";
SuppressUnsupportedOSWarning.pfm_title = "ระงับคำเตือนระบบปฏิบัติการที่ไม่ได้รับการสนับสนุน";
SuppressUnsupportedOSWarning.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะระงับการแสดงคำเตือนที่ปรากฏขึ้นเมื่อ Brave กำลังทำงานในคอมพิวเตอร์หรือระบบปฏิบัติการที่ไม่รองรับ\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้คำเตือนปรากฏขึ้นในระบบที่ไม่รองรับ";
SyncDisabled.pfm_title = "ปิดใช้งานการซิงค์ข้อมูลกับ Google";
SyncDisabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะปิดการซิงค์ข้อมูลใน Brave ซึ่งใช้บริการการซิงค์ข้อมูลที่โฮสต์ไว้ใน Google\nหากต้องการปิดบริการChrome Sync ทั้งหมด เราขอแนะนำให้ปิดบริการในGoogle Admin console\n\nหากตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่า ผู้ใช้จะเลือกได้ว่าจะใช้Chrome Sync หรือไม่\n\nหมายเหตุ: อย่าเปิดใช้นโยบายนี้เมื่อเปิดใช้ RoamingProfileSupportEnabled อยู่ เนื่องจากฟีเจอร์ดังกล่าวมีฟังก์ชันการทำงานฝั่งไคลเอ็นต์เหมือนกัน การซิงค์ที่โฮสต์ไว้ใน Google จะปิดโดยสมบูรณ์ในกรณีนี้";
SyncTypesListDisabled.pfm_title = "รายการของประเภทที่จะไม่รวมในการซิงค์ข้อมูล";
SyncTypesListDisabled.pfm_description = "หากตั้งค่านโยบายนี้ ระบบจะยกเว้นประเภทข้อมูลที่ระบุไว้ทั้งหมดจากการซิงค์ข้อมูลทั้งสำหรับChrome Sync และการซิงค์ข้อมูลโปรไฟล์แบบโรมมิ่ง วิธีนี้อาจช่วยลดขนาดของโปรไฟล์แบบโรมมิ่งหรือจำกัดประเภทข้อมูลที่อัปโหลดไปยังเซิร์ฟเวอร์Chrome Sync\n\nประเภทข้อมูลปัจจุบันของนโยบายนี้ ได้แก่ \"apps\", \"autofill\", \"bookmarks\", \"extensions\", \"preferences\", \"passwords\", \"payments\", \"productComparison\", \"readingList\", \"tabs\", \"themes\", \"typedUrls\", \"wifiConfigurations\" โดยชื่อประเภทข้อมูลเหล่านี้จะคำนึงถึงตัวพิมพ์เล็กหรือใหญ่\n\nหมายเหตุ: การรีเฟรชนโยบายแบบไดนามิกรองรับเฉพาะใน Brave เวอร์ชัน 123 ขึ้นไปเท่านั้น การปิดใช้ประเภทข้อมูล \"autofill\" จะเป็นการปิดใช้ \"payments\" ด้วย \"typedUrls\" หมายถึงประวัติการท่องเว็บทั้งหมด";
TLS13EarlyDataEnabled.pfm_title = "เปิดใช้ TLS 1.3 Early Data";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Early Data เป็นส่วนขยายของ TLS 1.3 เพื่อส่งคำขอ HTTP พร้อมกันกับแฮนด์เชค TLS\n\nหากไม่กำหนดค่านโยบายนี้ Brave จะทำตามขั้นตอนการเปิดตัวเริ่มต้นสำหรับ TLS 1.3 Early Data\n\nหากเปิดใช้ Brave จะเปิดใช้ TLS 1.3 Early Data\n\nหากปิดใช้ Brave จะไม่เปิดใช้ TLS 1.3 Early Data\n\nเมื่อเปิดใช้ฟีเจอร์นี้ Brave อาจใช้หรือไม่ใช้ TLS 1.3 Early Data โดยขึ้นอยู่กับการรองรับของเซิร์ฟเวอร์\n\nTLS 1.3 Early Data เป็นโปรโตคอลที่ได้รับการยอมรับ คาดว่าเซิร์ฟเวอร์ TLS, Middlebox และซอฟต์แวร์รักษาความปลอดภัยที่มีอยู่จะจัดการหรือปฏิเสธ TLS 1.3 Early Data โดยที่การเชื่อมต่อจะไม่หลุด\n\nอย่างไรก็ตาม อุปกรณ์ที่ไม่มีการใช้งาน TLS อย่างถูกต้องอาจทำงานผิดพลาดและตัดการเชื่อมต่อเมื่อใช้ TLS 1.3 Early Data หากเกิดเหตุการณ์นี้ขึ้น ผู้ดูแลระบบควรติดต่อผู้ให้บริการเพื่อแก้ไขปัญหา\n\nนโยบายนี้เป็นมาตรการชั่วคราวเพื่อควบคุมฟีเจอร์และจะถูกนำออกหลังจากนั้น ทั้งนี้อาจมีการเปิดใช้นโยบายเพื่อให้คุณทดสอบปัญหาต่างๆ ได้ และปิดใช้ขณะที่ปัญหากำลังได้รับการแก้ไข";
TabCaptureAllowedByOrigins.pfm_title = "อนุญาตให้ต้นทางเหล่านี้จับภาพแท็บ";
TabCaptureAllowedByOrigins.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งใช้การจับภาพแท็บได้\n\nการไม่ตั้งค่านโยบายจะทำให้ระบบไม่พิจารณาเว็บไซต์เพื่อทำการลบล้างที่การจับภาพระดับนี้\n\nโปรดทราบว่าจะยังมีการจับภาพแอป Chrome ในโหมดหน้าต่างได้อยู่\n\nระบบจะไม่พิจารณานโยบายนี้หากเว็บไซต์ตรงกับรูปแบบ URL ในนโยบาย SameOriginTabCaptureAllowedByOrigins\n\nหากเว็บไซต์ตรงกับรูปแบบ URL ในนโยบายนี้ ระบบจะไม่พิจารณานโยบาย WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins และ ScreenCaptureAllowed\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/  นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL";
TabCompareSettings.pfm_title = "การตั้งค่าการเปรียบเทียบแท็บ";
TabCompareSettings.pfm_description = "0 - อนุญาตให้ใช้การเปรียบเทียบแท็บและปรับปรุงโมเดล AI\n1 - อนุญาตให้ใช้การเปรียบเทียบแท็บโดยไม่ปรับปรุงโมเดล AI\n2 - ไม่อนุญาตให้ใช้การเปรียบเทียบแท็บ\nการเปรียบเทียบแท็บเป็นเครื่องมือที่ทำงานด้วยระบบ AI สําหรับการเปรียบเทียบข้อมูลในแท็บของผู้ใช้ ตัวอย่างเช่น ระบบสามารถเสนอฟีเจอร์แก่ผู้ใช้เมื่อเปิดแท็บที่มีผลิตภัณฑ์ในหมวดหมู่ที่คล้ายกันอยู่หลายแท็บ\n\n0 = อนุญาตให้ใช้ฟีเจอร์ พร้อมกับอนุญาตให้ Google ใช้ข้อมูลที่เกี่ยวข้องเพื่อปรับปรุงโมเดล AI ข้อมูลที่เกี่ยวข้องอาจรวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร โดยทั้งนี้จะขึ้นอยู่กับฟีเจอร์นั้นๆ รวมถึงเจ้าหน้าที่อาจตรวจสอบข้อมูลดังกล่าวเพื่อปรับปรุงโมเดล AI 0 คือค่าเริ่มต้น เว้นแต่จะระบุไว้ด้านล่าง\n\n1 = อนุญาตให้ใช้ฟีเจอร์ แต่ไม่อนุญาตให้ Google ปรับปรุงโมเดลโดยใช้เนื้อหาของผู้ใช้ (รวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร) 1 คือค่าเริ่มต้นสำหรับผู้ใช้ระดับองค์กรที่จัดการโดย Google Admin console และบัญชี Education ที่จัดการโดย Google Workspace\n\n2 = ไม่อนุญาตให้ใช้ฟีเจอร์\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
TabDiscardingExceptions.pfm_title = "การยกเว้นรูปแบบ URL สำหรับการละทิ้งแท็บ";
TabDiscardingExceptions.pfm_description = "นโยบายนี้จะทำให้เบราว์เซอร์ไม่ละทิ้ง URL ที่ตรงกับรูปแบบที่ระบุไว้อย่างน้อย 1 รูปแบบ (โดยใช้รูปแบบตัวกรอง URLBlocklist)\nโดยจะมีผลกับการใช้หน่วยความจำและการละทิ้งในโหมดประสิทธิภาพสูง\nระบบจะยกเลิกการโหลดหน้าที่ถูกละทิ้งและมีการเรียกคืนทรัพยากรทั้งหมด แท็บที่เชื่อมโยงกับหน้าดังกล่าวจะยังคงอยู่ในแนวแท็บ แต่การแสดงผลแท็บดังกล่าวจะกระตุ้นให้เกิดการโหลดซ้ำอย่างเต็มรูปแบบ\n";
TaskManagerEndProcessEnabled.pfm_title = "เปิดใช้การหยุดกระบวนการในตัวจัดการงาน";
TaskManagerEndProcessEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"ปิดใช้\" จะป้องกันไม่ให้ผู้ใช้หยุดกระบวนการในตัวจัดการงาน\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ผู้ใช้หยุดกระบวนการในตัวจัดการงานได้";
ThirdPartyAiChatSettings.pfm_title = "การตั้งค่าสำหรับการผสานรวมโหมด AI ของบุคคลที่สามในแถบที่อยู่และช่องค้นหาในหน้าแท็บใหม่";
ThirdPartyAiChatSettings.pfm_description = "0 - อนุญาตให้ผสานรวมโหมด AI ของบุคคลที่สาม\n1 - ไม่อนุญาตให้ผสานรวมโหมด AI ของบุคคลที่สาม\nนโยบายนี้ควบคุมการผสานรวมโหมด AI ของบุคคลที่สามในแถบที่อยู่และช่องค้นหาในหน้าแท็บใหม่\n\nหากต้องการเข้าถึงฟีเจอร์นี้ ผู้ใช้จะต้องตั้งค่าเครื่องมือค้นหาของบุคคลที่สามที่รองรับโหมด AI เป็นเครื่องมือค้นหาเริ่มต้น\n\n0 = ฟีเจอร์นี้จะพร้อมใช้งานสำหรับผู้ใช้\n\n1 = ฟีเจอร์นี้จะไม่พร้อมใช้งานสำหรับผู้ใช้\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "ตั้งขีดจำกัดหน่วยความจำสำหรับอินสแตนซ์ของ Chrome";
TotalMemoryLimitMb.pfm_description = "กำหนดขนาดหน่วยความจำที่อินสแตนซ์หนึ่งๆ ของ Brave จะใช้ได้ก่อนเริ่มทิ้งแท็บ (กล่าวคือ หน่วยความจำที่แท็บใช้จะถูกล้างและจะต้องโหลดแท็บซ้ำเมื่อมีการสลับไปยังแท็บนั้น) เพื่อประหยัดหน่วยความจำ\n\nหากตั้งค่านโยบายนี้ เบราว์เซอร์จะเริ่มทิ้งแท็บเพื่อประหยัดหน่วยความจำเมื่อการใช้หน่วยความจำเกินขีดจำกัดแล้ว อย่างไรก็ตาม ไม่มีการรับประกันว่าเบราว์เซอร์จะทำงานตลอดเวลาแม้ว่าจะยังไม่เกินขีดจำกัดก็ตาม ทุกค่าที่ต่ำกว่า 1024 จะปัดเป็น 1024\n\nหากไม่ได้ตั้งค่านโยบายนี้ เบราว์เซอร์จะเริ่มพยายามประหยัดหน่วยความจำก็ต่อเมื่อตรวจพบว่าหน่วยความจำจริงของเครื่องเหลือน้อย";
TranslateEnabled.pfm_title = "เปิดใช้งานแปลภาษา";
TranslateEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"จริง\" จะเสนอฟังก์ชันแปลภาษาแก่ผู้ใช้ตามความเหมาะสมด้วยการแสดงแถบเครื่องมือแปลภาษาที่ผสานรวมอยู่ใน Brave และตัวเลือกการแปลเมื่อคลิกขวาที่เมนูตามบริบท การตั้งค่านโยบายเป็น \"เท็จ\" จะปิดฟีเจอร์แปลภาษาในตัวทั้งหมด\n\nหากคุณตั้งค่านโยบายนี้ ผู้ใช้จะเปลี่ยนฟังก์ชันนี้ไม่ได้ การไม่ตั้งค่าจะให้ผู้ใช้เปลี่ยนการตั้งค่าได้";
TranslatorAPIAllowed.pfm_title = "อนุญาต Translator API";
TranslatorAPIAllowed.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่าจะอนุญาตให้ใช้ Translator API ใน Brave ได้\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ใช้ Translator API ไม่ได้";
TryOnYouSettings.pfm_title = "การตั้งค่าสำหรับฟีเจอร์ลองลุคนี้";
TryOnYouSettings.pfm_description = "0 - เปิดใช้ฟีเจอร์ลองลุคนี้พร้อมการปรับปรุงโมเดล\n1 - เปิดใช้ฟีเจอร์ลองลุคนี้โดยไม่ปรับปรุงโมเดล\n2 - ปิดใช้ฟีเจอร์ลองลุคนี้\n\"ลองลุคนี้\" เป็นฟีเจอร์ที่ทำงานด้วยระบบ AI ซึ่งช่วยให้ผู้ใช้ลองสวมเสื้อผ้าจากรูปภาพที่พบบนเว็บแบบเสมือนจริง และจะให้ข้อมูลเชิงลึกด้านการช็อปปิ้งที่เป็นประโยชน์ใน Gemini ใน Chrome หากเปิดใช้ Gemini ใน Chrome\n\n0 = อนุญาตให้ใช้ฟีเจอร์ พร้อมกับอนุญาตให้ Google ใช้ข้อมูลที่เกี่ยวข้องเพื่อปรับปรุงโมเดล AI ข้อมูลที่เกี่ยวข้องอาจรวมถึงรูปภาพ อินพุต เอาต์พุต เนื้อหาในแหล่งข้อมูล และความคิดเห็น โดยขึ้นอยู่กับฟีเจอร์นั้นๆ รวมถึงเจ้าหน้าที่อาจตรวจสอบข้อมูลดังกล่าวเพื่อปรับปรุงโมเดล AI 0 คือค่าเริ่มต้น เว้นแต่จะระบุไว้ด้านล่าง\n\n1 = อนุญาตให้ใช้ฟีเจอร์ แต่ไม่อนุญาตให้ Google ปรับปรุงโมเดลโดยใช้เนื้อหาของผู้ใช้ (รวมถึงรูปภาพ อินพุต เอาต์พุต เนื้อหาในแหล่งข้อมูล และความคิดเห็น) 1 คือค่าเริ่มต้นสำหรับผู้ใช้ระดับองค์กรที่จัดการโดยGoogle Admin console และบัญชี Education ที่จัดการโดย Google Workspace\n\n2 = ไม่อนุญาตให้ใช้ฟีเจอร์\n\nหมายเหตุ: ข้อจำกัดในการปรับปรุงโมเดล (ค่า 1) จะมีผลเฉพาะเมื่อมีการเรียกใช้ฟีเจอร์ลองลุคนี้ผ่านโฟลว์เบราว์เซอร์ Chrome เท่านั้น โดยจะไม่มีผลเมื่อใช้ฟีเจอร์ผ่านโฟลว์อื่นๆ\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings ดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings\n\nฟีเจอร์ \"ลองลุคนี้\" ไม่พร้อมให้บริการในบางประเทศหรือบางภาษา การตั้งค่านโยบายนี้ไม่ได้รับประกันว่าฟีเจอร์จะเปิดใช้งานได้ โดยจะขึ้นอยู่กับความพร้อมให้บริการ ดูข้อมูลเพิ่มเติมเกี่ยวกับการเปิดตัวได้ที่บันทึกประจำรุ่นของ Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=th";
URLAllowlist.pfm_title = "อนุญาตให้เข้าถึงรายการ URL";
URLAllowlist.pfm_description = "การตั้งค่านโยบายจะให้สิทธิ์เข้าถึง URL ที่ระบุไว้ โดยเป็นข้อยกเว้นของ URLBlocklist ดูรูปแบบของรายการในลิสต์นี้ได้จากคำอธิบายของนโยบายดังกล่าว ตัวอย่างเช่น การตั้งค่า URLBlocklist เป็น * จะบล็อกคำขอทั้งหมด และคุณจะใช้นโยบายนี้เพื่ออนุญาตการเข้าถึงรายการ URL ที่จำกัดไว้ได้ ตลอดจนใช้ในการเปิดข้อยกเว้นให้แก่บางรูปแบบ โดเมนย่อยของโดเมนอื่นๆ พอร์ต หรือเส้นทางที่เฉพาะเจาะจง โดยใช้รูปแบบที่ระบุไว้ที่ ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ) ตัวกรองที่เฉพาะเจาะจงมากที่สุดจะเป็นตัวกำหนดว่า URL หนึ่งๆ ถูกบล็อกหรือได้รับอนุญาต นโยบาย URLAllowlist จะมีความสำคัญเหนือ URLBlocklist นโยบายนี้ระบุรายการได้ไม่เกิน 1,000 รายการ\n\nรวมถึงยังให้คุณเปิดใช้การเรียกใช้อัตโนมัติโดยเบราว์เซอร์ของแอปพลิเคชันภายนอกที่ลงทะเบียนเป็นตัวแฮนเดิลโปรโตคอลสำหรับโปรโตคอลที่ระบุไว้ เช่น \"tel:\" หรือ \"ssh:\"\n\nการไม่ตั้งค่านโยบายจะทำให้ไม่มีข้อยกเว้นสำหรับ URLBlocklist\n\nมีการรองรับนโยบายนี้ในโหมดไม่มีส่วนหัวด้วยใน \"Brave\" เวอร์ชัน 92 เป็นต้นไป";
URLBlocklist.pfm_title = "บล็อกการเข้าถึงรายการ URL";
URLBlocklist.pfm_description = "การตั้งค่านโยบาย URLBlocklist จะทำให้ระบบหยุดโหลดหน้าเว็บที่มี URL ต้องห้าม ผู้ดูแลระบบสามารถระบุรายการรูปแบบ URL ที่จะบล็อกได้ หากไม่ได้ตั้งค่า ระบบจะไม่บล็อก URL ในเบราว์เซอร์ คุณกำหนดข้อยกเว้นใน URLAllowlist ได้ไม่เกิน 1,000 รายการ ดูวิธีจัดรูปแบบ URL ( https://support.google.com/chrome/a?p=url_blocklist_filter_format )\n\nหมายเหตุ: นโยบายนี้ไม่มีผลกับ URL JavaScript แบบในหน้าเว็บและมีการโหลดข้อมูลแบบไดนามิก หากคุณบล็อก example.com/abc ไว้ example.com จะยังคงโหลดโดยใช้ XMLHTTPRequest ได้ นอกจากนี้ นโยบายไม่ได้ป้องกันไม่ให้หน้าเว็บอัปเดต URL ที่แสดงในแถบอเนกประสงค์เป็น URL ที่ถูกบล็อกโดยใช้ JavaScript History API\n\nเริ่มจาก Brave เวอร์ชัน 73 เป็นต้นไป คุณจะบล็อก URL javascript://* ได้ แต่จะมีผลเฉพาะกับ JavaScript ที่พิมพ์ลงในแถบที่อยู่ (หรือ bookmarklet เป็นต้น)\n\nมีการรองรับนโยบายนี้ในโหมดไม่มีส่วนหัวด้วยใน Brave เวอร์ชัน 92 เป็นต้นไป\n\nเริ่มจาก Brave เวอร์ชัน 147 เป็นต้นไป ไวลด์การ์ด * เพียงอย่างเดียวจะไม่มีผลกับ chrome:// ซึ่งเป็น URL ภายใน หากต้องการบล็อก URL เหล่านี้ คุณต้องใช้รูปแบบ chrome://* อย่างชัดเจน\n\nหมายเหตุ: การบล็อก chrome://* และ chrome-untrusted://* ซึ่งเป็น URL ภายในอาจทำให้เกิดข้อผิดพลาดที่ไม่คาดคิดหรือระบบอาจหลีกเลี่ยงในบางกรณี ลองดูว่ามีนโยบายเฉพาะเพิ่มเติมหรือไม่แทนการบล็อก URL ภายในบางรายการ ตัวอย่างเช่น\n\n- ใช้ CACertificateManagementAllowed แทนการบล็อก chrome://settings/certificates\n\n- ใช้ SystemFeaturesDisableList แทนการบล็อก chrome-untrusted://crosh\n\n- ใช้นโยบาย DeveloperToolsAvailability, DeveloperToolsAvailabilityAllowlist หรือ DeveloperToolsAvailabilityBlocklist อย่างใดอย่างหนึ่ง แทนการบล็อก devtools://*";
UpdateOnZeroWindowEnabled.pfm_title = "ควบคุมการเปิดอีกครั้งโดยอัตโนมัติในเบื้องหลังอีกครั้งเมื่อปิดหน้าต่างเบราว์เซอร์ทั้งหมด";
UpdateOnZeroWindowEnabled.pfm_description = "ควบคุมลักษณะการทำงานของการรีสตาร์ทอัตโนมัติในเบื้องหลังบน macOS เมื่อมีการอัปเดตความปลอดภัยที่รอดำเนินการอยู่และหน้าต่างเบราว์เซอร์ทั้งหมดปิดอยู่\n\nหากตั้งค่านโยบายนี้เป็น \"จริง\" หรือไม่ได้ตั้งค่า Brave จะได้รับอนุญาตให้เปิดอีกครั้งโดยอัตโนมัติเพื่อใช้การอัปเดตที่รอดำเนินการเมื่อหน้าต่างเบราว์เซอร์ทั้งหมดปิดลง\n\nหากตั้งค่านโยบายนี้เป็น \"เท็จ\" ระบบจะปิดใช้การเปิดอีกครั้งโดยอัตโนมัติเมื่อปิดหน้าต่างเบราว์เซอร์ทั้งหมด";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "เปิดใช้การรวบรวมข้อมูลที่ไม่ระบุตัวบุคคลซึ่งผูกกับ URL";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะทำให้มีการรวบรวมข้อมูลที่ไม่ระบุตัวบุคคลซึ่งผูกกับ URL อยู่เสมอ ข้อมูลนี้จะส่ง URL ของหน้าเว็บที่ผู้ใช้เข้าชมไปยัง Google เพื่อช่วยให้การค้นหาและการท่องเว็บดีขึ้น\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ไม่มีการรวบรวมข้อมูลที่ไม่ระบุตัวบุคคลซึ่งผูกกับ URL\n\nหากไม่ได้ตั้งค่านโยบายนี้ ผู้ใช้จะเปลี่ยนการตั้งค่านี้ด้วยตนเองได้\n\nในคีออสก์ของ Google Chrome OS นโยบายนี้จะไม่มีตัวเลือก \"ให้ผู้ใช้ตัดสินใจ\" หากไม่ได้ตั้งค่านโยบายนี้ให้กับคีออสก์ของ Google Chrome OS จะมีการรวบรวมข้อมูลที่ไม่ระบุตัวบุคคลซึ่งผูกกับ URL อยู่เสมอ\nเมื่อตั้งค่าให้กับคีออสก์ของ Google Chrome OS นโยบายนี้จะเปิดใช้การรวบรวมเมตริกซึ่งผูกกับ URL สำหรับแอปคีออสก์";
UserDataDir.pfm_title = "ตั้งค่าไดเรกทอรีข้อมูลผู้ใช้";
UserDataDir.pfm_description = "กำหนดค่าไดเรกทอรีที่ Brave จะใช้สำหรับจัดเก็บข้อมูลผู้ใช้\n\nหากคุณตั้งค่านโยบายนี้ Brave จะใช้ไดเรกทอรีที่ให้มา โดยไม่คำนึงว่าผู้ใช้มีการระบุสถานะ \"--user-data-dir\" หรือไม่ เพื่อหลีกเลี่ยงการสูญเสียข้อมูลหรือข้อผิดพลาดที่ไม่คาดคิดอื่นๆ คุณไม่ควรตั้งค่านโยบายนี้เป็นไดเรกทอรีที่ใช้สำหรับวัตถุประสงค์อื่นเพราะ Brave จะจัดการเนื้อหาของตัวเอง\n\nดูรายการตัวแปรที่ใช้ได้ได้ที่ https://support.google.com/chrome/a?p=Supported_directory_variables\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะใช้เส้นทางโปรไฟล์เริ่มต้นและผู้ใช้จะลบล้างเส้นทางนี้ได้ด้วยการตั้งสถานะโดยใช้บรรทัดคำสั่ง \"--user-data-dir\"";
UserDataSnapshotRetentionLimit.pfm_title = "จำกัดจำนวนสแนปชอตข้อมูลผู้ใช้ที่เก็บรักษาไว้สำหรับใช้ในกรณีที่ต้องทำการย้อนกลับฉุกเฉิน";
UserDataSnapshotRetentionLimit.pfm_description = "ในการอัปเดตเวอร์ชันครั้งใหญ่แต่ละครั้ง Chrome จะสร้างสแนปชอตของข้อมูลการท่องเว็บของผู้ใช้เอาไว้จำนวนหนึ่งสำหรับใช้ในกรณีที่ต้องทำการย้อนกลับเวอร์ชันฉุกเฉินในภายหลัง หากทำการย้อนกลับฉุกเฉินไปยังเวอร์ชันที่ผู้ใช้มีสแนปชอตที่ตรงกัน ข้อมูลในสแนปชอตจะได้รับการคืนค่า ซึ่งจะช่วยให้ผู้ใช้เก็บการตั้งค่าดังกล่าวเป็นบุ๊กมาร์กและข้อมูลสำหรับป้อนข้อความอัตโนมัติได้\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะใช้ค่าเริ่มต้นที่ 3\n\nหากตั้งค่านโยบายนี้ ระบบจะลบสแนปชอตเก่าตามที่จำเป็นเพื่อให้จำนวนอยู่ในขีดจำกัดที่กำหนด หากตั้งค่านโยบายนี้เป็น 0 จะไม่มีการสร้างสแนปชอต";
UserFeedbackAllowed.pfm_title = "อนุญาตความคิดเห็นจากผู้ใช้";
UserFeedbackAllowed.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะทำให้ผู้ใช้ส่งความคิดเห็นไปให้ Google ได้ผ่านเมนู > ความช่วยเหลือ > รายงานปัญหาหรือการกดแป้นร่วมกัน\n\nการตั้งค่านโยบายเป็น \"ปิดใช้งาน\" หมายความว่าผู้ใช้จะส่งความคิดเห็นไปให้ Google ไม่ได้";
VideoCaptureAllowed.pfm_title = "อนุญาตหรือปฏิเสธการจับวิดีโอ";
VideoCaptureAllowed.pfm_description = "เมื่อตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า ผู้ใช้จะได้รับข้อความแจ้งหากมีการเข้าถึงการจับภาพวิดีโอ ยกเว้นใน URL ที่ตั้งค่าไว้ในรายการ VideoCaptureAllowedUrls\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิดข้อความแจ้ง และการจับภาพวิดีโอจะใช้ได้เฉพาะกับ URL ที่ตั้งค่าไว้ในรายการ VideoCaptureAllowedUrls เท่านั้น\n\nหมายเหตุ: นโยบายนี้มีผลกับอินพุตวิดีโอทั้งหมด (ไม่ใช่แค่กล้องในตัว)";
VideoCaptureAllowedUrls.pfm_title = "URL ที่จะได้รับสิทธิ์การเข้าถึงอุปกรณ์จับภาพวิดีโอโดยไม่ต้องแจ้ง";
VideoCaptureAllowedUrls.pfm_description = "การตั้งค่านโยบายนี้เป็นการระบุรายการ URL ที่จะมีการจับคู่รูปแบบกับต้นทางการรักษาความปลอดภัยของ URL ที่ขอ หากรูปแบบตรงกัน ระบบจะให้สิทธิ์เข้าถึงอุปกรณ์บันทึกวิดีโอโดยไม่แสดงข้อความแจ้ง\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/ อย่างไรก็ตาม โปรดทราบว่านโยบายนี้ไม่รองรับรูปแบบ \"*\" ที่ตรงกับ URL ใดก็ตาม";
VoiceTypingSettings.pfm_title = "การตั้งค่าการพูดเพื่อพิมพ์";
VoiceTypingSettings.pfm_description = "0 - อนุญาตให้ใช้การพูดเพื่อพิมพ์\n1 - อนุญาตให้ใช้การพูดเพื่อพิมพ์โดยไม่ต้องมีการเก็บรวบรวมข้อมูล\n2 - ไม่อนุญาตให้ใช้การพูดเพื่อพิมพ์\nการพูดเพื่อพิมพ์เป็นฟีเจอร์ที่ใช้ AI ซึ่งช่วยให้ผู้ใช้ป้อนและแก้ไขข้อความโดยใช้เสียงของตนเอง ขับเคลื่อนด้วยโมเดล Generative AI เพื่อให้การถอดเสียงเป็นคำและการจัดรูปแบบที่มีคุณภาพสูง\n\n0 = อนุญาตให้ใช้ฟีเจอร์ พร้อมกับอนุญาตให้ Google ใช้ข้อมูลที่เกี่ยวข้องเพื่อปรับปรุงโมเดล AI ข้อมูลที่เกี่ยวข้องอาจรวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร โดยทั้งนี้จะขึ้นอยู่กับฟีเจอร์นั้นๆ รวมถึงเจ้าหน้าที่อาจตรวจสอบข้อมูลดังกล่าวเพื่อปรับปรุงโมเดล AI 0 คือค่าเริ่มต้น เว้นแต่จะระบุไว้ด้านล่าง\n\n1 = อนุญาตให้ใช้ฟีเจอร์ แต่ไม่อนุญาตให้ Google ปรับปรุงโมเดลโดยใช้เนื้อหาของผู้ใช้ (รวมถึงพรอมต์ อินพุต เอาต์พุต เนื้อหาแหล่งที่มา และความคิดเห็นเป็นลายลักษณ์อักษร) 1 คือค่าเริ่มต้นสำหรับผู้ใช้ระดับองค์กรที่จัดการโดยGoogle Admin console และบัญชี Education ที่จัดการโดย Google Workspace\n\n2 = ไม่อนุญาตให้ใช้ฟีเจอร์\n\nหากไม่ได้ตั้งค่านโยบาย ลักษณะการทำงานจะกำหนดโดยนโยบาย GenAiDefaultSettings\n\nดูข้อมูลเพิ่มเติมเกี่ยวกับการจัดการข้อมูลสำหรับฟีเจอร์ Generative AI ได้ที่ https://support.google.com/chrome/a?p=generative_ai_settings";
WPADQuickCheckEnabled.pfm_title = "เปิดการเพิ่มประสิทธิภาพ WPAD";
WPADQuickCheckEnabled.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" หรือไม่ตั้งค่าจะเปิดการเพิ่มประสิทธิภาพ WPAD (Web Proxy Auto-Discovery) ใน Brave\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะปิดการเพิ่มประสิทธิภาพ WPAD ซึ่งทำให้ Brave ต้องรอเซิร์ฟเวอร์ WPAD แบบใช้ DNS เป็นเวลานานขึ้น\n\nไม่ว่าจะมีการตั้งค่านโยบายนี้หรือไม่ ผู้ใช้จะเปลี่ยนการตั้งค่าการเพิ่มประสิทธิภาพ WPAD ไม่ได้";
WarnBeforeQuittingEnabled.pfm_title = "แสดงกล่องคำเตือนเมื่อผู้ใช้พยายามออก";
WarnBeforeQuittingEnabled.pfm_description = "ควบคุมกล่องโต้ตอบ \"เตือนก่อนออก (⌘Q)\" เมื่อผู้ใช้พยายามออกจากเบราว์เซอร์\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" หรือไม่ได้ตั้งค่า กล่องคำเตือนจะแสดงขึ้นมาเมื่อผู้ใช้พยายามออก\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" กล่องคำเตือนจะไม่แสดงขึ้นมาเมื่อผู้ใช้พยายามออก";
WebAppInstallByUserEnabled.pfm_title = "เปิดใช้การติดตั้งเว็บแอปของผู้ใช้จากเบราว์เซอร์";
WebAppInstallByUserEnabled.pfm_description = "นโยบายนี้ควบคุมว่าผู้ใช้จะติดตั้งเว็บแอปผ่านเบราว์เซอร์ได้หรือไม่\nหากเปิดใช้หรือไม่ได้กำหนดค่านโยบายนี้ ผู้ใช้จะติดตั้งเว็บแอปผ่านเบราว์เซอร์ได้\nหากปิดใช้นโยบายนี้ ผู้ใช้จะติดตั้งเว็บแอปผ่านเบราว์เซอร์ไม่ได้ และระบบจะยกเว้นประเภทข้อมูล \"แอป\" จากการซิงค์สำหรับ Chrome Sync\nนโยบายนี้ไม่รองรับการรีเฟรชแบบไดนามิก การเปลี่ยนแปลงใดๆ ไม่ว่าจะเป็นการเปิดใช้ การปิดใช้ หรือการยกเลิก จะมีผลก็ต่อเมื่อรีสตาร์ทเบราว์เซอร์แล้วเท่านั้น\nนโยบายนี้ไม่มีผลต่อนโยบาย \"WebAppInstallForceList\"";
WebAppInstallForceList.pfm_title = "URL ของเว็บแอปที่จะติดตั้งแบบเงียบ";
WebAppInstallForceList.pfm_description = "การตั้งค่านโยบายนี้จะเป็นการระบุรายการเว็บแอปที่ติดตั้งโดยผู้ใช้ไม่ต้องดำเนินการ และจะถอนการติดตั้งหรือปิดไม่ได้\n\nรายการย่อยแต่ละรายการในนโยบายคือออบเจ็กต์ที่มีสมาชิกที่จำเป็น 1 รายการ ซึ่งก็คือ url (URL ของเว็บแอปที่จะติดตั้ง) และสมาชิกที่ไม่บังคับ 6 รายการคือ default_launch_container (สำหรับการเปิดเว็บแอป ค่าเริ่มต้นคือแท็บใหม่) และ create_desktop_shortcut (เป็น \"จริง\" หากคุณต้องการสร้างทางลัดบนเดสก์ท็อปสำหรับ Linux และ Microsoft® Windows®)\n\n- fallback_app_name\n(Brave เวอร์ชัน 90 เป็นต้นไปจะอนุญาตให้ลบล้างชื่อแอปได้หากไม่ใช่ Progressive Web App (PWA) หรือชื่อแอปที่ติดตั้งชั่วคราวหากเป็น PWA แต่ต้องมีการตรวจสอบสิทธิ์ก่อนที่จะติดตั้งเสร็จสมบูรณ์ หากมีการระบุทั้ง custom_name และ fallback_app_name ระบบจะไม่สนใจรายการหลัง)\n\n- custom_name\n(Google Chrome OS เวอร์ชัน 99 เป็นต้นไป และเวอร์ชัน 112 ในระบบปฏิบัติการอื่นทั้งหมดสำหรับเดสก์ท็อปจะอนุญาตให้ลบล้างชื่อแอปสำหรับเว็บแอปและ PWA ทั้งหมดได้อย่างถาวร)\n\n- custom_icon\n(Google Chrome OS เวอร์ชัน 99 เป็นต้นไป และเวอร์ชัน 112 ในระบบปฏิบัติการอื่นทั้งหมดสำหรับเดสก์ท็อปจะอนุญาตให้ลบล้างไอคอนแอปของแอปที่ติดตั้งไว้ ไอคอนต้องเป็นสี่เหลี่ยมจัตุรัสขนาดไม่เกิน 1 MB และอยู่ในรูปแบบ jpeg, png, gif, webp หรือ ico\nค่าแฮชต้องเป็นแฮช SHA256 ของไฟล์ไอคอน url\nควรเข้าถึงได้โดยไม่ต้องตรวจสอบสิทธิ์ให้แน่ใจว่าจะใช้ไอคอนได้เมื่อติดตั้งแอป)\n\n- install_as_shortcut\n(Brave\nเวอร์ชัน 107 เป็นต้นไป) หากเปิดใช้แล้ว ระบบจะติดตั้ง url ที่ระบุไว้เป็นทางลัด เช่นเดียวกับที่ทำผ่านตัวเลือก \"สร้างทางลัด...\"\nใน GUI ของเบราว์เซอร์ในเดสก์ท็อป\nโปรดทราบว่าเมื่อติดตั้งเป็นทางลัดแล้ว URL นั้นจะไม่อัปเดตหากไฟล์ Manifest ใน url มีการเปลี่ยนแปลง\nหากปิดใช้หรือไม่ได้ตั้งค่า จะมีการติดตั้งเว็บแอปใน url ที่ระบุไว้ตามปกติ\n\nดูการปักหมุดแอปไว้ที่แถบ Google Chrome OS ที่ PinnedLauncherApps\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=WebAppInstallForceList";
WebAppSettings.pfm_title = "การตั้งค่าการจัดการเว็บแอป";
WebAppSettings.pfm_description = "นโยบายนี้ให้ผู้ดูแลระบบสามารถระบุการตั้งค่าของเว็บแอปที่ติดตั้ง นโยบายนี้แมปรหัสเว็บแอปกับการตั้งค่าที่เฉพาะเจาะจง การกำหนดค่าเริ่มต้นทำได้โดยใช้รหัสพิเศษ * ซึ่งจะมีผลกับเว็บแอปทั้งหมดที่ไม่มีการกำหนดค่าเองในนโยบายนี้\n\nช่อง manifest_id คือรหัสไฟล์ Manifest ของเว็บแอป ดูวิธีการระบุรหัสไฟล์ Manifest ของเว็บแอปที่ติดตั้งได้ใน https://developer.chrome.com/blog/pwa-manifest-id/\nช่อง run_on_os_login ระบุว่าเว็บแอปจะทำงานระหว่างการเข้าสู่ระบบปฏิบัติการได้หรือไม่ หากตั้งค่าช่องนี้เป็น blocked เว็บแอปจะไม่ทำงานระหว่างการเข้าสู่ระบบปฏิบัติการและผู้ใช้จะเปิดใช้ภายหลังไม่ได้ หากตั้งค่าช่องนี้เป็น run_windowed เว็บแอปจะทำงานระหว่างการเข้าสู่ระบบปฏิบัติการและผู้ใช้จะปิดใช้ภายหลังไม่ได้ หากตั้งค่าช่องนี้เป็น allowed ผู้ใช้จะกำหนดค่าเว็บแอปให้ทำงานเมื่อเข้าสู่ระบบปฏิบัติการได้ การกำหนดค่าเริ่มต้นอนุญาตให้มีค่า allowed และ blocked เท่านั้น\n(ตั้งแต่เวอร์ชัน 117) ช่อง prevent_close_after_run_on_os_login จะระบุว่าควรป้องกันไม่ให้มีการปิดเว็บแอปไม่ว่าในกรณีใดก็ตามหรือไม่ (เช่น โดยผู้ใช้ ตัวจัดการงาน หรือ API ของเว็บ) คุณจะเปิดใช้ลักษณะการทำงานนี้ได้ก็ต่อเมื่อตั้งค่า run_on_os_login เป็น run_windowed เท่านั้น หากแอปทำงานอยู่แล้ว พร็อพเพอร์ตี้นี้จะมีผลหลังจากรีสตาร์ทแอป หากไม่ได้กำหนดช่องนี้ ผู้ใช้จะปิดแอปได้\n(ตั้งแต่เวอร์ชัน 118) ช่อง force_unregister_os_integration จะระบุว่าการผสานรวมระบบปฏิบัติการทั้งหมดสำหรับเว็บแอป เช่น ทางลัด ตัวแฮนเดิลไฟล์ ตัวแฮนเดิลโปรโตคอล จะถูกนำออกหรือไม่ หากแอปกำลังทำงานอยู่ก่อนแล้ว พร็อพเพอร์ตี้นี้จะมีผลหลังจากรีสตาร์ทแอป คุณควรดำเนินการดังกล่าวด้วยความระมัดระวัง เนื่องจากอาจลบล้างการผสานรวมระบบปฏิบัติการใดก็ตามที่ตั้งค่าไว้โดยอัตโนมัติในช่วงเริ่มต้นระบบเว็บแอปพลิเคชัน ปัจจุบันใช้งานได้เฉพาะในแพลตฟอร์ม Windows, Mac และ Linux เท่านั้น\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=WebAppSettings";
WebAudioOutputBufferingEnabled.pfm_title = "เปิดใช้การบัฟเฟอร์แบบปรับอัตโนมัติสำหรับ Web Audio";
WebAudioOutputBufferingEnabled.pfm_description = "นโยบายนี้ควบคุมว่าเบราว์เซอร์ควรใช้การบัฟเฟอร์แบบปรับอัตโนมัติสำหรับ Web Audio ไหม ซึ่งอาจลดอาการเสียงกระตุก แต่อาจเพิ่มเวลาแฝงตามจำนวนตัวแปร\n\nการตั้งค่านโยบายเป็น \"เปิดใช้\" จะใช้การบัฟเฟอร์แบบปรับอัตโนมัติเสมอ\n\nการตั้งค่านโยบายเป็น \"ปิดใช้\" หรือไม่ได้ตั้งค่าจะทำให้กระบวนการเปิดตัวฟีเจอร์ของเบราว์เซอร์ตัดสินใจได้ว่าจะใช้การบัฟเฟอร์แบบปรับอัตโนมัติไหม";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "ต้นทางที่อนุญาตสําหรับคำขอ WebAuthn ที่ทำพร็อกซีจากแอปพลิเคชัน Remote Desktop";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "รายการต้นทางของแอปไคลเอ็นต์ Remote Desktop ที่อาจเรียกใช้คำขอ WebAuthn API ที่มาจากเซสชันการท่องเว็บในโฮสต์ระยะไกล\n\nต้นทางใดก็ตามที่กำหนดค่าไว้ในนโยบายนี้สามารถส่งคำขอ WebAuthn สำหรับ Relying Party ID (RP ID) ซึ่งโดยปกติแล้วต้นทางนั้นจะไม่ได้รับอนุญาตให้อ้างสิทธิ์ได้\n\nอนุญาตเฉพาะต้นทาง HTTPS ที่ถูกต้อง ไม่รองรับไวลด์การ์ด\nระบบจะไม่สนใจข้อมูลที่ไม่ถูกต้อง\n\nนโยบายนี้มีผลเฉพาะกับผู้ใช้ที่อยู่ในโดเมนนั้นๆ เท่านั้น";
WebHidAllowAllDevicesForUrls.pfm_title = "ให้สิทธิ์เว็บไซต์โดยอัตโนมัติในการเชื่อมต่อกับอุปกรณ์ HID";
WebHidAllowAllDevicesForUrls.pfm_description = "การตั้งค่านโยบายนี้ให้คุณระบุเว็บไซต์ที่ได้รับสิทธิ์โดยอัตโนมัติในการเข้าถึงอุปกรณ์ที่ใช้ได้ทั้งหมด\n\nURL ต้องใช้การได้ มิเช่นนั้น นโยบายจะไม่มีผล ระบบพิจารณาเฉพาะต้นทาง (รูปแบบ โฮสต์ และพอร์ต) ของ URL เท่านั้น\n\nใน Chrome OS นโยบายนี้จะมีผลเฉพาะกับผู้ใช้ที่เชื่อมโยงเท่านั้น\n\nนโยบายนี้จะลบล้าง DefaultWebHidGuardSetting, WebHidAskForUrls, WebHidBlockedForUrls และค่ากำหนดของผู้ใช้";
WebHidAllowDevicesForUrls.pfm_title = "ให้สิทธิ์เว็บไซต์เหล่านี้โดยอัตโนมัติในการเชื่อมต่อกับอุปกรณ์ HID ที่มีรหัสผู้ให้บริการและรหัสสินค้าที่กำหนด";
WebHidAllowDevicesForUrls.pfm_description = "การตั้งค่านโยบายนี้ให้คุณระบุ URL ซึ่งเจาะจงเว็บไซต์ที่ได้รับสิทธิ์โดยอัตโนมัติในการเข้าถึงอุปกรณ์ HID ที่มีรหัสผู้ให้บริการและรหัสสินค้าที่กำหนด แต่ละรายการในลิสต์ต้องระบุทั้งช่อง devices และ urls จึงจะมีผล มิเช่นนั้น ระบบจะไม่สนใจรายการดังกล่าว แต่ละรายการในช่อง devices ต้องมี vendor_id และอาจมีช่อง product_id การไม่ระบุช่อง product_id จะสร้างนโยบายที่ตรงกับอุปกรณ์ทุกเครื่องที่มีรหัสผู้ให้บริการที่ระบุ รายการที่ระบุช่อง product_id แต่ไม่ระบุช่อง vendor_id จะไม่มีผล\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultWebHidGuardSetting จะมีผลหากตั้งค่าไว้ แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nURL ในนโยบายนี้ไม่ควรขัดแย้งกับ URL ที่กำหนดค่าผ่าน WebHidBlockedForUrls หากขัดแย้งกัน นโยบายนี้จะมีความสำคัญสูงกว่า WebHidBlockedForUrls\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "ให้สิทธิ์เว็บไซต์เหล่านี้โดยอัตโนมัติในการเชื่อมต่อกับอุปกรณ์ HID ที่มีการรวบรวมระดับบนสุดเกี่ยวกับการใช้งาน HID ที่กำหนด";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "การตั้งค่านโยบายนี้ให้คุณระบุ URL ซึ่งเจาะจงเว็บไซต์ที่ได้รับสิทธิ์โดยอัตโนมัติในการเข้าถึงอุปกรณ์ HID ที่มีการรวบรวมระดับบนสุดเกี่ยวกับการใช้งาน HID ที่กำหนด แต่ละรายการในลิสต์ต้องระบุทั้งช่อง usages และ urls นโยบายจึงจะมีผล แต่ละรายการในช่อง usages ต้องมี usage_page และอาจมีช่อง usage การไม่ระบุช่อง usage จะสร้างนโยบายที่ตรงกับอุปกรณ์ทุกเครื่องที่มีการรวบรวมระดับบนสุดเกี่ยวกับการใช้งานจากหน้าการใช้งานที่ระบุ รายการที่ระบุช่อง usage แต่ไม่ระบุช่อง usage_page จะไม่มีผล\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultWebHidGuardSetting จะมีผลหากตั้งค่าไว้ แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nURL ในนโยบายนี้ไม่ควรขัดแย้งกับ URL ที่กำหนดค่าผ่าน WebHidBlockedForUrls หากขัดแย้งกัน นโยบายนี้จะมีความสำคัญสูงกว่า WebHidBlockedForUrls\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls";
WebHidAskForUrls.pfm_title = "อนุญาต WebHID API ในเว็บไซต์เหล่านี้";
WebHidAskForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ขอให้ผู้ใช้ให้สิทธิ์เข้าถึงอุปกรณ์ HID ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultWebHidGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nสำหรับรูปแบบ URL ที่ไม่ตรงกับนโยบาย รูปแบบต่อไปนี้จะมีความสำคัญสูงกว่าตามลำดับ\n\n  * WebHidBlockedForUrls (หากมีการจับคู่)\n\n  * DefaultWebHidGuardSetting (หากตั้งค่าไว้) หรือ\n\n  * การตั้งค่าส่วนตัวของผู้ใช้\n\nรูปแบบ URL ต้องไม่ขัดแย้งกับ WebHidBlockedForUrls ไม่มีนโยบายที่จะมีความสำคัญสูงกว่าหาก URL ตรงกับทั้ง 2 นโยบาย\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
WebHidBlockedForUrls.pfm_title = "บล็อก WebHID API ในเว็บไซต์เหล่านี้";
WebHidBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่สามารถขอให้ผู้ใช้ให้สิทธิ์เข้าถึงอุปกรณ์ HID ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultWebHidGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nสำหรับรูปแบบ URL ที่ไม่ตรงกับนโยบาย รูปแบบต่อไปนี้จะมีความสำคัญสูงกว่าตามลำดับ\n\n  * WebHidAskForUrls (หากมีการจับคู่)\n\n  * DefaultWebHidGuardSetting (หากตั้งค่าไว้) หรือ\n\n  * การตั้งค่าส่วนตัวของผู้ใช้\n\nรูปแบบ URL ต้องไม่ขัดแย้งกับ WebHidAskForUrls ไม่มีนโยบายที่จะมีความสำคัญสูงกว่าหาก URL ตรงกับทั้ง 2 นโยบาย\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "เปิดใช้การรวบรวมบันทึกการวินิจฉัยของ WebRTC สำหรับต้นทางที่เฉพาะเจาะจง";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "นโยบายนี้อนุญาตให้เปิดใช้การเก็บรวบรวมบันทึกการวินิจฉัยของ WebRTC สำหรับต้นทางที่เฉพาะเจาะจง\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบอินพุตที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้ นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL รองรับ Scheme และโดเมนย่อย\n\nหากตั้งค่านโยบายนี้ไว้ ระบบจะเปิดใช้การเก็บรวบรวมบันทึกการวินิจฉัยสำหรับต้นทางที่ตรงกับรูปแบบในรายการ\n\nหากไม่ได้ตั้งค่าไว้ ระบบจะปิดใช้การเก็บรวบรวมบันทึกการวินิจฉัยโดยค่าเริ่มต้น";
WebRtcEventLogCollectionAllowed.pfm_title = "อนุญาตให้รวบรวมบันทึกเหตุการณ์ WebRTC จากบริการของ Google";
WebRtcEventLogCollectionAllowed.pfm_description = "หากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" จะทำให้ Brave รวบรวมบันทึกเหตุการณ์ WebRTC จากบริการของ Google เช่น Hangouts Meet และอัปโหลดบันทึกไปยัง Google ได้ บันทึกเหล่านี้มีข้อมูลการวินิจฉัยสำหรับแก้ไขข้อบกพร่องเกี่ยวกับการประชุมด้วยเสียงหรือการประชุมทางวิดีโอใน Brave เช่น เวลาและขนาดของแพ็กเก็ต RTP, ผลป้อนกลับเกี่ยวกับความหนาแน่นในเครือข่าย ตลอดจนข้อมูลเมตาเกี่ยวกับระยะเวลาและคุณภาพของเสียงและเฟรมของวิดีโอ บันทึกเหล่านี้ไม่มีเนื้อหาเสียงหรือวิดีโอจากการประชุม เพื่อให้แก้ไขข้อบกพร่องได้ง่ายขึ้น Google อาจเชื่อมโยงบันทึกเหล่านี้ (โดยใช้รหัสเซสชัน) กับบันทึกอื่นๆ ที่บริการของ Google รวบรวมไว้เอง\n\nการตั้งค่านโยบายนี้เป็น \"ปิดใช้\" จะส่งผลให้ไม่มีการรวบรวมหรืออัปโหลดบันทึกดังกล่าว\n\nหากไม่ได้ตั้งค่านโยบายนี้ในเวอร์ชันตั้งแต่ M76 ลงมา โดยค่าเริ่มต้นของ Brave จะรวบรวมหรืออัปโหลดบันทึกเหล่านี้ไม่ได้ เริ่มตั้งแต่เวอร์ชัน M77 ขึ้นไป ค่าเริ่มต้นของ Brave จะรวบรวมและอัปโหลดบันทึกเหล่านี้ได้จากโปรไฟล์ส่วนใหญ่ที่ได้รับผลกระทบจากนโยบายองค์กรในระดับผู้ใช้บนระบบคลาวด์ ตั้งแต่เวอร์ชัน M77 ขึ้นไปจนถึงเวอร์ชัน M80 โดยค่าเริ่มต้น Brave จะรวบรวมและอัปโหลดบันทึกเหล่านี้ได้จากโปรไฟล์ที่ได้รับผลกระทบจากการจัดการภายในองค์กรของ Brave";
WebRtcIPHandling.pfm_title = "การจัดการ IP ของ WebRTC";
WebRtcIPHandling.pfm_description = "default - WebRTC จะใช้อินเทอร์เฟซทั้งหมดที่มีอยู่เมื่อค้นหาเส้นทางที่ดีที่สุด\ndefault_public_and_private_interfaces - WebRTC จะใช้อินเทอร์เฟซที่เชื่อมต่อกับอินเทอร์เน็ตสาธารณะเท่านั้น แต่อาจเชื่อมต่อโดยใช้ที่อยู่ IP ส่วนตัว\ndefault_public_interface_only - WebRTC จะใช้อินเทอร์เฟซที่เชื่อมต่อกับอินเทอร์เน็ตสาธารณะเท่านั้น แต่จะไม่เชื่อมต่อโดยใช้ที่อยู่ IP ส่วนตัว\ndisable_non_proxied_udp - WebRTC จะใช้ TCP ในอินเทอร์เฟซที่เปิดเผยต่อสาธารณะ และจะใช้ UDP ก็ต่อเมื่อพร็อกซีที่กำหนดค่าไว้รองรับเท่านั้น\nนโยบายนี้อนุญาตให้จำกัดที่อยู่ IP และอินเทอร์เฟซที่ WebRTC จะใช้เมื่อพยายามค้นหาการเชื่อมต่อที่ดีที่สุดที่มีอยู่\n\nค่าที่ถูกต้อง:\n\n* ค่าเริ่มต้น - WebRTC ใช้อินเทอร์เฟซเครือข่ายทั้งหมดที่มีอยู่\n\n* default_public_and_private_interfaces - WebRTC ใช้อินเทอร์เฟซสาธารณะและส่วนตัวทั้งหมด\n\n* default_public_interface_only - WebRTC ใช้อินเทอร์เฟซสาธารณะทั้งหมด แต่ไม่ใช้อินเทอร์เฟซส่วนตัว\n\n* disable_non_proxied_udp - WebRTC ใช้พร็อกซี SOCKS ของ UDP หรือจะเปลี่ยนไปใช้พร็อกซีของ TCP\n\nเมื่อไม่ได้ตั้งค่าไว้ ค่าเริ่มต้นจะเป็นการใช้อินเทอร์เฟซเครือข่ายทั้งหมดที่มีอยู่\n\nดูคำอธิบายโดยละเอียดของค่าการจัดการทั้งหมดได้ที่ RFC 8828 ส่วนที่ 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2)";
WebRtcIPHandlingUrl.pfm_title = "การจัดการ IP ของ WebRTC ต่อ URL";
WebRtcIPHandlingUrl.pfm_description = "นโยบายนี้อนุญาตให้จำกัดที่อยู่ IP และอินเทอร์เฟซที่ WebRTC ใช้เมื่อพยายามค้นหาการเชื่อมต่อที่ดีที่สุดที่มีสำหรับ URL บางรูปแบบ\n\nโดยรับรายการรูปแบบ URL และคู่ประเภทการจัดการ ระบบจะตรวจสอบรูปแบบ URL ตามลำดับและการจับคู่ครั้งแรกจะกำหนดค่าการจัดการที่ WebRTC ใช้สำหรับโดเมน เมื่อ URL ของเอกสารปัจจุบันไม่ตรงกับรายการใดๆ ระบบจะใช้ค่ากำหนดที่นโยบาย WebRtcIPHandling ตั้ง\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบอินพุตที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/ ใช้ไวลด์การ์ด (*) ได้ นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL\n\nค่าการจัดการที่ถูกต้อง\n\n* ค่าเริ่มต้น - WebRTC ใช้อินเทอร์เฟซเครือข่ายทั้งหมด\n\n* default_public_and_private_interfaces - WebRTC ใช้อินเทอร์เฟซสาธารณะและส่วนตัวทั้งหมด\n\n* default_public_interface_only - WebRTC ใช้อินเทอร์เฟซสาธารณะทั้งหมด แต่ไม่ใช้อินเทอร์เฟซส่วนตัว\n\n* disable_non_proxied_udp - WebRTC ใช้พร็อกซี SOCKS ของ UDP หรือจะเปลี่ยนไปใช้พร็อกซีของ TCP\n\nดูคำอธิบายโดยละเอียดของค่าการจัดการทั้งหมดได้ที่ RFC 8828 ส่วนที่ 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2)\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl";
WebRtcLocalIpsAllowedUrls.pfm_title = "URL ที่ IP ของเครื่องแสดงใน ICE Candidate ผ่าน WebRTC";
WebRtcLocalIpsAllowedUrls.pfm_description = "รูปแบบในรายการนี้จะจับคู่กับต้นทางการรักษาความปลอดภัยของ URL ที่ขอ\nหากพบต้นทางที่ตรงกันหรือมีการปิดใช้ chrome://flags/#enable-webrtc-hide-local-ips-with-mdns ที่อยู่ IP ของเครื่องจะแสดงใน ICE Candidate ผ่าน WebRTC\nหากไม่ ระบบจะปกปิดที่อยู่ IP ของเครื่องโดยใช้ชื่อโฮสต์ mDNS แทน\nโปรดทราบว่าหากผู้ดูแลระบบจำเป็นต้องปกป้อง IP ของเครื่อง นโยบายนี้จะทำให้การปกป้องนั้นด้อยประสิทธิภาพลง";
WebRtcPostQuantumKeyAgreement.pfm_title = "เปิดใช้ข้อตกลงเกี่ยวกับคีย์ในการเข้ารหัสเพื่อรักษาความปลอดภัยจากคอมพิวเตอร์ควอนตัมสำหรับ WebRTC";
WebRtcPostQuantumKeyAgreement.pfm_description = "นโยบายนี้อนุญาตให้ควบคุมข้อตกลงเกี่ยวกับคีย์ในการเข้ารหัสเพื่อรักษาความปลอดภัยจากคอมพิวเตอร์ควอนตัมสำหรับ WebRTC\n\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" ระบบจะเสนอข้อตกลงเกี่ยวกับคีย์ในการเข้ารหัสเพื่อรักษาความปลอดภัยจากคอมพิวเตอร์ควอนตัมสำหรับ WebRTC\n\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" ระบบจะไม่เสนอข้อตกลงเกี่ยวกับคีย์ในการเข้ารหัสเพื่อรักษาความปลอดภัยจากคอมพิวเตอร์ควอนตัมสำหรับ WebRTC\n\nหากไม่ได้ตั้งค่านโยบายนี้ ระบบจะตั้งค่าตามกระบวนการเปิดตัวเริ่มต้นของข้อตกลงเกี่ยวกับคีย์ในการเข้ารหัสเพื่อรักษาความปลอดภัยจากคอมพิวเตอร์ควอนตัมที่เสนอสำหรับ WebRTC\n\nการเสนอข้อตกลงเกี่ยวกับคีย์ในการเข้ารหัสเพื่อรักษาความปลอดภัยจากคอมพิวเตอร์ควอนตัมมีความเข้ากันได้แบบย้อนหลัง คาดว่าเพียร์ DTLS และมิดเดิลแวร์เครือข่ายที่มีอยู่จะไม่สนใจตัวเลือกใหม่ดังกล่าวและจะยังคงเลือกตัวเลือกก่อนหน้านี้อยู่ต่อไป\n\nอย่างไรก็ตาม อุปกรณ์ที่ไม่มีการใช้งาน DTLS อย่างถูกต้องอาจทำงานผิดพลาดเมื่อเสนอตัวเลือกใหม่นี้ เช่น อาจยกเลิกการเชื่อมต่อเมื่อพบเจอตัวเลือกที่ไม่รู้จักหรือเมื่อได้รับข้อความที่มีขนาดใหญ่ขึ้นซึ่งเป็นผลจากตัวเลือกนั้น อุปกรณ์ดังกล่าวยังไม่พร้อมสำหรับการใช้งานหลังยุคควอนตัมและจะรบกวนการเปลี่ยนระบบหลังยุคควอนตัมขององค์กร หากพบปัญหาการรบกวนดังกล่าว ผู้ดูแลระบบควรติดต่อผู้ให้บริการเพื่อแก้ไขปัญหา\n\nนโยบายนี้เป็นมาตรการชั่วคราวและจะถูกนำออกหลังจากเวลาผ่านไประยะหนึ่ง";
WebRtcTextLogCollectionAllowed.pfm_title = "อนุญาตให้รวบรวมบันทึกข้อความ WebRTC จากบริการของ Google";
WebRtcTextLogCollectionAllowed.pfm_description = "การตั้งค่านโยบายเป็น \"เปิดใช้\" จะทำให้ Brave รวบรวมบันทึกข้อความ WebRTC จากบริการของ Google เช่น Google Meet และอัปโหลดไปยัง Google ได้ บันทึกเหล่านี้มีข้อมูลการวินิจฉัยสำหรับแก้ไขปัญหาข้อบกพร่องเกี่ยวกับการประชุมด้วยเสียงหรือการประชุมทางวิดีโอใน Brave เช่น ข้อมูลเมตาข้อความที่อธิบายสตรีมขาเข้าและขาออกใน WebRTC, รายการบันทึกที่เจาะจงของ WebRTC รวมถึงข้อมูลระบบเพิ่มเติม บันทึกเหล่านี้ไม่มีเนื้อหาเสียงหรือวิดีโอจากการประชุม\nการตั้งค่านโยบายเป็น \"ปิดใช้\" จะทำให้ไม่มีการอัปโหลดบันทึกดังกล่าวไปยัง Google บันทึกจะยังคงเก็บสะสมไว้ในอุปกรณ์ของผู้ใช้\nการไม่ตั้งค่านโยบายหมายความว่า Brave สามารถรวบรวมและอัปโหลดบันทึกเหล่านี้ได้โดยค่าเริ่มต้น";
WebRtcUdpPortRange.pfm_title = "จำกัดช่วงของพอร์ต UDP ในเครื่องที่ WebRTC ใช้งาน";
WebRtcUdpPortRange.pfm_description = "หากตั้งค่านโยบายนี้ไว้ WebRTC จะใช้งานพอร์ต UDP ตามช่วงพอร์ตที่ระบุ (รวมจุดสิ้นสุดด้วย)\n\nหากไม่ได้ตั้งค่านโยบายนี้ไว้ หรือตั้งค่าเป็นสตริงว่างหรือช่วงพอร์ตที่ไม่ถูกต้อง จะเป็นการอนุญาตให้ WebRTC ใช้พอร์ต UDP ที่ว่างอยู่พอร์ตใดก็ได้ในเครื่อง";
WebUsbAllowDevicesForUrls.pfm_title = "ให้สิทธิ์เว็บไซต์เหล่านี้โดยอัตโนมัติในการเชื่อมต่อกับอุปกรณ์ USB ที่มีรหัสผู้ให้บริการและรหัสสินค้าที่ระบุ";
WebUsbAllowDevicesForUrls.pfm_description = "การตั้งค่านโยบายนี้ให้คุณระบุรูปแบบ URL ซึ่งเจาะจงเว็บไซต์ที่ได้รับสิทธิ์โดยอัตโนมัติในการเข้าถึงอุปกรณ์ USB ที่มีรหัสผู้ให้บริการและรหัสสินค้าที่กำหนด รูปแบบแต่ละรายการต้องระบุทั้งช่อง devices และ urls นโยบายจึงจะมีผล รูปแบบแต่ละรายการในช่อง devices อาจระบุช่อง vendor_id และ product_id การไม่ระบุช่อง vendor_id จะสร้างนโยบายที่ตรงกับอุปกรณ์ทุกเครื่อง การไม่ระบุช่อง product_id จะสร้างนโยบายที่ตรงกับอุปกรณ์ทุกเครื่องที่มีรหัสผู้ให้บริการที่กำหนด นโยบายที่ระบุช่อง product_id แต่ไม่ระบุช่อง vendor_id จะไม่มีผล\n\nโมเดลสิทธิ์ USB จะให้สิทธิ์ URL ที่ระบุในการเข้าถึงอุปกรณ์ USB เป็นต้นทางระดับบนสุด หากเฟรมแบบฝังจำเป็นต้องเข้าถึงอุปกรณ์ USB ควรใช้ส่วนหัว feature-policy ของ \"usb\" เพื่อให้สิทธิ์เข้าถึง URL ต้องใช้การได้ มิเช่นนั้น นโยบายจะไม่มีผล\n\nเลิกใช้งาน: โมเดลสิทธิ์ USB ที่ใช้เพื่อรองรับการระบุทั้ง URL ที่ส่งคำขอและ URL ที่มีการฝัง เราเลิกใช้งานโมเดลนี้แล้วและรองรับเฉพาะความเข้ากันได้แบบย้อนหลังในลักษณะต่อไปนี้ ได้แก่ ในกรณีที่มีการระบุทั้ง URL ที่ส่งคำขอและ URL ที่มีการฝัง ระบบจะให้สิทธิ์แก่ URL ที่มีการฝังเป็นต้นทางระดับบนสุดและไม่พิจารณา URL ที่ส่งคำขอ\n\nนโยบายนี้จะลบล้าง DefaultWebUsbGuardSetting, WebUsbAskForUrls, WebUsbBlockedForUrls และค่ากำหนดของผู้ใช้\n\nรวมถึงจะมีผลเฉพาะกับสิทธิ์เข้าถึงอุปกรณ์ USB ผ่าน WebUSB API เท่านั้น หากต้องการให้สิทธิ์เข้าถึงอุปกรณ์ USB ผ่าน Web Serial API ให้ดูนโยบาย SerialAllowUsbDevicesForUrls\nดูข้อมูลเพิ่มเติมเกี่ยวกับสคีมาและการจัดรูปแบบได้ที่ https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls";
WebUsbAskForUrls.pfm_title = "อนุญาต WebUSB ในเว็บไซต์เหล่านี้";
WebUsbAskForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ขอให้ผู้ใช้ให้สิทธิ์เข้าถึงอุปกรณ์ USB ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultWebUsbGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nรูปแบบ URL ต้องไม่ขัดแย้งกับ WebUsbAskForUrls ไม่มีนโยบายที่จะมีความสำคัญสูงกว่าหาก URL ตรงกับทั้ง 2 นโยบาย\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
WebUsbBlockedForUrls.pfm_title = "บล็อก WebUSB ในเว็บไซต์เหล่านี้";
WebUsbBlockedForUrls.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งระบุเว็บไซต์ที่ไม่สามารถขอให้ผู้ใช้ให้สิทธิ์เข้าถึงอุปกรณ์ USB ได้\n\nการไม่ตั้งค่านโยบายหมายความว่า DefaultWebUsbGuardSetting จะมีผลกับทุกเว็บไซต์ (หากตั้งค่าไว้) แต่หากไม่ได้ตั้งค่าไว้ การตั้งค่าส่วนตัวของผู้ใช้จะมีผล\n\nรูปแบบ URL ต้องไม่ขัดแย้งกับ WebUsbAskForUrls ไม่มีนโยบายที่จะมีความสำคัญสูงกว่าหาก URL ตรงกับทั้ง 2 นโยบาย\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns * ไม่ใช่ค่าที่ยอมรับสำหรับนโยบายนี้";
WindowCaptureAllowedByOrigins.pfm_title = "อนุญาตให้ต้นทางเหล่านี้จับภาพหน้าต่างและแท็บ";
WindowCaptureAllowedByOrigins.pfm_description = "การตั้งค่านโยบายจะให้คุณสร้างรายการรูปแบบ URL ซึ่งใช้การจับภาพหน้าต่างและแท็บได้\n\nการไม่ตั้งค่านโยบายจะทำให้ระบบไม่พิจารณาเว็บไซต์เพื่อทำการลบล้างที่การจับภาพระดับนี้\n\nระบบจะไม่พิจารณานโยบายนี้หากเว็บไซต์ตรงกับรูปแบบ URL ในนโยบาย TabCaptureAllowedByOrigins หรือ SameOriginTabCaptureAllowedByOrigins\n\nหากเว็บไซต์ตรงกับรูปแบบ URL ในนโยบายนี้ ระบบจะไม่พิจารณานโยบาย ScreenCaptureAllowedByOrigins และ ScreenCaptureAllowed\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ url ที่ถูกต้องได้ที่ https://chromeenterprise.google/policies/url-patterns/  นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL";
WindowManagementAllowedForUrls.pfm_title = "อนุญาตสิทธิ์การจัดการหน้าต่างในเว็บไซต์เหล่านี้";
WindowManagementAllowedForUrls.pfm_description = "ให้คุณกำหนดรายการรูปแบบ URL ของเว็บไซต์ซึ่งระบุเว็บไซต์ที่จะอนุญาตสิทธิ์การจัดการหน้าต่างโดยอัตโนมัติ การดำเนินการนี้จะทำให้เว็บไซต์สามารถดูข้อมูลเกี่ยวกับหน้าจอของอุปกรณ์แล้วใช้ข้อมูลนั้นในการเปิดและวางหน้าต่างหรือขอโหมดเต็มหน้าจอในบางหน้าจอได้\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องของเว็บไซต์ได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้ นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL\n\nหากไม่ได้ตั้งค่านโยบายนี้สำหรับเว็บไซต์ นโยบายจาก DefaultWindowManagementSetting ก็จะมีผลกับเว็บไซต์เมื่อตั้งค่าไว้ ไม่เช่นนั้นสิทธิ์ดังกล่าวจะเป็นไปตามค่าเริ่มต้นของเบราว์เซอร์และอนุญาตให้ผู้ใช้เลือกสิทธิ์สำหรับแต่ละเว็บไซต์\n\nนโยบายนี้มาแทนที่นโยบาย WindowPlacementAllowedForUrls ที่เลิกใช้งานแล้ว";
WindowManagementBlockedForUrls.pfm_title = "บล็อกสิทธิ์การจัดการหน้าต่างในเว็บไซต์เหล่านี้";
WindowManagementBlockedForUrls.pfm_description = "ให้คุณกำหนดรายการรูปแบบ URL ของเว็บไซต์ซึ่งระบุเว็บไซต์ที่จะปฏิเสธสิทธิ์การจัดการหน้าต่างโดยอัตโนมัติ การดำเนินการนี้จะจำกัดไม่ให้เว็บไซต์ดูข้อมูลเกี่ยวกับหน้าจอของอุปกรณ์เพื่อใช้ข้อมูลนั้นในการเปิดและวางหน้าต่างหรือขอโหมดเต็มหน้าจอในบางหน้าจอ\n\nดูข้อมูลโดยละเอียดเกี่ยวกับรูปแบบ URL ที่ถูกต้องของเว็บไซต์ได้ที่ https://chromeenterprise.google/policies/url-patterns ใช้ไวลด์การ์ด (*) ได้ นโยบายนี้จะจับคู่โดยอิงตามต้นทางเท่านั้น ระบบจึงไม่สนใจเส้นทางใดก็ตามในรูปแบบ URL\n\nหากไม่ได้ตั้งค่านโยบายนี้สำหรับเว็บไซต์ นโยบายจาก DefaultWindowManagementSetting ก็จะมีผลกับเว็บไซต์เมื่อตั้งค่าไว้ ไม่เช่นนั้นสิทธิ์ดังกล่าวจะเป็นไปตามค่าเริ่มต้นของเบราว์เซอร์และอนุญาตให้ผู้ใช้เลือกสิทธิ์สำหรับแต่ละเว็บไซต์\n\nนโยบายนี้มาแทนที่นโยบาย WindowPlacementBlockedForUrls ที่เลิกใช้งานแล้ว";
XSLTEnabled.pfm_title = "ควบคุมความพร้อมใช้งานของฟีเจอร์ XSLT";
XSLTEnabled.pfm_description = "นโยบายนี้ควบคุมความพร้อมใช้งานของฟีเจอร์ XSLT (XSLTProcessor JavaScript API และคำสั่งการประมวลผล XSL)\nหากตั้งค่านโยบายนี้เป็น \"เปิดใช้\" XSLT จะพร้อมใช้งาน ไม่ว่าสถานะเริ่มต้นของฟีเจอร์ในเบราว์เซอร์จะเป็นอย่างไร\nหากตั้งค่านโยบายนี้เป็น \"ปิดใช้\" XSLT จะใช้งานไม่ได้ ไม่ว่าสถานะเริ่มต้นของฟีเจอร์ในเบราว์เซอร์จะเป็นอย่างไร\nหากไม่ได้ตั้งค่านโยบายนี้ ความพร้อมใช้งานของ XSLT จะกำหนดโดยการตั้งค่าเริ่มต้นของเบราว์เซอร์และการทดสอบในวงจำกัด\nนโยบายนี้เป็นมาตรการชั่วคราวและจะถูกนำออกใน M176";