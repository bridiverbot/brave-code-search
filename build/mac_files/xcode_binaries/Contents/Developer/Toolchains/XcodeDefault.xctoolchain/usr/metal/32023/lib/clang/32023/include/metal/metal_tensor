  METAL_FUNC index_type __get_stride(rank_type r) thread  const
  {
    return __metal_get_stride_tensor(
        static_cast<const thread  tensor_type *>(this)->handle(),
        extents_type::rank(), r,
        __tensor_detail::__get_plane_index<PlaneTag>(), size_type());
  }

