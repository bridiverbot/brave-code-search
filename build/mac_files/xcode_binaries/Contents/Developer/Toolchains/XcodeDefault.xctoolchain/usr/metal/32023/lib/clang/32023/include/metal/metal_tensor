struct __TENSOR_INLINE_ATTRS(Extents) tensor<ElementType, Extents, tensor_inline, Tags...>
  : public __tensor_base<tensor<ElementType, Extents, tensor_inline, Tags...>>
{
private:
  using base = __tensor_base<tensor<ElementType, Extents, tensor_inline, Tags...>>;

  template <class, class> friend struct __tensor_base;
