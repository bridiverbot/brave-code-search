#define METAL_RELAXED_ORDER(O) METAL_ENABLE_IF(O == memory_order_relaxed, "'" #O "' argument must be 'metal::memory_order_relaxed' if no 'mem_flags' argument is provided")

#if defined(__HAVE_PARTIAL_ORDER_ATOMIC__)
#if defined(__HAVE_GENERIC_ADDRESS_SPACE__)
template <typename T, typename U, thread_scope S>
METAL_FUNC enable_if_t<_valid_non_fetch_type<thread T *>::value &&
                       is_convertible<T, U>::value>
atomic_store_explicit(volatile thread _atomic<T, S> *object, U desired, memory_order order, mem_flags flags)
{
  __metal_atomic_store_explicit(&object->__s, decltype(object->__s)(desired), int(order), int(S), int(flags));
}
template <typename T, typename U, thread_scope S>
METAL_FUNC enable_if_t<_valid_non_fetch_type<thread T *>::value &&
                       is_convertible<T, U>::value>
atomic_store_explicit(volatile thread _atomic<T, S> *object, U desired, memory_order order) METAL_CONST_ARG(order) METAL_RELAXED_ORDER(order)
{
  __metal_atomic_store_explicit(&object->__s, decltype(object->__s)(desired), int(order), int(S), __METAL_MEMORY_FLAGS_NONE__);
}
template <typename T, typename U, thread_scope S>
METAL_FUNC enable_if_t<_valid_non_fetch_type<thread T *>::value &&
                       is_convertible<T, U>::value>
atomic_store(volatile thread _atomic<T, S> *object, U desired)
{
  atomic_store_explicit(object, desired, memory_order_seq_cst, static_cast<mem_flags>(__METAL_MEMORY_FLAGS_ALL__));
}
