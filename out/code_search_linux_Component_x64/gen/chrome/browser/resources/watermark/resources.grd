<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/watermark_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/watermark_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/watermark_resources_map.h"
            type="resource_map_header" />
    <output filename="watermark_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_WATERMARK_WATERMARK_HTML" file="${root_gen_dir}/chrome/browser/resources/watermark/preprocessed/watermark.html" resource_path="watermark.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WATERMARK_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/watermark/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WATERMARK_APP_JS" file="${root_gen_dir}/chrome/browser/resources/watermark/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WATERMARK_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/watermark/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_WATERMARK_WATERMARK_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/watermark/minified/watermark.mojom-webui.js" resource_path="watermark.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
