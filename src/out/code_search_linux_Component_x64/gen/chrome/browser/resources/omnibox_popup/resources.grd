<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/omnibox_popup_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/omnibox_popup_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/omnibox_popup_resources_map.h"
            type="resource_map_header" />
    <output filename="omnibox_popup_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_OMNIBOX_POPUP_IMAGES_CREATE_IMAGES_PNG" file="${root_src_dir}/chrome/browser/resources/omnibox_popup/images/create_images.png" resource_path="images/create_images.png" use_base_dir="false" type="BINDATA" />
      <include name="IDR_OMNIBOX_POPUP_OMNIBOX_POPUP_HTML" file="${root_gen_dir}/chrome/browser/resources/omnibox_popup/preprocessed/omnibox_popup.html" resource_path="omnibox_popup.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_OMNIBOX_POPUP_OMNIBOX_POPUP_AIM_HTML" file="${root_gen_dir}/chrome/browser/resources/omnibox_popup/preprocessed/omnibox_popup_aim.html" resource_path="omnibox_popup_aim.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_OMNIBOX_POPUP_OMNIBOX_POPUP_DOCUMENT_STYLE_CSS" file="${root_gen_dir}/chrome/browser/resources/omnibox_popup/preprocessed/omnibox_popup_document_style.css" resource_path="omnibox_popup_document_style.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_OMNIBOX_POPUP_OMNIBOX_POPUP_FULL_HTML" file="${root_gen_dir}/chrome/browser/resources/omnibox_popup/preprocessed/omnibox_popup_full.html" resource_path="omnibox_popup_full.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_OMNIBOX_POPUP_OMNIBOX_POPUP_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/omnibox_popup/minified/omnibox_popup.rollup.js" resource_path="omnibox_popup.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_OMNIBOX_POPUP_OMNIBOX_POPUP_CLASSIC_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/omnibox_popup/minified/omnibox_popup_classic.rollup.js" resource_path="omnibox_popup_classic.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_OMNIBOX_POPUP_SHARED_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/omnibox_popup/minified/shared.rollup.js" resource_path="shared.rollup.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
