        "CARGO_PKG_VERSION": "0.8.4",
        "CARGO_PKG_VERSION_MAJOR": "0",
        "CARGO_PKG_VERSION_MINOR": "8",
        "CARGO_PKG_VERSION_PATCH": "4",
        "CARGO_PKG_VERSION_PRE": "",
        "CARGO_PKG_NAME": "yoke-derive",
        "CARGO_PKG_DESCRIPTION": "Custom derive for the yoke crate",
