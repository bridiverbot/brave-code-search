--crate-name
test_simple_rust_exe
--crate-type
bin
-Dwarnings
-Cforce-unwind-tables=yes
-Crelocation-model=pic
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--color=always
--target=x86_64-unknown-linux-gnu
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
--cfg
cr_rustc_revision="110108a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-8a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-1-24-14453-ge063be79"
-Copt-level=3
-Cforce-frame-pointers=yes
-Zallow-features=
-Cdebug-assertions
-Zdefault-visibility=hidden
--sysroot=local_rustc_sysroot
-Ldependency=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib
-Clink-arg=-Bdynamic
-Clink-arg=./libc++.so
-Clink-arg=./libatomic.so
-Clink-arg=local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/libstd_std.rlib
