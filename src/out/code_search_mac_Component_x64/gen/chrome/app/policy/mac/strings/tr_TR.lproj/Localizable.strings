/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Brave tercihleri";
AIModeSettings.pfm_title = "Adres çubuğundaki ve Yeni Sekme sayfası arama kutusundaki Google'ın AI Modu entegrasyonlarıyla ilgili ayarlar.";
AIModeSettings.pfm_description = "0 - AI Modu entegrasyonlarına izin ver.\n1 - AI Modu entegrasyonlarına izin verme.\nBu politika, adres çubuğundaki ve Yeni Sekme sayfası arama kutusundaki Google AI Modu entegrasyonlarını kontrol eder.\n\nBu özelliğe erişebilmek için kullanıcının varsayılan arama motoru olarak Google ayarlanmış olmalıdır.\n\n0 = Kullanıcılar özelliği kullanabilir.\n\n1 = Kullanıcılar özelliği kullanamaz.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.";
AbusiveExperienceInterventionEnforce.pfm_title = "Kötüye Kullanım Deneyimi Müdahele Yaptırımı";
AbusiveExperienceInterventionEnforce.pfm_description = "SafeBrowsingEnabled Devre dışı değerine ayarlanmamışsa AbusiveExperienceInterventionEnforce politikasının Etkin değerine ayarlanması veya ayarlanmadan bırakılması, kötüye kullanım deneyimi yaşatan sitelerin yeni pencere veya sekme açmasını önler.\n\nSafeBrowsingEnabled politikası veya AbusiveExperienceInterventionEnforce politikası Devre dışı değerine ayarlanırsa, kötüye kullanım deneyimi yaşatan sitelerin yeni pencere veya sekme açmasına izin verilir.";
AccessCodeCastDeviceDuration.pfm_title = "Erişim kodu veya QR koduyla seçilen bir yayın cihazının, Google Cast menüsündeki yayın cihazları listesinde kaç saniye duracağını belirtir.";
AccessCodeCastDeviceDuration.pfm_description = "Bu politika, daha önce erişim kodu veya QR kodu aracılığıyla seçilen bir yayın cihazının, Google Cast yayın cihazı menüsünde kaç saniye gösterileceğini belirtir.\nBir girişin ömrü, erişim kodunun ilk girildiği veya QR kodunun ilk tarandığı zaman başlar.\nYayın cihazı bu süre boyunca Google Cast menüsündeki yayın cihazları listesinde görünür.\nYayın cihazını bu süreden sonra tekrar kullanabilmek için erişim kodu yeniden girilmeli veya QR kodu yeniden taranmalıdır.\nVarsayılan olarak bu süre sıfır saniye olduğu için yayın cihazları Google Cast menüsünde durmaz. Bu nedenle, yeni bir yayın oturumu başlatmak için erişim kodu yeniden girilmeli veya QR kodu yeniden taranmalıdır.\nBu politikanın yalnızca bir yayın cihazının Google Cast menüsünde ne kadar süreyle görüneceğini etkilediğini ve bu süre sona erse bile devam eden herhangi bir yayın oturumu üzerinde etkisi olmadığını unutmayın.\nAccessCodeCastEnabled politikası Etkin değerine ayarlanmadıkça bu politikanın hiçbir etkisi olmaz.";
AccessCodeCastEnabled.pfm_title = "Kullanıcıların, Google Cast menüsünde erişim kodu veya QR kodu kullanarak yayın cihazı seçmesine izin ver.";
AccessCodeCastEnabled.pfm_description = "Bu politika, yayın cihazlarının ekranında gözüken erişim kodunu veya QR kodunu kullanarak, Google Cast menüsünde görünmeyen yayın cihazlarına yayın yapma imkanı veren bir seçeneğin kullanıcılara Google Cast menüsünde sunulup sunulmayacağını kontrol eder.\nKullanıcının sonraki yayın oturumunu başlatmak için varsayılan olarak erişim kodunu yeniden girmesi veya QR kodunu yeniden taraması gerekir. Ancak AccessCodeCastDeviceDuration politikası sıfır olmayan bir değere (varsayılan değer sıfırdır) ayarlanırsa yayın cihazı, belirtilen süre dolana kadar kullanılabilir yayın cihazları listesinde kalır.\nBu politika Etkin değerine ayarlanırsa kullanıcılara erişim kodu kullanarak veya QR kodu tarayarak yayın cihazı seçme olanağı verilir.\nBu politika Devre Dışı değerine ayarlanırsa veya ayarlanmadan bırakılırsa kullanıcılara erişim kodu kullanarak ya da QR kodu tarayarak yayın cihazı seçme olanağı verilmez.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "CORS ön kontrolünde eşleşen Access-Control-Allow-Methods yanıt başlığını spesifikasyonla uyumlu hale getir";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Bu politika, CORS ön kontrolündeki Access-Control-Allow-Methods yanıt başlıklarıyla eşleşen istek yöntemlerinin büyük harfle yazılıp yazılmayacağını kontrol eder.\n\nPolitika, Devre Dışı değerine ayarlanırsa istek yöntemleri büyük harfle yazılır.\nBu davranış, Brave 108 veya önceki sürümlerde geçerlidir.\n\nPolitika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa istek yöntemleri büyük/küçük harfe duyarlı olmaksızın DELETE, GET, HEAD, OPTIONS, POST veya PUT ile eşleşmediği sürece büyük harfle yazılmaz.\nBu durumda fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" yanıt başlığı reddedilir ve\nfetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\" yanıt başlığı kabul edilir.\n\nNot: \"post\" ve \"put\" istek yöntemleri etkilenmez,\"patch\" etkilenir.\n\nBu politika, geçici olarak tasarlanmıştır ve gelecekte kaldırılacaktır.";
AccessibilityImageLabelsEnabled.pfm_title = "Get Image Descriptions from Google özelliğini etkinleştir";
AccessibilityImageLabelsEnabled.pfm_description = "Get Image Descriptions from Google erişilebilirlik özelliği, görme engelli ekran okuyucu kullanıcılarının web'deki etiketsiz resimlerin açıklamalarını almalarını sağlar. Bu özelliği etkinleştirmeyi seçen kullanıcıların, web'de karşılaştıkları etiketlenmemiş resimlerin otomatik olarak açıklamalarını sağlayacak anonim bir Google hizmetini kullanma seçenekleri olur.\n\nBu özellik etkinleştirilirse resimlerin içeriği, açıklama oluşturmak için Google sunucularına gönderilir. Çerez veya başka kullanıcı verileri gönderilmez. Google, hiçbir resim içeriğini saklamaz veya günlüğe kaydetmez.\n\nBu politika Etkin değerine ayarlanırsa Get Image Descriptions from Google özelliği etkinleştirilir, ancak bundan yalnızca ekran okuyucu veya benzeri başka yardımcı teknolojileri kullanan kullanıcılar etkilenir.\n\nBu politika Devre Dışı değerine ayarlanırsa kullanıcıların özelliği etkinleştirme seçeneği olmaz.\n\nBu politika ayarlanmazsa kullanıcı, bu özelliği kullanmayı veya kullanmamayı seçebilir.\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "İlave DNS kayıt türleri için DNS sorgularına izin ver";
AdditionalDnsQueryTypesEnabled.pfm_description = "Bu politika, Brave tarayıcısının güvenli olmayan DNS istekleri yaparken ilave DNS kayıt türleri sorgulayıp sorgulamayacağını kontrol eder. Bu politika, Güvenli DNS üzerinden yapılan DNS sorgularını etkilemez. Güvenli DNS, her zaman ilave DNS türlerini sorgulayabilir.\n\nBu politika ayarlanmaz veya Etkin değerine ayarlanırsa A (DNS tür 1) ve AAAA (DNS tür 28) türlerine ek olarak HTTPS (DNS tür 65) gibi ilave türler sorgulanabilir.\n\nBu politika, Devre Dışı değerine ayarlanırsa DNS, yalnızca A (DNS tür 1) ve/veya AAAA (DNS tür 28) için sorgulanır.\n\nBu politika geçici bir çözüm olup gelecekteki Brave sürümlerinden kaldırılacaktır. Politikanın kaldırılmasından sonra Brave, her zaman ilave DNS türlerini sorgulayabilecektir.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Araya giren reklamların yer aldığı siteler için reklam ayarı";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Tüm sitelerde reklamlara izin ver\n2 - Arayan giren reklamların yer aldığı sitelerde reklamlara izin verme\nSafeBrowsingEnabled, False (Yanlış) olarak ayarlanmamış ve AdsSettingForIntrusiveAdsSites seçeneğine, 1 verilmiş veya herhangi bir değer verilmemişse tüm sitelerde reklamlara izin verilir.\n\nPolitikayı 2 değerine ayarlayarak sitelerde araya giren reklamları engelleyebilirsiniz.";
AdvancedProtectionAllowed.pfm_title = "Gelişmiş Koruma programına kayıtlı kullanıcılar için ek koruma özelliklerini etkinleştir";
AdvancedProtectionAllowed.pfm_description = "Bu politika, Gelişmiş Koruma programına kayıtlı kullanıcılara ekstra özellikler sunulup sunulmayacağını kontrol eder. Bu özelliklerin bazıları kapsamında Google ile veri paylaşılabilir (örneğin, Gelişmiş Koruma kullanıcıları indirdikleri dosyaları Google'a göndererek kötü amaçlı yazılıma karşı taranmasını sağlayabilir). Bu politika True (Doğru) değerine ayarlanır veya ayarlanmadan bırakılırsa kayıtlı kullanıcılara ekstra özellikler sunulur. Bu politika False (Yanlış) değerine ayarlanırsa Gelişmiş Koruma kullanıcılarına yalnızca standart tüketici özellikleri sunulur.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Tüm HTTP kimlik doğrulamalarına izin veren kaynakların listesi";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "Politika ayarlandığında AuthSchemes politikasından bağımsız olarak hangi kaynaklar için Brave tarafından desteklenen tüm HTTP kimlik doğrulama şemalarına izin verileceğini belirtir.\n\nBrave 161 sürümünden itibaren bu politika yalnızca hedef sunucu kaynakları için geçerli olacak ve proxy sunucu kimlik doğrulama sorgulamaları için geçerli olmayacak. Proxy sunucular için tüm HTTP kimlik doğrulama şemalarına izin vermek istiyorsanız bunun yerine AllHttpAuthSchemesAllowedForProxies politikasını kullanın. 161'den önceki sürümlerde, AllHttpAuthSchemesAllowedForProxies ayarlanmadığı sürece bu politikayla eşleşen proxy sunucuların tüm HTTP kimlik doğrulama şemalarını kullanmasına da izin verilir.\n\nKaynak kalıbını, https://support.google.com/chrome/a?p=url_blocklist_filter_format adresine göz atarak biçimlendirin. AllHttpAuthSchemesAllowedForOrigins içinde en fazla 1.000 istisna tanımlanabilir.\nAna makine bileşeni için joker karakterlere izin verilir (ör. \"*:8000\", 8000 bağlantı noktasındaki tüm ana makinelerle eşleşir). Tüm şemaları veya tüm bağlantı noktalarını eşleştirmek için bileşeni tamamen çıkarın (ör. \"example.com\" herhangi bir şema ve herhangi bir bağlantı noktasıyla eşleşir). Ana makine adı (ör. \"example.com\"), alt alan adlarıyla da eşleşir. Bir ana makinenin tam olarak eşleşmesi ve alt alan adlarının hariç tutulması için başına nokta ekleyin (ör. \".example.com\"). Tüm kaynakları eşleştirmek için tek bir yıldız işareti (\"*\") kullanın.";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Tüm HTTP kimlik doğrulama şemalarına izin veren proxy sunucuların listesi";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "Politika ayarlandığında AuthSchemes politikasından bağımsız olarak hangi proxy sunucuları için Brave tarafından desteklenen tüm HTTP kimlik doğrulama şemalarına izin verileceğini belirtir.\n\nProxy sunucu kalıbını, URL engellenenler listesi filtre biçimine (https://support.google.com/chrome/a?p=url_blocklist_filter_format) göre biçimlendirin. En fazla 1.000 istisna tanımlanabilir.\nAna makine bileşeni için joker karakterlere izin verilir (ör. \"*:8080\", 8080 bağlantı noktasındaki tüm proxy'lerle eşleşir). Ana makine adı (ör. \"proxy.example.com\"), alt alan adlarıyla da eşleşir. Bir ana makinenin tam olarak eşleşmesi ve alt alan adlarının hariç tutulması için başına nokta ekleyin (ör. \".proxy.example.com\").\n\nBu politika ayarlanmazsa proxy kimlik doğrulaması için yalnızca AuthSchemes politikasında belirtilen HTTP kimlik doğrulama şemaları (veya ayarlanmamışsa varsayılan şemalar) desteklenir.";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Cache-Control: no-store başlığı içeren sayfaların geri-ileri önbelleğe girmesine izin ver";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Bu politika, Cache-Control: no-store başlığı içeren bir sayfanın geri-ileri önbellek içinde depolanıp depolanmayacağını kontrol eder. Bazı hassas bilgiler, bunlara artık erişilemediğinde bile geri yüklemeden sonra gösterilmeye devam edebileceği için bu başlığın ayarlandığı web sitesinde, sayfa geri-ileri önbellek üzerinden geri yüklenmez.\n\nPolitika etkinleştirilirse veya ayarlanmadan bırakılırsa Cache-Control: no-store başlığı içeren sayfa, önbellekten çıkarma işleminin tetiklendiği (ör. sitede yalnızca HTTP çerez değişikliği olduğunda) durumlar dışında geri-ileri önbellek üzerinden geri yüklenebilir.\n\nPolitika devre dışı bırakılırsa Cache-Control: no-store başlığı içeren sayfa, geri-ileri önbellek içinde depolanmaz.";
AllowCrossOriginAuthPrompt.pfm_title = "Çapraz kaynak HTTP Kimlik Doğrulama istemleri";
AllowCrossOriginAuthPrompt.pfm_description = "Politikanın Etkin değerine ayarlanması, sayfadaki üçüncü taraf görsellerinin bir kimlik doğrulama istemi göstermesini sağlar.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa üçüncü taraf görsellerinin, kimlik doğrulama istemi göstermesi engellenir.\n\nGenellikle bu politika kimlik avına karşı bir savunma olarak Devre Dışıdır.";
AllowDeletingBrowserHistory.pfm_title = "Tarayıcı ve indirme geçmişinin silinmesini etkinleştir";
AllowDeletingBrowserHistory.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa tarayıcı geçmişi ve indirme geçmişi Chrome'da silinebilir ve kullanıcılar bu ayarı değiştiremezler.\n\nPolitika, Devre Dışı değerine ayarlanırsa tarayıcı geçmişi ve indirme geçmişi silinemez. Bu politika devre dışı bırakılsa bile tarama ve indirme geçmişinin saklanacağı garanti edilmez. Kullanıcılar geçmiş veritabanındaki dosyaları doğrudan düzenleyebilir veya silebilirler. Ayrıca tarayıcının kendisinin süresi dolabilir veya geçmiş öğelerinin herhangi birini veya tümünü her an arşive alabilir.";
AllowDinosaurEasterEgg.pfm_title = "Dinozor Paskalya Yumurtası Oyununa İzin Verme";
AllowDinosaurEasterEgg.pfm_description = "Politikanın Doğru değerine ayarlanması, kullanıcıların dinozor oyunu oynamalarına izin verir. Politikanın Yanlış değerine ayarlanması, kullanıcıların cihaz internete bağlı değilken paskalya yumurtası oyununu oynayamayacakları anlamına gelir.\n\nPoltikanının ayarlanmadan bırakılması, kullanıcıların oyunu kayıtlı Google Chrome OS ürününde oynayamayacakları, ancak diğer durumlarda oynayabilecekleri anlamına gelir.";
AllowFileSelectionDialogs.pfm_title = "Dosya seçimi iletişim kutularının çağrılmasına izin ver";
AllowFileSelectionDialogs.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa dosya seçimi iletişim kutuları Chrome tarafından görüntülenebilir ve kullanıcılar tarafından açılabilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa kullanıcılar yer işareti içe aktarma, dosya yükleme ve bağlantı kaydetme gibi dosya seçimi iletişim kutusunun açılmasını sağlayan işlemler yaptıklarında bir mesaj görüntülenir. Kullanıcının dosya seçimi iletişim kutusunda İptal'i tıklamış olduğu varsayılır.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Proxy'ler için yuva havuzu boyutunu rastgele hale getirmeye izin ver";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "Yuva havuzu boyutunu rastgele hale getirme, saldırganların siteler arası bilgileri öğrenmek için deterministik kapasite sınırlarından yararlanmasını önleyen bir güvenlik mekanizmasıdır.\nBir havuzun normal kapasitesi 128 yuva ise bu mekanizma, havuzun kapasitesini rastgele olarak 128 ile 256 arasında bir değerle sınırlandırır.\nBu sayede, proxy ile 2 kat daha fazla bağlantı kurulabilir ancak pratikte beklenen değer 1,2 kat civarındadır.\n\nBu durum, MaxConnectionsPerProxy ve MaxConnectionsPerProxyForWebSocket ayarlarını etkiler.\nÜst sınırı kendileri belirlemek yerine, üst sınır onların değerinin 2 katı olur (ancak pratikte beklenen değer yine onların 1,2 katı civarındadır).\n\nBu, tüm havuzlar için varsayılan olarak etkindir ancak bu politika, özelliğin özellikle proxy havuzları için devre dışı bırakılmasına olanak tanır.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Sorunlu TLS sertifikalarına sahip sitelerde web kimlik doğrulama isteklerine izin ver.";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Politika, Etkin değerine ayarlanırsa Brave\nhatalı TLS sertifikası içeren web sitelerinde (yani, güvenli olmadığı düşünülen web sitelerinde)\nweb kimlik doğrulama isteklerine izin verir.\n\nPolitika, Devre Dışı değerine ayarlanırsa veya ayarlanmadan bırakılırsa varsayılan\nolarak bu tür istekleri engelleme davranışı geçerli olur.";
AllowedDomainsForApps.pfm_title = "Google Workspace ürününe erişim izni olan alanları belirle";
AllowedDomainsForApps.pfm_description = "Politika ayarlanırsa Google Workspace içinde Chrome'un kısıtlı oturum açma özelliği etkinleştirilir ve kullanıcılar bu ayarı değiştiremezler. Kullanıcılar sadece belirtilen alan adlarındaki hesapları kullanarak Google araçlarına erişebilirler (gmail veya googlemail hesaplarına izin vermek için alan adı listesine consumer_accounts öğesini ekleyin). Bu ayar, kullanıcıların Google kimlik doğrulaması gerektiren yönetilen bir cihazda oturum açmalarını ve açıkça izin verilen alan adlarından birine ait olmadığı sürece İkincil Hesap eklemelerini engeller.\n\nBu ayar boş veya ayarlanmadan bırakılırsa kullanıcılar herhangi bir hesapla Google Workspace ürününe erişebilirler.\n\nKullanıcılar bu ayarı değiştiremez veya geçersiz kılamazlar.\n\nNot: Bu politika, https://support.google.com/a/answer/1668854 sayfasında açıklandığı gibi, tüm google.com alan adlarına gönderilen tüm HTTP ve HTTPS isteklerine X-GoogApps-Allowed-Domains başlığının eklenmesine neden olur.";
AlternateErrorPagesEnabled.pfm_title = "Alternatif hata sayfalarını etkinleştir";
AlternateErrorPagesEnabled.pfm_description = "Politika, Doğru değerine ayarlandığında Brave tarayıcıya gömülü alternatif hata sayfalarını kullanır (ör. \"sayfa bulunamadı\"). Politika, Yanlış değerine ayarlanırsa Brave alternatif hata sayfalarını kullanmaz.\n\nBu politikayı ayarlarsanız kullanıcılar değiştiremez. Ayarlanmazsa politika açık kalır fakat kullanıcılar bu ayarı değiştirebilir.";
AlternativeBrowserParameters.pfm_title = "Alternatif tarayıcı için komut satırı parametreleri.";
AlternativeBrowserParameters.pfm_description = "Bu politika bir dize listesine ayarlanırsa her dize, alternatif tarayıcıya ayrı bir komut satırı parametresi olarak aktarılır. Microsoft® Windows® üzerinde parametreler boşluklarla birleştirilir. macOS ve Linux® üzerinde bir parametre boşluk içermesine rağmen tek bir parametre olarak değerlendirilebilir.\n\nBir parametre ${url} ifadesi içeriyorsa ${url} açılacak sayfanın URL'siyle değiştirilir. Hiçbir öğe ${url} ifadesi içermiyorsa URL, komut satırının sonuna eklenir.\n\nOrtam değişkenleri genişletilir. Microsoft® Windows® işletim sisteminde %ABC% ifadesinin yerine ABC ortam değişkeninin değeri getirilir. macOS ve Linux® işletim sistemlerinde ${ABC} ifadesinin yerine ABC ortam değişkeninin değeri getirilir.\n\nPolitika ayarlanmadan bırakılırsa yalnızca URL, komut satırı parametresi olarak aktarılır.";
AlternativeBrowserPath.pfm_title = "Yapılandırılan web siteleri için başlatılacak alternatif tarayıcı.";
AlternativeBrowserPath.pfm_description = "Bu politika, URL'leri alternatif tarayıcıda açmak için hangi komutun kullanılacağını kontrol eder. Politika; ${ie}, ${firefox}, ${safari}, ${opera}, ${edge} veya bir dosya yoluna ayarlanabilir. Bu politika bir dosya yoluna ayarlanırsa buradaki dosya yürütülebilir dosya olarak kullanılır. ${ie}, sadece Microsoft® Windows® üzerinde kullanılabilir. ${safari} ve ${edge}, sadece Microsoft® Windows® ve macOS üzerinde kullanılabilir.\n\nBu politika ayarlanmadan bırakılırsa platforma özgü bir varsayılan kullanılır: Microsoft® Windows® için Internet Explorer® veya macOS için Safari®. Linux® üzerinde alternatif tarayıcı açılamaz.";
AlwaysOpenPdfExternally.pfm_title = "PDF dosyalarını her zaman harici olarak aç";
AlwaysOpenPdfExternally.pfm_description = "Politika, Etkin değerine ayarlanırsa Brave içinde dahili PDF görüntüleyicisi kapatılır, PDF dosyaları indirme olarak ele alınır ve kullanıcının PDF'leri varsayılan uygulamayla açmasına izin verilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa PDF eklentisi, kullanıcılar tarafından kapatılmadığı sürece PDF dosyalarını açar.\n\nBu politikayı ayarlarsanız kullanıcılar Brave ürününde bunu değiştiremezler. Politika ayarlanmadan bırakılırsa kullanıcılar PDF dosyalarının haricen açılıp açılmayacağını seçebilir.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Ambiyans Kimlik Doğrulamasını profil türlerine göre etkinleştir.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Ambiyans kimlik doğrulamasını yalnızca normal oturumlarda etkinleştir.\n1 - Ambiyans kimlik doğrulamasını gizli ve normal oturumlarda etkinleştir.\n2 - Ambiyans kimlik doğrulamasını misafir oturumlarında ve normal oturumlarda etkinleştir.\n3 - Ambiyans kimlik doğrulamasını normal, gizli ve misafir oturumlarında etkinleştir.\nBu politika yapılandırıldığında Brave içindeki Gizli profiller ve Misafir profilleri için ambiyans kimlik doğrulamasına izin verilir/verilmez.\n\nAmbiyans Kimlik Doğrulaması, NTLM/Kerberos/Negotiate görev/yanıt şemaları üzerinden açık kimlik bilgileri sağlanmadığında varsayılan kimlik bilgileriyle gerçekleştirilen http kimlik doğrulamasıdır.\n\nRegularOnly (0 değeri) ayarlanırsa ambiyans kimlik doğrulaması yalnızca Normal oturumlarda gerçekleştirilebilir. Gizli oturumlar ve Misafir oturumları ambiyans kimlik doğrulaması gerçekleştiremez.\n\nIncognitoAndRegular (1 değeri) ayarlanırsa Gizli ve Normal oturumlarda ambiyans kimlik doğrulaması gerçekleştirilebilir. Misafir oturumları ambiyans kimlik doğrulaması gerçekleştiremez.\n\nGuestAndRegular (2 değeri) ayarlanırsa Misafir oturumlarında ve Normal oturumlarda ambiyans kimlik doğrulaması gerçekleştirilebilir. Gizli oturumlar ambiyans kimlik doğrulaması gerçekleştiremez.\n\nAll (3 değeri) ayarlanırsa tüm oturumlarda ambiyans kimlik doğrulaması gerçekleştirilebilir.\n\nNormal profillerde ambiyans kimlik doğrulamasına her zaman izin verildiğini unutmayın.\n\nBrave sürüm 81 ve sonraki sürümlerde politika ayarlanmadan bırakılırsa ambiyans kimlik doğrulaması yalnızca normal oturumlarda etkinleştirilir.";
AudioCaptureAllowed.pfm_title = "Ses yakalamaya izin verme veya reddetme";
AudioCaptureAllowed.pfm_description = "Politika, Etkin değerine ayarlanırsa veya ayarlanmadan bırakılırsa kullanıcılardan ses yakalama için erişim izni istenir (AudioCaptureAllowedUrls listesinde ayarlanan URL'ler hariç).\n\nPolitika, Devre dışı değerine ayarlanırsa istemler kapatılır ve ses yakalama yalnızca AudioCaptureAllowedUrls listesinde ayarlanan URL'ler tarafından kullanılabilir.\n\nNot: Bu politika, tüm ses girişlerini etkiler (yalnızca yerleşik mikrofonu değil).";
AudioCaptureAllowedUrls.pfm_title = "Soru sorulmadan ses yakalama cihazlarına erişim verilecek URL'ler";
AudioCaptureAllowedUrls.pfm_description = "Politikanın ayarlanması, kalıpları istek yapan URL'nin güvenlik kaynağıyla eşleşen URL listesini sizin belirttiğiniz anlamına gelir. Eşleşme olması halinde istemde bulunulmadan ses yakalama cihazlarına erişim izni verilir\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz. Ancak her URL'ye uyan \"*\" kalıbının bu politika tarafından desteklenmediğini unutmayın.";
AudioSandboxEnabled.pfm_title = "Sesli korumalı alanın çalışmasına izin ver";
AudioSandboxEnabled.pfm_description = "Bu politika, korumalı alana alınan ses işlemini kontrol eder.\nBu politika etkinleştirilirse ses işlemi korumalı alana alınmış olarak gerçekleştirilir.\nBu politika devre dışı bırakılırsa ses işlemi korumalı alana alınmadan gerçekleştirilir ve WebRTC ses işleme modülü, oluşturucu işleminde çalışır.\nBu durum kullanıcıları ses altsisteminin korumalı alana alınmadan çalıştırılmasıyla ilgili güvenlik risklerine açık hale getirir.\nBu politika ayarlanmazsa ses korumalı alanının varsayılan yapılandırması kullanılır. Bu yapılandırma platformdan platforma değişiklik gösterebilir.\nBu politika, korumalı alanın çalışmasını etkileyen güvenlik yazılımı yapılandırmaları kullanan işletmelere ses korumalı alanını devre dışı bırakma esnekliği sunmak amacıyla tasarlanmıştır.";
AuthNegotiateDelegateAllowlist.pfm_title = "Kerberos yetki sunucusu izin verilenler listesi";
AuthNegotiateDelegateAllowlist.pfm_description = "Politikayı ayarlamak Brave ürününün yetki verebileceği sunucular atar. Birden fazla sunucu adını virgülle ayırın. Joker karakterlere (*) izin verilir.\n\nPolitika ayarlanmadan bırakılırsa bir sunucunun intranet olduğu belirlense dahi Brave, kullanıcı kimlik bilgilerine yeki vermez.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Kimlik bilgilerine yetki vermek için KDC politikasını kullan.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Politika, Etkin değerine ayarlanırsa HTTP kimlik doğrulaması, KDC politikasının onayını dikkate alır. Yani, KDC hizmet biletini OK-AS-DELEGATE olarak ayarlarsa Brave, kullanıcı kimlik bilgileri için erişilen hizmeti yetkilendirir. RFC 5896 belgesine bakın ( https://tools.ietf.org/html/rfc5896.html ). Hizmete AuthNegotiateDelegateAllowlist tarafından da izin verilmelidir.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa KDC politikası, desteklenen platformlarda yok sayılır ve yalnızca AuthNegotiateDelegateAllowlist politikası dikkate alınır.\n\nMicrosoft® Windows® ürününde KDC politikası her zaman dikkate alınır.";
AuthSchemes.pfm_title = "Desteklenen kimlik doğrulama şemaları";
AuthSchemes.pfm_description = "Politikanın ayarlanması, Brave ürününün hangi HTTP kimlik doğrulama şemalarını desteklediğini belirtir.\n\nPolitika ayarlanmadan bırakılırsa 4 şemanın hepsi kullanılır.\n\nGeçerli değerler:\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nNot: Birden fazla değeri virgülle ayırın.";
AuthServerAllowlist.pfm_title = "Kimlik doğrulama sunucusu izin verilenler listesi";
AuthServerAllowlist.pfm_description = "Politikanın ayarlanması, entegre kimlik doğrulama için hangi sunuculara izin verileceğini belirtir. Entegre kimlik doğrulaması yalnızca Brave bir proxy veya söz konusu izin verilenler listesindeki bir sunucudan kimlik doğrulaması daveti aldığında etkinleşir.\n\nPolitika ayarlanmadan bırakılırsa Brave, sunucunun intranette olup olmadığını saptamaya çalışır. Yalnızca intranetteyse IWA isteklerini yanıtlar. Sunucunun internette olduğu saptanırsa sunucudan gelen IWA istekleri Brave tarafından yok sayılır.\n\nNot: Birden fazla sunucu adını virgülle ayırın. Joker karakterlere (*) izin verilir.";
AutoLaunchProtocolsFromOrigins.pfm_title = "Listelenen kaynaklardan kullanıcıya sormadan harici uygulama başlatabilecek protokollerin bir listesini tanımlayın";
AutoLaunchProtocolsFromOrigins.pfm_description = "Protokol listesi ayarlamanıza ve ayarladığınız her protokol için izin verilen kaynak kalıplarının ilişkilendirilmiş bir listesini oluşturmanıza izin verir. Bu kalıplar kullanıcıya sormadan harici bir uygulama başlatabilir. Protokol listelenirken sondaki ayırıcı dahil edilmemelidir, o yüzden listeye \"skype:\" ya da \"skype://\" yerine doğrudan \"skype\" olarak ekleyin.\n\nBu politika ayarlanırsa protokol, listelendiği ve protokolü başlatmaya çalışan sitenin kaynağı protokolün izin_verilen_kaynaklar listesindeki kaynak kalıplarından biriyle eşleştiği takdirde politika tarafından sorulmadan yalnızca harici uygulamaları başlatma iznine sahip olur. İki koşul da yanlış ise harici protokol başlatma istemi politika tarafından atlanmaz.\n\nBu politika ayarlı değilse protokoller istem olmadan varsayılan halde başlayamaz. ExternalProtocolDialogShowAlwaysOpenCheckbox politikası, devre dışı bırakılmadığı sürece kullanıcılar protokol/site bazında istemlerin kapsamı dışında kalmayı seçebilir. Bu politika, kullanıcıların ayarladığı protokol/site bazında istem muafiyetleri üzerinde etkili değildir.\n\nKaynakları eşleşen kalıplar, https://support.google.com/chrome/a?p=url_blocklist_filter_format adresinde bulabileceğiniz \"URLBlocklist\" politikasıyla benzer bir biçimi kullanır.\n\nFakat, bu politika için kaynakları eşleşen kalıplar \"/path\" ya da \"@query\" öğelerini içeremez. \"/path\" ya da \"@query\" öğelerini içeren kalıplar yoksayılacaktır.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins adresine bakın.";
AutoOpenAllowedForURLs.pfm_title = "AutoOpenFileTypes öğesinin uygulanabileceği URL'ler";
AutoOpenAllowedForURLs.pfm_description = "AutoOpenFileTypes politikasının hangi URL'lere uygulanacağını belirten URL'lerin listesi. Bu politikanın, kullanıcılar tarafından belirlenen otomatik olarak açık değerler üzerinde hiçbir etkisi yoktur.\n\nBu politika ayarlanırsa dosyalar yalnızca URL bu kümenin bir parçası olup dosya türü AutoOpenFileTypes öğesinde listeleniyorsa politikaya göre otomatik olarak açılır. İki koşuldan biri yanlışsa indirilen, politikaya göre otomatik olarak açılmaz.\n\nBu politika ayarlanmazsa AutoOpenFileTypes içinde bulunan dosya türündeki tüm indirilenler otomatik olarak açılır.\n\nURL kalıplarının, https://support.google.com/chrome/a?p=url_blocklist_filter_format adresinde belirtilen biçime uygun olması gerekir.";
AutoOpenFileTypes.pfm_title = "İndirildiğinde otomatik olarak açılması gereken dosya türleri listesi";
AutoOpenFileTypes.pfm_description = "İndirildiğinde otomatik olarak açılması gereken dosya türleri listesidir. Dosya türü listelenirken baştaki ayırıcının eklenmemesi gerektiğinden, \".txt\" yerine \"txt\" yazın.\n\nOtomatik olarak açılması gereken türdeki dosyalar, yine de etkinleştirilmiş güvenli tarama kontrollerine tabidir ve bu kontrollerden geçmezse açılmaz.\n\nBu politika ayarlanmazsa yalnızca kullanıcının otomatik olarak açılmasını zaten belirttiği dosya türleri indirildiğinde otomatik olarak açılır.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
AutoSelectCertificateForUrls.pfm_title = "Bu siteler için istemci sertifikalarını otomatik olarak seç";
AutoSelectCertificateForUrls.pfm_description = "Politikayı ayarlayarak, Chrome'un istemci sertifikası seçebileceği siteleri otomatik belirten URL kalıplarının listesini çıkarabilirsiniz. $URL_PATTERN içerik ayarı kalıbı olduğunda değer, her biri { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER } biçiminde dizili JSON sözlükleri dizisidir. $FILTER, tarayıcının otomatik seçtiği istemci sertifikalarını sınırlandırır. Filtreden bağımsız olarak, yalnızca sunucunun sertifika isteğiyle eşleşen sertifikalar seçilir. Chrome, Android ve iOS'de yalnızca kendi sağladığı istemci sertifikalarını seçebilir. İşletim sistemi düzeyinde yüklenen sertifikalara erişemez.\n\n$FILTER bölümünün kullanımına dair örnekler:\n\n* $FILTER değeri { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } } olarak ayarlandığında yalnızca CommonName $ISSUER_CN olan bir sertifikanın verdiği istemci sertifikaları seçilir.\n\n* $FILTER değeri hem \"ISSUER\" hem de \"SUBJECT\" bölümlerini içerdiğinde yalnızca iki koşulu da karşılayan istemci sertifikaları seçilir.\n\n* $FILTER değeri, \"O\" değeri olan bir \"SUBJECT\" bölümü içerdiğinde sertifika, seçilecek belirli değerle eşleşen en az bir kuruluş gerektirir.\n\n* $FILTER değeri, \"OU\" değeri olan bir \"SUBJECT\" bölümü içerdiğinde sertifika, seçilecek belirli değerle eşleşen en az bir kuruluş birimi gerektirir.\n\n* $FILTER değeri {} olarak ayarlandığında istemci sertifikalarının seçimi ayrıca kısıtlanmaz. Web sunucusu tarafından sağlanan filtrelerin geçerli olmaya devam ettiğini unutmayın.\n\nPolitikayı ayarlamadan bırakırsanız hiçbir site için otomatik seçim gerçekleşmez.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls adresine bakın.";
AutofillGenAiSettings.pfm_title = "Otomatik doldurmadaki üretken yapay zeka özellikleriyle ilgili ayarlar";
AutofillGenAiSettings.pfm_description = "0 - Otomatik doldurmada üretken yapay zeka özelliklerine izin ver ve yapay zeka modellerini daha iyi hale getir.\n1 - Yapay zeka modellerini daha iyi hale getirmeden otomatik doldurmada üretken yapay zeka özelliklerine izin ver\n2 - Otomatik doldurmada üretken yapay zeka özelliklerine izin verme.\nBrave içindeki bu özellikler, kullanıcıların web'deki formları doldurmasına yardımcı olmak için üretken yapay zeka modellerini kullanır. Bu özellikleri kullanabilmek için Brave, kullanıcının etkileşimde bulunduğu formların yapısı gibi verileri ve Gemini ile Bul ve Tamamla özelliğinde kullanıcının Gemini'a bağladığı uygulamalarda arama yapmak üzere girdiği serbest metin sorgularını toplamalı, bunları üretken yapay zeka modeli çalıştıran Google'a ait bir sunucuya göndermelidir.\n\nPolitika 0 (Otomatik doldurmada üretken yapay zeka özelliklerine izin ver ve yapay zeka modellerini daha iyi hale getir) değerine ayarlanırsa özellikler kullanılabilir ve Google, yapay zeka modellerini daha iyi hale getirmek için ilgili verileri kullanabilir. İlgili veriler arasında özelliğe bağlı olarak istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler yer alabilir. Aşağıdaki değerler belirtilmediği sürece varsayılan değer 0'dır.\n\nPolitika 1 (Yapay zeka modellerini daha iyi hale getirmeden otomatik doldurmada üretken yapay zeka özelliklerine izin ver) değerine ayarlanırsa özellikler kullanılabilir ancak Google, kullanıcıların içeriklerini (istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler dahil) modellerini daha iyi hale getirmek için kullanamaz. Google Admin console tarafından yönetilen kurumsal kullanıcılar ve Google Workspace tarafından yönetilen eğitim hesapları için varsayılan değer 1'dir.\n\nPolitika 2 (Otomatik doldurmada üretken yapay zeka özelliklerine izin verme) değerine ayarlanırsa bu özellikler kullanılamaz.\n\nPolitika ayarlanmadığında davranışı GenAiDefaultSettings politikası belirler.\n\nOtomatik doldurmadaki üretken yapay zeka özellikleri şunlardır:\n\n- Akıllı form anlama: Bir formdaki alanları tanımlamak ve sınıflandırmak için yapay zeka kullanır. Böylece daha fazla alan doldurulabilir.\n\n- Gemini ile Bul ve Tamamla: Kullanıcının Gemini'a bağladığı uygulamalardaki bilgileri bulur ve bunları form doldurmak için formda proaktif öneriler olarak veya kullanıcının yazdığı sorguya yanıt olarak sunar.\n\nBu politika, AutofillPredictionSettings politikasının yerini alır ancak ayarlanmazsa söz konusu politika geçerli olmaya devam eder. \"Gemini ile Bul ve Tamamla\" özelliğinin kullanılabilmesi için GeminiSettings politikasının da devre dışı bırakılmaması gerekir.\n\nBu politika, üretken yapay zeka kullanmayan otomatik doldurma özelliklerini kontrol etmez.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
AutofillSettings.pfm_title = "Belirli siteler için otomatik doldurma veri türlerini engelleme";
AutofillSettings.pfm_description = "Bu politika ayarlandığında belirli URL kalıplarında hangi otomatik doldurma veri türlerinin engelleneceğini belirleyebilirsiniz.\n\nPolitika, sözlük listesi olarak yapılandırılmıştır. Her sözlük şu öğeleri içermelidir:\n* \"url_pattern\": Ana çerçeve için içerik ayarı URL kalıbı (ör. \"https://[*.]example.com\").\n* \"blocked_types\": Engellenecek otomatik doldurma verisi kategorilerini temsil eden dize listesi.\n\n\"blocked_types\" için desteklenen değerler:\n* \"contact_info\": İletişim bilgilerinin doldurulmasını ve kaydedilmesini engeller.\n* \"payments\": Kredi kartlarının ve ödeme yöntemlerinin doldurulmasını ve kaydedilmesini engeller.\n* \"identity_docs\": Kimlik belgelerinin (ör. pasaport, sürücü belgesi, nüfus cüzdanı) doldurulmasını ve kaydedilmesini engeller.\n* \"travel\": Seyahat bilgilerinin (ör. uçuş rezervasyonu, araç kaydı) doldurulmasını ve kaydedilmesini engeller.\n* \"shopping\": Alışveriş bilgilerinin (ör. online siparişler, kargolar) doldurulmasını ve kaydedilmesini engeller.\n* \"all\": Tüm otomatik doldurma veri türlerinin doldurulmasını ve kaydedilmesini engeller.\n\nBir veri türü belirli bir site için engellenirse bu sitede hem önerilerin oluşturulması hem de bu türdeki yeni verilerin kaydedilmesi/içe aktarılması istemi devre dışı bırakılır.\n\nBir URL, listedeki birden fazla kalıp girişiyle eşleşirse, eşleşen tüm girişlerdeki engellenen türler birleştirilir (birleştirme-tekilleştirme). Listedeki geçersiz URL kalıpları yoksayılır.\n\nBu politika ayarlanmazsa hiçbir otomatik doldurma veri türü alan adına göre engellenmez.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakter * desteklenir. Bu kalıp; şeması, bağlantı noktası ve yolu ne olursa olsun tüm URL'lerle eşleşir.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=AutofillSettings adresine bakın.";
AutomatedPasswordChangeSettings.pfm_title = "Otomatik şifre değişikliğini etkinleştir";
AutomatedPasswordChangeSettings.pfm_description = "0 - Özelliğin kullanılmasına ve yapay zeka modellerinin iyileştirilmesine izin ver\n1 - Yapay zeka modellerini iyileştirmeden özelliğin kullanılmasına izin ver\n2 - Özelliğe izin verme\nBu politika, Brave uygulamasına ait otomatik şifre değiştirme özelliğinin kullanılabilirliğini kontrol eder.\n\nEtkinleştirilirse kullanıcı, bir web sitesindeki şifresinin tarayıcı tarafından otomatik olarak değiştirilmesi işlemini tetikleyebilir. Bu işlem üretken yapay zeka tarafından yönetilir. Yeni şifre, tarayıcının şifre yöneticisine kaydedilir.\n\n0 = Özelliğin kullanılmasına izin verirken Google'ın yapay zeka modellerini iyileştirmek için ilgili verileri kullanmasına izin verir. İlgili veriler arasında özelliğe bağlı olarak istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler yer alabilir. Bu bilgiler, gerçek kişiler tarafından da yapay zeka modellerini iyileştirmek için incelenebilir. Aşağıdaki değerler belirtilmediği sürece varsayılan değer 0'dır.\n\n1 = Özelliğin kullanılmasına izin verir ancak Google'ın kullanıcıların içeriklerini (istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler dahil) kullanarak modelleri iyileştirmesine izin vermez. Google Yönetici Konsolu tarafından yönetilen kurumsal kullanıcılar ve Google Workspace tarafından yönetilen Education hesapları için varsayılan değer 1'dir.\n\n2 = Özelliğe izin vermez.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Bu sitelerde otomatik indirmeye izin verme";
AutomaticDownloadsAllowedForUrls.pfm_description = "Birden fazla dosyayı otomatik olarak indirmesine izin verilen siteleri belirten URL kalıpları listesini ayarlamanıza olanak tanır.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.\n\nBir URL hem AutomaticDownloadsAllowedForUrls hem de AutomaticDownloadsBlockedForUrls ile eşleşirse AutomaticDownloadsBlockedForUrls öncelikli olur.\n\nBu politika ayarlanmazsa DefaultAutomaticDownloadsSetting, ayarlanması koşuluyla tüm siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Bu sitelerde otomatik indirmeleri engelleme";
AutomaticDownloadsBlockedForUrls.pfm_description = "Birden fazla dosyayı otomatik olarak indirmesine izin verilmeyen siteleri belirten URL kalıpları listesini ayarlamanıza olanak tanır.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.\n\nBir URL hem AutomaticDownloadsAllowedForUrls hem de AutomaticDownloadsBlockedForUrls ile eşleşirse AutomaticDownloadsBlockedForUrls öncelikli olur.\n\nBu politika ayarlanmazsa DefaultAutomaticDownloadsSetting, ayarlanması koşuluyla tüm siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Bu sitelerde otomatik olarak tam ekrana geçilmesine izin ver";
AutomaticFullscreenAllowedForUrls.pfm_description = "requestFullscreen() web API, güvenlik nedenleriyle önceki kullanıcı hareketinin (\"geçici etkinleştirme\") çağrılmasını zorunlu kılar ve çağrılmadığı takdirde başarısız olur. Kullanıcının kişisel ayarları doğrultusunda, https://chromestatus.com/feature/6218822004768768 adresinde açıklandığı üzere önceki kullanıcı hareketi olmasa da belirli kaynakların bu API'yi çağırmasına izin verilebilir.\n\nBu politika, kullanıcının kişisel ayarlarını geçersiz kılar ve eşleşen kaynakların önceki kullanıcı hareketi olmadan API'yi çağırmasına izin verir.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için\nhttps://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz.\nJoker karakterlere (*) izin verilir.\n\nHem engellenen hem de izin verilen politika kalıplarıyla eşleşen kaynaklar engellenir.\nPolitika veya kullanıcı ayarları tarafından belirtilmeyen kaynakların bu API'yi çağırması için kullanıcı hareketinin olması gerekir.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Bu sitelerde otomatik olarak tam ekrana geçişi engelle";
AutomaticFullscreenBlockedForUrls.pfm_description = "requestFullscreen() web API, güvenlik nedenleriyle önceki kullanıcı hareketinin (\"geçici etkinleştirme\") çağrılmasını zorunlu kılar ve çağrılmadığı takdirde başarısız olur. Kullanıcının kişisel ayarları doğrultusunda, https://chromestatus.com/feature/6218822004768768 adresinde açıklandığı üzere önceki kullanıcı hareketi olmasa da belirli kaynakların bu API'yi çağırmasına izin verilebilir.\n\nBu politika, kullanıcının kişisel ayarlarını geçersiz kılar ve eşleşen kaynakların önceki kullanıcı hareketi olmadan API'yi çağırmasını engeller.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için\nhttps://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz.\nJoker karakterlere (*) izin verilir.\n\nHem engellenen hem de izin verilen politika kalıplarıyla eşleşen kaynaklar engellenir.\nPolitika veya kullanıcı ayarları tarafından belirtilmeyen kaynakların bu API'yi çağırması için kullanıcı hareketinin olması gerekir.";
AutoplayAllowed.pfm_title = "Medyayı otomatik oynatmaya izin ver";
AutoplayAllowed.pfm_description = "Politikayı Doğru değerine ayarlarsanız Brave medyayı otomatik oynatır. Politikayı Yanlış değerine ayarlarsanız Brave ürününün otomatik medya oynatması durdurulur.\n\nBu politika ayarlanmadan bırakılırsa Brave medyayı otomatik olarak oynatmaz. Ancak belirli URL kalıplarında bu ayarı değiştirmek için AutoplayAllowlist politikasını kullanabilirsiniz.\n\nBrave çalışırken bu politika değiştirilirse bu değişiklik sadece yeni açılan sekmeler için geçerli olur.";
AutoplayAllowlist.pfm_title = "URL kalıpları izin verilenler listesinde medyanın otomatik olarak oynatılmasına izin ver";
AutoplayAllowlist.pfm_description = "Politikayı ayarladığınızda Brave ürününde sesli videolar otomatik (kullanıcı onayı olmadan) oynatılır. AutoplayAllowed Doğru değerine ayarlandığında bu politika geçerliliğini yitirir. AutoplayAllowed Yanlış değerine ayarlandığında bu politikadaki URL kalıpları oynatılabilir. Brave çalışırken bu politika değiştirilirse sadece yeni açılan sekmelere uygulanır.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.";
BackgroundTabFreezingEnabled.pfm_title = "Arka planda sekme dondurmayı etkinleştir";
BackgroundTabFreezingEnabled.pfm_description = "Brave hizmetinin, CPU ve bellek tasarrufu yapmak için etkin olmayan arka plan sekmelerini dondurup dondurmayacağını kontrol eder.\n\nArka planda sekme dondurma etkin olduğunda, arka planda bir süre boyunca etkin olmayan sekmeler, JavaScript yürütme ve zamanlayıcı görevleri duraklatılarak dondurulur. Dondurulan sekmeler bellekte yüklü kalır ve kullanıcı tarafından seçildiğinde anında devam eder. Etkin arka plan görevleri olan sekmeler (ör. ses veya video oynatan, ekran ya da kamera görüntü akışlarını yakalayan, etkin WebRTC bağlantılarını sürdüren veya Web Locks'u tutan sekmeler) dondurulamaz ve çalışmaya devam eder. TabDiscardingExceptions politikasında veya kullanıcının sekme silme istisnalarında yapılandırılan siteler de dondurma işleminden muaf tutulur.\n\nPolitika, Etkin değerine ayarlanırsa uygun arka plan sekmeleri için otomatik arka plan sekmesi dondurma özelliği etkinleştirilir. Kullanıcılar bu ayarı değiştiremez.\n\nPolitika, Devre Dışı değerine ayarlanırsa arka plan sekmelerinin dondurulması engellenir. Kullanıcılar bu ayarı değiştiremez.\n\nPolitika ayarlanmazsa arka plan sekmesini dondurma özelliği varsayılan olarak etkinleştirilir ancak kullanıcılar bu özelliği Brave ayarlarından açıp kapatabilir.";
BasicAuthOverHttpEnabled.pfm_title = "HTTP için Basic kimlik doğrulamasına izin ver";
BasicAuthOverHttpEnabled.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Basic kimlik doğrulama davetlerinin güvenli olmayan HTTP üzerinden alınmasına izin verir.\n\nPolitika, Devre Dışı değerine ayarlanırsa güvenli olmayan HTTP isteklerinin Basic kimlik doğrulama düzenini kullanmasına verilmez. Yalnızca güvenli HTTPS'ye izin verilir\n\nAuthSchemes politikası ayarlanırsa ve Basic içermiyorsa bu politika ayarı yok sayılır (ve Basic her zaman yasaklanır).";
BatterySaverModeAvailability.pfm_title = "Pil Tasarrufu Modu'nu etkinleştir";
BatterySaverModeAvailability.pfm_description = "0 - Pil Tasarrufu Modu devre dışı bırakılır.\n1 - Cihaz pil gücüyle çalışırken ve pil seviyesi düşük olduğunda Pil Tasarrufu Modu etkinleştirilir.\n2 - Bu değerin desteği, M121 sürümünden itibaren sonlandırılmıştır. Değerler, M121 ve sonraki sürümlerde EnabledBelowThreshold olarak kabul edilir.\nBu politika, Pil Tasarrufu Modu ayarını etkinleştirir veya devre dışı bırakır.\nChrome'da bu ayar, güç tüketimini azaltmak için kare hızının kısıtlanmasını sağlar. Bu politika ayarlanmazsa son kullanıcı bu ayarı chrome://settings/performance bölümünden kontrol edebilir.\nChromeOS'te bu ayar, kare hızının ve CPU frekansının kısıtlanmasını, arka ışıkların kısılmasını ve Android'in, Pil Tasarrufu Modu'na alınmasını sağlar. Birden fazla CPU'su olan cihazlarda bazı CPU'lar kapatılır.\nFarklı düzeyler şunlardır:\nDisabled (0): Pil Tasarrufu Modu devre dışı bırakılır.\nEnabledBelowThreshold (1): Cihaz pil gücüyle çalışırken ve pil seviyesi düşük olduğunda Pil Tasarrufu Modu etkinleştirilir.\nEnabledOnBattery (2): Bu değerin desteği, M121 sürümünden itibaren sonlandırılmıştır. Değerler, M121 sürümünden itibaren EnabledBelowThreshold olarak kabul edilir.\n";
BlockExternalExtensions.pfm_title = "Harici uzantıların yüklenmesini engeller";
BlockExternalExtensions.pfm_description = "Harici uzantıların yüklenmesini kontrol eder.\n\nBu politika Etkin değerine ayarlanırsa harici uzantıların yüklenmesi engellenir.\n\nBu politika Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa harici uzantılar yüklenebilir.\n\nHarici uzantılar ve bu uzantıları yüklemeyle ilgili bilgiyi https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions adresinde bulabilirsiniz.\n\nNot: Bu politika yalnızca uzantıları destekleyen platformlarda geçerlidir.";
BlockThirdPartyCookies.pfm_title = "Üçüncü taraf çerezlerini engelle";
BlockThirdPartyCookies.pfm_description = "Politikanın Etkin değerine ayarlanması tarayıcının adres çubuğundaki alan adına ait olmayan web sayfası öğelerinin çerez yerleştirmesini engeller. Politikanın Devre Dışı değerine ayarlanması bu öğelerin çerez yerleştirmesine izin verir ve kullanıcıların bu ayarı değiştirmelerini önler.\n\nPolitika ayarlanmadan bırakılırsa üçüncü taraf çerezlerine izin verilir ancak kullanıcılar bu ayarı değiştirebilir.\n\nNot: Bu politika, üçüncü taraf çerezlerinin engellendiği ve yalnızca site düzeyinde izin verilebileceği Gizli modda geçerli değildir. Site düzeyinde çerezlere izin vermek için CookiesAllowedForUrls politikasını kullanın.";
BookmarkBarEnabled.pfm_title = "Yer İşareti Çubuğunu etkinleştir";
BookmarkBarEnabled.pfm_description = "Politikayı True (Doğru) değerine ayarlamak, Brave ürününde yer işareti çubuğunu görüntüler. Politikayı False (Yanlış) değerine ayarlamak, kullanıcıların yer işareti çubuğunu hiçbir zaman görmeyecekleri anlamına gelir.\n\nBu politikayı ayarlarsanız kullanıcılar değiştiremez. Ayarlanmazsa bu işlevi kullanıp kullanmamaya kullanıcılar karar verir.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "Kullanıcı yöneticisinde kişi eklemeyi etkinleştir";
BrowserAddPersonEnabled.pfm_description = "Bu politika, Doğru değerine ayarlanırsa veya yapılandırılmazsa Brave ve Lacros, kullanıcı yöneticisinden yeni bir kişi eklemeye izin verir.\n\nBu politika, Yanlış değerine ayarlanırsa Brave ve Lacros, kullanıcı yöneticisinden yeni bir kişi eklemeye izin vermez.";
BrowserGuestModeEnabled.pfm_title = "Tarayıcıda misafir modunu etkinleştir";
BrowserGuestModeEnabled.pfm_description = "Bu politika, Etkin değerine ayarlanırsa veya yapılandırılmazsa Brave, misafir girişlerini etkinleştirir. Misafir girişleri, tüm pencerelerin gizli modda olduğu Brave profilleridir.\n\nBu politika, Devre Dışı değerine ayarlanırsa Brave, misafir profillerinin başlatılmasına izin vermez.";
BrowserGuestModeEnforced.pfm_title = "Tarayıcı misafir modunu zorunlu tut";
BrowserGuestModeEnforced.pfm_description = "Politika, Etkin değerine ayarlanırsa Brave, misafir oturumunu zorunlu kılıp profil ile oturum açma işlemlerini engeller. Misafir oturumları, tüm pencerelerin gizli modda olduğu Brave profilleridir.\n\nPolitika, Devre Dışı değerine ayarlanır, ayarlanmadan bırakılır veya tarayıcı Misafir Modu devre dışı bırakılırsa (BrowserGuestModeEnabled politikasıyla) yeni ve mevcut profiller kullanılabilir.";
BrowserLabsEnabled.pfm_title = "Araç çubuğundaki tarayıcı deneyleri simgesi";
BrowserLabsEnabled.pfm_description = "Politika Etkin değerine ayarlanırsa veya ayarlanmadan bırakılırsa kullanıcılar, araç çubuğundaki bir simge aracılığıyla tarayıcı deneysel özelliklerine erişebilirler\n\nPolitika Devre Dışı değerine ayarlanırsa tarayıcı deneysel özellikler simgesi araç çubuğundan kaldırılır.\n\nchrome://flags ve tarayıcı özelliklerini açıp kapatmak için kullanılan herhangi başka bir yöntem, bu politikanın Etkin ya da Devre Dışı olmasından bağımsız olarak, beklendiği şekilde davranacaktır.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Google zaman hizmetini sorgulamaya izin ver";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, doğru zaman damgası almak için bir Google sunucusuna ara sıra sorgu gönderir.\n\nPolitika, Devre Dışı değerine ayarlanırsa Brave, bu sorguları göndermez.";
BrowserSignin.pfm_title = "Tarayıcı oturum açma ayarları";
BrowserSignin.pfm_description = "0 - Tarayıcıda oturum açmayı devre dışı bırak\n1 - Tarayıcıda oturum açmayı etkinleştir\n2 - Tarayıcıyı kullanabilmeleri için kullanıcıları oturum açmaya zorla\nBu politika, tarayıcının oturum açma davranışını denetler. Kullanıcının hesabıyla Brave üzerinde oturum açıp açamayacağını ve Brave Senkronizasyonu gibi hesapla alakalı hizmetleri kullanıp kullanamayacağını belirtmenize olanak tanır.\n\nPolitika \"Tarayıcıda oturum açmayı devre dışı bırak\" olarak ayarlanmışsa kullanıcı tarayıcıda oturum açamaz ve hesaba dayalı hizmetleri kullanamaz. Bu durumda, Brave Senkronizasyonu gibi tarayıcı seviyesindeki özellikler kullanılamaz. iOS platformunda kullanıcının oturumu açıksa ve politika \"Devre dışı\" olarak ayarlanmışsa oturumları hemen kapatılır. Diğer platformlarda Brave tarayıcısını tekrar çalıştırdıklarında oturumları kapatılır. Tüm platformlarda yer işaretleri ve şifreler gibi profil verileri halen kullanılabilir bir şekilde saklanır. Kullanıcı, Gmail gibi Google web hizmetlerinde oturum açarak bunları kullanmaya devam edebilir.\n\nPolitika \"Tarayıcıda oturum açmayı etkinleştir\" olarak ayarlanırsa kullanıcı tarayıcıda oturum açabilir. iOS dışındaki tüm platformlarda kullanıcı, Gmail gibi Google web hizmetlerinde oturum açtığında otomatik olarak tarayıcıda oturum açmış olur. Tarayıcıda oturum açmak demek, kullanıcının hesap bilgilerinin tarayıcı tarafından saklanması demektir. Ancak bu, Brave Senkronizasyonu'nun varsayılan olarak açılacağı anlamına gelmez. Kullanıcının bu özelliği kullanabilmesi için ayrıca kaydolması gerekir. Bu politikanın etkinleştirilmesi kullanıcının tarayıcıda oturum açmaya imkan tanıyan ayarı kapatmasını engelleyecektir. Brave Senkronizasyonu'nun kullanılabilirliğini denetlemek için SyncDisabled politikasını kullanın.\n\nPolitika \"Tarayıcıda oturum açmaya zorla\" olarak ayarlanmışsa kullanıcıya bir hesap seçimi iletişim kutusu sunulur. Tarayıcıyı kullanmak için kullanıcının bir hesap seçmesi ve bu hesapta oturum açması gerekir. Bu sayede, yönetilen hesaplarda hesapla ilişkili politikalar uygulanır ve zorunlu tutulur. BrowserGuestModeEnabled politikasının varsayılan değeri devre dışı olarak ayarlanır. Bu politika etkinleştirildikten sonra mevcut imzasız profillerin kilitleneceğini ve erişilemez hale geleceğini unutmayın. Daha fazla bilgi edinmek için https://support.google.com/chrome/?p=force_browser_signin adresindeki Yardım Merkezi makalesine bakın. Bu seçenek Google Chrome OS ve Android platformlarında desteklenmez. Kullanılması halinde \"Tarayıcıda oturum açmayı etkinleştir\" ayarına döner.\n\nBu politika ayarlanmazsa kullanıcı Brave ayarlarında tarayıcıda oturum açmayı etkinleştirmeyle ilgili tercih yapabilir ve bunu uygun gördüğü şekilde kullanabilir.";
BrowserSwitcherDelay.pfm_title = "Alternatif tarayıcı açılmadan önce geçecek süre (milisaniye)";
BrowserSwitcherDelay.pfm_description = "Bu politika bir sayıya ayarlanırsa Brave, ayarlanan milisaniye süresince bir mesaj görüntüler, ardından alternatif tarayıcıyı açar.\n\nBu politika ayarlanmadan bırakılırsa veya 0 değerine ayarlanırsa tanımlanan bir URL'ye gidildiğinde URL hemen alternatif tarayıcıda açılır.";
BrowserSwitcherEnabled.pfm_title = "Eski Tarayıcı Desteği özelliğini etkinleştir.";
BrowserSwitcherEnabled.pfm_description = "Politika Etkin değerine ayarlanırsa Brave bazı URL'leri alternatif bir tarayıcıda (ör. Internet Explorer®) açmaya çalışır. Bu özellik, Legacy Browser support grubundaki politikalar kullanılarak ayarlanır.\n\nPolitika Devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, tanımlanan URL'leri alternatif tarayıcıda açmaya çalışmaz.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "Hiçbir zaman bir tarayıcı anahtarını tetiklememesi gereken URL'ler içeren bir XML dosyasının URL'si.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Politika geçerli bir URL'ye ayarlanırsa Brave, site listesini o URL'den indirir ve kuralları, BrowserSwitcherUrlGreylist politikasıyla yapılandırılmışlar gibi uygular. Bu politikalar Brave ve alternatif tarayıcının birbirini açmasını engeller.\n\nPolitika ayarlanmadan bırakılırsa (veya geçersiz bir URL'ye ayarlanırsa) Brave, politikayı tarayıcılar arasında geçiş yapmamak için bir kural kaynağı olarak kullanmaz.\n\nNot: Bu politika, Internet Explorer® tarayıcısının SiteList politikasıyla aynı biçimde bir XML dosyasına yönlendirir. Bu politika, bir XML dosyasından kurallar yükler, ancak bu kuralları Internet Explorer® ile paylaşmaz. Internet Explorer® tarayıcısının SiteList politikası hakkında daha fazla bilgi edinin ( https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode )";
BrowserSwitcherExternalSitelistUrl.pfm_title = "Alternatif bir tarayıcıda yüklenecek URL'leri içeren bir XML dosyasının URL'si.";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Politika geçerli bir URL'ye ayarlanırsa Brave, site listesini o URL'den indirir ve kuralları, BrowserSwitcherUrlList politikasıyla yapılandırılmışlar gibi uygular.\n\nPolitika ayarlanmadan bırakılırsa (veya geçersiz bir URL'ye ayarlanırsa) Brave, politikayı tarayıcılar arasında geçiş yapmak için bir kural kaynağı olarak kullanmaz.\n\nNot: Bu politika, Internet Explorer® tarayıcısının SiteList politikasıyla aynı biçimde bir XML dosyasına yönlendirir. Bu politika, bir XML dosyasından kurallar yükler, ancak bu kuralları Internet Explorer® ile paylaşmaz. Internet Explorer® tarayıcısının SiteList politikası hakkında daha fazla bilgi edinin ( https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Chrome'da son sekmeyi açık tut.";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, alternatif tarayıcıya geçtikten sonra en az bir sekmeyi açık tutar.\n\nPolitika, Devre dışı değerine ayarlanırsa alternatif tarayıcıya son sekmeden geçilmiş olsa bile Brave o sekmeyi kapatır. Bu da Brave tarayıcısının tamamen çıkış yapmasına neden olur.";
BrowserSwitcherParsingMode.pfm_title = "Site listesi ayrıştırma modu";
BrowserSwitcherParsingMode.pfm_description = "0 - Eski Tarayıcı Desteği için varsayılan davranış.\n1 - Microsoft IE/Edge kurumsal mod site listeleriyle daha uyumlu.\nBu politika, Google Chrome ürününün, Eski Tarayıcı Desteği özelliğinin site listesi/gri liste politikalarını nasıl yorumladığını kontrol eder. Şu politikaları etkiler: BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl ve BrowserSwitcherExternalGreylistUrl.\n\n\"Varsayılan\", (0) değerine ayarlanırsa veya ayarlanmazsa URL eşleşmesi daha az katı kurallı olur. \"/\" karakterini içermeyen kurallar, URL'nin ana makine adının herhangi bir yerinde alt dize arar. URL yol bileşeninin eşleşmesi büyük/küçük harfe duyarlıdır.\n\n\"IESiteListMode\", (1) değerine ayarlanırsa URL eşleşmesi daha katı kurallı olur. \"/\" karakterini içermeyen kurallar, yalnızca ana makine adının sonunda eşleşir. Alan adı sınırında da bulunmaları gerekir. URL yol bileşeninin eşleşmesi büyük/küçük harfe duyarlı değildir. Bu, Microsoft® Internet Explorer® ve Microsoft® Edge® ile daha uyumludur.\n\nÖrneğin, \"example.com\" ve \"acme.com/abc\" kurallarıyla:\n\n\"http://example.com/\", \"http://subdomain.example.com/\" ve \"http://acme.com/abc\" URL'leri, ayrıştırma modundan bağımsız olarak eşleşir.\n\n\"http://notexample.com/\", \"http://example.com.invalid.com/\" ve \"http://example.comabc/\" yalnızca \"Varsayılan\" modda eşleşir.\n\n\"http://acme.com/ABC\" yalnızca \"IESiteListMode\" modunda eşleşir.";
BrowserSwitcherUrlGreylist.pfm_title = "Hiçbir zaman başka bir tarayıcıya geçişi tetiklememesi gereken web siteleri.";
BrowserSwitcherUrlGreylist.pfm_description = "Bu politika, hiçbir zaman tarayıcı geçişine neden olmayacak web sitelerinin listesini kontrol eder. Her öğe bir kural olarak ele alınır. Eşleşen kurallar alternatif bir tarayıcı açmaz. BrowserSwitcherUrlList politikasından farklı olarak, kurallar her iki yönde de uygulanır. Internet Explorer® eklentisi etkinse aynı zamanda Internet Explorer® tarayıcısının bu URL'leri Brave ile açıp açmayacağını da kontrol eder.\n\nPolitika ayarlanmadan bırakılırsa web siteleri listeye eklenmez.\n\nNot: Bu listeye BrowserSwitcherExternalGreylistUrl politikası aracılığıyla öğeler eklenebileceğini de unutmayın.";
BrowserSwitcherUrlList.pfm_title = "Alternatif tarayıcıda açılacak web siteleri";
BrowserSwitcherUrlList.pfm_description = "Bu politika, alternatif tarayıcıda açılacak web sitelerinin listesini kontrol eder. Her öğe, bir şeyin alternatif tarayıcıda açılması için bir kural olarak değerlendirilir. Brave, bir URL'nin alternatif tarayıcıda açılıp açılmayacağını belirlerken bu kuralları kullanır. Internet Explorer® eklentisi etkinken, kurallar eşleşmediğinde Internet Explorer® tekrar Brave tarayıcısına geçiş yapar. Kurallar birbiriyle çelişirse Brave en ayrıntılı kuralı kullanır.\n\nPolitika ayarlanmadan bırakılırsa web siteleri listeye eklenmez.\n\nNot: Bu listeye BrowserSwitcherUseIeSitelist ve BrowserSwitcherExternalSitelistUrl politikaları aracılığıyla öğeler eklenebileceğini de unutmayın.";
BrowserThemeColor.pfm_title = "Tarayıcı temasının rengini yapılandır";
BrowserThemeColor.pfm_description = "Bu politika, yöneticilere Brave temasının rengini yapılandırma imkanı tanır. Giriş dizesi, \"#RRGGBB\" biçimine uygun geçerli bir onaltılık renk dizesi olmalıdır.\n\nBu politika geçerli bir onaltılık renge ayarlanırsa otomatik olarak o renge dayalı bir tema oluşturularak tarayıcıya uygulanır. Kullanıcılar, politika tarafından ayarlanan temayı değiştiremez.\n\nBu politika ayarlanmadan bırakılırsa kullanıcılar tarayıcılarının temasını istedikleri gibi değiştirebilir.";
BrowsingDataLifetime.pfm_title = "Tarama Verisi Geçerlilik Süresi Ayarları";
BrowsingDataLifetime.pfm_description = "Brave için tarama verisi geçerlilik süresi ayarlarını yapılandırır. Bu politika, veriler tarayıcı tarafından silindiğinde yöneticilerin yapılandırmasına (veri türü başına) izin verir. Bu özellik, hassas verilerle çalışan müşteriler için kullanışlıdır.\n\nUyarı: Bu politikanın ayarlanması, yerel kişisel verileri etkileyebilir ve kalıcı olarak silebilir. Kişisel verilerin yanlışlıkla silinmesini önlemek için dağıtmadan önce ayarlarınızı test etmeniz önerilir.\n\nKullanılabilir veri türleri şunlardır: 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' ve 'hosted_app_data'. 'download_history' ve 'hosted_app_data', Android'de desteklenmez.\n\nTarayıcı, 'time_to_live_in_hours' saatten daha eski olan seçili veri türlerini otomatik olarak kaldırır. Ayarlanabilecek minimum değer 1 saattir.\n\nSüresi dolan verilerin silinme işlemi, tarayıcı başlatıldıktan 15 saniye sonra gerçekleşir, ardından tarayıcı çalıştığı sürece 30 dakikada bir tekrarlanır.\n\nKullanıcı, çerezleri sildiğinde Google Hesabı oturumu açık kalır.\n\nBu politika, Chrome 114 sürümüne kadar SyncDisabled politikasının doğru değerine ayarlanmasını gerektiriyordu. Chrome 115 sürümünden itibaren SyncDisabled politikası ayarlanarak \"Chrome Sync\" devre dışı bırakılmadığı veya BrowserSignin devre dışı olmadığı sürece, bu politika ayarlandığında ilgili veri türleri için senkronizasyon devre dışı bırakılır.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime adresine bakın.";
BuiltInAIAPIsEnabled.pfm_title = "Sayfaların yerleşik yapay zeka API'lerini kullanmasına izin ver.";
BuiltInAIAPIsEnabled.pfm_description = "Bu politika, bir sayfanın yerleşik yapay zeka API'lerini (ör. LanguageModel API, Summarization API, Writer API ve Rewriter API) kullanıp kullanamayacağını kontrol eder.\n\nPolitika etkinleştirilirse veya ayarlanmazsa API'lerin kullanımı etkinleştirilir.\n\nPolitika devre dışı bırakılırsa API'leri kullanmaya çalışmak hata verir.";
BuiltInDnsClientEnabled.pfm_title = "Dahili DNS istemcisini kullan";
BuiltInDnsClientEnabled.pfm_description = "Bu politika, DNS sunucusuyla iletişim kurmak için hangi yazılım yığınının kullanıldığını kontrol eder: İşletim Sistemi DNS istemcisi veya Brave ürününün yerleşik DNS istemcisi. Bu politika hangi DNS sunucularının kullanıldığını etkilemez: Örneğin, işletim sistemi kurumsal DNS sunucusu kullanacak şekilde yapılandırılmışsa aynı sunucu, yerleşik DNS istemcisi tarafından da kullanılır. Ayrıca DNS-over-HTTPS kullanılıp kullanılmadığını da kontrol etmez; Brave, DNS-over-HTTPS istekleri için her zaman yerleşik çözümleyici kullanır. DNS-over-HTTPS'nin kontrolüyle ilgili bilgi için DnsOverHttpsMode politikasına bakın.\n\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa yerleşik DNS istemcisi kullanılır.\n\nBu politika, Devre Dışı değerine ayarlanırsa yerleşik DNS istemcisi yalnızca DNS-over-HTTPS kullanımdayken kullanılır.";
CACertificateManagementAllowed.pfm_title = "Kullanıcıların yüklü CA sertifikalarını yönetmelerine izin ver.";
CACertificateManagementAllowed.pfm_description = "0 - Kullanıcıların tüm sertifikaları yönetmelerine izin ver\n1 - Kullanıcıların, kullanıcı sertifikalarını yönetmelerine izin ver\n2 - Kullanıcıların sertifikaları yönetmelerine izin verme\nPolitika, Tümü (0) değerine ayarlanırsa veya ayarlanmadan bırakılırsa kullanıcılar, tüm CA sertifikaları için güven ayarlarını düzenleyebilir, kullanıcının içe aktardığı sertifikaları kaldırabilir ve başka sertifikaları içe aktarabilirler. Politika, Yalnızca Kullanıcı (1) değerine ayarlanırsa kullanıcılar, yalnızca kullanıcının içe aktardığı sertifikaları yönetebilir, ancak yerleşik sertifikaların güven ayarlarını değiştiremezler. Politika, Yok (2) değerine ayarlanırsa kullanıcılar, CA sertifikalarını görüntüleyebilirler (yönetemezler).";
CACertificates.pfm_title = "Sunucu kimlik doğrulaması için Brave tarafından güvenilmesi gereken TLS sertifikaları";
CACertificates.pfm_description = "Sunucu kimlik doğrulaması için Brave tarafından güvenilmesi gereken TLS sertifikalarının listesi.\nSertifikalar, base64 kodlu olmalıdır.";
CACertificatesWithConstraints.pfm_title = "Kısıtlamalarla sunucu kimlik doğrulaması için Brave tarafından güvenilmesi gereken TLS sertifikaları";
CACertificatesWithConstraints.pfm_description = "Sertifika dışında eklenen kısıtlamalarla, sunucu kimlik doğrulaması için Brave tarafından güvenilmesi gereken TLS sertifikalarının listesi. Belirli türden bir kısıtlama bulunmadığında ilgili türdeki tüm adlara izin verilir.\nSertifikalar, base64 kodlu olmalıdır. Her sertifika için en az bir kısıtlama belirtilmelidir.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints adresine bakın.";
CADistrustedCertificates.pfm_title = "Sunucu kimlik doğrulaması için Brave tarafından güvenilmemesi gereken TLS sertifikaları";
CADistrustedCertificates.pfm_description = "TLS sunucu kimlik doğrulaması için Brave tarafından güvenilmemesi gereken sertifika ortak anahtarlarının\nlistesi.\n\nPolitika değeri, base64 kodlu X.509 sertifikalarının listesidir. Eşleşen\nbir SPKI (SubjectPublicKeyInfo) içeren sertifikalara güvenilmez.";
CAHintCertificates.pfm_title = "Güvenilmeyen ancak sunucu kimlik doğrulaması için yol oluşturmada kullanılabilen TLS sertifikaları";
CAHintCertificates.pfm_description = "Brave ürününde güvenilmeyen ancak yol oluşturma için ipucu olarak\nkullanılabilecek sertifikaların listesi. Sertifikalar, base64 kodlu olmalıdır.";
CAPlatformIntegrationEnabled.pfm_title = "Sunucu kimlik doğrulaması için platform güvenilir sertifika depolarındaki kullanıcılar tarafından eklenen TLS sertifikalarını kullan";
CAPlatformIntegrationEnabled.pfm_description = "Etkinleştirilirse (veya ayarlanmazsa), platformun güvenilir sertifika depolarındaki kullanıcılar tarafından eklenen TLS sertifikaları, TLS sunucusu kimlik doğrulaması için yol oluşturma işleminde kullanılır.\n\nDevre dışı bırakılırsa, platformun güvenilir sertifika depolarındaki kullanıcılar tarafından eklenen TLS sertifikaları, TLS sunucusu kimlik doğrulaması için yol oluşturma işleminde kullanılmaz.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "CORS joker karakter olmayan istek başlıkları desteği";
CORSNonWildcardRequestHeadersSupport.pfm_description = "CORS joker karakter olmayan istek başlıkları desteğini yapılandırır.\n\nBrave 97 sürümü, CORS joker karakter olmayan istek başlıkları desteğini kullanıma sunuyor. Komut dosyaları, komut dosyası eklenmiş bir Yetkinlendirme başlığı içeren fetch() ve XMLHttpRequest aracılığıyla kaynaklar arası ağ isteğinde bulunduğunda bu başlığa, CORS ön kontrol yanıtındaki Access-Control-Allow-Headers başlığı tarafından açıkça izin verilmelidir. Buradaki \"açıkça\" ifadesiyle \"*\" joker karakter sembolünün, Yetkilendirme başlığını kapsamaması kastedilmektedir. Daha ayrıntılı bilgi için https://chromestatus.com/feature/5742041264816128 sayfasına bakın.\n\nBu politika ayarlanmazsa veya Doğru değerine ayarlanırsa Brave, CORS joker karakter olmayan istek başlıklarını destekler ve yukarıda açıklanan şekilde davranır.\n\nBu politika Yanlış değerine ayarlanırsa Chrome, CORS ön kontrol yanıtındaki Access-Control-Allow-Headers başlığında bulunan (\"*\") joker karakter sembolünün, Yetkilendirme başlığını kapsamasına izin verir.\n\nBu Kurumsal politika geçici olup gelecekte kaldırılması planlanmaktadır.";
CacheEncryptionEnabled.pfm_title = "Bu politika, yöneticilerin HTTP önbelleğini diskte şifrelemesine olanak tanır.";
CacheEncryptionEnabled.pfm_description = "Bu politika, yöneticilerin tarayıcı HTTP önbelleğini diskte şifrelemesine olanak tanır.\n\nBu politika etkinleştirildiğinde tarayıcı önbelleği şifrelenir.\n\nBu politika devre dışı bırakıldığında veya ayarlanmadığında tarayıcı önbelleği şifrelenmez.\n\nTarayıcı önbelleği şifreleme, performansı etkileyebilir.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "subjectPublicKeyInfo karma listesi için Sertifika Şeffaflığı uygulamasını devre dışı bırak";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "Politikanın ayarlanması, subjectPublicKeyInfo karmaları listesi için Sertifika Şeffaflığı açıklama gereksinimlerinin uygulanmasını kapatır. Kurumsal ana makineler, aksi halde güvenilmeyecek olan (uygun bir şekilde herkese açık olarak açıklanmadığından) sertifikaları kullanmaya devam edebilir. Uygulamanın kapatılması için karmanın aşağıdaki koşullardan birini karşılaması gerekir:\n\n* Karma, sunucu sertifikasının subjectPublicKeyInfo bilgisinde yer almalıdır.\n\n* Karma, sertifika zincirindeki bir Sertifika Yetkilisi (CA) sertifikasında görünensubjectPublicKeyInfo bilgisinde yer almalıdır. CA sertifikası, X.509v3 nameConstraints uzantısı aracılığıyla sınırlandırılır, permittedSubtrees içinde bir veya daha fazla mevcuttur ve directoryName bir nameConstraints özelliği içerir.\n\n* Karma, sertifika zincirindeki bir CA sertifikasında görünen subjectPublicKeyInfo bilgisinde yer almalıdır. CA sertifikasının sertifika Konu kısmında bir veya daha fazla organizationName özelliği vardır ve sunucu sertifikası, aynı sırada ve bayt bayt aynı değerlerde, aynı sayıda organizationName özelliği içerir.\n\nsubjectPublicKeyInfo karmasını, karma algoritması adı, eğik çizgi ve belirtilen sertifikanın DER kodlamalı subjectPublicKeyInfo öğesine uygulanan Base64 kodlamasını bağlayarak belirtir. Base64 kodlamasının biçimi, SPKI Parmak İzi ile aynıdır. Yalnızca karma algoritması tanınır, diğerleri yok sayılır.\n\nPolitikanın ayarlanmadan bırakılması, Sertifika Şeffaflığı aracılığıyla açıklama gerektiren sertifikaların açıklanmaması durumunda Brave ürününün bu sertifikalara güvenmeyeceği anlamına gelir.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "Bir URL listesi için Sertifika Şeffaflığı uygulamasını devre dışı bırak";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "Politikanın ayarlanması, belirtilen URL'lerdeki ana makine adları için Sertifika Şeffaflığı açıklama gereksinimlerini kapatır. Yanlış kullanılan sertifikaları algılamayı zorlaştırırken kurumsal ana makineler, aksi halde güvenilmeyecek olan (uygun bir şekilde herkese açık olarak paylaşılmadığından) sertifikaları kullanmaya devam edebilir.\n\nPolitikanın ayarlanmadan bırakılması, Sertifika Şeffaflığı aracılığıyla açıklama gerektiren sertifikaların açıklanmaması durumunda Brave ürününün bu sertifikalara güvenmeyeceği anlamına gelir.\n\nURL kalıbı bu biçime (https://support.google.com/chrome/a?p=url_blocklist_filter_format) uymalıdır. Bununla birlikte, belirli bir ana makine adı için sertifikaların geçerliliği şema, bağlantı noktası veya yoldan bağımsız olduğundan, Brave yalnızca URL'nin ana makine adı bölümünü dikkate alır. Joker karakter içeren ana makine adları desteklenmez.";
ChromeForTestingAllowed.pfm_title = "Chrome for Testing'e izin ver";
ChromeForTestingAllowed.pfm_description = "Kullanıcıların Chrome for Testing'i kullanıp kullanamayacağını kontrol eder.\n\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar Chrome for Testing'i yükleyip çalıştırabilir.\n\nBu politika, Devre Dışı değerine ayarlanırsa kullanıcıların Chrome for Testing'i çalıştırmasına izin verilmez. Kullanıcılar yine de Chrome for Testing'i yükleyebilir ancak bu politikanın Devre Dışı değerine ayarlandığı profillerde çalıştıramaz.";
ChromeSuggestionsSettings.pfm_title = "ChromeSuggestions ayarları";
ChromeSuggestionsSettings.pfm_description = "Bu ayar, Chrome'un doğru anlarda yapay zeka özellikleri önermesine olanak tanır.\n\n0/ayarlanmadı = Kullanıcılar için Chrome'dan öneriler etkinleştirilir.\n\n1 = Kullanıcılar için Chrome'dan öneriler devre dışı bırakılır.\n\nDaha fazla bilgi için lütfen https://support.google.com/chrome/a?p=chrome_suggestions adresindeki Yardım Merkezi makalesini inceleyin.";
ChromeVariations.pfm_title = "Varyasyonların kullanılabilirliğini belirleme";
ChromeVariations.pfm_description = "0 - Tüm varyasyonları etkinleştirme\n1 - Yalnızca önemli düzeltmelerle ilgili varyasyonları etkinleştir\n2 - Tüm varyasyonları devre dışı bırakma\nBu politikanın yapılandırılması, Brave ürününde hangi varyasyonların uygulanmasına izin verileceğini belirtmeye olanak tanır.\n\nVaryasyonlar, halihazırda varolan özellikler arasından seçilenleri etkinleştirerek veya devre dışı bırakarak tarayıcının yeni bir sürümünü göndermeden Brave ürününde değişiklikler sunmanın bir yolunu sağlar. Daha fazla bilgi için https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework sayfasına bakın.\n\nVariationsEnabled (0 değeri) ayarlanırsa veya politika ayarlanmadan bırakılırsa tarayıcı için tüm varyasyonların geçerli olması sağlanır.\n\nCriticalFixesOnly (1 değeri) ayarlanırsa Brave ürününe sadece önemli güvenlik veya sağlamlık düzeltmelerinin uygulanması sağlanır.\n\nVariationsDisabled (2 değeri) ayarlanırsa tarayıcıya hiçbir varyasyonun uygulanmasına izin verilmez. Bu modun, Brave geliştiricilerinin kritik güvenlik düzeltmelerini zamanında sağlamalarını engelleyebileceğini ve dolayısıyla önerilmediğini lütfen unutmayın.";
ClearBrowsingDataOnExitList.pfm_title = "Çıkışta Tarama Verilerini Sil";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - Tarama geçmişi\ndownload_history - İndirme geçmişi\ncookies_and_other_site_data - Çerezler ve diğer site verileri\ncached_images_and_files - Önbelleğe alınan resimler ve dosyalar\npassword_signin - Şifreyle oturum açma\nautofill - Otomatik doldurma\nsite_settings - Site ayarları\nhosted_app_data - Barındırılan uygulama verileri\nKullanıcı tüm tarayıcı pencerelerini kapattığında silinmesi gereken tarama verisi türlerinin listesini yapılandırır.\n\nUyarı: Bu politikanın ayarlanması, yerel kişisel verileri etkileyebilir ve kalıcı olarak silebilir. Kişisel verilerin yanlışlıkla silinmesini önlemek için dağıtmadan önce ayarlarınızı test etmeniz önerilir.\n\nKullanılabilir veri türleri şunlardır: Tarama geçmişi (browsing_history), indirme geçmişi (download_history), çerezler (cookies_and_other_site_data), önbellek (cached_images_and_files), otomatik doldurma (autofill), şifreler (password_signin), site ayarları (site_settings) ve barındırılan uygulama verileri (hosted_app_data). Bu politikanın AllowDeletingBrowserHistory üzerinde önceliği yoktur.\n\nKullanıcı, çerezleri sildiğinde Google Hesabı oturumu açık kalır.\n\nBu politika, Chrome 114 sürümüne kadar SyncDisabled politikasının doğru değerine ayarlanmasını gerektiriyordu. Chrome 115 sürümünden itibaren SyncDisabled politikası ayarlanarak \"Chrome Sync\" devre dışı bırakılmadığı veya BrowserSignin devre dışı olmadığı sürece, bu politika ayarlandığında ilgili veri türleri için senkronizasyon devre dışı bırakılır.\n\nVeri silme işlemi herhangi bir nedenle başlatılıp tamamlanmadıysa profil tekrar yüklendiğinde tarama verileri silinir.\n\nBrave normal bir şekilde kapanmazsa (örneğin tarayıcı veya işletim sistemi çökerse) tarayıcı, kullanıcının tüm tarayıcı pencerelerini kapatmasından dolayı kapanmadığı için tarama verileri silinmez.";
ClipboardAllowedForUrls.pfm_title = "Bu sitelerde panoya izin ver";
ClipboardAllowedForUrls.pfm_description = "Bu politikayı ayarlayarak, site pano iznini kullanabilecek siteleri belirten URL kalıplarını listeleyebilirsiniz. Kalıplarla eşleşen kaynaklardaki tüm pano işlemleri bu kapsama girmez. Örneğin, site pano izni tarafından denetlenmediğinden klavye kısayollarını kullanarak yapıştırma işlevi engellenmez.\n\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultClipboardSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
ClipboardBlockedForUrls.pfm_title = "Bu sitelerde panoyu engelle";
ClipboardBlockedForUrls.pfm_description = "Bu politikayı ayarlayarak, site pano iznini kullanamayacak siteleri belirten URL kalıplarını listeleyebilirsiniz. Kalıplarla eşleşen kaynaklardaki tüm pano işlemleri bu kapsama girmez. Örneğin, site pano izni tarafından denetlenmediğinden klavye kısayollarını kullanarak yapıştırma işlevi engellenmez.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultClipboardSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
CloudManagementEnrollmentMandatory.pfm_title = "Zorunlu bulut yönetimi kaydını etkinleştir";
CloudManagementEnrollmentMandatory.pfm_description = "Politika, Etkin değerine ayarlanırsa Chrome Enterprise Core tarayıcısına kaydolmak zorunlu olur ve başarısız olması halinde Brave ürününün işlemi başlatmasını engeller.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa Chrome Enterprise Core tarayıcısına kaydolmak isteğe bağlı olur ve başarısız olması halinde Brave ürününün işlemi başlatmasını engellemez.\n\nMasaüstünde makine kapsamı bulut politika kaydı bu politikayı kullanır. Ayrıntıları https://support.google.com/chrome/a/answer/9301891 adresinde bulabilirsiniz.";
CloudManagementEnrollmentToken.pfm_title = "Bulut politikasının kayıt jetonu";
CloudManagementEnrollmentToken.pfm_description = "Politika ayarlanırsa Brave kendini Chrome Enterprise Core tarayıcı yönetimine kaydettirmeye çalışır. Bu politikanın değeri, Google Admin console hizmetinden alabileceğiniz kayıt jetonudur.\n\nAyrıntıları https://support.google.com/chrome/a/answer/9301891 adresinde bulabilirsiniz.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "Brave bulut politikası, Platform politikasını geçersiz kılar.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Politika, Etkin değerine ayarlandığında bulut politikası platform politikasıyla çakışıyorsa bulut politikası tercih edilir.\n\nPolitika, Devre Dışı değerine ayarlandığında veya ayarlanmadan bırakıldığında bulut politikası platform politikasıyla çakışıyorsa platform politikası tercih edilir.\n\nBu zorunlu politika, makine genelinde geçerli olan bulut politikalarını etkiler.\n\nBu politika, Brave için geçerlidir ve bağımsız uygulamalar olduklarından Google Update üzerinde etkili değildir.\nGoogle Update aynı adda ayrı bir politikaya sahiptir.";
CloudUserPolicyMerge.pfm_title = "Kullanıcı bulut politikalarının, makine düzeyinde politikalarla birleştirilmesini sağlar";
CloudUserPolicyMerge.pfm_description = "Politika, Etkin değere ayarlandığında yönetilen bir hesapla ilişkilendirilmiş politikaların, makine düzeyinde politikalarla birleşmesine izin verilir.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcı düzeyindeki bulut politikalarının diğer kaynaklardaki politikalarla birleştirilmesine engel olur.\n\nYalnızca güvenli kullanıcılardan gelen politikalar öncelikli olabilir. Güvenli kullanıcı, tarayıcısını Chrome Enterprise Core ile yöneten kuruluşa bağlıdır. Diğer tüm kullanıcı düzeyindeki politikalar varsayılan olarak öncelikli olur.\n\nBirleştirilmesi gereken politikaların aynı zamanda PolicyListMultipleSourceMergeList veya PolicyDictionaryMultipleSourceMergeList içerisinde de ayarlanması gerekir. Yukarıda bahsedilen iki politika da yapılandırılmamışsa bu politika yok sayılır.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Kullanıcı bulut politikalarının, Chrome Browser Cloud Management politikalarını geçersiz kılmasına izin ver.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Politika, Etkin değerine ayarlanırsa yönetilen bir hesaba ilişkin politikalar ile Chrome Enterprise Core tarayıcı politikaları arasında uyuşmazlık olması halinde ilki öncelikli olur.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcı düzeyindeki bulut politikaları varsayılan olarak öncelikli olur.\n\nYalnızca güvenli kullanıcılardan gelen politikalar öncelikli olabilir. Güvenli kullanıcı, tarayıcısını Chrome Enterprise Core ile yöneten kuruluşa bağlıdır. Diğer tüm kullanıcı düzeyindeki politikalar varsayılan olarak öncelikli olur.\n\nPolitika, CloudPolicyOverridesPlatformPolicy ile birlikte kullanılabilir. İki politika da etkinleştirilirse kullanıcı bulut politikaları da uyuşmazlık içeren platform politikaları karşısında öncelikli olur.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Komut satırı işaretleri için güvenlik uyarılarını etkinleştirme";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Politika Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Chrome'u başlatmak için tehlikeli olabilecek komut satırı işaretleri kullanıldığında güvenlik uyarıları gösterilir.\n\nPolitika Devre Dışı değerine ayarlanırsa Chrome tehlikeli olabilecek komut satırı işaretleriyle başlatıldığında güvenlik uyarılarının gösterilmesini engeller.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
ComponentUpdatesEnabled.pfm_title = "Brave ürününde bileşen güncellemelerini etkinleştir";
ComponentUpdatesEnabled.pfm_description = "Ayarlanmazsa veya etkin değerine ayarlanırsa Brave ürünündeki tüm bileşenler için bileşen güncellemelerini etkinleştirir.\n\nDevre dışı değerine ayarlanırsa bileşen güncellemeleri devre dışı bırakılır. Ancak bazı bileşenler bu politikadan muaf tutulur: Yürütülebilir kod içermeyen ve tarayıcının güvenliği açısından kritik öneme sahip olan bileşen güncellemeleri devre dışı bırakılmaz.\nBu tür bileşenlere örnek olarak sertifika iptal listeleri ve alt kaynak filtreleri gösterilebilir.";
CompressionDictionaryTransportEnabled.pfm_title = "Sıkıştırılmış sözlük aktarım desteğini etkinleştir";
CompressionDictionaryTransportEnabled.pfm_description = "Bu özellik, sözlükler kullanıma hazır olduğunda Accept-Encoding istek başlığında sözlüğe özgü içerik kodlamalarının (\"sbr\" ve \"zst-d\") kullanılmasını sağlar.\n\nPolitika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, sıkıştırılmış sözlük aktarım özelliğini kullanan web içeriklerini kabul eder.\nPolitika, Devre Dışı değerine ayarlanırsa sıkıştırılmış sözlük aktarım özelliği devre dışı bırakılır.";
CookiesAllowedForUrls.pfm_title = "Bu sitelerde çerezlere izin ver";
CookiesAllowedForUrls.pfm_description = "Çerezleri ayarlamasına izin verilen siteleri belirten url kalıpları listesini ayarlamanıza olanak sağlar.\n\nURL kalıpları, sitenin tüm üst düzey sitelerde çerez kullanabileceğini gösteren tek bir URL'den oluşabilir.\n\nKalıplar, virgülle ayrılmış iki URL'den de oluşabilir. Birincisi, çerezleri kullanmasına izin verilmesi gereken siteyi belirtir. İkincisi ise ilk değerin uygulanması gereken üst düzey siteyi belirtir.\n\nBir URL çifti kullanırsanız çiftteki ilk değer * işaretini destekler, ancak ikinci değer bu işareti desteklemez. İlk değer için * kullanılması, ikinci URL üst düzey site olduğunda tüm sitelerin çerez kullanabileceğini gösterir.\n\nBu politika ayarlanmadan bırakılırsa genel varsayılan değer, tüm siteler için, ayarlanması halinde DefaultCookiesSetting ya da BlockThirdPartyCookies politikalarından veya kullanıcının kişisel yapılandırmasından kullanılır.\n\nCookiesBlockedForUrls ve CookiesSessionOnlyForUrls politikalarına da bakın. Hangi politikanın öncelikli olarak ele alınacağı belirtilmediğinden bu üç politika arasında çakışan URL kalıplarının olmaması gerektiğini unutmayın.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
CookiesBlockedForUrls.pfm_title = "Bu sitelerdeki çerezleri engelle";
CookiesBlockedForUrls.pfm_description = "Politikayı ayarlayarak çerez ayarlayamayan siteleri belirten URL kalıpları listesi oluşturabilirsiniz.\n\nPolitika ayarlanmadan bırakılırsa tüm siteler için (etkinse) DefaultCookiesSetting kullanılır. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nHiçbir politikanın diğeri üzerinde önceliği olmamakla birlikte, CookiesAllowedForUrls ve CookiesSessionOnlyForUrls politikalarına bakın. Bu üç politikada yer alan URL kalıpları birbirleriyle çakışmamalıdır.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
CookiesSessionOnlyForUrls.pfm_title = "Eşleşen URL'lerden çerezleri geçerli oturumla sınırlama";
CookiesSessionOnlyForUrls.pfm_description = "RestoreOnStartup politikası, önceki oturumlardan URL'lerin geri yükleneceği şekilde ayarlanmışsa, CookiesSessionOnlyForUrls ayarı bir oturum için çerezlere izin veren ve vermeyen siteleri belirten bir URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika ayarlanmadan bırakılırsa tüm siteler için (etkinse) DefaultCookiesSetting kullanılır. Aksi takdirde kullanıcının kişisel ayarları geçerlidir. Belirtilen kalıplarda yer almayan URL'ler için de varsayılan ayarlar geçerlidir.\n\nHiçbir politikanın diğeri üzerinde önceliği olmamakla birlikte, CookiesBlockedForUrls ve CookiesAllowedForUrls politikalarına bakın. Bu üç politikada yer alan URL kalıpları birbirleriyle çakışmamalıdır.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
CpuPerformanceTierOverride.pfm_title = "CPU performans katmanı için geçersiz kılma";
CpuPerformanceTierOverride.pfm_description = "Bu politikanın ayarlanması, kuruluşların CPU Performance API tarafından döndürülen değeri (ör.\nnavigator.cpuPerformance,\nayrıntılar için lütfen https://github.com/WICG/cpu-performance adresini inceleyin) geçersiz kılmasına imkan sağlar.\n\nBu politika ayarlanırsa navigator.cpuPerformance değeri, belirtilen değerle geçersiz kılınır. Politika ayarlanmazsa varsayılan performans katmanı hesaplaması kullanılır.\n\nBu politika için olası değerler 0-4 arasıdır.";
CreatePasskeysInICloudKeychain.pfm_title = "Geçiş anahtarı oluşturma işleminin varsayılan olarak iCloud Anahtar Zinciri'nde yapılıp yapılmayacağını kontrol et.";
CreatePasskeysInICloudKeychain.pfm_description = "Brave, macOS 13.5 veya sonraki sürümlerde geçiş anahtarı/WebAuthn oluşturma isteklerini doğrudan iCloud Anahtar Zinciri'ne yönlendirebilir. iCloud Anahtar Zinciri senkronizasyonu henüz etkinleştirilmemişse kullanıcıdan iCloud ile oturum açması istenir veya iCloud Anahtar Zinciri senkronizasyonunu etkinleştirmesi istenebilir.\n\nBu politika Yanlış değerine ayarlanırsa iCloud Anahtar Zinciri varsayılan olarak kullanılmaz. Bunun yerine önceki davranış (kimlik bilgilerini Brave profilinde oluşturma) kullanılabilir. iCloud Anahtar Zinciri, kullanıcılara seçenek olarak sunulmaya devam eder ve kullanıcılar oturum açarken iCloud Anahtar Zinciri kimlik bilgilerini görmeye devam edebilirler.\n\nBu politika Doğru değerine ayarlanırsa WebAuthn isteğinin bu seçenekle uyumlu olduğu her durumda varsayılan olarak iCloud Anahtar Zinciri kullanılır.\n\nBu politika ayarlanmazsa varsayılan ayar, iCloud Drive'ın etkin olup olmadığı ve kullanıcının son zamanlarda Brave profilinde kimlik bilgisi kullanıp kullanmadığı veya oluşturup oluşturmadığı gibi faktörlere bağlı olur.";
CreateThemesSettings.pfm_title = "Yapay Zeka ile Tema Oluştur ayarları";
CreateThemesSettings.pfm_description = "0 - Yapay Zeka ile Tema Oluştur özelliğine izin ver ve yapay zeka modellerini daha iyi hale getir.\n1 - Yapay zeka modellerini daha iyi hale getirmeden Yapay Zeka ile Tema Oluştur özelliğine izin ver.\n2 - Yapay Zeka ile Tema Oluştur özelliğine izin verme.\nYapay Zeka ile Tema Oluştur özelliği, kullanıcıların bir seçenek listesinden önceden seçim yaparak özel temalar/duvar kağıtları oluşturmasına olanak tanır.\n\n0 = Özelliğin kullanılmasına izin verirken Google'ın yapay zeka modellerini iyileştirmek için ilgili verileri kullanmasına izin verir. İlgili veriler arasında özelliğe bağlı olarak istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler yer alabilir. Bu bilgiler, gerçek kişiler tarafından da yapay zeka modellerini iyileştirmek için incelenebilir. Aşağıdaki değerler belirtilmediği sürece varsayılan değer 0'dır.\n\n1 = Özelliğin kullanılmasına izin verir ancak Google'ın kullanıcıların içeriklerini (istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler dahil) kullanarak modelleri iyileştirmesine izin vermez. Google Admin console tarafından yönetilen kurumsal kullanıcılar ve Google Workspace tarafından yönetilen eğitim hesapları için varsayılan değer 1'dir.\n\n2 = Özelliğe izin vermez.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
DNSInterceptionChecksEnabled.pfm_title = "DNS müdahale kontrolü etkin";
DNSInterceptionChecksEnabled.pfm_description = "Bu politika, DNS müdahale kontrollerin devre dışı bırakmak için kullanılabilen yerel bir anahtarı yapılandırır. Kontroller, tarayıcının bilinmeyen ana bilgisayar adlarına yönlendirme yapan bir proxy'nin arkasında olup olmadığını anlamaya çalışır.\n\nBu tespit, ağ yapılandırmasının bilindiği kurumsal ortamlarda gerekli olmayabilir. Zira bu işlem başlangıçta ve DNS yapılandırması her değiştiğinde bir miktar DNS ve HTTP trafiğine neden olur.\n\nBu politika ayarlanmadığında veya etkinken DNS müdahale kontrolleri yapılır. Açıkça devre dışı bırakıldığında kontrol yapılmaz.";
DataURLWhitespacePreservationEnabled.pfm_title = "Tüm medya türleri için veri URL'si boşluk koruması";
DataURLWhitespacePreservationEnabled.pfm_description = "Bu politika, Chrome'un data URL'lerindeki boşlukları işleme şekliyle ilgili değişiklikler için geçici bir devre dışı bırakma seçeneği sunar.\nBoşluklar eskiden yalnızca üst düzey medya türü text ise veya xml medya türü dizesini içeriyorsa korunuyordu.\nBoşluklar artık medya türünden bağımsız olarak tüm veri URL'lerinde korunacak.\n\nBu politika ayarlanmadan bırakılırsa veya Doğru değerine ayarlanırsa yeni davranış etkinleştirilir.\n\nBu politika Yanlış değerine ayarlandığında eski davranış etkinleştirilir.";
DataUrlInSvgUseEnabled.pfm_title = "SVGUseElement için veri URL'si desteği.";
DataUrlInSvgUseEnabled.pfm_description = "Bu politika, SVGUseElement için Veri URL'si desteğini etkinleştirir. Bu destek, M119'dan itibaren varsayılan olarak devre dışı olacaktır.\nBu politika, Etkin seçeneğine ayarlanırsa Veri URL'leri SVGUseElement öğesinde çalışmaya devam eder.\nBu politika Devre Dışı seçeneğine ayarlanırsa veya ayarlanmadan bırakılırsa Veri URL'leri SVGUseElement öğesinde çalışmaz.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Web Çalışanlarında veri URL'leri için opak kaynakları etkinleştir";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Veri URL'lerinden oluşturulan Web Çalışanlarına benzersiz opak kaynak atanıp atanmadığını kontrol eder.\n\nWeb Çalışanları, çalışanın komut dosyasını içeren bir veri URL'si kullanılarak oluşturulabilir. Daha önce bu çalışanlar, kendilerini oluşturan sayfanın kaynağını devraldıkları için aynı yerel depolama alanı, çerezler ve kaynağa bağlı diğer verilere erişebiliyordu. Chrome, güvenliği artırmak ve HTML spesifikasyonuyla uyumlu hale gelmek için 149 sürümünde varsayılan davranışını değiştirerek veri URL'lerinden oluşturulan çalışanların artık benzersiz ve opak bir kaynağa sahip olmasını sağlıyor. Bu işlem, onları oluşturucunun sayfasındaki verilerden ayırır.\n\nBu politika, Etkin değerine ayarlanırsa veya ayarlanmadan bırakılırsa yeni varsayılan (daha güvenli) davranış kullanılır ve veri URL'lerinden oluşturulan Web Çalışanları benzersiz bir opak kaynağa sahip olur.\n\nBu politika, Devre Dışı seçeneğine ayarlanırsa Chrome, eski davranışa döner ve veri URL'lerinden oluşturulan Web Çalışanları, oluşturucularının kaynağını devralır. Bu sayede yöneticiler, güvenlik değişikliği nedeniyle dahili uygulamalarda sorun yaşanması durumunda uyumluluk sorunlarını geçici olarak çözebilir.\n\nBu politika, geçici olarak tasarlanmıştır ve 157 sürümünde kaldırılacaktır.";
DefaultAutomaticDownloadsSetting.pfm_title = "Varsayılan otomatik indirme ayarı";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Tüm sitelerin otomatik olarak birden fazla dosya indirmesine izin ver\n2 - Hiçbir sitenin otomatik olarak birden fazla dosya indirmesine izin verme\n3 - Bir site birden fazla dosyayı otomatik olarak indirmek istediğinde her zaman sor\nPolitika 1 değerine ayarlanırsa web sitelerinin birden fazla dosyayı otomatik olarak indirmesine izin verilir. Politika 2 değerine ayarlanırsa bu izin engellenir. Politikayı, web siteleri birden fazla dosyayı otomatik olarak indirmek istediğinde onay isteyecek şekilde ayarlayabilirsiniz.\n\nPolitikayı ayarlamadan bırakırsanız AskAutomaticDownloads politikası geçerli olur. Kullanıcılar bu ayarı değiştirebilir.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Brave ürününü varsayılan tarayıcım olarak ayarla";
DefaultBrowserSettingEnabled.pfm_description = "Politikayı True (Doğru) değerine ayarlamak, Brave ürününün her zaman başlangıçta varsayılan tarayıcı olup olmadığını denetlemesini ve mümkünse kendini otomatik olarak kaydetmesini sağlar. Politikayı False (Yanlış) değerine ayarlamak, Brave ürününün varsayılan olup olmadığını kontrol etmesini durdurup bu seçenek için kullanıcı denetimlerini kapatır.\n\nPolitikanının ayarlanmadan bırakılması, Brave ürününün varsayılan olup olmadığını ve varsayılan değilse kullanıcı bildirimlerinin gösterilip gösterilmeyeceğini kullanıcının denetlemesine izin verdiği anlamına gelir.\n\nNot: Microsoft®Windows® yöneticileri için bu ayar yalnızca Windows 7 çalıştıran makinelerde etkinleştirilebilir. Daha yeni sürümlerde Brave ürününü https ve http protokollerinin (ve isteğe bağlı olarak ftp protokolünün ve diğer dosya biçimlerinin) işleyicisi haline getiren bir \"varsayılan uygulama ilişkilendirmeleri\" dosyası dağıtmanız gerekir. Daha fazla bilgi için Chrome Yardımı'na (https://support.google.com/chrome?p=make_chrome_default_win) bakabilirsiniz.";
DefaultClipboardSetting.pfm_title = "Varsayılan pano ayarı";
DefaultClipboardSetting.pfm_description = "2 - Hiçbir sitenin, site pano iznini kullanmasına izin verme\n3 - Sitelerin kullanıcıdan site pano izni istemesine izin ver\nPolitika 2 değerine ayarlanırsa siteler, site pano iznini kullanamaz. Politika 3 değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcı, ayarı değiştirebilir ve siteler pano API'si kullanmak istediğinde buna izin verebilir.\n\nBu politika, ClipboardAllowedForUrls ve ClipboardBlockedForUrls politikaları kullanılarak belirli URL kalıpları için geçersiz kılınabilir.\n\nBu politika yalnızca site pano izni tarafından kontrol edilen pano işlemlerini etkiler; steril pano yazma işlemlerini veya güvenilir kopyalama ve yapıştırma işlemlerini etkilemez.";
DefaultCookiesSetting.pfm_title = "Varsayılan çerezler ayarı";
DefaultCookiesSetting.pfm_description = "1 - Tüm sitelerin yerel verileri ayarlamasına izin verme\n2 - Hiçbir sitenin yerel verileri ayarlamasına izin verme\n4 - Oturum süresince çerezleri tutma\nRestoreOnStartup politikası, önceki oturumlardan URL'lerin geri yükleneceği şekilde ayarlanmamışsa, CookiesSessionOnlyForUrls ayarı bir oturum için çerezlere izin veren ve vermeyen siteleri belirten URL kalıpları için liste yapmanıza olanak tanır.\n\nPolitika ayarlanmadan bırakılırsa tüm siteler için DefaultCookiesSetting (etkinse) kullanılır. Aksi takdirde kullanıcının kişisel ayarları geçerlidir. Belirtilen kalıplarda yer almayan URL'ler için de varsayılan ayarlar geçerlidir.\n\nHiçbir politikanın diğeri üzerinde önceliği olmamakla birlikte, CookiesBlockedForUrls ve CookiesAllowedForUrls politikalarına bakın. Bu üç politikada yer alan URL kalıpları birbirleriyle çakışmamalıdır.";
DefaultDownloadDirectory.pfm_title = "Varsayılan indirme dizinini ayarlama";
DefaultDownloadDirectory.pfm_description = "Politika ayarlanırsa Chrome'un dosyaları indirdiği varsayılan dizin değişir, ancak kullanıcılar dizini değiştirebilir.\n\nPolitika ayarlanmadan bırakılırsa Chrome, platforma özgü varsayılan dizinini kullanır.\n\nDownloadDirectory politikası ayarlanmışsa bu politikanın etkisi olmaz.\n\nNot: Kullanabileceğiniz değişkenlerin listesine bakın (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DefaultFileSystemReadGuardSetting.pfm_title = "Okuma için File System API'nin kullanımını kontrol et";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - Hiçbir sitenin File System API üzerinden dosya ve dizinlere okuma erişimi istemesine izin verme\n3 - Sitelerin kullanıcıdan File System API üzerinden dosya ve dizinlere okuma erişimi istemesine izin ver\nPolitika 3 değerine ayarlanırsa web siteleri, File System API üzerinden ana makine işletim sisteminin dosya sistemindeki dosya ve dizinlere okuma erişimi isteyebilir. Politikayı 2 değerine ayarlamak erişimi engeller.\n\nPolitikayı ayarlanmadan bırakırsanız web siteleri erişim izni isteyebilir. Kullanıcılar bu ayarı değiştirebilirler.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Yazma için File System API'nin kullanımını kontrol et";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - Hiçbir sitenin dosya ve dizinlere yazma erişimi istemesine izin verme\n3 - Sitelerin kullanıcıdan dosya ve dizinlere yazma erişimi istemesine izin ver\nPolitika 3 değerine ayarlanırsa web siteleri, ana makine işletim sisteminin dosya sistemindeki dosya ve dizinlere yazma erişimi isteyebilir. Politikayı 2 değerine ayarlamak erişimi engeller.\n\nPolitikayı ayarlanmadan bırakırsanız web siteleri erişim izni isteyebilir. Kullanıcılar bu ayarı değiştirebilirler.";
DefaultGeolocationSetting.pfm_title = "Varsayılan coğrafi konum ayarı";
DefaultGeolocationSetting.pfm_description = "1 - Sitelerin, kullanıcıların fiziksel konumlarını izlemesine izin ver\n2 - Hiçbir sitenin, kullanıcının fiziksel konumunu izlemesine izin verme\n3 - Bir site, kullanıcının fiziksel konumunu izlemek istediğinde sor\nPolitikayı 1 değerine ayarlamak sitelerin kullanıcının fiziksel konumunu izlemesine izin verir. Politikayı 2 değerine ayarlamak izlemeyi varsayılan olarak kapatır. Politikayı, web siteleri fiziksel konumunuzu izlemek istediğinde sorması için ayarlayabilirsiniz.\n\nPolitikayı ayarlamadan bırakırsanız AskGeolocation politikası geçerli olur. Kullanıcılar bu ayarı değiştirebilir.";
DefaultIdleDetectionSetting.pfm_title = "Boşta kalma algılama";
DefaultIdleDetectionSetting.pfm_description = "1 - Sitelerin, kullanıcıya sormadan boşta kalma durumunu algılamasına izin ver\n2 - Hiçbir sitenin kullanıcının boşta kalma durumunu algılamasına izin verme\n3 - Bir site, kullanıcının boşta kalma durumunu her algılamak istediğinde sor\nWeb sitelerinin Idle Detection API'yi kullanmasına izin verilip verilmeyeceğini ayarlamanıza olanak tanır.\n\nBu politika 1 - AllowIdleDetection değerine ayarlandığında web siteleri, kullanıcıdan izin istemeden API'yi kullanabilir.\n\nBu politika 2 - BlockIdleDetection değerine ayarlandığında kullanıcının izni ne olursa olsun web siteleri API'yi kullanamaz.\n\nBu politika 3 - AskIdleDetection değerine ayarlanır veya ayarlanmadan bırakılırsa web siteleri, kullanıcının izni olmadan API'yi kullanamaz.";
DefaultImagesSetting.pfm_title = "Varsayılan resimler ayarı";
DefaultImagesSetting.pfm_description = "1 - Tüm sitelerin tüm resimleri görüntülemesine izin ver\n2 - Hiçbir sitenin resimleri görüntülemesine izin verme\nPolitikayı 1 değerine ayarlamak tüm web sitelerde görsellere izin verir. Politikayı 2 değerine ayarlamak görselleri engeller.\n\nPolitikayı ayarlamadan bırakırsanız görsellere izin verilir. Kullanıcılar bu ayarı değiştirebilir.";
DefaultInsecureContentSetting.pfm_title = "Güvenli olmayan içerik istisnalarının kullanımını kontrol et";
DefaultInsecureContentSetting.pfm_description = "2 - Hiçbir sitenin engellenebilir karma içerik yüklemesine izin verme\n3 - Kullanıcıların engellenebilir karma içeriğe izin vermek için istisnalar eklemesine izin ver\nBelirli sitelerle ilgili karma içeriğe izin vermek için kullanıcıların istisnalar ekleyip ekleyemeceklerini ayarlamanıza olanak tanır.\n\nBu politika \"InsecureContentAllowedForUrls\" ve \"InsecureContentBlockedForUrls\" politikaları kullanılarak belirli URL kalıpları için geçersiz kılınabilir.\n\nBu politika ayarlanmadan bırakılırsa kullanıcıların, engellenebilir karma içeriğe izin vermek için istisnalar eklemelerine ve isteğe bağlı olarak engellenebilir karma içerik için otomatik yükseltmeleri devre dışı bırakmalarına izin verilir.";
DefaultJavaScriptJitSetting.pfm_title = "JavaScript JIT kullanımını denetle";
DefaultJavaScriptJitSetting.pfm_description = "1 - Tüm sitelerin JavaScript JIT çalıştırmasına izin ver\n2 - Hiçbir sitenin JavaScript JIT çalıştırmasına izin verme\nBrave tarayıcının, v8 JavaScript motorunu JIT (Just In Time) derleyicisi etkinken çalıştırıp çalıştırmayacağını ayarlamanıza olanak tanır.\n\nJavaScript JIT'in devre dışı bırakılması, Brave tarayıcının, web içeriğini daha yavaş oluşturabileceği, ayrıca JavaScript'in WebAssembly gibi bazı bölümlerini devre dışı bırakabileceği anlamına gelir. JavaScript JIT'in devre dışı bırakılması, Brave tarayıcının, web içeriğini daha güvenli bir konfigürasyonda oluşturmasına imkan sağlayabilir.\n\nBu politika, JavaScriptJitAllowedForSites ve JavaScriptJitBlockedForSites politikaları kullanılarak belirli URL kalıpları için geçersiz kılınabilir.\n\nBu politika ayarlanmadan bırakılırsa JavaScript JIT etkin olur.";
DefaultJavaScriptOptimizerSetting.pfm_title = "JavaScript optimize edicilerin kullanımını denetle";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Gelişmiş JavaScript optimizasyonlarını tüm sitelerde etkinleştir\n2 - Gelişmiş JavaScript optimizasyonlarını tüm sitelerde devre dışı bırak\nBrave tarayıcının, V8 JavaScript motorunu daha gelişmiş JavaScript optimizasyonları etkinken çalıştırıp çalıştırmayacağını ayarlamanıza olanak tanır.\n\nBu politikanın değerinin 2'ye ayarlanarak JavaScript optimizasyonlarının devre dışı bırakılması, Brave tarayıcının web içeriğini daha yavaş oluşturabileceği anlamına gelir.\n\nBu politika, JavaScriptOptimizerAllowedForSites ve JavaScriptOptimizerBlockedForSites politikaları kullanılarak belirli URL kalıpları için geçersiz kılınabilir.\n\nBu politika ayarlanmadan bırakılırsa JavaScript optimizasyonları etkin olur.";
DefaultJavaScriptSetting.pfm_title = "Varsayılan JavaScript ayarı";
DefaultJavaScriptSetting.pfm_description = "1 - Tüm sitelerin JavaScript çalıştırmasına izin ver\n2 - Hiçbir sitenin JavaScript çalıştırmasına izin verme\nPolitikayı Doğru değerine ayarlamak web sitelerinin JavaScript çalıştırmasına izin verir. Politikayı Yanlış değerine ayarlamak web sitelerinin JavaScript çalıştırmasını engeller.\n\nPolitikayı ayarlamadan bırakırsanız JavaScript'e izin verilir. Kullanıcılar bu ayarı değiştirebilir.";
DefaultLocalFontsSetting.pfm_title = "Varsayılan yerel yazı tipleri izni ayarı";
DefaultLocalFontsSetting.pfm_description = "2 - Yerel yazı tipleri iznini tüm sitelerde varsayılan olarak reddeder\n3 - Siteler yerel yazı tipleri izni istediğinde her seferinde sor\nPolitika, BlockLocalFonts (2. değer) olarak ayarlanırsa sitelerdeki yerel yazı tipleri iznini varsayılan olarak otomatik engeller. Bu durumda sitelerin, yerel yazı tipleriyle ilgili bilgileri görme imkanı kısıtlanmış olur.\n\nPolitika, AskLocalFonts (3. değer) olarak ayarlanırsa yerel yazı tipleri izni istendiğinde varsayılan olarak kullanıcıyı bilgilendirir. Kullanıcılar bu izni verirse sitelerin, yerel yazı tipleriyle ilgili bilgileri görme imkanı artmış olur.\n\nPolitika ayarlanmadan bırakılırsa kullanıcıyı bilgilendirmeyle ilgili varsayılan davranış geçerli olur ancak kullanıcılar bu ayarı değiştirebilir";
DefaultNotificationsSetting.pfm_title = "Varsayılan bildirim ayarı";
DefaultNotificationsSetting.pfm_description = "1 - Sitelerin masaüstü bildirimi göstermesine izin ver\n2 - Hiçbir sitenin masaüstü bildirimi göstermesine izin verme\n3 - Bir site, masaüstü bildirimlerini her göstermek istediğinde sor.\nPolitikayı 1 değerine ayarlamak web sitelerinin masaüstü bildirimlerine izin verir. Politikayı 2 değerine ayarlamak masaüstü bildirimlerini engeller.\n\nPolitikayı ayarlamadan bırakırsanız AskNotifications politikası geçerli olur. Kullanıcılar bu ayarı değiştirebilir.";
DefaultPopupsSetting.pfm_title = "Varsayılan pop-up'lar ayarı";
DefaultPopupsSetting.pfm_description = "1 - Tüm sitelerin pop-up göstermesine izin ver\n2 - Hiçbir sitenin pop-up göstermesine izin verme\nPolitikayı 1 değerine ayarlamak web sitelerinde pop-up'lara izin verir. Politikayı 2 değerine ayarlamak pop-up'ları engeller.\n\nPolitikayı ayarlamadan bırakırsanız BlockPopups politikası geçerli olur. Kullanıcılar bu ayarı değiştirebilir.";
DefaultPrinterSelection.pfm_title = "Varsayılan yazıcı seçimi için kurallar";
DefaultPrinterSelection.pfm_description = "Politika ayarlanırsa Brave ürününde varsayılan yazıcıyı seçme kuralları belirlenir ve varsayılan kurallar geçersiz kılınır. Yazıcı seçimi, kullanıcılar ilk kez yazdırmaya çalıştığında, yani Brave belirtilen özelliklere uygun bir yazıcı aradığında yapılır. Kusursuz eşleşme sağlanamazsa Brave, bulunma sırasına bağlı olarak eşleşen yazıcılardan herhangi birini seçecek şekilde ayarlanabilir.\n\nPolitika ayarlanmadan bırakılır veya hiçbir yazıcıyla eşleşmeyen özelliklere ayarlanırsa yerleşik PDF yazıcısı varsayılan olur. PDF yazıcısı yoksa Brave için varsayılan yazıcı ayarlanmaz.\n\nŞu anda tüm yazıcılar \"local\" olarak sınıflandırılmaktadır. Google Cloud Print hizmetine bağlı yazıcılar \"cloud\" olarak kabul edilir, ancak Google Cloud Print artık desteklenmemektedir.\n\nNot: Bir alanın atlanması, tüm değerlerin o alanla eşleştiği anlamına gelir. Örneğin, idPattern belirtilmezse Yazdırma Önizleme, tüm yazıcı kimliklerini kabul eder. Normal ifade kalıpları JavaScript RegExp söz dizimine uygun olmalıdır. Eşleşmeler büyük/küçük harfe duyarlıdır.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection adresine bakın.";
DefaultSearchProviderAlternateURLs.pfm_title = "Varsayılan arama sağlayıcısına ilişkin alternatif URL'lerin listesi";
DefaultSearchProviderAlternateURLs.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderAlternateURLs protokolünün ayarlanması, arama motorundan arama terimlerini çıkartmak için alternatif URL'lerin bir listesini belirtir. Bu URL'ler, '{searchTerms}' dizesini içermelidir.\n\nDefaultSearchProviderAlternateURLs protokolü ayarlanmadan bırakılırsa arama terimlerini çıkartmak için alternatif URL kullanılmaz.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Varsayılan arama sağlayıcısı içerik menüsü arama erişimine izin verir";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "İçerik menüsünde bir varsayılan arama sağlayıcısının kullanılabilmesini sağlar.\n\nBu politikayı devre dışı değerine ayarlarsanız varsayılan arama sağlayıcınıza dayanan arama içerik menüsü öğesi kullanılamaz.\n\nBu politika etkin değerine ayarlanırsa veya ayarlanmadan bırakılırsa varsayılan arama içerik sağlayıcınız için olan içerik menüsü öğesi kullanılabilir.\n\nPolitika değeri yalnızca DefaultSearchProviderEnabled politikası etkin olduğunda uygulanır ve bunun dışında uygulanmaz.";
DefaultSearchProviderEnabled.pfm_title = "Varsayılan arama sağlayıcıyı etkinleştir";
DefaultSearchProviderEnabled.pfm_description = "Politika, Etkin değerine ayarlanırsa kullanıcı adres çubuğuna URL olmayan metin girdiğinde varsayılan arama gerçekleştirilir. Varsayılan arama motorunu belirtmek için geri kalan arama politikalarını ayarlayın. Bu politikaları boş bırakırsanız kullanıcı varsayılan sağlayıcısını seçebilir. Politika, Devre Dışı değerine ayarlanırsa kullanıcı adres çubuğuna URL olmayan metin girdiğinde arama gerçekleşmez. Google Admin console, Devre Dışı değerini desteklemez.\n\nBu politikayı ayarlarsanız kullanıcılar Brave ürününde değiştiremez. Ayarlanmadan bırakılırsa varsayılan arama motorunu etkin hale gelir ve kullanıcılar, arama sağlayıcısı listesini ayarlayabilirler.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
DefaultSearchProviderEncodings.pfm_title = "Varsayılan arama sağlayıcı kodlamaları";
DefaultSearchProviderEncodings.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderEncodings politikasının ayarlanması, arama sağlayıcı tarafından desteklenen karakter kodlamalarını belirtir. Kodlamalar UTF-8, GB2312 ve ISO-8859-1 gibi kod sayfası adlarıdır. Bunlar, sağlandıkları sırada denenirler.\n\nDefaultSearchProviderEncodings politikası ayarlanmazsa UTF-8 kullanılır.";
DefaultSearchProviderImageURL.pfm_title = "Varsayılan arama sağlayıcısı için resme göre arama özelliği sağlayan parametre";
DefaultSearchProviderImageURL.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderImageURL politikasının ayarlanması, resim arama için kullanılan arama motorunun URL'sini belirtir. (DefaultSearchProviderImageURLPostParams politikası ayarlandıysa resim arama istekleri bunun yerine POST yöntemini kullanır.)\n\nDefaultSearchProviderImageURL protokolü ayarlanmadan bırakılırsa resim arama kullanılmaz.\n\nGörsel arama, alma yöntemini kullanıyorsa URL aşağıdaki yer tutucuların geçerli\nbir kombinasyonunu kullanarak görsel parametrelerini belirtmelidir:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "POST kullanan resim URL'si için parametreler";
DefaultSearchProviderImageURLPostParams.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderImageURLPostParams protokolünün ayarlanması, POST ile resim araması yaparken parametreleri belirtir. Virgülle ayrılmış ad-değer çiftlerini içerir. Değer, {imageThumbnail} gibi bir şablon parametresi ise gerçek resmin küçük resim verisiyle değiştirilir.\n\nDefaultSearchProviderImageURLPostParams politikası ayarlanmazsa resim araması isteği, GET yöntemi kullanılarak gönderilir.\n\nURL, arama motorunun neyi desteklediğine göre aşağıdaki yer tutucuların geçerli\nbir kombinasyonunu kullanarak görsel parametresini belirtmelidir:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Varsayılan arama sağlayıcı anahtar kelimesi";
DefaultSearchProviderKeyword.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderKeyword protokolünün ayarlanması, bu sağlayıcı için arama tetiklemek üzere adres çubuğunda kullanılan anahtar kelimeyi veya kısayolu belirtir.\n\nDefaultSearchProviderKeyword protokolünün ayarlanmadan bırakılması, arama sağlayıcıyı etkinleştiren anahtar kelime olmadığı anlamına gelir.";
DefaultSearchProviderName.pfm_title = "Varsayılan arama sağlayıcının adı";
DefaultSearchProviderName.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderName protokolünün ayarlanması, varsayılan arama sağlayıcının adını belirtir.\n\nDefaultSearchProviderName politikası ayarlanmadan bırakılırsa arama URL'sinde belirtilen ana makine adı kullanılır.";
DefaultSearchProviderNewTabURL.pfm_title = "Varsayılan arama sağlayıcısı yeni sekme sayfası URL'si";
DefaultSearchProviderNewTabURL.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderNewTabURL politikasının ayarlanması, arama motorunun Yeni Sekme sayfası sağlamak için kullandığı URL'yi belirtir.\n\nDefaultSearchProviderNewTabURL protokolü ayarlanmadan bırakılırsa yeni sekme sayfası sağlanmaz.";
DefaultSearchProviderSearchURL.pfm_title = "Varsayılan arama sağlayıcı arama URL'si";
DefaultSearchProviderSearchURL.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderSearchURL politikasının ayarlanması, varsayılan arama sırasında kullanılan arama motorunu belirtir. URL, sorguda kullanıcının arama terimi ile değiştirilen '{searchTerms}' dizesini içermelidir.\n\nGoogle'ın arama URL'sini şu şekilde belirtebilirsiniz: '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "POST kullanan arama URL'si için parametreler";
DefaultSearchProviderSearchURLPostParams.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderSearchURLPostParams protokolünün ayarlanması, POST ile URL ararken parametreleri belirtir. Virgülle ayrılmış ad-değer çiftlerini içerir. Değer, '{searchTerms}' gibi bir şablon parametresi ise gerçek arama terimleri verisiyle değiştirilir.\n\nDefaultSearchProviderSearchURLPostParams politikası ayarlanmadan bırakılırsa istekler GET yöntemi kullanılarak gönderilir.";
DefaultSearchProviderSuggestURL.pfm_title = "Arama önerileri için varsayılan arama sağlayıcı URL'si";
DefaultSearchProviderSuggestURL.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderSuggestURL politikasının ayarlanması, arama önerileri sağlamak için kullanılan arama motorunun URL'sini belirler. URL, sorguda kullanıcının arama terimi ile değiştirilen '{searchTerms}' dizesini içermelidir.\n\nGoogle'ın arama URL'sini şu şekilde belirtebilirsiniz: '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "POST kullanan öneri URL'si parametreleri";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "DefaultSearchProviderEnabled açıksa DefaultSearchProviderSuggestURLPostParams protokolünün ayarlanması, POST ile öneri araması yaparken parametreleri belirtir. Virgülle ayrılmış ad-değer çiftlerini içerir. Değer, '{searchTerms}' gibi bir şablon parametresi ise gerçek arama terimleri verisiyle değiştirilir.\n\nDefaultSearchProviderSuggestURLPostParams politikası ayarlanmadan bırakılırsa öneri araması istekleri GET yöntemi kullanılarak gönderilir.";
DefaultSensorsSetting.pfm_title = "Varsayılan sensörler ayarı";
DefaultSensorsSetting.pfm_description = "1 - Sitelerin sensörlere erişmesine izin ver\n2 - Hiçbir sitenin sensörlere erişmesine izin verme\n3 - Bir site sensörlere erişmek istediğinde her zaman sor\nPolitikayı 1 değerine ayarlarsanız web siteleri, hareket ve ışık gibi sensörlere erişip bunları kullanabilir. Politikayı 2 değerine ayarlarsanız sensörlere erişim engellenir. Politikayı 3 değerine ayarlarsanız bir site sensörlere erişim isteğinde üç durumlu özellik bayrağı etkinse kullanıcıya sorar, değilse varsayılan olarak sensörlere erişime izin verir.\n\nPolitikayı ayarlamadan bırakırsanız AllowSensors politikası geçerli olur. Kullanıcılar bu ayarı değiştirebilir.";
DefaultSerialGuardSetting.pfm_title = "Serial API'sinin kullanımını kontrol et";
DefaultSerialGuardSetting.pfm_description = "2 - Hiçbir sitenin Serial API'si üzerinden seri bağlantı noktalarına erişim izni istemesine izin verme\n3 - Sitelerin, seri bağlantı noktasına erişmek için kullanıcıdan izin istemesine izin ver\nPolitikayı 3 değerine ayarlarsanız web siteleri seri bağlantı noktalarına erişim izni isteyebilir. Politikayı 2 değerine ayarlarsanız seri bağlantı noktalarına erişim izni verilmez.\n\nPolitikayı ayarlanmadan bırakırsanız web siteleri erişim izni isteyebilir. Kullanıcılar bu ayarı değiştirebilir.";
DefaultWebBluetoothGuardSetting.pfm_title = "Web Bluetooth API'sının kullanımını kontrol et";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - Hiçbir sitenin Web Bluetooth API'sı aracılığıyla Bluetooth hizmetlerine erişim istemesine izin verme\n3 - Sitelerin, yakınlardaki bir Bluetooth cihazına erişmek için kullanıcıdan izin istemesine izin ver\nPolitikayı 3 değerine ayarlamak web sitelerinin yakınlardaki Bluetooth cihazlarına erişim istemesini sağlar. Politikayı 2 değerine ayarlamak yakınlardaki Bluetooth cihazlarına erişimi kısıtlar.\n\nAyarlanmazsa politika açık kalır fakat kullanıcılar bu ayarı değiştirebilir.";
DefaultWebHidGuardSetting.pfm_title = "WebHID API'nin kullanımını kontrol et";
DefaultWebHidGuardSetting.pfm_description = "2 - Hiçbir sitenin WebHID API üzerinden HID cihazlara erişim istemesine izin verme\n3 - Sitelerin kullanıcıdan HID cihazlara erişim istemesine izin ver\nPolitikayı 3 değerine ayarlarsanız web siteleri HID cihazlara erişim izni isteyebilir. Politikayı 2 değerine ayarlarsanız HID cihazlara erişime izin verilmez.\n\nPolitikayı ayarlanmadan bırakırsanız web siteleri erişim izni isteyebilir. Kullanıcılar bu ayarı değiştirebilir.\n\nBu politika, WebHidAskForUrls ve WebHidBlockedForUrls politikaları kullanılarak belirli url kalıpları için geçersiz kılınabilir.";
DefaultWebUsbGuardSetting.pfm_title = "WebUSB API'sinin kullanımını kontrol et";
DefaultWebUsbGuardSetting.pfm_description = "2 - Hiçbir sitenin WebUSB API'si aracılığıyla USB cihazlarına erişim izni istemesine izin verme\n3 - Sitelerin, bağlı bir USB cihazına erişmek için kullanıcıdan izin istemesine izin ver\nPolitikayı 3 değerine ayarlamak web sitelerinin bağlı USB cihazlarına erişim istemesini sağlar. Politikayı 2 değerine ayarlamak bağlı USB cihazlarına erişimi engeller.\n\nPolitikayı ayarlamadan bırakmak web sitelerinin erişim istemesini sağlar. Kullanıcılar bu ayarı değiştirebilir.";
DefaultWindowManagementSetting.pfm_title = "Varsayılan pencere yönetimi izni ayarı";
DefaultWindowManagementSetting.pfm_description = "2 - Pencere yönetimi iznini tüm sitelerde varsayılan olarak reddeder\n3 - Siteler pencere yönetimi izni istediğinde her seferinde sor\nPolitika, BlockWindowManagement (2. değer) değerine ayarlanırsa sitelere pencere yönetimi izni verilmesini varsayılan olarak reddeder. Bu durumda sitelerin, cihazların ekranlarıyla ilgili bilgileri görme ve pencere açıp yerleştirmek ya da belirli ekranlarda tam ekran isteği iletmek için bu bilgileri kullanma imkanı kısıtlanmış olur.\n\nPolitika, AskWindowManagement (3. değer) değerine ayarlanırsa pencere yönetimi izni istendiğinde varsayılan olarak kullanıcıyı bilgilendirir. Kullanıcı izni verirse sitelerin, cihazların ekranlarıyla ilgili bilgileri görme ve pencere açıp yerleştirmek ya da belirli ekranlarda tam ekran isteği iletmek için bu bilgileri kullanma imkanı genişlemiş olur.\n\nPolitikayı ayarlamadan bırakırsanız AskWindowManagement politikası geçerli olur. Kullanıcılar bu ayarı değiştirebilir.\n\nBu politika, kullanımdan kaldırılan DefaultWindowPlacementSetting politikasının yerini almıştır.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Şifresi çözülemeyen şifreleri silmeyi etkinleştir";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Bu politika yerleşik şifre yöneticisinin, şifresi çözülemeyen şifreleri veritabanından silip silemeyeceğini kontrol eder. Bu, yerleşik şifre yöneticisinin tam işlevini geri yüklemek için gereklidir ancak kalıcı veri kaybına neden olabilir. Şifresi çözülemeyen şifre değerleri kendiliğinden şifresi çözülebilir hale gelmez ve düzeltilmeleri mümkünse genellikle karmaşık kullanıcı işlemleri yapılması gerekir.\n\nPolitika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar, yerleşik şifre yöneticisine kaydedilmiş şifresi çözülemeyen şifreleri kaybederler. Hâlâ çalışır durumda olan şifrelerde değişiklik yapılmaz.\n\nPolitika, Devre Dışı değerine ayarlanırsa kullanıcıların şifre yöneticisi verileri değişmez ancak şifre yöneticisi işlevleri bozulur.\n\nPolitika ayarlanırsa kullanıcılar bunu Brave ürününde değiştiremezler.";
DesktopSharingHubEnabled.pfm_title = "Çok amaçlı adres çubuğu ve 3 noktalı menüde masaüstü paylaşımını etkinleştir";
DesktopSharingHubEnabled.pfm_description = "Politika, Doğru değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar masaüstü paylaşım merkezi tarafından sağlanan işlemleri kullanarak mevcut web sayfasını paylaşabilir veya kaydedebilir. Paylaşım merkezine, çok amaçlı adres çubuğu simgesi veya 3 noktalı menü üzerinden erişilebilir.\n\nPolitika, Yanlış değerine ayarlanırsa paylaşım simgesi çok amaçlı adres çubuğundan, giriş de 3 noktalı menüden kaldırılır.";
DevToolsGenAiSettings.pfm_title = "Chrome DevTools üretken yapay zeka özellikleriyle ilgili ayarlar";
DevToolsGenAiSettings.pfm_description = "0 - Chrome DevTools üretken yapay zeka özelliklerine izin ver ve yapay zeka modellerini daha iyi hale getir.\n1 - Yapay zeka modellerini daha iyi hale getirmeden Chrome DevTools üretken yapay zeka özelliklerine izin ver.\n2 - Chrome DevTools üretken yapay zeka özelliklerine izin verme.\nChrome DevTools ürününün bu özellikleri, hata ayıklama ile ilgili ek bilgiler sağlamak için üretken yapay zeka modellerini kullanır. Bu özellikleri kullanmak için Brave ürününün hata mesajı, yığın izleme (stack trace), kod snippet'i ve ağ istekleri gibi verileri toplayıp Google'ın sahip olduğu ve üretken yapay zeka modeli kullanan bir sunucuya göndermesi gerekir. Ağ isteklerindeki yanıt gövdesi veya kimlik doğrulama ve çerez başlıkları, sunucuya gönderilen verilere dahil edilmez.\n\n0 = Özelliğin kullanılmasına izin verirken Google'ın yapay zeka modellerini iyileştirmek için ilgili verileri kullanmasına izin verir. İlgili veriler arasında özelliğe bağlı olarak istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler yer alabilir. Bu bilgiler, gerçek kişiler tarafından da yapay zeka modellerini iyileştirmek için incelenebilir. Aşağıdaki değerler belirtilmediği sürece varsayılan değer 0'dır.\n\n1 = Özelliğin kullanılmasına izin verir ancak Google'ın kullanıcıların içeriklerini (istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler dahil) kullanarak modelleri iyileştirmesine izin vermez. Google Admin console tarafından yönetilen kurumsal kullanıcılar ve Google Workspace tarafından yönetilen eğitim hesapları için varsayılan değer 1'dir.\n\n2 = Özelliğe izin vermez.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nAşağıdakiler Chrome DevTools üretken yapay zeka özellikleri arasındadır:\n\n- Konsol Analizleri: Konsol mesajlarını açıklar ve konsol hatalarının düzeltilmesine yönelik öneriler sunar.\n\n- Yapay zeka desteği: CSS stillerini (131. sürümden itibaren), ağ isteklerini, performansı ve dosyaları (tümü 132. sürümden itibaren) anlama konusunda yardım alın.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Chrome DevTools içinde Google Developer Program profillerini etkinleştirin";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Chrome DevTools içinde Google Developer Program entegrasyonunu etkinleştirin.\n1 - Chrome DevTools içinde Google Developer Program entegrasyonunu etkinleştirin ancak araç kullanımını paylaşmayın (rozet kazanmak için).\n2 - Chrome DevTools içinde Google Developer Program entegrasyonunu etkinleştirmeyin.\nBu politika, Google Developer Program'ın Chrome DevTools ile entegrasyonunu kontrol eder. Kullanıcının Google Developer Program profili Chrome DevTools içinde gösterilir ve kullanıcılar Chrome DevTools içinde belirli işlemleri gerçekleştirdiklerinde rozet kazanır.\n\nPolitika, 0 (Etkin) olarak ayarlanırsa veya herhangi bir politika değeri ayarlanmazsa Google Developer Program'ın Chrome DevTools ile entegrasyonuna izin verilir ve rozet verilebilmesi için Chrome DevTools araç kullanımının paylaşılmasına izin verilir.\n\nPolitika, 1 - \"Rozetler olmadan etkin\" olarak ayarlanırsa Google Developer Program'ın Chrome DevTools ile entegrasyonuna izin verilir ancak Chrome DevTools araç kullanımının Google Developer Program ile paylaşılmasına izin verilmez. Rozet verilmeyecek.\n\nPolitika, 2 - \"Devre Dışı\" değerine ayarlanırsa Google Developer Program'ın Chrome DevTools ile entegrasyonuna izin verilmez.";
DeveloperToolsAvailability.pfm_title = "Chrome DevTools aracının kullanılabileceği yerleri kontrol et";
DeveloperToolsAvailability.pfm_description = "0 - Kurumsal politikaya göre ya da 114 sürümünden itibaren yüklenen uygulama ve uzantılarda, yönetilen bir kullanıcı hesabı olması durumunda da tarayıcıda yerleşik olarak bulunan uzantılarda Chrome DevTools kullanımına izin verme. Diğer bağlamlarda Chrome DevTools kullanımına izin ver\n1 - Chrome DevTools tarayıcısının kullanımına izin ver\n2 - Chrome DevTools kullanımına izin verme\nPolitika, 0 (varsayılan) değerine ayarlanırsa Chrome DevTools ve JavaScript konsoluna erişebilirsiniz. Ancak kurumsal politikaya göre ya da 114 sürümünden itibaren yüklenen uzantılar, yönetilen bir kullanıcı hesabı olması durumunda da tarayıcıda yerleşik olarak bulunan uzantıların bağlamında bu erişimi sağlayamazsınız. Politika, 1 değerine ayarlanırsa kurumsal politikaya göre yüklenen uzantıların bağlamı dahil tüm bağlamlarda Chrome DevTools ve JavaScript konsoluna erişebilirsiniz. Politika, 2 değerine ayarlanırsa Chrome DevTools aracına erişemezsiniz ve web sitesi öğelerini inceleyemezsiniz.\n\nBu ayar, Chrome DevTools veya JavaScript konsolunu açmak için klavye kısayollarını ve menü veya bağlam menüsü girişlerini de kapatır.\n\nBu ayar, Brave sürüm 99'dan itibaren \"Sayfa kaynağını görüntüle\" özelliği için giriş noktalarını da kontrol eder. Bu politikayı \"DeveloperToolsDisallowed\" (2 değeri) olarak ayarlarsanız kullanıcılar klavye kısayollarını veya içerik menüsünü kullanarak kaynak görüntülemeye erişemez. Kaynak görüntülemeyi tamamen engellemek için URLBlocklist politikasına \"view-source:*\" ifadesini de eklemeniz gerekir.\n\nBu ayar, Brave sürüm 119'dan itibaren yalıtılmış web uygulamaları için geliştirici modunun etkinleştirilip kullanılmasını da kontrol eder.\n\nBu ayar, Brave sürüm 128'den itibaren ExtensionDeveloperModeSettings politikası ayarlanırsa uzantılar sayfasında geliştirici modunu kontrol etmez.\n\nBu politika; Chrome DevTools, doğrudan Chrome Geliştirici Araçları Protokolü (CDP) erişimi (örneğin, --remote-debugging-port veya --remote-debugging-pipe ile başlatıldığında) ve chrome.debugger API'leri aracılığıyla Chrome Geliştirici Araçları Protokolü (CDP) erişimini etkiler. Hem bu politika hem de RemoteDebuggingAllowed politikası geçerlidir: RemoteDebuggingAllowed, uzaktan hata ayıklamanın başlatılıp başlatılamayacağını kontrol eder. Bu politika ise uzaktan hata ayıklama çalışırken bile tek tek hedeflerin incelenip incelenemeyeceğini kısıtlar.\n\nDeveloperToolsAvailabilityAllowlist ve DeveloperToolsAvailabilityBlocklist politikaları, bu politikaya göre daha önceliklidir. Chrome DevTools kullanılabilirliği aşağıdaki öncelik sırasına göre belirlenir:\n\n1. Bir URL, DeveloperToolsAvailabilityAllowlist politikasındaki bir kalıpla eşleşirse Chrome DevTools için izin verilir.\n2. DeveloperToolsAvailabilityAllowlist ayarlanır ve DeveloperToolsAvailabilityBlocklist ayarlanmazsa izin verilenler listesinde yer almayan tüm URL'ler engellenir.\n3. Bir URL, DeveloperToolsAvailabilityBlocklist politikasındaki bir kalıpla eşleşirse Chrome DevTools engellenir.\n4. İki politika da ayarlanmazsa veya bir URL hiçbir listeyle eşleşmezse yedek mekanizma olarak bu politika (DeveloperToolsAvailability) kullanılır.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Chrome DevTools kullanılmasına izin verilen URL kalıplarının listesi";
DeveloperToolsAvailabilityAllowlist.pfm_description = "Bu politika, belirli URL'lerde Chrome DevTools kullanmaya izin vermek için kullanılabilir.\n\nChrome DevTools kullanılabilirliği, hedef düzeyinde değerlendirilir. URL kalıpları, incelenen her hedefin (ör. bir sayfanın ana çerçevesi, yerleştirilmiş alt çerçeve, uzantı veya web uygulaması) URL'siyle eşleştirilir. Sonuçtaki davranış, DeveloperToolsAvailabilityBlocklist politikasının da ayarlanıp ayarlanmadığına bağlıdır.\n\nBu politika ayarlanır ve DeveloperToolsAvailabilityBlocklist ayarlanmazsa bir hedefte Chrome DevTools kullanımına izin verilebilmesi için bu hedefin URL'sinin bu izin verilenler listesindeki bir kalıpla eşleşmesi gerekir. Bir hedefin URL'si bu izin verilenler listesiyle eşleşmezse Chrome DevTools bu hedef için engellenir (örneğin, URL'si izin verilenler listesinde olmayan bir alt çerçeve incelenemez ancak URL'si izin verilenler listesinde olan ana sayfa incelenebilir). URL biçimi hakkında bilgi için https://support.google.com/chrome/a?p=url_blocklist_filter_format adresine bakın.\n\nHem bu politika hem de DeveloperToolsAvailabilityBlocklist politikası ayarlanırsa bu izin verilenler listesi öncelikli olur. Bir hedefin URL'si bu izin verilenler listesindeki bir kalıpla eşleşirse engellenenler listesindeki bir kalıpla eşleşse bile URL'ye izin verilir. Bir hedefin URL'si, bu engellenenler listesindeki bir kalıpla eşleşir ancak izin verilenler listesindeki bir kalıpla bu hedef eşleşmezse engellenir. Bir hedefin URL'si hiçbiriyle eşleşmezse yedek olarak DeveloperToolsAvailability politikası kullanılır.\n\nBu politika ayarlanmazsa Chrome DevTools kullanılabilirliği DeveloperToolsAvailabilityBlocklist ve DeveloperToolsAvailability politikalarına göre belirlenir.\n\nGeniş kapsamlı ana makine joker karakterlerine (ör. \"*\" veya \"[*]\") izin verilmez. Özelliği dünya genelinde etkinleştirmek için DeveloperToolsAvailability politikasını kullanın.\n\nBu politika; Chrome DevTools, doğrudan Chrome Geliştirici Araçları Protokolü (CDP) erişimi (örneğin, --remote-debugging-port veya --remote-debugging-pipe ile başlatıldığında) ve chrome.debugger API'leri aracılığıyla Chrome Geliştirici Araçları Protokolü (CDP) erişimini etkiler. Hem bu politika hem de RemoteDebuggingAllowed politikası geçerlidir: RemoteDebuggingAllowed, uzaktan hata ayıklamanın başlatılıp başlatılamayacağını kontrol eder. Bu politika ise uzaktan hata ayıklama çalışırken bile tek tek hedeflerin incelenip incelenemeyeceğini kısıtlar.\n\nBu politika 1.000 giriş ile sınırlıdır.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Chrome DevTools kullanmanın engellendiği URL kalıplarının listesi";
DeveloperToolsAvailabilityBlocklist.pfm_description = "Bu politika, belirli URL'lerde Chrome DevTools kullanımını engellemek için kullanılabilir. URL biçimi hakkında bilgi için https://support.google.com/chrome/a?p=url_blocklist_filter_format adresine bakın.\n\nChrome DevTools kullanılabilirliği, hedef düzeyinde değerlendirilir. URL kalıpları, incelenen her hedefin (ör. bir sayfanın ana çerçevesi, yerleştirilmiş alt çerçeve, uzantı veya web uygulaması) URL'siyle eşleştirilir. Sonuçtaki davranış, DeveloperToolsAvailabilityAllowlist politikasının da ayarlanıp ayarlanmadığına bağlıdır.\n\nBu politika ayarlanır ve DeveloperToolsAvailabilityAllowlist ayarlanmazsa bu engellenenler listesindeki kalıpla eşleşen bir hedefin URL'si, ilgili hedef için Chrome DevTools kullanımını engeller (örneğin, URL'si bu engellenenler listesiyle eşleşen bir alt çerçeve incelenemez ancak URL'si engellenenler listesinde değilse ana sayfa incelenebilir). Bir hedefin URL'si hiçbir kalıpla eşleşmiyorsa kullanılabilirlik, DeveloperToolsAvailability politikasına göre belirlenir.\n\nHem bu politika hem de DeveloperToolsAvailabilityAllowlist politikası ayarlanırsa bu izin verilenler listesi öncelikli olur. Bir hedefin URL'si izin verilenler listesindeki kalıpla eşleşirse bu engellenenler listesindeki bir kalıpla eşleşse bile URL'ye izin verilir. Bir hedefin URL'si, bu engellenenler listesindeki bir kalıpla eşleşir ancak izin verilenler listesindeki bir kalıpla bu hedef eşleşmezse engellenir. Bir hedefin URL'si hiçbiriyle eşleşmezse yedek olarak DeveloperToolsAvailability politikası kullanılır.\n\nBu politika ayarlanmazsa Chrome DevTools kullanılabilirliği DeveloperToolsAvailabilityAllowlist ve DeveloperToolsAvailability politikalarına göre belirlenir.\n\nBu politika; Chrome DevTools, doğrudan Chrome Geliştirici Araçları Protokolü (CDP) erişimi (örneğin, --remote-debugging-port veya --remote-debugging-pipe ile başlatıldığında) ve chrome.debugger API'leri aracılığıyla Chrome Geliştirici Araçları Protokolü (CDP) erişimini etkiler. Hem bu politika hem de RemoteDebuggingAllowed politikası geçerlidir: RemoteDebuggingAllowed, uzaktan hata ayıklamanın başlatılıp başlatılamayacağını kontrol eder. Bu politika ise uzaktan hata ayıklama çalışırken bile tek tek hedeflerin incelenip incelenemeyeceğini kısıtlar.\n\nBu politika 1.000 giriş ile sınırlıdır.";
Disable3DAPIs.pfm_title = "3D grafik API'ları için desteği devre dışı bırak";
Disable3DAPIs.pfm_description = "Politika, Doğru değerine ayarlanırsa (veya HardwareAccelerationModeEnabled, Yanlış değerine ayarlanırsa) web sayfalarının WebGL API'ye erişimi engellenir.\n\nPolitika, Yanlış değerine ayarlanırsa veya ayarlanmadan bırakılırsa web sayfaları WebGL API'yi kullanabilir. Bu API'leri kullanmak için tarayıcının varsayılan ayarları yine de komut satırı bağımsız değişkenlerini gerektirebilir.";
DisableAuthNegotiateCnameLookup.pfm_title = "Kerberos kimlik doğrulaması anlaşmasını yaparken CNAME aramasını devre dışı bırak";
DisableAuthNegotiateCnameLookup.pfm_description = "Politika, Etkin değerine ayarlanırsa CNAME araması atlanır. Kerberos SPN oluşturulurken sunucu adı girildiği şekliyle kullanılır.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa CNAME araması, Kerberos SPN'i oluşturulurken sunucunun standart adını belirler.";
DisablePrintPreview.pfm_title = "Baskı Önizlemeyi Devre Dışı Bırak";
DisablePrintPreview.pfm_description = "Politika, Etkin değerine ayarlanırsa kullanıcılar çıktı almak istediğinde Brave, yerleşik baskı önizleme yerine sistemin yazdırma iletişim kutusunu açar.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa yazdırma komutları, baskı önizleme ekranını tetikler.";
DisableSafeBrowsingProceedAnyway.pfm_title = "Güvenli Tarama uyarı sayfasından ilerlemeyi devre dışı bırak";
DisableSafeBrowsingProceedAnyway.pfm_description = "Politika Etkin değerine ayarlanırsa kullanıcıların Güvenli Tarama hizmeti tarafından gösterilen uyarı sayfasını geçerek kötü amaçlı siteye ilerlemeleri engellenir. Bu politika yalnızca, kullanıcıların kötü amaçlı yazılım ve kimlik avı gibi Güvenli Tarama uyarılarından öteye geçmelerini önler. SSL sertifikasıyla ilgili sorunlar (ör. geçersiz veya süresi dolmuş sertifikalar) konusunda etkili değildir.\n\nPolitika Devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa uyarı gösterildikten sonra kullanıcılar işaretli siteye ilerleyebilirler.\n\nGüvenli tarama hakkında daha fazla bilgi edinin (https://developers.google.com/safe-browsing).";
DisableScreenshots.pfm_title = "Ekran görüntüleri almayı devre dışı bırak";
DisableScreenshots.pfm_description = "Politika, Etkin değerine ayarlandığında klavye kısayolları veya uzantı API'leriyle ekran görüntüsü alınmasına izin verilmez. Politika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa ekran görüntülerine izin verilir.\n\nBrave 154. sürümünden itibaren bu politikanın etkinleştirilmesi, uzantıların \"chrome.debugger.attach()\" aracılığıyla hata ayıklayıcı eklemesini de engeller.\n\nBu politikanın Microsoft® Windows®, macOS ve Linux üzerinde işletim sistemi veya üçüncü taraf uygulamalarıyla alınan ekran görüntülerini engellemediğini aklınızda bulundurun.";
DiskCacheDir.pfm_title = "Disk önbellek dizinini ayarla";
DiskCacheDir.pfm_description = "Politika ayarlanırsa Brave, önbelleğe alınan dosyaları diskte depolamak için (kullanıcıların --disk-cache-dir bayrağını belirtip belirtmemelerinden bağımsız olarak) sağladığınız dizini kullanır.\n\nAyarlanmazsa Brave, varsayılan önbellek dizinini kullanır, ancak kullanıcılar --disk-cache-dir komut satırı bayrağını kullanarak bu ayarı değiştirebilirler.\n\nBrave, birimin kök dizininin içeriğini yönetir. Bu nedenle veri kaybını veya diğer hataları önlemek için bu politikayı kök dizine veya başka amaçlarla kullanılan herhangi bir dizine ayarlamayın. Kullanabileceğiniz değişkenlere bakın (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DiskCacheSize.pfm_title = "Disk önbellek boyutunu ayarla";
DiskCacheSize.pfm_description = "Politika \"Yok\" seçeneğine ayarlandığında, Brave önbelleğe alınan dosyaları diskte depolamak için varsayılan önbellek boyutunu kullanır. Kullanıcılar bunu değiştiremezler.\n\nPolitikayı ayarlarsanız Brave (kullanıcıların --disk-cache-size flag'ini belirtip belirtmediklerinden bağımsız olarak) sağladığınız önbellek boyutunu kullanır. (Birkaç megabaytın altındaki değerler yukarı yuvarlanır.)\n\nAyarlanmazsa Brave varsayılan boyutu kullanır. Kullanıcılar bu ayarı --disk-cache-size flag'ini kullanarak değiştirebilirler.\n\nNot: Bu politikada belirtilen değer, tarayıcıdaki çeşitli önbellek alt sistemleri için bir ipucu olarak kullanılır. Bu nedenle, tüm önbelleklerin gerçekteki toplam disk kullanımı daha yüksek olsa da belirtilen değerle aynı büyüklük sırasında olacaktır.";
DnsOverHttpsMode.pfm_title = "DNS-over-HTTPS modunu denetler";
DnsOverHttpsMode.pfm_description = "off - DNS-over-HTTPS modunu devre dışı bırak\nautomatic - DNS-over-HTTPS'i güvenli olmayan geçişle etkinleştir\nsecure - DNS-over-HTTPS'i güvenli olmayan geçiş olmadan etkinleştir\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "İstenen DNS-over-HTTPS çözümleyicisinin URI şablonunu belirler";
DnsOverHttpsTemplates.pfm_description = "İstenen DNS-over-HTTPS çözümleyicisinin URI şablonu. Birden fazla DNS-over-HTTPS çözümleyicisi belirlemek için karşılık gelen URI şablonlarını boşlukla ayırın.\n\nDnsOverHttpsMode, \"secure\" olarak ayarlanırsa bu politika ayarlanmalı, boş bırakılmamalıdır. Yalnızca Google Chrome OS işletim sisteminde bu politika veya DnsOverHttpsTemplatesWithIdentifiers ayarlanmalıdır. Aksi takdirde DNS çözümleme yapılamaz.\n\nDnsOverHttpsMode, \"automatic\" olarak ayarlandıysa ve bu politika da ayarlanırsa belirtilen URI şablonları kullanılır. Bu politika ayarlanmadan bırakılırsa kullanıcının geçerli DNS çözümleyicisini aynı sağlayıcı tarafından işletilen bir DoH çözümleyiciye yükseltmek için koda gömülmüş eşleşmeler kullanılır.\n\nURI şablonu dns değişkeni içeriyorsa çözümleyiciye gelen istekler GET yöntemini kullanır; aksi takdirde istekler POST yöntemini kullanır.\n\nYanlış biçimlendirilmiş şablonlar yok sayılır.";
DomainReliabilityAllowed.pfm_title = "Alan güvenilirliğiyle ilgili verilerin raporlanmasına izin ver";
DomainReliabilityAllowed.pfm_description = "Bu politika Yanlış değerine ayarlanırsa alan güvenilirliği teşhis verilerinin raporlanması devre dışı bırakılır ve Google'a hiçbir veri gönderilmez.\nBu politika Doğru değerine ayarlanır veya ayarlanmadan bırakılırsa alan güvenilirliği teşhis verilerinin raporlanması, Brave için MetricsReportingEnabled veya Google Chrome OS için DeviceMetricsReportingEnabled davranışını izler.";
DownloadDirectory.pfm_title = "İndirme dizinini ayarla";
DownloadDirectory.pfm_description = "Politika ayarlanırsa Chrome'un dosya indirmek için kullandığı dizin yapılandırılır. Chrome, kullanıcıların bir dizin belirtmesine veya her seferinde indirme konumunun sorulmasını sağlayan işareti etkinleştirmiş olmasına bakılmaksızın burada sağlanan dizini kullanır.\n\nBu politika DefaultDownloadDirectory politikasını geçersiz kılar.\n\nPolitika ayarlanmadan bırakılırsa Chrome varsayılan indirme dizinini kullanır ve kullanıcılar bunu değiştirebilir.\n\nGoogle Chrome OS sisteminde bunu yalnızca Google Drive dizinlerini içerecek şekilde ayarlamak mümkündür.\n\nNot: Kullanabileceğiniz değişkenlerin listesine bakın (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DownloadRestrictions.pfm_title = "İndirme kısıtlamaları";
DownloadRestrictions.pfm_description = "0 - Özel kısıtlama yok. Varsayılan.\n1 - Kötü amaçlı indirmeleri ve tehlikeli dosya türlerini engelle.\n2 - Kötü amaçlı indirmeleri, yaygın olmayan veya istenmeyen indirmeleri ve tehlikeli dosya türlerini engelle.\n3 - Tüm indirmeleri engelle.\n4 - Kötü amaçlı indirmeleri engelle. Önerilen.\nPolitika ayarlanırsa kullanıcılar indirme güvenliği kararlarını atlayamaz.\n\nChrome'da birçok farklı indirme uyarısı vardır. Bu uyarılar genel olarak aşağıdaki gibi sınıflandırılabilir (Güvenli Tarama sonuçları hakkında daha fazla bilgi https://support.google.com/chrome/?p=ib_download_blocked):\n\n* Kötü amaçlı (Güvenli Tarama sunucusu tarafından işaretlendiği gibi)\n* Yaygın olmayan veya istenmeyen (Güvenli Tarama sunucusu tarafından işaretlendiği gibi)\n* Tehlikeli dosya türü (ör. SWF indirmelerinin tümü ve EXE indirmelerinin birçoğu)\n\nPolitika ayarlanırsa, değerine bağlı olarak bu kategorilerin farklı alt grupları engellenir:\n\n0: Özel kısıtlama yok. Varsayılan.\n\n1: Güvenli Tarama sunucusu tarafından işaretlenen kötü amaçlı dosyaları VE tehlikeli dosya türlerinin tümünü engeller. Tehlikeli olmayan dosyaların yanlışlıkla tehlikeli olarak sınıflandırılıp engellenmesine tolerans gösterebilecek kuruluş birimleri/tarayıcılar/kullanıcılar dışındakilere önerilmez.\n\n2: Güvenli Tarama sunucusu tarafından işaretlenen kötü amaçlı dosyaları, Güvenli Tarama sunucusu tarafından işaretlenen yaygın olmayan ya da istenmeyen dosyaları VE tehlikeli dosya türlerinin tümünü engeller. Tehlikeli olmayan dosyaların yanlışlıkla tehlikeli olarak sınıflandırılıp engellenmesine tolerans gösterebilecek kuruluş birimleri/tarayıcılar/kullanıcılar dışındakilere önerilmez.\n\n3: Tüm indirmeleri engeller. Özel kullanım alanları hariç önerilmez.\n\n4: Güvenli Tarama sunucusu tarafından işaretlenen kötü amaçlı dosyaları engeller, tehlikeli dosya türlerini engellemez. Önerilir.\n\nNot: Bu kısıtlamalar hem web sayfası içeriğinden hem de İndirme bağlantısı… menü seçeneğinden tetiklenen indirmeler için geçerlidir. Görüntülenmekte olan sayfayı indirme ya da yazdırma seçeneklerinden PDF olarak kaydetme için geçerli değildir. Güvenli tarama hakkında daha fazla bilgi edinin (https://developers.google.com/safe-browsing).";
EditBookmarksEnabled.pfm_title = "Yer işareti düzenlemesini etkinleştir veya devre dışı bırak";
EditBookmarksEnabled.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar yer işaretleri ekleyebilir, kaldırabilir, değiştirebilir veya yükleyebilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa kullanıcılar yer işaretleri ekleyemez, kaldıramaz, değiştiremez veya yükleyemez. Mevcut yer işaretlerini kullanmaya devam edebilirler.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Kerberos SPN'sine standart dışı bağlantı noktasını dahil et";
EnableAuthNegotiatePort.pfm_description = "Politika, Etkin değerine ayarlanır ve standart olmayan bir bağlantı noktası girilirse (yani 80 veya 443'ten başka bir bağlantı noktası) politika, oluşturulan Kerberos SPN'ine dahil edilir.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa oluşturulan Kerberos SPN'ine bağlantı noktası dahil edilmez.";
EnableExperimentalPolicies.pfm_title = "Deneysel politikaları etkinleştirir";
EnableExperimentalPolicies.pfm_description = "Brave ürününün deneysel politikaları yüklemesine izin verir.\n\nUYARI: Deneysel politikalar desteklenmez ve tarayıcının gelecekteki sürümünde bildirimde bulunmaksızın değiştirilebilir veya kaldırılabilir.\n\nDeneysel bir politika tamamlanmamış olabilir veya hâlâ bilinen ya da bilinmeyen kusurlar içerebilir. Herhangi bir bildirimde bulunulmadan değiştirilebilir, hatta kaldırılabilir. Deneysel politikaları etkinleştirdiğinizde tarayıcı verileri kaybolabilir ya da güvenliğiniz veya gizliliğiniz ihlal edilebilir.\n\nListede olmayan bir politika resmi olarak yayınlanmadıysa Beta ve Mevcut ürün kanalında politikanın değeri göz ardı edilir.\n\nListede yer alan bir politika resmi olarak yayınlanmadıysa politikanın değeri geçerli olur.\n\nBu politikanın önceden yayınlanmış politikalar üzerinde bir etkisi yoktur.";
EnableMediaRouter.pfm_title = "Google Cast ürününü etkinleştirin";
EnableMediaRouter.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Google Cast açılır. Kullanıcılar cihazı uygulama menüsünden, sayfaların içerik menüsünden, Cast uyumlu web sitelerindeki medya kontrollerinden ve (gösteriliyorsa) Cast araç çubuğu simgesinden başlatabilir.\n\nPolitika, Devre dışı değerine ayarlanırsa Google Cast kapatılır.";
EnableOnlineRevocationChecks.pfm_title = "Online OCSP/CRL denetimlerini etkinleştir";
EnableOnlineRevocationChecks.pfm_description = "Politika True (Doğru) değerine ayarlandığında online OCSP/CRL denetimleri yapılır.\n\nPolitika False (Yanlış) değerine ayarlanır veya hiç ayarlanmazsa Brave online iptal etme denetimlerini Brave 19 ve sonraki sürümler için yapmaz.\n\nNot: OCSP/CRL denetimleri güvenlik açısından verimli değildir.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "ProxyOverrideRules ve ProxyProvisioningDomains politikalarının hangi yönetilen kullanıcı hesapları tarafından ayarlayabileceğini kontrol eder.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Bu politika 0 değerine ayarlanır veya ayarlanmadan bırakılırsa ProxyOverrideRules ve ProxyProvisioningDomains politikaları yalnızca yönetilen bir tarayıcıdaki ilişkili kullanıcılar için kullanıcı kapsamına uygulanır.\nBu politika 1 değerine ayarlanırsa ProxyOverrideRules ve ProxyProvisioningDomains politikaları, ilişkili olmayan kullanıcılar için bile kullanıcı kapsamına uygulanır.";
EnableUnsafeSwiftShader.pfm_title = "SwiftShader kullanarak yazılım WebGL yedeğine izin ver";
EnableUnsafeSwiftShader.pfm_description = "Donanım GPU hızlandırması kullanılamadığında SwiftShader'ın WebGL yedeği olarak kullanılıp kullanılmayacağını kontrol eden bir politika.\n\nSwiftShader, GPU hızlandırması olmayan sistemlerde (ör. gözetimsiz sistemler veya sanal makineler) WebGL'yi desteklemek için kullanılıyordu ancak güvenlik sorunları nedeniyle desteği sonlandırıldı. M139'dan itibaren, SwiftShader'in kullanılacağı durumlarda WebGL bağlamı oluşturulması başarısız olacaktır. Bu politika, tarayıcının veya yöneticinin desteği sonlandırma işlemini geçici olarak ertelemesine olanak tanır.\n\nPolitika, Etkin değerine ayarlanırsa SwiftShader, yazılım WebGL yedeği olarak kullanılır.\n\nPolitika, Devre Dışı değerine ayarlanırsa veya ayarlanmadan bırakılırsa ve donanım GPU hızlandırması kullanılamıyorsa WebGL bağlamı oluşturulamaz. WebGL bağlamı oluşturma hatasını düzgün şekilde ele almayan web sayfaları hatalı davranabilir.\n\nBu politika geçicidir ve gelecekte kaldırılacaktır.";
EncryptedClientHelloEnabled.pfm_title = "TLS Encrypted ClientHello'yu etkinleştir";
EncryptedClientHelloEnabled.pfm_description = "Encrypted ClientHello (ECH), ClientHello'un hassas alanlarını şifrelemek ve gizliliği iyileştirmek için kullanılan bir TLS uzantısıdır.\n\nBu politika yapılandırılmazsa veya etkin değerine ayarlanırsa Brave, ECH için varsayılan kullanıma sunma işlemini uygular. Politika, devre dışı değerine ayarlanırsa Brave, ECH'yi etkinleştirmez.\n\nBu özellik etkinleştirildiğinde sunucu desteğine, HTTPS DNS kaydının kullanılabilirliğine veya kullanıma sunma durumuna bağlı olarak Brave, ECH'yi kullanabilir veya kullanmayabilir.\n\nECH, sürekli gelişen bir protokol olduğu için Brave hizmetinin uygulama sürecinde değişiklikler yapılabilir. Dolayısıyla bu politika ilk deneysel uygulama sürecini kontrol etmek için kullanıma sunulmuş geçici bir önlemdir. Protokol kesinleştiğinde politika da son kontrollere göre değiştirilecektir.";
EnterpriseCustomLabel.pfm_title = "Yönetilen profil için özel kurumsal etiket ayarla";
EnterpriseCustomLabel.pfm_description = "Bu politika, yönetilen profilleri tanımlamak için kullanılan özel bir etiket ekler. Yönetilen profillerde bu etiket, araç çubuğundaki avatarın yanında gösterilir. Özel etiket çevrilmez.\n\nBu politika uygulandığında 16 karakterden uzun olan tüm dizeler \"...\" ile kısaltılır. Lütfen uzun adlar kullanmaktan kaçının.\n\nBu politika yalnızca kullanıcı politikası olarak ayarlanabilir.\n\nEnterpriseProfileBadgeToolbarSettings politikası hide_expanded_enterprise_toolbar_badge (1 değeri) olarak ayarlanırsa bu politikanın etkisi olmaz.";
EnterpriseCustomLabelForBrowser.pfm_title = "Yönetilen tarayıcı için özel kurumsal etiket ayarla";
EnterpriseCustomLabelForBrowser.pfm_description = "Bu politika, yönetilen tarayıcıları belirtmek için kullanılan özel etiketi kontrol eder. Yönetilen tarayıcılarda bu etiket, Yeni Sekme sayfasının altbilgi bölümündeki yönetim sorumluluk reddi beyanında gösterilir. Özel etiket çevrilmez.\n\nBu politikanın yalnızca yönetilen tarayıcılar için geçerli olduğunu ve yönetilmeyen tarayıcılardaki yönetilen kullanıcı hesaplarını etkilemediğini unutmayın.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Yönetilen uzantıların Kurumsal Donanım Platformu API'sini kullanmasını sağlar";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Politika True (Doğru) değerine ayarlandığında kurumsal politika tarafından yüklenen uzantıların Kurumsal Donanım Platformu API'sini kullanmasına izin verilir.\n\nPolitika False (Yanlış) değerine ayarlandığında veya ayarlanmadan bırakıldığında uzantıların bu API'yı kullanmasına izin verilmez.\n\nBu politika, Hangout Hizmetleri uzantısı gibi bileşen uzantıları için de geçerlidir.";
EnterpriseLogoUrl.pfm_title = "Yönetilen profilin kurumsal logo URL'si";
EnterpriseLogoUrl.pfm_description = "Yönetilen profilde kurumsal rozet olarak kullanılacak resmin URL'sidir. URL bir resme yönlendirmelidir.\n\nBu politika yalnızca kullanıcı politikası olarak ayarlanabilir.\n\nSite simgesini (ör. https://www.google.com/favicon.ico) veya 48 x 48 pikselden küçük olmayan bir simgeyi kullanmanız önerilir.";
EnterpriseLogoUrlForBrowser.pfm_title = "Yönetilen tarayıcının kurumsal logo URL'si";
EnterpriseLogoUrlForBrowser.pfm_description = "Yönetilen profilde kurumsal rozet olarak kullanılacak resmin URL'sidir. URL bir resme yönlendirmelidir.\n\nSite simgesini (ör. https://www.google.com/favicon.ico) veya 48 x 48 pikselden küçük olmayan bir simgeyi kullanmanız önerilir.\n\nBu politikanın yalnızca yönetilen tarayıcılar için geçerli olduğunu ve yönetilmeyen tarayıcılardaki yönetilen kullanıcı hesaplarını etkilemediğini unutmayın.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Araç çubuğundaki kurumsal profil rozetinin görünürlüğünü kontrol eder";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Genişletilmiş kurumsal araç çubuğu rozetini göster\n1 - Araç çubuğunda genişletilmiş kurumsal rozeti gizle\nİş ve okul profillerinde, araç çubuğu avatarının yanında varsayılan olarak \"İş\" veya \"Okul\" etiketi gösterilir. Etiket yalnızca oturum açılan hesap yönetilen bir hesap olduğunda gösterilir.\n\nBu politika hide_expanded_enterprise_toolbar_badge (1 değeri) olarak ayarlanırsa araç çubuğundaki yönetilen profil için kurumsal rozet gizlenir.\n\nBu politika ayarlanmadan bırakılır veya show_expanded_enterprise_toolbar_badge (0 değeri) olarak ayarlanırsa kurumsal rozet gösterilir.\n\nEtiket, EnterpriseCustomLabel politikası kullanılarak özelleştirilebilir.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "Kurumsal profil oluştururken tarama verilerini varsayılan olarak sakla";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Bu politika Etkin değerine ayarlanırsa kurumsal profil oluştururken, mevcut tarama verilerini saklama seçeneği varsayılan olarak işaretlenir.\n\nBu politika ayarlanmaz veya Devre Dışı değerine ayarlanırsa kurumsal profil oluştururken, mevcut tarama verilerini saklama seçeneği varsayılan olarak işaretlenmez.\n\nDeğerden bağımsız olarak kullanıcılar, kurumsal profil oluştururken mevcut tarama verilerinin saklanıp saklanmayacağına karar verebilir.\n\nKurumsal profil ayrımının katı bir şekilde zorunlu tutulması ya da ilgili verilerin halihazırda yönetilen bir profilden gelmesi halinde, mevcut tarama verilerini saklama seçeneği sunulmaz ve bu politika etkili olmaz.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Kurumsal arama toplayıcı ayarları";
EnterpriseSearchAggregatorSettings.pfm_description = "Bu politikayla yöneticiler, çok amaçlı adres çubuğunda (adres çubuğu) ve yeni sekme sayfasındaki arama kutusunda arama önerileri ve sonuçlar gösteren bir kurumsal arama toplayıcı belirleyebilir.\n\nKurumsal arama önerileri varsayılan olarak karıştırılır ve normal Brave önerileriyle birlikte gösterilir. Kullanıcılar, shortcut alanında belirtilen anahtar kelimeyi başına @ ekleyerek veya eklemeden (ör. @work) yazıp ardından çok amaçlı adres çubuğunda Boşluk veya Sekme tuşuna basarak aramalarının kapsamını yalnızca kuruluş arama toplayıcısıyla açıkça sınırlayabilir. Kapsamı sınırlanmış kurumsal aramalar (anahtar kelimeyle tetiklenir) şu anda yalnızca çok amaçlı adres çubuğunda desteklenir ve yeni sekme sayfasındaki arama kutusunda desteklenmez.\n\nŞu alanlar gereklidir: name, shortcut, search_url, suggest_url.\n\nname alanı, adres çubuğunda kullanıcıya gösterilen arama motoru adına karşılık gelir.\n\nshortcut alanı, kullanıcının aramayı tetiklemek için girdiği anahtar kelimeye karşılık gelir. Kısayol düz kelimeler ve karakterler içerebilir, ancak boşluk içeremez veya @ sembolüyle başlayamaz. Kısayollar benzersiz olmalıdır.\n\nsearch_url alanı, aramanın yapılacağı URL'yi belirtir. Arama motoru sonuç sayfasının web adresini girin ve sorgu alanında '{searchTerms}' öğesini kullanın.\n\nsuggest_url alanı, arama önerileri sağlayan URL'yi belirtir. Aksi takdirde POST isteği yapılır ve kullanıcının sorgusu, 'query' anahtarının altındaki POST parametrelerinde iletilir.\n\nicon_url alanı, arama önerilerinde kullanılacak resmin URL'sini belirtir. Bu alan ayarlanmadığında varsayılan simge kullanılır. Site simgesi (ör. https://www.google.com/favicon.ico) kullanılması önerilir. Desteklenen resim dosyası biçimleri: JPEG, PNG ve ICO.\n\nrequire_shortcut alanı, arama önerilerini görmek için adres çubuğunun (shortcut) gerekli olup olmadığını belirtir. Gerekirse yeni sekme sayfasındaki arama kutusunda öneri gösterilmez ancak kapsamı sınırlanmış arama modundayken çok amaçlı adres çubuğunda (adres çubuğu) gösterilmeye devam eder. Bu alan ayarlanmazsa adres çubuğu (shortcut) gerekli değildir.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya \"Microsoft® Azure® Active Directory®\" alan adına katılmış ya da \"Chrome Enterprise Core\" öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings adresine bakın.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "İndirilen dosya türünün uzantısına dayalı uyarıları alanlarda belirlenen dosya türleri için engelle";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Dosya türü uzantısına dayalı indirme uyarılarından muaf tutulacak dosya türü uzantılarını ve muafiyetin geçerli olacağı alanların listesini içeren bir sözlük oluşturmak için bu politikayı etkinleştirebilirsiniz. Böylece kuruluş yöneticileri, listedeki alanlarla ilişkili dosyalar için dosya türü uzantısına dayalı indirme uyarılarını engelleyebilirler. Örneğin \"jnlp\" uzantısı \"website1.com\" ile ilişkilendirilmişse kullanıcılar, \"website1.com\"dan \"jnlp\" dosyalarını indirirken uyarı almaz ancak \"website2.com\"dan \"jnlp\" dosyalarını indirirken uyarı alır.\n\nBu politikada tanımlanan alanlar için belirtilen dosya türü uzantılarına sahip dosyalar da, karma içerik indirme uyarısı ve Güvenli Tarama uyarısı gibi dosya türü uzantısına dayalı olmayan güvenlik uyarılarına tabidir.\n\nBu politikayı devre dışı bırakır veya yapılandırmazsanız uzantıya dayalı indirme uyarılarını tetikleyen dosya türleri kullanıcıya uyarı verir.\n\nBu politikayı etkinleştirirseniz:\n\n*URL kalıpları, https://chromeenterprise.google/policies/url-patterns/ adresindeki kurallara uygun olarak biçimlendirilmelidir.\n\n* Dosya türü uzantıları küçük harflerle ASCII olarak girilmelidir. Dosya türü uzantısı listelenirken ayırıcı eklenmemelidir, yani \".jnlp\" yerine \"jnlp\" şeklinde yazmanız gerekir.\n\nÖrnek:\n\nAşağıdaki örnek değer, *.example.com alanlarında \"exe\" ve \"jnlp\" uzantıları, tüm alanlarda ise \"swf\" uzantıları için dosya türü uzantısına dayalı indirme uyarılarını önler. Diğer tüm alanlarda kullanıcıya exe ve jnlp dosyaları için dosya türü uzantısına dayalı indirme uyarısı gösterir ancak swf dosyaları için göstermez.\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nBu örnekte \"swf\" dosyaları için dosya türü uzantısına dayalı indirme uyarılarının tüm alanlarda engellendiğini görebilirsiniz. Güvenlik riski nedeniyle, tehlikeli dosya türü uzantıları için bu gibi uyarıların tüm alanlarda engellenmesi önerilmez. Bu örnek yalnızca böyle bir yapılandırmanın mümkün olduğunu göstermek amacıyla verilmiştir.\n\nBu politika DownloadRestrictions ile birlikte etkinleştirildiğinde bu politika tarafından belirtilen dosya türü uzantısına dayalı uyarı muafiyetlerine, tehlikeli dosya türlerini engelleyen bir DownloadRestrictions ayarına göre öncelik verilir. Bu politikada belirtilen istisnalar yalnızca DownloadRestrictions politikasının 1 ve 2. değerleriyle belirtilen \"tehlikeli dosya türlerini engelle\" davranışı için geçerlidir.\n\nÖrneğin, bu politika \"website1.com\" adresinden \"exe\" uzantılı indirmeler için muafiyet belirtiyorsa ve DownloadRestrictions politikası kötü amaçlı indirmeleri ve tehlikeli dosya türlerini engelleyecek şekilde ayarlanmışsa (değer 1) \"website1.com\" adresinden \"exe\" uzantılı indirmeler, dosya türü uzantısına dayalı engellemelerden muaf tutulur ancak kötü amaçlıysa engellenir.\n\nDownloadRestrictions hakkında daha fazla bilgiyi https://chromeenterprise.google/policies/?policy=DownloadRestrictions adresinde bulabilirsiniz.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings adresine bakın.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Açıkça izin verilen ağ bağlantı noktaları";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - bağlantı noktası 554 (15.10.2021'e kadar engellemesi kaldırılabilir)\n10080 - bağlantı noktası 10080 (01.04.2022'ye kadar engellemesi kaldırılabilir)\n6566 - bağlantı noktası 6566 (15.10.2021'e kadar engellemesi kaldırılabilir)\n989 - bağlantı noktası 989 (01.02.2022'ye kadar engellemesi kaldırılabilir)\n990 - bağlantı noktası 990 (01.02.2022'ye kadar engellemesi kaldırılabilir)\nBrave tarayıcıda yerleşik olarak bulunan kısıtlanmış bağlantı noktalarının listesi mevcuttur. Bu bağlantı noktalarına yapılan bağlantılar başarısız olur. Bu ayar, söz konusu listenin atlanmasına olanak tanır. Değer, giden bağlantılara izin verilen sıfır veya daha fazla bağlantı noktasının virgülle ayrılmış listesidir.\n\nBağlantı noktaları, çeşitli ağ güvenlik açıklarından yararlanmak amacıyla Brave tarayıcının kullanılmasını önlemek için kısıtlanır. Bu politikanın ayarlanması ağınızı saldırılara açık hale getirebilir. Bu politika, engellenen bir bağlantı noktasında çalışan bir hizmeti standart bir bağlantı noktasına (yani bağlantı noktası 80 veya 443) taşırken \"ERR_UNSAFE_PORT\" kodlu hatalar için geçici bir çözüm olarak tasarlanmıştır.\n\nKötü amaçlı web siteleri bu politikayı ve hangi bağlantı noktaları için ayarlandığını kolayca tespit ederek bu bilgileri saldırılarını hedeflemek için kullanabilir.\n\nBuradaki her bağlantı noktası, engellemesinin kaldırılabileceği son tarihle etiketlenmiştir. Bağlantı noktaları, etiketlerinde belirtilen tarihten sonra bu ayardan bağımsız olarak kısıtlanır.\n\nBu değer boş veya ayarlanmadan bırakılırsa tüm kısıtlanmış bağlantı noktaları engellenir. Geçerli ve geçersiz değerler bir arada olursa geçerli değerler uygulanır.\n\nBu politika, \"--explicitly-allowed-ports\" komut satırı seçeneğini geçersiz kılar.";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Tarayıcı için Genişletilebilir Enterprise SSO'yu kullanamayan kimlik sağlayıcıları içeren engellenenler listesi";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Tüm kimlik sağlayıcılar\nmicrosoft - Microsoft® bulut kimlik sağlayıcısı\nokta - Okta® bulut kimlik sağlayıcısı\nping - Ping® bulut kimliği sağlayıcısı\nListelenen kimlik sağlayıcılar için Extensible Enterprise SSO ile tek oturum açma özelliğini devre dışı bırakın.\n\n'all' değeri eklendiğinde TOA için desteklenen tüm kimlik sağlayıcılar devre dışı bırakılır.\n\n'microsoft' değeri eklendiğinde Chrome'da Microsoft® bulut kimliği sağlayıcısı için tek oturum açma desteği devre dışı bırakılır.\n\nBu politika ayarlanmadan bırakılırsa Brave tarafından desteklenen tüm kimlik sağlayıcılar etkinleştirilir.\n\nBrave için etkinleştirilen ve yönetici tarafından cihazda yapılandırılan kimlik sağlayıcılar için, Extensible Enterprise SSO özelliğini destekleyen herhangi bir uygulamada bu kimlik sağlayıcıyı kullanarak oturum açan kullanıcılar, web mülklerinde otomatik olarak bu kimlik sağlayıcıyı kullanarak oturum açabilirler. Kullanıcının kimlik doğrulamasına ilişkin bilgiler, her kimlik doğrulama işleminde kullanıcının bulut kimliği sağlayıcısına iletilir.\n\nNotlar:\n\nBrave, Gizli veya Misafir modlarında Extensible Enterprise SSO ile Tek Oturum Açma özelliğini desteklemez.\n\nBrave, yalnızca aşağıdaki kimlik sağlayıcılar için Extensible Enterprise SSO ile Tek Oturum Açma özelliğini destekler: Microsoft, Okta, Ping.\n\nBu özellik, macOS 10.15 sürümünden itibaren kullanılabilir.";
ExtensionAllowedTypes.pfm_title = "Yüklenmesine izin verilen uzantı/uygulama türleri";
ExtensionAllowedTypes.pfm_description = "extension - Uzantı\ntheme - Tema\nuser_script - Kullanıcı komut dosyası\nhosted_app - Barındırılan uygulama\nlegacy_packaged_app - Eski paket uygulama\nplatform_app - Platform uygulaması\nPolitikanın ayarlanması, Brave ürününe yüklenebilecek uygulamaları ve uzantıları, ayrıca etkileşimde bulunabilecekleri ana makineleri kontrol eder ve çalışma zamanı erişimini sınırlar.\n\nPolitika ayarlanmadan bırakılırsa kabul edilebilir uzantılar ve uygulama türleriyle ilgili hiçbir kısıtlama uygulanmaz.\n\nListede bulunmayan türden uzantılar ve uygulamalar yüklenmez. Her değer, şu dizelerden biri olmalıdır:\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\nBu türlerle ilgili daha fazla bilgi edinmek için Brave uzantıları belgelerine bakın.\n\n75 sürümünden önce, birden fazla virgülle ayrılmış uzantı kimliğinin kullanılması desteklenmez ve atlanır. Politikanın geri kalanı geçerlidir.\n\nNot: Bu politika ayrıca ExtensionInstallForcelist kullanılarak zorunlu yüklenmiş uzantıları ve uygulamaları da etkiler.\n\nNot: Bu politika yalnızca uzantıları destekleyen platformlarda geçerlidir.";
ExtensionDeveloperModeSettings.pfm_title = "Uzantılar sayfasında geliştirici modunun kullanılabilirliğini kontrol et";
ExtensionDeveloperModeSettings.pfm_description = "0 - Uzantılar sayfasında geliştirici modunun kullanılmasına izin ver\n1 - Uzantılar sayfasında geliştirici modunun kullanılmasına izin verme\nKullanıcıların chrome://extensions sayfasında geliştirici modunu açıp açamayacağını kontrol eder.\n\nPolitika ayarlanmazsa DeveloperToolsAvailability politikası DeveloperToolsDisallowed (2) değerine ayarlanmadığı sürece kullanıcılar uzantılar sayfasında geliştirici modunu açabilir.\nPolitika, Allow (0) değerine ayarlanırsa kullanıcılar uzantılar sayfasında geliştirici modunu açabilir.\nPolitika, Disallow (1) değerine ayarlanırsa kullanıcılar uzantılar sayfasında geliştirici modunu açamaz.\n\nBu politika ayarlanırsa DeveloperToolsAvailability artık uzantılar sayfasında geliştirici modunu kontrol edemez.\n\nNot: Bu politika yalnızca uzantıları destekleyen platformlarda geçerlidir.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Bağlı uzantıların arka planda ömrünü uzatan kaynakların listesini yapılandır.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "Bu kaynaklardan birine bağlanan uzantılar, bağlantı noktası bağlı olduğu sürece çalışmaya devam eder.\n\nPolitika ayarlanmazsa politikanın varsayılan değerleri kullanılır. Bunlar, kapalı bir bağlantıyı önceki durumuna döndürme olanağı sunmadığı bilinen SDK'lar sunan uygulama kaynaklarıdır:\n- Smart Card Connector\n- Citrix Receiver (kararlı, Beta, yedek)\n- VMware Horizon (kararlı, Beta)\n\nPolitika ayarlanırsa varsayılan değer listesine yeni yapılandırılan değerler eklenir. Hem varsayılanlar hem de politika tarafından sağlanan girişler, bağlantı noktası bağlı olduğu sürece, bağlı uzantılara istisna tanır.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Varsayılan arama veya yeni sekme sayfası ayarlarını geçersiz kılan, politika ile yüklenen uzantıları etkinleştirme";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Varsayılan arama motorunu veya yeni sekme sayfası ayarlarını geçersiz kılan, politika ile yüklenen uzantılara (zorunlu yüklenen veya önerilen) düşük güven düzeyine sahip ortamlarda izin verilip verilmeyeceğini kontrol eder.\n\nBu politika yalnızca düşük güven düzeyine sahip ortamlarda (ör. politikaların alan veya bulut yönetimi olmadan yerel olarak yapılandırıldığı cihazlar) geçerlidir. Yüksek güven düzeyine sahip ortamlar etkilenmez:\n\nMicrosoft® Windows® işletim sisteminde bu politika bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılamaz.\n\nmacOS işletim sisteminde bu politika MDM üzerinden yönetilen, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılamaz.\n\nVarsayılan arama motorunu veya yeni sekme sayfası ayarlarını geçersiz kılan, politika ile yüklenen uzantılar, bu yüksek güven düzeyine sahip örneklerde etkin kalır.\n\nEtkin değerine ayarlanırsa Brave, varsayılan arama motorunu veya yeni sekme sayfası ayarlarını geçersiz kılan, politika ile yüklenen uzantıların, düşük güven düzeyine sahip ortamlarda yüklenmesine ve etkin kalmasına izin verir.\n\nDevre dışı değerine ayarlanırsa veya yapılandırılmazsa Brave, varsayılan arama motorunu veya yeni sekme sayfası ayarlarını geçersiz kılan, politika ile yüklenen uzantıların düşük güven düzeyine sahip ortamlara yüklenmesini engeller ve zaten yüklüyse bunları kaldırır.\n\nEtkilenen bir uzantı, artık bu ayarları geçersiz kılmayacak şekilde güncellenirse Brave, uzantıyı 7 gün içinde otomatik olarak yükler.\n\nBu politika geçicidir ve gelecekteki bir sürümde kaldırılacaktır.";
ExtensionInstallAllowlist.pfm_title = "Engellenenler listesinden muaf tutulacak uzantı kimlikleri";
ExtensionInstallAllowlist.pfm_description = "Politikayı ayarlamak, engellenenler listesine alınmayacak uzantıları belirtir.\n\nEngellenenler listesi değerinin * olması, tüm uzantıların engellendiği ve kullanıcıların yalnızca izin verilenler listesindeki uzantıları yükleyebileceği anlamına gelir.\n\nVarsayılan olarak tüm uzantılara izin verilir. Ancak uzantıları politikaya göre yasakladıysanız bu politikayı değiştirmek için izin verilen uzantılar listesini kullanın.\n\nNot: Bu politika yalnızca uzantıları destekleyen platformlarda geçerlidir.";
ExtensionInstallBlocklist.pfm_title = "Kullanıcının yüklemesine engel olunacak uzantı kimlikleri (veya tümü için *)";
ExtensionInstallBlocklist.pfm_description = "Kullanıcıların YÜKLEYEMEYECEĞİ uzantıları belirlemenize olanak tanır. Zaten yüklü olan uzantılar engellenirse devre dışı bırakılır ve kullanıcıya bunları etkinleştirmek için bir yol sunulmaz. Engellenenler listesi nedeniyle devre dışı bırakılan bir uzantı listeden çıkarıldıktan sonra otomatik olarak yeniden etkinleştirilir.\n\nEngellenenler listesi değerinin \"*\" olması, tüm uzantıların varsayılan olarak engellendiği anlamına gelir. İzin verilenler listesinde açıkça listelenen uzantılara, imzalanmış (paketlenmiş) olmaları durumunda izin verilir. Paketlenmemiş tüm uzantılar engellenir.\n\nBu politika ayarlanmadan bırakılırsa kullanıcı Brave ürününde herhangi bir uzantıyı yükleyebilir.\n\nNot: Bu politika yalnızca uzantıları destekleyen platformlarda geçerlidir.";
ExtensionInstallForcelist.pfm_title = "Uzantı/Uygulama kimlikleri ve güncelleme URL'leri sessizce yüklenir";
ExtensionInstallForcelist.pfm_description = "Politikanın ayarlanması, kullanıcı etkileşimi olmadan sessizce yüklenen, kullanıcı tarafından Brave arayüzünden yüklemesi kaldırılamayan veya kapatılamayan uygulamaların ve uzantıların bir listesini belirtir. İzinler, enterprise.deviceAttributes ve enterprise.platformKeys uzantı API'leri için dolaylı olarak verilir. (Bu iki API zorunlu olarak yüklenmemiş uygulamalar ve uzantılar tarafından kullanılamaz.)\n\nBrave, kullanıcıların bu uzantıları kaldırmasını engellemeyi amaçlasa da bazı işletim sistemleri, Brave tarafından uzantıların harici olarak değiştirilmesine karşı güçlü bir savunma yapılmasını imkansız kıldığı için bu önlem, en ideal seçenektir.\n\nBu politika ayarlanmadan bırakılırsa hiçbir uygulama veya uzantı otomatik olarak yüklenmez ve kullanıcılar Brave ürünündeki uygulama veya uzantıları kaldırabilirler.\n\nBu politika, ExtensionInstallBlocklist politikasının yerini alır. Önceden zorunlu olarak yüklenmiş bir uygulama veya uzantı listeden çıkarılırsa Brave, otomatik olarak bu uygulamayı veya uzantıyı kaldırır.\n\nHerhangi bir uzantının kaynak kodu, kullanıcılar tarafından geliştirici araçları kullanılarak uzantının işlevselliğini devre dışı bırakabilecek şekilde değiştirilebilir. Böyle bir endişe olması durumunda DeveloperToolsDisabled politikasını ayarlayın.\n\nPolitikaya ait her liste öğesi, noktalı virgülle (;) ayrılmış bir uzantı kimliği ve isteğe bağlı bir güncelleme URL'si içeren bir dizedir. Uzantı kimliği, örneğin Geliştirici modundayken chrome://extensions adresinde bulunabilen 32 harfli bir dizedir. Belirtilmişse güncelleme URL'si bir Güncelleme Manifest XML belgesine işaret etmelidir (https://developer.chrome.com/extensions/autoupdate). Güncelleme URL'si şu şemalardan birini kullanmalıdır: http, https veya file. Varsayılan olarak Chrome Web Mağazası'nın güncelleme URL'si kullanılır. Bu politikada ayarlanan güncelleme URL'si yalnızca ilk yükleme için kullanılır. Uzantının sonraki güncellemelerinde ise uzantının manifest dosyasındaki güncelleme URL'si kullanılır. Sonraki güncellemelerin güncelleme URL'si, ExtensionSettings politikası kullanılarak geçersiz kılınabilir. http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy adresine bakın.\n\nMicrosoft® Windows® örneklerinde, Chrome Web Mağazası dışından uygulamalar ve uzantılar, örnek yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmışsa ya da Chrome Enterprise Core öğesine kaydolmuşsa zorunlu olarak yüklenebilir.\n\nmacOS örneklerinde, Chrome Web Mağazası dışından uygulamalar ve uzantılar, örnek yalnızca MDM ile çalışıyorsa, MCX aracılığıyla bir alan adına katılmışsa veya Chrome Enterprise Core öğesine kaydolmuşsa zorunlu olarak yüklenebilir.\n\nNot: Bu politika gizli mod için geçerli değildir. Uzantıların barındırılması (https://developer.chrome.com/extensions/hosting) ile ilgili bilgi edinin.\n\nNot: Bu politika yalnızca uzantıları destekleyen platformlarda geçerlidir.";
ExtensionInstallSources.pfm_title = "Uzantı, uygulama ve kullanıcı komut dosyası yüklemelerine izin veren URL kalıpları";
ExtensionInstallSources.pfm_description = "Politikayı ayarlamak uzantı, uygulama ve tema yükleyebilecek URL'leri belirtir. Brave 21 sürümünden önce, kullanıcılar bir *.crx dosyası bağlantısını tıklayarak Brave ürününün birkaç uyarıdan sonra dosyayı yüklemesini sağlayabiliyordu. Daha sonra, bu tür dosyaların indirilip Brave ayarları sayfasına sürüklenmesi zorunlu hale getirilmiştir. Bu ayar, belirli URL'lerin eski, daha kolay yükleme akışına sahip olmasına olanak tanır.\n\nBu listedeki her öğe bir uzantı stili eşleşme kalıbıdır (https://developer.chrome.com/extensions/match_patterns sayfasına bakın). Kullanıcılar, bu listedeki bir öğeyle eşleşen herhangi bir URL'deki öğeleri kolayca yükleyebilirler. Bu kalıplar hem *.crx dosyasının konumuna hem de indirmenin başlatıldığı sayfaya (yönlendirene) izin vermelidir.\n\nExtensionInstallBlocklist, bu politikaya göre daha önceliklidir. Diğer bir deyişle, engellenenler listedeki bir uzantı bu listedeki bir sitede bulunsa bile yüklenmeyecektir.\n\nNot: Bu politika yalnızca uzantıları destekleyen platformlarda geçerlidir.";
ExtensionInstallTypeBlocklist.pfm_title = "Uzantı yükleme türleri için engellenenler listesi";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Uzantıların, komut satırından yüklenmesini engeller\nEngellenenler listesi, izin verilmeyen uzantı yükleme türlerini kontrol eder.\n\n\"command_line\" değerini ayarlamak, uzantının komut satırından yüklenmesini\nengeller.";
ExtensionReviewPromptsEnabled.pfm_title = "Uzantı inceleme istemlerini ve puanlama bağlantılarını kontrol et";
ExtensionReviewPromptsEnabled.pfm_description = "Yüklü Chrome uzantıları için yerel yorum istemlerinin ve puanlama bağlantılarının (\"Puan ver\" gibi) Chrome kullanıcı arayüzlerinde kullanılıp kullanılamayacağını kontrol eder.\n\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar, araç çubuğunda, bağlam menülerinde ve uzantı yönetimi sayfasında (chrome://extensions) uygun uzantıları inceleyip puanlayacakları yerel giriş noktalarını görebilir.\n\nBu politika, Devre Dışı değerine ayarlanırsa tüm yerel yorum istemleri ve puanlama bağlantıları gizlenir ve kullanılamaz.";
ExtensionSettings.pfm_title = "Uzantı yönetim ayarları";
ExtensionSettings.pfm_description = "Politikanın ayarlanması, mevcut uzantılarla alakalı politikalar dahil olmak üzere Brave ürünü için uzantı yönetim ayarlarını kontrol eder.\n\nBu politika, uzantı kimliklerini veya güncelleme URL'lerini yalnızca kendi özel ayarlarıyla eşleştirir. \"*\" özel kimliği için varsayılan bir yapılandırma ayarlanabilir. Bu varsayılan yapılandırma, bu politikada özel bir yapılandırma ayarlanmamış tüm uzantılara uygulanır.\n\nBu politika, eski politikalardaki uzantı bazında yapılandırmayı geçersiz kılabilir.\n\nExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist veya ExtensionSettings politikasındaki kimlik bazında uzantı ayarlarının, \"*\" varsayılanlarından yalnızca \"installation_mode\" ve \"update_url\" özelliklerini devralacağını unutmayın. Başka hiçbir özellik devralınmaz. Güncelleme URL'si olduğunda yapılandırma, uzantı manifest'inde (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy) belirtilenle tam olarak aynı güncelleme URL'sine sahip tüm uzantılara uygulanır. \"override_update_url\" işareti doğru değerine ayarlanırsa uzantı yüklenip ExtensionInstallForcelist politikasında veya bu politikanın \"update_url\" alanında belirtilen \"güncelleme\" URL'si kullanılarak güncellenir. \"update_url\", Chrome Web Mağazası URL'si ise \"override_update_url\" işareti dikkate alınmaz.\n\nBrave 154 sürümünden itibaren, \"debugger\" iznine sahip bir uzantıya \"runtime_blocked_hosts\" uygulandığında tüm hedeflerde \"chrome.debugger.attach()\" tamamen devre dışı bırakılır.\n\nMicrosoft® Windows® örneklerinde, Chrome Web Mağazası dışından uygulamalar ve uzantılar, örnek yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmışsa ya da Chrome Enterprise Core öğesine kaydolmuşsa zorunlu olarak yüklenebilir.\n\nmacOS örneklerinde, Chrome Web Mağazası dışından uygulamalar ve uzantılar, örnek yalnızca MDM ile çalışıyorsa, MCX aracılığıyla bir alan adına katılmışsa veya Chrome Enterprise Core öğesine kaydolmuşsa zorunlu olarak yüklenebilir.\n\nNot: Bu politika yalnızca uzantıları destekleyen platformlarda geçerlidir.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=ExtensionSettings adresine bakın.";
ExtensionUnpublishedAvailability.pfm_title = "Chrome Web Mağazası'nda yayından kaldırılan uzantıların kullanılabilirliğini kontrol et.";
ExtensionUnpublishedAvailability.pfm_description = "0 - Yayından kaldırılan uzantılara izin ver\n1 - Yayından kaldırılan uzantıları devre dışı bırak\nBu politika etkinleştirilirse Chrome Web Mağazası'nda yayından kaldırılan uzantılar Brave ürününde devre dışı bırakılır.\nBu politika yalnızca Chrome Web Mağazası'ndan yüklenen ve güncellenen uzantılar\niçin geçerlidir.\n\nGeliştirici modu kullanılarak yüklenen paketlenmemiş uzantılar ve\nkomut satırı anahtarı kullanılarak yüklenen uzantılar gibi mağaza dışındaki uzantılar\nyoksayılır.\nKendi bünyesinde barındırılan zorunlu yüklenmiş uzantılar yoksayılır. Sürüme\nsabitlenmiş tüm uzantılar da yoksayılır.\n\nPolitika AllowUnpublished (0) değerine ayarlanırsa veya ayarlanmadan bırakılırsa Chrome Web Mağazası'nda yayından kaldırılan uzantılara izin verilir.\nPolitika DisableUnpublished (1) değerine ayarlanırsa Chrome Web Mağazası'nda yayından kaldırılan uzantılar devre dışı bırakılır.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Harici protokol iletişim kutusunda \"Her zaman aç\" onay kutusu göster.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Bu politika, harici protokol başlatma onayı istemlerinde \"Her zaman aç\" onay kutusunun gösterilip gösterilmeyeceğini kontrol eder.\n\n     Bu politika True (Doğru) değerine ayarlanırsa veya hiç ayarlanmazsa bir harici protokol onayı gösterildiğinde, kullanıcı ileride bu sitede tüm protokol onay istemlerini atlamak için \"Her zaman izin ver\"i seçebilir.\n\n     Bu politika False (Yanlış) değerine ayarlanırsa \"Her zaman izin ver\" onay kutusu görüntülenmez ve bir harici protokolün çağrıldığı her defasında kullanıcıya sorulur.";
FeedbackSurveysEnabled.pfm_title = "Ürün içi Brave anketlerinin kullanıcılara gösterilip gösterilmeyeceğini belirtir.";
FeedbackSurveysEnabled.pfm_description = "Brave ürün içi anketleri, tarayıcı ile ilgili kullanıcı geri bildirimleri toplar. Anket yanıtları, kullanıcı hesaplarıyla ilişkilendirilmez.\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılara ürün içi anketler gösterilebilir.\nBu politika, Devre Dışı değerine ayarlanırsa kullanıcılara ürün içi anketler gösterilmez.\n\nMetricsReportingEnabled, Devre Dışı değerine ayarlanmışsa bu politikanın etkisi olmaz. Bu durumda, ürün içi anketler de devre dışı bırakılır.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Kapanışta keepalive süresini getir";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Tarayıcı kapanırken keepalive isteklerine tanınacak süreyi (saniye cinsinden) kontrol eder.\n\nBir değer belirtildiğinde keepalive isteklerini işlemek üzere (https://fetch.spec.whatwg.org/#request-keepalive-flag)\n belirtilen süre boyunca tarayıcının kapanması engellenebilir.\n\nVarsayılan değer (0) bu özelliğin devre dışı olduğu anlamına gelir.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Önceki kullanıcının hareketi olmadan dosya veya dizin seçici API'lerin çağrılmasına izin ver";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "showOpenFilePicker(),\nshowSaveFilePicker() ve\nshowDirectoryPicker() web API'leri,\ngüvenlik nedenleriyle önceki kullanıcının hareketinin\n(\"geçici etkinleştirme\") çağrılmasını zorunlu kılar ve çağrılmadığı takdirde\nbaşarısız olur.\n\nBu politika ayarlandığında yöneticiler, önceki kullanıcının hareketi olmadan bu API'lerin\nçağrılabileceği kaynakları belirtebilir.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için\nhttps://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz. *\nbu politikada kabul edilen bir değer değildir.\n\nBu politika ayarlanmazsa tüm kaynaklar, bu API'leri çağırmak için önceki kullanıcının hareketini\nzorunlu kılar.";
FileSystemReadAskForUrls.pfm_title = "Bu sitelerde File System API üzerinden okuma erişimine izin ver";
FileSystemReadAskForUrls.pfm_description = "Bu politika ayarlanırsa kullanıcılardan ana makine işletim sisteminin dosya sisteminde bulunan dosya veya dizinlere File System API üzerinden okuma erişimi vermelerini isteyebilecek sitelerin belirtildiği URL kalıpları listesini oluşturabilirsiniz.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultFileSystemReadGuardSetting bütün siteler için geçerli olur. Etkin değilse kullanıcının ayarları geçerlidir.\n\nURL kalıpları, FileSystemReadBlockedForUrls ile çakışmamalıdır. Bir URL her ikisiyle de eşleşirse politikaların ikisinin de diğeri üzerinde önceliği olmaz.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
FileSystemReadBlockedForUrls.pfm_title = "Bu sitelerde File System API üzerinden okuma erişimini engelle";
FileSystemReadBlockedForUrls.pfm_description = "Bu politika ayarlanırsa kullanıcılardan ana makine işletim sisteminin dosya sisteminde bulunan dosya veya dizinlere File System API üzerinden okuma erişimi vermelerini isteyemeyecek sitelerin belirtildiği URL kalıpları listesini oluşturabilirsiniz.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultFileSystemReadGuardSetting bütün siteler için geçerli olur. Etkin değilse kullanıcının ayarları geçerlidir.\n\nURL kalıpları, FileSystemReadAskForUrls ile çakışamaz. Bir URL her ikisiyle de eşleşirse politikaların ikisinin de diğeri üzerinde önceliği olmaz.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
FileSystemWriteAskForUrls.pfm_title = "Bu sitelerde dosya ve dizinlere yazma erişimine izin ver";
FileSystemWriteAskForUrls.pfm_description = "Politika ayarlanırsa kullanıcılardan ana makine işletim sisteminin dosya sistemindeki dosya veya dizinlere yazma erişimi vermelerini isteyebilecek siteleri belirten URL kalıplarının listesini oluşturabilirsiniz.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultFileSystemWriteGuardSetting bütün siteler için geçerli olur. Etkin değilse kullanıcının ayarları geçerlidir.\n\nURL kalıpları, FileSystemWriteBlockedForUrls ile çakışmamalıdır. Bir URL her ikisiyle de eşleşirse politikaların ikisinin de diğeri üzerinde önceliği olmaz.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
FileSystemWriteBlockedForUrls.pfm_title = "Bu sitelerde dosya ve dizinlere yazma erişimini engelle";
FileSystemWriteBlockedForUrls.pfm_description = "Bu politika ayarlanırsa kullanıcılardan ana makine işletim sisteminin dosya sisteminde bulunan dosya veya dizinlere yazma erişimi vermelerini isteyemeyecek sitelerin belirtildiği URL kalıpları listesini oluşturabilirsiniz.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultFileSystemWriteGuardSetting bütün siteler için geçerli olur. Etkin değilse kullanıcının ayarları geçerlidir.\n\nURL kalıpları, FileSystemWriteAskForUrls ile çakışamaz. Bir URL her ikisiyle de eşleşirse politikaların ikisinin de diğeri üzerinde önceliği olmaz.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
ForceEphemeralProfiles.pfm_title = "Geçici profil";
ForceEphemeralProfiles.pfm_description = "Bu politika etkinleştirilirse profil geçici moda geçmeye zorlanır. Bu politika bir OS politikası olarak belirlenirse (ör. Windows'da GPO) sistemdeki tüm profiller için geçerli olur; Bulut politikası olarak belirlenirse yalnızca yönetilen hesapla oturum açılan bir profil için geçerli olur.\n\nBu modda, profil verileri disk üzerinde sadece kullanıcının oturumu süresince kalır. Tarayıcı geçmişi gibi özellikler, uzantılar ve uzantıların verilerinin yanı sıra çerezler ve web veritabanları gibi web verileri tarayıcı kapandıktan sonra saklanmaz. Ancak bu durum, kullanıcının verileri manuel olarak diske indirmesine, sayfaları kaydetmesine veya yazdırmasına engel olmaz.\n\nKullanıcı, senkronizasyonu etkinleştirmişse tüm bu veriler normal profillerde olduğu gibi kullanıcının senkronizasyon profilinde saklanır. Politika tarafından açıkça devre dışı bırakılmamışsa gizli mod da kullanılabilir.\n\nPolitika devre dışı olarak ayarlanırsa veya ayarlanmadan bırakılırsa oturum açıldığında normal profiller kullanılır.";
ForceForegroundPriorityForAllTabs.pfm_title = "Tüm sekmeler için ön plan önceliğini zorla";
ForceForegroundPriorityForAllTabs.pfm_description = "Bu politika, arka plandaki web içeriğinin ön plan önceliğinde çalışmaya zorlanıp zorlanmayacağını\nkontrol eder.\n\nTarayıcı, varsayılan olarak kaynakları optimize etmek için arka plan sekmelerindeki içeriğin\nönceliğini düşürür. Bu politika etkinleştirildiğinde bu davranış geçersiz\nkılınır ve arka plan sekmeleri, etkin sekme ile aynı şekilde planlanır.\n\nArka plandaki içeriği ön planda öncelikli olarak çalışmaya zorlamanın, etkin sekmenin\nyanıt verme hızını biraz etkileyebileceğini unutmayın.\n\nBu politika, Etkin değerine ayarlanırsa tüm web içeriği görünürlük durumundan bağımsız\nolarak ön plan önceliğinde çalışır.\n\nBu politika, Devre Dışı değerine ayarlanırsa veya ayarlanmadan bırakılırsa tarayıcı,\nönceliği standart buluşsal yöntemlere (ör. görünmeyen, ses çalmayan, görüntülü görüşmelere\nkatılmayan içeriklerin önceliğini düşürme) göre belirler.";
ForceForegroundPriorityForUrls.pfm_title = "Belirli URL'ler için ön plan önceliğini zorla";
ForceForegroundPriorityForUrls.pfm_description = "Bu politika, URL kalıpları listesi belirtmenize olanak tanır. Bu kalıplarla eşleşen arka plandaki web içeriği, ön plan önceliğinde çalışmaya zorlanır.\n\nForceForegroundPriorityForAllTabs politikası etkinleştirilirse tüm sekmeler ön plan önceliğine zorlanacağından bu liste yoksayılır.\n\nForceForegroundPriorityForAllTabs devre dışı bırakılır veya ayarlanmazsa yalnızca bu listedeki kalıplarla eşleşen içerik zorunlu kılınır.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://support.google.com/chrome/a?p=url_blocklist_filter_format adresine bakabilirsiniz.\n\nBu liste boşsa veya ayarlanmamışsa hiçbir arka plan içeriği ön plan önceliğine zorlanmaz.";
ForceGoogleSafeSearch.pfm_title = "Google Güvenli Arama'yı zorla";
ForceGoogleSafeSearch.pfm_description = "Politika Etkin değerine ayarlanırsa Google Arama'da Güvenli Arama her zaman etkin olur ve kullanıcılar bu ayarı değiştiremezler.\n\nPolitika Devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa Google Arama'da Güvenli Arama uygulanmaz.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "unload etkinlik işleyicilerin devre dışı bırakılıp bırakılamayacağını kontrol eder.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "unload etkinlik işleyicilerin desteği sonlandırılıyor. Bu işleyicilerin tetiklenip tetiklenmemesi unload Permissions-Policy politikasına bağlıdır. Şu anda politika bunlara varsayılan olarak izin vermektedir. Gelecekte, kademeli bir şekilde varsayılan olarak izin verilmeyecek ve sitelerin, Permissions-Policy başlıklarını kullanarak bunları açıkça etkinleştirmesi gerekecek. Bu kurumsal politika, varsayılan ayarı etkin olarak kalmaya zorlayarak desteğin kademeli olarak sonlandırılmasını devre dışı bırakmak için kullanılabilir.\n\nSayfalar, verileri kaydetmek veya bir kullanıcı oturumunun sonlandırıldığını sunucuya bildirmek için unload etkinlik işleyicileri kullanabilir. Güvenilir olmadığı ve BackForwardCache kullanımını engelleyerek performansı etkilediği için bu kullanım önerilmez. Önerilen alternatifler mevcut olsa da unload etkinliği uzun süredir kullanılmaktadır. Bazı uygulamalar bunu kullanmaya devam edebilir.\n\nBu politika, Yanlış değerine ayarlanırsa veya ayarlanmadan bırakılırsa unload etkinlik işleyicilerin, desteği sonlandırma süreci doğrultusunda kademeli olarak desteği sonlandırılır ve Permissions-Policy başlığını ayarlamayan siteler, \"kaldırma\" etkinliklerini tetiklemeyi bırakır.\n\nBu politika, Doğru değerine ayarlanırsa unload etkinlik işleyiciler varsayılan olarak çalışmaya devam eder.\n\nNOT: Bu politikanın varsayılan değeri M117 dokümanında hatalı bir şekilde \"true\" (doğru) olarak belirtilmiştir. M117'de kaldırma etkinliği değişmedi ve değişmeyecek. Dolayısıyla, bu politikanın o sürümde etkisi yoktur.\n";
ForceYouTubeRestrict.pfm_title = "Minimum YouTube Kısıtlı Mod'u zorunlu kıl";
ForceYouTubeRestrict.pfm_description = "0 - YouTube uygulamasında Kısıtlı Mod'u zorunlu kılma\n1 - YouTube uygulamasında en azından Orta Düzey Kısıtlı Mod'u zorunlu kıl\n2 - YouTube için Yüksek Düzey Kısıtlı Mod'u zorunlu kıl\nPolitika ayarlanırsa YouTube uygulamasında minimum Kısıtlı mod uygulanır ve kullanıcıların daha az kısıtlı bir mod seçmeleri engellenir. Politikayı:\n\n* Yüksek Düzey seçeneğine ayarlarsanız YouTube uygulamasında Yüksek Düzey Kısıtlı mod her zaman etkin olur.\n\n* Orta Düzey olarak ayarlarsanız kullanıcı YouTube uygulamasında yalnızca Orta Düzey Kısıtlı mod'u ve Yüksek Düzey Kısıtlı mod'u seçebilir, ancak Kısıtlı mod'u kapatamaz.\n\n* Kapalı olarak ayarlar veya hiçbir değer ayarlamazsanız Chrome, YouTube uygulamasında Kısıtlı mod'u zorunlu tutmaz. Ancak YouTube politikaları gibi harici politikalar Kısıtlı mod'un uygulanmasını zorunlu tutabilir.";
ForcedLanguages.pfm_title = "İçeriği ve tercih edilen diller sıralamasını yapılandır";
ForcedLanguages.pfm_description = "Bu politika, yöneticilerin Brave ürününün ayarlarında tercih edilen dillerin sıralamasını yapılandırmalarına olanak tanır.\n\nListenin sırası, chrome://settings/languages adresindeki \"Dilleri tercihinize göre sıralayın\" bölümün altındaki liste ile aynı sırada görünür. Kullanıcılar, politika tarafından ayarlanan dilleri kaldıramaz veya sırasını değiştiremezler ancak politika tarafından ayarlanan dillerin altında yeni diller ekleyebilirler. Diğer politikalar tarafından uygulanmadığı sürece kullanıcılar ayrıca, tarayıcının hem kullanıcı arayüzü hem de çeviri/yazım denetimi ayarları üzerinde tam kontrol sahibi olurlar.\n\nPolitikanın ayarlanmadan bırakılması, kullanıcıların tercih edilen diller listesinin tamamını manipüle etmelerine olanak tanır.";
GeminiActOnWebAllowedForURLs.pfm_title = "Gemini uygulaması entegrasyonlarının belirtilen sitelerde doğrudan işlem yapmasına izin ver";
GeminiActOnWebAllowedForURLs.pfm_description = "Gemini uygulaması entegrasyonlarının web sayfalarında doğrudan işlem yapabileceği sitelerin belirtildiği URL kalıpları listesinin ayarlanmasına olanak tanır.\n\nİzin verilenler listesi veya engellenenler listesiyle eşleşmeyen URL'lerde GeminiActOnWebSettings kullanılır.\n\nHem izin verilenler hem de engellenenler listesiyle eşleşen URL'lere izin verilir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://support.google.com/chrome/a?p=url_blocklist_filter_format adresine bakabilirsiniz.";
GeminiActOnWebBlockedForURLs.pfm_title = "Gemini uygulaması entegrasyonlarının belirtilen sitelerde doğrudan işlem yapmasını engelle";
GeminiActOnWebBlockedForURLs.pfm_description = "Gemini uygulaması entegrasyonlarının web sayfalarında doğrudan işlem yapamayacağı sitelerin belirtildiği URL kalıpları listesinin ayarlanmasına olanak tanır.\n\nİzin verilenler listesi veya engellenenler listesiyle eşleşmeyen URL'lerde GeminiActOnWebSettings kullanılır.\n\nHem izin verilenler hem de engellenenler listesiyle eşleşen URL'lere izin verilir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://support.google.com/chrome/a?p=url_blocklist_filter_format adresine bakabilirsiniz.";
GeminiActOnWebSettings.pfm_title = "Gemini uygulaması entegrasyonlarının doğrudan web sayfalarında işlem yapmasına izin verir";
GeminiActOnWebSettings.pfm_description = "0 - Gemini uygulamasının, web sayfalarında işlem yapmasına izin ver.\n1 - Gemini uygulamasının, web sayfalarında işlem yapmasına izin verme.\nGemini uygulamasının, web sayfalarında kullanıcı adına işlem yapmasına izin verilip verilmeyeceğini kontrol eder.\n\n0/ayarlanmadı  = Gemini uygulamasının web sayfalarında işlem yapmasına izin verilir.\n\n1 = Gemini uygulamasının, web sayfalarında işlem yapmasına izin verilmez.\n\nGemini uygulaması devre dışı bırakıldığında bu politikanın etkisi olmaz. Örneğin, Gemini uygulaması GeminiSettings politikası tarafından devre dışı bırakılabilir.\n\nChrome'da Gemini hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a/answer/16291696 adresini ziyaret edin.\n\nGemini'ın etkinleştirilmesi tüm ülkelerde veya dillerde kullanılamaz. Bu politikanın ayarlanması, özelliğin etkinleştirileceğini garanti etmez. Özellik, kullanılabilirliğe bağlı olarak etkinleştirilir. Özelliğin kullanılabilirliğiyle ilgili daha fazla bilgi için Enterprise sürüm notlarını inceleyin: https://support.google.com/chrome/a/answer/7679408?hl=tr";
GeminiSettings.pfm_title = "Gemini entegrasyonu ayarları";
GeminiSettings.pfm_description = "0 - Gemini entegrasyonlarına izin ver.\n1 - Gemini entegrasyonlarına izin verme.\nBu ayar, Gemini uygulaması entegrasyonlarına izin verir.\n\n0 = Kullanıcılar Gemini entegrasyonunu kullanabilir.\n\n1 = Kullanıcılar Gemini entegrasyonunu kullanamaz.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nDaha fazla bilgi için lütfen https://support.google.com/chrome/a?p=gemini_in_chrome adresindeki Yardım Merkezi makalesini inceleyin.";
GeminiSparkSettings.pfm_title = "Gemini Spark, Chrome'da Gemini aracılığıyla Brave ile bağlantı kurabilir ve otomatik gezinme özelliğini kullanabilir";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark, Brave ile bağlantı kurabilir ve otomatik gezinme özelliğini kullanabilir.\n1 - Gemini Spark ajanının Brave ile bağlantı kurmasına veya otomatik gezinme özelliğini kullanmasına izin verilmez.\nGemini Spark ajanının Brave ile bağlantı kurmasına ve otomatik gezinme özelliğini kullanmasına izin verilip verilmeyeceğini kontrol eder. Gemini Spark, kuruluşunuzda kullanılamıyor olabilir.\n\n0 = Gemini Spark, Brave ile bağlantı kurabilir ve otomatik gezinme özelliğini kullanabilir\n\n1 = Gemini Spark, Brave ile bağlantı kuramaz veya otomatik gezinme özelliğini kullanamaz\n\nUyarı: Gemini Spark ajanının Brave ile bağlantı kurmasını ve otomatik gezinme özelliğini kullanmasını etkinleştirmek, Gemini Spark ajanının etkin tarayıcı oturumunu kullanarak Brave istemcilerinde bağımsız, çok adımlı işlemler yapmasına olanak tanır. Bu durum; kimlik bilgisi riskleri, Yerel Ağ Girişi ve içeriğe duyarlı sinyallerin kaybı gibi önemli güvenlik risklerini beraberinde getirir. Mevcut yönetim ve güvenlik denetimlerine uyulmayabilir.\n\nYöneticilerin bu özelliği etkinleştirmeden önce kuruluşlarının ağ tehdit modelini, uyumluluk ve gizlilik kurallarını dikkatlice değerlendirmeleri önerilir.\n\nGoogle Gemini uygulaması veya Brave otomatik gezinme politikaları devre dışı bırakıldığında bu politikanın etkisi olmaz. Örneğin, Google Gemini uygulaması GeminiSettings politikası tarafından devre dışı bırakılabilir. Brave üzerinde Google Gemini hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=gemini_in_chrome adresine göz atın.\n\nBrave otomatik gezinme ve Gemini Spark tüm ülkelerde veya dillerde kullanılamaz. Bu politikanın 0 - Etkin değerine ayarlanması, özelliğin etkinleştirileceğini garanti etmez. Bu durum, kullanılabilirliğe bağlıdır. Kullanıma sunmayla ilgili daha fazla bilgi edinmek için Enterprise sürüm notlarını inceleyin: https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Üretken yapay zekanın yerel temel modeliyle ilgili ayarlar";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Modeli otomatik olarak indirir\n1 - Modeli indirme\nBrave öğesinin, üretken yapay zekanın temel modelini indirme ve yerel çıkarım için kullanma şeklini yapılandırın.\n\nPolitika, İzin Verildi (0) değerine ayarlanır veya ayarlanmadan bırakılırsa model otomatik olarak indirilir ve çıkarım için kullanılır.\n\nPolitika, Devre Dışı (1) değerine ayarlanırsa model indirilmez ve mevcut model (daha önce indirilmişse) silinir.\n\nMasaüstü platformlarda model indirme işlemi, ComponentUpdatesEnabled değerini yanlış olarak ayarlayarak da devre dışı bırakılabilir.";
GeolocationBlockedForUrls.pfm_title = "Bu sitelerde coğrafi konumu engelle";
GeolocationBlockedForUrls.pfm_description = "Bu politikayı ayarlayarak kullanıcının coğrafi konumuna erişmesine izin verilmeyen ve bunu yapmak için kullanıcı izni istemesi engellenen sitelerin belirtildiği URL kalıplarının listesini oluşturabilirsiniz.\n\nPolitika ayarlanmadan bırakılırsa tüm sitelerde DefaultGeolocationSetting (ayarlanmışsa) geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "Genel olarak kapsamlı HTTP auth önbelleği etkinleştirir";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Bu politika, HTTP sunucusu kimlik doğrulama bilgileri ile tek bir genel profil başına önbellek yapılandırır.\n\nBu politika ayarlanmazsa veya devre dışı bırakılırsa tarayıcı, siteler arası varsayılan kimlik doğrulama ayarını kullanır. Bu davranış, HTTP sunucu kimlik doğrulama bilgilerini üst düzey siteye göre değerlendirir. Onun için iki site aynı kimlik doğrulama alanından kaynak kullanırsa kimlik bilgilerinin iki sitenin de kendi bağlamında ayrı ayrı sağlanması gerekir. Önbelleğe alınan proxy kimlik bilgileri siteler arasında yeniden kullanılır.\n\nPolitika etkinleştirilirse bir site bağlamında girilen HTTP kimlik doğrulama bilgileri otomatik olarak diğer site bağlamında da kullanılır.\n\nBu politikanın etkinleştirilmesi, siteleri bazı siteler arası saldırılara açık bırakır ve kullanıcıların, URL'lere gömülü kimlik bilgilerini kullanıp HTTP kimlik doğrulama önbelleğine girişler ekleyerek, çerezler bile olmadan siteler arasında takip edilmesine olanak tanır.\n\nBu politikanın amacı eski ayarlarına bağlı olarak işletmelere giriş prosedürlerini güncelleme fırsatı vermektir ve ileride kaldırılacaktır.";
GoogleSearchSidePanelEnabled.pfm_title = "Google Search Side Panel tarayıcısını etkinleştir";
GoogleSearchSidePanelEnabled.pfm_description = "Etkin seçeneğine ayarlanır veya ayarlanmadan bırakılırsa tüm web sayfalarında Google Search Side Panel için izin verilir.\n\nDevre Dışı seçeneğine ayarlanırsa Google Search Side Panel, hiçbir web sayfasında kullanılamaz.\n\nBu özellik kapsamındaki üretken yapay zeka özellikleri, eğitim hesaplarında veya kurumsal hesaplarda kullanılamaz.";
HSTSPolicyBypassList.pfm_title = "HSTS politika kontrolünü atlayacak olan isimlerin listesi";
HSTSPolicyBypassList.pfm_description = "Politika ayarlanırsa önceden yüklenmiş HSTS'lerin http'den https'ye geçirilmelerini atlayan ana makine adlarının bir listesi belirtilir.\n\nBu politikada yalnızca tek etiketli ana makine adlarına izin verilir. Bu politika, yalnızca \"statik\" HSTS-önceden yüklenmiş öğeler için (örneğin, \"app\", \"new\", \"search\", \"play\") geçerlidir. Bu politika, Strict-Transport-Security yanıt başlığı kullanarak \"dinamik\" olarak HSTS sürümüne geçiş isteğinde bulunmuş sunucular için HSTS geçişlerini engellemez.\n\nSağlanan ana makine adları standartlaştırılmalıdır: Tüm IDN'ler, A-etiket biçimine dönüştürülmeli ve tüm ASCII harfleri küçük harf olmalıdır. Bu politika, yalnızca belirtilen tek etiketli ana makine adları için geçerlidir. Bu ana makine adlarının alt alan adları için geçerli değildir.";
HappyEyeballsV3Enabled.pfm_title = "Happy Eyeballs V3 algoritmasını kullan";
HappyEyeballsV3Enabled.pfm_description = "Bu özellik, Happy Eyeballs V3 algoritmasının bağlantı denemeleri yapmasını sağlar. Ayrıntılar için https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3 adresine bakın.\n\nPolitika, Etkin değerine ayarlanırsa Brave, bağlantı denemeleri için Happy Eyeballs V3 algoritmasını kullanır.\n\nPolitika, Devre Dışı değerine ayarlanırsa Happy Eyeballs V3 algoritması devre dışı bırakılır.\n\nPolitika ayarlanmazsa Brave, chrome://flags/#happy-eyeballs-v3 adresindeki ayara göre Happy Eyeballs V3 algoritmasını açar veya kapatır.\n\nBu politika dinamik yenilemeyi destekler.\n\nBu politika geçici bir çözüm olup gelecekteki Brave sürümlerinden kaldırılacaktır.";
HardwareAccelerationModeEnabled.pfm_title = "Kullanılabilir olduğunda grafik hızlandırmayı kullan";
HardwareAccelerationModeEnabled.pfm_description = "Politikanın Etkin değerine ayarlanması veya ayarlamadan bırakılması, mevcutsa grafik hızlandırmayı açar.\n\nPolitikanın Devre Dışı değerine ayarlanması grafik hızlandırmayı kapatır.";
HeadlessMode.pfm_title = "Gözetimsiz Mod'un kullanımını kontrol et";
HeadlessMode.pfm_description = "1 - Gözetimsiz Mod'un kullanılmasına izin ver\n2 - Gözetimsiz Mod'un kullanımına izin verme\nBu politikanın Enabled değerine ayarlanması veya ayarlanmadan bırakılması, gözetimsiz modun kullanımına izin verir. Bu politikanın Disabled değerine ayarlanması, gözetimsiz modun kullanılmasını engeller.";
HelpMeWriteSettings.pfm_title = "Yazmama yardım et ayarları";
HelpMeWriteSettings.pfm_description = "0 - \"Yazmama yardım et\" özelliğine izin ver ve yapay zeka modellerini daha iyi hale getir.\n1 - Yapay zeka modellerini daha iyi hale getirmeden \"Yazmama yardım et\" özelliğine izin ver.\n2 - \"Yazmama yardım et\" özelliğine izin verme.\nYazmama yardım et, web'deki kısa içerikler için yapay zekadan yararlanarak yazım konusunda destek sunar. Önerilen içerikler, kullanıcının girdiği istemlere ve web sayfasındaki içeriklere göre belirlenir.\n\n0 = Özelliğin kullanılmasına izin verirken Google'ın yapay zeka modellerini iyileştirmek için ilgili verileri kullanmasına izin verir. İlgili veriler arasında özelliğe bağlı olarak istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler yer alabilir. Bu bilgiler, gerçek kişiler tarafından da yapay zeka modellerini iyileştirmek için incelenebilir. Aşağıdaki değerler belirtilmediği sürece varsayılan değer 0'dır.\n\n1 = Özelliğin kullanılmasına izin verir ancak Google'ın kullanıcıların içeriklerini (istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler dahil) kullanarak modelleri iyileştirmesine izin vermez. Google Admin console tarafından yönetilen kurumsal kullanıcılar ve Google Workspace tarafından yönetilen eğitim hesapları için varsayılan değer 1'dir.\n\n2 = Özelliğe izin vermez.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
HideWebStoreIcon.pfm_title = "Yeni sekme sayfasında ve uygulama başlatıcıda web mağazasını gizle";
HideWebStoreIcon.pfm_description = "Chrome Web Mağazası uygulamasını ve alt bilgi bağlantısını Yeni Sekme Sayfası'nda ve Google Chrome OS uygulama başlatıcısında gizle.\n\nBu politika doğru değerine ayarlandığında simgeler gizlenir.\n\nBu politika yanlış değerine ayarlandığında veya yapılandırılmadığında simgeler görünür.";
HighEfficiencyModeEnabled.pfm_title = "Yüksek Verimlilik Modu'nu etkinleştir";
HighEfficiencyModeEnabled.pfm_description = "Bu politika, Yüksek Verimlilik Modu ayarını etkinleştirir veya devre dışı bırakır. Bu ayar, belleğin geri kazanılması için sekmelerin arka planda bir süre sonra silinmesini sağlar.\nBu politika ayarlanmazsa son kullanıcı bu ayarı chrome://settings/performance bölümünden kontrol edebilir.\n";
HistoryClustersVisible.pfm_title = "Sayfa grupları içeren Chrome geçmişi görünümünü göster";
HistoryClustersVisible.pfm_description = "Bu politika, sayfa grupları halinde düzenlenmiş Chrome geçmişi sayfasının görünürlüğünü kontrol eder.\n\nPolitika, Etkin olarak ayarlanırsa gruplar halinde düzenlenmiş bir Chrome geçmişi sayfası chrome://history/grouped adresinde görülebilir.\n\nPolitika, Devre Dışı olarak ayarlanırsa gruplar halinde düzenlenmiş bir Chrome geçmişi sayfası chrome://history/grouped adresinde görülemez.\n\nPolitika ayarlanmadan bırakılırsa gruplar halinde düzenlenmiş bir Chrome geçmişi sayfası varsayılan olarak chrome://history/grouped adresinde görülebilir.\n\nComponentUpdatesEnabled politikası Devre Dışı olarak ayarlıyken HistoryClustersVisible politikası Etkin olarak ayarlanır veya ayarlanmadan bırakılırsa gruplar halinde düzenlenmiş bir Chrome geçmişi sayfası chrome://history/grouped adresinde bulunmaya devam eder ancak kullanıcıyla alaka düzeyi düşük olabilir.\n";
HistorySearchSettings.pfm_title = "Yapay zeka destekli geçmişte arama ayarları";
HistorySearchSettings.pfm_description = "0 - Yapay zeka destekli geçmişte aramaya izin ver ve yapay zeka modellerini daha iyi hale getir.\n1 - Yapay zeka modellerini daha iyi hale getirmeden yapay zeka destekli geçmişte arama özelliğine izin ver.\n2 - Yapay zeka destekli geçmişte arama özelliğine izin verme.\nYapay zeka destekli geçmişte arama işlevi, kullanıcıların tarama geçmişlerinde yalnızca sayfa başlığı ve URL ile değil, sayfa içeriğine göre de arama yapmasına ve oluşturulan yanıtları almasına olanak tanıyan bir özelliktir.\n\n0 = Özelliğin kullanılmasına izin verirken Google'ın yapay zeka modellerini iyileştirmek için ilgili verileri kullanmasına izin verir. İlgili veriler arasında özelliğe bağlı olarak istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler yer alabilir. Bu bilgiler, gerçek kişiler tarafından da yapay zeka modellerini iyileştirmek için incelenebilir. Aşağıdaki değerler belirtilmediği sürece varsayılan değer 0'dır.\n\n1 = Özelliğin kullanılmasına izin verir ancak Google'ın kullanıcıların içeriklerini (istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler dahil) kullanarak modelleri iyileştirmesine izin vermez. Google Admin console tarafından yönetilen kurumsal kullanıcılar ve Google Workspace tarafından yönetilen eğitim hesapları için varsayılan değer 1'dir.\n\n2 = Özelliğe izin vermez.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
HomepageIsNewTabPage.pfm_title = "Ana sayfa olarak Yeni Sekme Sayfası'nı kullan";
HomepageIsNewTabPage.pfm_description = "Politika, Etkin değerine ayarlanırsa herhangi bir ana sayfanın URL konumu yok sayılarak Yeni Sekme sayfası kullanıcının ana sayfası yapılır. Politika, Devre dışı değerine ayarlanırsa kullanıcının ana sayfa URL'si chrome://newtab olarak ayarlanmadığı sürece ana sayfa hiçbir zaman Yeni Sekme sayfası olmaz.\n\nBu politikayı ayarlarsanız kullanıcılar Brave ürününde ana sayfa türlerini değiştiremez. Politika ayarlanmadan bırakılırsa ana sayfasının Yeni Sekme sayfası olup olmayacağına kullanıcı karar verir.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
HomepageLocation.pfm_title = "Ana sayfa URL'si";
HomepageLocation.pfm_description = "Politikanın ayarlanması, Brave ürününde varsayılan ana sayfa URL'sini ayarlar. Ana sayfa, ana sayfa düğmesi kullanılarak açılır. Masaüstünde, RestoreOnStartup politikaları başlangıçta açılan sayfaları kontrol eder.\n\nAna sayfa, kullanıcı veya HomepageIsNewTabPage tarafından Yeni Sekme sayfasına ayarlanırsa bu politika geçerliliğini yitirir.\n\nURL'nin http://example.com veya https://example.com gibi standart bir şema kullanması gerekir. Bu politika ayarlandığında kullanıcılar Brave ürününde ana sayfa URL'lerini değiştiremez.\n\nHem HomepageLocation hem de HomepageIsNewTabPage politikaları ayarlanmadan bırakılırsa kullanıcılar ana sayfalarını seçebilir.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
HttpAllowlist.pfm_title = "HTTP İzin Verilenler Listesi";
HttpAllowlist.pfm_description = "Bu politika ayarlanırsa HTTPS'ye yükseltilmeyecek ana makine adlarının veya ana makine\nadı kalıplarının (örneğin, \"[*.]example.com\") bir listesi belirtilir ve HTTPS öncelikli\nmod etkinse hata ara sayfası gösterilmez. Kuruluşlar, HTTPS yükseltmelerini\nve/veya HTTPS öncelikli modu devre dışı bırakmaya gerek kalmadan HTTPS'yi\ndesteklemeyen sunuculara erişimi sürdürmek için bu politikayı kullanabilir.\n\nSağlanan ana makine adları standartlaştırılmalıdır: Tüm IDN'ler, A-etiket biçimine dönüştürülmeli ve tüm ASCII harfleri küçük harf olmalıdır.\n\nGeniş kapsamlı ana makine joker karakterlerine (ör. \"*\" veya \"[*]\") izin verilmez. Bunun yerine,\nHTTPS öncelikli mod ve HTTPS yükseltmeleri kendi özel politikaları aracılığıyla açık bir şekilde devre\ndışı bırakılmalıdır.\n\nNot: Bu politika HSTS yükseltmeleri için geçerli değildir.";
HttpHeaderInjection.pfm_title = "Spesifik URL kalıpları için HTTP başlığı yerleştirmeyi yapılandır";
HttpHeaderInjection.pfm_description = "Bu politika, spesifik URL kalıplarıyla eşleşen web isteklerine özel HTTP üstbilgisi yerleştirmek için bir kural listesi tanımlanmasını sağlar. Bu politika tarafından ayarlanan başlıklar, başlangıçta istekte bulunan başlıkların yanı sıra kullanıcılar veya uzantılar tarafından yapılan değişikliklere göre önceliklidir.\n\nBu politikanın yaygın kullanım alanlarından biri, özel başlıklar (ör. X-Tenant-ID) yerleştirerek kiracı erişim denetimlerini zorunlu kılmaktır.\n\nPolitika, bir kural listesini kabul eder. Her kural şunları içerir:\n\n* patterns: Eşleştirilecek URL kalıplarının listesi. URL kalıbının nasıl biçimlendirileceğine göz atın (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\n* headers: Yerleştirilecek başlıkları temsil eden nesnelerin listesi. Her nesne şunları içerir:\n\n* name: Yerleştirilecek başlığın adı.\n\n* value: Yerleştirilecek başlığın değeri.\n\nBir istek birden fazla kuralla eşleşirse eşleşen tüm kurallardaki başlıklar uygulanır. Aynı ada sahip birden fazla başlık varsa en spesifik URL kalıbına sahip olan başlık uygulanır. Kalıplar eşit derecede spesifik ise listede en son görünen kalıp uygulanır.\n\nBaşlık adları RFC 2616 (https://www.rfc-editor.org/rfc/rfc2616) ile uyumlu olmalıdır. Başlık değerleri NUL, CR veya LF sembolleri içermemelidir. Her bir başlığın boyutu 8 KB'ı aşmamalıdır. Geçersiz başlıklar ve URL kalıpları yoksayılır.\n\nBu politika, tüm kurallarda toplam 500 URL kalıbıyla sınırlıdır. Her kural en fazla 20 başlık içerebilir. Bu eşiklerin üzerindeki kalıplar ve başlıklar yoksayılır.\n\nNot: Bir URL kalıbı, şifrelenmemiş şemalarla (http://, ws:// veya şema atlandığında) eşleşirse yapılandırılan başlıklar, şifrelenmemiş bir kanal üzerinden düz metin olarak iletilebilir ve ağ gözlemcilerine açık hale gelebilir. Hassas veya tanımlayıcı başlık değerlerini korumak için URL kalıplarını şifrelenmiş şemalarla (https:// veya wss://) kısıtlayın.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=HttpHeaderInjection adresine bakın.";
HttpsOnlyMode.pfm_title = "Yalnızca HTTPS Modunun etkinleştirilmesine izin ver";
HttpsOnlyMode.pfm_description = "allowed - Kullanıcıların Yalnızca HTTPS Modu ayarını kısıtlama\ndisallowed - Yalnızca HTTPS Modu'nu devre dışı bırak\nforce_enabled - Yüksek Düzey Modu'nda Yalnızca HTTPS Modu'nu etkinleştir\nforce_balanced_enabled - Dengeli Mod'da Yalnızca HTTPS Modu'nu etkinleştir\nBu politika, kullanıcıların Yalnızca HTTPS Modu'nu (Her Zaman Güvenli Bağlantılar Kullan) Ayarlar'da etkinleştirip etkinleştiremeyeceğini kontrol eder. Yalnızca HTTPS Modu, tüm gezinmeleri HTTPS'ye yükseltir.\n\nBu ayar belirtilmezse veya \"izin verildi\" olarak seçilirse kullanıcılar Yalnızca HTTPS Modu'nu etkinleştirebilir.\n\nBu ayar \"izin verilmedi\" olarak ayarlanırsa Yalnızca HTTPS Modu devre dışı bırakılır.\n\nBu ayar, \"force_enabled\" değerine ayarlanırsa Yalnızca HTTPS Modu, Yüksek Düzey Modu'nda etkinleştirilir.\n\nBu ayar, \"force_balanced_enabled\" değerine ayarlanırsa Yalnızca HTTPS Modu, Dengeli Mod'da etkinleştirilir.\n\n\"force_enabled\" M112 ve sonraki sürümlerde, \"force_balanced_enabled\" ise M129 ve sonraki sürümlerde desteklenir.\n\n\"force_enabled\" ve \"force_balanced_enabled\" da kullanıcılara önerilebilir.\nYalnızca HTTPS Modu başlangıçta Yüksek Düzey veya Dengeli olarak ayarlanır ancak kullanıcılar bu ayarı değiştirebilir.\n\nBu politikayı, politikayı alan Chrome sürümünün desteklemediği bir değere ayarlarsanız Chrome, varsayılan olarak izin verilen ayara geçer.\n\nBelirli ana makine adlarının veya ana makine adı kalıplarının bu özellik tarafından HTTPS'ye yükseltilmesini engellemek için ayrı HttpAllowlist politikası kullanılabilir.";
HttpsUpgradesEnabled.pfm_title = "Otomatik HTTPS yükseltmelerini etkinleştir";
HttpsUpgradesEnabled.pfm_description = "Brave, mümkün olduğunda bazı gezinme özelliklerini HTTP'den HTTPS'ye yükseltmeye çalışır. Bu politika bu davranışı devre dışı bırakmak için kullanılabilir. Bu politika \"true\" değerine ayarlanır veya ayarlanmadan bırakılırsa\nbu özellik varsayılan olarak etkinleştirilir.\n\nBelirli ana makine adlarının veya ana makine adı kalıplarının bu özellik tarafından HTTPS'ye yükseltilmesini engellemek için ayrı HttpAllowlist politikası kullanılabilir.\n\nHttpsOnlyMode politikasına da göz atın.";
IPv6ReachabilityOverrideEnabled.pfm_title = "IPv6 erişilebilirlik kontrolünü geçersiz kılmayı etkinleştir";
IPv6ReachabilityOverrideEnabled.pfm_description = "Politika, doğru değerine ayarlanırsa IPv6 erişilebilirlik kontrolü geçersiz kılınır. Bu, sistemin ana makine adlarını çözümlerken AAAA kayıtlarını her zaman sorgulayacağı anlamına gelir. Bu, cihazdaki tüm arayüzler ve kullanıcılar için geçerlidir.\n\nPolitika, yanlış değerine ayarlanır veya ayarlanmadan bırakılırsa IPv6 erişilebilirlik kontrolü geçersiz kılınmaz.\nSistem, AAAA kayıtlarını yalnızca küresel bir IPv6 ana makinesinden cihaza erişilebildiğinde sorgular.";
IdleDetectionAllowedForUrls.pfm_title = "Sitelere, boşta kalma algılama için izin verildi";
IdleDetectionAllowedForUrls.pfm_description = "Kullanıcıya sormadan Idle Detection API'yi kullanmasına izin verilen sitelerin belirtildiği URL kalıpları listesini ayarlamanıza olanak tanır. Engellenenler listesindeki girişler, izin verilenler listesindeki girişlere göre daha yüksek önceliğe sahiptir. İzin verilenler listesindeki girişler de yapılandırılmış varsayılan değere göre daha yüksek önceliğe sahiptir.\n\nGeçerli site URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir. Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yoksayılır.\n\nBu politika ayarlanmazsa tüm siteler için genel varsayılan değer kullanılır. Bu değer, ayarlanması halinde DefaultIdleDetectionSetting (varsayılan boşta kalma algılama ayarı) politikasıyla, aksi takdirde kullanıcının kişisel yapılandırmasıyla belirlenir.";
IdleDetectionBlockedForUrls.pfm_title = "Siteler, boşta kalma algılama için engellendi";
IdleDetectionBlockedForUrls.pfm_description = "Idle Detection API'yi kullanmasına izin verilmeyen siteleri belirten URL kalıpları listesini ayarlamanıza olanak tanır.\n\nGeçerli site URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir. Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yoksayılır.\n\nBu politika ayarlanmazsa tüm siteler için genel varsayılan değer kullanılır. Bu değer, ayarlanması halinde DefaultIdleDetectionSetting (varsayılan boşta kalma algılama ayarı) politikasıyla, aksi takdirde kullanıcının kişisel yapılandırmasıyla belirlenir.";
IdleTimeout.pfm_title = "Sistem boştayken yapılan işlemler gerçekleştirilmeden önceki gecikme";
IdleTimeout.pfm_description = "Bilgisayar boşta kaldığında işlem tetikler.\n\nBu politika ayarlanırsa IdleTimeoutActions, politikası aracılığıyla yapılandırılan işlemleri gerçekleştirmeden önce kullanıcı girişi olmadan geçecek süreyi (dakika cinsinden) belirtir.\n\nBu politika ayarlanmazsa herhangi bir işlem gerçekleştirilmez.\n\nMinimum eşik 1 dakikadır.\n\n\"Kullanıcı girişi\", işletim sistemi API'leri tarafından tanımlanır ve fareyi hareket ettirme ya da klavyede yazma gibi işlemleri içerir.";
IdleTimeoutActions.pfm_title = "Bilgisayar boşta kaldığında gerçekleştirilecek işlemler";
IdleTimeoutActions.pfm_description = "close_browsers - Tarayıcıları Kapat\nshow_profile_picker - Profil Seçiciyi Göster\nclear_browsing_history - Göz Atma Geçmişini Temizle\nclear_download_history - İndirme Geçmişini Temizle\nclear_cookies_and_other_site_data - Çerezleri ve Diğer Site Verilerini Temizle\nclear_cached_images_and_files - Önbelleğe Alınan Resimleri ve Dosyaları Temizle\nclear_password_signin - Şifreyle Oturum Açma Bilgilerini Temizle\nclear_autofill - Otomatik Doldurma Bilgilerini Temizle\nclear_site_settings - Site Ayarlarını Temizle\nclear_hosted_app_data - Barındırılan Uygulama Verilerini Temizle\nreload_pages - Sayfaları Yeniden Yükle\nsign_out - Çıkış\nclose_tabs - Sekmeleri Kapat\nIdleTimeout politikasındaki zaman aşımına ulaşıldığında gerçekleştirilecek işlemlerin listesi.\n\nUyarı: Bu politikanın ayarlanması, yerel kişisel verileri etkileyebilir ve kalıcı olarak silebilir. Kişisel verilerin yanlışlıkla silinmesini önlemek için dağıtmadan önce ayarlarınızı test etmeniz önerilir.\n\nIdleTimeout politikası ayarlanmazsa bu politikanın hiçbir etkisi olmaz.\n\nIdleTimeout politikasındaki zaman aşımına ulaşıldığında tarayıcı bu politikada yapılandırılan işlemleri çalıştırır.\n\nBu politika boşsa veya ayarlanmamışsa IdleTimeout politikasının hiçbir etkisi yoktur.\n\nDesteklenen işlemler şunlardır:\n\n\"close_browsers\": Bu profildeki tüm tarayıcı pencerelerini ve PWA'ları (Progresif Web Uygulaması) kapatır. Android ve iOS'te desteklenmez.\n\n\"close_tabs\": Açık pencerelerdeki tüm açık sekmeleri kapatır. Yalnızca iOS'te desteklenir.\n\n\"show_profile_picker\": Profil seçici penceresini gösterir. Android ve iOS'te desteklenmez.\n\n\"sign_out\": Oturum açmış durumdaki kullanıcının oturumu kapatılır. Yalnızca iOS'te desteklenir.\n\n\"clear_browsing_history\", \"clear_download_history\", \"clear_cookies_and_other_site_data\", \"clear_cached_images_and_files\", \"clear_password_signing\", \"clear_autofill\", \"clear_site_settings\", \"clear_hosted_app_data\": İlgili tarama verilerini temizleyin. Daha fazla bilgi için ClearBrowsingDataOnExitList politikasına bakın. iOS'te desteklenen türler şunlardır: \"clear_browsing_history\", \"clear_cookies_and_other_site_data\", \"clear_cached_images_and_files\", \"clear_password_signing\" ve \"clear_autofill\".\n\n\"reload_pages\": Tüm web sayfalarını yeniden yükler. Bazı sayfalarda önce kullanıcıdan onay istenebilir. iOS'te desteklenmez.\n\nKullanıcı, \"clear_cookies_and_other_site_data\" kullanarak çerezleri sildiğinde Google Hesabı oturumu açık kalır.\n\nSyncDisabled politikası ayarlanarak \"Chrome Sync\" devre dışı bırakılmadığı veya BrowserSignin devre dışı olmadığı sürece \"clear_browsing_history\", \"clear_password_signing\", \"clear_autofill\" ve \"clear_site_settings\" ayarlandığında ilgili veri türleri için senkronizasyon devre dışı bırakılır.";
ImagesAllowedForUrls.pfm_title = "Bu sitelerdeki resimlere izin ver";
ImagesAllowedForUrls.pfm_description = "Politikayı ayarlayarak, görselleri olan siteleri belirten URL kalıplarının listesini oluşturabilirsiniz.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultImagesSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.\n\nBu politikanın önceden Android'de hatalı bir şekilde etkinleştirildiğini, ancak bu işlevin Android'de hiçbir zaman tam olarak desteklenmediğini unutmayın.";
ImagesBlockedForUrls.pfm_title = "Bu sitelerdeki resimleri engelle";
ImagesBlockedForUrls.pfm_description = "Politikayı ayarlamak, resimleri görüntüleyemeyen siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultImagesSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\n Geçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.\n\n Bu politikanın önceden Android'de hatalı bir şekilde etkinleştirildiğini, ancak bu işlevin Android'de hiçbir zaman tam olarak desteklenmediğini unutmayın.";
ImportAutofillFormData.pfm_title = "İlk çalıştırmada, otomatik doldurma formu verilerini varsayılan tarayıcıdan içe aktar";
ImportAutofillFormData.pfm_description = "Politika Etkin değerine ayarlanırsa önceki varsayılan tarayıcıda otomatik doldurulan form verileri ilk çalıştırmada içe aktarılır. Politika Devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa otomatik doldurulan form verileri ilk çalıştırmada içe aktarılmaz.\n\nKullanıcılar içe aktarma iletişim kutusunu tetikleyebilir ve otomatik doldurulan form verileri onay kutusu, bu politikanın değerine uyacak şekilde işaretlenir veya işareti kaldırılır.";
ImportBookmarks.pfm_title = "İlk çalıştırmada yer işaretlerini varsayılan tarayıcıdan içe aktar";
ImportBookmarks.pfm_description = "Politika Etkin değerine ayarlanırsa önceki varsayılan tarayıcıdan yer işaretleri ilk çalıştırmada içe aktarılır. Politika Devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa yer işaretleri ilk çalıştırmada içe aktarılmaz.\n\nKullanıcılar içe aktarma iletişim kutusunu tetikleyebilir ve yer işaretleri onay kutusu, bu politikanın değerine uyacak şekilde işaretlenir veya işareti kaldırılır.";
ImportHistory.pfm_title = "İlk çalıştırmada tarama geçmişini varsayılan tarayıcıdan içe aktar";
ImportHistory.pfm_description = "Politika Etkin değerine ayarlanırsa önceki varsayılan tarayıcıdan tarama geçmişi ilk çalıştırmada içe aktarılır. Politika Devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa tarama geçmişi ilk çalıştırmada içe aktarılmaz.\n\nKullanıcılar içe aktarma iletişim kutusunu tetikleyebilir ve tarama geçmişi onay kutusu, bu politikanın değerine uyacak şekilde işaretlenir veya işareti kaldırılır.";
ImportHomepage.pfm_title = "İlk çalıştırmada ana sayfayı varsayılan tarayıcıdan içe aktar";
ImportHomepage.pfm_description = "Politika Etkin değerine ayarlanırsa önceki varsayılan tarayıcının ana sayfası ilk çalıştırmada içe aktarılır. Politika Devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa ana sayfa ilk çalıştırmada içe aktarılmaz.\n\nKullanıcılar içe aktarma iletişim kutusunu tetikleyebilir ve ana sayfa onay kutusu, bu politikanın değerine uyacak şekilde işaretlenir veya işareti kaldırılır.";
ImportSavedPasswords.pfm_title = "İlk çalıştırmada kayıtlı şifreleri varsayılan tarayıcıdan içe aktar";
ImportSavedPasswords.pfm_description = "Bu politika, yalnızca yüklemeden sonra ilk çalıştırma sırasındaki içe aktarma davranışını kontrol eder. Tarayıcı yüklenmeden önce genellikle farklı bir tarayıcının kullanıldığı ortamlarda Brave geçişinin daha sorunsuz bir şekilde yapılmasını sağlar. Bu politika, Google Hesaplarındaki şifre yöneticisi özelliklerini etkilemez.\n\nPolitika, Etkin değerine ayarlanırsa önceki varsayılan tarayıcıda kayıtlı olan şifreler ilk çalıştırma sırasında içe aktarılır ve ayarlar sayfasından manuel içe aktarma da gerçekleştirilebilir.\nPolitika, Devre Dışı değerine ayarlanırsa kayıtlı şifreler ilk çalıştırma sırasında içe aktarılmaz ve ayarlar sayfasından manuel içe aktarma engellenir.\nPolitika ayarlanmadan bırakılırsa kayıtlı şifreler ilk çalıştırma sırasında içe aktarılmaz ancak kullanıcılar dilerse bu işlemi ayarlar sayfasından yapabilir.";
ImportSearchEngine.pfm_title = "İlk çalıştırmada arama motorlarını varsayılan tarayıcıdan içe aktar";
ImportSearchEngine.pfm_description = "Politika Etkin değerine ayarlanırsa önceki varsayılan tarayıcıdaki varsayılan arama motoru ilk çalıştırmada içe aktarılır. Politika Devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa varsayılan arama motoru ilk çalıştırmada içe aktarılmaz.\n\nKullanıcılar içe aktarma iletişim kutusunu tetikleyebilir ve varsayılan arama motoru onay kutusu, bu politikanın değerine uyacak şekilde işaretlenir veya işareti kaldırılır.";
IncognitoModeAvailability.pfm_title = "Gizli modun kullanılabilirliği";
IncognitoModeAvailability.pfm_description = "0 - Gizli mod kullanılabilir\n1 - Gizli mod devre dışı\n2 - Gizli mod zorunlu\nKullanıcının Brave içinde Gizli modda sayfa açıp açamayacağını belirtir.\n\n\"Etkin\" değeri seçilirse veya politika ayarlanmadan bırakılırsa sayfalar Gizli modda açılabilir.\n\n\"Devre Dışı\" değeri seçilirse sayfalar Gizli modda açılamaz.\n\n\"Zorunlu\" seçeneği belirlenirse sayfalar YALNIZCA Gizli modda açılabilir. \"Zorunlu\" seçeneğinin Android-on-Chrome'da çalışmadığını unutmayın\n\nIncognitoModeUrlAllowlist politikası bu politikaya göre daha önceliklidir ve belirli URL'ler için Gizli modu yeniden etkinleştirebilir. İzin verilenler listesi sağlandığında Gizli mod bu politika tarafından devre dışı bırakılırsa Gizli mod, yalnızca izin verilenler listesiyle eşleşen URL'lerde kullanılabilir. Diğer tüm sayfalar engellenir.\n\nNot: iOS'te oturum esnasında yapılan politika değişiklikleri, yeniden başlatmanın ardından uygulanır.";
IncognitoModeUrlAllowlist.pfm_title = "Gizli modda URL listesine erişime izin ver.";
IncognitoModeUrlAllowlist.pfm_description = "Politikanın ayarlanması, Gizli modda listelenen URL'lere erişim sağlar. Bu politikayı, (https://support.google.com/chrome/a?p=url_blocklist_filter_format) adresinde belirtilen biçimi kullanarak IncognitoModeUrlBlocklist politikasında tanımlanan belirli URL kalıplarına ilişkin istisnaları açmak için kullanın.\n\nHem bu politika hem de IncognitoModeUrlBlocklist politikası ayarlanırsa izin verilenler listesi öncelikli olur. Bir URL, izin verilenler listesindeki bir kalıpla eşleşirse URL'ye izin verilir. Engellenenler listesindeki bir kalıpla eşleşir ancak izin verilenler listesindeki bir kalıpla eşleşmezse URL engellenir. Bir URL hiçbiriyle eşleşmezse yedek olarak genel URLBlocklist/URLAllowlist politikaları kullanılır.\n\nBu politika ayarlanır ve IncognitoModeUrlBlocklist politikası ayarlanmazsa izin verilenler listesinde yer almayan tüm URL'ler Gizli modda engellenir.\n\nIncognitoModeAvailability politikası izin vermeyecek şekilde (1 değeri) ayarlanır ancak bu politika yapılandırılırsa Gizli mod yalnızca izin verilenler listesindeki URL'ler için kullanılabilir.\n\nPolitika ayarlanmadan bırakılırsa IncognitoModeUrlBlocklist ve IncognitoModeAvailability politikası için hiçbir istisnaya izin verilmez.\n\nBu politika yalnızca Gizli modu etkiler. URL'lere tüm kullanıcı profillerinde izin vermek için lütfen URLAllowlist politikasını kullanın.\n\nGeniş kapsamlı ana makine joker karakterlerine (ör. \"*\" veya \"[*]\") izin verilmez. Özelliği dünya genelinde etkinleştirmek için IncognitoModeAvailability politikasını kullanın.\n\nBu politika 1.000 giriş ile sınırlıdır.";
IncognitoModeUrlBlocklist.pfm_title = "Gizli modda URL listesine erişimi engelle.";
IncognitoModeUrlBlocklist.pfm_description = "IncognitoModeUrlBlocklist politikası ayarlanırsa yasaklı URL'leri olan web sayfalarının Gizli modda yüklenmesi durdurulur. Yöneticiler engellenecek URL kalıplarının listesini belirtebilir. URL kalıbının nasıl biçimlendirileceğine göz atın ( https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nHem bu politika hem de IncognitoModeUrlAllowlist politikası ayarlanırsa izin verilenler listesi öncelikli olur. Bir URL, izin verilenler listesindeki bir kalıpla eşleşirse URL'ye izin verilir. Engellenenler listesindeki bir kalıpla eşleşir ancak izin verilenler listesindeki bir kalıpla eşleşmezse URL engellenir. Bir URL hiçbiriyle eşleşmezse yedek olarak genel URLBlocklist/URLAllowlist politikaları kullanılır.\n\nIncognitoModeUrlAllowlist politikası ayarlanır ve bu politika ayarlanmazsa izin verilenler listesinde yer almayan tüm URL'ler Gizli modda engellenir.\n\nIncognitoModeAvailability politikası izin vermeyecek şekilde (1 değeri) ayarlanır ancak IncognitoModeUrlAllowlist politikası yapılandırılırsa Gizli mod yalnızca izin verilenler listesindeki URL'ler için kullanılabilir.\n\nBu politika yalnızca Gizli modu etkiler. URL'leri tüm kullanıcı profillerinde engellemek için lütfen URLBlocklist politikasını kullanın.\n\nBu politika 1.000 giriş ile sınırlıdır.";
InsecureContentAllowedForUrls.pfm_title = "Bu sitelerde güvenli olmayan içeriğe izin ver";
InsecureContentAllowedForUrls.pfm_description = "Engellenebilir (ör. etkin) karma içeriği (ör. HTTPS sitelerindeki HTTP içeriği) görüntülemesine izin verilen sitelerin belirtildiği ve isteğe bağlı olarak engellenebilir karma içerik yükseltmelerinin devre dışı bırakılacağı bir URL kalıpları listesini ayarlamanıza olanak tanır.\n\nBu politika ayarlanmadan bırakılırsa engellenebilir karma içerik engellenir ve isteğe bağlı olarak engellenebilir karma içerik yükseltilir, ayrıca kullanıcıların belirli sitelerde buna izin vermek üzere istisnalar ayarlamasına izin verilir.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
InsecureContentBlockedForUrls.pfm_title = "Bu sitelerde güvenli olmayan içeriği engelle";
InsecureContentBlockedForUrls.pfm_description = "Engellenebilir (ör. etkin) karma içeriği (ör. HTTPS sitelerindeki HTTP içeriği) görüntülemelerine izin verilmeyen sitelerin belirtildiği ve isteğe bağlı olarak engellenebilir (ör. pasif) karma içeriğin yükseltileceği bir URL kalıpları listesini ayarlamanıza olanak tanır.\n\nBu politika ayarlanmadan bırakılırsa engellenebilir karma içerik engellenir ve isteğe bağlı olarak engellenebilir karma içerik yükseltilir, ancak kullanıcıların belirli sitelerde buna izin vermek üzere istisnalar ayarlamasına izin verilir.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
IntensiveWakeUpThrottlingEnabled.pfm_title = "IntensiveWakeUpThrottling özelliğini kontrol eder.";
IntensiveWakeUpThrottlingEnabled.pfm_description = "IntensiveWakeUpThrottling özelliği, etkinleştirildiği zaman arka plan sekmelerindeki JavaScript zamanlayıcılarının yoğun şekilde kısıtlanmasına ve birleştirilmesine, bir sayfa 5 dakika veya daha uzun süre arka planda kaldıktan sonra dakikada bir defadan fazla çalışmamasına neden olur.\n\nBu, web standartlarına uyumlu bir özelliktir ancak belirli işlemlerin bir dakikaya kadar gecikmesine neden olarak bazı web sitelerinde işlevselliği bozabilir. Ancak etkin olduğunda önemli ölçüde CPU ve pil tasarrufu sağlar. Daha fazla ayrıntı için https://bit.ly/30b1XR4 sayfasına bakabilirsiniz.\n\nBu politika, etkin değerine ayarlanırsa özellik etkin olmaya zorlanır ve kullanıcılar bunu geçersiz kılamaz.\n\nBu politika, devre dışı değerine ayarlanırsa özellik devre dışı olmaya zorlanır ve kullanıcılar bunu geçersiz kılamaz.\n\nBu politika ayarlanmadan bırakılırsa özellik kullanıcılar tarafından manuel olarak yapılandırılabilen kendi dahili mantığı tarafından kontrol edilir.\n\nPolitikanın oluşturucu işlemi başına uygulandığını ve bir oluşturucu işlemi başladığında geçerli olan politika ayarının en son değerinin kullanıldığını unutmayın. Tüm yüklenen sekmelerin tutarlı bir politika ayarı almasını sağlamak için tam bir yeniden başlatma gereklidir. İşlemlerin bu politikanın farklı değerleriyle çalışması zararlı değildir.\n";
IntranetRedirectBehavior.pfm_title = "İntranet Yönlendirme Davranışı";
IntranetRedirectBehavior.pfm_description = "0 - Varsayılan tarayıcı davranışını kullan.\n1 - DNS müdahale kontrollerini ve bunu mu demek istediniz \"http://intranetsite/\" bilgi çubuklarını devre dışı bırak.\n2 - DNS müdahale kontrollerini devre dışı bırak; bunu mu demek istediniz \"http://intranetsite/\" bilgi çubuklarına izin ver.\n3 - DNS müdahale kontrollerine ve bunu mu demek istediniz \"http://intranetsite/\" bilgi çubuklarına izin ver.\nBu politika, DNS müdahale kontrolleriyle intranet yönlendirmelerinin davranışını yapılandırır. Kontroller, tarayıcının bilinmeyen ana bilgisayar adlarına yönlendirme yapan bir proxy'nin arkasında olup olmadığını anlamaya çalışır.\n\nBu politika ayarlanmazsa tarayıcı, DNS müdahale kontrollerinin varsayılan davranışını ve intranet yönlendirme önerilerini kullanır. Bunlar M88'de varsayılan olarak etkindir, ancak gelecekteki sürümde varsayılan olarak devre dışı bırakılacaktır.\n\nDNSInterceptionChecksEnabled politikası da DNS müdahale kontrollerini devre dışı bırakabilen, bu işlevle ilgili bir politikadır. Daha esnek bir sürüm olan bu politika, intranet yönlendirme bilgi çubuklarını ayrı ayrı kontrol edebilir ve gelecekte genişletilebilir.\nDNSInterceptionChecksEnabled politikası veya bu politika, müdahale kontrollerinin devre dışı bırakılmasını isterse kontroller devre dışı bırakılır.";
IsolateOrigins.pfm_title = "Site İzolasyonu'nu belirtilen kaynaklar için etkinleştirme";
IsolateOrigins.pfm_description = "Özel işlem içinde çalışan kaynakların listesini belirtin.\n\nBu politika, Android üzerinde yalnızca yeterli belleğe (kesinlikle 3,2 GB'tan fazla RAM) sahip cihazlarda çalışır. Kaynak açısından sınırlı cihazlarda çok fazla siteyi izole etmek performans sorunlarına neden olabilir. Kaynak açısından sınırlı Android cihazlarda bunun yerine lütfenIsolateOriginsShortlist kullanın.\n\n1 GB'tan az belleğe sahip cihazlarda herhangi bir işlem izolasyonunun özel olarak yapılandırılması önerilmez.\n\nAdı verilen her kaynağın işleminde yalnızca o kaynaktan ve kaynağın alt alan adlarından belgeler bulunabilir. Örneğin, https://a1.example.com/ alan adı tanımlandığında aynı işlem içerisinde https://a2.a1.example.com/ bulunabilir ancak https://example.com veya https://b.example.com bulunamaz.\n\n77. Brave sürümünden itibaren, joker karakter kullanarak izole edilecek bir kaynak aralığı belirlemek mümkündür. Örneğin, https://[*.]corp.example.com alan adı belirlenirse, https://corp.example.com alan adının kendisi, https://a1.corp.example.com ve https://a2.a1.corp.example.com dahil olmak üzere https://corp.example.com alan adının altında bulunan her bir kaynak kendi özel işlemi içinde çalışır.\n\nSitePerProcess politikasında açıklandığı üzere masaüstü platformlarda tüm sitelerin (şema artı eTLD+1, örneğin, https://example.com) varsayılan olarak zaten izole olduğunu unutmayın. Bu IsolateOrigins politikası, daha ince ayrıntı düzeyindeki belirli kaynakların (ör. https://a.example.com) izole edilmesinde faydalıdır.\n\nAndroid işlemi sisteminin Brave sürüm 77'den itibaren varsayılan olarak bazı hassas siteleri izole ettiğini, bu politikanın da söz konusu modun kapsamını bazı diğer siteleri izole edecek şekilde genişlettiğini unutmayın.\n\nAyrıca, normalde aynı sitedeki iki belge, document.domain değerlerini değiştirip eşleşerek aynı sitedeki diğer kaynaklardan komut dosyası çalıştırabilse de bu politika tarafından izole edilen kaynaklar, aynı sitedeki diğer kaynaklardan komut dosyası çalıştıramaz. Yöneticiler, bir kaynağı izole etmeden önce, yaygın olmayan bu davranışın ilgili kaynak üzerinde kullanılmadığından emin olmalıdır.\n\nPolitika, boş bir dizeye ayarlanır veya ayarlanmadan bırakılırsa hiçbir belirli kaynak için site izolasyonu gerekmez. Kullanıcılar isterlerse komut satırı işaretini kullanarak işlem izolasyonunu manuel olarak etkinleştirebilir.";
JavaScriptAllowedForUrls.pfm_title = "Bu sitelerde JavaScript'e izin ver";
JavaScriptAllowedForUrls.pfm_description = "Politikayı ayarlamak, JavaScript çalıştırabilen siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultJavaScriptSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
JavaScriptBlockedForUrls.pfm_title = "Bu sitelerde JavaScript'i engelle";
JavaScriptBlockedForUrls.pfm_description = "Politikayı ayarlamak, JavaScript çalıştıramayan siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultJavaScriptSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.\n\nBu politikanın, JavaScript'i üst düzey belgenin kaynağının (genellikle adres çubuğunda da görüntülenen sayfa URL'si) kalıplardan herhangi biriyle eşleşip eşleşmediğine göre engellediğini unutmayın. Dolayısıyla bu politika web tedarik zinciri saldırılarını azaltmak için uygun değildir. Örneğin \"https://[*.]foo.com/\" kalıbının kullanılması, https://example.com/ adresinde barındırılan bir sayfanın https://www.foo.com/example.js adresinden yüklenen bir komut dosyasını çalıştırmasını engellemez. Ayrıca, \"https://example.com/\" kalıbının kullanılması, https://example.com adresindeki bir belgenin üst düzey belge olmamasına rağmen başka bir kaynakta (ör. https://www.bar.com) barındırılan bir sayfanın alt çerçevesi olarak yerleştirilmiş olması durumunda bu belgenin komut dosyası çalıştırmasını da engellemez.";
JavaScriptJitAllowedForSites.pfm_title = "Bu sitelerde JavaScript'in JIT kullanmasına izin ver";
JavaScriptJitAllowedForSites.pfm_description = "JIT (Just In Time) derleyicisi etkinken JavaScript çalıştırmasına izin verilen sitelerin belirtildiği bir site URL kalıpları listesini ayarlamanıza olanak tanır.\n\nGeçerli site URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.\n\nPolitika istisnaları, belirli alt alan adlarının yanı sıra sitelerin tamamı için de ayarlanabilir. Örneğin, yalnızca altalanadi.site.com için ayarlanan bir politika, site.com'u etkilemeden altalanadi.site.com'a uygulanır. Bir alt alan adı, üst sitesinden izole edilemediği bazı durumlarda site.com'da ayarlanan politikayı devralabilir. Ayrıca istisnalar, site yeni bir sekmede açılana kadar mevcut bir sekmede yüklenen çerçeveler için geçerli olmayabilir. Düşük bellekli Android cihazlarda siteye özel istisnalar zorunlu kılınmayabilir. Siteler bunun yerine, ayarlanmışsa DefaultJavaScriptJitSetting politikasını veya varsayılan olarak profilin JavaScript JIT ayarını kullanır.\n\nBrave, istisnaları zorunlu kılmak için ayarları varsayılandan farklı olan siteleri veya alt alan adlarını özel işlemlere yerleştirebilir. Bu durum, özellikle Android cihazlarda veya bir joker karakter kalıbı çok sayıda alt alan adıyla eşleştiğinde bellek kullanımını artırabilir. Bunun nedeni, eşleşen her kaynağın ayrı ayrı izole edilebilmesidir. İzole edilmiş alt alan adları, üst sitelerine erişmek için document.domain'i de kullanamaz.\n\nNot: 155 ve önceki sürümlerde politika istisnaları yalnızca site ayrıntı düzeyinde (eTLD+1) zorunlu kılınıyordu. Yalnızca altalanadi.site.com için ayarlanan bir politika, altalanadi.site.com için bile geçerli olmuyordu. Hem site.com hem de altalanadi.site.com'da geçerli olması için politikanın site.com üzerinde ayarlanması gerekiyordu.\n\nBu politika, yalnızca üst düzey kaynak URL'ye göre değil, her bir çerçeve için ayrı ayrı uygulanır. Örneğin, site-bir.com sitesi JavaScriptJitAllowedForSites politikasında listelenmişse ancak site-iki.com'u içeren bir çerçeve yüklüyorsa site-bir.com'da JavaScript JIT etkinleştirilir. Ancak site-iki.com, ayarlanmışsa DefaultJavaScriptJitSetting politikasını kullanır veya varsayılan olarak JavaScript JIT'yi etkinleştirir. Engellenenler listesindeki girişler, izin verilenler listesindeki girişlere göre daha yüksek önceliğe sahiptir. İzin verilenler listesindeki girişler de yapılandırılmış varsayılan değere göre daha yüksek önceliğe sahiptir.\n\nBu politikanın ayarlanmadığı bir site için mevcutsa DefaultJavaScriptJitSetting ayarının politikası geçerli olur, mevcut değilse JavaScript JIT site için etkinleştirilir.";
JavaScriptJitBlockedForSites.pfm_title = "Bu sitelerde JavaScript'in JIT kullanmasını engelle";
JavaScriptJitBlockedForSites.pfm_description = "JIT (Just In Time) derleyicisi etkinken JavaScript çalıştırmasına izin verilmeyen sitelerin belirtildiği bir site URL kalıpları listesini ayarlamanıza olanak tanır.\n\nJavaScript JIT'in devre dışı bırakılması, Brave tarayıcının, web içeriğini daha yavaş oluşturabileceği, ayrıca JavaScript'in WebAssembly gibi bazı bölümlerini devre dışı bırakabileceği anlamına gelir. JavaScript JIT'in devre dışı bırakılması, Brave tarayıcının, web içeriğini daha güvenli bir konfigürasyonda oluşturmasına imkan sağlayabilir.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.\n\nPolitika istisnaları, belirli alt alan adlarının yanı sıra sitelerin tamamı için de ayarlanabilir. Örneğin, yalnızca altalanadi.site.com için ayarlanan bir politika, site.com'u etkilemeden altalanadi.site.com'a uygulanır. Bir alt alan adı, üst sitesinden izole edilemediği bazı durumlarda site.com'da ayarlanan politikayı devralabilir. Ayrıca istisnalar, site yeni bir sekmede açılana kadar mevcut bir sekmede yüklenen çerçeveler için geçerli olmayabilir. Düşük bellekli Android cihazlarda siteye özel istisnalar zorunlu kılınmayabilir. Siteler bunun yerine, ayarlanmışsa DefaultJavaScriptJitSetting politikasını veya varsayılan olarak profilin JavaScript JIT ayarını kullanır.\n\nBrave, istisnaları zorunlu kılmak için ayarları varsayılandan farklı olan siteleri veya alt alan adlarını özel işlemlere yerleştirebilir. Bu durum, özellikle Android cihazlarda veya bir joker karakter kalıbı çok sayıda alt alan adıyla eşleştiğinde bellek kullanımını artırabilir. Bunun nedeni, eşleşen her kaynağın ayrı ayrı izole edilebilmesidir. İzole edilmiş alt alan adları, üst sitelerine erişmek için document.domain'i de kullanamaz.\n\nNot: 155 ve önceki sürümlerde politika istisnaları yalnızca site ayrıntı düzeyinde (eTLD+1) zorunlu kılınıyordu. Yalnızca altalanadi.site.com için ayarlanan bir politika, altalanadi.site.com için bile geçerli olmuyordu; hem site.com hem de altalanadi.site.com'da geçerli olması için politikanın site.com üzerinde ayarlanması gerekiyordu.\n\nBu politika, yalnızca üst düzey kaynak URL'ye göre değil, her bir çerçeve için ayrı ayrı uygulanır. Örneğin, site-bir.com sitesi JavaScriptJitBlockedForSites politikasında listelenmişse ancak site-iki.com'u içeren bir çerçeve yüklüyorsa site-bir.com'da JavaScript JIT devre dışı bırakılır. Ancak site-iki.com, ayarlanmışsa DefaultJavaScriptJitSetting politikasını kullanır veya varsayılan olarak JavaScript JIT'yi etkinleştirir. Engellenenler listesindeki girişler, izin verilenler listesindeki girişlere göre daha yüksek önceliğe sahiptir. İzin verilenler listesindeki girişler de yapılandırılmış varsayılan değere göre daha yüksek önceliğe sahiptir.\n\nBu politikanın ayarlanmadığı bir site için mevcutsa DefaultJavaScriptJitSetting ayarının politikası geçerli olur, mevcut değilse JavaScript JIT site için etkinleştirilir.";
JavaScriptOptimizerAllowedForSites.pfm_title = "Bu sitelerde JavaScript optimizasyonuna izin ver";
JavaScriptOptimizerAllowedForSites.pfm_description = "Gelişmiş JavaScript optimizasyonlarının etkinleştirildiği siteleri belirten site URL kalıplarının listesini oluşturmanıza olanak tanır.\n\nGeçerli site URL kalıpları hakkında ayrıntılı bilgi için\nhttps://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz.\nJoker karakterlere (*) izin verilir.\n\nPolitika istisnaları, belirli alt alan adlarının yanı sıra sitelerin tamamı için de ayarlanabilir.\nÖrneğin, yalnızca altalanadi.site.com için ayarlanan bir politika, site.com'u\netkilemeden altalanadi.site.com'a uygulanır. Bir alt alan adının, üst sitesinden\nizole edilemediği bazı durumlarda site.com'da ayarlanan politikayı devralabilir. Ayrıca\nistisnalar, site yeni bir sekmede açılana kadar mevcut bir sekmede yüklenen\nçerçeveler için geçerli olmayabilir. Düşük bellekli\nAndroid cihazlarda siteye özel istisnalar zorunlu\nkılınmayabilir. Siteler bunun yerine, ayarlanmışsa DefaultJavaScriptOptimizerSetting politikasını veya\nvarsayılan olarak profilin JavaScript optimizasyon ayarını kullanır.\n\nBrave, istisnaları zorunlu kılmak\niçin ayarları varsayılandan farklı olan siteleri veya alt alan adlarını\nözel işlemlere yerleştirebilir. Bu durum, özellikle Android cihazlarda\nveya bir joker karakter kalıbı çok sayıda alt alan adıyla eşleştiğinde\nbellek kullanımını artırabilir. Bunun nedeni, eşleşen her kaynağın ayrı ayrı izole edilebilmesidir. İzole edilmiş\nalt alan adları, üst sitelerine erişmek için document.domain'i de kullanamaz.\n\nNot: 138 ve önceki sürümlerde politika istisnaları yalnızca site ayrıntı düzeyinde\n(eTLD+1) zorunlu kılınıyordu. Yalnızca altalanadi.site.com için ayarlanan bir politika,\naltalanadi.site.com için bile geçerli olmuyordu. Hem site.com hem de altalanadi.site.com'da geçerli olması\niçin politikanın site.com üzerinde ayarlanması gerekiyordu.\n\nBu politika, yalnızca üst düzey kaynak URL'ye göre değil, her bir çerçeve için\nayrı ayrı uygulanır. Örneğin, site-bir.com sitesi JavaScriptOptimizerAllowedForSites politikasında listelenmişse ancak site-iki.com'u içeren bir çerçeve yüklüyorsa site-bir.com'da JavaScript optimizasyonları etkinleştirilir.\nAncak site-iki.com, ayarlanmışsa DefaultJavaScriptOptimizerSetting politikasını kullanır veya varsayılan olarak JavaScript\noptimizasyonlarını etkinleştirir. Engellenenler listesindeki girişler, izin verilenler listesindeki girişlere göre daha yüksek önceliğe sahiptir. İzin verilenler listesindeki girişler de yapılandırılmış varsayılan değere göre daha yüksek önceliğe sahiptir.\n\nBu politikanın ayarlanmadığı bir site için mevcutsa DefaultJavaScriptOptimizerSetting ayarının politikası geçerli olur, mevcut değilse JavaScript optimizasyonu site için etkinleştirilir.";
JavaScriptOptimizerBlockedForSites.pfm_title = "Bu sitelerde JavaScript optimizasyonlarını engelle";
JavaScriptOptimizerBlockedForSites.pfm_description = "Gelişmiş JavaScript optimizasyonlarının devre dışı bırakıldığı siteleri belirten site URL kalıplarının listesini oluşturmanıza olanak tanır.\n\nJavaScript optimizasyonlarının devre dışı bırakılması, Brave tarayıcının web içeriğini daha yavaş oluşturabileceği anlamına gelir.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için\nhttps://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz.\nJoker karakterlere (*) izin verilir.\n\nPolitika istisnaları, belirli alt alan adlarının yanı sıra sitelerin tamamı için de ayarlanabilir.\nÖrneğin, yalnızca altalanadi.site.com için ayarlanan bir politika, site.com'u etkilemeden altalanadi.site.com'a uygulanır. Bir alt alan adı, üst sitesinden izole edilemediği bazı durumlarda site.com'da ayarlanan politikayı devralabilir. Ayrıca istisnalar, site yeni bir sekmede açılana kadar mevcut bir sekmede yüklenen çerçeveler için geçerli olmayabilir. Düşük bellekli Android cihazlarda siteye özel istisnalar zorunlu kılınmayabilir. Siteler bunun yerine, ayarlanmışsa DefaultJavaScriptOptimizerSetting politikasını veya varsayılan olarak profilin JavaScript optimizasyon ayarını kullanır.\n\nBrave, istisnaları zorunlu kılmak için ayarları varsayılandan farklı olan siteleri veya alt alan adlarını özel işlemlere yerleştirebilir. Bu durum, özellikle Android cihazlarda veya bir joker karakter kalıbı çok sayıda alt alan adıyla eşleştiğinde bellek kullanımını artırabilir. Bunun nedeni, eşleşen her kaynağın ayrı ayrı izole edilebilmesidir. İzole edilmiş alt alan adları, üst sitelerine erişmek için document.domain'i de kullanamaz.\n\nNot: 138 ve önceki sürümlerde politika istisnaları yalnızca site ayrıntı düzeyinde (eTLD+1) zorunlu kılınıyordu. Yalnızca altalanadi.site.com için ayarlanan bir politika, altalanadi.site.com için bile geçerli olmuyordu; hem site.com hem de altalanadi.site.com'da geçerli olması için politikanın site.com üzerinde ayarlanması gerekiyordu.\n\nBu politika, yalnızca üst düzey kaynak URL'ye göre değil, her bir çerçeve için ayrı ayrı uygulanır. Örneğin, site-bir.com sitesi JavaScriptOptimizerBlockedForSites politikasında listelenmişse ancak site-iki.com'u içeren bir çerçeve yüklüyorsa site-bir.com'da JavaScript optimizasyonları devre dışı bırakılır. Ancak site-iki.com, ayarlanmışsa DefaultJavaScriptOptimizerSetting politikasını kullanır veya varsayılan olarak JavaScript optimizasyonlarını etkinleştirir. Engellenenler listesindeki girişler, izin verilenler listesindeki girişlere göre daha yüksek önceliğe sahiptir. İzin verilenler listesindeki girişler de yapılandırılmış varsayılan değere göre daha yüksek önceliğe sahiptir.\n\nBu politikanın ayarlanmadığı bir site için mevcutsa DefaultJavaScriptOptimizerSetting ayarının politikası geçerli olur, mevcut değilse JavaScript optimizasyonu site için etkinleştirilir.";
LiveCaptionEnabled.pfm_title = "Canlı Altyazıyı Etkinleştir";
LiveCaptionEnabled.pfm_description = "Canlı Altyazı özelliğini etkinleştirin.\n\nBu politika, Etkin değerine ayarlanırsa Canlı Altyazı özelliği her zaman açık olur.\n\nBu politika, Devre Dışı değerine ayarlanırsa Canlı Altyazı özelliği her zaman kapalı olur.\n\nBu politikayı zorunlu olarak ayarlarsanız kullanıcılar politikayı değiştiremez veya geçersiz kılamaz.\n\nBu politika ayarlanmadan bırakılırsa Canlı Altyazı özelliği başlangıçta devre dışı bırakılır, ancak kullanıcılar istedikleri zaman etkinleştirebilir.";
LiveTranslateEnabled.pfm_title = "Canlı Çeviri'yi etkinleştir";
LiveTranslateEnabled.pfm_description = "Canlı altyazıların çevrilmesini etkinleştirin. Altyazılar, çeviri için Google'a gönderilir.\n\nBu politika, Etkin değerine ayarlanırsa Canlı Çeviri özelliği her zaman açık olur.\n\nBu politika, Devre Dışı değerine ayarlanırsa Canlı Çeviri özelliği her zaman kapalı olur.\n\nBu politikayı zorunlu olarak ayarlarsanız kullanıcılar politikayı değiştiremez veya geçersiz kılamaz.\n\nBu politika ayarlanmadan bırakılırsa Canlı Çeviri özelliği başlangıçta devre dışı bırakılır, ancak kullanıcılar istedikleri zaman etkinleştirebilir.\n\nLiveCaptionEnabled, Devre Dışı değerine ayarlanırsa bu politika ayarından bağımsız olarak Canlı Çeviri devre dışı bırakılır.";
LocalFontsAllowedForUrls.pfm_title = "Bu sitelerde yerel yazı tiplerine izin ver";
LocalFontsAllowedForUrls.pfm_description = "Yerel yazı tipleri izninin otomatik olarak verileceği siteleri belirten site URL kalıplarının yer aldığı bir liste oluşturur. Bu durumda sitelerin, yerel yazı tipleriyle ilgili bilgileri görme imkanı artmış olur.\n\nGeçerli site URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir. Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yoksayılır.\n\nBu politikanın ayarlanmadığı siteler için, ayarlanmışsa DefaultLocalFontsSetting politikası geçerli olur. Aksi takdirde ilgili izin, tarayıcının varsayılan ayarına uyarak kullanıcıların site bazında bu izni belirlemesine imkan verir.";
LocalFontsBlockedForUrls.pfm_title = "Bu sitelerde yerel yazı tipleri iznini engelle";
LocalFontsBlockedForUrls.pfm_description = "Yerel yazı tipleri izninin otomatik olarak reddedileceği siteleri belirten site URL kalıplarının yer aldığı bir liste oluşturur. Bu durumda sitelerin, yerel yazı tipleriyle ilgili bilgileri görme imkanı kısıtlanmış olur.\n\nGeçerli site URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir. Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yok sayılır.\n\nBu politikanın ayarlanmadığı siteler için, ayarlanmışsa DefaultLocalFontsSetting politikası geçerli olur. Aksi takdirde ilgili izin, tarayıcının varsayılan ayarına uyarak kullanıcıların site bazında bu izni belirlemesine imkan verir.";
LocalNetworkAccessAllowedForUrls.pfm_title = "Sitelerin yerel cihazlara ve yerel ağ uç noktalarına ağ isteği göndermesine izin ver.";
LocalNetworkAccessAllowedForUrls.pfm_description = "URL kalıpları listesi Eşleşen kaynakların sunduğu web sitelerinden başlatılan istekler Local Network Access kontrollerine tabi değildir.\n\nBurada belirtilen kalıpların dışında kalan kaynaklar için kullanıcının kişisel yapılandırması geçerli olur.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.\n\nLocal Network Access kısıtlamaları için https://wicg.github.io/local-network-access/ sayfasına bakabilirsiniz.\n\nYerel cihaza ve yerel ağ uç noktalarına yönelik istekleri etkileyen, içinde kaynakların listelendiği birden fazla politika vardır. Bir kaynak aşağıdaki politikalardan birden fazlasıyla eşleşirse politikalar aşağıdaki öncelik sırasına göre uygulanır:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "Sitelerin yerel cihazlara ve yerel ağ uç noktalarına ağ isteği göndermesini engelle.";
LocalNetworkAccessBlockedForUrls.pfm_description = "URL kalıpları listesi Eşleşen kaynakların sunduğu web sitelerinden başlatılan ağ isteklerinin Local Network Access istekleri göndermesi engellenir.\n\nBurada belirtilen kalıpların dışında kalan kaynaklar için kullanıcının kişisel yapılandırması geçerli olur.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.\n\nLocal Network Access kısıtlamaları için https://wicg.github.io/local-network-access/ sayfasına bakabilirsiniz.\n\nYerel cihaza ve yerel ağ uç noktalarına yönelik istekleri etkileyen, içinde kaynakların listelendiği birden fazla politika vardır. Bir kaynak aşağıdaki politikalardan birden fazlasıyla eşleşirse politikalar aşağıdaki öncelik sırasına göre uygulanır:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "IP adresi alanı eşlemelerini geçersiz kıl";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "Bu, belirli dahili adres aralıklarını \"herkese açık\" olarak değerlendirmek ve dolayısıyla Local Network Access kontrollerine tabi tutmamak için kullanılabilir. Diğer taraftan, dahili olarak kullanılabilecek belirli herkese açık adres aralıklarını \"yerel\" olarak değerlendirmek için de kullanılabilir. Böylece, bu adresler Local Network Access kontrolleriyle korunur.\n\nIP adresi alanı, iki şekilde geçersiz kılınabilir:\n\n[cidr]=[public|local|loopback]\n\nBurada [cidr], CIDR gösteriminde bir IP adresi aralığıdır (IPv4 için https://tools.ietf.org/html/rfc4632 adresindeki 3.1. bölüme ve IPv6 için ise https://tools.ietf.org/html/rfc4291 adresindeki 2.3. bölümüne bakın). IPv6 adresleri, URL açısından güvenli (köşeli parantezli) biçimde belirtilmelidir. CIDR geçersiz kılmaları, tüm bağlantı noktaları için geçerlidir.\n\nveya\n\n[ip-address]:[port]=[public|local|loopback]\n\nLocal Network Access hakkında daha fazla bilgi için https://wicg.github.io/local-network-access/ ve https://developer.chrome.com/blog/local-network-access adreslerini ziyaret edin.\n\nBu politika, dinamik yenilemeyi desteklemez.\n\n--ip-address-space-overrides komut satırı anahtarından yapılan geçersiz kılmalar, bu politika tarafından ayarlanan geçersiz kılmalara göre önceliklidir.";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "Açıkça yetki verilmeden alt çerçevelerde yerel ağ erişimi (LNA) isteklerine izin ver";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "Varsayılan olarak, yerel ağ erişimi (LNA) izinlerinin kaynaklar arası alt çerçevelerde istenmesine yalnızca açıkça yetkilendirildikleri takdirde izin verilir. Bu politika, bu varsayılan davranışı geçersiz kılmak için kullanılabilir. Böylece LNA izinleri, izin politikasında açıkça reddedilmediği sürece alt çerçevelere varsayılan olarak devredilir.\n\nBu politika, etkin değerine ayarlanırsa alt çerçeveler tüm LNA izin politikası özellikleri için varsayılan olarak yetkilendirilir ve yerel ağ isteği gönderebilir (bu işlem, izin istemini tetikler).\n\nBu politika, devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa alt çerçevelerin yerel ağ isteği gönderebilmesi ve izin istemini tetikleyebilmesi için izin politikası özelliğiyle açıkça yetkilendirilmesi gerekir.\n\nBu politika; \"local-network-access\", \"loopback-network\" ve \"local-network\" izin politikası özellikleri için geçerlidir.\n\nYerel ağ erişimi hakkında daha fazla bilgiyi https://wicg.github.io/local-network-access/ ve https://developer.chrome.com/blog/local-network-access sayfasında bulabilirsiniz.\n\nİzin politikası hakkında daha fazla bilgiyi https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy sayfasında bulabilirsiniz.";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "Yerel ağ erişimi kısıtlamalarının (geçici olarak) devre dışı bırakılıp bırakılmayacağını belirtir";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "Bu politika, Etkin değerine ayarlanırsa Local Network Access\nistekleri, Local Network Access kontrollerinin başarısız olması nedeniyle yalnızca Chrome DevTools içinde uyarı gösterir.\n\nBu politika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa Local Network Access istekleri, bu istekler için varsayılan yöntemle işlenir.\n\nLocal Network Access kısıtlamaları için https://wicg.github.io/local-network-access/ sayfasına bakabilirsiniz.\n\nBu kurumsal politika geçici olup M163 sürümünden sonra kaldırılacaktır.\n\nUzun vadede, Local Network Access izninin otomatik olarak verilmesi gereken URL kalıplarının izin verilenler listesine eklenmesi için LocalNetworkAccessAllowedForUrls politikası kullanılabilir.";
LocalNetworkAllowedForUrls.pfm_title = "Sitelerin yerel ağ uç noktalarına istekte bulunmasına izin ver.";
LocalNetworkAllowedForUrls.pfm_description = "URL kalıplarının listesi. Eşleşen kaynakların sunduğu web sitelerinden başlatılan yerel ağ uç noktalarına yönelik ağ istekleri, Local Network Access kontrollerine tabi değildir.\n\nBurada belirtilen kalıpların dışında kalan kaynaklar için kullanıcının kişisel yapılandırması geçerli olur.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.\n\nLocal Network Access kısıtlamaları için https://wicg.github.io/local-network-access/ sayfasına bakabilirsiniz.\n\nYerel ağ uç noktalarına yönelik istekleri etkileyen ve içinde kaynakların listelendiği birden fazla politika vardır. Bir kaynak aşağıdaki politikalardan birden fazlasıyla eşleşirse politikalar aşağıdaki öncelik sırasına göre uygulanır:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkBlockedForUrls.pfm_title = "Sitelerin yerel ağ uç noktalarına istekte bulunmasını engelle";
LocalNetworkBlockedForUrls.pfm_description = "URL kalıplarının listesi. Eşleşen kaynakların sunduğu web sitelerinden başlatılan yerel ağ uç noktalarına yönelik ağ isteklerinin Local Network Access isteği göndermesi engellenir.\n\nBurada belirtilen kalıpların dışında kalan kaynaklar için kullanıcının kişisel yapılandırması geçerli olur.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.\n\nLocal Network Access kısıtlamaları için https://wicg.github.io/local-network-access/ sayfasına bakabilirsiniz.\n\nYerel ağ uç noktalarına yönelik istekleri etkileyen ve içinde kaynakların listelendiği birden fazla politika vardır. Bir kaynak aşağıdaki politikalardan birden fazlasıyla eşleşirse politikalar aşağıdaki öncelik sırasına göre uygulanır:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LookalikeWarningAllowlistDomains.pfm_title = "Alan adlarında benzer alan adı uyarılarını gizle";
LookalikeWarningAllowlistDomains.pfm_description = "Bu politika, listelenen sitelerde benzer URL uyarılarının gösterilmesini engeller. Brave tarafından kullanıcının tanıdığı bir sitenin adresini taklit ettiği düşünülen sitelerde bu uyarılar gösterilir.\n\nPolitika etkinleştirilerek bir veya daha fazla alan adına ayarlanırsa kullanıcı o alan adındaki sayfaları ziyaret ederken benzer uyarı sayfaları gösterilmez.\n\nPolitika devre dışı bırakılır, ayarlanmaz veya boş listeye ayarlanırsa uyarılar kullanıcının ziyaret ettiği her sitede gösterilebilir.\n\nAna makine adı tam olarak eşleşirse veya alan adında eşleşme söz konusu olursa ana makine adına izin verilebilir. Örneğin, bu listede \"foo.example.com\" veya \"example.com\" yer alıyorsa \"https://foo.example.com/bar\" gibi bir URL için uyarılar gizlenebilir.";
LoopbackNetworkAllowedForUrls.pfm_title = "Sitelerin yerel cihaza ağ isteği göndermesine izin ver.";
LoopbackNetworkAllowedForUrls.pfm_description = "URL kalıplarının listesi. Eşleşen kaynakların sunduğu web sitelerinden başlatılan yerel cihaza yönelik ağ istekleri, Local Network Access kontrollerine tabi değildir.\n\nBurada belirtilen kalıpların dışında kalan kaynaklar için kullanıcının kişisel yapılandırması geçerli olur.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.\n\nLocal Network Access kısıtlamaları için https://wicg.github.io/local-network-access/ sayfasına bakabilirsiniz.\n\nYerel cihaza yönelik istekleri etkileyen ve içinde kaynakların listelendiği birden fazla politika vardır. Bir kaynak aşağıdaki politikalardan birden fazlasıyla eşleşirse politikalar aşağıdaki öncelik sırasına göre uygulanır:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LoopbackNetworkBlockedForUrls.pfm_title = "Sitelerin yerel cihaza ağ isteği göndermesini engelle.";
LoopbackNetworkBlockedForUrls.pfm_description = "URL kalıplarının listesi. Eşleşen kaynakların sunduğu web sitelerinden başlatılan yerel cihaza yönelik ağ isteklerinin Local Network Access isteği göndermesi engellenir.\n\nBurada belirtilen kalıpların dışında kalan kaynaklar için kullanıcının kişisel yapılandırması geçerli olur.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.\n\nLocal Network Access kısıtlamaları için https://wicg.github.io/local-network-access/ sayfasına bakabilirsiniz.\n\nYerel cihaza yönelik istekleri etkileyen ve içinde kaynakların listelendiği birden fazla politika vardır. Bir kaynak aşağıdaki politikalardan birden fazlasıyla eşleşirse politikalar aşağıdaki öncelik sırasına göre uygulanır:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
ManagedBookmarks.pfm_title = "Yönetilen Yer İşaretleri";
ManagedBookmarks.pfm_description = "Politikayı ayarlamak, her biri \"name\" ve \"url\" anahtarlarna sahip bir sözlük olan yer işaretlerinin listesini oluşturur. Bu anahtarlar yer işaretinin adını ve hedefini içerir. Yöneticiler, \"url\" anahtarı olmayan ancak ek \"children\" anahtarı içeren bir yer işareti tanımlayarak alt klasör oluşturabilir. Bu anahtarda bazıları klasör olabilecek yer işaretleri listesi de olabilir. Chrome, eksik URL'leri adres çubuğu kullanılarak gönderilmiş gibi düzeltir. Örneğin, \"google.com\" olan bir URL \"https://google.com/\" halini alır.\n\nKullanıcılar, yer işaretlerinin yerleştirildiği klasörleri değiştiremezler (ancak yer işareti çubuğunda gizleyebilirler). Yönetilen yer işaretlerinin varsayılan klasör ismi \"Yönetilen Yer İşaretleri\"dir fakat politikaya değere istenilen klasör adı yazılan \"toplevel_name\" isminde tek bir anahtara sahip yeni bir alt sözlük ekleyerek değiştirilebilir. Yönetilen yer işaretleri kullanıcı hesabıyla senkronize edilmez ve uzantılar bunların üzerinde değişiklik yapamaz.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=ManagedBookmarks adresine bakın.";
ManagedConfigurationPerOrigin.pfm_title = "Belirli kaynaklar için web sitelerine yönetilen yapılandırma değerleri ayarla";
ManagedConfigurationPerOrigin.pfm_description = "Politikanın ayarlanması, belirli bir kaynak için Managed Configuration API'nin döndürdüğü değeri tanımlar.\n\n Bir anahtar/değer yapılandırması olan Managed Configuration API'ye navigator.managed.getManagedConfiguration() javascript çağrısı ile erişilebilir. Bu API, yalnızca WebAppInstallForceList aracılığıyla zorunlu yüklenmiş web uygulamalarına karşılık gelen kaynaklar için kullanılabilir.\n\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin adresine bakın.";
MaxConnectionsPerProxy.pfm_title = "WebSocket dışı istekler için proxy sunucu başına yapılabilecek maksimum eşzamanlı bağlantı sayısı";
MaxConnectionsPerProxy.pfm_description = "Politikanın ayarlanması, WebSocket dışı istekler için proxy sunucu başına yapılabilecek maksimum eşzamanlı bağlantı sayısını belirtir.\n\nWebSocket istek sınırlarını değiştirmek için MaxConnectionsPerProxyForWebSocket bölümüne göz atın.\n\nPolitika ayarlanmadan bırakılırsa, varsayılan değer olarak 128 kullanılır.\n\nBazı web uygulamalarının askıda kalan GET'lerle çok fazla bağlantı kullandığı bilinmektedir. Bu nedenle, 128'den küçük bir değerin ayarlanması, askıda bağlantısı olan çok fazla web uygulamasının açık olması halinde tarayıcı bağlantılarının yavaşlamasına neden olabilir.\nBazı proxy sunucular istemci başına çok sayıda eşzamanlı bağlantıyı işleyemez. Bu sorun, bu politikanın daha düşük bir değere ayarlanmasıyla çözülür.\n\nDeğer, 6 veya daha yüksek olmalıdır.\nBu sınırın altında bir değer belirlerseniz 6 kullanılır.\nVarsayılanın (128) altında bir değer ayarlarsanız bunun tüm riski size aittir.\n\nDeğer, 256'ya (Brave 147 ve önceki sürümlerde 99) eşit veya daha düşük olmalıdır.\nBu sınırın üzerinde bir değer ayarlanırsa 256 (Brave 147 ve önceki sürümlerde 99) kullanılır.\nVarsayılan değerin (128) üzerinde bir değer ayarlamak tamamen sizin sorumluluğunuzdadır.\n\nUygulanan sınırların AllowSocketPoolSizeRandomizationForProxies tarafından etkilendiğini lütfen unutmayın.";
MaxConnectionsPerProxyForWebSocket.pfm_title = "WebSocket istekleri için proxy sunucu başına yapılabilecek maksimum eşzamanlı bağlantı sayısı";
MaxConnectionsPerProxyForWebSocket.pfm_description = "Politikanın ayarlanması, WebSocket istekleri için proxy sunucu başına yapılabilecek maksimum eşzamanlı bağlantı sayısını belirtir.\n\nWebSocket dışı istek sınırlarını değiştirmek için MaxConnectionsPerProxy bölümüne göz atın.\n\nPolitika ayarlanmadan bırakılırsa, varsayılan değer olarak 128 kullanılır.\n\nBazı web uygulamalarının askıda kalan GET'lerle çok fazla bağlantı kullandığı bilinmektedir. Bu nedenle, 128'den küçük bir değerin ayarlanması, askıda bağlantısı olan çok fazla web uygulamasının açık olması halinde tarayıcı bağlantılarının yavaşlamasına neden olabilir.\nBazı proxy sunucular istemci başına çok sayıda eşzamanlı bağlantıyı işleyemez. Bu sorun, bu politikanın daha düşük bir değere ayarlanmasıyla çözülür.\n\nDeğer, 6 veya daha yüksek olmalıdır.\nBu sınırın altında bir değer belirlerseniz 6 kullanılır.\nVarsayılanın (128) altında bir değer ayarlarsanız bunun tüm riski size aittir.\n\nDeğer, 256'ya eşit veya 256'dan küçük olmalıdır.\nBu sınırın üzerinde bir değer belirlerseniz 256 kullanılır.\nVarsayılan değerin (128) üzerinde bir değer ayarlamak tamamen sizin sorumluluğunuzdadır.\n\nUygulanan sınırların AllowSocketPoolSizeRandomizationForProxies tarafından etkilendiğini lütfen unutmayın.";
MaxInvalidationFetchDelay.pfm_title = "Bir politika iptal edildikten sonra maksimum getirme gecikmesi";
MaxInvalidationFetchDelay.pfm_description = "Politikanın ayarlanması bir politika iptalinin alınmasıyla cihaz yönetimi hizmetinden yeni politikanın getirilmesi arasındaki maksimum gecikmeyi milisaniye olarak belirtir. Geçerli değerler, 1.000 (1 saniye) ile 300.000 (5 dakika) aralığındadır. Bu aralık dışındaki değerler ilgili sınıra ayarlanır.\n\nPolitika ayarlanmadan bırakılırsa Brave, 10 saniye olan varsayılan değeri kullanır.";
MediaRecommendationsEnabled.pfm_title = "Medya Önerilerini Etkinleştir";
MediaRecommendationsEnabled.pfm_description = "Varsayılan olarak tarayıcı, kullanıcıya göre kişiselleştirilmiş medya önerileri gösterir. Bu politika Devre Dışı değerine ayarlanırsa bu öneriler kullanıcıdan gizlenir. Bu politika Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcıya medya önerileri gösterilir.";
MediaRouterCastAllowAllIPs.pfm_title = "Google Cast ürününün tüm IP adreslerindeki Yayın cihazlarına bağlanmasına izin ver";
MediaRouterCastAllowAllIPs.pfm_description = "EnableMediaRouter politikası Devre dışı değerine ayarlanmadığı sürece, MediaRouterCastAllowAllIPs politikası Etkin değerine ayarlanırsa Google Cast yalnızca RFC1918/RFC4193 özel adreslerinde değil tüm IP adreslerinde yayın cihazlarına bağlanır.\n\nPolitika, Devre Dışı değerine ayarlanırsa Google Cast yalnızca RFC1918/RFC4193 adreslerinde yayın cihazlarına bağlanır.\n\nPolitika ayarlanmadan bırakılırsa Google Cast yalnızca RFC1918/RFC4193 adreslerinde yayın cihazlarına bağlanır (CastAllowAllIPs özelliği açılmazsa).";
MemorySaverModeSavings.pfm_title = "Bellek Tasarrufu modunun tasarruf düzeyini değiştir";
MemorySaverModeSavings.pfm_description = "0 - Orta düzeyde bellek tasarrufu.\n1 - Dengeli bellek tasarrufu.\n2 - Maksimum bellek tasarrufu.\nBu politika, Bellek Tasarrufu'nun tasarruf düzeyini değiştirir.\n\nBu politika yalnızca Bellek Tasarrufu, ayarlardan veya HighEfficiencyModeEnabled politikası aracılığıyla etkinleştirildiğinde geçerli olur ve sekmelerin ne zaman silineceğini belirlemek için buluşsal yöntemlerin kullanılma biçimini etkiler. Örneğin, etkin olmayan bir sekmeyi silmeden önce ömrünü kısaltmak bellek tasarrufu sağlayabilir ancak sekmelerin daha sık yeniden yükleneceği anlamına da gelir. Bu da kötü bir kullanıcı deneyimine ve daha fazla ağ trafiğine neden olabilir.\n\nPolitikayı 0 - Bellek Tasarrufu değerine ayarlamak orta düzeyde bellek tasarrufu sağlar. Sekmeler daha uzun süre sonra devre dışı kalır.\n\nPolitikayı 1 - Bellek Tasarrufu değerine ayarlamak dengeli bellek tasarrufu sağlar. Sekmeler ideal süre sonunda devre dışı kalır.\n\nPolitikayı 2 - Bellek Tasarrufu değerine ayarlamak maksimum bellek tasarrufu sağlar. Sekmeler daha kısa süre sonra devre dışı kalır.\n\nBu politika ayarlanmazsa son kullanıcı bu ayarı chrome://settings/performance bölümünden kontrol edebilir.";
MetricsReportingEnabled.pfm_title = "Kullanım ve kilitlenme ile ilgili verilerin raporlanmasını etkinleştir";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "Yeni Sekme Sayfası'nda kartları göster";
NTPCardsVisible.pfm_description = "Bu politika, Yeni Sekme Sayfası'nda kartların görünürlüğünü kontrol eder. Kartlar, kullanıcının göz atma davranışına göre genel kullanıcı işlemlerini başlatmak için giriş noktalarını gösterir.\n\nPolitika, Etkin değerine ayarlandığında, içerik varsa Yeni Sekme Sayfası, kartları gösterir.\n\nPolitika, Devre Dışı değerine ayarlanırsa Yeni Sekme Sayfası, kartları göstermez.\n\nPolitika ayarlanmazsa kart görünürlüğünü kullanıcı kontrol edebilir. Varsayılan ayarda kartlar görünür.\n";
NTPCustomBackgroundEnabled.pfm_title = "Kullanıcıların Yeni Sekme sayfasındaki arka planı özelleştirmelerin izin ver.";
NTPCustomBackgroundEnabled.pfm_description = "Politika false (yanlış) değerine ayarlanırsa Yeni Sekme sayfası kullanıcıların arka planı özelleştirmesine izin vermez. Mevcut herhangi bir özel arka plan, politika daha sonra true (doğru) değerine ayarlansa bile, kalıcı olarak kaldırılacaktır.\n\nPolitika true (doğru) değerine ayarlanırsa veya ayarlanmamış olarak bırakılırsa kullanıcılar Yeni Sekme sayfasındaki arka planı özelleştirebilirler.\n\nNot: Android'de politika, tarayıcıya yalnızca tarayıcı yeniden başlatıldıktan sonra uygulanır.";
NTPFooterExtensionAttributionEnabled.pfm_title = "Yeni Sekme Sayfası'nda uzantı ilişkilendirmesiyle ilgili bilginin görünürlüğünü kontrol et";
NTPFooterExtensionAttributionEnabled.pfm_description = "Bu politika, Yeni Sekme Sayfası'nda (NTP) değişiklik yapan uzantıyı belirten bir bilgilendirmenin, NTP'nin altbilgi bölümünde gösterilip gösterilmeyeceğini belirler.\n\nVarsayılan olarak, bir uzantı standart NTP'yi geçersiz kılmışsa bu değişikliğin söz konusu uzantıdan kaynaklandığını belirten bir mesaj altbilgide görünür. Bu bilgilendirmede genellikle ilgili uzantının Chrome Web Mağazası'ndaki bağlantısı da bulunur.\n\nBu politika ayarlanmadan bırakılır veya Doğru değerine ayarlanırsa bir uzantı NTP'yi kontrol ederken uzantıyla ilgili bilgilendirme yeni sekme sayfasının altbilgisinde görünür.\n\nBu politika, Yanlış değerine ayarlanırsa NTP altbilgisinde uzantıyla ilgili bilgilendirme gizlenir.";
NTPFooterManagementNoticeEnabled.pfm_title = "Yönetilen tarayıcılar için yeni sekme sayfasındaki yönetim bildiriminin görünürlüğünü kontrol edin";
NTPFooterManagementNoticeEnabled.pfm_description = "Bu politika, Yeni Sekme Sayfası'nın altbilgi bölümündeki yönetim bildiriminin görünürlüğünü kontrol eder. Tarayıcı bir kuruluş tarafından yönetiliyorsa varsayılan olarak yeni sekme sayfası altbilgisinde bilgiler görüntülenir (bir bina simgesi ve \"[alan adı] tarafından yönetiliyor\" ifadesiyle belirtilir). Bu ayar, EnterpriseCustomLabelForBrowser ve EnterpriseLogoUrlForBrowser politikaları kullanılarak özelleştirilebilir.\n\nBu politika ayarlanmadan bırakılır veya Doğru değerine ayarlanırsa yönetilen tarayıcılarda bir simgeyle birlikte \"… tarafından yönetiliyor\" bildirimi gösterilir.\n\nBu politika, Yanlış değerine ayarlanırsa yönetim bildirimi gizlenir.\n\nBu politikanın yalnızca yönetilen tarayıcılar için geçerli olduğunu ve yönetilmeyen tarayıcılardaki yönetilen kullanıcı hesaplarını etkilemediğini unutmayın.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
NTPOutlookCardVisible.pfm_title = "Yeni Sekme Sayfası'nda Outlook Takvim kartını göster";
NTPOutlookCardVisible.pfm_description = "Bu politika, Yeni Sekme Sayfası'nda Outlook Kartı'nın görünürlüğünü kontrol eder. Kart yalnızca politika etkinleştirilirse ve kuruluşunuz Outlook Takvim verilerinin tarayıcıda kullanılmasına izin verirse Yeni Sekme Sayfası'nda gösterilir.\n\nOutlook verileri tarayıcı tarafından depolanmaz.\n\nOutlook kartı bir sonraki takvim etkinliğinin yanı sıra günün diğer saatlerindeki toplantılarla ilgili genel bir bakış sunar. Bu özelliğin amacı, kullanıcılara bir sonraki toplantılarının kısayolunu sunarak bağlam değiştirme sorununu gidermek ve üretkenliği artırmaktır.\n\nMicrosoft Outlook kartının kullanılabilmesi için ek yönetici yapılandırması gerekir. Chrome Yeni Sekme Sayfası Kartı'nın Outlook'a bağlanması hakkında ayrıntılı bilgi için lütfen https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards adresine göz atın.\n\nNTPCardsVisible devre dışı bırakılırsa Outlook kartı gösterilmez. NTPCardsVisible etkinleştirilirse Outlook kartının gösterilmesi için bu politika da etkinleştirilmeli ve gösterilecek veri bulunmalıdır. NTPCardsVisible ayarlanmazsa Outlook kartının gösterilmesi için bu politikanın etkinleştirilmesi, ayrıca kullanıcının Chrome'u Özelleştir bölümünden kartı etkinleştirmesi ve gösterilecek veri bulunması gerekir.";
NTPSharepointCardVisible.pfm_title = "Yeni Sekme Sayfası'nda SharePoint ve OneDrive Dosya Kartı'nı göster";
NTPSharepointCardVisible.pfm_description = "Bu politika, Yeni Sekme Sayfası'nda SharePoint ve OneDrive Dosya Kartı'nın görünürlüğünü kontrol eder. Kart yalnızca politika etkinleştirilirse ve kuruluşunuz SharePoint Dosya verilerinin tarayıcıda kullanılmasına izin verirse Yeni Sekme Sayfası'nda gösterilir.\n\nSharePoint ve OneDrive verileri tarayıcı tarafından depolanmaz.\n\nSharePoint ve OneDrive Dosyaları öneri kartında, önerilen dosyaların bir listesi bulunur.  Bu özelliğin amacı, kullanıcılara en önemli dokümanlarının kısayollarını sunarak bağlam değiştirme sorununu gidermek ve verimliliği artırmaktır.\n\nMicrosoft SharePoint ve OneDrive kartı için ek yönetici yapılandırması gerekir. Chrome Yeni Sekme Sayfası Kartı'nın Sharepoint'e bağlanması hakkında ayrıntılı bilgi için lütfen https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards adresine göz atın.\n\nNTPCardsVisible devre dışı bırakılırsa SharePoint ve OneDrive kartı gösterilmez. NTPCardsVisible etkinleştirilirse Sharepoint ve OneDrive kartının gösterilmesi için bu politika da etkinleştirilmeli ve gösterilecek veri bulunmalıdır. NTPCardsVisible ayarlanmazsa Sharepoint ve OneDrive kartının gösterilmesi için bu politikanın etkinleştirilmesi, ayrıca kullanıcının Chrome'u Özelleştir bölümünden kartı etkinleştirmesi ve gösterilecek veri bulunması gerekir.";
NTPShortcuts.pfm_title = "Yeni Sekme Sayfası'nda kısayollar ayarlama";
NTPShortcuts.pfm_description = "Politika ayarlandığında Brave Yeni Sekme sayfasında 10 adede kadar özel kısayol önceden yapılandırılır.\n\nBu politika ayarlanırsa kullanıcılar kişisel kısayollarının yanı sıra varsayılan olarak bu kısayolları da görür. Kullanıcılar, \"Chrome'u Özelleştir\" panelinde kuruluşlarının kısayollarının görünürlüğünü kontrol edebilir.\n\nKısayol URL'leri benzersiz olmalıdır.\n\nallow_user_edit, doğru değerine ayarlanırsa kullanıcılar kısayolun adını değiştirebilir. Yanlış değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar adı düzenleyemez.\n\nallow_user_delete, doğru değerine ayarlanırsa kullanıcılar kısayolu kaldırabilir. Politika, yanlış değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar kısayolu kaldıramaz.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=NTPShortcuts adresine bakın.";
NativeMessagingAllowlist.pfm_title = "Engellenenler listesinden muaf tutulacak yerel mesajlaşma ana makinelerinin adları";
NativeMessagingAllowlist.pfm_description = "Politikanın ayarlanması, reddetme listesine tabi olmayan yerel mesajlaşma ana makinelerini belirtir. Reddetme listesi değerinin * olması, açıkça izin verilmediği sürece tüm yerel mesajlaşma ana makinelerinin reddedileceği anlamına gelir.\n\nVarsayılan olarak tüm yerel mesajlaşma ana makinelerine izin verilir. Ancak tüm yerel mesajlaşma ana makineleri politikaya göre yasaklandıysa yönetici, bu politikayı değiştirmek için izin verilenler listesini kullanabilir.";
NativeMessagingBlocklist.pfm_title = "Yasak yerel mesajlaşma ana makinelerinin adları (veya hepsi için *)";
NativeMessagingBlocklist.pfm_description = "Politikanın ayarlanması, yüklenmemesi gereken yerel mesajlaşma ana makinelerini belirtir. Reddetme listesi değerinin * olması, açıkça izin verilmediği sürece tüm yerel mesajlaşma ana makinelerinin reddedileceği anlamına gelir.\n\nPolitika ayarlanmadan bırakılırsa Brave, tüm yüklü yerel mesajlaşma ana makinelerini yükler.";
NativeMessagingUserLevelHosts.pfm_title = "Kullanıcı düzeyinde Yerel Mesajlaşma ana makinelerine izin ver (yönetici şifreleri olmadan yüklenir)";
NativeMessagingUserLevelHosts.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, yüklü yerel mesajlaşma ana makinelerini kullanıcı düzeyinde kullanabilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa Brave, bu ana makineleri yalnızca sistem düzeyinde yüklendiyse kullanabilir.";
NetworkPredictionOptions.pfm_title = "Ağ tahminini etkinleştir";
NetworkPredictionOptions.pfm_description = "0 - Ağ bağlantılarında ağ işlemlerini tahmin et\n1 - Hücresel olmayan ağlarda ağ işlemlerini tahmin et.\n(50'de kullanımdan kaldırılmıştır, 52'de kaldırılmıştır. 52'den sonra, 1 değeri ayarlanırsa 0 olarak (ağ bağlantılarında ağ işlemlerini tahmin et değeri gibi) işlem görür.)\n2 - Ağ bağlantılarında ağ işlemlerini tahmin etme\nBu politika, Brave içinde ağ tahminini kontrol eder. DNS'nin önceden getirilmesini, TCP ve SSL ön bağlantısını ve web sayfalarının önceden oluşturulmasını kontrol eder.\n\nBu politikayı ayarlarsanız kullanıcılar değiştiremez. Bu politika ayarlanmadan bırakılırsa ağ tahmini etkinleştirilir, ancak kullanıcı bunu değiştirebilir.";
NewTabPageLocation.pfm_title = "Yeni Sekme sayfasının URL'si";
NewTabPageLocation.pfm_description = "Politikanın ayarlanması, varsayılan Yeni Sekme sayfasının URL'sini yapılandırır ve kullanıcıların değiştirmesini önler.\n\nYeni Sekme sayfası, yeni sekmeler ve pencerelerle açılır.\n\nBu politika başlangıçta hangi sayfaların açılacağını belirlemez. Bu sayfalar RestoreOnStartup politikaları ile kontrol edilir. Bu politika, Yeni Sekme sayfasını açacak şekilde ayarlanmışsa ana sayfayı etkiler. Aynı şekilde Yeni Sekme sayfasını açacak şekilde ayarlanmışsa başlangıç sayfasını da etkiler.\n\nTamamen standartlaştırılmış bir URL sağlamak en iyi uygulamadır. URL tamamen standartlaştırılmazsa Brave, varsayılan olarak https:// seçer.\n\nPolitika ayarlanmaz veya boş bırakılırsa varsayılan Yeni Sekme sayfası kullanılır.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
NotificationsAllowedForUrls.pfm_title = "Bu sitelerde bildirimlere izin ver";
NotificationsAllowedForUrls.pfm_description = "Politikayı ayarlamak bildirimleri görüntüleyebilen siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultNotificationsSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
NotificationsBlockedForUrls.pfm_title = "Bu sitelerde bildirimleri engelle";
NotificationsBlockedForUrls.pfm_description = "Politikayı ayarlamak, bildirimleri görüntüleyemeyen siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultNotificationsSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
NtlmV2Enabled.pfm_title = "NTLMv2 kimlik doğrulamasını etkinleştir.";
NtlmV2Enabled.pfm_description = "Politika Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa NTLMv2 açılır.\n\nPolitika Devre dışı değerine ayarlanırsa NTLMv2 kapanır.\n\nEn son Samba ve Microsoft® Windows® sunucularının tamamı NTLMv2'yi desteklemektedir. Bu, kimlik doğrulamanın güvenliğini azalttığından yalnızca geriye dönük uyumluluk için kapatılmalıdır.";
OopPrintDriversAllowed.pfm_title = "İşlem dışı yazıcı sürücülerine izin veriliyor";
OopPrintDriversAllowed.pfm_description = "Brave öğesinin, yazıcı sürücüleriyle ayrı bir hizmet işleminden etkileşime geçip geçmediğini kontrol eder. Mevcut yazıcıları sorgulamak, yazdırma sürücüsü ayarlarını almak ve doküman göndererek yerel yazıcılara yazdırmak için yapılan platform yazdırma çağrıları, hizmet işleminden gerçekleştirilir. Bu tür çağrıları, tarayıcı işleminin dışına taşımak, kararlılığı iyileştirmeye ve Yazdırma Önizleme'deki donmuş kullanıcı arayüzü davranışını azaltmaya yardımcı olur.\n\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, platform yazdırma görevleri için ayrı bir hizmet işlemi kullanır.\n\nBu politika Devre Dışı değerine ayarlanırsa Brave, platform yazdırma görevleri için tarayıcı işlemini kullanır.\n\nBu politika, gelecekte işlem dışı yazıcı sürücüleri özelliği tamamen kullanıma sunulduktan sonra kaldırılacaktır.";
OriginAgentClusterDefaultEnabled.pfm_title = "Varsayılan olarak kaynak içeren veya kaynaklarla ilişkili aracı kümelemeye izin verir.";
OriginAgentClusterDefaultEnabled.pfm_description = "Bu politika varsayılan olarak kaynak içeren veya kaynaklarla ilişkili aracı kümelemeye izin verir.\n\nKaynak Aracısı Kümesi: HTTP başlığı, bir dokümanın kaynak içeren veya kaynaklarla ilişkili aracı kümesinde mi yoksa site içeren veya sitelerle ilişkili aracı kümesinde mi erişime kapalı olacağını kontrol eder. Kaynak içeren veya kaynaklarla ilişkili aracı kümesi, dokümanların kaynağa göre erişime kapatılmasına izin verdiği için güvenlik etkileri olabilir. Bu durumun geliştirici tarafından görünür olan sonucu, document.domain erişeninin artık ayarlanamamasıdır.\n\nKaynak Aracısı Kümesi olmadığında gerçekleşen varsayılan davranış: Başlık ayarlanmış,\nM111'de site içeren veya sitelerle ilişkili seçeneğinden kaynak içeren veya kaynaklarla ilişkili seçeneğine geçiş.\n\nBu politika etkinleştirilir veya ayarlanmadan bırakılırsa tarayıcı bu sürümden itibaren yeni varsayılanı izler.\n\nBu politika devre dışı bırakılırsa bu değişiklik tersine çevrilir ve dokümanlarda Kaynak Aracısı Kümesi olmaz. Başlıklar, site içeren veya sitelerle ilişkili aracı kümelerine atanır. Sonuç olarak document.domain erişeni varsayılan olarak ayarlanabilir olur. Bu da eski davranışla aynıdır.\n\nAyrıntılı bilgi için https://developer.chrome.com/blog/immutable-document-domain/ sayfasını inceleyin.";
OriginKeyedProcessesEnabled.pfm_title = "Kaynak içeren veya kaynaklarla ilişkili işlem yalıtımını varsayılan olarak etkinleştir.";
OriginKeyedProcessesEnabled.pfm_description = "Çoğu sayfa için (yani varsayılan olarak kaynak içeren veya kaynaklarla ilişkili aracı kümesine atanan sayfalar) kaynak içeren işlem yalıtımını etkinleştirir. Bu, işlem güvenliğini iyileştirmenin yanı sıra oluşturulan işlem sayısını da artırır. Kullanıcıların, ayarlanmış politika değerini komut satırı işaretleri veya chrome://flags sayfası yoluyla (her ikisi de bu özelliği etkinleştirmek veya devre dışı bırakmak için kullanılabilir) geçersiz kılmasına izin verilir.\n\nPolitika, Etkin değerine ayarlanırsa aynı sitedeki diğer kaynaklar da dahil olmak üzere çoğu kaynak yalıtılır. IsolateOrigins ve SitePerProcess politikalarına da göz atın.\n\nPolitika, Devre Dışı değerine ayarlanırsa bir kaynak açıkça talep etmediği sürece hiçbir kaynak, bulunduğu sitenin geri kalanından yalıtılmaz.\n\nPolitika ayarlanmazsa hangi kaynakların ne zaman yalıtılacağını tarayıcı belirler.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "Güvenli olmayan başlangıç noktalarında kısıtlamaların uygulanmaması gereken başlangıç noktaları ve ana makine adı kalıpları";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "Bu politika ayarlanırsa güvenli olmayan kaynaklarda güvenlik kısıtlamalarının geçerli olmayacağı kaynakların (URL'ler) veya ana makine adı kalıplarının (örneğin, *.example.com) bir listesi belirtilir. Kalıplar yalnızca ana makine adlarında kullanılabilir. Şemaları olan URL'ler/kaynaklar tam dize biçiminde olmalıdır. Kuruluşlar, TLS dağıtamayan eski uygulamalar için kaynak ayarlayabilir veya dahili web geliştirme için hazırlık sunucusu kurulumu yapabilir. Böylece geliştiriciler hazırlık sunucusunda TLS dağıtmak zorunda kalmadan güvenli içerik gerektiren özellikleri test edebilir. Bu politika, kaynağın adres çubuğunda \"Güvenli Değil\" olarak etiketlenmesini de önler.\n\nBu politikada bir URL listesi ayarlamakla, aynı URL'lerin virgülle ayrılmış bir listesine --unsafely-treat-insecure-origin-as-secure komut satırı işaretini ayarlamak aynı sonucu verir. Bu politika ayarlanırsa komut satırı işaretini ve UnsafelyTreatInsecureOriginAsSecure politikasını geçersiz kılar.\n\nGüvenli içerikler hakkında daha fazla bilgi için Secure Contexts sayfasına (https://www.w3.org/TR/secure-contexts) bakabilirsiniz.";
PartitionedBlobUrlUsage.pfm_title = "Blob URL'lerinin, getirme ve gezinme işlemleri sırasında bölümlendirilip bölümlendirilmeyeceğini seç";
PartitionedBlobUrlUsage.pfm_description = "Bu politika, blob URL'lerinin getirme ve gezinme işlemleri sırasında bölümlendirilip bölümlendirilmeyeceğini kontrol eder.\nBu politika Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa blob URL'leri bölümlendirilir.\nBu politika Devre Dışı değerine ayarlanırsa blob URL'leri bölümlendirilmez.\n\nBu politikayı kullanmanız gerekirse lütfen Brave adresinden hata bildiriminde bulunun.\nBildiriminizde, kullanım alanınızı açıklamayı unutmayın. Bu politikanın Brave 146 sürümüyle sunulması planlanmıştır. Bu sürümden\nsonra eski uygulama kaldırılacaktır.\n\nNOT: Tarayıcı çalışırken bu politikada yapılan değişiklikleri yalnızca\nyeni başlatılan oluşturucu işlemleri yansıtır.\n\nÜçüncü taraf depolama bölümlendirmesi hakkında ayrıntılı bilgi için https://developers.google.com/privacy-sandbox/cookies/storage-partitioning adresine göz atabilirsiniz.";
PasswordDismissCompromisedAlertEnabled.pfm_title = "Girilen kimlik bilgisi için güvenliği ihlal edilmiş şifre uyarılarını kapatmayı etkinleştir";
PasswordDismissCompromisedAlertEnabled.pfm_description = "Politika, etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcıya güvenliği ihlal edilmiş şifre uyarılarını kapatma/geri yükleme seçeneği sunulur.\n\nBu ayarı devre dışı bırakırsanız kullanıcılar güvenliği ihlal edilmiş şifre uyarılarını kapatamaz. Ayar etkinleştirilirse kullanıcılar güvenliği ihlal edilmiş şifre uyarılarını kapatabilir.";
PasswordLeakDetectionEnabled.pfm_title = "Girilen kimlik bilgileri için sızıntı algılamayı etkinleştir";
PasswordLeakDetectionEnabled.pfm_description = "Politika, Etkin değerine ayarlanırsa kullanıcılar, Brave ürününün, girilen kullanıcı adları ve şifrelerin bir sızıntının parçası olup olmadığını kontrol etmesini sağlayabilirler.\n\nPolitika, Devre Dışı değerine ayarlanırsa bu işlev kullanılamaz.\n\nPolitika ayarlanırsa kullanıcılar bunu Brave ürününde değiştiremezler. Politika ayarlanmazsa kimlik bilgisi sızıntısı kontrolüne izin verilir ancak kullanıcı bunu devre dışı bırakabilir.";
PasswordManagerBlocklist.pfm_title = "Password Manager (Kaydet ve Doldur) hizmetinin devre dışı bırakılacağı alanların listesini yapılandır";
PasswordManagerBlocklist.pfm_description = "Brave tarafından Password Manager hizmetinin devre dışı bırakılacağı alanların listesini yapılandırın. Bu durumda Kaydet ve Doldur iş akışları devre dışı bırakılır ve bu web sitelerindeki şifreler kaydedilemez veya web formlarında otomatik olarak doldurulamaz.\n\nListede yer alan bir alan için Password Manager devre dışı bırakılır.\n\nListede yer almayan bir alan için Password Manager kullanılabilir.\n\nPolitika ayarlanmadan bırakılırsa Password Manager tüm alanlar için kullanılabilir.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için https://support.google.com/chrome/a?p=url_blocklist_filter_format adresine bakabilirsiniz.";
PasswordManagerEnabled.pfm_title = "Şifrelerin, şifre yöneticisine kaydedilmesini etkinleştir";
PasswordManagerEnabled.pfm_description = "Bu politika, tarayıcının web sitelerindeki şifreleri otomatik olarak hatırlama ve yerleşik şifre yöneticisine kaydetme özelliğini kontrol eder. Şifre yöneticisine kaydedilen, muhtemelen de Google Hesabı profili ve Android ile senkronize edilen şifrelere erişimi kısıtlamaz veya bunların içeriğini değiştirmez.\n\nPolitika, Etkin değerine ayarlanırsa kullanıcılar, Brave ürününün, şifreleri hatırlayıp bir sitede tekrar oturum açtıklarında şifreleri sunmasını sağlayabilirler.\n\nPolitika, Devre Dışı değerine ayarlanırsa kullanıcılar yeni şifreleri kaydedemez, ancak önceden kaydedilmiş şifreler çalışmaya devam eder.\n\nPolitika ayarlanırsa kullanıcılar bunu Brave ürününde değiştiremezler. Politika ayarlanmadan bırakılırsa kullanıcı şifre kaydetmeyi devre dışı bırakabilir.";
PasswordManagerPasskeysEnabled.pfm_title = "Geçiş anahtarlarının, şifre yöneticisine kaydedilmesini etkinleştir";
PasswordManagerPasskeysEnabled.pfm_description = "Bu politika, tarayıcının geçiş anahtarlarını yerleşik şifre yöneticisine kaydetme özelliğini kontrol eder. Şifre yöneticisine kaydedilmiş olan geçiş anahtarlarına erişimi kısıtlamaz veya bunların içeriğini değiştirmez. PasswordManagerEnabled politikası Devre Dışı seçeneğine ayarlanırsa yerleşik şifre yöneticisine kaydetme özelliği (geçiş anahtarları ve şifreler dahil) genel olarak devre dışı bırakılır ve bu nedenle bu politika uygulanamaz.\n\nPolitika, Etkin seçeneğine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar Brave uygulamasında oturum açarak geçiş anahtarlarını yerleşik şifre yöneticisine kaydedebilir.\n\nPolitika, Devre Dışı seçeneğine ayarlanırsa kullanıcılar geçiş anahtarlarını yerleşik şifre yöneticisine kaydedemez ancak önceden kaydedilmiş olan geçiş anahtarları çalışmaya devam eder.";
PasswordProtectionChangePasswordURL.pfm_title = "Şifre değiştirme URL'sini yapılandırır.";
PasswordProtectionChangePasswordURL.pfm_description = "Politika ayarlanırsa kullanıcıların tarayıcıda bir uyarı gördükten sonra şifrelerini değiştirmeleri için hangi URL'ye gönderileceği belirlenir. Şifre koruma hizmeti, kullanıcıları bu politikayla belirlediğiniz URL'ye (yalnızca HTTP ve HTTPS protokolleri) gönderir. Brave ürününün bu şifre değiştirme sayfasında yeni şifrenin rastgele oluşturulmuş karma değerini doğru bir şekilde yakalayabilmesi için şifre değiştirme sayfanızın, https://www.chromium.org/developers/design-documents/create-amazing-password-forms adresinde belirtilen yönergelere uygun olduğundan emin olun.\n\nPolitika devre dışı bırakılır veya ayarlanmazsa hizmet, şifrelerini değiştirmeleri için kullanıcıları https://myaccount.google.com adresine gönderir.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
PasswordProtectionLoginURLs.pfm_title = "Şifrelerin rastgele oluşturulmuş karma değerlerinin şifre koruma hizmeti tarafından yakalanması gerektiği kurumsal giriş URL'lerinin listesini yapılandırın.";
PasswordProtectionLoginURLs.pfm_description = "Politika ayarlanırsa kurumsal giriş URL'lerinin listesi ayarlanır (yalnızca HTTP ve HTTPS protokolleri). Şifre koruma hizmeti, bu URL'lerdeki şifrelerin rastgele oluşturulmuş karma değerlerini yakalayıp şifre yeniden kullanımı algılaması için kullanır. Brave ürününün rastgele oluşturulmuş karma değerleri doğru bir şekilde yakalayabilmesi için oturum açma sayfalarınızın https://www.chromium.org/developers/design-documents/create-amazing-password-forms adresinde belirtilen yönergelere uygun olduğundan emin olun.\n\nBu ayar devre dışı bırakılır veya ayarlanmazsa şifre koruma hizmeti yalnızca https://accounts.google.com adresindeki şifrelerin rastgele oluşturulmuş karma değerlerini yakalar.\n\nMicrosoft® Windows® işletim sisteminde bu işlev yalnızca bir Microsoft® Active Directory® alan adına katılmış, Microsoft® Azure® Active Directory® alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
PasswordProtectionWarningTrigger.pfm_title = "Şifre koruma uyarısı tetikleyicisi";
PasswordProtectionWarningTrigger.pfm_description = "0 - Şifre koruma uyarısı kapalı\n1 - Şifre koruma uyarısı, şifre yeniden kullanımıyla tetiklendi\n2 - Şifre koruma uyarısı, kimlik avı sayfasında şifre yeniden kullanımıyla tetiklendi\nPolitika ayarlanırsa şifre koruma uyarısının tetiklenmesini kontrol edebilirsiniz. Şifre koruma, korunan şifrelerini şüpheli olabilecek sitelerde yeniden kullanan kullanıcıları uyarır.\n\nHangi şifrenin korunacağını ayarlamak için PasswordProtectionLoginURLs ve PasswordProtectionChangePasswordURL politikalarını kullanın.\n\nBu politika:\n\n* PasswordProtectionWarningOff değerine ayarlanırsa herhangi bir şifre koruma uyarısı gösterilmez.\n\n* PasswordProtectionWarningOnPasswordReuse değerine ayarlanırsa kullanıcı korunan şifresini izin verilmeyen bir sitede yeniden kullandığında şifre koruma uyarısı gösterilir.\n\n* PasswordProtectionWarningOnPhishingReuse değerine ayarlanırsa kullanıcı korunan şifresini bir kimlik avı sitesinde yeniden kullandığında şifre koruma uyarısı gösterilir.\n\nBu politika ayarlanmadan bırakılırsa şifre koruma hizmeti yalnızca Google şifrelerini korur, ancak kullanıcılar bu ayarı değiştirebilirler.";
PasswordSharingEnabled.pfm_title = "Kullanıcı kimlik bilgilerinin diğer kullanıcılarla paylaşılmasını etkinleştir";
PasswordSharingEnabled.pfm_description = "Politika, Etkin değerine ayarlanırsa kullanıcılar aile üyeleriyle (aile hizmetlerine göre) şifre alışverişinde bulunabilir.\nPolitika etkinleştirildiğinde veya ayarlanmadan bırakıldığında Şifre Yöneticisi'nde şifre gönderilmesine izin veren bir düğme bulunur.\nAlınan şifreler kullanıcının hesabında depolanır ve bu şifrelere, Şifre Yöneticisi'nden ulaşılabilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa kullanıcılar Şifre Yöneticisi'nden diğer kullanıcılara şifre gönderemez ve diğer kullanıcılardan şifre alamaz.\n\nŞifre senkronizasyonu kapalıysa (kullanıcı ayarlarından veya SyncDisabled politikasının Etkin değerine ayarlanmasından dolayı) bu özellik kullanılamaz.\n\nYönetilen hesaplar, aile gruplarına katılamadığı veya aile grubu oluşturamadığı için şifre paylaşamaz.";
PaymentMethodQueryEnabled.pfm_title = "Web sitelerinin kullanılabilir ödeme yöntemlerini sorgulamalarına izin ver.";
PaymentMethodQueryEnabled.pfm_description = "Web sitelerinin kullanıcının kaydettiği ödeme yöntemleri olup olmadığını kontrol etmesine izin verilip verilmeyeceğini ayarlamanıza olanak sağlar.\n\nBu politika devre dışı olarak ayarlanırsa PaymentRequest.canMakePayment veya PaymentRequest.hasEnrolledInstrument API kullanan web siteleri, kullanılabilir ödeme yöntemi olmadığı hakkında bilgilendirilecektir.\n\nBu ayar etkinleştirilir veya ayarlanmazsa web sitelerinin kullanıcının kaydettiği ödeme yöntemleri olup olmadığını kontrol etmesine izin verilir.";
PdfAnnotationsEnabled.pfm_title = "PDF Ek Açıklamalarını etkinleştir";
PdfAnnotationsEnabled.pfm_description = "Brave ürünündeki PDF görüntüleyicisinin PDF'lere not ekleme iznini kontrol eder.\n\nBu politika ayarlanmadığında veya doğru değerine ayarlandığında PDF görüntüleyici PDF'lere not ekleyebilir.\n\nBu politika yanlış değerine ayarlandığında PDF görüntüleyici PDF'lere not ekleyemez.";
PdfLocalFileAccessAllowedForDomains.pfm_title = "Yerel dosyaların, PDF görüntüleyicide bu sitelerdeki file:// URL'lerine erişmesine izin ver";
PdfLocalFileAccessAllowedForDomains.pfm_description = "Bu politika ayarlandığında, listelenen alanların PDF görüntüleyicide file:// URL'lerine erişmesine izin verilir.\nPolitikaya eklenen alan, PDF görüntüleyicide file:// URL'lerine erişebilir.\nPolitikadan kaldırılan alan, PDF görüntüleyicide file:// URL'lerine erişemez.\nPolitika ayarlanmadan bırakılırsa hiçbir alan, PDF görüntüleyicide file:// URL'lerine erişemez.";
PdfUseSkiaRendererEnabled.pfm_title = "PDF oluşturma işlemleri için Skia oluşturucuyu kullanma";
PdfUseSkiaRendererEnabled.pfm_description = "Brave ürünündeki PDF görüntüleyicisinin Skia oluşturucuyu kullanıp kullanmayacağını kontrol eder.\n\nBu politika etkinleştirildiğinde PDF görüntüleyici Skia oluşturucuyu kullanır.\n\nBu politika devre dışı bırakılırsa PDF görüntüleyici kendi AGG oluşturucusunu kullanır.\n\nBu politika ayarlanmadan bırakılırsa PDF oluşturucu tarayıcı tarafından seçilir.";
PolicyAtomicGroupsEnabled.pfm_title = "Politika atom grupları kavramını etkinleştirir";
PolicyAtomicGroupsEnabled.pfm_description = "Politika, Etkin değerine ayarlanırsa bir atom grubundan gelen ve o gruptaki en yüksek öncelikle aynı kaynağı paylaşmayan politikalar yok sayılır.\n\nPolitika, Devre Dışı değerine ayarlanırsa hiçbir politika, kaynağı yüzünden yok sayılmaz. Politikalar yalnızca bir çakışma olduğunda ve o politika en yüksek önceliğe sahip olmadığında yok sayılır.\n\nBu politika bir bulut kaynağından ayarlanırsa belirli bir kullanıcıyı hedefleyemez.";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "Farklı kaynaklara ait sözlük politikalarını birleştirmeye izin ver";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - Yönetilen kullanıcı manuel istisna URL'leri\nDeviceLoginScreenPowerManagement - Giriş ekranında güç yönetimi\nExtensionSettings - Uzantı yönetim ayarları\nKeyPermissions - Temel İzinler\nPowerManagementIdleSettings - Kullanıcının işlem yapmadığı zaman için güç yönetimi ayarları\nScreenBrightnessPercent - Ekran parlaklığı yüzdesi\nScreenLockDelays - Ekran kilidi bekleme süresi\nPolitikanın ayarlanması, farklı kaynaklardan seçilen politikaların aynı kapsamda ve düzeyde birleştirilmesine olanak tanır. Bu birleştirme, her kaynaktaki sözlüğün ilk düzey anahtarlarında meydana gelir. En yüksek öncelikli kaynaktan gelen anahtar tercih edilir.\n\nDesteklenen tüm sözlük politikalarının birleştirilmesine izin vermek için \"*\" joker karakterini kullanın.\n\nPolitika listede yer alıyorsa ve kaynaklar arasında aşağıdaki çakışmalar varsa:\n\n* Aynı kapsamlar ve düzey: Değerler yeni bir politika sözlüğünde birleştirilir.\n\n* Farklı kapsamlar veya düzey: En yüksek önceliğe sahip politika uygulanır.\n\nBir politika listede yoksa ve kaynaklar, kapsamlar veya düzey arasında çakışma varsa en yüksek önceliğe sahip politika uygulanır.";
PolicyListMultipleSourceMergeList.pfm_title = "Farklı kaynaklara ait liste politikalarını birleştirmeye izin ver";
PolicyListMultipleSourceMergeList.pfm_description = "Politikanın ayarlanması, farklı kaynaklardan seçilen politikaların aynı kapsamda ve düzeyde birleştirilmesine olanak tanır.\n\nTüm liste politikalarının birleştirilmesine izin vermek için \"*\" joker karakterini kullanın.\n\nPolitika listede yer alıyorsa ve kaynaklar arasında aşağıdaki çakışmaların olması halinde:\n\n* Aynı kapsamlar ve düzey: Değerler yeni bir politika listesinde birleştirilir.\n\n* Farklı kapsamlar veya düzey: En yüksek önceliğe sahip politika uygulanır.\n\nBir politika listede yoksa ve kaynaklar, kapsamlar veya düzey arasında çakışma varsa en yüksek önceliğe sahip politika uygulanır.";
PolicyRefreshRate.pfm_title = "Kullanıcı politikası için yenileme hızı";
PolicyRefreshRate.pfm_description = "Politikanın ayarlanması, cihaz yönetimi hizmetinin kullanıcı politikası bilgileri için sorgulandığı süreyi milisaniye olarak belirtir. Geçerli değerler, 1.800.000 (30 dakika) ile 86.400.000 (1 gün) aralığındadır. Bu aralık dışındaki değerler ilgili sınıra ayarlanır.\n\nPolitika ayarlanmadan bırakılırsa 3 saat olan varsayılan değer kullanılır.\n\nNot: Politika bildirimleri, politika değiştiğinde yenileme yapılmasını zorlar, böylece sık sık yenileme yapılması gerekmez. Dolayısıyla, platform bu bildirimleri destekliyorsa yenileme gecikmesi 24 saat olarak ayarlanır (varsayılanlar ve bu politikanın değeri yok sayılır).";
PopupsAllowedForUrls.pfm_title = "Bu sitelerde pop-up'lara izin ver";
PopupsAllowedForUrls.pfm_description = "Politikayı ayarlamak, pop-up'ları açabilen siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultPopupsSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
PopupsBlockedForUrls.pfm_title = "Bu sitelerde pop-up'ları engelle";
PopupsBlockedForUrls.pfm_description = "Politikayı ayarlamak pop-up'ları açamayan siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultPopupsSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
PreciseGeolocationAllowedForUrls.pfm_title = "Bu sitelerde tam coğrafi konum kullanımına izin ver";
PreciseGeolocationAllowedForUrls.pfm_description = "Bu politikayı ayarlayarak kullanıcının yüksek doğruluğu olan coğrafi konumuna erişmek için önce izin istemek zorunda olmayan sitelerin belirtildiği URL kalıplarının listesini oluşturabilirsiniz.\n\nPolitika ayarlanmadan bırakılırsa tüm sitelerde DefaultGeolocationSetting (ayarlanmışsa) geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
PreferSlowCiphers.pfm_title = "TLS için belirli şifreleme şifre algoritmalarını tercih et";
PreferSlowCiphers.pfm_description = "cnsa - CNSA 1.0 ve 2.0 koşullarını karşılayan şifreleri tercih et\ndefault - Brave ürünündeki varsayılan şifre sırasını kullan\nBu politika, Brave ürününü, TLS 1.3'te tercih edilen şifreleme şifrelerini belirli bir uyumluluk rejimi tarafından onaylanmış algoritmalara öncelik verecek şekilde sıralamak için yapılandırır.\n\nBu politikanın ayarlanması, belirli herhangi bir algoritmada anlaşılacağını garanti edilmez.\n\nBu politika, uyumluluk gereksinimlerini karşılayan ve karşılamayan istemcileri desteklemek isteyen sunucu operatörlerinin, bu istemcileri ayırt etmesine ve yalnızca açıkça tercih edecek şekilde yapılandırılmış istemciler için kriptografik gücü artırılmış belirli, varsayılan olmayan algoritmaları kullanmasına olanak tanımak amacıyla tasarlanmıştır.\n\nPolitika, \"cnsa\" değerine ayarlanırsa Brave, Commercial National Security Algorithm Suite 1.0 ve 2.0 (CNSA 1.0 ve 2.0) ile uygunluk için gerekli olan şifreleri tercih edecek şekilde yapılandırılır.\n\nPolitika ayarlanmazsa veya \"default\" değerine ayarlanırsa Brave, varsayılan şifrelerini kullanacak şekilde yapılandırılır.\n\nGüvenlik için bu politikanın ayarlanması gerekmez. Brave tarafından kullanılan varsayılan kriptografi, Güneş'teki tüm enerjiyi kullanarak yapılacak kaba kuvvet saldırısına dayanacak kadar güçlüdür.\n\nBu politika ayarlanırsa web sitelerine erişirken Brave daha yavaş çalışır.\n\nBu politika yalnızca TLS 1.3 ve QUIC'i etkiler. TLS'nin önceki sürümlerini etkilemez.\n\nBu politika hem makine hem de kullanıcı için ayarlanabilir. Bu politika kullanıcı için ayarlanırsa yalnızca kullanıcı profili tarafından başlatılan ağ isteklerini etkiler. Tarayıcı genelindeki arka plan görevlerini yürütmek için Brave tarafından yapılan ağ isteklerini etkilemeyebilir. Bu tür istekler, makine düzeyindeki değer tarafından kontrol edilir. Bu politika hem makine hem de kullanıcı düzeyinde ayarlanırsa politika öncelik sırası CloudUserPolicyOverridesCloudMachinePolicy politikasıyla değiştirilmediği sürece makine düzeyindeki değer geçerli olur.\n\n155 ve önceki sürümlerde bu politika yalnızca makine düzeyinde geçerlidir.";
PreferSlowKexAlgorithms.pfm_title = "TLS için belirli anahtar değişimi algoritmalarını tercih edin";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - CNSA 2.0 gereksinimlerini karşılayan anahtar değişimi yöntemlerini tercih edin\ndefault - Brave ürünündeki varsayılan desteklenen grupları kullan\nBu politika, Brave ürününü, TLS 1.3'te tercih edilen anahtar anlaşması algoritmalarını (desteklenen gruplar) belirli bir uyumluluk rejimi tarafından onaylanmış algoritmalara öncelik verecek şekilde sıralamak için yapılandırır.\n\nBu politikanın ayarlanması, belirli herhangi bir algoritmada anlaşılacağını garanti edilmez.\n\nBu politika, uyumluluk gereksinimlerini karşılayan ve karşılamayan istemcileri desteklemek isteyen sunucu operatörlerinin, bu istemcileri ayırt etmesine ve yalnızca açıkça tercih edecek şekilde yapılandırılmış istemciler için kriptografik gücü artırılmış belirli, varsayılan olmayan algoritmaları kullanmasına olanak tanımak amacıyla tasarlanmıştır.\n\nPolitika, \"cnsa2\" değerine ayarlanırsa Brave, Commercial National Security Algorithm Suite 2.0 (CNSA 2.0) ile uygunluk için gerekli olan anahtar değişim yöntemlerini tercih edecek şekilde yapılandırılır.\n\nPolitika ayarlanmazsa veya \"default\" değerine ayarlanırsa Brave, varsayılan anahtar değişimi yöntemlerini kullanacak şekilde yapılandırılır.\n\nGüvenlik için bu politikanın ayarlanması gerekmez. Brave tarafından kullanılan varsayılan kriptografi, Güneş'teki tüm enerjiyi kullanarak yapılacak kaba kuvvet saldırısına dayanacak kadar güçlüdür.\n\nBu politika ayarlanırsa web sitelerine erişirken Brave daha yavaş çalışır.\n\nBu politika yalnızca TLS 1.3 ve QUIC'i etkiler. TLS'nin önceki sürümlerini etkilemez.\n\nBu politika hem makine hem de kullanıcı için ayarlanabilir. Bu politika kullanıcı için ayarlanırsa yalnızca kullanıcı profili tarafından başlatılan ağ isteklerini etkiler. Tarayıcı genelindeki arka plan görevlerini yürütmek için Brave tarafından yapılan ağ isteklerini etkilemeyebilir. Bu tür istekler, makine düzeyindeki değer tarafından kontrol edilir. Bu politika hem makine hem de kullanıcı düzeyinde ayarlanırsa politika öncelik sırası CloudUserPolicyOverridesCloudMachinePolicy politikasıyla değiştirilmediği sürece makine düzeyindeki değer geçerli olur.\n\n155 ve önceki sürümlerde bu politika yalnızca makine düzeyinde geçerlidir.";
PrefetchWithServiceWorkerEnabled.pfm_title = "ServiceWorker tarafından kontrol edilen URL'ler için SpeculationRules önceden getirme işlemine izin ver";
PrefetchWithServiceWorkerEnabled.pfm_description = "SpeculationRules önceden getirme işlemi, ServiceWorker tarafından kontrol edilen URL'lere uygulanabilir. Ancak eski kod buna izin vermedi ve önceden getirme isteklerini iptal etti. Bu politika, davranışı kontrol etmeyi sağlar.\n\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa ServiceWorker tarafından kontrol edilen URL'ler için SpeculationRules önceden getirme işlemine izin verilir (PrefetchServiceWorker özellik bayrağı etkinse). Bu, geçerli varsayılan davranıştır ve spesifikasyonlarla uyumludur.\n\nBu politika, Devre Dışı değerine ayarlanırsa ServiceWorker tarafından kontrol edilen URL'ler için SpeculationRules önceden getirme işlemine izin verilmez. Bu, eski davranıştır.\n\nBu politika, geçici olarak tasarlanmıştır ve gelecekte kaldırılacaktır.";
PrintHeaderFooter.pfm_title = "Üst Bilgileri ve Alt Bilgileri yazdır";
PrintHeaderFooter.pfm_description = "Politika, Etkin değerine ayarlanırsa baskı önizlemede üst bilgiler ve alt bilgiler etkinleştirilir. Politika, Devre Dışı değerine ayarlanırsa bunlar baskı önizlemede devre dışı bırakılır.\n\nBu politikayı ayarlarsanız kullanıcılar değiştiremez. Politika ayarlanmadan bırakılırsa üst bilgilerin ve alt bilgilerin gösterilip gösterilmeyeceğine kullanıcılar karar verir.";
PrintPdfAsImageAvailability.pfm_title = "PDF'yi Resim Olarak Yazdırma Seçeneği Kullanılabilir";
PrintPdfAsImageAvailability.pfm_description = "Brave ürününün, Microsoft® Windows® ve macOS aracılığıyla PDF yazdırırken Resim olarak yazdır seçeneğini nasıl kullanılabilir hale getireceğini kontrol eder.\n\nMicrosoft® Windows® veya macOS aracılığıyla PDF yazdırırken belirli yazıcıların doğru görünümde çıktılar alabilmesi için yazdırma işlerinin bazen resim olarak pikselleştirilmesi gerekir.\n\nBu politika Etkin değerine ayarlandığında Brave, PDF yazdırırken Resim olarak yazdır seçeneği Yazdırma Önizlemesi bölümünde kullanılabilir hale gelir.\n\nBu politika Devre Dışı değerine ayarlanırsa veya ayarlanmazsa Brave, Resim olarak yazdır seçeneği Yazdırma Önizlemesi bölümünde kullanılabilir hale gelmez ve PDF'ler, hedefe gönderilmeden önce resim olarak pikselleştirilmeden normal şekilde yazdırılır.";
PrintPdfAsImageDefault.pfm_title = "PDF'yi Resim Olarak Yazdır Varsayılan Ayar";
PrintPdfAsImageDefault.pfm_description = "Brave üzerinde PDF yazdırılırken Resim olarak yazdır'ın varsayılan olarak seçilip seçilmeyeceğini kontrol eder.\n\nBu politika Etkin değerine ayarlanırsa Brave varsayılan olarak PDF yazdırırken Yazdırma Önizleme'de Resim olarak yazdır seçeneğini ayarlar.\n\nBu politika Devre Dışı değerine ayarlanırsa veya ayarlanmadan bırakılırsa Brave üzerinde Resim olarak yazdır seçeneği baştan seçilmemiş olur.  Seçeneğin kullanılabildiği durumlarda kullanıcı, ayrı ayrı her bir PDF'nin yazdırma işi için bu seçimi yapabilir.\n\nBu politika, Microsoft® Windows® veya macOS üzerinde yalnızca PrintPdfAsImageAvailability politikasının da etkin olduğu durumlarda geçerli olur.";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "Varsayılan Olarak Sistem Varsayılan Yazıcısını Kullan";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "Politika, Etkin değerine ayarlanırsa Brave, baskı önizleme için varsayılan hedef olarak işletim sistemi varsayılan yazıcısını kullanır.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, baskı önizleme için varsayılan hedef olarak en son kullanılan yazıcıyı kullanır.";
PrintRasterizePdfDpi.pfm_title = "Yazdırma Pikselleştirme PDF DPI";
PrintRasterizePdfDpi.pfm_description = "Brave, pikselleştirme ile PDF yazdırdığında yazdırılan resmin çözünürlüğünü kontrol eder.\n\nResim olarak yazdır seçeneği ile PDF yazdırırken bir cihazın yazıcı ayarı veya PDF varsayılan değeri dışında bir yazdırma çözünürlüğü belirtilmesi faydalı olabilir.  Yüksek çözünürlükte işleme ve yazdırma süresi büyük oranda artarken düşük çözünürlükte ise kötü bir resim kalitesi ortaya çıkabilir.\n\nBu politika, PDF'leri yazdırmak için pikselleştirirken kullanılacak belirli bir çözünürlüğün belirtilmesini sağlar.\n\nBu politika sıfır değerine ayarlanırsa veya hiç ayarlanmazsa sayfa resimlerinin pikselleştirilmesi sırasında varsayılan sistem çözünürlüğü kullanılır.";
PrinterTypeDenyList.pfm_title = "Reddetme listesinde yazıcı türlerini devre dışı bırakma";
PrinterTypeDenyList.pfm_description = "privet - Zeroconf tabanlı (mDNS + DNS-SD) protokol hedefleri (kullanımdan kaldırıldı)\nextension - Uzantı tabanlı hedefler\npdf - Google Chrome OS cihazlardaki \"PDF olarak kaydet\" hedefinin yanı sıra \"Google Drive'a kaydet\" hedefi\nlocal - Yerel yazıcı hedefleri\ncloud - Google Cloud Print (Kullanımdan kaldırıldı)\nReddetme listesine yerleştirilen yazıcı türlerinin bulunması veya işlevlerinin yerine getirilmesi devre dışı bırakılır.\n\nTüm yazıcı türlerini reddetme listesine yerleştirmek, bir dokümanı yazdırmak için gönderilecek kullanılabilir hedef olmayacağından yazdırma işlevini etkin bir şekilde devre dışı bırakır.\n\n102'den önceki sürümlerde reddetme listesine cloud eklemek, CloudPrintSubmitEnabled politikasını yanlış değerine ayarlamakla aynı etkiye sahiptir. Google Cloud Print hedeflerini bulunabilir tutmak için CloudPrintSubmitEnabled politikanın doğru değerine ayarlanması ve reddetme listesine cloud eklenmemesi gerekir. Sürüm 102'den itibaren Google Cloud Print hedefleri desteklenmez ve politika değerleri ne olursa olsun gösterilmez.\n\nBu politika ayarlanmaz veya boş bir listeye ayarlanırsa tüm yazıcı türleri bulunmak için kullanılabilir.\n\nUzantı yazıcıları ayrıca yazdırma sağlayıcı hedefleri olarak da bilinir ve Brave uzantısına ait olan herhangi bir hedefi içerir.\n\nYerel yazıcılar ayrıca yerel yazdırma hedefleri olarak da bilinir ve yerel makineler ile paylaşılan ağ yazıcılarının kullanabildiği hedefleri içerir.";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "Arka plan grafikleri yazdırma modunu kısıtla";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - Arka plan grafikleri ile ve bu grafikler olmadan yazdırmaya izin ver\nenabled - Yalnızca arka plan grafikleriyle yazdırmaya izin ver\ndisabled - Yalnızca arka plan grafikleri olmadan yazdırmaya izin ver\nArka plan grafikleri yazdırma modunu kısıtlar. Politika ayarlanmazsa herhangi bir kısıtlama uygulanmaz.";
PrintingBackgroundGraphicsDefault.pfm_title = "Varsayılan arka plan grafikleri yazdırma modu";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - Varsayılan olarak arka plan grafikleri yazdırma modunu etkinleştir\ndisabled - Varsayılan olarak arka plan grafikleri yazdırma modunu devre dışı bırak\nVarsayılan arka plan grafikleri yazdırma modunu geçersiz kılar.";
PrintingEnabled.pfm_title = "Yazdırmayı etkinleştir";
PrintingEnabled.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar Brave üzerinde yazdırabilir ve bu ayarı değiştiremez.\n\nPolitika, Devre Dışı değerine ayarlanırsa kullanıcılar Brave üzerinden yazdırma işlemi gerçekleştiremez. Üç nokta menüsünde, uzantılarda ve JavaScript uygulamalarında yazdırma işlemi devre dışı bırakılır.";
PrintingPaperSizeDefault.pfm_title = "Varsayılan yazdırma sayfası boyutu";
PrintingPaperSizeDefault.pfm_description = "Varsayılan yazdırma sayfa boyutunu geçersiz kılar.\n\nname, listelenen biçimlerden birini veya gereken kağıt boyutu listede yoksa \"özel\" biçimi içermelidir. \"Özel\" değer sağlanıyorsa custom_size özelliği belirtilmelidir. Bu özellik, istenilen yüksekliği ve genişliği mikrometre cinsinden verir. Aksi takdirde custom_size özelliği belirtilmemelidir. Bu kuralları ihlal eden politika yok sayılır.\n\nSayfa boyutu kullanıcı tarafından seçilen yazıcıda kullanılamıyorsa bu politika yok sayılır.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault adresine bakın.";
ProfilePickerOnStartupAvailability.pfm_title = "Başlangıçta profil seçicinin kullanılabilirlik durumu";
ProfilePickerOnStartupAvailability.pfm_description = "0 - Başlangıçta profil seçiciyi etkinleştir\n1 - Başlangıçta profil seçiciyi devre dışı bırak\n2 - Başlangıçta profil seçiciyi zorunlu tut\nProfil seçicinin etkin olup olmadığını, devre dışı bırakılıp bırakılmadığını veya tarayıcı başlatılırken zorunlu tutulup tutulmadığını belirtir.\n\nVarsayılan olarak profil seçici şu durumlarda gösterilmez: Tarayıcı misafir modunda veya gizli modda başlatıldığında, profil dizini ve/veya URL'ler komut satırı tarafından belirtildiğinde, uygulamanın açılması açıkça istendiğinde, tarayıcı yerel bildirim tarafından başlatıldığında, kullanılabilir yalnızca tek bir profil olduğunda veya ForceBrowserSignin politikası doğru değerine ayarlandığında.\n\nPolitika, \"Etkin\" (0) değerine ayarlanırsa veya ayarlanmadan bırakılırsa profil seçici, varsayılan olarak başlangıçta gösterilir, ancak kullanıcılar bu ayarı etkinleştirebilir veya devre dışı bırakabilirler.\n\nPolitika, \"Devre Dışı\" (1) değerine ayarlanırsa profil seçici hiçbir zaman gösterilmez ve kullanıcılar bu ayarı değiştiremezler.\n\nPolitika, \"Zorunlu\" (2) değerine ayarlanırsa profil seçici kullanıcı tarafından engellenemez. Kullanılabilir tek bir profil olsa bile profil seçici gösterilir.";
ProfileReauthPrompt.pfm_title = "Kullanıcılardan profil için yeniden kimlik doğrulamalarını iste";
ProfileReauthPrompt.pfm_description = "0 - Yeniden kimlik doğrulama isteme\n1 - Yeni sekmede yeniden kimlik doğrulama iste\nDoNotPrompt değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, kullanıcıdan tarayıcıda yeniden kimlik doğrulaması yapmasını otomatik olarak istemez.\n\nPromptInTab olarak ayarlanırsa kullanıcının kimlik doğrulama süresi dolduğunda hemen yeni bir sekmede Google giriş sayfası açılır. Bu yalnızca Chrome Sync kullanıldığında geçerlidir.";
ProfileSeparationDomainExceptionList.pfm_title = "Kurumsal profil ayırma ikincil alan adı izin verilenler listesi";
ProfileSeparationDomainExceptionList.pfm_description = "Bu politika ayarlanmazsa yeni bir ayrı profil oluşturmak için hesaba giriş yapılması gerekmez.\n\nBu politika ayarlanırsa yeni bir ayrı profil oluşturmak için listelenen alan adlarından hesaba giriş yapılması gerekmez.\n\nBu politika boş bir dizeye ayarlanabilir. Böylece, yeni bir ayrı profil oluşturmak için tüm hesaplara giriş yapılması gerekir.";
PromotionsEnabled.pfm_title = "Tanıtım amaçlı içerik göstermeyi etkinleştir";
PromotionsEnabled.pfm_description = "Politika, Doğru değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, kullanıcılara ürünle ilgili tanıtım amaçlı içerik gösterebilir.\n\nPolitika, Yanlış değerine ayarlanırsa Brave, ürünle ilgili tanıtım amaçlı içerik gösteremez.\n\nBu politika, kullanıcıların Brave ürününde oturum açmalarına, Brave ürününü kullanıcının varsayılan tarayıcısı olarak ayarlamasına veya ürün özellikleriyle ilgili diğer bilgileri almalarına yardımcı olan karşılama sayfaları da dahil olmak üzere tanıtım amaçlı içeriğin sunulmasını kontrol eder.";
PromptForDownloadLocation.pfm_title = "İndirmeden önce her dosyanın nereye kaydedileceğini sor";
PromptForDownloadLocation.pfm_description = "Politika Etkin değerine ayarlanırsa kullanıcılara indirmeden önce her dosyanın nereye kaydedileceği sorulur. Politika Devre dışı değerine ayarlanırsa indirme işlemleri hemen başlar ve kullanıcılara dosyanın nereye kaydedileceği sorulmaz.\n\nPolitika ayarlanmadan bırakılırsa kullanıcılar bu ayarı değiştirebilir.";
PromptOnMultipleMatchingCertificates.pfm_title = "Birden fazla sertifika eşleştiğinde istem görüntüle";
PromptOnMultipleMatchingCertificates.pfm_description = "Bu politika, AutoSelectCertificateForUrls ile eşleşen birden fazla sertifika olduğunda kullanıcıdan bir istemci sertifikası seçmesinin istenip istenmeyeceğini kontrol eder.\nBu politika Etkin değerine ayarlanırsa, otomatik seçim politikası birden fazla sertifikayla eşleştiğinde kullanıcıdan bir istemci sertifikası seçmesi istenir.\nBu politika Devre Dışı değerine ayarlanırsa veya ayarlanmadan bırakılırsa kullanıcıdan yalnızca otomatik seçimle eşleşen sertifika olmadığında seçim yapması istenebilir.";
ProxySettings.pfm_title = "Proxy ayarları";
ProxySettings.pfm_description = "Politikanın ayarlanması, komut satırında proxy ile ilgili belirtilen tüm seçenekleri yok sayan Chrome ve ARC-uygulamaları için proxy ayarlarını yapılandırır.\n\nPolitika ayarlanmazsa kullanıcılar kendi proxy ayarlarını seçebilir.\n\nProxySettings politikasının ayarlamak için aşağıdaki alanlar kullanılabilir:\n\n* ProxyMode, Chrome'un kullandığı proxy sunucusunu belirtmenizi sağlar ve kullanıcıların proxy ayarlarını değiştirmesini önler\n\n* ProxyPacUrl, proxy .pac dosyası için URL veya application/x-ns-proxy-autoconfig MIME türü ile veri URL'si olarak kodlanmış bir PAC komut dosyası\n\n* ProxyPacMandatory, ağ yığınının geçersiz veya kullanılamayan PAC komut dosyasıyla doğrudan bağlantılara geri dönmesini önler\n* ProxyServer, proxy sunucu URL'si\n\n* ProxyBypassList, proxy'nin atlanacağı ana makinelerin listesi\n\nProxyServerMode alanının desteği sonlandırılmış, yerine ProxyMode alanı getirilmiştir. ProxyMode için aşağıdaki değerleri seçerseniz:\n\n* direct, proxy hiçbir zaman kullanılmaz ve diğer tüm alanlar yoksayılır.\n\n* system, sisteme ait proxy kullanılır ve diğer tüm alanlar yoksayılır.\n\n* auto_detect, diğer tüm alanlar yoksayılır.\n\n* fixed_servers, ProxyServer ve ProxyBypassList alanları kullanılır.\n\n* pac_script, ProxyPacUrl, ProxyPacMandatory ve ProxyBypassList alanları kullanılır.\n\nNot: Daha ayrıntılı örnekler için Chromium Projeleri'ni ziyaret edin (https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings).\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=ProxySettings adresine bakın.";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "QR kodu oluşturma aracını etkinleştir";
QRCodeGeneratorEnabled.pfm_description = "Bu politika, Brave tarayıcıdaki QR kodu oluşturma aracı özelliğini etkinleştirir.\n\nBu politikayı etkinleştirirseniz veya yapılandırmazsanız QR kodu oluşturma aracı özelliği etkinleştirilir.\n\nBu politikayı devre dışı bırakırsanız QR kodu oluşturma aracı özelliği devre dışı bırakılır.";
QuicAllowed.pfm_title = "QUIC protokolüne izin verin";
QuicAllowed.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Brave ürününde QUIC protokolünün kullanımına izin verilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa QUIC protokolünün kullanımına izin verilmez.";
RegisteredProtocolHandlers.pfm_title = "Protokol işleyicilerini kaydet";
RegisteredProtocolHandlers.pfm_description = "Politikayı (yalnızca önerildiği gibi) ayarlamak, kullanıcının kaydettiği ile birleşen protokol işleyicileri listesi kaydetmenize olanak tanır. Böylece her iki liste de kullanılır. \"Protokol\" özelliğini \"mailto\" gibi bir düzene ayarlayın ve \"URL\" özelliğini \"protokol\" alanında belirtilen düzeni işleyen uygulamanın URL kalıbına ayarlayın. Kalıp, işlenen URL'nin yerini aldığı bir \"%s\" yer tutucu içerebilir.\n\nKullanıcılar politika tarafından kaydedilen bir protokol işleyicisini kaldıramazlar. Ancak kullanıcılar yeni bir varsayılan işleyici yükleyerek politika tarafından kaydedilen protokol işleyicilerini değiştirebilirler.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers adresine bakın.";
RelaunchFastIfOutdated.pfm_title = "Dönem (gün)";
RelaunchFastIfOutdated.pfm_description = "Sonraki sürümlerde yeniden başlatma bildirimlerinin daha agresif olacağı minimum sürüm yaşını belirtir. Bu yaş, geçerli sürümün istemcilere en son sunulduğu zamana göre hesaplanır.\n\nBekleyen bir güncellemenin tamamlanması için tarayıcının ya da cihazın yeniden başlatılması gerekiyorsa ve mevcut sürüm, bu ayarda belirtilen gün sayısından daha uzun süredir güncel değilse RelaunchNotificationPeriod politikası geçersiz kılınıp 2 saat olarak ayarlanır. RelaunchNotification politikası 1 (\"Zorunlu\") değerine ayarlanırsa kullanıcılar, sürenin sonunda yeniden başlatmaya zorlanır.\n\nPolitika ayarlanmazsa veya sürüm yaşı belirlenemezse tüm güncellemelerde RelaunchNotificationPeriod politikası kullanılır.";
RelaunchNotification.pfm_title = "Kullanıcıya tarayıcının veya cihazın yeniden başlatılmasının önerildiğini ya da gerektiğini bildir";
RelaunchNotification.pfm_description = "1 - Kullanıcıya yeniden başlatmanın önerildiğini belirten yinelenen bir istem gösterme\n2 - Kullanıcıya yeniden başlatmanın gerektiğini belirten yinelenen bir istem gösterme\nKullanıcılara, bekleyen bir güncellemeyi uygulamak için Brave uygulamasının veya Google Chrome OS cihazının yeniden başlatılması gerektiğini bildirin.\n\nBu politika ayarı, kullanıcıya tarayıcının veya cihazın yeniden başlatılmasının önerildiği ya da gerektiği bilgisini verecek bildirimleri etkinleştirir. Bir değer ayarlanmazsa Brave, menüsündeki küçük değişiklikler aracılığıyla kullanıcıya uygulamanın yeniden başlatılması gerektiğini belirtir. Diğer yandan Google Chrome OS, sistem tepsisinde bir bildirim aracılığıyla böyle bir gerekliliği bildirir. \"Önerilen\" seçeneği ayarlanırsa, kullanıcıya uygulamayı yeniden başlatmasının önerildiği yinelenen bir uyarı ile bildirilir. Kullanıcı, yeniden başlatmayı ertelemek için bu uyarıyı kapatabilir. \"Zorunlu\" değeri ayarlanırsa kullanıcıya, bildirim dönemi geçtikten sonra tarayıcının yeniden başlatılmasının zorlanacağını belirten yinelenen bir uyarı gösterilir. Varsayılan dönem Brave için yedi gün, Google Chrome OS için dört gündür ve RelaunchNotificationPeriod politika ayarı aracılığıyla yapılandırılabilir.\n\nYeniden başlatmanın ardından kullanıcı oturumu yeniden açılır.";
RelaunchNotificationPeriod.pfm_title = "Dönem (milisaniye)";
RelaunchNotificationPeriod.pfm_description = "Beklemedeki bir güncellemenin uygulanması için Brave ürününün veya bir Google Chrome OS cihazının yeniden başlatılması gerektiği konusunda kullanıcıların bilgilendirileceği dönemi milisaniye cinsinden ayarlamanıza olanak tanır.\n\nBu zaman diliminde kullanıcı, güncelleme yapılması gerektiğine dair tekrar tekrar bilgilendirilir. Google Chrome OS cihazları için yeniden başlatma bildirimi, RelaunchHeadsUpPeriod politikası gereği sistem tepsisinde görünür. Brave tarayıcıları için uygulama menüsü, bildirim süresinin üçte biri geçtikten sonra yeniden başlatmanın gerekli olduğunu gösterecek şekilde değişir. Bu bildirim, bildirim süresinin üçte ikisi geçtikten sonra renk değiştirir ve bildirim süresinin tamamı geçtikten sonra tekrar renk değiştirir. RelaunchNotification politikası tarafından etkinleştirilen ek bildirimler, aynı programı takip eder.\n\nBu politika ayarlanmazsa varsayılan süre olan 604800000 milisaniye (bir hafta) kullanılır.";
RelaunchWindow.pfm_title = "Yeniden başlatma zaman aralığı";
RelaunchWindow.pfm_description = "Yeniden başlatma bildirim süresinin sonu için bir hedef zaman aralığı belirler.\n\nRelaunchNotification ve RelaunchNotificationPeriod politika ayarları uyarınca tarayıcının veya cihazın yeniden başlatılması gerekliliği kullanıcılara bildirilir. RelaunchNotification politikası \"Gerekli\" değerine ayarlanırsa tarayıcılar ve cihazlar, bildirim süresinin sonunda zorla yeniden başlatılır. RelaunchWindow politikası, bildirim süresinin sonunu belirli bir zaman aralığına denk gelecek şekilde ertelemek için kullanılabilir.\n\nBu politika ayarlanmadığında Google Chrome OS için varsayılan hedef zaman dilimi 02:00 ile 04:00 saatleri arasıdır. Brave için varsayılan hedef zaman aralığı tüm gündür (bildirim süresinin sonu hiçbir zaman ertelenmez).\n\nNot: Politika entries alanında birden çok öğe kabul edebilir, ancak birinci öğe hariç diğerleri yok sayılır.\nUyarı: Bu politikayı ayarlamak, yazılım güncellemelerinin uygulanmasını geciktirebilir.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=RelaunchWindow adresine bakın.";
RemoteAccessHostAllowClientPairing.pfm_title = "Uzaktan erişim ana makineleri için PIN'siz kimlik doğrulamayı etkinleştir veya devre dışı bırak";
RemoteAccessHostAllowClientPairing.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcıların bağlantı zamanında istemcileri ve ana makineleri eşlemelerine izin verilir. Bu durumda, her defasında PIN girme gereği ortadan kalkar.\n\nPolitika, Devre Dışı değerine ayarlanırsa bu özellik kullanılamaz.";
RemoteAccessHostAllowFileTransfer.pfm_title = "Uzaktan erişim kullanıcılarının ana makineye/ana makineden dosya aktarımı yapmalarına izin ver";
RemoteAccessHostAllowFileTransfer.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa uzaktan erişim ana makinesine bağlı kullanıcıların istemci ile ana makine arasında dosya aktarımı yapmasına izin verilir. Bu durum, dosya aktarımını desteklemeyen uzaktan yardım bağlantıları için geçerli değildir.\n\nPolitika, Devre Dışı değerine ayarlanırsa dosya aktarımına izin verilmez.";
RemoteAccessHostAllowPinAuthentication.pfm_title = "Uzaktan erişim ana makinelerinin PIN ve eşleme kimlik doğrulama yöntemlerini kullanmasına izin verir";
RemoteAccessHostAllowPinAuthentication.pfm_description = "Politikanın Etkin değerine ayarlanması, istemci bağlantılarını kabul ederken uzaktan erişim ana makinesinin PIN ve eşleme kimlik doğrulama yöntemlerini kullanmasına izin verir.\n\nPolitikanın Devre dışı değerine ayarlanması, PIN ve eşleme kimlik doğrulama yöntemlerini engeller.\n\nPolitikanın ayarlanmaması halinde, PIN ve/veya eşleme kimlik doğrulama yöntemlerinin kullanılıp kullanılamayacağına ana makine karar verir.\n\nNot: Bu ayar sonucunda ana makine ve istemci tarafında her iki tarafın desteklediği kimlik doğrulama yöntemleri bulunmazsa bağlantı reddedilir.";
RemoteAccessHostAllowRelayedConnection.pfm_title = "Uzaktan erişen ana makine tarafından geçiş sunucuları kullanılmasını etkinleştir";
RemoteAccessHostAllowRelayedConnection.pfm_description = "RemoteAccessHostFirewallTraversal politikası Etkin değerine ayarlanırsa, RemoteAccessHostAllowRelayedConnection politikasının Etkin değerine ayarlanması veya ayarlanmadan bırakılması halinde uzak istemcilerin, güvenlik duvarı kısıtlamaları gibi nedenlerden dolayı doğrudan bağlantı olmadığında geçiş sunucularını kullanarak bu makineye bağlanmasına izin verilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa uzaktan erişim kapatılmaz, ancak yalnızca aynı ağdan bağlantılara izin verilir (NAT geçişine veya geçiş sunucularına izin verilmez).";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "Bu makineye uzaktan erişim bağlantılarına izin ver";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "Bu politika Devre Dışı değerine ayarlanırsa uzaktan erişim ana makine hizmeti başlatılamaz veya gelen bağlantıları kabul etmek üzere yapılandırılamaz.  Bu politika, uzaktan destek senaryolarını etkilemez.\n\nEtkin değerine ayarlanır, boş bırakılır veya ayarlanmazsa bu politikanın hiçbir etkisi olmaz.";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "Bu makineye uzaktan destek bağlantılarına izin ver";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "Bu politika devre dışı bırakılırsa uzaktan destek ana makinesi başlatılamaz veya gelen bağlantıları kabul etmek üzere yapılandırılamaz.\n\nBu politika, uzaktan erişim senaryolarını etkilemez.\n\nBu politika, kurumsal yöneticilerin yönetilen Google Chrome OS cihazlara bağlanmasını engellemez.\n\nEtkinleştirilir, boş bırakılır veya ayarlanmazsa bu politikanın hiçbir etkisi olmaz.";
RemoteAccessHostAllowUrlForwarding.pfm_title = "Uzaktan erişim kullanıcılarının, yerel istemci tarayıcılarında ana makine taraflı URL'leri açmasına izin ver";
RemoteAccessHostAllowUrlForwarding.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa uzaktan erişim ana makinesine bağlı kullanıcıların, yerel istemci tarayıcılarında ana makine taraflı URL'leri açmasına izin verilebilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa uzaktan erişim ana makinesinin, istemciye URL göndermesi engellenir.\n\nÖzellik, uzaktan yardım bağlantılarında desteklenmediğinden bu ayar söz konusu bağlantı modunda geçerli değildir.\n\nNot: Bu özellik henüz genel kullanıma sunulmadığı için özelliğin etkinleştirilmesi, istemci kullanıcı arayüzünde görünür olacağı anlamına gelmez.";
RemoteAccessHostClientDomainList.pfm_title = "Uzaktan erişim istemcileri için gereken alan adlarını yapılandır";
RemoteAccessHostClientDomainList.pfm_description = "Politika ayarlanırsa uzaktan erişim istemcilerine uygulanacak istemci alan adlarını belirtir. Kullanıcılar bu alan adlarını değiştiremez. Yalnızca belirtilen alan adlarından birinden gelen istemciler ana makineye bağlanabilir.\n\nPolitika boş listeye ayarlanırsa veya ayarlanmadan bırakılırsa bağlantı türü için varsayılan politika uygulanır. Bu durum, uzaktan yardım açısından, herhangi bir alan adındaki istemcilerin ana makineye bağlanmasına olanak tanır. Herhangi bir zamanda gerçekleştirilen uzaktan erişim için yalnızca ana makine sahibi bağlantı kurabilir.\n\nAyrıca RemoteAccessHostDomainList politikasına bakın.\n\nNot: Politika ayarlanırsa RemoteAccessHostClientDomain politikasını geçersiz kılar.";
RemoteAccessHostClipboardSizeBytes.pfm_title = "Pano senkronizasyonu aracılığıyla istemci ve ana makine arasında aktarılabilecek bayt cinsinden maksimum boyut";
RemoteAccessHostClipboardSizeBytes.pfm_description = "Bu politika ayarlanırsa ana makineye ve ana makineden gönderilen pano verileri bu politikada belirlenen sınıra göre kesilecektir.\n\n0 değeri ayarlanırsa pano senkronizasyonu devre dışı bırakılır.\n\nBu politika hem uzaktan erişim hem de uzaktan destek senaryolarını etkiler.\n\nAyarlanmazsa bu politikanın hiçbir etkisi olmaz.\n\nPolitikanın min/maks aralığında olmayan bir değere ayarlanması, ana makinenin başlamasına engel olabilir.\n\nPano boyutunun gerçek üst sınırının, bu politikanın kontrol etmediği WebRTC veri kanalının maksimum mesaj boyutuna dayalı olduğunu lütfen unutmayın.";
RemoteAccessHostDomainList.pfm_title = "Uzaktan erişim ana makineleri için gereken alan adlarını yapılandır";
RemoteAccessHostDomainList.pfm_description = "Politika ayarlanırsa uzaktan erişim ana makinelerine uygulanacak ana makine alan adlarını belirtir. Kullanıcılar bu alan adlarını değiştiremez. Ana makineler yalnızca belirtilen alan adlarından birinde kayıtlı hesaplar kullanılarak paylaşılabilir.\n\nPolitika boş listeye ayarlanır veya ayarlanmazsa ana makineler herhangi bir hesap kullanılarak paylaşılabilir.\n\nAyrıca RemoteAccessHostClientDomainList politikasına bakın.\n\nNot: Bu ayar mevcut olması halinde RemoteAccessHostDomain politikasını geçersiz kılar.";
RemoteAccessHostFirewallTraversal.pfm_title = "Uzaktan erişim ana makinesinden güvenlik duvarı geçişini etkinleştir";
RemoteAccessHostFirewallTraversal.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa STUN sunucularının kullanılmasına izin verilir. Uzak istemciler, bir güvenlik duvarıyla ayrılmış olsa bile bu makineyi keşfedip bağlanabilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa UDP bağlantılarına güvenlik duvarı tarafından filtre uygulandığında bu makine, yalnızca yerel ağ içindeki istemci makinelerden gelen bağlantılara izin verir.";
RemoteAccessHostMatchUsername.pfm_title = "Yerel kullanıcının adı ile uzak erişim ana makinesi sahibinin adının aynı olmasını gerektir";
RemoteAccessHostMatchUsername.pfm_description = "Politika, Etkin değerine ayarlanırsa uzaktan erişim ana makinesi, ana makine ile ilişkilendirilmiş yerel kullanıcının adını, ana makinenin sahibi olarak kayıtlı Google Hesabının adıyla (ör. ana makinenin sahibi \"candogru@example.com\" hesabı ise, bu ad \"candogru\" olur) karşılaştırır. Ana makinenin sahibinin adı, ana makinenin ilişkilendirildiği yerel kullanıcının adından farklı ise bu uzaktan erişim ana makinesi çalışmaz. Ana makine sahibinin Google Hesabının belirli bir alan adıyla ilişkilendirilmesini sağlamak için bu politikayı, RemoteAccessHostDomain politikası ile birlikte kullanın.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa uzaktan erişim ana makinesi herhangi bir yerel kullanıcıyla ilişkilendirilebilir.";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "Uzaktan erişim bağlantıları için izin verilen maksimum oturum süresi";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "Bu politika ayarlanırsa, dakika cinsinden tanımlanmış olan süre geçtikten sonra uzaktan erişim bağlantıları otomatik olarak kesilir. Bu durum maksimum oturum süresi aşıldıktan sonra istemcinin tekrar bağlanmasına engel olmaz. Politikanın min/maks aralığında olmayan bir değere ayarlanması, ana makinenin başlamasına engel olabilir. Bu politika, uzaktan destek senaryolarını etkilemez.\n\nAyarlanmazsa bu politikanın hiçbir etkisi olmaz. Bu durumda uzaktan erişim bağlantılarının bu makinede süre kısıtlaması olmaz.";
RemoteAccessHostRequireCurtain.pfm_title = "Uzaktan erişen ana makinelerin perdelenmesini etkinleştirme";
RemoteAccessHostRequireCurtain.pfm_description = "Politika, Etkin değerine ayarlanırsa uzak bağlantı sırasında uzaktan erişim ana makinelerin fiziksel giriş ve çıkış cihazları devre dışı bırakılır.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa ana makine paylaşıldığı sırada hem yerel hem de uzak kullanıcıların etkileşimde bulunmasına izin verilir.";
RemoteAccessHostUdpPortRange.pfm_title = "Uzaktan erişen ana makine tarafından kullanılan UDP bağlantı noktası aralığını kısıtla";
RemoteAccessHostUdpPortRange.pfm_description = "Politikanın ayarlanması, uzaktan erişim ana makinesi tarafından bu makinede kullanılan UDP bağlantı noktası aralığını kısıtlar.\n\nPolitika ayarlanmaz veya boş dize olarak ayarlanırsa uzaktan erişim ana makinesinin, kullanılabilir bağlantı noktalarından herhangi birini kullanmasına izin verilir.\n\nNot: RemoteAccessHostFirewallTraversal politikası Devre Dışı değerine ayarlanırsa uzaktan erişim ana makinesi, 12400-12409 aralığındaki UDP bağlantı noktalarını kullanır.";
RemoteDebuggingAllowed.pfm_title = "Uzaktan hata ayıklamaya izin ver";
RemoteDebuggingAllowed.pfm_description = "Kullanıcıların uzaktan hata ayıklama kullanıp kullanamayacaklarını kontrol eder.\n\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar, masaüstü platformlarda --remote-debugging-port ve --remote-debugging-pipe komut satırı anahtarlarını belirterek veya Android cihazında USB üzerinden hata ayıklama sistem ayarını etkinleştirerek uzaktan hata ayıklamayı kullanabilirler.\n\nBu politika Devre dışı değerine ayarlanırsa kullanıcılar, uzaktan hata ayıklama kullanamazlar.";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "Yerel güven bağlantıları için online OCSP/CRL denetimlerini gerekli kıl";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "Politikayı Doğru değerine ayarlamak, Brave ürününün yerel olarak yüklü CA sertifikaları tarafından imzalanmış başarıyla doğrulanmış sunucu sertifikaları için her zaman iptal kontrolü yapacağı anlamına gelir. Brave, iptal durumu bilgilerini alamazsa Brave, bu sertifikaları iptal edildi (\"kesin hata\") olarak değerlendirir.\n\nPolitikayı Yanlış değerine ayarlamak veya ayarlamadan bırakmak, Brave ürününün mevcut online iptal kontrolü ayarlarını kullanacağı anlamına gelir.\n\nmacOS üzerinde ChromeRootStoreEnabled politikası Yanlış değerine ayarlanırsa bu politikanın etkisi olmaz.";
RestoreOnStartup.pfm_title = "Başlangıçtaki işlem";
RestoreOnStartup.pfm_description = "5 - Yeni Sekme Sayfasını aç\n1 - Son oturumu geri yükle\n4 - URL listesi aç\n6 - Bir URL listesi açıp son oturumu geri yükle\nPolitikayı ayarlamak, başlangıçta sistem davranışını belirtmenize olanak tanır. Brave ürününün, başlangıç davranışını belirtmesi gerektiğinden bu ayarı kapatmak, politikanın ayarlanmadan bırakılması anlamına gelir.\n\nBu politikayı ayarlarsanız kullanıcılar Brave ürününde değiştiremez. Politika ayarlanmazsa kullanıcılar sistem davranışını değiştirebilir.\n\nPolitika, RestoreOnStartupIsLastSession veya RestoreOnStartupIsLastSessionAndURLs olarak ayarlanırsa oturumlarla ilişkili olan veya çıkışta tarama verilerini ya da salt oturum çerezlerini temizleme gibi çıkışta çeşitli işlemler yapan bazı ayarlar devre dışı kalır.\n\nBu politika RestoreOnStartupIsLastSessionAndURLs olarak ayarlanırsa tarayıcı, önceki oturumu geri yükleyip ayrı bir pencere açarak RestoreOnStartupURLs politikasından ayarlanan URL'leri gösterir. Kullanıcıların bu URL'leri açık tutmayı seçebileceklerini ve sonraki oturumda bu URL'lerin de geri yükleneceğini unutmayın.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
RestoreOnStartupURLs.pfm_title = "Başlangıçta açılacak olan URL'ler";
RestoreOnStartupURLs.pfm_description = "RestoreOnStartup politikası RestoreOnStartupIsURLs olarak ayarlanırsa RestoreOnStartupURLs politikasını bir URL listesine ayarlamak hangi URL'lerin açılacağını belirtir.\n\nPolitika ayarlanmadan bırakılırsa başlangıçta Yeni Sekme sayfası açılır.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "Bir hizmet çalışanı tarafından çağrıldığında Restrict Background Fetch API'yi kısıtla";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "Bu politika, hizmet çalışanlarından gelen arka planda getirme isteklerinin kısıtlanıp kısıtlanmayacağını kontrol eder. Arka planda dosya indiren bir özellik etkilenirse bu politika geçerli olabilir.\n\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kısıtlama etkin olur ve hizmet çalışanı bağlamlarından gelen arka planda getirme istekleri engellenebilir.\n\nBu politika, Devre dışı değerine ayarlanırsa kısıtlama atlanır ve tüm hizmet çalışanlarının arka planda getirme isteği göndermesine izin verilir.\n\nBu kurumsal politika geçici olup M152 sürümünden sonra kaldırılacaktır.";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "Brave PDF görüntüleyicideki PDF dosyalarını Google Drive'a kaydetmeye uygun Google Hesaplarını kısıtla";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "Brave PDF görüntüleyicideki PDF dosyalarını Google Drive'a kaydetmeye uygun Google Hesaplarını belirleyen bir normal ifade içerir.\n\nBir kullanıcı, bu kalıpla eşleşmeyen bir hesap kullanarak Google Drive'a PDF dosyası yüklemeye çalışırsa hata mesajı gösterilir.\n\nBu politika ayarlanmadan bırakılır veya boş bırakılırsa kullanıcı, PDF dosyalarını Google Drive'a kaydetmek için herhangi bir Google Hesabı'nı kullanabilir.";
RestrictSigninToPattern.pfm_title = "Brave dahilinde hangi Google hesaplarının tarayıcı birincil hesapları olarak ayarlanmasına izin verileceğini kısıtlama";
RestrictSigninToPattern.pfm_description = "Brave dahilinde hangi Google hesaplarının tarayıcı birincil hesapları (senkronizasyonu etkinleştirme akışında seçilen hesap) olarak ayarlanabileceğini belirlemek için kullanılan normal bir ifade içerir.\n\nBir kullanıcı bu kalıba uymayan bir kullanıcı adıyla tarayıcı birincil hesabını ayarlamaya çalışırsa ilgili bir hata görüntülenir.\n\nBu politika ayarlanmamış olarak veya boş bırakılırsa, kullanıcı Brave dahilinde herhangi bir Google hesabını tarayıcı birincil hesabı olarak ayarlayabilir.";
RestrictYouTubeCookiesDeletion.pfm_title = "YouTube çerezlerinin silinmesini kısıtla";
RestrictYouTubeCookiesDeletion.pfm_description = "YouTube çerezlerinin manuel olarak silinmesini engeller.\n\nBu politika, kullanıcıların site ayarları sayfasından YouTube çerezlerini manuel olarak temizledikten sonra YouTube hizmetlerine yetkisiz erişmesini engellemeyi amaçlar.\n\nPolitika, Etkin değerine ayarlanırsa YouTube çerezlerinin manuel olarak silinmesi engellenir.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa YouTube çerezleri normal şekilde silinebilir.\n\nNot: Bu politika yalnızca site ayarları kullanıcı arayüzünden manuel silme işlemini engeller. ClearBrowsingDataOnExitList veya BrowsingDataLifetime politikalarıyla otomatik silme işlemini engellemez. Ayrıca, AllowDeletingBrowserHistory politikası etkinleştirilirse kullanıcılar, Tarama Verilerini Temizle iletişim kutusunu kullanarak tüm çerezlerini temizleyebilir.";
SSLErrorOverrideAllowed.pfm_title = "SSL uyarı sayfasından devam etmeye izin ver";
SSLErrorOverrideAllowed.pfm_description = "Politika Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcıların SSS hatalarına neden olan sitelere gittiklerinde Brave tarafından gösterilen uyarı sayfalarını tıklamalarına izin verilir.\n\nPolitika Devre Dışı değerine ayarlanırsa kullanıcıların uyarı sayfalarını tıklamalarına izin verilmez.";
SSLErrorOverrideAllowedForOrigins.pfm_title = "Belirli kaynaklarda SSL uyarı sayfasından devam etmeye izin ver";
SSLErrorOverrideAllowedForOrigins.pfm_description = "SSLErrorOverrideAllowed Devre Dışı bırakılırsa politikayı ayarlamak, SSL hatası olan sitelere giden kullanıcıların, Brave tarafından gösterilen uyarı sayfalarını hangi sitelerde atlayabileceklerini belirten kaynak kalıplarının olduğu bir liste yapmanıza olanak tanır. Kullanıcılar, bu listede olmayan kaynaklarda SSL uyarı sayfalarını atlayamaz.\n\nSSLErrorOverrideAllowed, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa bu politikanın bir işlevi olmaz.\n\nPolitika ayarlanmadan bırakılırsa SSLErrorOverrideAllowed bütün siteler için geçerli olur.\n\nGeçerli giriş kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir. Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yok sayılır.";
SafeBrowsingAllowlistDomains.pfm_title = "Güvenli Tarama'nın uyarıları tetiklemeyeceği alan adlarının listesini yapılandırır.";
SafeBrowsingAllowlistDomains.pfm_description = "Politika, Etkin değerine ayarlanırsa Güvenli Tarama, belirttiğiniz alan adlarına güvenir. Bu alan adlarında kimlik avı, kötü amaçlı yazılım veya istenmeyen yazılım gibi tehlikeli kaynakların bulunup bulunmadığı kontrol edilmez. Güvenli Tarama'nın indirme koruma hizmeti, bu alan adlarında barındırılan indirmeleri kontrol etmez. Şifre koruma hizmeti, şifre yeniden kullanımını kontrol etmez.\n\nPolitika ayarlanmadan bırakılırsa varsayılan Güvenli Tarama koruması tüm kaynaklar için geçerli olur.\n\nBu politika normal ifadeleri desteklemez ancak belirli bir alanın alt alan adları, izin verilenler listesine alınır. Tam etki alan adları (FQDN'ler) gerekli değildir.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya Microsoft® Azure® Active Directory® alan adına katılmış ya da Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.";
SafeBrowsingDeepScanningEnabled.pfm_title = "Güvenli Tarama'yı etkinleştirmiş kullanıcıların derin tarama yapmasına izin ver";
SafeBrowsingDeepScanningEnabled.pfm_description = "Bu politika etkinleştirildiğinde veya ayarlanmadan bırakıldığında Brave, Güvenli Tarama'yı etkinleştirmiş kullanıcıların gerçekleştirdiği şüpheli indirme işlemlerini, kötü amaçlı yazılım açısından taraması için Google'a gönderebilir veya şifrelenmiş arşivler için kullanıcıların şifre girmesini isteyebilir.\nBu politika devre dışı bırakıldığında tarama yapılmaz.\nBu politika, Chrome Enterprise Connectors tarafından yapılandırılan indirilen içerik analizini etkilemez.";
SafeBrowsingProtectionLevel.pfm_title = "Güvenli Tarama Koruma Seviyesi";
SafeBrowsingProtectionLevel.pfm_description = "0 - Güvenli Tarama hiçbir zaman etkin değil.\n1 - Güvenli Tarama standart modda etkin.\n2 - Güvenli Tarama gelişmiş modda etkin. Bu mod daha yüksek güvenlik sağlar, ancak Google ile daha fazla tarama bilgisi paylaşmayı gerektirir.\nBrave Güvenli Tarama özelliğinin etkin olup olmadığını ve hangi modda çalıştığını kontrol etmenize olanak tanır.\n\nBu politika \"NoProtection\" (0 değeri) olarak ayarlanırsa Güvenli Tarama hiçbir zaman etkin olmaz.\n\nBu politika \"StandardProtection\" (varsayılan değer olan 1 değeri) olarak ayarlanırsa Güvenli Tarama standart modda her zaman etkin olur.\n\nBu politika \"EnhancedProtection\" (2 değeri) olarak ayarlanırsa Güvenli Tarama gelişmiş modda her zaman etkin olur. Bu mod daha yüksek güvenlik sağlar, ancak Google ile daha fazla tarama bilgisi paylaşmayı gerektirir.\n\nBu politikayı zorunlu olarak ayarlarsanız kullanıcılar Brave içindeki Güvenli Tarama ayarını değiştiremez veya geçersiz kılamaz.\n\nBu politika ayarlanmadan bırakılırsa Güvenli Tarama, Standart Koruma modunda çalışır, ancak kullanıcılar bu ayarı değiştirebilir.\n\nGüvenli Tarama hakkında daha fazla bilgi için https://support.google.com/chrome?p=safe_browsing_preferences adresine göz atın.";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "Güvenli Tarama Proxy Kullanan Gerçek Zamanlı Kontrollere İzin Ver";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "Bu politika, URL'nin ziyaret edilmesinin güvenli olup olmadığını belirlemek için\nGüvenli Tarama'nın standart koruma modunun, URL'nin kısmi karmalarını habersiz\nHTTP üzerinden proxy aracılığıyla Google'a göndermesine izin verilip verilmediğini kontrol eder.\n\nProxy; tarayıcıların, kullanıcının IP adresine bağlanmadan URL'lerin kısmi karmalarını Google'a yüklemesine olanak tanır. Politika ayrıca Güvenli Tarama korumasının daha iyi olması için tarayıcıların URL'lerin kısmi karmalarını daha yüksek sıklıkta yüklemesine olanak tanır.\n\nGüvenli Tarama devre dışıysa veya gelişmiş koruma moduna ayarlanmışsa bu\npolitika yoksayılır.\n\nPolitika, Etkin olarak ayarlanır veya ayarlanmadan bırakılırsa daha yüksek\nkorumalı proxy kullanan aramalara izin verilir.\n\nPolitika, Devre Dışı olarak ayarlanırsa daha yüksek korumalı proxy kullanan aramalara izin\nverilmez. URL'lerin kısmi karmaları doğrudan Google'a çok daha düşük sıklıkta yüklenir. Bu da korumanın kalitesini düşürür.";
SafeBrowsingSurveysEnabled.pfm_title = "Güvenli Tarama anketlerine izin ver";
SafeBrowsingSurveysEnabled.pfm_description = "Bu politika etkinleştirildiğinde veya ayarlanmadan bırakıldığında kullanıcı, Güvenli Tarama ile ilgili anketler alabilir.\nBu politika devre dışı bırakıldığında kullanıcı, Güvenli Tarama ile ilgili anketleri almaz.";
SafeSitesFilterBehavior.pfm_title = "SafeSites yetişkinlere uygun içerik filtrelemeyi kontrol et.";
SafeSitesFilterBehavior.pfm_description = "0 - Yetişkinlere uygun içerik için siteler filtreleme\n1 - Yetişkinlere uygun içerik barındıran siteleri filtrele\nPolitikanın ayarlanması, URL'lerin pornografik olup olmadığını sınıflandırmak için Google Safe Search API'yi kullanan SafeSites URL filtresini kontrol eder.\n\nBu politika:\n\n* Yetişkinlere uygun içerik için siteleri filtreleme seçeneğine ayarlanır veya ayarlanmadan bırakılırsa siteler filtrelenmez.\n\n* Yetişkinlere uygun içerik için siteleri filtreleme seçeneğine ayarlanırsa pornografik siteler filtrelenir.\n\nPolitika, hem kullanıcının gittiği URL hem de iframe'ler için geçerlidir. URLAllowlist politikası bu politikaya göre daha önceliklidir ve Google Safe Search API kararlarını geçersiz kılmak için kullanılabilir.";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "Bu kaynakların Aynı Kaynak Sekmesini yakalamasına izin ver";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "Politikayı ayarlamak, kendisiyle aynı Kaynaklara sahip sekmeleri yakalayabilen URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika ayarlanmadan bırakılırsa siteler bu yakalama seviyesindeki geçersiz kılma için dikkate alınmaz.\n\nBu siteyle aynı kaynağa sahip pencereli Chrome Uygulamalarının yakalanmasına yine de izin verileceğini unutmayın.\n\nBir site bu politikadaki URL kalıbıyla eşleşirse şu politikalar dikkate alınmaz: TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.  Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yok sayılır.";
SandboxExternalProtocolBlocked.pfm_title = "Chrome'un, korumalı alana alınmış iframe'lerdeki harici protokollere yönelik gezinmeyi engellemesine izin ver";
SandboxExternalProtocolBlocked.pfm_description = "Chrome, korumalı alana alınmış iframe içerisindeki harici protokollere\nyönelik gezinmeleri engeller. https://chromestatus.com/features/5680742077038592 adresine bakın.\n\nPolitika, Doğru değerine ayarlandığında Chrome bu gezinmeleri engeller.\n\nPolitika, Yanlış değerine ayarlandığında Chrome'un bu gezinmeleri engellemesi önlenir.\n\nPolitika varsayılan olarak Doğru değerindeyse: Güvenlik özelliği etkindir.\n\nBu özellik, bu yeni kısıtlamadan etkilenen dahili web sitelerini güncellemek için daha fazla zamana ihtiyaç duyan yöneticiler tarafından kullanılabilir. Bu Kurumsal politika geçici olup Brave 117 sürümünden sonra kaldırılması planlanmaktadır.\n";
SavingBrowserHistoryDisabled.pfm_title = "Tarayıcı geçmişini kaydetmeyi devre dışı bırak";
SavingBrowserHistoryDisabled.pfm_description = "Politika, Etkin değerine ayarlanırsa tarama geçmişi kaydedilmez, sekme senkronizasyonu kapalı olur ve kullanıcılar bu ayarı değiştiremez.\n\nPolitika, Devre dışı değerine ayarlanır veya ayarlanmadan bırakılırsa tarama geçmişi kaydedilir.";
ScreenCaptureAllowed.pfm_title = "Ekran görüntüsü almaya izin ver veya bunu reddet";
ScreenCaptureAllowed.pfm_description = "Bu politika etkinleştirilir veya yapılandırılmazsa (varsayılan) bir web sayfası, kullanıcıdan ekran görüntüsü alınacak bir sekme, pencere veya masaüstü seçmesini istemek için ekran paylaşımı API'lerini (ör. getDisplayMedia() veya Desktop Capture uzantı API'si) kullanabilir.\n\nBu politika devre dışı bırakıldığında, ekran paylaşımı API'lerine yapılan\nçağrılar bir hatayla başarısız olur. Ancak site, aşağıdaki politikalardan\nherhangi birindeki kaynak kalıbıyla eşleşirse bu politika dikkate alınmaz (ve sitenin ekran paylaşımı\nAPI'lerini kullanmasına izin verilir):\nScreenCaptureAllowedByOrigins,\nWindowCaptureAllowedByOrigins,\nTabCaptureAllowedByOrigins,\nSameOriginTabCaptureAllowedByOrigins.\n";
ScreenCaptureAllowedByOrigins.pfm_title = "Bu kaynakların Masaüstü, Pencere ve Sekme yakalamasına izin ver";
ScreenCaptureAllowedByOrigins.pfm_description = "Politikayı ayarlamak; Masaüstü, Pencere ve Sekme Yakalama kullanabilen URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika ayarlanmadan bırakılırsa siteler bu Yakalama seviyesindeki geçersiz kılma için dikkate alınmaz.\n\nBir site, şu politikalardan herhangi birindeki URL kalıbıyla eşleşirse şu politikalardan hiçbiri dikkate alınmaz: WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nBir site bu politikadaki URL kalıbıyla eşleşirse ScreenCaptureAllowed politikası dikkate alınmaz.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.  Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yok sayılır.";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "Önceki kullanıcı hareketi olmadan ekran görüntüsü almaya izin ver";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "getDisplayMedia() web API, güvenlik nedenleriyle önceki kullanıcı hareketinin (\"geçici etkinleştirme\") çağrılmasını zorunlu kılar ve çağrılmadığı takdirde başarısız olur.\n\nBu politika ayarlandığında yöneticiler, önceki kullanıcı hareketi olmadan bu API'nin çağrılabileceği kaynakları belirtebilir.\n\nGeçerli URL kalıpları hakkında ayrıntılı bilgi için\nhttps://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz. *\nbu politikada kabul edilen bir değer değildir.\n\nBu politika ayarlanmazsa tüm kaynaklar, bu API'yi çağırmak için önceki kullanıcı hareketini zorunlu kılar.";
ScrollToTextFragmentEnabled.pfm_title = "URL parçalarında belirtilen metne kaydırma işlevini etkinleştirme";
ScrollToTextFragmentEnabled.pfm_description = "Bu özellik, köprülerin ve URL'lerin web sayfasındaki belirli bir metni hedeflemesine olanak tanıyarak, yüklenmesi tamamlandığında web sayfasını hedeflenen konuma kaydırır.\n\nBu politikayı etkinleştirir veya yapılandırmazsanız web sayfasını URL yoluyla belirli metin parçalarına kaydırma işlevi etkinleştirilir.\n\nBu politikayı devre dışı bırakırsanız web sayfasını URL yoluyla belirli metin parçalarına kaydırma işlevi devre dışı bırakılır.";
SearchContentSharingSettings.pfm_title = "Google AI Mode ve Lens entegrasyonlarıyla içerik paylaşımını etkinleştir";
SearchContentSharingSettings.pfm_description = "0 - Google AI Mode entegrasyonuyla içerik paylaşımına izin ver.\n1 - Google AI Mode entegrasyonlarıyla içerik paylaşımına izin verme.\nBu politika, Google Chrome yan paneli veya sekmeleri aracılığıyla sayfa ve dosya içeriğinin Google AI Mode ve Lens ile paylaşılmasını kontrol eder.\n\nBu politikanın web'deki Google AI Mode özelliğini etkilemediğini unutmayın. Yalnızca kullanıcıların Google Chrome kullanırken bu özellikle nasıl bilgi paylaşabileceğini kontrol eder.\n\n0 = Kullanıcılar, sayfa veya dosya içeriğini Google AI Mode ile paylaşabilir.\n\n1 = Kullanıcılar, sayfa veya dosya içeriğini Google AI Mode ile paylaşamaz. Bağlam paylaşımı için giriş noktaları ve yan panel devre dışı bırakılır veya gizlenir.\n\nBu politika, Google Search kullanıcıların varsayılan arama motoru olmadığında, özellik devre dışı bırakıldığından yok sayılır.\n\nBu politika, AIModeSettings politikasından bağımsızdır. AIModeSettings politikası yalnızca çok amaçlı adres çubuğu veya yeni sekme sayfası arama kutusundaki giriş noktalarını kontrol ederken bu politika, yan panel veya sekmeler aracılığıyla bağlam paylaşımını kontrol eder.\n\nBu politika, GeminiSettings tarafından devre dışı bırakılabilen Google Gemini entegrasyonunu da kontrol etmez.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
SearchSuggestEnabled.pfm_title = "Arama önerilerini etkinleştir";
SearchSuggestEnabled.pfm_description = "Politikayı True (Doğru) değerine ayarlamak, Brave ürününün adres çubuğunda arama önerilerini açar. Politikayı False (Yanlış) değerine ayarlamak, arama önerilerini kapatır.\n\nYer işaretlerine veya geçmişe dayalı öneriler politikadan etkilenmez.\n\nBu politikayı ayarlarsanız kullanıcılar değiştiremez. Ayarlanmazsa arama önerileri ilk başta açıktır, ancak kullanıcılar istedikleri zaman kapatabilir.";
SecurityKeyPermitAttestation.pfm_title = "Doğrudan Güvenlik Anahtarı doğrulamasına otomatik olarak izin verilen URL'ler/alan adları";
SecurityKeyPermitAttestation.pfm_description = "Politikanın ayarlanması, güvenlik anahtarlarından onay sertifikaları istendiğinde hiçbir istem görünmeyen WebAuthn RP kimliklerini belirtir. Ayrıca, güvenlik anahtarına bağımsız onayın kullanılabileceğini belirten bir sinyal gönderilir. Bu olmadan, siteler güvenlik anahtarlarının onayını istediğinde kullanıcılar Brave sürüm 65 ve sonraki sürümlerde istem alır.";
SensorsAllowedForUrls.pfm_title = "Bu sitelerde sensörlere erişime izin ver";
SensorsAllowedForUrls.pfm_description = "Politikayı ayarlamak, hareket ve ışık sensörleri gibi sensörlere erişebilen siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultSensorsSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nAynı URL kalıbı hem bu politikada hem de SensorsBlockedForUrls politikasında yer alıyorsa ikincisine öncelik verilir ve hareket ya da ışık sensörlerine erişim engellenir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
SensorsBlockedForUrls.pfm_title = "Bu sitelerde sensörlere erişimi engelle";
SensorsBlockedForUrls.pfm_description = "Politikayı ayarlamak, hareket ve ışık sensörleri gibi sensörlere erişemeyen siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultSensorsSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nAynı URL kalıbı hem bu politikada hem de SensorsAllowedForUrls politikasında yer alıyorsa bu politikaya öncelik verilir ve hareket ya da ışık sensörlerine erişim engellenir.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir.";
SerialAllowAllPortsForUrls.pfm_title = "Sitelere, tüm seri bağlantı noktalarına bağlanmak için otomatik olarak izin ver.";
SerialAllowAllPortsForUrls.pfm_description = "Politikanın ayarlanması, kullanılabilen tüm seri bağlantı noktalarına erişmesine otomatik olarak izin verilen sitelerin listesini oluşturmanıza olanak tanır.\n\nURL'ler geçerli olmalıdır; aksi halde, politika yok sayılır. Yalnızca URL'nin kaynağı (şema, ana makine ve bağlantı noktası) dikkate alınır.\n\nBu politika Google Chrome OS üzerinde yalnızca ilişkili kullanıcılar için geçerli olur.\n\nBu politika DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls ve kullanıcının tercihlerini geçersiz kılar.";
SerialAllowUsbDevicesForUrls.pfm_title = "Sitelere, USB seri cihazlara bağlanmak için otomatik olarak izin ver.";
SerialAllowUsbDevicesForUrls.pfm_description = "Politikanın ayarlanması, vendor_id ve product_id alanıyla eşleşen tedarikçi ve ürün kimliklerine sahip USB seri cihazlarına erişmesine otomatik olarak izin verilen sitelerin listesini oluşturmanıza olanak tanır. product_id alanının atlanması, belirtilen sitelere vendor_id alanı ve herhangi bir ürün kimliğiyle eşleşen tedarikçi kimliğine sahip cihazlara erişim izni verir.\n\nURL'ler geçerli olmalıdır; aksi halde, politika yok sayılır. Yalnızca URL'nin kaynağı (şema, ana makine ve bağlantı noktası) dikkate alınır.\n\nChromeOS'te bu politika, yalnızca ilişkili kullanıcılar için geçerli olur.\n\nBu politika DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls ve kullanıcının tercihlerini geçersiz kılar.\n\nBu politika, yalnızca Web Serial API üzerinden USB cihazlarına erişimi etkiler. WebUSB API üzerinden USB cihazlarına erişim izni vermek için WebUsbAllowDevicesForUrls politikasını inceleyin.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls adresine bakın.";
SerialAskForUrls.pfm_title = "Bu sitelerde Serial API'sine izin ver";
SerialAskForUrls.pfm_description = "Politikayı ayarlamak, kullanıcılardan bir seri bağlantı noktasına erişme izni vermelerini isteyebilen siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultSerialGuardSetting bütün siteler için geçerli olur. Etkin değilse kullanıcının ayarları geçerlidir.\n\nSerialBlockedForUrls politikasıyla eşleşmeyen URL kalıpları için (eşleşme varsa), DefaultSerialGuardSetting (etkinse) veya kullanıcıların kişisel ayarları öncelikli olur (bu sırayla).\n\nURL kalıpları SerialBlockedForUrls ile çakışırsa yoksayılır.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
SerialBlockedForUrls.pfm_title = "Bu sitelerde Serial API'sini engelle";
SerialBlockedForUrls.pfm_description = "Politikayı ayarlamak, kullanıcılardan bir seri bağlantı noktasına erişme izni vermelerini isteyemeyecek siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultSerialGuardSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nSerialAskForUrls politikasıyla eşleşmeyen URL kalıpları için (eşleşme varsa), DefaultSerialGuardSetting (etkinse) veya kullanıcıların kişisel ayarları öncelikli olur (bu sırayla).\n\nURL kalıpları SerialAskForUrls ile çakışırsa bu politika öncelikli olur.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
ServiceWorkerAutoPreloadEnabled.pfm_title = "ServiceWorker'ın, başlatılmayı beklemeden gezinme istekleri göndermesine izin ver";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nServiceWorkerAutoPreload özelliği, ServiceWorker önyükleme sürecini başlattığı sırada ana kaynak için bir ağ isteği gönderir.\n\nPolitika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa\nBrave, ServiceWorkerAutoPreload'u etkinleştirir. Gezinme isteği, bazı senaryolarda (ör. ServiceWorker çalışmıyorsa) ServiceWorker başlatılırken otomatik olarak gönderilir.\n\nPolitika devre dışı bırakılırsa Brave, ServiceWorkerAutoPreload'u etkinleştirmez. Gezinme isteği her zaman ServiceWorker başlatıldıktan sonra gönderilir.\n\nBu politika, özelliği kontrol etmek için geçici bir çözüm olup M154 sürümünde kaldırılacaktır.";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "ServiceWorker'ın srcdoc iframe'lerini kontrol etmesine izin ver";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "https://github.com/w3c/ServiceWorker/issues/765, \"allow-same-origin\" korumalı alan özelliğine sahip srcdoc iframe'inin ServiceWorker kontrolü altında olmasını gerektirir.\n\nPolitika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, \"allow-same-origin\" korumalı alan özelliklerine sahip srcdoc iframe'leri ServiceWorker tarafından kontrol edilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa srcdoc iframe'i ServiceWorker tarafından kontrol edilmez.\n\nBu politika, geçici olarak tasarlanmıştır ve 2026 yılında kaldırılacaktır.";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "Kökler arası erişime kapalı olmayan bağlamda, SharedArrayBuffers kullanılıp kullanılamayacağını belirler";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\nKökler arası erişime kapalı olmayan bir bağlamda SharedArrayBuffers kullanılıp kullanılamayacağını belirler. Brave, Brave 91 ve sonrasında (25.05.2021) Web Uyumluluğu nedeniyle SharedArrayBuffers kullanımında kökler arası erişime kapalı olmayı gerektirecek. Daha fazla ayrıntıyı aşağıdaki adreste bulabilirsiniz: https://developer.chrome.com/blog/enabling-shared-array-buffer/.\n\nDoğru değerine ayarlandığında, siteler kısıtlama olmadan SharedArrayBuffer kullanabilir.\n\nYanlış değerine ayarlanır veya ayarlanmadan bırakılırsa siteler, SharedArrayBuffers'ı yalnızca kökler arası erişime kapalı olduğunda kullanabilir.";
SharedWorkerBlobURLFixEnabled.pfm_title = "SharedWorker blob URL davranışını spesifikasyonla uyumlu hale getir";
SharedWorkerBlobURLFixEnabled.pfm_description = "https://w3c.github.io/ServiceWorker/#control-and-use-worker-client'a göre\nişleyiciler, blob URL'si için denetleyicileri devralabilmelidir.  Ancak mevcut kod, yalnızca DedicatedWorker'ların denetleyiciyi devralmasına izin verir, SharedWorker'lar denetleyiciyi devralmaz.\n\nPolitika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa bir blob URL'si SharedWorker URL'si olarak kullanıldığında Brave denetleyiciyi devralır.\n\nPolitika, Devre Dışı değerine ayarlandığında spesifikasyonla uyumlu olmayan davranış olduğu gibi bırakılır.\n\nBu politika, geçici olarak tasarlanmıştır ve gelecekte kaldırılacaktır.";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "SharedWorker'lar için uzatılmış kullanım ömrünü etkinleştir.";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "SharedWorker oluşturucuda \"extendedLifetime\" seçeneği doğru değerine ayarlanırsa SharedWorker'ların kullanım ömrü uzatılabilir.\n\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa SharedWorker'ların kullanım ömrü uzatılabilir.\n\nBu politika, Devre Dışı değerine ayarlanırsa seçenek doğru değerine ayarlanmış olsa bile SharedWorker'ların kullanım ömrü uzatılamaz.\n\nBu politika, geçici olarak tasarlanmıştır ve gelecekte kaldırılacaktır.";
ShoppingListEnabled.pfm_title = "Alışveriş listesi özelliğinin etkinleştirilmesine izin ver";
ShoppingListEnabled.pfm_description = "Bu politika, alışveriş listesi özelliğinin kullanılabilirliğini kontrol eder.\nEtkinleştirilirse kullanıcılara mevcut sayfada gösterilen ürünün fiyatını takip edebilecekleri bir kullanıcı arayüzü sunulur. Takip edilen ürün, yer işaretleri yan panelinde gösterilir.\nBu politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar alışveriş listesi özelliğini kullanabilirler.\nBu politika, Devre Dışı değerine ayarlanırsa alışveriş listesi özelliği kullanılamaz.\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "Yer işareti çubuğunda uygulamalar kısayolunu göster";
ShowAppsShortcutInBookmarkBar.pfm_description = "Politikayı True (Doğru) değerine ayarlamak, uygulama kısayollarını görüntüler. Politikayı False (Yanlış) değerine ayarlamak, bu kısayolun hiçbir zaman görünmeyeceği anlamına gelir.\n\nBu politikayı ayarlarsanız kullanıcılar değiştiremez. Ayarlanmazsa kullanıcılar uygulama kısayollarının yer işareti çubuğu içerik menüsünde gösterilmesine veya gizlenmesine karar verir.";
ShowCastIconInToolbar.pfm_title = "Google Cast araç çubuğu simgesini göster";
ShowCastIconInToolbar.pfm_description = "Politika, Etkin değerine ayarlanırsa Cast araç çubuğu simgesi, araç çubuğunda veya taşma menüsünde görüntülenir ve kullanıcılar tarafından kaldırılamaz.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar simgeyi içerik menüsünden sabitleyebilir veya kaldırabilir.\n\nEnableMediaRouter politikası Devre Dışı değerine ayarlanırsa bu politikanın değerinin geçerliliği kalmaz ve araç çubuğu simgesi görünmez.";
ShowCastSessionsStartedByOtherDevices.pfm_title = "Yerel ağdaki diğer cihazlar tarafından başlatılan Google Cast oturumları için medya kontrollerini göster";
ShowCastSessionsStartedByOtherDevices.pfm_description = "Bu politika etkinleştirildiğinde medya oynatma kontrolleri kullanıcı arayüzü, yerel ağdaki diğer cihazlar tarafından başlatılan Google Cast oturumları için kullanılabilir.\n\nBu politika kurumsal kullanıcılar için ayarlanmadığında veya devre dışı bırakıldığında medya oynatma kontrolleri kullanıcı arayüzü, yerel ağdaki diğer cihazlar tarafından başlatılan Google Cast oturumları için kullanılamaz.\n\nEnableMediaRouter politikası devre dışı bırakılırsa Google Cast işlevi tamamen devre dışı bırakıldığından bu politikanın değerinin hiçbir etkisi olmaz.";
ShowFullUrlsInAddressBar.pfm_title = "Tam URL'leri göster";
ShowFullUrlsInAddressBar.pfm_description = "Bu özellik, tam URL'nin adres çubuğunda görüntülenmesini sağlar.\nBu politika True (Doğru) değerine ayarlanırsa tam URL, şemalar ve alt alan adlarıyla birlikte adres çubuğunda gösterilir.\nBu politika False (Yanlış) değerine ayarlanırsa varsayılan URL görüntüsü uygulanır.\nBu politika ayarlanmadan bırakılırsa varsayılan URL görüntüsü uygulanır ve kullanıcı bir içerik menüsü seçeneği olmadan varsayılan ve tam URL görüntüsü arasında geçiş yapabilir.\n";
ShowHomeButton.pfm_title = "Araç çubuğunda Ana Sayfa düğmesini göster";
ShowHomeButton.pfm_description = "Politika Etkin değerine ayarlanırsa Brave araç çubuğunda Ana sayfa düğmesi gösterilir. Politika Devre Dışı değerine ayarlanırsa Ana sayfa düğmesinin görünmesi engellenir.\n\nBu politikayı ayarlarsanız kullanıcılar Brave ürününde değiştiremez. Politika ayarlanmadan bırakılırsa Ana sayfa düğmesinin gösterilip gösterilmeyeceğine kullanıcılar karar verir.";
SideSearchEnabled.pfm_title = "En son varsayılan arama motoru sonuç sayfasının, tarayıcı yan panelinde gösterilmesine izin ver";
SideSearchEnabled.pfm_description = "Politika, etkin değerine ayarlanırsa veya ayarlanmadan bırakılırsa kullanıcılar, araç çubuğundaki bir simgeyi açıp kapatarak en son varsayılan arama motoru sonuç sayfasını yan panelde açabilir.\n\nPolitika, devre dışı değerine ayarlanırsa varsayılan arama motoru sonuç sayfasının olduğu yan paneli açan bu simge araç çubuğundan kaldırılır.";
SignedHTTPExchangeEnabled.pfm_title = "İmzalı HTTP Değişimi (SXG) desteğini etkinleştir";
SignedHTTPExchangeEnabled.pfm_description = "Politika True (Doğru) değerine ayarlanır veya ayarlanmadan bırakılırsa Brave, İmzalanmış HTTP Takası olarak yayınlanan web içeriklerini kabul eder.\n\nPolitikanın False (Yanlış) değerine ayarlanması, İmzalanmış HTTP Takası içeriğinin yüklenmesini önler.";
SigninInterceptionEnabled.pfm_title = "Oturum açma müdahalesini etkinleştir";
SigninInterceptionEnabled.pfm_description = "Bu ayar, oturum açma müdahalesini etkinleştirir veya devre dışı bırakır.\n\nBu politika ayarlanmaz veya etkinleştirilirse web'de bir Google hesabı eklendiğinde oturum açma müdahalesi iletişim kutusu tetiklenir ve kullanıcı bu hesabı başka (yeni veya mevcut) bir profile taşıyabilir.\n\nBu politika devre dışı bırakılırsa oturum açma müdahalesi iletişim kutusu tetiklenmez.\nBu politika devre dışı olsa da, yönetilen hesap profil ayrımının ManagedAccountsSigninRestriction politikası tarafından zorunlu kılındığı durumlarda iletişim kutusu gösterilir.";
SilentPrintingEnabled.pfm_title = "Sessiz Yazdırma özelliğini etkinleştir";
SilentPrintingEnabled.pfm_description = "Bu politika Doğru değerine ayarlandığında Sessiz Yazdırma özelliği etkinleştirilir.\nSessiz Yazdırma, açıldığında yazdırma önizleme penceresini hemen kapatır ve varsayılan seçeneklerle\nvarsayılan yazıcıda yazdırır. Varsayılan yazıcı \"PDF olarak kaydet\" şeklinde görünüyorsa\ndosya, İndirilenler klasörüne kaydedilir.\n\nBu politika ayarlanmadan bırakılır veya Yanlış değerine ayarlanırsa Sessiz Yazdırma\ndevre dışı bırakılır. Bu durumda, yazdırma önizleme penceresi otomatik olarak kapatılmaz ve kullanıcının\nher zamanki gibi seçim yapması gerekir.";
SitePerProcess.pfm_title = "Her site için Site İzolasyonunu zorunlu tut";
SitePerProcess.pfm_description = "Site izolasyonu, 67. Brave sürümünden itibaren tüm masaüstü platformlarda varsayılan olarak etkinleştirilerek her sitenin kendi işleminde çalışmasına neden olur. Site, şema artı eTLD+1 olarak tanımlanır (ör. https://example.com). Bu politikanın Etkin değerine ayarlanması bu davranışı değiştirmez, yalnızca kullanıcıların bu ayarı devre dışı bırakmasını (örneğin, chrome://flags'te Site izolasyonunu devre dışı bırak seçeneğini kullanarak) engeller. 76. Brave sürümünden itibaren, bu politikanın Devre dışı değerine ayarlanması veya ayarlanmadan bırakılması, site izolasyonunu kapatmaz ancak kullanıcılar tarafından devre dışı bırakılmasına izin verir.\n\nSiteden daha yüksek ayrıntı düzeyindeki belirli kaynakların (ör. https://a.example.com) izole edilmesinde IsolateOrigins politikasından da yararlanılabilir.\n\n76. ve önceki Google Chrome OS sürümlerinde DeviceLoginScreenSitePerProcess cihaz politikasını aynı değere ayarlayın. (Değerlerin eşleşmemesi durumunda, kullanıcı oturumuna giriş sırasında gecikme yaşanabilir.)\n\nNot: Android için bunun yerine SitePerProcessAndroid politikasını kullanın.";
SiteSearchSettings.pfm_title = "Site arama ayarları";
SiteSearchSettings.pfm_description = "Bu politika, kullanıcıların adres çubuğunda kısayolları kullanarak hızlı bir şekilde arama yapabileceği sitelerin listesini sağlar. Kullanıcılar adres çubuğuna kısayol veya @kısayol (ör. @iş) yazıp Boşluk ya da Sekme tuşuna basarak arama başlatabilir.\n\nHer site için şu alanlar zorunludur: name, shortcut, url.\n\nname alanı, adres çubuğunda kullanıcıya gösterilecek site veya arama motoru adına karşılık gelir.\n\nshortcut, düz kelimeler ve karakterler içerebilir, ancak boşluk içeremez veya @ sembolüyle başlayamaz. Ayrıca kısayollar, benzersiz olmalıdır.\n\nurl alanı, her giriş için karşılık gelen anahtar kelimeyle arama sırasında kullanılan arama motorunun URL'sini belirtir. URL, sorguda kullanıcının arama terimi ile değiştirilen '{searchTerms}' dizesini içermelidir. Geçersiz girişler ve yinelenen kısayollara sahip girişler yoksayılır.\n\nKullanıcı \"@\" yazdığında, öne çıkan olarak yapılandırılmış site arama girişleri adres çubuğunda gösterilir. Öne çıkan olarak en fazla üç giriş seçilebilir.\n\nallow_user_override değerinin doğru olarak ayarlandığı bir site arama girişinde kullanıcılar bu girişi düzenleyebilir veya devre dışı bırakabilir. Ancak öne çıkan motorlar (\"@\" ile başlayan) yalnızca devre dışı bırakılabilir. Bir kullanıcı başlangıçta bu politikanın oluşturduğu bir girişi değiştirirse söz konusu giriş artık politika tarafından yönetilmez ve kullanıcı tarafından oluşturulan kısayol olarak değerlendirilir. Bir site arama girişi için allow_user_override değeri yanlış olarak ayarlanmışsa veya belirtilmemişse kullanıcılar söz konusu girişi düzenleyemez veya devre dışı bırakamaz. Kullanıcı geçersiz kılma işlemine izin verme ayarı yalnızca M139 ve sonraki sürümlerde desteklenir. Önceki sürümlerde kullanıcı geçersiz kılma işlemi varsayılan olarak devre dışı bırakılır.\n\nallow_user_override, site arama girişi için doğru değerine ayarlanmadığı sürece kullanıcılar daha önce bu politika aracılığıyla oluşturulmuş bir kısayolla yeni site arama girişleri oluşturamaz.\n\nKullanıcının daha önce oluşturduğu bir kısayolla çakışma olması durumunda kullanıcı ayarına öncelik verilir. Ancak kullanıcılar arama çubuğuna \"@\" yazarak politika tarafından oluşturulan seçeneği tetikleyebilir. Örneğin, kullanıcı URL1 kısayolu olarak daha önce \"iş\" kelimesini tanımladıysa ve politika \"iş\" kelimesini URL2 kısayolu olarak tanımlıyorsa arama çubuğuna \"iş\" yazıldığında URL1 araması tetiklenir ancak \"@iş\" yazıldığında URL2 araması tetiklenir.\n\nMicrosoft® Windows® işletim sisteminde bu politika yalnızca bir Microsoft® Active Directory® veya \"Microsoft® Azure® Active Directory®\" alan adına katılmış ya da \"Chrome Enterprise Core\" öğesine kaydolmuş örneklerde kullanılabilir.\n\nmacOS işletim sisteminde bu politika yalnızca MDM ile çalışan, MCX aracılığıyla bir alan adına katılmış veya Chrome Enterprise Core öğesine kaydolmuş örneklerde kullanılabilir.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=SiteSearchSettings adresine bakın.";
SmartTabSharingSettings.pfm_title = "Akıllı sekme paylaşımı ayarları";
SmartTabSharingSettings.pfm_description = "0 - Google AI Mode entegrasyonlarıyla akıllı sekme paylaşımına izin ver.\n1 - Google AI Mode entegrasyonlarıyla akıllı sekme paylaşımına izin verme.\nBu politika, Google Chrome yan paneli veya sekmeleri aracılığıyla Google AI Mode akıllı sekme paylaşımı özelliğini kontrol eder.\n\nBu politikanın web'deki Google AI Mode özelliğini etkilemediğini unutmayın. Yalnızca kullanıcıların Google Chrome kullanırken bu özellikle nasıl bilgi paylaşabileceğini kontrol eder.\n\n0 = Kullanıcılar, sayfa veya dosya içeriğini Google AI Mode ile paylaşabilir.\n\n1 = Kullanıcılar, sayfa veya dosya içeriğini Google AI Mode ile paylaşamaz. Bağlam paylaşımı için giriş noktaları ve yan panel devre dışı bırakılır veya gizlenir.\n\nBu politika, Google Search kullanıcıların varsayılan arama motoru olmadığında, özellik devre dışı bırakıldığından yok sayılır.\n\nBu politika, AIModeSettings politikasından bağımsızdır. AIModeSettings politikası yalnızca çok amaçlı adres çubuğu veya yeni sekme sayfası arama kutusundaki giriş noktalarını kontrol ederken bu politika, yan panel veya sekmeler aracılığıyla bağlam paylaşımını kontrol eder.\n\nBu politika, GeminiSettings tarafından devre dışı bırakılabilen Google Gemini entegrasyonunu da kontrol etmez.\n\nSearchContentSharingSettings devre dışı bırakılırsa bu politikanın yoksayılacağını hatırlatırız.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
SpellCheckServiceEnabled.pfm_title = "Yazım denetimi Web hizmetini etkinleştir veya devre dışı bırak";
SpellCheckServiceEnabled.pfm_description = "Politikanın Etkin değerine ayarlanması, yazım hatalarının çözülmesine yardımcı olmak için bir Google web hizmetinin kullanılmasını sağlar. Bu politika yalnızca çevrimiçi hizmetin kullanımını denetler. Politika, Devre Dışı değerine ayarlanırsa bu hizmet hiçbir zaman kullanılmaz.\n\nPolitika ayarlanmadan bırakılırsa kullanıcılar yazım denetimi hizmetinin kullanılıp kullanılmayacağına karar verebilirler.\n\nBu özellik, SpellcheckEnabled tarafından devre dışı bırakılmadıkça yazım denetimi her zaman yerel olarak indirilen bir sözlüğü kullanabilir. Bu durumda politikanın hiçbir etkisi olmaz.";
SpellcheckEnabled.pfm_title = "Yazım denetimini etkinleştir";
SpellcheckEnabled.pfm_description = "Politikanın Etkin değerine ayarlanması, yazım denetimini açar ve kullanıcılar tarafından kapatılamaz. Yazım denetimi dilleri Microsoft® Windows®, Google Chrome OS ve Linux® ürünlerinde ayrı ayrı açılıp kapatılabilir. Böylece kullanıcılar, her yazım denetimi dilini kapatarak yine de yazım denetimini devre dışı bırakabilirler. Bunu önlemek için belirli yazım denetimi dillerini etkinleştirmeye zorlamak üzere SpellcheckLanguage politikasını kullanın.\n\nPolitikanın Devre Dışı değerine ayarlanması, tüm kaynaklardan yazım denetimini kapatır ve kullanıcılar tarafından açılamaz. Bu politika Yanlış değerine ayarlandığında, SpellCheckServiceEnabled, SpellcheckLanguage ve SpellcheckLanguageBlocklist politikalarının herhangi bir etkisi olmaz.\n\nPolitika ayarlanmazsa kullanıcılar, dil ayarlarında yazım denetimini açabilir veya kapatabilirler.";
StandardizedBrowserZoomEnabled.pfm_title = "Standart Hale Getirilmiş Tarayıcı Yakınlaştırma Davranışını Etkinleştir";
StandardizedBrowserZoomEnabled.pfm_description = "Bu politika, yeni kullanılmaya başlanan CSS yakınlaştırma spesifikasyonuna uygunluğu etkinleştirir.\n\nBu politika, Etkin değerine ayarlandığında veya ayarlanmadığında CSS \"yakınlaştırma\" özelliği şu spesifikasyona uyar:\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\nPolitika, Devre Dışı değerine ayarlandığında CSS \"yakınlaştırma\" özelliği standart hale getirilmeden önceki eski davranışına geri döner.\n\nBu politika, web içeriğinin yeni davranışa geçirilmesi için zaman tanıyan geçici bir politikadır. Ayrıca, bu politika Devre Dışı değerine ayarlandığında geçerli olan davranışa karşılık gelen bir kaynak denemesi (\"DisableStandardizedBrowserZoom\") bulunur. Bu politika, 134 sürümünde kaldırılacak ve \"Etkin\" davranışı kalıcı hale getirilecektir.";
StaticStorageQuotaEnabled.pfm_title = "Depolama alanı kotası API'lerinin statik değerler döndürüp döndürmeyeceğini kontrol et";
StaticStorageQuotaEnabled.pfm_description = "Bu politika etkinleştirildiğinde depolama alanı kotası API'leri, kullanım + minimum (10 GiB, disk en yakın 1 GiB'a yuvarlanır) değere eşit statik bir değer döndürür.\nPolitika devre dışı bırakıldığında depolama alanı kotası API'leri, genellikle kullanımdan bağımsız olarak cihazda mevcut toplam alanla orantılı dinamik bir değer döndürür.\nPolitika ayarlanmadan bırakılırsa depolama alanı kotası API'leri varsayılan Chrome davranışını kullanır.\nSınırsız depolama izni olan siteler bu ayardan etkilenmez. Zorunlu kılınan kota da etkilenmez.";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "Çalışan komut dosyaları için sıkı MIME türü kontrolünü etkinleştir";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "Bu politika, çalışan komut dosyaları için sıkı MIME türü kontrolünü etkinleştirir.\n\nPolitika etkinleştirilir veya ayarlanmadan bırakılırsa çalışan komut dosyaları, JavaScript için sıkı MIME türü kontrolünü kullanır. Bu da varsayılan yeni davranıştır. Eski MIME türlerine sahip çalışan komut dosyaları reddedilir.\n\nPolitika devre dışı bırakılırsa çalışan komut dosyaları, lax MIME türü kontrolünü kullanır. Böylece, text/ascii gibi eski MIME türlerine sahip çalışan komut dosyaları yüklenmeye ve yürütülmeye devam eder.\n\nTarayıcılar geleneksel olarak lax MIME türü kontrolünü kullandığı için çok sayıda eski MIME türüne sahip kaynak desteklenmekteydi. Örneğin text/ascii, JavaScript kaynakları için desteklenen eski bir MIME türüdür. Bu, kaynakların hiçbir zaman komut dosyası olarak kullanılması amaçlanmamışken komut dosyası olarak yüklenmesine izin verdiği için güvenlik sorunları ortaya çıkabilir. Chrome, yakın bir tarihte sıkı MIME türü kontrolünü kullanmaya başlayacaktır. Etkinleştirilen politika, varsayılan davranışı uygular. Bu politikanın devre dışı bırakılması, yöneticilerin isterse eski davranışı korumasına olanak tanır.\n\nJavaScript/ECMAScript medya türleriyle ilgili ayrıntılı bilgi edinmek için https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage adresine göz atın.\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "Farklı kaynaklı alt çerçevelerden tetiklenen JavaScript İletişim Kutularını gizle";
SuppressDifferentOriginSubframeDialogs.pfm_description = "https://www.chromestatus.com/feature/5148698084376576 adresinde açıklandığı üzere; kaynağı ana çerçevenin kaynağından farklı olan bir alt çerçeveden tetiklenmeleri halinde window.alert, window.confirm ve window.prompt tarafından tetiklenen JavaScript kalıcı iletişim kutuları Brave içinde engellenir.\n\nBu politika söz konusu değişikliğin geçersiz kılınmasına izin verir.\nPolitika etkin olarak ayarlanır veya ayarlanmadan bırakılırsa farklı kaynaklı alt çerçevelerden tetiklenen JavaScript iletişim kutuları engellenir.\nPolitika devre dışı olarak ayarlanırsa farklı kaynaklı alt çerçevelerden tetiklenen JavaScript iletişim kutuları engellenmez.\n\nBu politika, gelecekte Brave ürününden kaldırılacaktır.";
SuppressUnsupportedOSWarning.pfm_title = "Desteklenmeyen OS uyarısını gizle";
SuppressUnsupportedOSWarning.pfm_description = "Politika Etkin değerine ayarlanırsa Brave desteklenmeyen bir bilgisayarda veya işletim sisteminde çalışırken görüntülenen uyarı gizlenir.\n\nPolitika Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa desteklenmeyen sistemlerde uyarı görüntülenir.";
SyncDisabled.pfm_title = "Google ile veri senkronizasyonunu devre dışı bırak";
SyncDisabled.pfm_description = "Politika, Etkin değerine ayarlanırsa, Google tarafından barındırılan senkronizasyon hizmetleri kullanılarakBrave içinde yapılan veri senkronizasyonu kapatılır.\nChrome Sync hizmetlerini tamamen kapatmak için Google Admin console içerisinde hizmeti kapatmanızı öneririz.\n\nPolitika, Devre Dışı değerine ayarlanırsa veya ayarlanmadan bırakılırsa kullanıcıların Chrome Sync kullanma konusunda seçim yapmasına izin verilir.\n\nNot: Bu özellik aynı istemci taraflı işleve sahip olduğundan, RoamingProfileSupportEnabled Etkinse bu politikayı etkinleştirmeyin. Bu durumda Google tarafından barındırılan senkronizasyon tamamen kapalıdır.";
SyncTypesListDisabled.pfm_title = "Senkronizasyonun dışında tutulması gereken türlerin listesi";
SyncTypesListDisabled.pfm_description = "Bu politika ayarlanırsa belirtilen tüm veri türleri hem Chrome Sync senkronizasyonunun hem de dolaşım profili senkronizasyonunun dışında tutulur. Bu, dolaşım profilinin boyutunu küçültmeye veya Chrome Sync sunucularına yüklenen veri türlerini sınırlandırmaya yarayabilir.\n\nŞu anda bu politika kapsamında bulunan veri türleri şunlardır: \"apps\", \"autofill\", \"bookmarks\", \"extensions\", \"preferences\", \"passwords\", \"payments\", \"productComparison\", \"readingList\", \"tabs\", \"themes\", \"typedUrls\", \"wifiConfigurations\". Bu adlar büyük/küçük harfe duyarlıdır.\n\nNotlar: Dinamik politika yenileme yalnızca Brave 123 sürümünde ve sonraki sürümlerde desteklenir. \"autofill\" veri türü devre dışı bırakıldığında \"payments\" türü de devre dışı bırakılır. \"typedUrls\", tüm tarama geçmişini ifade eder.";
TLS13EarlyDataEnabled.pfm_title = "TLS 1.3 Early Data'yı Etkinleştir";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Eary Data, TLS el sıkışmasıyla aynı anda HTTP isteği göndermek için kullanılan bir TLS 1.3 uzantısıdır.\n\nBu politika yapılandırılmazsa Brave, TLS 1.3 Early Data için varsayılan kullanıma sunma işlemini uygular.\n\nPolitika etkinleştirilirse Brave, TLS 1.3 Early Data'yı etkinleştirir.\n\nPolitika devre dışı bırakılırsa Brave, TLS 1.3 Early Data'yı etkinleştirmez.\n\nBu özellik etkinleştirildiğinde Brave, sunucu desteğine bağlı olarak TLS 1.3 Early Data'yı kullanabilir veya kullanmayabilir.\n\nTLS 1.3 Early Data yerleşik bir protokoldür. Mevcut TLS sunucularının, ara katmanlarının ve güvenlik yazılımlarının TLS 1.3 Early Data'yı bağlantıyı kesmeden işlemeleri veya reddetmeleri beklenir.\n\nAncak TLS'yi doğru şekilde uygulamayan cihazlar TLS 1.3 Early Data'yı kullanılırken düzgün çalışmayabilir ve bağlantısı kesilebilir. Bu sorunla karşılaşan yöneticiler durumun düzeltilmesi için satıcıyla iletişime geçmelidir.\n\nBu politika, özelliği kontrol etmek için geçici bir çözüm olup daha sonra kaldırılacaktır. Sorunları test edebilmeniz için politika etkinleştirilebilir ve sorunlar çözülürken devre dışı bırakılabilir.";
TabCaptureAllowedByOrigins.pfm_title = "Bu kaynakların Sekme yakalamasına izin ver";
TabCaptureAllowedByOrigins.pfm_description = "Politikayı ayarlamak, Sekme Yakalama'yı kullanabilen URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika ayarlanmadan bırakılırsa siteler bu yakalama seviyesindeki geçersiz kılma için dikkate alınmaz.\n\nPencereli Chrome Uygulamalarının yakalanmasına yine de izin verileceğini unutmayın.\n\nBir site, SameOriginTabCaptureAllowedByOrigins politikasındaki URL kalıbıyla eşleşirse bu politika dikkate alınmaz\n\nBir site bu politikadaki URL kalıbıyla eşleşirse şu politikalar dikkate alınmaz: WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.  Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yok sayılır.";
TabCompareSettings.pfm_title = "Sekme Karşılaştırma ayarları";
TabCompareSettings.pfm_description = "0 - Sekme Karşılaştırma'ya izin ver ve yapay zeka modellerini daha iyi hale getir.\n1 - Yapay zeka modellerini daha iyi hale getirmeden Sekme Karşılaştırma'ya izin ver.\n2 - Sekme Karşılaştırma'ya izin verme.\nSekme Karşılaştırma, kullanıcının sekmelerindeki bilgileri karşılaştırmak için kullanılan yapay zeka destekli bir araçtır. Bu özellik, örneğin benzer kategorideki ürünlerin bulunduğu birden fazla sekme açıkken kullanıcıya sunulabilir.\n\n0 = Özelliğin kullanılmasına izin verirken Google'ın yapay zeka modellerini iyileştirmek için ilgili verileri kullanmasına izin verir. İlgili veriler arasında özelliğe bağlı olarak istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler yer alabilir. Bu bilgiler, gerçek kişiler tarafından da yapay zeka modellerini iyileştirmek için incelenebilir. Aşağıdaki değerler belirtilmediği sürece varsayılan değer 0'dır.\n\n1 = Özelliğin kullanılmasına izin verir ancak Google'ın kullanıcıların içeriklerini (istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler dahil) kullanarak modelleri iyileştirmesine izin vermez. Google Admin console tarafından yönetilen kurumsal kullanıcılar ve Google Workspace tarafından yönetilen eğitim hesapları için varsayılan değer 1'dir.\n\n2 = Özelliğe izin vermez.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
TabDiscardingExceptions.pfm_title = "Sekme silmeyle ilgili URL kalıbı istisnaları";
TabDiscardingExceptions.pfm_description = "Bu politika, URLBlocklist filtre biçimini kullanarak belirttiği kalıplardan en az bir tanesiyle eşleşen herhangi bir URL'nin, tarayıcı tarafından hiçbir zaman silinmemesini sağlar.\nBu durum, bellek baskısı ve yüksek verimlilik modunun silinme işleminde de geçerlidir.\nSilinmiş sayfa kaldırılır ve kaynakları tamamen geri alınır. İlişkili olduğu sekme, sekme şeridinde kalır ancak bu sekme görünür olduğunda tamamen yeniden yükleme işlemi tetiklenir.\n";
TaskManagerEndProcessEnabled.pfm_title = "Görev Yöneticisi'ndeki işlemlerin sona erdirilebilmesini etkinleştir";
TaskManagerEndProcessEnabled.pfm_description = "Politika, Devre Dışı değerine ayarlanırsa kullanıcıların, Görev Yöneticisi'ndeki işlemleri sona erdirmesi engellenir.\n\nPolitika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcıların, Görev Yöneticisi'ndeki işlemleri sona erdirmesine izin verilir.";
ThirdPartyAiChatSettings.pfm_title = "Adres çubuğundaki ve Yeni Sekme sayfası arama kutusundaki üçüncü taraf AI Modu entegrasyonlarıyla ilgili ayarlar.";
ThirdPartyAiChatSettings.pfm_description = "0 - Üçüncü taraf AI Modu entegrasyonlarına izin ver.\n1 - Üçüncü taraf AI Modu entegrasyonlarına izin verme.\nBu politika, adres çubuğundaki ve Yeni Sekme sayfası arama kutusundaki üçüncü taraf AI Modu entegrasyonlarını kontrol eder.\n\nBu özelliğe erişebilmek için kullanıcının varsayılan arama motoru olarak AI Modu'nu destekleyen üçüncü taraf bir arama motoru ayarlanmış olmalıdır.\n\n0 = Kullanıcılar özelliği kullanabilir.\n\n1 = Kullanıcılar özelliği kullanamaz.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "Chrome örnekleri için bellek sınırı ayarla";
TotalMemoryLimitMb.pfm_description = "Bellekten tasarruf etmek için sekmelerin silinmeye başlamasından önce (sekme tarafından kullanılan bellek serbest kalır ve sekmeye geçiş yapıldığında sekmenin yeniden yüklenmesi gerekir) tek bir Brave örneğinin kullanabileceği bellek miktarını yapılandırır.\n\nPolitika ayarlanırsa tarayıcı, sınır geçildikten sonra bellekten tasarruf etmek için sekmeleri silmeye başlar. Bununla birlikte, tarayıcının her zaman sınırın altında çalışacağına dair herhangi bir garanti yoktur. 1024'ün altındaki değerler 1024'e yuvarlanır.\n\nBu politika ayarlanmazsa tarayıcı yalnızca makinesindeki fiziksel bellek miktarının düştüğünü algıladığında bellekten tasarruf etmeye çalışır.";
TranslateEnabled.pfm_title = "Google Çeviri'yi etkinleştir";
TranslateEnabled.pfm_description = "Politikayı True (Doğru) değerine ayarlamak, kullanıcılar için uygun olduğunda hem Brave ürününde entegre çeviri araç çubuğu hem de sağ tıklanan içerik menüsünde çeviri seçeneği göstererek çeviri işlevselliği sağlar. Politikayı False (Yanlış) değerine ayarlamak, tüm yerleşik çeviri özelliklerini kapatır.\n\nPolitikayı ayarlarsanız kullanıcılar bu fonksiyonu değiştiremez. Ayarlamadan bırakırsanız kullanıcılar bu ayarı değiştirebilir.";
TranslatorAPIAllowed.pfm_title = "Translator API'ye izin ver";
TranslatorAPIAllowed.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Brave içinde Translator API'nin kullanımına izin verilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa Translator API'nin kullanımına izin verilmez.";
TryOnYouSettings.pfm_title = "Try on You ayarları.";
TryOnYouSettings.pfm_description = "0 - Try on You özelliğini model iyileştirme ile birlikte etkinleştir.\n1 - Try on You özelliğini model iyileştirme olmadan etkinleştir.\n2 - Try on You özelliğini devre dışı bırak.\nTry on You, kullanıcıların web'de buldukları kıyafet resimlerini sanal olarak denemelerine olanak tanıyan yapay zeka destekli bir özelliktir. Chrome'da Gemini etkinse Chrome'da Gemini'da faydalı alışveriş analizleri sağlar.\n\n0 = Özelliğin kullanılmasına izin verirken Google'ın yapay zeka modellerini iyileştirmek için ilgili verileri kullanmasına izin verir. İlgili veriler arasında özelliğe bağlı olarak resimler, girişler, çıkışlar, kaynak materyaller ve geri bildirimler yer alabilir. Bu bilgiler, gerçek kişiler tarafından da yapay zeka modellerini iyileştirmek için incelenebilir. Aşağıdaki değerler belirtilmediği sürece varsayılan değer 0'dır.\n\n1 = Özelliğin kullanılmasına izin verir ancak Google'ın kullanıcıların içeriklerini (resimler, girişler, çıkışlar, kaynak materyaller ve geri bildirimler dahil) kullanarak modelleri iyileştirmesine izin vermez. Google Admin console tarafından yönetilen kurumsal kullanıcılar ve Google Workspace tarafından yönetilen eğitim hesapları için varsayılan değer 1'dir.\n\n2 = Özelliğe izin vermez.\n\nNot: Model iyileştirmeleriyle ilgili kısıtlama (değer 1) yalnızca Try on You özelliği Chrome tarayıcı akışı üzerinden etkinleştirildiğinde geçerlidir. Özellik diğer akışlar üzerinden kullanıldığında geçerli değildir.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir. Üretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.\n\nTry on You özelliği tüm ülkelerde veya dillerde kullanılamaz. Bu politikanın ayarlanması, özelliğin etkinleştirileceğini garanti etmez. Özellik, kullanılabilirliğe bağlı olarak etkinleştirilir. Özelliğin kullanılabilirliğiyle ilgili daha fazla bilgi için Enterprise sürüm notlarını inceleyin: https://support.google.com/chrome/a/answer/7679408?hl=tr";
URLAllowlist.pfm_title = "URL listesine erişime izin ver";
URLAllowlist.pfm_description = "Politikanın ayarlanması URLBlocklist politikasına istisna olarak, listelenen URL'lere erişim sağlar. Bu listedeki girişlerin biçimi için söz konusu politikanın açıklamasına bakın. Örneğin, URLBlocklist politikasını * olarak ayarlamak tüm istekleri engeller. Bu durumda bu politikayı sınırlı bir URL listesine erişim izni vermek için kullanabilirsiniz. Bu ayarı, (https://support.google.com/chrome/a?p=url_blocklist_filter_format) adresinde belirtilen biçimi kullanarak belirli şemalar, diğer alan adlarının alt alan adları, bağlantı noktaları veya belirli yollara ilişkin istisnaları açmak için kullanın. Bir URL'nin engellenip engellenmediğini, en spesifik filtre belirler. URLAllowlist politikası, URLBlocklist politikasına göre daha önceliklidir. Bu politika 1.000 giriş ile sınırlıdır.\n\nBu politika ayrıca \"tel:\" veya \"ssh:\" gibi listelenmiş protokoller için protokol işleyici olarak kayıtlı harici uygulamanın tarayıcısı üzerinden otomatik çağrının etkinleştirilmesine izin verir.\n\nPolitika ayarlanmadan bırakılırsa URLBlocklist politikası için hiçbir istisnaya izin verilmez.\n\nBu politika, Brave 92 sürümünden itibaren gözetimsiz modda da desteklenir.";
URLBlocklist.pfm_title = "URL listesine erişimi engelle";
URLBlocklist.pfm_description = "URLBlocklist politikası ayarlanırsa yasaklı URL'leri olan web sayfalarının yüklenmesi durdurulur. Yöneticiler engellenecek URL kalıplarının listesini belirtebilir. Politika ayarlanmadan bırakılırsa tarayıcıda hiçbir URL engellenmez. URLAllowlist politikasında en çok 1.000 istisna tanımlanabilir. URL kalıbının nasıl biçimlendirileceğine göz atın (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nNot: Bu politika, dinamik olarak yüklenmiş verilere sahip sayfa içi JavaScript URL'leri için geçerli değildir. example.com/abc URL'sini engellediyseniz example.com bunu XMLHTTPRequest kullanarak yine yükleyebilir. Ayrıca bu politika, web sayfalarının, çok amaçlı adres çubuğunda gösterilen URL'yi JavaScript History API'yi kullanarak engellenen bir URL'ye güncellemesini de engellemez.\n\nBrave sürüm 73'ten itibaren javascript://* URL'lerini engelleyebilirsiniz. Ancak bu engelleme yalnızca adres çubuğuna girilen JavaScript'i veya örneğin yer işareti uygulamalarını etkiler.\n\nBu politika, Brave 92 sürümünden itibaren gözetimsiz modda da desteklenir.\n\nBrave sürüm 147'den itibaren tek başına kullanılan * joker karakteri, dahili chrome:// URL'leri için geçerli değildir. Bunları engellemek için chrome://* kalıbını açıkça kullanmanız gerekir.\n\nNot: Dahili chrome://* ile chrome-untrusted://* URL'lerinin engellenmesi beklenmeyen hatalara yol açabilir ve bazı durumlarda bunu yapmanız engellenebilir. Belirli dahili URL'leri engellemek yerine kullanabileceğiniz daha spesifik politikalar olup olmadığını kontrol edin. Örneğin:\n\n- chrome://settings/certificates URL'sini engellemek yerine CACertificateManagementAllowed politikasını kullanın.\n\n- chrome-untrusted://crosh URL'sini engellemek yerine SystemFeaturesDisableList politikasını kullanın.\n\n- devtools://* URL'sini engellemek yerine DeveloperToolsAvailability, DeveloperToolsAvailabilityAllowlist veya DeveloperToolsAvailabilityBlocklist politikalarından birini kullanın.";
UpdateOnZeroWindowEnabled.pfm_title = "Tüm tarayıcı pencereleri kapatıldığında arka planda otomatik olarak yeniden başlatmayı kontrol eder";
UpdateOnZeroWindowEnabled.pfm_description = "macOS'te bekleyen bir güvenlik güncellemesi olduğunda ve tüm tarayıcı pencereleri kapatıldığında arka planda otomatik yeniden başlatma davranışını kontrol eder.\n\nBu politika, Doğru değerine ayarlanır veya ayarlanmadan bırakılırsa tüm tarayıcı pencereleri kapatıldığında bekleyen güncellemeleri uygulamak için Brave otomatik olarak yeniden başlatılabilir.\n\nBu politika, Yanlış değerine ayarlanırsa tüm tarayıcı pencereleri kapatıldığında otomatik yeniden başlatma devre dışı bırakılır.";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "URL içeren veya URL'lerle ilişkili anonim veri toplamayı etkinleştir";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "Bu politika Etkin olarak ayarlandığında, aramaları ve gezinmeyi daha iyi hale getirmek için kullanıcının ziyaret ettiği sayfaların URL'lerini Google'a gönderen, \"URL içeren veya URL'lerle ilişkili anonim veri toplama\" özelliği her zaman etkin olur.\n\nPolitika, Devre Dışı değerine ayarlanırsa URL içeren veya URL'lerle ilişkili anonim veriler toplanmaz.\n\nBu politika ayarlanmadan bırakılırsa kullanıcı bu ayarı manuel olarak değiştirebilir.\n\nGoogle Chrome OS Kiosk'ta bu politika, \"Kullanıcının karar vermesine izin ver\" seçeneğini sunmaz. Bu politika Google Chrome OS Kiosk için ayarlanmazsa URL içeren veya URL'lerle ilişkili anonim veri toplama her zaman etkin olur.\nBu politika, Google Chrome OS Kiosk için ayarlandığında kiosk uygulamalarındaki URL içeren veya URL'lerle ilişkili metrik toplama özelliğini etkinleştirir.";
UserDataDir.pfm_title = "Kullanıcı veri dizinini ayarla";
UserDataDir.pfm_description = "Brave uygulamasının kullanıcı verilerini depolamak için kullanacağı dizini yapılandırır.\n\nBu politikayı ayarlarsanız Brave, kullanıcının \"--user-data-dir\" işaretini kullanıp kullanmamasına bakmaksızın sağlanan dizini kullanır. Veri kaybını veya diğer beklenmeyen hataları önlemek için bu politika, Brave dizinin içeriğini yönettiğinden başka amaçlar için kullanılan bir dizine ayarlanmamalıdır.\n\nKullanılabilir değişkenler listesi için https://support.google.com/chrome/a?p=Supported_directory_variables sayfasına bakın.\n\nBu politika ayarlanmadan bırakılırsa varsayılan profil yolu kullanılır. Kullanıcı, \"--user-data-dir\" komut satırı işaretiyle bu politikayı geçersiz kılabilir.";
UserDataSnapshotRetentionLimit.pfm_title = "Acil geri alma durumunda kullanılmak üzere saklanan kullanıcı verilerinin anlık görüntü sayısını sınırlar.";
UserDataSnapshotRetentionLimit.pfm_description = "Her büyük sürüm güncellemesinin ardından Chrome, daha sonra bir acil sürüm geri alma durumunda kullanılmak üzere kullanıcının tarama verilerinin belirli bölümlerinin anlık görüntüsünü oluşturur. Kullanıcının karşılık gelen anlık görüntüsüne sahip olduğu bir sürümde acil durum geri alma gerçekleştirilirse anlık görüntüdeki veriler geri yüklenir. Bu, kullanıcıların yer işaretleri ve otomatik doldurma verileri gibi ayarları saklamasına olanak tanır.\n\nBu politika ayarlanmazsa varsayılan değer olan 3 değeri kullanılır\n\nPolitika ayarlanırsa sınıra uymak için eski anlık görüntüler gerektiğinde silinir. Politika 0 değerine ayarlanırsa anlık görüntü alınmaz";
UserFeedbackAllowed.pfm_title = "Kullanıcı geri bildirimine izin ver";
UserFeedbackAllowed.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa kullanıcılar Menü > Yardım > Sorun Bildirin adımlarını veya tuş kombinasyonunu kullanarak Google'a geri bildirim gönderebilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa kullanıcılar Google'a geri bildirim gönderemez.";
VideoCaptureAllowed.pfm_title = "Video yakalamaya izin verme veya reddetme";
VideoCaptureAllowed.pfm_description = "Politika, Etkin değerine ayarlanırsa veya ayarlanmadan bırakılırsa kullanıcılardan video yakalama için erişim izni istenir (VideoCaptureAllowedUrls listesinde ayarlanan URL'ler hariç).\n\nPolitika, Devre dışı değerine ayarlanırsa istemler kapatılır ve video yakalama yalnızca VideoCaptureAllowedUrls listesinde ayarlanan URL'ler tarafından kullanılabilir.\n\nNot: Politika, tüm video girişlerini etkiler (yalnızca yerleşik kamerayı değil).";
VideoCaptureAllowedUrls.pfm_title = "Soru sorulmadan video yakalama cihazlarına erişim verilecek URL'ler";
VideoCaptureAllowedUrls.pfm_description = "Politikanın ayarlanması, kalıpları istek yapan URL'nin güvenlik kaynağıyla eşleşen URL listesini sizin belirttiğiniz anlamına gelir. Eşleşme olması halinde istemde bulunulmadan video yakalama cihazlarına erişim izni verilir\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz. Ancak her URL'ye uyan \"*\" kalıbının bu politika tarafından desteklenmediğini unutmayın.";
VoiceTypingSettings.pfm_title = "Konuşarak yazma ayarları";
VoiceTypingSettings.pfm_description = "0 - Konuşarak yazma özelliğine izin ver.\n1 - Konuşarak yazma özelliğinin veri toplamadan kullanılmasına izin ver.\n2 - \"Konuşarak yazma\" özelliğine izin verme.\nKonuşarak yazma, kullanıcıların seslerini kullanarak metin girmesine ve düzenlemesine olanak tanıyan yapay zeka tabanlı bir özelliktir. Yüksek kaliteli metne dönüştürme ve biçimlendirme için üretken yapay zeka modelleriyle desteklenir.\n\n0 = Özelliğin kullanılmasına izin verirken Google'ın yapay zeka modellerini iyileştirmek için ilgili verileri kullanmasına izin verir. İlgili veriler arasında özelliğe bağlı olarak istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler yer alabilir. Bu bilgiler, gerçek kişiler tarafından da yapay zeka modellerini iyileştirmek için incelenebilir. Aşağıdaki değerler belirtilmediği sürece varsayılan değer 0'dır.\n\n1 = Özelliğin kullanılmasına izin verir ancak Google'ın kullanıcıların içeriklerini (istemler, girişler, çıkışlar, kaynak materyaller ve yazılı geri bildirimler dahil) kullanarak modelleri iyileştirmesine izin vermez. Google Admin console tarafından yönetilen kurumsal kullanıcılar ve Google Workspace tarafından yönetilen eğitim hesapları için varsayılan değer 1'dir.\n\n2 = Özelliğe izin vermez.\n\nPolitika ayarlanmadan bırakılırsa davranışı GenAiDefaultSettings politikasına göre belirlenir.\n\nÜretken yapay zeka özelliklerinde verilerin nasıl işlendiği hakkında daha fazla bilgi için lütfen https://support.google.com/chrome/a?p=generative_ai_settings adresine göz atın.";
WPADQuickCheckEnabled.pfm_title = "WPAD optimizasyonunu etkinleştir";
WPADQuickCheckEnabled.pfm_description = "Politika, Etkin değerine ayarlanır veya ayarlanmadan bırakılırsa Brave ürününde WPAD (Otomatik Web Proxy Keşfi) optimizasyonu etkinleştirilir.\n\nPolitika, Devre Dışı değerine ayarlanırsa WPAD optimizasyonu devre dışı bırakılarak Brave ürününün DNS tabanlı WPAD sunucularını daha fazla beklemesine neden olur.\n\nBu politika ayarlansa da ayarlanmasa da kullanıcılar WPAD optimizasyonu ayarını değiştiremez.";
WarnBeforeQuittingEnabled.pfm_title = "Çıkmaya çalışan kullanıcılara uyarı iletişimi göster";
WarnBeforeQuittingEnabled.pfm_description = "Tarayıcıdan çıkmaya çalışan kullanıcılara gösterilen \"Çıkmadan Önce Uyar (⌘Q)\" iletişimini kontrol eder.\n\nPolitika Etkin olarak ayarlanır veya ayarlanmadan bırakılırsa, tarayıcıdan çıkmaya çalışan kullanıcılara uyarı iletişimi gösterilir.\n\nPolitika Devre Dışı değerine ayarlanırsa, tarayıcıdan çıkmaya çalışan kullanıcılara uyarı iletişimi gösterilmez.";
WebAppInstallByUserEnabled.pfm_title = "Kullanıcıların Tarayıcıdan Web Uygulaması Yüklemesine İzin Ver";
WebAppInstallByUserEnabled.pfm_description = "Bu politika, kullanıcıların tarayıcı üzerinden web uygulamaları yükleyip yükleyemeyeceğini kontrol eder.\nBu politikayı etkinleştirir veya yapılandırmazsanız kullanıcılar web uygulamalarını tarayıcı üzerinden yükleyebilir.\nBu politikayı devre dışı bırakırsanız kullanıcılar, web uygulamalarını tarayıcı üzerinden yükleyemez ve \"uygulamalar\" veri türü, Chrome Sync için senkronizasyonun dışında tutulur.\nBu politika, dinamik yenilemeyi desteklemez. Etkinleştirme, devre dışı bırakma veya ayarı geri alma gibi tüm değişiklikler yalnızca tarayıcı yeniden başlatıldıktan sonra geçerli olur.\nBu politika, \"WebAppInstallForceList\" politikasını etkilemez.";
WebAppInstallForceList.pfm_title = "Web Uygulamalarının URL'leri sessizce yüklenir.";
WebAppInstallForceList.pfm_description = "Politikayı ayarlamak, kullanıcı etkileşimi olmadan sessizce yüklenen, kullanıcıların kaldıramadığı veya kapatamadığı web uygulamalarının listesini belirtir.\n\nPolitikanın her liste öğesi, zorunlu üyeye sahip bir nesnedir:\nurl (yüklenecek web uygulamasının URL'si)\n\nve isteğe bağlı 6 üye:\n- default_launch_container\n(web uygulamasının açılma yöntemini belirlemek için, varsayılan ayar yeni sekmedir)\n\n- create_desktop_shortcut\n(Linux ve\nMicrosoft® Windows® masaüstü kısayolları oluşturulmak istenirse doğru değerine ayarlanmalıdır).\n\n- fallback_app_name\n(Brave sürüm 90'dan başlayarak, Progresif Web Uygulaması (PWA) değilse uygulama adını veya PWA ise ancak yüklemenin tamamlanabilmesi için kimlik doğrulama gerekiyorsa geçici olarak yüklenen uygulama adını geçersiz kılmanıza olanak tanır.) Hem custom_name hem de fallback_app_name sağlanmışsa ikincisi dikkate alınmaz.)\n\n- custom_name\n(Google Chrome OS sürüm 99\nve diğer tüm masaüstü işletim sistemlerinde bulunan sürüm 112'den itibaren tüm web uygulamaları\nve PWA'lar için uygulama adını kalıcı olarak geçersiz kılmanıza olanak tanır.)\n\n- custom_icon\n(Google Chrome OS sürüm 99\nve diğer tüm masaüstü işletim sistemlerinde bulunan sürüm 112'den itibaren yüklü uygulamaların\nuygulama simgesini geçersiz kılmanıza olanak tanır. Simgeler; kare şeklinde, maksimum 1 MB boyutunda ve jpeg, png, gif, webp, ico biçimlerinden birinde olmalıdır.\nKarma değeri, simge dosyasının SHA256 karma değeri olmalıdır.) Uygulama yüklendiğinde simgenin kullanılabilmesi için url, kimlik doğrulamadan erişilebilir olmalıdır.)\n\n- install_as_shortcut\n(Brave sürüm 107'den\nitibaren). Politika etkinleştirilirse belirtilen url, masaüstü tarayıcı GUI'sindeki \"Kısayol Oluştur...\" seçeneği kullanılmış gibi kısayol olarak yüklenir.\nKısayol olarak yüklenirse url içindeki manifest değiştiğinde\ngüncellenmeyeceğini unutmayın.\nPolitika devre dışı bırakılırsa veya ayarlanmazsa belirtilen\nurl içindeki web uygulaması normal şekilde yüklenir.\n\nUygulamaları Google Chrome OS rafına sabitlemek için PinnedLauncherApps politikasına bakın.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=WebAppInstallForceList adresine bakın.";
WebAppSettings.pfm_title = "Web Uygulaması yönetimi ayarları";
WebAppSettings.pfm_description = "Bu politika, yöneticinin yüklenen web uygulamaları için ayarları belirtmesine olanak tanır. Bu politika, web uygulaması kimliğini kendi özel ayarı ile eşleştirir. * özel kimliği kullanılarak varsayılan bir yapılandırma ayarlanabilir. Bu varsayılan yapılandırma, bu politikada özel bir yapılandırma ayarlanmamış tüm web uygulamaları için geçerli olur.\n\nmanifest_id alanı, web uygulamasının manifest kimliğidir. Yüklü bir web uygulamasının manifest kimliğini nasıl belirleyeceğinizle ilgili talimatlar için https://developer.chrome.com/blog/pwa-manifest-id/ adresine göz atın.\nrun_on_os_login alanı bir web uygulamasının OS girişi sırasında çalıştırılıp çalıştırılamayacağını belirtir. Bu alan, blocked değerine ayarlanırsa OS girişi sırasında web uygulaması çalıştırılmaz. Kullanıcı, bu ayarı daha sonra etkinleştiremez. Bu alan, run_windowed değerine ayarlanırsa OS girişi sırasında web uygulaması çalıştırılır. Kullanıcı, bu ayarı daha sonra devre dışı bırakamaz. Bu alan, allowed değerine ayarlanırsa kullanıcı, OS girişi sırasında web uygulamasını çalışacak şekilde yapılandırabilir. Varsayılan yapılandırma, yalnızca allowed ve blocked değerlerine izin verir.\n(Sürüm 117'den itibaren) prevent_close_after_run_on_os_login alanı, bir web uygulamasının herhangi bir şekilde (ör. kullanıcı, görev yöneticisi veya web API'leri tarafından) kapatılmasının engellenip engellenmeyeceğini belirtir. Bu çalışma biçimi yalnızca run_on_os_login, run_windowed olarak ayarlandıysa mümkündür. Uygulama zaten çalışıyorsa bu özellik ancak uygulama yeniden başlatıldıktan sonra etkinleşir. Bu alan tanımlanmazsa uygulamalar kullanıcılar tarafından kapatılabilir.\n(Sürüm 118'den itibaren) force_unregister_os_integration alanında, bir web uygulaması için tüm işletim sistemi entegrasyonlarının (ör. kısayollar, dosya işleyiciler, protokol işleyiciler vb.) kaldırılıp kaldırılmayacağı belirtilir. Bir uygulama halihazırda çalışıyorsa bu özellik, uygulama yeniden başlatıldıktan sonra etkinleşir. Bu özellik, web uygulamaları sistemi başlatılırken otomatik olarak ayarlanan tüm işletim sistemi entegrasyonlarını geçersiz kılabileceğinden dikkatli kullanılmalıdır. Şu anda yalnızca Windows, Mac ve Linux platformlarında kullanılabilir.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=WebAppSettings adresine bakın.";
WebAudioOutputBufferingEnabled.pfm_title = "Web Audio için uyarlanabilir arabelleğe almayı etkinleştir";
WebAudioOutputBufferingEnabled.pfm_description = "Bu politika, tarayıcının Web Audio için uyarlanabilir arabelleğe almayı kullanıp\nkullanmayacağını kontrol eder. Bu özellik, ses hatalarını azaltabilir ancak\ngecikmeyi değişken bir şekilde artırabilir.\n\nPolitika, Etkin değerine ayarlanırsa uyarlanabilir arabelleğe alma her zaman kullanılır.\n\nPolitika, Devre Dışı değerine ayarlanır veya ayarlanmadan bırakılırsa uyarlanabilir\narabelleğe alma özelliğinin kullanılıp kullanılmayacağına, özelliğin tarayıcıda kullanıma sunulma süreci karar verir.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "Uzaktan Masaüstü Uygulamalarından Proxy Kullanılarak Gönderilen WebAuthn İstekleri için İzin Verilen Kaynaklar.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "Uzak bir ana makinedeki tarayıcı oturumundan gönderilen WebAuthn API isteklerini yürütebilen\nuzaktan masaüstü istemci uygulamalarının kaynak listesi.\n\nBu politikada yapılandırılan tüm kaynaklar, normalde talep etmesine izin verilmeyen\nGüvenilen Taraf kimlikleri (RP kimlikleri) için WebAuthn istekleri gönderebilir.\n\nYalnızca geçerli HTTPS kaynaklarına izin verilir. Joker karakterler desteklenmez.\nGeçersiz girişler yoksayılır.\n\nBu politika yalnızca ilişkili kullanıcılar için geçerli olur.";
WebHidAllowAllDevicesForUrls.pfm_title = "Sitelere, HID cihazlarına otomatik olarak bağlanma izni ver.";
WebHidAllowAllDevicesForUrls.pfm_description = "Politikanın ayarlanması, kullanılabilen tüm cihazlara otomatik olarak erişme izni verilen sitelerin listesini yapmanıza olanak tanır.\n\nURL'ler geçerli olmalıdır; aksi halde, politika yok sayılır. Yalnızca URL'nin kaynağı (şema, ana makine ve bağlantı noktası) dikkate alınır.\n\nChromeOS'te bu politika, yalnızca ilişkili kullanıcılar için geçerli olur.\n\nBu politika DefaultWebHidGuardSetting, WebHidAskForUrls, WebHidBlockedForUrls ve kullanıcının tercihlerini geçersiz kılar.";
WebHidAllowDevicesForUrls.pfm_title = "Bu sitelere, sağlanan tedarikçi ve ürün kimlikleriyle otomatik olarak HID cihazlarına bağlanma izni verir.";
WebHidAllowDevicesForUrls.pfm_description = "Politikayı ayarlamak, tedarikçi ve ürün kimlikleri olan HID cihazına otomatik olarak erişme izni verilen siteleri belirten URL'lerin listesini yapmanıza olanak tanır. Öğenin geçerli olabilmesi için listedeki her öğe hem devices hem de urls alanlarını gerektirir. Aksi takdirde öğe yoksayılır. devices alanındaki her öğe, vendor_id alanını içermelidir ve product_id alanını da içerebilir. product_id alanının atlanması, belirtilen satıcı kimliğiyle her cihazla eşleşen bir politika oluşturur. product_id alanı olup vendor_id alanı olmayan öğe geçersizdir ve yoksayılır.\n\nPolitika ayarlanmadan bırakılırsa DefaultWebHidGuardSetting (ayarlanmışsa) geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nBu politikadaki URL'ler, WebHidBlockedForUrls aracılığıyla yapılandırılan URL'lerle çakışmamalıdır. Çakışırsa bu politika, WebHidBlockedForUrls ve  politikalarına göre daha önceliklidir.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls adresine bakın.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "Bu sitelere, belirli HID kullanımına sahip üst düzey koleksiyonlar içeren HID cihazlarına otomatik olarak bağlanma izni ver.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "Politikayı ayarlamak, belirli HID kullanımına sahip üst düzey bir koleksiyon içeren HID cihazına otomatik olarak erişme izni verilen siteleri belirten URL'lerin listesini yapmanıza olanak tanır. Politikanın geçerli olabilmesi için listedeki her öğe hem usages hem de urls alanlarını gerektirir. usages alanındaki her öğe, usage_page alanını içermelidir ve usage alanını da içerebilir. usage alanının atlanması, belirtilen kullanım sayfasındaki kullanımlardan birine sahip üst düzey bir koleksiyon içeren her cihazla eşleşen bir politika oluşturur. usage alanı olup usage_page alanı olmayan öğe geçersizdir ve yoksayılır.\n\nPolitika ayarlanmadan bırakılırsa DefaultWebHidGuardSetting (ayarlanmışsa) geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nBu politikadaki URL'ler, WebHidBlockedForUrls aracılığıyla yapılandırılan URL'lerle çakışmamalıdır. Çakışırsa bu politika, WebHidBlockedForUrls ve  politikalarına göre daha önceliklidir.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls adresine bakın.";
WebHidAskForUrls.pfm_title = "Bu sitelerde WebHID API'ye izin ver";
WebHidAskForUrls.pfm_description = "Politikayı ayarlamak, kullanıcılardan HID cihazlarına erişim izni vermelerini isteyebilecek siteleri belirlemenize olanak sağlar. Bu şekilde, belirli URL kalıplarının yer aldığı bir liste hazırlayabilirsiniz.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultWebHidGuardSetting bütün siteler için geçerli olur. Etkin değilse kullanıcının ayarları geçerlidir.\n\nPolitikayla eşleşmeyen URL kalıpları için öncelikli olacak seçenek aşağıdaki sırayla belirlenir:\n\n  * WebHidBlockedForUrls (eşleşme varsa),\n\n  * DefaultWebHidGuardSetting (etkinse) veya\n\n  * Kullanıcıların kişisel ayarları.\n\nURL kalıpları, WebHidBlockedForUrls ile çakışmamalıdır. Bir URL her ikisiyle de eşleşirse politikaların ikisinin de diğeri üzerinde önceliği olmaz.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
WebHidBlockedForUrls.pfm_title = "Bu sitelerde WebHID API'yi engelle";
WebHidBlockedForUrls.pfm_description = "Politikayı ayarlamak, kullanıcıların sistemindeki HIB cihazlarına erişim izni isteyemeyecek siteleri belirlemenize olanak sağlar. Bu şekilde, belirli URL kalıplarının yer aldığı bir liste hazırlayabilirsiniz.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultWebHidGuardSetting bütün siteler için geçerli olur. Etkin değilse kullanıcının ayarları geçerlidir.\n\nPolitikayla eşleşmeyen URL kalıpları için öncelikli olacak seçenek aşağıdaki sırayla belirlenir:\n\n  * WebHidAskForUrls (eşleşme varsa),\n\n  * DefaultWebHidGuardSetting (etkinse) veya\n\n  * Kullanıcıların kişisel ayarları.\n\nURL kalıpları WebHidAskForUrls ile çakışamaz. Bir URL her ikisiyle de eşleşirse politikaların ikisinin de diğeri üzerinde önceliği olmaz.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "Belirli kaynaklar için WebRTC teşhis günlüklerinin toplanmasını etkinleştir";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "Bu politika, belirli kaynaklar için WebRTC teşhis günlüklerinin toplanmasına imkan tanır.\n\nGeçerli giriş kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir. Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yok sayılır. Şema ve alt alan adları desteklenir.\n\nPolitika ayarlanırsa listedeki kalıplarla eşleşen kaynaklar için teşhis günlüklerinin toplanması etkinleştirilir.\n\nPolitika ayarlanmazsa teşhis günlüklerinin toplanması varsayılan olarak devre dışı bırakılır.";
WebRtcEventLogCollectionAllowed.pfm_title = "Google hizmetlerinden WebRTC olay günlüklerinin toplanmasına izin ver";
WebRtcEventLogCollectionAllowed.pfm_description = "Politika, Etkin değerine ayarlanırsa Brave ürünü, Hangouts Meet gibi Google hizmetlerinden WebRTC olay günlüklerini toplayıp bu günlükleri Google'a yükleyebilir. Bu günlükler, Brave ürünündeki sesli veya görüntülü toplantılarla ilgili sorunlarda hata ayıklamada kullanılacak teşhis bilgileri içerir. Bunlar, RTP paketlerinin saati ve boyutu, ağdaki tıkanmayla ilgili geri bildirim, ses ve video karelerinin zamanı ve kalitesiyle ilgili meta veriler gibi bilgilerdir. Bu günlükler toplantıya ait ses veya video içeriği barındırmaz. Hata ayıklamayı kolaylaştırmak için Google bu günlükleri bir oturum kimliği aracılığıyla Google hizmetinin kendisi tarafından toplanan diğer günlüklerle ilişkilendirebilir.\n\nPolitika, Yanlış değerine ayarlanırsa bu tür günlükler toplanıp yüklenmez.\n\nBu politika ayarlanmadan bırakılırsa M76 ve önceki sürümlerde Brave varsayılan olarak bu günlükleri toplayıp yükleyemez. M77'den itibaren Brave varsayılan olarak, bu günlükleri bulut tabanlı kullanıcı düzeyi kurumsal politikalardan etkilenen profillerin çoğundan toplayıp yükleyebilir. M77'den M80'e (dahil) kadar, Brave bu günlükleri varsayılan olarak Brave şirket içi yönetiminden etkilenen profillerden toplayıp yükleyebilir.";
WebRtcIPHandling.pfm_title = "WebRTC IP işleme";
WebRtcIPHandling.pfm_description = "default - WebRTC, en iyi yolu ararken mevcut tüm arayüzleri kullanır.\ndefault_public_and_private_interfaces - WebRTC, yalnızca herkese açık internete bağlanırken arayüzü kullanır, ancak özel IP adresleri kullanarak bağlanabilir.\ndefault_public_interface_only - WebRTC, yalnızca herkese açık internete bağlanırken arayüzü kullanıp özel IP adresleri kullanarak bağlanmaz.\ndisable_non_proxied_udp - WebRTC, herkese açık arayüzde TCP'yi kullanıp UDP'yi, yalnızca yapılandırılan proxy tarafından destekleniyorsa kullanır.\nBu politika, mevcut en iyi bağlantıyı ararken WebRTC'nin kullandığı hem IP adreslerinin hem de arayüzlerin kısıtlanmasına olanak tanır.\n\nGeçerli değerler:\n\n* default: WebRTC, mevcut tüm ağ arayüzlerini kullanır.\n\n* default_public_and_private_interfaces: WebRTC, tüm herkese açık ve gizli arayüzleri kullanır.\n\n* default_public_interface_only: WebRTC, tüm herkese açık arayüzleri kullanır ancak gizli arayüzleri kullanmaz.\n\n* disable_non_proxied_udp: WebRTC, UDP SOCKS proxy uygulama işlevini kullanır veya TCP proxy uygulama işlevine döner.\n\nBu politika ayarlanmadan bırakıldığında varsayılan olarak mevcut tüm ağ arayüzleri kullanılır.\n\nTüm işleme değerlerinin ayrıntılı açıklaması için RFC 8828 belgesinin 5.2 numaralı bölümüne bakın (https://tools.ietf.org/html/rfc8828.html#section-5.2).";
WebRtcIPHandlingUrl.pfm_title = "URL Bazında WebRTC IP İşleme";
WebRtcIPHandlingUrl.pfm_description = "Bu politika, her bir belirli URL kalıbı için mevcut en iyi bağlantıyı ararken WebRTC'nin kullandığı IP adreslerinin ve arayüzlerin kısıtlanmasına olanak tanır.\n\nURL kalıpları ve işleme türü çiftlerinden oluşan bir listeyi kabul eder. URL kalıpları sırayla kontrol edilir ve ilk eşleşme, WebRTC tarafından alan adı için kullanılan işleme türünü yapılandırır. Mevcut belgenin URL'si hiçbir girişle eşleşmezse WebRtcIPHandling politikasıyla belirlenen yapılandırma kullanılır.\n\nGeçerli giriş kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz. Joker karakterlere (*) izin verilir. Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yok sayılır.\n\nGeçerli işleme değerleri:\n\n* default: WebRTC tüm ağ arayüzlerini kullanır.\n\n* default_public_and_private_interfaces: WebRTC, tüm herkese açık ve gizli arayüzleri kullanır.\n\n* default_public_interface_only: WebRTC, tüm herkese açık arayüzleri kullanır ancak gizli arayüzleri kullanmaz.\n\n* disable_non_proxied_udp: WebRTC, UDP SOCKS proxy uygulama işlevini kullanır veya TCP proxy uygulama işlevine döner.\n\nTüm işleme değerlerinin ayrıntılı açıklaması için RFC 8828 belgesinin 5.2 numaralı bölümüne bakın (https://tools.ietf.org/html/rfc8828.html#section-5.2).\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl adresine bakın.";
WebRtcLocalIpsAllowedUrls.pfm_title = "WebRTC ICE adaylarında sunulan yerel IP'ler için URL'ler";
WebRtcLocalIpsAllowedUrls.pfm_description = "Bu listedeki kalıplar, istek yapan URL'nin güvenlik kaynağı ile karşılaştırılır.\nBir eşleşme bulunursa veya chrome://flags/#enable-webrtc-hide-local-ips-with-mdns Devre dışı bırakıldıysa yerel IP adresleri WebRTC ICE adaylarında gösterilir.\nAksi takdirde, yerel IP adresleri mDNS ana makine adlarıyla gizlenir.\nBu politikanın, yöneticilerin ihtiyaç duyması halinde yerel IP'lerin korunmasını zayıflattığını lütfen unutmayın.";
WebRtcPostQuantumKeyAgreement.pfm_title = "Kuantum sonrası anahtar anlaşmasını WebRTC için etkinleştir";
WebRtcPostQuantumKeyAgreement.pfm_description = "Bu politika, WebRTC için kuantum sonrası anahtar anlaşmasını kontrol etmeye olanak tanır.\n\nBu politika, Etkin değerine ayarlanırsa WebRTC için kuantum sonrası anahtar anlaşması\nsunulur.\n\nBu politika, Devre Dışı değerine ayarlanırsa WebRTC için kuantum sonrası anahtar anlaşması\nsunulmaz.\n\nBu politika ayarlanmazsa değer, WebRTC için sunulan kuantum sonrası anahtar anlaşmasıyla\nilgili varsayılan kullanıma sunma süreci tarafından ayarlanır.\n\nKuantum sonrası anahtar anlaşması sunmak, geriye dönük uyumludur. Mevcut DTLS\neşlerinin ve ağ kurulumu ara katman yazılımlarının yeni seçeneği yoksayıp önceki seçenekleri\nbelirlemeye devam etmesi beklenir.\n\nAncak, DTLS doğru uygulamayan cihazlar yeni seçenek sunulduğunda düzgün çalışmayabilir. Örneğin, tanınmayan seçenekler\nveya ortaya çıkan daha büyük mesajlar nedeniyle bağlantıları kesilebilir. Bu tür cihazlar,\nkuantum sonrası kullanıma hazır değildir ve kuruluşun kuantum sonrası geçişini etkileyebilir. Bu sorunla karşılaşan yöneticiler, düzeltilmesi için satıcıyla iletişime geçmelidir.\n\nBu politika geçici bir çözüm olup birkaç aşamadan sonra kaldırılacaktır.";
WebRtcTextLogCollectionAllowed.pfm_title = "Google hizmetlerinden WebRTC metin günlüklerinin toplanmasına izin ver";
WebRtcTextLogCollectionAllowed.pfm_description = "Politika, Etkin değerine ayarlanırsa Brave ürünü, Google Meet gibi Google hizmetlerinden WebRTC olay günlüklerini toplayıp bu günlükleri Google'a yükleyebilir. Bu günlükler, Brave ürünündeki sesli veya görüntülü toplantılarla ilgili sorunlarda hata ayıklamada kullanılacak teşhis bilgileri içerir. Bunlar, gelen ve giden WebRTC akışlarını açıklayan metin meta verileri, WebRTC'ye özgü günlük girişleri ve ek sistem bilgileri olabilir. Bu günlükler toplantıya ait ses veya video içeriği barındırmaz.\nPolitika, Devre Dışı değerine ayarlanırsa bu tür günlükler Google'a yüklenmez. Günlükler, kullanıcının cihazında yerel olarak birikmeye devam eder.\nPolitika ayarlanmadan bırakılırsa Brave varsayılan olarak bu günlükleri toplayıp yükleyebilir.";
WebRtcUdpPortRange.pfm_title = "WebRTC tarafından kullanılan yerel UDP bağlantı noktaları aralığını kısıtlama";
WebRtcUdpPortRange.pfm_description = "Politika ayarlanırsa, WebRTC tarafından kullanılan UDP bağlantı noktası aralığı, belirtilen bağlantı noktası aralığı (başlangıç ve bitiş noktaları dahil) kullanılacak şekilde kısıtlanır.\n\nPolitika ayarlanmazsa veya boş dize değerine ya da geçersiz bir bağlantı noktası aralığına ayarlanırsa, WebRTC'nin kullanılabilir herhangi bir yerel UDP bağlantı noktasını kullanmasına izin verilir.";
WebUsbAllowDevicesForUrls.pfm_title = "Bu sitelere, sağlanan tedarikçi ve ürün kimlikleriyle otomatik olarak USB cihazlarına bağlanma izni verir.";
WebUsbAllowDevicesForUrls.pfm_description = "Politikayı ayarlamak, tedarikçi ve ürün kimlikleri olan USB cihazına otomatik olarak erişme izni verilen siteleri belirten URL kalıplarının listesini oluşturmanıza olanak tanır. Politikanın geçerli olabilmesi için listedeki her öğede hem devices hem de urls alanlarının doldurulması zorunludur. devices alanındaki her öğe, vendor_id ve product_id alanı içerebilir. vendor_id alanı atlandığında, her cihazla eşleşen bir politika oluşturulur. product_id alanı atlandığında, belirtilen satıcı kimliğine sahip her cihazla eşleşen bir politika oluşturulur. product_id alanı olup vendor_id alanı olmayan politika geçersizdir.\n\nUSB izin modeli, belirtilen URL'nin USB cihazına üst seviye kaynak olarak erişmesine izin verir. Yerleşik çerçevelerin USB cihazlarına erişmesi gerekiyorsa erişim izni vermek için \"usb\" feature-policy üstbilgisi kullanılmalıdır. URL geçerli olmazsa politika yoksayılır.\n\nKullanımdan kaldırıldı: Hem istekte bulunan URL'nin hem de yerleştirme URL'sinin belirtilmesini desteklemek için kullanılan USB izin modeli. Bu izin modeli, kullanımdan kaldırılmıştır ve yalnızca geriye dönük uyumluluk için şu şekilde desteklenir: Hem istekte bulunan URL hem de yerleştirme URL'si belirtilirse yerleştirme URL'sine üst seviye kaynak olarak izin verilir, istekte bulunan URL ise tamamen yoksayılır.\n\nBu politika DefaultWebUsbGuardSetting, WebUsbAskForUrls, WebUsbBlockedForUrls politikalarını ve kullanıcının tercihlerini geçersiz kılar.\n\nBu politika, yalnızca WebUSB API üzerinden USB cihazlarına erişimi etkiler. Web Serial API üzerinden USB cihazlarına erişim izni vermek için SerialAllowUsbDevicesForUrls politikasını inceleyin.\nŞema ve biçimlendirme hakkında daha fazla bilgi için https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls adresine bakın.";
WebUsbAskForUrls.pfm_title = "Bu sitelerde WebUSB'ye izin ver";
WebUsbAskForUrls.pfm_description = "Politikayı ayarlamak, kullanıcılardan bir USB cihazına erişme izni vermelerini isteyebilen siteleri belirten URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultWebUsbGuardSetting bütün siteler için geçerli olur. Etkin değilse kullanıcının ayarları geçerlidir.\n\nURL kalıpları, WebUsbAskForUrls ile çakışmamalıdır. Bir URL her ikisiyle de eşleşirse politikaların ikisinin de diğeri üzerinde önceliği olmaz.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
WebUsbBlockedForUrls.pfm_title = "Bu sitelerde WebUSB'yi engelle";
WebUsbBlockedForUrls.pfm_description = "Politikayı ayarlamak, kullanıcıların sistemindeki bir USB cihazına erişme izni isteyemeyecek siteleri belirten bir URL kalıpları listesi yapmanıza olanak tanır.\n\nPolitika etkinleştirilir ve ayarlanmadan bırakılırsa DefaultWebUsbGuardSetting bütün siteler için geçerli olur. Aksi takdirde kullanıcının kişisel ayarları geçerlidir.\n\nURL kalıpları, WebUsbAskForUrls ile çakışamaz. Bir URL her ikisiyle de eşleşirse politikaların ikisinin de diğeri üzerinde önceliği olmaz.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. *, bu politikada kabul edilen bir değer değildir.";
WindowCaptureAllowedByOrigins.pfm_title = "Bu kaynakların Pencere ve Sekme yakalamasına izin ver";
WindowCaptureAllowedByOrigins.pfm_description = "Politikayı ayarlamak, Pencere ve Sekme Yakalama işlevini kullanabilen URL kalıpları için bir liste yapmanıza olanak tanır.\n\nPolitika ayarlanmadan bırakılırsa siteler bu Yakalama seviyesindeki geçersiz kılma için dikkate alınmaz.\n\nBir site, şu politikalardan herhangi birindeki URL kalıbıyla eşleşirse şu polikaların hiçbiri dikkate alınmaz: TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nBir site bu politikadaki URL kalıbıyla eşleşirse şu politikalar dikkate alınmaz: ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nGeçerli url kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns/ adresine bakabilirsiniz.  Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yok sayılır.";
WindowManagementAllowedForUrls.pfm_title = "Bu sitelere pencere yönetimi izni ver";
WindowManagementAllowedForUrls.pfm_description = "Pencere yönetimi izninin otomatik olarak verileceği siteleri belirten site URL kalıplarından oluşan bir liste oluşturmanıza imkan verir. Bu durumda sitelerin, cihazların ekranlarıyla ilgili bilgileri görme ve pencere açıp yerleştirmek ya da belirli ekranlarda tam ekran isteği iletmek için bu bilgileri kullanma imkanı artmış olur.\n\nGeçerli site URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir. Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yoksayılır.\n\nBu politikanın ayarlanmadığı siteler için, ayarlanmışsa DefaultWindowManagementSetting politikası geçerli olur. Aksi takdirde ilgili izin, tarayıcının varsayılan ayarına uyarak kullanıcıların site bazında bu izni belirlemesine imkan verir.\n\nBu politika, kullanımdan kaldırılan WindowPlacementAllowedForUrls politikasının yerini almıştır.";
WindowManagementBlockedForUrls.pfm_title = "Bu sitelerde pencere yönetimi iznini engelle";
WindowManagementBlockedForUrls.pfm_description = "Pencere yönetimi izninin otomatik olarak reddedileceği siteleri belirten site URL kalıplarından oluşan bir liste oluşturmanıza imkan verir. Bu durumda sitelerin, cihazların ekranlarıyla ilgili bilgileri görme ve pencere açıp yerleştirmek ya da belirli ekranlarda tam ekran isteği iletmek için bu bilgileri kullanma imkanı kısıtlanmış olur.\n\nGeçerli site URL kalıpları hakkında ayrıntılı bilgi için https://chromeenterprise.google/policies/url-patterns adresine bakabilirsiniz. Joker karakterlere (*) izin verilir. Bu politika, yalnızca kaynağa göre eşleşir. Dolayısıyla, URL kalıbındaki yollar yoksayılır.\n\nBu politikanın ayarlanmadığı siteler için, ayarlanmışsa DefaultWindowManagementSetting politikası geçerli olur. Aksi takdirde ilgili izin, tarayıcının varsayılan ayarına uyarak kullanıcıların site bazında bu izni belirlemesine imkan verir.\n\nBu politika, kullanımdan kaldırılan WindowPlacementBlockedForUrls politikasının yerini almıştır.";
XSLTEnabled.pfm_title = "XSLT özelliğinin kullanılabilirliğini kontrol et";
XSLTEnabled.pfm_description = "Bu politika, XSLT özelliğinin (XSLTProcessor JavaScript API ve XSL işleme talimatı) kullanılabilirliğini kontrol eder.\nBu politika, Etkin değerine ayarlanırsa özelliğin tarayıcıdaki varsayılan durumundan bağımsız olarak XSLT kullanılabilir.\nBu politika, Devre Dışı değerine ayarlanırsa özelliğin tarayıcıdaki varsayılan durumundan bağımsız olarak XSLT kullanılamaz.\nBu politika ayarlanmadan bırakılırsa XSLT'nin kullanılabilirliği, tarayıcının varsayılan ayarlarına ve saha denemelerine göre belirlenir.\nBu politika geçici bir çözüm olup M176 sürümünde kaldırılacaktır.";