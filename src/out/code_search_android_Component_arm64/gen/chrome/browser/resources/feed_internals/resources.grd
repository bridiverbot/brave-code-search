<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/feed_internals_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/feed_internals_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/feed_internals_resources_map.h"
            type="resource_map_header" />
    <output filename="feed_internals_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_FEED_INTERNALS_FEED_INTERNALS_CSS" file="${root_gen_dir}/chrome/browser/resources/feed_internals/preprocessed/feed_internals.css" resource_path="feed_internals.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_FEED_INTERNALS_FEED_INTERNALS_HTML" file="${root_gen_dir}/chrome/browser/resources/feed_internals/preprocessed/feed_internals.html" resource_path="feed_internals.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_FEED_INTERNALS_FEED_INTERNALS_JS" file="${root_gen_dir}/chrome/browser/resources/feed_internals/minified/feed_internals.js" resource_path="feed_internals.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_FEED_INTERNALS_FEED_INTERNALS_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/feed_internals/minified/feed_internals.mojom-webui.js" resource_path="feed_internals.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
