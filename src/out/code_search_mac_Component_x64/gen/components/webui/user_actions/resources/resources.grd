<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/user_actions_ui_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/user_actions_ui_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/user_actions_ui_resources_map.h"
            type="resource_map_header" />
    <output filename="user_actions_ui_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_USER_ACTIONS_UI_USER_ACTIONS_CSS" file="${root_gen_dir}/components/webui/user_actions/resources/preprocessed/user_actions.css" resource_path="user_actions.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_USER_ACTIONS_UI_USER_ACTIONS_HTML" file="${root_gen_dir}/components/webui/user_actions/resources/preprocessed/user_actions.html" resource_path="user_actions.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_USER_ACTIONS_UI_USER_ACTIONS_JS" file="${root_gen_dir}/components/webui/user_actions/resources/minified/user_actions.js" resource_path="user_actions.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
