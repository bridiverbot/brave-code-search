/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Preferências do Brave";
AIModeSettings.pfm_title = "Configurações das integrações do Modo IA do Google na barra de endereço e na caixa de pesquisa da página \"Nova guia\".";
AIModeSettings.pfm_description = "0 - Permitir integrações do Modo IA.\n1 - Não permitir integrações do Modo IA.\nEsta política controla as integrações do Modo IA do Google na barra de endereço e na caixa de pesquisa da página \"Nova guia\".\n\nPara acessar esse recurso, o Google precisa ser definido como o mecanismo de pesquisa padrão do usuário.\n\n0 = o recurso ficará disponível para os usuários.\n\n1 = o recurso não ficará disponível para os usuários.\n\nSe não for definida, o comportamento será determinado pela política GenAiDefaultSettings.";
AbusiveExperienceInterventionEnforce.pfm_title = "Aplicação de intervenção de experiência ofensiva";
AbusiveExperienceInterventionEnforce.pfm_description = "Se SafeBrowsingEnabled não estiver definida como \"Desativada\", definir AbusiveExperienceInterventionEnforce como \"Ativada\" ou deixá-la sem definição impedirá sites com experiências ofensivas de serem abertos em novas janelas ou guias.\n\nSe SafeBrowsingEnabled ou AbusiveExperienceInterventionEnforce forem definidas como \"Desativadas\", sites com experiências ofensivas poderão ser abertos em novas janelas ou guias.";
AccessCodeCastDeviceDuration.pfm_title = "Especificar por quanto tempo (em segundos) um dispositivo de transmissão selecionado com um código de acesso ou QR permanece na lista aparelhos desse tipo no menu do Google Cast.";
AccessCodeCastDeviceDuration.pfm_description = "Esta política especifica por quanto tempo (em segundos) um dispositivo de transmissão que foi selecionado anteriormente por um código de acesso ou QR pode ser exibido no menu de aparelhos desse tipo no Google Cast.\nO ciclo de vida de uma entrada começa na primeira vez que o código de acesso é inserido ou quando o QR code é lido pela primeira vez.\nDurante esse período, o dispositivo de transmissão será exibido na lista do menu do Google Cast.\nApós esse período, para usar o dispositivo de transmissão novamente, será necessário inserir o código de acesso ou ler o QR code de novo.\nPor padrão, o período é de zero segundo, ou seja, os dispositivos de transmissão não serão exibidos no menu do Google Cast. Portanto, será necessário inserir o código de acesso ou ler o QR code novamente para iniciar uma nova sessão de transmissão.\nObserve que esta política afeta apenas por quanto tempo um dispositivo de transmissão é exibido no menu do Google Cast e não tem efeito nas sessões de transmissão em andamento que continuarão mesmo se o período expirar.\nEsta política não tem efeito a menos que a política AccessCodeCastEnabled esteja ativada.";
AccessCodeCastEnabled.pfm_title = "Permitir que os usuários selecionem dispositivos de transmissão com um código de acesso ou QR no menu do Google Cast.";
AccessCodeCastEnabled.pfm_description = "Esta política controla se haverá uma opção disponível ao usuário no menu do Google Cast, que permita a transmissão em dispositivos que não são exibidos no menu do Google Cast, usando o código de acesso ou QR exibido na tela desses aparelhos.\nPor padrão, um usuário precisa inserir o código de acesso ou fazer a leitura do QR code novamente para iniciar a próxima sessão de transmissão, mas se a política AccessCodeCastDeviceDuration for definida com um valor diferente de zero (que é o padrão), o dispositivo de transmissão permanecerá na lista de aparelhos disponíveis até que o período especificado tenha expirado.\nQuando esta política for definida como \"Ativada\", os usuários terão a opção de selecionar dispositivos de transmissão usando um código de acesso ou QR.\nSe esta política for definida como \"Desativada\" ou deixada sem definição, os usuários não terão essa opção.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "Fazer com que Access-Control-Allow-Methods corresponda à especificação de simulação do CORS em conformidade";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Esta política controla se os métodos de solicitação têm letras maiúsculas ao fazer a correspondência com os cabeçalhos de resposta Access-Control-Allow-Methods na simulação do CORS.\n\nSe a política for desativada, os métodos de solicitação vão usar letras maiúsculas.\nEsse é o comportamento até a versão 108 do Brave.\n\nSe a política for ativada ou deixada sem definição, os métodos de solicitação não vão usar letras maiúsculas, a menos que haja correspondência com DELETE, GET, HEAD, OPTIONS, POST ou PUT sem diferenciar maiúsculas de minúsculas.\nIsso rejeitaria o cabeçalho de resposta fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\"\ne aceitaria o fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\".\n\nObservação: os métodos de solicitação \"post\" e \"put\" não são afetados, enquanto o \"patch\" é.\n\nEssa política é temporária e vai ser removida.";
AccessibilityImageLabelsEnabled.pfm_title = "Ativar \"Get Image Descriptions from Google\".";
AccessibilityImageLabelsEnabled.pfm_description = "O recurso de acessibilidade \"Get Image Descriptions from Google\" permite que pessoas com deficiência visual que usam leitores de tela recebam descrições de imagens sem etiqueta na Web. Os usuários que decidirem ativá-lo\npoderão usar um serviço anônimo do Google para fornecer\ndescrições automáticas para imagens sem etiqueta que encontrarem na Web.\n\nSe esse recurso for ativado, conteúdo de imagens será enviado aos servidores do\nGoogle para gerar uma descrição. Nenhum cookie ou dado do\nusuário será enviado, e o Google não salvará nem registrará nenhum conteúdo de imagens.\n\nSe a política for definida como \"Ativada\", o recurso\nGet Image Descriptions from Google\nserá ativado, mas só afetará pessoas que usarem um\nleitor de tela ou outra tecnologia adaptativa semelhante.\n\nSe ela for definida como \"Desativada\", os usuários não poderão ativar\nesse recurso.\n\nSe ela não for definida, os usuários poderão escolher ativar o recurso ou não.\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "Permitir consultas DNS em mais tipos de registro DNS";
AdditionalDnsQueryTypesEnabled.pfm_description = "Esta política controla se o Brave pode consultar mais tipos de registro DNS ao fazer solicitações de DNS não seguras. Ela não afeta consultas DNS realizadas por DNS seguro, que sempre pode consultar mais tipos de DNS.\n\nSe a política for ativada ou deixada sem definição, tipos como HTTPS (tipo 65 de DNS) poderão ser consultados com A (tipo 1 de DNS) e AAAA (tipo 28 de DNS).\n\nSe a política for desativada, o DNS será consultado apenas nos tipos A (tipo 1 de DNS) e/ou AAAA (tipo 28 de DNS).\n\nEla é uma medida temporária e será removida em versões futuras do Brave. Após a remoção da política, o Brave sempre poderá consultar outros tipos de DNS.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Configurações de anúncios para sites com anúncios invasivos";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Permitir anúncios em todos os sites\n2 - Não permitir anúncios em sites com anúncios invasivos\nA não ser que SafeBrowsingEnabled esteja definida como falsa, definir a política AdsSettingForIntrusiveAdsSites como 1 ou deixá-la sem definição permitirá anúncios em todos os sites.\n\nSe a política for definida como 2, os anúncios serão bloqueados em sites com anúncios invasivos.";
AdvancedProtectionAllowed.pfm_title = "Ativar mais proteções para usuários inscritos no Programa Proteção Avançada";
AdvancedProtectionAllowed.pfm_description = "Esta política controla se os usuários inscritos no Programa Proteção Avançada recebem segurança extra. Alguns desses recursos podem envolver o compartilhamento de dados com o Google. Por exemplo, usuários do Proteção Avançada poderão enviar os downloads ao Google para verificação de malware. Se a política for definida como \"verdadeira\" ou não for configurada, os usuários inscritos receberão proteções extras. Se for definida como \"falsa\", os usuários do Proteção Avançada receberão apenas os recursos padrão do consumidor.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Lista de origens que autorizam todas as autenticações HTTP";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "A definição desta política especifica quais origens têm permissão para todos os esquemas de autenticação HTTP compatíveis com Brave, independentemente da política AuthSchemes.\n\nA partir da versão 161 do Brave, esta política se aplica apenas às origens do servidor de destino e não aos desafios de autenticação do servidor proxy. Para permitir todos os esquemas de autenticação HTTP para servidores proxy, use a política AllHttpAuthSchemesAllowedForProxies. Antes da versão 161, os servidores proxy que correspondem a esta política também podem usar todos os esquemas de autenticação HTTP, a menos que AllHttpAuthSchemesAllowedForProxies esteja definido.\n\nFormate o padrão da origem conforme o formato apresentado em https://support.google.com/chrome/a?p=url_blocklist_filter_format. Até 1.000 exceções podem ser definidas na política AllHttpAuthSchemesAllowedForOrigins.\nÉ possível usar caracteres curingas para o componente de host (por exemplo, \"*:8000\" corresponde a todos os hosts na porta 8000). Para corresponder a todos os esquemas ou todas as portas, omita o componente por completo (ou seja, \"exemplo.com\" corresponde a qualquer esquema e qualquer porta). Um nome do host (no caso, \"exemplo.com\") também corresponde aos subdomínios dele. Para corresponder exatamente a um host e excluir os subdomínios dele, adicione um ponto antes (ou seja, \".exemplo.com\"). Para corresponder a todas as origens, use um único asterisco (\"*\").";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Lista de servidores proxy que permitem todos os esquemas de autenticação HTTP";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "A definição desta política especifica quais servidores proxy têm permissão para todos os esquemas de autenticação HTTP compatíveis com Brave, independentemente da política AuthSchemes.\n\nFormate o padrão do servidor proxy de acordo com o formato do filtro da lista de bloqueio de URLs (https://support.google.com/chrome/a?p=url_blocklist_filter_format). É possível definir até 1.000 exceções.\nÉ possível usar caracteres curingas para o componente de host (por exemplo, \"*:8080\" corresponde a todos os proxies na porta 8080). Um nome do host (no caso, \"proxy.exemplo.com\") também corresponde aos subdomínios dele. Para corresponder exatamente a um host e excluir os subdomínios dele, adicione um ponto antes (ou seja, \"proxy.exemplo.com\").\n\nSe esta política não for definida, apenas os esquemas de autenticação HTTP especificados em AuthSchemes (ou os esquemas padrão, se não forem definidos) serão compatíveis com a autenticação de proxy.";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Permitir que as páginas com o cabeçalho Cache-Control: no-store sejam inseridas no cache de avanço e retorno";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Esta política controla se uma página com o cabeçalho Cache-Control: no-store pode ser armazenada no cache de avanço e retorno. O site que define esse cabeçalho não pode esperar que a página seja restaurada do cache de avanço e retorno, já que algumas informações sensíveis ainda podem aparecer após a restauração, mesmo que não estejam mais acessíveis.\n\nSe a política for ativada ou não for definida, a página com o cabeçalho Cache-Control: no-store poderá ser restaurada do cache de avanço e retorno. Isso não vai acontecer se a remoção do cache for acionada, por exemplo, quando houver mudança no cookie somente HTTP para o site.\n\nSe ela for desativada, a página com o cabeçalho Cache-Control: no-store não será armazenada no cache de avanço e retorno.";
AllowCrossOriginAuthPrompt.pfm_title = "Prompts de autenticação HTTP entre origens";
AllowCrossOriginAuthPrompt.pfm_description = "Se a política for ativada, imagens de terceiros em uma página poderão aparecer em um prompt de autenticação.\n\nSe a política for desativada ou não for definida, imagens de terceiros não poderão aparecer em um prompt de autenticação.\n\nNormalmente, essa política fica desativada como defesa contra phishing.";
AllowDeletingBrowserHistory.pfm_title = "Ativar exclusão do histórico do navegador e de downloads";
AllowDeletingBrowserHistory.pfm_description = "Se a política for ativada ou não for definida, o histórico de navegação e de downloads poderão ser excluídos no Chrome e os usuários não poderão mudar essa configuração.\n\nSe a política for desativada, o histórico de navegação e o de downloads não poderão ser excluídos. Mesmo que a política esteja desativada, não há garantia de que o histórico de navegação e o de downloads serão preservados. Os usuários poderão editar ou excluir os arquivos de banco de dados de histórico diretamente, e o próprio navegador poderá expirar ou arquivar todo ou qualquer item de histórico a qualquer momento.";
AllowDinosaurEasterEgg.pfm_title = "Permitir jogo easter egg de dinossauro";
AllowDinosaurEasterEgg.pfm_description = "Se a política for definida como verdadeira, os usuários poderão acessar o jogo do dinossauro. Se ela for definida como falsa, os usuários não terão acesso ao jogo quando o dispositivo estiver off-line.\n\nNão definir a política significa que os usuários não poderão jogar no Google Chrome OS registrado, mas poderão fazer isso em outras circunstâncias.";
AllowFileSelectionDialogs.pfm_title = "Permitir a chamada de caixas de diálogo de seleção de arquivos";
AllowFileSelectionDialogs.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, o Chrome poderá exibir caixas de diálogo para seleção de arquivos e os usuários poderão abri-las.\n\nSe a política for definida como \"Desativada\", sempre que alguma ação do usuário gerar uma caixa de diálogo para seleção de arquivos, como a importação de favoritos, o upload de arquivos ou o salvamento de links, uma mensagem aparecerá no lugar da caixa de diálogo. O navegador responde como se o usuário tivesse clicado em \"Cancelar\" na caixa de diálogo de seleção de arquivos.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Permitir a aleatorização do tamanho do pool de soquetes para proxies";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "A aleatorização do tamanho do pool de soquetes é um mecanismo de segurança que impede que invasores explorem limites de capacidade determinísticos para aprender informações de sites.\nSe a capacidade de um pool for normalmente de 128 soquetes, esse mecanismo limita aleatoriamente o pool entre 128 e 256.\nIsso pode permitir até 2 vezes mais conexões com o proxy, mas, na prática, o valor esperado é de 1,2 vezes.\n\nIsso afeta as configurações de MaxConnectionsPerProxy e MaxConnectionsPerProxyForWebSocket.\nEm vez de essas políticas definirem o limite máximo, o limite será de 2 vezes os seus valores (embora, na prática, o valor esperado seja cerca de 1,2x).\n\nA opção está ativada por padrão para todos os pools, mas essa política permite que o recurso seja desativado especificamente para pools de proxy.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Permitir solicitações de autenticação da Web em sites com certificados TLS corrompidos.";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Se a política for ativada, o Brave vai permitir\nsolicitações de autenticação da Web em sites que tenham certificados TLS com\nerros, ou seja, sites considerados não seguros.\n\nSe ela for desativada ou deixada sem definição, o comportamento padrão de\nbloqueio dessas solicitações será aplicado.";
AllowedDomainsForApps.pfm_title = "Definir os domínios que têm permissão para acessar o Google Workspace";
AllowedDomainsForApps.pfm_description = "A definição da política ativa o recurso de login restrito do Chrome no Google Workspace e impede que os usuários mudem essa configuração. As ferramentas do Google só poderão ser acessadas por contas dos domínios especificados. Para permitir contas @gmail ou @googlemail, adicione consumer_accounts à lista de domínios. Essa configuração impedirá que os usuários façam login e adicionem uma conta secundária em um dispositivo gerenciado que precisa da autenticação do Google se essa conta não pertencer a um dos domínios explicitamente permitidos.\n\nDeixar essa configuração vazia ou se definição permite que usuários acessem o Google Workspace com qualquer conta.\n\nOs usuários não poderão mudar ou substituir essa configuração.\n\nObservação: essa política faz com que o cabeçalho X-GoogApps-Allowed-Domains seja anexado a todas as solicitações HTTP e HTTPS de todos os domínios google.com, como descrito em https://support.google.com/a/answer/1668854.";
AlternateErrorPagesEnabled.pfm_title = "Ativar páginas de erro alternativas";
AlternateErrorPagesEnabled.pfm_description = "Se a política for definida como verdadeira, o Brave vai usar páginas de erro alternativas integradas no navegador, como \"Página não encontrada\". Se a política for definida como falsa, o Brave nunca vai usar páginas de erro alternativas.\n\nSe você definir a política, os usuários não poderão mudá-la. Se ela não for definida, ficará ativa, mas os usuários poderão mudá-la.";
AlternativeBrowserParameters.pfm_title = "Parâmetros de linha de comando para o navegador alternativo.";
AlternativeBrowserParameters.pfm_description = "Se a política for definida como uma lista de strings, cada string será transmitida para o navegador alternativo como um parâmetro de linha de comando separado. No Microsoft® Windows®, os parâmetros são mesclados com espaços. No macOS e Linux®, um parâmetro pode ter espaços e ainda ser tratado como um único parâmetro.\n\nSe um parâmetro tiver ${url}, ${url} será substituído pelo URL da página a ser aberta. Se nenhum parâmetro tiver ${url}, o URL será anexado ao fim da linha de comando.\n\nAs variáveis de ambiente serão expandidas. No Microsoft® Windows®, %ABC% será substituída pelo valor da variável de ambiente ABC. No macOS e Linux®, ${ABC} será substituída pelo valor da variável de ambiente ABC.\n\nSe a política não for definida, apenas o URL será transmitido como um parâmetro de linha de comando.";
AlternativeBrowserPath.pfm_title = "Navegador alternativo que será iniciado com sites configurados.";
AlternativeBrowserPath.pfm_description = "Se a política for definida, ela controlará o comando usado para abrir URLs em um navegador alternativo. Ela pode ser definida como ${ie}, ${firefox}, ${safari}, ${opera}, ${edge} ou um caminho de arquivo. Quando esta política é definida como um caminho de arquivo, o arquivo em questão é usado como um executável. O ${ie} está disponível apenas no Microsoft® Windows®. O ${safari} e o ${edge} estão disponíveis apenas no Microsoft® Windows® e macOS.\n\nSe a política não for definida, o padrão usado seguirá a plataforma: Internet Explorer® para Microsoft® Windows® ou Safari® para macOS. No Linux®, não será possível abrir um navegador alternativo.";
AlwaysOpenPdfExternally.pfm_title = "Sempre abrir arquivos em PDF externamente";
AlwaysOpenPdfExternally.pfm_description = "Se a política for ativada, o visualizador de PDF interno será desativado no Brave, os arquivos PDF serão tratados como downloads e os usuários poderão abrir PDFs com o aplicativo padrão.\n\nSe ela for desativada, os arquivos PDF serão abertos no plug-in, a menos que ele seja desativado pelos usuários.\n\nSe você definir a política, os usuários não poderão mudá-la no Brave. Se ela não for definida, os usuários poderão escolher se os PDFs serão ou não abertos externamente.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Ativar a autenticação pelo SO para tipos de perfil.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Ativar a autenticação pelo SO apenas em sessões normais.\n1 - Ativar a autenticação pelo SO em sessões normais e anônimas.\n2 - Ativar a autenticação pelo SO em sessões normais e de visitante.\n3 - Ativar a autenticação pelo SO em sessões normais, anônimas e de visitante.\nConfigurar esta política permitirá/proibirá a autenticação pelo SO para perfis anônimos e de visitante no Brave.\n\nA autenticação pelo SO é do tipo HTTP com credenciais padrão caso as explícitas não sejam fornecidas por meio de esquemas de resposta/desafio Negotiate/NTLM/Kerberos.\n\nDefinir a opção RegularOnly (valor 0) permite a autenticação pelo SO apenas para sessões normais. As sessões anônimas e de visitante não terão permissão para usar essa autenticação.\n\nDefinir a opção IncognitoAndRegular (valor 1) permite a autenticação pelo SO em sessões anônimas e normais. As sessões de visitante não terão permissão para usar essa autenticação.\n\nDefinir a opção GuestAndRegular (valor 2) permite a autenticação pelo SO para sessões normais e de visitante. As sessões anônimas não terão permissão para usar essa autenticação.\n\nDefinir a opção All (valor 3) permite a autenticação pelo SO para todas as sessões.\n\nEssa autenticação sempre é permitida em perfis normais.\n\nNa versão 81 e em versões mais recentes do Brave, se a política não for definida, a autenticação pelo SO será ativada apenas em sessões normais.";
AudioCaptureAllowed.pfm_title = "Permitir ou negar captura de áudio";
AudioCaptureAllowed.pfm_description = "Se a política for definida como ativada ou não for definida, o usuário receberá uma solicitação para acesso de captura de áudio, exceto para URLs configurados na lista AudioCaptureAllowedUrls.\n\nSe a política for definida como desativada as solicitações serão desativadas e a captura de áudio só estará disponível para URLs configurados na lista AudioCaptureAllowedUrls.\n\nObservação: a política afeta todos os tipos de entradas de áudio, não apenas o microfone integrado.";
AudioCaptureAllowedUrls.pfm_title = "URLs que terão acesso a dispositivos de captura de áudio sem solicitação";
AudioCaptureAllowedUrls.pfm_description = "Se a política for definida, você vai especificar a lista de URLs com padrões que correspondam à origem de segurança do URL solicitante. Quando houver correspondência de padrão, o acesso a dispositivos de captura de áudio será permitido sem um comando.\n\nPara saber mais sobre os padrões de url válidos, acesse https://chromeenterprise.google/policies/url-patterns/. No entanto, o padrão \"*\", que corresponde a qualquer URL, não é compatível com esta política.";
AudioSandboxEnabled.pfm_title = "Permite a execução do sandbox de áudio.";
AudioSandboxEnabled.pfm_description = "Esta política controla o sandbox do processo de áudio.\nSe esta política for ativada, o processo de áudio será executado no sandbox.\nSe esta política for desativada, o processo de áudio será executado fora do sandbox, e o módulo de processamento de áudio WebRTC será executado no processo do renderizador.\nEssa opção deixa os usuários vulneráveis a riscos de segurança relacionados à execução do subsistema de áudio fora do sandbox.\nSe esta política não for definida, a configuração padrão do sandbox de áudio será usada, o que pode variar de acordo com a plataforma.\nCom esta política, as empresas que usam configurações de software de segurança que afetam o sandbox têm a flexibilidade de desativar o sandbox de áudio.";
AuthNegotiateDelegateAllowlist.pfm_title = "Lista de permissões do servidor de delegação Kerberos";
AuthNegotiateDelegateAllowlist.pfm_description = "A definição da política atribui servidores que podem ser delegados pelo Brave. Separe vários nomes de servidor usando vírgulas. Caracteres curinga (*) são permitidos.\n\nSe a política não for definida, o Brave não delegará credenciais de usuário, mesmo que um servidor seja detectado como intranet.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Usar a política KDC para delegar credenciais.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Ativar a política faz com que a autenticação HTTP respeite a aprovação pela política de KDC. Em outras palavras, o Brave delegará credenciais de usuário para o serviço acessado se o KDC definir OK-AS-DELEGATE em um ticket de serviço. Consulte RFC 5896 (https://tools.ietf.org/html/rfc5896.html, link em inglês). O serviço também precisa ter a permissão de AuthNegotiateDelegateAllowlist.\n\nDesativar a política ou deixá-la sem definição faz com que a política de KDC seja ignorada nas plataformas com suporte, e somente AuthNegotiateDelegateAllowlist será respeitada.\n\nNo Microsoft® Windows®, a política de KDC sempre é respeitada.";
AuthSchemes.pfm_title = "Esquemas de autenticação compatíveis";
AuthSchemes.pfm_description = "A definição da política especifica quais esquemas de autenticação HTTP são compatíveis com o Brave.\n\nSe a política não for definida, os quatro esquemas serão empregados.\n\nValores válidos:\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nObservação: separe vários valores usando vírgulas.";
AuthServerAllowlist.pfm_title = "Lista de permissões do servidor de autenticação";
AuthServerAllowlist.pfm_description = "Definir a política especifica quais servidores devem ter permissão para a autenticação integrada, que só é ativada quando o Brave recebe um desafio de autenticação de um proxy ou de um servidor nessa lista permitida.\n\nSe a política não for definida, o Brave tentará detectar se um servidor está na intranet. Só então ele responderá às solicitações IWA. Se um servidor for detectado como Internet, o Brave ignorará as solicitações IWA dele.\n\nObservação: separe vários nomes de servidor usando vírgulas. Caracteres curinga (*) são permitidos.";
AutoLaunchProtocolsFromOrigins.pfm_title = "Define uma lista de protocolos que podem inicializar um aplicativo externo a partir de origens listadas sem notificar o usuário";
AutoLaunchProtocolsFromOrigins.pfm_description = "Permite definir uma lista de protocolos e, para cada um deles, uma lista associada de padrões de origem com permissão para inicializar um app externo sem notificar o usuário. O separador à direita não pode ser incluído ao listar o protocolo, então liste \"skype\" em vez de \"skype:\" ou \"skype://\".\n\nSe esta política for definida, um protocolo só terá permissão para inicializar um app externo sem notificação se o protocolo estiver listado e a origem do site que tentou fazer a inicialização dele corresponder a um dos padrões de origem na lista allowed_origins do protocolo. Se alguma das condições for falsa, a solicitação de inicialização de protocolo externo não será omitida pela política.\n\nPor padrão, se a política não for definida, nenhum protocolo poderá ser inicializado sem uma solicitação. Os usuários podem recusar as solicitações por site ou por protocolo, a menos que a política ExternalProtocolDialogShowAlwaysOpenCheckbox esteja desativada. Esta política não afeta isenções de solicitação por site ou por protocolo definidas pelo usuário.\n\nOs padrões de correspondência de origem usam um formato semelhante aos da política URLBlocklist, que estão documentados em https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nEntretanto, os padrões de correspondência de origem para esta política não podem conter elementos \"/path\" ou \"@query\". Todos os padrões que tiverem esses elementos serão ignorados.\nConsulte https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins para ver mais informações sobre esquema e formatação.";
AutoOpenAllowedForURLs.pfm_title = "URLs em que é possível aplicar AutoOpenFileTypes";
AutoOpenAllowedForURLs.pfm_description = "A lista de URLs especificando para quais URLs a AutoOpenFileTypes é válida. Esta política não tem impacto em valores de abertura automática definidos pelo usuário.\n\nSe esta política for definida, os arquivos serão abertos automaticamente se o URL fizer parte deste conjunto e o tipo de arquivo estiver listado em AutoOpenFileTypes. Se alguma das condições for falsa, o download não será aberto automaticamente por padrão.\n\nSe a política não for definida, todos os downloads em que o tipo de arquivo estiver em AutoOpenFileTypes serão abertos automaticamente.\n\nUm padrão de URL precisa ser formatado de acordo com https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
AutoOpenFileTypes.pfm_title = "Lista de tipos de arquivo que devem ser abertos automaticamente após o download";
AutoOpenFileTypes.pfm_description = "Lista de tipos de arquivo que serão abertos automaticamente após o download. O separador à esquerda não pode ser incluído ao listar os tipos de arquivo. Então, liste \"txt\" em vez de \".txt\".\n\nOs arquivos dos tipos que devem ser automaticamente abertos ainda estarão sujeitos às verificações ativadas da navegação segura e não serão abertos se forem reprovados nessas verificações.\n\nSe essa política não for configurada, apenas os tipos de arquivo que o usuário já especificou para abrir automaticamente serão abertos após o download.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
AutoSelectCertificateForUrls.pfm_title = "Selecionar certificados de cliente automaticamente para estes sites";
AutoSelectCertificateForUrls.pfm_description = "Se a política for definida, você poderá fazer uma lista de padrões de URL que especificam sites para que o Chrome possa selecionar um certificado do cliente automaticamente. O valor é uma matriz de dicionários JSON convertidos em strings, cada um com o formato { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER }, em que $URL_PATTERN é um padrão de configuração de conteúdo. $FILTER restringe quais certificados do cliente podem ser selecionados automaticamente pelo navegador. Seja qual for o filtro utilizado, apenas os certificados correspondentes à solicitação do servidor serão selecionados. No Android e iOS, o Chrome só pode selecionar certificados do cliente que ele mesmo provisionou. Ele não pode acessar certificados instalados no nível do sistema operacional.\n\nExemplos de uso da seção $FILTER:\n\n* Quando $FILTER estiver definido como { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } }, apenas certificados do cliente emitidos por um certificado com o CommonName $ISSUER_CN serão selecionados.\n\n* Quando $FILTER contiver as seções \"ISSUER\" e \"SUBJECT\" ao mesmo tempo, apenas certificados do cliente que satisfaçam ambas as condições serão selecionados.\n\n* Quando $FILTER contiver uma seção \"SUBJECT\" com o valor \"O\", um certificado precisará de pelo menos uma organização correspondente ao valor especificado para ser selecionado.\n\n* Quando $FILTER contiver uma seção \"SUBJECT\" com um valor \"OU\", um certificado precisará de pelo menos uma unidade organizacional correspondente ao valor especificado para ser selecionado.\n\n* Quando $FILTER estiver definido como {}, a seleção de certificados do cliente não será restringida de nenhuma outra forma. Os filtros fornecidos pelo servidor da web ainda se aplicam.\n\nSe a política não for definida, não haverá seleção automática para nenhum site.\nConsulte https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls para ver mais informações sobre esquema e formatação.";
AutofillGenAiSettings.pfm_title = "Configurações dos recursos de IA generativa no preenchimento automático";
AutofillGenAiSettings.pfm_description = "0 - Permitir recursos de IA generativa no preenchimento automático e aprimorar os modelos de IA.\n1 - Permitir recursos de IA generativa no preenchimento automático sem aprimorar os modelos de IA.\n2 - Não permitir recursos de IA generativa no preenchimento automático.\nEsses recursos no Brave usam modelos de IA generativa para ajudar os usuários a preencher formulários na web. O uso desses recursos exige que o Brave colete dados, como a estrutura dos formulários com que o usuário interage e, no caso da opção \"Encontre e preencha com o Gemini\", as consultas de texto livre que o usuário insere para pesquisar nos apps do Gemini conectados. Esses dados são enviados a um servidor do Google, que executa um modelo de IA generativa.\n\nSe a política for definida como 0 (permitir recursos de IA generativa no preenchimento automático e aprimorar os modelos de IA), os recursos serão habilitados e o Google poderá usar os dados relevantes para aprimorar os modelos de IA. Esses dados podem incluir comandos, entradas, saídas, materiais de fonte e feedback por escrito, dependendo do recurso. O valor padrão é 0, exceto quando indicado de outra forma abaixo.\n\nDefinir a política como 1 (permitir recursos de IA generativa no preenchimento automático sem aprimorar os modelos de IA) permite o uso dos recursos, mas o Google não poderá usar o conteúdo dos usuários (incluindo comandos, entradas, saídas, materiais de fonte e feedback por escrito) para aprimorar os modelos. O valor padrão é 1 para usuários corporativos gerenciados pelo Google Admin console e contas de ensino gerenciadas pelo Google Workspace.\n\nDefinir a política como 2 (não permitir recursos de IA generativa no preenchimento automático) proíbe os recursos.\n\nQuando a política é deixada sem definição, a GenAiDefaultSettings determina o comportamento.\n\nOs recursos de IA generativa no preenchimento automático incluem:\n\n- Preenchimento inteligente de formulários: usa IA para identificar e classificar os campos de um formulário para que mais deles possam ser preenchidos.\n\n- Encontre e preencha com o Gemini: localiza informações nos apps que o usuário conectou ao Gemini e as oferece para preenchimento, seja como sugestões proativas em um formulário ou em resposta a uma consulta que o usuário escreve.\n\nEsta política substitui a AutofillPredictionSettings, que ainda é válida quando esta é deixada sem definição. A opção \"Encontre e preencha com o Gemini\" também exige que a política GeminiSettings não esteja desativada.\n\nEsta política não controla os recursos de preenchimento automático que não usam IA generativa.\n\nPara mais informações sobre como tratar dados de recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
AutofillSettings.pfm_title = "Bloquear tipos de dados de preenchimento automático para sites específicos";
AutofillSettings.pfm_description = "Ao definir essa política, é possível especificar quais tipos de dados de preenchimento automático são bloqueados em padrões de URL específicos.\n\nA política é estruturada como uma lista de dicionários. Cada dicionário precisa ter:\n* \"url_pattern\": um URL padrão de configuração de conteúdo para o frame principal (por exemplo, \"https://[*.]example.com\").\n* \"blocked_types\": uma lista de strings que representam as categorias de dados de preenchimento automático a serem bloqueadas.\n\nOs valores aceitos para \"blocked_types\" são:\n* \"contact_info\": bloqueia o preenchimento e o salvamento de dados de contato.\n* \"payments\": impede o preenchimento e o salvamento de cartões de crédito e formas de pagamento.\n* \"identity_docs\": impede o preenchimento e o salvamento de documentos de identificação (por exemplo, passaporte, carteira de habilitação, documento de identidade nacional).\n* \"travel\": impede o preenchimento e o salvamento de informações de viagem (por exemplo, reserva de voo, registro de veículo).\n* \"shopping\": impede o preenchimento e o salvamento de informações de compras (por exemplo, pedidos on-line, envios).\n* “all”: impede o preenchimento e o salvamento de todos os tipos de dados de preenchimento automático.\n\nSe um tipo de dados for bloqueado para um site, a geração de sugestões e o comando para salvar/importar novos dados desse tipo serão desativados no site.\n\nSe um URL corresponder a múltiplas entradas de padrão na lista, os tipos bloqueados de todas as entradas correspondentes serão combinados (mesclados por união). Os padrões de URL inválidos na lista são ignorados.\n\nSe a política não for definida, nenhum tipo de dados de preenchimento automático será bloqueado por domínio.\n\nPara informações mais detalhadas sobre padrões de URL válidos, consulte:\nhttps://chromeenterprise.google/policies/url-patterns. O caractere curinga * é compatível. Esse padrão corresponde a qualquer URL, com qualquer esquema, porta e caminho.\nConsulte https://chromeenterprise.google/policies/?policy=AutofillSettings para ver mais informações sobre esquema e formatação.";
AutomatedPasswordChangeSettings.pfm_title = "Ativar mudança automática de senha";
AutomatedPasswordChangeSettings.pfm_description = "0 - Permitir o uso do recurso e o aprimoramento dos modelos de IA\n1 - Permitir o uso do recurso sem aprimorar os modelos de IA\n2 - Não permitir o recurso\nEsta política controla a disponibilidade do recurso de mudança automatizada de senha do Brave.\n\nSe ela for ativada, um usuário pode acionar um processo em que o navegador tenta mudar a senha em um site automaticamente. Esse processo é gerenciado pela IA generativa. A nova senha é salva no gerenciador de senhas do navegador.\n\nSe a política for definida como 0, o recurso será habilitado, e dados relevantes poderão ser usados pelo Google para aprimorar os modelos de IA. Esses dados podem incluir comandos, entradas, respostas, materiais de origem e feedback por escrito, dependendo do recurso. Eles também podem ser analisados por humanos para melhorar os modelos de IA. O valor padrão é 0, exceto quando indicado de outra forma abaixo.\n\nSe a política for definida como 1, o recurso será habilitado, mas o Google não poderá usar o conteúdo dos usuários (incluindo comandos, entradas, respostas, materiais de origem e feedback por escrito) para aprimorar os modelos. 1 é o valor padrão para usuários corporativos gerenciados pelo Google Admin Console e para contas de ensino gerenciadas pelo Google Workspace.\n\nSe a política for definida como 2, o recurso não será habilitado.\n\nSe for deixada sem definição, o comportamento será determinado pela política GenAiDefaultSettings.\n\nPara mais informações sobre como tratar dados de recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Permitir downloads automáticos a esses sites";
AutomaticDownloadsAllowedForUrls.pfm_description = "Permite definir uma lista de padrões de URL que especificam quais sites têm permissão para baixar vários arquivos de forma automática.\n\nPara informações mais detalhadas sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns.\n\nSe um URL corresponder tanto a AutomaticDownloadsAllowedForUrls quanto a AutomaticDownloadsBlockedForUrls, a política AutomaticDownloadsBlockedForUrls terá precedência.\n\nSe essa política não for definida, então DefaultAutomaticDownloadsSetting, caso esteja definida, será aplicada a todos os sites. Caso contrário, a configuração pessoal do usuário será aplicada.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Bloquear downloads automáticos nesses sites";
AutomaticDownloadsBlockedForUrls.pfm_description = "Permite definir uma lista de padrões de URL que especificam quais sites não têm permissão para baixar vários arquivos de forma automática.\n\nPara informações mais detalhadas sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns.\n\nSe um URL corresponder tanto a AutomaticDownloadsAllowedForUrls quanto a AutomaticDownloadsBlockedForUrls, a política AutomaticDownloadsBlockedForUrls terá precedência.\n\nSe essa política não for definida, então DefaultAutomaticDownloadsSetting, caso esteja definida, será aplicada a todos os sites. Caso contrário, a configuração pessoal do usuário será aplicada.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Permitir a tela cheia automática nesses sites";
AutomaticFullscreenAllowedForUrls.pfm_description = "Por motivos de segurança, a\nAPI requestFullscreen() da web\nexige que uma interação anterior do usuário (\"ativação temporária\") seja chamada. Caso contrário,\nela vai falhar. As configurações pessoais dos usuários podem permitir que determinadas origens chamem\nessa API sem uma interação anterior do usuário, conforme descrito em\nhttps://chromestatus.com/feature/6218822004768768.\n\nEsta política substitui as configurações pessoais dos usuários e permite que origens correspondentes\nchamem a API sem uma interação anterior do usuário.\n\nPara informações mais detalhadas sobre os padrões de URL válidos, consulte\nhttps://chromeenterprise.google/policies/url-patterns.\nCaracteres curinga (*) são permitidos.\n\nAs origens que corresponderem aos padrões de política bloqueados e permitidos ao mesmo tempo serão bloqueadas.\nOrigens não especificadas por políticas ou configurações dos usuários exigem uma interação anterior\ndo usuário para chamar a API.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Bloquear a tela cheia automática nesses sites";
AutomaticFullscreenBlockedForUrls.pfm_description = "Por motivos de segurança, a\nAPI requestFullscreen() da web\nexige que uma interação anterior do usuário (\"ativação temporária\") seja chamada. Caso contrário,\nela vai falhar. As configurações pessoais dos usuários podem permitir que determinadas origens chamem\nessa API sem uma interação anterior do usuário, conforme descrito em\nhttps://chromestatus.com/feature/6218822004768768.\n\nEsta política substitui as configurações pessoais dos usuários e impede que origens correspondentes\nchamem a API sem uma interação anterior do usuário.\n\nPara saber mais sobre padrões de URL válidos, consulte\nhttps://chromeenterprise.google/policies/url-patterns.\nCaracteres curinga (*) são permitidos.\n\nAs origens que corresponderem aos padrões de política bloqueados e permitidos ao mesmo tempo serão bloqueadas.\nOrigens não especificadas por políticas ou configurações dos usuários exigem uma interação anterior\ndo usuário para chamar a API.";
AutoplayAllowed.pfm_title = "Permitir reprodução automática de mídia";
AutoplayAllowed.pfm_description = "Se a política for definida como verdadeira, o Brave poderá tocar mídia automaticamente. Se for definida como falsa, o Brave será impedido de tocar mídia automaticamente.\n\nSe ela não for definida, o Brave não vai tocar mídia automaticamente. No entanto, você pode usar a política AutoplayAllowlist para mudar essa configuração para padrões de URL específicos.\n\nSe a política for modificada enquanto o Brave estiver em execução, ela será válida apenas para guias abertas recentemente.";
AutoplayAllowlist.pfm_title = "Permitir reprodução automática de mídia em uma lista de permissões de padrões de URL";
AutoplayAllowlist.pfm_description = "Se a política for definida, será possível iniciar vídeos automaticamente (sem o consentimento do usuário) com conteúdo de áudio no Brave. Se a política AutoplayAllowed for definida como verdadeira, esta política não terá efeito. Se a política AutoplayAllowed for definida como falsa, todos os padrões de URL definidos nesta política terão permissão para serem iniciados. Se a política for modificada enquanto o Brave estiver em execução, ela vai se aplicar apenas a guias abertas recentemente.\n\nPara saber mais sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns/.";
BackgroundTabFreezingEnabled.pfm_title = "Ativar o congelamento das guias em segundo plano";
BackgroundTabFreezingEnabled.pfm_description = "Controla se o Brave congela as guias inativas em segundo plano para economizar CPU e memória.\n\nQuando o congelamento de guias em segundo plano está ativo, as guias que estão inativas em segundo plano por um período são congeladas ao pausar a execução do JavaScript e as tarefas do timer. As guias congeladas permanecem carregadas na memória e são retomadas na hora quando selecionadas pelo usuário. As com tarefas ativas em segundo plano (como aquelas com áudio ou vídeo, capturam streams de tela ou câmera, mantêm conexões WebRTC ativas ou detêm bloqueios da web) não estão qualificadas para congelamento e continuam em execução. Os sites configurados na política TabDiscardingExceptions ou nas exceções de descarte de guias do usuário também estão isentos de congelamento.\n\nSe a política for ativada, o congelamento automático de guias em segundo plano será ativado para as guias qualificadas. Os usuários não podem mudar essa configuração.\n\nSe a política for desativada, as guias em segundo plano não serão congeladas. Os usuários não podem mudar essa configuração.\n\nSe a política for deixada sem definição, o congelamento de guias em segundo plano será ativado por padrão, mas os usuários poderão ativar ou desativar essa opção nas configurações do Brave.";
BasicAuthOverHttpEnabled.pfm_title = "Permitir autenticação Basic para conexões HTTP";
BasicAuthOverHttpEnabled.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, desafios de autenticação Basic recebidos por HTTP não seguro serão permitidos.\n\nSe a política for definida como \"Desativada\", solicitações HTTP não seguras não poderão usar o esquema de autenticação Basic. Apenas conexões HTTPS seguras serão aceitas.\n\nSe a política AuthSchemes for definida e não incluir o esquema Basic, a definição da política será ignorada e o Basic será sempre proibido.";
BatterySaverModeAvailability.pfm_title = "Ativar o modo de economia de bateria";
BatterySaverModeAvailability.pfm_description = "0 - O modo de economia de bateria vai ser desativado.\n1 - O modo de economia de bateria vai ser ativado quando o dispositivo estiver usando a energia da bateria e o nível dela estiver baixo.\n2 - Esse valor foi descontinuado na versão M121. Na versão M121 e em versões mais recentes, os valores serão tratados como EnabledBelowThreshold.\nEsta política ativa ou desativa a configuração do modo de economia de bateria.\nNo Chrome, essa configuração limita o frame rate para reduzir o consumo de energia. Se a política for deixada sem definição, o usuário final poderá controlar essa configuração em chrome://settings/performance.\nNo ChromeOS, essa configuração faz com que o frame rate e a frequência da CPU sejam limitados, as luzes de fundo fiquem esmaecidas e o Android seja colocado no modo de economia de bateria. Em dispositivos com várias CPUs, algumas delas serão desativadas.\nOs diferentes níveis são:\nDisabled (0): o modo de economia de bateria será desativado.\nEnabledBelowThreshold (1): o modo de economia de bateria será ativado quando o dispositivo estiver usando a energia da bateria e o nível dela estiver baixo.\nEnabledOnBattery (2): esse valor foi descontinuado na versão M121. Na versão M121 e mais recentes, os valores serão tratados como EnabledBelowThreshold.\n";
BlockExternalExtensions.pfm_title = "Bloqueia a instalação de extensões externas";
BlockExternalExtensions.pfm_description = "Controla a instalação de extensões externas.\n\nSe a política for ativada, as extensões externas não poderão ser instaladas.\n\nSe ela for desativada ou não for definida, extensões externas poderão ser instaladas.\n\nAs extensões externas e a instalação estão documentadas em https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions.\n\nObservação: esta política só se aplica a plataformas que são compatíveis com extensões.";
BlockThirdPartyCookies.pfm_title = "Bloquear cookies de terceiros";
BlockThirdPartyCookies.pfm_description = "Se a política for ativada, os cookies não poderão ser definidos por elementos de página da Web que não sejam do domínio que está na barra de endereço do navegador. Se a política for desativada, os cookies poderão ser definidos por esses elementos, e os usuários serão impedidos de mudar essa configuração.\n\nSe ela não for definida, os cookies de terceiros serão permitidos, mas os usuários poderão mudar essa configuração.\n\nObservação: essa política não se aplica ao modo de navegação anônima, em que os cookies de terceiros são bloqueados e só podem ser permitidos no nível do site. Para permitir cookies no nível do site, use a política CookiesAllowedForUrls.";
BookmarkBarEnabled.pfm_title = "Ativar a barra de favoritos";
BookmarkBarEnabled.pfm_description = "Se a política for definida como verdadeira, a barra de favoritos será exibida no Brave. Se ela for definida como falsa, os usuários não poderão ver a barra de favoritos.\n\nSe você definir a política, os usuários não poderão mudá-la. Caso contrário, os usuários poderão usar essa função.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "Ativar adição de uma pessoa no gerenciador de usuários";
BrowserAddPersonEnabled.pfm_description = "Se esta política for definida como verdadeira ou for deixada sem definição, o Brave e o Lacros vão permitir que uma nova pessoa seja adicionada pelo gerenciador de usuários.\n\nSe ela for definida como falsa, o Brave e o Lacros não vão permitir que uma nova pessoa seja adicionada pelo gerenciador de usuários.";
BrowserGuestModeEnabled.pfm_title = "Ativar o modo visitante no navegador";
BrowserGuestModeEnabled.pfm_description = "Se esta política for ativada ou deixada sem definição, o Brave vai ativar os logins de visitantes. Logins de visitantes são perfis do Brave em que todas as janelas estão no modo de navegação anônima.\n\nSe ela for desativada, o Brave não vai permitir que perfis de visitantes sejam iniciados.";
BrowserGuestModeEnforced.pfm_title = "Aplicar o modo visitante do navegador";
BrowserGuestModeEnforced.pfm_description = "Definir a política como \"Ativada\" faz com que o Brave aplique sessões de visitante e impeça logins de perfis. Logins de visitante são perfis do Brave em que as janelas estão no modo de navegação anônima.\n\nSe a política for definida como \"Desativada\", não for definida ou se o modo visitante for desativado (pela BrowserGuestModeEnabled), o uso de perfis novos e existentes será permitido.";
BrowserLabsEnabled.pfm_title = "Ícone dos experimentos do navegador na barra de ferramentas";
BrowserLabsEnabled.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, o usuário poderá acessar recursos experimentais do navegador pelo ícone da barra de ferramentas\n\nSe a política for definida como \"Desativada\", o ícone de recursos experimentais do navegador será removido da barra de ferramentas.\n\nchrome://flags e todas as outras formas de desativar e ativar os recursos do navegador ainda funcionarão como esperado, independentemente de a política ser definida como \"Ativada\" ou \"Desativada\".";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Permitir consultas a um serviço de hora do Google";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, o Brave enviará consultas ocasionais a um servidor do Google para recuperar um carimbo de data/hora preciso.\n\nSe ela for definida como \"Desativada\", o Brave não enviará essas consultas.";
BrowserSignin.pfm_title = "Configurações de login no navegador";
BrowserSignin.pfm_description = "0 - Desativar login no navegador\n1 - Ativar login no navegador\n2 - Forçar o usuário a fazer login para usar o navegador\nEsta política controla o comportamento de login do navegador. Com ela, você especifica se o usuário pode fazer login no Brave com a conta dele e usar serviços relacionados à conta, como a Sincronização do Brave.\n\nSe a política for definida como \"Desativar login no navegador\", o usuário não poderá fazer login no navegador e usar os serviços da conta. Nesse caso, recursos do navegador, como a Sincronização do Brave, não poderão ser usados e não vão estar disponíveis. No iOS, se o usuário já estiver com a conta conectada e a política for desativada, a conta será imediatamente desconectada. Em outras plataformas, a conta será desconectada na próxima vez que o Brave for executado. Em todas as outras plataformas, os dados locais do perfil, como favoritos, senhas etc., serão mantidos e poderão ser usados. O usuário ainda poderá fazer login e usar serviços da web do Google, como o Gmail.\n\nSe a política for definida como \"Ativar login no navegador\", o usuário poderá fazer login. Em todas as plataformas, exceto no iOS, a conta do usuário será conectada automaticamente no navegador quando ele fizer login em serviços da web do Google, como o Gmail. Estar conectado significa que as informações da conta do usuário serão mantidas pelo navegador. Entretanto, isso não significa que a Sincronização do Brave será ativada por padrão. O usuário precisará ativar esse recurso de forma separada. A ativação desta política vai impedir que o usuário desative a configuração que permite o login no navegador. Para controlar a disponibilidade da Sincronização do Brave, use a política SyncDisabled.\n\nSe ela estiver definida como \"Forçar o login no navegador\", o usuário verá uma caixa de diálogo de seleção de contas. Ele precisará escolher uma e fazer login para usar o navegador. Isso garante que, para as contas gerenciadas, as políticas associadas à conta sejam aplicadas. O valor padrão da BrowserGuestModeEnabled será definido como desativado. Os perfis existentes não conectados serão bloqueados e vão ficar inacessíveis após a ativação dessa política. Para mais informações, consulte o artigo da Central de Ajuda: https://support.google.com/chrome/?p=force_browser_signin. Essa opção não está disponível para Google Chrome OS ou Android. Nesses dispositivos, ela será substituída por \"Ativar login no navegador\", caso seja usada.\n\nSe a política não for definida, o usuário poderá decidir se quer ativar o login no navegador nas configurações do Brave e usar esse recurso como achar melhor.";
BrowserSwitcherDelay.pfm_title = "Atraso para iniciar um navegador alternativo (milésimos de segundo)";
BrowserSwitcherDelay.pfm_description = "Se a política for definida como um número, o Brave vai mostrar uma mensagem de milésimos de segundo para o número e abrirá um navegador alternativo.\n\nSe ela não for definida ou for definida como \"0\", a navegação para um URL designado vai abri-lo imediatamente em um navegador alternativo.";
BrowserSwitcherEnabled.pfm_title = "Ativa o recurso \"Suporte a navegadores legados\".";
BrowserSwitcherEnabled.pfm_description = "Se a política for ativada, o Brave vai tentar abrir alguns URLs em um navegador alternativo, como o Internet Explorer®. Esse recurso é configurado por meio das políticas no grupo do Legacy Browser support.\n\nSe a política for desativada ou não for definida, o Brave não vai tentar abrir URLs designados em um navegador alternativo.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "URL de um arquivo XML contendo URLs que nunca devem acionar uma troca de navegador.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Se a política for definida como um URL válido, o Brave fará o download da lista de sites desse URL e aplicará as regras como se tivessem sido configuradas com a política BrowserSwitcherUrlGreylist. Essas políticas evitam que o Brave e o navegador alternativo abram um ao outro.\n\nSe ela não for definida ou for definida como um URL inválido, o Brave não a usará como fonte de regras para não trocar de navegador.\n\nObservação: esta política aponta para um arquivo XML no mesmo formato que a política SiteList do Internet Explorer®. As regras são carregadas de um arquivo XML e não são compartilhadas com o Internet Explorer®. Leia mais sobre a política SiteList do Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL de um arquivo XML que contém URLs que serão carregados em um navegador alternativo.";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Se a política for definida como um URL válido, o Brave fará o download da lista de sites desse URL e aplicará as regras como se tivessem sido configuradas com a política BrowserSwitcherUrlList.\n\nSe ela não for definida ou for definida como um URL inválido, o Brave não a usará como fonte de regras para uma troca de navegador.\n\nObservação: esta política aponta para um arquivo XML no mesmo formato que a política SiteList do Internet Explorer®. As regras são carregadas de um arquivo XML e não são compartilhadas com o Internet Explorer®. Leia mais sobre a política SiteList do Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Mantém a última guia aberta no Chrome.";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Se a política for definida como ativada ou não for definida, o Brave manterá pelo menos uma guia aberta depois de mudar para um navegador alternativo.\n\nSe a política for definida como desativada, o Brave fechará a guia depois de mudar para um navegador alternativo, mesmo se essa for a última guia. Isso faz com que o Brave seja completamente fechado.";
BrowserSwitcherParsingMode.pfm_title = "Modo de análise da lista de sites";
BrowserSwitcherParsingMode.pfm_description = "0 - Comportamento padrão para LBS.\n1 - Mais compatível com as listas de sites do modo empresarial do Microsoft IE/Edge.\nEsta política controla como o Google Chrome interpreta políticas de lista de sites/lista cinza no recurso Suporte a navegadores legados. Ela afeta as políticas BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl e BrowserSwitcherExternalGreylistUrl.\n\nSe ela for definida como \"Default\" (0) ou for deixada sem definição, a correspondência de URL será menos rigorosa. Regras que não tiverem \"/\" procurarão uma substring em qualquer lugar no nome do host do URL. A correspondência do componente de caminho de um URL diferencia maiúsculas de minúsculas.\n\nSe \"IESiteListMode\" (1), a correspondência de URL será mais rigorosa. Regras que não tiverem \"/\" terão correspondência apenas no fim do nome do host. Elas também precisarão estar no limite de um nome de domínio. A correspondência do componente de caminho de um URL não diferencia maiúsculas e minúsculas. Esse comportamento é mais compatível com o Microsoft® Internet Explorer® e o Microsoft® Edge®.\n\nPor exemplo, com as regras \"example.com\" e \"acme.com/abc\":\n\n\"http://example.com/\", \"http://subdomain.example.com/\" e \"http://acme.com/abc\" correspondem independentemente do modo de análise.\n\n\"http://notexample.com/\", \"http://example.com.invalid.com/\" e \"http://example.comabc/\" correspondem apenas no modo \"Default\".\n\n\"http://acme.com/ABC\" corresponde apenas no \"IESiteListMode\".";
BrowserSwitcherUrlGreylist.pfm_title = "Sites que nunca acionarão uma troca de navegador.";
BrowserSwitcherUrlGreylist.pfm_description = "A definição a política controla a lista de sites que nunca causarão uma troca de navegador. Cada item é tratado como uma regra. As regras correspondentes não abrirão um navegador alternativo. Ao contrário da política BrowserSwitcherUrlList, as regras se aplicam nas duas direções. Quando o suplemento do Internet Explorer® estiver ativado, ele também controlará se o Internet Explorer® abrirá os URLs no Brave.\n\nSe a política não for definida, nenhum site será adicionado à lista.\n\nObservação: também é possível adicionar elementos à lista por meio da política BrowserSwitcherExternalGreylistUrl.";
BrowserSwitcherUrlList.pfm_title = "Sites que serão abertos no navegador alternativo";
BrowserSwitcherUrlList.pfm_description = "Se a política for definida, ela controlará a abertura da lista de sites em um navegador alternativo. Cada item será tratado como uma regra para abrir algo em um navegador alternativo. No Brave, essas regras são usadas para determinar se um URL será aberto em um navegador alternativo ou não. Quando o suplemento do Internet Explorer® estiver ativado, o Internet Explorer® retornará ao Brave quando não houver correspondência com as regras. Se as regras forem contraditórias, o Brave usará a regra mais específica.\n\nSe a política não for definida, nenhum site será adicionado à lista.\n\nObservação: também é possível adicionar elementos à lista pelas políticas BrowserSwitcherUseIeSitelist e BrowserSwitcherExternalSitelistUrl.";
BrowserThemeColor.pfm_title = "Configurar a cor do tema do navegador";
BrowserThemeColor.pfm_description = "Esta política permite que os administradores configurem a cor do tema do Brave. Para isso, a string de entrada precisa ser de uma cor hexadecimal válida compatível com o formato \"#RRGGBB\".\n\nSe a política for definida como uma cor hexadecimal válida, um tema baseado nessa cor será gerado automaticamente e aplicado ao navegador. O usuário não poderá mudar o tema definido pela política.\n\nSe a política for deixada sem definição, o usuário poderá mudar o tema do navegador como quiser.";
BrowsingDataLifetime.pfm_title = "Configurações do ciclo de vida dos dados de navegação";
BrowsingDataLifetime.pfm_description = "Define as configurações para o ciclo de vida dos dados de navegação do Brave. Esta política permite que os administradores configurem (para cada tipo de dado) quando os dados serão excluídos pelo navegador. Isso é útil para clientes que trabalham com dados sensíveis do cliente.\n\nAviso: definir essa política pode afetar e remover permanentemente os dados pessoais locais. Recomendamos testar as configurações antes da implantação para evitar a exclusão acidental de dados pessoais.\n\nOs tipos de dados disponíveis são: 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' e 'hosted_app_data'. 'download_history' e 'hosted_app_data' não estão disponíveis no Android.\n\nO navegador vai excluir automaticamente os tipos de dados selecionados com mais de 'time_to_live_in_hours'. O valor mínimo que pode ser definido é de uma hora.\n\nOs dados expirados serão excluídos 15 segundos após a inicialização do navegador e a cada 30 minutos enquanto ele estiver em execução.\n\nO usuário vai continuar conectado à Conta do Google ao excluir cookies.\n\nAté o Chrome 114, esta política exigia que a SyncDisabled fosse definida como \"true\" (verdadeira). No Chrome 115 e versões mais recentes, a definição desta política vai desativar a sincronização dos respectivos tipos de dados se a Chrome Sync não for desativada pela configuração da SyncDisabled, e a BrowserSignin não for desativada.\nConsulte https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime para ver mais informações sobre esquema e formatação.";
BuiltInAIAPIsEnabled.pfm_title = "Permita que as páginas usem APIs de IA integradas.";
BuiltInAIAPIsEnabled.pfm_description = "Esta política controla se uma página pode usar APIs de IA integradas (como LanguageModel API, Summarization API, Writer API e Rewriter API).\n\nSe a política for ativada ou ficar sem definição, as APIs poderão ser usadas.\n\nSe for desativada, a tentativa de usar as APIs vai resultar em um erro.";
BuiltInDnsClientEnabled.pfm_title = "Usar cliente DNS integrado";
BuiltInDnsClientEnabled.pfm_description = "Esta política controla qual pilha de software é usada para se comunicar com o servidor DNS: o cliente DNS do sistema operacional ou o cliente DNS integrado do Brave. Esta política não afeta qual servidor DNS será usado. Se, por exemplo, o sistema operacional estiver configurado para usar um servidor DNS empresarial, o mesmo servidor será usado pelo cliente DNS integrado. Ela também não controla como o DNS sobre HTTPS é usado. O Brave sempre usará o resolvedor integrado para solicitações DNS sobre HTTPS. Consulte a política DnsOverHttpsMode para informações sobre como controlar o DNS sobre HTTPS.\n\nSe a política for ativada ou deixada sem definição, o cliente DNS integrado será usado.\n\nSe a política for definida como \"Desativada\", o cliente DNS integrado será usado apenas quando o DNS sobre HTTPS estiver em uso.";
CACertificateManagementAllowed.pfm_title = "Permite que o usuário gerencie os certificados de CA instalados.";
CACertificateManagementAllowed.pfm_description = "0 - Permitir que os usuários gerenciem todos os certificados\n1 - Permitir que os usuários gerenciem certificados\n2 - Não permitir que os usuários gerenciem certificados\nSe a política for definida como \"Todos (0)\" ou não for definida, os usuários poderão editar as configurações de confiança para todos os certificados de CA, remover certificados importados e importar outros usando o Gerenciador de certificados. Se a política for definida como \"Somente usuário (1)\", os usuários poderão gerenciar os certificados importados, mas não poderão mudar as configurações de confiança dos certificados integrados. Se ela for definida como \"Nenhum (2)\", os usuários poderão ver os certificados de CA, mas não gerenciá-los.";
CACertificates.pfm_title = "Certificados TLS que devem ser considerados confiáveis pelo Brave para autenticação do servidor";
CACertificates.pfm_description = "Uma lista de certificados TLS em que o Brave confia para autenticação do servidor.\nOs certificados precisam ser codificados em Base64.";
CACertificatesWithConstraints.pfm_title = "Certificados TLS que precisam ser considerados confiáveis pelo Brave para autenticação do servidor com restrições";
CACertificatesWithConstraints.pfm_description = "Uma lista de certificados TLS em que o Brave confia para autenticação do servidor, com restrições adicionadas fora do certificado. Se nenhuma restrição de um determinado tipo estiver presente, qualquer nome desse tipo será permitido.\nOs certificados precisam ser codificados em base64. É preciso especificar pelo menos uma restrição para cada certificado.\nConsulte https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints para ver mais informações sobre esquema e formatação.";
CADistrustedCertificates.pfm_title = "Certificados TLS em que o Brave não deve confiar para autenticação do servidor";
CADistrustedCertificates.pfm_description = "Uma lista de chaves públicas do certificado em relação ao qual o Brave deve ficar em dúvida para autenticação do servidor TLS.\n\nO valor da política é uma lista de certificados X.509 codificados em base64. Os\ncertificados com SPKI (SubjectPublicKeyInfo) correspondentes não serão considerados confiáveis.";
CAHintCertificates.pfm_title = "Certificados TLS que não são confiáveis ou aqueles que não são confiáveis, mas podem ser usados na criação de caminhos para autenticação do servidor";
CAHintCertificates.pfm_description = "Uma lista de certificados que não são confiáveis ou aqueles que não são confiáveis no Brave,\nmas que podem ser usados como dicas para criar caminhos. Os certificados precisam ser codificados em Base64.";
CAPlatformIntegrationEnabled.pfm_title = "Usar certificados TLS adicionados pelo usuário de repositórios de confiança da plataforma para autenticação do servidor";
CAPlatformIntegrationEnabled.pfm_description = "Se ativado (ou não definido), os certificados TLS adicionados pelo usuário de repositórios de confiança da plataforma serão usados na criação de caminhos para a autenticação do servidor TLS.\n\nSe desativado, os certificados TLS adicionados pelo usuário de repositórios de confiança da plataforma não serão usados na criação de caminhos para a autenticação do servidor TLS.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "Suporte a cabeçalhos de solicitação de CORS sem caractere curinga";
CORSNonWildcardRequestHeadersSupport.pfm_description = "Configura o suporte a cabeçalhos de solicitação de CORS sem caractere curinga.\n\nA versão 97 do Brave introduz o suporte a cabeçalhos de solicitação de CORS sem caractere curinga. Diante de uma solicitação de rede entre origens usando fetch() e XMLHttpRequest com um cabeçalho Authorization adicionado pelo script, o cabeçalho precisa receber autorização explícita do cabeçalho Access-Control-Allow-Headers na resposta de simulação do CORS. Aqui, \"explícita\" significa que o caractere curinga \"*\" não inclui o cabeçalho Authorization. Para acessar mais detalhes, consulte https://chromestatus.com/feature/5742041264816128.\n\nSe esta política for deixada sem definição ou for definida como verdadeira, o Brave vai oferecer suporte a cabeçalhos de solicitação de CORS sem caractere curinga e se comportará como descrito acima.\n\nSe esta política for definida como falsa, o Chrome vai permitir o uso do caractere curinga \"*\" no cabeçalho Access-Control-Allow-Headers da resposta de simulação do CORS para incluir o cabeçalho Authorization.\n\nA política corporativa é temporária e será removida no futuro.";
CacheEncryptionEnabled.pfm_title = "Com esta política, os administradores podem criptografar o cache HTTP no disco.";
CacheEncryptionEnabled.pfm_description = "Esta política permite que os administradores criptografem o cache http do navegador no disco.\n\nQuando esta política está ativada, o cache do navegador é criptografado.\n\nQuando esta política está desativada ou não é definida, o cache do navegador não é criptografado.\n\nA criptografia do cache do navegador pode afetar o desempenho.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "Desativar a aplicação da Transparência dos certificados para uma lista de hashes subjectPublicKeyInfo";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "A definição da política desativa a aplicação dos requisitos de divulgação da Transparência dos certificados para uma lista de hashes subjectPublicKeyInfo. Os hosts comerciais podem continuar usando certificados que, de outro modo, não seriam confiáveis, já que eles não foram divulgados publicamente de maneira adequada. Para desativar a aplicação, o hash precisa atender a uma destas condições:\n\n* Ele é do subjectPublicKeyInfo do certificado do servidor.\n\n* Ele é de um subjectPublicKeyInfo que aparece em um certificado de CA na cadeia de certificados. Esse certificado de CA é restringido pela extensão X.509v3 nameConstraints, um ou mais nameConstraints de directoryName estão presentes nas permittedSubtrees, e o directoryName tem um atributo organizationName.\n\n* Ele é de um subjectPublicKeyInfo que aparece em um certificado de CA na cadeia de certificados, o certificado de CA tem um ou mais atributos organizationName no Subject do certificado, e o certificado do servidor contém o mesmo número de atributos organizationName, na mesma ordem e com valores idênticos byte por byte.\n\nEspecifique um hash subjectPublicKeyInfo vinculando o nome do algoritmo dele, uma barra e a codificação Base64 desse algoritmo de hash aplicado ao subjectPublicKeyInfo codificado por DER do certificado especificado. O formato de codificação Base64 corresponde ao de uma impressão digital SPKI. O único algoritmo de hash reconhecido é sha256, enquanto os outros são ignorados.\n\nDeixar esta política sem definição significa que se os certificados que precisam ser divulgados via Transparência dos certificados não o forem, o Brave não confiará nesses certificados.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "Desativar a aplicação da Transparência dos certificados para uma lista de URLs";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "A definição da política desativa os requisitos de divulgação de Transparência dos certificados para os nomes de host nos URLs especificados. Embora dificultem a detecção de certificados incorretos, os hosts podem continuar usando certificados que, de outro modo, não seriam confiáveis, já que não foram divulgados publicamente de maneira adequada.\n\nDeixar esta política sem definição significa que, se os certificados que precisam ser divulgados pela Transparência dos certificados não forem, o Brave não confiará nesses certificados.\n\nUm padrão de URL segue o formato especificado em https://support.google.com/chrome/a?p=url_blocklist_filter_format. No entanto, como a validação dos certificados para um determinado nome do host independe do esquema, da porta ou do caminho, o Brave só considera a parte de nome do host do URL. Hosts curinga não têm suporte.";
ChromeForTestingAllowed.pfm_title = "Permitir o uso do Chrome for Testing";
ChromeForTestingAllowed.pfm_description = "Controla se os usuários podem usar o Chrome for Testing.\n\nSe esta política for ativada ou deixada sem definição, os usuários poderão instalar e executar o Chrome for Testing.\n\nSe for desativada, os usuários não terão permissão para executar o Chrome for Testing. Os usuários ainda poderão instalar o Chrome for Testing, mas ele não será executado nos perfis em que a política estiver desativada.";
ChromeSuggestionsSettings.pfm_title = "Configurações de ChromeSuggestions";
ChromeSuggestionsSettings.pfm_description = "Essa configuração permite que o Chrome sugira recursos de IA em momentos relevantes.\n\n0/não definida = as sugestões do Chrome ficarão ativadas para os usuários.\n\n1 = as sugestões do Chrome ficarão desativadas para os usuários.\n\nPara mais informações, consulte o artigo da Central de Ajuda: https://support.google.com/chrome/a?p=chrome_suggestions";
ChromeVariations.pfm_title = "Determinar a disponibilidade de variações";
ChromeVariations.pfm_description = "0 - Permitir todas as variações\n1 - Ativar variações relativas apenas a correções críticas\n2 - Desativar todas as variações\nConfigurar esta política permite especificar quais variações têm permissão para ser aplicadas no Brave.\n\nAs variações fornecem uma maneira de oferecer modificações para o Brave sem lançar uma nova versão do navegador, ativando ou desativando recursos já existentes. Acesse https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework para ver mais informações.\n\nDefinir VariationsEnabled (valor 0) ou não definir a política permite que todas as variações sejam aplicadas ao navegador.\n\nDefinir CriticalFixesOnly (valor 1) permite que apenas as variações consideradas como correções críticas de segurança ou estabilidade sejam aplicadas ao Brave.\n\nDefinir VariationsDisabled (valor 2) impede que qualquer variação seja aplicada ao navegador. Esse modo não é recomendado, porque pode impedir que os desenvolvedores do Brave forneçam correções críticas de segurança de maneira rápida.";
ClearBrowsingDataOnExitList.pfm_title = "Remover dados de navegação ao sair";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - Histórico de navegação\ndownload_history - Histórico de downloads\ncookies_and_other_site_data - Cookies e outros dados do site\ncached_images_and_files - Imagens e arquivos em cache\npassword_signin - Login com senha\nautofill - Preenchimento automático\nsite_settings - Configurações de sites\nhosted_app_data - Dados dos apps hospedados\nConfigura uma lista de tipos de dados de navegação a serem excluídos quando o usuário fechar todas as janelas do navegador.\n\nAviso: definir essa política pode afetar e remover permanentemente os dados pessoais locais. Recomendamos testar as configurações antes da implantação para evitar a exclusão acidental de dados pessoais.\n\nOs tipos de dados disponíveis são: histórico de navegação (browsing_history), histórico de downloads (download_history), cookies (cookies_and_other_site_data), cache(cached_images_and_files), preenchimento automático (autofill), senhas (password_signin), configurações de sites (site_settings) e dados de apps hospedados (hosted_app_data). Esta política não tem precedência sobre AllowDeletingBrowserHistory.\n\nO usuário vai continuar conectado à Conta do Google ao excluir cookies.\n\nAté o Chrome 114, esta política exigia que a SyncDisabled fosse definida como \"true\" (verdadeira). No Chrome 115 e versões mais recentes, a definição desta política vai desativar a sincronização dos respectivos tipos de dados se a Chrome Sync não for desativada pela configuração da SyncDisabled, e a BrowserSignin não for desativada.\n\nSe por algum motivo a exclusão de dados tiver começado e não tiver sido concluída, os dados de navegação serão excluídos da próxima vez que o perfil for carregado.\n\nSe o Brave não for fechado corretamente (por exemplo, se o navegador ou o SO falhar), os dados de navegação não serão excluídos, já que o fechamento do navegador não foi o resultado do usuário fechar todas as janelas.";
ClipboardAllowedForUrls.pfm_title = "Permitir a área de transferência nesses sites";
ClipboardAllowedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que podem usar a permissão do site para a área de transferência. Essa ação não inclui todas as operações da área de transferência ou origens que correspondem aos padrões. Por exemplo, os usuários ainda poderão colar usando atalhos do teclado, porque essa opção não é controlada pela permissão do site para a área de transferência.\n\n\nSe a política não tiver definição, DefaultClipboardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
ClipboardBlockedForUrls.pfm_title = "Bloquear a área de transferência nesses sites";
ClipboardBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que não podem usar a permissão do site para a área de transferência. Essa ação não inclui todas as operações da área de transferência ou origens que correspondem aos padrões. Por exemplo, os usuários ainda poderão colar usando atalhos do teclado, porque essa opção não é controlada pela permissão do site para a área de transferência.\n\nSe a política não tiver definição, DefaultClipboardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
CloudManagementEnrollmentMandatory.pfm_title = "Permite a inscrição obrigatória no gerenciamento em nuvem";
CloudManagementEnrollmentMandatory.pfm_description = "Se a política for ativada, o navegador Chrome Enterprise Core vai forçar o registro e impedir o processo de inicialização do Brave em caso de erro.\n\nSe ela for desativada ou deixada sem definição, o registro do navegador Chrome Enterprise Core será opcional e não vai impedir o processo de inicialização do Brave em caso de erro.\n\nA inscrição de políticas da nuvem para o escopo da máquina em computadores usa esta política. Veja mais detalhes em https://support.google.com/chrome/a/answer/9301891.";
CloudManagementEnrollmentToken.pfm_title = "Token de registro da política de nuvem";
CloudManagementEnrollmentToken.pfm_description = "Se a política for definida, o Brave tentará se registrar com o gerenciamento de navegadores do Chrome Enterprise Core. O valor desta política é um token de inscrição que pode ser recuperado pelo Google Admin console.\n\nVeja mais detalhes em https://support.google.com/chrome/a/answer/9301891.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "A política de nuvem do Brave substitui a política da plataforma.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Se a política for ativada, a política de nuvem terá precedência caso haja um conflito com a da plataforma.\n\nSe a política for desativada ou deixada sem definição, a política da plataforma terá precedência caso haja um conflito com a de nuvem.\n\nEsta política obrigatória afeta as políticas de nuvem no escopo da máquina.\n\nEla é específica para o Brave e não afeta o Google Update, porque eles são aplicativos independentes.\nO Google Update tem uma política separada com o mesmo nome.";
CloudUserPolicyMerge.pfm_title = "Ativa a unificação das políticas de nuvem de usuários com políticas no nível da máquina";
CloudUserPolicyMerge.pfm_description = "Se a política for ativada, as políticas associadas a uma conta gerenciada poderão ser mescladas com outras no nível da máquina.\n\nSe ela for desativada ou deixada sem definição, as políticas de nuvem no nível do usuário não poderão ser mescladas com as de outras origens.\n\nApenas políticas originárias de usuários seguros podem ter precedência. Um usuário seguro é afiliado à organização que gerencia o navegador com o Chrome Enterprise Core. Todas as outras políticas do usuário terão precedência por padrão.\n\nAs políticas que precisam ser mescladas também precisam ser definidas na PolicyListMultipleSourceMergeList ou PolicyDictionaryMultipleSourceMergeList. Esta política será ignorada se nenhuma das duas mencionadas acima for configurada.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Permitir que as políticas da nuvem de usuários substituam as políticas do Chrome Browser Cloud Management.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Se a política for ativada, políticas associadas a uma conta gerenciada poderão ter precedência se estiverem em conflito com políticas do navegador Chrome Enterprise Core.\n\nSe ela for desativada ou deixada sem definição, as políticas de nuvem do usuário terão prioridade por padrão.\n\nApenas políticas originárias de usuários seguros podem ter precedência. Um usuário seguro é afiliado à organização que gerencia o navegador com o Chrome Enterprise Core. Todas as outras políticas do usuário terão precedência por padrão.\n\nA política pode ser combinada com CloudPolicyOverridesPlatformPolicy. Se ambas as políticas forem ativadas, as políticas de nuvem do usuário também poderão ter precedência sobre as políticas em conflito da plataforma.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Ativar avisos de segurança para sinalizações de linha de comando";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, os avisos de segurança vão aparecer apenas quando flags de linha de comando potencialmente perigosas forem usadas para iniciar o Chrome.\n\nSe a política for definida como \"Desativada\", os avisos de segurança não vão aparecer quando o Chrome for iniciado com flags de linha de comando potencialmente perigosas.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
ComponentUpdatesEnabled.pfm_title = "Ativar atualizações de componentes no Brave";
ComponentUpdatesEnabled.pfm_description = "Se a política for ativada ou deixada sem definição, as atualizações para todos os componentes no Brave serão ativadas.\n\nSe a política for desativada, as atualizações dos componentes também serão desativadas. No entanto, alguns componentes estarão isentos desta política: as atualizações de componentes que não contenham código executável e sejam essenciais para a segurança do navegador não serão desativadas.\nEntre os exemplos desses componentes estão as listas de revogação de certificados e os filtros de recursos secundários.";
CompressionDictionaryTransportEnabled.pfm_title = "Ativar o suporte ao transporte do dicionário por compactação";
CompressionDictionaryTransportEnabled.pfm_description = "Esse recurso permite o uso de codificações de conteúdo específicas do dicionário no cabeçalho de solicitação Accept-Encoding (\"sbr\" e \"zst-d\") quando os dicionários estão disponíveis para uso.\n\nSe a política for ativada ou deixada sem definição, o Brave vai aceitar conteúdo da Web usando o recurso de transporte do dicionário por compactação.\nSe a política for desativada, esse recurso será desativado.";
CookiesAllowedForUrls.pfm_title = "Permitir cookies nestes sites";
CookiesAllowedForUrls.pfm_description = "Permite definir uma lista com padrões de URL que especificam quais sites podem definir cookies.\n\nOs padrões de URL podem ser um único URL indicando que o site pode usar cookies em todos os sites de nível superior.\n\nOs padrões também podem ser dois URLs separados por vírgula. O primeiro caso especifica o site que precisa de permissão para usar cookies. O segundo especifica o site de nível superior em que o primeiro valor tem que ser aplicado.\n\nSe você usar um par de URLs, o primeiro valor terá suporte a *, mas o segundo não. O uso de * no primeiro valor indica que todos os sites podem usar cookies quando o segundo URL é o site de nível superior.\n\nSe esta política não for definida, o valor padrão global será usado para todos os sites. Esse valor será o mesmo das políticas DefaultCookiesSetting ou BlockThirdPartyCookies, caso estejam definidas, ou da configuração pessoal do usuário.\n\nConsulte também as políticas CookiesBlockedForUrls e CookiesSessionOnlyForUrls. Não pode haver padrões de URL conflitantes entre essas três políticas, já que não foi especificado qual delas tem prioridade.\n\nPara saber mais sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
CookiesBlockedForUrls.pfm_title = "Bloquear cookies nestes sites";
CookiesBlockedForUrls.pfm_description = "Se a política for definida, você poderá fazer uma lista de padrões de URL que especificam sites que não podem configurar cookies.\n\nSe a política ficar sem definição, DefaultCookiesSetting será usada para todos os sites, se ela estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nEmbora nenhuma política específica tenha precedência, consulte CookiesAllowedForUrls e CookiesSessionOnlyForUrls. Os padrões de URL dentre essas 3 políticas não podem ser conflitantes.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
CookiesSessionOnlyForUrls.pfm_title = "Limita cookies de URLs correspondentes à sessão atual";
CookiesSessionOnlyForUrls.pfm_description = "A menos que a política RestoreOnStartup seja definida para restaurar permanentemente URLs de sessões anteriores, a definição de CookiesSessionOnlyForUrls vai permitir que você faça uma lista de padrões de URL que especificam sites que podem e sites que não podem configurar cookies para uma sessão.\n\nSe a política ficar sem definição, DefaultCookiesSetting será usada para todos os sites, se ela estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada. URLs não incluídos nos padrões especificados também resultam no uso de padrões.\n\nEmbora nenhuma política específica tenha precedência, consulte CookiesBlockedForUrls e CookiesAllowedForUrls. Os padrões de URL dentre essas 3 políticas não podem ser conflitantes.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
CpuPerformanceTierOverride.pfm_title = "Substituição do nível de desempenho da CPU";
CpuPerformanceTierOverride.pfm_description = "Definir esta política permite que as empresas substituam o valor retornado pela\nCPU Performance API (ou seja,\nnavigator.cpuPerformance,\nconsulte https://github.com/WICG/cpu-performance para saber mais detalhes).\n\nSe esta política for ativada, o valor de\nnavigator.cpuPerformance\nserá substituído pelo valor especificado. Se a política não for ativada,\no cálculo padrão do nível de desempenho será usado.\n\nOs valores possíveis para esta política são de 0 a 4.";
CreatePasskeysInICloudKeychain.pfm_title = "Controle se a criação de chaves de acesso usará as Chaves do iCloud por padrão.";
CreatePasskeysInICloudKeychain.pfm_description = "O Brave pode direcionar\nsolicitações de criação de chaves de acesso / WebAuthn diretamente às Chaves do iCloud no macOS 13.5\nou versões mais recentes. Se a sincronização das Chaves do iCloud ainda não tiver sido ativada,\no usuário terá que fazer login com o iCloud ou ativar a sincronização das\nChaves do iCloud.\n\nSe a política for definida como \"false\" (falsa), as Chaves do iCloud não serão usadas como padrão,\ne o comportamento anterior (de criação da credencial no perfil do Brave) poderá\nser usado. Os usuários ainda vão poder selecionar as Chaves do iCloud como opção e\nverificar as credenciais das Chaves do iCloud ao fazer login.\n\nSe a política for definida como \"true\" (verdadeira), as Chaves do iCloud serão o padrão\nsempre que a solicitação do WebAuthn for compatível com essa opção.\n\nSe a política não for definida, o padrão vai depender de fatores como\na ativação do iCloud Drive e se o usuário usou ou\ncriou recentemente uma credencial no\nperfil Brave.";
CreateThemesSettings.pfm_title = "Configurações para criar temas com IA";
CreateThemesSettings.pfm_description = "0 - Permitir a criação de temas e melhorar os modelos de IA.\n1 - Permitir a criação de temas sem melhorar os modelos de IA.\n2 - Não permitir a criação de temas.\nA criação de temas com IA permite que os usuários criem temas/planos de fundo personalizados pré-selecionando em uma lista de opções.\n\nSe ela for definida como 0, o recurso será habilitado e os dados relevantes poderão ser usados pelo Google para melhorar os modelos de IA. Esses dados podem incluir comandos, entradas, saídas, materiais de origem e feedback por escrito, dependendo do recurso. Eles também podem ser analisados por humanos para melhorar os modelos de IA. O valor padrão é 0, exceto quando indicado de outra forma abaixo.\n\nSe a política for definida como 1, o recurso será habilitado, mas o Google não poderá usar o conteúdo dos usuários (incluindo comandos, entradas, saídas, materiais de origem e feedback por escrito) para melhorar os modelos. 1 é o valor padrão para usuários corporativos gerenciados pelo Google Admin console e contas de ensino gerenciadas pelo Google Workspace.\n\nSe ela for definida como 2, o recurso não será habilitado.\n\nSe for deixada sem definição, o comportamento será determinado pela política GenAiDefaultSettings.\n\nPara mais informações sobre como tratar dados de recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
DNSInterceptionChecksEnabled.pfm_title = "Verificação de interceptações de DNS ativada";
DNSInterceptionChecksEnabled.pfm_description = "Esta política configura um interruptor local que pode ser usado para desativar verificações de interceptação de DNS. As verificações tentam descobrir se o navegador está por trás de um proxy que redireciona nomes de host desconhecidos.\n\nEssa detecção pode não ser necessária em um ambiente empresarial em que a configuração de rede é conhecida, já que isso causa certo tráfego HTTP e DNS na inicialização e a cada mudança de configuração do DNS.\n\nQuando essa política não for definida ou estiver ativada, as verificações de interceptação de DNS são executadas. Quando a política é desativada explicitamente, elas não são executadas.";
DataURLWhitespacePreservationEnabled.pfm_title = "Preservação de espaços em branco do DataURL para todos os tipos de mídia";
DataURLWhitespacePreservationEnabled.pfm_description = "Esta política fornece uma desativação temporária para mudanças na forma como o Chrome lida com espaços em branco em URLs de data.\nAnteriormente, os espaços em branco eram mantidos apenas se o tipo de mídia de nível superior fosse text ou tivesse a string de tipo de mídia xml.\nAgora, os espaços em branco serão preservados em todos os URLs de dados, independente do tipo de mídia.\n\nSe esta política for definida como verdadeira ou deixada sem definição, o novo comportamento será ativado.\n\nSe ela for definida como falsa, o comportamento antigo será ativado.";
DataUrlInSvgUseEnabled.pfm_title = "Suporte ao URL dos dados para SVGUseElement.";
DataUrlInSvgUseEnabled.pfm_description = "Esta política ativa o suporte a URL de dados para SVGUseElement, que será desativado\npor padrão a partir da versão M119.\nSe ela for ativada, os URLs de dados vão continuar funcionando no SVGUseElement.\nSe for desativada ou deixada sem definição, os URLs de dados não vão funcionar no SVGUseElement.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Ativar origens opacas para URLs de dados em Web Workers";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Controla se os Web Workers criados a partir de URLs de dados recebem uma origem opaca exclusiva.\n\nOs Web Workers podem ser criados usando um URL de dados que contém o script do worker. Antes, esses workers herdavam a origem da página que os criou, permitindo que eles acessassem o mesmo armazenamento local, cookies e outros dados vinculados à origem. Para melhorar a segurança e manter a conformidade com a especificação HTML, o Chrome vai mudar o comportamento padrão no marco 149. Agora, os workers criados com URLs de dados terão uma origem única e opaca. Isso os isola dos dados da página do criador.\n\nSe essa política for ativada ou deixada sem definição, o novo comportamento padrão (mais seguro) será usado, e os Web Workers criados com URLs de dados terão uma origem opaca exclusiva.\n\nSe essa política for desativada, o Chrome vai reverter para o comportamento legado, e os Web Workers criados com URLs de dados vão herdar a origem do criador. Isso permite que os administradores resolvam temporariamente problemas de compatibilidade se os aplicativos internos forem interrompidos devido à mudança de segurança.\n\nEssa política é temporária e será removida na etapa 157.";
DefaultAutomaticDownloadsSetting.pfm_title = "Definir o download automático como o padrão";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Permitir que os sites façam download de vários arquivos automaticamente\n2 - Não permitir que nenhum site faça download de vários arquivos automaticamente\n3 - Perguntar sempre que um site quiser baixar vários arquivos de forma automática\nSe a política for definida como 1, os sites poderão baixar vários arquivos de forma automática. Se ela for definida como 2, essa permissão será negada. É possível definir a política para perguntar sempre que um site quiser baixar vários arquivos de forma automática.\n\nSe a política não for definida, a AskAutomaticDownloads será aplicada, mas os usuários poderão mudar essa configuração.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Definir o Brave como meu navegador padrão";
DefaultBrowserSettingEnabled.pfm_description = "Se a política for definida como verdadeira, o Brave precisará sempre verificar se é o navegador padrão na inicialização e, se possível, registrar-se automaticamente. Se a política for definida como falsa, oBrave deixará de verificar se ele é o navegador padrão e os controles do usuário para essa opção serão desativados.\n\nSe a política não for definida, o Brave permitirá que os usuários controlem se ele será o padrão ou não e, caso não seja, se as notificações do usuário serão exibidas.\n\nObservação: para administradores do Microsoft®Windows®, a ativação dessa configuração só funciona em máquinas com o Windows 7. Para versões mais recentes, é necessário implantar um arquivo de \"associações de aplicativo padrão\", que torna o Brave o gerenciador dos protocolos https e http e, opcionalmente, o protocolo ftp e outros formatos de arquivo. Consulte a Ajuda do Google Chrome (https://support.google.com/chrome?p=make_chrome_default_win).";
DefaultClipboardSetting.pfm_title = "Configuração padrão da área de transferência";
DefaultClipboardSetting.pfm_description = "2 - Não permitir que sites usem a permissão do site para a área de transferência\n3 - Permitir que sites peçam ao usuário para dar a permissão do site para a área de transferência\nSe for definida com o valor 2, essa política vai impedir os sites de usarem a permissão do site para a área de transferência. Se ela for definida com o valor 3 ou deixada sem definição, os usuários vão poder mudar a configuração e decidir se as APIs de área de transferência ficam disponíveis quando um sites quer usar uma delas.\n\nEsta política pode ser substituída por padrões de URL específicos usando as políticas ClipboardAllowedForUrls e ClipboardBlockedForUrls.\n\nA política só afeta as operações da área de transferência controladas pela permissão do site para a área de transferência, e não as gravações limpas da área de transferência ou operações de copiar e colar confiáveis.";
DefaultCookiesSetting.pfm_title = "Configuração de cookies padrão";
DefaultCookiesSetting.pfm_description = "1 - Permitir que todos os sites definam dados locais\n2 - Não permitir que nenhum site defina dados locais\n4 - Manter cookies enquanto durar a sessão\nA menos que a política RestoreOnStartup seja definida para restaurar permanentemente URLs de sessões anteriores, a definição de CookiesSessionOnlyForUrls permitirá que você faça uma lista de padrões de URL que especificam sites que podem e sites que não podem configurar cookies para uma sessão.\n\nSe a política ficar sem definição, a DefaultCookiesSetting será usada para todos os sites, se ela estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada. URLs não incluídos nos padrões especificados também resultam no uso de padrões.\n\nEmbora nenhuma política específica tenha precedência, consulte CookiesBlockedForUrls e CookiesAllowedForUrls. Os padrões de URL dentre essas três políticas não podem ser conflitantes.";
DefaultDownloadDirectory.pfm_title = "Definir diretório de download padrão";
DefaultDownloadDirectory.pfm_description = "Se a política for definida, o diretório padrão do Chrome para salvar arquivos de download vai ser alterado, mas o usuário poderá mudar isso.\n\nSe a política não for definida, o Chrome usará o diretório padrão específico da plataforma.\n\nEsta política não tem efeito se a política DownloadDirectory estiver definida.\n\nObservação: veja uma lista com as variáveis que podem ser usadas: https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables (link em inglês).";
DefaultFileSystemReadGuardSetting.pfm_title = "Controlar o uso da API File System para leitura";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - Não permitir que nenhum site solicite acesso de leitura de arquivos e diretórios pela API File System\n3 - Permitir que sites peçam ao usuário para conceder permissão de acesso de leitura de arquivos e diretórios com a API File System\nSe a política for definida como \"3\", os sites poderão pedir acesso de leitura de arquivos e diretórios no sistema de arquivos do sistema operacional do host com a API File System. Se for definida como \"2\", o acesso será negado.\n\nSe não for definida, os sites terão permissão para solicitar acesso, mas os usuários poderão mudar essa configuração.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Controlar o uso da API File System para gravação";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - Não permitir que qualquer site solicite acesso de gravação de arquivos ou diretórios\n3 - Permitir que sites peçam ao usuário para conceder acesso de gravação de arquivos e diretórios\nSe a política for definida como \"3\" os sites poderão pedir permissão de acesso de gravação de arquivos e diretórios no sistema de arquivos do sistema operacional do host. Se for definida como \"2\", o acesso será negado.\n\nSe não for definida, os sites terão permissão para solicitar acesso, mas os usuários poderão mudar essa configuração.";
DefaultGeolocationSetting.pfm_title = "Configuração padrão de geolocalização";
DefaultGeolocationSetting.pfm_description = "1 - Permitir que os sites rastreiem a localização física dos usuários\n2 - Não permitir que nenhum site rastreie a localização física dos usuários\n3 - Perguntar sempre que um site quiser rastrear a localização física dos usuários\nSe a política for definida como 1, os sites poderão rastrear a localização física dos usuários como o estado padrão. Se a política for definida como 2, será negado o rastreamento como padrão. É possível definir a política para perguntar sempre que um site quiser rastrear a localização física dos usuários.\n\nSe a política não for definida, a AskGeolocation será aplicada, mas os usuários poderão mudar essa configuração.";
DefaultIdleDetectionSetting.pfm_title = "Detecção de inatividade";
DefaultIdleDetectionSetting.pfm_description = "1 - Permitir que sites detectem o estado de inatividade sem pedir permissão ao usuário\n2 - Não permitir que sites detectem o estado de inatividade do usuário\n3 - Perguntar sempre que um site quiser detectar o estado de inatividade do usuário\nPermite definir se os sites têm permissão para usar a API Idle Detection.\n\nQuando essa política é definida como 1 (AllowIdleDetection), os sites podem usar a API sem a permissão ao usuário.\n\nQuando ela é definida como 2 (BlockIdleDetection), os sites não podem usar a API, independentemente da permissão do usuário.\n\nQuando ela é definida como 3 (AskIdleDetection) ou deixada sem definição, os sites não podem usar a API sem a permissão do usuário.";
DefaultImagesSetting.pfm_title = "Configuração de imagens padrão";
DefaultImagesSetting.pfm_description = "1 - Permitir que todos os sites exibam todas as imagens\n2 - Não permitir que nenhum site exiba imagens\nSe a política for definida como 1, todos os sites mostrarão imagens. Se ela for definida como 2, as imagens não vão aparecer.\n\nSe não for definida, as imagens serão permitidas, mas os usuários poderão mudar essa configuração.";
DefaultInsecureContentSetting.pfm_title = "Controlar o uso de exceções de conteúdo não seguro";
DefaultInsecureContentSetting.pfm_description = "2 - Não permitir que nenhum site carregue conteúdo misto\n3 - Permitir que os usuários adicionem exceções para liberar conteúdo misto\nPermite definir se os usuários podem adicionar exceções para permitir conteúdo misto em sites específicos.\n\nEsta política pode ser modificada para padrões de URL específicos usando as políticas \"InsecureContentAllowedForUrls\" e \"InsecureContentBlockedForUrls\".\n\nSe esta política não for definida, o usuário poderá adicionar exceções para permitir conteúdo misto ativo e desativar atualizações automáticas para conteúdo misto passivo.";
DefaultJavaScriptJitSetting.pfm_title = "Controlar o uso do JIT do JavaScript";
DefaultJavaScriptJitSetting.pfm_description = "1 - Permitir que sites executem o JIT do JavaScript\n2 - Não permitir que sites executem o JIT do JavaScript\nPermite definir se o Brave executará o mecanismo JavaScript V8 com o compilador JIT (Just In Time) ativado ou não.\n\nSe você desativar o JIT do JavaScript, o Brave poderá renderizar conteúdo da Web mais lentamente, e partes do próprio JavaScript poderão ser desativadas, incluindo o WebAssembly. Se você desativar o JIT do JavaScript, o Brave poderá renderizar conteúdo da Web com uma configuração mais segura.\n\nEsta política pode ser substituída por padrões de URL específicos usando as políticas JavaScriptJitAllowedForSites e JavaScriptJitBlockedForSites.\n\nSe ela não for definida, o JIT do JavaScript será ativado.";
DefaultJavaScriptOptimizerSetting.pfm_title = "Controlar o uso de otimizadores do JavaScript";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Ativar as otimizações avançadas do JavaScript em todos os sites\n2 - Desativar as otimizações avançadas do JavaScript em todos os sites\nPermite definir se o Brave\nvai executar o mecanismo JavaScript V8 com otimizações do JavaScript mais avançadas ativadas.\n\nDesativar as otimizações do JavaScript definindo o valor da política como 2\nsignifica que o Brave poderá renderizar conteúdo da Web\nmais lentamente.\n\nEsta política pode ser substituída por padrões de URL específicos usando as políticas JavaScriptOptimizerAllowedForSites e JavaScriptOptimizerBlockedForSites.\n\nSe ela for deixada sem definição, as otimizações do JavaScript serão ativadas.";
DefaultJavaScriptSetting.pfm_title = "Configuração padrão do JavaScript";
DefaultJavaScriptSetting.pfm_description = "1 - Permitir que todos os sites executem o JavaScript\n2 - Não permitir que nenhum site execute o JavaScript\nSe a política for definida como 1, os sites poderão executar o JavaScript. Se for definida como 2, o JavaScript não será executado.\n\nSe ela não for definida, o JavaScript será executado, mas os usuários poderão mudar essa configuração.";
DefaultLocalFontsSetting.pfm_title = "Configuração padrão de permissão das fontes locais";
DefaultLocalFontsSetting.pfm_description = "2 - Nega a permissão para fontes locais em todos os sites por padrão\n3 - Perguntar sempre que um site quiser uma permissão para fontes locais\nSe a política for definida como BlockLocalFonts (valor 2), por padrão, ela vai negar automaticamente a permissão de fontes locais para sites. Isso limita a capacidade dos sites de ver informações sobre fontes locais.\n\nSe a política for definida como AskLocalFonts (valor 3), por padrão, o usuário vai receber um aviso quando a permissão para fontes locais for solicitada. Se o usuário autorizar, ela vai ampliar a capacidade dos sites de ver informações sobre fontes locais.\n\nSe a política for deixada sem definição, o comportamento padrão será aplicado. Isso significa que os usuários são consultados, mas eles podem mudar essa configuração.";
DefaultNotificationsSetting.pfm_title = "Configuração padrão de notificações";
DefaultNotificationsSetting.pfm_description = "1 - Permitir que os sites exibam notificações da área de trabalho\n2 - Não permitir que nenhum site exiba notificações da área de trabalho\n3 - Perguntar cada vez que um site quiser exibir notificações da área de trabalho\nSe a política for definida como 1, os sites poderão mostrar notificações na área de trabalho. Se a política for definida como 2, as notificações na área de trabalho serão negadas.\n\nSe a política não for definida, a AskNotifications será aplicada, mas os usuários poderão mudar essa configuração.";
DefaultPopupsSetting.pfm_title = "Configuração padrão de pop-ups";
DefaultPopupsSetting.pfm_description = "1 - Permitir que todos os sites exibam pop-ups\n2 - Não permitir que sites mostrem pop-ups\nSe a política for definida como 1, os sites poderão mostrar pop-ups. Se ela for definida como 2, os pop-ups serão negados.\n\nSe a política não for definida, a BlockPopups será aplicada, mas os usuários poderão mudar essa configuração.";
DefaultPrinterSelection.pfm_title = "Regras de seleção de impressora padrão";
DefaultPrinterSelection.pfm_description = "Se a política for definida, as regras serão configuradas para selecionar a impressora padrão no Brave, substituindo as regras padrão. A seleção da impressora ocorre na primeira vez que os usuários tentam imprimir, quando o Brave busca uma impressora correspondente aos atributos especificados. No caso de uma correspondência menos do que perfeita, o Brave pode ser definido para selecionar qualquer impressora correspondente, dependendo da ordem de detecção.\n\nSe a política for deixada sem definição ou for definida com atributos para os quais não há correspondência, a impressora de PDF integrada será o padrão. Se não houver uma impressora de PDF, o Brave não terá padrão.\n\nNo momento, todas as impressoras são classificadas como \"local\". Impressoras conectadas ao Google Cloud Print são consideradas como \"cloud\", mas é mais oferecido suporte ao Google Cloud Print.\n\nObservação: a omissão de um campo significa que todos os valores correspondem a esse campo específico. Por exemplo, não especificar o idPattern significa que a prévia de impressão aceita todos os IDs de impressoras. Os padrões de expressão regular precisam seguir a sintaxe RegExp do JavaScript. As correspondências diferenciam maiúsculas de minúsculas.\nConsulte https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection para ver mais informações sobre esquema e formatação.";
DefaultSearchProviderAlternateURLs.pfm_title = "Lista de URLs alternativos para o provedor de pesquisa padrão";
DefaultSearchProviderAlternateURLs.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderAlternateURLs especificará uma lista de URLs alternativos para extrair termos de pesquisa do mecanismo. Os URLs precisam incluir a string '{searchTerms}'.\n\nSe a DefaultSearchProviderAlternateURLs não for definida, nenhum URL alternativo será usado para extrair termos de pesquisa.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Permitir o acesso à pesquisa do menu de contexto pelo provedor de pesquisa padrão";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "Ativa o uso de um provedor de pesquisa padrão no menu de contexto.\n\nSe esta política for definida como desativada, o item do menu de contexto da pesquisa que depende do provedor de pesquisa padrão não estará disponível.\n\nSe esta política for definida como ativada ou não for definida, o item do menu de contexto para o provedor de pesquisa padrão estará disponível.\n\nO valor da política só é aplicado quando a DefaultSearchProviderEnabled está ativada. Caso contrário, ele não é aplicável.";
DefaultSearchProviderEnabled.pfm_title = "Ativar o provedor de pesquisa padrão";
DefaultSearchProviderEnabled.pfm_description = "Se a política for definida como \"Ativada\", uma pesquisa padrão será realizada quando o usuário digitar um texto na barra de endereço que não seja um URL. Para especificar o provedor de pesquisa padrão, configure o restante das políticas de pesquisa padrão. Se essas políticas forem deixadas em branco, o usuário poderá escolher o provedor padrão. Se a política for definida como \"Desativada\", nenhuma pesquisa será realizada quando o usuário digitar um texto na barra de endereço que não seja um URL. O valor \"Desativado\" não pode ser usado no Google Admin console.\n\nSe você definir a política, ela não poderá ser mudada pelos usuários no Brave. Se ela não for definida, o provedor de pesquisa padrão ficará ativado e o usuário poderá definir a lista de provedores de pesquisa.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
DefaultSearchProviderEncodings.pfm_title = "Codificações do provedor de pesquisa padrão";
DefaultSearchProviderEncodings.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderEncodings especificará as codificações de caracteres compatíveis com o provedor de pesquisa. As codificações são nomes de páginas de código como UTF-8, GB2312 e ISO-8859-1. Elas são testadas na ordem fornecida.\n\nSe a DefaultSearchProviderEncodings não for definida, UTF-8 será usada.";
DefaultSearchProviderImageURL.pfm_title = "Parâmetro que fornece recursos de pesquisa por imagem para o provedor de pesquisa padrão";
DefaultSearchProviderImageURL.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderImageURL especificará o URL do mecanismo de pesquisa usado para a pesquisa de imagens. Se a DefaultSearchProviderImageURLPostParams for definida, as solicitações de pesquisa de imagem utilizarão o método POST.\n\nSe a DefaultSearchProviderImageURL não for definida, nenhuma pesquisa de imagem será utilizada.\n\nSe a pesquisa de imagens usar o método GET, o URL precisará especificar parâmetros\nde imagem usando uma combinação válida destes marcadores:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "Parâmetros para URL de imagens que usa POST";
DefaultSearchProviderImageURLPostParams.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderImageURLPostParams especificará os parâmetros durante a pesquisa de imagem com POST. Ele consiste em pares nome-valor separados por vírgula. Se o valor for um parâmetro modelo, como {imageThumbnail}, ele será substituído pelos dados de miniatura de imagem reais.\n\nSe a DefaultSearchProviderImageURLPostParams não for definida, as solicitações de pesquisa de imagem serão enviadas usando o método GET.\n\nO URL precisa especificar o parâmetro de imagem usando uma combinação válida destes\nmarcadores, dependendo do suporte do provedor de pesquisa:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Palavra-chave do provedor de pesquisa padrão";
DefaultSearchProviderKeyword.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderKeyword especificará a palavra-chave ou o atalho utilizados na barra de endereço para acionar a pesquisa desse provedor.\n\nSe a DefaultSearchProviderKeyword não for definida, nenhuma palavra-chave ativará o provedor de pesquisa.";
DefaultSearchProviderName.pfm_title = "Nome do provedor de pesquisa padrão";
DefaultSearchProviderName.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderName especificará o nome do provedor de pesquisa padrão.\n\nSe a DefaultSearchProviderName não for definida, o nome do host especificado pelo URL de pesquisa será usado.";
DefaultSearchProviderNewTabURL.pfm_title = "URL da página \"Nova guia\" do provedor de pesquisa padrão";
DefaultSearchProviderNewTabURL.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderNewTabURL especificará o URL do mecanismo de pesquisa usado para fornecer uma página \"Nova guia\".\n\nSe a DefaultSearchProviderNewTabURL não for definida, nenhuma página \"Nova guia\" será fornecida.";
DefaultSearchProviderSearchURL.pfm_title = "URL de pesquisa do provedor de pesquisa padrão";
DefaultSearchProviderSearchURL.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderSearchURL especificará o URL do mecanismo de pesquisa usado na pesquisa padrão. O URL precisa incluir a string '{searchTerms}', que é substituída na consulta pelos termos de pesquisa do usuário.\n\nÉ possível especificar o URL de pesquisa do Google como: '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "Parâmetros para URL de pesquisa que usa POST";
DefaultSearchProviderSearchURLPostParams.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderSearchURLPostParams especificará os parâmetros ao pesquisar um URL com POST. Ela consiste em pares de nome-valor separados por vírgula. Se o valor for um parâmetro modelo, como '{searchTerms}', ele será substituído pelos dados dos termos de pesquisa reais.\n\nSe a DefaultSearchProviderSearchURLPostParams não for definida, as solicitações de pesquisa serão enviadas usando o método get.";
DefaultSearchProviderSuggestURL.pfm_title = "URL sugerido do provedor de pesquisa padrão";
DefaultSearchProviderSuggestURL.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderSuggestURL especificará o URL do mecanismo que fornecerá sugestões de pesquisa. O URL precisa incluir a string '{searchTerms}', que é substituída na consulta pelos termos de pesquisa do usuário.\n\nÉ possível especificar o URL de pesquisa do Google como: '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "Parâmetros para URL de sugestões que usa POST";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "Se a DefaultSearchProviderEnabled estiver ativada, definir DefaultSearchProviderSuggestURLPostParams especificará os parâmetros durante a pesquisa sugerida com POST. Ele consiste em pares nome-valor separados por vírgula. Se o valor for um parâmetro modelo, como '{searchTerms}', ele será substituído pelos dados dos termos de pesquisa reais.\n\nSe a DefaultSearchProviderSuggestURLPostParams não for definida, as solicitações de pesquisa sugerida serão enviadas usando o método get.";
DefaultSensorsSetting.pfm_title = "Configuração padrão de sensores";
DefaultSensorsSetting.pfm_description = "1 - Permite que os sites acessem sensores\n2 - Não permitir o acesso de nenhum site aos sensores\n3 - Perguntar sempre que um site quiser acessar sensores\nSe a política for definida como 1, os sites poderão acessar e usar sensores, como os de luz e movimento. Se for definida como 2, o acesso aos sensores será negado. Quando a política estiver definida como 3, o usuário será questionado sempre que um site solicitar acesso aos sensores (caso a flag de recurso de três estados esteja ativada); do contrário, o acesso aos sensores será permitido por padrão.\n\nCaso a política não seja definida, AllowSensors será aplicada, mas os usuários poderão mudar essa configuração.";
DefaultSerialGuardSetting.pfm_title = "Controlar o uso da API Serial";
DefaultSerialGuardSetting.pfm_description = "2 - Não permitir que nenhum site solicite acesso a portas seriais por meio da API Serial\n3 - Permitir que os sites peçam ao usuário para conceder acesso a uma porta serial\nSe a política for definida como 3, os sites poderão solicitar acesso a portas seriais. Se for definida como 2, os sites não poderão acessar portas seriais.\n\nSe não for definida, os sites terão permissão para solicitar acesso, mas os usuários poderão mudar essa configuração.";
DefaultWebBluetoothGuardSetting.pfm_title = "Controla o uso da API Web Bluetooth";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - Não permite que nenhum site solicite acesso a dispositivos Bluetooth por meio da API Web Bluetooth\n3 - Permitir que os sites peçam ao usuário para conceder acesso a um dispositivo Bluetooth próximo\nSe a política for definida como 3, os sites solicitarão acesso a dispositivos Bluetooth que estiverem por perto. Se a política for definida como 2, o acesso a dispositivos Bluetooth que estiverem por perto será negado.\n\nSe não for definida, os sites terão permissão para solicitar acesso, mas os usuários poderão mudar essa configuração.";
DefaultWebHidGuardSetting.pfm_title = "Controlar o uso da API WebHID";
DefaultWebHidGuardSetting.pfm_description = "2 - Não permitir que nenhum site solicite acesso a dispositivos HID pela API WebHID\n3 - Permitir que sites peçam ao usuário para conceder acesso ao dispositivo HID\nSe a política for definida como \"3\", os sites vão poder pedir acesso aos dispositivos HID. Se a política for definida como \"2\", o acesso a dispositivos HID vai ser negado.\n\nSe não for definida, os sites têm permissão para solicitar acesso, mas os usuários podem mudar essa configuração.\n\nEsta política pode ser substituída por padrões de url específicos usando as políticas WebHidAskForUrls e WebHidBlockedForUrls.";
DefaultWebUsbGuardSetting.pfm_title = "Controla o uso da API WebUSB";
DefaultWebUsbGuardSetting.pfm_description = "2 - Não permite que nenhum site solicite acesso a dispositivos USB por meio da API WebUSB\n3 - Permitir que os sites peçam ao usuário para conceder acesso a um dispositivo USB conectado\nSe a política for definida como 3, os sites poderão solicitar acesso a dispositivos USB conectados. Se ela for definida como 2, será negado o acesso a dispositivos USB conectados.\n\nSe não for definida, os sites terão permissão para solicitar acesso, mas os usuários poderão mudar essa configuração.";
DefaultWindowManagementSetting.pfm_title = "Configuração padrão da permissão de gerenciamento de janelas";
DefaultWindowManagementSetting.pfm_description = "2 - Nega a permissão para gerenciamento de janelas em todos os sites por padrão\n3 - Perguntar sempre que um site quiser uma permissão para posicionamento de janelas\nSe a política for definida como BlockWindowManagement (valor 2), por padrão, a permissão a sites para gerenciamento de janelas será automaticamente negada. Isso vai limitar a capacidade dos sites de acessar informações sobre as telas do dispositivo e de usar essas informações para abrir e posicionar janelas ou solicitar a tela cheia em casos específicos.\n\nSe a política for definida como AskWindowManagement (valor 3), por padrão, o usuário receberá um aviso quando a permissão para gerenciamento de janelas for solicitada. Se o usuário conceder a permissão, ela vai ampliar a capacidade dos sites de acessar informações sobre as telas do dispositivo e usar essas informações para abrir e posicionar janelas ou solicitar a tela cheia em casos específicos.\n\nSe a política for deixada sem definição, a AskWindowManagement vai ser aplicada, mas o usuário poderá mudar essa configuração.\n\nIsso substitui a política DefaultWindowPlacementSetting descontinuada.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Ativar a exclusão de senhas não descriptografáveis";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Esta política controla se o gerenciador de senhas integrado pode excluir senhas não descriptografáveis do banco de dados. Isso é necessário para restaurar a funcionalidade completa do gerenciador de senhas integrado, mas pode incluir uma perda permanente de dados. Se for possível corrigir os valores de senhas não descriptografáveis para que possam ser descriptografados, geralmente será necessário que o usuário realize ações complexas.\n\nSe a política for ativada ou não for definida, as senhas não descriptografáveis salvas no Gerenciador de senhas integrado do usuário serão perdidas. As senhas que ainda estiverem em um estado funcional não serão modificadas.\n\nSe a política for desativada, os dados do gerenciador de senhas dos usuários vão continuar intactos, mas a funcionalidade será interrompida.\n\nSe a política for definida, os usuários não poderão mudá-la no Brave.";
DesktopSharingHubEnabled.pfm_title = "Ativar o compartilhamento da área de trabalho na omnibox e no menu de três pontos";
DesktopSharingHubEnabled.pfm_description = "Se a política for definida como verdadeira ou deixada sem definição, os usuários poderão compartilhar ou salvar a página da Web atual usando ações do hub de compartilhamento da área de trabalho. Esse hub pode ser acessado por um ícone da omnibox ou pelo menu de três pontos.\n\nSe a política for definida como falsa, o ícone de compartilhamento será removido da omnibox, assim como a entrada do menu de três pontos.";
DevToolsGenAiSettings.pfm_title = "Configurações dos Recursos de IA Generativa do Chrome DevTools";
DevToolsGenAiSettings.pfm_description = "0 - Permitir Recursos de IA Generativa do Chrome DevTools e aprimorar os modelos de IA.\n1 - Permitir os Recursos de IA Generativa do Chrome DevTools sem aprimorar os modelos de IA.\n2 - Não permitir os Recursos de IA Generativa do Chrome DevTools.\nEsses recursos no Chrome DevTools usam modelos de IA generativa para dar mais informações de depuração. Para usá-los, o Brave precisa coletar dados, como mensagens de erro, stack traces, snippets de código e solicitações de rede, e enviar essas informações a um servidor do Google, que executa um modelo de IA generativa. O corpo da resposta ou a autenticação e os cabeçalhos de cookie em solicitações de rede não são incluídos nos dados enviados ao servidor.\n\nSe a política for definida como 0, o recurso será habilitado e os dados relevantes poderão ser usados pelo Google para aprimorar os modelos de IA. Esses dados podem incluir comandos, entradas, respostas, materiais de fonte e feedback por escrito, dependendo do recurso. Eles também podem ser analisados por humanos para aperfeiçoar os modelos de IA. O valor padrão é 0, exceto quando indicado de outra forma abaixo.\n\nSe a política for definida como 1, o recurso será habilitado, mas o Google não poderá usar o conteúdo dos usuários (incluindo comandos, entradas, respostas, materiais de fonte e feedback por escrito) para aprimorar os modelos. 1 é o valor padrão para usuários corporativos gerenciados pelo Google Admin console e contas de ensino gerenciadas pelo Google Workspace.\n\nSe a política for definida como 2, o recurso não será habilitado.\n\nSe não for definida, o comportamento será determinado pela política GenAiDefaultSettings.\n\nOs recursos da IA generativa do Chrome DevTools incluem:\n\n– Console Insights: explica as mensagens do console e oferece sugestões para corrigir erros.\n\n– Assistência de IA no Chrome DevTools: ajuda a explicar os estilos CSS (desde a versão 131), as solicitações de rede, o desempenho e os arquivos (todos desde a versão 132).\n\nPara mais informações sobre como tratar dados de recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Ativar os perfis do Google Developer Program na ferramenta Chrome DevTools";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Ativar a integração do Google Developer Program na ferramenta Chrome DevTools.\n1 - Ativar a integração do Google Developer Program na ferramenta Chrome DevTools, mas sem compartilhar o uso dela (para conceder selos).\n2 - Não ativar a integração com o Google Developer Program na ferramenta Chrome DevTools.\nEsta política controla a integração do Google Developer Program com o Chrome DevTools. O perfil do usuário no Google Developer Program é mostrado no Chrome DevTools, e os usuários recebem selos por realizar ações específicas no Chrome DevTools.\n\nDefinir a política como 0 (\"Ativada\") ou não definir nenhum valor permite a integração do Google Developer Program com o Chrome DevTools e o compartilhamento do uso do Chrome DevTools para conceder selos.\n\nSe a política for definida como 1 (\"Ativada sem selos\"), a integração do Google Developer Program com o Chrome DevTools será permitida, mas o compartilhamento do uso do Chrome DevTools com o Google Developer Program não será. Nenhum selo será concedido.\n\nSe a política for definida como 2 (\"Desativada\"), a integração do Google Developer Program com o Chrome DevTools não será permitida.";
DeveloperToolsAvailability.pfm_title = "Controlar onde as Chrome DevTools podem ser usadas";
DeveloperToolsAvailability.pfm_description = "0 - Não permitir o uso das Chrome DevTools em extensões e apps instalados por uma política da empresa ou (da versão 114 em diante e se o usuário for gerenciado) extensões integradas ao navegador. Permitir o uso das Chrome DevTools em outros contextos\n1 - Permitir uso do Chrome DevTools\n2 - Não permitir o uso das Chrome DevTools\nSe a política for definida como 0 (o padrão), você poderá acessar as Chrome DevTools e o Console JavaScript, mas não no contexto de extensões instaladas por uma política da empresa ou (da versão 114 em diante e se o usuário for gerenciado) extensões integradas ao navegador. Se ela for definida como 1, você poderá acessar as Chrome DevTools e o Console JavaScript em todos os contextos, inclusive o das extensões instaladas pela política da empresa. Se ela for definida como 2, não será possível acessar as Chrome DevTools nem inspecionar elementos de sites.\n\nEssa definição também desativa atalhos de teclado e entradas do menu de contexto ou do menu para abrir as Chrome DevTools ou o Console JavaScript.\n\nA partir da versão 99 do Brave, essa configuração também vai controlar pontos de entrada para o recurso \"Ver código-fonte da página\". Se a política foi definida como \"DeveloperToolsDisallowed\" (valor 2), os usuários não poderão acessar a visualização do código-fonte pelo atalho do teclado nem pelo menu de contexto. Para bloquear totalmente a visualização do código-fonte, também é preciso adicionar \"view-source:*\" à política URLBlocklist.\n\nA partir da versão 119 do Brave, essa configuração também controla se o modo de desenvolvedor para App Isolado da Web pode ser ativado e usado.\n\nA partir da versão 128 do Brave, essa configuração não vai controlar o modo de desenvolvedor na página de extensões se a política ExtensionDeveloperModeSettings estiver definida.\n\nEsta política afeta as Chrome DevTools, o acesso direto ao Chrome DevTools Protocol (CDP) (por exemplo, quando iniciado com --remote-debugging-port ou --remote-debugging-pipe) e o acesso ao CDP pelas APIs chrome.debugger. Tanto esta política quanto a RemoteDebuggingAllowed são aplicadas: a RemoteDebuggingAllowed controla se a depuração remota pode ser iniciada, enquanto esta política restringe se destinos individuais podem ser inspecionados mesmo quando a depuração remota está em execução.\n\nAs políticas DeveloperToolsAvailabilityAllowlist e DeveloperToolsAvailabilityBlocklist têm precedência sobre esta política. A disponibilidade das Chrome DevTools é determinada na seguinte ordem de precedência:\n\n1. Se um URL corresponder a um padrão na política DeveloperToolsAvailabilityAllowlist, as Chrome DevTools serão permitidas.\n2. Se a política DeveloperToolsAvailabilityAllowlist estiver definida e a DeveloperToolsAvailabilityBlocklist não estiver, qualquer URL que não aparece na lista de permissões será bloqueado.\n3. Se um URL corresponder a um padrão na política DeveloperToolsAvailabilityBlocklist, as Chrome DevTools serão bloqueadas.\n4. Se nenhuma política for definida ou se um URL não corresponder a nenhuma lista, esta política (DeveloperToolsAvailability) será usada como mecanismo substituto.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Lista de padrões de URL em que o Chrome DevTools pode ser aberto";
DeveloperToolsAvailabilityAllowlist.pfm_description = "Esta política pode ser usada para permitir o Chrome DevTools em URLs específicos.\n\nA disponibilidade do Chrome DevTools é avaliada no nível do destino. Os padrões de URL são comparados ao URL de cada destino que está sendo inspecionado, como o frame principal de uma página, um subframe incorporado, uma extensão ou um aplicativo da web. O comportamento resultante depende de a política DeveloperToolsAvailabilityBlocklist também estar definida.\n\nSe esta política estiver definida e a DeveloperToolsAvailabilityBlocklist não, o URL de um destino precisará corresponder a um padrão nesta lista de permissões para que o Chrome DevTools seja permitido para esse destino. Se o URL de um destino não corresponder a esta lista de permissões, o Chrome DevTools será bloqueado para esse destino. Por exemplo, um subframe com um URL que não está na lista de permissões não pode ser inspecionado, mas a página principal permanece inspecionável caso o URL dela esteja na lista. Para informações sobre o formato do URL, consulte https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSe tanto esta como a DeveloperToolsAvailabilityBlocklist estiverem definidas, a lista de permissões terá precedência. Se um URL de destino corresponder a um padrão nesta lista de permissões, ele será permitido, mesmo que também corresponda a um padrão na lista de bloqueio. Se corresponder a um padrão nesta lista de bloqueio, mas não na lista de permissões, o URL será bloqueado. Se um URL de destino não corresponder a nenhuma delas, a política DeveloperToolsAvailability será usada como substituta.\n\nSe esta política for deixada sem definição, a disponibilidade do Chrome DevTools será determinada pelas políticas DeveloperToolsAvailabilityBlocklist e DeveloperToolsAvailability.\n\nCuringas genéricos para hosts (ou seja, \"*\" ou \"[*]\") não são permitidos. Use a política DeveloperToolsAvailability para ativar o recurso globalmente.\n\nEsta política afeta as Chrome DevTools, o acesso direto ao Chrome DevTools Protocol (CDP) (por exemplo, quando iniciado com --remote-debugging-port ou --remote-debugging-pipe) e o acesso ao CDP pelas APIs chrome.debugger. Tanto esta política quanto a RemoteDebuggingAllowed são aplicadas: a RemoteDebuggingAllowed controla se a depuração remota pode ser iniciada, enquanto esta política restringe se destinos individuais podem ser inspecionados mesmo quando a depuração remota está em execução.\n\nEsta política tem um limite de 1.000 entradas.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Lista de padrões de URL com o Chrome DevTools bloqueado";
DeveloperToolsAvailabilityBlocklist.pfm_description = "Esta política pode ser usada para bloquear o Chrome DevTools em URLs específicos. Para obter informações sobre o formato do URL, consulte https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nA disponibilidade do Chrome DevTools é avaliada no nível do destino. Os padrões de URL são comparados ao URL de cada destino que está sendo inspecionado, como o frame principal de uma página, um subframe incorporado, uma extensão ou um aplicativo da web. O comportamento resultante depende de a política DeveloperToolsAvailabilityAllowlist também estar definida.\n\nSe esta política estiver definida e a DeveloperToolsAvailabilityAllowlist não estiver, o URL de um destino que corresponder a um padrão nesta lista de bloqueio vai bloquear o Chrome DevTools para esse destino. Por exemplo, um subframe com um URL que corresponda à lista de bloqueio não pode ser inspecionado, mas a página principal continua inspecionável caso o URL dela não esteja na lista. Se o URL de um destino não corresponder a nenhum padrão, a disponibilidade será determinada pela política DeveloperToolsAvailability.\n\nSe tanto esta como a DeveloperToolsAvailabilityAllowlist estiverem definidas, a lista de permissões terá precedência. Se o URL de um destino corresponder a um padrão na lista de permissões, ele será permitido, mesmo que também corresponda a um padrão nesta lista de bloqueio. Se corresponder a um padrão nesta lista de bloqueio, mas não na lista de permissões, o URL será bloqueado. Se um URL de destino não corresponder a nenhuma delas, a política DeveloperToolsAvailability será usada como substituta.\n\nSe esta política for deixada sem definição, a disponibilidade do Chrome DevTools será determinada pelas políticas DeveloperToolsAvailabilityAllowlist e DeveloperToolsAvailability.\n\nEsta política afeta as Chrome DevTools, o acesso direto ao Chrome DevTools Protocol (CDP) (por exemplo, quando iniciado com --remote-debugging-port ou --remote-debugging-pipe) e o acesso ao CDP pelas APIs chrome.debugger. Tanto esta política quanto a RemoteDebuggingAllowed são aplicadas: a RemoteDebuggingAllowed controla se a depuração remota pode ser iniciada, enquanto esta política restringe se destinos individuais podem ser inspecionados mesmo quando a depuração remota está em execução.\n\nEsta política tem um limite de 1.000 entradas.";
Disable3DAPIs.pfm_title = "Desativar o suporte a APIs para gráficos 3D";
Disable3DAPIs.pfm_description = "Se a política for definida como verdadeira ou se HardwareAccelerationModeEnabled for definida como falsa, as páginas da Web serão impedidas de acessar a API WebGL.\n\nSe a política for definida como falsa ou deixada sem definição, as páginas da Web poderão usar a API WebGL, mas talvez as configurações padrão do navegador ainda exijam argumentos da linha de comando para usar essas APIs.";
DisableAuthNegotiateCnameLookup.pfm_title = "Desativar consulta CNAME ao negociar a autenticação do Kerberos";
DisableAuthNegotiateCnameLookup.pfm_description = "Ativar a política faz com que a pesquisa CNAME seja ignorada. O nome do servidor é usado conforme inserido ao gerar o SPN do Kerberos.\n\nDesativar a política ou deixá-la sem definição faz com que a pesquisa CNAME determine o nome canônico do servidor ao gerar o SPN do Kerberos.";
DisablePrintPreview.pfm_title = "Desativar visualização da impressão";
DisablePrintPreview.pfm_description = "Se a política for definida como \"Ativada\", o Brave abrirá a caixa de diálogo de impressão do sistema em vez da integrada quando os usuários solicitarem uma impressão.\n\nSe a política for definida como \"Desativada\" ou for deixada sem definição, os comandos de impressão acionarão a tela de visualização de impressão.";
DisableSafeBrowsingProceedAnyway.pfm_title = "Desativa a continuação na página de aviso de \"Navegação segura\"";
DisableSafeBrowsingProceedAnyway.pfm_description = "Se a política for definida como \"Ativada\", os usuários serão impedidos de prosseguir além da página de aviso que o serviço \"Navegação segura\" exibe para o site malicioso. Esta política apenas evita que os usuários prossigam para sites com avisos do \"Navegação segura\", por exemplo, com malware ou de phishing, mas não é aplicada para problemas relacionados a certificados SSL, como certificados inválidos ou vencidos.\n\nSe a política for definida como \"Desativada\" ou não for definida, os usuários poderão prosseguir para o site sinalizado após a exibição do aviso.\n\nLeia mais sobre o \"Navegação segura\" (https://developers.google.com/safe-browsing).";
DisableScreenshots.pfm_title = "Desativar captura de tela";
DisableScreenshots.pfm_description = "Se a política for ativada, não vai ser permitido fazer capturas de tela com os atalhos do teclado\nou as APIs de extensão. Se ela for desativada ou deixada sem definição, será possível fazer capturas de tela.\n\nA partir da versão 154 do Brave, a ativação dessa política também impede que as extensões anexem o depurador usando \"chrome.debugger.attach()\".\n\nNo Microsoft® Windows®, macOS e Linux,\nisso não impede capturas de tela com apps do sistema operacional ou de terceiros.";
DiskCacheDir.pfm_title = "Definir o diretório de cache de disco";
DiskCacheDir.pfm_description = "Com a definição da política, o Brave usará o diretório fornecido para o armazenamento de arquivos em cache, independentemente de o usuário ter especificado ou não a sinalização \"--disk-cache-dir\".\n\nSe ela não for definida, o Brave usará o diretório de cache padrão, mas os usuários poderão mudar isso com a sinalização da linha de comando \"--disk-cache-dir\".\n\nO Brave gerencia o conteúdo do diretório raiz de um volume. Portanto, para evitar a perda de dados ou outros erros, não defina a política para o diretório raiz nem qualquer diretório usado para outros propósitos. Veja as variáveis que podem ser usadas: https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables (link em inglês).";
DiskCacheSize.pfm_title = "Definir o tamanho do disco de cache";
DiskCacheSize.pfm_description = "Definir a política como \"Nenhuma\" faz com que o Brave use o tamanho de cache padrão para o armazenamento de arquivos em cache no disco. Os usuários não podem fazer mudanças.\n\nSe você definir a política, o Brave usará o tamanho de cache fornecido, independentemente dos usuários especificarem ou não a sinalização \"--disk-cache-size\". Valores abaixo de alguns megabytes serão arredondados para cima.\n\nSe a política não for definida, o Brave usará o tamanho padrão. Os usuários podem mudar essa configuração usando a sinalização \"--disk-cache-size\".\n\nObservação: o valor especificado nesta política é usado como uma dica para vários subsistemas de cache no navegador. Portanto, o consumo total real do disco de todos os caches será maior, mas dentro da mesma ordem de magnitude do valor especificado.";
DnsOverHttpsMode.pfm_title = "Controla o modo de DNS sobre HTTPS";
DnsOverHttpsMode.pfm_description = "off - Desativar DNS sobre HTTPS\nautomatic - Ativar DNS sobre HTTPS com substituto inseguro\nsecure - Ativar DNS sobre HTTPS sem substituto inseguro\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "Especifica o modelo de URI do resolvedor DNS sobre HTTPS desejado";
DnsOverHttpsTemplates.pfm_description = "O modelo de URI do resolvedor de DNS sobre HTTPS desejado. Para especificar vários resolvedores de DNS sobre HTTPS, separe os modelos de URI correspondentes com espaços.\n\nSe a política DnsOverHttpsMode estiver definida como \"secure\", esta política precisará ser definida e não poderá estar vazia. No Google Chrome OS, esta política ou a DnsOverHttpsTemplatesWithIdentifiers precisam ser definidas. Caso contrário, a resolução de DNS vai falhar.\n\nSe a DnsOverHttpsMode estiver definida como \"automatic\" e esta política for definida, os modelos de URI especificados vão ser usados. Se esta política for deixada sem definição, os mapeamentos fixados no código serão usados para tentar fazer upgrade do resolvedor de DNS atual do usuário para um resolvedor de DoH operado pelo mesmo provedor.\n\nSe o modelo de URI tiver uma variável dns, as solicitações para o resolvedor vão usar GET. Caso contrário, as solicitações usarão POST.\n\nModelos formatados incorretamente vão ser ignorados.";
DomainReliabilityAllowed.pfm_title = "Permitir relatórios de dados relacionados à confiabilidade do domínio";
DomainReliabilityAllowed.pfm_description = "Se a política for definida como falsa, os relatórios de dados para diagnóstico de confiabilidade do domínio serão desativados e nenhum dado será enviado ao Google.\nSe a política for definida como verdadeira ou for deixada sem definição, esses relatórios vão seguir o comportamento de MetricsReportingEnabled para o Brave ou de DeviceMetricsReportingEnabled para o Google Chrome OS.";
DownloadDirectory.pfm_title = "Definir diretório de download";
DownloadDirectory.pfm_description = "Se a política for definida, o diretório usado para salvar arquivos de download no Chrome vai ser configurado. O diretório fornecido será usado, ainda que o usuário tenha especificado outro diretório ou ativado a sinalização de sempre perguntar o local de download.\n\nEsta política substitui a política DefaultDownloadDirectory.\n\nSe a política não for definida, o Chrome usará o diretório de download padrão e o usuário poderá modificar isso.\n\nNo Google Chrome OS, só é possível definir essa política em diretórios do Google Drive.\n\nObservação: confira uma lista com as variáveis que podem ser usadas (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DownloadRestrictions.pfm_title = "Restrições de downloads";
DownloadRestrictions.pfm_description = "0 - Nenhuma restrição especial (padrão).\n1 - Bloquear downloads maliciosos e tipos de arquivo perigosos.\n2 - Bloquear downloads maliciosos, incomuns ou indesejados e tipos de arquivo perigosos.\n3 - Bloquear todos os downloads.\n4 - Bloquear downloads maliciosos (recomendado).\nSe a política for definida, o usuário não poderá ignorar as decisões de segurança de downloads.\n\nHá muitos tipos de alertas de download no Chrome, que os divide nas categorias abaixo. Saiba mais sobre os vereditos da Navegação segura (https://support.google.com/chrome/?p=ib_download_blocked).\n\n* Malicioso, conforme sinalizado pelo servidor da Navegação segura\n* Incomum ou indesejado, conforme sinalizado pelo servidor da Navegação segura\n* Perigoso (por exemplo, todos os downloads de arquivos SWF e muitos downloads de arquivos EXE)\n\nSe a política for definida, vários subconjuntos dessas categorias serão bloqueados, dependendo do valor:\n\n0: nenhuma restrição especial. Padrão.\n\n1: bloqueia arquivos maliciosos sinalizados pelo servidor da Navegação segura e também bloqueia todos os tipos de arquivo perigosos. Recomendado apenas para UOs/navegadores/usuários com alta tolerância a falsos positivos.\n\n2: bloqueia arquivos maliciosos sinalizados pelo servidor da Navegação segura, bloqueia arquivos incomuns ou indesejados sinalizados pelo servidor da Navegação segura e também bloqueia todos os tipos de arquivo perigosos. Recomendado apenas para UOs/navegadores/usuários com alta tolerância a falsos positivos.\n\n3: bloqueia todos os downloads. Não recomendado, exceto em casos de uso especiais.\n\n4: bloqueia arquivos maliciosos sinalizados pelo servidor da Navegação segura, não bloqueia tipos de arquivo perigosos Recomendado.\n\nObservação: essas restrições são válidas para downloads acionados em conteúdos de páginas da Web e na opção do menu \"Baixar o link\". Elas não são válidas para a opção de baixar a página atualmente mostrada nem de salvar como PDF nas opções de impressão. Leia mais sobre a Navegação segura (https://developers.google.com/safe-browsing).";
EditBookmarksEnabled.pfm_title = "Ativar ou desativar a edição de favoritos";
EditBookmarksEnabled.pfm_description = "Se a política for ativada ou deixada sem definição, os usuários poderão adicionar, remover, mudar ou fazer upload de favoritos.\n\nSe ela for desativada, os usuários não poderão adicionar, remover, mudar ou fazer upload de favoritos. Eles ainda poderão usar os favoritos já existentes.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Incluir porta não padrão no SPN Kerberos";
EnableAuthNegotiatePort.pfm_description = "Ativar a política e inserir uma porta não padrão (ou seja, uma porta diferente de 80 ou 443) a inclui no SPN do Kerberos gerado.\n\nDesativar a política ou deixá-la sem definição faz com que o SPN do Kerberos gerado não inclua uma porta.";
EnableExperimentalPolicies.pfm_title = "Ativa políticas experimentais";
EnableExperimentalPolicies.pfm_description = "Permite que o Brave carregue políticas experimentais.\n\nALERTA: as políticas experimentais não são compatíveis e podem ser modificadas ou removidas sem aviso prévio em uma versão futura do navegador.\n\nUma política experimental pode não ter sido concluída ou ainda ter defeitos conhecidos ou desconhecidos. Ela pode ser modificada ou até removida sem aviso prévio. Ao ativar políticas experimentais, você pode perder dados do navegador ou comprometer sua segurança ou privacidade.\n\nSe uma política não estiver na lista e não tiver sido lançada oficialmente, o valor dela será ignorado nos canais Beta e Stable.\n\nSe uma política estiver na lista, mas não tiver sido lançada oficialmente, o valor dela será aplicado.\n\nEsta política não afeta políticas já lançadas.";
EnableMediaRouter.pfm_title = "Ativar Google Cast";
EnableMediaRouter.pfm_description = "Se a política for definida como ativada ou não for definida, o Google Cast será ativado e poderá ser iniciado pelos usuários no menu de apps, nos menus de contexto da página, nos controles de mídia em sites compatíveis com o Cast e no ícone da barra de ferramentas do Google Cast (se for exibido).\n\nSe a política for definida como desativada, o Google Cast será desativado.";
EnableOnlineRevocationChecks.pfm_title = "Ativar verificações OCSP/CRL on-line";
EnableOnlineRevocationChecks.pfm_description = "Se a política for definida como verdadeira, verificações on-line de OCSP/CRL serão realizadas.\n\nSe a política for definida como falsa ou não for definida, o Brave não fará verificações de revogação on-line no Brave 19 e versões mais recentes.\n\nObservação: as verificações de OCSP/CRL não resultam em nenhum benefício de segurança eficaz.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "Controla quais usuários gerenciados podem definir as políticas ProxyOverrideRules e ProxyProvisioningDomains.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Quando esta política for definida como 0 ou deixada sem definição, as políticas ProxyOverrideRules e ProxyProvisioningDomains serão aplicadas apenas no escopo do usuário para usuários afiliados em um navegador gerenciado.\nSe for definida como 1, as políticas ProxyOverrideRules e ProxyProvisioningDomains serão aplicadas no escopo do usuário, mesmo que ele não seja afiliado.";
EnableUnsafeSwiftShader.pfm_title = "Permitir a substituição do software WebGL usando o SwiftShader";
EnableUnsafeSwiftShader.pfm_description = "Essa política controla se o SwiftShader será usado como substituto do WebGL quando a aceleração de GPU de hardware não estiver disponível.\n\nO SwiftShader era usado para oferecer suporte ao WebGL em sistemas sem aceleração de GPU, como sistemas headless ou máquinas virtuais, mas foi descontinuado devido a problemas de segurança. A partir da versão M139, a criação de contexto do WebGL vai falhar, em vez de usar o SwiftShader. Essa política permite que o navegador ou administrador adie temporariamente a descontinuação.\n\nSe a política for ativada, o SwiftShader será usado como um substituto de software do WebGL.\n\nSe ela for desativada ou deixada sem definição, a criação do contexto do WebGL poderá falhar se a aceleração de GPU de hardware não estiver disponível. As páginas da Web podem apresentar comportamento indevido se não processarem corretamente a falha de criação de contexto do WebGL.\n\nEssa é uma política temporária que será removida no futuro.";
EncryptedClientHelloEnabled.pfm_title = "Ativar Encrypted ClientHello do TLS";
EncryptedClientHelloEnabled.pfm_description = "O Encrypted ClientHello (ECH) é uma extensão do TLS para criptografar campos confidenciais do ClientHello e melhorar a privacidade.\n\nSe esta política for ativada ou deixada sem definição, o Brave vai seguir o processo de lançamento padrão do ECH. Se ela for desativada, o Brave não vai ativar o ECH.\n\nQuando o recurso está ativado, o Brave pode ou não usar o ECH, dependendo do suporte do servidor, da disponibilidade do registro DNS HTTPS ou do status de lançamento.\n\nO ECH é um protocolo em evolução, o que significa que a implementação do Brave está sujeita a mudanças. Assim, esta política é uma medida temporária para controlar a implementação experimental inicial. Ela vai ser substituída por controles finais quando o protocolo for finalizado.";
EnterpriseCustomLabel.pfm_title = "Definir um rótulo corporativo personalizado para um perfil gerenciado";
EnterpriseCustomLabel.pfm_description = "Esta política controla um rótulo personalizado usado para identificar perfis gerenciados. Para perfis gerenciados, esse rótulo vai aparecer ao lado do avatar na barra de ferramentas. O rótulo personalizado não será traduzido.\n\nQuando esta política é aplicada, todas as strings que ultrapassam 16 caracteres são truncadas com \"…\". Evite usar nomes grandes.\n\nEla só pode ser definida como uma política do usuário.\n\nEsta política não terá efeito se a EnterpriseProfileBadgeToolbarSettings for definida como hide_expanded_enterprise_toolbar_badge (valor 1).";
EnterpriseCustomLabelForBrowser.pfm_title = "Definir um rótulo corporativo personalizado para um navegador gerenciado";
EnterpriseCustomLabelForBrowser.pfm_description = "Essa política controla um rótulo personalizado usado para indicar um navegador gerenciado. Em navegadores desse tipo, o rótulo vai aparecer em uma exoneração de responsabilidade sobre gerenciamento no rodapé da página \"Nova guia\". O rótulo personalizado não será traduzido.\n\nEssa política é aplicada apenas a navegadores gerenciados. Portanto, ela não afeta usuários gerenciados em navegadores não gerenciados.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas no Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas no Chrome Enterprise Core.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Permitir que extensões gerenciadas usem a API Enterprise Hardware Platform";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Se a política for definida como verdadeira, as extensões instaladas pela política comercial poderão usar a API Enterprise Hardware Platform.\n\nSe a política for definida como falsa ou não for definida, as extensões não poderão usar essa API.\n\nObservação: essa política também se aplica a extensões de componentes, como a extensão do Hangout Services.";
EnterpriseLogoUrl.pfm_title = "URL do logotipo da empresa para um perfil gerenciado";
EnterpriseLogoUrl.pfm_description = "Um URL de uma imagem que será usada como selo corporativo de um perfil gerenciado. O URL precisa levar a uma imagem.\n\nEla só pode ser definida como uma política do usuário.\n\nRecomendamos usar o favicon (por exemplo, https://www.google.com/favicon.ico) ou um ícone com pelo menos 48 x 48 pixels.";
EnterpriseLogoUrlForBrowser.pfm_title = "URL do logotipo da empresa para um navegador gerenciado";
EnterpriseLogoUrlForBrowser.pfm_description = "Um URL da imagem que será usada como selo corporativo de um navegador gerenciado. O URL precisa levar a uma imagem.\n\nRecomendamos usar o favicon (por exemplo, https://www.google.com/favicon.ico) ou um ícone com pelo menos 48 x 48 pixels.\n\nEssa política é aplicada apenas a navegadores gerenciados. Portanto, ela não afeta usuários gerenciados em navegadores não gerenciados.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas no Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas no Chrome Enterprise Core.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Controla a visibilidade do selo do perfil corporativo na barra de ferramentas";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Mostrar o selo aberto da barra de ferramentas corporativa\n1 - Ocultar o ícone corporativo aberto na barra de tarefas\nPara perfis de trabalho e escola, a barra de ferramentas vai mostrar um rótulo \"Trabalho\" ou \"Escola\" por padrão ao lado do avatar da barra de ferramentas. O rótulo só aparecerá se a conta conectada for gerenciada.\n\nSe esta política for definida como hide_expanded_enterprise_toolbar_badge (valor 1), o selo de empresa será ocultado na barra de ferramentas para um perfil gerenciado.\n\nSe ela for deixada sem definição ou definida como show_expanded_enterprise_toolbar_badge (valor 0), o selo corporativo vai aparecer.\n\nO rótulo pode ser personalizado usando a política EnterpriseCustomLabel.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "Manter os dados de navegação por padrão ao criar um perfil corporativo";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Se esta política for ativada, a opção de manter os dados de navegação existentes ao criar um perfil de trabalho vai ser marcada por padrão.\n\nSe a política for desativada ou deixada sem definição, a opção de manter os dados de navegação existentes ao criar um perfil de trabalho não vai ser marcada por padrão.\n\nSeja qual for o valor, o usuário vai poder decidir se quer ou não manter os dados de navegação existentes ao criar um perfil corporativo.\n\nEsta política não vai ter efeito se a opção de manter os dados de navegação existentes não estiver disponível. Isso acontece quando a separação de perfil corporativo é aplicada de forma rigorosa ou quando os dados são de um perfil já gerenciado.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Configurações do agregador de pesquisa corporativo";
EnterpriseSearchAggregatorSettings.pfm_description = "Essa política permite que os administradores definam um agregador de pesquisa corporativo específico para fornecer recomendações e resultados tanto na omnibox (barra de endereço) quanto na caixa de pesquisa da página \"Nova guia\".\n\nPor padrão, as sugestões de pesquisa corporativa são misturadas e exibidas com as recomendações normais do Brave. No entanto, os usuários podem direcionar suas buscas exclusivamente para o agregador de pesquisa corporativa ao inserir a palavra-chave especificada no campo shortcut com ou sem o prefixo @ (por exemplo, @work), seguida de um espaço ou da tecla Tab na omnibox. No momento, as buscas corporativas específicas (acionadas por palavra-chave) só são compatíveis com a omnibox e não funcionam na caixa de pesquisa da página \"Nova guia\".\n\nEstes campos são obrigatórios: name, shortcut, search_url, suggest_url.\n\nO campo name corresponde ao nome do mecanismo de pesquisa mostrado ao usuário na barra de endereço.\n\nO campo shortcut é a palavra-chave inserida pelo usuário para acionar a pesquisa. O atalho pode incluir palavras e caracteres simples, mas não deve ter espaços nem começar com o símbolo @. Os atalhos precisam ser exclusivos.\n\nO campo search_url especifica o URL em que a pesquisa será feita. Insira o endereço da Web da página de resultados do mecanismo de pesquisa e use '{searchTerms}' no lugar da consulta.\n\nO campo suggest_url informa o URL que fornece sugestões de pesquisa. Uma solicitação POST será feita, e a consulta do usuário será transmitida nos parâmetros POST na chave 'query'.\n\nO campo icon_url especifica o URL de uma imagem que será usada nas sugestões de pesquisa. Um ícone padrão será usado quando esse campo não estiver definido. Recomendamos usar um favicon (por exemplo, https://www.google.com/favicon.ico). Formatos de arquivos de imagem aceitos: JPEG, PNG e ICO.\n\nO campo require_shortcut especifica se a barra de endereço shortcut é necessária para mostrar as recomendações de pesquisa. Se necessário, as sugestões não vão aparecer na caixa de pesquisa da página \"Nova guia\", mas vão continuar sendo exibidas na omnibox (barra de endereço) no modo de pesquisa específica. Se esse campo não for definido, a barra de endereço shortcut não será obrigatória.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.\nConsulte https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings para ver mais informações sobre esquema e formatação.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "Desativar avisos de download com base na extensão do tipo de arquivo para os tipos especificados nos domínios";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Você pode ativar esta política para criar um dicionário de extensões de tipos de arquivo com uma lista de domínios correspondentes que estão isentos dos avisos de download com base na extensão do tipo de arquivo. Isso permite que os admins corporativos bloqueiem avisos de download com base na extensão de tipo para arquivos associados a um domínio listado. Por exemplo, se a extensão \"jnlp\" estiver associada ao \"site1.com\", os usuários não vão receber um aviso ao baixar arquivos \"jnlp\" do \"site1.com\", mas vão receber um aviso baixar arquivos \"jnlp\" do \"site2.com\".\n\nArquivos com extensões especificadas para domínios identificados por esta política ainda estarão sujeitos a avisos de segurança não baseados na extensão do tipo do arquivo, como avisos de download de conteúdo misto e da Navegação segura.\n\nSe a política for desativada ou não estiver configurada, os tipos de arquivo que acionam avisos de download com base na extensão vão mostrar avisos ao usuário.\n\nSe você ativa a política:\n\n* O padrão de URL precisa ser formatado de acordo com https://chromeenterprise.google/policies/url-patterns/.\n\n* A extensão do tipo de arquivo inserida precisa estar em letras minúsculas de acordo com o ASCII. O separador à esquerda não pode ser incluído ao listar as extensões do tipo de arquivo. Então, use \"jnlp\" em vez de \".jnlp\".\n\nExemplo:\n\nO valor de exemplo abaixo evitaria avisos de download baseados na extensão do tipo de arquivo em extensões \"exe\" e \"jnlp\" para domínios *.example.com e em extensões \"swf\" para todos os domínios. O usuário recebe um aviso de download com base na extensão do tipo de arquivo em qualquer outro domínio para arquivos exe e jnlp, mas não para arquivos swf.\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nObserve que, embora o exemplo anterior mostre a supressão de avisos de download com base na extensão do tipo de arquivo \"swf\" em todos os domínios, a aplicação da supressão desse tipo de aviso em todos os domínios para extensões de tipos de arquivos perigosas não é recomendada devido a questões de segurança. A supressão é mostrada no exemplo apenas para demonstrar que pode ser feita.\n\nSe esta política estiver ativada junto com DownloadRestrictions, as isenções de avisos com base na extensão do tipo de arquivo especificadas por esta política terão precedência sobre uma configuração DownloadRestrictions que bloquearia tipos de arquivo perigosos. As exceções especificadas por esta política se aplicam apenas ao comportamento \"Bloquear tipos de arquivos perigosos\" especificado pelos valores 1 e 2 de DownloadRestrictions.\n\nPor exemplo, se esta política especificar uma exceção para downloads de arquivos \"exe\" do \"site1.com\" e a política DownloadRestrictions estiver definida para bloquear downloads maliciosos e tipos de arquivos perigosos (valor 1), os downloads de arquivos \"exe\" do \"site1.com\" vão estar isentos do bloqueio com base na extensão do tipo de arquivo, mas ainda serão bloqueados se forem mal-intencionados.\n\nPara mais informações sobre a política DownloadRestrictions, acesse https://chromeenterprise.google/policies/?policy=DownloadRestrictions.\nConsulte https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings para ver mais informações sobre esquema e formatação.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Portas de rede explicitamente permitidas";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - porta 554 (pode ser desbloqueada até 15/10/2021)\n10080 - porta 10080 (pode ser desbloqueada até 01/04/2022)\n6566 - porta 6566 (pode ser desbloqueada até 15/10/2021)\n989 - porta 989 (pode ser desbloqueada até 01/02/2022)\n990 - porta 990 (pode ser desbloqueada até 01/02/2022)\nHá uma lista de portas restritas integrada ao Brave. Qualquer tentativa de conexão com essas portas falhará. Esta configuração permite ignorar a lista. O valor é uma lista separada por vírgulas de zero ou mais portas em que conexões de saída serão permitidas.\n\nAs portas são restritas para evitar que o Brave seja usado como vetor para explorar diversas vulnerabilidades de rede. Se a política for definida, sua rede poderá ficar exposta a ataques. Esta política visa ser uma solução temporária para erros com o código \"ERR_UNSAFE_PORT\" ao mesmo tempo em que migra um serviço executado em uma porta bloqueada para uma porta padrão (por exemplo, a porta 80 ou 443).\n\nSites maliciosos podem detectar facilmente que esta política foi definida e para quais portas e usar essas informações para fazer ataques direcionados.\n\nCada porta está marcada com uma data que indica até quando ela pode ser desbloqueada. Após essa data, a porta será restrita independentemente desta configuração.\n\nSe o valor não for preenchido ou definido, todas as portas restritas serão bloqueadas. Se houver uma mistura de valores válidos e inválidos, os válidos serão aplicados.\n\nEsta política substitui a opção \"--explicitly-allowed-ports\" na linha de comando.";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Lista de bloqueio de provedores de identidade que não podem usar o SSO empresarial extensível para o navegador";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Todos os provedores de identidade\nmicrosoft - Provedor de identidade na nuvem da Microsoft®\nokta - Provedor de identidade na nuvem da Okta®\nping - Provedor de identidade na nuvem da Ping®\nDesativar o logon único usando o Extensible Enterprise SSO para os provedores de identidade listados.\n\nAo adicionar o valor 'all', todos os provedores de identidade para SSO compatíveis são desativados.\n\nAo adicionar o valor 'microsoft', o logon único para o provedor de identidade na nuvem da Microsoft® no Chrome é desativado.\n\nSe esta política for deixada sem definição, todos os provedores de identidade compatíveis com o Brave serão ativados.\n\nPara provedores de identidade ativados no Brave e configurados no dispositivo pelo admin, os usuários que fizerem login usando esse provedor em qualquer aplicativo compatível com o Extensible Enterprise SSO também poderão fazer login em propriedades da web usando esse provedor de identidade automaticamente. As informações de autenticação do usuário são transmitidas ao provedor de identidade na nuvem para cada evento de autenticação.\n\nObservações:\n\nO Brave não aceita logon único usando Extensible Enterprise SSO nos modos de navegação anônima ou de convidado.\n\nO Brave só é compatível com o logon único usando o Extensible Enterprise SSO para os seguintes provedores de identidade: Microsoft, Okta e Ping.\n\nEsse recurso está disponível no macOS 10.15.";
ExtensionAllowedTypes.pfm_title = "Tipos de extensões/aplicativos que podem ser instalados";
ExtensionAllowedTypes.pfm_description = "extension - Extensão\ntheme - Tema\nuser_script - Script de usuário\nhosted_app - App hospedado\nlegacy_packaged_app - App empacotado legado\nplatform_app - App de plataforma\nSe for definida, a política controlará os apps e extensões que podem ser instalados no Brave e os hosts que podem interagir com eles. Além disso, ela limitará o acesso ao ambiente de execução.\n\nSe a política não for definida, não haverá nenhuma restrição quanto aos tipos de extensão e app aceitáveis.\n\nExtensões e apps de um tipo não presente na lista não serão instalados. Cada valor terá uma destas strings:\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\nConsulte a documentação das extensões do Brave para mais informações sobre esses tipos.\n\nVersões anteriores à 75 que usam vários IDs de extensão separados por vírgulas não são compatíveis e serão ignoradas. O restante da política estará em vigor.\n\nObservação: esta política também afeta extensões e apps de instalação forçada que usam ExtensionInstallForcelist.\n\nObservação: esta política só se aplica a plataformas que são compatíveis com extensões.";
ExtensionDeveloperModeSettings.pfm_title = "Controlar a disponibilidade do modo de desenvolvedor na página de extensões";
ExtensionDeveloperModeSettings.pfm_description = "0 - Permitir o uso do modo de desenvolvedor na página de extensões\n1 - Não permitir o uso do modo de desenvolvedor na página de extensões\nControle se os usuários podem ativar o modo de desenvolvedor em chrome://extensions.\n\nSe a política não for definida, os usuários poderão ativar o modo de desenvolvedor na página da extensão, a menos que a política DeveloperToolsAvailability seja definida como DeveloperToolsDisallowed (2).\nSe for definida como Allow (0), os usuários poderão ativar o modo de desenvolvedor na página de extensões.\nSe for definida como Disallow (1), os usuários não poderão ativar o modo de desenvolvedor na página de extensões.\n\nSe for definida, o DeveloperToolsAvailability não poderá mais controlar o modo de desenvolvedor de extensões.\n\nObservação: esta política só se aplica a plataformas que são compatíveis com extensões.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Configure uma lista de origens que concede ciclo de vida em segundo plano estendido às extensões de conexão.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "As extensões que se conectam a uma dessas origens vão continuar em execução enquanto a porta estiver conectada.\n\nSe a política for deixada sem definição, os valores padrão dela serão usados. Estas são origens de apps que oferecem SDKs que não dão a possibilidade de reiniciar uma conexão fechada para um estado anterior:\n- Smart Card Connector\n- Citrix Receiver (estável, Beta, backup)\n- VMware Horizon (estável, Beta)\n\nSe definida, a lista de valores padrão será estendida com os valores recém-configurados. As entradas padrão e as fornecidas pela política vão conceder a exceção às extensões de conexão, desde que a porta esteja conectada.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Ativar extensões instaladas por políticas que substituem as configurações de pesquisa padrão ou da página Nova guia";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Controla se as extensões instaladas por políticas (instaladas à força ou recomendadas) que substituem as configurações do mecanismo de pesquisa padrão ou da página Nova guia são permitidas em ambientes de baixa confiança.\n\nEsta política só se aplica a ambientes de baixa confiança, como dispositivos em que as políticas são configuradas localmente sem gerenciamento de domínio ou nuvem. Os ambientes de alta confiança não são afetados:\n\nNo Microsoft® Windows®, esta política não está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas no Chrome Enterprise Core.\n\nNo macOS, esta política não está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas no Chrome Enterprise Core.\n\nAs extensões instaladas por políticas que substituem as configurações do mecanismo de pesquisa padrão ou da página Nova guia vão continuar ativadas nessas instâncias de alta confiança.\n\nQuando definido como Ativado, o Brave vai permitir que extensões instaladas por políticas que substituem as configurações do mecanismo de pesquisa padrão ou da página Nova guia sejam instaladas e permaneçam ativadas em ambientes de baixa confiança.\n\nQuando definido como Desativado ou não configurado, o Brave vai impedir que extensões instaladas por políticas que substituem as configurações do mecanismo de pesquisa padrão ou da página Nova guia sejam instaladas em ambientes de baixa confiança e vai removê-las se já estiverem instaladas.\n\nSe uma extensão afetada for atualizada para não substituir mais essas configurações, o Brave vai instalá-la automaticamente em até sete dias.\n\nEsta política é temporária e será removida em uma versão futura.";
ExtensionInstallAllowlist.pfm_title = "IDs de extensão que serão isentos da lista de bloqueio";
ExtensionInstallAllowlist.pfm_description = "Se for definida, a política especificará as extensões que não estão sujeitas à lista de bloqueio.\n\nUm valor da lista de bloqueio de * significa que todas as extensões estão bloqueadas e que os usuários só podem instalar extensões que estejam na lista de permissões.\n\nPor padrão, todas as extensões são permitidas. Mas, se você proibiu extensões por meio de uma política, use a lista de extensões permitidas para mudar essa política.\n\nObservação: esta política só se aplica a plataformas que são compatíveis com extensões.";
ExtensionInstallBlocklist.pfm_title = "IDs de extensão que devem ser impedidos de serem instalados pelo usuário (ou * para todos)";
ExtensionInstallBlocklist.pfm_description = "Permite especificar quais extensões os usuários NÃO podem instalar. As extensões já instaladas serão desativadas se estiverem bloqueadas, sem a opção de o usuário ativá-las novamente. Quando uma extensão que tiver sido desativada devido à lista de bloqueios for removida da lista, ela será reativada automaticamente.\n\nUm valor \"*\" da lista de bloqueio significa que todas as extensões estão bloqueadas por padrão. As extensões que estão explicitamente na lista de permissões só são permitidas se estiverem assinadas (empacotadas). Todas as extensões descompactadas estão bloqueadas.\n\nSe esta política não for definida, o usuário poderá instalar qualquer extensão no Brave.\n\nObservação: esta política só se aplica a plataformas que são compatíveis com extensões.";
ExtensionInstallForcelist.pfm_title = "IDs de extensões//aplicativos e URLs de atualização deverão ser instalados silenciosamente";
ExtensionInstallForcelist.pfm_description = "A definição da política especifica uma lista de apps e extensões com instalação silenciosa, sem interação do usuário, e que não podem ser desinstalados nem desativados pela interface do Brave. As permissões são concedidas implicitamente, inclusive para as APIs de extensão enterprise.deviceAttributes e enterprise.platformKeys. Essas duas APIs não estão disponíveis para apps e extensões que não sejam de instalação forçada.\n\nEmbora o Brave tenha como objetivo impedir que os usuários desinstalem essas extensões, alguns sistemas operacionais não permitem que o Brave proteja as extensões de modificações externas. Portanto, essa prevenção é uma tentativa de mitigação.\n\nSe a política não for definida, nenhum app ou extensão será instalado automaticamente e o usuário poderá desinstalar qualquer app ou extensão no Brave.\n\nEsta política substitui a ExtensionInstallBlocklist. Se um app ou extensão de instalação forçada for removido da lista, será automaticamente desinstalado pelo Brave.\n\nO código-fonte de qualquer extensão pode ser alterado pelos usuários com as ferramentas para desenvolvedores, possivelmente prejudicando a funcionalidade da extensão. Se isso for uma preocupação, defina a política DeveloperToolsDisabled.\n\nCada item da lista da política é uma string que contém um ID de extensão e, opcionalmente, um URL de atualização separados por ponto e vírgula (;). O ID da extensão é a string de 32 letras encontrada, por exemplo, em chrome://extensions no modo de desenvolvedor. Se especificado, o URL de atualização vai apontar para um documento XML de manifesto de atualização (https://developer.chrome.com/extensions/autoupdate). O URL de atualização vai usar um destes esquemas: http, https ou file. Por padrão, o URL de atualização da Chrome Web Store é usado. O URL de atualização definido nesta política só é usado na instalação inicial. As atualizações subsequentes da extensão utilizam o URL indicado no manifesto da extensão. O URL para atualizações subsequentes pode ser substituído usando a política ExtensionSettings. Consulte http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy.\n\nEm instâncias do Microsoft® Windows®, apps e extensões de fora da Chrome Web Store só poderão ter a instalação forçada se a instância for associada a um domínio do Microsoft® Active Directory®, associada ao Microsoft® Azure® Active Directory® ou estiver registrada em Chrome Enterprise Core.\n\nEm instâncias do macOS, apps e extensões de fora da Chrome Web Store só poderão ter a instalação forçada se a instância for gerenciada por MDM, associada a um domínio via MCX ou registrada em Chrome Enterprise Core.\n\nObservação: esta política não se aplica ao modo de navegação anônima. Leia sobre hospedagem de extensões (https://developer.chrome.com/extensions/hosting).\n\nObservação: esta política só se aplica a plataformas que são compatíveis com extensões.";
ExtensionInstallSources.pfm_title = "Padrões de URL para permitir instalação de extensões, aplicativos e scripts do usuário a partir de";
ExtensionInstallSources.pfm_description = "Se definida, a política especificará os URLs que podem instalar extensões, apps e temas. Antes do Brave 21, os usuários podiam clicar em um link para um arquivo *.crx, e o Brave se oferecia para instalar o arquivo após alguns avisos. Depois dessa versão, esses arquivos precisam ser baixados e arrastados para a página de configurações do Brave. Essa configuração permite que URLs específicos utilizem o fluxo de instalação antigo facilitado.\n\nCada item nesta lista é um padrão de correspondência de estilo de extensão (consulte https://developer.chrome.com/extensions/match_patterns). Os usuários conseguem instalar com facilidade os itens de qualquer URL correspondente a um item da lista. Tanto o local do arquivo *.crx quanto a página de onde é baixado (ou seja, o referenciador) precisam ser permitidos por esses padrões.\n\nExtensionInstallBlocklist tem prioridade sobre esta política. Ou seja, uma extensão da lista de bloqueio não será instalada, mesmo se a instalação for feita de um site presente nesta lista.\n\nObservação: esta política só se aplica a plataformas que são compatíveis com extensões.";
ExtensionInstallTypeBlocklist.pfm_title = "Lista de bloqueio para tipos de instalação de extensões";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Impede que extensões sejam carregadas na linha de comando\nA lista de bloqueio controla quais tipos de extensão não poderão ser instalados.\n\nDefinir \"command_line\" impede que uma extensão seja carregada na\nlinha de comando.";
ExtensionReviewPromptsEnabled.pfm_title = "Controlar as solicitações de avaliação de extensões e os links de classificação";
ExtensionReviewPromptsEnabled.pfm_description = "Controla se as solicitações de avaliação nativas e os links de classificação (como \"Avaliar\") para extensões instaladas do Chrome estão disponíveis nas interfaces do usuário do Chrome.\n\nSe esta política for ativada ou deixada sem definição, os usuários vão encontrar pontos de entrada nativos para avaliar as extensões qualificadas na barra de ferramentas, nos menus de contexto e na página de gerenciamento de extensões (chrome://extensions).\n\nSe esta política for desativada, todos os prompts de avaliação nativos e links de classificação serão suprimidos e ficarão indisponíveis.";
ExtensionSettings.pfm_title = "Configurações de gerenciamento de extensão";
ExtensionSettings.pfm_description = "Se definida, a política controlará as configurações de gerenciamento de extensões do Brave, inclusive aquelas controladas pelas políticas existentes relacionadas a extensões.\n\nEsta política mapeia um ID de extensão ou um URL de atualização apenas para a própria configuração específica. Uma configuração padrão pode ser definida para o ID especial \"*\", que será aplicada a todas as extensões que não tiverem uma configuração personalizada definida nesta política.\n\nEsta política pode substituir a configuração de extensão de políticas legadas.\n\nQualquer configuração de extensão por ID de ExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist ou ExtensionSettings vai herdar apenas \"installation_mode\" e \"update_url\" dos padrões de \"*\". A configuração não vai herdar outras propriedades. Com um URL de atualização, a configuração será aplicada a todas as extensões com o URL de atualização exato indicado no manifesto da extensão (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy). Se a flag \"override_update_url\" for definida como verdadeira, a extensão será instalada e atualizada usando o URL de atualização especificado na política ExtensionInstallForcelist ou no campo \"update_url\" desta política. A flag \"override_update_url\" será ignorada se o campo \"update_url\" for um URL da Chrome Web Store.\n\nA partir da versão 154 do Brave, a aplicação de \"runtime_blocked_hosts\" a uma extensão com a permissão \"debugger\" vai desativar completamente o \"chrome.debugger.attach()\" em todos os destinos.\n\nEm instâncias do Microsoft® Windows®, apps e extensões de fora da Chrome Web Store só poderão ter a instalação forçada se a instância for associada a um domínio do Microsoft® Active Directory®, associada ao Microsoft® Azure® Active Directory® ou estiver registrada no Chrome Enterprise Core.\n\nEm instâncias do macOS, apps e extensões de fora da Chrome Web Store só poderão ter a instalação forçada se a instância for gerenciada por MDM, associada a um domínio via MCX ou registrada em Chrome Enterprise Core.\n\nObservação: esta política só se aplica a plataformas que são compatíveis com extensões.\nConsulte https://chromeenterprise.google/policies/?policy=ExtensionSettings para ver mais informações sobre esquema e formatação.";
ExtensionUnpublishedAvailability.pfm_title = "Controlar a disponibilidade das extensões não publicadas na Chrome Web Store";
ExtensionUnpublishedAvailability.pfm_description = "0 - Permitir extensões não publicadas\n1 - Desativar extensões não publicadas\nSe a política for ativada, as extensões não publicadas na Chrome Web\nStore serão desativadas no Brave.\nEsta política se aplica apenas às extensões instaladas e atualizadas pela\nChrome Web Store.\n\nExtensões de fora da loja, como as descompactadas instaladas no modo de\ndesenvolvedor e as instaladas usando a opção de linha de comando, são ignoradas.\nAs extensões de instalação forçada que são auto-hospedadas são ignoradas. Todas\nas extensões fixadas na versão também são ignoradas.\n\nSe a política for definida como AllowUnpublished (0) ou for deixada sem definição, as extensões não publicadas na Chrome Web Store serão permitidas.\nSe a política for definida como DisableUnpublished (1), as extensões não publicadas na Chrome Web Store serão desativadas.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Exibir uma caixa de seleção \"Sempre aberto\" na caixa de diálogo do protocolo externo.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Esta política controla se a caixa de seleção \"Sempre aberto\" é exibida ou não em prompts de confirmação para inicialização de protocolo externo.\n\n     Se esta política for definida como verdadeira ou não for configurada, quando uma confirmação de protocolo externo for exibida, o usuário poderá selecionar \"Sempre permitir\" para pular todos os futuros prompts de confirmação para o protocolo nesse site.\n\n     Se esta política for definida como falsa, a caixa de seleção \"Sempre permitir\" não será exibida, e o usuário precisará confirmar sempre que um protocolo externo for invocado.";
FeedbackSurveysEnabled.pfm_title = "Especifica se as pesquisas do Brave no produto são mostradas aos usuários.";
FeedbackSurveysEnabled.pfm_description = "Pesquisas do Brave no produto coletam feedback de usuários sobre o navegador. As respostas das pesquisas não estão associadas a contas de usuário.\nSe a política for ativada ou deixada sem definição, as pesquisas no produto poderão ser mostradas aos usuários.\nQuando ela estiver desativada, as pesquisas no produto não vão ser mostradas aos usuários.\n\nA política não terá efeito se a MetricsReportingEnabled for desativada, o que também desativa as pesquisas no produto.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Buscar duração do sinal de atividade durante o encerramento";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Controla a duração (em segundos) permitida para solicitações de sinal de atividade no encerramento do navegador.\n\nQuando especificada, o encerramento do navegador pode ser bloqueado pelo número de segundos especificado\npara processar as solicitações de sinal de atividade (https://fetch.spec.whatwg.org/#request-keepalive-flag, link em inglês).\n\nO valor padrão (0) significa que esse recurso está desativado.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Permitir que APIs de seletores de arquivos ou diretórios sejam chamadas sem o gesto anterior do usuário";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "Por motivos de segurança, as APIs da Web\nshowOpenFilePicker(),\nshowSaveFilePicker() e\nshowDirectoryPicker() exigem que uma interação inicial do usuário (\"ativação temporária\") seja chamada. Caso contrário, vai haver\numa falha.\n\nCom esse conjunto de políticas, os admins conseguem especificar origens em que essas APIs podem ser\nchamadas sem a interação inicial do usuário.\n\nPara saber mais sobre padrões de URL válidos, consulte\nhttps://chromeenterprise.google/policies/url-patterns/. O valor *\nnão é aceito para esta política.\n\nSe a política for deixada sem definição, todas as origens vão exigir uma interação inicial do usuário para chamar\nessas APIs.";
FileSystemReadAskForUrls.pfm_title = "Permitir acesso de leitura com a API File System nestes sites";
FileSystemReadAskForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica quais sites podem pedir que os usuários concedam permissão de leitura de arquivos ou diretórios no sistema de arquivos do sistema operacional do host com a API File System.\n\nSe a política não tiver definição, DefaultFileSystemReadGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, as configurações pessoais dos usuários serão aplicadas.\n\nOs padrões de URL não podem entrar em conflito com FileSystemReadBlockedForUrls. Nenhuma política terá precedência se um URL tiver correspondência com ambas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
FileSystemReadBlockedForUrls.pfm_title = "Bloquear acesso de leitura com a API File System nestes sites";
FileSystemReadBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica quais sites não podem pedir que os usuários concedam permissão de leitura de arquivos ou diretórios no sistema de arquivos do sistema operacional do host com a API File System.\n\nSe a política não tiver definição, DefaultFileSystemReadGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, as configurações pessoais dos usuários serão aplicadas.\n\nOs padrões de URL não podem entrar em conflito com FileSystemReadAskForUrls. Nenhuma política terá precedência se um URL tiver correspondência com ambas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
FileSystemWriteAskForUrls.pfm_title = "Permitir acesso de gravação de arquivos e diretórios nestes sites";
FileSystemWriteAskForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica quais sites podem pedir que os usuários concedam permissão de gravação de arquivos ou diretórios no sistema de arquivos do sistema operacional do host.\n\nSe a política não tiver definição, DefaultFileSystemWriteGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, as configurações pessoais dos usuários serão aplicadas.\n\nOs padrões de URL não podem entrar em conflito com FileSystemWriteBlockedForUrls. Nenhuma política terá precedência se um URL tiver correspondência com ambas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
FileSystemWriteBlockedForUrls.pfm_title = "Bloquear acesso de gravação de arquivos e diretórios nestes sites";
FileSystemWriteBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica quais sites não podem pedir que os usuários concedam permissão de gravação de arquivos ou diretórios no sistema de arquivos do sistema operacional do host.\n\nSe a política não tiver definição, DefaultFileSystemWriteGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, as configurações pessoais dos usuários serão aplicadas.\n\nOs padrões de URL não podem entrar em conflito com FileSystemWriteAskForUrls. Nenhuma política terá precedência se um URL tiver correspondência com ambas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
ForceEphemeralProfiles.pfm_title = "Perfil temporário";
ForceEphemeralProfiles.pfm_description = "Se estiver ativada, esta política forçará a alteração do perfil para o modo temporário. Se esta política for especificada como uma política de SO (por exemplo GPO no Windows) ela será aplicada a todos os perfis no sistema. Se a política for definida como uma política de nuvem, ela será aplicada apenas a um perfil acessado com uma conta gerenciada.\n\nNeste modo, os dados de perfil são mantidos no disco apenas durante a sessão do usuário. Recursos como o histórico do navegador, as extensões e as informações nelas contidas, os dados da Web, como cookies e bancos de dados não são mantidos após o navegador ser fechado. No entanto, isso não impede que o usuário faça o download de dados para o disco manualmente, salve páginas ou as imprima.\n\nSe o usuário tiver ativado a sincronização, todos esses dados serão preservados no perfil de sincronização dele, assim como acontece nos perfis regulares. O modo de navegação anônima também estará disponível, se não for explicitamente desativado pela política.\n\nSe a política for desativada ou não for definida, o login levará a perfis regulares.";
ForceForegroundPriorityForAllTabs.pfm_title = "Forçar a prioridade de primeiro plano para todas as guias";
ForceForegroundPriorityForAllTabs.pfm_description = "Esta política define se o conteúdo da web em segundo plano é forçado a ser executado com prioridade de primeiro plano.\n\nPor padrão, o navegador reduz a prioridade das guias em segundo plano para otimizar recursos. Ativar esta política mudará o comportamento padrão, e as guias em segundo plano serão processadas da mesma forma que a guia ativa.\n\nForçar a priorização do conteúdo em segundo plano pode afetar a capacidade de resposta da guia ativa.\n\nSe esta política estiver ativada, todo o conteúdo da web será executado com prioridade de primeiro plano, mesmo que esteja em outra guia.\n\nSe esta política estiver desativada ou sem uma configuração definida, o navegador determinará a prioridade de forma prática (por exemplo, desconsiderando conteúdo que não esteja visível, reproduzindo áudio ou sendo usado em videochamadas).";
ForceForegroundPriorityForUrls.pfm_title = "Forçar a prioridade de primeiro plano para URLs específicos";
ForceForegroundPriorityForUrls.pfm_description = "Esta política permite especificar uma lista de padrões de URL. O conteúdo da web em segundo plano que corresponder a esses padrões será forçado a ser executado com prioridade de primeiro plano.\n\nSe a política ForceForegroundPriorityForAllTabs for ativada, esta lista será ignorada, porque todas as guias serão forçadas a ter prioridade de primeiro plano.\n\nSe a política ForceForegroundPriorityForAllTabs for desativada ou não for definida, apenas o conteúdo que corresponder aos padrões nesta lista será forçado.\n\nPara informações detalhadas sobre padrões de URL válidos, consulte https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSe a lista estiver vazia ou não for definida, nenhum conteúdo em segundo plano será forçado a ter prioridade de primeiro plano.";
ForceGoogleSafeSearch.pfm_title = "Forçar o Google SafeSearch";
ForceGoogleSafeSearch.pfm_description = "Se a política for definida como \"Ativada\", o SafeSearch estará sempre ativo na Pesquisa Google e os usuários não poderão mudar essa configuração.\n\nSe a política for definida como \"Desativada\" ou não for definida, o SafeSearch não será obrigatório na Pesquisa Google.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "Controla se os manipuladores de eventos unload podem ser desativados.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "O uso dos manipuladores de eventos unload está sendo descontinuado. O disparo depende da Permissions-Policy do unload. Por padrão, eles são permitidos pela política. No futuro, eles serão desativados gradualmente por padrão, e os sites precisarão ativá-los explicitamente usando cabeçalhos da Permissions-Policy. Essa política corporativa pode ser usada para desativar a descontinuação gradual, forçando o padrão a permanecer como ativado.\n\nAs páginas podem depender de manipuladores de eventos unload para salvar dados ou sinalizar o final de uma sessão de usuário para o servidor. Isso não é recomendado porque não é confiável e afeta o desempenho ao bloquear o uso do BackForwardCache. Há alternativas recomendadas, mas o evento unload é usado há muito tempo. Alguns aplicativos ainda podem depender dele.\n\nSe esta política for definida como falsa ou deixada sem definição, os manipuladores de eventos unload serão descontinuados gradualmente, de acordo com o status da descontinuação, e os sites que não definirem o cabeçalho Permissions-Policy não vão disparar eventos de descarregamento.\n\nSe esta política for definida como verdadeira, os manipuladores de eventos unload continuarão funcionando por padrão.\n\nOBSERVAÇÃO: essa política tinha documentado incorretamente o padrão como \"verdadeiro\" na versão M117. O evento de descarregamento foi modificado e não vai mudar na versão M117. Portanto, essa política não tem efeito nessa versão.\n";
ForceYouTubeRestrict.pfm_title = "Aplicar o Modo Restrito do YouTube no nível mínimo";
ForceYouTubeRestrict.pfm_description = "0 - Não aplicar o Modo Restrito no YouTube\n1 - Aplicar o Modo Restrito no mínimo como Moderado no YouTube\n2 - Aplicar o Modo Restrito Rigoroso para o YouTube\nSe a política for definida, um nível mínimo do Modo Restrito será aplicado ao YouTube e os usuários não poderão escolher um modo menos restrito. Se for definida como:\n\n* Rigorosa, o Modo Restrito Rigoroso estará sempre ativo no YouTube.\n\n* Moderada, os usuários poderão escolher apenas o Modo Restrito Moderado e o Modo Restrito Rigoroso no YouTube, e não poderão desativar o Modo Restrito.\n\n* Desativada, ou se nenhum valor for definido, o Modo Restrito no YouTube não será aplicado pelo Chrome. Políticas externas, como as do YouTube, ainda poderão aplicar o Modo Restrito.";
ForcedLanguages.pfm_title = "Configurar o conteúdo e a ordem dos idiomas preferidos";
ForcedLanguages.pfm_description = "Esta política permite que administradores configurem a ordem dos idiomas preferidos nas configurações do Brave.\n\nA lista aparecerá nessa mesma ordem na seção \"Ordenar idiomas com base na sua preferência\" em chrome://settings/languages. Os usuários não poderão remover ou reorganizar os idiomas definidos pela política, mas será possível adicionar mais idiomas abaixo deles. Além disso, os usuários terão total controle sobre as configurações de tradução/verificação ortográfica e o idioma da interface do navegador, a menos que eles sejam impostos por outras políticas.\n\nSe a política não for definida, será possível manipular toda a lista de idiomas preferidos.";
GeminiActOnWebAllowedForURLs.pfm_title = "Permitir que integrações do app do Gemini ajam diretamente em sites especificados";
GeminiActOnWebAllowedForURLs.pfm_description = "Permite definir uma lista de padrões de URL que especificam sites em que integrações do app Gemini podem agir diretamente em páginas da web.\n\nOs URLs que não correspondem à lista de permissões nem à lista de bloqueio usam GeminiActOnWebSettings.\n\nOs URLs que correspondem à lista de permissões e à lista de bloqueio são permitidos.\n\nEncontre informações detalhadas sobre padrões do URL válidos em https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebBlockedForURLs.pfm_title = "Bloquear a ação direta de integrações do app do Gemini em sites especificados";
GeminiActOnWebBlockedForURLs.pfm_description = "Permite definir uma lista de padrões do URL que especificam sites em que integrações do app Gemini não podem agir diretamente em páginas da web.\n\nOs URLs que não correspondem à lista de permissões nem à lista de bloqueio usam GeminiActOnWebSettings.\n\nOs URLs que correspondem à lista de permissões e à lista de bloqueio são permitidos.\n\nEncontre informações detalhadas sobre padrões do URL válidos em https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebSettings.pfm_title = "Permitir que as integrações do app do Gemini atuem diretamente nas páginas da Web";
GeminiActOnWebSettings.pfm_description = "0 - Permitir que o app do Gemini realize ações nas páginas da Web.\n1 - Não permitir que o app do Gemini realize ações nas páginas da Web.\nControla se o app do Gemini pode realizar ações nas páginas da web em nome do usuário.\n\nSe for definida como 0 ou deixada sem definição, o app do Gemini poderá realizar ações nas páginas da web.\n\nSe for definida como 1, ele não terá permissão para isso.\n\nEsta política não tem efeito quando o app do Gemini está desativado. Por exemplo, ele pode ser desativado pela política GeminiSettings.\n\nPara mais informações sobre o Gemini no Chrome, acesse https://support.google.com/chrome/a/answer/16291696.\n\nO acionamento do Gemini só está disponível em alguns países e idiomas. Definir esta política não garante que o recurso será ativado. Ele ainda vai ficar sujeito à disponibilidade. Para mais informações sobre o lançamento, consulte as notas da versão do Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=pt-br";
GeminiSettings.pfm_title = "Configurações da integração do Gemini";
GeminiSettings.pfm_description = "0 - Permitir integrações com o Gemini.\n1 - Não permitir integrações com o Gemini.\nEsta configuração permite integrações dos apps do Gemini.\n\n0 = a integração do Gemini ficará disponível para os usuários.\n\n1 = a integração do Gemini não ficará disponível para os usuários.\n\nSe não for definida, o comportamento será determinado pela política GenAiDefaultSettings.\n\nPara mais informações, consulte o artigo da Central de Ajuda: https://support.google.com/chrome/a?p=gemini_in_chrome.";
GeminiSparkSettings.pfm_title = "Permite que o Gemini Spark se conecte ao Brave e use a navegação automática do Gemini no Chrome";
GeminiSparkSettings.pfm_description = "0 - O Gemini Spark tem permissão para se conectar e usar a navegação automática do Brave.\n1 - O Gemini Spark não tem permissão para se conectar ou usar a navegação automática do Brave.\nControla se o agente do Gemini Spark tem permissão para se conectar ao Brave e usar a navegação automática. O Gemini Spark pode não estar disponível na sua organização.\n\n0 = O Gemini Spark tem permissão para se conectar e usar a navegação automática do Brave\n\n1 = O Gemini Spark não tem permissão para se conectar ou usar a navegação automática do Brave\n\nAviso: permitir que o Gemini Spark se conecte ao Brave e use a navegação automática habilita o agente do Gemini Spark a realizar ações autônomas de várias etapas nos clientes do Brave usando a sessão ativa do navegador. Isso envolve riscos significativos de segurança, incluindo riscos relacionados a credenciais, invasão da rede local e perda de sinais contextuais. Os controles de segurança e gerenciamento atuais podem não ser respeitados.\n\nOs admins devem avaliar com cuidado o modelo de ameaças à rede e as diretrizes de conformidade e privacidade da organização antes de ativar esse recurso.\n\nEssa política não tem efeito quando o app Google Gemini ou as políticas de navegação automática do Brave estão desativados. Por exemplo, o app Google Gemini pode ser desativado pela política GeminiSettings. Para mais informações sobre o Google Gemini no Brave, acesse https://support.google.com/chrome/a?p=gemini_in_chrome.\n\nA navegação automática do Brave e o Gemini Spark não estão disponíveis em todos os países ou idiomas. Definir essa política como 0 (ativada) não garante que o recurso será ativado. Ele ainda vai ficar sujeito à disponibilidade. Para mais informações sobre o lançamento, consulte as notas da versão do Enterprise: https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Configurações do modelo de fundação local da IA generativa";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Baixar o modelo automaticamente\n1 - Não baixar o modelo\nConfigure como o Brave baixa e usa o modelo básico da IA generativa para inferência local.\n\nQuando a política for definida como Permitida (0) ou deixada sem definição, o modelo será baixado automaticamente e usado para inferência.\n\nSe a política for definida como Desativada (1), o modelo não será baixado e o anterior (se houver) será excluído.\n\nEm plataformas para computador, também é possível desativar o download desse modelo definindo ComponentUpdatesEnabled como falso.";
GeolocationBlockedForUrls.pfm_title = "Bloquear a geolocalização nestes sites";
GeolocationBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que não têm permissão para acessar a geolocalização do usuário e também não podem pedir permissão do usuário para fazer isso.\n\nSe a política não for definida, DefaultGeolocationSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara informações detalhadas sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "Ativa o cache de autenticação de HTTP com escopo global";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Esta política configura um único cache global por perfil com credenciais de autenticação do servidor HTTP.\n\nSe esta política não for definida ou for desativada, o navegador usará o comportamento padrão da autenticação entre sites, que será criar o escopo das credenciais de autenticação do servidor HTTP por site de nível superior. Portanto, se dois sites usarem recursos do mesmo domínio de autenticação, as credenciais precisarão ser fornecidas de forma independente no contexto desses sites. As credenciais de proxy armazenadas em cache serão reutilizadas nos sites.\n\nSe a política estiver ativada, as credenciais de autenticação de HTTP inseridas no contexto de um site serão automaticamente usadas no contexto de outro.\n\nA ativação desta política cria vulnerabilidades para alguns tipos de ataque entre sites e permite que os usuários sejam rastreados nos sites mesmo sem cookies, pela adição de entradas ao cache de autenticação de HTTP usando credenciais incorporadas em URLs.\n\nO objetivo desta política é dar às empresas, dependendo do comportamento legado, a chance de atualizar os próprios procedimentos de login. Ela será removida no futuro.";
GoogleSearchSidePanelEnabled.pfm_title = "Ativar Google Search Side Panel";
GoogleSearchSidePanelEnabled.pfm_description = "Se a política for ativada ou deixada sem definição, o Google Search Side Panel terá permissão para aparecer em todas as páginas da Web.\n\nSe ela for desativada, o Google Search Side Panel não vai ficar disponível em nenhuma página da Web.\n\nOs recursos de IA generativa que fazem parte dessa ferramenta não estão disponíveis para contas corporativas ou de ensino.";
HSTSPolicyBypassList.pfm_title = "Lista de nomes que contornarão a verificação de política HSTS";
HSTSPolicyBypassList.pfm_description = "A definição da política especifica uma lista de nomes de host que ignoram upgrades HSTS pré-carregados de HTTP para HTTPS.\n\nApenas nomes de host de etiqueta única são permitidos nesta política, e ela se aplica somente a entradas HSTS pré-carregadas \"estáticas\" (por exemplo, \"app\", \"new\", \"search\", \"play\"). A política não impede upgrades HSTS para servidores que fazem solicitações de upgrade HSTS \"dinamicamente\" usando um cabeçalho de resposta Strict-Transport-Security.\n\nOs nomes de host fornecidos precisam ser canonizados. Todos os IDNs precisam ser convertidos para o formato de etiqueta A, e todas as letras ASCII precisam ser minúsculas. Essa política se aplica exclusivamente aos nomes do host de etiqueta única específicos, e não aos subdomínios desses nomes.";
HappyEyeballsV3Enabled.pfm_title = "Usar o algoritmo Happy Eyeballs V3";
HappyEyeballsV3Enabled.pfm_description = "Esse recurso permite que o algoritmo Happy Eyeballs V3 faça tentativas de conexão. Saiba mais em https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3 (página em inglês).\n\nSe a política for ativada, o Brave vai usar o algoritmo Happy Eyeballs V3 para as tentativas de conexão.\n\nSe a política for desativada, o algoritmo Happy Eyeballs V3 também será.\n\nSe a política não for definida, o Brave vai ativar ou desativar o algoritmo Happy Eyeballs V3 com base em chrome://flags/#happy-eyeballs-v3.\n\nEssa política aceita atualização dinâmica.\n\nEla é uma medida temporária e será removida em versões futuras do Brave.";
HardwareAccelerationModeEnabled.pfm_title = "Usar aceleração gráfica quando disponível";
HardwareAccelerationModeEnabled.pfm_description = "Se a política for ativada ou deixada sem definição, a aceleração gráfica também será ativada, se disponível.\n\nSe ela for desativada, a aceleração gráfica também será.";
HeadlessMode.pfm_title = "Controlar o uso do modo headless";
HeadlessMode.pfm_description = "1 - Permitir o uso do modo headless\n2 - Não permitir o uso do modo headless\nSe esta política for definida como Enabled ou for deixada sem definição, o modo headless poderá ser usado. Se ela for definida como Disabled, o uso do modo headless será negado.";
HelpMeWriteSettings.pfm_title = "Configurações do recurso \"Me ajude a escrever\"";
HelpMeWriteSettings.pfm_description = "0 - Permitir o recurso Me ajude a escrever e melhorar os modelos de IA.\n1 - Permitir o recurso Me ajude a escrever sem melhorar os modelos de IA.\n2 - Não permitir o recurso Me ajude a escrever.\nO recurso Me ajude a escrever é um assistente de escrita baseado em IA para conteúdos curtos na Web. As sugestões são baseadas nos comandos inseridos pelo usuário e no conteúdo da página da Web.\n\nSe ela for definida como 0, o recurso será habilitado e os dados relevantes poderão ser usados pelo Google para melhorar os modelos de IA. Esses dados podem incluir comandos, entradas, saídas, materiais de origem e feedback por escrito, dependendo do recurso. Eles também podem ser analisados por humanos para melhorar os modelos de IA. O valor padrão é 0, exceto quando indicado de outra forma abaixo.\n\nSe a política for definida como 1, o recurso será habilitado, mas o Google não poderá usar o conteúdo dos usuários (incluindo comandos, entradas, saídas, materiais de origem e feedback por escrito) para melhorar os modelos. 1 é o valor padrão para usuários corporativos gerenciados pelo Google Admin console e contas de ensino gerenciadas pelo Google Workspace.\n\nSe ela for definida como 2, o recurso não será habilitado.\n\nSe for deixada sem definição, o comportamento será determinado pela política GenAiDefaultSettings.\n\nPara mais informações sobre como tratar dados de recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
HideWebStoreIcon.pfm_title = "Ocultar a loja on-line da página \"Nova guia\" e do Acesso rápido aos apps";
HideWebStoreIcon.pfm_description = "Oculta o link do aplicativo e do rodapé da Chrome Web Store na página \"Nova guia\" e no iniciador de aplicativos do Google Chrome OS.\n\nQuando esta política é definida como verdadeira, os ícones ficam ocultos.\n\nQuando esta política é definida como falsa ou não está configurada, os ícones ficam visíveis.";
HighEfficiencyModeEnabled.pfm_title = "Ativar o modo de alta eficiência";
HighEfficiencyModeEnabled.pfm_description = "Esta política ativa ou desativa a configuração do modo de alta eficiência. Com essa configuração, as guias são descartadas após um determinado período em segundo plano para recuperar memória.\nSe a política não for definida, o usuário final vai poder controlar essa configuração em chrome://settings/performance.\n";
HistoryClustersVisible.pfm_title = "Mostrar uma visualização do histórico do Chrome com grupos de páginas";
HistoryClustersVisible.pfm_description = "Esta política controla a visibilidade da página do histórico do Chrome organizada em grupos de páginas.\n\nSe ela for ativada, uma página do histórico do Chrome organizada em grupos ficará visível em chrome://history/grouped.\n\nSe for desativada, a página não ficará visível em chrome://history/grouped.\n\nSe a política for deixada sem definição, a página ficará visível em chrome://history/grouped por padrão.\n\nSe a política ComponentUpdatesEnabled for desativada, mas a HistoryClustersVisible for ativada ou deixada sem definição, uma página do histórico do Chrome organizada em grupos vai continuar disponível em chrome://history/grouped, mas poderá ser menos relevante para o usuário.\n";
HistorySearchSettings.pfm_title = "Configurações da pesquisa no histórico com tecnologia de IA";
HistorySearchSettings.pfm_description = "0 - Permitir a pesquisa no histórico com tecnologia de IA e melhorar os modelos de IA.\n1 - Permitir a pesquisa no histórico com tecnologia de IA sem melhorar os modelos de IA\n2 - Não permitir a pesquisa no histórico com tecnologia de IA.\nA pesquisa no histórico com tecnologia de IA é um recurso que permite que os usuários pesquisem no histórico de navegação e recebam respostas geradas de acordo com o conteúdo da página, não apenas o título e o URL.\n\nSe ela for definida como 0, o recurso será habilitado e os dados relevantes poderão ser usados pelo Google para melhorar os modelos de IA. Esses dados podem incluir comandos, entradas, saídas, materiais de origem e feedback por escrito, dependendo do recurso. Eles também podem ser analisados por humanos para melhorar os modelos de IA. O valor padrão é 0, exceto quando indicado de outra forma abaixo.\n\nSe a política for definida como 1, o recurso será habilitado, mas o Google não poderá usar o conteúdo dos usuários (incluindo comandos, entradas, saídas, materiais de origem e feedback por escrito) para melhorar os modelos. 1 é o valor padrão para usuários corporativos gerenciados pelo Google Admin console e contas de ensino gerenciadas pelo Google Workspace.\n\nSe ela for definida como 2, o recurso não será habilitado.\n\nSe for deixada sem definição, o comportamento será determinado pela política GenAiDefaultSettings.\n\nPara mais informações sobre como tratar dados de recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
HomepageIsNewTabPage.pfm_title = "Usar a página \"Nova guia\" como página inicial";
HomepageIsNewTabPage.pfm_description = "Se a política for definida como \"Ativada\", a página Nova guia será a página inicial do usuário. Qualquer local de URL de página inicial será ignorado. Se a política for definida como \"Desativada\", a página Nova guia não será a página inicial, a não ser que o URL dela seja definido como chrome://newtab.\n\nSe você definir a política, os usuários não poderão mudar a página inicial no Brave. Se a política não for definida, o usuário poderá escolher se a página Nova guia será a inicial.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
HomepageLocation.pfm_title = "URL da página inicial";
HomepageLocation.pfm_description = "Se a política for definida, o URL de página inicial padrão será definido no Brave. O botão \"Página inicial\" abrirá a página inicial. No computador, as políticas RestoreOnStartup controlam as páginas que são abertas na inicialização.\n\nSe a página inicial for definida como a página Nova guia, seja pelo usuário ou por HomepageIsNewTabPage, esta política não terá efeito.\n\nO URL precisa de um esquema padrão, como http://example.com ou https://example.com. Quando a política for definida, os usuários não poderão mudar o URL da página inicial no Brave.\n\nSe HomepageLocation e HomepageIsNewTabPage não forem definidas, o usuário poderá escolher a página inicial.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
HttpAllowlist.pfm_title = "Lista de permissões de HTTP";
HttpAllowlist.pfm_description = "A definição da política especifica uma lista de nomes do host ou padrões do nome do host (como\n\"[*.]example.com\") que não vão receber upgrade para HTTPS e não\nmostrarão um intersticial de erro se o HTTPS-First Mode estiver ativado. As organizações podem usar essa\npolítica para manter o acesso a servidores que não oferecem suporte a HTTPS, sem\nprecisar desativar os upgrades e/ou o HTTPS-First Mode.\n\nOs nomes de host fornecidos precisam ser canonizados. Todos os IDNs precisam ser convertidos no formato de\netiqueta A, e todas as letras ASCII precisam ser minúsculas.\n\nCaracteres curinga de host em geral (por exemplo, \"*\" ou \"[*]\") não são permitidos. Em vez disso,\no HTTPS-First Mode e os HTTPS Upgrades precisam ser explicitamente desativados pelas\npolíticas específicas correspondentes.\n\nObservação: esta política não se aplica a HSTS Upgrades.";
HttpHeaderInjection.pfm_title = "Configurar a injeção de cabeçalho HTTP para padrões de URL específicos";
HttpHeaderInjection.pfm_description = "Esta política permite definir uma lista de regras para injetar cabeçalhos HTTP personalizados em solicitações da web que correspondem a padrões de URL específicos. Os cabeçalhos definidos por esta política têm precedência sobre aqueles inicialmente presentes na solicitação, bem como sobre as tentativas de modificações feitas por usuários ou extensões.\n\nUm caso de uso comum para essa política é aplicar controles de acesso de locatário injetando cabeçalhos personalizados (por exemplo, X-Tenant-ID).\n\nA política aceita uma lista de regras. Cada regra contém:\n\n* patterns: uma lista de padrões de URL para correspondência. Confira como formatar um padrão de URL (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\n* headers: uma lista de objetos que representam cabeçalhos a serem injetados. Cada um contém:\n\n* name: o nome do cabeçalho a ser injetado.\n\n* value: o valor do cabeçalho a ser injetado.\n\nSe várias regras corresponderem a uma solicitação, serão aplicados os cabeçalhos de todas as regras correspondentes. Se houver vários cabeçalhos com o mesmo nome, será aplicado aquele que tiver o padrão de URL mais específico. Se os padrões forem igualmente específicos, será aplicado aquele que estiver por último na lista.\n\nOs nomes de cabeçalho precisam estar em conformidade com a RFC 2616 (https://www.rfc-editor.org/rfc/rfc2616). Os valores de cabeçalho não podem conter símbolos NUL, CR ou LF. Os cabeçalhos individuais não podem exceder 8 KB. Cabeçalhos e padrões de URL inválidos serão ignorados.\n\nEsta política é limitada a um total de 500 padrões de URL em todas as regras. Cada regra pode conter no máximo 20 cabeçalhos. Padrões e cabeçalhos além desses limites serão ignorados.\n\nObservação: se um padrão de URL corresponder a esquemas não criptografados (http://, ws:// ou quando o esquema for omitido), os cabeçalhos configurados poderão ser transmitidos em texto simples por um canal não criptografado e ficar expostos a observadores de rede. Para proteger valores de cabeçalho sensíveis ou de identificação, restrinja os padrões de URL a esquemas criptografados (https:// ou wss://).\nConsulte https://chromeenterprise.google/policies/?policy=HttpHeaderInjection para ver mais informações sobre esquema e formatação.";
HttpsOnlyMode.pfm_title = "Permitir que o HTTPS-Only Mode seja ativado";
HttpsOnlyMode.pfm_description = "allowed - Não restringir a configuração do modo somente HTTPS\ndisallowed - Desativar o modo somente HTTPS\nforce_enabled - Ativar o modo somente HTTPS no modo estrito\nforce_balanced_enabled - Ativar o modo somente HTTPS no modo equilibrado\nEsta política controla se os usuários podem ativar o modo somente HTTPS (Sempre usar conexões seguras) nas Configurações. O modo somente HTTPS faz upgrade de todas as navegações para HTTPS.\n\nSe esta configuração for deixada sem definição ou definida como \"permitida\", os usuários poderão ativar o modo somente HTTPS.\n\nSe ela for definida como \"não permitida\", o modo somente HTTPS será desativado.\n\nSe ela for definida como \"force_enabled\", o modo somente HTTPS será ativado no modo estrito.\n\nSe ela for definida como \"force_balanced_enabled\", o modo somente HTTPS será ativado no modo equilibrado.\n\nA opção \"force_enabled\" está disponível a partir da versão M112, enquanto \"force_balanced_enabled\" está disponível a partir da M129.\n\nTambém é possível recomendar \"force_enabled\" e \"force_balanced_enabled\" aos usuários.\nInicialmente, o modo somente HTTPS será definido como \"estrito\" ou \"equilibrado\", mas os usuários poderão\nmudar a configuração.\n\nSe você definir essa política para um valor que não é compatível com a versão do Chrome que a recebe, o navegador vai usar a configuração permitida por padrão.\n\nA política HttpAllowlist separada\npode ser usada para evitar que determinados nomes de host ou padrões de nome do host sejam\natualizados para HTTPS por esse recurso.";
HttpsUpgradesEnabled.pfm_title = "Ativar upgrades automáticos do HTTPS";
HttpsUpgradesEnabled.pfm_description = "O Brave tenta fazer upgrade de algumas\nnavegações de HTTP para HTTPS, quando possível. Essa política pode ser usada para\ndesativar esse comportamento. Se definido como \"verdadeiro\" ou não for definido, esse recurso será\nativado por padrão.\n\nA política HttpAllowlist separada\npode ser usada para evitar que determinados nomes de host ou padrões de nome de host sejam\natualizados para HTTPS por esse recurso.\n\nConsulte também a política HttpsOnlyMode.";
IPv6ReachabilityOverrideEnabled.pfm_title = "Ativar a substituição da verificação de acessibilidade do IPv6";
IPv6ReachabilityOverrideEnabled.pfm_description = "Se a política for definida como verdadeira, a verificação de acessibilidade do IPv6 será substituída. Isso significa que o\nsistema sempre vai consultar registros AAAA ao resolver nomes de host. Isso se aplica a\ntodos os usuários e interfaces no dispositivo.\n\nSe a política for definida como falsa ou for deixada sem definição, a verificação de acessibilidade do IPv6 não será substituída.\nO sistema só consulta registros AAAA quando está acessível a um host IPv6 global.";
IdleDetectionAllowedForUrls.pfm_title = "Sites permitidos para detecção de inatividade";
IdleDetectionAllowedForUrls.pfm_description = "Permite definir uma lista de padrões de URL que especificam os sites que podem usar a API Idle Detection sem pedir permissão ao usuário. As entradas da lista de bloqueio têm mais prioridade do que as entradas da lista de permissões, que têm menos prioridade do que o valor padrão configurado.\n\nPara saber mais sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos. A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.\n\nSe essa política não for definida, o valor padrão global será usado para todos os sites, o que é definido pela configuração pessoal do usuário ou pela política DefaultIdleDetectionSetting (Configuração padrão de detecção de inatividade), se ela for definida.";
IdleDetectionBlockedForUrls.pfm_title = "Sites bloqueados para detecção de inatividade";
IdleDetectionBlockedForUrls.pfm_description = "Permite definir uma lista de padrões de URL que especificam os sites que não têm permissão para usar a API Idle Detection.\n\nPara saber mais sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos. A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.\n\nSe essa política não for definida, o valor padrão global será usado para todos os sites, o que é definido pela configuração pessoal do usuário ou pela política DefaultIdleDetectionSetting (Configuração padrão de detecção de inatividade), se ela for definida.";
IdleTimeout.pfm_title = "Atraso antes de executar ações de inatividade";
IdleTimeout.pfm_description = "Acionar uma ação quando o computador está inativo.\n\nSe esta política for definida, ela especificará após quantos minutos sem entradas do usuário o navegador vai executar ações configuradas pela IdleTimeoutActions.\n\nSe a política for deixada sem definição, nenhuma ação será executada.\n\nO limite mínimo é de 1 minuto.\n\nA \"entrada do usuário\" é definida pelas APIs do sistema operacional e inclui ações como mover o mouse ou digitar no teclado.";
IdleTimeoutActions.pfm_title = "Ações a serem executadas quando o computador estiver inativo";
IdleTimeoutActions.pfm_description = "close_browsers - Fechar navegadores\nshow_profile_picker - Mostrar seletor de perfil\nclear_browsing_history - Limpar histórico de navegação\nclear_download_history - Limpar histórico de downloads\nclear_cookies_and_other_site_data - Limpar cookies e outros dados do site\nclear_cached_images_and_files - Limpar imagens e arquivos armazenados em cache\nclear_password_signin - Limpar login com senha\nclear_autofill - Limpar preenchimento automático\nclear_site_settings - Limpar configurações do site\nclear_hosted_app_data - Limpar dados de apps hospedados\nreload_pages - Atualizar páginas\nsign_out - Sair\nclose_tabs - Fechar guias\nLista de ações a serem executadas quando o tempo limite da política IdleTimeout for atingido.\n\nAviso: definir essa política pode afetar e remover permanentemente os dados pessoais locais. Recomendamos testar as configurações antes da implantação para evitar a exclusão acidental de dados pessoais.\n\nSe a IdleTimeout não for definida, esta política não terá efeito.\n\nQuando o tempo limite da IdleTimeout for atingido, o navegador vai executar as ações configuradas nesta política.\n\nSe esta política for deixada em branco ou sem definição, a IdleTimeout não terá efeito.\n\nAs ações disponíveis são:\n\nclose_browsers: fechar todos os PWAs e janelas do navegador deste perfil. Indisponível no Android e no iOS.\n\nclose_tabs: fechar todas as guias em janelas abertas. Disponível apenas no iOS.\n\nshow_profile_picker: mostrar a janela do seletor de perfil. Indisponível no Android e no iOS.\n\nsign_out: desconecta o usuário. Disponível apenas no iOS.\n\nclear_browsing_history, clear_download_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing, clear_autofill, clear_site_settings, clear_hosted_app_data: limpar os dados de navegação correspondentes. Consulte a política ClearBrowsingDataOnExitList para mais detalhes. Os tipos disponíveis no iOS são clear_browsing_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing e clear_autofill\n\nreload_pages: atualizar todas as páginas da Web. Em algumas delas, o usuário pode receber uma solicitação de confirmação primeiro. Indisponível no iOS.\n\nO usuário vai continuar conectado à Conta do Google ao usar clear_cookies_and_other_site_data para excluir cookies.\n\nA definição de clear_browsing_history, clear_password_signing, clear_autofill e clear_site_settings vai desativar a sincronização dos respectivos tipos de dados se a Chrome Sync nem a BrowserSignin forem desativadas pela configuração da política SyncDisabled.";
ImagesAllowedForUrls.pfm_title = "Permitir imagens nestes sites";
ImagesAllowedForUrls.pfm_description = "Se a política for definida, você poderá fazer uma lista de padrões de URL que especificam sites que podem exibir imagens.\n\nSe a política não tiver definição, DefaultImagesSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.\n\nEsta política já foi ativada no Android por engano, mas a funcionalidade nunca foi totalmente compatível com ele.";
ImagesBlockedForUrls.pfm_title = "Bloquear imagens nestes sites";
ImagesBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que não podem exibir imagens.\n\nSe a política não tiver definição, DefaultImagesSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\n Para saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.\n\n Esta política já foi ativada no Android por engano, mas a funcionalidade nunca foi totalmente compatível com ele.";
ImportAutofillFormData.pfm_title = "Importar dados de preenchimento automático de formulários do navegador padrão na primeira execução";
ImportAutofillFormData.pfm_description = "Se a política for definida como ativada, os dados de preenchimento automático de formulários serão importados do navegador padrão anterior durante a primeira execução. Se a política for definida como desativada ou não for definida, nenhum dado de preenchimento automático de formulário será importado durante a primeira execução.\n\nO usuário pode acionar uma caixa de diálogo de importação em que a caixa de seleção de dados de preenchimento automático de formulários estará marcada ou desmarcada de acordo com o valor da política.";
ImportBookmarks.pfm_title = "Importar favoritos do navegador padrão na primeira execução";
ImportBookmarks.pfm_description = "Se a política for definida como ativada, os favoritos serão importados do navegador padrão anterior durante a primeira execução. Se a política for definida como desativada ou não for definida, nenhum favorito será importado durante a primeira execução.\n\nO usuário pode acionar uma caixa de diálogo de importação em que a caixa de seleção dos favoritos estará marcada ou desmarcada de acordo com o valor da política.";
ImportHistory.pfm_title = "Importar histórico de navegação do navegador padrão na primeira execução";
ImportHistory.pfm_description = "Se a política for definida como ativada, o histórico de navegação será importado do navegador padrão anterior durante a primeira execução. Se a política for definida como desativada ou não for definida, o histórico de navegação não será importado durante a primeira execução.\n\nO usuário pode acionar uma caixa de diálogo de importação em que a caixa de seleção do histórico de navegação estará marcada ou desmarcada de acordo com o valor da política.";
ImportHomepage.pfm_title = "Importar homepage do navegador padrão na primeira execução";
ImportHomepage.pfm_description = "Se a política for definida como \"Ativada\", a página inicial será importada do navegador padrão anterior durante a primeira execução. Se a política for definida como \"Desativada\" ou não for definida, a página inicial não será importada durante a primeira execução.\n\nOs usuários podem acionar uma caixa de diálogo de importação em que a caixa de seleção da página inicial estará marcada ou desmarcada, de acordo com o valor da política.";
ImportSavedPasswords.pfm_title = "Importar senhas salvas do navegador padrão na primeira execução";
ImportSavedPasswords.pfm_description = "Esta política controla apenas o comportamento de importação da primeira execução depois que o navegador é instalado. Ela permite uma transição mais suave para o Brave em ambientes em que um outro navegador foi muito usado antes da instalação desse. Esta política não afeta os recursos do gerenciador de senhas para Contas do Google.\n\nSe ela for ativada, as senhas salvas serão importadas do navegador padrão anterior durante a primeira execução. Também será possível fazer a importação manual pela página de configurações.\nSe a política for desativada, nenhuma senha será importada durante a primeira execução, e a importação manual pela página de configurações será bloqueada.\nSe a política for deixada sem definição, nenhuma senha salva será importada na primeira execução, mas o usuário poderá fazer isso na página de configurações.";
ImportSearchEngine.pfm_title = "Importar mecanismos de pesquisa do navegador padrão na primeira execução";
ImportSearchEngine.pfm_description = "Se a política for definida como ativada, o mecanismo de pesquisa padrão será importado do navegador padrão anterior durante a primeira execução. Se a política for definida como desativada ou não for definida, o mecanismo de pesquisa padrão não será importado durante a primeira execução.\n\nO usuário pode acionar uma caixa de diálogo de importação em que a caixa de seleção do mecanismo de pesquisa padrão estará marcada ou desmarcada de acordo com o valor da política.";
IncognitoModeAvailability.pfm_title = "Disponibilidade do modo de navegação anônima";
IncognitoModeAvailability.pfm_description = "0 - Modo de navegação anônima disponível\n1 - Modo de navegação anônima desativado\n2 - Modo de navegação anônima forçado\nEspecifica se o usuário pode abrir páginas no modo de navegação anônima no Brave.\n\nSe a política for definida como \"Ativada\" ou não for definida, as páginas poderão ser abertas no modo de navegação anônima.\n\nSe ela for definida como \"Desativada\", as páginas não poderão ser abertas no modo de navegação anônima.\n\nSe a opção \"Forçada\" for selecionada, as páginas poderão ser abertas SOMENTE no modo de navegação anônima. A opção \"Forçada\" não funciona para o Android no Chrome\n\nA política IncognitoModeUrlAllowlist tem precedência e pode reativar o modo de navegação anônima para URLs específicos. Quando o modo de navegação anônima é desativado por essa política e uma lista de permissões é fornecida, ele fica disponível apenas para URLs que correspondem a essa lista, enquanto todas as outras páginas são bloqueadas.\n\nObservação: no iOS, se a política for alterada durante a sessão, ela só terá efeito após a reinicialização.";
IncognitoModeUrlAllowlist.pfm_title = "Permitir o acesso a uma lista de URLs no modo de navegação anônima.";
IncognitoModeUrlAllowlist.pfm_description = "Definir esta política concede acesso aos URLs listados no modo de navegação anônima. Ela pode abrir exceções para alguns padrões de URL definidos em IncognitoModeUrlBlocklist, usando o formato especificado em (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nSe esta política e IncognitoModeUrlBlocklist forem definidas, a lista de permissões terá precedência. Se um URL corresponder a um padrão na lista de permissões, ele será permitido. Se corresponder a um padrão na lista de bloqueio (mas não na lista de permissões), será bloqueado. Se um URL não corresponder a nenhuma delas, as políticas gerais URLBlocklist/URLAllowlist serão usadas como substitutas.\n\nSe esta política estiver definida e a IncognitoModeUrlBlocklist não, qualquer URL que não estiver na lista de permissões será bloqueado no modo de navegação anônima.\n\nSe a política IncognitoModeAvailability estiver definida como não permitida (valor 1), mas esta política estiver configurada, o modo de navegação anônima só vai estar disponível para URLs que corresponderem à lista de permissões.\n\nSe a política não for definida, nenhuma exceção a IncognitoModeUrlBlocklist e IncognitoModeAvailability será permitida.\n\nA política afeta apenas o modo de navegação anônima. Se quiser permitir URLs para todos os perfis de usuário, use a política URLAllowlist.\n\nCuringas genéricos para hosts (ou seja, \"*\" ou \"[*]\") não são permitidos. Use a política IncognitoModeAvailability para ativar o recurso globalmente.\n\nEsta política tem um limite de 1.000 entradas.";
IncognitoModeUrlBlocklist.pfm_title = "Bloquear o acesso a uma lista de URLs no modo de navegação anônima.";
IncognitoModeUrlBlocklist.pfm_description = "Se a política IncognitoModeUrlBlocklist for definida, as páginas da web que têm URLs proibidos não vão ser carregadas no modo de navegação anônima. Os admins podem especificar a lista de padrões de URL a serem bloqueados. Confira como formatar um padrão de URL ( https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nSe esta política e a IncognitoModeUrlAllowlist estiverem definidas, a lista de permissões terá precedência. Se um URL corresponder a um padrão na lista de permissões, ele será permitido. Se corresponder a um padrão na lista de bloqueio, mas não na lista de permissões, será bloqueado. Se um URL não corresponder a nenhuma delas, as políticas gerais URLBlocklist/URLAllowlist serão usadas como substitutas.\n\nSe a política IncognitoModeUrlAllowlist estiver definida e esta não, qualquer URL que não estiver na lista de permissões será bloqueado no modo de navegação anônima.\n\nSe IncognitoModeAvailability for definida como não permitida (valor 1), mas a política IncognitoModeUrlAllowlist estiver configurada, o modo de navegação anônima vai estar disponível apenas para URLs que corresponderem à lista de permissões.\n\nA política afeta apenas o modo de navegação anônima. Se quiser bloquear URLs para todos os perfis de usuário, use a política URLBlocklist.\n\nEsta política tem um limite de 1.000 entradas.";
InsecureContentAllowedForUrls.pfm_title = "Permitir conteúdo não seguro nesses sites";
InsecureContentAllowedForUrls.pfm_description = "Permite a definição de uma lista de padrões de URL que especifica sites sem permissão para exibir conteúdo misto bloqueável (ativo), ou seja, conteúdo HTTP em sites HTTPS, e em que o conteúdo misto opcionalmente bloqueável (passivo) será desativado.\n\nSe esta política não for definida, o conteúdo misto bloqueável será bloqueado e o conteúdo misto opcionalmente bloqueável ganhará um upgrade. Além disso, o usuário poderá definir exceções para dar permissão a sites específicos.\n\nPara saber mais sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
InsecureContentBlockedForUrls.pfm_title = "Bloquear conteúdo não seguro nesses sites";
InsecureContentBlockedForUrls.pfm_description = "Permite que você defina uma lista de padrões de URL que especificam sites sem permissão para exibir conteúdo misto bloqueável (ativo), ou seja, conteúdo HTTP em sites HTTPS, e em que será feito o upgrade de conteúdo misto opcionalmente bloqueável (passivo).\n\nSe esta política não for definida, o conteúdo misto bloqueável será bloqueado e o conteúdo misto opcionalmente bloqueável ganhará um upgrade, mas o usuário poderá definir exceções para dar permissão a sites específicos.\n\nPara saber mais sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
IntensiveWakeUpThrottlingEnabled.pfm_title = "Controlar o recurso de IntensiveWakeUpThrottling.";
IntensiveWakeUpThrottlingEnabled.pfm_description = "Quando ativado, o recurso IntensiveWakeUpThrottling faz com que os timers JavaScript nas guias em segundo plano sejam agressivamente limitados e agrupados, sendo executados no máximo uma vez por minuto depois que uma página tiver ficado 5 minutos ou mais em segundo plano.\n\nEsse é um recurso que obedece aos padrões da Web, mas pode causar falhas na funcionalidade\nem alguns sites, fazendo com que certas ações sofram um atraso de até um\nminuto. No entanto, ele economiza significativamente o uso da bateria e da CPU quando\nativado. Acesse https://bit.ly/30b1XR4 para ver mais detalhes (em inglês).\n\nSe essa política for ativada, o recurso vai ter uma ativação forçada e\no usuário não vai poder modificar isso.\n\nSe ela for desativada, o recurso vai ter uma desativação forçada e\no usuário não vai poder modificar isso.\n\nSe ela não for definida, o recurso vai ser controlado pela própria\nlógica interna, que pode ser configurada manualmente pelo usuário.\n\nObserve que a política é aplicada em cada processo do renderizador, com os valores\nmais recentes dela sendo aplicados quando um processo do renderizador é iniciado. Uma reinicialização\ncompleta é necessária para garantir que todas as guias carregadas recebam uma configuração\nconsistente da política. Não há problemas em executar processos com valores\ndiferentes desta política.\n";
IntranetRedirectBehavior.pfm_title = "Comportamento de redirecionamento à intranet";
IntranetRedirectBehavior.pfm_description = "0 - Usar comportamento do navegador padrão.\n1 - Desativar verificações de interceptação de DNS e barras de informações oferecendo \"http://intranetsite/\" como alternativa.\n2 - Desativar verificações de interceptação de DNS. Permitir barras de informações oferecendo \"http://intranetsite/\" como alternativa.\n3 - Permitir verificações de interceptação de DNS e barras de informações oferecendo \"http://intranetsite/\" como alternativa.\nEsta política configura o comportamento de redirecionamento à intranet por verificações de interceptação de DNS. As verificações tentam descobrir se o navegador está por trás de um proxy que redireciona nomes de host desconhecidos.\n\nSe a política não for definida, o navegador usará o comportamento padrão de verificações de interceptação de DNS e sugestões de redirecionamento à intranet. Na versão M88, esses comportamentos estão ativados por padrão, mas serão desativados em uma versão futura.\n\nA DNSInterceptionChecksEnabled é uma política relacionada que também pode desativar verificações de interceptação de DNS. Esta política é uma versão mais flexível, que pode controlar barras de informações de redirecionamento à intranet separadamente e ainda pode ser expandida no futuro.\nSe DNSInterceptionChecksEnabled ou esta política solicitarem que as verificações de interceptação sejam desativadas, elas serão desativadas.";
IsolateOrigins.pfm_title = "Ativar o isolamento de sites para origens específicas";
IsolateOrigins.pfm_description = "Especifique uma lista de origens que são executadas em um processo dedicado.\n\nNo Android, essa política só funciona em dispositivos com memória suficiente (mais de 3,2 GB de RAM), porque o isolamento de muitos sites em dispositivos com recursos limitados pode causar problemas de desempenho. Para dispositivos Android com recursos limitados, use IsolateOriginsShortlist.\n\nNão é recomendado configurar o isolamento de processos em dispositivos com menos de 1 GB de memória.\n\nCada processo de uma origem indicada só poderá conter documentos da origem em questão e dos subdomínios dela. Por exemplo, se https://a1.example.com/ for especificada, https://a2.a1.example.com/ será permitida no mesmo processo, mas https://example.com ou https://b.example.com não serão.\n\nDesde o Brave 77, também é possível especificar um intervalo de origens isoladas usando um caractere curinga. Por exemplo, se https://[*.]corp.example.com for especificada, todas as origens abaixo de https://corp.example.com ganharão um processo dedicado, incluindo a própria https://corp.example.com, a https://a1.corp.example.com e a https://a2.a1.corp.example.com.\n\nObserve que todos os sites (ou seja, esquema + eTLD+1, como https://example.com) já são isolados por padrão em plataformas para computador, conforme definido na política SitePerProcess. A política IsolateOrigins é útil para isolar origens específicas com uma granularidade mais refinada (por exemplo, https://a.example.com).\n\nObserve que o Android isola certos sites sensíveis por padrão a partir da versão 77 do Brave, e essa política estende esse modo para isolar outras origens específicas.\n\nObserve também que as origens isoladas por essa política não poderão criar scripts de outras origens no mesmo site, ação que é possível quando dois documentos do mesmo site modificam os valores de document.domain para que sejam correspondentes. Os admins precisam confirmar se esse comportamento incomum não está sendo usado em uma origem antes de isolá-la.\n\nSe a política for definida como uma string vazia ou deixada sem definição, o isolamento de sites não será exigido para nenhuma origem específica. Os usuários ainda poderão ativar o isolamento de processos de forma manual com a flag de linha de comando.";
JavaScriptAllowedForUrls.pfm_title = "Permitir o JavaScript nestes sites";
JavaScriptAllowedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica sites que podem executar JavaScript.\n\nSe a política não tiver definição, DefaultJavaScriptSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
JavaScriptBlockedForUrls.pfm_title = "Bloquear o JavaScript nestes sites";
JavaScriptBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica sites que não podem executar JavaScript.\n\nSe a política não tiver definição, DefaultJavaScriptSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.\n\nEsta política bloqueia o JavaScript com base na correspondência entre a origem do documento de nível superior (geralmente o URL da página que também é mostrado na barra de endereços) e um dos padrões. Ela não é adequada para mitigar ataques de cadeia de suprimentos da web. Por exemplo, fornecer o padrão \"https://[*.]foo.com/\" não vai impedir que uma página hospedada em https://example.com execute um script carregado de https://www.foo.com/example.js. Além disso, fornecer o padrão \"https://example.com/\" não vai impedir que um documento de https://example.com execute scripts se ele não for o documento de nível superior, mas incorporado como um subframe em uma página hospedada em outra origem, como https://www.bar.com.";
JavaScriptJitAllowedForSites.pfm_title = "Permitir o uso do JIT pelo JavaScript nestes sites";
JavaScriptJitAllowedForSites.pfm_description = "Permite definir uma lista de padrões de URL que especificam sites com permissão para executar o JavaScript com o compilador Just-in-Time (JIT, na sigla em inglês) ativado.\n\nPara informações mais detalhadas sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.\n\nAs exceções da política podem ser definidas para subdomínios específicos, assim como para sites inteiros. Por exemplo, uma política definida apenas para subdomínio.site.com se aplica a subdomínio.site.com sem afetar site.com. Em alguns casos em que não é possível isolar um subdomínio do site pai, ele pode herdar a política definida em site.com. Além disso, talvez as exceções não entrem em vigor para frames carregados em uma guia atual até que o site seja aberto em uma nova guia. Em dispositivos Android com pouca memória, as exceções específicas do site podem não ser aplicadas. Nesses casos, os sites usarão a política de DefaultJavaScriptJitSetting (se definida) ou vão adotar o ajuste padrão de JIT do JavaScript do perfil.\n\nPara aplicar as exceções, o Brave pode colocar em processos dedicados os sites ou subdomínios com configurações diferentes do padrão. Isso pode aumentar o uso da memória, especialmente no Android ou quando um padrão de caracteres curinga corresponde a muitos subdomínios, já que cada origem compatível pode ser isolada separadamente. Os subdomínios isolados também não podem usar document.domain para acessar o site pai.\n\nObservação: nas versões 155 e anteriores, as exceções da política eram aplicadas apenas na granularidade de um site (eTLD+1). Uma política definida apenas para subdomínio.site.com não entrava em vigor, nem mesmo para subdomínio.site.com. Ela precisava ser definida em site.com para ser aplicada tanto a site.com quanto a subdomínio.site.com.\n\nEssa política é aplicada frame a frame, e não apenas com base no URL de origem de nível superior. Por exemplo, se o site-um.com estiver listado na política JavaScriptJitAllowedForSites, mas carregar um frame que contém o site-dois.com, o primeiro terá o JIT do JavaScript ativado, mas o segundo vai usar a política de DefaultJavaScriptJitSetting (se definida) ou adotará o JIT do JavaScript ativado por padrão. As entradas da lista de bloqueio têm mais prioridade do que as da lista de permissões, que têm menos prioridade do que o valor padrão configurado.\n\nSe esta política for deixada sem definição para um site, a política do DefaultJavaScriptJitSetting será aplicada (se definida). Do contrário, um JIT do JavaScript será ativado para o site.";
JavaScriptJitBlockedForSites.pfm_title = "Bloquear o uso de JIT pelo JavaScript nestes sites";
JavaScriptJitBlockedForSites.pfm_description = "Permite definir uma lista de padrões de URL que especificam sites sem permissão para executar o compilador Just-in-Time (JIT, na sigla em inglês) do JavaScript ativado.\n\nSe você desativar o JIT do JavaScript, o Brave poderá renderizar conteúdo da web mais lentamente, e partes do próprio JavaScript poderão ser desativadas, incluindo o WebAssembly. Com a desativação do JIT do JavaScript, o Brave poderá renderizar conteúdo da web com uma configuração mais segura.\n\nPara informações mais detalhadas sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.\n\nAs exceções da política podem ser definidas para subdomínios específicos, assim como para sites inteiros. Por exemplo, uma política definida apenas para subdomínio.site.com se aplica a subdomínio.site.com sem afetar site.com. Em alguns casos em que não é possível isolar um subdomínio do site pai, ele pode herdar a política definida em site.com. Além disso, talvez as exceções não entrem em vigor para frames carregados em uma guia atual até que o site seja aberto em uma nova guia. Em dispositivos Android com pouca memória, as exceções específicas do site podem não ser aplicadas. Nesses casos, os sites usarão a política de DefaultJavaScriptJitSetting (se definida) ou vão adotar o ajuste padrão de JIT do JavaScript do perfil.\n\nPara aplicar as exceções, o Brave pode colocar em processos dedicados os sites ou subdomínios com configurações diferentes do padrão. Isso pode aumentar o uso da memória, especialmente no Android ou quando um padrão de caracteres curinga corresponde a muitos subdomínios, já que cada origem compatível pode ser isolada separadamente. Os subdomínios isolados também não podem usar document.domain para acessar o site pai.\n\nObservação: nas versões 155 e anteriores, as exceções da política eram aplicadas apenas na granularidade de um site (eTLD+1). Uma política definida apenas para subdomínio.site.com não entrava em vigor, nem mesmo para subdomínio.site.com. Ela precisava ser definida em site.com para ser aplicada tanto a site.com quanto a subdomínio.site.com.\n\nEssa política é aplicada frame a frame, e não apenas com base no URL de origem de nível superior. Por exemplo, se o site-um.com estiver listado na política JavaScriptJitBlockedForSites, mas carregar um frame que contém o site-dois.com, o primeiro terá o JIT do JavaScript desativado, mas o segundo vai usar a política de DefaultJavaScriptJitSetting (se definida) ou adotará o JIT do JavaScript ativado por padrão. As entradas da lista de bloqueio têm mais prioridade do que as da lista de permissões, que têm menos prioridade do que o valor padrão configurado.\n\nSe esta política for deixada sem definição para um site, a política de DefaultJavaScriptJitSetting será aplicada (se definida). Do contrário, um JIT do JavaScript será ativado.";
JavaScriptOptimizerAllowedForSites.pfm_title = "Permitir a otimização do JavaScript nestes sites";
JavaScriptOptimizerAllowedForSites.pfm_description = "Permite definir uma lista de padrões de URL que especifica os sites em que\nas otimizações avançadas do JavaScript são ativadas.\n\nPara saber mais sobre padrões de URL válidos, consulte\nhttps://chromeenterprise.google/policies/url-patterns.\nCaracteres curinga (*) são permitidos.\n\nAs exceções da política podem ser definidas para subdomínios específicos, assim como para sites inteiros.\nPor exemplo, uma política definida apenas para subdomínio.site.com se aplica a\nsubdomínio.site.com sem afetar site.com. Em alguns casos em que um\nsubdomínio não pode ser isolado do site pai, ele pode herdar a política\ndefinida em site.com. Além disso, as exceções podem não entrar em vigor para frames carregados em uma\nguia existente até que o site seja aberto em uma nova guia. Em dispositivos\nAndroid com pouca memória, as exceções específicas do site podem\nnão ser aplicadas. Nesses casos, os sites usarão a política de\nDefaultJavaScriptOptimizerSetting\n(se definida) ou vão adotar o ajuste padrão de otimização do JavaScript do perfil.\n\nPara aplicar as exceções, o Brave\npode colocar em processos dedicados os sites ou subdomínios com configurações\ndiferentes do padrão. Isso pode aumentar o uso da memória, especialmente no\nAndroid ou quando um padrão de caracteres curinga corresponde a muitos\nsubdomínios, já que cada origem compatível pode ser isolada separadamente. Os subdomínios\nisolados também não podem usar document.domain para acessar o site pai.\n\nObservação: nas versões 138 e anteriores, as exceções da política eram aplicadas apenas na\ngranularidade de um site (eTLD+1). Uma política definida apenas para subdomínio.site.com não\nentrava em vigor, nem mesmo para subdomínio.site.com. Ela precisava ser definida em site.com para\nser aplicada tanto a site.com quanto a subdomínio.site.com.\n\nEssa política é aplicada frame a frame, e não apenas com base no URL de origem\nde nível superior. Por exemplo, se o site-um.com estiver listado na política JavaScriptOptimizerAllowedForSites, mas carregar um frame que contém o site-dois.com, o primeiro terá otimizações do JavaScript\nativadas, mas o segundo vai usar a política de DefaultJavaScriptOptimizerSetting (se definida) ou adotará otimizações do JavaScript\nativadas por padrão. As entradas da lista de bloqueio têm prioridade maior do que as da\nlista de permissões, que têm prioridade maior do que o valor padrão configurado.\n\nSe esta política for deixada sem definição para um site, a política do DefaultJavaScriptOptimizerSetting será aplicada (se definida). Caso contrário,\na otimização do JavaScript será ativada para o site.";
JavaScriptOptimizerBlockedForSites.pfm_title = "Bloquear as otimizações do JavaScript nestes sites";
JavaScriptOptimizerBlockedForSites.pfm_description = "Permite definir uma lista de padrões de URL que especifica os sites em que as otimizações avançadas\ndo JavaScript são desativadas.\n\nSe você desativar as otimizações do JavaScript, o Brave poderá renderizar conteúdo da web mais lentamente.\n\nPara informações mais detalhadas sobre os padrões de URL válidos, consulte\nhttps://chromeenterprise.google/policies/url-patterns.\nCaracteres curinga (*) são permitidos.\n\nAs exceções da política podem ser definidas para subdomínios específicos, assim como para sites inteiros.\nPor exemplo, uma política definida apenas para subdomínio.site.com se aplica a\nsubdomínio.site.com sem afetar site.com. Em alguns casos em que um\nsubdomínio não pode ser isolado do site pai, ele pode herdar a política\ndefinida em site.com. Além disso, as exceções podem não entrar em vigor para frames carregados em uma\nguia existente até que o site seja aberto em uma nova guia. Em dispositivos\nAndroid com pouca memória, as exceções específicas do site podem\nnão ser aplicadas. Nesses casos, os sites usarão a política de\nDefaultJavaScriptOptimizerSetting\n(se definida) ou vão adotar o ajuste padrão de otimização do JavaScript do perfil.\n\nPara aplicar as exceções, o Brave\npode colocar em processos dedicados os sites ou subdomínios com configurações\ndiferentes do padrão. Isso pode aumentar o uso da memória, especialmente no\nAndroid ou quando um padrão de caracteres curinga corresponde a muitos\nsubdomínios, já que cada origem compatível pode ser isolada separadamente. Os subdomínios\nisolados também não podem usar document.domain para acessar o site pai.\n\nObservação: nas versões 138 e anteriores, as exceções da política eram aplicadas apenas na\ngranularidade de um site (eTLD+1). Uma política definida apenas para subdomínio.site.com não\nentrava em vigor, nem mesmo para subdomínio.site.com. Ela precisava ser definida em site.com para\nser aplicada tanto a site.com quanto a subdomínio.site.com.\n\nEssa política é aplicada frame a frame, e não apenas com base no URL de origem\nde nível superior. Por exemplo, se o site-um.com estiver listado na política JavaScriptOptimizerBlockedForSites, mas carregar um frame que\ncontém o site-dois.com, o primeiro terá otimizações do JavaScript\ndesativadas, mas o segundo vai usar a política de DefaultJavaScriptOptimizerSetting (se definida) ou adotará otimizações do JavaScript\nativadas por padrão. As entradas da lista de bloqueio têm prioridade maior do que as da\nlista de permissões, que têm prioridade maior do que o valor padrão configurado.\n\nSe esta política for deixada sem definição para um site, a política de DefaultJavaScriptOptimizerSetting será aplicada (se definida). Do contrário,\na otimização do JavaScript será ativada.";
LiveCaptionEnabled.pfm_title = "Ative a legenda instantânea";
LiveCaptionEnabled.pfm_description = "Ative a legenda instantânea.\n\nSe essa política for ativada, a legenda instantânea vai ficar sempre ativada.\n\nSe ela for desativada, a legenda instantânea também vai ficar desativada.\n\nSe for definida como obrigatória, o usuário não poderá mudar nem substituir essa política.\n\nSe for deixada sem definição, a legenda instantânea vai ficar desativada inicialmente, mas poderá ser ativada pelo usuário a qualquer momento.";
LiveTranslateEnabled.pfm_title = "Ativar a tradução instantânea";
LiveTranslateEnabled.pfm_description = "Ative a tradução da legenda instantânea. As legendas serão enviadas ao Google para tradução.\n\nSe essa política for ativada, a tradução instantânea vai ficar sempre ativada.\n\nSe ela for desativada, a tradução instantânea também vai ficar desativada.\n\nSe for definida como obrigatória, o usuário não poderá mudar nem substituir essa política.\n\nSe for deixada sem definição, a tradução instantânea vai ficar desativada inicialmente, mas poderá ser ativada pelo usuário a qualquer momento.\n\nSe a opção LiveCaptionEnabled estiver desativada, a tradução instantânea também será desativada, não importando a configuração dessa política.";
LocalFontsAllowedForUrls.pfm_title = "Autorizar a permissão para fontes locais nesses sites";
LocalFontsAllowedForUrls.pfm_description = "Define uma lista de padrões de URL especificando sites que permitem fontes locais automaticamente. Isso vai ampliar a capacidade dos sites de ver informações sobre fontes locais.\n\nPara saber mais sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos. A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.\n\nSe esta política for deixada sem definição para um site, a política de DefaultLocalFontsSetting será aplicada, quando configurada. Caso contrário, a permissão vai seguir os padrões do navegador e autorizar a escolha dos usuários para cada site.";
LocalFontsBlockedForUrls.pfm_title = "Bloquear a permissão para fontes locais nesses sites";
LocalFontsBlockedForUrls.pfm_description = "Define uma lista de padrões de URL que especificam quais sites negam permissão a fontes locais automaticamente. Isso limita a capacidade dos sites de ver informações sobre fontes locais.\n\nPara informações mais detalhadas sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos. A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.\n\nSe esta política não for definida para um site, a política de DefaultLocalFontsSetting será aplicada, quando configurada. Caso contrário, a permissão vai seguir os padrões do navegador e autorizar a escolha dos usuários para cada site.";
LocalNetworkAccessAllowedForUrls.pfm_title = "Permitir que sites façam solicitações de rede para dispositivos locais e endpoints da rede local.";
LocalNetworkAccessAllowedForUrls.pfm_description = "Lista de padrões do URL. Solicitações de rede iniciadas em sites com as mesmas origens não ficam sujeitas a verificações de Local Network Access.\n\nSe as origens não corresponderem aos padrões especificados aqui, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões do URL válidos, acesse https://chromeenterprise.google/policies/url-patterns/.\n\nConsulte as restrições de Local Network Access em https://wicg.github.io/local-network-access/ (em inglês).\n\nVárias políticas listam origens que afetam as solicitações para o dispositivo local e para endpoints da rede local. Se mais de uma das políticas abaixo estiver associada à origem, elas serão aplicadas nesta ordem:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "Impedir que sites façam solicitações de rede para dispositivos locais e endpoints da rede local.";
LocalNetworkAccessBlockedForUrls.pfm_description = "Lista de padrões do URL. Solicitações de rede iniciadas em sites que têm as mesmas origens são bloqueadas e não podem solicitar Local Network Access.\n\nSe as origens não corresponderem aos padrões especificados aqui, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões do URL válidos, acesse https://chromeenterprise.google/policies/url-patterns/.\n\nConsulte as restrições de Local Network Access em https://wicg.github.io/local-network-access/ (em inglês).\n\nVárias políticas listam origens que afetam as solicitações para o dispositivo local e para endpoints da rede local. Se mais de uma das políticas abaixo estiver associada à origem, elas serão aplicadas nesta ordem:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "Substituir mapeamentos de espaço de endereço IP";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "A política pode ser usada para tratar determinados intervalos de endereços internos como \"públicos\" e, portanto, não sujeitos a verificações de Local Network Access. Da mesma maneira, pode ser usada para tratar determinados intervalos de endereços públicos com possível uso interno como endereços \"locais\" para que fiquem protegidos por verificações de Local Network Access.\n\nAs substituições de espaço de endereço IP têm duas formas:\n\n[cidr]=[public|local|loopback]\n\nNesta, [cidr] é um intervalo de endereço IP na notação CIDR (consulte a seção 3.1 de https://tools.ietf.org/html/rfc4632 para IPv4 e a seção 2.3 de https://tools.ietf.org/html/rfc4291 para IPv6). Endereços IPv6 precisam ser especificados em formato seguro para URL (entre colchetes). As substituições de CIDR se aplicam a todas as portas.\n\nou\n\n[ip-address]:[port]=[public|local|loopback]\n\nPara saber mais sobre o Local Network Access, consulte https://wicg.github.io/local-network-access/ e https://developer.chrome.com/blog/local-network-access.\n\nEsta política não é compatível com atualização dinâmica.\n\nAs substituições da chave de linha de comando --ip-address-space-overrides têm precedência sobre as definidas por esta política.";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "Permitir que subframes sem delegação explícita solicitem acesso à rede local (LNA)";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "Por padrão, as permissões de acesso à rede local (LNA) só podem ser solicitadas em subframes de origem cruzada quando há delegação explícita. Esta política pode ser usada para substituir o comportamento padrão, porque ela transmite automaticamente para os subframes as permissões de LNA, a menos que sejam explicitamente negadas na política de permissões.\n\nSe a política estiver ativada, os subframes recebem por padrão todas as permissões de LNA e podem fazer solicitações à rede local, o que aciona o aviso de permissão.\n\nSe a política estiver desativada ou sem uma configuração definida, os subframes precisarão receber a delegação explícita da permissão para fazer solicitações à rede local e acionar o comando de permissão.\n\nEsta política se aplica aos recursos da política de permissões \"local-network-access\", \"loopback-network\" e \"local-network\".\n\nPara mais informações sobre o acesso à rede local, consulte https://wicg.github.io/local-network-access/ (em inglês) e https://developer.chrome.com/blog/local-network-access?hl=pt-br.\n\nPara mais informações sobre a política de permissões, consulte https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy (em inglês).";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "Especifica se é necessário desativar (temporariamente) as restrições de acesso à rede local";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "Se esta política for ativada, as solicitações de Local Network Access\nsó vão mostrar avisos no Chrome DevTools devido a falhas nas verificações de Local Network Access.\n\nSe ela for desativada ou não for definida, as solicitações de Local Network Access vão usar o\ngerenciamento padrão.\n\nConsulte as restrições de Local Network Access em https://wicg.github.io/local-network-access/ (em inglês).\n\nEsta política corporativa é temporária e será removida após a versão M163.\n\nA longo prazo, a política LocalNetworkAccessAllowedForUrls\npode ser usada para permitir padrões de URL que devem receber automaticamente\na permissão Local Network Access.";
LocalNetworkAllowedForUrls.pfm_title = "Permitir que sites façam solicitações de rede para endpoints da rede local.";
LocalNetworkAllowedForUrls.pfm_description = "Lista de padrões de URL. Solicitações de rede iniciadas em sites que têm as mesmas origens dos endpoints da rede local não estão sujeitas a verificações de Local Network Access.\n\nSe as origens não corresponderem aos padrões especificados aqui, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de URL válidos, acesse https://chromeenterprise.google/policies/url-patterns/.\n\nConsulte as restrições de Local Network Access em https://wicg.github.io/local-network-access/ (em inglês).\n\nVárias políticas listam origens que afetam as solicitações para endpoints da rede local. Se mais de uma das políticas abaixo estiver associada à origem, elas serão aplicadas nesta ordem:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkBlockedForUrls.pfm_title = "Impedir que sites façam solicitações de rede para endpoints da rede local.";
LocalNetworkBlockedForUrls.pfm_description = "Lista de padrões de URL. Solicitações de rede iniciadas em sites que têm as mesmas origens dos endpoints da rede local são bloqueadas e não podem pedirLocal Network Access.\n\nSe as origens não corresponderem aos padrões especificados aqui, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de URL válidos, acesse https://chromeenterprise.google/policies/url-patterns/.\n\nConsulte as restrições de Local Network Access em https://wicg.github.io/local-network-access/ (em inglês).\n\nVárias políticas listam origens que afetam as solicitações para endpoints da rede local. Se mais de uma das políticas abaixo estiver associada à origem, elas serão aplicadas nesta ordem:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LookalikeWarningAllowlistDomains.pfm_title = "Suprimir alertas de domínios parecidos em domínios";
LookalikeWarningAllowlistDomains.pfm_description = "Esta política evita a exibição de alertas de URL parecido nos sites listados. Geralmente, esses alertas são exibidos em sites em que o Brave acredita estar havendo uma tentativa de spoofing, ou seja, a falsificação de um site conhecido pelo usuário.\n\nSe a política estiver ativada e for definida para um ou mais domínios, nenhuma página de alerta para URL parecido será exibida nas páginas do domínio em questão.\n\nSe a política for definida como uma lista vazia ou for deixada sem definição, os avisos poderão ser exibidos em qualquer site acessado pelo usuário.\n\nUm nome de host pode ser permitido com uma correspondência completa do host ou qualquer correspondência do domínio. Por exemplo, os alertas de um URL como \"https://foo.example.com/bar\" serão suprimidos se a lista incluir \"foo.example.com\" ou \"example.com\".";
LoopbackNetworkAllowedForUrls.pfm_title = "Permitir que sites façam solicitações de rede para o dispositivo local.";
LoopbackNetworkAllowedForUrls.pfm_description = "Lista de padrões de URL. Solicitações de rede iniciadas em sites que têm as mesmas origens do dispositivo local não estão sujeitas a verificações de Local Network Access.\n\nSe as origens não corresponderem aos padrões especificados aqui, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de URL válidos, acesse https://chromeenterprise.google/policies/url-patterns/.\n\nConsulte as restrições de Local Network Access em https://wicg.github.io/local-network-access/ (em inglês).\n\nVárias políticas listam origens que afetam as solicitações enviadas para o dispositivo local. Se mais de uma das políticas abaixo estiver associada à origem, elas serão aplicadas nesta ordem:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LoopbackNetworkBlockedForUrls.pfm_title = "Impedir que sites façam solicitações de rede para o dispositivo local.";
LoopbackNetworkBlockedForUrls.pfm_description = "Lista de padrões de URL. Solicitações de rede iniciadas em sites que têm as mesmas origens do dispositivo local são bloqueadas e não podem pedir Local Network Access.\n\nSe as origens não corresponderem aos padrões especificados aqui, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de URL válidos, acesse https://chromeenterprise.google/policies/url-patterns/.\n\nConsulte as restrições de Local Network Access em https://wicg.github.io/local-network-access/ (em inglês).\n\nVárias políticas listam origens que afetam as solicitações enviadas para o dispositivo local. Se mais de uma das políticas abaixo estiver associada à origem, elas serão aplicadas nesta ordem:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
ManagedBookmarks.pfm_title = "Favoritos gerenciados";
ManagedBookmarks.pfm_description = "A definição desta política configura uma lista de favoritos em que cada um deles é um dicionário contendo as chaves \"name\" e \"url\", que definem o nome e o destino do favorito. Os administradores podem configurar uma subpasta definindo um favorito sem uma chave \"url\", mas com uma outra chave \"children\". Essa chave também tem uma lista de favoritos, alguns dos quais podem ser pastas. O Chrome modifica URLs incompletos como se eles tivessem sido enviados pela barra de endereço. Por exemplo, \"google.com\" se torna \"https://google.com/\".\n\nOs usuários não podem mudar as pastas em que os favoritos estão, embora seja possível ocultá-las da barra de favoritos. O nome padrão da pasta de favoritos gerenciados é \"Favoritos gerenciados\", mas ele pode ser modificado ao adicionar um novo subdicionário à política com uma única chave chamada \"toplevel_name\" usando o nome da pasta desejada como valor. Os favoritos gerenciados não são sincronizados com a conta do usuário, e as extensões não podem modificá-los.\nConsulte https://chromeenterprise.google/policies/?policy=ManagedBookmarks para ver mais informações sobre esquema e formatação.";
ManagedConfigurationPerOrigin.pfm_title = "Define valores de configuração gerenciada para sites de origens específicas";
ManagedConfigurationPerOrigin.pfm_description = "Se a política for definida, o valor de retorno da API Managed Configuration será definido para origens específicas.\n\n A API Managed Configuration é uma configuração de chave-valor que pode ser acessada pela chamada de navigator.managed.getManagedConfiguration() no JavaScript. Ela só está disponível em origens correspondentes a aplicativos da Web de instalação forçada via WebAppInstallForceList.\n\nConsulte https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin para ver mais informações sobre esquema e formatação.";
MaxConnectionsPerProxy.pfm_title = "Número máximo de conexões simultâneas por servidor proxy para solicitações que não são WebSocket";
MaxConnectionsPerProxy.pfm_description = "Se a política for definida, será especificado o número máximo de conexões simultâneas por servidor proxy para solicitações que não são WebSocket.\n\nPara modificar o limite de solicitações WebSocket, consulte MaxConnectionsPerProxyForWebSocket.\n\nSe a política não for definida, o valor padrão de 128 será usado.\n\nAlguns web apps são conhecidos por consumir muitas conexões com GETs irresponsivos, então, definir um valor inferior a 128 pode gerar interrupções na rede do navegador caso haja muitos deles com conexões pendentes abertas.\nAlguns servidores proxy não podem administrar um grande número de conexões simultâneas por cliente, mas isso pode ser resolvido definindo um número menor para esta política.\n\nO valor deve ser igual ou maior que 6.\nSe você definir um número abaixo desse limite, o valor 6 será usado.\nA definição de valores abaixo do padrão (128) fica sob sua responsabilidade.\n\nO valor deve ser igual ou inferior a 256 (99 para Brave e 147 para versões anteriores).\nSe você definir um número acima desse limite, o valor 256 será usado (99 para Brave e 147 para versões anteriores).\nAumentar acima do padrão (128) fica sob sua responsabilidade.\n\nOs limites aplicados são afetados por AllowSocketPoolSizeRandomizationForProxies.";
MaxConnectionsPerProxyForWebSocket.pfm_title = "Número máximo de conexões simultâneas por servidor proxy para solicitações WebSocket";
MaxConnectionsPerProxyForWebSocket.pfm_description = "Se a política for definida, será especificado o número máximo de conexões simultâneas por servidor proxy para solicitações WebSocket.\n\nPara modificar o limite de solicitações que não são WebSocket, consulte MaxConnectionsPerProxy.\n\nSe a política não for definida, o valor padrão de 128 será usado.\n\nAlguns web apps são conhecidos por consumir muitas conexões com GETs irresponsivos, então, definir um valor inferior a 128 pode gerar interrupções na rede do navegador caso haja muitos deles com conexões pendentes abertas.\nAlguns servidores proxy não podem administrar um grande número de conexões simultâneas por cliente, mas isso pode ser resolvido definindo um número menor para esta política.\n\nO valor deve ser igual ou maior que 6.\nSe você definir um número abaixo desse limite, o valor 6 será usado.\nA definição de valores abaixo do padrão (128) fica sob sua responsabilidade.\n\nO valor deve ser igual ou inferior a 256.\nSe você definir um número acima desse limite, o valor 256 será usado.\nAumentar acima do padrão (128) fica sob sua responsabilidade.\n\nOs limites aplicados são afetados por AllowSocketPoolSizeRandomizationForProxies.";
MaxInvalidationFetchDelay.pfm_title = "Atraso máximo de busca após a invalidação de uma política";
MaxInvalidationFetchDelay.pfm_description = "A definição da política especifica o atraso máximo em milissegundos entre o recebimento de uma invalidação de política e a busca de uma nova política pelo serviço de gerenciamento do dispositivo. O intervalo de valores válidos é de 1.000 (1 segundo) até 300.000 (5 minutos). Valores fora desse intervalo serão ajustados para o respectivo limite.\n\nSe a política não for definida, o valor padrão de 10 segundos será usado pelo Brave.";
MediaRecommendationsEnabled.pfm_title = "Ativar recomendações de mídia";
MediaRecommendationsEnabled.pfm_description = "Por padrão, o navegador mostrará recomendações de mídia personalizadas para o usuário. Se esta política for definida como \"Desativada\", essas recomendações ficarão ocultas para o usuário. Se esta política for definida como \"Ativada\" ou não for definida, as recomendações de mídia serão mostradas para o usuário.";
MediaRouterCastAllowAllIPs.pfm_title = "Permitir que o Google Cast conecte-se a dispositivos de transmissão em todos os endereços IP.";
MediaRouterCastAllowAllIPs.pfm_description = "A menos que EnableMediaRouter esteja definida como desativada, definir MediaRouterCastAllowAllIPs como ativada irá conectar o Google Cast aos dispositivos Cast em todos os endereços IP, não apenas no endereço particular RFC1918/RFC4193.\n\nSe a política for definida como desativada, o Google Cast será conectado aos dispositivos Cast apenas em RFC1918/RFC4193.\n\nSe a política não for definida, o Google Cast será conectado aos dispositivos Cast apenas em RFC1918/RFC4193, exceto se o recurso CastAllowAllIPs estiver ativado.";
MemorySaverModeSavings.pfm_title = "Mudar o modo de Economia de memória";
MemorySaverModeSavings.pfm_description = "0 - Economia de memória moderada.\n1 - Economia de memória equilibrada.\n2 - Economia de memória máxima.\nEsta política muda o nível de Economia de memória.\n\nIsso só vai acontecer quando a Economia de memória for ativada pelas configurações ou pela política HighEfficiencyModeEnabled, e vai afetar a forma como as heurísticas são usadas para determinar quando descartar guias. Por exemplo, reduzir o ciclo de vida de uma guia inativa antes de descartá-la pode economizar memória, mas também significa que as guias serão recarregadas com mais frequência, o que pode resultar em uma experiência ruim para o usuário e em mais tráfego de rede.\n\nSe a política for definida como \"0\", o nível de Economia de memória será moderado. As guias ficarão inativas depois de um período mais longo\n\nSe a política for definida como \"1\", o nível de Economia de memória será balanceado. Suas guias ficarão inativas depois de um período ideal.\n\nSe a política for definida como \"2\", o nível de Economia de memória será extremo. Suas guias ficarão inativas depois de um período mais curto.\n\nSe a política for deixada sem definição, o usuário final poderá controlar essa configuração em chrome://settings/performance.";
MetricsReportingEnabled.pfm_title = "Ativar relato de uso e dados relacionados a falhas";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "Exibir cards na página Nova guia";
NTPCardsVisible.pfm_description = "Esta política controla a visibilidade de cards na página Nova guia. Os cards exibem pontos de entrada para inicializar jornadas de usuário comuns com base no comportamento de navegação do usuário.\n\nSe a política for definida como \"Ativada\", a página Nova guia exibirá os cards caso haja conteúdo disponível.\n\nSe a política for definida como \"Desativada\", a página Nova guia não exibirá cards.\n\nSe a política não for definida, os usuários poderão controlar a visibilidade dos cards. O padrão é visível.\n";
NTPCustomBackgroundEnabled.pfm_title = "Permitir que usuários personalizem o plano de fundo na página \"Nova guia\"";
NTPCustomBackgroundEnabled.pfm_description = "Se a política for definida como falsa, a página \"Nova guia\" não permitirá que os usuários personalizem o plano de fundo. Qualquer plano de fundo personalizado já existente será removido permanentemente, mesmo que a política seja definida como verdadeira mais tarde.\n\nSe a política for definida como verdadeira ou não for definida, os usuários poderão personalizar o plano de fundo da página \"Nova guia\".\n\nObservação: no Android, a política é aplicada ao navegador somente após a reinicialização.";
NTPFooterExtensionAttributionEnabled.pfm_title = "Controlar a visibilidade da atribuição da extensão na página \"Nova guia\"";
NTPFooterExtensionAttributionEnabled.pfm_description = "Esta política determina se uma atribuição à extensão que modifica a página \"Nova guia\" (NTP, na sigla em inglês) é exibida no rodapé da NTP.\n\nPor padrão, se uma extensão tiver substituído a NTP padrão, uma mensagem atribuindo essa mudança à extensão específica vai aparecer no rodapé. Essa atribuição normalmente inclui um link para a extensão relevante na Chrome Web Store.\n\nSe a política não for definida ou for definida como \"true\", a atribuição da extensão vai ficar visível no rodapé da NTP quando uma extensão controlar essa página.\n\nSe a política for definida como \"false\", a atribuição à extensão no rodapé da NTP será suprimida.";
NTPFooterManagementNoticeEnabled.pfm_title = "Controlar a visibilidade do aviso de gerenciamento na página \"Nova guia\" para navegadores gerenciados";
NTPFooterManagementNoticeEnabled.pfm_description = "Esta política controla a visibilidade do aviso de gerenciamento no rodapé da página \"Nova guia\" (NTP, na sigla em inglês). Por padrão, o rodapé da NTP exibe informações quando o navegador é gerenciado por uma organização (indicado por um ícone de edifício e \"Gerenciado por [nome de domínio]\"). Isso pode ser personalizado usando as políticas EnterpriseCustomLabelForBrowser e EnterpriseLogoUrlForBrowser.\n\nSe essa política for deixada sem definição ou for definida como \"true\", os navegadores gerenciados vão mostrar um aviso \"Gerenciado por…\" com um ícone.\n\nSe for definida como \"false\", o aviso de gerenciamento será ocultado.\n\nEssa política é aplicada apenas a navegadores gerenciados. Portanto, ela não afeta usuários gerenciados em navegadores não gerenciados.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
NTPOutlookCardVisible.pfm_title = "Mostrar o card do Calendário do Outlook na página \"Nova guia\"";
NTPOutlookCardVisible.pfm_description = "Essa política controla a visibilidade do card do Outlook na página \"Nova guia\". O card só vai aparecer nessa página se a política estiver ativada e sua organização tiver autorizado o uso dos dados do Calendário do Outlook no navegador.\n\nOs dados do Outlook não serão armazenados pelo navegador.\n\nO card do Outlook mostra o próximo evento da agenda e uma visão geral das outras reuniões do dia. O objetivo é resolver o problema da mudança de contexto e aumentar a produtividade, dando aos usuários um atalho para acessar a próxima reunião.\n\nO card do Microsoft Outlook vai precisar de mais configurações administrativas. Para mais informações sobre como conectar o card da página \"Nova guia\" do Chrome ao Outlook, consulte a página https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nSe a política NTPCardsVisible for desativada, o card do Outlook não vai aparecer. Se NTPCardsVisible for ativada, o card do Outlook vai aparecer se essa política também estiver ativada e houver dados para mostrar. Se NTPCardsVisible não for definida, o card do Outlook vai aparecer se esta política também estiver ativada, o usuário tiver ativado o card em \"Personalizar o Chrome\" e houver dados para mostrar.";
NTPSharepointCardVisible.pfm_title = "Mostrar o card de arquivos do SharePoint e do OneDrive na página \"Nova guia\"";
NTPSharepointCardVisible.pfm_description = "Essa política controla a visibilidade do card de arquivos do SharePoint e do OneDrive na página \"Nova guia\". O card só vai aparecer na página \"Nova guia\" se a política estiver ativada e sua organização tiver autorizado o uso dos dados de arquivos do SharePoint e do OneDrive no navegador.\n\nOs dados do SharePoint e do OneDrive não serão armazenados pelo navegador.\n\nO card de recomendação de arquivos do SharePoint e do OneDrive mostra uma lista de arquivos recomendados.  O objetivo é resolver o problema da mudança de contexto e aumentar a produtividade, dando aos usuários um atalho para acessar os documentos mais importantes.\n\nO card da Microsoft para o SharePoint e o OneDrive vai precisar de mais configurações administrativas. Para mais informações sobre como conectar o card da página \"Nova guia\" do Chrome ao Sharepoint, consulte a página https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nSe a política NTPCardsVisible for desativada, o card do SharePoint e do OneDrive não vai aparecer. Se NTPCardsVisible for ativada, o card do Sharepoint e do OneDrive vai aparecer caso essa política também esteja ativada e haja dados para mostrar. Se NTPCardsVisible for deixada sem definição, o card do SharePoint e do OneDrive vai aparecer se essa política também estiver ativada, o usuário tiver ativado o card na página \"Personalizar o Chrome\" e houver dados para mostrar.";
NTPShortcuts.pfm_title = "Definir atalhos na página \"Nova guia\"";
NTPShortcuts.pfm_description = "Definir a política pré-configura até 10 atalhos personalizados na página \"Nova guia\" do Brave.\n\nCom a definição, eles vão aparecer por padrão, além dos atalhos pessoais dos usuários. As pessoas podem controlar a visibilidade dos atalhos da organização no painel \"Personalizar o Chrome\".\n\nOs URLs de atalho precisam ser exclusivos.\n\nSe a opção allow_user_edit for definida como verdadeira, os usuários poderão mudar o nome do atalho. Se for definida como falsa ou não for definida, os usuários não poderão editar o nome.\n\nSe a opção allow_user_delete for definida como verdadeira, os usuários poderão remover o atalho. Se for definida como falsa ou não for definida, os usuários não poderão remover o atalho.\nConsulte https://chromeenterprise.google/policies/?policy=NTPShortcuts para ver mais informações sobre esquema e formatação.";
NativeMessagingAllowlist.pfm_title = "Nomes dos hosts de mensagens nativas a serem mantidos fora da lista de bloqueio";
NativeMessagingAllowlist.pfm_description = "A definição da política especifica quais hosts de mensagens nativas não estão sujeitos à lista de proibições. Um valor de * da lista de proibições significa que todos os hosts de mensagens nativas serão proibidos, a menos que tenham permissão explícita.\n\nTodos os hosts de mensagens nativas têm permissão por padrão. No entanto, se todos os hosts de mensagens nativas forem bloqueados pela política, um administrador poderá usar a lista de permissões para mudar essa política.";
NativeMessagingBlocklist.pfm_title = "Nomes dos hosts de mensagens nativas proibidos (ou \"*\" para todos)";
NativeMessagingBlocklist.pfm_description = "A definição da política especifica quais hosts de mensagens nativas não serão carregados. Um valor de * da lista de proibições significa que todos os hosts de mensagens nativas serão proibidos, a menos que tenham permissão explícita.\n\nSe a política for deixada sem definição, o Brave carregará todos os hosts de mensagens nativas instalados.";
NativeMessagingUserLevelHosts.pfm_title = "Permitir hosts de mensagens nativas no nível do usuário (instalados sem permissão do administrador)";
NativeMessagingUserLevelHosts.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, o Brave poderá usar hosts de mensagens nativas instalados no nível do usuário.\n\nSe a política for definida como \"Desativada\", o Brave só poderá usar esses hosts se eles estiverem instalados no nível do sistema.";
NetworkPredictionOptions.pfm_title = "Ativar previsão de rede";
NetworkPredictionOptions.pfm_description = "0 - Prever ações da rede em qualquer conexão de rede\n1 - Prever ações de rede em qualquer rede que não seja a de celular.\nUso suspenso na versão 50 e removido na 52. Depois da versão 52, se o valor 1 for definido, ele será tratado como 0: prever ações de rede em qualquer conexão de rede.\n2 - Não prever ações da rede em nenhuma conexão de rede\nEsta política controla a previsão de rede no Brave. Ela controla a pré-busca de DNS, a pré-conexão SSL e TCP e a pré-renderização das páginas da Web.\n\nSe você definir a política, os usuários não poderão mudá-la. Se ela não for definida, a previsão de rede será ativada, mas os usuários poderão mudar a configuração.";
NewTabPageLocation.pfm_title = "URL da página \"Nova guia\"";
NewTabPageLocation.pfm_description = "A definição da política configura o URL padrão da página Nova guia e impede que os usuários o modifiquem.\n\nEssa página será aberta em novas guias e janelas.\n\nEsta política não decide quais páginas serão abertas na inicialização. Isso é controlado pelas políticas RestoreOnStartup. Esta política afetará a página inicial e de inicialização se elas estiverem configuradas para abrir a página Nova guia.\n\nA prática recomendada é fornecer o URL totalmente canonizado. Se isso não ocorrer, o Brave completará com https:// por padrão.\n\nSe a política não for configurada ou for deixada em branco, a página Nova guia padrão será usada.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
NotificationsAllowedForUrls.pfm_title = "Permitir notificações nesses sites";
NotificationsAllowedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que podem exibir notificações.\n\nSe a política não tiver definição, DefaultNotificationsSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
NotificationsBlockedForUrls.pfm_title = "Bloquear notificações nestes sites";
NotificationsBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que não podem exibir notificações.\n\nSe a política não tiver definição, DefaultNotificationsSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
NtlmV2Enabled.pfm_title = "Ativar autenticação NTLMv2.";
NtlmV2Enabled.pfm_description = "Definir a política como \"Ativada\" ou deixá-la sem definição ativa NTLMv2.\n\nDefini-la como \"Desativada\" desativa NTLMv2.\n\nTodas as versões recentes dos servidores Samba e Microsoft® Windows® são compatíveis com NTLMv2. Como a desativação diminui a segurança da autenticação, só a realize se precisar de compatibilidade com versões anteriores.";
OopPrintDriversAllowed.pfm_title = "Drivers de impressão fora do processo são permitidos";
OopPrintDriversAllowed.pfm_description = "Controla se o Brave interage com os drivers de impressora de um processo de serviço separado. As chamadas de impressão da plataforma são feitas com base em um processo de serviço. Elas são usadas para consultar as impressoras disponíveis, acessar as configurações do driver de impressão e enviar documentos para impressoras locais. Remover essas chamadas do processo do navegador ajuda a melhorar a estabilidade e reduzir o comportamento congelado da interface na visualização da impressão.\n\nSe esta política for ativada ou deixada sem definição, o Brave vai usar um processo de serviço separado para tarefas de impressão da plataforma.\n\nSe for desativada, o Brave vai usar o processo do navegador para tarefas de impressão da plataforma.\n\nEsta política será removida após o lançamento do recurso de drivers de impressão fora de processo.";
OriginAgentClusterDefaultEnabled.pfm_title = "Permite o clustering do agente com origin-key por padrão.";
OriginAgentClusterDefaultEnabled.pfm_description = "Esta política permite por padrão o clustering do agente com origin-key.\n\nO cabeçalho HTTP Origin-Agent-Cluster controla se um documento está\nisolado em um cluster de agente com origin-key ou\ncom site-key. Como um cluster de agente com origin-key permite o isolamento de\ndocumentos por origem, esse processo afeta a segurança. A consequência visível\npara o desenvolvedor é a impossibilidade de definir o acessador\ndocument.domain.\n\nO comportamento padrão quando nenhum cabeçalho Origin-Agent-Cluster foi definido\nmuda de site-key para origin-key na versão M111.\n\nSe esta política for ativada ou for deixada sem definição, o navegador vai seguir o\nnovo padrão dessa versão em diante.\n\nSe a política for desativada, a mudança será revertida e os\ndocumentos sem cabeçalhos Origin-Agent-Cluster serão atribuídos a\nclusters de agente com site-key. Consequentemente, o acessador document.domain\nvai permanecer definível por padrão. Esse comportamento é correspondente ao legado.\n\nConfira mais detalhes em https://developer.chrome.com/blog/immutable-document-domain/\n(em inglês).";
OriginKeyedProcessesEnabled.pfm_title = "Ativar o isolamento de processos com origin-key por padrão.";
OriginKeyedProcessesEnabled.pfm_description = "Ativa o isolamento de processos com origin-key para a maioria das páginas (por exemplo, aquelas atribuídas a um cluster de agente com origin-key por padrão). Isso melhora a segurança, mas aumenta o número de processos criados. Os usuários podem substituir o valor da política definida usando flags de linha de comando ou chrome://flags, tanto para ativar quanto desativar o recurso.\n\nSe a política for ativada, a maioria das origens será isolada, inclusive de outras origens no mesmo site. Consulte também as políticas IsolateOrigins e SitePerProcess.\n\nSe a política for desativada, nenhuma origem será isolada do restante do site, a menos que uma origem peça explicitamente por isso.\n\nSe a política não for definida, o navegador vai determinar quais origens isolar e quando fará isso.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "Origens ou padrões de nome do host aos quais as restrições sobre origens não seguras não se aplicam";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "Se a política for definida, será possível especificar uma lista de origens (URLs) ou padrões de nome de host (como *.example.com) aos quais as restrições de segurança de origens inseguras não serão aplicadas. Os padrões só são aceitos para nomes de host. URLs/origens com esquemas precisam ser strings exatas. As organizações podem especificar origens para aplicativos legados que não possam implantar TLS ou configurar um servidor de preparo para desenvolvimento da Web interno. Dessa forma, os desenvolvedores podem testar recursos que necessitam de contextos seguros sem precisar implantar o TLS no servidor de preparo. Essa política também impede que origens sejam marcadas como \"Não seguras\" na barra de endereço.\n\nA definição de uma lista de URLs nesta política tem o mesmo efeito que configurar a flag de linha de comando --unsafely-treat-insecure-origin-as-secure para uma lista dos mesmos URLs separados por vírgulas. A política vai modificar a flag de linha de comando e UnsafelyTreatInsecureOriginAsSecure, se estiver presente.\n\nPara ver mais informações sobre contextos seguros, consulte Secure Contexts (https://www.w3.org/TR/secure-contexts) (em inglês).";
PartitionedBlobUrlUsage.pfm_title = "Escolher se os URLs de blobs são particionados durante a busca e navegação.";
PartitionedBlobUrlUsage.pfm_description = "Esta política controla se os URLs de blobs são particionados durante a busca e navegação.\nSe ela for ativada ou não for definida, os URLs de blobs serão particionados.\nSe ela for desativada, os URLs de blobs não serão particionados.\n\nSe você precisar usar a política, informe um bug em\nBrave\nexplicando seu caso de uso. A política está programada para ser oferecida até\na versão 146 do Brave. Após essa versão,\na implementação antiga será removida.\n\nOBSERVAÇÃO: somente processos de renderizador recém-iniciados vão refletir as mudanças nesta\npolítica enquanto o navegador estiver em execução.\n\nPara ver detalhes sobre o particionamento de armazenamento de terceiros, consulte\nhttps://developers.google.com/privacy-sandbox/cookies/storage-partitioning.";
PasswordDismissCompromisedAlertEnabled.pfm_title = "Ativar a opção de dispensar alertas de senha comprometida para as credenciais inseridas";
PasswordDismissCompromisedAlertEnabled.pfm_description = "Se a política for definida como \"Enabled\" (ativada) ou deixada sem definição, o usuário tem a opção de dispensar/restaurar alertas de senha comprometida.\n\nSe você desativar esta configuração, os usuários não vão poder dispensar alertas de senha comprometida. Se ela estiver ativada, os usuários vão poder dispensar alertas sobre senhas comprometidas.";
PasswordLeakDetectionEnabled.pfm_title = "Ativa a detecção de vazamento para credenciais digitadas";
PasswordLeakDetectionEnabled.pfm_description = "Se a política for ativada, os usuários poderão permitir que o Brave verifique se os nomes de usuário e as senhas usados foram comprometidos em um vazamento.\n\nSe a política for desativada, os usuários não terão acesso a essa funcionalidade.\n\nSe a política for definida, os usuários não poderão mudá-la no Brave. Se ela for deixada sem definição, a verificação de vazamento de credenciais será permitida, mas os usuários poderão desativá-la.";
PasswordManagerBlocklist.pfm_title = "Configure a lista de domínios em que Password Manager (salvar e preencher) vai estar desativado";
PasswordManagerBlocklist.pfm_description = "Configure a lista de domínios em que o Brave precisa desativar o Password Manager. Isso significa que os fluxos de trabalho de salvar e preencher serão desativados, garantindo que as senhas desses sites não sejam salvas nem preenchidas automaticamente em formulários on-line.\n\nSe um domínio estiver na lista, o Password Manager será desativado para ele.\n\nSe um domínio não estiver na lista, o Password Manager vai estar disponível para ele.\n\nSe a política for deixada sem definição, o Password Manager vai ficar disponível para todos os domínios.\n\nPara informações detalhadas sobre padrões de URL válidos, consulte https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
PasswordManagerEnabled.pfm_title = "Ativar salvamento de senhas no gerenciador de senhas";
PasswordManagerEnabled.pfm_description = "Esta política controla a capacidade do navegador de se lembrar de senhas automaticamente em sites e salvá-las no gerenciador de senhas integrado. Ela não limita o acesso nem muda o conteúdo das senhas salvas no gerenciador e das possivelmente sincronizadas com o perfil da Conta do Google e com o Android.\n\nSe a política for ativada, os usuários poderão fazer com que o Brave se lembre de senhas e as forneça na próxima vez que eles fizerem login em um site.\n\nSe a política for desativada, os usuários não poderão salvar senhas novas, mas as salvas anteriormente ainda poderão ser usadas.\n\nSe a política for definida, ela não poderá ser mudada pelos usuários no Brave. Se ela for deixada sem definição, os usuários poderão desativar o salvamento de senhas.";
PasswordManagerPasskeysEnabled.pfm_title = "Ativar o salvamento de chaves de acesso no gerenciador de senhas";
PasswordManagerPasskeysEnabled.pfm_description = "Esta política controla a capacidade do navegador de salvar chaves de acesso no gerenciador de senhas integrado. Ela não limita o acesso nem muda o conteúdo das chaves de acesso já salvas no gerenciador de senhas. Se a política PasswordManagerEnabled for desativada, o salvamento no gerenciador de senhas integrado também estará desativado, incluindo para chaves de acesso e senhas. Portanto, a política não será relevante.\n\nSe ela for ativada ou deixada sem definição, os usuários poderão salvar chaves de acesso no gerenciador de senhas integrado ao fazer login no Brave.\n\nSe for desativada, os usuários não poderão salvar chaves de acesso no gerenciador de senhas integrado, mas as que foram salvas anteriormente ainda vão funcionar.";
PasswordProtectionChangePasswordURL.pfm_title = "Configure o URL de alteração de senha.";
PasswordProtectionChangePasswordURL.pfm_description = "Se a política for definida, será possível configurar um URL em que os usuários poderão mudar a senha após receber um alerta no navegador. O serviço de proteção de senha direcionará os usuários ao URL (apenas protocolos HTTP e HTTPS) designado pela política. Para que o Brave capture corretamente o hash com sal da nova senha na página de mudança de senha, essa página precisa seguir as diretrizes apresentadas em https://www.chromium.org/developers/design-documents/create-amazing-password-forms (link em inglês).\n\nSe a política for desativada ou não for definida, o serviço vai direcionar os usuários para https://myaccount.google.com para mudar a senha.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
PasswordProtectionLoginURLs.pfm_title = "Configura a lista de URLs de login corporativo em que o serviço de proteção de senha capturará hashes com salt de senhas.";
PasswordProtectionLoginURLs.pfm_description = "Se a política for definida, será possível definir uma lista de URLs de login corporativos (apenas protocolos HTTP e HTTPS). O serviço de proteção de senhas capturará hashes com sal de senhas nesses URLs e os usará para detectar a reutilização. Para que o Brave capture hashes com sal de senhas corretamente, confira se a página de login segue as diretrizes apresentadas em https://www.chromium.org/developers/design-documents/create-amazing-password-forms (link em inglês).\n\nSe você desativar ou não definir essa configuração, o serviço de proteção de senhas vai capturar apenas os hashes com sal em https://accounts.google.com.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
PasswordProtectionWarningTrigger.pfm_title = "Acionamento de aviso de proteção de senha";
PasswordProtectionWarningTrigger.pfm_description = "0 - O aviso de proteção de senha está desativado\n1 - O aviso de proteção de senha é acionado pela reutilização da senha\n2 - O aviso de proteção de senha é acionado pela reutilização de senhas em uma página de phishing\nSe a política for definida, será possível controlar o acionamento do aviso de proteção de senha, que alerta os usuários quando eles reutilizam senhas em sites potencialmente suspeitos.\n\nUse PasswordProtectionLoginURLs e PasswordProtectionChangePasswordURL para definir quais senhas serão protegidas.\n\nSe esta política for definida como:\n\n* PasswordProtectionWarningOff, nenhum aviso de proteção de senha será exibido;\n\n* PasswordProtectionWarningOnPasswordReuse, o aviso de proteção de senha será exibido quando os usuários reutilizarem senhas protegidas em sites fora da lista de permissões;\n\n* PasswordProtectionWarningOnPhishingReuse, o aviso de proteção de senha será exibido quando os usuários reutilizarem senhas protegidas em sites de phishing.\n\nSe a política não for definida, o serviço protegerá apenas as senhas do Google, mas os usuários poderão mudar essa configuração.";
PasswordSharingEnabled.pfm_title = "Ativa o compartilhamento de credenciais do usuário com outros usuários";
PasswordSharingEnabled.pfm_description = "Se a política for ativada, os usuários poderão enviar e receber senhas de membros da família (de acordo com os serviços para a família).\nQuando a política é ativada ou deixada sem definição, há um botão no Gerenciador de senhas que permite o envio de uma senha.\nAs senhas recebidas são armazenadas na conta do usuário e ficam disponíveis no Gerenciador de senhas.\n\nSe a política for desativada, os usuários não poderão enviar senhas do Gerenciador para outros usuários nem receber senhas de outras pessoas.\n\nO recurso não ficará disponível se a sincronização de senhas estiver desativada, seja pelas configurações do usuário ou pela ativação da política SyncDisabled.\n\nAs contas gerenciadas não podem participar nem criar um grupo familiar. Por isso, elas não podem compartilhar senhas.";
PaymentMethodQueryEnabled.pfm_title = "Permitir que sites consultem formas de pagamento disponíveis.";
PaymentMethodQueryEnabled.pfm_description = "Permite que você defina se os sites têm permissão de verificar se os usuários salvaram formas de pagamento.\n\nSe esta política for definida como \"desativada\", sites que usam a API PaymentRequest.canMakePayment ou PaymentRequest.hasEnrolledInstrument serão informados de que não há formas de pagamento disponíveis.\n\nSe a configuração estiver ativada ou não estiver definida, os sites terão permissão para verificar se o usuário salvou formas de pagamento.";
PdfAnnotationsEnabled.pfm_title = "Ativar anotações no PDF";
PdfAnnotationsEnabled.pfm_description = "Controla se o visualizador de PDF no Brave pode fazer anotações em PDFs.\n\nQuando esta política é deixada sem definição ou é definida como verdadeira, o visualizador de PDF pode fazer anotações em PDFs.\n\nQuando esta política é definida como falsa, o visualizador de PDF não pode fazer anotações em PDFs.";
PdfLocalFileAccessAllowedForDomains.pfm_title = "Permitir que os arquivos locais sejam acessados pelos URLs file:// nesses sites no Visualizador de PDF";
PdfLocalFileAccessAllowedForDomains.pfm_description = "Se a política for definida, os domínios listados poderão acessar URLs file:// no Visualizador de PDF.\nA adição à política permite que o domínio acesse URLs file:// nesse visualizador.\nA remoção da política nega o acesso.\nSe a política for deixada sem definição, nenhum domínio poderá acessar os URLs file:// no Visualizador de PDF.";
PdfUseSkiaRendererEnabled.pfm_title = "Usar o renderizador Skia para a renderização de PDF";
PdfUseSkiaRendererEnabled.pfm_description = "Controla se o visualizador de PDF no Brave usa o renderizador Skia.\n\nQuando esta política estiver ativada, o visualizador de PDF vai usar o renderizador Skia.\n\nQuando ela estiver desativada, o visualizador de PDF vai usar o renderizador AGG atual.\n\nQuando ela for deixada sem definição, o renderizador de PDF será escolhido pelo navegador.";
PolicyAtomicGroupsEnabled.pfm_title = "Ativar o conceito de grupos atômicos de política";
PolicyAtomicGroupsEnabled.pfm_description = "Se a política for definida como \"Ativada\", as políticas vindas de um grupo atômico que não compartilha a origem com a maior prioridade do grupo serão ignoradas.\n\nSe a política for definida como \"Desativada\", nenhuma política será ignorada por causa da origem. As políticas serão ignoradas apenas se houver um conflito e a política não tiver a maior prioridade.\n\nSe a política for definida com base em uma origem na nuvem, ela não poderá ser destinada a um usuário específico.";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "Permitir a mescla de políticas de dicionário de diferentes fontes";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - URLs de exceção manual do usuário gerenciado\nDeviceLoginScreenPowerManagement - Gerenciamento de energia na tela de login\nExtensionSettings - Configurações de gerenciamento de extensão\nKeyPermissions - Principais permissões\nPowerManagementIdleSettings - Configurações de gerenciamento de energia quando o usuário se torna inativo\nScreenBrightnessPercent - Porcentagem de brilho da tela\nScreenLockDelays - Tempo de espera para bloqueio de tela\nSe a política for definida, será possível mesclar as políticas selecionadas quando elas vierem de origens diferentes com os mesmos escopos e níveis. Essa mesclagem ocorre nas chaves de primeiro nível do dicionário de cada origem. A chave da origem de maior prioridade tem precedência.\n\nUse o caractere curinga \"*\" para permitir a mescla de todas as políticas de dicionário com suporte.\n\nSe uma política estiver na lista e houver um conflito entre origens com:\n\n* o mesmo escopo e nível: os valores serão mesclados em um novo dicionário de política;\n\n* diferentes escopos ou níveis: a política com maior prioridade será aplicada.\n\nSe uma política não estiver na lista e houver um conflito entre origens, escopos ou níveis, a política com a maior prioridade será aplicada.";
PolicyListMultipleSourceMergeList.pfm_title = "Permitir a mescla de políticas de lista de diferentes fontes";
PolicyListMultipleSourceMergeList.pfm_description = "Se a política for definida, será possível mesclar as políticas selecionadas quando elas vierem de origens diferentes com os mesmos escopos e níveis.\n\nUse o caractere curinga \"*\" para permitir a mescla de todas as políticas na lista.\n\nSe uma política estiver na lista e houver um conflito entre origens com:\n\n* o mesmo escopo e nível: os valores serão mesclados em uma nova lista de políticas;\n\n* diferentes escopos ou níveis: a política com maior prioridade será aplicada.\n\nSe uma política não estiver na lista e houver um conflito entre origens, escopos ou níveis, a política com a maior prioridade será aplicada.";
PolicyRefreshRate.pfm_title = "Taxa de atualização da política do usuário";
PolicyRefreshRate.pfm_description = "A definição da política especifica um período em milissegundos em que o serviço de gerenciamento do dispositivo recebe consultas sobre informações de políticas do usuário. O intervalo válido de valores é de 1.800.000 (30 minutos) até 86.400.000 (1 dia). Valores fora desse intervalo serão ajustados para o respectivo limite.\n\nSe a política não for definida, o valor padrão de 3 horas será usado.\n\nObservação: notificações sobre políticas forçam uma atualização quando a política muda, tornando as atualizações frequentes desnecessárias. Por isso, se a plataforma oferecer compatibilidade com essas notificações, o atraso de atualização será de 24 horas, ignorando os padrões e os valores desta política.";
PopupsAllowedForUrls.pfm_title = "Permitir pop-ups nesses sites";
PopupsAllowedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que podem abrir pop-ups.\n\nSe a política não tiver definição, DefaultPopupsSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
PopupsBlockedForUrls.pfm_title = "Bloquear pop-ups nesses sites";
PopupsBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que não podem abrir pop-ups.\n\nSe a política não tiver definição, DefaultPopupsSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
PreciseGeolocationAllowedForUrls.pfm_title = "Permitir a geolocalização exata nestes sites";
PreciseGeolocationAllowedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que podem acessar a geolocalização de alta precisão do usuário sem precisar pedir permissão para isso.\n\nSe a política ficar sem definição, DefaultGeolocationSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nPara informações detalhadas sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
PreferSlowCiphers.pfm_title = "Preferir algoritmos de criptografia específicos para TLS";
PreferSlowCiphers.pfm_description = "cnsa - Preferir criptografias que atendam aos requisitos do CNSA 1.0 e 2.0\ndefault - Usar a ordem de criptografia padrão do Brave\nEsta política configura o Brave de modo que o produto ordene as criptografias no TLS 1.3 para refletir uma preferência por algoritmos que foram aprovados por um regime de compliance específico.\n\nA definição desta política não garante que algoritmos específicos sejam negociados.\n\nEsta política existe para permitir que operadores de servidores que querem oferecer suporte a clientes com e sem requisitos de compliance façam a diferenciação entre esses clientes e usem apenas determinados algoritmos não padrão com maior força criptográfica para aqueles que os preferem explicitamente.\n\nDefinir a política como \"cnsa\" configura o Brave para preferir criptografias necessárias para compliance com as versões 1.0 e 2.0 do Commercial National Security Algorithm Suite (CNSA 1.0 e 2.0), um conjunto de algoritmos criptográficos promulgado pela Agência de Segurança Nacional dos EUA.\n\nSe a política não for definida ou for definida como \"default\", o Brave vai usar as criptografias padrão.\n\nA definição desta política não é necessária para a segurança. A criptografia padrão usada pelo Brave é forte o suficiente para resistir a um ataque de força bruta usando toda a energia do Sol.\n\nA definição desta política vai fazer com que o Brave fique mais lento ao acessar sites.\n\nEsta política afeta apenas o TLS 1.3 e o QUIC, e não as versões anteriores do TLS.\n\nEsta política pode ser definida para a máquina e para o usuário. Se for definida para o usuário, ela vai afetar apenas as solicitações de rede iniciadas pelo perfil do usuário, e não as feitas pelo Brave para realizar tarefas em segundo plano em todo o navegador. Essas solicitações são controladas pelo valor no nível da máquina. Se esta política for definida nos níveis da máquina e do usuário, o valor no nível da máquina será aplicado, a menos que a CloudUserPolicyOverridesCloudMachinePolicy tenha mudado a ordem de precedência da política.\n\nNas versões 155 e anteriores, esta política é apenas para toda a máquina.";
PreferSlowKexAlgorithms.pfm_title = "Preferir algoritmos de troca de chaves específicos para TLS";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - Preferir métodos de troca de chaves que atendam aos requisitos do CNSA 2.0\ndefault - Usar os grupos padrão compatíveis do Brave\nEsta política configura o Brave para ordenar os algoritmos de contrato de chave preferidos (grupos aceitos) no TLS 1.3 para refletir uma preferência por algoritmos que foram aprovados por um regime de compliance específico.\n\nA definição desta política não garante que algoritmos específicos sejam negociados.\n\nEsta política existe para permitir que operadores de servidores que querem oferecer suporte a clientes com e sem requisitos de compliance façam a diferenciação entre esses clientes e usem apenas determinados algoritmos não padrão com maior força criptográfica para aqueles que os preferem explicitamente.\n\nDefinir a política como \"cnsa2\" configura o Brave para preferir métodos de troca de chaves necessários para compliance com a versão 2.0 do Commercial National Security Algorithm Suite (CNSA 2.0), um conjunto de algoritmos criptográficos promulgado pela Agência de Segurança Nacional dos EUA.\n\nSe a política não for definida ou for definida como \"default\", o Brave usará os métodos de troca de chaves padrão.\n\nA definição desta política não é necessária para a segurança. A criptografia padrão usada pelo Brave é forte o suficiente para resistir a um ataque de força bruta usando toda a energia do Sol.\n\nA definição desta política vai fazer com que o Brave fique mais lento ao acessar sites.\n\nEsta política afeta apenas o TLS 1.3 e o QUIC, e não as versões anteriores do TLS.\n\nEsta política pode ser definida para a máquina e para o usuário. Se for definida para o usuário, ela vai afetar apenas as solicitações de rede iniciadas pelo perfil do usuário, e não as feitas pelo Brave para realizar tarefas em segundo plano em todo o navegador. Essas solicitações são controladas pelo valor no nível da máquina. Se esta política for definida nos níveis da máquina e do usuário, o valor no nível da máquina será aplicado, a menos que a CloudUserPolicyOverridesCloudMachinePolicy tenha mudado a ordem de precedência da política.\n\nNas versões 155 e anteriores, esta política é apenas para toda a máquina.";
PrefetchWithServiceWorkerEnabled.pfm_title = "Permitir a pré-busca de SpeculationRules para URLs controlados pelo ServiceWorkers";
PrefetchWithServiceWorkerEnabled.pfm_description = "A pré-busca de SpeculationRules pode ser emitida para URLs controlados pelo\nServiceWorkers. No entanto, o código legado não permitiu e cancelou as solicitações de\npré-busca. Com essa política, é possível controlar o comportamento.\n\nSe a política for ativada ou não definida, a pré-busca de SpeculationRules será permitida para\nURLs controlados pelo ServiceWorkers (se a flag de recurso PrefetchServiceWorker estiver\nativada). Esse é o comportamento padrão atual e está alinhado com as\nespecificações.\n\nSe a política for desativada, a pré-busca de SpeculationRules para\nURLs controlados pelo ServiceWorkers não será permitida. Esse é o comportamento legado.\n\nEssa política é temporária e será removida.";
PrintHeaderFooter.pfm_title = "Imprimir cabeçalhos e rodapés";
PrintHeaderFooter.pfm_description = "Se a política for definida como \"Ativada\", os cabeçalhos e rodapés serão ativados na visualização de impressão. Se a política for definida como \"Desativada\", eles serão desativados na visualização de impressão.\n\nSe você definir a política, os usuários não poderão mudá-la. Se ela não for definida, os usuários decidirão se os cabeçalhos e rodapés aparecem ou não.";
PrintPdfAsImageAvailability.pfm_title = "Imprimir PDF como imagem disponível";
PrintPdfAsImageAvailability.pfm_description = "Controla como o Brave exibe a opção \"Imprimir como imagem\" no Microsoft® Windows® e no macOS durante a impressão de PDFs.\n\nAo imprimir um PDF no Microsoft® Windows® ou no macOS, pode ser necessário rasterizar trabalhos de impressão para imagens de modo a garantir que algumas impressoras tenham o resultado correto.\n\nQuando esta política é ativada, o Brave exibe a opção \"Imprimir como imagem\" na visualização da impressão de PDFs.\n\nQuando ela é desativada ou deixada sem definição, a opção \"Imprimir como imagem\" não é exibida para usuários na visualização de impressão do Brave, e os PDFs são impressos normalmente, sem que sejam rasterizados antes do envio.";
PrintPdfAsImageDefault.pfm_title = "Padrão para imprimir PDF como imagem";
PrintPdfAsImageDefault.pfm_description = "Controla se o Brave usa a opção \"Imprimir como imagem\" como padrão ao imprimir PDFs.\n\nSe esta política for ativada, o Brave usará a opção \"Imprimir como imagem\" como padrão na visualização da impressão de PDFs.\n\nSe esta política for desativada ou deixada sem definição, o Brave usará a seleção do usuário, e a opção \"Imprimir como imagem\" não será usada automaticamente.  O usuário poderá escolher o que fazer com cada trabalho de impressão em PDF, se a opção estiver disponível.\n\nEm dispositivos Microsoft® Windows® ou macOS, esta política só tem efeito quando PrintPdfAsImageAvailability também está ativada.";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "Usar a impressora padrão do sistema como padrão";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "Se a política for definida como \"Ativada\", o Brave usará impressão padrão do SO como o destino padrão para a visualização de impressão.\n\nSe a política for definida como \"Desativada\" ou deixada sem definição, o Brave usará a impressora usada mais recentemente como o destino padrão para a visualização de impressão.";
PrintRasterizePdfDpi.pfm_title = "Rasterizar o DPI de PDFs na impressão";
PrintRasterizePdfDpi.pfm_description = "Controla a resolução da imagem quando o Brave imprime PDFs com rasterização.\n\nAo imprimir um PDF com a opção \"Imprimir como imagem\", pode ser útil especificar uma resolução diferente da configuração do dispositivo ou do padrão do PDF.  Uma resolução alta pode aumentar significativamente o tempo de processamento e impressão, enquanto uma baixa pode levar à redução da qualidade da imagem.\n\nEsta política permite que uma resolução seja especificada na rasterização de PDFs para impressão.\n\nSe ela for definida como 0 ou for deixada sem definição, a resolução padrão do sistema será usada na rasterização de imagens das páginas.";
PrinterTypeDenyList.pfm_title = "Desativar tipos de impressora na lista de proibições";
PrinterTypeDenyList.pfm_description = "privet - Destinos de protocolo que não precisam de configuração (mDNS e DNS-SD) (descontinuado)\nextension - Destinos baseados em extensões\npdf - Os destinos \"Salvar como PDF\" e \"Salvar no Google Drive\" em dispositivos Google Chrome OS\nlocal - Destinos de impressoras locais\ncloud - Google Cloud Print (descontinuado)\nSe o tipo da impressora estiver na lista de proibições, não será possível descobrir esse equipamento ou buscar as funcionalidades dele.\n\nColocar todos os tipos de impressora na lista de proibições desativa a impressão de modo eficaz porque não há destinos disponíveis para enviar um documento para impressão.\n\nNas versões anteriores à 102, a inclusão de cloud na lista de proibições tem o mesmo efeito que a definição da política CloudPrintSubmitEnabled como falsa. Para que os destinos da Google Cloud Print continuem detectáveis, é necessário que a política CloudPrintSubmitEnabled seja definida como verdadeira e que cloud não esteja na lista de proibições. A partir da versão 102, os destinos do Google Cloud Print não terão suporte e não vão aparecer, independentemente dos valores da política.\n\nSe a política for deixada sem definição ou for configurada como uma lista vazia, todos os tipos de impressora estarão disponíveis para descoberta.\n\nAs impressoras de extensão também são conhecidas como destinos de provedores de impressão e incluem qualquer destino que pertença a uma extensão do Brave.\n\nAs impressoras locais também são conhecidas como destinos de impressão nativos e incluem os destinos disponíveis para as impressoras de rede compartilhada e de máquinas locais.";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "Restringir modo de impressão de gráficos de segundo plano";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - Permitir a impressão com e sem gráficos em segundo plano\nenabled - Permitir impressão somente com gráficos de segundo plano\ndisabled - Permitir impressão apenas sem gráficos de segundo plano\nRestringe modo de impressão de gráficos em segundo plano. Se esta política não for definida, não haverá restrição.";
PrintingBackgroundGraphicsDefault.pfm_title = "Modo de impressão de gráficos em segundo plano padrão";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - Ativar o modo de impressão de gráficos de segundo plano por padrão\ndisabled - Desativar modo de impressão de gráficos de segundo plano por padrão\nModifica o modo de impressão de gráficos de segundo plano padrão.";
PrintingEnabled.pfm_title = "Ativar impressão";
PrintingEnabled.pfm_description = "Se a política for definida como \"Ativada\" ou deixada sem definição, os usuários poderão imprimir com o Brave e não poderão mudar esta configuração.\n\nSe a política for definida como \"Desativada\", os usuários não poderão imprimir usando o Brave. A impressão ficará desativada no menu de três pontos, nas extensões e nos aplicativos JavaScript.";
PrintingPaperSizeDefault.pfm_title = "Tamanho da página de impressão padrão";
PrintingPaperSizeDefault.pfm_description = "Modifica o tamanho da página para impressão padrão.\n\nname precisa conter um dos formatos listados ou \"personalizado\" se o tamanho do papel exigido não estiver na lista. Se um valor \"personalizado\" for fornecido, a propriedade custom_size precisará ser especificada. Ela descreve a altura e a largura desejadas em micrômetros. Caso contrário, a propriedade custom_size não precisa ser especificada. A política que violar essas regras será ignorada.\n\nSe o tamanho da página não estiver disponível na impressora escolhida pelo usuário, esta política será ignorada.\nConsulte https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault para ver mais informações sobre esquema e formatação.";
ProfilePickerOnStartupAvailability.pfm_title = "Disponibilidade do seletor de perfil na inicialização";
ProfilePickerOnStartupAvailability.pfm_description = "0 - Seletor de perfil disponível na inicialização\n1 - Seletor de perfil desativado na inicialização\n2 - Seletor de perfil forçado na inicialização\nEspecifica se o seletor de perfil será ativado, desativado ou forçado na inicialização do navegador.\n\nPor padrão, o seletor de perfil não é exibido quando o navegador é inicializado nos modos de navegação anônima ou visitante, quando um diretório e/ou URLs de perfil são especificados por linha de comando, quando a abertura de um app é explicitamente solicitada, quando o navegador é aberto por uma notificação nativa, quando há apenas um perfil disponível ou quando a política ForceBrowserSignin é definida como verdadeira.\n\nSe a política for definida como \"Ativada\" (0) ou não for definida, o seletor de perfil será exibido por padrão ao inicializar, mas os usuários poderão ativá-lo ou desativá-lo.\n\nSe a política for definida como \"Desativada\" (1), o seletor de perfil nunca será exibido, e os usuários não poderão mudar essa opção.\n\nSe a política for definida como \"Forçada\" (2), o seletor de perfil não poderá ser suprimido pelos usuários. Ele será exibido mesmo quando houver apenas um perfil disponível.";
ProfileReauthPrompt.pfm_title = "Pedir que os usuários façam a autenticação do perfil de novo";
ProfileReauthPrompt.pfm_description = "0 - Não pedir que os usuários façam a autenticação de novo\n1 - Pedir a reautenticação em uma guia\nQuando a política for definida como DoNotPrompt ou deixada sem definição, o Brave não vai pedir automaticamente que o usuário faça a autenticação de novo no navegador.\n\nSe definida como PromptInTab, quando a autenticação do usuário expirar, uma nova guia será aberta imediatamente com a página de login do Google. Isso só vai acontecer se você estiver usando a Chrome Sync.";
ProfileSeparationDomainExceptionList.pfm_title = "Lista de permissões de domínio secundário para separação de perfis corporativos";
ProfileSeparationDomainExceptionList.pfm_description = "Se a política for deixada sem definição, não será necessário fazer login na conta para criar um perfil separado.\n\nSe ela for definida, não será necessário fazer login nas contas dos domínios listados para criar um perfil separado.\n\nSe for definida como uma string vazia, todos os logins de conta serão necessários para criar um perfil separado.";
PromotionsEnabled.pfm_title = "Ativar a exibição de conteúdo promocional";
PromotionsEnabled.pfm_description = "Se a política for definida como verdadeira ou deixada sem definição, o Brave poderá mostrar conteúdo promocional de produtos aos usuários.\n\nSe ela for definida como falsa, o Brave não poderá mostrar conteúdo promocional de produtos.\n\nEsta política controla a apresentação de conteúdo promocional. Isso inclui conteúdo como as páginas de boas-vindas, que ajudam os usuários a fazer login no Brave, definir o Brave como o navegador padrão ou descobrir os recursos do produto.";
PromptForDownloadLocation.pfm_title = "Perguntar onde salvar cada arquivo antes de fazer download";
PromptForDownloadLocation.pfm_description = "Se a política for definida como ativada, será solicitado, ao usuário, um local para salvar cada arquivo antes do download. Se a política for definida como desativada, os downloads serão iniciados imediatamente, sem solicitar um local para salvar o arquivo ao usuário.\n\nSe a política não for definida, o usuário poderá alterar essa configuração.";
PromptOnMultipleMatchingCertificates.pfm_title = "Solicitar quando houver várias correspondências de certificado";
PromptOnMultipleMatchingCertificates.pfm_description = "Esta política controla se o usuário receberá uma solicitação para selecionar um certificado de cliente quando a AutoSelectCertificateForUrls corresponder a mais de um certificado.\nSe esta política for definida como \"Ativada\", o usuário receberá uma solicitação para selecionar um certificado de cliente sempre que a política de seleção automática corresponder a vários certificados.\nSe esta política for definida como \"Desativada\" ou deixada sem definição, o usuário só receberá a solicitação quando nenhum certificado corresponder à seleção automática.";
ProxySettings.pfm_title = "Configurações de proxy";
ProxySettings.pfm_description = "Se a política for definida, haverá configurações de proxy para o Chrome e apps ARC, ignorando todas as opções relacionadas a proxy especificadas na linha de comando.\n\nSe a política for deixada sem definição, os usuários poderão escolher as configurações de proxy.\n\nSe a política ProxySettings for definida, os campos a seguir serão aceitos:\n\n* ProxyMode, que permite especificar o servidor proxy usado pelo Chrome e evitar que os usuários mudem as configurações de proxy.\n\n* ProxyPacUrl, um URL de um arquivo de proxy .pac. ou um script PAC codificado como um URL de dados com o Tipo MIME application/x-ns-proxy-autoconfig.\n\n* ProxyPacMandatory, que evita que a pilha de rede retome as conexões diretas com um script de PAC inválido ou indisponível.\n\n* ProxyServer, um URL do servidor proxy.\n\n* ProxyBypassList, uma lista de hosts pelos quais o proxy será ignorado.\n\nO campo ProxyServerMode foi descontinuado e substituído pelo campo ProxyMode. Para ProxyMode, se você escolher o valor:\n\n* direct, um proxy nunca será usado e todos os outros campos serão ignorados;\n\n* system, o proxy do sistema será usado e todos os outros campos serão ignorados;\n\n* auto_detect, todos os outros campos serão ignorados;\n\n* fixed_servers, os campos ProxyServer e ProxyBypassList serão usados;\n\n* pac_script, os campos ProxyPacUrl, ProxyPacMandatory e ProxyBypassList serão usados.\n\nObservação: para ver mais exemplos detalhados, acesse The Chromium Projects em https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings (link em inglês).\nConsulte https://chromeenterprise.google/policies/?policy=ProxySettings para ver mais informações sobre esquema e formatação.";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "Ativar o Gerador de QR code";
QRCodeGeneratorEnabled.pfm_description = "Esta política ativa o recurso do gerador de QR code no Brave.\n\nSe você ativar ou não configurar esta política, esse recurso será ativado.\n\nSe você desativar esta política, o gerador de QR code também será desativado.";
QuicAllowed.pfm_title = "Permitir protocolo QUIC";
QuicAllowed.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, o uso de protocolo QUIC será permitido no Brave.\n\nSe a política for definida como \"Desativada\", o uso de protocolo QUIC não será permitido.";
RegisteredProtocolHandlers.pfm_title = "Registrar gerenciadores de protocolos";
RegisteredProtocolHandlers.pfm_description = "Se a política for definida (apenas como recomendado), será possível registrar uma lista de gerenciadores de protocolo, que será mesclada às registradas pelo usuário de forma que as duas configurações sejam aplicadas. Defina a propriedade \"protocolo\" conforme o esquema, por exemplo, \"mailto\", e defina a propriedade \"URL\" conforme o padrão de URL do aplicativo que gerencia o esquema especificado no campo \"protocolo\". O padrão pode incluir um marcador \"%s\", que é substituído pelo URL gerenciado.\n\nOs usuários não podem remover um gerenciador de protocolo registrado pela política. No entanto, ao instalar um novo gerenciador padrão, eles podem mudar os gerenciadores de protocolo instalados pela política.\nConsulte https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers para ver mais informações sobre esquema e formatação.";
RelaunchFastIfOutdated.pfm_title = "Período (dias)";
RelaunchFastIfOutdated.pfm_description = "Especifica a idade mínima da versão para notificações de reinicialização mais agressivas. A idade é calculada a partir do momento em que a versão atual foi veiculada aos clientes pela última vez.\n\nSe for necessário reinicializar o navegador ou o dispositivo para finalizar uma atualização pendente, e a versão atual estiver desatualizada há mais tempo do que o número de dias especificado nessa configuração, a política RelaunchNotificationPeriod será substituída por duas horas. Se a política RelaunchNotification estiver definida como 1 (obrigatória), os usuários precisarão reinicializar ou reiniciar ao final do período.\n\nSe ela estiver sem definição ou não for possível determinar a idade de lançamento, a política RelaunchNotificationPeriod será usada para todas as atualizações.";
RelaunchNotification.pfm_title = "Notifica um usuário de que a reinicialização do navegador ou do dispositivo é recomendada ou obrigatória";
RelaunchNotification.pfm_description = "1 - Mostrar um prompt recorrente ao usuário indicando que a reinicialização é necessária\n2 - Mostrar um prompt recorrente ao usuário indicando que é necessário reiniciar\nNotifica os usuários de que é preciso reiniciar o Brave ou o Google Chrome OS para aplicar uma atualização pendente.\n\nA configuração desta política ativa notificações para informar o usuário de que a reinicialização do navegador ou do dispositivo é recomendada ou obrigatória. Se a política não for definida, o Brave indicará para o usuário que a reinicialização é necessária por meio de pequenas alterações no menu dele, enquanto o Google Chrome OS indicará isso por meio de uma notificação na bandeja do sistema. Se a política for definida como \"Recomendada\", um aviso recorrente será exibido para o usuário, informando que a reinicialização é recomendada. O usuário pode dispensar esse aviso para adiar a reinicialização. Se a política for definida como \"Obrigatória\", um aviso recorrente será exibido para o usuário, indicando que a reinicialização do navegador será forçada assim que o período de notificação terminar. O período padrão é de sete dias para o Brave e de quatro dias para o Google Chrome OS. Também é possível configurar esse período por meio da definição da política RelaunchNotificationPeriod.\n\nA sessão do usuário é restaurada após a reinicialização.";
RelaunchNotificationPeriod.pfm_title = "Período (milissegundos)";
RelaunchNotificationPeriod.pfm_description = "Permite definir o período, em milissegundos, em que os usuários são notificados de que o Brave ou um dispositivo Google Chrome OS precisa ser reiniciado para aplicar uma atualização pendente.\n\nNesse período, o usuário será informado várias vezes sobre a necessidade de atualização. Para dispositivos Google Chrome OS, uma notificação de reinicialização é exibida na bandeja do sistema de acordo com a política RelaunchHeadsUpPeriod. Para navegadores Brave, o menu do app muda para indicar que uma reinicialização é necessária após o decorrer de um terço do período de notificação. Essa notificação muda de cor após dois terços do período de notificação e muda mais uma vez quando todo o período de notificação é concluído. As outras notificações ativadas pela política RelaunchNotification seguem essa mesma programação.\n\nSe a política não for definida, o período padrão de 604.800.000 milissegundos (uma semana) será usado.";
RelaunchWindow.pfm_title = "Janela de tempo de reinicialização";
RelaunchWindow.pfm_description = "Especificar a janela de tempo escolhida para o final do período de notificação da reinicialização.\n\nOs usuários são notificados sobre a necessidade de reinicialização do navegador ou do dispositivo com base nas configurações da política RelaunchNotification e RelaunchNotificationPeriod. Os navegadores e dispositivos são reiniciados à força ao final do período de notificação quando a política RelaunchNotification está definida como \"Obrigatória\". A política RelaunchWindow pode ser usada para adiar o final do período de notificação de modo que ele ocorra em uma janela de tempo específica.\n\nSe essa política não for definida, a janela de tempo padrão para o Google Chrome OS será entre às 2h e 4h. A janela de tempo padrão para o Brave é o dia todo, ou seja, o final do período de notificação nunca é adiado.\n\nObservação: ainda que a política possa aceitar vários itens em entries, todos eles serão ignorados, com exceção do primeiro.\nAviso: a configuração dessa política pode atrasar as atualizações de software.\nConsulte https://chromeenterprise.google/policies/?policy=RelaunchWindow para ver mais informações sobre esquema e formatação.";
RemoteAccessHostAllowClientPairing.pfm_title = "Ativar ou desativar autenticação sem PIN para hosts de acesso remoto";
RemoteAccessHostAllowClientPairing.pfm_description = "Se a política for definida como \"Ativada\" ou deixada sem definição, o usuário poderá parear clientes e hosts durante a conexão, eliminando a necessidade de inserir um PIN todas as vezes.\n\nSe a política for definida como \"Desativada\", esse recurso não estará disponível.";
RemoteAccessHostAllowFileTransfer.pfm_title = "Permitir que usuários de acesso remoto transfiram arquivos para/do host";
RemoteAccessHostAllowFileTransfer.pfm_description = "Se a política for definida como \"Ativada\" ou deixada sem definição, os usuários poderão se conectar a um host de acesso remoto para transferir arquivos entre o cliente e o host. Isso não se aplica a conexões de assistência remota, que não são compatíveis com a transferência de arquivos.\n\nSe a política for definida como \"Desativada\", a transferência de arquivos não será permitida.";
RemoteAccessHostAllowPinAuthentication.pfm_title = "Permitir métodos de autenticação com PIN e pareamento para hosts de acesso remoto";
RemoteAccessHostAllowPinAuthentication.pfm_description = "Se a política for ativada, o host de acesso remoto poderá usar autenticações com PIN e pareamento ao aceitar conexões de clientes.\n\nSe for desativada, as autenticações com PIN ou pareamento não serão permitidas.\n\nSe for deixada sem definição, o host poderá decidir se autenticações com PIN e/ou pareamento podem ser usadas.\n\nObservação: se a configuração resultar em métodos de autenticação aceitos tanto pelo host quanto pelo cliente, a conexão será recusada.";
RemoteAccessHostAllowRelayedConnection.pfm_title = "Ativar o uso de servidores relay pelo host de acesso remoto";
RemoteAccessHostAllowRelayedConnection.pfm_description = "Se a RemoteAccessHostFirewallTraversal for ativada, definir RemoteAccessHostAllowRelayedConnection como \"Ativada\" ou deixá-la sem definição permitirá que clientes remotos usem servidores de redirecionamento para se conectar a esta máquina quando uma conexão direta não estiver disponível (por exemplo, por conta de uma restrição de firewall).\n\nSe a política for desativada, o acesso remoto não será desativado, mas apenas conexões da mesma rede serão permitidas (e não conexões NAT transversal ou de redirecionamento).";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "Permitir conexões de acesso remoto a esta máquina";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "Se esta política for definida como \"Desativada\", o serviço de host de acesso remoto não poderá ser iniciado nem configurado para aceitar conexões de entrada.  Esta política não afeta situações de suporte remoto.\n\nEsta política não terá efeito se for definida como \"Ativada\", deixada vazia ou sem definição.";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "Permitir conexões de suporte remoto a esta máquina";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "Se esta política for desativada, o host de suporte remoto não vai poder ser iniciado ou configurado para aceitar novas conexões.\n\nEsta política não afeta situações de acesso remoto.\n\nEsta política não impede que administradores corporativos se conectem a dispositivos Google Chrome OS gerenciados.\n\nEsta política não vai ter efeito se for ativada, deixada vazia ou não for definida.";
RemoteAccessHostAllowUrlForwarding.pfm_title = "Permitir que usuários de acesso remoto abram URLs do lado do host no navegador cliente local";
RemoteAccessHostAllowUrlForwarding.pfm_description = "Se a política for ativada ou deixada sem definição, os usuários conectados a um host de acesso remoto poderão abrir URLs do lado do host no navegador cliente local.\n\nSe a política for desativada, o host de acesso remoto não vai enviar URLs ao cliente.\n\nEssa configuração não é válida para conexões de assistência remota, já que esse modo de conexão não tem suporte ao recurso.\n\nObservação: esse recurso ainda não está disponível para o público geral. Portanto, ativá-lo não significa que ele ficará visível na interface do cliente.";
RemoteAccessHostClientDomainList.pfm_title = "Configurar os nomes de domínio obrigatórios para clientes de acesso remoto";
RemoteAccessHostClientDomainList.pfm_description = "Definir a política especifica os nome de domínio impostos aos clientes de acesso remoto. Os usuários não poderão mudar isso. Apenas clientes de um dos domínios especificados poderão se conectar ao host.\n\nSe a política for definida como uma lista vazia ou deixada sem definição, a política padrão será aplicada conforme o tipo de conexão. Para assistência remota, isso permite que clientes de qualquer domínio se conectem ao host. Para acesso remoto a qualquer momento, apenas o proprietário do host poderá se conectar.\n\nVeja também: RemoteAccessHostDomainList.\n\nObservação: esta configuração substituirá RemoteAccessHostClientDomain, caso presente.";
RemoteAccessHostClipboardSizeBytes.pfm_title = "O tamanho máximo, em bytes, que pode ser transferido entre cliente e host pela sincronização da área de transferência";
RemoteAccessHostClipboardSizeBytes.pfm_description = "Se esta política for definida, os dados da área de transferência enviados pelo host e para ele serão truncados até o limite definido.\n\nSe um valor de 0 for definido, a sincronização da área de transferência ficará desativada.\n\nEsta política afeta cenários de acesso e suporte remotos.\n\nEla não terá efeito se não for definida.\n\nSe a política for definida com um valor que não está no intervalo mínimo/máximo, o host poderá não ser iniciado.\n\nO limite superior do tamanho da área de transferência é baseado no tamanho máximo das mensagens no canal de dados WebRTC, que esta política não controla.";
RemoteAccessHostDomainList.pfm_title = "Configurar os nomes de domínio obrigatórios para hosts de acesso remoto";
RemoteAccessHostDomainList.pfm_description = "Se a política for definida, os nomes de domínio impostos aos hosts de acesso remoto serão especificados. Os usuários não poderão mudar isso. Os hosts podem ser compartilhados somente por contas registradas em um dos nomes de domínio especificados.\n\nSe a política for definida como uma lista vazia ou deixada sem definição, os hosts poderão ser compartilhados usando qualquer conta.\n\nVeja também: RemoteAccessHostClientDomainList.\n\nObservação: esta configuração substituirá a RemoteAccessHostDomain, se ela estiver presente.";
RemoteAccessHostFirewallTraversal.pfm_title = "Habilitar passagem de firewall a partir do host de acesso remoto";
RemoteAccessHostFirewallTraversal.pfm_description = "Se a política for definida como \"Ativada\" ou deixada sem definição, o uso de servidores STUN será permitido, isso faz com que clientes remotos possam descobrir e se conectar a esta máquina, mesmo quando separados por um firewall.\n\nSe a política for definida como \"Desativada\" e as conexões de saída UDP forem filtradas pelo firewall, a máquina permitirá apenas conexões de máquinas clientes na rede local.";
RemoteAccessHostMatchUsername.pfm_title = "Exigir correspondência entre o nome do usuário local e o proprietário do host de acesso remoto";
RemoteAccessHostMatchUsername.pfm_description = "Se a política for definida como \"Ativada\", o host de acesso remoto fará a comparação entre o nome do usuário local associado com o host e o nome da Conta do Google registrada como proprietária do host (\"joaosilva\", se o host for propriedade de \"joaosilva@exemplo.com\"). Este host não será iniciado se o nome do proprietário do host for diferente do nome do usuário local associado com o host. Use a política RemoteAccessHostDomain para garantir que a Conta do Google do proprietário seja associada com um domínio específico.\n\nSe a política for definida como \"Desativada\" ou deixada sem definição, o host de acesso remoto poderá ser associado com qualquer usuário local.";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "Duração máxima da seção permitida por conexões de acesso remoto";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "Se esta política for definida, as conexões de acesso remoto serão encerradas automaticamente quando o número de minutos definido na política for excedido. Isso não impede que o cliente se reconecte após a duração máxima da sessão ter sido alcançada. Se a política for definida com um valor que não está no intervalo mínimo/máximo, o host poderá não ser iniciado. Esta política não afeta situações de suporte remoto.\n\nEsta política não terá efeito se não for definida. Nesse caso, as conexões de acesso remoto não terão uma duração máxima nesta máquina.";
RemoteAccessHostRequireCurtain.pfm_title = "Ativar cortinas de hosts de acesso remoto";
RemoteAccessHostRequireCurtain.pfm_description = "Se a política for definida como \"Ativada\", a entrada física e os dispositivos de saída dos hosts de acesso remoto serão desativados durante uma conexão remota.\n\nSe a política for definida como \"Desativada\" ou deixada sem definição, usuários locais e remotos poderão interagir com o host durante o compartilhamento.";
RemoteAccessHostUdpPortRange.pfm_title = "Restringir o intervalo de portas UDP usado pelo host de acesso remoto";
RemoteAccessHostUdpPortRange.pfm_description = "Se a política for definida, o intervalo de portas UDP usado pelo host de acesso remoto nesta máquina será restrito.\n\nSe a política for definida como uma string vazia ou deixada sem definição, o host de acesso remoto poderá usar qualquer porta disponível.\n\nObservação: se RemoteAccessHostFirewallTraversal for desativada, o host de acesso remoto usará as portas UDP no intervalo 12400-12409.";
RemoteDebuggingAllowed.pfm_title = "Permitir a depuração remota";
RemoteDebuggingAllowed.pfm_description = "Controla se os usuários podem usar a depuração remota.\n\nSe esta política for ativada ou deixada sem definição, os usuários poderão usar a depuração remota especificando as chaves da linha de comando --remote-debugging-port e --remote-debugging-pipe em plataformas para computador ou ativando a configuração do sistema de depuração USB no Android.\n\nSe esta política for definida como \"Desativada\", os usuários não poderão usar a depuração remota.";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "Exigir verificações on-line de OCSP/CRL para âncoras de confiança locais";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "Se a política for definida como verdadeira, o Brave sempre vai verificar a revogação de certificados de servidor validados com assinatura dos certificados de CA locais. Se o Brave não conseguir informações sobre o status da revogação, o Brave tratará esses certificados como revogados (\"falha forçada\").\n\nSe a política for definida como falsa ou for deixada sem definição, o Brave vai usar configurações on-line de verificação da revogação.\n\nNo macOS, essa política não tem efeito quando a ChromeRootStoreEnabled é definida como falsa.";
RestoreOnStartup.pfm_title = "Ação na inicialização";
RestoreOnStartup.pfm_description = "5 - Abrir Nova guia\n1 - Restaurar a última sessão\n4 - Abrir uma lista de URLs\n6 - Abrir uma lista de URLs e restaurar a última sessão\nA definição desta política permite especificar o comportamento do sistema na inicialização. Desativar essa configuração é o mesmo que não defini-la, já que o Brave precisa ter um comportamento de inicialização especificado.\n\nSe você definir a política, ela não poderá ser mudada pelos usuários no Brave. Se não for definida, ela poderá ser alterada.\n\nA definição da política como RestoreOnStartupIsLastSession ou RestoreOnStartupIsLastSessionAndURLs desativa algumas configurações que dependem de sessões ou que realizam ações ao sair, como a limpeza dos dados de navegação ou dos cookies de sessão.\n\nSe essa política for definida como RestoreOnStartupIsLastSessionAndURLs, o navegador vai restaurar a sessão anterior e abrir uma janela separada para mostrar URLs definidos em RestoreOnStartupURLs. Além disso, os usuários podem optar por manter esses URLs abertos. Assim, eles também serão restaurados na próxima sessão.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
RestoreOnStartupURLs.pfm_title = "URLs que devem ser abertos na inicialização";
RestoreOnStartupURLs.pfm_description = "Se RestoreOnStartup for definida como RestoreOnStartupIsURLs, definir RestoreOnStartupURLs como uma lista de URLs especifica quais serão abertos.\n\nSe ela não for definida, a página \"Nova guia\" será aberta na inicialização.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "Restringir a API Background Fetch quando chamada por um service worker";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "Esta política controla se as solicitações de busca em segundo plano feitas por service workers são restritas. Se um recurso que baixa arquivos em segundo plano for afetado, esta política poderá ser relevante.\n\nSe a política estiver ativada ou não for configurada, a restrição ficará ativa e as solicitações de busca em segundo plano de contextos de service workers poderão ser bloqueadas.\n\nSe a política estiver desativada, a restrição será ignorada, permitindo que todos os service workers façam solicitações de busca em segundo plano.\n\nEsta política corporativa é temporária e será removida após a versão M152.";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "Restringir contas do Google qualificadas para salvar arquivos PDF no Google Drive pelo visualizador de PDF do Brave";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "Contém uma expressão regular para determinar as contas do Google qualificadas para salvar arquivos PDF no Google Drive pelo visualizador de PDF do Brave.\n\nUma mensagem de erro será exibida se um usuário tentar fazer upload de um arquivo PDF para o Google Drive usando uma conta que não corresponda a esse padrão.\n\nSe esta política não for definida ou for deixada em branco, o usuário poderá usar qualquer Conta do Google para salvar arquivos PDF no Google Drive.";
RestrictSigninToPattern.pfm_title = "Restringir quais Contas do Google são permitidas como principais do navegador no Brave";
RestrictSigninToPattern.pfm_description = "Contém uma expressão regular que é usada para determinar quais Contas do Google podem ser definidas como contas principais do navegador no Brave (isto é, a conta escolhida durante o fluxo de ativação de sincronização).\n\nSe o usuário tentar configurar uma conta principal com um nome de usuário que não corresponde a esse padrão, o erro correspondente será exibido.\n\nSe esta política for deixada sem definição ou em branco, o usuário poderá configurar qualquer Conta do Google como uma conta principal do navegador no Brave.";
RestrictYouTubeCookiesDeletion.pfm_title = "Restringir a exclusão de cookies do YouTube";
RestrictYouTubeCookiesDeletion.pfm_description = "Impede a exclusão manual de cookies do YouTube.\n\nEsta política tem como objetivo impedir que os usuários acessem o YouTube sem autorização depois de limpar manualmente os cookies do YouTube na página de configurações do site.\n\nSe a política for ativada, os cookies do YouTube não poderão ser excluídos manualmente.\n\nSe a política for desativada ou não for definida, os cookies do YouTube poderão ser excluídos normalmente.\n\nObservação: esta política impede apenas a exclusão manual da interface de configurações do site. Ela não impede a exclusão automatizada pelas políticas ClearBrowsingDataOnExitList ou BrowsingDataLifetime. Além disso, se a política AllowDeletingBrowserHistory estiver ativada, os usuários ainda poderão limpar todos os cookies na caixa de diálogo Limpar Dados de Navegação.";
SSLErrorOverrideAllowed.pfm_title = "Permitir a continuação na página de aviso SSL";
SSLErrorOverrideAllowed.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, os usuários poderão clicar para ignorar páginas de aviso exibidas pelo Brave quando eles acessarem sites com erros de SSL.\n\nSe a política for definida como \"Desativada\", os usuários serão impedidos de ignorar as páginas de aviso.";
SSLErrorOverrideAllowedForOrigins.pfm_title = "Permitir que páginas de aviso SSL em origens específicas sejam ignoradas";
SSLErrorOverrideAllowedForOrigins.pfm_description = "Quando SSLErrorOverrideAllowed está desativada e depois é definida, é possível configurar uma lista de padrões de origem. Essa lista especifica os sites em que os usuários podem clicar para ignorar as páginas de aviso exibidas pelo Brave quando navegarem para sites com erros de SSL. Os usuários não poderão clicar para ignorar páginas com avisos SSL em origens que não estejam na lista.\n\nSe SSLErrorOverrideAllowed estiver ativada ou sem definição, a política não terá efeito.\n\nSe a política for deixada sem definição, SSLErrorOverrideAllowed será aplicada em todos os sites.\n\nPara saber mais sobre padrões de entrada válidos, consulte https://chromeenterprise.google/policies/url-patterns/. * não é um valor aceitável para esta política. A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.";
SafeBrowsingAllowlistDomains.pfm_title = "Configure a lista de domínios em que a política Navegação segura não acionará avisos.";
SafeBrowsingAllowlistDomains.pfm_description = "Se a política for definida como \"Ativada\", a Navegação segura confiará nos domínios designados. Ela não verificará a presença de recursos perigosos como phishing, malware ou software indesejado. O serviço de proteção de downloads da Navegação segura não verificará downloads hospedados nesses domínios. O serviço de proteção de senhas não verificará a reutilização de senhas.\n\nSe a política não for definida, as proteções padrão da Navegação segura serão aplicadas a todos os recursos.\n\nEsta política não aceita o uso de expressões regulares. No entanto, os subdomínios de um determinado domínio estão na lista de permissões. Nomes de domínio totalmente qualificados (FQDNs, na sigla em inglês) não são obrigatórios.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.";
SafeBrowsingDeepScanningEnabled.pfm_title = "Permitir verificações detalhadas de downloads para usuários que ativaram a Navegação segura";
SafeBrowsingDeepScanningEnabled.pfm_description = "Se esta política for ativada ou não for definida, o Brave poderá enviar downloads suspeitos de usuários com o recurso Navegação segura ao Google para verificar se há malware ou solicitar que os usuários forneçam uma senha para arquivos criptografados.\nSe a política for desativada, a verificação não será realizada.\nEla não afeta a análise de downloads configurada pelo Chrome Enterprise Connectors.";
SafeBrowsingProtectionLevel.pfm_title = "Nível de proteção do \"Navegação segura\"";
SafeBrowsingProtectionLevel.pfm_description = "0 - O \"Navegação segura\" nunca está ativado.\n1 - O \"Navegação segura\" está ativo no modo padrão.\n2 - O \"Navegação segura\" está ativo no modo avançado. Esse modo oferece maior segurança, mas requer o compartilhamento de mais informações de navegação com o Google.\nPermite que você controle se o recurso Navegação segura do Brave está ativado e em que modo ele opera.\n\nSe esta política for definida como \"NoProtection\" (valor 0), a Navegação segura nunca estará ativa.\n\nSe a política for definida como \"StandardProtection\" (valor 1, que é o padrão), a Navegação segura sempre estará ativa no modo padrão.\n\nSe a política for definida como \"EnhancedProtection\" (valor 2), a Navegação segura sempre estará ativa no modo avançado, que oferece maior segurança, mas requer o compartilhamento de mais informações de navegação com o Google.\n\nSe você definir esta política como obrigatória, os usuários não poderão mudar ou substituir a configuração da Navegação segura no Brave.\n\nSe esta política não for definida, a Navegação segura vai operar no modo \"Proteção padrão\", mas os usuários poderão mudar a configuração.\n\nConsulte https://support.google.com/chrome?p=safe_browsing_preferences para mais informações sobre a Navegação segura.";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "Permitir verificações em tempo real com o proxy da Navegação segura";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "Isso controla se o modo de proteção padrão do Navegação segura pode enviar hashes parciais de URLs ao Google por meio de um proxy via HTTP Oblivious para determinar se eles são seguros.\n\nO proxy permite que os navegadores façam o upload de hashes parciais de URLs para o Google\nsem que eles estejam vinculados ao endereço IP do usuário. A política também permite\nque os navegadores façam o upload dos hashes parciais de URLs com maior frequência para\nmelhorar a qualidade da proteção do Navegação segura.\n\nEsta política será ignorada se a Navegação segura estiver desativada ou definida como\no modo de proteção avançada.\n\nSe a política for definida como ativada ou não for definida, as pesquisas por\nproxy com maior proteção poderão ser usadas.\n\nSe a política for definida como desativada, as pesquisas por proxy com maior proteção não\nserão permitidas. Os hashes parciais dos URLs serão enviados diretamente para o Google com uma frequência\nmuito menor, o que vai prejudicar a proteção.";
SafeBrowsingSurveysEnabled.pfm_title = "Permitir pesquisas da Navegação segura";
SafeBrowsingSurveysEnabled.pfm_description = "Quando esta política for ativada ou deixada sem definição, o usuário poderá receber pesquisas relacionadas ao recurso Navegação segura.\nQuando ela for desativada, o usuário não vai receber essas pesquisas.";
SafeSitesFilterBehavior.pfm_title = "Controlar a filtragem de conteúdo adulto SafeSites.";
SafeSitesFilterBehavior.pfm_description = "0 - Não filtrar sites com conteúdo adulto\n1 - Filtrar sites com conteúdo adulto\nSe a política for definida, será possível controlar o filtro de URL SafeSites, que usa a API Google Safe Search para classificar URLs como sendo pornográficos ou não.\n\nQuando a política for definida para:\n\n* não filtrar sites com conteúdo adulto ou for deixada sem definição: os sites não serão filtrados;\n\n* filtrar sites com conteúdo adulto: sites pornográficos serão filtrados.\n\nA política se aplica ao URL que o usuário acessa e aos iframes. A política URLAllowlist tem precedência sobre esta e pode ser usada para substituir os vereditos da API Google Safe Search.";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "Permitir captura de guia da mesma origem por estas origens";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que podem capturar guias com a mesma origem.\n\nSe ela for deixada sem definição, os sites não serão considerados para uma substituição nesse nível da captura.\n\nAinda será possível capturar apps do Chrome em janela com a mesma origem do site.\n\nSe um site corresponder a um padrão de URL nesta política, TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins e ScreenCaptureAllowed não serão consideradas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns/.  A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.";
SandboxExternalProtocolBlocked.pfm_title = "Permitir que o Chrome bloqueie a navegação para protocolos externos no iframe dentro do sandbox";
SandboxExternalProtocolBlocked.pfm_description = "O Chrome vai bloquear a navegação para protocolos externos no\niframe dentro do sandbox. Consulte https://chromestatus.com/features/5680742077038592.\n\nSe esta política for definida como verdadeira, o Chrome vai bloquear esse tipo de navegação.\n\nSe ela for definida como falsa, o Chrome não vai bloquear esse tipo de navegação.\n\nPor padrão, a política é definida como verdadeira, com o recurso de segurança ativado.\n\nEla pode ser usada por administradores que precisam de mais tempo para atualizar os sites internos afetados pela nova restrição. A política corporativa é temporária e será removida após a versão 117 do Brave.\n";
SavingBrowserHistoryDisabled.pfm_title = "Desativar o salvamento do histórico do navegador";
SavingBrowserHistoryDisabled.pfm_description = "Se a política for definida como \"Ativada\" o histórico de navegação não será salvo, a sincronização de guias será desativada e os usuários não poderão mudar essa configuração.\n\nSe a política for definida como \"Desativada\" ou não for definida, o histórico de navegação será salvo.";
ScreenCaptureAllowed.pfm_title = "Permitir ou negar captura de tela";
ScreenCaptureAllowed.pfm_description = "Se ativada ou não configurada (padrão), uma página da Web poderá usar\nAPIs de compartilhamento de tela (por exemplo, getDisplayMedia() ou a API de extensão Desktop Capture)\npara pedir que o usuário selecione uma guia, janela ou área de trabalho para captura.\n\nQuando esta política estiver desativada, as chamadas para APIs de compartilhamento de tela falharão\ncom um erro. No entanto, ela não será considerada, e um site poderá\nusar APIs de compartilhamento de tela, se o site corresponder a um padrão de origem em alguma destas políticas:\nScreenCaptureAllowedByOrigins,\nWindowCaptureAllowedByOrigins,\nTabCaptureAllowedByOrigins ou\nSameOriginTabCaptureAllowedByOrigins.\n";
ScreenCaptureAllowedByOrigins.pfm_title = "Permitir captura de área de trabalho, janela e guia por estas origens";
ScreenCaptureAllowedByOrigins.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que podem usar a captura de área de trabalho, janela e guia.\n\nSe ela for deixada sem definição, os sites não serão considerados para uma substituição nesse nível da captura.\n\nEsta política não será considerada caso um site corresponda a um padrão de URL nas políticas WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins ou SameOriginTabCaptureAllowedByOrigins.\n\nSe um site corresponder a um padrão de URL nesta política, ScreenCaptureAllowed não será considerada.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns/.  A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "Permitir captura de tela sem o gesto anterior do usuário";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "Por motivos de segurança, a\nAPI getDisplayMedia() da web exige\nque uma interação inicial do usuário (\"ativação temporária\") seja chamada. Caso contrário,\nvai haver uma falha.\n\nCom esse conjunto de políticas, os admins podem especificar origens em que essa API pode ser\nchamada sem a interação inicial do usuário.\n\nPara saber mais sobre padrões de URL válidos, consulte\nhttps://chromeenterprise.google/policies/url-patterns/. O valor *\nnão é aceito para esta política.\n\nSe a política for deixada sem definição, todas as origens vão exigir uma interação inicial do usuário para chamar\nessa API.";
ScrollToTextFragmentEnabled.pfm_title = "Permitir rolagem para texto especificado em fragmentos de URL";
ScrollToTextFragmentEnabled.pfm_description = "Esse recurso permite que navegações de URL de hiperlinks e da barra de endereço busquem textos específicos em uma página da Web, rolando para o local desejado assim que o carregamento é concluído.\n\nSe você ativar ou não configurar essa política, a rolagem via URL para fragmentos de texto específicos em páginas da Web será ativada.\n\nSe você desativar a política, essa rolagem será desativada.";
SearchContentSharingSettings.pfm_title = "Ativar o compartilhamento de conteúdo com integrações do Google AI Mode e do Lens";
SearchContentSharingSettings.pfm_description = "0 - Permitir o compartilhamento de conteúdo com integrações do Google AI Mode.\n1 - Não permitir o compartilhamento de conteúdo com integrações do Google AI Mode.\nEsta política controla o compartilhamento do conteúdo de páginas e arquivos com o Google AI Mode e o Lens pelo painel lateral ou pelas guias do Google Chrome.\n\nEla não afeta o Google AI Mode na web. A política só controla como os usuários podem compartilhar informações com esse recurso ao usar o Google Chrome.\n\n0 = os usuários poderão compartilhar o conteúdo de páginas ou arquivos com o Google AI Mode.\n\n1 = os usuários não poderão compartilhar o conteúdo de páginas ou arquivos com o Google AI Mode. Os pontos de entrada para compartilhamento de contexto e o painel lateral serão desativados ou ocultados.\n\nEsta política será ignorada quando o Google Search não for o mecanismo de pesquisa padrão dos usuários, já que o recurso está desativado.\n\nEla é independente da política AIModeSettings. A política AIModeSettings controla apenas os pontos de entrada na caixa de pesquisa da omnibox ou da página \"Nova guia\". Já esta política controla o compartilhamento de contexto pelo painel lateral ou pelas guias.\n\nAlém disso, esta política não controla a integração do Google Gemini, que pode ser desativada pela GeminiSettings.\n\nSe esta política não for definida, o comportamento dela será determinado pela política GenAiDefaultSettings.\n\nPara mais informações sobre como tratar dados de recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
SearchSuggestEnabled.pfm_title = "Ativar sugestões de pesquisa";
SearchSuggestEnabled.pfm_description = "Se a política for definida como verdadeira, as sugestões de pesquisa na barra de endereço do Brave vão ser ativadas. Se ela for definida como falsa, essas sugestões vão ser desativadas.\n\nSugestões baseadas em favoritos ou histórico não são afetadas pela política.\n\nSe você definir a política, os usuários não poderão mudá-la. Se ela não for definida, as sugestões de pesquisa ficarão inicialmente ativadas, mas os usuários poderão desativá-las quando quiserem.";
SecurityKeyPermitAttestation.pfm_title = "Os URLs/domínios permitidos automaticamente direcionam a declaração da chave de segurança";
SecurityKeyPermitAttestation.pfm_description = "A definição da política vai especificar os IDs de RP do WebAuthn para os quais nenhum comando aparece quando certificados de atestado das chaves de segurança forem solicitados. Além disso, um sinal será enviado para a chave de segurança indicando que o atestado empresarial pode ser usado. Se a política for deixada sem definição, os usuários vão receber uma solicitação no Brave 65 ou versões mais recentes quando os sites solicitarem o atestado das chaves de segurança.";
SensorsAllowedForUrls.pfm_title = "Permite acesso a sensores nesses sites";
SensorsAllowedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifique os sites que podem acessar sensores de luz e movimento.\n\nSe a política não for definida, DefaultSensorsSetting será aplicada a todos os sites, se esta estiver configurada. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nSe o mesmo padrão de URL existir nesta política e na política SensorsBlockedForUrls, a segunda terá prioridade, e o acesso a sensores de luz e movimento será bloqueado.\n\nPara informações mais detalhadas sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
SensorsBlockedForUrls.pfm_title = "Bloquear acesso a sensores nesses sites";
SensorsBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica os sites que não podem acessar sensores de luz e movimento.\n\nSe a política não tiver definição, DefaultSensorsSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nSe o mesmo padrão de URL existir nesta política e na SensorsAllowedForUrls, a primeira terá prioridade e o acesso a sensores de luz e movimento será bloqueado.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos.";
SerialAllowAllPortsForUrls.pfm_title = "Permitir automaticamente que os sites se conectem a todas as portas seriais.";
SerialAllowAllPortsForUrls.pfm_description = "Se a política for definida, você vai poder listar sites com permissão automática para acessar todas as portas seriais disponíveis.\n\nOs URLs precisam ser válidos. Caso contrário, a política será ignorada. Apenas a origem (esquema, host e porta) do URL é considerada.\n\nNo Google Chrome OS, esta política se aplica apenas a usuários afiliados.\n\nEsta política substitui DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls e as preferências do usuário.";
SerialAllowUsbDevicesForUrls.pfm_title = "Permitir automaticamente que os sites se conectem a dispositivos seriais USB.";
SerialAllowUsbDevicesForUrls.pfm_description = "Se a política for definida, você vai poder listar sites com permissão automática para acessar dispositivos seriais USB com IDs de produto e fornecedor correspondentes aos campos vendor_id e product_id. A omissão do campo product_id concede aos sites permissão para acessar dispositivos com um ID de fornecedor correspondente ao campo vendor_id e a qualquer ID de produto.\n\nOs URLs precisam ser válidos. Caso contrário, a política será ignorada. Apenas a origem (esquema, host e porta) do URL é considerada.\n\nNo ChromeOS, esta política se aplica apenas a usuários afiliados.\n\nEsta política substitui DefaultSerialGuardSetting, SerialAskForUrls, SerialBlockedForUrls e as preferências do usuário.\n\nEla afeta apenas o acesso aos dispositivos USB pela API Web Serial. Para conceder acesso a dispositivos USB pela API WebUSB, consulte a política WebUsbAllowDevicesForUrls.\nConsulte https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls para ver mais informações sobre esquema e formatação.";
SerialAskForUrls.pfm_title = "Permitir a API Serial nesses sites";
SerialAskForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica quais sites podem pedir que o usuário permita o acesso a uma porta serial.\n\nSe a política não tiver definição, DefaultSerialGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, as configurações pessoais dos usuários serão aplicadas.\n\nNo caso de padrões de URL que não correspondem à política SerialBlockedForUrls (se houver uma correspondência), DefaultSerialGuardSetting (se definida) ou as preferências pessoais dos usuários têm precedência, nessa ordem.\n\nSe os padrões de URL entrarem em conflito com a política SerialBlockedForUrls, eles serão ignorados.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
SerialBlockedForUrls.pfm_title = "Bloquear a API Serial nesses sites";
SerialBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica quais sites não podem pedir que o usuário conceda permissão de acesso a uma porta serial.\n\nSe a política não tiver definição, DefaultSerialGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nNo caso de padrões de URL que não correspondem à política SerialAskForUrls (se houver uma correspondência), DefaultSerialGuardSetting (se definida) ou as preferências pessoais dos usuários têm precedência, nessa ordem.\n\nSe os padrões de URL entrarem em conflito com a política SerialAskForUrls, esta política terá precedência.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
ServiceWorkerAutoPreloadEnabled.pfm_title = "Permitir que o ServiceWorker envie solicitações de navegação sem esperar a inicialização";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nO recurso ServiceWorkerAutoPreload envia uma solicitação de rede para um recurso principal ao mesmo tempo que inicia o processo de inicialização do ServiceWorker.\n\nSe a política for ativada ou deixada sem definição, o\nBrave vai ativar o ServiceWorkerAutoPreload. A solicitação de navegação é enviada automaticamente ao iniciar o ServiceWorker em alguns cenários, por exemplo, quando o ServiceWorker não está em execução.\n\nSe estiver desativado, o Brave não vai ativar o ServiceWorkerAutoPreload. A solicitação de navegação é enviada sempre após o início do ServiceWorker.\n\nEsta política é uma medida temporária para controlar o recurso e será removida na versão M154.";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "Permitir que o ServiceWorker controle iframes srcdoc";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "https://github.com/w3c/ServiceWorker/issues/765 pede que o iframe srcdoc com\no atributo de sandbox \"allow-same-origin\" esteja sob controle do ServiceWorker.\n\nSe a política for ativada ou deixada sem definição, o\nBrave fará com que os iframes de srcdoc\ncom atributos de sandbox \"allow-same-origin\" estejam sob controle do ServiceWorker.\n\nSe a política for desativada, o iframe de srcdoc não será controlado pelo\nServiceWorker.\n\nEssa política é temporária e será removida em 2026.";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "Especifica se o SharedArrayBuffers pode ser usado em um contexto não isolado entre origens";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\nEspecifica se os objetos SharedArrayBuffers podem ser usados em um contexto sem isolamento entre origens. Da versão 91 (25/05/2021) em diante, o Brave vai exigir o isolamento entre origens ao usar os SharedArrayBuffers do Brave por motivos de compatibilidade na Web. Veja mais detalhes em: https://developer.chrome.com/blog/enabling-shared-array-buffer/ (link em inglês).\n\nSe a política for ativada, os sites poderão usar os SharedArrayBuffers sem restrições.\n\nSe ela for desativada ou deixada sem definição, os sites só poderão usar os SharedArrayBuffers em isolamento entre origens.";
SharedWorkerBlobURLFixEnabled.pfm_title = "Alinhar o comportamento do URL do blob do SharedWorker com a especificação";
SharedWorkerBlobURLFixEnabled.pfm_description = "Em https://w3c.github.io/ServiceWorker/#control-and-use-worker-client (link em inglês),\nos workers devem herdar os controladores do URL do blob.  No entanto, o código atual\npermite que apenas DedicatedWorkers herdem o controlador. SharedWorkers\nnão o herdam.\n\nSe a política for ativada ou deixada sem definição, o\nBrave vai herdar o controlador\nse o URL de um blob for usado como um URL de SharedWorker.\n\nSe a política for desativada, o comportamento não será alinhado à\nespecificação atual.\n\nEsta política é temporária e será removida.";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "Ativar ciclo de vida estendido para SharedWorkers";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "SharedWorkers podem ter o ciclo de vida estendido se a opção \"extendedLifetime\" for definida como verdadeira no construtor do SharedWorker.\n\nSe esta política estiver ativada ou não for configurada, os SharedWorkers poderão ter o ciclo de vida estendido.\n\nSe esta política estiver desativada, os SharedWorkers não poderão ter o ciclo de vida estendido, mesmo se a opção estiver definida como verdadeira.\n\nEssa política é temporária e será removida.";
ShoppingListEnabled.pfm_title = "Permitir que o recurso da lista de compras seja ativado";
ShoppingListEnabled.pfm_description = "Esta política controla a disponibilidade do recurso da lista de compras.\nSe for ativada, os usuários vão receber uma interface para monitorar o preço do produto mostrado na página atual. O produto é mostrado no painel lateral de favoritos.\nSe a política for ativada ou deixada sem definição, a lista de compras vai ficar disponível para os usuários.\nSe for desativada, o recurso da lista de compras vai ficar indisponível.\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "Exibir os atalhos de aplicativos na barra de favoritos";
ShowAppsShortcutInBookmarkBar.pfm_description = "Se a política for definida como verdadeira, o atalho de apps será exibido. Se ela for definida como falsa, o atalho não aparecerá.\n\nSe você definir a política, os usuários não poderão mudá-la. Se ela não for definida, os usuários poderão mostrar ou ocultar o atalho de apps no menu de contexto da barra de favoritos.";
ShowCastIconInToolbar.pfm_title = "Mostrar o ícone da barra de ferramentas do Google Cast";
ShowCastIconInToolbar.pfm_description = "Se a política for ativada, o ícone da barra de ferramentas do Google Cast vai aparecer na barra de ferramentas ou no menu flutuante e não poderá ser removido pelo usuário.\n\nSe a política for desativada ou não for definida, o usuário poderá fixar ou remover o ícone com o menu contextual.\n\nSe a política EnableMediaRouter for definida como desativada, o valor desta política não terá efeito e o ícone da barra de ferramentas não vai aparecer.";
ShowCastSessionsStartedByOtherDevices.pfm_title = "Mostrar controles de mídia para sessões do Google Cast iniciadas por outros dispositivos na rede local";
ShowCastSessionsStartedByOtherDevices.pfm_description = "Quando esta política é ativada, a interface dos controles de mídia fica disponível para sessões do Google Cast iniciadas por outros dispositivos na rede local.\n\nSe a política for deixada sem definição para usuários corporativos ou for desativada, a interface dos controles de mídia vai ficar indisponível para as sessões do Google Cast iniciadas por outros dispositivos na rede local.\n\nSe a política EnableMediaRouter for desativada, o valor desta não terá efeito, já que a funcionalidade do Google Cast vai estar desativada.";
ShowFullUrlsInAddressBar.pfm_title = "Exibir URLs completos";
ShowFullUrlsInAddressBar.pfm_description = "Este recurso ativa a exibição do URL completo na barra de endereço.\nSe esta política for definida como verdadeira, o URL completo será exibido na barra de endereço, incluindo esquemas e subdomínios.\nSe esta política for definida como falsa, a exibição padrão de URL será aplicada.\nSe esta política não for definida, a exibição padrão de URL será aplicada e o usuário poderá alternar entre ela e a exibição completa do URL em uma opção do menu de contexto.\n";
ShowHomeButton.pfm_title = "Exibir o botão da Página inicial na barra de ferramentas";
ShowHomeButton.pfm_description = "Se a política for definida como \"Ativada\", o botão \"Início\" será exibido na barra de ferramentas do Brave. Se a política for definida como \"Desativada\", o botão \"Início\" não será exibido.\n\nSe você definir a política, os usuários não poderão mudá-la no Brave. Se não defini-la, os usuários poderão decidir se o botão \"Início\" será exibido.";
SideSearchEnabled.pfm_title = "Permitir mostrar a página de resultados mais recente do mecanismo de pesquisa padrão em um painel lateral do navegador";
SideSearchEnabled.pfm_description = "Se a política for definida como \"Ativada\" ou for deixada sem definição, os usuários vão poder ver a página de resultados mais recente do mecanismo de pesquisa padrão em um painel lateral ao ativar um ícone na barra de ferramentas.\n\nSe a política for definida como \"Desativada\", o ícone da barra de ferramentas que abre o painel lateral com os resultados da página de resultados do mecanismo de pesquisa padrão vai ser removido.";
SignedHTTPExchangeEnabled.pfm_title = "Ativa a compatibilidade com Signed HTTP Exchange (SXG)";
SignedHTTPExchangeEnabled.pfm_description = "Se a política for definida como verdadeira ou não for definida, o Brave aceitará conteúdos da Web exibidos como Signed HTTP Exchanges.\n\nSe ela for definida como falsa, conteúdos Signed HTTP Exchanges não serão carregados.";
SigninInterceptionEnabled.pfm_title = "Ativar interceptação de login";
SigninInterceptionEnabled.pfm_description = "Esta configuração ativa ou desativa a interceptação de login.\n\nSe esta política não for configurada ou for ativada, a caixa de diálogo de interceptação de login será acionada quando uma Conta do Google for adicionada na Web, e o usuário vai poder se beneficiar da transferência dessa conta para outro perfil (novo ou já existente).\n\nQuando ela for desativada, a caixa de diálogo de interceptação de login não será acionada.\nQuando a política é desativada, uma caixa de diálogo ainda é mostrada caso a separação do perfil da conta gerenciada seja aplicada por ManagedAccountsSigninRestriction.";
SilentPrintingEnabled.pfm_title = "Ativar impressão silenciosa";
SilentPrintingEnabled.pfm_description = "Se a política for definida como true, a impressão silenciosa será ativada. Isso fecha imediatamente\na janela de visualização de impressão quando ela é aberta e usa a impressora padrão com\nas opções padrão. Se a opção de impressão padrão for \"Salvar como PDF\", o arquivo será\nsalvo na pasta \"Downloads\".\n\nSe esta política não for definida ou for definida como false, a impressão silenciosa será desativada.\nAssim, a janela de visualização de impressão não será fechada automaticamente e vai exigir\nque uma seleção seja feita como de costume.";
SitePerProcess.pfm_title = "Exigir isolamento de sites para todos os sites";
SitePerProcess.pfm_description = "Desde o Brave 67, o isolamento de sites é ativado por padrão em todas as plataformas para computador, obrigando cada site a executar um processo próprio. Um site é um esquema + eTLD+1 (por exemplo, https://example.com). Se a política for ativada, esse comportamento não mudará. Ela apenas evita que usuários possam escolher outra opção (por exemplo, desativar o isolamento de sites em chrome://flags). Desde o Brave 76, desativar esta política ou deixá-la sem definição não desativa o isolamento de sites, mas permite que os usuários escolham outra opção.\n\nA IsolateOrigins também pode ser útil para isolar origens específicas com uma granularidade mais refinada que a do site (por exemplo, https://a.example.com).\n\nNo Google Chrome OS 76 e versões anteriores, defina a política DeviceLoginScreenSitePerProcess do dispositivo com o mesmo valor. Se os valores não forem iguais, poderá haver um atraso ao entrar em uma sessão de usuário.\n\nObservação: use a política SitePerProcessAndroid no Android.";
SiteSearchSettings.pfm_title = "Configurações da pesquisa no site";
SiteSearchSettings.pfm_description = "Esta política oferece uma lista de sites em que o usuário pode pesquisar rapidamente usando atalhos na barra de endereço. É possível iniciar uma pesquisa digitando o atalho ou @atalho (por exemplo, @trabalho) seguido da barra de espaço ou tecla Tab na barra de endereço.\n\nOs campos a seguir são obrigatórios para cada site: name, shortcut e url.\n\nO campo name corresponde ao nome do site ou do mecanismo de pesquisa que será mostrado ao usuário na barra de endereço.\n\nO shortcut pode incluir palavras e caracteres simples, mas não pode incluir espaços nem começar com o símbolo @. Os atalhos também precisam ser exclusivos.\n\nPara cada entrada, o campo url especifica o URL do mecanismo de pesquisa usado durante uma pesquisa com a palavra-chave correspondente. O URL precisa incluir a string '{searchTerms}', que é substituída na consulta pelos termos de pesquisa do usuário. Entradas inválidas e com atalhos duplicados são ignoradas.\n\nAs entradas da pesquisa no site configuradas como em destaque aparecem na barra de endereço quando o usuário digita \"@\". Até três entradas podem ser selecionadas para ficar em destaque.\n\nPara uma entrada de pesquisa no site em que allow_user_override é verdadeiro, os usuários podem editar ou desativar essa entrada. No entanto, os mecanismos em destaque (que começam com \"@\") só podem ser desativados. Se um usuário modificar uma entrada criada inicialmente por essa política, ela não será mais gerenciada por uma política e será tratada como um atalho criado pelo usuário. Quando allow_user_override é falso ou não especificado para uma entrada de pesquisa no site, os usuários não podem editar nem desativar essa entrada. A configuração para permitir a substituição do usuário só é compatível com o M139 e versões mais recentes. As versões anteriores desativam a substituição do usuário por padrão.\n\nNão é possível criar novas entradas de pesquisa no site com um atalho criado anteriormente por essa política, a menos que allow_user_override esteja definido como verdadeiro para a entrada de pesquisa no site.\n\nEm caso de conflito com um atalho criado anteriormente pelo usuário, a configuração do usuário tem prioridade. No entanto, ainda é possível acionar a opção criada pela política digitando \"@\" na barra de pesquisa. Por exemplo, se o usuário já definiu \"trabalho\" como um atalho para URL1, e a política define \"trabalho\" como um atalho para URL2, digitar \"trabalho\" na barra de pesquisa aciona uma pesquisa para URL1, mas digitar \"@trabalho\" aciona uma pesquisa para URL2.\n\nNo Microsoft® Windows®, essa política só está disponível em instâncias associadas a um domínio do Microsoft® Active Directory®, associadas ao Microsoft® Azure® Active Directory® ou registradas em Chrome Enterprise Core.\n\nNo macOS, essa política só está disponível em instâncias gerenciadas por MDM, associadas a um domínio via MCX ou registradas em Chrome Enterprise Core.\nConsulte https://chromeenterprise.google/policies/?policy=SiteSearchSettings para ver mais informações sobre esquema e formatação.";
SmartTabSharingSettings.pfm_title = "Configurações do compartilhamento inteligente de guias";
SmartTabSharingSettings.pfm_description = "0 - Permitir o compartilhamento inteligente de guias com integrações do Google AI Mode.\n1 - Não permitir o compartilhamento inteligente de guias com integrações do Google AI Mode.\nEsta política controla o recurso de compartilhamento inteligente de guias do Google AI Mode pelo painel lateral ou pelas guias do Google Chrome.\n\nEla não afeta o Google AI Mode na web. Esta política só controla como os usuários podem compartilhar informações com esse recurso ao usar o Google Chrome.\n\nSe ela for definida como 0, os usuários poderão compartilhar o conteúdo de páginas ou arquivos com o Google AI Mode.\n\nSe for definida como 1, os usuários não poderão compartilhar o conteúdo de páginas ou arquivos com o Google AI Mode. Os pontos de entrada para compartilhamento de contexto e o painel lateral serão desativados ou ocultados.\n\nEsta política será ignorada quando a Google Search não for o mecanismo de pesquisa padrão dos usuários, já que o recurso está desativado.\n\nEsta política é independente da AIModeSettings. A política de AIModeSettings controla apenas os pontos de entrada na caixa de pesquisa da omnibox ou da página Nova Guia. Já esta política controla o compartilhamento de contexto pelo painel lateral ou pelas guias.\n\nEsta política também não controla a integração do Google Gemini, que pode ser desativada pela GeminiSettings.\n\nSe a SearchContentSharingSettings for desativada, esta política será ignorada.\n\nSe esta política não for definida, o comportamento dela será determinado pela política GenAiDefaultSettings.\n\nPara mais informações sobre como tratar dados de recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
SpellCheckServiceEnabled.pfm_title = "Ativar ou desativar serviço da web de verificação ortográfica";
SpellCheckServiceEnabled.pfm_description = "Se a política for definida como \"Ativada\", o serviço da Web do Google será usado para ajudar a resolver erros de ortografia. Essa política controla apenas o uso dos serviços on-line. Se a política for definida como \"Desativada\", o serviço nunca será usado.\n\nSe ela não for definida, os usuários poderão escolher usar o serviço de verificação ortográfica ou não.\n\nA verificação ortográfica sempre pode usar um dicionário baixado localmente, a menos que esse recurso tenha sido desativado pela SpellcheckEnabled. Nesse caso, a política não terá efeito.";
SpellcheckEnabled.pfm_title = "Ativar verificação ortográfica";
SpellcheckEnabled.pfm_description = "Se a política for definida como \"Ativada\", a verificação ortográfica será ativada e os usuários não poderão desativá-la. No Microsoft® Windows®, Google Chrome OS e Linux®, os idiomas de verificação ortográfica podem ser ativados ou desativados individualmente. Assim, os usuários ainda poderão desativar a verificação ortográfica desativando todos os idiomas dela. Para impedir isso, use a SpellcheckLanguage para forçar a ativação de idiomas específicos de verificação ortográfica.\n\nSe a política for definida como \"Desativada\", a verificação ortográfica de todas as origens será desativada e os usuários não poderão ativá-la. As políticas SpellCheckServiceEnabled, SpellcheckLanguage e SpellcheckLanguageBlocklist não terão nenhum efeito quando esta política estiver definida como \"Falsa\".\n\nSe a política não for definida os usuários poderão ativar ou desativar a verificação ortográfica nas configurações de idiomas.";
StandardizedBrowserZoomEnabled.pfm_title = "Ativar comportamento padronizado de zoom do navegador";
StandardizedBrowserZoomEnabled.pfm_description = "Esta política permite a conformidade com a especificação recém-adotada de zoom do CSS.\n\nQuando ela for ativada ou deixada sem definição, a propriedade \"zoom\" do CSS vai seguir a especificação:\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property (link em inglês)\n\nQuando ela for desativada, a propriedade \"zoom\" do CSS vai voltar ao comportamento legado pré-padronizado.\n\nEsta política é uma solução temporária para permitir que o conteúdo da Web seja migrado para o novo comportamento. Há também um teste de origem (DisableStandardizedBrowserZoom) que corresponde ao comportamento quando esta política está desativada. Esta política será removida e o comportamento \"Ativado\" será permanente no marco 134.";
StaticStorageQuotaEnabled.pfm_title = "Controlar se as APIs de cota de armazenamento vão retornar valores estáticos";
StaticStorageQuotaEnabled.pfm_description = "Quando ativadas, as APIs de cota de armazenamento vão retornar um valor estático igual ao uso e mais um mínimo de 10 GiB de disco, arredondado para o próximo 1 GiB.\nQuando desativadas, as APIs de cota de armazenamento geralmente vão retornar um valor dinâmico proporcional ao espaço total disponível no dispositivo, não importando o uso.\nSe forem deixadas sem definição, as APIs de cota de armazenamento vão usar o comportamento padrão do Chrome.\nOs sites com permissões de armazenamento ilimitado não são afetados por essa configuração. A cota obrigatória também não é impactada.";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "Ativar a verificação rigorosa de tipo MIME para scripts de worker";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "Esta política ativa a verificação rigorosa de tipo MIME para scripts de worker.\n\nQuando ela for ativada ou deixada sem definição, os scripts de worker vão usar a verificação rigorosa de tipo MIME para JavaScript, que é o novo comportamento padrão. Os scripts de worker com tipos MIME legados vão ser rejeitados.\n\nQuando desativada, os scripts de worker vão usar a verificação não rigorosa de tipo MIME. Assim, os scripts de worker com tipos MIME legados, como text/ascii, vão continuar sendo carregados e executados.\n\nTradicionalmente, os navegadores usavam a verificação não rigorosa de tipo MIME, de modo que havia suporte para recursos com vários tipos MIME legados. Por exemplo, para recursos JavaScript, o text/ascii é um tipo MIME legado com suporte. Isso pode causar problemas de segurança, permitindo carregar recursos como scripts, sem que eles tenham sido criados para esse uso. O Chrome vai passar a usar verificação rigorosa de tipo MIME em breve. A política ativada vai acompanhar o comportamento padrão. Se a política for desativada, os administradores poderão manter o comportamento legado, se quiserem.\n\nConsulte https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage (link em inglês) para ver detalhes sobre os tipos de mídia JavaScript / ECMAScript.\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "Suprimir caixas de diálogo de JavaScript acionadas por subframes de origem diferentes";
SuppressDifferentOriginSubframeDialogs.pfm_description = "Como descrito em https://www.chromestatus.com/feature/5148698084376576, as caixas de diálogo modais de JavaScript, acionadas por window.alert, window.confirm e window.prompt, são bloqueadas no Brave quando acionadas por um subframe com a origem diferente do frame de origem principal.\n\nEsta política permite substituir essa mudança.\nSe a política é definida como \"Enabled\" ou deixada sem definição, as caixas de diálogo de JavaScript acionadas por um subframe de origem diferente são bloqueadas.\nSe definida como \"Disabled\", as caixas de diálogo de JavaScript acionadas por um subframe de origem diferente não são bloqueadas.\n\nEsta política pode ser removida de Brave no futuro.";
SuppressUnsupportedOSWarning.pfm_title = "Remover o aviso de SO não compatível";
SuppressUnsupportedOSWarning.pfm_description = "Se a política for definida como \"Ativada\", o aviso que aparece quando o Brave está em execução em um computador ou sistema operacional não compatível será suprimido.\n\nSe a política for definida como \"Desativada\", o aviso será exibido nos sistemas não compatíveis.";
SyncDisabled.pfm_title = "Desativar a sincronização de dados com o Google";
SyncDisabled.pfm_description = "Se a política for ativada, a sincronização de dados no Brave usando serviços de sincronização hospedados pelo Google será desativada.\nPara desativar completamente os serviços da Chrome Sync, recomendamos que você desative o serviço no Google Admin console.\n\nSe a política for desativada ou deixada sem definição, os usuários poderão escolher se vão ou não usar a Chrome Sync.\n\nObservação: não ative esta política quando a RoamingProfileSupportEnabled estiver ativada, porque esse recurso usa a mesma funcionalidade do lado do cliente. Nesse caso, a sincronização hospedada pelo Google será completamente desativada.";
SyncTypesListDisabled.pfm_title = "Lista de tipos a serem excluídos da sincronização";
SyncTypesListDisabled.pfm_description = "Se esta política for definida, todos os tipos de dados especificados serão excluídos da sincronização, tanto para a Chrome Sync quanto para a sincronização de perfil de roaming. Isso pode ajudar a reduzir o tamanho do perfil de roaming ou limitar o tipo de dado que será enviado por upload aos servidores da Chrome Sync.\n\nAtualmente, os tipos de dados para esta política são: \"apps\", \"autofill\", \"bookmarks\", \"extensions\", \"preferences\", \"passwords\", \"payments\", \"productComparison\", \"readingList\", \"tabs\", \"themes\", \"typedUrls\" e \"wifiConfigurations\". Esses nomes diferenciam letras maiúsculas de minúsculas.\n\nObservações: a atualização dinâmica de políticas está disponível apenas na versão 123 e mais recentes do Brave. Desativar a opção \"autofill\" também desativa \"payments\". \"typedUrls\" refere-se a todo o histórico de navegação.";
TLS13EarlyDataEnabled.pfm_title = "Ativar o TLS 1.3 Early Data";
TLS13EarlyDataEnabled.pfm_description = "O TLS 1.3 Early Data é uma extensão do TLS 1.3 para enviar uma solicitação HTTP ao mesmo tempo que o handshake de TLS.\n\nSe a política não for configurada, o Brave vai seguir o processo de lançamento padrão do TLS 1.3 Early Data.\n\nSe ela for ativada, o Brave vai ativar o TLS 1.3 Early Data.\n\nSe ela for desativada, o Brave não vai ativar o TLS 1.3 Early Data.\n\nQuando o recurso está ativado, o Brave pode ou não usar o TLS 1.3 Early Data, dependendo do suporte do servidor.\n\nO TLS 1.3 Early Data é um protocolo estabelecido. Os servidores, os dispositivos middlebox e o software de segurança do TLS atuais devem processar ou rejeitar o TLS 1.3 Early Data sem interromper a conexão.\n\nNo entanto, os dispositivos que não implementam corretamente o TLS talvez não funcionem direito e se desconectem quando o TLS 1.3 Early Data estiver em uso. Se isso ocorrer, os administradores precisarão entrar em contato com o fornecedor para que seja feita uma correção.\n\nEssa política é uma medida temporária para controlar o recurso e será removida depois. Ela pode ser ativada em testes para ver se há problemas e desativada enquanto eles são resolvidos.";
TabCaptureAllowedByOrigins.pfm_title = "Permitir captura de guia por estas origens";
TabCaptureAllowedByOrigins.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que podem usar a captura de guia.\n\nSe ela for deixada sem definição, os sites não serão considerados para uma substituição nesse nível da captura.\n\nAinda será possível capturar apps do Chrome em janela.\n\nEsta política não será considerada se um site corresponder a um padrão de URL na SameOriginTabCaptureAllowedByOrigins.\n\nSe um site corresponder a um padrão de URL nesta política, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins e ScreenCaptureAllowed não serão consideradas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns/.  A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.";
TabCompareSettings.pfm_title = "Configurações da Comparação de guias";
TabCompareSettings.pfm_description = "0 - Permitir o uso da Tabela de comparação e melhorar os modelos de IA.\n1 - Permitir o uso da Tabela de comparação sem melhorar os modelos de IA.\n2 - Não permitir o uso da Tabela de comparação.\nA Tabela de comparação é uma ferramenta com tecnologia de IA criada para comparar informações entre as guias de um usuário. Por exemplo, o usuário poderá usar o recurso quando várias guias com produtos de uma categoria semelhante estiverem abertas.\n\nSe ela for definida como 0, o recurso será habilitado e os dados relevantes poderão ser usados pelo Google para melhorar os modelos de IA. Esses dados podem incluir comandos, entradas, saídas, materiais de origem e feedback por escrito, dependendo do recurso. Eles também podem ser analisados por humanos para melhorar os modelos de IA. O valor padrão é 0, exceto quando indicado de outra forma abaixo.\n\nSe a política for definida como 1, o recurso será habilitado, mas o Google não poderá usar o conteúdo dos usuários (incluindo comandos, entradas, saídas, materiais de origem e feedback por escrito) para melhorar os modelos. 1 é o valor padrão para usuários corporativos gerenciados pelo Google Admin console e contas de ensino gerenciadas pelo Google Workspace.\n\nSe ela for definida como 2, o recurso não será habilitado.\n\nSe for deixada sem definição, o comportamento será determinado pela política GenAiDefaultSettings.\n\nPara mais informações sobre como tratar dados de recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
TabDiscardingExceptions.pfm_title = "Exceções ao padrão de URL para descarte de guias";
TabDiscardingExceptions.pfm_description = "Esta política determina que qualquer URL que corresponda a um ou mais padrões especificados, usando o formato de filtro URLBlocklist, nunca seja descartado pelo navegador.\nIsso se aplica à pressão da memória e ao descarte no modo de alta eficiência.\nUma página descartada é descarregada e os recursos dela são totalmente recuperados. A guia a que ela está associada permanece na barra de guias, mas se ela ficar visível, uma atualização completa vai ser acionada.\n";
TaskManagerEndProcessEnabled.pfm_title = "Permitir processos de finalização no gerenciador de tarefas";
TaskManagerEndProcessEnabled.pfm_description = "Se a política for definida como \"Desativada\", os usuários não poderão finalizar processos no gerenciador de tarefas.\n\nSe a política for definida como \"Ativada\" ou deixada sem definição, os usuários poderão encerrar processos no gerenciador de tarefas.";
ThirdPartyAiChatSettings.pfm_title = "Configurações das integrações do Modo IA de terceiros na barra de endereço e na caixa de pesquisa da página Nova Guia.";
ThirdPartyAiChatSettings.pfm_description = "0 - Permitir integrações de terceiros no Modo IA.\n1 - Não permitir integrações de terceiros no Modo IA.\nEssa política controla as integrações do Modo IA de terceiros na barra de endereço e na caixa de pesquisa da página Nova Guia.\n\nPara acessar esse recurso, um mecanismo de pesquisa de terceiros que seja compatível com o Modo IA precisa ser definido como o mecanismo de pesquisa padrão do usuário.\n\n0 = o recurso ficará disponível para os usuários.\n\n1 = o recurso não ficará disponível para os usuários.\n\nSe ela não for definida, o comportamento será determinado pela política GenAiDefaultSettings.";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "Definir um limite de memória para instâncias do Chrome";
TotalMemoryLimitMb.pfm_description = "Configura a quantidade de memória que uma única instância do Brave pode usar antes que as guias comecem a ser descartadas para economizar memória. Isto é, a memória usada por uma guia será liberada, e a guia terá que ser atualizada ao ser aberta novamente.\n\nSe a política for definida, o navegador começará a descartar guias para economizar memória quando o limite for excedido. Entretanto, não há garantia de que o navegador seja sempre executado dentro dos limites. Qualquer valor abaixo de 1.024 será arredondado para esse número.\n\nSe esta política não for definida, o navegador só começará a economizar memória quando detectar que a quantidade de memória física da máquina está baixa.";
TranslateEnabled.pfm_title = "Ativar Traduzir";
TranslateEnabled.pfm_description = "Se esta política for definida como verdadeira, funcionalidades de tradução serão fornecidas quando for adequado para os usuários, mostrando uma barra de ferramentas de tradução integrada no Brave e uma opção de tradução no menu de contexto que aparece ao clicar com o botão direito do mouse. Se esta política for definida como falsa, todos os recursos de tradução integrados serão desativados.\n\nSe você definir a política, os usuários não poderão mudar essa função. Se ela não for definida, os usuários poderão mudar a configuração.";
TranslatorAPIAllowed.pfm_title = "Permitir o uso da API Translator";
TranslatorAPIAllowed.pfm_description = "Se a política for ativada ou deixada sem definição, a API Translator poderá ser usada no Brave.\n\nSe a política for definida como \"Desativada\", o uso da API Translator não será permitida.";
TryOnYouSettings.pfm_title = "Configurações do Provador Virtual.";
TryOnYouSettings.pfm_description = "0 - Ativar o Provador Virtual com melhoria do modelo.\n1 - Ativar o Provador Virtual sem melhoria do modelo.\n2 - Desativar o Provador Virtual.\nO Provador Virtual é um recurso com tecnologia de IA que permite usar imagens de roupas encontradas na web para simular como elas ficariam no usuário e oferece insights úteis de compras no Gemini no Chrome, quando esse recurso está ativado.\n\nSe ela for definida como 0, o recurso será habilitado e os dados relevantes poderão ser usados pelo Google para melhorar os modelos de IA. Esses dados podem incluir imagens, entradas, saídas, materiais de fonte e feedback, dependendo do recurso. Eles também podem ser analisados por humanos para melhorar os modelos de IA. O valor padrão é 0, exceto quando indicado de outra forma abaixo.\n\nSe a política for definida como 1, o recurso será habilitado, mas o Google não poderá usar o conteúdo dos usuários (incluindo imagens, entradas, saídas, materiais de fonte e feedback) para melhorar os modelos. 1 é o valor padrão para usuários corporativos gerenciados pelo Google Admin console e contas de ensino gerenciadas pelo Google Workspace.\n\nSe ela for definida como 2, o recurso não será habilitado.\n\nObservação: a restrição de melhorias do modelo (valor 1) só se aplica quando o Provador Virtual é acionado pelo fluxo do navegador Chrome. Ela não se aplica quando o recurso é usado em outros fluxos.\n\nSe for deixada sem definição, o comportamento será determinado pela política GenAiDefaultSettings. Para mais informações sobre o tratamento de dados dos recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings\n\nO Provador Virtual não está disponível em todos os países ou idiomas. Definir esta política não garante que o recurso será ativado. Ele ainda vai ficar sujeito à disponibilidade. Para mais informações sobre o lançamento, consulte as notas da versão do Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=pt-br";
URLAllowlist.pfm_title = "Permitir acesso a uma lista de URLs";
URLAllowlist.pfm_description = "A definição da política concede acesso aos URLs listados, como exceções à URLBlocklist. Consulte a descrição da política para saber o formato das entradas dessa lista. Por exemplo, se a URLBlocklist for definida como \"*\", todas as solicitações serão bloqueadas, e você poderá usar a política para permitir o acesso a uma lista de URLs limitada. Ela pode servir para abrir exceções para alguns esquemas, subdomínios de outros domínios, portas ou caminhos específicos usando o formato especificado em https://support.google.com/chrome/a?p=url_blocklist_filter_format. O filtro mais específico determina se um URL vai ser bloqueado ou permitido. A política URLAllowlist tem precedência sobre a URLBlocklist. Esta política tem um limite de 1.000 entradas.\n\nEla também permite que o navegador invoque automaticamente aplicativos externos registrados como gerenciadores de protocolo para os protocolos listados, como \"tel:\" ou \"ssh:\".\n\nSe a política não for definida, nenhuma exceção a URLBlocklist vai ser permitida.\n\nNa versão 92 e mais recentes do Brave, esta política também vai oferecer suporte ao modo headless.";
URLBlocklist.pfm_title = "Bloquear acesso a uma lista de URLs";
URLBlocklist.pfm_description = "Se a política URLBlocklist for definida, as páginas da web com URLs proibidos não serão carregadas. Os admins podem especificar a lista de padrões de URL a serem bloqueados. Se a política não for definida, nenhum URL será bloqueado no navegador. Até 1.000 exceções podem ser definidas na URLAllowlist. Confira como formatar um padrão de URL (https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nObservação: esta política não se aplica a URLs JavaScript na página com dados carregados dinamicamente. Se você bloqueou exemplo.com/abc, ainda é possível carregar exemplo.com usando XMLHTTPRequest. Além disso, esta política não impede que as páginas da web atualizem o URL mostrado na omnibox para um bloqueado usando a API History do JavaScript.\n\nA partir do Brave versão 73, é possível bloquear URLs \"javascript://*\". No entanto, isso só afeta JavaScript inserido na barra de endereço ou, por exemplo, os bookmarklets.\n\nA partir do Brave versão 92, esta política também será compatível com o modo headless.\n\nA partir do Brave versão 147, o caractere curinga * sozinho não se aplica a URLs internos chrome://. Para bloquear esses URLs, use explicitamente o padrão chrome://*.\n\nObservação: bloquear URLs internos chrome://* e chrome-untrusted://* pode gerar erros inesperados ou ser ignorado em alguns casos. Em vez de bloquear determinados URLs internos, confira se há políticas mais específicas disponíveis. Por exemplo:\n\n— Em vez de bloquear chrome://settings/certificates, use CACertificateManagementAllowed.\n\n— Em vez de bloquear chrome-untrusted://crosh, use a política SystemFeaturesDisableList.\n\n— Em vez de bloquear devtools://*, use uma das políticas DeveloperToolsAvailability, DeveloperToolsAvailabilityAllowlist ou DeveloperToolsAvailabilityBlocklist.";
UpdateOnZeroWindowEnabled.pfm_title = "Controla a reabertura automática em segundo plano quando todas as janelas do navegador são fechadas";
UpdateOnZeroWindowEnabled.pfm_description = "Controla o comportamento de reinicialização automática em segundo plano no macOS quando uma atualização de segurança está pendente e todas as janelas do navegador estão fechadas.\n\nSe esta política for definida como True, ou não for definida, o Brave poderá ser reiniciado de forma automática para aplicar atualizações pendentes quando todas as janelas do navegador forem fechadas.\n\nSe ela for definida como False, as reinicializações automáticas serão desativadas quando todas as janelas do navegador forem fechadas.";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "Ativar a coleta de dados anônimos inseridos no URL";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "Se a política for definida como \"Ativada\", a coleta de dados anônimos inseridos no URL (que envia os URLs das páginas acessadas pelo usuário ao Google para melhorar a pesquisa e navegação) vai ficar sempre ativa.\n\nSe a política for definida como \"Desativada\", não haverá coleta de dados anônimos inseridos no URL.\n\nSe ela for deixada sem definição, o usuário poderá mudar a configuração manualmente.\n\nNo quiosque do Google Chrome OS, esta política não oferece a opção \"Permitir que o usuário decida\". Se esta política não for definida para o quiosque do Google Chrome OS, a coleta de dados anônimos inseridos no URL vai estar sempre ativa.\nQuando definida para o quiosque do Google Chrome OS, esta política ativa a coleta de métricas inseridas por URL para aplicativos de quiosque.";
UserDataDir.pfm_title = "Definir diretório de dados do usuário";
UserDataDir.pfm_description = "Configura o diretório que o Brave usará para armazenar dados do usuário.\n\nSe você definir esta política, o Brave usará o diretório fornecido independentemente de o usuário ter ou não especificado a sinalização \"--user-data-dir'\". Para evitar perda de dados ou outros erros inesperados, não defina esta política para um diretório usado para outros propósitos, já que o Brave gerencia o conteúdo.\n\nAcesse https://support.google.com/chrome/a?p=Supported_directory_variables para ver uma lista das variáveis que podem ser usadas.\n\nSe esta política for deixada sem definição, o caminho padrão do perfil será usado, e o usuário poderá substituí-lo pela flag de linha de comando \"--user-data-dir\".";
UserDataSnapshotRetentionLimit.pfm_title = "Limita o número de snapshots de dados do usuário retidos para uso em caso de reversão de emergência.";
UserDataSnapshotRetentionLimit.pfm_description = "Depois de cada atualização importante de versão, o Chrome criará um snapshot de certas partes dos dados de navegação do usuário para uso em caso de reversão de emergência da versão. Se uma reversão de emergência for feita para uma versão da qual o usuário tem um snapshot correspondente, os dados serão restaurados. Isso permite que o usuário retenha essas configurações na forma de favoritos e dados de preenchimento automático.\n\nSe essa política não for definida, o valor padrão 3 será usado.\n\nSe a política for definida, snapshots antigos serão excluídos conforme necessário para respeitar o limite. Se a política for definida como 0, nenhum snapshot será criado.";
UserFeedbackAllowed.pfm_title = "Permitir feedback do usuário";
UserFeedbackAllowed.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, os usuários poderão enviar feedback ao Google em \"Menu > Ajuda > Informar um problema\" ou usando uma combinação de teclas.\n\nSe a política for definida como \"Desativada\", os usuários não poderão enviar feedback ao Google.";
VideoCaptureAllowed.pfm_title = "Permitir ou negar captura de vídeo";
VideoCaptureAllowed.pfm_description = "Se a política for definida como ativada ou não for definida, o usuário receberá uma solicitação para autorizar a captura de vídeo, exceto para URLs configurados na lista VideoCaptureAllowedUrls.\n\nSe a política for definida como desativada, as solicitações serão desativadas e a captura de vídeo só estará disponível para URLs configurados na lista VideoCaptureAllowedUrls.\n\nObservação: a política afeta todas as entradas de vídeo, não apenas a câmera integrada.";
VideoCaptureAllowedUrls.pfm_title = "URLs que terão acesso a dispositivos de captura de vídeo sem solicitação";
VideoCaptureAllowedUrls.pfm_description = "Se a política for definida, você vai especificar a lista de URLs com padrões que correspondam à origem de segurança do URL solicitante. Quando houver correspondência de padrão, o acesso a dispositivos de captura de vídeo será permitido sem uma solicitação.\n\nPara saber mais sobre os padrões de url válidos, acesse https://chromeenterprise.google/policies/url-patterns/. No entanto, o padrão \"*\", que corresponde a qualquer URL, não é compatível com esta política.";
VoiceTypingSettings.pfm_title = "Configurações do recurso de digitação por voz";
VoiceTypingSettings.pfm_description = "0 - Permitir o recurso de digitação por voz.\n1 - Permitir o recurso de digitação por voz sem coleta de dados.\n2 - Não permitir o recurso de digitação por voz.\nA digitação por voz é um recurso baseado em IA que permite aos usuários inserir e editar textos usando a voz. Ela usa modelos de IA generativa para oferecer transcrição e formatação de alta qualidade.\n\nSe ela for definida como 0, o recurso será habilitado e os dados relevantes poderão ser usados pelo Google para melhorar os modelos de IA. Esses dados podem incluir comandos, entradas, saídas, materiais de origem e feedback por escrito, dependendo do recurso. Eles também podem ser analisados por humanos para melhorar os modelos de IA. O valor padrão é 0, exceto quando indicado de outra forma abaixo.\n\nSe a política for definida como 1, o recurso será habilitado, mas o Google não poderá usar o conteúdo dos usuários (incluindo comandos, entradas, saídas, materiais de origem e feedback por escrito) para melhorar os modelos. 1 é o valor padrão para usuários corporativos gerenciados pelo Google Admin console e contas de ensino gerenciadas pelo Google Workspace.\n\nSe ela for definida como 2, o recurso não será habilitado.\n\nSe for deixada sem definição, o comportamento será determinado pela política GenAiDefaultSettings.\n\nPara mais informações sobre o tratamento de dados dos recursos de IA generativa, consulte https://support.google.com/chrome/a?p=generative_ai_settings.";
WPADQuickCheckEnabled.pfm_title = "Ativar otimização WPAD";
WPADQuickCheckEnabled.pfm_description = "Se a política for definida como \"Ativada\" ou não for definida, a otimização da descoberta automática de proxies da Web (WPAD, na sigla em inglês) será ativada no Brave.\n\nSe a política for definida como \"Desativada\", a otimização da WPAD será desativada e o Brave precisará esperar mais por servidores de WPAD baseados em DNS.\n\nEm qualquer um dos casos, não será possível mudar a configuração de otimização da WPAD.";
WarnBeforeQuittingEnabled.pfm_title = "Mostrar uma caixa de diálogo de alerta quando o usuário tentar sair";
WarnBeforeQuittingEnabled.pfm_description = "Controla a caixa de diálogo \"Avisar antes de sair (⌘Q)\" quando o usuário tenta sair do navegador.\n\nSe a política for ativada ou for deixada sem definição, uma caixa de diálogo de alerta será aberta quando o usuário tentar sair.\n\nSe ela for desativada, uma caixa de diálogo não será aberta quando o usuário tenta sair.";
WebAppInstallByUserEnabled.pfm_title = "Permitir instalação de apps da web pelo navegador";
WebAppInstallByUserEnabled.pfm_description = "Esta política controla se os usuários podem instalar apps da web pelo navegador.\nSe ela for ativada ou não for configurada, os usuários poderão instalar apps da web pelo navegador.\nSe ela for desativada, não vai permitir que os usuários instalem apps da web, e o tipo de dado \"Apps\" será excluído da sincronização para o Chrome Sync.\nA política não tem atualização dinâmica. Qualquer alteração, seja para ativar, desativar ou não definir a política só vai entrar em vigor depois que o navegador for reiniciado.\nEsta política não afeta a \"WebAppInstallForceList\".";
WebAppInstallForceList.pfm_title = "URLs para apps da Web serem instalados silenciosamente.";
WebAppInstallForceList.pfm_description = "A definição da política especifica uma lista de apps da Web com instalação silenciosa (sem interação do usuário) e que não podem ser desinstalados nem desativados.\n\nCada item da lista da política é um objeto com um elemento obrigatório:\nurl, que é o URL do app da Web que será instalado.\n\nAlém de seis elementos opcionais:\n- default_launch_container,\npara a maneira como o app da Web é aberto (o padrão é uma nova guia).\n\n- create_desktop_shortcut,\ncom valor \"verdadeiro\" se você quiser criar atalhos na área de trabalho do Linux e do\nMicrosoft® Windows®.\n\n- fallback_app_name\n(da versão 90 em diante do Brave)\npermite substituir o nome do app se ele não for um\nApp Web Progressivo (PWA) ou o nome do app instalado\ntemporariamente se ele for um PWA, mas a autenticação for exigida antes de\nconcluir a instalação. Se um\ncustom_name e um\nfallback_app_name forem fornecidos,\no segundo será ignorado.\n\n- custom_name\n(da versão 99 em diante do Google Chrome OS\ne da versão 112 em todos os outros sistemas operacionais de computador) permite substituir\npermanentemente os nomes de todos os apps da Web e PWAs.\n\n- custom_icon\n(da versão 99 em diante do Google Chrome OS\ne da versão 112 em todos os outros sistemas operacionais de computador) permite\nsubstituir o ícone dos apps instalados. Os ícones precisam ser quadrados,\nter no máximo 1 MB e estar em um destes formatos: jpeg, png, gif, webp, ico.\nO valor de hash precisa ser o hash SHA256 do arquivo de ícone. O url\nprecisa ser acessível sem autenticação para garantir que o ícone possa ser usado\nna instalação do app.\n\n- install_as_shortcut\n(da versão 107 em diante\ndo Brave). Se ativado, o url\nfornecido será instalado como um atalho, como se fosse feito pela opção \"Criar atalho…\"\nna GUI do navegador para computador.\nObserve que, quando instalado como um atalho, ele não será atualizado se o\nmanifesto no url mudar.\nSe desativado ou não configurado, o app da Web no\nurl especificado será instalado normalmente.\n\nConsulte a política PinnedLauncherApps para fixar apps na estante do Google Chrome OS.\nConsulte https://chromeenterprise.google/policies/?policy=WebAppInstallForceList para ver mais informações sobre esquema e formatação.";
WebAppSettings.pfm_title = "Configurações de gerenciamento de apps da Web";
WebAppSettings.pfm_description = "Esta política permite que um administrador especifique configurações para apps da Web instalados. Ela mapeia um ID de app da Web para a própria configuração específica. É possível usar o ID especial * para definir uma configuração padrão, que será aplicada a todos os apps da Web que não tiverem uma configuração personalizada definida nesta política.\n\nO campo manifest_id é o ID do manifesto do app da Web. Consulte https://developer.chrome.com/blog/pwa-manifest-id/ para conferir instruções de como determinar esse ID para um app da Web instalado.\nO campo run_on_os_login especifica se um app da Web pode ser executado durante o Login do SO. Se ele for definido como blocked, o app da Web não será executado durante o Login do SO e o usuário não poderá ativar essa opção mais tarde. Se ele for definido como run_windowed, o app da Web será executado durante o Login do SO e o usuário não poderá desativar essa opção mais tarde. Se ele for definido como allowed, o usuário poderá configurar o app da Web para ser executado no Login do SO. A configuração padrão permite apenas os valores allowed e blocked.\nNa versão 117 e mais recentes, o campo prevent_close_after_run_on_os_login especifica se o fechamento de um app da Web será impedido de alguma forma (por exemplo, pelo usuário, pelo gerenciador de tarefas ou por APIs da Web). Esse comportamento só poderá ser ativado se run_on_os_login for definido como run_windowed. Se o app já estava em execução, essa propriedade só terá efeito após a reinicialização dele. Se esse campo não for definido, os apps poderão ser fechados pelos usuários.\nA partir versão 118, o campo force_unregister_os_integration especifica se toda a integração do SO com um app da Web será removida ou não. Isso inclui atalhos, gerenciadores de arquivos, gerenciadores de protocolo, entre outros. Se um app já estiver em execução, essa propriedade vai entrar em vigor após a reinicialização dele. É importante cuidado, já que fazer isso pode substituir qualquer integração do SO definida automaticamente durante a inicialização do sistema de aplicativos da Web. No momento, esta política funciona apenas nas plataformas Windows, Mac e Linux.\nConsulte https://chromeenterprise.google/policies/?policy=WebAppSettings para ver mais informações sobre esquema e formatação.";
WebAudioOutputBufferingEnabled.pfm_title = "Ativar o armazenamento em buffer adaptável para a API Web Audio";
WebAudioOutputBufferingEnabled.pfm_description = "Esta política controla se o navegador usa o armazenamento em buffer adaptável para a API\nWeb Audio, o que pode diminuir as falhas de áudio, mas também aumentar a latência em uma quantidade variável.\n\nSe a política for ativada, o armazenamento em buffer adaptável será usado sempre.\n\nSe for desativada ou deixada sem definição, o processo de inicialização do navegador\nvai decidir se o armazenamento em buffer adaptável será usado.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "Origens permitidas para solicitações de WebAuthn transmitidas por proxy de aplicativos de área de trabalho remota.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "Uma lista de origens de apps cliente de Área de Trabalho remota que podem executar solicitações de API WebAuthn originadas de uma sessão de navegação em um host remoto.\n\nQualquer origem configurada nesta política pode fazer solicitações WebAuthn para IDs de terceiros confiáveis (RP IDs) que normalmente não seriam permitidos.\n\nSomente origens HTTPS válidas são permitidas. Caracteres curinga não são aceitos.\nAs entradas inválidas são ignoradas.\n\nEsta política se aplica apenas a usuários afiliados.";
WebHidAllowAllDevicesForUrls.pfm_title = "Permitir automaticamente que os sites se conectem a qualquer dispositivo HID.";
WebHidAllowAllDevicesForUrls.pfm_description = "Se a política for definida, você vai poder listar sites com permissão automática para acessar todos os dispositivos disponíveis.\n\nOs URLs precisam ser válidos. Caso contrário, a política será ignorada. Apenas a origem (esquema, host e porta) do URL é considerada.\n\nNo ChromeOS, esta política se aplica apenas a usuários afiliados.\n\nEsta política substitui DefaultWebHidGuardSetting, WebHidAskForUrls, WebHidBlockedForUrls e as preferências do usuário.";
WebHidAllowDevicesForUrls.pfm_title = "Conceder automaticamente permissão a esses sites para se conectarem a dispositivos HID com determinados IDs de fornecedores e de produtos.";
WebHidAllowDevicesForUrls.pfm_description = "Se a política for definida, será possível criar uma lista de URLs que especificam quais sites recebem permissão automaticamente para acessar um dispositivo HID com os IDs de produto e de fornecedor especificados. Cada item na lista precisa ter os campos \"devices\" e \"urls\" para que o item seja válido. Caso contrário, ele será ignorado. Cada item em \"devices\" precisa ter um campo \"vendor_id\" e pode ter um \"product_id\". A omissão do campo \"product_id\" cria uma política válida para qualquer dispositivo com o ID de fornecedor especificado. Um item com um campo \"product_id\" e sem um \"vendor_id\" será inválido e ignorado.\n\nSe a política for deixada sem definição, a DefaultWebHidGuardSetting será aplicada, caso esteja definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nOs URLs desta política não devem entrar em conflito com os configurados pela WebHidBlockedForUrls. Se entrarem, esta política terá precedência sobre a WebHidBlockedForUrls.\nConsulte https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls para ver mais informações sobre esquema e formatação.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "Conceder automaticamente permissão a esses sites para se conectarem a dispositivos HID que contêm uma coleção de nível mais alto com o uso de um HID especificado.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "Se a política for definida, será possível criar uma lista de URLs que especifica quais sites recebem permissão automaticamente para acessar um dispositivo HID que contém uma coleção de nível mais alto com o uso de um HID especificado. Cada item na lista precisa ter os campos \"usages\" e \"urls\" para que a política seja válida. Cada item em \"usages\" precisa ter um campo \"usage_page\" e pode ter um \"usage\". A omissão de \"usage\" cria uma política válida para qualquer dispositivo que contém uma coleção de nível mais alto com a página de uso especificada. Um item com um campo \"usage\" e sem um \"usage_page\" será inválido e ignorado.\n\nSe a política for deixada sem definição, a DefaultWebHidGuardSetting será aplicada, caso esteja definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nOs URLs desta política não devem entrar em conflito com os configurados pela WebHidBlockedForUrls. Se entrarem, esta política terá precedência sobre a WebHidBlockedForUrls.\nConsulte https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls para ver mais informações sobre esquema e formatação.";
WebHidAskForUrls.pfm_title = "Autorizar o uso da API WebHID nestes sites";
WebHidAskForUrls.pfm_description = "Se a política for definida, é possível configurar uma lista de padrões de URL que especifica quais sites podem pedir que o usuário conceda permissão de acesso ao dispositivo HID.\n\nSe a política não tiver definição, DefaultWebHidGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, as configurações pessoais dos usuários serão aplicadas.\n\nNo caso de padrões de URL que não correspondem à política, os padrões abaixo têm precedência, nesta ordem:\n\n  * WebHidBlockedForUrls (se houver correspondência),\n\n  * DefaultWebHidGuardSetting (se definida), ou\n\n  * configurações pessoais do usuário.\n\nOs padrões de URL não podem entrar em conflito com WebHidBlockedForUrls. Nenhuma política terá precedência se um URL tiver correspondência com ambas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
WebHidBlockedForUrls.pfm_title = "Bloquear a API WebHID nesses sites";
WebHidBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica quais sites não podem pedir que o usuário conceda permissão de acesso ao dispositivo HID.\n\nSe a política não tiver definição, DefaultWebHidGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, as configurações pessoais dos usuários serão aplicadas.\n\nNo caso de padrões de URL que não correspondem à política, os padrões abaixo têm precedência, nesta ordem:\n\n  * WebHidAskForUrls (se houver correspondência),\n\n  * DefaultWebHidGuardSetting (se definida), ou\n\n  * configurações pessoais do usuário.\n\nOs padrões de URL não podem entrar em conflito com WebHidAskForUrls. Nenhuma política terá precedência se um URL tiver correspondência com ambas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "Ativar a coleta de registros de diagnóstico do WebRTC para origens específicas";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "Esta política permite ativar a coleta de registros de diagnóstico do WebRTC para origens específicas.\n\nPara saber mais sobre padrões de entrada válidos, consulte https://chromeenterprise.google/policies/url-patterns. Não é possível usar * com esta política. Ela só considera as origens, por isso os caminhos no padrão do URL são ignorados. Esquemas e subdomínios podem ser usados.\n\nAplicar esta política ativa a coleta dos registros de diagnóstico para origens correspondentes aos padrões na lista.\n\nNão aplicar esta política mantém a coleta dos registros de diagnóstico desativada por padrão.";
WebRtcEventLogCollectionAllowed.pfm_title = "Permite a coleta de logs de eventos WebRTC dos serviços do Google";
WebRtcEventLogCollectionAllowed.pfm_description = "Se a política for definida como \"Ativada\", o Brave poderá coletar logs de eventos WebRTC em Serviços do Google (por exemplo, no Hangouts Meet) e fazer upload deles para o Google. Esses registros contêm informações de diagnóstico que são úteis para depurar problemas com chamadas de áudio ou videochamadas no Brave, como o horário e o tamanho de pacotes RTP, feedback sobre congestionamento na rede e metadados sobre o tempo e a qualidade de frames de áudio e vídeo. Esses registros não têm conteúdo de áudio ou vídeo da chamada. Com um código de sessão, o Google pode associar esses registros a outros coletados pelo próprio serviço do Google. Isso é feito para facilitar a depuração.\n\nSe a política for definida como \"Desativada\", não haverá coleta ou envio dos registros.\n\nSe a política não for definida em versões até a M76, o Brave terá como padrão não coletar esses registros nem fazer upload deles. A partir da versão M77, o Brave terá como padrão coletar os registros e fazer upload deles da maioria dos perfis afetados por políticas de empresas no nível de usuário baseadas em nuvem. A partir da versão M77 até a M80, o Brave também pode coletar esses registros e, por padrão, fazer upload deles tomando perfis afetados pelo gerenciamento local do Brave como base.";
WebRtcIPHandling.pfm_title = "Processamento de IPs do WebRTC";
WebRtcIPHandling.pfm_description = "default - O WebRTC usará todas as interfaces disponíveis ao procurar o melhor caminho.\ndefault_public_and_private_interfaces - O WebRTC usará apenas a interface conectada à Internet pública, mas poderá se conectar usando endereços IP particulares.\ndefault_public_interface_only - O WebRTC usará apenas a interface conectada à Internet pública e não se conectará usando endereços IP particulares.\ndisable_non_proxied_udp - O WebRTC usará o TCP na interface pública e usará o UDP apenas se ele for compatível com um proxy configurado.\nEsta política permite restringir as interfaces e os endereços IP usados pelo WebRTC ao tentar encontrar a melhor conexão disponível.\n\nValores válidos:\n\n* default: o WebRTC usa todas as interfaces de rede disponíveis.\n\n* default_public_and_private_interfaces: o WebRTC usa todas as interfaces públicas e privadas.\n\n* default_public_interface_only: o WebRTC usa todas as interfaces públicas, mas não as privadas.\n\n* disable_non_proxied_udp: o WebRTC usa o proxy SOCKS em UDP ou o proxy TCP.\n\nSe a política não for definida, o WebRTC usará todas as interfaces de rede disponíveis como padrão.\n\nConsulte a seção 5.2 do RFC 8828 (https://tools.ietf.org/html/rfc8828.html#section-5.2, link em inglês) para ver uma descrição detalhada de todos os valores de processamento.";
WebRtcIPHandlingUrl.pfm_title = "Processamento de IPs do WebRTC por URL";
WebRtcIPHandlingUrl.pfm_description = "Esta política permite restringir as interfaces e os endereços IP usados pelo WebRTC ao tentar encontrar a melhor conexão disponível para cada padrão de URL específico.\n\nEla aceita uma lista de padrões de URL e pares de tipos de processamento. Os padrões de URL são verificados em ordem. A primeira correspondência configura qual processamento é usado pelo WebRTC para o domínio. Quando o URL do documento atual não corresponde a nenhuma entrada, ele usa a configuração definida pela política WebRtcIPHandling.\n\nPara saber mais sobre padrões de entrada válidos, consulte https://chromeenterprise.google/policies/url-patterns/. Caracteres curinga (*) são permitidos. A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.\n\nValores de processamento válidos:\n\n* default: o WebRTC usa todas as interfaces de rede.\n\n* default_public_and_private_interfaces: o WebRTC usa todas as interfaces públicas e privadas.\n\n* default_public_interface_only: o WebRTC usa todas as interfaces públicas, mas não as privadas.\n\n* disable_non_proxied_udp: o WebRTC usa o proxy SOCKS em UDP ou o proxy TCP.\n\nConsulte a seção 5.2 do RFC 8828 (https://tools.ietf.org/html/rfc8828.html#section-5.2, link em inglês) para ver uma descrição detalhada de todos os valores de processamento.\nConsulte https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl para ver mais informações sobre esquema e formatação.";
WebRtcLocalIpsAllowedUrls.pfm_title = "URLs para os quais IPs locais são expostos em candidatos ICE do WebRTC";
WebRtcLocalIpsAllowedUrls.pfm_description = "Os padrões desta lista serão comparados com a origem de segurança do URL solicitante.\nSe uma correspondência for encontrada ou a opção chrome://flags/#enable-webrtc-hide-local-ips-with-mdns estiver desativada, os endereços IP locais serão mostrados nos candidatos ICE do WebRTC.\nCaso contrário, os endereços IP locais serão ocultos com os nomes de host de mDNS.\nObserve que, se exigida pelos administradores, esta política enfraquece a proteção dos IPs locais.";
WebRtcPostQuantumKeyAgreement.pfm_title = "Ativar o contrato de chave pós-quântica para o WebRTC";
WebRtcPostQuantumKeyAgreement.pfm_description = "Esta política permite controlar o contrato de chave pós-quântica para o WebRTC.\n\nSe esta política for definida como ativada, o contrato de chave pós-quântica será oferecido para\nWebRTC.\n\nSe esta política for definida como desativada, o contrato de chave pós-quântica não será oferecido\npara o WebRTC.\n\nSe a política não for definida, o valor será definido pelo processo de lançamento padrão\npara o contrato de chave pós-quântica oferecido para o WebRTC.\n\nA oferta de um contrato de chave pós-quântica é compatível com versões anteriores. Os servidores DTLS atuais\ne o middleware de rede devem ignorar a nova opção e\ncontinuar selecionando as opções anteriores.\n\nNo entanto, os dispositivos que não implementam corretamente a DTLS talvez não funcionem direito\nquando a nova opção for oferecida. Por exemplo, talvez eles se desconectem em resposta a opções não reconhecidas ou mensagens maiores resultantes. Esses dispositivos não estão prontos para o estágio pós-quântico e interferem na transição pós-quântica da empresa. Os administradores precisam entrar em contato com o fornecedor para que seja feita uma correção caso encontrem esse problema.\n\nEsta política é uma medida temporária e será removida após alguns marcos.";
WebRtcTextLogCollectionAllowed.pfm_title = "Permitir a coleta de registros de textos WebRTC nos Serviços do Google";
WebRtcTextLogCollectionAllowed.pfm_description = "Se a política é definida como ativada, o Brave pode coletar registros de textos WebRTC em Serviços do Google (por exemplo, no Google Meet) e fazer upload deles para o Google. Esses registros contêm informações de diagnóstico para depurar problemas em videochamadas de áudio ou vídeo no Brave, por exemplo, metadados textuais que descrevem streams de entrada e saída, entradas de registro específicas do WebRTC e informações adicionais do sistema. Esses registros não têm conteúdo de áudio ou vídeo da chamada.\nSe a política é definida como desativada, esses registros não são enviados ao Google. Os registros ainda se acumulam localmente no dispositivo do usuário.\nSe a política é deixada sem definição, o Brave pode coletar e fazer upload desses registros por padrão.";
WebRtcUdpPortRange.pfm_title = "Restringir o alcance das portas UDP locais usadas por WebRTC";
WebRtcUdpPortRange.pfm_description = "Se a política for configurada, o alcance da porta UDP usado por WebRTC será restrito ao intervalo de porta especificado (endpoints inclusos).\n\nSe a política não for configurada ou for definida para a string em branco ou um alcance de porta inválido, o WebRTC terá permissão para usar qualquer porta UDP local disponível.";
WebUsbAllowDevicesForUrls.pfm_title = "Conceder automaticamente permissão a esses sites para se conectarem a dispositivos USB com determinados IDs de fornecedores e produtos.";
WebUsbAllowDevicesForUrls.pfm_description = "Se a política for definida, será possível criar uma lista de padrões de URL que especifica quais sites recebem permissão automaticamente para acessar um dispositivo USB com os IDs de produto e fornecedor especificados. Cada item na lista precisa ter os campos \"devices\" e \"urls\" para que a política seja válida. Cada item no campo \"devices\" pode ter um campo \"vendor_id\" e \"product_id\". A omissão de \"vendor_id\" criará uma política válida para qualquer dispositivo. A omissão de \"product_id\" criará uma política válida para qualquer dispositivo com o ID de fornecedor especificado. Uma política com um campo \"product_id\" que não tiver um campo \"vendor_id\" será inválida.\n\nO modelo de permissões de USB autorizará o URL especificado a acessar o dispositivo USB como uma origem de nível superior. Se os frames incorporados precisarem acessar dispositivos USB, o cabeçalho \"usb\" de feature-policy será usado para conceder o acesso. O URL precisa ser válido. Caso contrário, a política será ignorada.\n\nO modelo de permissões de USB usado para especificar os URLs de solicitação e incorporação foi descontinuado e tem suporte apenas a versões anteriores, mas com esta limitação: se os dois tipos de URL forem especificados ao mesmo tempo, o de incorporação vai receber a permissão como origem de alto nível e o de solicitação será totalmente ignorado.\n\nEsta política substitui DefaultWebUsbGuardSetting, WebUsbAskForUrls, WebUsbBlockedForUrls e as preferências do usuário.\n\nEla afeta apenas o acesso aos dispositivos USB pela API WebUSB. Para conceder acesso a dispositivos USB pela API Web Serial, consulte a política SerialAllowUsbDevicesForUrls.\nConsulte https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls para ver mais informações sobre esquema e formatação.";
WebUsbAskForUrls.pfm_title = "Permitir WebUSB nesses sites";
WebUsbAskForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica quais sites podem pedir que o usuário permita o acesso a um dispositivo USB.\n\nSe a política não tiver definição, DefaultWebUsbGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, as configurações pessoais dos usuários serão aplicadas.\n\nOs padrões de URL não podem entrar em conflito com WebUsbAskForUrls. Nenhuma política terá precedência se um URL tiver correspondência com ambas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
WebUsbBlockedForUrls.pfm_title = "Bloquear o WebUSB nesses sites";
WebUsbBlockedForUrls.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que especifica quais sites não podem pedir que o usuário permita o acesso a um dispositivo USB.\n\nSe a política não tiver definição, DefaultWebUsbGuardSetting será aplicada a todos os sites, se estiver definida. Caso contrário, a configuração pessoal do usuário será aplicada.\n\nOs padrões de URL não podem entrar em conflito com WebUsbAskForUrls. Nenhuma política terá precedência se um URL tiver correspondência com ambas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns. * não é um valor aceitável para esta política.";
WindowCaptureAllowedByOrigins.pfm_title = "Permitir captura de janela e guia por estas origens";
WindowCaptureAllowedByOrigins.pfm_description = "Se a política for definida, será possível configurar uma lista de padrões de URL que podem usar a captura de janela e de guia.\n\nSe ela for deixada sem definição, os sites não serão considerados para uma substituição nesse nível da captura.\n\nEsta política não será considerada caso um site corresponda a um padrão de URL nas políticas TabCaptureAllowedByOrigins ou SameOriginTabCaptureAllowedByOrigins.\n\nSe um site corresponder a um padrão de URL nesta política, ScreenCaptureAllowedByOrigins e ScreenCaptureAllowed não serão consideradas.\n\nPara saber mais sobre padrões de url válidos, consulte https://chromeenterprise.google/policies/url-patterns/.  A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.";
WindowManagementAllowedForUrls.pfm_title = "Permitir o gerenciamento de janelas nesses sites";
WindowManagementAllowedForUrls.pfm_description = "Permite definir uma lista de padrões de URL que especificam os sites que vão conceder automaticamente a permissão de gerenciamento de janelas. Isso vai ampliar a capacidade dos sites de acessar informações sobre as telas do dispositivo e de usar essas informações para abrir e posicionar janelas ou solicitar a tela cheia em casos específicos.\n\nPara saber mais sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos. A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.\n\nSe esta política for deixada sem definição para um site, a política de DefaultWindowManagementSetting será aplicada, quando configurada. Caso contrário, a permissão vai seguir os padrões do navegador e autorizar a escolha dos usuários para cada site.\n\nIsso substitui a política WindowPlacementAllowedForUrls descontinuada.";
WindowManagementBlockedForUrls.pfm_title = "Bloquear a permissão para gerenciamento de janelas nesses sites";
WindowManagementBlockedForUrls.pfm_description = "Permite definir uma lista de padrões de URL que especificam os sites que vão negar automaticamente a permissão para gerenciamento de janelas. Isso vai limitar a capacidade dos sites de acessar informações sobre as telas do dispositivo e de usar essas informações para abrir e posicionar janelas ou solicitar a tela cheia em casos específicos.\n\nPara saber mais sobre padrões de URL válidos, consulte https://chromeenterprise.google/policies/url-patterns. Caracteres curinga (*) são permitidos. A política só faz a correspondência de origens, então os caminhos no padrão do URL serão ignorados.\n\nSe esta política for deixada sem definição para um site, a política de DefaultWindowManagementSetting será aplicada, quando configurada. Caso contrário, a permissão vai seguir os padrões do navegador e autorizar a escolha dos usuários para cada site.\n\nIsso substitui a política WindowPlacementBlockedForUrls descontinuada.";
XSLTEnabled.pfm_title = "Controlar a disponibilidade do recurso XSLT";
XSLTEnabled.pfm_description = "Política que controla a disponibilidade do recurso XSLT (a API JavaScript XSLTProcessor e a instrução de processamento XSL).\nQuando ela é ativada, o XSLT fica disponível, mesmo que esteja desativado por padrão no navegador.\nQuando ela é desativada, o XSLT fica indisponível, mesmo que esteja ativado por padrão no navegador.\nSe a política não for configurada, a disponibilidade do XSLT será definida pelas configurações padrão do navegador e pelos testes de campo.\nEsta política é uma medida temporária e será removida na versão M176.";