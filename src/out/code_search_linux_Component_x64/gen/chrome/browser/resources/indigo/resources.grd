<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/indigo_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/indigo_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/indigo_resources_map.h"
            type="resource_map_header" />
    <output filename="indigo_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_INDIGO_INDEX_HTML" file="${root_gen_dir}/chrome/browser/resources/indigo/preprocessed/index.html" resource_path="indigo/index.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_MANIFEST_JSON" file="${root_gen_dir}/chrome/browser/resources/indigo/preprocessed/manifest.json" resource_path="indigo/manifest.json" use_base_dir="false" type="BINDATA" />
      <include name="IDR_INDIGO_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/app.html.js" resource_path="indigo/app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_APP_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/app.js" resource_path="indigo/app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_MOTION_OVERLAY_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/motion_overlay.html.js" resource_path="indigo/motion_overlay.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_MOTION_OVERLAY_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/motion_overlay.js" resource_path="indigo/motion_overlay.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_SWEEP_MASK_WORKLET_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/sweep_mask_worklet.js" resource_path="indigo/sweep_mask_worklet.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_TEXT_OVERLAY_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/text_overlay.html.js" resource_path="indigo/text_overlay.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_TEXT_OVERLAY_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/text_overlay.js" resource_path="indigo/text_overlay.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/app.css.js" resource_path="indigo/app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_MOTION_OVERLAY_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/motion_overlay.css.js" resource_path="indigo/motion_overlay.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_INDIGO_TEXT_OVERLAY_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/indigo/minified/text_overlay.css.js" resource_path="indigo/text_overlay.css.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
