/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Preferencias de Brave";
AIModeSettings.pfm_title = "Configuración de las integraciones del Modo IA de Google en la barra de direcciones y el cuadro de búsqueda de la página Nueva pestaña.";
AIModeSettings.pfm_description = "0 - Permitir las integraciones del Modo IA.\n1 - No permitir integraciones del Modo IA.\nEsta política controla las integraciones del Modo IA de Google en la barra de direcciones y el cuadro de búsqueda de la página Nueva pestaña.\n\nPara acceder a esta función, Google debe establecerse como el motor de búsqueda predeterminado del usuario.\n\n0 = La función estará disponible para los usuarios.\n\n1 = La función no estará disponible para los usuarios.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.";
AbusiveExperienceInterventionEnforce.pfm_title = "Intervención ante experiencias abusivas";
AbusiveExperienceInterventionEnforce.pfm_description = "Si no se inhabilita SafeBrowsingEnabled, habilitar la política AbusiveExperienceInterventionEnforce o no establecerla impide que los sitios que brindan experiencias abusivas abran ventanas o pestañas nuevas.\n\nSi inhabilitas SafeBrowsingEnabled o AbusiveExperienceInterventionEnforce, los sitios que brindan experiencias abusivas podrán abrir ventanas o pestañas nuevas.";
AccessCodeCastDeviceDuration.pfm_title = "Especificar el tiempo (en segundos) que un dispositivo de transmisión seleccionado con un código QR o de acceso permanece en la lista de dispositivos de transmisión del menú de Google Cast";
AccessCodeCastDeviceDuration.pfm_description = "Esta política especifica cuánto tiempo (en segundos) se puede ver un dispositivo de transmisión seleccionado anteriormente con un código QR o de acceso entre los dispositivos de transmisión en el menú de Google Cast.\nLa vigencia de una entrada comienza en el momento en el que se ingresa el código de acceso o se escanea el código QR.\nDurante este período, el dispositivo de transmisión aparecerá en la lista de dispositivos de transmisión del menú de Google Cast.\nAl finalizar el período, para volver a usar el dispositivo de transmisión, se deberá volver a ingresar el código de acceso o volver a escanear el código QR.\nDe forma predeterminada, el período es cero segundos, por lo que los dispositivos de transmisión no permanecerán en el menú de Google Cast. Por lo tanto, deberá volver a ingresarse el código de acceso o volver a escanearse el código QR para iniciar una nueva sesión de transmisión.\nTen en cuenta que esta política solo afecta el tiempo de permanencia de los dispositivos de transmisión en el menú de Google Cast. Por el contrario, no tiene ningún efecto en las sesiones de transmisión en curso, las cuales continuarán incluso si finaliza el período.\nEsta política no tiene ningún efecto a menos que esté habilitada la política AccessCodeCastEnabled.";
AccessCodeCastEnabled.pfm_title = "Permitir que los usuarios seleccionen dispositivos de transmisión con un código QR o de acceso desde el menú de Google Cast";
AccessCodeCastEnabled.pfm_description = "Esta política controla si un usuario tiene la opción en el menú de Google Cast de transmitir contenido a dispositivos de transmisión que no aparezcan en el menú de Google Cast a través del código QR o de acceso que se muestra en la pantalla de los dispositivos de transmisión.\nDe forma predeterminada, un usuario debe volver a ingresar el código de acceso o volver a escanear el código QR para iniciar una sesión de transmisión posterior. No obstante, si estableces la política AccessCodeCastDeviceDuration en un valor que no sea cero (la opción predeterminada es cero), el dispositivo de transmisión permanecerá en la lista de dispositivos de transmisión disponibles hasta que caduque el período especificado.\nSi habilitas esta política, los usuarios podrán elegir dispositivos de transmisión mediante un código QR o de acceso.\nSi inhabilitas esta política o no la estableces, los usuarios no podrán elegir dispositivos de transmisión mediante un código QR o de acceso.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "Hacer que las coincidencias de Access-Control-Allow-Methods en la especificación de solicitud preliminar CORS sean compatibles";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Esta política controla si los métodos de solicitud están en mayúsculas cuando coinciden con los encabezados de respuesta Access-Control-Allow-Methods en la solicitud preliminar CORS.\n\nSi la inhabilitas, se usarán mayúsculas en los métodos de solicitud.\nEste es el comportamiento en Brave 108 o versiones anteriores.\n\nSi habilitas la política o no la estableces, no se usarán mayúsculas en los métodos de solicitud, a menos que no se distingan mayúsculas de minúsculas en DELETE, GET, HEAD, OPTIONS, POST oPUT.\nEsta acción rechazará el encabezado de respuesta fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" y aceptará el encabezado de respuesta fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\".\n\nNota: Los métodos de solicitud \"post\" y \"put\" no se ven afectados, mientras que \"patch\" se ve afectado.\n\nEsta política es temporal y se quitará en el futuro.";
AccessibilityImageLabelsEnabled.pfm_title = "Habilita Get Image Descriptions from Google";
AccessibilityImageLabelsEnabled.pfm_description = "La función de accesibilidad de Get Image Descriptions from Google\npermite que los usuarios de lectores de pantalla para personas con discapacidad visual\nobtengan descripciones de las imágenes sin etiquetar que aparecen en la Web. Los usuarios que habiliten esta función\npodrán usar un servicio anónimo de Google para\nobtener descripciones automáticas de las imágenes sin etiquetar que aparezcan en la Web.\n\nSi se habilita esta función, se enviará el contenido de las imágenes a los servidores de Google\npara generar una descripción. No se enviarán cookies ni otros datos\ndel usuario. Además, Google no guardará ni registrará el contenido de las imágenes.\n\nSi habilitas esta política, se activará la función de\nGet Image Descriptions from Google,\naunque solo afectará a los usuarios que usen un\nlector de pantalla o alguna otra tecnología de accesibilidad similar.\n\nSi inhabilitas la política, los usuarios no podrán activar\nla función.\n\nSi no se establece esta política, los usuarios pueden decidir usar o no la función.\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "Permitir consultas de DNS para tipos de registro DNS adicionales";
AdditionalDnsQueryTypesEnabled.pfm_description = "Esta política controla si Brave puede hacer consultas sobre los tipos de registro DNS adicionales cuando hace solicitudes de DNS no seguras. Esta política no tiene efecto en las consultas de DNS que se realizan a través del DNS seguro, el cual siempre puede hacer consultas sobre los tipos de DNS adicionales.\n\nSi no estableces esta política o la habilitas, es posible que se hagan consultas sobre los tipos adicionales como HTTPS (DNS tipo 65), además de A (DNS tipo 1) y AAAA (DNS tipo 28).\n\nSi inhabilitas esta política, solo se harán consultas sobre DNS para A (DNS tipo 1) o AAAA (DNS tipo 28).\n\nEsta política es una medida temporal y se eliminará en las futuras versiones de Brave. Después de que se elimine la política, Brave podrá seguir haciendo consultas sobre los tipos de DNS adicionales.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Configuración de anuncios para sitios con anuncios intrusivos";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Permitir anuncios en todos los sitios\n2 - No permitir anuncios en sitios con anuncios intrusivos\nSi estableces AdsSettingForIntrusiveAdsSites en 1 o no la estableces, los anuncios podrán aparecer en todos los sitios, a menos que establezcas SafeBrowsingEnabled como falsa.\n\nSi estableces la política en 2, se bloquearán los anuncios en sitios con anuncios intrusivos.";
AdvancedProtectionAllowed.pfm_title = "Habilitar protecciones adicionales para los usuarios inscritos en el Programa de Protección Avanzada";
AdvancedProtectionAllowed.pfm_description = "Esta política controla si los usuarios inscritos en el Programa de Protección Avanzada reciben protección adicional. Es posible que algunas de estas funciones compartan datos con Google (por ejemplo, los usuarios de la Protección avanzada podrán enviar sus descargas a Google para comprobar que no incluyan software malicioso). Si se establece como verdadera o no se establece, los usuarios inscritos recibirán protección adicional. Si se establece como falsa, los usuarios de la Protección avanzada solo recibirán las funciones estándar para el consumidor.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Lista de orígenes que permiten todas las autenticaciones de HTTP";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "Si estableces la política, se especificará para qué orígenes se permiten todos los esquemas de autenticación de HTTP compatibles con Brave, independientemente de la política AuthSchemes.\n\nA partir de la versión 161 de Brave, esta política se aplica solo a los orígenes del servidor de destino y no a los desafíos de autenticación del servidor proxy. Para permitir todos los esquemas de autenticación de HTTP para los servidores proxy, usa la política AllHttpAuthSchemesAllowedForProxies. Antes de la versión 161, los servidores proxy que coinciden con esta política también pueden usar todos los esquemas de autenticación HTTP, a menos que se establezca AllHttpAuthSchemesAllowedForProxies.\n\nDebes configurar el patrón de origen conforme a este formato (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Se pueden definir hasta 1,000 excepciones en AllHttpAuthSchemesAllowedForOrigins.\nSe permiten comodines para el componente de host (p. ej., \"*:8000\" coincide con todos los hosts en el puerto 8000). Para que coincidan todos los esquemas o todos los puertos, omite el componente por completo (p. ej., \"example.com\" coincide con cualquier esquema y cualquier puerto). Un nombre de host (p. ej., \"example.com\") también coincide con sus subdominios. Para que coincida exactamente con un host y excluir sus subdominios, antepón un punto (p. ej., \".example.com\"). Para que coincida con todos los orígenes, usa un solo asterisco (\"*\").";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Lista de servidores proxy que permiten todos los esquemas de autenticación de HTTP";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "Si estableces la política, se especificará para qué servidores proxy se permiten todos los esquemas de autenticación de HTTP compatibles con Brave, independientemente de la política AuthSchemes.\n\nEl patrón del servidor proxy debe tener el formato de filtro de la lista de URLs bloqueadas (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Se pueden definir hasta 1,000 excepciones.\nSe permiten comodines para el componente de host (p. ej., \"*:8080\" coincide con todos los proxies en el puerto 8080). Un nombre de host (p. ej., \"proxy.example.com\") también coincide con sus subdominios. Para que coincida exactamente con un host y excluir sus subdominios, antepón un punto (p. ej., \".proxy.example.com\").\n\nSi no se establece esta política, solo se admitirán los esquemas de autenticación HTTP especificados en AuthSchemes (o los esquemas predeterminados si no se establecen) para la autenticación de proxy.";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Permitir que las páginas con el encabezado Cache-Control: no-store ingresen a la memoria caché atrás/adelante";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Esta política controla si una página con el encabezado Cache-Control: no-store se puede almacenar en la memoria caché atrás/adelante. Es posible que el sitio web que establece este encabezado no espere que la página se restablezca desde la memoria caché atrás/adelante, ya que cierta información sensible podría seguir apareciendo después del restablecimiento, incluso si ya no se puede acceder a ella.\n\nSi habilitas la política o no la estableces, es posible que se restablezca la página con el encabezado Cache-Control: no-store de la memoria caché atrás/adelante, a menos que se active el desalojo de la caché (p. ej., cuando hay un cambio de cookies solo HTTP en el sitio).\n\nSi inhabilitas la política, la página con el encabezado Cache-Control: no-store no se almacenará en la memoria caché atrás/adelante.";
AllowCrossOriginAuthPrompt.pfm_title = "Solicitudes de autenticación HTTP de origen cruzado";
AllowCrossOriginAuthPrompt.pfm_description = "Si habilitas la política, las imágenes de terceros de una página podrán mostrar una solicitud de autenticación.\n\nSi inhabilitas la política o no la estableces, las imágenes de terceros no podrán mostrar una solicitud de autenticación.\n\nEsta política suele estar inhabilitada para ofrecer protección frente al phishing.";
AllowDeletingBrowserHistory.pfm_title = "Habilita la eliminación del historial de descargas y del navegador.";
AllowDeletingBrowserHistory.pfm_description = "Si habilitas la política o no la estableces, podrán borrarse los historiales de navegación y de descargas en Chrome, y los usuarios no podrán cambiar esta configuración.\n\nSi inhabilitas la política, no podrán borrarse los historiales de navegación ni de descargas. Incluso con la política desactivada, no se garantiza la conservación de los historiales de navegación y de descarga. Es posible que los usuarios puedan editar o borrar los archivos de la base de datos del historial directamente, y que el propio navegador pueda caducar o archivar algunos o todos los elementos del historial en cualquier momento.";
AllowDinosaurEasterEgg.pfm_title = "Permitir juego del huevo de pascua del dinosaurio";
AllowDinosaurEasterEgg.pfm_description = "Si estableces la política como verdadera, los usuarios podrán jugar al juego del dinosaurio. Si estableces la política como falsa, los usuarios no podrán jugar al juego del huevo de pascua del dinosaurio cuando el dispositivo esté sin conexión.\n\nSi no la estableces, los usuarios no podrán jugar al juego en el Google Chrome OS registrado, pero podrán hacerlo en otras circunstancias.";
AllowFileSelectionDialogs.pfm_title = "Permitir la invocación de los diálogos de selección de archivos";
AllowFileSelectionDialogs.pfm_description = "Si habilitas la política o no la estableces, Chrome podrá mostrar diálogos de selección de archivos, y los usuarios podrán abrirlos.\n\nSi inhabilitas la política, cuando los usuarios realicen acciones que generen un diálogo de selección de archivos, como importar favoritos, subir archivos o guardar vínculos, se mostrará en su lugar un mensaje. Se considerará como si el usuario hubiera hecho clic en Cancelar en el diálogo de selección de archivos.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Permitir la aleatorización del tamaño del grupo de sockets para los proxies";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "La aleatorización del tamaño del grupo de sockets es un mecanismo de seguridad que impide que los atacantes aprovechen los límites de capacidad determinísticos para obtener información entre sitios.\nSi la capacidad de un grupo es normalmente de 128 sockets, este mecanismo limita aleatoriamente el grupo entre 128 y 256.\nEsto puede permitir hasta el doble de conexiones al proxy, pero en la práctica el valor esperado es más parecido a 1.2 veces.\n\nEsto afecta la configuración de MaxConnectionsPerProxy y MaxConnectionsPerProxyForWebSocket.\nEn lugar de que estas políticas definan el límite superior, el límite superior es 2 veces sus valores (aunque, de nuevo, el valor esperado en la práctica es más bien 1.2 veces sus valores).\n\nEsta opción está habilitada de forma predeterminada para todos los grupos, pero esta política permite inhabilitar la función específicamente para los grupos de proxy.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Permitir solicitudes de autenticación web en sitios con certificados TLS rotos";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Si habilitas la política, Brave permitirá\nlas solicitudes de autenticación web en sitios web que tengan certificados TLS con\nerrores (es decir, sitios web considerados no seguros).\n\nSi inhabilitas la política o no la estableces, se aplicará\nel comportamiento predeterminado para bloquear esas solicitudes.";
AllowedDomainsForApps.pfm_title = "Definir los dominios que pueden acceder a Google Workspace";
AllowedDomainsForApps.pfm_description = "Si estableces la política, se activará la función de acceso restringido de Chrome en Google Workspace, y los usuarios no podrán cambiar esta configuración. Los usuarios solo podrán acceder a las herramientas de Google mediante cuentas de dominios específicos (para permitir cuentas de gmail o googlemail, debes agregar consumer_accounts a la lista de dominios). Esta configuración no permite que los usuarios accedan ni agreguen una cuenta secundaria en un dispositivo administrado que requiera autenticación de Google, en caso de que esa cuenta no pertenezca a uno de los dominios permitidos de forma explícita.\n\nSi dejas vacía esta configuración o no la estableces, los usuarios podrán acceder a Google Workspace con cualquier cuenta.\n\nLos usuarios no podrán cambiar ni anular esta configuración.\n\nNota: Esta política provoca que se agregue el encabezado X-GoogApps-Allowed-Domains a todas las solicitudes HTTP y HTTPS para todos los dominios google.com, como se describe en https://support.google.com/a/answer/1668854.";
AlternateErrorPagesEnabled.pfm_title = "Habilitar páginas de error alternativas";
AlternateErrorPagesEnabled.pfm_description = "Si estableces la política como verdadera, Brave utilizará páginas de error alternativas integradas en el navegador (como \"no se encontró la página\"). Si la estableces como falsa, Brave no utilizará nunca páginas de error alternativas.\n\nSi estableces la política, los usuarios no podrán cambiarla. Si no la estableces, la política estará activa, pero los usuarios podrán cambiar esta configuración.";
AlternativeBrowserParameters.pfm_title = "Parámetros de la línea de comandos para el navegador alternativo";
AlternativeBrowserParameters.pfm_description = "Si estableces esta política como una lista de cadenas, se transferirá cada string al navegador alternativo como parámetro de la línea de comandos. En Microsoft® Windows®, los parámetros están separados por espacios. En macOS y Linux®, un parámetro puede contener espacios y tratarse como un único parámetro.\n\nSi un parámetro contiene ${url}, se reemplazará ${url} por la URL de la página que se abrirá. Si ningún parámetro contiene ${url}, se agregará la URL al final de la línea de comandos.\n\nSe expanden las variables de entorno. En Microsoft® Windows®, se reemplaza %ABC% por el valor de la variable de entorno ABC. En macOS y Linux®, se reemplaza ${ABC} por el valor de la variable de entorno ABC.\n\nSi no estableces la política, se transferirá solo la URL como parámetro de la línea de comandos.";
AlternativeBrowserPath.pfm_title = "Navegador alternativo que se inicia para sitios web configurados";
AlternativeBrowserPath.pfm_description = "Si estableces la política, controlarás el comando que se utilizará para abrir las URL en un navegador alternativo. La política puede establecerse como una ruta de archivo o uno de estos valores: ${ie}, ${firefox}, ${safari}, ${opera} o ${edge}. Si la estableces como una ruta de archivo, ese archivo se usará como ejecutable. ${ie} solo está disponible en Microsoft® Windows®. ${safari} y ${edge} solo están disponibles en Microsoft® Windows® y macOS.\n\nSi no estableces la política, se utilizará la configuración predeterminada específica de la plataforma: Internet Explorer® para Microsoft® Windows® o Safari® para macOS. En Linux®, se producirá un error al intentar ejecutar un navegador alternativo.";
AlwaysOpenPdfExternally.pfm_title = "Abrir siempre archivos PDF de forma externa";
AlwaysOpenPdfExternally.pfm_description = "Si habilitas la política, se desactivará el lector de PDF interno de Brave, se tratarán los archivos PDF como descargas y los usuarios podrán abrir los archivos PDF con la aplicación predeterminada.\n\nSi inhabilitas la política, se abrirán los archivos PDF, a menos que los usuarios desactiven el complemento de PDF.\n\nSi estableces esta política, los usuarios no podrán cambiarla en Brave. Si no la estableces, los usuarios podrán elegir si desean abrir los archivos PDF de forma externa o no.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Permite la autenticación ambiental para tipos de perfiles.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Permite la autenticación ambiental solo en sesiones comunes.\n1 - Permite la autenticación ambiental en sesiones comunes y de incógnito.\n2 - Permite la autenticación ambiental en sesiones comunes y de invitado.\n3 - Permite la autenticación ambiental en sesiones comunes, de incógnito y de invitado.\nLa configuración de esta política habilitará o inhabilitará la autenticación ambiental para los perfiles de incógnito y de invitado en Brave.\n\nLa Autenticación ambiental es la autenticación por http con credenciales predeterminadas si no se proporcionan credenciales específicas mediante esquemas de desafío/respuesta de NTLM, Kerberos y Negotiate.\n\nSi estableces la opción RegularOnly (valor 0), solo se habilitará la autenticación ambiental para las sesiones comunes. No se permitirá esta autenticación en las sesiones de incógnito y de invitado.\n\nSi estableces la opción IncognitoAndRegular (valor 1), se habilitará la autenticación ambiental para las sesiones comunes y de incógnito. No se permitirá esta autenticación en las sesiones de invitado.\n\nSi estableces la opción GuestAndRegular (valor 2), se habilitará la autenticación ambiental para las sesiones comunes y de invitado. No se permitirá esta autenticación en las sesiones de incógnito.\n\nSi estableces la opción All (valor 3), se habilitará la autenticación ambiental para todas las sesiones.\n\nTen en cuenta que siempre se permite la autenticación ambiental en los perfiles comunes.\n\nEn Brave 81 y versiones posteriores, si no se establece la política, solo se habilitará la autenticación ambiental para las sesiones comunes.";
AudioCaptureAllowed.pfm_title = "Permitir o rechazar la captura de audio";
AudioCaptureAllowed.pfm_description = "Si habilitas la política o no la estableces, a excepción de las URL que se indican en la lista AudioCaptureAllowedUrls, se les solicitará a los usuarios permiso para acceder a la captura de audio.\n\nSi inhabilitas la política, se desactivarán los mensajes, y la captura de audio solo estará disponible para las URL que se establezcan en la lista AudioCaptureAllowedUrls.\n\nNota: La política afecta a todas las entradas de audio (no solo al micrófono integrado).";
AudioCaptureAllowedUrls.pfm_title = "Las URL que recibirán acceso a dispositivos de captura de audio sin solicitarlo";
AudioCaptureAllowedUrls.pfm_description = "Si estableces la política, especificarás la lista de URL cuyos patrones buscarán coincidencia con el origen de seguridad de la URL de solicitud. En caso de haber coincidencia, se otorgará acceso a los dispositivos de captura de audio sin necesidad de un mensaje.\n\nPara obtener información detallada sobre los patrones válidos de url, consulta https://chromeenterprise.google/policies/url-patterns/. Sin embargo, ten en cuenta que esta política no admite el patrón \"*\", que coincide con cualquier URL.";
AudioSandboxEnabled.pfm_title = "Permite que se ejecute la zona de pruebas de audio";
AudioSandboxEnabled.pfm_description = "Esta política controla la zona de pruebas del proceso de audio.\nSi se habilita esta política, se ejecutará el proceso de audio en la zona de pruebas.\nSi se inhabilita, se ejecutará el proceso de audio fuera de la zona de pruebas y se ejecutará el módulo de procesamiento de audio WebRTC en el proceso de renderizado.\nEsta acción deja a los usuarios desprotegidos ante los riesgos de seguridad relacionados con la ejecución de los subsistemas de audio fuera de la zona de pruebas.\nSi no se establece esta política, se utilizará la configuración predeterminada para la zona de pruebas de audio, que puede diferir según la plataforma.\nEsta política permite que las empresas inhabiliten la zona de pruebas de audio si utilizan configuraciones de software de seguridad que interfieran con la zona de pruebas.";
AuthNegotiateDelegateAllowlist.pfm_title = "Lista de servidores de delegación de Kerberos permitidos";
AuthNegotiateDelegateAllowlist.pfm_description = "Si estableces la política, se asignarán los servidores a los que Brave puede delegar. Los nombres de los servidores se separan con comas. Se permite el uso de caracteres comodín (*).\n\nSi no estableces la política, Brave no delegará credenciales de usuario, incluso si se detecta un servidor como intranet.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Usa la política de KDC para delegar credenciales.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Si habilitas esta política, la autenticación HTTP respetará la aprobación de la política de KDC, es decir, Brave delegará las credenciales de usuario para el servicio al que se accede si KDC establece OK-AS-DELEGATE en el ticket de servicio. Consulta la RFC 5896 ( https://tools.ietf.org/html/rfc5896.html ). La política AuthNegotiateDelegateAllowlist debe permitir este servicio.\n\nSi inhabilitas la política o no la estableces, se ignorará la política de KDC en las plataformas admitidas y solo se respetará la política AuthNegotiateDelegateAllowlist.\n\nEn Microsoft® Windows®, siempre se respeta la política de KDC.";
AuthSchemes.pfm_title = "Esquemas de autenticación admitidos";
AuthSchemes.pfm_description = "Si estableces la política, se especifican qué esquemas de autenticación de HTTP son compatibles con Brave.\n\nSi no la estableces, se emplean los 4 esquemas.\n\nValores válidos:\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nNota: Los valores se separan con comas.";
AuthServerAllowlist.pfm_title = "Lista de servidores de autenticación habilitados";
AuthServerAllowlist.pfm_description = "Si estableces la política, se especificarán los servidores que deben habilitarse para la autenticación integrada, la cual solo está activa cuando Brave recibe un desafío de autenticación de un proxy o de un servidor que se encuentra en la lista autorizada.\n\nSi no estableces la política, Brave intentará detectar si un servidor se encuentra en la intranet. Solo en ese caso responderá a las solicitudes de IWA. Si se detecta un servidor como Internet, Brave ignorará las solicitudes de IWA que provengan de ese servidor.\n\nNota: Los nombres de los servidores se separan con comas. Se permite el uso de caracteres comodín (*).";
AutoLaunchProtocolsFromOrigins.pfm_title = "Define una lista de protocolos que puede ejecutar una aplicación externa a partir los orígenes enumerados sin avisarle al usuario";
AutoLaunchProtocolsFromOrigins.pfm_description = "Te permite configurar una lista de protocolos y, para cada uno de ellos, una lista asociada de patrones de origen permitidos, que pueden ejecutar una aplicación externa sin pedirle permiso al usuario. No se debe agregar el separador final cuando se incluye el protocolo en la lista; por lo tanto, usa \"skype\" en lugar de \"skype:\" o \"skype://\".\n\nSi estableces esta política, un protocolo solo podrá ejecutar una aplicación externa sin pedir permiso según la política si el protocolo aparece en la lista y el origen del sitio que intenta ejecutar el protocolo coincide con uno de los patrones de origen que se encuentra en la lista allowed_origins de ese protocolo. Si no se cumple alguna de estas condiciones, la política no omitirá el pedido de permiso para la ejecución por parte del protocolo externo.\n\nSi no estableces la política, los protocolos no podrán ejecutar aplicaciones sin solicitar permiso de forma predeterminada. A menos que se inhabilite la política ExternalProtocolDialogShowAlwaysOpenCheckbox, los usuarios podrán rechazar las solicitudes de permiso según cada protocolo o sitio. Esta política no afecta a las excepciones de las solicitudes de permiso que establecen los usuarios para cada protocolo o sitio.\n\nLos patrones de coincidencia de orígenes usan un formato similar a los de la política \"URLBlocklist\", que se documentan en https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSin embargo, los patrones de coincidencia de orígenes para esta política no pueden incluir los elementos \"/path\" ni \"@query\". Se ignorará cualquier patrón que contenga alguno de estos elementos.\nConsulta https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins para obtener más información sobre el esquema y el formato.";
AutoOpenAllowedForURLs.pfm_title = "Las URL donde se puede aplicar AutoOpenFileTypes";
AutoOpenAllowedForURLs.pfm_description = "Se trata de una lista que incluye las URLs en las que se aplicará AutoOpenFileTypes. Esta política no afecta los valores abiertos automáticamente que configuran los usuarios.\n\nSi la configuras, se abrirán los archivos automáticamente solo cuando la URL forme parte de este conjunto y se incluya el tipo de archivo en AutoOpenFileTypes. Si no se cumple alguna de las dos condiciones, no se abrirá automáticamente la descarga.\n\nSi no configuras esta política, se abrirán automáticamente todas las descargas cuyo tipo de archivo se indique en AutoOpenFileTypes.\n\nEl patrón de una URL debe presentar un formato conforme a lo especificado en https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
AutoOpenFileTypes.pfm_title = "Lista de tipos de archivos que deben abrirse automáticamente cuando se descargan";
AutoOpenFileTypes.pfm_description = "Lista de los tipos de archivos que se deben abrir automáticamente cuando se descargan. Cuando se enumera el tipo de archivo, no debe incluirse el separador principal. Por lo tanto, usa \"txt\" en lugar de \".txt\".\n\nSi habilitas la Navegación segura, esta función revisará los archivos que se pueden abrir automáticamente. Si los archivos no son seguros, no se abrirán.\n\nSi no estableces esta política, solo se abrirán los tipos de archivos que el usuario haya especificado para que se abran automáticamente cuando se descarguen.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
AutoSelectCertificateForUrls.pfm_title = "Seleccionar automáticamente certificados de clientes para estos sitios";
AutoSelectCertificateForUrls.pfm_description = "Si estableces la política, podrás crear una lista de patrones de URL que especifiquen los sitios para los cuales Chrome podrá seleccionar un certificado de cliente automáticamente. El valor es un arreglo de diccionarios convertidos en strings de JSON. Cada diccionario debe tener el formato { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER }, donde $URL_PATTERN es un patrón de configuración de contenido. $FILTER restringe los certificados de cliente entre los cuales el navegador seleccionará automáticamente. Más allá del filtro, solo se seleccionarán certificados que se ajusten a la solicitud del servidor. En iOS y Android, Chrome solo puede seleccionar los certificados de cliente que aprovisionó por sí misma; no puede acceder a los certificados instalados a nivel del sistema operativo.\n\nA continuación se incluyen ejemplos de uso de la sección $FILTER:\n\n* Si estableces $FILTER en { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } }, solo se seleccionarán certificados de cliente emitidos por un certificado con el CommonName $ISSUER_CN.\n\n* Si $FILTER incluye las secciones \"ISSUER\" y \"SUBJECT\", solo se seleccionarán certificados de cliente que cumplan con ambas condiciones.\n\n* Si $FILTER incluye la sección \"SUBJECT\" con el valor \"O\", el certificado deberá contar con al menos una unidad organizacional que coincida con el valor indicado para ser elegido.\n\n* Si $FILTER incluye una sección \"SUBJECT\" con el valor \"OU\", el certificado deberá contar con al menos una unidad organizacional que coincida con el valor indicado para ser elegido.\n\n* Si estableces $FILTER como {}, no se aplicarán restricciones adicionales a la selección de certificados de cliente. Ten en cuenta que se seguirán aplicando los filtros que proporciona el servidor web.\n\nSi no estableces la política, no se implementará la selección automática para ningún sitio.\nConsulta https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls para obtener más información sobre el esquema y el formato.";
AutofillGenAiSettings.pfm_title = "Configuración de las funciones potenciadas por IA generativa en Autocompletar";
AutofillGenAiSettings.pfm_description = "0 - Permitir las funciones potenciadas por IA generativa en Autocompletar y mejorar los modelos de IA.\n1 - Permitir las funciones potenciadas por IA generativa en Autocompletar sin mejorar los modelos de IA.\n2 - No permitir las funciones potenciadas por IA generativa en Autocompletar.\nEstas funciones de Brave emplean modelos de IA generativa para ayudar a los usuarios a completar formularios en la Web. Para usar estas funciones, Brave debe recopilar datos como la estructura de los formularios con los que interactúa un usuario. Para usar la función Buscar y completar con Gemini, debe recopilar las consultas de texto libre que un usuario ingresa cuando realiza búsquedas en las apps de Gemini conectadas y enviar estos datos a un servidor de Google que ejecuta un modelo de IA generativa.\n\nSi estableces la política en 0 (Permitir las funciones potenciadas por IA generativa en Autocompletar y mejorar los modelos de IA), se podrán usar las funciones y Google podrá usar datos pertinentes para mejorar sus modelos de IA. Los datos pertinentes pueden incluir instrucciones, entradas, resultados, materiales de referencia y comentarios escritos, según la función. 0 es el valor predeterminado, excepto en los casos que se enumeran a continuación.\n\nSi estableces la política en 1 (Permitir las funciones potenciadas por IA generativa en Autocompletar sin mejorar los modelos de IA), se podrán usar las funciones, pero no se permitirá que Google mejore los modelos con el contenido de los usuarios (lo que incluye las instrucciones, las entradas, los resultados, los materiales de referencia y los comentarios escritos). 1 es el valor predeterminado para los usuarios empresariales que administra Google Admin console y las cuentas de institución educativa que administra Google Workspace.\n\nSi estableces la política en 2 (No permitir las funciones potenciadas por IA generativa en Autocompletar), no se permitirán las funciones.\n\nSi no estableces la política, su comportamiento se determinará según la política GenAiDefaultSettings.\n\nLas funciones de IA generativa en Autocompletar incluyen las siguientes:\n\n- Comprensión más inteligente de formularios: Usa la IA para identificar y clasificar los campos de un formulario, de modo que se puedan completar más.\n\n- Buscar y completar con Gemini: Busca información de las apps que un usuario conectó a Gemini y la ofrece para completar, ya sea como sugerencias proactivas en un formulario o en respuesta a una consulta que escribe el usuario.\n\nEsta política sustituye a la política AutofillPredictionSettings, que se sigue aplicando cuando no se establece esta política. La función \"Buscar y completar con Gemini\" también requiere que la política GeminiSettings no esté inhabilitada.\n\nEsta política no controla las funciones de Autocompletar que no usan IA generativa.\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
AutofillSettings.pfm_title = "Bloquear tipos de datos de Autocompletar para sitios específicos";
AutofillSettings.pfm_description = "Si estableces esta política, podrás especificar qué tipos de datos de Autocompletar se bloquean en patrones de URL específicos.\n\nLa política se estructura como una lista de diccionarios. Cada diccionario debe contener lo siguiente:\n* \"url_pattern\": Un patrón de URL de configuración de contenido para el marco principal (p. ej., \"https://[*.]example.com\").\n* \"blocked_types\": Una lista de cadenas que representan las categorías de datos de Autocompletar que se bloquearán.\n\nLos valores admitidos para \"blocked_types\" son los siguientes:\n* \"contact_info\": Bloquea el guardado y el completado de la información de contacto.\n* \"payments\": Bloquea el guardado y el completado de tarjetas de crédito y formas de pago.\n* \"identity_docs\": Bloquea el guardado y el completado de documentos de identidad (p. ej., pasaporte, licencia de conducir, documento nacional de identidad).\n* \"travel\": Bloquea el guardado y el completado de información de viajes (p. ej., reservas de vuelos, registro de vehículos).\n* \"shopping\": Bloquea el guardado y el completado de información de compras (p. ej., pedidos en línea, envíos).\n* \"all\": Bloquea el guardado y el completado de todos los tipos de datos de Autocompletar.\n\nSi se bloquea un tipo de datos para un sitio, se inhabilitan tanto la generación de sugerencias como la instrucción para guardar o importar datos nuevos de ese tipo en el sitio.\n\nSi una URL coincide con varias entradas de patrones en la lista, se combinan los tipos bloqueados de todas las entradas coincidentes (unión combinada). Se ignorarán los patrones de URL no válidos de la lista.\n\nSi no estableces esta política, no se bloqueará ningún tipo de datos de Autocompletar por dominio.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta:\nhttps://chromeenterprise.google/policies/url-patterns. Se admite el comodín *, este patrón busca coincidencias entre una URL y cualquier esquema, puerto y ruta de acceso.\nConsulta https://chromeenterprise.google/policies/?policy=AutofillSettings para obtener más información sobre el esquema y el formato.";
AutomatedPasswordChangeSettings.pfm_title = "Habilitar el cambio de contraseña automatizado";
AutomatedPasswordChangeSettings.pfm_description = "0 - Permitir el uso de la función y mejorar los modelos de IA\n1 - Permitir el uso de la función sin mejorar los modelos de IA\n2 - No permitir la función\nEsta política controla la disponibilidad de la función de cambio de contraseña automatizado de Brave.\n\nSi se habilita, un usuario puede activar un proceso en el que el navegador intenta cambiar su contraseña en un sitio web de forma automática. La IA generativa administra este proceso. La nueva contraseña se guarda en el administrador de contraseñas del navegador.\n\n0 = Permite que se use la función y que Google use datos pertinentes para mejorar sus modelos de IA. Los datos pertinentes pueden incluir instrucciones, entradas, resultados, materiales de referencia y comentarios escritos, según la función. Es posible que personas revisen los datos para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los siguientes casos.\n\n1 = Permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (lo que incluye las instrucciones, las entradas, los resultados, los materiales de referencia y los comentarios escritos). 1 es el valor predeterminado para los usuarios empresariales que administra la Consola del administrador de Google y las cuentas de institución educativa que administra Google Workspace.\n\n2 = No permite la función.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Permitir descargas automáticas en estos sitios";
AutomaticDownloadsAllowedForUrls.pfm_description = "Te permite establecer una lista de patrones de URL que especifican los sitios que pueden descargar varios archivos automáticamente.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns/.\n\nSi una URL coincide con AutomaticDownloadsAllowedForUrls y AutomaticDownloadsBlockedForUrls, tendrá prioridad AutomaticDownloadsBlockedForUrls.\n\nSi no estableces esta política, se aplicará DefaultAutomaticDownloadsSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Bloquear descargas automáticas en estos sitios";
AutomaticDownloadsBlockedForUrls.pfm_description = "Te permite establecer una lista de patrones de URL que especifican los sitios que no pueden descargar varios archivos automáticamente.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns/.\n\nSi una URL coincide con AutomaticDownloadsAllowedForUrls y AutomaticDownloadsBlockedForUrls, tendrá prioridad AutomaticDownloadsBlockedForUrls.\n\nSi no estableces esta política, se aplicará DefaultAutomaticDownloadsSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Permitir el modo de pantalla completa automático en estos sitios";
AutomaticFullscreenAllowedForUrls.pfm_description = "Por motivos de seguridad, la\nAPI web de requestFullscreen()\nrequiere que se llame a un gesto previo del usuario (\"activación transitoria\") o fallará si esto no ocurre. La configuración personal de los usuarios puede permitir que ciertos orígenes llamen\na esta API sin un gesto previo del usuario, como se describe en\nhttps://chromestatus.com/feature/6218822004768768.\n\nEsta política reemplaza la configuración personal de los usuarios y permite que los orígenes coincidentes\nllamen a la API sin un gesto previo del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta\nhttps://chromeenterprise.google/policies/url-patterns.\nSe permite el uso de caracteres comodín (*).\n\nSe bloquearán los orígenes que coincidan con los patrones de políticas bloqueados y permitidos.\nLos orígenes no especificados en la política ni en la configuración del usuario requerirán un gesto previo del usuario\npara llamar a esta API.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Bloquear la pantalla completa automática en estos sitios";
AutomaticFullscreenBlockedForUrls.pfm_description = "Por motivos de seguridad, la\nAPI web de requestFullscreen()\nrequiere que se llame a un gesto previo del usuario (\"activación transitoria\") o\nfallará si esto no ocurre. La configuración personal de los usuarios puede permitir que ciertos orígenes llamen\na esta API sin un gesto previo del usuario, como se describe en\nhttps://chromestatus.com/feature/6218822004768768.\n\nEsta política reemplaza la configuración personal de los usuarios y bloquea los orígenes coincidentes\npara que no llamen a la API sin un gesto previo del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta\nhttps://chromeenterprise.google/policies/url-patterns.\nSe permite el uso de caracteres comodín (*).\n\nSe bloquearán los orígenes que coincidan con los patrones de políticas bloqueados y permitidos.\nLos orígenes no especificados en la política ni en la configuración del usuario requerirán un gesto previo del usuario\npara llamar a esta API.";
AutoplayAllowed.pfm_title = "Permitir la reproducción automática de contenido multimedia";
AutoplayAllowed.pfm_description = "Si estableces la política como verdadera, Brave podrá reproducir contenido multimedia de forma automática. Si estableces la política como falsa, Brave dejará de reproducir contenido multimedia de forma automática.\n\nSi no estableces esta política, Brave no reproducirá contenido multimedia de forma automática. Sin embargo, para ciertos patrones de URL, podrás usar la política AutoplayAllowlist para cambiar esta configuración.\n\nSi esta política cambia mientras se ejecuta Brave, el cambio solo se aplicará a las pestañas que se abran a partir de ese momento.";
AutoplayAllowlist.pfm_title = "Permite la reproducción automática de contenido multimedia en una lista de patrones de URL permitidos";
AutoplayAllowlist.pfm_description = "Si estableces la política, los videos se reproducirán de forma automática (sin el consentimiento del usuario) con contenido de audio en Brave. Si estableces la política AutoplayAllowed como verdadera, esta no tendrá ningún efecto. Si estableces AutoplayAllowed como falsa, de todos modos podrá reproducirse cualquier patrón de URL que esté especificado en esta política. Si esta política cambia mientras se ejecuta Brave, el cambio solo se aplicará a las pestañas que se abran a partir de ese momento.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns/.";
BackgroundTabFreezingEnabled.pfm_title = "Habilitar la inmovilización de pestañas en segundo plano";
BackgroundTabFreezingEnabled.pfm_description = "Controla si Brave inmoviliza las pestañas inactivas en segundo plano para ahorrar CPU y memoria.\n\nCuando la inmovilización de pestañas en segundo plano está activa, las pestañas que estuvieron inactivas en segundo plano durante un período se inmovilizan pausando la ejecución de JavaScript y las tareas del cronómetro. Las pestañas congeladas permanecen cargadas en la memoria y se reanudan de forma instantánea cuando el usuario las selecciona. Las pestañas con tareas activas en segundo plano, como las que reproducen audio o video, capturan transmisiones de pantalla o de cámara, mantienen conexiones WebRTC activas o retienen Web Locks, no son aptas para la congelación y siguen ejecutándose. Los sitios configurados en la política TabDiscardingExceptions o en las excepciones de descarte de pestañas del usuario también están exentos de la inmovilización.\n\nSi habilitas la política, se activará la inhabilitación automática de pestañas en segundo plano para las pestañas en segundo plano aptas. Los usuarios no pueden cambiar este parámetro de configuración.\n\nSi inhabilitas la política, se evitará que se congelen las pestañas en segundo plano. Los usuarios no pueden cambiar este parámetro de configuración.\n\nSi no estableces la política, la inmovilización de pestañas en segundo plano estará habilitada de forma predeterminada, pero los usuarios podrán activarla o desactivarla en la configuración de Brave.";
BasicAuthOverHttpEnabled.pfm_title = "Permitir la autenticación Basic para HTTP";
BasicAuthOverHttpEnabled.pfm_description = "Si habilitas esta política o no la estableces, se podrán recibir desafíos de autenticación Basic en las solicitudes HTTP no seguras.\n\nSi inhabilitas la política, se prohíbe que las solicitudes HTTP no seguras usen el esquema de autenticación Basic; solo se permitirán las solicitudes HTTPS seguras.\n\nSi se establece la política de AuthSchemes y no incluye Basic, se ignora esta política y se prohíbe siempre Basic.";
BatterySaverModeAvailability.pfm_title = "Habilitar el modo de Ahorro de batería";
BatterySaverModeAvailability.pfm_description = "0 - Inhabilitar el modo de Ahorro de batería\n1 - Habilitar el modo de Ahorro de batería cuando el dispositivo esté funcionando con la batería y el nivel esté bajo\n2 - Este valor deja de estar disponible a partir de M121. A partir de M121, los valores se tratarán como EnabledBelowThreshold.\nEsta política habilita o inhabilita la configuración del modo de Ahorro de batería.\nEn Chrome, esta configuración hace que la velocidad de fotogramas se limite a un consumo de energía más bajo. Si no estableces esta política, el usuario final podrá controlar esta configuración desde chrome://settings/performance.\nEn ChromeOS, este parámetro de configuración hace que se limite la velocidad de fotogramas y la frecuencia de la CPU, se atenúe la retroiluminación y se active el modo de Ahorro de batería para Android. En los dispositivos con varias CPUs, se desactivarán algunas.\nLos diferentes niveles son los siguientes:\nDisabled (0): Se inhabilitará el modo de Ahorro de batería.\nEnabledBelowThreshold (1): Se habilitará el modo de Ahorro de batería cuando el dispositivo esté funcionando con la batería y su nivel esté bajo.\nEnabledOnBattery (2): Este valor deja de estar disponible a partir de M121. A partir de la versión M121, los valores se      tratarán como EnabledBelowThreshold.\n";
BlockExternalExtensions.pfm_title = "Impide la instalación de extensiones externas";
BlockExternalExtensions.pfm_description = "Controla la instalación de extensiones externas.\n\nSi habilitas esta política, no se podrán instalar extensiones externas.\n\nSi inhabilitas esta política o no la estableces, se podrán instalar extensiones externas.\n\nLas extensiones externas y su instalación están documentadas en https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions.\n\nNota: Esta política solo se aplica a las plataformas que admiten extensiones.";
BlockThirdPartyCookies.pfm_title = "Bloquear cookies de terceros";
BlockThirdPartyCookies.pfm_description = "Si habilitas la política, los elementos de la página web que no sean del dominio especificado en la barra de direcciones del navegador no podrán establecer cookies. Si inhabilitas la política, esos elementos podrán establecer cookies y los usuarios no podrán cambiar esta configuración.\n\nSi no la estableces, se podrán mostrar cookies de terceros, pero los usuarios podrán cambiar esta configuración.\n\nNota: Esta política no se aplica en el modo Incógnito, donde se bloquean las cookies de terceros y solo se pueden permitir a nivel del sitio. Para permitir las cookies a nivel del sitio, usa la política CookiesAllowedForUrls.";
BookmarkBarEnabled.pfm_title = "Habilitar barra de favoritos";
BookmarkBarEnabled.pfm_description = "Si estableces la política como verdadera, se mostrará una barra de favoritos en Brave. Si la estableces como falsa, los usuarios no podrán ver la barra de favoritos.\n\nSi estableces la política, los usuarios no podrán cambiarla. Si no la estableces, los usuarios decidirán si usan esta función.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "Habilitar la opción para agregar una persona en el Administrador de usuarios";
BrowserAddPersonEnabled.pfm_description = "Si estableces esta política como verdadera o no la configuras, Brave y Lacros permitirán que se agregue una nueva persona desde el Administrador de usuarios.\n\nSi la estableces como falsa, Brave y Lacros no permitirán que se agregue una nueva persona desde el Administrador de usuarios.";
BrowserGuestModeEnabled.pfm_title = "Habilitar modo de invitado en el navegador";
BrowserGuestModeEnabled.pfm_description = "Si habilitas esta política o no la configuras, Brave habilitará los accesos de invitado. Los accesos de invitado son perfiles de Brave en donde todas las ventanas están en el modo Incógnito.\n\nSi inhabilitas esta política, Brave no permitirá que se inicien perfiles de invitado.";
BrowserGuestModeEnforced.pfm_title = "Aplica el modo de invitado en el navegador";
BrowserGuestModeEnforced.pfm_description = "Si habilitas la política, Brave aplicará las sesiones de invitado y no permitirá acceder a los perfiles. Los accesos de invitado son perfiles de Brave en donde todas las ventanas están en el modo Incógnito.\n\nSi inhabilitas la política, no la estableces o inhabilitas el modo de invitado del navegador (mediante BrowserGuestModeEnabled) se podrán usar perfiles nuevos y existentes.";
BrowserLabsEnabled.pfm_title = "Ícono de experimentos del navegador de la barra de herramientas";
BrowserLabsEnabled.pfm_description = "Si habilitas o no estableces esta política, los usuarios podrán acceder a las funciones experimentales del navegador a través de un ícono de la barra de herramientas\n\nSi la inhabilitas, se quitará el ícono de funciones experimentales de la barra de herramientas.\n\nchrome://flags y cualquier otra forma de activar y desactivar las funciones del navegador seguirán comportándose según lo esperado independientemente de si esta política está habilitada o inhabilitada.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Permitir consultas a un servicio de hora de Google";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Si habilitas la política o no la estableces, Brave enviará consultas ocasionales a un servidor de Google para recuperar una marca de tiempo precisa.\n\nSi la inhabilitas, Brave dejará de enviar estas consultas.";
BrowserSignin.pfm_title = "Configuración de acceso en el navegador";
BrowserSignin.pfm_description = "0 - Inhabilitar el acceso en el navegador\n1 - Habilitar el acceso en el navegador\n2 - Obligar a los usuarios a acceder para usar el navegador\nEsta política controla el comportamiento de acceso del navegador. Te permite especificar si el usuario puede acceder a Brave con su cuenta y usar servicios relacionados con ella, como la sincronización de Brave.\n\nSi estableces la política con el valor \"Inhabilitar el acceso en el navegador\", el usuario no podrá acceder al navegador ni usar los servicios basados en su cuenta. Es este caso, las funciones del nivel del navegador, como la sincronización de Brave, no se podrán usar y dejarán de estar disponibles. En iOS, si el usuario accedió y se inhabilita la política, se saldrá de la cuenta de forma inmediata. En otras plataformas, se saldrá de la cuenta la siguiente vez que se ejecute Brave. En todas las plataformas, se preservarán los datos de perfil locales, como los favoritos, las contraseñas, etc., y seguirán siendo utilizables. El usuario aún podrá acceder a los servicios web de Google, como Gmail, y usarlos.\n\nSi estableces la política con el valor \"Habilitar el acceso en el navegador\", el usuario podrá acceder al navegador. En todas las plataformas excepto iOS, el usuario accederá al navegador de forma automática cuando acceda a un servicio web de Google, como Gmail. Si se habilita el acceso al navegador, este guardará la información de la cuenta del usuario. Sin embargo, esto no implica que la sincronización de Brave se activará de forma predeterminada; el usuario deberá habilitarla por separado. Si habilitas esta política, el usuario no podrá desactivar la configuración que permite el acceso al navegador. Para controlar la disponibilidad de la sincronización de Brave, usa la política SyncDisabled.\n\nSi estableces la política para que se fuerce el acceso al navegador, el usuario verá un diálogo de selección de cuenta; deberá elegir una cuenta y acceder a ella para usar el navegador. Esto asegura que se aplicarán las políticas asociadas a la cuenta para las cuentas administradas. Se inhabilitará el valor predeterminado de BrowserGuestModeEnabled. Ten en cuenta que se bloquearán los perfiles a los que no se haya accedido y no se podrá acceder a ellos luego de que se habilite esta política. Para obtener más información, consulta este artículo del Centro de ayuda: https://support.google.com/chrome/?p=force_browser_signin. Esta opción no es compatible con Google Chrome OS ni Android, donde se asignará el valor \"Habilitar el acceso en el navegador\" si se la usa.\n\nSi no estableces esta política, el usuario podrá decidir si habilitar el acceso al navegador desde la configuración de Brave y usarlo según su criterio.";
BrowserSwitcherDelay.pfm_title = "Retraso antes de ejecutar otro navegador (milisegundos)";
BrowserSwitcherDelay.pfm_description = "Si asignas un número a la política, Brave mostrará un mensaje durante esa cantidad de milisegundos y, luego, abrirá un navegador alternativo.\n\nSi no estableces la política o la estableces con el valor \"0\", la navegación a una URL desginada la abrirá de inmediato en un navegador alternativo.";
BrowserSwitcherEnabled.pfm_title = "Habilitar la función \"Compatibilidad con navegadores heredados\"";
BrowserSwitcherEnabled.pfm_description = "Si habilitas esta política, Brave intentará ejecutar algunas URLs en un navegador alternativo, como Internet Explorer®. Esta función está configurada conforme a las políticas del grupo Legacy Browser support.\n\nSi inhabilitas la política o no la estableces, Brave no intentará ejecutar las URLs designadas en un navegador alternativo.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "URL de un archivo XML que contiene URL que nunca deben abrirse en otro navegador";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Si estableces esta política con una URL válida, Brave descargará la lista de sitios de esa URL y aplicará las reglas como si se hubieran configurado con la política BrowserSwitcherUrlGreylist. Estas políticas impiden que Brave abra el navegador alternativo y viceversa.\n\nSi no la estableces (o determinas una URL no válida), Brave no utilizará la política como fuente de reglas para no cambiar de navegador.\n\nNota: Esta política redirecciona a un archivo XML en el mismo formato que la política SiteList de Internet Explorer®. De esta manera, se cargan reglas de un archivo XML sin la necesidad de compartirlas con Internet Explorer®. Obtén más información sobre la política SiteList de Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL de un archivo XML que contiene URL para cargarlas en un navegador alternativo";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Si estableces esta política con una URL válida, Brave descargará la lista de sitios de esa URL y aplicará las reglas como si se hubieran configurado con la política BrowserSwitcherUrlList.\n\nSi no la estableces (o determinas una URL no válida), Brave no utilizará la política como fuente de reglas para cambiar de navegador.\n\nNota: Esta política redirecciona a un archivo XML en el mismo formato que la política SiteList de Internet Explorer®. De esta manera, se cargan reglas de un archivo XML sin la necesidad de compartirlas con Internet Explorer®. Obtén más información sobre la política SiteList de Internet Explorer® (https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode)";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Mantener la última pestaña abierta en Chrome";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Si habilitas esta política o no la estableces, Brave mantendrá al menos una pestaña abierta y cambiará a un navegador alternativo.\n\nSi la inhabilitas, Brave cerrará la pestaña y, luego, cambiará a un navegador alternativo, incluso si se trataba de la última pestaña. En consecuencia, Brave saldrá por completo.";
BrowserSwitcherParsingMode.pfm_title = "Modo de análisis de la lista de sitios";
BrowserSwitcherParsingMode.pfm_description = "0 - Comportamiento predeterminado de LBS\n1 - Mayor compatibilidad con listas de sitios en modo de empresa de Microsoft IE/Edge\nEsta política controla la manera en la que Google Chrome interpreta las políticas de listas de sitios o listas grises para la función Compatibilidad con navegadores heredados. Afecta las siguientes políticas: BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl y BrowserSwitcherExternalGreylistUrl.\n\nSi estableces la política como \"Default\" (0) o no la estableces, las coincidencias de URL serán menos estrictas. Las reglas que no incluyan \"/\" buscarán una substring en cualquier parte del nombre de host de la URL. Para establecer coincidencias con el componente de la ruta de acceso de una URL se distinguen mayúsculas de minúsculas.\n\nSi estableces la política como \"IESiteListMode\" (1), las coincidencias de URL serán más estrictas. Las reglas que no incluyan \"/\" solo buscarán coincidencias al final del nombre de host. Las reglas deben estar en el límite de un nombre de dominio. Para establecer coincidencias con el componente de la ruta de acceso de una URL no se distinguen mayúsculas de minúsculas. Es más compatible con Microsoft® Internet Explorer® y Microsoft® Edge®.\n\nPor ejemplo, con las reglas \"example.com\" y \"acme.com/abc\":\n\n\"http://example.com/\", \"http://subdomain.example.com/\" y \"http://acme.com/abc\" coinciden, independientemente del modo de análisis.\n\n\"http://notexample.com/\", \"http://example.com.invalid.com/\" y \"http://example.comabc/\" solo coinciden en el modo \"Default\".\n\n\"http://acme.com/ABC\" solo coincide en el modo \"IESiteListMode\".";
BrowserSwitcherUrlGreylist.pfm_title = "Sitios web que nunca deben abrirse en otro navegador";
BrowserSwitcherUrlGreylist.pfm_description = "Si estableces esta política, se controlará la lista de sitios web que nunca obligarán a cambiar de navegador. Cada elemento será tratado como una regla. Las reglas que coincidan no se abrirán en un navegador alternativo. A diferencia de la política BrowserSwitcherUrlList, las reglas se aplican en ambas direcciones. Si el complemento de Internet Explorer® está activado, también controlará si Internet Explorer® puede abrir estas URL en Brave.\n\nSi no estableces la política, no se agregarán sitios web a la lista.\n\nNota: También se pueden agregar elementos a esta lista a través de la política BrowserSwitcherExternalGreylistUrl.";
BrowserSwitcherUrlList.pfm_title = "Sitios web que se abren en un navegador alternativo";
BrowserSwitcherUrlList.pfm_description = "Si estableces esta política, controlará la lista de sitios web que se abrirán en un navegador alternativo. Se tratan todos los elementos como regla para abrirse en un navegador alternativo. Brave utiliza esas reglas cuando se decide si una URL debe abrirse en un navegador alternativo. Si el complemento de Internet Explorer® está activado, Internet Explorer® cambiará a Brave cuando las reglas no coinciden. Si las reglas se contradicen, Brave usa la regla más específica.\n\nSi no estableces la política, no se agregarán sitios web a la lista.\n\nNota: Se pueden agregar elementos a esta lista mediante las políticas BrowserSwitcherUseIeSitelist y BrowserSwitcherExternalSitelistUrl.";
BrowserThemeColor.pfm_title = "Configurar el color del tema del navegador";
BrowserThemeColor.pfm_description = "Esta política permite a los administradores configurar el color del tema de Brave. La string de entrada debe ser una string válida de un código hexadecimal de color que coincida con el formato \"#RRGGBB\".\n\nSi estableces la política con un código hexadecimal de color válido, se generará automáticamente un tema basado en ese color y se aplicará al navegador. Los usuarios no podrán cambiar el tema establecido por la política.\n\nSi no la estableces, los usuarios podrán cambiar el tema de su navegador como prefieran.";
BrowsingDataLifetime.pfm_title = "Configuración de la duración de los datos de navegación";
BrowsingDataLifetime.pfm_description = "Establece la configuración de la duración de los datos de navegación para Brave. Esta política les permite a los administradores configurar (por tipo de datos) cuándo el navegador borra los datos. Esto es útil para los clientes que trabajan con datos sensibles de clientes.\n\nAdvertencia: Si estableces esta política, es posible que se vean afectados los datos personales locales y que se quiten de forma permanente. Se recomienda probar la configuración antes de la implementación para evitar la eliminación accidental de datos personales.\n\nLos tipos de datos disponibles son 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' y 'hosted_app_data'. 'download_history' y 'hosted_app_data' no son compatibles con Android.\n\nEl navegador quitará de forma automática los datos de los tipos seleccionados que sean anteriores a 'time_to_live_in_hours'. El valor mínimo que se puede establecer es 1 hora.\n\nLos datos caducados se borrarán 15 segundos después del inicio del navegador y, luego, cada media hora mientras se esté ejecutando el navegador.\n\nEl usuario permanecerá en su Cuenta de Google cuando borre las cookies.\n\nHasta la versión 114 de Chrome, esta política requería que se estableciera la política SyncDisabled como verdadera. A partir de la versión 115 de Chrome, si estableces esta política, se inhabilitará la sincronización de los tipos de datos correspondientes si no inhabilitas \"Chrome Sync\" al establecer la política SyncDisabled ni inhabilitas BrowserSignin.\nConsulta https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime para obtener más información sobre el esquema y el formato.";
BuiltInAIAPIsEnabled.pfm_title = "Permitir que las páginas usen las APIs de IA integradas.";
BuiltInAIAPIsEnabled.pfm_description = "Esta política controla si una página puede usar las APIs de IA integradas (como LanguageModel API, Summarization API, Writer API y Rewriter API).\n\nSi habilitas las política o no la estableces, las APIs estarán habilitadas para su uso.\n\nSi la inhabilitas, se producirá un error cuando intentes usar las APIs.";
BuiltInDnsClientEnabled.pfm_title = "Utilizar cliente DNS integrado";
BuiltInDnsClientEnabled.pfm_description = "Esta política controla la pila de software que se utiliza para establecer la comunicación con el servidor DNS: el cliente DNS del sistema operativo o el cliente DNS integrado de Brave. Esta política no cambia los servidores DNS que se utilizan: si, por ejemplo, el sistema operativo está configurado para usar un servidor DNS empresarial, el cliente DNS integrado utilizará ese mismo servidor. Tampoco controla si se utiliza el protocolo DNS-over-HTTPS; Brave siempre utilizará el agente de resolución integrado para las solicitudes del protocolo DNS-over-HTTPS. Para obtener información sobre el control de este protocolo, consulta la política DnsOverHttpsMode.\n\nSi habilitas esta política o no la estableces, se usará el cliente de DNS integrado.\n\nSi la inhabilitas, el cliente DNS integrado solo se utilizará cuando esté en uso el protocolo DNS-over-HTTPS.";
CACertificateManagementAllowed.pfm_title = "Permite que los usuarios administren los Certificados de CA instalados";
CACertificateManagementAllowed.pfm_description = "0 - Permitir que los usuarios administren todos los certificados\n1 - Permitir que los usuarios administren los certificados de usuario\n2 - No permitir que los usuarios administren certificados\nSi estableces la política en All (0) o no la estableces, los usuarios podrán editar la configuración de confianza para todos los certificados de CA, importar certificados mediante el administrador de certificados y quitar los certificados importados por el usuario. Si la estableces en UserOnly (1), los usuarios podrán administrar solo los certificados importados por el usuario, pero no podrán cambiar la configuración de confianza de los certificados integrados. Si la estableces en None (2), los usuarios podrán ver los certificados de CA, pero no los podrán administrar.";
CACertificates.pfm_title = "Certificados TLS en los que debe confiar Brave para la autenticación del servidor";
CACertificates.pfm_description = "Una lista de certificados TLS en los que debe confiar Brave para la autenticación del servidor.\nLos certificados deben estar codificados en base64.";
CACertificatesWithConstraints.pfm_title = "Certificados TLS en los que debe confiar Brave para la autenticación del servidor con restricciones";
CACertificatesWithConstraints.pfm_description = "Una lista de certificados TLS en los que debe confiar Brave para la autenticación del servidor, con restricciones agregadas fuera del certificado. Si no hay ninguna restricción de un tipo determinado, se permite cualquier nombre de ese tipo.\nLos certificados deben estar codificados en base64. Se debe especificar al menos una restricción para cada certificado.\nConsulta https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints para obtener más información sobre el esquema y el formato.";
CADistrustedCertificates.pfm_title = "Certificados TLS en los que no debe confiar Brave para la autenticación del servidor";
CADistrustedCertificates.pfm_description = "Una lista de claves públicas de certificados en las que no debe confiar Brave para la autenticación\ndel servidor TLS.\n\nEl valor de la política es una lista de certificados X.509 codificados en base64. Cualquier\ncertificado con una SPKI (SubjectPublicKeyInfo) que coincida no será de confianza.";
CAHintCertificates.pfm_title = "Certificados TLS que no son confiables o no confiables, pero que se pueden usar en la compilación de rutas de acceso para la autenticación del servidor";
CAHintCertificates.pfm_description = "Una lista de certificados que no son confiables o no confiables en Brave,\npero que se pueden usar como sugerencias para la compilación de rutas de acceso. Los certificados deben estar codificados en base64.";
CAPlatformIntegrationEnabled.pfm_title = "Usar certificados TLS agregados por el usuario desde almacenes de confianza de la plataforma para la autenticación del servidor";
CAPlatformIntegrationEnabled.pfm_description = "Si se habilita (o no se establece), se usarán certificados TLS agregados por el usuario desde los almacenes de confianza de la plataforma en la generación de rutas de acceso para la autenticación del servidor TLS.\n\nSi se inhabilita, no se usarán los certificados TLS agregados por el usuario desde los almacenes de confianza de la plataforma en la generación de rutas de acceso para la autenticación del servidor TLS.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "Admisión de encabezados de solicitudes sin comodín CORS";
CORSNonWildcardRequestHeadersSupport.pfm_description = "Determina si se admiten encabezados de solicitudes sin comodín CORS.\n\nA partir de la versión 97 de Brave, se puede determinar si se admiten encabezados de solicitudes sin comodín CORS. Cuando las secuencias de comandos envían una solicitud de red de orígenes cruzados a través de fetch() y XMLHttpRequest con un encabezado Authorization para agregar a la secuencia de comandos, el encabezado debe tener la autorización expresa del encabezado Access-Control-Allow-Headers en la respuesta de la solicitud preliminar de CORS. En este caso, \"Expresa\" significa que el símbolo comodín \"*\" no incluye el encabezado de autorización. Para obtener más información, visita https://chromestatus.com/feature/5742041264816128.\n\nSi no estableces esta política o la estableces como verdadera, Brave admitirá los encabezados de solicitudes sin comodín CORS y se comportará como se describe anteriormente.\n\nSi la estableces como falsa, Chrome admitirá el símbolo comodín (\"*\") del encabezado Access-Control-Allow-Headers en la respuesta de la solicitud preliminar de CORS, a fin de incluir el encabezado Authorization.\n\nEsta política empresarial es temporal; se planea quitarla en el futuro.";
CacheEncryptionEnabled.pfm_title = "Esta política permite que los administradores encripten la caché HTTP en el disco.";
CacheEncryptionEnabled.pfm_description = "Esta política permite que los administradores encripten la caché HTTP del navegador en el disco.\n\nSi habilitas esta política, se encriptará la caché del navegador.\n\nSi la inhabilitas o no la estableces, no se encriptará la caché del navegador.\n\nLa encriptación de la caché del navegador puede afectar el rendimiento.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "Inhabilitar la aplicación del Certificado de transparencia para una lista de hash de subjectPublicKeyInfo";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "Si estableces la política, se inhabilitará la aplicación de los requisitos de divulgación del Certificado de transparencia para una lista de hash de subjectPublicKeyInfo. Los hosts empresariales podrán seguir usando los certificados que no sean de confianza (porque no se divulgaron públicamente de forma correcta). Para inhabilitar la aplicación, el hash debe complir con una de las siguientes condiciones:\n\n* El hash pertenece al campo subjectPublicKeyInfo del certificado del servidor.\n\n* El hash pertenece a un campo subjectPublicKeyInfo que aparece en un certificado de autoridad certificadora (CA) en la cadena de certificados; ese certificado de CA está limitado por la extensión X.509v3 nameConstraints; uno o más directoryName nameConstraints están presentes en permittedSubtrees; y directoryName contiene un atributo organizationName.\n\n* El hash pertenece a un campo subjectPublicKeyInfo que aparece en un certificado de CA en la cadena de certificados; ese certificado de CA tiene uno o más atributos organizationName en el asunto del certificado; y el certificado del servidor contiene la misma cantidad de atributos organizationName, en el mismo orden y con los mismos valores, byte por byte.\n\nPara especificar un hash de subjectPublicKeyInfo, se debe vincular el nombre del algoritmo del hash, una barra y la codificación de Base64 de ese algoritmo aplicada al campo subjectPublicKeyInfo codificado con DER del certificado específico. Esta codificación de Base64 tiene el mismo formato que una SPKI Fingerprint. El único algoritmo de hash compatible es sha256; se ignorarán los demás.\n\nSi no estableces esta política, Brave considerará que no son de confianza los certificados que no se divulguen, a pesar de requerir divulgación mediante el Certificado de transparencia.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "Inhabilitar la aplicación del Certificado de transparencia para una lista de URL";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "Si estableces la política, se desactivarán los requisitos de divulgación del Certificado de transparencia para los nombres de host en las URLs especificadas. Si bien esta acción dificulta la detección de los certificados que se usan de forma incorrecta, los hosts pueden seguir usando certificados que, de otra manera, no serían de confianza (porque no se divulgaron correctamente a nivel público).\n\nSi no estableces esta política, Brave considerará que no son de confianza los certificados que requieran divulgación mediante el Certificado de transparencia y, a pesar de ello, no se hayan divulgado.\n\nEl patrón de una URL tiene el formato que se indica en ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ). Sin embargo, dado que la validez de los certificados para un nombre de host específico no depende del esquema, el puerto ni la ruta de acceso, Brave solo considerará la parte de la URL que contenga el nombre de host. No se admiten hosts con comodines.";
ChromeForTestingAllowed.pfm_title = "Permitir Chrome for Testing";
ChromeForTestingAllowed.pfm_description = "Controla si los usuarios pueden usar Chrome for Testing.\n\nSi habilitas esta política o no la estableces, los usuarios podrán instalar y ejecutar Chrome for Testing.\n\nSi la inhabilitas, los usuarios no podrán ejecutar Chrome for Testing. Los usuarios aún podrán instalar Chrome for Testing. Sin embargo, no se ejecutará con los perfiles en los que inhabilites esta política.";
ChromeSuggestionsSettings.pfm_title = "Configuración de ChromeSuggestions";
ChromeSuggestionsSettings.pfm_description = "Este parámetro de configuración permite que Chrome sugiera funciones potenciadas por IA en momentos pertinentes.\n\n0 o no establecido = Las sugerencias de Chrome estarán habilitadas para los usuarios.\n\n1 = Las sugerencias de Chrome están inhabilitadas para los usuarios.\n\nPara obtener más información, consulta el artículo del Centro de ayuda: https://support.google.com/chrome/a?p=chrome_suggestions";
ChromeVariations.pfm_title = "Determina la disponibilidad de las variantes";
ChromeVariations.pfm_description = "0 - Habilitar todas las variaciones\n1 - Habilitar solo variaciones relacionadas con correcciones críticas\n2 - Inhabilitar todas las variaciones\nSi se configura esta política, es posible especificar qué variaciones pueden aplicarse respecto de Brave.\n\nLas variaciones son una forma de ofrecer modificaciones para Brave sin enviar una nueva versión del navegador; solo se habilitan o inhabilitan de forma selectiva las funciones existentes. Para obtener más información, consulta https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework.\n\nSi estableces la política VariationsEnabled (valor 0) o no la estableces, se podrán aplicar todas las variaciones en el navegador.\n\nSi estableces CriticalFixesOnly (valor 1), solo se podrán aplicar las variaciones que se consideren correcciones de estabilidad o seguridad críticas en Brave.\n\nSi estableces VariationsDisabled (valor 2), no se podrá aplicar ninguna variación en el navegador. Ten en cuenta que no se recomienda este modo porque podría impedir que los desarrolladores de Brave proporcionen correcciones de seguridad críticas de manera oportuna.";
ClearBrowsingDataOnExitList.pfm_title = "Borra los datos de navegación al salir";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - Historial de navegación\ndownload_history - Historial de descargas\ncookies_and_other_site_data - Cookies y otros datos de sitios\ncached_images_and_files - Imágenes y archivos almacenados en caché\npassword_signin - Acceso mediante contraseña\nautofill - Autocompletar\nsite_settings - Configuración de sitios\nhosted_app_data - Datos de apps alojadas\nConfigura una lista de los tipos de datos de navegación que deben borrarse cuando el usuario cierra todas las ventanas del navegador.\n\nAdvertencia: Si estableces esta política, es posible que se vean afectados los datos personales locales y que se quiten de forma permanente. Se recomienda probar la configuración antes de la implementación para evitar la eliminación accidental de datos personales.\n\nLos tipos de datos disponibles son el historial de navegación (browsing_history), el historial de descargas (download_history), las cookies (cookies_and_other_site_data), la memoria caché (cached_images_and_files), las opciones de autocompletar (autofill), las contraseñas (password_signin), la configuración de los sitios (site_settings) y los datos de las apps alojadas (hosted_app_data). Esta política no tendrá prioridad sobre AllowDeletingBrowserHistory.\n\nEl usuario permanecerá en su Cuenta de Google cuando borre las cookies.\n\nHasta la versión 114 de Chrome, esta política requería que se estableciera la política SyncDisabled como verdadera. A partir de la versión 115 de Chrome, si estableces esta política, se inhabilitará la sincronización de los tipos de datos correspondientes si no inhabilitas \"Chrome Sync\" al establecer la política SyncDisabled ni inhabilitas BrowserSignin.\n\nSi por algún motivo se inició la eliminación de datos y no se completó, se borrarán los datos de navegación la próxima vez que se cargue el perfil.\n\nSi se produce un error al salir de Brave (por ejemplo, si falla el navegador o el SO), no se borrarán los datos de navegación, ya que la salida del navegador no fue el resultado de que el usuario cerrara todas las ventanas del navegador.";
ClipboardAllowedForUrls.pfm_title = "Permitir el portapapeles en estos sitios";
ClipboardAllowedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que pueden usar el permiso para sitios del portapapeles. Esto no incluye todas las operaciones del portapapeles en orígenes que coinciden con los patrones. Por ejemplo, los usuarios podrán pegar contenido usando combinaciones de teclas, ya que el permiso para sitios del portapapeles no anula esta función.\n\n\nSi no estableces la política, se aplicará DefaultClipboardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
ClipboardBlockedForUrls.pfm_title = "Bloquear el portapapeles en estos sitios";
ClipboardBlockedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indique los sitios que no pueden usar el permiso para sitios del portapapeles. Esto no incluye todas las operaciones del portapapeles en orígenes que coinciden con los patrones. Por ejemplo, los usuarios podrán pegar contenido usando combinaciones de teclas, ya que el permiso para sitios del portapapeles no anula esta función.\n\nSi no estableces la política, se aplicará DefaultClipboardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
CloudManagementEnrollmentMandatory.pfm_title = "Habilitar la inscripción obligatoria en la administración de la nube";
CloudManagementEnrollmentMandatory.pfm_description = "Si habilitas la política, la inscripción en el navegador Chrome Enterprise Core será obligatoria y se bloqueará el proceso de ejecución de Brave si esta falla.\n\nSi la inhabilitas o no la estableces, la inscripción en el navegador Chrome Enterprise Core será opcional y no se bloqueará el proceso de ejecución de Brave si esta falla.\n\nEsta política se usa en máquinas de escritorio con inscripción en las políticas de la nube. Para obtener más información, consulta https://support.google.com/chrome/a/answer/9301891.";
CloudManagementEnrollmentToken.pfm_title = "El token de inscripción de la política de nube";
CloudManagementEnrollmentToken.pfm_description = "Si estableces la política, Brave intentará registrarse con la administración del navegador Chrome Enterprise Core. El valor de esta política es un token de inscripción que puedes recuperar de la Google Admin console.\n\nPara obtener más información, consulta https://support.google.com/chrome/a/answer/9301891.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "La política de nube de Brave anula la política de la plataforma.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Si habilitas la política y hay conflicto con la política de la plataforma, tendrá prioridad la política de la nube.\n\nSi inhabilitas la política o no la estableces y hay conflicto con la política de la nube, tendrá prioridad la política de la plataforma.\n\nEsta política obligatoria afecta las políticas de la nube para esta máquina.\n\nEsta política es específica para Brave y no afecta a Google Update porque son aplicaciones independientes.\nGoogle Update tiene una política independiente con el mismo nombre.";
CloudUserPolicyMerge.pfm_title = "Permite combinar las políticas de nube destinadas a los usuarios con las políticas de la máquina";
CloudUserPolicyMerge.pfm_description = "Si habilitas la política, las políticas asociadas a una cuenta administrada podrán combinarse en políticas de la máquina.\n\nSi inhabilitas la política o no la estableces, las políticas de la nube destinadas a los usuarios no podrán combinarse con políticas de cualquier otro origen.\n\nSolo pueden prevalecer políticas que hayan originado usuarios seguros. Un usuario seguro es aquél que está afiliado a la organización que administra su navegador a través de Chrome Enterprise Core. Todas las demás políticas destinadas a los usuarios tendrán la prioridad predeterminada.\n\nLas políticas que deban combinarse también deben establecerse en PolicyListMultipleSourceMergeList o PolicyDictionaryMultipleSourceMergeList. Se ignorará esta política si no se configura ninguna de las dos políticas mencionadas anteriormente.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Permitir que las políticas de nube destinadas a los usuarios anulen las políticas de Chrome Browser Cloud Management";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Si habilitas la política, prevalecerán las políticas asociadas a una cuenta administrada si entran en conflicto con las políticas del navegador Chrome Enterprise Core.\n\nSi inhabilitas la política o no la estableces, las políticas de la nube destinadas a los usuarios tendrán la prioridad predeterminada.\n\nSolo pueden prevalecer políticas que hayan originado usuarios seguros. Un usuario seguro es aquél que está afiliado a la organización que administra su navegador a través de Chrome Enterprise Core. Todas las demás políticas destinadas a los usuarios tendrán la prioridad predeterminada.\n\nLa política puede combinarse con CloudPolicyOverridesPlatformPolicy. Si se habilitan ambas políticas, las políticas de nube destinadas a los usuarios también prevalecerán sobre las políticas de la plataforma que estén en conflicto.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Habilita las advertencias de seguridad para las marcas de la línea de comandos";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Si inhabilitas la política o no la estableces, aparecerán las advertencias de seguridad cuando se usen funciones experimentales de línea de comandos potencialmente peligrosas para iniciar Chrome.\n\nSi la inhabilitas, no aparecerán las advertencias de seguridad cuando se inicie Chrome con funciones experimentales de línea de comandos potencialmente peligrosas.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
ComponentUpdatesEnabled.pfm_title = "Habilitar las actualizaciones de componentes en Brave";
ComponentUpdatesEnabled.pfm_description = "Si habilitas la política o no la estableces, se permitirán las actualizaciones de todos los componentes de Brave.\n\nSi la inhabilitas, no se permitirán las actualizaciones. Sin embargo, algunos componentes están exceptuados de esta política: no se inhabilitarán las actualizaciones de componentes que no contengan código ejecutable y que sean fundamentales para la seguridad del navegador.\nLos ejemplos de estos componentes incluyen las listas de revocación de certificados y los filtros de subrecursos.";
CompressionDictionaryTransportEnabled.pfm_title = "Habilitar la compatibilidad con la función Compression Dictionary Transport";
CompressionDictionaryTransportEnabled.pfm_description = "Esta función habilita el uso de codificaciones de contenido específicas de diccionarios en el encabezado de solicitud Accept-Encoding (\"sbr\" y \"zst-d\") cuando hay diccionarios disponibles.\n\nSi habilitas la política o no la estableces, Brave aceptará contenido web que use la función Compression Dictionary Transport.\nSi inhabilitas la política, se desactivará la función Compression Dictionary Transport.";
CookiesAllowedForUrls.pfm_title = "Permitir cookies en estos sitios";
CookiesAllowedForUrls.pfm_description = "Te permite configurar una lista de patrones de URL donde se indiquen los sitios autorizados a configurar cookies.\n\nLos patrones de URL pueden ser una sola URL que indique que el sitio puede usar cookies en todos los sitios de nivel superior.\n\nLos patrones también pueden ser dos URLs delimitadas por una coma. La primera especifica el sitio que debería poder usar cookies. La segunda especifica el sitio de nivel superior al que se debe aplicar el primer valor.\n\nSi usas un par de URLs, el primer valor del par admite *, pero el segundo no. Si se usa * para el primer valor, significa que todos los sitios pueden usar cookies cuando la segunda URL es el sitio de nivel superior.\n\nSi no estableces esta política, se usará el valor predeterminado global para todos los sitios, ya sea de las políticas DefaultCookiesSetting o BlockThirdPartyCookies, si se establecen, o bien la configuración personal del usuario.\n\nConsulta también las políticas CookiesBlockedForUrls y CookiesSessionOnlyForUrls. Ten en cuenta que no debe haber patrones de URL en conflicto entre estas tres políticas. No se especifica qué política prevalece en esa situación.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
CookiesBlockedForUrls.pfm_title = "Bloquear cookies en estos sitios";
CookiesBlockedForUrls.pfm_description = "Si estableces la política, podrás crear una lista de patrones de URL que especifiquen los sitios que no pueden configurar cookies.\n\nSi no estableces la política, se aplicará DefaultCookiesSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nSi bien no prevalece ninguna política específica, consulta CookiesAllowedForUrls y CookiesSessionOnlyForUrls. Los patrones de URL entre estas 3 políticas no deben entrar en conflicto.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
CookiesSessionOnlyForUrls.pfm_title = "Restringir las cookies solo para las URL coincidentes en la sesión actual";
CookiesSessionOnlyForUrls.pfm_description = "A menos que establezcas la política RestoreOnStartup para restablecer las URL de sesiones anteriores de forma definitiva, la configuración de CookiesSessionOnlyForUrls te permitirá crear una lista de patrones de URL donde se especifiquen los sitios que pueden y no pueden configurar cookies para una sesión determinada.\n\nSi no estableces la política, se aplicará DefaultCookiesSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario. En el caso de URL que no estén contempladas en los patrones especificados, también se utilizará la configuración predeterminada.\n\nSi bien no prevalece ninguna política específica, consulta CookiesBlockedForUrls y CookiesAllowedForUrls. Los patrones de URL entre estas 3 políticas no deben entrar en conflicto.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
CpuPerformanceTierOverride.pfm_title = "Anulación para el nivel de rendimiento de la CPU";
CpuPerformanceTierOverride.pfm_description = "Si estableces esta política, las empresas podrán anular el valor que devuelve\nCPU Performance API (es decir,\nnavigator.cpuPerformance,\nconsulta https://github.com/WICG/cpu-performance para obtener más detalles).\n\nSi estableces esta política, se anulará el valor de\nnavigator.cpuPerformance\ny se usará el valor especificado. Si no se establece la política, se usa el cálculo predeterminado del nivel de rendimiento.\n\nLos valores posibles para esta política son de 0 a 4.";
CreatePasskeysInICloudKeychain.pfm_title = "Controlar si la creación de llaves de acceso se establecerá de forma predeterminada en el llavero de iCloud";
CreatePasskeysInICloudKeychain.pfm_description = "Brave puede enviar\nlas solicitudes de creación de llaves de acceso o WebAuthn directamente al llavero de iCloud en macOS 13.5\no versiones posteriores. Si aún no se habilitó la sincronización del llavero de iCloud, se le\nsolicitará al usuario que acceda con iCloud o que habilite la sincronización del\nllavero de iCloud.\n\nSi estableces esta política como falsa, no se usará el llavero de iCloud de forma predeterminada\ny se podrá usar el comportamiento anterior (crear la credencial en el perfil de Brave)\nen su lugar. Los usuarios aún podrán seleccionar el llavero de iCloud como opción y\nes posible que sigan viendo las credenciales del llavero de iCloud cuando accedan.\n\nSi la estableces como verdadera, el llavero de iCloud será la configuración predeterminada\ncuando la solicitud de WebAuthn sea compatible con esa opción.\n\nSi no la estableces, la configuración predeterminada dependerá de factores como\nsi iCloud Drive está habilitado y si el usuario usó o\ncreó una credencial en su\nperfil de Brave hace poco.";
CreateThemesSettings.pfm_title = "Configuración de Crear temas con IA";
CreateThemesSettings.pfm_description = "0 - Permitir Create Themes y mejorar los modelos de IA.\n1 - Permitir Create Themes sin mejorar los modelos de IA.\n2 - No permitir Create Themes.\nCreate Themes con IA les permite a los usuarios crear temas y fondos de pantalla personalizados con una selección previa de una lista de opciones.\n\n0 = Permite que se use la función y que Google use datos pertinentes para mejorar sus modelos de IA. Los datos pertinentes pueden incluir instrucciones, entradas, resultados, materiales de origen y comentarios escritos, según la función. Es posible que personas revisen los datos para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los siguientes casos.\n\n1 = Permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (lo que incluye las instrucciones, las entradas, los resultados, los materiales de origen y los comentarios escritos). 1 es el valor predeterminado para los usuarios empresariales que administra Google Admin console y las cuentas de institución educativa que administra Google Workspace.\n\n2 = No permite la función.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
DNSInterceptionChecksEnabled.pfm_title = "Habilitación de las verificaciones de intercepción de DNS";
DNSInterceptionChecksEnabled.pfm_description = "Esta política configura un switch local que se puede usar para inhabilitar las revisiones de intercepción de DNS. Las revisiones intentan detectar si el navegador está detrás de un proxy que redirige nombres de host desconocidos.\n\nEs posible que esta detección no sea necesaria en un entorno empresarial (donde se conoce la configuración de la red), dado que genera una cierta cantidad de tráfico de DNS y HTTP en el inicio y cambia la configuración de cada DNS.\n\nSi no se establece esta política, o está habilitada, se llevarán a cabo las revisiones de intercepción de DNS. Si se inhabilita explícitamente, no se llevarán a cabo.";
DataURLWhitespacePreservationEnabled.pfm_title = "Conservación de espacios en blanco de DataURL para todos los tipos de medio";
DataURLWhitespacePreservationEnabled.pfm_description = "Esta política permite inhabilitar temporalmente los cambios en la forma en que Chrome maneja los espacios en blanco en las URLs de data.\nAnteriormente, los espacios en blanco se conservaban solo si el tipo de medio de nivel superior era text o contenía la cadena de tipo de medio xml.\nAhora, se conservarán los espacios en blanco en todas las URLs de datos, independientemente del tipo de medio.\n\nSi no estableces esta política o la estableces como verdadera, se habilitará el nuevo comportamiento.\n\nSi la estableces como falsa, se habilitará el comportamiento anterior.";
DataUrlInSvgUseEnabled.pfm_title = "Compatibilidad de las URLs de datos con SVGUseElement.";
DataUrlInSvgUseEnabled.pfm_description = "Esta política habilita la compatibilidad de las URLs de datos con SVGUseElement, que se inhabilitará\nde forma predeterminada a partir de M119.\nSi habilitas esta política, las URLs de datos seguirán funcionando en SVGUseElement.\nSi inhabilitas esta política o no la estableces, las URLs de datos no funcionarán en SVGUseElement.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Habilitar orígenes opacos para URLs de datos en Web Workers";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Controla si a los Web Workers creados a partir de URLs de datos se les asigna un origen opaco único.\n\nLos Web Workers se pueden crear con una URL de datos que contenga la secuencia de comandos del Worker. Anteriormente, estos Workers heredaban el origen de la página que los creó, lo que les permitía acceder al mismo almacenamiento local, las mismas cookies y otros datos vinculados al origen. Para mejorar la seguridad y alinearse con la especificación de HTML, Chrome cambiará su comportamiento predeterminado en el hito 149 para que los Workers creados a partir de URLs de datos ahora tengan un origen único y opaco. Esto los aísla de los datos de la página del creador.\n\nSi habilitas esta política o no la estableces, se usará el nuevo comportamiento predeterminado (más seguro), y los Web Workers creados a partir de URLs de datos tendrán un origen opaco único.\n\nSi inhabilitas esta política, Chrome volverá al comportamiento heredado y los Web Workers creados a partir de URLs de datos heredarán el origen de su creador. Esto permite que los administradores resuelvan temporalmente los problemas de compatibilidad si las aplicaciones internas dejan de funcionar debido al cambio de seguridad.\n\nEsta política es temporal y se quitará en el evento importante 157.";
DefaultAutomaticDownloadsSetting.pfm_title = "Configuración predeterminada de descargas automáticas";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Permitir que los sitios descarguen varios archivos automáticamente\n2 - No permitir que ningún sitio descargue varios archivos automáticamente\n3 - Preguntar cada vez que un sitio quiera descargar varios archivos automáticamente\nSi estableces la política en 1, los sitios web podrán descargar varios archivos automáticamente. Si la estableces en 2, se rechazará este permiso. Puedes establecer que la política solicite permiso cada vez que un sitio web quiera descargar varios archivos automáticamente.\n\nSi no la estableces, se aplicará la política AskAutomaticDownloads, pero los usuarios podrán cambiar esta configuración.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Establecer Brave como navegador predeterminado";
DefaultBrowserSettingEnabled.pfm_description = "Si estableces la política como verdadera, Brave revisará siempre al iniciarse si es el navegador predeterminado, y se registrará automáticamente en caso de ser posible. Si la estableces como falsa, Brave dejará de revisar si es el navegador predeterminado, y se desactivarán los controles del usuario para esta opción.\n\nSi no la estableces, Brave permitirá que los usuarios decidan si será el navegador predeterminado y, en caso de no seleccionarlo, si se mostrarán las notificaciones para el usuario.\n\nNota para los administradores de Microsoft®Windows®: Esta opción de configuración solo podrá habilitarse en máquinas con Windows 7. Para las versiones posteriores, el usuario debe implementar un archivo con \"asociaciones de apps predeterminadas\" que convierta a Brave en el controlador de los protocolos https y http (y, opcionalmente, el protocolo ftp y otros formatos de archivo). Consulta la Ayuda de Chrome ( https://support.google.com/chrome?p=make_chrome_default_win).";
DefaultClipboardSetting.pfm_title = "Configuración predeterminada del portapapeles";
DefaultClipboardSetting.pfm_description = "2 - No permitir que ningún sitio use el permiso para sitios del portapapeles\n3 - Permitir que los sitios soliciten al usuario el permiso para sitios del portapapeles\nSi estableces la política en 2, los sitios no podrán usar el permiso para sitios del portapapeles. Si la estableces en 3 o no la estableces, el usuario podrá cambiar la configuración y decidir si las APIs del portapapeles estarán disponibles cuando un sitio quiera usarlas.\n\nEsta política puede anularse para patrones de URL específicos a través de las políticas ClipboardAllowedForUrls y ClipboardBlockedForUrls.\n\nEsta política solo afecta las operaciones del portapapeles que están controladas por el permiso para sitios del portapapeles. No afecta las interacciones seguras del portapapeles.";
DefaultCookiesSetting.pfm_title = "Configuración de cookies predeterminada";
DefaultCookiesSetting.pfm_description = "1 - Permitir a todos los sitios establecer datos locales\n2 - No permitir que ningún sitio configure los datos locales.\n4 - Guardar las cookies durante la sesión\nA menos que establezcas la política RestoreOnStartup para restablecer las URL de sesiones anteriores de forma definitiva, la configuración de CookiesSessionOnlyForUrls te permitirá crear una lista de patrones de URL donde se especifiquen los sitios que pueden y no pueden configurar cookies para una sesión determinada.\n\nSi no estableces la política, se aplicará DefaultCookiesSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario. En el caso de URL que no estén contempladas en los patrones especificados, también se utilizará la configuración predeterminada.\n\nSi bien no prevalece ninguna política específica, consulta CookiesBlockedForUrls y CookiesAllowedForUrls. Los patrones de URL entre estas 3 políticas no deben entrar en conflicto.";
DefaultDownloadDirectory.pfm_title = "Establecer el directorio de descarga predeterminado";
DefaultDownloadDirectory.pfm_description = "Si estableces la política, se modificará el directorio predeterminado donde Chrome descarga los archivos, pero los usuarios podrán cambiar el directorio.\n\nSi no estableces la política, Chrome utilizará el directorio predeterminado específico de la plataforma.\n\nLa política no tiene efecto si se configura la política DownloadDirectory.\n\nNota: Consulta la lista de las variables que puedes utilizar (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DefaultFileSystemReadGuardSetting.pfm_title = "Controla el uso de la API de File System para lectura";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - No permite que ningún sitio solicite acceso de lectura a archivos y directorios a través de la API de File System\n3 - Permite que los sitios soliciten al usuario acceso de lectura a archivos y directorios a través de la API de File System\nSi estableces la política en 3, los sitios web podrán solicitar acceso de lectura a archivos y directorios en el sistema de archivos del sistema operativo del host a través de la API de File System. Si la estableces en 2, se rechazará el acceso.\n\nSi no la estableces, los sitios web podrán solicitar acceso, pero los usuarios también podrán cambiar esta configuración.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Controla el uso de la API de File System para escritura";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - No permite que ningún sitio solicite acceso de escritura a archivos ni directorios\n3 - Permite que los sitios soliciten al usuario acceso de escritura a archivos y directorios\nSi estableces la política en 3, los sitios web podrán solicitar acceso de escritura a archivos y directorios en el sistema de archivos del sistema operativo del host. Si la estableces en 2, se rechazará el acceso.\n\nSi no la estableces, los sitios web podrán solicitar acceso, pero los usuarios también podrán cambiar esta configuración.";
DefaultGeolocationSetting.pfm_title = "Configuración de geolocalización predeterminada";
DefaultGeolocationSetting.pfm_description = "1 - Permitir a los sitios que rastreen la ubicación física de los usuarios.\n2 - No permitir que ningún sitio rastree la ubicación física de los usuarios.\n3 - Preguntar siempre si un sitio quiere rastrear la ubicación física de los usuarios.\nSi estableces la política en 1, los sitios podrán hacer un seguimiento de la ubicación física de los usuarios de forma predeterminada. Si la estableces en 2, se rechazará el seguimiento de forma predeterminada. Puedes establecer que la política solicite permiso cada vez que un sitio quiera hacer un seguimiento de la ubicación física de los usuarios.\n\nSi no la estableces, se aplicará la política AskGeolocation, pero los usuarios podrán cambiar esta configuración.";
DefaultIdleDetectionSetting.pfm_title = "Detección de inactividad";
DefaultIdleDetectionSetting.pfm_description = "1 - Permitir que los sitios detecten el estado de inactividad sin preguntarle al usuario\n2 - No permitir que ningún sitio detecte el estado de inactividad del usuario\n3 - Preguntar siempre que un sitio quiera detectar el estado de inactividad del usuario\nTe permite establecer si los sitios web pueden usar la API de Idle Detection.\n\nCuando esta política se establece en 1 (AllowIdleDetection), los sitios web pueden usar la API sin pedir permiso al usuario.\n\nSi estableces esta política en 2 (BlockIdleDetection), los sitios web no podrán usar la API, independientemente del permiso del usuario.\n\nSi estableces esta política en 3 (AskIdleDetection) o no la estableces, los sitios web no podrán usar la API sin el permiso del usuario.";
DefaultImagesSetting.pfm_title = "Configuración de imágenes predeterminadas";
DefaultImagesSetting.pfm_description = "1 - Permitir a todos los sitios que muestren todas las imágenes\n2 - No permitir que ningún sitio muestre imágenes.\nSi estableces la política en 1, todos los sitios web podrán mostrar imágenes. Si la estableces en 2, no se podrán mostrar imágenes.\n\nSi no la estableces, se podrán mostrar imágenes, pero los usuarios podrán cambiar esta configuración.";
DefaultInsecureContentSetting.pfm_title = "Controla el uso de excepciones de contenido no seguro";
DefaultInsecureContentSetting.pfm_description = "2 - No permitir que ningún sitio cargue contenido mixto\n3 - Permitir que los usuarios agreguen excepciones para habilitar contenido mixto\nPermite establecer si los usuarios pueden agregar excepciones para habilitar contenido mixto en sitios específicos.\n\nEsta política puede anularse para patrones de URL específicos mediante las políticas \"InsecureContentAllowedForUrls\" y \"InsecureContentBlockedForUrls\".\n\nSi no estableces esta política, los usuarios podrán agregar excepciones para permitir contenido mixto bloqueable y podrán inhabilitar las actualizaciones automáticas para el contenido mixto bloqueable de forma opcional.";
DefaultJavaScriptJitSetting.pfm_title = "Controlar el uso de JavaScript con JIT";
DefaultJavaScriptJitSetting.pfm_description = "1 - Permitir que cualquier sitio ejecute JavaScript con JIT\n2 - No permitir que cualquier sitio ejecute JavaScript con JIT\nTe permite establecer si Brave ejecutará el motor v8 de JavaScript con el compilador JIT (Just In Time) habilitado o inhabilitado.\n\nSi inhabilitas JavaScript con JIT, es posible que Brave procese el contenido web más lentamente y, además, inhabilite partes de JavaScript, incluido WebAssembly. Si inhabilitas JavaScript con JIT, Brave podría procesar el contenido web en una configuración más segura.\n\nEsta política puede anularse para patrones de URL específicos a través de las políticas de JavaScriptJitAllowedForSites y JavaScriptJitBlockedForSites.\n\nSi no estableces esta política, se habilitará JavaScript con JIT.";
DefaultJavaScriptOptimizerSetting.pfm_title = "Controlar el uso de optimizadores de JavaScript";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Habilitar las optimizaciones avanzadas de JavaScript en todos los sitios\n2 - Inhabilitar las optimizaciones avanzadas de JavaScript en todos los sitios\nTe permite establecer si Brave\nejecutará el motor v8 de JavaScript con las optimizaciones de JavaScript más avanzadas habilitadas.\n\nSi inhabilitas las optimizaciones de JavaScript (estableciendo el valor de esta política como 2),\nes posible que Brave renderice el contenido web\nmás lentamente.\n\nEsta política puede anularse para patrones de URL específicos a través de las políticas JavaScriptOptimizerAllowedForSites y JavaScriptOptimizerBlockedForSites.\n\nSi no estableces esta política, se habilitarán las optimizaciones de JavaScript.";
DefaultJavaScriptSetting.pfm_title = "Configuración de JavaScript predeterminada";
DefaultJavaScriptSetting.pfm_description = "1 - Permitir que todos los sitios ejecuten JavaScript\n2 - No permitir que los sitios ejecuten JavaScript.\nSi estableces la política en 1, los sitios web podrán ejecutar JavaScript. Si la estableces en 2, se rechazará JavaScript.\n\nSi no la estableces, se podrá ejecutar JavaScript, pero los usuarios podrán cambiar esta configuración.";
DefaultLocalFontsSetting.pfm_title = "Configuración predeterminada del permiso de fuentes locales";
DefaultLocalFontsSetting.pfm_description = "2 - Rechazar el permiso de fuentes locales para todos los sitios de forma predeterminada\n3 - Preguntar siempre que un sitio quiera obtener el permiso de fuentes locales\nSi estableces la política con el valor BlockLocalFonts (valor 2), se rechazará automáticamente el permiso de fuentes locales para los sitios de forma predeterminada. Esto limitará la capacidad de los sitios para ver la información sobre las fuentes locales.j\n\nSi estableces la política con el valor AskLocalFonts (valor 3), se notificará al usuario cuando se solicite el permiso de fuentes locales de forma predeterminada. Si los usuarios otorgan el permiso, se ampliará la capacidad de los sitios para ver la información sobre las fuentes locales.\n\nSi no estableces la política, se aplicará el comportamiento predeterminado por el cual se notifica al usuario. Los usuarios pueden cambiar esta configuración.";
DefaultNotificationsSetting.pfm_title = "Configuración de notificación predeterminada";
DefaultNotificationsSetting.pfm_description = "1 - Permitir que los sitios muestren notificaciones de escritorio.\n2 - No permitir que los sitios muestren notificaciones de escritorio.\n3 - Preguntar siempre que un sitio quiera mostrar notificaciones de escritorio.\nSi estableces la política en 1, los sitios web podrán mostrar notificaciones de escritorio. Si la estableces en 2, se rechazarán las notificaciones de escritorio.\n\nSi no la estableces, se aplicará la política AskNotifications, pero los usuarios podrán cambiar esta configuración.";
DefaultPopupsSetting.pfm_title = "Configuración predeterminada de ventanas emergentes";
DefaultPopupsSetting.pfm_description = "1 - Permitir que todos los sitios muestren ventanas emergentes.\n2 - No permitir que ningún sitio muestre ventanas emergentes\nSi estableces la política en 1, los sitios web podrán mostrar ventanas emergentes. Si la estableces en 2, se rechazarán las ventanas emergentes.\n\nSi no la estableces, se aplicará la política BlockPopups, pero los usuarios podrán cambiar esta configuración.";
DefaultPrinterSelection.pfm_title = "Normas de selección de la impresora predeterminada";
DefaultPrinterSelection.pfm_description = "Si estableces la política, se determinarán las reglas para seleccionar la impresora predeterminada en Brave y se anularán las reglas predeterminadas. Los usuarios eligen la impresora la primera vez que realizan una impresión, cuando Brave busca una impresora que coincida con los atributos especificados. En caso de no haber una coincidencia perfecta, podrá determinarse que Brave seleccione cualquier impresora que coincida con la política, en función del orden en el que se detectaron.\n\nSi no estableces la política o la estableces según los atributos cuando no hay coincidencias, la impresora PDF integrada será la predeterminada. Si no hay impresora PDF, Brave no seleccionará ninguna como predeterminada.\n\nActualmente, todas las impresoras se clasifican como \"local\". Las impresoras conectadas a Google Cloud Print se consideran \"cloud\", pero ya no se admite Google Cloud Print.\n\nNota: Si se omite un campo, todos los valores coincidirán con ese campo en particular. Por ejemplo, si no se especifica idPattern significa que la vista previa de impresión acepta todos los ID de impresora. Los patrones de las expresiones regulares deben seguir la sintaxis de JavaScript RegExp, y las coincidencias distinguen entre mayúsculas y minúsculas.\nConsulta https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection para obtener más información sobre el esquema y el formato.";
DefaultSearchProviderAlternateURLs.pfm_title = "Lista de las URL alternativas para el proveedor de búsqueda predeterminado";
DefaultSearchProviderAlternateURLs.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderAlternateURLs especificará una lista de URL alternativas para extraer términos de búsqueda del motor de búsqueda. Las URL deben incluir la string '{searchTerms}'.\n\nSi no estableces DefaultSearchProviderAlternateURLs, no se usará ninguna URL alternativa para extraer términos de búsqueda.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Permite realizar búsquedas con el proveedor de búsqueda predeterminado a través del menú contextual";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "Permite el uso de un proveedor de búsqueda predeterminado a través del menú contextual.\n\nSi inhabilitas esta política, no estará disponible el elemento del menú contextual de búsqueda destinado al proveedor de búsqueda predeterminado.\n\nSi inhabilitas esta política o no la estableces, estará disponible el elemento del menú contextual destinado a tu proveedor de búsqueda predeterminado.\n\nSolo se aplica el valor de la política cuando habilitas DefaultSearchProviderEnabled, y no se aplica en caso contrario.";
DefaultSearchProviderEnabled.pfm_title = "Habilitar el proveedor de búsqueda predeterminado";
DefaultSearchProviderEnabled.pfm_description = "Si habilitas la política, se realizará una búsqueda predeterminada cuando el usuario ingrese texto que no sea una URL en la barra de direcciones. Para especificar el proveedor de búsqueda predeterminado, establece el resto de las políticas para la búsqueda predeterminada. Si dejas vacías esas políticas, el usuario podrá elegir el proveedor predeterminado. Si inhabilitas la política, no se realizará ninguna búsqueda cuando el usuario ingrese texto que no sea una URL en la barra de direcciones. El valor inhabilitado no es compatible con Google Admin console.\n\nSi estableces esta política, los usuarios no podrán cambiarla en Brave. Si no la estableces, se habilitará el proveedor de búsqueda predeterminado, y los usuarios podrán establecer la lista de proveedores de búsqueda.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
DefaultSearchProviderEncodings.pfm_title = "Codificación del proveedor de búsqueda predeterminado";
DefaultSearchProviderEncodings.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderEncodings especificará la codificación de caracteres que admite el proveedor de búsqueda. Las codificaciones son nombres de página de código como UTF-8, GB2312 y ISO-8859-1. Estos se prueban en el orden establecido.\n\nSi no estableces DefaultSearchProviderEncodings, se utilizará UTF-8.";
DefaultSearchProviderImageURL.pfm_title = "Parámetro que proporciona una función de búsqueda por imagen para el proveedor de búsquedas predeterminado";
DefaultSearchProviderImageURL.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderImageURL especificará la URL del motor de búsqueda utilizado para la búsqueda de imágenes. (Si estableces DefaultSearchProviderImageURLPostParams, las solicitudes de búsqueda de imágenes utilizarán el método POST en su lugar).\n\nSi no estableces DefaultSearchProviderImageURL, no se utilizarán métodos de búsqueda de imágenes.\n\nSi la búsqueda con imágenes usa el método GET, la URL debe especificar\nparámetros de imagen con una combinación válida de los siguientes marcadores de posición:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "Parámetros para URL de imagen que utiliza POST";
DefaultSearchProviderImageURLPostParams.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderImageURLPostParams especificará los parámetros durante la búsqueda de imágenes con POST. Se compone de pares de nombre y valor separados por comas. Si un valor es un parámetro de plantilla, como {imageThumbnail}, se reemplazará por datos de miniaturas de imágenes reales.\n\nSi no estableces DefaultSearchProviderImageURLPostParams, se enviarán las solicitudes de búsqueda de imágenes con el método GET.\n\nLa URL debe especificar el parámetro de imagen con una combinación válida de\nlos siguientes marcadores de posición, según lo que admita el proveedor de búsqueda:\n'{google:imageURL}',\n'{google:imageOriginalHeight}',\n'{google:imageOriginalWidth}',\n'{google:processedImageDimensions}',\n'{google:imageSearchSource}',\n'{google:imageThumbnail}',\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Palabra clave del proveedor de búsqueda predeterminado";
DefaultSearchProviderKeyword.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderKeyword especificará la palabra clave o el atajo que se utilizará en la barra de direcciones para activar la búsqueda de este proveedor.\n\nSi no estableces DefaultSearchProviderKeyword, no se activará el proveedor de búsqueda con ninguna palabra clave.";
DefaultSearchProviderName.pfm_title = "Nombre del proveedor de búsqueda predeterminado";
DefaultSearchProviderName.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderName especificará el nombre del proveedor de búsqueda predeterminado.\n\nSi no estableces DefaultSearchProviderName, se utilizará el nombre de host especificado por la URL de búsqueda.";
DefaultSearchProviderNewTabURL.pfm_title = "URL de la página Nueva pestaña del proveedor de búsqueda predeterminado";
DefaultSearchProviderNewTabURL.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderNewTabURL especificará la URL del motor de búsqueda utilizado para proporcionar una página Nueva pestaña.\n\nSi no estableces DefaultSearchProviderNewTabURL, no se proporcionará ninguna página Nueva pestaña.";
DefaultSearchProviderSearchURL.pfm_title = "Dirección URL de búsqueda de proveedores de búsqueda predeterminada";
DefaultSearchProviderSearchURL.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderSearchURL especificará la URL del motor de búsqueda utilizado en una búsqueda predeterminada. La URL debe incluir la string '{searchTerms}', que se reemplazará en la búsqueda por los términos del usuario.\n\nPuedes especificar la URL de búsqueda de Google de la siguiente manera: '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "Parámetros para URL de búsqueda que utiliza POST";
DefaultSearchProviderSearchURLPostParams.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderSearchURLPostParams especificará los parámetros para la búsqueda de una URL con POST. Se compone de pares de nombre y valor separados por comas. Si un valor es un parámetro de plantilla, como '{searchTerms}', se reemplazará por datos de términos de búsqueda reales.\n\nSi no estableces DefaultSearchProviderSearchURLPostParams, se enviarán solicitudes de búsqueda con el método GET.";
DefaultSearchProviderSuggestURL.pfm_title = "Dirección URL sugerida para el proveedor de búsqueda predeterminado";
DefaultSearchProviderSuggestURL.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderSuggestURL especificará la URL del motor de búsqueda para proporcionar sugerencias de búsqueda. La URL debe incluir la string '{searchTerms}', que se reemplazará en la búsqueda por los términos del usuario.\n\nPuedes especificar la URL de búsqueda de Google de la siguiente manera: '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "Parámetros para URL de sugerencia que utiliza POST";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "Si activas DefaultSearchProviderEnabled, establecer DefaultSearchProviderSuggestURLPostParams especificará los parámetros durante la búsqueda de sugerencias con POST. Se compone de pares de nombre y valor separados por comas. Si un valor es un parámetro de plantilla, como '{searchTerms}', se reemplazará por datos de términos de búsqueda reales.\n\nSi no estableces DefaultSearchProviderSuggestURLPostParams, se enviarán las solicitudes de búsqueda de sugerencias con el método GET.";
DefaultSensorsSetting.pfm_title = "Configuración predeterminada de los sensores";
DefaultSensorsSetting.pfm_description = "1 - Permite que los sitios accedan a los sensores\n2 - No permite que ningún sitio acceda a los sensores\n3 - Preguntar cada vez que un sitio quiera acceder a los sensores\nSi la estableces en 1, los sitios web podrán acceder a los sensores y usarlos, como los de movimiento y luz. Si la estableces en 2, se negará el acceso a los sensores. Si estableces la política en 3, se le preguntará al usuario cuando un sitio solicite acceso a los sensores si se habilitó la marca de función de tres estados. De lo contrario, se permitirá el acceso a los sensores de forma predeterminada.\n\nSi no la estableces, se aplicará la política AllowSensors, pero los usuarios podrán cambiar esta configuración.";
DefaultSerialGuardSetting.pfm_title = "Controla el uso de la API de Serial";
DefaultSerialGuardSetting.pfm_description = "2 - No permite que ningún sitio solicite acceso a puertos en serie a través de la API de Serial\n3 - Permite que los sitios soliciten al usuario acceso a un puerto en serie\nSi estableces la política en 3, los sitios web podrán solicitar acceso a los puertos en serie. Si la estableces en 2, se rechaza el acceso a los puertos en serie.\n\nSi no la estableces, los sitios web podrán solicitar acceso, pero los usuarios podrán cambiar esta configuración.";
DefaultWebBluetoothGuardSetting.pfm_title = "Controlar el uso de la API de Bluetooth web";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - No permitir que ningún sitio solicite acceso a dispositivos Bluetooth mediante la API de Bluetooth web\n3 - Permitir que los sitios soliciten permiso al usuario para acceder a un dispositivo Bluetooth cercano\nSi estableces la política en 3, los sitios web podrán solicitar acceso a dispositivos Bluetooth cercanos. Si la estableces en 2, se negará el acceso a dispositivos Bluetooth cercanos.\n\nSi no la estableces, los sitios podrán solicitar acceso, pero los usuarios podrán cambiar esta configuración.";
DefaultWebHidGuardSetting.pfm_title = "Controlar el uso de la API de WebHID";
DefaultWebHidGuardSetting.pfm_description = "2 - No permitir que ningún sitio solicite acceso a los dispositivos HID a través de la API de WebHID\n3 - Permitir que los sitios soliciten al usuario acceso a un dispositivo HID\nSi estableces la política en 3, los sitios web podrán solicitar acceso a los dispositivos HID. Si estableces la política en 2, los sitios no podrán acceder a los dispositivos HID.\n\nSi no la estableces, los sitios web podrán solicitar acceso, pero los usuarios podrán cambiar esta configuración.\n\nEsta política puede anularse para patrones de urlespecíficos a través de las políticas de WebHidAskForUrls y WebHidBlockedForUrls.";
DefaultWebUsbGuardSetting.pfm_title = "Controla el uso de la API de WebUSB";
DefaultWebUsbGuardSetting.pfm_description = "2 - No permitir que ningún sitio solicite acceso a dispositivos USB a través de la API de WebUSB\n3 - Permite que los sitios soliciten al usuario que otorgue acceso a un dispositivo USB conectado\nSi estableces la política en 3, los sitios web podrán solicitar acceso a dispositivos USB conectados. Si la estableces en 2, se negará el acceso a dispositivos USB conectados.\n\nSi no la estableces, los sitios web podrán solicitar acceso, pero los usuarios podrán cambiar esta configuración.";
DefaultWindowManagementSetting.pfm_title = "Configuración predeterminada del permiso de Administración de ventanas";
DefaultWindowManagementSetting.pfm_description = "2 - Rechazar el permiso de Administración de ventanas para todos los sitios de forma predeterminada\n3 - Preguntar siempre que un sitio quiera obtener el permiso de Administración de ventanas\nSi estableces la política como BlockWindowManagement (valor 2), se rechazará automáticamente el permiso de administración de ventanas para todos los sitios de forma predeterminada. Esto limitará la capacidad de los sitios para ver la información sobre las pantallas del dispositivo y utilizarla para abrir y ubicar ventanas o solicitar el modo pantalla completa en pantallas específicas.\n\nSi estableces la política como AskWindowManagement (valor 3), se notificará al usuario cuando el permiso de administración de ventanas se solicite de forma predeterminada. Si los usuarios otorgan el permiso, se ampliará la capacidad de los sitios para ver la información sobre las pantallas del dispositivo y utilizarla para abrir y ubicar ventanas o solicitar el modo pantalla completa en pantallas específicas.\n\nSi no la estableces, se aplicará la política AskWindowManagement, pero los usuarios podrán cambiar esta configuración.\n\nEsto reemplaza la política DefaultWindowPlacementSetting, que dejó de estar disponible.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Habilitar la opción para borrar las contraseñas que no se pueden desencriptar";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Esta política controla si el administrador de contraseñas integrado puede borrar contraseñas que no se pueden desencriptar de su base de datos. Esto es necesario para restablecer la funcionalidad completa del administrador de contraseñas integrado, pero puede incluir la pérdida permanente de datos. Los valores de contraseñas que no se pueden desencriptar no se desencriptarán por sí solos y, si es posible corregirlos, generalmente se requieren acciones complejas del usuario.\n\nSi habilitas la política o no la estableces, los usuarios que hayan guardado contraseñas que no se pueden desencriptar en el administrador de contraseñas integrado las perderán. Las contraseñas que aún estén en funcionamiento no se modificarán.\n\nSi inhabilitas la política, los datos del administrador de contraseñas de los usuarios no se verán afectados, pero la funcionalidad del administrador de contraseñas estará dañada.\n\nSi estableces esta política, los usuarios no podrán cambiarla en Brave.";
DesktopSharingHubEnabled.pfm_title = "Habilitar el uso compartido del escritorio en el cuadro multifunción y el menú de 3 puntos";
DesktopSharingHubEnabled.pfm_description = "Si estableces la política como verdadera o no la estableces, los usuarios podrán compartir o guardar la página web actual mediante acciones proporcionadas por el centro para compartir el escritorio. Se puede acceder al centro para compartir a través del cuadro multifunción o el menú de 3 puntos.\n\nSi estableces la política como falsa, dejará de estar disponible el ícono para compartir en el cuadro multifunción y en el menú de 3 puntos.";
DevToolsGenAiSettings.pfm_title = "Configuración de las funciones potenciadas por IA generativa de Chrome DevTools";
DevToolsGenAiSettings.pfm_description = "0 - Permitir las funciones potenciadas por IA generativa de Chrome DevTools y mejorar los modelos de IA.\n1 - Permitir las funciones potenciadas por IA generativa de Chrome DevTools sin mejorar los modelos de IA.\n2 - No permitir las funciones potenciadas por IA generativa de Chrome DevTools.\nEstas funciones de Chrome DevTools emplean modelos de IA generativa para proporcionar información de depuración adicional. Para usar estas funciones, Brave tiene que recopilar datos como mensajes de error, seguimientos de pila, fragmentos de código y solicitudes de red, y enviarlos a un servidor de Google que ejecuta un modelo de IA generativa. Los datos que se envían al servidor no incluyen el cuerpo de la respuesta ni los encabezados de autenticación y de cookies.\n\n0 = Permite que se use la función y que Google use datos pertinentes para mejorar sus modelos de IA. Los datos pertinentes pueden incluir instrucciones, entradas, resultados, materiales de referencia y comentarios escritos, según la función. Es posible que personas revisen los datos para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los siguientes casos.\n\n1 = Permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (lo que incluye las instrucciones, las entradas, los resultados, los materiales de referencia y los comentarios escritos). 1 es el valor predeterminado para los usuarios empresariales que administra Google Admin console y las cuentas de institución educativa que administra Google Workspace.\n\n2 = No permite la función.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nLas funciones potenciadas por IA generativa de Chrome DevTools incluyen:\n\n- Estadísticas de la consola: Explica los mensajes de la consola y ofrece sugerencias para corregir errores.\n\n- Asistencia de IA: Obtén ayuda para comprender los estilos de CSS (desde la versión 131), las solicitudes de red, el rendimiento y los archivos (todos desde la versión 132).\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Habilitar los perfiles de Google Developer Program en Chrome DevTools.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Habilitar la integración de Google Developer Program en Chrome DevTools.\n1 - Habilitar la integración de Google Developer Program en Chrome DevTools, pero sin compartir el uso de la herramienta (para otorgar insignias).\n2 - No habilitar la integración de Google Developer Program en Chrome DevTools.\nEsta política controla la integración de Google Developer Program con Chrome DevTools. El perfil del usuario en Google Developer Program se muestra en Chrome DevTools, y los usuarios reciben insignias por realizar acciones específicas en Chrome DevTools.\n\nSi estableces la política en 0 - \"Habilitada\" o no estableces ningún valor de política, se permitirá la integración de Google Developer Program con Chrome DevTools y se permitirá compartir el uso de la herramienta Chrome DevTools para poder otorgar insignias.\n\nSi estableces la política en 1 - \"Habilitada sin insignias\", se permite la integración de Google Developer Program con Chrome DevTools, pero no se permite compartir el uso de la herramienta Chrome DevTools con Google Developer Program. No se otorgarán insignias.\n\nSi estableces la política en 2 - \"Inhabilitada\", no se permitirá la integración de Google Developer Program con Chrome DevTools.";
DeveloperToolsAvailability.pfm_title = "Controla dónde se puede usar Chrome DevTools";
DeveloperToolsAvailability.pfm_description = "0 - No permitir el uso de Chrome DevTools en extensiones y apps instaladas por una política empresarial ni, a partir de la versión 114 y si es un usuario administrado, extensiones integradas en el navegador. Permitir el uso de Chrome DevTools en otros contextos\n1 - Permitir el uso de Chrome DevTools\n2 - No permitir el uso de Chrome DevTools\nSi le asignas a la política el valor \"0\" (la opción predeterminada), podrás acceder a las Chrome DevTools y la Consola de JavaScript. No obstante, no podrás hacerlo en el contexto de extensiones instaladas por una política empresarial ni, a partir de la versión 114 y si es un usuario administrado, de extensiones integradas en el navegador. Si le asignas a la política el valor \"1\", podrás acceder las Chrome DevTools y a la Consola de JavaScript en todos los contextos, incluido el de extensiones instaladas por una política empresarial. Si le asignas a la política el valor \"2\", no podrás acceder a las Chrome DevTools ni inspeccionar elementos de sitios web.\n\nEste parámetro de configuración también desactivará las combinaciones de teclas y las entradas del menú contextual o de cualquier menú que permiten abrir las Chrome DevTools o la Consola de JavaScript.\n\nA partir de la versión 99 de Brave, esta configuración también controla los puntos de entrada de la función \"Ver el código fuente de la página\". Si estableces esta política como \"DeveloperToolsDisallowed\" (valor 2), los usuarios no podrán ver los códigos fuente de las páginas mediante una combinación de teclas ni el menú contextual. Para bloquear la vista de los códigos fuente, debes agregar \"view-source:*\" a la política URLBlocklist.\n\nA partir de la versión 119 de Brave, este parámetro de configuración también controla si se puede activar y usar el modo de desarrollador para apps web aisladas.\n\nA partir de la versión 128 de Brave, este parámetro de configuración no controla el modo de desarrollador en la página de extensiones si se establece la política ExtensionDeveloperModeSettings.\n\nEsta política afecta a Chrome DevTools, al acceso directo al Protocolo de Herramientas para desarrolladores de Chrome (CDP) (por ejemplo, cuando se inicia con --remote-debugging-port o --remote-debugging-pipe) y al acceso al CDP a través de las APIs de chrome.debugger. Se aplican tanto esta política como la política RemoteDebuggingAllowed: RemoteDebuggingAllowed controla si se puede iniciar la depuración remota, mientras que esta política restringe si se pueden inspeccionar los objetivos individuales, incluso cuando se está ejecutando la depuración remota.\n\nLas políticas DeveloperToolsAvailabilityAllowlist y DeveloperToolsAvailabilityBlocklist tienen prioridad sobre esta política. La disponibilidad de Chrome DevTools se determina en el siguiente orden de prioridad:\n\n1. Si una URL coincide con un patrón de la política DeveloperToolsAvailabilityAllowlist, se permiten las Chrome DevTools.\n2. Si se establece DeveloperToolsAvailabilityAllowlist y no se establece DeveloperToolsAvailabilityBlocklist, se bloquea cualquier URL que no esté en la lista de entidades permitidas.\n3. Si una URL coincide con un patrón de la política DeveloperToolsAvailabilityBlocklist, se bloquearán las Chrome DevTools.\n4. Si no se establece ninguna de las políticas o si una URL no coincide con ninguna de las listas, se usará esta política (DeveloperToolsAvailability) como mecanismo de resguardo.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Lista de patrones de URLs para los que se permite abrir Chrome DevTools";
DeveloperToolsAvailabilityAllowlist.pfm_description = "Esta política se puede usar para permitir Chrome DevTools en URLs específicas.\n\nLa disponibilidad de Chrome DevTools se evalúa a nivel del destino. Los patrones de URLs se comparan con la URL de cada destino que se inspecciona (como el marco principal de una página, un submarco incorporado, una extensión o una aplicación web). El comportamiento resultante depende de si también se establece la política DeveloperToolsAvailabilityBlocklist.\n\nSi estableces esta política y no estableces DeveloperToolsAvailabilityBlocklist, la URL de un destino debe coincidir con un patrón de esta lista de entidades permitidas para que se permita Chrome DevTools en ese destino. Si la URL de un destino no coincide con esta lista de entidades permitidas, se bloqueará Chrome DevTools para ese destino (por ejemplo, no se puede inspeccionar un submarco cuya URL no esté en la lista de entidades permitidas, pero la página principal se puede inspeccionar si su URL está en la lista de entidades permitidas). Para obtener información sobre el formato de las URLs, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSi se establecen esta política y la política DeveloperToolsAvailabilityBlocklist, esta lista de entidades permitidas tendrá prioridad. Si la URL de un destino coincide con un patrón de esta lista de direcciones permitidas, se permitirá, incluso si también coincide con un patrón de la lista de direcciones bloqueadas. Si la URL de un destino coincide con un patrón de esta lista de direcciones bloqueadas (pero no con la lista de direcciones permitidas), se bloqueará. Si la URL de un destino no coincide con ninguna, se usará la política DeveloperToolsAvailability como alternativa.\n\nSi no estableces esta política, la disponibilidad de Chrome DevTools se determinará según las políticas DeveloperToolsAvailabilityBlocklist y DeveloperToolsAvailability.\n\nLos comodines de host generales (p. ej., \"*\" o \"[*]\") no están permitidos; usa la política DeveloperToolsAvailability para habilitar la función de forma global.\n\nEsta política afecta a Chrome DevTools, al acceso directo al Protocolo de Herramientas para desarrolladores de Chrome (CDP) (por ejemplo, cuando se inicia con --remote-debugging-port o --remote-debugging-pipe) y al acceso al CDP a través de las APIs de chrome.debugger. Se aplican tanto esta política como la política RemoteDebuggingAllowed: RemoteDebuggingAllowed controla si se puede iniciar la depuración remota, mientras que esta política restringe si se pueden inspeccionar los objetivos individuales, incluso cuando se está ejecutando la depuración remota.\n\nEsta política se limitará a 1,000 entradas.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Lista de patrones de URLs para los que se bloquean las Chrome DevTools";
DeveloperToolsAvailabilityBlocklist.pfm_description = "Esta política se puede usar para bloquear Chrome DevTools en URLs específicas. Para obtener información sobre el formato de las URLs, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nLa disponibilidad de Chrome DevTools se evalúa a nivel del destino. Los patrones de URLs se comparan con la URL de cada destino que se inspecciona (como el marco principal de una página, un submarco incorporado, una extensión o una aplicación web). El comportamiento resultante depende de si también se establece la política DeveloperToolsAvailabilityAllowlist.\n\nSi estableces esta política y no estableces DeveloperToolsAvailabilityAllowlist, se bloqueará Chrome DevTools para un destino si su URL coincide con un patrón de esta lista de URLs bloqueadas (por ejemplo, no se puede inspeccionar un submarco cuya URL coincida con esta lista de URLs bloqueadas, pero la página principal se puede inspeccionar si su URL no está bloqueada). Si la URL de un destino no coincide con ningún patrón, la disponibilidad se determina según la política DeveloperToolsAvailability.\n\nSi se establecen esta política y la política DeveloperToolsAvailabilityAllowlist, la lista de entidades permitidas tendrá prioridad. Si la URL de un destino coincide con un patrón de la lista de direcciones permitidas, se permitirá, incluso si también coincide con un patrón de esta lista de direcciones bloqueadas. Si la URL de un destino coincide con un patrón de esta lista de direcciones bloqueadas (pero no con la lista de direcciones permitidas), se bloqueará. Si la URL de un destino no coincide con ninguna, se usará la política DeveloperToolsAvailability como alternativa.\n\nSi no estableces esta política, la disponibilidad de Chrome DevTools se determinará según las políticas DeveloperToolsAvailabilityAllowlist y DeveloperToolsAvailability.\n\nEsta política afecta a Chrome DevTools, al acceso directo al Protocolo de Herramientas para desarrolladores de Chrome (CDP) (por ejemplo, cuando se inicia con --remote-debugging-port o --remote-debugging-pipe) y al acceso al CDP a través de las APIs de chrome.debugger. Se aplican tanto esta política como la política RemoteDebuggingAllowed: RemoteDebuggingAllowed controla si se puede iniciar la depuración remota, mientras que esta política restringe si se pueden inspeccionar los objetivos individuales, incluso cuando se está ejecutando la depuración remota.\n\nEsta política se limitará a 1,000 entradas.";
Disable3DAPIs.pfm_title = "Inhabilitar la admisión de API gráficas en 3D";
Disable3DAPIs.pfm_description = "Si estableces la política como verdadera (o estableces HardwareAccelerationModeEnabled como falsa), las páginas web no podrán acceder a la API de WebGL.\n\nSi la estableces como falsa o no la estableces, los sitios web podrán usar la API de WebGL, pero es posible que la configuración predeterminada del navegador aún requiera que los argumentos de línea de comandos utilicen estas API.";
DisableAuthNegotiateCnameLookup.pfm_title = "Inhabilitar la búsqueda de CNAME al negociar la autenticación de Kerberos";
DisableAuthNegotiateCnameLookup.pfm_description = "Si habilitas la política, se omitirá la búsqueda de CNAME. Se usará el nombre del servidor tal como se haya introducido al generar el SPN de Kerberos.\n\nSi inhabilitas la política o no la estableces, la búsqueda de CNAME determinará el nombre canónico del servidor al generar el SPN de Kerberos.";
DisablePrintPreview.pfm_title = "Inhabilitar vista previa de impresión";
DisablePrintPreview.pfm_description = "Si habilitas la política, Brave abrirá el diálogo de impresión del sistema en lugar de la vista previa de impresión integrada cuando los usuarios soliciten realizar una impresión.\n\nSi la inhabilitas o no la estableces, los comandos de impresión mostrarán la pantalla de vista previa de impresión.";
DisableSafeBrowsingProceedAnyway.pfm_title = "Inhabilita continuar desde la página de advertencia de Navegación segura.";
DisableSafeBrowsingProceedAnyway.pfm_description = "Si habilitas la política, los usuarios no podrán acceder a un sitio malicioso desde la página de advertencia que muestra el servicio de Navegación segura. Esta política solo impide que los usuarios accedan luego de recibir una advertencia de Navegación segura (p. ej., por la presencia de software malicioso o phishing), pero no impide el acceso si se trata de un problema relacionado con un certificado SSL (por ejemplo, si no es válido o caducó).\n\nSi la inhabilitas o no la estableces, los usuarios podrán continuar al sitio que dio lugar a la advertencia después de verla.\n\nObtén más información sobre la Navegación segura ( https://developers.google.com/safe-browsing ).";
DisableScreenshots.pfm_title = "Inhabilitar la toma de capturas de pantalla";
DisableScreenshots.pfm_description = "Si habilitas la política, no se permitirá realizar capturas de pantalla con combinaciones de teclas\nni APIs de extensiones. Si inhabilitas la política o no la estableces, se permitirán las capturas de pantalla.\n\nA partir de la versión 154 de Brave, habilitar esta política también impide que las extensiones adjunten el depurador a través de \"chrome.debugger.attach()\".\n\nTen en cuenta que en Microsoft® Windows®, macOS y Linux,\nesto no impide que se tomen capturas de pantalla con aplicaciones del sistema operativo o de terceros.";
DiskCacheDir.pfm_title = "Configurar el directorio de caché de disco";
DiskCacheDir.pfm_description = "Si estableces la política, Brave utilizará el directorio que proporciones para guardar los archivos almacenados en caché que se encuentren en el disco, independientemente de si los usuarios especifican la función experimental --disk-cache-dir.\n\nSi no la estableces, Brave utilizará el directorio predeterminado para el almacenamiento en caché, pero los usuarios podrán cambiar esa configuración con la función experimental de la línea de comandos --disk-cache-dir.\n\nBrave administra el contenido del directorio raíz de un volumen. Por lo tanto, para evitar pérdida de datos u otros errores, no establezcas esta política para el directorio raíz o cualquier directorio que se utilice para otros propósitos. Consulta las variables que puedes utilizar (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DiskCacheSize.pfm_title = "Configurar el tamaño de caché de disco";
DiskCacheSize.pfm_description = "Si estableces la política como None, Brave usará el tamaño predeterminado para guardar los archivos almacenados en caché que se encuentren en el disco. Los usuarios no podrán cambiar esta configuración.\n\nSi estableces la política, Brave usará el tamaño del almacenamiento en caché que proporciones, independientemente de que los usuarios hayan especificado o no la función experimental --disk-cache-size. (Los valores expresados en megabytes se redondearán hacia arriba).\n\nSi no estableces la política, Brave usará el tamaño predeterminado. Los usuarios podrán cambiar la configuración mediante la función experimental --disk-cache-size.\n\nNota: El valor especificado en esta política se utiliza como pauta para varios subsistemas del navegador almacenados en caché. Por lo tanto, el uso total del disco destinado al almacenamiento en caché será mayor, pero en la misma proporción que el valor especificado.";
DnsOverHttpsMode.pfm_title = "Controla el modo de DNS sobre HTTPS";
DnsOverHttpsMode.pfm_description = "off - Inhabilitar DNS sobre HTTPS\nautomatic - Habilitar DNS-over-HTTPS con resguardo inseguro\nsecure - Habilitar DNS-over-HTTPS sin resguardo inseguro\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "Especifica la plantilla de URI del agente de resolución de DNS sobre HTTPS";
DnsOverHttpsTemplates.pfm_description = "La plantilla de URI del agente de resolución de DNS-over-HTTPS deseado. Para especificar varios agentes de resolución de DNS-over-HTTPS, separa las plantillas de URI correspondientes mediante espacios.\n\nSi se configuró DnsOverHttpsMode como \"secure\", se debe establecer esta política y no puede estar vacía. Únicamente en Google Chrome OS, se debe establecer esta política o DnsOverHttpsTemplatesWithIdentifiers. De lo contrario, la resolución de DNS fallará.\n\nSi se configuró DnsOverHttpsMode como \"automatic\" y se establece esta política, se usarán las plantillas de URI especificadas. Si no se establece, se usarán las asignaciones codificadas para intentar actualizar el agente de resolución de DNS actual del usuario a un agente de resolución de DoH que opere el mismo proveedor.\n\nSi la plantilla de URI contiene una variable dns, las solicitudes al agente de resolución usarán GET; de lo contrario, las solicitudes usarán POST.\n\nSe omitirán las plantillas con formato incorrecto.";
DomainReliabilityAllowed.pfm_title = "Permitir la generación de informes sobre los datos relacionados con la confiabilidad de dominios";
DomainReliabilityAllowed.pfm_description = "Si se establece esta política como falsa, se inhabilitarán los informes sobre datos de diagnóstico de confiabilidad de dominios y no se enviarán datos a Google.\nSi no se establece esta política o se establece como verdadera, los informes sobre datos de diagnóstico de confiabilidad de dominios seguirán el comportamiento de MetricsReportingEnabled en Brave o el de DeviceMetricsReportingEnabled en Google Chrome OS.";
DownloadDirectory.pfm_title = "Establecer el directorio de descarga";
DownloadDirectory.pfm_description = "Si estableces la política, se configurará el directorio que usa Chrome para descargar archivos. Utilizará el directorio proporcionado ya sea que los usuarios hayan especificado uno o no, o activado la marca para que siempre se les pregunte dónde quieren realizar las descargas.\n\nEsta política anula la política DefaultDownloadDirectory.\n\nSi no estableces la política, Chrome utilizará el directorio de descarga predeterminado y los usuarios podrán cambiarlo.\n\nEn Google Chrome OS, solo se puede establecer en los directorios de Google Drive.\n\nNota: Consulta la lista de las variables que puedes utilizar (https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables).";
DownloadRestrictions.pfm_title = "Restricciones de descarga";
DownloadRestrictions.pfm_description = "0 - Sin restricciones especiales (predeterminado)\n1 - Bloquear descargas de contenido malicioso y tipos de archivos peligrosos\n2 - Bloquear las descargas de archivos maliciosos, desconocidos, no deseados o de tipos peligrosos\n3 - Bloquear todas las descargas\n4 - Bloquear descargas con contenido malicioso (recomendado)\nSi estableces la política, los usuarios no podrán omitir las decisiones de seguridad relacionadas con las descargas.\n\nChrome tiene varios tipos de advertencias de descarga, que pueden desglosarse en las siguientes categorías (puedes obtener más información sobre los veredictos de Navegación segura en https://support.google.com/chrome/?p=ib_download_blocked):\n\n* Contenido malicioso (detectado por el servidor de Navegación segura)\n* Contenido desconocido o no deseado (detectado por el servidor de Navegación segura)\n* Tipo de archivo peligroso (p. ej., todas las descargas de SWF y varias EXE)\n\nConfigurar la política permite bloquear diversos subconjuntos de advertencias, en función de su valor:\n\n0: Sin restricciones especiales (predeterminado)\n\n1: Bloquear los archivos maliciosos detectados por el servidor de Navegación segura Y todos los tipos de archivos peligrosos (solo se recomienda para UO/navegadores/usuarios que tengan una alta tolerancia a los falsos positivos)\n\n2: Bloquear los archivos maliciosos y los archivos desconocidos o no deseados detectados por el servidor de Navegación segura Y todos los tipos de archivos peligrosos (solo se recomienda para UO/navegadores/usuarios que tengan una alta tolerancia a los falsos positivos)\n\n3: Bloquear todas las descargas (no se recomienda, excepto en casos de uso especiales)\n\n4: Bloquear los archivos maliciosos detectados por el servidor de Navegación segura, pero no los tipos de archivos peligrosos (recomendado)\n\nNota: Estas restricciones se aplican a las descargas que se inician desde el contenido de páginas web o con la opción Descargar vínculo… del menú. No se aplican a la acción de descargar la página que se muestra actualmente ni a la opción para guardar como PDF desde las opciones de impresión. Obtén más información sobre la Navegación segura ( https://developers.google.com/safe-browsing ).";
EditBookmarksEnabled.pfm_title = "Habilitar o inhabilitar la edición de favoritos";
EditBookmarksEnabled.pfm_description = "Si habilitas la política o no la estableces, los usuarios podrán agregar, quitar, modificar o subir favoritos.\n\nSi la inhabilitas, los usuarios no podrán agregar, quitar, modificar ni subir favoritos. Podrán seguir utilizando los favoritos existentes.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Incluir puerto no estándar en el SPN de Kerberos";
EnableAuthNegotiatePort.pfm_description = "Si habilitas esta política y, luego, introduces un puerto no estándar (es decir, cualquiera que no sea el 80 ni el 443), ese puerto se incluirá en el SPN de Kerberos generado.\n\nSi la inhabilitas o no la estableces, el SPN de Kerberos que se genere no incluirá ningún puerto.";
EnableExperimentalPolicies.pfm_title = "Habilita las políticas experimentales";
EnableExperimentalPolicies.pfm_description = "Permite que Brave cargue las políticas experimentales.\n\nADVERTENCIA: Las políticas experimentales no son compatibles y pueden modificarse o quitarse sin previo aviso en futuras versiones del navegador.\n\nEs posible que una política experimental no esté terminada o tenga defectos conocidos o desconocidos. Esta política puede modificarse o quitarse sin previo aviso. Si habilitas las políticas experimentales, podrías perder datos de navegación o poner en riesgo tu seguridad o privacidad.\n\nSi una política no se encuentra en la lista y no se publicó oficialmente, se ignorará su valor en el canal estable y Beta.\n\nSi una política se encuentra en la lista, pero no se publicó oficialmente, se aplicará su valor.\n\nEsta política no prevalecerá sobre las políticas ya publicadas.";
EnableMediaRouter.pfm_title = "Habilitar Google Cast";
EnableMediaRouter.pfm_description = "Si habilitas la política o no la estableces, se activará Google Cast, que los usuarios pueden ejecutar desde el menú de la app, los menús contextuales de la página, los controles de contenido multimedia en los sitios web compatibles con Cast y el ícono de la barra de herramientas de Cast (si se muestra).\n\nSi inhabilitas la política, se desactivará Google Cast.";
EnableOnlineRevocationChecks.pfm_title = "Habilitar las comprobaciones OCSP/CRL en línea";
EnableOnlineRevocationChecks.pfm_description = "Si la estableces como verdadera, se realizarán verificaciones de OCSP/CRL en línea.\n\nSi estableces la política como falsa o no la estableces, Brave no realizará verificaciones de revocación en línea en Brave 19 ni en versiones posteriores.\n\nNota: Las verificaciones de OCSP/CRL no proporcionan un beneficio de seguridad eficaz.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "Controla qué usuarios administrados pueden establecer las políticas ProxyOverrideRules y ProxyProvisioningDomains.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Si estableces esta política en 0 o no la estableces, las políticas ProxyOverrideRules y ProxyProvisioningDomains solo se aplicarán en el permiso del usuario para los usuarios afiliados en un navegador administrado.\nCuando esta política se establezca en 1, se aplicarán las políticas ProxyOverrideRules y ProxyProvisioningDomains en el permiso del usuario, incluso si no está afiliado.";
EnableUnsafeSwiftShader.pfm_title = "Permitir el resguardo de software de WebGL con SwiftShader";
EnableUnsafeSwiftShader.pfm_description = "Una política que controla si se usará SwiftShader como resguardo de WebGL cuando la aceleración de GPU de hardware no esté disponible.\n\nSwiftShader se usó para admitir WebGL en sistemas sin aceleración de GPU, como sistemas sin interfaz gráfica o máquinas virtuales, pero dejó de estar disponible debido a problemas de seguridad. A partir de M139, la creación de contexto de WebGL fallará cuando, de otro modo, se hubiera usado SwiftShader. Esta política permite que el navegador o el administrador pospongan temporalmente la baja.\n\nSi habilitas la política, SwiftShader se usará como resguardo de software de WebGL.\n\nSi inhabilitas la política o no la estableces, es posible que falle la creación de contexto de WebGL si la aceleración de GPU de hardware no está disponible. Es posible que las páginas web no funcionen correctamente si no controlan bien el error de creación de contexto de WebGL.\n\nSe trata de una política temporal que se quitará en el futuro.";
EncryptedClientHelloEnabled.pfm_title = "Habilitar TLS Encrypted ClientHello";
EncryptedClientHelloEnabled.pfm_description = "Encrypted ClientHello (ECH) es una extensión de TLS para encriptar campos sensibles de ClientHello y mejorar la privacidad.\n\nSi habilitas esta política o no la configuras, Brave seguirá el proceso de lanzamiento predeterminado para ECH. Si está inhabilitada, Brave no habilitará ECH.\n\nCuando la función esté habilitada, Brave podrá usar el ECH según la compatibilidad del servidor, la disponibilidad del registro DNS de HTTPS o el estado del lanzamiento.\n\nECH es un protocolo en evolución, por lo que la implementación de Brave está sujeta a cambios. Por lo tanto, esta política es una medida temporal para controlar la implementación experimental inicial. Se reemplazará con controles finales a medida que finalice el protocolo.";
EnterpriseCustomLabel.pfm_title = "Establecer una etiqueta de empresa personalizada para un perfil administrado";
EnterpriseCustomLabel.pfm_description = "Esta política controla una etiqueta personalizada que se usa para identificar perfiles administrados. En el caso de los perfiles administrados, esta etiqueta se mostrará junto al avatar en la barra de herramientas. No se traducirá la etiqueta personalizada.\n\nCuando se aplica esta política, las cadenas que superen los 16 caracteres se truncarán con un “…”. No uses nombres extendidos.\n\nEsta política solo se puede establecer como política del usuario.\n\nTen en cuenta que esta política no tiene efecto si la política EnterpriseProfileBadgeToolbarSettings se establece como hide_expanded_enterprise_toolbar_badge (valor 1).";
EnterpriseCustomLabelForBrowser.pfm_title = "Establecer una etiqueta de empresa personalizada para un navegador administrado";
EnterpriseCustomLabelForBrowser.pfm_description = "Esta política controla una etiqueta personalizada que se usa para indicar un navegador administrado. En el caso de los navegadores administrados, esta etiqueta se mostrará en una cláusula de exención de responsabilidad de administración en el pie de página de la página Nueva pestaña. No se traducirá la etiqueta personalizada.\n\nTen en cuenta que esta política solo se aplica a los navegadores administrados, por lo que no tendrá efecto en los usuarios administrados en navegadores no administrados.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Habilitar las extensiones administradas para usar la API de Enterprise Hardware Platform";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Si estableces la política como verdadera, las extensiones instaladas por la política empresarial podrán utilizar la API de Enterprise Hardware Platform.\n\nSi la estableces como falsa o no la estableces, las extensiones no podrán usar esta API.\n\nNota: Esta política también se aplica en las extensiones de componentes, como la extensión de Servicios de Hangout.";
EnterpriseLogoUrl.pfm_title = "URL del logotipo de la empresa para un perfil administrado";
EnterpriseLogoUrl.pfm_description = "Una URL a una imagen que se usará como insignia de la empresa para un perfil administrado. La URL debe dirigir a una imagen.\n\nEsta política solo se puede establecer como política del usuario.\n\nSe recomienda usar el ícono de página (por ejemplo, https://www.google.com/favicon.ico) o un ícono de al menos 48 × 48 px.";
EnterpriseLogoUrlForBrowser.pfm_title = "URL del logotipo de la empresa para un navegador administrado";
EnterpriseLogoUrlForBrowser.pfm_description = "Una URL a una imagen que se usará como insignia de la empresa para un navegador administrado. La URL debe dirigir a una imagen.\n\nSe recomienda usar el ícono de página (por ejemplo, https://www.google.com/favicon.ico) o un ícono de al menos 48 × 48 px.\n\nTen en cuenta que esta política solo se aplica a los navegadores administrados, por lo que no tendrá efecto en los usuarios administrados en navegadores no administrados.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Controlar la visibilidad de la insignia del perfil empresarial en la barra de herramientas";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Mostrar la insignia empresarial expandida en la barra de herramientas\n1 - Ocultar la insignia empresarial expandida en la barra de herramientas\nEn los perfiles de trabajo y de instituciones educativas, la barra de herramientas mostrará una etiqueta de \"Trabajo\" o \"Institución educativa\" de forma predeterminada junto al avatar de la barra de herramientas. La etiqueta solo se mostrará si se administra la cuenta con la que accediste.\n\nSi estableces esta política como hide_expanded_enterprise_toolbar_badge (valor 1), se ocultará la insignia empresarial de un perfil administrado en la barra de herramientas.\n\nSi no estableces esta política o la estableces como show_expanded_enterprise_toolbar_badge (valor 0), se mostrará la insignia empresarial.\n\nLa etiqueta se puede personalizar con la política EnterpriseCustomLabel.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "Conservar los datos de navegación de forma predeterminada cuando se cree un perfil empresarial";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Si habilitas esta política, la opción para conservar los datos de navegación existentes cuando se cree un perfil empresarial estará marcada de forma predeterminada.\n\nSi no la estableces o la inhabilitas, la opción para conservar los datos de navegación existentes cuando se cree un perfil empresarial no estará marcada de forma predeterminada.\n\nMás allá del valor, el usuario podrá decidir si desea conservar o no los datos de navegación existentes cuando cree un perfil empresarial.\n\nEsta política no tiene efecto si la opción para conservar los datos de navegación existentes no está disponible. Esto sucede si la separación del perfil empresarial se aplica de manera forzosa o si los datos provienen de un perfil ya administrado.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Configuración del agregador de búsqueda empresarial";
EnterpriseSearchAggregatorSettings.pfm_description = "Esta política permite a los administradores establecer un agregador de búsquedas empresarial designado que proporcionará recomendaciones de búsqueda y resultados en el cuadro multifunción (barra de direcciones) y el cuadro de búsqueda de la página Nueva pestaña.\n\nDe forma predeterminada, las sugerencias de búsqueda empresariales se combinarán y se mostrarán junto con las recomendaciones de Brave normales. Los usuarios pueden limitar explícitamente su búsqueda al agregador de búsquedas empresarial si escriben la palabra clave especificada en el campo shortcut con o sin el prefijo @ (p.ej., @work), seguido de la barra espaciadora o Tab en el cuadro multifunción. Actualmente, las búsquedas empresariales con alcance (activadas por una palabra clave) solo se admiten en el cuadro multifunción y no en el cuadro de búsqueda de la página Nueva pestaña.\n\nLos siguientes campos son obligatorios: name, shortcut, search_url, suggest_url.\n\nEl campo name corresponde al nombre del motor de búsqueda que se muestra al usuario en la barra de direcciones.\n\nEl campo shortcut corresponde a la palabra clave que el usuario ingresa para activar la búsqueda. El atajo puede incluir palabras y caracteres simples, pero no puede incluir espacios ni comenzar con el símbolo @. Los atajos deben ser únicos.\n\nEl campo search_url especifica la URL en la que se realizará la búsqueda. Ingresa la dirección web para la página de resultados del motor de búsqueda y usa '{searchTerms}' en lugar de la búsqueda.\n\nEl campo suggest_url especifica la URL que proporciona sugerencias de búsqueda. Se realizará una solicitud POST y la consulta del usuario se pasará en los parámetros de POST con la clave 'query'.\n\nEl campo icon_url especifica la URL de una imagen que se usará en las sugerencias de búsqueda. Si no se establece este campo, se usará un ícono predeterminado. Se recomienda usar un ícono de página (por ejemplo, https://www.google.com/favicon.ico). Formatos de archivos de imagen admitidos: JPEG, ICO y PNG.\n\nEl campo require_shortcut especifica si se requiere la barra de direcciones shortcut para ver las recomendaciones de búsqueda. Si es necesario, las sugerencias no se mostrarán en el cuadro de búsqueda de la página Nueva pestaña, pero se seguirán mostrando en el cuadro multifunción (barra de direcciones) en el modo de búsqueda con alcance. Si no estableces este campo, no se requerirá la barra de direcciones shortcut.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.\nConsulta https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings para obtener más información sobre el esquema y el formato.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "Inhabilitar las advertencias basadas en las extensiones de la descarga del tipo de archivo en los dominios";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Puedes habilitar esta política para crear un diccionario de extensiones del tipo de archivo con una lista correspondiente de dominios que quedarán exentos de las advertencias sobre descargas basadas en las extensiones del tipo de archivo. Esto les permite a los administradores de empresas bloquear las advertencias sobre descargas basadas en las extensiones del tipo de archivo para los archivos asociados con un dominio de la lista. Por ejemplo, si la extensión \"jnlp\" está asociada con \"website1.com\", los usuarios no verán advertencias cuando se descarguen archivos \"jnlp\" de \"website1.com\", sino cuando se descarguen de \"website2.com\".\n\nLos archivos con extensiones del tipo de archivo especificadas para los dominios que se identifican en esta política seguirán sujetas a las advertencias de seguridad que no estén basadas en extensiones del tipo de archivo, como las advertencias sobre descargas de contenido mixto y las advertencias de Navegación segura.\n\nSi inhabilitas esta política o no la configuras, los tipos de archivos que activan advertencias sobre descargas basadas en extensiones enviarán advertencias al usuario.\n\nSi habilitas esta política:\n\n* El formato del patrón de URL debe seguir las condiciones especificadas en https://chromeenterprise.google/policies/url-patterns/.\n\n* La extensión del tipo de archivo ingresada debe estar en minúscula y con letras en formato ASCII. Cuando enumeres la extensión del tipo de archivo, no incluyas el separador principal. Por ejemplo, usa \"jnlp\" en lugar de \".jnlp\".\n\nPor ejemplo:\n\nEl siguiente valor de ejemplo evitaría las advertencias sobre descargas basadas en las extensiones del tipo de archivo para las extensiones \"exe\" y \"jnlp\" en los dominios *.example.com, y para las extensiones \"swf\" en todos los dominios. Le enviará al usuario una advertencia sobre descargas basada en las extensiones del tipo de archivo en cualquier otro dominio para los archivos exe y jnlp, pero no para los archivos swf.\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nTen en cuenta que, mientras que el ejemplo anterior muestra menos advertencias sobre descargas basadas en las extensiones del tipo de archivo para los archivos \"swf\" en todos los dominios, por cuestiones de seguridad, no te recomendamos reducir la cantidad de ese tipo de advertencias en todos los dominios para las extensiones peligrosas de tipo de archivo. El único fin del ejemplo es demostrar que es posible hacerlo.\n\nSi habilitas esta política junto a DownloadRestrictions, las excepciones de las advertencias basadas en las extensiones del tipo de archivo especificadas por esta política tendrán prioridad sobre un parámetro de configuración de DownloadRestrictions que bloquearía los tipos de archivos peligrosos. Las excepciones especificadas por esta política solo se aplican al comportamiento \"block dangerous file types\" especificado por los valores 1 y 2 de DownloadRestrictions.\n\nPor ejemplo, si esta política especifica una excepción para las descargas de \"exe\" de \"website1.com\" y DownloadRestrictions está configurada para bloquear las descargas maliciosas y los tipos de archivos peligrosos (valor 1), las descargas de \"exe\" de \"website1.com\" estarán exentas del bloqueo basado en la extensión del tipo de archivo, pero se bloquearán si son maliciosas.\n\nPuedes encontrar más información sobre DownloadRestrictions en https://chromeenterprise.google/policies/?policy=DownloadRestrictions.\nConsulta https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings para obtener más información sobre el esquema y el formato.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Puertos de red habilitados de forma explícita";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - puerto 554 (puede desbloquearse hasta el 15/10/2021)\n10080 - puerto 10080 (puede desbloquearse hasta el 01/04/2022)\n6566 - puerto 6566 (puede desbloquearse hasta el 15/10/2021)\n989 - puerto 989 (puede desbloquearse hasta el 01/02/2022)\n990 - puerto 990 (puede desbloquearse hasta el 01/02/2022)\nBrave incluye una lista de puertos restringidos. Las conexiones a esos puertos no podrán completarse. Esta configuración permite omitir esa lista. El valor es una lista separada por comas que incluye cero o más puertos en los que se permiten las conexiones de salida.\n\nLos puertos están restringidos a fin de impedir que se utilice Brave como vector para aprovecharse de diversas vulnerabilidades de la red. Si estableces esta política, es posible que tu red quede expuesta a ataques. Esta política es una solución temporal para los errores con el código \"ERR_UNSAFE_PORT\" que se producen al migrar un servicio de un puerto bloqueado a un puerto estándar (p. ej., el puerto 80 o 443).\n\nLos sitios web maliciosos pueden detectar fácilmente si esta política está establecida y en qué puertos, y utilizar esa información para dirigir ataques.\n\nLos puertos pueden desbloquearse hasta una fecha específica, la cual se indica en cada uno. Después de esa fecha, el puerto estará restringido independientemente de esta configuración.\n\nSi dejas el valor vacío o no lo estableces, se bloquearán todos los puertos restringidos. Si hay valores tanto válidos como no válidos, se aplicarán los válidos.\n\nEsta política anula la opción de la línea de comandos \"--explicitly-allowed-ports\".";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Lista de entidades bloqueadas de proveedores de identidad que no pueden usar Extensible Enterprise SSO para el navegador";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Todos los proveedores de identidad\nmicrosoft - Proveedor de identidad en la nube de Microsoft®\nokta - Proveedor de identidad en la nube de Okta®\nping - Proveedor de identidad en la nube de Ping®\nInhabilita el inicio de sesión único con Extensible Enterprise SSO para los proveedores de identidad que se muestran.\n\nSi agregas el valor 'all', se inhabilitarán todos los proveedores de identidad compatibles para SSO.\n\nSi agregas el valor 'microsoft', se inhabilita la compatibilidad con el inicio de sesión único para el proveedor de identidad en la nube de Microsoft® en Chrome.\n\nSi no estableces esta política, se habilitarán todos los proveedores de identidad que admita Brave.\n\nEn el caso de los proveedores de identidad que están habilitados en Brave y configurados en el dispositivo por el administrador, los usuarios que accedan a su cuenta con ese proveedor de identidad, en cualquier aplicación que admita Extensible Enterprise SSO, pueden acceder a las propiedades web con ese proveedor de forma automática. La información de autenticación del usuario se transmite al proveedor de identidad en la nube del usuario para cada evento de autenticación.\n\nNotas:\n\nBrave no admite el inicio de sesión único con Extensible Enterprise SSO en los modos Incógnito o de invitado.\n\nBrave solo admite el inicio de sesión único con Extensible Enterprise SSO para los siguientes proveedores de identidad: Microsoft, Okta, Ping.\n\nEsta función está disponible a partir de la versión 10.15 de macOS.";
ExtensionAllowedTypes.pfm_title = "Tipos de extensiones o aplicaciones que se pueden instalar";
ExtensionAllowedTypes.pfm_description = "extension - Extensión\ntheme - Tema\nuser_script - Secuencia de comandos del usuario\nhosted_app - App alojada\nlegacy_packaged_app - Aplicación empaquetada heredada\nplatform_app - App de plataforma\nSi estableces la política, se controlarán las apps y extensiones que se pueden instalar en Brave, así como los hosts con los que estas pueden interactuar, y se limitará el acceso al entorno de ejecución.\n\nSi no estableces la política, no habrá restricciones para los tipos de apps y extensiones admitidos.\n\nNo se instalarán las extensiones ni las apps con un tipo que no se incluya en la lista. Cada valor debe ser una de estas strings:\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\nConsulta la documentación sobre las extensiones de Brave para obtener más información sobre estos tipos.\n\nLas versiones anteriores a la 75, que usan varios ID de extensiones separados por comas, no son compatibles y se omitirán. Se aplicará el resto de la política.\n\nNota: Esta política también afecta a las extensiones y apps que se instalan de manera automática usando ExtensionInstallForcelist.\n\nNota: Esta política solo se aplica a las plataformas que admiten extensiones.";
ExtensionDeveloperModeSettings.pfm_title = "Controlar la disponibilidad del modo de desarrollador en la página de extensiones";
ExtensionDeveloperModeSettings.pfm_description = "0 - Permitir el uso del modo de desarrollador en la página de extensiones\n1 - No permitir el uso del modo de desarrollador en la página de extensiones\nControla si los usuarios pueden activar el modo de desarrollador en chrome://extensions.\n\nSi no estableces la política, los usuarios podrán activar el modo de desarrollador en la página de extensiones, a menos que la política de DeveloperToolsAvailability se establezca como DeveloperToolsDisallowed (2).\nSi estableces la política como Allow (0), los usuarios podrán activar el modo de desarrollador en la página de extensiones.\nSi estableces la política como Disallow (1), los usuarios no podrán activar el modo de desarrollador en la página de extensiones.\n\nSi estableces esta política, DeveloperToolsAvailability ya no podrá controlar el modo de desarrollador de extensiones.\n\nNota: Esta política solo se aplica a las plataformas que admiten extensiones.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Configura una lista de orígenes que concedan una mayor duración en segundo plano a las extensiones que se conectan.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "Las extensiones que se conecten a uno de estos orígenes se seguirán ejecutando mientras el puerto esté conectado.\n\nSi no la estableces, se usarán los valores predeterminados de la política. Estos son orígenes de apps que ofrecen SDK y que no ofrecen la posibilidad de reiniciar una conexión cerrada a un estado anterior:\n- Smart Card Connector\n- Receptor de Citrix (estable, beta, copia de seguridad)\n- VMware Horizon (estable, beta)\n\nSi estableces la política, la lista de valores predeterminada se extenderá con los valores recién configurados. Tanto los valores predeterminados como las entradas proporcionadas por la política otorgarán la excepción a las extensiones que se conectan, siempre que el puerto esté conectado.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Habilitar las extensiones instaladas mediante políticas que anulan la configuración de búsqueda predeterminada o de la página Nueva pestaña";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Controla si se permiten en entornos de baja confianza las extensiones instaladas (de forma forzosa o recomendadas) mediante políticas que anulan la configuración del motor de búsqueda predeterminado o de la página Nueva pestaña.\n\nEsta política solo se aplica a entornos de baja confianza (como dispositivos en los que las políticas se configuran de forma local sin administración de dominio o de la nube). Los entornos de alta confianza no se ven afectados:\n\nEn Microsoft® Windows®, esta política no está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política no está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.\n\nLas extensiones instaladas mediante políticas que anulan la configuración del motor de búsqueda predeterminado o de la página Nueva pestaña permanecerán habilitadas en estas instancias de alta confianza.\n\nSi habilitas la política, Brave permitirá que las extensiones instaladas mediante políticas que anulan la configuración del motor de búsqueda predeterminado o de la página Nueva pestaña se instalen y permanezcan habilitadas en entornos de baja confianza.\n\nSi se inhabilita o no se configura, Brave impedirá que las extensiones instaladas mediante políticas que anulan la configuración del motor de búsqueda predeterminado o de la página Nueva pestaña se instalen en entornos de baja confianza, y las quitará si ya están instaladas.\n\nSi se actualiza una extensión afectada para que ya no anule estos parámetros de configuración, Brave la instalará automáticamente en un plazo de 7 días.\n\nEsta es una política temporal y se quitará en una versión futura.";
ExtensionInstallAllowlist.pfm_title = "Identificadores de extensión para excluir de la lista de elementos bloqueados";
ExtensionInstallAllowlist.pfm_description = "Si estableces la política, se especificarán las extensiones que no están sujetas a la lista de elementos bloqueados.\n\nUn valor de * en una lista de elementos bloqueados significa que se incluyen todas las extensiones en esa lista, y los usuarios solo podrán instalar extensiones que figuren en la lista de elementos permitidos.\n\nDe forma predeterminada, se permiten todas las extensiones. Sin embargo, si prohibiste extensiones mediante una política, usa la lista de extensiones permitidas para cambiar esa política.\n\nNota: Esta política solo se aplica a las plataformas que admiten extensiones.";
ExtensionInstallBlocklist.pfm_title = "ID de extensiones que el usuario no debe poder instalar (o * para incluirlas todas).";
ExtensionInstallBlocklist.pfm_description = "Permite especificar las extensiones que los usuarios NO pueden instalar. Si se incluyen en la lista de elementos bloqueados extensiones que ya están instaladas, no funcionarán y el usuario no podrá habilitarlas. Si las quitas de esa lista, se volverán a habilitar automáticamente.\n\nUn valor de asterisco (*) en la lista de extensiones bloqueadas significa que todas las extensiones están incluidas en esa lista de forma predeterminada. Las extensiones que se enumeran de forma explícita en la lista de extensiones permitidas se admiten si están firmadas (comprimidas). Todas las extensiones sin empaquetar están bloqueadas.\n\nSi no estableces esta política, el usuario podrá instalar cualquier extensión de Brave.\n\nNota: Esta política solo se aplica a las plataformas que admiten extensiones.";
ExtensionInstallForcelist.pfm_title = "ID de extensiones/apps y direcciones URL de actualización para instalar en silencio";
ExtensionInstallForcelist.pfm_description = "Si estableces la política, se especificará una lista de apps y extensiones que se instalan en segundo plano, sin la interacción del usuario, y que este no puede desinstalar ni desactivar en la interfaz de Brave. Se otorgan los permisos de manera implícita, incluidos los de las APIs de extensión enterprise.deviceAttributes y enterprise.platformKeys. (Estas 2 APIs no están disponibles para las apps y extensiones que no se instalan de manera automática).\n\nAunque Brave tiene como objetivo evitar que los usuarios desinstalen estas extensiones, algunos sistemas operativos impiden que Brave se proteja de manera eficaz contra las extensiones que se modifican de forma externa. Por lo tanto, esta prevención es lo mejor que se puede hacer.\n\nSi no estableces la política, no se instalará ninguna app ni extensión de manera automática, y los usuarios podrán desinstalar cualquier app o extensión en Brave.\n\nEsta política sustituye la política ExtensionInstallBlocklist. Si se quita de esta lista una app o extensión instalada de manera automática, Brave la desinstalará sin interacción del usuario.\n\nLos usuarios pueden modificar el código fuente de cualquier extensión con las herramientas para desarrolladores (y probablemente la extensión deje de funcionar). Si esta situación puede plantear problemas, establece la política DeveloperToolsDisabled.\n\nCada elemento de la lista de la política es una cadena que contiene un ID de extensión y, de forma opcional, una URL de actualización separada por un punto y coma (;). El ID de extensión es la cadena de 32 letras que se encuentra, por ejemplo, en chrome://extensions, en el modo de desarrollador. Si se especifica, la URL de actualización debe direccionar a un documento XML del manifiesto de actualización (https://developer.chrome.com/extensions/autoupdate). La URL de actualización debe usar uno de los siguientes esquemas: http, https o file. De forma predeterminada, se usa la URL de actualización de Chrome Web Store. La URL de actualización que se establece en esta política solo se usa para la instalación inicial; las actualizaciones posteriores de la extensión utilizan la URL de actualización que se indica en el manifiesto de la extensión. La URL de actualización para actualizaciones posteriores puede anularse con la política ExtensionSettings; consulta http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy.\n\nEn instancias de Microsoft® Windows®, las apps y extensiones que no provengan de Chrome Web Store podrán instalarse de manera automática solo si la instancia está vinculada a un dominio de Microsoft® Active Directory®, vinculada a Microsoft® Azure® Active Directory® o inscrita en Chrome Enterprise Core.\n\nEn instancias de macOS, las apps y extensiones que no provengan de Chrome Web Store podrán instalarse de manera automática solo si la instancia está administrada con MDM, vinculada a un dominio a través de MCX o inscrita en Chrome Enterprise Core.\n\nNota: Esta política no se aplica al modo Incógnito. Obtén más información sobre el alojamiento de extensiones en https://developer.chrome.com/extensions/hosting.\n\nNota: Esta política solo se aplica a las plataformas que admiten extensiones.";
ExtensionInstallSources.pfm_title = "Patrones de URL desde los que se pueden instalar secuencias de comandos de usuario, aplicaciones y extensiones";
ExtensionInstallSources.pfm_description = "Si estableces esta política, se especificarán las URL que pueden instalar extensiones, apps y temas. Antes de la versión Brave 21, los usuarios podían hacer clic en un vínculo que los dirigía a un archivo *.crx, y Brave ofrecía instalar el archivo después de unas advertencias. A partir de esa versión, este tipo de archivos debe descargarse y arrastrarse a la página de configuración de Brave. Esta configuración permite especificar las URL que tendrán el flujo de instalación anterior, que es más sencillo.\n\nCada elemento en esta lista es un patrón de coincidencia con el formato de extensiones (consulta https://developer.chrome.com/extensions/match_patterns). Los usuarios pueden instalar fácilmente elementos desde cualquier URL que coincida con un elemento de la lista. Estos patrones deben permitir tanto la ubicación del archivo *.crx como la página desde donde se inicia la descarga (la URL de referencia).\n\nExtensionInstallBlocklist tiene prioridad sobre esta política. Esto quiere decir que no se instalará ninguna extensión de la lista de elementos bloqueados, incluso si proviene de un sitio de esta lista.\n\nNota: Esta política solo se aplica a las plataformas que admiten extensiones.";
ExtensionInstallTypeBlocklist.pfm_title = "Lista de entidades bloqueadas para los tipos de instalación de extensiones";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Impedir que se carguen extensiones desde la línea de comandos\nLa lista de entidades bloqueadas controla qué tipos de instalación de extensiones no están permitidos.\n\nSi estableces “command_line”, se bloqueará la carga de la extensión desde\nla línea de comandos.";
ExtensionReviewPromptsEnabled.pfm_title = "Controlar las solicitudes de revisión de extensiones y los vínculos de calificación";
ExtensionReviewPromptsEnabled.pfm_description = "Controla si las solicitudes de opiniones nativas y los vínculos de calificación (como \"Calificar\") para las extensiones de Chrome instaladas están disponibles en las interfaces de usuario de Chrome.\n\nSi habilitas esta política o no la estableces, es posible que los usuarios vean puntos de entrada nativos para revisar y calificar las extensiones aptas en la barra de herramientas, los menús contextuales y la página de administración de extensiones (chrome://extensions).\n\nSi la inhabilitas, se suprimirán y no estarán disponibles todas las solicitudes de opiniones y los vínculos de calificaciones nativos.";
ExtensionSettings.pfm_title = "Configuración de la administración de extensiones";
ExtensionSettings.pfm_description = "Si estableces esta política, se controlará la configuración de la administración de extensiones para Brave, incluido cualquier parámetro de configuración controlado por políticas existentes relacionadas con extensiones.\n\nEsta política asigna un ID de extensión o una URL de actualización solo a su configuración específica. Se puede establecer una configuración predeterminada para el ID especial \"*\", que se aplicará a todas las extensiones que no tengan una configuración personalizada en esta política.\n\nEsta política puede anular la configuración por extensión de las políticas heredadas.\n\nTen en cuenta que cualquier configuración de extensión por ID de ExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist o ExtensionSettings solo heredará \"installation_mode\" y \"update_url\" de la configuración predeterminada de \"*\". No heredará ninguna otra propiedad. Con una URL de actualización, la configuración se aplica a todas las extensiones con la URL de actualización exacta establecida en el manifiesto de la extensión (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy). Si estableces la función experimental \"override_update_url\" como verdadera, se instalará la extensión y se actualizará a través de la URL \"update\" especificada en la política ExtensionInstallForcelist o en el campo \"update_url\" de esta política. Se ignorará la función experimental \"override_update_url\" si \"update_url\" es una URL de Chrome Web Store.\n\nA partir de la versión 154 de Brave, si se aplica \"runtime_blocked_hosts\" a una extensión con el permiso \"debugger\", se inhabilitará por completo \"chrome.debugger.attach()\" en todos los destinos.\n\nEn instancias de Microsoft® Windows®, las apps y extensiones que no provengan de Chrome Web Store podrán instalarse de manera automática solo si la instancia está vinculada a un dominio de Microsoft® Active Directory®, vinculada a Microsoft® Azure® Active Directory® o inscrita en Chrome Enterprise Core.\n\nEn instancias de macOS, las apps y extensiones que no provengan de Chrome Web Store podrán instalarse de manera automática solo si la instancia está administrada con MDM, vinculada a un dominio a través de MCX o inscrita en Chrome Enterprise Core.\n\nNota: Esta política solo se aplica a las plataformas que admiten extensiones.\nConsulta https://chromeenterprise.google/policies/?policy=ExtensionSettings para obtener más información sobre el esquema y el formato.";
ExtensionUnpublishedAvailability.pfm_title = "Controlar la disponibilidad de las extensiones no publicadas en Chrome Web Store";
ExtensionUnpublishedAvailability.pfm_description = "0 - Permitir extensiones no publicadas\n1 - Inhabilitar las extensiones no publicadas\nSi habilitas esta política, las extensiones que no estén publicadas en Chrome Web\nStore se inhabilitarán en Brave.\nEsta política solo se aplica a las extensiones instaladas y actualizadas desde\nChrome Web Store.\n\nSe ignoran las extensiones que no están en la tienda, como las extensiones sin empaquetar instaladas\ncon el modo de desarrollador, y las extensiones instaladas con el interruptor de línea de comandos.\nSe ignoran las extensiones instaladas de manera automática que se alojan en una ubicación propia. También\nse ignoran todas las extensiones fijadas a la versión.\n\nSi estableces la política como AllowUnpublished (0) o no la estableces, se permitirán las extensiones que no estén publicadas en Chrome Web Store.\nSi estableces la política como DisableUnpublished (1), se inhabilitarán las extensiones que no estén publicadas en Chrome Web Store.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Muestra la casilla de verificación \"Always open\" en un cuadro de diálogo del protocolo externo";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Esta política determina si se muestra la casilla de verificación \"Abrir siempre\" en mensajes de confirmación de lanzamiento en protocolos externos.\n\n     Si se establece esta política como verdadera o no se establece, cuando aparezca un mensaje de confirmación de un protocolo externo, el usuario podrá elegir la opción \"Permitir siempre\" para omitir todos los mensajes de confirmación futuros en este sitio web para el protocolo.\n\n     Si se establece esta política como falsa, no aparecerá la casilla de verificación \"Permitir siempre\" y el usuario verá un mensaje de confirmación cada vez que se invoque un protocolo externo.";
FeedbackSurveysEnabled.pfm_title = "Especifica si las encuestas dentro del producto Brave se muestran a los usuarios.";
FeedbackSurveysEnabled.pfm_description = "Las encuestas dentro del producto Brave recopilan los comentarios de los usuarios sobre el navegador. Las respuestas de la encuesta no están asociadas con las cuentas de usuario.\nSi habilitas esta política o no la estableces, es posible que se muestren a los usuarios las encuestas dentro del producto.\nSi la inhabilitas, las encuestas dentro del producto no se mostrarán a los usuarios.\n\nEsta política no tendrá efecto si inhabilitas MetricsReportingEnabled, lo que también inhabilitará las encuestas dentro del producto.";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Recupera la duración de keepalive al momento del cierre";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Controla la duración (en segundos) permitida para las solicitudes de keepalive cuando se cierra el navegador.\n\nSi especificas la política, se podrá bloquear el cierre del navegador hasta la cantidad de segundos especificados,\npara procesar las solicitudes (https://fetch.spec.whatwg.org/#request-keepalive-flag) de keepalive.\n\nEl valor predeterminado (0) significa que esta función está inhabilitada.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Permitir que se llame a las APIs del selector de directorios o archivos sin gestos previos del usuario";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "Por motivos de seguridad, las APIs web\nshowOpenFilePicker(),\nshowSaveFilePicker() y\nshowDirectoryPicker()\nrequieren un gesto previo del usuario (\"activación transitoria\") para realizar una llamada.\nDe lo contrario, fallarán.\n\nCuando estableces esta política, los administradores pueden especificar los orígenes en los que se puede\nllamar a estas APIs sin un gesto previo del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta\nhttps://chromeenterprise.google/policies/url-patterns/. * no es\nun valor aceptado para esta política.\n\nSi no estableces esta política, todos los orígenes requerirán un gesto previo del usuario para llamar\na estas APIs.";
FileSystemReadAskForUrls.pfm_title = "Permite el acceso de lectura a través de la API de File System en estos sitios";
FileSystemReadAskForUrls.pfm_description = "Si estableces la política, podrás definir una lista de patrones de URL donde se especifiquen los sitios que pueden pedir a los usuarios acceso de lectura a los archivos o directorios que se encuentren en el sistema de archivos del sistema operativo del host mediante la API de File System.\n\nSi no estableces la política, se aplicará DefaultFileSystemReadGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nLos patrones de URL no deben entrar en conflicto con FileSystemReadBlockedForUrls. Si una URL se ajusta a ambas políticas, no prevalece ninguna de las dos.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
FileSystemReadBlockedForUrls.pfm_title = "Impide el acceso de lectura a través de la API de File System en estos sitios";
FileSystemReadBlockedForUrls.pfm_description = "Si estableces la política, podrás definir una lista de patrones de URL donde se especifiquen los sitios que no pueden pedir a los usuarios acceso de lectura a los archivos o directorios que se encuentren en el sistema de archivos del sistema operativo del host mediante la API de File System.\n\nSi no estableces la política, se aplicará DefaultFileSystemReadGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal de los usuarios.\n\nLos patrones de URL no pueden entrar en conflicto con FileSystemReadAskForUrls. Si una URL se ajusta a ambas políticas, no prevalece ninguna de las dos.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
FileSystemWriteAskForUrls.pfm_title = "Permite el acceso de escritura a archivos y directorios en estos sitios";
FileSystemWriteAskForUrls.pfm_description = "Si estableces la política, podrás definir una lista de patrones de URL donde se especifiquen los sitios que pueden pedir a los usuarios acceso de escritura a los archivos o directorios que se encuentren en el sistema de archivos del sistema operativo del host.\n\nSi no estableces la política, se aplicará DefaultFileSystemWriteGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nLos patrones de URL no deben entrar en conflicto con FileSystemWriteBlockedForUrls. Si una URL se ajusta a ambas políticas, no prevalece ninguna de las dos.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
FileSystemWriteBlockedForUrls.pfm_title = "Bloquea el acceso de escritura a archivos y directorios en estos sitios";
FileSystemWriteBlockedForUrls.pfm_description = "Si estableces la política, podrás definir una lista de patrones de URL donde se especifiquen los sitios que no pueden pedir a los usuarios acceso de escritura a los archivos o directorios que se encuentren en el sistema de archivos del sistema operativo del host.\n\nSi no estableces la política, se aplicará DefaultFileSystemWriteGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nLos patrones de URL no pueden entrar en conflicto con FileSystemWriteAskForUrls. Si una URL se ajusta a ambas políticas, no prevalece ninguna de las dos.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
ForceEphemeralProfiles.pfm_title = "Perfil efímero";
ForceEphemeralProfiles.pfm_description = "Si se habilita, esta política cambia el perfil al modo efímero. Si se especifica como política del Sistema operativo (p. ej., GPO en Windows), se aplica a todos los perfiles del sistema. Si se establece como política en la nube, solo se aplica a un perfil que haya accedido con una cuenta administrada.\n\nEn este modo, los datos de perfil solo se mantienen en el disco hasta que termine la sesión del usuario. Una vez que se cierra el navegador, no se conservan ciertas funciones, como el historial web, las extensiones y su información, los datos de Internet (las cookies) o las bases de datos web. Sin embargo, esto no impide que el usuario pueda descargar datos en el disco manualmente, guardar páginas o imprimirlas.\n\nSi el usuario habilita la sincronización, todos estos datos se conservan en el perfil de sincronización, al igual que ocurre con los perfiles normales. A menos que se inhabilite expresamente mediante esta política, el modo de navegación de incógnito también está disponible.\n\nSi esta política se inhabilita o no se establece, el acceso direcciona al usuario a los perfiles normales.";
ForceForegroundPriorityForAllTabs.pfm_title = "Forzar la prioridad en primer plano para todas las pestañas";
ForceForegroundPriorityForAllTabs.pfm_description = "Esta política controla si el contenido web en segundo plano se ejecuta con\nprioridad de primer plano.\n\nDe forma predeterminada, el navegador optimiza los recursos quitando la prioridad del contenido en\nlas pestañas en segundo plano. Si habilitas esta política, se anulará ese comportamiento y se programarán las\npestañas en segundo plano de la misma manera que la pestaña activa.\n\nTen en cuenta que forzar la ejecución del contenido en segundo plano con prioridad de primer plano puede\nafectar ligeramente la capacidad de respuesta de la pestaña activa.\n\nSi habilitas esta política, todo el contenido web se ejecutará con prioridad de primer plano\nindependientemente de su estado de visibilidad.\n\nSi esta política se inhabilita o no se establece, el navegador determina la prioridad\nsegún la heurística estándar (p. ej., disminuyendo la prioridad del contenido que no es\nvisible, que no reproduce audio, que no participa en videollamadas, etcétera).";
ForceForegroundPriorityForUrls.pfm_title = "Forzar la prioridad en primer plano para URLs específicas";
ForceForegroundPriorityForUrls.pfm_description = "Esta política te permite especificar una lista de patrones de URL. El contenido web en segundo plano que coincida con estos patrones se ejecutará con prioridad de primer plano.\n\nSi habilitas la política ForceForegroundPriorityForAllTabs, se ignorará esta lista, ya que todas las pestañas se forzarán a tener prioridad de primer plano.\n\nSi inhabilitas o no estableces ForceForegroundPriorityForAllTabs, solo se forzará el contenido que coincida con los patrones de esta lista.\n\nPara obtener información detallada sobre los patrones válidos de URL, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nSi esta lista está vacía o no se establece, no se forzará ningún contenido en segundo plano a la prioridad de primer plano.";
ForceGoogleSafeSearch.pfm_title = "Forzar Google SafeSearch";
ForceGoogleSafeSearch.pfm_description = "Si habilitas la política, la función SafeSearch estará siempre activa en la Búsqueda de Google, y los usuarios no podrán cambiar esta configuración.\n\nSi la inhabilitas o no la estableces, no se aplicará SafeSearch en la Búsqueda de Google.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "Controlar si se pueden inhabilitar los controladores del evento unload";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "Los controladores del evento unload dejarán de estar disponibles. Su activación depende de la Permissions-Policy de unload. Actualmente, la política los admite de forma predeterminada. Paulatinamente, pasarán a estar inhabilitados de forma predeterminada, y los sitios deberán habilitarlos explícitamente mediante encabezados de la Permissions-Policy. Con esta política empresarial, se puede rechazar esta baja gradual. Para ello, se debe forzar que la configuración predeterminada permanezca habilitada.\n\nEs posible que las páginas dependan de los controladores del evento unload para guardar datos o indicar el final de una sesión de usuario en el servidor. Esto no se recomienda, ya que no es confiable y afecta el rendimiento porque bloquea el uso de BackForwardCache. Si bien existen alternativas recomendadas, el evento unload se usa hace mucho tiempo. Es posible que algunas aplicaciones aún dependan de ellos.\n\nSi estableces esta política como falsa o no la estableces, los controladores del evento unload dejarán de estar disponibles de manera gradual y en consonancia con el lanzamiento de la baja, y los sitios que no establezcan el encabezado de la Permissions-Policy dejarán de activar los eventos de \"descarga\".\n\nSi la estableces como verdadera, los controladores del evento unload seguirán funcionando de forma predeterminada.\n\nNOTA: Esta política tenía un valor predeterminado \"verdadero\" documentado de forma incorrecta en la versión M117. El evento de descarga lo tenía y no cambiará en M117, por lo que esta política no tiene efecto en esa versión.\n";
ForceYouTubeRestrict.pfm_title = "Aplicar el modo restringido mínimo de YouTube";
ForceYouTubeRestrict.pfm_description = "0 - No aplicar el modo restringido en YouTube\n1 - Aplicar, al menos, el modo restringido moderado en YouTube\n2 - Aplicar el modo restringido estricto para YouTube\nSi configuras la política, se aplicará un modo restringido mínimo en YouTube y se impedirá que los usuarios seleccionen un modo menos restringido. Establece alguno de los siguientes valores para esta política:\n\n* Estricto: El modo restringido estricto estará siempre activo en YouTube.\n\n* Moderado: El usuario podrá elegir entre el modo restringido moderado y el estricto en YouTube, pero no podrá desactivar el modo restringido.\n\n* Desactivado (o sin establecer ningún valor): Chrome no aplicará el modo restringido en YouTube. Sin embargo, es posible que las políticas externas, como las de YouTube, apliquen el modo restringido.";
ForcedLanguages.pfm_title = "Configurar el contenido y el orden de los idiomas preferidos";
ForcedLanguages.pfm_description = "Esta política permite a los administradores establecer el orden de los idiomas preferidos en la configuración de Brave.\n\nLa lista aparecerá en el mismo orden que se especifica en la sección \"Ordena los idiomas según tus preferencias\" de chrome://settings/languages. Los usuarios no podrán cambiar el orden de los idiomas establecidos por la política ni quitarlos, pero podrán agregar idiomas debajo de los que estableció la política. Los usuarios también podrán controlar el idioma de la IU del navegador y las opciones de configuración del corrector ortográfico y de traducción, a menos que se apliquen otras políticas para estas configuraciones.\n\nSi no estableces la política, los usuarios podrán modificar toda la lista de idiomas preferidos.";
GeminiActOnWebAllowedForURLs.pfm_title = "Permite que las integraciones de la app de Gemini actúen directamente en los sitios especificados";
GeminiActOnWebAllowedForURLs.pfm_description = "Permite establecer una lista de patrones de URL que especifique en qué sitios las integraciones de la app de Gemini pueden actuar de directamente en las páginas web.\n\nLas URLs que no coinciden con la lista de entidades permitidas ni con la lista de entidades bloqueadas utilizan GeminiActOnWebSettings.\n\nSe permiten las URLs que coinciden con la lista de entidades permitidas y la lista de entidades bloqueadas.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebBlockedForURLs.pfm_title = "Bloquea las integraciones de la app de Gemini para que no actúen directamente en los sitios especificados";
GeminiActOnWebBlockedForURLs.pfm_description = "Permite establecer una lista de patrones de URL que especifique en qué sitios las integraciones de la app de Gemini no pueden actuar directamente en las páginas web.\n\nLas URLs que no coinciden con la lista de entidades permitidas ni con la lista de entidades bloqueadas utilizan GeminiActOnWebSettings.\n\nSe permiten las URLs que coinciden con la lista de entidades permitidas y la lista de entidades bloqueadas.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebSettings.pfm_title = "Permite que las integraciones de la app de Gemini actúen directamente en las páginas web.";
GeminiActOnWebSettings.pfm_description = "0 - Permite que la app de Gemini realice acciones en las páginas web.\n1 - Impide que la app de Gemini realice acciones en las páginas web.\nControla si la app de Gemini puede realizar acciones en las páginas web en nombre del usuario.\n\n0 o no establecida = La app de Gemini puede realizar acciones en las páginas web.\n\n1 = La app de Gemini no tiene permiso para realizar acciones en las páginas web.\n\nEsta política no tiene efecto cuando se inhabilita la app de Gemini. Por ejemplo, la política de GeminiSettings puede inhabilitar la app de Gemini.\n\nPara obtener más información sobre Gemini en Chrome, consulta https://support.google.com/chrome/a/answer/16291696.\n\nLa activación de Gemini no está disponible en todos los países ni idiomas. Si estableces esta política, no se garantiza que se habilitará la función, ya que sigue sujeta a la disponibilidad. Para obtener más información sobre el lanzamiento, consulta las notas de la versión de Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=es-419";
GeminiSettings.pfm_title = "Configuración de la integración con Gemini";
GeminiSettings.pfm_description = "0 - Permitir las integraciones en Gemini.\n1 - No permitir integraciones en Gemini.\nEsta configuración permite las integraciones de la app de Gemini.\n\n0 = La integración con Gemini estará disponible para los usuarios.\n\n1 = La integración con Gemini no estará disponible para los usuarios.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nPara obtener más información, consulta el artículo del Centro de ayuda https://support.google.com/chrome/a?p=gemini_in_chrome.";
GeminiSparkSettings.pfm_title = "Permite que Gemini Spark se conecte a Brave y use la navegación automática a través de Gemini en Chrome";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark tiene permiso para conectarse y usar la navegación automática de Brave.\n1 - Gemini Spark no tiene permiso para conectarse a la navegación automática de Brave ni para usarla.\nControla si el agente de Gemini Spark puede conectarse a Brave y usar la navegación automática. Es posible que Gemini Spark no esté disponible para tu organización.\n\n0 = Gemini Spark tiene permiso para conectarse a la navegación automática de Brave y usarla\n\n1 = Gemini Spark no tiene permiso para conectarse a la navegación automática de Brave ni usarla\n\nAdvertencia: Si habilitas la conexión de Gemini Spark a Brave y el uso de la navegación automática, el agente de Gemini Spark podrá realizar acciones autónomas de varios pasos en los clientes de Brave con la sesión de navegador activa. Esto implica riesgos de seguridad significativos, incluidos los riesgos de credenciales, la entrada de red local y la pérdida de señales con reconocimiento de contexto. Es posible que no se respeten los controles de administración y seguridad existentes.\n\nSe recomienda a los administradores que evalúen cuidadosamente el modelo de amenazas de red, el cumplimiento y los lineamientos de privacidad de su organización antes de habilitar esta función.\n\nEsta política no tiene efecto cuando se inhabilitan la app de Google Gemini o las políticas de navegación automática de Brave. Por ejemplo, la política GeminiSettings puede inhabilitar la app de Google Gemini. Para obtener más información sobre Google Gemini en Brave, consulta https://support.google.com/chrome/a?p=gemini_in_chrome.\n\nLa navegación automática de Brave y Gemini Spark no están disponibles en todos los países ni en todos los idiomas. Si estableces esta política con el valor \"0\" (habilitada), no se garantiza que se habilitará la función, ya que sigue sujeta a la disponibilidad. Para obtener más información sobre el lanzamiento, consulta las notas de la versión de Enterprise: https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Configuración del modelo de base local de IA generativa";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Descargar el modelo automáticamente\n1 - No descargar el modelo\nConfigura la forma en que Brave descarga el modelo básico de IA generativa y lo usa para la inferencia a nivel local.\n\nSi permites (0) la política o no la estableces, el modelo se descargará automáticamente y se usará para las inferencias.\n\nSi la inhabilitas (1), no se descargará el modelo y se borrará el modelo existente (si ya se descargó).\n\nEn plataformas de escritorio, también se puede inhabilitar la descarga de modelos si se establece ComponentUpdatesEnabled como falsa.";
GeolocationBlockedForUrls.pfm_title = "Bloquear la ubicación geográfica en estos sitios";
GeolocationBlockedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que no pueden acceder a la ubicación geográfica del usuario y que tampoco pueden solicitarle permiso para hacerlo.\n\nSi no estableces la política, se aplicará DefaultGeolocationSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "Permite la caché de autorización para HTTP con alcance global";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Esta política configura una única caché global por perfil con credenciales de autenticación del servidor HTTP.\n\nSi se inhabilita o no se establece esta política, el navegador usará el comportamiento predeterminado de autenticación entre sitios, que consiste en asignar el alcance de las credenciales de autenticación del servidor HTTP de acuerdo al sitio de nivel más alto. Por lo tanto, si dos sitios usan recursos del mismo dominio de autenticación, se deberán proporcionar credenciales de forma independiente en el contexto de ambos sitios. Se reutilizarán las credenciales de proxy almacenadas en la caché entre los sitios.\n\nSi se habilita la política, las credenciales de autenticación de HTTP ingresadas en un sitio se usarán automáticamente en otro.\n\nSi se habilita esta política, los sitios quedan expuestos a ciertos tipos de ataques entre sitios. Además, se pueden rastrear los usuarios entre los sitios sin usar cookies; solo es necesario agregar entradas a la caché de autorización de HTTP con credenciales incorporadas en las URL.\n\nEl objetivo de esta política es brindarles a las empresas que dependen del comportamiento heredado una oportunidad para actualizar sus procedimientos de acceso. En el futuro, se quitará esta política.";
GoogleSearchSidePanelEnabled.pfm_title = "Habilitar el Google Search Side Panel";
GoogleSearchSidePanelEnabled.pfm_description = "Si habilitas la política o no la estableces, se permitirá el Google Search Side Panel en todas las páginas web.\n\nSi la inhabilitas, el Google Search Side Panel no estará disponible en ninguna página web.\n\nLas funciones de IA generativa que son parte de esta función no están disponibles para las cuentas educativas o empresariales.";
HSTSPolicyBypassList.pfm_title = "Lista de nombres que omitirán la revisión de la política de HSTS";
HSTSPolicyBypassList.pfm_description = "Si estableces la política, se especifica una lista de nombres de host que evitan las actualizaciones de HSTS precargadas de http a https.\n\nEsta política únicamente admite nombres de host con una sola etiqueta y se aplica a las entradas de HSTS precargadas \"estáticas\" (por ejemplo, \"app\", \"new\", \"search\", \"play\"). Esta política no evita las actualizaciones de HSTS para los servidores que hayan solicitado actualizaciones de HSTS \"de manera dinámica\" con un encabezado de respuesta Strict-Transport-Security.\n\nLos nombres de host deben estar canonicalizados: debe convertirse cualquier IDN a su formato de etiqueta A y todas las letras en formato ASCII deben estar en minúscula. Esta política solo se aplica a los nombres de host especificados con una sola etiqueta. No se aplica a los subdominios de esos nombres.";
HappyEyeballsV3Enabled.pfm_title = "Usar el algoritmo Happy Eyeballs V3";
HappyEyeballsV3Enabled.pfm_description = "Esta función habilita el algoritmo Happy Eyeballs V3 para realizar intentos de conexión. Consulta https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3 para obtener más información.\n\nSi habilitas la política, Brave usará el algoritmo Happy Eyeballs V3 para los intentos de conexión.\n\nSi la inhabilitas, se desactivará el algoritmo Happy Eyeballs V3.\n\nSi no estableces la política, Brave activará o desactivará el algoritmo Happy Eyeballs V3 según chrome://flags/#happy-eyeballs-v3.\n\nEsta política admite la actualización dinámica.\n\nEsta política es una medida temporal y se eliminará en las futuras versiones de Brave.";
HardwareAccelerationModeEnabled.pfm_title = "Usar la aceleración de gráficos cuando esté disponible";
HardwareAccelerationModeEnabled.pfm_description = "Si habilitas la política o no la estableces, se activará la aceleración de gráficos, en caso de estar disponible.\n\nSi inhabilitas la política, se desactivará la aceleración de gráficos.";
HeadlessMode.pfm_title = "Controlar el uso del modo sin interfaz gráfica";
HeadlessMode.pfm_description = "1 - Permitir el uso del modo sin interfaz gráfica\n2 - No permitir el uso del modo sin interfaz gráfica\nSi estableces esta política como Enabled o no la estableces, se podrá usar el modo sin interfaz gráfica. Si estableces esta política como Disabled, no se podrá usar el modo sin interfaz gráfica.";
HelpMeWriteSettings.pfm_title = "Configuración de Ayúdame a escribir";
HelpMeWriteSettings.pfm_description = "0 - Permitir Ayúdame a escribir y mejorar los modelos de IA.\n1 - Permitir Ayúdame a escribir sin mejorar los modelos de IA.\n2 - No permitir Ayúdame a escribir.\nAyúdame a escribir es un asistente de escritura basado en IA para contenido de formato corto en la Web. El contenido sugerido se basa en las instrucciones que ingresa el usuario y en el contenido de la página web.\n\n0 = Permite que se use la función y que Google use datos pertinentes para mejorar sus modelos de IA. Los datos pertinentes pueden incluir instrucciones, entradas, resultados, materiales de origen y comentarios escritos, según la función. Es posible que personas revisen los datos para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los siguientes casos.\n\n1 = Permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (lo que incluye las instrucciones, las entradas, los resultados, los materiales de origen y los comentarios escritos). 1 es el valor predeterminado para los usuarios empresariales que administra Google Admin console y las cuentas de institución educativa que administra Google Workspace.\n\n2 = No permite la función.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
HideWebStoreIcon.pfm_title = "Ocultar ícono de Web Store en la página Nueva pestaña y el Selector de aplicaciones";
HideWebStoreIcon.pfm_description = "Permite ocultar la aplicación Chrome Web Store y el vínculo de la parte inferior de la página Nueva pestaña y del Selector de aplicaciones de Google Chrome OS.\n\nSi esta política se establece en true, los íconos estarán ocultos.\n\nSi esta política se establece en false o no se configura, los íconos serán visibles.";
HighEfficiencyModeEnabled.pfm_title = "Habilitar el modo de alta eficiencia";
HighEfficiencyModeEnabled.pfm_description = "Esta política habilita o inhabilita la configuración del modo de alta eficiencia. Esta configuración hace que, a fin de recuperar memoria, se cierren las pestañas tras un período en segundo plano.\nSi no estableces esta política, el usuario final podrá controlar esta configuración desde chrome://settings/performance.\n";
HistoryClustersVisible.pfm_title = "Mostrar una vista del historial de Chrome con grupos de páginas";
HistoryClustersVisible.pfm_description = "Esta política controla la visibilidad de la página del historial de Chrome organizada en grupos de páginas.\n\nSi habilitas la política, se mostrará una página del historial de Chrome organizada en grupos en chrome://history/grouped.\n\nSi la inhabilitas, no se mostrará una página del historial de Chrome organizada en grupos en chrome://history/grouped.\n\nSi no la estableces, se mostrará una página del historial de Chrome organizada en grupos en chrome://history/grouped de forma predeterminada.\n\nTen en cuenta que, si inhabilitas la política ComponentUpdatesEnabled, pero habilitas o no estableces HistoryClustersVisible, la página del historial de Chrome organizada en grupos seguirá disponible en chrome://history/grouped, pero es posible que sea menos relevante para el usuario.\n";
HistorySearchSettings.pfm_title = "Configuración de AI-powered history search";
HistorySearchSettings.pfm_description = "0 - Permitir AI History Search y mejorar los modelos de IA.\n1 - Permitir AI History Search sin mejorar los modelos de IA.\n2 - No permitir AI History Search.\nAI History Search es una función que permite a los usuarios buscar en su historial de navegación y obtener respuestas generadas en función del contenido de las páginas, no solo del título y la URL.\n\n0 = Permite que se use la función y que Google use datos pertinentes para mejorar sus modelos de IA. Los datos pertinentes pueden incluir instrucciones, entradas, resultados, materiales de origen y comentarios escritos, según la función. Es posible que personas revisen los datos para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los siguientes casos.\n\n1 = Permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (lo que incluye las instrucciones, las entradas, los resultados, los materiales de origen y los comentarios escritos). 1 es el valor predeterminado para los usuarios empresariales que administra Google Admin console y las cuentas de institución educativa que administra Google Workspace.\n\n2 = No permite la función.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
HomepageIsNewTabPage.pfm_title = "Usar la página Nueva pestaña como página principal";
HomepageIsNewTabPage.pfm_description = "Si habilitas la política, se establecerá la página Nueva pestaña como la página principal del usuario y se ignorarán las demás URLs de página principal. Si inhabilitas la política, la página principal no será la página Nueva pestaña, a menos que se establezca chrome://newtab como la URL de la página principal del usuario.\n\nSi estableces la política, los usuarios no podrán cambiar la página principal en Brave. Si no la estableces, el usuario decidirá si la página Nueva pestaña es la página principal.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
HomepageLocation.pfm_title = "URL de la página principal";
HomepageLocation.pfm_description = "Si estableces la política, se determinará la URL predeterminada de la página principal en Brave. Podrás abrir la página principal con el botón correspondiente. En la computadora, la política RestoreOnStartup controla las páginas que se abren al iniciar el navegador.\n\nSi el usuario o HomepageIsNewTabPage establecen la página principal como la página Nueva pestaña, esta política no tendrá efecto.\n\nLa URL debe tener un esquema estándar, por ejemplo, http://example.com o https://example.com. Si estableces esta política, los usuarios no podrán cambiar la URL de la página principal en Brave.\n\nSi no estableces HomepageLocation ni HomepageIsNewTabPage, los usuarios podrán elegir la página principal.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
HttpAllowlist.pfm_title = "Lista de entidades permitidas de HTTP";
HttpAllowlist.pfm_description = "Si estableces la política, se especificará una lista de nombres de host o patrones de nombres de host (como\n\"[*.]example.com\") que no se actualizarán a HTTPS y no mostrarán un\nintersticial de error si se habilita el modo HTTPS primero. Las organizaciones pueden usar esta\npolítica para mantener el acceso a servidores que no admiten HTTPS, sin necesidad de\ninhabilitar las actualizaciones de HTTPS ni el modo HTTPS primero.\n\nLos nombres de host provistos deben estar canonicalizados: debe convertirse cualquier IDN a su\nformato de etiqueta A y todas las letras en formato ASCII deben estar en minúscula.\n\nLos comodines de host generales (p. ej., \"*\" o \"[*]\") no están permitidos. En su lugar,\nel modo HTTPS primero y las actualizaciones de HTTPS deben inhabilitarse de manera explícita a través de sus\npolíticas específicas.\n\nNota: Esta política no se aplica a las actualizaciones de HSTS.";
HttpHeaderInjection.pfm_title = "Configurar la inyección de encabezados HTTP para patrones de URL específicos";
HttpHeaderInjection.pfm_description = "Esta política permite definir una lista de reglas para inyectar encabezados HTTP personalizados en las solicitudes web que coincidan con patrones de URL específicos. Los encabezados establecidos por esta política tienen prioridad sobre los que estaban presentes inicialmente en la solicitud, así como sobre las modificaciones que intenten realizar los usuarios o las extensiones.\n\nUn caso de uso común para esta política es aplicar controles de acceso de usuarios inyectando encabezados personalizados (p. ej., X-Tenant-ID).\n\nLa política acepta una lista de reglas. Cada regla contiene lo siguiente:\n\n* patterns: Una lista de patrones de URL que deben coincidir. Consulta cómo darle formato a un patrón de URL ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ).\n\n* headers: Una lista de objetos que representan los encabezados que se inyectarán, cada uno de los cuales contiene lo siguiente:\n\n* name: El nombre del encabezado que se inyectará.\n\n* value: El valor del encabezado que se inyectará.\n\nSi varias reglas coinciden con una solicitud, se aplicarán los encabezados de todas las reglas coincidentes. En caso de que haya varios encabezados con el mismo nombre, se aplicará el que tenga el patrón de URL más específico. Si los patrones son igualmente específicos, se aplicará el que aparezca último en la lista.\n\nLos nombres de encabezado deben cumplir con RFC 2616 ( https://www.rfc-editor.org/rfc/rfc2616 ). Los valores de encabezado no deben contener símbolos NUL, CR ni LF. Los encabezados individuales no deben superar los 8 KB de tamaño. Se ignorarán los encabezados y patrones de URL no válidos.\n\nEsta política está limitada a un total de 500 patrones de URL en todas las reglas. Cada regla puede contener 20 encabezados como máximo. Se ignorarán los patrones y encabezados que superen estos límites.\n\nNota: Si un patrón de URL coincide con esquemas no encriptados (http://, ws:// o cuando se omite el esquema), los encabezados configurados podrían transmitirse en texto sin formato a través de un canal no encriptado y podrían quedar expuestos a observadores de red. Para proteger los valores de encabezado sensibles o de identificación, restringe los patrones de URL a esquemas encriptados (https:// o wss://).\nConsulta https://chromeenterprise.google/policies/?policy=HttpHeaderInjection para obtener más información sobre el esquema y el formato.";
HttpsOnlyMode.pfm_title = "Permitir que se habilite el modo solo HTTPS";
HttpsOnlyMode.pfm_description = "allowed - No restringir la configuración del Modo solo HTTPS de los usuarios\ndisallowed - Inhabilitar el Modo solo HTTPS\nforce_enabled - Habilitar el Modo solo HTTPS en el modo estricto\nforce_balanced_enabled - Habilitar el Modo solo HTTPS en el modo equilibrado\nEsta política controla si los usuarios pueden habilitar el Modo solo HTTPS (Usar siempre conexiones seguras) en la Configuración. El modo solo HTTPS actualiza todas las navegaciones a páginas HTTPS.\n\nSi no estableces este parámetro de configuración o lo habilitas, los usuarios podrán habilitar el Modo solo HTTPS.\n\nSi inhabilitas este parámetro de configuración, se inhabilitará el Modo solo HTTPS.\n\nSi estableces este parámetro de configuración como \"force_enabled\", se habilitará el Modo solo HTTPS en el modo estricto.\n\nSi estableces este parámetro de configuración como \"force_balanced_enabled\", se habilitará el Modo solo HTTPS en el modo equilibrado.\n\n\"force_enabled\" es compatible a partir de la versión M112 y \"force_balanced_enabled\", a partir de la versión M129.\n\nTambién se pueden recomendar \"force_enabled\" y \"force_balanced_enabled\" a los usuarios.\nEl Modo solo HTTPS se establecerá inicialmente en el modo estricto o equilibrado, pero los usuarios podrán cambiarlo.\n\nSi estableces esta política en un valor que no admite la versión de Chrome que la recibe, Chrome usará el parámetro de configuración permitido de forma predeterminada.\n\nSe puede usar la política HttpAllowlist independiente para que esta función no actualice a HTTPS los nombres de host o patrones de nombre de host específicos.";
HttpsUpgradesEnabled.pfm_title = "Habilitar las actualizaciones automáticas de HTTPS";
HttpsUpgradesEnabled.pfm_description = "Cuando es posible, Brave intenta actualizar algunas\nnavegaciones de HTTP a HTTPS. Esta política se puede usar para\ninhabilitar este comportamiento. Si la configuras como verdadera o no la estableces, esta función estará\nhabilitada de forma predeterminada.\n\nSe puede usar la política HttpAllowlist independiente\npara que esta función no actualice a HTTPS\nlos nombres de host o patrones de nombre de host específicos.\n\nConsulta también la política HttpsOnlyMode.";
IPv6ReachabilityOverrideEnabled.pfm_title = "Habilitar la anulación de verificación de accesibilidad de IPv6";
IPv6ReachabilityOverrideEnabled.pfm_description = "Si estableces la política como verdadera, se anulará la verificación de accesibilidad de IPv6. Esto significa que el\nsistema siempre consultará los registros AAAA cuando resuelva los nombres de host. Se aplica a\ntodos los usuarios y las interfaces del dispositivo.\n\nSi estableces la política como falsa o no la estableces, no se anulará la verificación de accesibilidad de IPv6.\nEl sistema solo consulta registros AAAA cuando el dispositivo es accesible para un host IPv6 global.";
IdleDetectionAllowedForUrls.pfm_title = "Sitios permitidos para la detección de inactividad";
IdleDetectionAllowedForUrls.pfm_description = "Te permite establecer una lista de patrones de URL que especifican los sitios que pueden usar la API de Idle Detection sin preguntarle al usuario. Las entradas de la lista de patrones bloqueados tienen mayor prioridad que las entradas de la lista de patrones permitidos, que, a su vez, tienen mayor prioridad que el valor predeterminado configurado.\n\nPara obtener información detallada sobre los patrones de URL de sitios válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.\n\nSi no estableces esta política, se usará el valor predeterminado global para todos los sitios, que se configura con la política DefaultIdleDetectionSetting (Configuración predeterminada de detección de inactividad), si se establece, o con la configuración personal del usuario.";
IdleDetectionBlockedForUrls.pfm_title = "Sitios bloqueados para la detección de inactividad";
IdleDetectionBlockedForUrls.pfm_description = "Te permite establecer una lista de patrones de URL que especifican los sitios que no pueden usar la API de Idle Detection.\n\nPara obtener información detallada sobre los patrones de URL de sitios válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.\n\nSi no estableces esta política, se usará el valor predeterminado global para todos los sitios, que se configura con la política DefaultIdleDetectionSetting (Configuración predeterminada de detección de inactividad), si se establece, o con la configuración personal del usuario.";
IdleTimeout.pfm_title = "Demorar antes de ejecutar respuestas de inactividad";
IdleTimeout.pfm_description = "Activa una acción cuando la computadora está inactiva.\n\nSi estableces esta política, especificará el período sin entrada del usuario (en minutos) antes de que el navegador ejecute acciones configuradas con la política IdleTimeoutActions.\n\nSi no estableces esta política, no se ejecutará ninguna acción.\n\nEl umbral mínimo es 1 minuto.\n\nLa \"Entrada del usuario\" se define con las APIs del sistema operativo y comprende acciones como mover el mouse o usar el teclado.";
IdleTimeoutActions.pfm_title = "Respuestas para ejecutar cuando la computadora está inactiva";
IdleTimeoutActions.pfm_description = "close_browsers - Cerrar navegadores\nshow_profile_picker - Mostrar el selector de perfiles\nclear_browsing_history - Borrar el historial de navegación\nclear_download_history - Borrar el historial de descargas\nclear_cookies_and_other_site_data - Borrar cookies y otros datos de sitios\nclear_cached_images_and_files - Borrar imágenes y archivos almacenados en caché\nclear_password_signin - Borrar el acceso mediante contraseña\nclear_autofill - Borrar los datos de Autocompletar\nclear_site_settings - Borrar la configuración de sitios\nclear_hosted_app_data - Borrar los datos de apps alojadas\nreload_pages - Volver a cargar páginas\nsign_out - Salir\nclose_tabs - Cerrar pestañas\nLista de acciones para ejecutar cuando se alcanza el tiempo de espera de la política IdleTimeout.\n\nAdvertencia: Si estableces esta política, es posible que se vean afectados los datos personales locales y que se quiten de forma permanente. Se recomienda probar la configuración antes de la implementación para evitar la eliminación accidental de datos personales.\n\nSi no estableces la política IdleTimeout, esta política no tendrá efecto.\n\nCuando se alcanza el tiempo de espera de la política IdleTimeout, el navegador ejecuta las acciones configuradas en esta política.\n\nSi la dejas vacía o no la estableces, la política IdleTimeout no tendrá efecto.\n\nSe admiten las siguientes acciones:\n\n\"close_browsers\": cierra todas las ventanas del navegador y las AWP de este perfil. No es compatible con iOS ni Android.\n\n\"close_tabs\": cierra todas las pestañas abiertas en las ventanas abiertas. Solo es compatible con iOS.\n\n\"show_profile_picker\": muestra la ventana del Selector de perfiles. No es compatible con iOS ni Android.\n\n\"sign_out\": sale del usuario actual. Solo es compatible con iOS.\n\n\"clear_browsing_history\", \"clear_download_history\", \"clear_cookies_and_other_site_data\", \"clear_cached_images_and_files\", \"clear_password_signing\", \"clear_autofill\", \"clear_site_settings\", \"clear_hosted_app_data\": borran los datos de navegación correspondientes. Para obtener más información, consulta la política ClearBrowsingDataOnExitList. Los tipos admitidos en iOS son \"clear_browsing_history\", \"clear_cookies_and_other_site_data\", \"clear_cached_images_and_files\", \"clear_password_signing\" y \"clear_autofill\"\n\n\"reload_pages\": vuelve a cargar todas las páginas web. En algunas páginas, es posible que primero se le solicite confirmación al usuario. No es compatible con iOS.\n\nEl usuario permanecerá con su Cuenta de Google cuando borre las cookies con \"clear_cookies_and_other_site_data\".\n\nSi estableces \"clear_browsing_history\", \"clear_password_signing\", \"clear_autofill\" y \"clear_site_settings\", se inhabilitará la sincronización de los tipos de datos respectivos si no inhabilitas \"Chrome Sync\" estableciendo la política SyncDisabled ni inhabilitas BrowserSignin.";
ImagesAllowedForUrls.pfm_title = "Permitir imágenes en estos sitios";
ImagesAllowedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que pueden mostrar imágenes.\n\nSi no estableces la política, se aplicará DefaultImagesSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\nTen en cuenta que esta política estaba habilitada en Android por error, pero esta funcionalidad nunca fue totalmente compatible en ese SO.";
ImagesBlockedForUrls.pfm_title = "Bloquear imágenes en estos sitios";
ImagesBlockedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que no pueden mostrar imágenes.\n\nSi no estableces la política, se aplicará DefaultImagesSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\n Para obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\n Ten en cuenta que esta política estaba habilitada en Android por error, pero esta funcionalidad nunca fue totalmente compatible en ese SO.";
ImportAutofillFormData.pfm_title = "Importar el formulario de Autocompletar del navegador predeterminado en la primera ejecución";
ImportAutofillFormData.pfm_description = "Si habilitas la política, se importarán los datos para autocompletar formularios del navegador predeterminado anterior en la primera ejecución. Si la inhabilitas o no la estableces, no se importará ningún dato para autocompletar formularios en la primera ejecución.\n\nLos usuarios podrán activar un diálogo de importación; la casilla de verificación correspondiente a los datos para autocompletar formularios estará marcada o desmarcada en función del valor de esta política.";
ImportBookmarks.pfm_title = "Importar favoritos del navegador predeterminado en la primera ejecución";
ImportBookmarks.pfm_description = "Si habilitas la política, se importarán los favoritos del navegador predeterminado anterior en la primera ejecución. Si la inhabilitas o no la estableces, no se importará ningún favorito en la primera ejecución.\n\nLos usuarios podrán activar un diálogo de importación; la casilla de verificación correspondiente a los favoritos estará marcada o desmarcada en función del valor de esta política.";
ImportHistory.pfm_title = "Importar historial de navegación del navegador predeterminado en la primera ejecución";
ImportHistory.pfm_description = "Si habilitas la política, se importará el historial de navegación del navegador predeterminado anterior en la primera ejecución. Si la inhabilitas o no la estableces, no se importará ningún historial de navegación en la primera ejecución.\n\nLos usuarios podrán activar un diálogo de importación; la casilla de verificación correspondiente al historial de navegación estará marcada o desmarcada en función del valor de esta política.";
ImportHomepage.pfm_title = "Importar la página principal del navegador predeterminado en la primera ejecución";
ImportHomepage.pfm_description = "Si habilitas la política, se importará la página principal del navegador predeterminado anterior en la primera ejecución. Si la inhabilitas o no la estableces, no se importará la página principal en la primera ejecución.\n\nLos usuarios podrán activar un diálogo de importación; la casilla de verificación correspondiente a la página principal estará marcada o desmarcada en función del valor de esta política.";
ImportSavedPasswords.pfm_title = "Importar las contraseñas guardadas del navegador predeterminado en la primera ejecución";
ImportSavedPasswords.pfm_description = "Esta política controla solo el comportamiento de importación de la primera ejecución después de la instalación. Permite una transición más fluida a Brave en entornos en los que se usó mucho otro navegador antes de instalar uno nuevo. Esta política no afecta las funciones del administrador de contraseñas para las Cuentas de Google.\n\nSi habilitas la política, se importarán las contraseñas guardadas del navegador predeterminado anterior en la primera ejecución y también se podrán importar de forma manual desde la página de configuración.\nSi inhabilitas la política, no se importará ninguna contraseña guardada en la primera ejecución y se bloqueará la importación manual desde la página de configuración.\nSi no estableces la política, no se importará ninguna contraseña guardada en la primera ejecución, pero el usuario podrá hacerlo desde la página de configuración.";
ImportSearchEngine.pfm_title = "Importar los motores de búsqueda desde el navegador predeterminado en la primera ejecución";
ImportSearchEngine.pfm_description = "Si habilitas la política, se importará el motor de búsqueda predeterminado del navegador predeterminado anterior en la primera ejecución. Si inhabilitas la política o no la estableces, no se importará el motor de búsqueda predeterminado en la primera ejecución.\n\nLos usuarios podrán activar un diálogo de importación; la casilla de verificación correspondiente al motor de búsqueda predeterminado estará marcada o desmarcada en función del valor de esta política.";
IncognitoModeAvailability.pfm_title = "Disponibilidad del modo incógnito";
IncognitoModeAvailability.pfm_description = "0 - Modo incógnito disponible\n1 - Modo incógnito inhabilitado\n2 - Modo incógnito forzado\nEspecifica si el usuario puede abrir páginas en modo Incógnito en Brave.\n\nSi seleccionas \"Enabled\" (habilitada) o no estableces la política, se permitirá abrir páginas en modo Incógnito.\n\nSi seleccionas \"Disabled\" (inhabilitada), no se permitirá abrir páginas en modo Incógnito.\n\nSi seleccionas \"Forced\" (forzada), las páginas se abrirán SOLO en modo Incógnito. Ten en cuenta que la opción \"Forced\" no funciona para Android-on-Chrome\n\nLa política IncognitoModeUrlAllowlist tiene prioridad sobre esta política y puede volver a habilitar el modo Incógnito para URLs específicas. Cuando esta política inhabilita el modo Incógnito y se proporciona una lista de direcciones permitidas, el modo Incógnito solo está disponible para las URLs que coinciden con la lista de direcciones permitidas, mientras que se bloquean todas las demás páginas.\n\nNota: En iOS, si la política cambia durante una sesión, solo tendrá efecto en el reinicio.";
IncognitoModeUrlAllowlist.pfm_title = "Permite el acceso a una lista de URLs en el modo Incógnito.";
IncognitoModeUrlAllowlist.pfm_description = "Si estableces la política, se permitirá el acceso a las URLs de la lista en el modo Incógnito. Úsala para abrir excepciones a ciertos patrones de URL definidos en IncognitoModeUrlBlocklist, con el formato especificado en ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ).\n\nSi se establecen esta política y IncognitoModeUrlBlocklist, la lista de direcciones permitidas tiene prioridad. Si una URL coincide con un patrón de la lista de direcciones permitidas, se permitirá. Si coincide con un patrón de la lista de direcciones bloqueadas (pero no con uno de la lista de direcciones permitidas), se bloqueará. Si una URL no coincide con ninguna, se usarán las políticas generales de URLBlocklist/URLAllowlist como alternativa.\n\nSi estableces esta política y no estableces IncognitoModeUrlBlocklist, se bloqueará cualquier URL que no esté en la lista de direcciones permitidas en el modo Incógnito.\n\nSi IncognitoModeAvailability está configurada para no permitir (valor 1), pero esta política está configurada, el modo Incógnito solo estará disponible para las URLs que coincidan con la lista de direcciones permitidas.\n\nSi no estableces la política, no se permitirán excepciones a IncognitoModeUrlBlocklist ni a IncognitoModeAvailability.\n\nEsta política solo afecta el modo Incógnito. Para permitir las URLs en todos los perfiles de usuario, usa la política URLAllowlist.\n\nLos comodines de host generales (p. ej., \"*\" o \"[*]\") no están permitidos; usa la política IncognitoModeAvailability para habilitar la función de forma global.\n\nEsta política está limitada a 1,000 entradas.";
IncognitoModeUrlBlocklist.pfm_title = "Bloquea el acceso a una lista de URLs en el modo Incógnito.";
IncognitoModeUrlBlocklist.pfm_description = "Si estableces la política IncognitoModeUrlBlocklist, se detendrá la carga de las páginas web que tengan URLs prohibidas en el modo Incógnito. Los administradores pueden especificar la lista de patrones de URL que se bloquearán. Consulta cómo darle formato a un patrón de URL ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ).\n\nSi se establecen esta política y la política IncognitoModeUrlAllowlist, la lista de direcciones permitidas tendrá prioridad. Si una URL coincide con un patrón de la lista de direcciones permitidas, se permitirá. Si coincide con un patrón de la lista de direcciones bloqueadas (pero no con uno de la lista de direcciones permitidas), se bloqueará. Si una URL no coincide con ninguna, se usarán las políticas generales de URLBlocklist/URLAllowlist como alternativa.\n\nSi se establece la política IncognitoModeUrlAllowlist y no se establece esta política, se bloqueará cualquier URL que no esté en la lista de direcciones permitidas en el modo Incógnito.\n\nSi estableces IncognitoModeAvailability como no permitir (valor 1), pero configuras la política IncognitoModeUrlAllowlist, el modo Incógnito solo estará disponible para las URLs que coincidan con la lista de direcciones permitidas.\n\nEsta política solo afecta el modo Incógnito. Para bloquear las URLs en todos los perfiles de usuario, usa la política URLBlocklist.\n\nEsta política está limitada a 1,000 entradas.";
InsecureContentAllowedForUrls.pfm_title = "Permite contenido no seguro en estos sitios";
InsecureContentAllowedForUrls.pfm_description = "Te permite configurar una lista de patrones de URL donde se indiquen los sitios que pueden mostrar contenido mixto (p. ej., contenido HTTP en sitios HTTPS) bloqueable (p. ej., activo) y para los cuales se inhabilitarán las actualizaciones del contenido mixto bloqueable de forma opcional.\n\nSi no estableces esta política, se bloqueará el contenido mixto bloqueable y se actualizará el contenido mixto bloqueable de forma opcional; además, los usuarios podrán establecer excepciones para permitir ese contenido en sitios específicos.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
InsecureContentBlockedForUrls.pfm_title = "Bloquea el contenido no seguro de estos sitios";
InsecureContentBlockedForUrls.pfm_description = "Te permite configurar una lista de patrones de URL donde se indiquen los sitios que no pueden mostrar contenido mixto (p. ej., contenido HTTP en sitios HTTPS) bloqueable (p. ej., activo) y para los cuales se actualizará el contenido mixto opcionalmente bloqueable (p. ej., pasivo).\n\nSi no estableces esta política, se bloqueará el contenido mixto bloqueable y se actualizará el contenido mixto opcionalmente bloqueable, pero los usuarios podrán establecer excepciones para permitir ese contenido en sitios específicos.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
IntensiveWakeUpThrottlingEnabled.pfm_title = "Controla la función IntensiveWakeUpThrottling";
IntensiveWakeUpThrottlingEnabled.pfm_description = "Si se habilita, la función de IntensiveWakeUpThrottling limitará y fusionará de forma drástica los cronómetros de JavaScript de las pestañas en segundo plano; estos no funcionarán más de una vez por minuto después de que una página haya estado en segundo plano durante 5 minutos o más.\n\nEsta función cumple con los estándares web, pero es posible que genere\nfallos en algunos sitios web debido a que provoca demoras de hasta un minuto\nen ciertas acciones. Sin embargo, cuando se habilita, se obtienen ahorros significativos\nde CPU y batería. Para obtener más información, consulta https://bit.ly/30b1XR4.\n\nSi habilitas esta política, se habilitará la función de manera forzosa\ny los usuarios no podrán anularla.\n\nSi inhabilitas esta política, se inhabilitará la función de manera forzosa\ny los usuarios no podrán anularla.\n\nSi no la estableces, la función estará controlada por su propia\nlógica interna; en este caso, los usuarios podrán configurarla.\n\nTen en cuenta que se aplica la política por proceso de renderizado, con el valor\nmás reciente de la configuración de la política vigente cuando comienza este proceso. Se requiere\nun reinicio completo para asegurarse de que todas las pestañas cargadas reciban una\nconfiguración de política coherente. Tener diferentes valores para esta política no tiene efectos adversos\npara los procesos.\n";
IntranetRedirectBehavior.pfm_title = "Comportamiento de redireccionamiento de intranet";
IntranetRedirectBehavior.pfm_description = "0 - Usa el comportamiento predeterminado del navegador.\n1 - Inhabilita las revisiones de intercepción de DNS y las barras de información de \"http://intranetsite/\" para \"quisiste decir\".\n2 - Inhabilita las revisiones de intercepción de DNS y permite las barras de información de \"http://intranetsite/\" para \"quisiste decir\".\n3 - Permite las revisiones de intercepción de DNS y las barras de información de \"http://intranetsite/\" para \"quisiste decir\".\nEsta política configura el comportamiento de la redirección de intranet mediante las revisiones de intercepción de DNS. Las revisiones intentan detectar si el navegador está detrás de un proxy que redirige nombres de host desconocidos.\n\nSi no estableces esta política, el navegador usará el comportamiento predeterminado de las revisiones de intercepción de DNS y las sugerencias de redirección de intranet. En la versión M88, están habilitados de forma predeterminada. Sin embargo, en las próximas versiones, se inhabilitarán de forma predeterminada.\n\nDNSInterceptionChecksEnabled es una política relacionada que también puede inhabilitar las revisiones de intercepción de DNS. Esta política es una versión más flexible que puede controlar por separado las barras de información de redirección de intranet y se puede expandir en el futuro.\nSi DNSInterceptionChecksEnabled o esta política solicitan inhabilitar las revisiones de intercepción, se desactivarán las revisiones.";
IsolateOrigins.pfm_title = "Permite el aislamiento de sitios específicos";
IsolateOrigins.pfm_description = "Especifica una lista de orígenes que se ejecutan en un proceso dedicado.\n\nEn Android, esta política solo funciona en dispositivos con suficiente memoria (más de 3.2 GB de RAM), ya que aislar demasiados sitios en dispositivos con recursos limitados puede causar problemas de rendimiento. Para los dispositivos Android con recursos limitados, usa IsolateOriginsShortlist en su lugar.\n\nNo se recomienda configurar específicamente ningún aislamiento de procesos en dispositivos con menos de 1 GB de memoria.\n\nEl proceso de cada origen designado solo podrá incluir documentos de ese origen y sus subdominios. Por ejemplo, si especificas https://a1.example.com/, se permitirá https://a2.a1.example.com/ en el mismo proceso, pero no https://example.com ni https://b.example.com.\n\nA partir de Brave 77, también puedes especificar un rango de orígenes para aislar con un comodín. Por ejemplo, si especificas https://[*.]corp.example.com, cada origen que esté debajo de https://corp.example.com tendrá su propio proceso dedicado, incluidos https://corp.example.com, https://a1.corp.example.com y https://a2.a1.corp.example.com.\n\nTen en cuenta que todos los sitios (es decir, el esquema más eTLD+1, como https://example.com) ya están aislados de forma predeterminada en las plataformas para computadoras, como se indica en la política de SitePerProcess. Esta política IsolateOrigins es útil para aislar orígenes específicos en un mayor nivel de detalle (p. ej., https://a.example.com).\n\nTen en cuenta que Android aísla algunos sitios sensibles de forma predeterminada a partir de la versión 77 de Brave y que esta política extiende ese modo para aislar orígenes adicionales específicos.\n\nAdemás, ten en cuenta que los orígenes que aísla esta política no podrán incluir otros orígenes en el mismo sitio. Por el contrario, esto es posible si dos documentos del mismo sitio modifican los valores de document.domain para que coincidan. Los administradores deben confirmar que este comportamiento poco común no se utilizará en los orígenes antes de aislarlos.\n\nSi estableces la política como una cadena vacía o no la estableces, no se requerirá el aislamiento de sitios para ningún origen específico. Los usuarios aún podrán activar el aislamiento de procesos de forma manual usando esa función experimental de línea de comandos.";
JavaScriptAllowedForUrls.pfm_title = "Permitir JavaScript en estos sitios";
JavaScriptAllowedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que pueden ejecutar JavaScript.\n\nSi no estableces la política, se aplicará DefaultJavaScriptSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
JavaScriptBlockedForUrls.pfm_title = "Bloquear JavaScript en estos sitios";
JavaScriptBlockedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que no pueden ejecutar JavaScript.\n\nSi no estableces la política, se aplicará DefaultJavaScriptSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\nTen en cuenta que esta política bloquea JavaScript según si el origen del documento de nivel superior (generalmente la URL de la página que también se muestra en la barra de direcciones) coincide con alguno de los patrones. Por lo tanto, esta política no es adecuada para mitigar los ataques a la cadena de suministro web. Por ejemplo, si proporcionas el patrón \"https://[*.]foo.com/\", no se impedirá que una página alojada en, por ejemplo, https://example.com ejecute una secuencia de comandos cargada desde https://www.foo.com/example.js. Además, si proporcionas el patrón \"https://example.com/\", no se impedirá que un documento de https://example.com ejecute secuencias de comandos si no es el documento de nivel superior, sino que se incorpora como un submarco en una página alojada en otro origen, por ejemplo, https://www.bar.com.";
JavaScriptJitAllowedForSites.pfm_title = "Permitir que JavaScript utilice JIT en estos sitios";
JavaScriptJitAllowedForSites.pfm_description = "Te permite establecer una lista de patrones de URL de sitios donde se indiquen los que pueden ejecutar JavaScript con el compilador JIT (Just In Time) habilitado.\n\nPara obtener información detallada sobre los patrones de URL de sitios válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\nSe pueden establecer excepciones de política para subdominios específicos, así como para sitios completos. Por ejemplo, una política establecida solo para subdominio.sitio.com se aplica a subdominio.sitio.com sin afectar a sitio.com. En algunos casos en los que un subdominio no se puede aislar de su sitio superior, puede heredar la política establecida en sitio.com. Es posible que las excepciones tampoco se apliquen a los marcos cargados en una pestaña existente hasta que el sitio se abra en una pestaña nueva. En dispositivos Android con poca memoria, es posible que no se apliquen las excepciones específicas del sitio y, en su lugar, los sitios usarán la política de DefaultJavaScriptJitSetting si se establece, o se usará de forma predeterminada el parámetro de configuración de JavaScript con JIT del perfil.\n\nPara aplicar excepciones, Brave puede colocar sitios o subdominios cuya configuración difiera de la predeterminada en procesos específicos. Esto puede aumentar el uso de memoria, especialmente en Android o cuando un patrón de comodín coincide con muchos subdominios, ya que cada origen coincidente puede aislarse por separado. Los subdominios aislados tampoco pueden usar documento.dominio para acceder a su sitio superior.\n\nNota: En las versiones 155 y anteriores, las excepciones de la política solo se aplicaban por sitio (eTLD+1). Una política establecida solo para subdominio.sitio.com no se aplicaba, ni siquiera para subdominio.sitio.com. Debía establecerse en sitio.com para que se aplicara tanto a sitio.com como a subdominio.sitio.com.\n\nEsta política se aplica marco por marco y no solo en función de la URL de origen de nivel superior. Por ejemplo, si sitio-uno.com aparece en la política JavaScriptJitAllowedForSites, pero sitio-uno.com carga un marco que contiene sitio-dos.com, sitio-uno.com tendrá habilitado JavaScript con JIT, pero sitio-dos.com usará la política de DefaultJavaScriptJitSetting, si se establece, o se habilitará JavaScript con JIT de forma predeterminada. Las entradas de la lista de patrones bloqueados tienen mayor prioridad que las entradas de la lista de patrones permitidos, que, a su vez, tienen mayor prioridad que el valor predeterminado configurado.\n\nSi no estableces esta política para un sitio, se aplicará la política de DefaultJavaScriptJitSetting al sitio, si se establece. De lo contrario, se habilitará JavaScript con JIT para el sitio.";
JavaScriptJitBlockedForSites.pfm_title = "Impedir que JavaScript utilice JIT en estos sitios";
JavaScriptJitBlockedForSites.pfm_description = "Te permite establecer una lista de patrones de URL de sitios donde se indiquen los que no pueden ejecutar JavaScript con el compilador JIT (Just In Time) habilitado.\n\nSi inhabilitas JavaScript con JIT, es posible que Brave procese el contenido web más lentamente y, además, inhabilite partes de JavaScript, incluido WebAssembly. Si inhabilitas JavaScript con JIT, Brave podría procesar el contenido web en una configuración más segura.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).\n\nSe pueden establecer excepciones de política para subdominios específicos, así como para sitios completos. Por ejemplo, una política establecida solo para subdominio.sitio.com se aplica a subdominio.sitio.com sin afectar a sitio.com. En algunos casos en los que un subdominio no se puede aislar de su sitio superior, puede heredar la política establecida en sitio.com. Es posible que las excepciones tampoco se apliquen a los marcos cargados en una pestaña existente hasta que el sitio se abra en una pestaña nueva. En dispositivos Android con poca memoria, es posible que no se apliquen las excepciones específicas del sitio y, en su lugar, los sitios usarán la política de DefaultJavaScriptJitSetting si se establece, o se usará de forma predeterminada el parámetro de configuración de JavaScript con JIT del perfil.\n\nPara aplicar excepciones, Brave puede colocar sitios o subdominios cuya configuración difiera de la predeterminada en procesos específicos. Esto puede aumentar el uso de memoria, especialmente en Android o cuando un patrón de comodín coincide con muchos subdominios, ya que cada origen coincidente puede aislarse por separado. Los subdominios aislados tampoco pueden usar documento.dominio para acceder a su sitio superior.\n\nNota: En las versiones 155 y anteriores, las excepciones de la política solo se aplicaban por sitio (eTLD+1). Una política establecida solo para subdominio.sitio.com no se aplicaba, ni siquiera para subdominio.sitio.com. Debía establecerse en sitio.com para que se aplicara tanto a sitio.com como a subdominio.sitio.com.\n\nEsta política se aplica por fotograma y no solo en función de la URL de origen de nivel superior. Por ejemplo, si sitio-uno.com aparece en la política JavaScriptJitBlockedForSites, pero sitio-uno.com carga un fotograma que contiene sitio-dos.com, sitio-uno.com tendrá inhabilitado JavaScript con JIT, pero sitio-dos.com usará la política de DefaultJavaScriptJitSetting, si se establece, o se habilitará JavaScript con JIT de forma predeterminada. Las entradas de la lista de patrones bloqueados tienen mayor prioridad que las entradas de la lista de patrones permitidos, que, a su vez, tienen mayor prioridad que el valor predeterminado configurado.\n\nSi no estableces esta política para un sitio, se aplicará la política de DefaultJavaScriptJitSetting al sitio, si se establece. De lo contrario, se habilitará JavaScript con JIT para el sitio.";
JavaScriptOptimizerAllowedForSites.pfm_title = "Permitir la optimización de JavaScript en estos sitios";
JavaScriptOptimizerAllowedForSites.pfm_description = "Te permite establecer una lista de patrones de URL de sitios que especifican los sitios para los cuales\nse habilitan las optimizaciones avanzadas de JavaScript.\n\nPara obtener información detallada sobre los patrones de URL de sitios válidos, consulta\nhttps://chromeenterprise.google/policies/url-patterns.\nSe permite el uso de caracteres comodín (*).\n\nSe pueden establecer excepciones de política para subdominios específicos, así como para sitios completos.\nPor ejemplo, una política establecida solo para subdominio.sitio.com se aplica a\nsubdominio.sitio.com sin afectar a sitio.com. En algunos casos en los que un\nsubdominio no se puede aislar de su sitio superior, puede heredar la política\nestablecida en sitio.com. Es posible que las excepciones tampoco se apliquen a los marcos cargados en una\npestaña existente hasta que el sitio se abra en una pestaña nueva. En dispositivos con poca memoria\nAndroid, es posible que no se apliquen las excepciones específicas del sitio y, en su lugar, los sitios usarán la política de\nDefaultJavaScriptOptimizerSetting,\nsi se establece, o la configuración predeterminada de optimización de JavaScript del perfil.\n\nPara aplicar excepciones, Brave\npuede colocar sitios o subdominios cuya configuración difiera de la predeterminada en\nprocesos específicos. Esto puede aumentar el uso de memoria, especialmente en\nAndroid o cuando un patrón de comodín coincide con muchos\nsubdominios, ya que cada origen coincidente puede aislarse por separado. Los subdominios aislados\ntampoco pueden usar documento.dominio para acceder a su sitio superior.\n\nNota: En las versiones 138 y anteriores, las excepciones de la política solo se\naplicaban por sitio (eTLD+1). Una política establecida solo para subdominio.sitio.com no\ntuvo efecto, ni siquiera para subdominio.sitio.com; se tuvo que establecer en sitio.com para\naplicarse tanto a sitio.com como a subdominio.sitio.com.\n\nEsta política se aplica marco por marco y no solo en función de la URL de origen de nivel superior,\npor lo que, por ejemplo, si sitio-uno.com aparece en la política JavaScriptOptimizerAllowedForSites, pero sitio-uno.com carga un marco\nque contiene sitio-dos.com, sitio-uno.com tendrá habilitadas las optimizaciones de JavaScript,\npero sitio-dos.com usará la política de DefaultJavaScriptOptimizerSetting, si se establece, o se habilitarán las optimizaciones de JavaScript\nde forma predeterminada. Las entradas de la lista de entidades bloqueadas tienen mayor prioridad que las entradas de la\nlista de entidades permitidas, que, a su vez, tienen mayor prioridad que el valor predeterminado configurado.\n\nSi no estableces esta política para un sitio, se aplicará la política de DefaultJavaScriptOptimizerSetting al sitio, si se establece. De lo contrario, se habilitará\nla optimización de JavaScript para el sitio.";
JavaScriptOptimizerBlockedForSites.pfm_title = "Bloquear las optimizaciones de JavaScript en estos sitios";
JavaScriptOptimizerBlockedForSites.pfm_description = "Te permite establecer una lista de patrones de URL de sitios que especifican los sitios para los cuales\nse inhabilitan las optimizaciones avanzadas de JavaScript.\n\nSi inhabilitas las optimizaciones de JavaScript, es posible que Brave renderice el contenido web más lentamente.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta\nhttps://chromeenterprise.google/policies/url-patterns.\nSe permite el uso de caracteres comodín (*).\n\nSe pueden establecer excepciones de política para subdominios específicos, así como para sitios completos.\nPor ejemplo, una política establecida solo para subdominio.sitio.com se aplica a\nsubdominio.sitio.com sin afectar a sitio.com. En algunos casos en los que un\nsubdominio no se puede aislar de su sitio superior, puede heredar la política\nestablecida en sitio.com. Es posible que las excepciones tampoco se apliquen a los marcos cargados en una\npestaña existente hasta que el sitio se abra en una pestaña nueva. En dispositivos con poca memoria\nAndroid, es posible que no se apliquen las excepciones específicas del sitio y, en su lugar, los sitios usarán la política de\nDefaultJavaScriptOptimizerSetting,\nsi se establece, o la configuración predeterminada de optimización de JavaScript del perfil.\n\nPara aplicar excepciones, Brave\npuede colocar sitios o subdominios cuya configuración difiera de la predeterminada en\nprocesos específicos. Esto puede aumentar el uso de memoria, especialmente en\nAndroid o cuando un patrón de comodín coincide con muchos\nsubdominios, ya que cada origen coincidente puede aislarse por separado. Los subdominios aislados\ntampoco pueden usar documento.dominio para acceder a su sitio superior.\n\nNota: En las versiones 138 y anteriores, las excepciones de la política solo se aplicaban en el nivel de detalle\ndel sitio (eTLD+1). Una política establecida solo para subdominio.sitio.com no\ntuvo efecto, ni siquiera para subdominio.sitio.com; se tuvo que establecer en sitio.com para\naplicarse tanto a sitio.com como a subdominio.sitio.com.\n\nEsta política se aplica fotograma por fotograma y no solo en función de la URL de origen de nivel superior,\npor lo que, por ejemplo, si sitio-uno.com aparece en la política JavaScriptOptimizerBlockedForSites, pero sitio-uno.com carga un fotograma\nque contiene sitio-dos.com, sitio-uno.com tendrá inhabilitadas las optimizaciones de JavaScript,\npero sitio-dos.com usará la política de DefaultJavaScriptOptimizerSetting, si se establece, o se habilitarán las optimizaciones de JavaScript\nde forma predeterminada. Las entradas de la lista de entidades bloqueadas tienen mayor prioridad que las entradas de la\nlista de entidades permitidas, que, a su vez, tienen mayor prioridad que el valor predeterminado configurado.\n\nSi no estableces esta política para un sitio, se aplicará la política de DefaultJavaScriptOptimizerSetting al sitio, si se establece. De lo contrario, se habilitará\nla optimización de JavaScript para el sitio.";
LiveCaptionEnabled.pfm_title = "Activar el subtitulado instantáneo";
LiveCaptionEnabled.pfm_description = "Habilita la función de Subtitulado instantáneo.\n\nSi habilitas esta política, la función Subtitulado instantáneo estará siempre activada.\n\nSi la inhabilitas, el Subtitulado instantáneo siempre estará desactivado.\n\nSi estableces esta política como obligatoria, los usuarios no podrán cambiarla ni anularla.\n\nSi no la estableces, el Subtitulado instantáneo estará inicialmente inhabilitado, pero el usuario podrá habilitarlo en cualquier momento.";
LiveTranslateEnabled.pfm_title = "Habilitar la Traducción instantánea";
LiveTranslateEnabled.pfm_description = "Habilita la traducción de subtítulos instantáneos. Los subtítulos se enviarán a Google para su traducción.\n\nSi habilitas esta política, la función Traducción instantánea estará siempre activada.\n\nSi la inhabilitas, la Traducción instantánea siempre estará desactivada.\n\nSi estableces esta política como obligatoria, los usuarios no podrán cambiarla ni anularla.\n\nSi no la estableces, la Traducción instantánea estará inicialmente inhabilitada, pero el usuario podrá habilitarla en cualquier momento.\n\nSi inhabilitas LiveCaptionEnabled, se inhabilitará la Traducción instantánea, independientemente de la configuración de esta política.";
LocalFontsAllowedForUrls.pfm_title = "Otorgar el permiso de fuentes locales para estos sitios";
LocalFontsAllowedForUrls.pfm_description = "Establece una lista de patrones de URL de sitios que enumera los que otorgarán automáticamente el permiso de fuentes locales. Esto ampliará la capacidad de los sitios para ver la información sobre las fuentes locales.\n\nPara obtener información detallada sobre los patrones de URL de sitios válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.\n\nSi no estableces esta política para un sitio, se aplicará la política de DefaultLocalFontsSetting al sitio, si se establece. De lo contrario, el permiso seguirá la configuración predeterminada del navegador y permitirá a los usuarios elegir este permiso para cada sitio.";
LocalFontsBlockedForUrls.pfm_title = "Bloquear el permiso de fuentes locales para estos sitios";
LocalFontsBlockedForUrls.pfm_description = "Establece una lista de patrones de URL de sitios donde se indiquen los que rechazarán automáticamente el permiso de fuentes locales. Esto limitará la capacidad de los sitios para ver la información sobre las fuentes locales.\n\nPara obtener información detallada sobre los patrones de URL de sitios válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.\n\nSi no estableces esta política para un sitio, se aplicará la política de DefaultLocalFontsSetting al sitio, si se establece. De lo contrario, el permiso seguirá la configuración predeterminada del navegador y permitirá a los usuarios elegir este permiso para cada sitio.";
LocalNetworkAccessAllowedForUrls.pfm_title = "Permitir que los sitios envíen solicitudes de red a dispositivos locales y endpoints de red locales.";
LocalNetworkAccessAllowedForUrls.pfm_description = "Lista de patrones de URL. Las solicitudes iniciadas en sitios web entregados por orígenes coincidentes no están sujetas a verificaciones del Local Network Access.\n\nEn el caso de orígenes no contemplados en los patrones especificados en la política, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns/.\n\nPara conocer las restricciones de Local Network Access, consulta https://wicg.github.io/local-network-access/.\n\nHay varias políticas que enumeran los orígenes que afectan las solicitudes a los endpoints de red locales y de dispositivos locales. Si un origen coincide con más de una de las siguientes políticas, las políticas tienen prioridad en el siguiente orden:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessBlockedForUrls.pfm_title = "Impedir que los sitios realicen solicitudes de red a dispositivos locales y endpoints de red locales.";
LocalNetworkAccessBlockedForUrls.pfm_description = "Lista de patrones de URL. Se bloquea la emisión de solicitudes de Local Network Access desde solicitudes iniciadas en sitios web entregados por orígenes coincidentes.\n\nEn el caso de orígenes no contemplados en los patrones especificados en la política, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns/.\n\nPara conocer las restricciones de Local Network Access, consulta https://wicg.github.io/local-network-access/.\n\nHay varias políticas que enumeran los orígenes que afectan las solicitudes a los endpoints de red locales y de dispositivos locales. Si un origen coincide con más de una de las siguientes políticas, las políticas tienen prioridad en el siguiente orden:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_title = "Anular las asignaciones de espacio de direcciones IP";
LocalNetworkAccessIpAddressSpaceOverrides.pfm_description = "Esto se puede usar para tratar ciertos rangos de direcciones internas como \"públicos\" y, por lo tanto, no sujetos a las verificaciones de Local Network Access. Por el contrario, esto se puede usar para tratar ciertos rangos de direcciones públicas que podrían usarse internamente como \"locales\" para que estén protegidos por las verificaciones de Local Network Access.\n\nLas anulaciones del espacio de direcciones IP tienen dos formas:\n\n[cidr]=[public|local|loopback]\n\ndonde [cidr] es un rango de direcciones IP en notación CIDR (consulta la sección 3.1 de https://tools.ietf.org/html/rfc4632 para IPv4 y la sección 2.3 de https://tools.ietf.org/html/rfc4291 para IPv6). Las direcciones IPv6 deben especificarse en formato seguro para URL (entre corchetes). Las anulaciones de CIDR se aplican a todos los puertos.\n\no\n\n[ip-address]:[port]=[public|local|loopback]\n\nPara obtener más información sobre Local Network Access, consulta https://wicg.github.io/local-network-access/ y https://developer.chrome.com/blog/local-network-access.\n\nEsta política no admite la actualización dinámica.\n\nLas anulaciones del parámetro de línea de comandos --ip-address-space-overrides tienen prioridad sobre las anulaciones establecidas por esta política.";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_title = "Permitir solicitudes de acceso a la red local (LNA) en submarcos sin delegación explícita";
LocalNetworkAccessPermissionsPolicyDefaultEnabled.pfm_description = "De forma predeterminada, solo se permite solicitar los permisos para el Acceso a la red local (LNA) en submarcos de origen cruzado si se delegan de forma explícita. Esta política se puede usar para anular este comportamiento predeterminado, de modo que los permisos de LNA se hereden de forma predeterminada en los subframes, a menos que se denieguen de forma explícita en la política de permisos.\n\nSi habilitas esta política, los submarcos tendrán delegadas de forma predeterminada todas las funciones de la política de permisos de LNA y podrán realizar solicitudes de red local (lo que activará la solicitud de permiso).\n\nSi inhabilitas esta política o no la estableces, los submarcos deben delegar explícitamente la función de política de permisos para realizar solicitudes de red local y activar la solicitud de permiso.\n\nEsta política se aplica a las funciones de la política de permisos \"local-network-access\", \"loopback-network\" y \"local-network\".\n\nPara obtener más información sobre el acceso a la red local, consulta https://wicg.github.io/local-network-access/ y https://developer.chrome.com/blog/local-network-access.\n\nPara obtener más información sobre la política de permisos, consulta https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Permissions_Policy.";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_title = "Especificar si se deben inhabilitar (temporalmente) las restricciones de acceso a la red local";
LocalNetworkAccessRestrictionsTemporaryOptOut.pfm_description = "Si habilitas esta política, las solicitudes de Local Network Access\nsolo mostrarán advertencias en Chrome DevTools debido a errores en las verificaciones de Local Network Access.\n\nSi la inhabilitas o no la estableces, las solicitudes de Local Network Access usarán el\nmanejo predeterminado de estas solicitudes.\n\nPara conocer las restricciones de Local Network Access, consulta https://wicg.github.io/local-network-access/.\n\nEsta política empresarial es temporal y se quitará después de la versión M163.\n\nA largo plazo, la política LocalNetworkAccessAllowedForUrls\nse puede usar para crear una lista de entidades permitidas de patrones de URL a los que se les debe otorgar automáticamente\nel permiso Local Network Access.";
LocalNetworkAllowedForUrls.pfm_title = "Permitir que los sitios envíen solicitudes a endpoints de red locales.";
LocalNetworkAllowedForUrls.pfm_description = "Lista de patrones de URL. Las solicitudes de red iniciadas en sitios web entregados por orígenes coincidentes a endpoints de red locales no están sujetas a verificaciones del Local Network Access.\n\nEn el caso de orígenes no contemplados en los patrones especificados en la política, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns/.\n\nPara conocer las restricciones de Local Network Access, consulta https://wicg.github.io/local-network-access/.\n\nHay varias políticas que enumeran los orígenes que afectan las solicitudes a los endpoints de red locales. Si un origen coincide con más de una de las siguientes políticas, las políticas tienen prioridad en el siguiente orden:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LocalNetworkBlockedForUrls.pfm_title = "Impedir que los sitios realicen solicitudes a endpoints de red locales.";
LocalNetworkBlockedForUrls.pfm_description = "Lista de patrones de URL. Se bloquea la emisión de solicitudes de Local Network Access desde solicitudes de red iniciadas en sitios web entregados por orígenes coincidentes a endpoints de red locales.\n\nEn el caso de orígenes no contemplados en los patrones especificados en la política, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns/.\n\nPara conocer las restricciones de Local Network Access, consulta https://wicg.github.io/local-network-access/.\n\nHay varias políticas que enumeran los orígenes que afectan las solicitudes a los endpoints de red locales. Si un origen coincide con más de una de las siguientes políticas, las políticas tienen prioridad en el siguiente orden:\n\n- LocalNetworkBlockedForUrls\n- LocalNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LookalikeWarningAllowlistDomains.pfm_title = "Elimina advertencias de dominios similares en dominios";
LookalikeWarningAllowlistDomains.pfm_description = "Esta política impide que se muestren advertencias de URL similares en los sitios incluidos en la lista. Por lo general, se muestran estas advertencias en sitios que Brave interpreta que falsifican otro sitio con el que el usuario está familiarizado.\n\nSi habilitas la política y la estableces en uno o más dominios, no se mostrarán páginas de advertencias de sitios similares cuando el usuario visite páginas de ese dominio.\n\nSi no habilitas la política o la estableces como una lista vacía, podrán aparecer advertencias en cualquier sitio que visite el usuario.\n\nPuede habilitarse un nombre de host con una coincidencia de host completa o cualquier coincidencia de dominio. Por ejemplo, es posible que se eliminen las advertencias de una URL como https://foo.example.com/bar si esta lista incluye foo.example.com o example.com.";
LoopbackNetworkAllowedForUrls.pfm_title = "Permitir que los sitios envíen solicitudes de red al dispositivo local.";
LoopbackNetworkAllowedForUrls.pfm_description = "Lista de patrones de URL. Las solicitudes de red iniciadas desde sitios web entregados por orígenes coincidentes al dispositivo local no están sujetas a verificaciones de Local Network Access.\n\nEn el caso de orígenes no contemplados en los patrones especificados en la política, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns/.\n\nPara conocer las restricciones de Local Network Access, consulta https://wicg.github.io/local-network-access/.\n\nHay varias políticas que enumeran los orígenes que afectan las solicitudes al dispositivo local. Si un origen coincide con más de una de las siguientes políticas, las políticas tienen prioridad en el siguiente orden:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
LoopbackNetworkBlockedForUrls.pfm_title = "Impedir que los sitios realicen solicitudes de red al dispositivo local.";
LoopbackNetworkBlockedForUrls.pfm_description = "Lista de patrones de URL. Se bloquea la emisión de solicitudes de Local Network Access desde solicitudes de red iniciadas en sitios web entregados por orígenes coincidentes al dispositivo local.\n\nEn el caso de orígenes no contemplados en los patrones especificados en la política, se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta https://chromeenterprise.google/policies/url-patterns/.\n\nPara conocer las restricciones de Local Network Access, consulta https://wicg.github.io/local-network-access/.\n\nHay varias políticas que enumeran los orígenes que afectan las solicitudes al dispositivo local. Si un origen coincide con más de una de las siguientes políticas, las políticas tienen prioridad en el siguiente orden:\n\n- LoopbackNetworkBlockedForUrls\n- LoopbackNetworkAllowedForUrls\n- LocalNetworkAccessBlockedForUrls\n- LocalNetworkAccessAllowedForUrls";
ManagedBookmarks.pfm_title = "Favoritos administrados";
ManagedBookmarks.pfm_description = "Si estableces la política, se define una lista de favoritos en la que cada uno es un diccionario que contiene las claves \"name\" y \"url\" con el nombre y destino del favorito, respectivamente. Los administradores pueden configurar una subcarpeta definiendo un favorito sin una clave \"url\", pero con una clave \"children\" adicional. Esta clave también incluye una lista de favoritos (algunos pueden ser carpetas). Chrome modifica las URL incompletas como si fueran enviadas a través de la barra de direcciones, p. ej., \"google.com\" cambia a \"https://google.com/\".\n\nLos usuarios no pueden modificar las carpetas donde se guardan los favoritos (pero pueden ocultarlas en la barra de favoritos). El nombre de carpeta predeterminado para los favoritos administrados es \"Favoritos administrados\", pero puede modificarse. Para hacerlo agrega un diccionario secundario en la política con una sola clave que se denomine \"toplevel_name\" y que incluya el nombre de carpeta deseado como su valor. Los favoritos administrados no se sincronizan con la cuenta del usuario ni se pueden modificar mediante extensiones.\nConsulta https://chromeenterprise.google/policies/?policy=ManagedBookmarks para obtener más información sobre el esquema y el formato.";
ManagedConfigurationPerOrigin.pfm_title = "Establece los valores de la configuración administrada como los sitios web de orígenes específicos";
ManagedConfigurationPerOrigin.pfm_description = "Si configuras la política, se definirá el valor que muestra la API Managed Configuration para un origen determinado.\n\nLa API Managed Configuration es una configuración de pares clave-valor a la cual se puede acceder mediante la llamada de JavaScript navigator.managed.getManagedConfiguration(). Esta API solo está disponible para los orígenes que corresponden a las aplicaciones web que se instalaron de manera automática mediante WebAppInstallForceList.\nConsulta https://chromeenterprise.google/policies/?policy=ManagedConfigurationPerOrigin para obtener más información sobre el esquema y el formato.";
MaxConnectionsPerProxy.pfm_title = "Cantidad máxima de conexiones simultáneas por servidor proxy para solicitudes que no son de WebSocket";
MaxConnectionsPerProxy.pfm_description = "Si estableces la política, se especificará la cantidad máxima de conexiones en simultáneo por servidor proxy para solicitudes que no sean de WebSocket.\n\nPara modificar los límites de solicitudes de WebSocket, consulta MaxConnectionsPerProxyForWebSocket.\n\nSi no estableces la política, se usará el valor predeterminado de 128.\n\nAlgunas apps web son conocidas por utilizar muchas conexiones con solicitudes GET pendientes. Por lo tanto, si estableces un valor menor a 128 es posible que la red del navegador quede pendiente si hay demasiadas apps web con conexiones pendientes abiertas.\nAlgunos servidores proxy no pueden soportar una gran cantidad de conexiones en simultáneo por cliente. Para solucionar este problema, establece un valor más bajo para esta política.\n\nEl valor debe ser igual o superior a 6.\nSi estableces un valor por debajo de ese límite, se usará 6.\nUsa un valor menor al valor predeterminado (128) bajo tu responsabilidad.\n\nEl valor debe ser igual o inferior a 256 (99 en Brave 147 y versiones anteriores).\nSi estableces un valor superior a ese límite, se usará 256 (99 en Brave 147 y versiones anteriores).\nUsa un valor mayor al valor predeterminado (128) bajo tu responsabilidad.\n\nTen en cuenta que los límites aplicados se ven afectados por AllowSocketPoolSizeRandomizationForProxies.";
MaxConnectionsPerProxyForWebSocket.pfm_title = "Cantidad máxima de conexiones simultáneas por servidor proxy para solicitudes de WebSocket";
MaxConnectionsPerProxyForWebSocket.pfm_description = "Si estableces la política, se especificará la cantidad máxima de conexiones en simultáneo por servidor proxy para las solicitudes de WebSocket.\n\nPara modificar los límites de solicitudes que no son de WebSocket, consulta MaxConnectionsPerProxy.\n\nSi no estableces la política, se usará el valor predeterminado de 128.\n\nAlgunas apps web son conocidas por utilizar muchas conexiones con solicitudes GET pendientes. Por lo tanto, si estableces un valor menor a 128 es posible que la red del navegador quede pendiente si hay demasiadas apps web con conexiones pendientes abiertas.\nAlgunos servidores proxy no pueden soportar una gran cantidad de conexiones en simultáneo por cliente. Para solucionar este problema, establece un valor más bajo para esta política.\n\nEl valor debe ser igual o superior a 6.\nSi estableces un valor por debajo de ese límite, se usará 6.\nUsa un valor menor al valor predeterminado (128) bajo tu responsabilidad.\n\nEl valor debe ser igual o inferior a 256.\nSi estableces un valor superior a ese límite, se usará 256.\nUsa un valor mayor al valor predeterminado (128) bajo tu responsabilidad.\n\nTen en cuenta que los límites aplicados se ven afectados por AllowSocketPoolSizeRandomizationForProxies.";
MaxInvalidationFetchDelay.pfm_title = "Demora de recuperación máxima después de invalidar una política";
MaxInvalidationFetchDelay.pfm_description = "Si estableces la política, se especificará la demora máxima (expresada en milisegundos) entre que se invalida una política y se recupera la nueva política del servicio de administración de dispositivos. Los valores válidos son de 1,000 (1 segundo) a 300,000 (5 minutos). Los valores fuera de este rango se ajustarán conforme al límite correspondiente.\n\nSi no estableces la política, Brave utilizará el valor predeterminado de 10 segundos.";
MediaRecommendationsEnabled.pfm_title = "Habilitar las recomendaciones de contenido multimedia";
MediaRecommendationsEnabled.pfm_description = "De forma predeterminada, el navegador mostrará recomendaciones de contenido multimedia personalizadas para el usuario. Si inhabilitas esta política, el usuario no verá estas recomendaciones. Si la habilitas o no la estableces, el usuario verá las recomendaciones de contenido multimedia.";
MediaRouterCastAllowAllIPs.pfm_title = "Permitir que Google Cast se conecte a los dispositivos de transmisión en todas las direcciones IP";
MediaRouterCastAllowAllIPs.pfm_description = "A menos que inhabilites EnableMediaRouter, si habilitas MediaRouterCastAllowAllIPs, se conectará Google Cast a dispositivos de transmisión en todas las direcciones IP, no solo en las direcciones privadas RFC1918/RFC4193.\n\nSi inhabilitas la política, se conectará Google Cast a dispositivos de transmisión solo en las direcciones RFC1918/RFC4193.\n\nSi no la estableces, se conectará Google Cast a dispositivos de transmisión solo en las direcciones RFC1918/RFC4193, a menos que se active la función CastAllowAllIPs.";
MemorySaverModeSavings.pfm_title = "Cambiar el ahorro del modo de Ahorro de memoria";
MemorySaverModeSavings.pfm_description = "0 - Ahorro de memoria moderado.\n1 - Ahorro de memoria equilibrado.\n2 - Ahorro de memoria máximo.\nEsta política cambia el nivel de ahorro del Ahorro de memoria.\n\nEsto solo se aplica cuando el Ahorro de memoria está habilitado en la configuración o a través de la política HighEfficiencyModeEnabled, y afectará la forma en que se usan las heurísticas para determinar cuándo descartar las pestañas. Por ejemplo, reducir la vida útil de una pestaña inactiva antes de descartarla puede ahorrar memoria, pero también significa que las pestañas se volverán a cargar con más frecuencia, lo que puede generar una mala experiencia del usuario y generar más tráfico de red.\n\nSi estableces la política con el valor \"0\", el Ahorro de memoria obtendrá un ahorro de memoria moderado. Las pestañas se vuelven inactivas después de un período más largo.\n\nSi estableces la política con el valor \"1\", el Ahorro de memoria obtendrá un ahorro de memoria equilibrado. Las pestañas se vuelven inactivas después de un período óptimo.\n\nSi estableces la política con el valor \"2\", el Ahorro de memoria obtendrá el ahorro de memoria máximo. Las pestañas se vuelven inactivas después de un período más corto.\n\nSi no estableces esta política, el usuario final podrá controlar esta configuración desde chrome://settings/performance.";
MetricsReportingEnabled.pfm_title = "Habilitar informes de uso y datos relacionados con bloqueos";
MetricsReportingEnabled.pfm_description = "When this policy is Enabled, anonymous reporting of usage and crash-related data about Brave to Google is recommended to be enabled by default. Users will still be able to change this setting.\n\nWhen this policy is Disabled, anonymous reporting is disabled and no usage or crash data is sent to Google. Users won't be able to change this setting.\n\nWhen this policy is not set, users can choose the anonymous reporting behavior at installation or first run, and can change this setting later.\n\n(For Google Chrome OS, see DeviceMetricsReportingEnabled.)";
NTPCardsVisible.pfm_title = "Muestra tarjetas en la página Nueva pestaña";
NTPCardsVisible.pfm_description = "Esta política controla la visibilidad de las tarjetas en la página Nueva pestaña. Las tarjetas proporcionan puntos de entrada para iniciar trayectorias comunes de los usuarios en función de su comportamiento de navegación.\n\nSi habilitas la política, la página Nueva pestaña mostrará tarjetas si hay contenido disponible.\n\nSi la inhabilitas, la página Nueva pestaña no mostrará tarjetas.\n\nSi no la estableces, el usuario podrá controlar la visibilidad de las tarjetas. Las tarjetas son visibles de forma predeterminada.\n";
NTPCustomBackgroundEnabled.pfm_title = "Permite que los usuarios personalicen el fondo en la página Nueva pestaña";
NTPCustomBackgroundEnabled.pfm_description = "Si se establece la política como falsa, los usuarios no podrán personalizar el fondo en la página Nueva pestaña. En caso de que haya un fondo personalizado, este se quitará de forma permanente, incluso si más tarde se establece la política como verdadera.\n\nSi se establece la política como verdadera o no se establece, los usuarios podrán personalizar el fondo en la página Nueva pestaña.\n\nNota: En Android, la política se aplica al navegador solo después de reiniciarlo.";
NTPFooterExtensionAttributionEnabled.pfm_title = "Controlar la visibilidad de la atribución de la extensión en la página Nueva pestaña";
NTPFooterExtensionAttributionEnabled.pfm_description = "Esta política determina si se muestra una atribución a la extensión que modifica la página Nueva pestaña en el pie de página de esta.\n\nDe forma predeterminada, si una extensión anuló la página Nueva pestaña estándar, aparecerá un mensaje en el pie de página que atribuirá este cambio a la extensión específica. Por lo general, esta atribución incluye un vínculo a la extensión relevante en Chrome Web Store.\n\nSi no estableces la política o la estableces como verdadera, la atribución de la extensión será visible en el pie de página de la página Nueva pestaña cuando una extensión la controle.\n\nSi la estableces como falsa, se suprimirá la atribución a la extensión en el pie de página de la página Nueva pestaña.";
NTPFooterManagementNoticeEnabled.pfm_title = "Controlar la visibilidad del aviso de administración en la página Nueva pestaña para los navegadores administrados";
NTPFooterManagementNoticeEnabled.pfm_description = "Esta política controla la visibilidad del aviso de administración en el pie de página de la página Nueva pestaña. De forma predeterminada, el pie de página de la página Nueva Pestaña muestra información cuando el navegador está administrado por una organización (indicado por un ícono de edificio y \"Administrado por [nombre del dominio]\"). Esto se puede personalizar con las políticas EnterpriseCustomLabelForBrowser y EnterpriseLogoUrlForBrowser.\n\nSi no la estableces o la estableces como verdadera, los navegadores administrados mostrarán el aviso \"Administrado por…\" con un ícono.\n\nSi estableces esta política como falsa, se ocultará el aviso de administración.\n\nTen en cuenta que esta política solo se aplica a los navegadores administrados, por lo que no tendrá efecto en los usuarios administrados en navegadores no administrados.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
NTPOutlookCardVisible.pfm_title = "Mostrar la tarjeta del calendario de Outlook en la página Nueva pestaña";
NTPOutlookCardVisible.pfm_description = "Esta política controla la visibilidad de la tarjeta de Outlook en la página Nueva pestaña. La tarjeta solo se mostrará en la página Nueva pestaña si la política está habilitada y tu organización autorizó el uso de los datos del calendario de Outlook en el navegador.\n\nEl navegador no almacenará los datos de Outlook.\n\nLa tarjeta de Outlook muestra el próximo evento de calendario, junto con una vista rápida del resto de las reuniones del día. Su objetivo es abordar el problema relacionado con el cambio de contexto y mejorar la productividad brindándoles a los usuarios un acceso directo a su próxima reunión.\n\nLa tarjeta de Microsoft Outlook requerirá una configuración adicional del administrador. Si quieres obtener información detallada para conectar la tarjeta de la página Nueva pestaña de Chrome a Outlook, consulta https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nSi inhabilitas NTPCardsVisible, no se mostrará la tarjeta de Outlook. Si habilitas NTPCardsVisible, se mostrará la tarjeta de Outlook si esta política también está habilitada y hay datos para mostrar. Si no estableces NTPCardsVisible, se mostrará la tarjeta de Outlook si esta política también está habilitada, el usuario tiene la tarjeta habilitada en Personalizar Chrome y hay datos para mostrar.";
NTPSharepointCardVisible.pfm_title = "Mostrar la tarjeta de archivos de SharePoint y OneDrive en la página Nueva pestaña";
NTPSharepointCardVisible.pfm_description = "Esta política controla la visibilidad de la tarjeta de archivos de SharePoint y OneDrive en la página Nueva pestaña. La tarjeta solo se mostrará en la página Nueva pestaña si la política está habilitada y tu organización autorizó el uso de los datos de archivos de SharePoint y OneDrive en el navegador.\n\nEl navegador no almacenará los datos de SharePoint ni OneDrive.\n\nEn la tarjeta de recomendaciones de archivos de SharePoint y OneDrive, se muestra una lista de archivos recomendados.  Su objetivo es abordar el problema relacionado con el cambio de contexto y mejorar la productividad brindándoles a los usuarios un acceso directo a sus documentos más importantes.\n\nLa tarjeta de Microsoft SharePoint y OneDrive requerirá una configuración adicional del administrador. Si quieres obtener información detallada para conectar la tarjeta de la página Nueva pestaña de Chrome a SharePoint, consulta https://support.google.com/chrome/a?p=chrome_ntp_microsoft_cards.\n\nSi inhabilitas NTPCardsVisible, no se mostrará la tarjeta de SharePoint ni OneDrive. Si habilitas NTPCardsVisible, se mostrarán la tarjeta de SharePoint y la de OneDrive si esta política también está habilitada y hay datos para mostrar. Si no estableces NTPCardsVisible, se mostrarán la tarjeta de SharePoint y la de OneDrive si esta política también está habilitada, el usuario tiene la tarjeta habilitada en Personalizar Chrome y hay datos para mostrar.";
NTPShortcuts.pfm_title = "Configurar accesos directos en la página Nueva pestaña";
NTPShortcuts.pfm_description = "Si estableces la política, se preconfigurarán hasta 10 accesos directos personalizados en la página Nueva pestaña de Brave.\n\nSi lo haces, los usuarios verán estos accesos directos de forma predeterminada, además de sus accesos directos personales. Los usuarios pueden controlar la visibilidad de los accesos directos de su organización en el panel \"Personalizar Chrome\".\n\nLas URLs de los accesos directos deben ser únicas.\n\nSi se establece la política allow_user_edit como verdadera, los usuarios pueden cambiar el nombre del acceso directo. Si se establece como falsa o no se establece, los usuarios no pueden editar el nombre.\n\nSi se establece la política allow_user_delete como verdadera, los usuarios pueden quitar el acceso directo. Si se establece como falsa o no se establece, los usuarios no pueden quitar el acceso directo.\nConsulta https://chromeenterprise.google/policies/?policy=NTPShortcuts para obtener más información sobre el esquema y el formato.";
NativeMessagingAllowlist.pfm_title = "Nombres de hosts de mensajería nativa que deben excluirse de la lista de elementos bloqueados";
NativeMessagingAllowlist.pfm_description = "Si estableces la política, se especificarán los hosts de mensajería nativa que no deben incluirse en la lista de bloqueo. Un valor de * en una lista de bloqueo significa que todos los hosts de mensajería nativa están bloqueados, a menos que se permitan de forma explícita.\n\nDe forma predeterminada, se permiten todos los hosts de mensajería nativa. No obstante, si todos los hosts de mensajería nativa se bloquearon mediante una política, el administrador puede utilizar la lista de elementos permitidos para modificar la política.";
NativeMessagingBlocklist.pfm_title = "Nombres de los hosts de mensajería nativa prohibidos (o * para todos)";
NativeMessagingBlocklist.pfm_description = "Si estableces la política, se especificarán los hosts de mensajería nativa que no se deben cargar. Un valor de * en una lista de bloqueo significa que todos los hosts de mensajería nativa están bloqueados, a menos que se permitan de forma explícita.\n\nSi no estableces la política, Brave cargará todos los hosts de mensajería nativa instalados.";
NativeMessagingUserLevelHosts.pfm_title = "Permite el uso de hosts de mensajería nativa en el nivel de usuario (instalados sin permisos de administrador).";
NativeMessagingUserLevelHosts.pfm_description = "Si habilitas la política o no la estableces, Brave podrá usar los hosts de mensajería nativa instalados a nivel del usuario.\n\nSi inhabilitas la política, Brave solo podrá usar estos hosts cuando estén instalados a nivel del sistema.";
NetworkPredictionOptions.pfm_title = "Habilitar la predicción de red";
NetworkPredictionOptions.pfm_description = "0 - Predecir acciones de la red en cualquier conexión de red\n1 - Predecir las acciones de red en cualquier red que no sea móvil\n(Dejó de estar disponible en la versión 50 y se quitó en la versión 52. Después de esta versión, si se establece el valor 1, se trata como 0; es decir, se predicen las acciones de red en cualquier conexión de red).\n2 - No predecir acciones de la red en ninguna conexión de red\nEsta política controla la predicción de red en Brave. Controla la precarga de DNS, la preconexión a TCP y SSL, y la representación previa de páginas web.\n\nSi estableces la política, los usuarios no podrán cambiarla. Si no la estableces, se activará la predicción de red, pero el usuario podrá cambiarla.";
NewTabPageLocation.pfm_title = "URL de la página Nueva pestaña";
NewTabPageLocation.pfm_description = "Si estableces esta política, se configurará la URL predeterminada de la página Nueva pestaña y los usuarios no podrán cambiarla.\n\nSe abrirá la página Nueva pestaña con nuevas pestañas y ventanas.\n\nEsta política no definirá las páginas que se abren al iniciar el navegador. Esa tarea está controlada por las políticas RestoreOnStartup. Esta política afecta tanto a la página principal como a la página de inicio (si respectivamente están configuradas para abrir la página Nueva pestaña).\n\nSe recomienda proporcionar una URL totalmente canónica. De lo contrario, Brave se establecerá como https:// de forma predeterminada.\n\nSi no estableces la política o la dejas vacía, se utilizará la página Nueva pestaña predeterminada.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
NotificationsAllowedForUrls.pfm_title = "Permitir notificaciones en estos sitios";
NotificationsAllowedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que pueden mostrar notificaciones.\n\nSi no estableces la política, se aplicará DefaultNotificationsSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
NotificationsBlockedForUrls.pfm_title = "Bloquear notificaciones en estos sitios";
NotificationsBlockedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que no pueden mostrar notificaciones.\n\nSi no estableces la política, se aplicará DefaultNotificationsSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
NtlmV2Enabled.pfm_title = "Habilitar la autenticación NTLMv2";
NtlmV2Enabled.pfm_description = "Si habilitas la política o no la estableces, se activará la autenticación NTLMv2.\n\nSi inhabilitas la política, se desactivará la autenticación NTLMv2.\n\nTodas las versiones recientes de los servidores Microsoft® Windows® y Samba admiten la autenticación NTLMv2. Esta política solo debe desactivarse para obtener retrocompatibilidad, ya que reduce la seguridad a la hora de autenticarse.";
OopPrintDriversAllowed.pfm_title = "Permitir controladores de impresión fuera del proceso";
OopPrintDriversAllowed.pfm_description = "Controla si Brave interactúa con los controladores de las impresoras desde un proceso de servicio independiente. Las llamadas de impresión desde la plataforma para consultar las impresoras disponibles, obtener la configuración de los controladores de impresión y enviar documentos para imprimir en impresoras locales se realizan desde un proceso de servicio. Quitar esas llamadas del proceso del navegador ayuda a mejorar la estabilidad y reducir el comportamiento de IU bloqueada en la vista previa de impresión.\n\nSi habilitas esta política o no la estableces, Brave usará un proceso de servicio independiente para las tareas de impresión desde la plataforma.\n\nSi la inhabilitas, Brave usará el proceso del navegador para las tareas de impresión desde la plataforma.\n\nEsta política se quitará en el futuro, cuando se lance por completo la función de controladores de impresión fuera del proceso.";
OriginAgentClusterDefaultEnabled.pfm_title = "Permitir el agrupamiento en clústeres de agentes con clave de origen de forma predeterminada";
OriginAgentClusterDefaultEnabled.pfm_description = "Esta política permite el agrupamiento en clústeres de agentes con clave de origen de forma predeterminada.\n\nEl encabezado del HTTP Origin-Agent-Cluster controla si un documento está\naislado en un clúster de agentes con clave de origen o bien en un\nclúster con clave de sitio. Esto tiene repercusiones en la seguridad ya que un clúster de agentes con clave de origen\npermite el aislamiento de documentos por origen. La consecuencia\nvisible de esto para el desarrollador es que el descriptor de acceso de document.domain ya no podrá\nestablecerse.\n\nEl comportamiento predeterminado cuando no se establece un encabezado Origin-Agent-Cluster\ncambia en M111 de clave de sitio a clave de origen.\n\nSi habilitas o no estableces la política, el navegador seguirá la\nnueva configuración predeterminada de esa versión en adelante.\n\nSi la inhabilitas, se revierte este cambio y\nlos documentos que no contengan encabezados Origin-Agent-Cluster se asignarán a\nlos clústeres de agentes con clave de sitio. Como consecuencia, el descriptor de acceso de document.domain\npodrá establecerse de forma predeterminada. Esto coincide con el comportamiento heredado.\n\nPara obtener más información, consulta https://developer.chrome.com/blog/immutable-document-domain/.";
OriginKeyedProcessesEnabled.pfm_title = "Habilitar el aislamiento de procesos con clave de origen de forma predeterminada.";
OriginKeyedProcessesEnabled.pfm_description = "Habilita el aislamiento de procesos con clave de origen para la mayoría de las páginas (es decir, las que se asignan a un clúster de agentes con clave de origen de forma predeterminada). Esta política mejora la seguridad, pero también aumenta la cantidad de procesos creados. Los usuarios pueden anular el valor de la política establecida a través de la función experimental de línea de comandos o chrome://flags (para activar o desactivar esta función).\n\nSi habilitas la política, la mayoría de los orígenes quedarán aislados, incluso de otros orígenes del mismo sitio. Consulta también las políticas IsolateOrigins y SitePerProcess.\n\nSi inhabilitas la política, los orígenes no quedarán aislados del resto de su sitio, a menos que un origen lo solicite de forma explícita.\n\nSi no estableces la política, el navegador determinará qué orígenes aislar y cuándo hacerlo.";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_title = "Los orígenes o patrones de nombres de host para los cuales no deben aplicarse restricciones en los orígenes no seguros";
OverrideSecurityRestrictionsOnInsecureOrigin.pfm_description = "Si estableces la política, se especificará una lista de orígenes (URLs) o patrones de nombres de host (como *.example.com) para los que no se aplicarán restricciones de seguridad en orígenes inseguros. Los patrones solo se aceptan para los nombres de host; las URLs o los orígenes con esquemas deben ser strings exactos. Las organizaciones pueden especificar orígenes para las apps heredadas que no pueden implementar TLS o configurar un servidor de etapa de pruebas para desarrollos web internos. Así, los desarrolladores pueden probar las funciones que requieren contextos seguros sin tener que implementar TLS en el servidor de pruebas. Esta política también previene que el origen se considere \"No seguro\" en la barra de direcciones.\n\nEstablecer una lista de URLs en esta política equivale a establecer la función experimental de línea de comandos --unsafely-treat-insecure-origin-as-secure en una lista separada por comas de las mismas URLs. La política anulará esta función experimental y también UnsafelyTreatInsecureOriginAsSecure, si se aplica.\n\nPara obtener más información sobre contextos seguros, consulta Secure Contexts (https://www.w3.org/TR/secure-contexts).";
PartitionedBlobUrlUsage.pfm_title = "Elegir si las URLs de BLOB se particionan durante la recuperación y la navegación";
PartitionedBlobUrlUsage.pfm_description = "Esta política controla si las URLs de BLOB se particionan durante la recuperación y la navegación.\nSi habilitas esta política o no la estableces, se particionarán las URLs de BLOB.\nSi la inhabilitas, las URLs de BLOB no se particionarán.\n\nSi tienes que utilizar la política, informa un error en\nBrave\nen el que expliques tu caso de uso. La política está programada para\nofrecerse a través de la versión 146 de Brave,\ndespués de lo cual se quitará la implementación anterior.\n\nNOTA: Solo los procesos del renderizado recién iniciados reflejarán los cambios de esta\npolítica mientras se esté ejecutando el navegador.\n\nPara obtener información detallada sobre la partición de almacenamiento de terceros, consulta\nhttps://developers.google.com/privacy-sandbox/cookies/storage-partitioning.";
PasswordDismissCompromisedAlertEnabled.pfm_title = "Habilitar la opción de descartar las alertas de contraseña hackeada para las credenciales que hayas ingresado";
PasswordDismissCompromisedAlertEnabled.pfm_description = "Si habilitas esta política o no la estableces, el usuario podrá descartar o restablecer las alertas de contraseña hackeada.\n\nSi inhabilitas esta configuración, los usuarios no podrán descartar las alertas de contraseña hackeada. Si la habilitas, los usuarios podrán descartar las alertas de contraseña hackeada.";
PasswordLeakDetectionEnabled.pfm_title = "Habilita la detección de filtraciones en las credenciales que se ingresan";
PasswordLeakDetectionEnabled.pfm_description = "Si habilitas la política, los usuarios podrán hacer que Brave revise si los nombres de usuario y contraseñas ingresados estuvieron en una filtración.\n\nSi la inhabilitas, los usuarios no podrán usar esta función.\n\nSi estableces esta política, los usuarios no podrán cambiarla en Brave. Si no la estableces, se habilitará la revisión de filtración de credenciales, pero el usuario podrá desactivarla.";
PasswordManagerBlocklist.pfm_title = "Configurar la lista de dominios para los que se inhabilitará la función Password Manager (guardar y completar)";
PasswordManagerBlocklist.pfm_description = "Configura la lista de dominios en los que Brave debe inhabilitar el Password Manager. Esto significa que se inhabilitarán los flujos de trabajo de guardar y completar, lo que garantiza que las contraseñas de esos sitios web no se puedan guardar ni completar automáticamente en formularios web.\n\nSi un dominio está presente en la lista, se inhabilitará el Password Manager.\n\nSi un dominio no está presente en la lista, el Password Manager estará disponible para él.\n\nSi no estableces la política, el Password Manager estará disponible para todos los dominios.\n\nPara obtener información detallada sobre los patrones válidos de URL, consulta https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
PasswordManagerEnabled.pfm_title = "Habilitar el guardado de contraseñas en el administrador de contraseñas";
PasswordManagerEnabled.pfm_description = "Esta política controla la capacidad del navegador de recordar automáticamente las contraseñas en sitios web y guardarlas en el administrador de contraseñas integrado. No limita el acceso ni modifica el contenido de las contraseñas guardadas en el administrador de contraseñas, y es posible que se sincronicen con el perfil de la Cuenta de Google y Android.\n\nSi habilitas la política, Brave recordará las contraseñas y las proporcionará a los usuarios la siguiente vez que accedan a su cuenta en un sitio.\n\nSi inhabilitas la política, los usuarios no podrán guardar nuevas contraseñas, pero seguirán funcionando las que se hayan guardado antes.\n\nSi estableces esta política, los usuarios no podrán cambiarla en Brave. Si no la estableces, el usuario podrá desactivar la opción para guardar contraseñas.";
PasswordManagerPasskeysEnabled.pfm_title = "Habilitar el guardado de llaves de acceso en el administrador de contraseñas";
PasswordManagerPasskeysEnabled.pfm_description = "Esta política controla la capacidad del navegador de guardar llaves de acceso en el administrador de contraseñas integrado. No limita el acceso ni modifica el contenido de las llaves de acceso guardadas en el administrador de contraseñas. Si la política PasswordManagerEnabled se inhabilita, se inhabilitará el guardado en el administrador de contraseñas integrado en general, lo que incluye las llaves de acceso y las contraseñas, por lo que esta política no se aplicará.\n\nSi habilitas la política o no la estableces, los usuarios podrán guardar llaves de acceso en el administrador de contraseñas integrado si acceden a Brave.\n\nSi inhabilitas la política, los usuarios no podrán guardar llaves de acceso en el administrador de contraseñas integrado, pero seguirán funcionando las que se hayan guardado antes.";
PasswordProtectionChangePasswordURL.pfm_title = "Configura la URL de cambio de contraseña.";
PasswordProtectionChangePasswordURL.pfm_description = "Si estableces la política, se configurará la URL para que los usuarios cambien su contraseña cuando vean una advertencia en el navegador. El servicio de protección de contraseñas enviará a los usuarios a la URL (solo protocolos HTTP y HTTPS) que designes a través de esta política. Para que Brave capture correctamente el hash con sal de la nueva contraseña en esta página de cambio de contraseña, asegúrate de que la página cumpla con estos lineamientos (https://www.chromium.org/developers/design-documents/create-amazing-password-forms).\n\nSi desactivas la política o no la estableces, el servicio enviará a los usuarios a https://myaccount.google.com para que cambien su contraseña.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
PasswordProtectionLoginURLs.pfm_title = "Configura la lista de las URLs de acceso empresariales donde el servicio de protección de contraseñas debe capturar los hash con sal de las contraseñas.";
PasswordProtectionLoginURLs.pfm_description = "Si estableces la política, se especificará la lista de URLs de acceso empresarial (solo protocolos HTTP y HTTPS). El servicio de protección de contraseñas capturará los hash con sal de las contraseñas de estas URLs y los usará para detectar las contraseñas reutilizadas. Para que Brave capture correctamente los hash con sal de las contraseñas, asegúrate de que tus páginas de acceso cumplan con los lineamientos (https://www.chromium.org/developers/design-documents/create-amazing-password-forms).\n\nSi desactivas este parámetro de configuración o no lo estableces, el servicio de protección de contraseñas solo capturará los hashes con sal de las contraseñas que se encuentren en https://accounts.google.com.\n\nEn Microsoft® Windows®, esta funcionalidad solo está disponible en instancias vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
PasswordProtectionWarningTrigger.pfm_title = "Activador de advertencia de la protección de la contraseña";
PasswordProtectionWarningTrigger.pfm_description = "0 - La advertencia de la protección de la contraseña está desactivada\n1 - La advertencia de la protección de la contraseña se activa cuando se vuelve a usar la contraseña\n2 - La advertencia de la protección de la contraseña se activa cuando se vuelve a usar la contraseña en una página de phishing\nSi estableces la política, podrás controlar cuándo se muestra la advertencia de protección de contraseñas. La protección de contraseñas alerta a los usuarios cuando reutilizan su contraseña protegida en sitios potencialmente sospechosos.\n\nUsa PasswordProtectionLoginURLs y PasswordProtectionChangePasswordURL para determinar las contraseñas que quieras proteger.\n\nSegún el comportamiento buscado, establece alguno de los siguientes valores para esta política.\n\n* PasswordProtectionWarningOff: no se mostrará ninguna advertencia de protección de contraseñas.\n\n* PasswordProtectionWarningOnPasswordReuse: se mostrará la advertencia de protección de contraseñas cuando el usuario reutilice su contraseña protegida en un sitio que no se encuentre en la lista de sitios permitidos.\n\n* PasswordProtectionWarningOnPhishingReuse: se mostrará la advertencia de protección de contraseñas cuando el usuario reutilice su contraseña protegida en un sitio de phishing.\n\nSi no estableces la política, el servicio de protección de contraseñas solo protegerá las contraseñas de Google, pero los usuarios podrán cambiar esta configuración.";
PasswordSharingEnabled.pfm_title = "Habilitar el uso compartido de credenciales de usuario con otros usuarios";
PasswordSharingEnabled.pfm_description = "Si habilitas la política, los usuarios podrán enviar sus contraseñas a miembros de la familia y recibir las de ellos (según el servicio familiar).\nSi habilitas la política o no la estableces, aparecerá un botón en el Administrador de contraseñas que permitirá enviar una contraseña.\nLas contraseñas recibidas se almacenan en la cuenta del usuario y están disponibles en el Administrador de contraseñas.\n\nSi inhabilitas la política, los usuarios no podrán enviar contraseñas desde el Administrador de contraseñas a otros usuarios ni recibir contraseñas de otros usuarios.\n\nLa función no está disponible si se desactiva la sincronización de Contraseñas (ya sea a través de la configuración del usuario o con la política SyncDisabled habilitada).\n\nLas cuentas administradas no son aptas para unirse a un grupo familiar ni crear uno, por lo que no pueden compartir contraseñas.";
PaymentMethodQueryEnabled.pfm_title = "Permite que los sitios web consulten las formas de pago disponibles.";
PaymentMethodQueryEnabled.pfm_description = "Te permite establecer si los sitios web están autorizados a verificar que el usuario tenga formas de pago guardadas.\n\nSi se establece esta política como inhabilitada, se informará a los sitios web que usan la API PaymentRequest.canMakePayment o PaymentRequest.hasEnrolledInstrument que no hay formas de pago disponibles.\n\nSi se habilita la configuración o no se establece, los sitios web estarán autorizados a verificar que el usuario tenga formas de pago guardadas.";
PdfAnnotationsEnabled.pfm_title = "Habilitar las anotaciones en archivos PDF";
PdfAnnotationsEnabled.pfm_description = "Controla si el lector de PDF de Brave puede agregar anotaciones en archivos PDF.\n\nSi no estableces esta política o la estableces como verdadera, el lector de PDF podrá agregar anotaciones en archivos PDF.\n\nSi la estableces como falsa, el lector de PDF no podrá agregar anotaciones en archivos PDF.";
PdfLocalFileAccessAllowedForDomains.pfm_title = "Permitir el acceso de archivo local a las URLs de file:// para estos sitios en el Lector de PDF";
PdfLocalFileAccessAllowedForDomains.pfm_description = "Si estableces esta política, los dominios que aparecen en la lista podrán acceder a las URLs de file:// en el Lector de PDF.\nSi agregas un dominio a la política, este podrá acceder a las URLs de file:// en el Lector de PDF.\nSi lo quitas de la política, no se permitirá que el dominio acceda a las URLs de file:// en el Lector de PDF.\nSi no estableces la política, ningún dominio podrá acceder a las URLs de file:// en el Lector de PDF.";
PdfUseSkiaRendererEnabled.pfm_title = "Usar el renderizador Skia para renderizar documentos PDF";
PdfUseSkiaRendererEnabled.pfm_description = "Controla si el lector de PDF de Brave usa el renderizador Skia.\n\nSi habilitas esta política, el lector de PDF utilizará el renderizador Skia.\n\nSi la inhabilitas, el lector de PDF usará el renderizador AGG actual.\n\nSi no estableces esta política, el navegador elegirá el renderizador de PDF.";
PolicyAtomicGroupsEnabled.pfm_title = "Habilita el concepto de grupos atómicos de políticas";
PolicyAtomicGroupsEnabled.pfm_description = "Si habilitas la política, se ignorarán las políticas procedentes de un grupo atómico que no comparten el origen con la prioridad más alta de ese grupo.\n\nSi la inhabilitas, no se ignorarán las políticas debido a su origen. Solo se ignorarán las políticas en caso de conflicto y si la política no tiene la prioridad más alta.\n\nSi se establece esta política desde un origen de nube, no podrá orientarse a un usuario específico.";
PolicyDictionaryMultipleSourceMergeList.pfm_title = "Permitir la combinación de políticas de diccionarios con diferentes fuentes";
PolicyDictionaryMultipleSourceMergeList.pfm_description = "ContentPackManualBehaviorURLs - Direcciones URL de excepción manual de usuario administrado\nDeviceLoginScreenPowerManagement - Administración de energía en la pantalla de acceso\nExtensionSettings - Configuración de la administración de extensiones\nKeyPermissions - Permisos de clave\nPowerManagementIdleSettings - Configuración de la administración de energía cuando el usuario está inactivo\nScreenBrightnessPercent - Porcentaje del brillo de pantalla\nScreenLockDelays - Demoras de bloqueo de pantalla\nSi estableces la política, se podrán combinar las políticas seleccionadas cuando provienen de diferentes fuentes, con los mismos alcances y niveles. Esta acción combina las claves de primer nivel del diccionario de cada fuente. Prevalecerá la clave que provenga de la fuente de mayor prioridad.\n\nUsa el carácter comodín \"*\" para permitir la combinación de todas las políticas del diccionario compatibles.\n\nSi la lista incluye una política y hay conflicto entre fuentes con las siguientes características:\n\n* Tienen los mismos alcances y niveles: se combinarán los valores en un nuevo diccionario de políticas.\n\n* Tienen diferentes alcances o niveles: se aplicará la política con la prioridad más alta.\n\nSi la lista no incluye una política y hay conflicto entre fuentes, alcances o niveles, se aplicará la política con la prioridad más alta.";
PolicyListMultipleSourceMergeList.pfm_title = "Permitir la combinación de políticas de listas con diferentes fuentes";
PolicyListMultipleSourceMergeList.pfm_description = "Si estableces la política, se podrán combinar las políticas seleccionadas cuando provienen de diferentes fuentes, con los mismos alcances y niveles.\n\nUsa el carácter comodín \"*\" para permitir la combinación de todas las políticas de la lista.\n\nSi la lista incluye una política y hay conflicto entre fuentes con las siguientes características:\n\n* Tienen los mismos alcances y niveles: se combinarán los valores en una nueva lista de políticas.\n\n* Tienen diferentes alcances o niveles: se aplicará la política con la prioridad más alta.\n\nSi la lista no incluye una política y hay conflicto entre fuentes, alcances o niveles, se aplicará la política con la prioridad más alta.";
PolicyRefreshRate.pfm_title = "Frecuencia de actualización de la política de usuario";
PolicyRefreshRate.pfm_description = "Si estableces la política, se especificará el período (expresado en milisegundos) durante el cual se consultará al servicio de administración del dispositivo para obtener la información de política del usuario. Los valores válidos son de 1,800,000 (30 minutos) a 86,400,000 (1 día). Los valores fuera de este rango se ajustarán conforme al límite correspondiente.\n\nSi no estableces la política, se utilizará el valor predeterminado de 3 horas.\n\nNota: Las notificaciones sobre políticas fuerzan una actualización cuando cambia la política, por lo que no es necesario actualizar de manera frecuente. Por lo tanto, si la plataforma admite estas notificaciones, la demora de la actualización será de 24 horas (se ignorarán los valores predeterminados y el de esta política).";
PopupsAllowedForUrls.pfm_title = "Permitir ventanas emergentes en estos sitios";
PopupsAllowedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que pueden abrir ventanas emergentes.\n\nSi no estableces la política, se aplicará DefaultPopupsSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
PopupsBlockedForUrls.pfm_title = "Bloquear ventanas emergentes en estos sitios";
PopupsBlockedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que no pueden abrir ventanas emergentes.\n\nSi no estableces la política, se aplicará DefaultPopupsSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
PreciseGeolocationAllowedForUrls.pfm_title = "Permitir la ubicación geográfica precisa en estos sitios";
PreciseGeolocationAllowedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen los sitios que pueden acceder a la ubicación geográfica de alta precisión del usuario sin tener que solicitar primero su permiso para hacerlo.\n\nSi no estableces la política, se aplicará DefaultGeolocationSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
PreferSlowCiphers.pfm_title = "Preferir los algoritmos de cifrado de encriptación específicos para TLS";
PreferSlowCiphers.pfm_description = "cnsa - Preferir los algoritmos de cifrado que satisfagan los requisitos de CNSA 1.0 y 2.0\ndefault - Usar el orden de cifrado predeterminado de Brave\nEsta política configura Brave para ordenar sus algoritmos de cifrado de encriptación preferidos en TLS 1.3 para reflejar una preferencia por los algoritmos que fueron aprobados por un régimen de cumplimiento específico.\n\nConfigurar esta política no garantiza que se negocien algoritmos específicos.\n\nGracias a esta política, los operadores de servidores que deseen admitir clientes con y sin requisitos de cumplimiento pueden diferenciarlos. Además, pueden usar solo ciertos algoritmos no predeterminados con mayor solidez criptográfica para aquellos clientes que se configuraron explícitamente para preferir los algoritmos más sólidos.\n\nSi estableces la política en \"cnsa\", se configurará Brave para que prefiera los algoritmos de cifrado necesarios para cumplir con las versiones 1.0 y 2.0 del Commercial National Security Algorithm Suite (CNSA 1.0 y 2.0).\n\nSi no estableces la política o la estableces como \"default\", se configurará Brave para que use sus algoritmos de encriptación predeterminados.\n\nNo es necesario establecer esta política para la seguridad. La criptografía predeterminada que usa Brave es lo suficientemente sólida como para resistir un ataque de fuerza bruta con toda la potencia del sol.\n\nSi estableces esta política, Brave será más lento cuando accedas a sitios web.\n\nEsta política solo afecta a TLS 1.3 y QUIC, y no a versiones anteriores de TLS.\n\nEsta política se puede establecer para la máquina y el usuario. Si se establece para el usuario, esta política solo afecta las solicitudes de red iniciadas por el perfil del usuario y es posible que no afecte las solicitudes de red que realiza Brave para llevar a cabo tareas en segundo plano en todo el navegador; esas tareas se controlan con el valor a nivel de la máquina. Si esta política se establece tanto a nivel de la máquina como del usuario, se aplica el valor a nivel de la máquina, a menos que la política CloudUserPolicyOverridesCloudMachinePolicy haya cambiado el orden de prioridad de la política.\n\nPara las versiones 155 y anteriores, esta política solo se aplica a nivel de la máquina.";
PreferSlowKexAlgorithms.pfm_title = "Preferir los algoritmos de intercambio de claves específicos para TLS";
PreferSlowKexAlgorithms.pfm_description = "cnsa2 - Preferir los métodos de intercambio de claves que satisfagan los requisitos de CNSA 2.0\ndefault - Usar los grupos compatibles predeterminados de Brave\nEsta política configura Brave para ordenar sus algoritmos de acuerdo de claves preferidos (grupos admitidos) en TLS 1.3 para reflejar una preferencia por los algoritmos que fueron aprobados por un régimen de cumplimiento específico.\n\nConfigurar esta política no garantiza que se negocien algoritmos específicos.\n\nGracias a esta política, los operadores de servidores que deseen admitir clientes con y sin requisitos de cumplimiento pueden diferenciarlos. Además, pueden usar solo ciertos algoritmos no predeterminados con mayor solidez criptográfica para aquellos clientes que se configuraron explícitamente para preferir los algoritmos más sólidos.\n\nSi estableces la política en \"cnsa2\", se configurará Brave para que prefiera los métodos de intercambio de claves necesarios para cumplir con el Commercial National Security Algorithm Suite 2.0 (CNSA 2.0).\n\nSi no estableces la política o la estableces como \"default\", se configurará Brave para que use sus métodos de intercambio de claves predeterminados.\n\nNo es necesario establecer esta política para la seguridad. La criptografía predeterminada que usa Brave es lo suficientemente sólida como para resistir un ataque de fuerza bruta con toda la potencia del sol.\n\nSi estableces esta política, Brave será más lento cuando accedas a sitios web.\n\nEsta política solo afecta a TLS 1.3 y QUIC, y no a versiones anteriores de TLS.\n\nEsta política se puede establecer para la máquina y el usuario. Si se establece para el usuario, esta política solo afecta las solicitudes de red iniciadas por el perfil del usuario y es posible que no afecte las solicitudes de red que realiza Brave para llevar a cabo tareas en segundo plano en todo el navegador; esas tareas se controlan con el valor a nivel de la máquina. Si esta política se establece tanto a nivel de la máquina como del usuario, se aplica el valor a nivel de la máquina, a menos que la política CloudUserPolicyOverridesCloudMachinePolicy haya cambiado el orden de prioridad de la política.\n\nPara las versiones 155 y anteriores, esta política solo se aplica a nivel de la máquina.";
PrefetchWithServiceWorkerEnabled.pfm_title = "Permitir la carga previa de SpeculationRules a URLs controladas por ServiceWorker";
PrefetchWithServiceWorkerEnabled.pfm_description = "La carga previa de SpeculationRules se puede emitir a las URLs que controla\nServiceWorker. Sin embargo, el código heredado no lo permitió y canceló las solicitudes de\ncarga previa. Esta política permite controlar el comportamiento.\n\nSi habilitas esta política o no la estableces, se permitirá la carga previa de SpeculationRules para las\nURLs controladas por ServiceWorker (si se habilita la marca de función de\nPrefetchServiceWorker). Este es el comportamiento predeterminado actual y está alineado con las\nespecificaciones.\n\nSi inhabilitas esta política, no se permitirá la carga previa de SpeculationRules para las\nURLs controladas por ServiceWorker. Este es el comportamiento heredado.\n\nEsta política es temporal y se quitará en el futuro.";
PrintHeaderFooter.pfm_title = "Imprimir encabezados y pies de página";
PrintHeaderFooter.pfm_description = "Si habilitas la política, se activarán los encabezados y pies de página en la vista previa de impresión. Si inhabilitas la política, se desactivarán en la vista previa de impresión.\n\nSi estableces la política, los usuarios no podrán cambiarla. Si no la estableces, los usuarios podrán elegir si se muestran los encabezados y pies de página.";
PrintPdfAsImageAvailability.pfm_title = "Imprimir PDF como imagen disponible";
PrintPdfAsImageAvailability.pfm_description = "Controla cómo Brave muestra la opción Imprimir como imagen en Microsoft® Windows® y macOS cuando se imprimen archivos PDF.\n\nAl imprimir archivos PDF en Microsoft® Windows® o macOS, a veces es necesario rasterizar los trabajos de impresión en imágenes para que determinadas impresoras logren el resultado buscado.\n\nSi habilitas esta política, Brave hará que la opción Imprimir como imagen esté disponible en el menú Vista previa de impresión cuando el usuario imprima un archivo PDF.\n\nSi no habilitas o no estableces la política, Brave hará que la opción Imprimir como imagen no esté disponible para los usuarios en el menú Vista previa de impresión y los archivos PDF se imprimirán del modo habitual, sin rasterizarse en imágenes antes de su envío a destino.";
PrintPdfAsImageDefault.pfm_title = "Imprimir PDF como imagen de forma predeterminada";
PrintPdfAsImageDefault.pfm_description = "Controla si Brave hace que la opción Imprimir como imagen esté definida de forma predeterminada al imprimir documentos PDF.\n\nSi habilitas esta política, Brave definirá la opción Imprimir como imagen de forma predeterminada en la vista previa de impresión al imprimir un PDF.\n\nSi la inhabilitas o no la estableces, la selección del usuario para la opción Imprimir como imagen no estará definida inicialmente en Brave.  Si la opción está disponible, el usuario podrá seleccionarla para cada trabajo de impresión de PDF individual.\n\nEn Microsoft® Windows® o macOS, esta política solo tiene efecto si también se habilita PrintPdfAsImageAvailability.";
PrintPreviewUseSystemDefaultPrinter.pfm_title = "Usar la impresora predeterminada del sistema como predeterminada";
PrintPreviewUseSystemDefaultPrinter.pfm_description = "Si habilitas la política, Brave utilizará la impresora por defecto del SO como el destino predeterminado para la vista previa de impresión.\n\nSi la inhabilitas o no la estableces, Brave utilizará la impresora que se usó por última vez como el destino predeterminado para la vista previa de impresión.";
PrintRasterizePdfDpi.pfm_title = "Valor de DPI en la rasterización de archivos PDF para la impresión";
PrintRasterizePdfDpi.pfm_description = "Controla la resolución de las imágenes de impresión cuando Brave imprime archivos PDF con rasterización.\n\nCuando el usuario imprime archivos PDF con la opción Imprimir como imagen, puede ser útil especificar una resolución de impresión diferente a la configuración de la impresora del dispositivo o el valor predeterminado para archivos PDF.  Una resolución alta aumentará enormemente el tiempo de procesamiento y de impresión, mientras que una resolución baja puede generar una baja calidad de imagen.\n\nEsta política permite especificar una resolución para usarla cuando se rasterizan archivos PDF para la impresión.\n\nSi la política se establece con el valor cero o no se establece, se usará la resolución predeterminada del sistema durante la rasterización de imágenes de páginas";
PrinterTypeDenyList.pfm_title = "Inhabilita los tipos de impresoras incluidos en la lista de rechazo";
PrinterTypeDenyList.pfm_description = "privet - Destinos de los protocolos basados en la no configuración (mDNS y DNS-SD) (Política obsoleta)\nextension - Destinos basados en extensiones\npdf - El destino de \"Guardar como PDF\" y el destino de \"Guardar en Google Drive\" en dispositivos Google Chrome OS\nlocal - Destinos de las impresoras locales\ncloud - Google Cloud Print (obsoleto)\nSi la lista de rechazo incluye un tipo de impresora, no se podrán visualizar estas impresoras ni obtener sus capacidades.\n\nSi se incluyen todos los tipos de impresora en la lista de rechazo, no se podrán realizar impresiones, dado que no habrá destinos disponibles para enviar un documento a imprimir.\n\nEn versiones anteriores a 102, si se incluye cloud en la lista de rechazo, el efecto es el mismo que si se establece la política CloudPrintSubmitEnabled como falsa. Para que se puedan visualizar los destinos de Google Cloud Print, debe establecerse como verdadera la política CloudPrintSubmitEnabled y no debe incluirse cloud en la lista de rechazo. A partir de la versión 102, no se admiten los destinos de Google Cloud Print y estos no aparecerán sin importar los valores indicados en la política.\n\nSi no se establece la política o se establece como una lista vacía, podrán visualizarse todos los tipos de impresora.\n\nLas impresoras de extensiones, también conocidas como destinos del proveedor de impresión, incluyen los destinos que pertenecen a las extensiones de Brave.\n\nLas impresoras locales, también conocidas como destinos nativos de impresión, incluyen los destinos disponibles en la máquina local y las impresoras de redes compartidas.";
PrintingAllowedBackgroundGraphicsModes.pfm_title = "Restringe el modo de impresión con gráficos de fondo";
PrintingAllowedBackgroundGraphicsModes.pfm_description = "any - Permitir la impresión con y sin gráficos de fondo\nenabled - Habilitar la impresión solo con los gráficos de fondo\ndisabled - Habilitar la impresión solo sin los gráficos de fondo\nRestringe el modo de impresión de los gráficos de fondo. Si no se configura la política, no se aplicará ninguna restricción.";
PrintingBackgroundGraphicsDefault.pfm_title = "Modo predeterminado de impresión de los gráficos de fondo";
PrintingBackgroundGraphicsDefault.pfm_description = "enabled - Habilitar el modo de impresión de los gráficos de fondo de forma predeterminada\ndisabled - Inhabilitar el modo de impresión de los gráficos de fondo de forma predeterminada\nAnula el modo predeterminado de impresión de los gráficos de fondo.";
PrintingEnabled.pfm_title = "Habilitar la impresión";
PrintingEnabled.pfm_description = "Si habilitas la política o no la estableces, los usuarios podrán realizar impresiones en Brave. Los usuarios no podrán cambiar esta configuración.\n\nSi inhabilitas la política, los usuarios no podrán realizar impresiones desde Brave. Se desactivará la opción de impresión en el menú de tres puntos, las extensiones y las aplicaciones de JavaScript.";
PrintingPaperSizeDefault.pfm_title = "Tamaño predeterminado de la página de impresión";
PrintingPaperSizeDefault.pfm_description = "Anula el tamaño predeterminado para la página de impresión.\n\nname debe contener uno de los formatos incluidos o \"personalizado\" si el tamaño del papel necesario no está en la lista. Si se proporciona un valor \"personalizado\", se debe especificar la propiedad custom_size. Describe el ancho y altura deseados en micrómetros. De lo contrario, no se debe especificar la propiedad custom_size. Se ignorará la política que infrinja estas reglas.\n\nSi el tamaño de la página no está disponible en la impresora que elija el usuario, se ignorará esta política.\nConsulta https://chromeenterprise.google/policies/?policy=PrintingPaperSizeDefault para obtener más información sobre el esquema y el formato.";
ProfilePickerOnStartupAvailability.pfm_title = "Disponibilidad del selector de perfiles en el inicio";
ProfilePickerOnStartupAvailability.pfm_description = "0 - Selector de perfiles disponible en el inicio\n1 - Selector de perfiles inhabilitado en el inicio\n2 - Selector de perfiles forzado en el inicio\nEspecifica si el selector de perfiles está habilitado, inhabilitado o forzado al iniciar el navegador.\n\nDe forma predeterminada, no se mostrará el selector de perfiles si se inicia el navegador en modo Incógnito o de invitado, se especifica un directorio de perfiles o URL por línea de comandos, se solicita de forma explícita que se abra una app, se inició el navegador mediante una notificación nativa, hay un solo perfil disponible o se establece la política ForceBrowserSignin como verdadera.\n\nSi habilitas (0) la política o no la estableces, se mostrará el selector de perfiles en el inicio de forma predeterminada, pero los usuarios podrán habilitarlo o inhabilitarlo.\n\nSi la inhabilitas (1), no se mostrará nunca el selector de perfiles, y los usuarios no podrán cambiar la configuración.\n\nSi la fuerzas (2), el usuario no podrá suprimir el selector de perfiles. Se mostrará el selector de perfiles incluso si hay solo un perfil disponible.";
ProfileReauthPrompt.pfm_title = "Solicitar a los usuarios que vuelvan a realizar la autenticación en el perfil";
ProfileReauthPrompt.pfm_description = "0 - No solicitar una nueva autenticación\n1 - Solicitar una nueva autenticación en una pestaña\nCuando estableces la política como DoNotPrompt o no la estableces, Brave no le solicita automáticamente al usuario que vuelva a realizar la autenticación en el navegador.\n\nCuando la estableces como PromptInTab, cuando vence la autenticación del usuario, se abre inmediatamente una pestaña nueva con la página de acceso de Google. Esto solo sucede si se usa Chrome Sync.";
ProfileSeparationDomainExceptionList.pfm_title = "Lista de entidades permitidas del dominio secundario de separación de perfiles de empresa";
ProfileSeparationDomainExceptionList.pfm_description = "Si no estableces esta política, no será necesario acceder a la cuenta para crear un nuevo perfil por separado.\n\nSi estableces esta política, no será necesario acceder a las cuentas de los dominios incluidos para crear un nuevo perfil por separado.\n\nEsta política se puede establecer como una cadena vacía, de modo que todos los accesos a la cuenta deban crear un nuevo perfil por separado.";
PromotionsEnabled.pfm_title = "Habilitar la presentación de contenido promocional";
PromotionsEnabled.pfm_description = "Si estableces la política como verdadera o no la estableces, Brave podrá mostrarles a los usuarios contenido promocional de productos.\n\nSi la estableces como falsa, Brave no podrá mostrar contenido promocional de productos.\n\nEl establecimiento de esta política permite controlar la presentación de contenido promocional, lo que incluye las páginas de bienvenida que ayudan a los usuarios a acceder a Brave, elegir Brave como navegador predeterminado o recibir información sobre funciones de productos.";
PromptForDownloadLocation.pfm_title = "Preguntar ubicación antes de descargar";
PromptForDownloadLocation.pfm_description = "Si habilitas la política, se les preguntará a los usuarios dónde guardar los archivos antes de descargarlos. Si la inhabilitas, las descargas se iniciarán inmediatamente; no se les preguntará a los usuarios dónde guardar los archivos.\n\nSi no estableces la política, los usuarios podrán cambiar esta configuración.";
PromptOnMultipleMatchingCertificates.pfm_title = "Notificar cuando coinciden múltiples certificados";
PromptOnMultipleMatchingCertificates.pfm_description = "Esta política controla si se le solicita al usuario que seleccione un certificado de cliente cuando más de un certificado coincide con AutoSelectCertificateForUrls.\nSi habilitas esta política, se le solicitará al usuario que seleccione un certificado de cliente cada vez que la política de selección automática coincida con múltiples certificados.\nSi inhabilitas esta política o no la estableces, solo se le solicitará al usuario que haga una elección cuando ningún certificado coincida con la selección automática.";
ProxySettings.pfm_title = "Configuración de proxy";
ProxySettings.pfm_description = "Si estableces la política, se especificará la configuración de proxy para Chrome y las apps de ARC, por lo que se ignorarán todas las opciones relacionadas con el proxy que se especificaron en la línea de comandos.\n\nSi no la estableces, los usuarios podrán elegir su configuración de proxy.\n\nSi estableces la política ProxySettings, se aceptarán los siguientes campos:\n\n* ProxyMode, que te permite especificar el servidor proxy que usa Chrome y evitar que los usuarios cambien la configuración de proxy\n\n* ProxyPacUrl, una URL a un archivo .pac de proxy o una secuencia de comandos de PAC codificada como una URL de datos con el tipo de MIME application/x-ns-proxy-autoconfig\n\n* ProxyPacMandatory, que evita que la pila de red recurra a conexiones directas con una secuencia de comandos de PAC no válida o no disponible\n\n* ProxyServer, una URL del servidor proxy\n\n      * ProxyBypassList, una lista de hosts para los que se omitirá el proxy\n\nEl campo ProxyServerMode está obsoleto y se recomienda usar el campo ProxyMode. Para ProxyMode, si eliges uno de estos valores:\n\n* direct: no se usará nunca un proxy y se ignorará el resto de los campos.\n\n* system: se usará el proxy del sistema y se ignorará el resto de los campos.\n\n* auto_detect: se ignorará el resto de los campos.\n\n* fixed_servers: se usarán los campos ProxyServer y ProxyBypassList.\n\n* pac_script: se usarán los campos ProxyPacUrl, ProxyPacMandatory y ProxyBypassList.\n\nNota: Para obtener más ejemplos detallados, visita The Chromium Projects ( https://www.chromium.org/developers/design-documents/network-settings/#command-line-options-for-proxy-settings ).\nConsulta https://chromeenterprise.google/policies/?policy=ProxySettings para obtener más información sobre el esquema y el formato.";
PsstEnabled.pfm_title = "Enable Privacy Settings Tuning Tool";
PsstEnabled.pfm_description = "Enable Privacy Settings Tuning Tool in Brave.\n\nPrivacy Settings Tuning Tool is a feature that allows Brave to automatically suggest (and adjust) site-specific privacy settings.";
QRCodeGeneratorEnabled.pfm_title = "Habilitar Generador de códigos QR";
QRCodeGeneratorEnabled.pfm_description = "Esta política habilita la función Generador de códigos QR en Brave.\n\nSi habilitas esta política o no la configuras, se habilitará la función Generador de códigos QR.\n\nSi inhabilitas esta política, se inhabilitará la función Generador de códigos QR.";
QuicAllowed.pfm_title = "Permitir el protocolo QUIC";
QuicAllowed.pfm_description = "Si habilitas la política o no la estableces, se permitirá el uso del protocolo QUIC en Brave.\n\nSi la inhabilitas, no se permitirá el uso de este protocolo.";
RegisteredProtocolHandlers.pfm_title = "Registrar controladores de protocolo";
RegisteredProtocolHandlers.pfm_description = "Si estableces la política (solo como recomendada), podrás registrar una lista de controladores de protocolo, que se combinarán con los que registre el usuario; así, ambos conjuntos de controladores estarán en uso. Asigna a la propiedad \"protocolo\" el esquema (p. ej. mailto) y a la propiedad \"URL\" el patrón de URL de la aplicación que controla el esquema especificado en el campo \"protocolo\". El patrón puede incluir el marcador de posición \"%s\", que se reemplazará por la URL controlada.\n\nLos usuarios no podrán quitar un controlador de protocolo que haya registrado la política. Sin embargo, al instalar un nuevo controlador predeterminado, los usuarios podrán cambiar los controladores de protocolo que haya instalado la política.\nConsulta https://chromeenterprise.google/policies/?policy=RegisteredProtocolHandlers para obtener más información sobre el esquema y el formato.";
RelaunchFastIfOutdated.pfm_title = "Período (días)";
RelaunchFastIfOutdated.pfm_description = "Especifica la antigüedad mínima de lanzamiento a partir de la cual las notificaciones de relanzamiento son más agresivas. La antigüedad se calcula a partir del momento en que se entregó la versión que se está ejecutando para los clientes.\n\nSi se necesita reiniciar el navegador o el dispositivo para finalizar una actualización pendiente, y la versión actual está desactualizada por más de la cantidad de días especificada en esta configuración, la política RelaunchNotificationPeriod se anulará y se establecerá en 2 horas. Si la política RelaunchNotification se establece como 1 (\"Obligatorio\"), los usuarios deberán volver a iniciar sesión o reiniciar el dispositivo al final del período.\n\nSi no se establece o si no se puede determinar la antigüedad de lanzamiento, se usará la política RelaunchNotificationPeriod para todas las actualizaciones.";
RelaunchNotification.pfm_title = "Notificar a un usuario que se recomienda o es obligatorio reiniciar el navegador o el dispositivo";
RelaunchNotification.pfm_description = "1 - Mostrar un mensaje recurrente al usuario para indicarle que se recomienda llevar a cabo el reinicio\n2 - Mostrar un mensaje recurrente al usuario para indicarle que se debe realizar un reinicio\nNotifica a los usuarios que se deben reiniciar Brave o Google Chrome OS para que se aplique una actualización pendiente.\n\nLa configuración de esta política habilita las notificaciones para informar al usuario que se debe realizar o es recomendable un reinicio del navegador o el dispositivo. Si no se establece, Brave le indica al usuario que se necesita un reinicio a través de cambios sutiles en el menú, mientras que Google Chrome OS indica eso a través de una notificación en la bandeja del sistema. Si se establece como recomendada, se mostrará una advertencia recurrente al usuario que indicará que se recomienda realizar un reinicio. Esta advertencia se puede descartar para posponer el reinicio. Si se establece como obligatoria, se mostrará una advertencia recurrente al usuario que indicará que se realizará automáticamente un reinicio del navegador una vez que finalice el período de notificación. El tiempo predeterminado es de siete días para Brave y cuatro para Google Chrome OS, y se puede ajustar a través de la configuración de la política RelaunchNotificationPeriod.\n\nLa sesión del usuario se restablecerá después del reinicio.";
RelaunchNotificationPeriod.pfm_title = "Período (milisegundos)";
RelaunchNotificationPeriod.pfm_description = "Te permite establecer el período, en milisegundos, en el que se notifica a los usuarios que deben reiniciar Brave o un dispositivo Google Chrome OS para aplicar una actualización pendiente.\n\nEn este período, se le informará reiteradamente al usuario acerca de la necesidad de la actualización. En dispositivos Google Chrome OS, se muestra una notificación de reinicio en la bandeja del sistema, en conformidad con la política RelaunchHeadsUpPeriod. En navegadores Brave, el menú de la app indica que se debe reiniciar después de transcurrido un tercio del período de la notificación. Esta notificación cambia de color tras dos tercios del período de la notificación y una vez más cuando finaliza este período. Las notificaciones adicionales que habilita la política RelaunchNotification siguen el mismo patrón.\n\nSi no se establece, se utilizará el período predeterminado de 604800000 milisegundos (una semana).";
RelaunchWindow.pfm_title = "Lapso para el reinicio";
RelaunchWindow.pfm_description = "Especifica un lapso fijado para la finalización del período de la notificación de reinicio.\n\nSe notifica a los usuarios que se debe reiniciar el navegador o el dispositivo conforme a la configuración de las políticas RelaunchNotification y RelaunchNotificationPeriod. Los navegadores y dispositivos se reinician de manera forzosa al finalizar el período de la notificación cuando se establece la política RelaunchNotification como obligatoria. La política RelaunchWindow puede utilizarse para posponer la finalización del período de la notificación de modo que coincida con un lapso determinado.\n\nSi no estableces esta política, el lapso fijado de forma predeterminada para Google Chrome OS es entre 2 a.m. y 4 a.m. El lapso fijado de forma predeterminada para Brave es todo el día (es decir, no se pospone nunca el período de la notificación).\n\nNota: Aunque la política acepte varios elementos en entries, ignorará todos menos el primero.\nAdvertencia: Si estableces esta política, es posible que se retrase la aplicación de las actualizaciones de software.\nConsulta https://chromeenterprise.google/policies/?policy=RelaunchWindow para obtener más información sobre el esquema y el formato.";
RemoteAccessHostAllowClientPairing.pfm_title = "Habilitar o inhabilitar la autenticación sin PIN para hosts de acceso remoto";
RemoteAccessHostAllowClientPairing.pfm_description = "Si habilitas la política o no la estableces, los usuarios podrán vincular los clientes y los hosts en el momento de la conexión, lo que elimina la necesidad de ingresar siempre un PIN.\n\nSi la inhabilitas, esta acción hará que la función no esté disponible.";
RemoteAccessHostAllowFileTransfer.pfm_title = "Permite que los usuarios con acceso remoto transfieran archivos hacia y desde el host";
RemoteAccessHostAllowFileTransfer.pfm_description = "Si habilitas la política o no la estableces, los usuarios conectados con un host de acceso remoto podrán transferir archivos entre el cliente y el host. Esta acción no se aplicará a las conexiones de asistencia remota, las cuales no admiten la transferencia de archivos.\n\nSi inhabilitas la política, no se podrá transferir archivos.";
RemoteAccessHostAllowPinAuthentication.pfm_title = "Permitir métodos de autenticación con PIN y con vinculación para hosts de acceso remoto";
RemoteAccessHostAllowPinAuthentication.pfm_description = "Si habilitas la política, el host de acceso remoto podrá usar las autenticaciones con PIN y con vinculación cuando acepte conexiones de clientes.\n\nSi inhabilitas la política, no se permitirán las autenticaciones con PIN ni con vinculación.\n\nSi no la estableces, el host decidirá si se pueden usar autenticaciones con PIN o con vinculación.\n\nNota: Si el parámetro de configuración no genera métodos de autenticación mutuamente admitidos por el host y el cliente, se rechazará la conexión.";
RemoteAccessHostAllowRelayedConnection.pfm_title = "Habilitar el uso de servidores de retransmisión por parte del host de acceso remoto";
RemoteAccessHostAllowRelayedConnection.pfm_description = "Si habilitas la política RemoteAccessHostFirewallTraversal y habilitas la política RemoteAccessHostAllowRelayedConnection o no la estableces, los clientes remotos podrán usar servidores de retransmisión para conectarse con este equipo cuando no haya conexiones directas disponibles, por ejemplo, debido a la presencia de firewalls.\n\nSi inhabilitas la política, no se desactivará el acceso remoto, pero solo se permitirán conexiones de la misma red (no se permitirán retransmisiones ni técnicas NAT traversal).";
RemoteAccessHostAllowRemoteAccessConnections.pfm_title = "Permite las conexiones de acceso remoto a esta máquina";
RemoteAccessHostAllowRemoteAccessConnections.pfm_description = "Si inhabilitas esta política, no podrá iniciarse el servicio de host de acceso remoto ni configurarse para aceptar conexiones entrantes.  Esta política no afecta los diferentes escenarios de asistencia remota.\n\nTampoco tiene efecto si la habilitas, la dejas vacía o no la estableces.";
RemoteAccessHostAllowRemoteSupportConnections.pfm_title = "Permitir las conexiones de asistencia remota a esta máquina";
RemoteAccessHostAllowRemoteSupportConnections.pfm_description = "Si se inhabilita esta política, el host de asistencia remota no podrá iniciarse ni configurarse para aceptar las conexiones entrantes.\n\nEsta política no afecta a los casos de acceso remoto.\n\nTampoco impide que los administradores de empresas se conecten a dispositivos Google Chrome OS administrados.\n\nPor último, no tiene efecto si la habilitas, la dejas vacía o no la configuras.";
RemoteAccessHostAllowUrlForwarding.pfm_title = "Permitir que los usuarios con acceso remoto abran las URLs del host en el navegador de su cliente local";
RemoteAccessHostAllowUrlForwarding.pfm_description = "Si habilitas la política o no la estableces, es posible que los usuarios conectados a un host de acceso remoto puedan abrir las URLs del host en su navegador de cliente local.\n\nSi inhabilitas la política, el host de acceso remoto no podrá enviar URLs al cliente.\n\nEste parámetro de configuración no se aplica a las conexiones de asistencia remota, ya que la función no es compatible con ese modo de conexión.\n\nNota: Esta función aún no está disponible de forma general, por lo que habilitarla no significa que la función estará visible en la IU del cliente.";
RemoteAccessHostClientDomainList.pfm_title = "Configurar los nombres de dominio obligatorios para clientes de acceso remoto";
RemoteAccessHostClientDomainList.pfm_description = "Si estableces la política, se especificarán los nombres de dominio del cliente que se imponen en los clientes de acceso remoto. Los usuarios no podrán cambiar estos nombres. Solo los clientes de uno de los dominios especificados podrán conectarse al host.\n\nSi estableces la política como una lista vacía o no la estableces, se aplicará la política predeterminada para el tipo de conexión. Para la asistencia remota, esta política permite que los clientes de cualquier dominio se conecten al host. Solo el propietario del host puede conectarse para acceder de forma remota en cualquier momento.\n\nConsulta también RemoteAccessHostDomainList.\n\nNota: Esta configuración anulará RemoteAccessHostClientDomain, si se aplica.";
RemoteAccessHostClipboardSizeBytes.pfm_title = "El tamaño máximo (en bytes) que puede transferirse entre el cliente y el host a través de la sincronización del portapapeles";
RemoteAccessHostClipboardSizeBytes.pfm_description = "Si estableces esta política, se truncarán los datos del portapapeles enviados al host y recibidos de este en función del límite que establezcas en esta política.\n\nSi estableces un valor de 0, se inhabilitará la sincronización del portapapeles.\n\nEsta política afecta tanto el acceso como la asistencia remotos.\n\nSi no la estableces, esta política no tendrá efecto.\n\nSi estableces la política en un valor que está fuera del rango establecido, es posible que el host no se inicie.\n\nTen en cuenta que el límite superior real del tamaño del portapapeles se basa en el tamaño máximo del mensaje del canal de datos WebRTC, y esta política no lo controla.";
RemoteAccessHostDomainList.pfm_title = "Configurar los nombres de dominio obligatorios para hosts de acceso remoto";
RemoteAccessHostDomainList.pfm_description = "Si estableces la política, se especificarán los nombres de dominio del host que se imponen en los hosts de acceso remoto. Los usuarios no podrán cambiar estos nombres. Los hosts solo podrán compartirse mediante cuentas registradas en uno de los nombres de dominio especificados.\n\nSi estableces la política como una lista vacía o no la estableces, los hosts podrán compartirse a través de cualquier cuenta.\n\nConsulta también RemoteAccessHostClientDomainList.\n\nNota: Esta configuración anulará RemoteAccessHostDomain, si se aplica.";
RemoteAccessHostFirewallTraversal.pfm_title = "Habilitar el cruce seguro de firewall desde hosts de acceso remoto";
RemoteAccessHostFirewallTraversal.pfm_description = "Si habilitas la política o no la estableces, se permitirá el uso de servidores STUN, lo que posibilitará que los clientes remotos descubran este equipo y se conecten con él aunque haya un firewall.\n\nSi no habilitas esta política y el firewall filtra las conexiones UDP en establecimiento, solo los clientes con equipos en la red local podrán conectarse con este equipo.";
RemoteAccessHostMatchUsername.pfm_title = "Solicitar que el nombre del usuario local y el propietario del host de acceso remoto coincidan";
RemoteAccessHostMatchUsername.pfm_description = "Si habilitas la política, el host de acceso remoto comparará el nombre del usuario local con el que está asociado el host y el nombre de la Cuenta de Google registrado como el propietario del host (\"juanperez\" si el host le pertenece a \"juanperez@ejemplo.com\"). No se iniciará el host si el nombre del propietario del host es diferente del nombre del usuario local con el que está asociado el host. Para asociar de forma forzosa la Cuenta de Google del propietario con un dominio específico, utiliza la política con RemoteAccessHostDomain.\n\nSi inhabilitas la política o no la estableces, el host de acceso remoto podrá asociarse a cualquier usuario local.";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_title = "Duración máxima de la sesión que se permite para las conexiones de acceso remoto";
RemoteAccessHostMaximumSessionDurationMinutes.pfm_description = "Si estableces esta política, las conexiones de acceso remoto se desconectarán de forma automática después de que transcurra el tiempo (en minutos) definido en la política. Esta acción no impide que el cliente se reconecte después de que se alcance la duración máxima de la sesión. Si estableces la política en un valor que está fuera del rango establecido, es posible que el host no se inicie. Esta política no influye en los diferentes escenarios de asistencia remota.\n\nSi no la estableces, esta política no tendrá efecto. En este caso, las conexiones de acceso remoto no tendrán duración máxima en esta máquina.";
RemoteAccessHostRequireCurtain.pfm_title = "Habilitar modo de cortina en hosts de acceso remoto";
RemoteAccessHostRequireCurtain.pfm_description = "Si habilitas la política, se desactivarán los dispositivos de entrada y salida físicas de los hosts de acceso remoto durante una conexión remota.\n\nSi la inhabilitas o no la estableces, los usuarios locales y remotos interactuarán con el host cuando este se encuentre en modo compartido.";
RemoteAccessHostUdpPortRange.pfm_title = "Restringir el intervalo de puertos UDP que utiliza el host de acceso remoto";
RemoteAccessHostUdpPortRange.pfm_description = "Si estableces la política, se restringirá el intervalo de puertos UDP que utiliza el host de acceso remoto en esta computadora.\n\nSi no la estableces o estableces una string vacía, el host de acceso remoto podrá usar cualquier puerto disponible.\n\nNota: Si inhabilitas RemoteAccessHostFirewallTraversal, el host de acceso remoto utilizará los puertos UDP en el rango 12400-12409.";
RemoteDebuggingAllowed.pfm_title = "Permitir la depuración remota";
RemoteDebuggingAllowed.pfm_description = "Determina si los usuarios pueden usar la depuración remota.\n\nSi habilitas esta política o no la estableces, los usuarios podrán usar la depuración remota. Para hacerlo, deberán especificar los interruptores --remote-debugging-port y --remote-debugging-pipe de la línea de comandos en plataformas de escritorio, o bien habilitar el parámetro de configuración del sistema de depuración por USB en Android.\n\nSi la inhabilitas, los usuarios no podrán usar la depuración remota.";
RequireOnlineRevocationChecksForLocalAnchors.pfm_title = "Exigir verificaciones de OCSP/CRL en línea para las anclas de confianza locales";
RequireOnlineRevocationChecksForLocalAnchors.pfm_description = "Si estableces la política como verdadera, Brave siempre comprobará la revocación de los certificados del servidor validados correctamente y firmados por certificados de CA instalados de manera local. Si Brave no puede obtener información del estado de revocación, Brave considerará estos certificados como revocados (rechazados).\n\nSi estableces la política como falsa o no la estableces, Brave utilizará la configuración para comprobar la actual revocación en línea.\n\nEn macOS, esta política no tendrá efecto si la política ChromeRootStoreEnabled se estableció como falsa.";
RestoreOnStartup.pfm_title = "Acción al iniciar";
RestoreOnStartup.pfm_description = "5 - Abrir la página Nueva pestaña\n1 - Restaurar la última sesión\n4 - Abrir una lista de direcciones URL\n6 - Abrir una lista de URLs y restablecer la última sesión\nSi estableces la política, podrás especificar el comportamiento del sistema al iniciar el navegador. Si desactivas esta configuración, equivale a no establecerla, dado que debe especificarse el comportamiento de Brave al iniciarse.\n\nSi estableces esta política, los usuarios no podrán cambiarla en Brave. Si no la estableces, los usuarios podrán cambiarla.\n\nSi estableces esta política como RestoreOnStartupIsLastSession o RestoreOnStartupIsLastSessionAndURLs, se desactivarán algunos parámetros de configuración asociados a las sesiones o que realizan acciones al salir del navegador, como borrar cookies específicas de la sesión o los datos de navegación al salir del navegador.\n\nSi estableces esta política como RestoreOnStartupIsLastSessionAndURLs, el navegador restablecerá la sesión anterior y abrirá una ventana independiente para mostrar URLs que se establecen desde RestoreOnStartupURLs. Ten en cuenta que los usuarios pueden escoger dejar las URLs abiertas, y estas se restablecerán en la próxima sesión.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
RestoreOnStartupURLs.pfm_title = "Direcciones URL que se abrirán al iniciar.";
RestoreOnStartupURLs.pfm_description = "Si estableces RestoreOnStartup como RestoreOnStartupIsURLs, configurar RestoreOnStartupURLs con una lista de URLs determinará qué URLs se abrirán.\n\nSi no la estableces, se abrirá la página Nueva pestaña al iniciar el navegador.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_title = "Restringir la API de Background Fetch cuando se llama desde un service worker";
RestrictBackgroundFetchFromServiceWorkerEnabled.pfm_description = "Esta política controla si se restringen las solicitudes de Background Fetch de los service workers. Si se ve afectada una función que descarga archivos en segundo plano, esta política puede ser pertinente.\n\nSi habilitas esta política o no la estableces, la restricción estará activa y es posible que se bloqueen las solicitudes de Background Fetch de los contextos de service worker.\n\nSi inhabilitas esta política, se omitirá la restricción y se permitirá que todos los service workers realicen solicitudes de Background Fetch.\n\nEsta política empresarial es temporal y se quitará después de la versión M152.";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_title = "Restringir las Cuentas de Google aptas para guardar archivos PDF en Google Drive desde el lector de PDF de Brave";
RestrictPdfSaveToGoogleDriveAccountsToPattern.pfm_description = "Contiene una expresión regular para determinar las cuentas de Google aptas para guardar archivos PDF en Google Drive desde el lector de PDF de Brave.\n\nSe muestra un error si un usuario intenta subir un archivo PDF a Google Drive con una cuenta que no coincide con este patrón.\n\nSi no estableces esta política o la dejas en blanco, el usuario podrá usar cualquier Cuenta de Google para guardar archivos PDF en Google Drive.";
RestrictSigninToPattern.pfm_title = "Determinar qué Cuentas de Google se pueden establecer como las principales del navegador en Brave";
RestrictSigninToPattern.pfm_description = "Contiene una expresión regular que se usa para determinar qué Cuentas de Google se pueden establecer como las principales del navegador en Brave (es decir, la cuenta que se elige en el proceso de aceptación de la sincronización).\n\nSi un usuario intenta establecer una cuenta principal en el navegador con un nombre de usuario que no coincida con este patrón, se mostrará un error.\n\nSi no se establece esta política o se deja en blanco, el usuario podrá establecer cualquier Cuenta de Google como la principal del navegador en Brave.";
RestrictYouTubeCookiesDeletion.pfm_title = "Restringir la eliminación de cookies de YouTube";
RestrictYouTubeCookiesDeletion.pfm_description = "Impide la eliminación manual de las cookies de YouTube.\n\nEsta política tiene como objetivo impedir que los usuarios accedan a YouTube sin autorización después de borrar manualmente sus cookies de YouTube desde la página de configuración del sitio.\n\nSi habilitas la política, se evitará que se borren manualmente las cookies de YouTube.\n\nSi inhabilitas la política o no estableces un valor, las cookies de YouTube se podrán borrar normalmente.\n\nNota: Esta política solo impide la eliminación manual desde la IU de configuración del sitio. No impide la eliminación automática por parte de las políticas ClearBrowsingDataOnExitList o BrowsingDataLifetime. Además, si habilitas la política AllowDeletingBrowserHistory, los usuarios podrán borrar todas sus cookies a través del diálogo Borrar datos de navegación.";
SSLErrorOverrideAllowed.pfm_title = "Permitir continuar desde la página de advertencia de SSL";
SSLErrorOverrideAllowed.pfm_description = "Si habilitas la política o no la estableces, los usuarios podrán hacer clic para omitir las páginas de advertencia que se muestran en Brave cuando navegan a sitios que tienen errores de SSL.\n\nSi inhabilitas la política, los usuarios no podrán hacer clic para omitir las páginas de advertencia.";
SSLErrorOverrideAllowedForOrigins.pfm_title = "Permite continuar desde la página de advertencia de SSL en orígenes específicos";
SSLErrorOverrideAllowedForOrigins.pfm_description = "Si inhabilitas SSLErrorOverrideAllowed, esta política te permite especificar una lista de patrones de origen que indiquen los sitios donde los usuarios pueden hacer clic para omitir las páginas de advertencia que muestra Brave cuando navegan a sitios que tienen errores de SSL. Los usuarios no podrán hacer clic para omitir páginas de advertencia de SSL en orígenes que no se encuentren en esta lista.\n\nSi se habilita SSLErrorOverrideAllowed o no se establece, esta política no tiene efecto.\n\nSi no estableces la política, se aplicará SSLErrorOverrideAllowed para todos los sitios.\n\nPara obtener información detallada sobre los patrones de entrada válidos, consulta https://chromeenterprise.google/policies/url-patterns/. * no es un valor aceptado para esta política. Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.";
SafeBrowsingAllowlistDomains.pfm_title = "Configura la lista de dominios donde la Navegación segura no activa advertencias.";
SafeBrowsingAllowlistDomains.pfm_description = "Si habilitas la política, la Navegación segura confiará en los dominios que designes. No comprobará si incluyen recursos peligrosos, como software malicioso, no deseado o de phishing. El servicio de protección de descargas de la Navegación segura no comprobará las descargas alojadas en estos dominios. Su servicio de protección de contraseñas no comprobará que no se reutilicen contraseñas.\n\nSi no estableces la política, se aplicará la protección predeterminada de la Navegación segura en todos los recursos.\n\nEsta política no admite expresiones regulares. Sin embargo, los subdominios de un dominio determinado se incluyen en la lista de entidades permitidas. Los nombres de dominio completamente calificados (FQDN) no son obligatorios.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.";
SafeBrowsingDeepScanningEnabled.pfm_title = "Permitir los análisis detallados de descargas para los usuarios que habilitaron la Navegación segura";
SafeBrowsingDeepScanningEnabled.pfm_description = "Si habilitas esta política o no la estableces, Brave podrá enviar a Google descargas sospechosas de los usuarios que habilitaron la Navegación segura para analizarlas en busca de software malicioso o solicitarles a los usuarios que proporcionen una contraseña para los archivos encriptados.\nSi la inhabilitas, no se realizará el análisis.\nEsta política no afecta el análisis de contenido de descargas configurado por Chrome Enterprise Connectors.";
SafeBrowsingProtectionLevel.pfm_title = "Nivel de protección de la Navegación segura";
SafeBrowsingProtectionLevel.pfm_description = "0 - La Navegación segura nunca está activa.\n1 - Se activó la Navegación segura en el modo estándar.\n2 - Se activó la Navegación segura en el modo mejorado. Este modo es más seguro, pero requiere que compartas con Google más datos sobre la navegación.\nTe permite controlar si se habilita o no la función de Navegación segura de Brave y el modo en el que opera.\n\nSi se establece esta política como \"NoProtection\" (valor 0), no se activará nunca la Navegación segura.\n\nSi se establece como \"StandardProtection\" (valor 1, el cual es el predeterminado), la Navegación segura estará siempre activa en el modo estándar.\n\nSi se establece como \"EnhancedProtection\" (valor 2), la Navegación segura estará siempre activa en el modo mejorado, el cual es más seguro, pero requiere que compartas con Google más datos sobre la navegación.\n\nSi la estableces como obligatoria, los usuarios no podrán cambiar ni anular la configuración de la Navegación segura en Brave.\n\nSi no se establece, la Navegación segura operará en el modo de protección estándar, pero los usuarios podrán cambiar esta configuración.\n\nPara obtener más información sobre la Navegación segura, consulta https://support.google.com/chrome?p=safe_browsing_preferences.";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_title = "Permitir las verificaciones con proxy de la Navegación segura en tiempo real";
SafeBrowsingProxiedRealTimeChecksAllowed.pfm_description = "Esto controla si se permite que el modo de protección estándar de la Navegación segura\nenvíe hashes parciales de URLs a Google a través de un proxy con un Oblivious HTTP\npara determinar si la URL es segura.\n\nEl proxy permite que los navegadores suban hashes parciales de URLs a Google\nsin que estén vinculados a la dirección IP del usuario. La política también permite\nque los navegadores suban los hashes parciales de URLs con mayor frecuencia para\nmejorar la calidad de la protección de la Navegación segura.\n\nSe ignorará esta política si la Navegación segura está inhabilitada o se establece en el modo de protección\nmejorada.\n\nSi habilitas la política o no la estableces, se permitirán las\nbúsquedas con proxy de mayor protección.\n\nSi inhabilitas la política, no se permitirán las búsquedas\ncon proxy de mayor protección. Los hashes parciales de URLs se subirán a Google directamente con una frecuencia mucho\nmenor, lo que disminuirá la protección.";
SafeBrowsingSurveysEnabled.pfm_title = "Permitir encuestas de Navegación segura";
SafeBrowsingSurveysEnabled.pfm_description = "Si habilitas esta política o no la estableces, el usuario podría recibir encuestas relacionadas con la Navegación segura.\nSi la inhabilitas, el usuario no recibirá encuestas relacionadas con la Navegación segura.";
SafeSitesFilterBehavior.pfm_title = "Controlar el filtro de contenido para adultos de SafeSites.";
SafeSitesFilterBehavior.pfm_description = "0 - No aplicar filtros de contenido para adultos a los sitios\n1 - Aplicar filtros de contenido para adultos a los sitios\nSi estableces la política, esta controlará el filtro de URL de SafeSites, el cual utiliza la API de Google Safe Search para clasificar las URL como pornográficas o no.\n\nSegún el valor con el que establezcas la política, se obtendrán distintos comportamientos:\n\n* Si no aplicas filtros de contenido para adultos a los sitios (o no estableces ningún valor), no se filtrarán los sitios\n\n* Si aplicas filtros de contenido para adultos a los sitios, se filtrarán los sitios pornográficos\n\nLa política se aplica a la URL a la que navega el usuario y a los iframes. La política URLAllowlist tiene prioridad sobre esta política y se puede usar para anular los veredictos de la API de Google Safe Search.";
SameOriginTabCaptureAllowedByOrigins.pfm_title = "Permitir que estos orígenes capturen pestañas del mismo origen";
SameOriginTabCaptureAllowedByOrigins.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que pueden capturar pestañas con su mismo origen.\n\nSi no la estableces, los sitios no se considerarán para una anulación en este nivel de captura.\n\nTen en cuenta que se podrán capturar las Apps de Chrome en ventanas que tengan el mismo origen que este sitio.\n\nSi un sitio coincide con un patrón de URL de esta política, se considerarán las siguientes políticas: TabCaptureAllowedByOrigins, WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/.  Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.";
SandboxExternalProtocolBlocked.pfm_title = "Permitir que Chrome bloquee la navegación a protocolos externos dentro de iframes de la zona de pruebas";
SandboxExternalProtocolBlocked.pfm_description = "Chrome bloqueará la navegación a protocolos externos dentro del\niframe de la zona de pruebas. Consulta https://chromestatus.com/features/5680742077038592.\n\nSi estableces esta política como verdadera, Chrome bloqueará la navegación a esos protocolos.\n\nSi la estableces como falsa, Chrome no bloqueará la navegación a esos protocolos.\n\nEsta política se establece de forma predeterminada como verdadera: se habilita la función de seguridad.\n\nEs útil para los administradores que necesitan más tiempo para actualizar sus sitios web internos afectados por esta nueva restricción. Esta política empresarial es temporal; se planea quitarla después de la versión 117 de Brave.\n";
SavingBrowserHistoryDisabled.pfm_title = "Inhabilitar el almacenamiento del historial del navegador";
SavingBrowserHistoryDisabled.pfm_description = "Si habilitas la política, no se guardará el historial de navegación, estará desactivada la sincronización de pestañas, y los usuarios no podrán cambiar esta configuración.\n\nSi inhabilitas la política o no la estableces, se guardará el historial de navegación.";
ScreenCaptureAllowed.pfm_title = "Permite o rechaza la captura de pantalla";
ScreenCaptureAllowed.pfm_description = "Si se habilita o no se configura (predeterminado), una página web podrá utilizar\nlas API para compartir pantalla (p. ej., getDisplayMedia() o la API de la extensión Captura del escritorio)\npara solicitarle al usuario que seleccione una pestaña, una ventana o un escritorio para capturar.\n\nSi se inhabilita esta política, fallarán las llamadas a las API;\nsin embargo, no se considerará esta política (y un sitio podrá\nusar las API para compartir pantalla) si el sitio coincide con el patrón de origen en\ncualquiera de las siguientes políticas:\nScreenCaptureAllowedByOrigins,\nWindowCaptureAllowedByOrigins,\nTabCaptureAllowedByOrigins,\nSameOriginTabCaptureAllowedByOrigins.\n";
ScreenCaptureAllowedByOrigins.pfm_title = "Permitir que estos orígenes capturen pestañas, ventanas y escritorios";
ScreenCaptureAllowedByOrigins.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de las URL que pueden usar la captura de pestañas, ventanas y escritorios.\n\nSi no la estableces, los sitios no se considerarán para una anulación en este nivel de captura.\n\nNo se considerará esta política si un sitio coincide con un patrón de URL de cualquiera de las siguientes políticas: WindowCaptureAllowedByOrigins, TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nSi un sitio coincide con un patrón de URL de esta política, no se considerará la política ScreenCaptureAllowed.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/.  Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_title = "Permitir la captura de pantalla sin gestos previos del usuario";
ScreenCaptureWithoutGestureAllowedForOrigins.pfm_description = "Por motivos de seguridad, la\nAPI web de getDisplayMedia() requiere\nque se llame a un gesto previo del usuario (\"activación transitoria\") o fallará si esto no ocurre.\n\nCuando estableces esta política, los administradores pueden especificar los orígenes en los que se puede\nllamar a esta API sin un gesto previo del usuario.\n\nPara obtener información detallada sobre los patrones de URL válidos, consulta\nhttps://chromeenterprise.google/policies/url-patterns/. * no es\nun valor aceptado para esta política.\n\nSi estableces esta política, todos los orígenes requerirán un gesto previo del usuario para llamar\na esta API.";
ScrollToTextFragmentEnabled.pfm_title = "Habilitar el desplazamiento al texto especificado en fragmentos de URL";
ScrollToTextFragmentEnabled.pfm_description = "Esta función permite que los hipervínculos y la navegación de URL en la barra de direcciones se orienten a texto específico dentro de una página web, al que esta se desplazará una vez que se complete la carga de la página.\n\nSi habilitas o no configuras esta política, se habilitará el desplazamiento de la página web a fragmentos de texto específicos mediante la URL.\n\nSi la inhabilitas, se inhabilitará el desplazamiento de la página web a fragmentos de texto específicos mediante la URL.";
SearchContentSharingSettings.pfm_title = "Habilitar el uso compartido de contenido con las integraciones de Google AI Mode y Lens";
SearchContentSharingSettings.pfm_description = "0 - Permitir el uso compartido de contenido con las integraciones de Google AI Mode.\n1 - No permitir el uso compartido de contenido con las integraciones de Google AI Mode.\nEsta política controla cómo se comparte el contenido de páginas y archivos con Google AI Mode y Lens a través del panel lateral o las pestañas de Google Chrome.\n\nTen en cuenta que esta política no afecta a Google AI Mode en la Web. Solo controla cómo los usuarios pueden compartir información cuando usan Google Chrome.\n\n0 = los usuarios pueden compartir contenido de páginas o archivos con Google AI Mode.\n\n1 = los usuarios no pueden compartir contenido de páginas o archivos con Google AI Mode. Se inhabilitarán o se ocultarán los puntos de entrada para compartir contexto y el panel lateral.\n\nEsta política se ignorará cuando Google Search no sea el motor de búsqueda predeterminado de los usuarios, ya que la función estará inhabilitada.\n\nEsta política es independiente de la política AIModeSettings. La política AIModeSettings solo controla los puntos de entrada en el cuadro de búsqueda del cuadro multifunción o de la NTP, mientras que esta política controla cómo se comparte el contexto a través del panel lateral o las pestañas.\n\nEsta política tampoco controla la integración de Google Gemini, que la política GeminiSettings puede inhabilitar.\n\nSi no estableces esta política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
SearchSuggestEnabled.pfm_title = "Habilitar sugerencias de búsqueda";
SearchSuggestEnabled.pfm_description = "Si estableces la política como verdadera, se activarán las sugerencias de búsqueda en la barra de direcciones de Brave. Si la estableces como falsa, se desactivarán estas sugerencias de búsqueda.\n\nLas sugerencias basadas en los favoritos o el Historial no se ven afectadas por la política.\n\nSi estableces la política, los usuarios no podrán cambiarla. Si no la estableces, las sugerencias de búsqueda estarán activadas al principio, pero los usuarios podrán desactivarlas en cualquier momento.";
SecurityKeyPermitAttestation.pfm_title = "Las URL y los dominios permiten automáticamente la atestación directa de llaves de seguridad";
SecurityKeyPermitAttestation.pfm_description = "Si estableces la política, se especificarán los IDs de RP de WebAuthn para los cuales no se mostrarán mensajes cuando se solicite certificación de llaves de seguridad. Además, se enviará una señal a la llave de seguridad para indicar que se puede usar la certificación de empresa. Sin esto, se mostrará un mensaje a los usuarios que tengan Brave 65 y versiones posteriores cuando los sitios soliciten certificaciones de llaves de seguridad.";
SensorsAllowedForUrls.pfm_title = "Permite el acceso a los sensores en estos sitios";
SensorsAllowedForUrls.pfm_description = "Si estableces la política, podrás definir una lista de patrones de URL donde se especifiquen los sitios que pueden acceder a sensores, como los de movimiento o luz.\n\nSi no estableces la política, se aplicará DefaultSensorsSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nSi el mismo patrón de URL aparece en esta política y en la política SensorsBlockedForUrls, prevalecerá esta última y no se podrá acceder a los sensores de movimiento o luz.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
SensorsBlockedForUrls.pfm_title = "Bloquea el acceso a los sensores en estos sitios";
SensorsBlockedForUrls.pfm_description = "Si estableces la política, podrás definir una lista de patrones de URL donde se especifiquen los sitios que no pueden acceder a sensores, como los de movimiento o luz.\n\nSi no estableces la política, se aplicará DefaultSensorsSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nSi el mismo patrón de URL aparece en esta política y en la política SensorsAllowedForUrls, prevalecerá esta última y no se podrá acceder a los sensores de movimiento o luz.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*).";
SerialAllowAllPortsForUrls.pfm_title = "Otorgar permiso automáticamente a los sitios para conectarse a puertos en serie";
SerialAllowAllPortsForUrls.pfm_description = "Si estableces la política, podrás crear una lista de los sitios que reciben automáticamente permiso para acceder a todos los puertos en serie disponibles.\n\nLas URLs deben ser válidas; de lo contrario, se ignorará la política. Solo se considera el origen (esquema, host y puerto) de la URL.\n\nEn Google Chrome OS, esta política solo se aplica a los usuarios afiliados.\n\nEsta política anula las políticas DefaultSerialGuardSetting, SerialAskForUrls y SerialBlockedForUrls, y las preferencias del usuario.";
SerialAllowUsbDevicesForUrls.pfm_title = "Otorgar permiso automáticamente a los sitios para conectarse a dispositivos seriales USB";
SerialAllowUsbDevicesForUrls.pfm_description = "Si estableces la política, podrás crear una lista de los sitios que reciben automáticamente permiso para acceder a los dispositivos seriales USB cuyos ID del producto y del proveedor coinciden con los campos vendor_id y product_id. Si omites el campo product_id, los sitios determinados tendrán acceso a los dispositivos cuyo ID de proveedor coincida con el campo vendor_id y cualquier ID del producto.\n\nLas URLs deben ser válidas; de lo contrario, se ignorará la política. Solo se considera el origen (esquema, host y puerto) de la URL.\n\nEn ChromeOS, esta política solo se aplica a los usuarios afiliados.\n\nEsta política anula las políticas DefaultSerialGuardSetting, SerialAskForUrls y SerialBlockedForUrls, y las preferencias del usuario.\n\nEsta política solo afecta el acceso a dispositivos USB a través de la API de Web Serial. Para otorgar el acceso a dispositivos USB a través de la API de WebUSB, consulta la política WebUsbAllowDevicesForUrls.\nConsulta https://chromeenterprise.google/policies/?policy=SerialAllowUsbDevicesForUrls para obtener más información sobre el esquema y el formato.";
SerialAskForUrls.pfm_title = "Permite la API de Serial en estos sitios";
SerialAskForUrls.pfm_description = "Si estableces la política, podrás definir una lista de patrones de URL donde se especifiquen los sitios que pueden pedir permiso a los usuarios para acceder a un puerto en serie.\n\nSi no estableces la política, se aplicará DefaultSerialGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nEn el caso de patrones de URL que no coincidan con la política SerialBlockedForUrls (si hay alguna coincidencia), tendrá prioridad DefaultSerialGuardSetting (si se establece) o la configuración personal de los usuarios, en ese orden.\n\nSi los patrones de URL entran en conflicto con SerialBlockedForUrls, se ignorarán.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
SerialBlockedForUrls.pfm_title = "Bloquea la API de Serial en estos sitios";
SerialBlockedForUrls.pfm_description = "Si estableces la política, podrás definir una lista de patrones de URL donde se especifiquen los sitios que no pueden pedir permiso a los usuarios para acceder a un puerto en serie.\n\nSi no estableces la política, se aplicará DefaultSerialGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nEn el caso de patrones de URL que no coincidan con la política SerialAskForUrls (si hay alguna coincidencia), tendrá prioridad DefaultSerialGuardSetting (si se establece) o la configuración personal de los usuarios, en ese orden.\n\nSi los patrones de URL entran en conflicto con SerialAskForUrls, esta política tendrá prioridad.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
ServiceWorkerAutoPreloadEnabled.pfm_title = "Permitir que ServiceWorker envíe solicitudes de navegación sin esperar su inicio";
ServiceWorkerAutoPreloadEnabled.pfm_description = "https://github.com/WICG/service-worker-auto-preload\nLa función ServiceWorkerAutoPreload envía una solicitud de red para un recurso principal al mismo tiempo que inicia el proceso de inicio de ServiceWorker.\n\nSi habilitas la política o no la estableces,\nBrave habilitará ServiceWorkerAutoPreload. La solicitud de navegación se envía automáticamente cuando se inicia ServiceWorker en algunos casos, p. ej., cuando ServiceWorker no se está ejecutando.\n\nSi se inhabilita esta política, Brave no habilitará ServiceWorkerAutoPreload. La solicitud de navegación siempre se envía después de iniciar ServiceWorker.\n\nEsta política es una medida temporal para controlar la función y se quitará en la versión M154.";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_title = "Permitir que ServiceWorker controle los iframes de srcdoc";
ServiceWorkerToControlSrcdocIframeEnabled.pfm_description = "En https://github.com/w3c/ServiceWorker/issues/765, se solicita que el iframe srcdoc con\nel atributo de la zona de pruebas \"allow-same-origin\" esté bajo el control de ServiceWorker.\n\nSi habilitas la política o no la estableces,\nBrave hará que los iframes de srcdoc\ncon atributos de la zona de pruebas “allow-same-origin” estén bajo el control de ServiceWorker.\n\nSi la inhabilitas, el iframe de srcdoc no estará controlado por\nServiceWorker.\n\nEsta política es temporal y se quitará en 2026.";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_title = "Especificar si se puede utilizar la política SharedArrayBuffers en un contexto que no está aislado en orígenes cruzados";
SharedArrayBufferUnrestrictedAccessAllowed.pfm_description = "\nEspecifica si puede utilizarse la política SharedArrayBuffers en un contexto que no está aislado de orígenes cruzados. Brave requerirá el aislamiento de origen cruzado cuando se utilice la política SharedArrayBuffers a partir de Brave 91 (25-05-2021) por motivos de compatibilidad con la Web. Encontrarás información adicional en el siguiente sitio: https://developer.chrome.com/blog/enabling-shared-array-buffer/.\n\nSi habilitas la política, los sitios podrán usar la política SharedArrayBuffer sin restricciones.\n\nSi la inhabilitas o no la estableces, los sitios solo podrán usar la política SharedArrayBuffers cuando cuenten con aislamiento de origen cruzado.";
SharedWorkerBlobURLFixEnabled.pfm_title = "Alinear el comportamiento de la URL de BLOB de SharedWorker con la especificación";
SharedWorkerBlobURLFixEnabled.pfm_description = "En https://w3c.github.io/ServiceWorker/#control-and-use-worker-client,\nlos trabajadores deben heredar controladores para la URL de BLOB.  Sin embargo, el código existente\npermite que solo los DedicatedWorkers hereden el controlador. Los SharedWorkers no\nlo heredan.\n\nSi habilitas la política o no la estableces,\nBrave heredará el controlador\nsi se usa una URL de BLOB como una URL de SharedWorker.\n\nSi inhabilitas la política, el comportamiento no se alineará con la\nespecificación actual.\n\nEsta política es temporal y se quitará en el futuro.";
SharedWorkerExtendedLifetimeEnabled.pfm_title = "Habilitar la vida útil extendida para SharedWorkers";
SharedWorkerExtendedLifetimeEnabled.pfm_description = "Los SharedWorkers pueden tener una vida útil extendida si la opción \"extendedLifetime\" se establece en verdadero en el constructor de SharedWorker.\n\nSi habilitas esta política o no la estableces, los SharedWorkers pueden tener una vida útil extendida.\n\nSi inhabilitas esta política, los SharedWorkers no podrán tener una vida útil extendida, incluso si estableces la opción como verdadera.\n\nEsta política es temporal y se quitará en el futuro.";
ShoppingListEnabled.pfm_title = "Permitir que se habilite la función de lista de compras";
ShoppingListEnabled.pfm_description = "Esta política controla la disponibilidad de la función de lista de compras.\nSi la habilitas, los usuarios verán una IU para hacer un seguimiento del precio del producto que se muestra en la página actual. El producto con seguimiento aparecerá en el panel lateral de favoritos.\nSi habilitas esta política o no la estableces, los usuarios podrán acceder a la función de lista de compras.\nSi la inhabilitas, la función de la lista de compras no estará disponible.\n";
ShowAppsShortcutInBookmarkBar.pfm_title = "Muestra el acceso directo a las aplicaciones en la barra de favoritos.";
ShowAppsShortcutInBookmarkBar.pfm_description = "Si estableces la política como verdadera, se mostrarán los accesos directos a aplicaciones. Si la estableces como falsa, no se mostrarán nunca los accesos directos.\n\nSi estableces la política, los usuarios no podrán cambiarla. Si no la estableces, los usuarios podrán ocultar o mostrar los accesos directos a aplicaciones desde el menú contextual de la barra de favoritos.";
ShowCastIconInToolbar.pfm_title = "Mostrar el ícono de la barra de herramientas de Google Cast";
ShowCastIconInToolbar.pfm_description = "Si habilitas la política, se mostrará el ícono de Cast en la barra de herramientas o el menú ampliado; los usuarios no podrán quitarlo.\n\nSi la inhabilitas o no la estableces, los usuarios podrán fijar o quitar el ícono desde el menú contextual.\n\nSi inhabilitas la política EnableMediaRouter, el valor de esta política no tendrá ningún efecto y no se mostrará el ícono de la barra de herramientas.";
ShowCastSessionsStartedByOtherDevices.pfm_title = "Mostrar los controles multimedia de las sesiones de Google Cast que iniciaron otros dispositivos en la red local";
ShowCastSessionsStartedByOtherDevices.pfm_description = "Si habilitas esta política, la IU de los controles de reproducción de contenido multimedia estará disponible en las sesiones de Google Cast que inicien otros dispositivos en la red local.\n\nSi no estableces esta política para los usuarios empresariales o la inhabilitas, la IU de los controles de reproducción de contenido multimedia no estará disponible en las sesiones de Google Cast que inicien otros dispositivos en la red local.\n\nSi inhabilitas la política EnableMediaRouter, el valor de esta política no tendrá efecto, ya que se inhabilitará la funcionalidad completa de Google Cast.";
ShowFullUrlsInAddressBar.pfm_title = "Muestra las URL completas";
ShowFullUrlsInAddressBar.pfm_description = "Esta función permite ver la URL completa en la barra de direcciones.\nSi estableces esta política como verdadera, se mostrará la URL completa en la barra de direcciones, incluidos sus esquemas y subdominios.\nSi la estableces como falsa, se aplicará la visualización predeterminada de las URL.\nSi no la estableces, se aplicará la visualización predeterminada de las URL, y el usuario podrá elegir esta visualización o la completa con una opción del menú contextual.\n";
ShowHomeButton.pfm_title = "Mostrar el botón \"Página principal\" en la barra de herramientas";
ShowHomeButton.pfm_description = "Si habilitas la política, se mostrará el botón de la página principal en la barra de herramientas de Brave. Si la inhabilitas, no se mostrará el botón.\n\nSi estableces esta política, los usuarios no podrán cambiarla en Brave. Si no la estableces, los usuarios decidirán si se muestra el botón.";
SideSearchEnabled.pfm_title = "Permitir que se muestre la página de resultados más reciente del motor de búsqueda predeterminado en el panel lateral de un navegador";
SideSearchEnabled.pfm_description = "Si habilitas la política o no la estableces, los usuarios podrán obtener la página de resultados más reciente del motor de búsqueda predeterminado en un panel lateral que podrán activar o desactivar mediante un ícono de la barra de herramientas.\n\nSi inhabilitas la política, se quitará el ícono de la barra de herramientas que abre el panel lateral con la página de resultados del motor de búsqueda predeterminado.";
SignedHTTPExchangeEnabled.pfm_title = "Habilitar compatibilidad con intercambios HTTP firmados (SXG)";
SignedHTTPExchangeEnabled.pfm_description = "Si estableces la política como verdadera o no la estableces, Brave aceptará contenidos web que se presenten como intercambios HTTP firmados.\n\nSi estableces la política como falsa, no se cargarán los intercambios HTTP firmados.";
SigninInterceptionEnabled.pfm_title = "Habilita la intercepción de acceso";
SigninInterceptionEnabled.pfm_description = "Esta configuración habilita o inhabilita la intercepción de acceso.\n\nSi habilitas o no estableces esta política, se mostrará el diálogo de la intercepción de acceso cuando se agregue una Cuenta de Google en la Web y el usuario resulte beneficiado con la migración de esta cuenta a otro perfil (nuevo o existente).\n\nSi se inhabilita, no se mostrará el diálogo de intercepción de acceso.\nSi se inhabilita y ManagedAccountsSigninRestriction separa los perfiles de la cuenta administrada, se seguirá mostrando el diálogo.";
SilentPrintingEnabled.pfm_title = "Habilitar la impresión silenciosa";
SilentPrintingEnabled.pfm_description = "Si estableces esta política como verdadera, se habilitará la impresión silenciosa, que cierra de inmediato\nla ventana de vista previa de impresión cuando se abre y que imprime en la impresora predeterminada con\nlas opciones predeterminadas. Si la impresora predeterminada es \"Guardar como PDF\", el archivo se\nguardará en la carpeta Descargas.\n\nSi no estableces esta política o la estableces como falsa, se inhabilitará la impresión\nsilenciosa, que no cierra automáticamente la ventana de vista previa de impresión y requiere\nque el usuario realice una selección como de costumbre.";
SitePerProcess.pfm_title = "Solicitar el aislamiento de sitios para todos los sitios";
SitePerProcess.pfm_description = "A partir de Brave 67, se habilitó el aislamiento de sitios de forma predeterminada en todas las plataformas de escritorio, lo que hace que los sitios se ejecuten en su propio proceso. Un sitio es un esquema más eTLD+1 (p. ej., https://example.com). Si habilitas esta política, no se modificará ese comportamiento; solo evita que los usuarios cambien la configuración (p. ej., inhabilitar el aislamiento de sitios en chrome://flags). A partir de Brave 76, si inhabilitas la política o no la estableces, no se desactivará el aislamiento de sitios, pero los usuarios podrán inhabilitar esta configuración.\n\nIsolateOrigins también puede ser útil para aislar orígenes específicos en un mayor nivel de detalle que el sitio (p. ej., https://a.example.com).\n\nEn la versión 76 y anteriores de Google Chrome OS, establece la política de dispositivo DeviceLoginScreenSitePerProcess en el mismo valor (si los valores no coinciden, pueden producirse retrasos cuando se ingresa a una sesión de usuario).\n\nNota: En Android, usa la política SitePerProcessAndroid en su lugar.";
SiteSearchSettings.pfm_title = "Configuración de las búsquedas en sitios";
SiteSearchSettings.pfm_description = "Esta política proporciona una lista de sitios en los que los usuarios pueden buscar rápidamente con atajos en la barra de direcciones. Para iniciar una búsqueda, los usuarios pueden escribir el atajo o @atajo (p. ej., @trabajo), seguido de la barra espaciadora o Tab en la barra de direcciones.\n\nLos siguientes campos son obligatorios para cada sitio: name, shortcut, url.\n\nEl campo name corresponde al nombre del sitio o del motor de búsqueda que se mostrará al usuario en la barra de direcciones.\n\nshortcut puede incluir palabras y caracteres simples, pero no puede incluir espacios ni comenzar con el símbolo @. Los atajos también deben ser únicos.\n\nPara cada entrada, el campo url especifica la URL del motor de búsqueda utilizado durante una búsqueda con la palabra clave correspondiente. La URL debe incluir la cadena '{searchTerms}', que se reemplazará en la búsqueda por los términos del usuario. Se ignoran las entradas no válidas y las entradas con atajos duplicados.\n\nLas entradas de búsquedas en el sitio configuradas como destacadas se muestran en la barra de direcciones cuando el usuario escribe \"@\". Se pueden seleccionar hasta tres entradas como destacadas.\n\nPara una entrada de búsqueda en el sitio en la que allow_user_override sea verdadera, los usuarios pueden editar o inhabilitar esa entrada. Sin embargo, los motores destacados (que comienzan con \"@\") solo se pueden inhabilitar. Si un usuario modifica una entrada que se creó inicialmente a través de esta política, ya no se administrará mediante la política y se tratará como un atajo creado por el usuario. Cuando allow_user_override es falsa o no se especifica para una entrada de búsqueda en el sitio, los usuarios no pueden editar ni inhabilitar esa entrada. La configuración para permitir la anulación por parte del usuario solo se admite en M139 y versiones posteriores. En las versiones anteriores, se inhabilitará la anulación por parte del usuario de forma predeterminada.\n\nLos usuarios no pueden crear nuevas entradas de búsquedas en el sitio con un atajo creado anteriormente mediante esta política, a menos que allow_user_override se establezca como verdadera para la entrada de búsqueda en el sitio.\n\nEn caso de conflicto con un atajo creado anteriormente por el usuario, tiene prioridad la configuración del usuario. Sin embargo, los usuarios aún pueden activar la opción creada por la política escribiendo \"@\" en la barra de búsqueda. Por ejemplo, si el usuario ya definió \"trabajo\" como atajo a URL1 y la política define \"trabajo\" como atajo a URL2, al escribir \"trabajo\" en la barra de búsqueda se activará una búsqueda en URL1, pero si escribes \"@trabajo\" en la barra de búsqueda se activará una búsqueda en URL2.\n\nEn Microsoft® Windows®, esta política solo está disponible en instancias que están vinculadas a un dominio de Microsoft® Active Directory®, vinculadas a Microsoft® Azure® Active Directory® o inscritas en Chrome Enterprise Core.\n\nEn macOS, esta política solo está disponible en instancias administradas con MDM, vinculadas a un dominio a través de MCX o inscritas en Chrome Enterprise Core.\nConsulta https://chromeenterprise.google/policies/?policy=SiteSearchSettings para obtener más información sobre el esquema y el formato.";
SmartTabSharingSettings.pfm_title = "Configuración del uso compartido inteligente de pestañas";
SmartTabSharingSettings.pfm_description = "0 - Permitir el uso compartido inteligente de pestañas con las integraciones de Google AI Mode.\n1 - No permitir el uso compartido inteligente de pestañas con las integraciones de Google AI Mode.\nEsta política controla la función de uso compartido inteligente de pestañas de Google AI Mode a través del panel lateral o las pestañas de Google Chrome.\n\nTen en cuenta que esta política no afecta a Google AI Mode en la Web. Solo controla cómo los usuarios pueden compartir información cuando usan Google Chrome.\n\n0 = los usuarios pueden compartir contenido de páginas o archivos con Google AI Mode.\n\n1 = los usuarios no pueden compartir contenido de páginas o archivos con Google AI Mode. Se inhabilitarán o se ocultarán los puntos de entrada para compartir contexto y el panel lateral.\n\nEsta política se ignorará cuando Google Search no sea el motor de búsqueda predeterminado de los usuarios, ya que la función estará inhabilitada.\n\nEsta política es independiente de la política AIModeSettings. La política AIModeSettings solo controla los puntos de entrada en el cuadro de búsqueda del cuadro multifunción o de la NTP, mientras que esta política controla el uso compartido de contexto a través del panel lateral o las pestañas.\n\nEsta política tampoco controla la integración de Google Gemini, que puede inhabilitarla GeminiSettings.\n\nTen en cuenta que si SearchContentSharingSettings está inhabilitada, se ignorará esta política.\n\nSi no estableces esta política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
SpellCheckServiceEnabled.pfm_title = "Habilita o inhabilita el servicio web de revisión ortográfica.";
SpellCheckServiceEnabled.pfm_description = "Si habilitas la política, se pondrá en funcionamiento un servicio web de Google que te ayudará a resolver los errores de ortografía. Esta política solo controla el uso del servicio en línea. Si inhabilitas la política, el servicio no se usará nunca.\n\nSi no la estableces, los usuarios podrán decidir si utilizar el servicio de corrector ortográfico o no.\n\nEl corrector ortográfico podrá usar un diccionario descargado de manera local a menos que SpellcheckEnabled inhabilite esa función. En ese caso, esta política no tendrá efecto.";
SpellcheckEnabled.pfm_title = "Habilitar el corrector ortográfico";
SpellcheckEnabled.pfm_description = "Si habilitas la política, se activará el corrector ortográfico, y los usuarios no podrán desactivarlo. En Microsoft® Windows®, Google Chrome OS y Linux®, es posible activar y desactivar individualmente idiomas con corrección ortográfica, por lo que de todos modos los usuarios podrán desactivar el corrector ortográfico si desactivan cada idioma que tenga corrección ortográfica. A fin de evitarlo, usa la políticaSpellcheckLanguage para habilitar idiomas específicos con corrección ortográfica de manera automática.\n\nSi inhabilitas la política, se desactivará el corrector ortográfico de todas las fuentes, y los usuarios no lo podrán activar. Las políticas SpellCheckServiceEnabled, SpellcheckLanguage y SpellcheckLanguageBlocklist no tienen efecto cuando esta política se establece como falsa.\n\nSi no estableces esta política, los usuarios podrán activar o desactivar el corrector ortográfico en la configuración de idiomas.";
StandardizedBrowserZoomEnabled.pfm_title = "Habilitar el comportamiento estandarizado del zoom del navegador";
StandardizedBrowserZoomEnabled.pfm_description = "Esta política habilita la conformidad con la especificación recientemente adoptada del zoom de CSS.\n\nSi habilitas esta política o no la estableces, la propiedad \"zoom\" de CSS se ajustará a la especificación:\n\nhttps://drafts.csswg.org/css-viewport/#zoom-property\n\nSi la inhabilitas, la propiedad \"zoom\" de CSS volverá a su comportamiento heredado anterior a la estandarización.\n\nEsta política es una prórroga temporal para permitir que el contenido web migre al nuevo comportamiento. También hay una prueba de origen (\"DisableStandardizedBrowserZoom\") que corresponde al comportamiento cuando inhabilitas esta política. Esta política se quitará y el comportamiento \"Habilitado\" se establecerá como permanente en la versión 134.";
StaticStorageQuotaEnabled.pfm_title = "Controlar si las APIs de cuota de almacenamiento devolverán valores estáticos";
StaticStorageQuotaEnabled.pfm_description = "Si se habilita, las APIs de cuota de almacenamiento devolverán un valor estático igual al uso + min(10 GiB, espacio del disco redondeado al próximo GiB entero).\nCuando se inhabilita, las APIs de cuota de almacenamiento generalmente devuelven un valor dinámico proporcional al espacio total disponible en el dispositivo, independientemente del uso.\nSi no se establece, las APIs de cuota de almacenamiento usarán el comportamiento predeterminado de Chrome.\nEsta configuración no afecta a los sitios con permisos de almacenamiento ilimitado. La cuota forzosa tampoco se verá afectada.";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_title = "Habilitar la verificación estricta del tipo de MIME para secuencias de comandos para workers";
StrictMimetypeCheckForWorkerScriptsEnabled.pfm_description = "Esta política habilita la verificación estricta del tipo de MIME para secuencias de comandos para workers.\n\nSi la habilitas o no la estableces, las secuencias de comandos para workers usarán una verificación estricta del tipo de MIME para JavaScript, que es el nuevo comportamiento predeterminado. Se rechazarán las secuencias de comandos para workers con tipos de MIME heredados.\n\nSi la inhabilitas, las secuencias de comandos para workers usarán la verificación laxa de tipos de MIME, de modo que las secuencias de comandos para workers con tipos de MIME heredados, p. ej. text/ascii, se seguirán cargando y ejecutando.\n\nTradicionalmente, los navegadores usaban verificaciones laxas de tipos de MIME, de modo que se admitían recursos con varios tipos de MIME heredados; p. ej., para los recursos de JavaScript, text/ascii es un tipo de MIME heredado admitido. Este comportamiento puede causar problemas de seguridad, ya que permite cargar recursos como secuencias de comandos que no serían usados con ese fin. Próximamente, Chrome comenzará a utilizar una verificación estricta de los tipos de MIME. La política habilitada hará un seguimiento del comportamiento predeterminado. Si inhabilitas esta política, los administradores podrán conservar el comportamiento heredado si lo desean.\n\nConsulta https://html.spec.whatwg.org/multipage/scripting.html#scriptingLanguage para obtener detalles sobre los tipos de medios JavaScript y ECMAScript.\n";
SuppressDifferentOriginSubframeDialogs.pfm_title = "Suprime los diálogos de JavaScript que se envían desde submarcos de otro origen";
SuppressDifferentOriginSubframeDialogs.pfm_description = "Como se describe en https://www.chromestatus.com/feature/5148698084376576, los diálogos modales de JavaScript, activados por window.alert, window.confirm y window.prompt, se bloquearán en Brave si se activan desde un submarco con un origen diferente al del marco principal.\n\nEsta política permite anular ese cambio.\nSi habilitas la política o no la estableces, se bloquearán los diálogos de JavaScript activados desde un submarco de origen diferente.\nSi inhabilitas la política, no se bloquearán los diálogos de JavaScript activados desde un submarco de origen diferente.\n\nLa política se quitará de Brave en el futuro.";
SuppressUnsupportedOSWarning.pfm_title = "Eliminar la advertencia de SO incompatible";
SuppressUnsupportedOSWarning.pfm_description = "Si habilitas la política, no se mostrarán advertencias cuando se ejecuta Brave en una computadora o sistema operativo no compatibles.\n\nSi la inhabilitas o no la estableces, se mostrarán advertencias en sistemas no compatibles.";
SyncDisabled.pfm_title = "Inhabilitar la sincronización de datos con Google";
SyncDisabled.pfm_description = "Si habilitas la política, se desactivará la sincronización de datos en Brave mediante los servicios de sincronización alojados en Google.\nPara desactivar por completo los servicios de Chrome Sync, recomendamos que desactives el servicio en Google Admin console.\n\nSi inhabilitas la política o no la estableces, los usuarios podrán elegir usar o no Chrome Sync.\n\nNota: No desactives esta política cuando está habilitada RoamingProfileSupportEnabled, porque esa función comparte la misma funcionalidad del cliente. En ese caso, se desactivará por completo la sincronización alojada en Google.";
SyncTypesListDisabled.pfm_title = "Lista de tipos que deben excluirse de la sincronización";
SyncTypesListDisabled.pfm_description = "Si estableces esta política, todos los tipos de datos especificados se excluirán de la sincronización para Chrome Sync y de la sincronización de perfiles móviles. Esta política puede ayudar a reducir el tamaño del perfil móvil o limitar los tipos de datos que se suben a los servidores de Chrome Sync.\n\nLos tipos de datos actuales para esta política son los siguientes: \"apps\", \"autofill\", \"bookmarks\", \"extensions\", \"preferences\", \"passwords\", \"payments\", \"productComparison\", \"readingList\", \"tabs\" themes\", \"typedUrls\", \"wifiConfigurations\". Estos nombres distinguen mayúsculas de minúsculas.\n\nNota: La actualización de políticas dinámicas solo es compatible con la versión 123 de Brave y con versiones posteriores. Si inhabilitas \"autofill\" también se inhabilitará la opción \"payments\". \"typedUrls\" se refiere a todo el historial de navegación.";
TLS13EarlyDataEnabled.pfm_title = "Habilitar TLS 1.3 Early Data";
TLS13EarlyDataEnabled.pfm_description = "TLS 1.3 Early Data es una extensión de TLS 1.3 para enviar una solicitud HTTP en simultáneo con el protocolo de enlace TLS.\n\nSi configuras la política, Brave seguirá el proceso de lanzamiento predeterminado para TLS 1.3 Early Data.\n\nSi la habilitas, Brave habilitará TLS 1.3 Early Data.\n\nSi la inhabilitas, Brave no habilitará TLS 1.3 Early Data.\n\nCuando la función está habilitada, Brave puede usar o no TLS 1.3 Early Data, según la compatibilidad del servidor.\n\nTLS 1.3 Early Data es un protocolo establecido. Se espera que los servidores TLS, los middleboxes y el software de seguridad existentes manejen o rechacen TLS 1.3 Early Data sin interrumpir la conexión.\n\nSin embargo, es posible que los dispositivos que no implementan TLS correctamente no funcionen bien y se desconecten cuando se use TLS 1.3 Early Data. Si esto ocurre, los administradores deben comunicarse con el proveedor para corregirlo.\n\nEsta política es una medida temporal para controlar la función y se quitará después. Es posible que la política se habilite para permitirte buscar errores y que se inhabilite mientras se resuelven.";
TabCaptureAllowedByOrigins.pfm_title = "Permitir que estos orígenes capturen pestañas";
TabCaptureAllowedByOrigins.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que pueden usar la captura de pestaña.\n\nSi no la estableces, los sitios no se considerarán para una anulación en este nivel de captura.\n\nTen en cuenta que las Apps de Chrome en ventanas se podrán capturar.\n\nNo se considerará esta política si un sitio coincide con un patrón de URL de la política SameOriginTabCaptureAllowedByOrigins.\n\nSi un sitio coincide con un patrón de URL de esta política, se considerarán las siguientes políticas: WindowCaptureAllowedByOrigins, ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/.  Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.";
TabCompareSettings.pfm_title = "Configuración de Tab Compare";
TabCompareSettings.pfm_description = "0 - Permitir la Comparación de pestañas y mejorar los modelos de IA.\n1 - Permitir la Comparación de pestañas sin mejorar los modelos de IA.\n2 - No permitir la Comparación de pestañas.\nLa Comparación de pestañas es una herramienta potenciada por IA para comparar información entre las pestañas de un usuario. Por ejemplo, la función se puede ofrecer al usuario cuando se abren varias pestañas con productos de una categoría similar.\n\n0 = Permite que se use la función y que Google use datos pertinentes para mejorar sus modelos de IA. Los datos pertinentes pueden incluir instrucciones, entradas, resultados, materiales de origen y comentarios escritos, según la función. Es posible que personas revisen los datos para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los siguientes casos.\n\n1 = Permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (lo que incluye las instrucciones, las entradas, los resultados, los materiales de origen y los comentarios escritos). 1 es el valor predeterminado para los usuarios empresariales que administra Google Admin console y las cuentas de institución educativa que administra Google Workspace.\n\n2 = No permite la función.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
TabDiscardingExceptions.pfm_title = "Excepciones de patrones de URL para descartar pestañas";
TabDiscardingExceptions.pfm_description = "Esta política hace que el navegador no descarte nunca las URLs que coincidan con uno o más de los patrones que especifican (con el formato de filtro URLBlocklist).\nEsto se aplica al descarte de la presión de memoria y del modo de alta eficiencia.\nSi se descarta una página, se descargará y se recuperarán todos sus recursos. La pestaña a la que está asociada permanece en la barra de pestañas, pero se activa una recarga completa si la haces visible.\n";
TaskManagerEndProcessEnabled.pfm_title = "Permitir finalizar procesos en el Administrador de tareas";
TaskManagerEndProcessEnabled.pfm_description = "Si inhabilitas la política, los usuarios no podrán finalizar procesos en el Administrador de tareas.\n\nSi habilitas la política o no la estableces, los usuarios podrán finalizar procesos en el Administrador de tareas.";
ThirdPartyAiChatSettings.pfm_title = "Configuración de las integraciones del Modo IA para terceros en la barra de direcciones y el cuadro de búsqueda de la página Nueva pestaña.";
ThirdPartyAiChatSettings.pfm_description = "0 - Permitir las integraciones del Modo IA para terceros.\n1 - No permitir integraciones del Modo IA para terceros.\nEsta política controla las integraciones del Modo IA para terceros en la barra de direcciones y el cuadro de búsqueda de la página Nueva pestaña.\n\nPara acceder a esta función, se debe establecer un motor de búsqueda de terceros que admita el Modo IA como el motor de búsqueda predeterminado del usuario.\n\n0 = La función estará disponible para los usuarios.\n\n1 = La función no estará disponible para los usuarios.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.";
TorDisabled.pfm_title = "Disable Tor Connectivity";
TorDisabled.pfm_description = "Disable Tor connectivity in Brave.\n\nUsing Tor connectivity in Private Windows makes it more difficult for sites to see a user's true IP address and for network observers to see what sites they visit. This may be used for enhanced confidentiality and censorship resistance in Private Windows.\n\nIf this policy is set to true, Tor connectivity will always be disabled.\n\nIf this policy is set to false, Tor connectivity will be enabled if the user opens a Private Window with Tor.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Tor connectivity will be enabled if the user opens a Private Window with Tor.";
TotalMemoryLimitMb.pfm_title = "Establecer el límite de memoria para las instancias de Chrome";
TotalMemoryLimitMb.pfm_description = "Configura la cantidad de memoria que puede usar una única instancia de Brave antes de que se empiecen a descartar las pestañas (es decir que se liberará la memoria que utiliza la pestaña, la cual se deberá volver a cargar cuando se seleccione), a fin de ahorrar memoria.\n\nSi estableces la política, el navegador comenzará a descartar pestañas para ahorrar memoria cuando se supere el límite. Sin embargo, no hay garantía de que el navegador se ejecute siempre por debajo del límite. Se redondeará a 1024 cualquier valor por debajo de 1024.\n\nSi no estableces esta política, el navegador solo comenzará a ahorrar memoria cuando detecte que queda poca cantidad de memoria física disponible en la máquina.";
TranslateEnabled.pfm_title = "Habilitar Traductor de Google";
TranslateEnabled.pfm_description = "Si estableces la política como verdadera, los usuarios podrán utilizar la funcionalidad de traducción cuando corresponda. Verán una barra de herramientas de traducción integrada en Brave y se agregará una opción de traducción al menú contextual que aparece al hacer clic con el botón derecho. Si estableces la política como falsa, se desactivarán todas las funciones de traducción integradas.\n\nSi estableces la política, los usuarios no podrán cambiar esta función. Si no la estableces, los usuarios podrán cambiar la configuración.";
TranslatorAPIAllowed.pfm_title = "Permitir la API de Translator";
TranslatorAPIAllowed.pfm_description = "Si habilitas la política o no la estableces, se permitirá el uso de la API de Translator en Brave.\n\nSi la inhabilitas, no se permitirá el uso de la API de Translator.";
TryOnYouSettings.pfm_title = "Configuración de Try on You.";
TryOnYouSettings.pfm_description = "0 - Habilitar Try on You con la mejora del modelo.\n1 - Habilitar Try on You sin la mejora del modelo.\n2 - Inhabilitar Try on You.\nTry on You es una función potenciada por IA que permite a los usuarios probarse virtualmente imágenes de ropa que se encuentran en la Web. Además, proporcionará estadísticas de compras útiles en Gemini en Chrome, si está habilitada.\n\n0 = Permite que se use la función y que Google use datos pertinentes para mejorar sus modelos de IA. Los datos pertinentes pueden incluir imágenes, entradas, resultados, materiales de referencia y comentarios, según la función. Es posible que personas revisen los datos para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los siguientes casos.\n\n1 = Permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (lo que incluye las imágenes, las entradas, los resultados, los materiales de referencia y los comentarios). 1 es el valor predeterminado para los usuarios empresariales que administra Google Admin console y las cuentas de institución educativa que administra Google Workspace.\n\n2 = No permite la función.\n\nNota: La restricción sobre las mejoras del modelo (valor 1) solo se aplica cuando se activa Try on You a través del flujo del navegador Chrome. No se aplica cuando la función se usa a través de otros flujos.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings. Para obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.\n\nLa función Try on You no está disponible en todos los países ni idiomas. Si estableces esta política, no se garantiza que se habilitará la función, ya que sigue sujeta a disponibilidad. Para obtener más información sobre el lanzamiento, consulta las notas de la versión de Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=es-419";
URLAllowlist.pfm_title = "Permitir el acceso a una lista de URL";
URLAllowlist.pfm_description = "Si estableces la política, se permitirá el acceso a las URLs de la lista, como excepciones a URLBlocklist. Consulta la descripción de esa política para conocer el formato de las entradas de esta lista. Por ejemplo, si estableces la política URLBlocklist como \"*\", se bloquearán todas las solicitudes. Además, con esta política puedes permitir el acceso a una lista limitada de URLs. Úsala para abrir excepciones para determinados esquemas, subdominios de otros dominios, puertos o rutas específicas, con el formato que se indica en (https://support.google.com/chrome/a?p=url_blocklist_filter_format). El filtro más específico determina si una URL está bloqueada o habilitada. La política URLAllowlist tiene prioridad sobre la política URLBlocklist. Esta política se limitará a 1,000 entradas.\n\nAdemás, esta política puede permitir que el navegador invoque de forma automática aplicaciones externas registradas como controladores de los protocolos que se encuentran en la lista correspondiente, como \"tel:\" o \"ssh:\".\n\nSi no estableces la política, no se permitirán excepciones URLBlocklist.\n\nA partir de la versión 92 de Brave, esta política también es compatible en el modo sin interfaz gráfica.";
URLBlocklist.pfm_title = "Bloquear el acceso a una lista de las URL";
URLBlocklist.pfm_description = "Si estableces la política URLBlocklist, se detendrá la carga de las páginas web que tengan URLs prohibidas. Los administradores pueden especificar la lista de patrones de URL que se bloquearán. Si no la estableces, no se bloqueará ninguna URL en el navegador. Se pueden definir hasta 1,000 excepciones en URLAllowlist. Consulta cómo darle formato a un patrón de URL ( https://support.google.com/chrome/a?p=url_blocklist_filter_format ).\n\nNota: Esta política no se aplica a las URLs de JavaScript en la página con datos cargados de forma dinámica. Si bloqueaste example.com/abc, example.com aún podría cargarla con XMLHTTPRequest. Además, esta política no impide que las páginas web actualicen la URL que se muestra en el cuadro multifunción a una bloqueada mediante la API de JavaScript History.\n\nA partir de la versión 73 de Brave, puedes bloquear las URLs javascript://*. Sin embargo, esto solo afecta el JavaScript ingresado en la barra de direcciones o, por ejemplo, bookmarklets.\n\nA partir de la versión 92 de Brave, esta política también es compatible en el modo sin interfaz gráfica.\n\nA partir de la versión 147 de Brave, el comodín * por sí solo no se aplica a las URLs internas de chrome://. Para bloquearlas, debes usar explícitamente el patrón chrome://*.\n\nNota: Si bloqueas las URLs internas chrome://* y chrome-untrusted://*, es posible que se produzcan errores inesperados o que se eludan en algunos casos. En lugar de bloquear determinadas URLs internas, consulta si hay más políticas específicas disponibles. Por ejemplo:\n\n- En lugar de bloquear chrome://settings/certificates, usa CACertificateManagementAllowed.\n\n- En lugar de bloquear chrome-untrusted://crosh, usa SystemFeaturesDisableList.\n\n- En lugar de bloquear devtools://*, usa una de las políticas DeveloperToolsAvailability, DeveloperToolsAvailabilityAllowlist o DeveloperToolsAvailabilityBlocklist.";
UpdateOnZeroWindowEnabled.pfm_title = "Controla el relanzamiento automático en segundo plano cuando se cierran todas las ventanas del navegador";
UpdateOnZeroWindowEnabled.pfm_description = "Controla el comportamiento de reinicio automático en segundo plano en macOS cuando hay una actualización de seguridad pendiente y se cierran todas las ventanas del navegador.\n\nSi estableces esta política como verdadera o no la estableces, Brave podrá reiniciarse automáticamente para aplicar las actualizaciones pendientes cuando se cierren todas las ventanas del navegador.\n\nSi se establece como falsa, se inhabilitan los reinicios automáticos cuando se cierran todas las ventanas del navegador.";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_title = "Permitir la recopilación de datos anónimos con clave de URL";
UrlKeyedAnonymizedDataCollectionEnabled.pfm_description = "Si habilitas la política, la recopilación de datos anónimos con URL estará siempre activa. Esta recopilación envía a Google las URLs de las páginas que visita el usuario para mejorar la búsqueda y la exploración.\n\nSi inhabilitas la política, no se recopilarán datos anónimos con URL.\n\nSi no la estableces, el usuario podrá cambiar esta configuración de forma manual.\n\nEn el kiosco de Google Chrome OS, esta política no ofrece la opción \"Permitir que el usuario decida\". Si no estableces esta política para el kiosco de Google Chrome OS, la recopilación de datos anónimos con URL estará siempre activa.\nCuando se establece para el kiosco de Google Chrome OS, esta política habilita la recopilación de métricas con URL para las aplicaciones de kiosco.";
UserDataDir.pfm_title = "Configurar directorio de datos de usuarios";
UserDataDir.pfm_description = "Configura el directorio que empleará Brave para almacenar datos del usuario.\n\nSi estableces esta política, Brave empleará el directorio provisto independientemente de que el usuario especifique la marca \"--user-data-dir\" o no. Para evitar pérdida de datos u otros errores inesperados, no debes establecer esta política en un directorio que se use para otros propósitos, porque Brave administra su contenido.\n\nConsulta https://support.google.com/chrome/a?p=Supported_directory_variables para ver una lista de las variables que se pueden usar.\n\nSi no estableces esta política, se utilizará la ruta del perfil predeterminada y el usuario podrá anularla con la marca de la línea de comandos \"--user-data-dir\".";
UserDataSnapshotRetentionLimit.pfm_title = "Limita la cantidad de instantáneas sobre los datos del usuario que se conservan en caso de tener que realizar reversión de emergencia.";
UserDataSnapshotRetentionLimit.pfm_description = "Después de cada actualización importante de la versión, Chrome creará una instantánea de ciertas porciones de los datos de navegación del usuario en caso de tener que realizar una reversión de emergencia en el futuro. Si se realiza una reversión de emergencia a una versión para la cual el usuario tiene una instantánea correspondiente, se restablecerán los datos de esa instantánea. Esto permitirá que los usuarios conserven opciones de configuración como los favoritos y los datos de la función Autocompletar.\n\nSi no se establece esta política, se usará el valor predeterminado \"3\".\n\nSi se establece la política, se borrarán las instantáneas anteriores según sea necesario para respetar el límite. Si se establece la política como \"0\", no se realizarán instantáneas.";
UserFeedbackAllowed.pfm_title = "Permite que los usuarios hagan comentarios";
UserFeedbackAllowed.pfm_description = "Si habilitas la política o no la estableces, los usuarios podrán enviar comentarios a Google desde Menú > Ayuda > Informar un problema o la combinación de teclas correspondiente.\n\nSi inhabilitas la política, los usuarios no podrán enviar los comentarios a Google.";
VideoCaptureAllowed.pfm_title = "Permitir o rechazar la captura de video";
VideoCaptureAllowed.pfm_description = "Si habilitas la política o no la estableces, a excepción de las URL que se indican en la lista VideoCaptureAllowedUrls, se les solicitará a los usuarios acceso para capturar videos.\n\nSi inhabilitas la política, se desactivarán los mensajes, y la captura de video solo estará disponible para las URL que se establezcan en la lista VideoCaptureAllowedUrls.\n\nNota: La política afecta a todas las entradas de video (no solo a la cámara integrada).";
VideoCaptureAllowedUrls.pfm_title = "Las URL que recibirán acceso a dispositivos de captura de video sin solicitarlo";
VideoCaptureAllowedUrls.pfm_description = "Si estableces la política, especificarás la lista de URL cuyos patrones buscarán coincidencia con el origen de seguridad de la URL de solicitud. En caso de haber coincidencia, se otorgará acceso a los dispositivos de captura de video sin necesidad de un mensaje.\n\nPara obtener información detallada sobre los patrones válidos de url, consulta https://chromeenterprise.google/policies/url-patterns/. Sin embargo, ten en cuenta que esta política no admite el patrón \"*\", que coincide con cualquier URL.";
VoiceTypingSettings.pfm_title = "Configuración de Talk to type";
VoiceTypingSettings.pfm_description = "0 - Permitir Talk to type.\n1 - Permitir Talk to type sin recopilación de datos.\n2 - No permitir Talk to type.\nTalk to type es una función basada en IA que permite a los usuarios ingresar y editar texto con la voz, con la tecnología de modelos de IA generativa para proporcionar transcripción y formato de alta calidad.\n\n0 = Permite que se use la función y que Google use datos pertinentes para mejorar sus modelos de IA. Los datos pertinentes pueden incluir instrucciones, entradas, resultados, materiales de referencia y comentarios escritos, según la función. Es posible que los datos sean revisados por personas para mejorar los modelos de IA. 0 es el valor predeterminado, excepto en los siguientes casos.\n\n1 = Permite que se use la función, pero no permite que Google mejore los modelos con el contenido de los usuarios (lo que incluye las instrucciones, las entradas, los resultados, los materiales de referencia y los comentarios escritos). 1 es el valor predeterminado para los usuarios empresariales que administra Google Admin console y las cuentas de institución educativa que administra Google Workspace.\n\n2 = No permite la función.\n\nSi no estableces la política, su comportamiento se determina según la política GenAiDefaultSettings.\n\nPara obtener más información sobre el manejo de datos de las funciones potenciadas por IA generativa, consulta https://support.google.com/chrome/a?p=generative_ai_settings.";
WPADQuickCheckEnabled.pfm_title = "Habilitar optimización de WPAD";
WPADQuickCheckEnabled.pfm_description = "Si la habilitas o no la estableces, se activará la optimización de WPAD (detección automática de proxy web) en Brave.\n\nSi la habilitas, se desactivará la optimización de WPAD. Esto hará que Brave espere más tiempo en los servidores de WPAD basados en DNS.\n\nMás allá de que establezcas o no esta política, los usuarios no podrán cambiar la configuración de la optimización de WPAD.";
WarnBeforeQuittingEnabled.pfm_title = "Mostrar un diálogo de advertencia cuando el usuario intenta salir";
WarnBeforeQuittingEnabled.pfm_description = "Controla un diálogo \"Advertir antes de salir (⌘-Q)\" cuando el usuario intenta salir del navegador.\n\nSi habilitas esta política o no la estableces, se mostrará un diálogo de advertencia cuando el usuario intente salir.\n\nSi no la habilitas, no se mostrará un diálogo de advertencia cuando el usuario intente salir.";
WebAppInstallByUserEnabled.pfm_title = "Habilitar la instalación de apps web por parte de los usuarios desde el navegador";
WebAppInstallByUserEnabled.pfm_description = "Esta política controla si los usuarios pueden instalar apps web a través del navegador.\nSi habilitas esta política o no la configuras, los usuarios podrán instalar apps web a través del navegador.\nSi inhabilitas esta política, los usuarios no podrán instalar apps web a través del navegador y el tipo de datos \"apps\" se excluirá de la sincronización de Chrome Sync.\nEsta política no admite la actualización dinámica. Los cambios, ya sea habilitar, inhabilitar o anular la configuración, solo se aplican después de reiniciar el navegador.\nEsta política no afecta la política \"WebAppInstallForceList\".";
WebAppInstallForceList.pfm_title = "URL de las aplicaciones web que se instalarán de manera silenciosa";
WebAppInstallForceList.pfm_description = "Si estableces la política, se especificará una lista de apps web que se instalan de manera silenciosa, sin la interacción del usuario, y que este no podrá desinstalar ni desactivar.\n\nCada elemento de la lista de la política es un objeto con un miembro obligatorio:\nurl (la URL de la app web que se instalará)\n\ny 6 miembros opcionales:\n- default_launch_container\n(establece la manera en la que se abrirá la app web; la opción predeterminada es una nueva pestaña)\n\n- create_desktop_shortcut\n(verdadero, si se crean accesos directos de escritorio para Linux y\nMicrosoft® Windows®).\n\n- fallback_app_name\n(A partir de la versión 90 de Brave,\nte permite anular el nombre de la app si no es una\napp web progresiva (AWP), o el nombre de la app instalada\ntemporalmente si es una AWP, pero se requiere autenticación para que la\ninstalación pueda completarse. Si se proporcionan\ncustom_name y\nfallback_app_name,\nse ignorará este último).\n\n- custom_name\n(A partir de la versión 99 de Google Chrome OS,\ny la versión 112 en los demás sistemas operativos de escritorio, te permite\nanular de forma permanente el nombre de la app para todas las apps web y AWP).\n\n- custom_icon\n(A partir de la versión 99 deGoogle Chrome OS,\ny la versión 112 en los demás sistemas operativos de escritorio, te permite\nanular el ícono de las apps instaladas. Los íconos deben tener forma cuadrada,\nun tamaño máximo de 1 MB y uno de los siguientes formatos: jpeg, png, gif, webp o ico.\nEl valor de hash del archivo del ícono debe ser SHA256. Se debe poder acceder a url\nsin autenticación para garantizar que se pueda usar el ícono\ndespués de instalar la app.)\n\n- install_as_shortcut\n(A partir de la versión 107 de\nBrave). Si se habilita, la url\nse instalará como acceso directo, como si se hiciera mediante la opción \"Crear acceso directo…\"\nen la GUI del navegador para computadoras.\nTen en cuenta que, en caso de que se instale como acceso directo, no se actualizará si\ncambia el manifiesto de url.\nSi se inhabilita o no se establece, la app web en la\nurl determinada se instalará normalmente.\n\nPara fijar apps a la barra de Google Chrome OS, consulta PinnedLauncherApps.\nConsulta https://chromeenterprise.google/policies/?policy=WebAppInstallForceList para obtener más información sobre el esquema y el formato.";
WebAppSettings.pfm_title = "Configuración de la administración de aplicaciones web";
WebAppSettings.pfm_description = "Esta política permite que un administrador especifique la configuración para las apps web instaladas. Esta política asigna la ID de una app web a su parámetro de configuración específico. Es posible establecer una configuración predeterminada usando la ID especial *, que se aplicará a todas las apps web que no tengan una configuración personalizada en esta política.\n\nEl campo manifest_id es la ID del manifiesto para la app web. Consulta https://developer.chrome.com/blog/pwa-manifest-id/ para obtener instrucciones para determinar la ID del manifiesto correspondiente a una app web instalada.\nEl campo run_on_os_login especifica si una app web puede ejecutarse durante el acceso al SO. Si estableces este campo como blocked, no se ejecutará la app web durante el acceso al SO, y el usuario no podrá habilitar esta acción más tarde. Si estableces este campo como run_windowed, se ejecutará la app web durante el acceso al SO, y el usuario no podrá inhabilitar esta acción más tarde. Si estableces este campo como allowed, el usuario podrá configurar la app web para que se ejecute durante el acceso al SO. La configuración predeterminada solo permite los valores allowed y blocked.\n(A partir de la versión 117) El campo prevent_close_after_run_on_os_login especifica si se debe impedir que una app web se cierre de alguna forma (p. ej., por el usuario, el Administrador de tareas o las APIs web). Este comportamiento solo se puede habilitar si estableces run_on_os_login como run_windowed. Si la app ya se estaba ejecutando, esta propiedad solo se aplicará cuando se reinicie la app. Si no se define este campo, los usuarios podrán cerrar las apps.\n(A partir de la versión 118) El campo force_unregister_os_integration especifica si se quitarán o no todas las integraciones del SO de una app web (p. ej., accesos directos, controladores de archivos, controladores de protocolos, etcétera). Si ya se está ejecutando una app, esta propiedad se aplicará cuando esta se reinicie. Se debe usar con precaución, ya que puede anular cualquier integración del SO que se configure automáticamente durante el inicio del sistema de aplicaciones web. Actualmente, solo funciona en plataformas Windows, Mac y Linux.\nConsulta https://chromeenterprise.google/policies/?policy=WebAppSettings para obtener más información sobre el esquema y el formato.";
WebAudioOutputBufferingEnabled.pfm_title = "Habilitar el almacenamiento en búfer adaptable para Web Audio";
WebAudioOutputBufferingEnabled.pfm_description = "Esta política controla si el navegador usa el almacenamiento en búfer adaptable para\nWeb Audio, lo que puede reducir las fallas de audio, pero también puede aumentar\nla latencia en una cantidad variable.\n\nSi habilitas la política, siempre se usará la función de almacenamiento en búfer adaptable.\n\nSi inhabilitas la política o no la estableces, el proceso de lanzamiento\nde funciones del navegador decidirá si se usa el almacenamiento en búfer adaptable.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_title = "Orígenes permitidos para las solicitudes de WebAuthn con proxy desde aplicaciones de escritorio remoto.";
WebAuthenticationRemoteDesktopAllowedOrigins.pfm_description = "Una lista de orígenes de apps de cliente de escritorio remoto que pueden ejecutar solicitudes a la API de WebAuthn\nque se originan a partir de una sesión de navegación en un host remoto.\n\nCualquier origen configurado en esta política puede realizar solicitudes de WebAuthn para Relying\nParty IDs (RP IDs) que normalmente no se pueden reclamar.\n\nSolo se permiten orígenes HTTPS válidos. Los comodines no son compatibles.\nSe ignoran las entradas no válidas.\n\nEsta política solo se aplica a los usuarios afiliados.";
WebHidAllowAllDevicesForUrls.pfm_title = "Otorgar permiso automáticamente a los sitios para que se conecten a cualquier dispositivo HID";
WebHidAllowAllDevicesForUrls.pfm_description = "Si estableces la política, podrás crear una lista de los sitios que reciben automáticamente permiso para acceder a todos los dispositivos disponibles.\n\nLas URLs deben ser válidas; de lo contrario, se ignorará la política. Solo se considera el origen (esquema, host y puerto) de la URL.\n\nEn ChromeOS, esta política solo se aplica a los usuarios afiliados.\n\nEsta política anula las políticas DefaultWebHidGuardSetting, WebHidAskForUrls y WebHidBlockedForUrls, y las preferencias del usuario.";
WebHidAllowDevicesForUrls.pfm_title = "Otorgar permiso automáticamente a estos sitios para que se conecten a dispositivos HID con los ID de producto y proveedor correspondientes";
WebHidAllowDevicesForUrls.pfm_description = "Si estableces la política, podrás crear una lista de URLs que indiquen los sitios a los que se les otorga permiso automáticamente para acceder a un dispositivo HID con los ID del producto y del proveedor especificados. Para que cada elemento de la lista sea válido, debe tener los campos devices y urls completos. De lo contrario, se ignorará el elemento. Cada elemento del campo devices debe tener especificado el campo vendor_id y puede tener el campo product_id. Si omites el campo product_id, se creará una política que funcione con cualquier dispositivo que tenga el ID de proveedor especificado. Los elementos que tengan especificado el campo product_id, pero que no tengan el campo vendor_id no serán válidos y se ignorarán.\n\nSi no estableces la política, se aplicará DefaultWebHidGuardSetting (si se establece). De lo contrario, se aplicará la configuración personal del usuario.\n\nLas URLs que se especifiquen en esta política no deben entrar en conflicto con las que se configuren a través de WebHidBlockedForUrls. Si ese es el caso, prevalecerá esta política por sobre WebHidBlockedForUrls.\nConsulta https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesForUrls para obtener más información sobre el esquema y el formato.";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_title = "Otorgar permiso automáticamente a estos sitios para que se conecten a dispositivos HID que tengan colecciones de nivel superior con el uso determinado de HID";
WebHidAllowDevicesWithHidUsagesForUrls.pfm_description = "Si estableces la política, podrás crear una lista de URLs que indiquen los sitios a los que se les otorga permiso automáticamente para acceder a un dispositivo HID que tenga una colección de nivel superior con el uso determinado de HID. Para que la política sea válida, cada elemento de la lista debe tener especificados los campos usages y urls. Cada elemento del campo usages debe tener especificado el campo usage_page y puede tener el campo usage. Si omites el campo usage, se creará una política que funcione con cualquier dispositivo que tenga una colección de nivel superior con un uso de la página de uso determinado. Los elementos que tengan especificado el campo usage, pero que no tengan el campo usage_page no serán válidos y se ignorarán.\n\nSi no estableces la política, se aplicará DefaultWebHidGuardSetting (si se establece). De lo contrario, se aplicará la configuración personal del usuario.\n\nLas URLs que se especifiquen en esta política no deben entrar en conflicto con las que se configuren a través de WebHidBlockedForUrls. Si ese es el caso, prevalecerá esta política por sobre WebHidBlockedForUrls.\nConsulta https://chromeenterprise.google/policies/?policy=WebHidAllowDevicesWithHidUsagesForUrls para obtener más información sobre el esquema y el formato.";
WebHidAskForUrls.pfm_title = "Permitir la API de WebHID en estos sitios";
WebHidAskForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen qué sitios pueden pedir a los usuarios permiso para acceder a un dispositivo HID.\n\nSi no estableces la política, se aplicará DefaultWebHidGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal de los usuarios.\n\nEn el caso de los patrones de URL que no coincidan con la política, tendrán prioridad los elementos de esta lista, en este orden:\n\n  * La política WebHidBlockedForUrls (si hay alguna coincidencia)\n\n  * La política DefaultWebHidGuardSetting (si se establece)\n\n  * La configuración personal de los usuarios\n\nLos patrones de URL no deben entrar en conflicto con WebHidBlockedForUrls. Si una URL se ajusta a ambas políticas, no prevalece ninguna de las dos.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
WebHidBlockedForUrls.pfm_title = "Bloquear la API de WebHID en estos sitios";
WebHidBlockedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen qué sitios no pueden pedir a los usuarios permiso para acceder a un dispositivo HID.\n\nSi no estableces la política, se aplicará DefaultWebHidGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal de los usuarios.\n\nEn el caso de los patrones de URL que no coincidan con la política, tendrán prioridad los elementos de esta lista, en este orden:\n\n  * La política WebHidAskForUrls (si hay alguna coincidencia)\n\n  * La política DefaultWebHidGuardSetting (si se establece)\n\n  * La configuración personal de los usuarios\n\nLos patrones de URL no pueden entrar en conflicto con WebHidAskForUrls. Si una URL se ajusta a ambas políticas, no prevalece ninguna de las dos.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_title = "Habilitar la recopilación de registros de diagnóstico de WebRTC para orígenes específicos";
WebRtcDiagnosticLogCollectionAllowedForOrigins.pfm_description = "Esta política permite habilitar la recopilación de registros de diagnóstico para WebRTC en orígenes específicos.\n\nPara obtener información detallada sobre los patrones de entrada válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política. Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL. Se admiten esquemas y subdominios.\n\nSi se establece la política, se habilitará la recopilación de registros de diagnóstico para los orígenes que coincidan con los patrones de la lista.\n\nSi no estableces la política, la recopilación de registros de diagnóstico se inhabilitará de forma predeterminada.";
WebRtcEventLogCollectionAllowed.pfm_title = "Permitir la recopilación de registro de acontecimientos de WebRTC que provienen de los servicios de Google";
WebRtcEventLogCollectionAllowed.pfm_description = "Si habilitas la política, Brave podrá recopilar registros de eventos de WebRTC a partir de los servicios de Google, como Hangouts Meet, y subirlos a Google. Estos registros incluyen información de diagnóstico que permite depurar problemas relacionados con llamadas de video o audio de Brave, como el momento y el tamaño de los paquetes RTP, comentarios sobre la congestión en la red y metadatos sobre el tiempo y la calidad de los cuadros de video y audio. Estos registros no incluyen contenido de audio o video de la reunión. Para simplificar la depuración, Google puede asociar estos registros, por medio de un ID de sesión, con otros registros recopilados por el servicio de Google en sí.\n\nSi inhabilitas la política, no se recopilarán ni subirán estos registros.\n\nSi no la estableces, hasta la versión M76 inclusive, Brave no podrá recopilar ni subir esos registros de forma predeterminada. A partir de la versión M77, Brave podrá, de forma predeterminada, recopilar y subir esos registros de la mayoría de los perfiles afectados por las políticas empresariales en la nube para los usuarios. En las versiones posteriores a M77 y hasta la M80 inclusive, Brave también podrá recopilar y subir de forma predeterminada esos registros de los perfiles afectados por la administración local de Brave.";
WebRtcIPHandling.pfm_title = "Manejo de IP de WebRTC";
WebRtcIPHandling.pfm_description = "default - WebRTC utilizará todas las interfaces disponibles al momento de buscar la mejor ruta.\ndefault_public_and_private_interfaces - WebRTC solo utilizará la interfaz mediante una conexión pública, pero puede conectarse mediante direcciones IP privadas.\ndefault_public_interface_only - WebRTC solo utilizará la interfaz mediante una conexión pública, pero no se conectará mediante direcciones IP privadas.\ndisable_non_proxied_udp - WebRTC utilizará TCP en la interfaz disponible al usuario y solo utilizará UDP si lo admite un proxy configurado.\nEsta política permite restringir las direcciones IP y las interfaces que utiliza WebRTC al momento de intentar encontrar la mejor conexión disponible.\n\nValores válidos:\n\n* default: WebRTC usa todas las interfaces de red disponibles.\n\n* default_public_and_private_interfaces: WebRTC usa todas las interfaces públicas y privadas.\n\n* default_public_interface_only: WebRTC usa todas las interfaces públicas, pero no las privadas.\n\n* disable_non_proxied_udp: WebRTC usa el proxy SOCKS del UDP o recurrirá al proxy del TCP.\n\nSi no estableces la política, de forma predeterminada se utilizarán todas las redes disponibles.\n\nConsulta el RFC 8828, sección 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2) para obtener una descripción detallada de todos los valores de procesamiento.";
WebRtcIPHandlingUrl.pfm_title = "Procesamiento de IP de WebRTC por URL";
WebRtcIPHandlingUrl.pfm_description = "Esta política permite restringir las direcciones IP y las interfaces que utiliza WebRTC al momento de intentar encontrar la mejor conexión disponible para cada patrón de URL específico.\n\nAcepta una lista de patrones de URL y pares de tipos de procesamiento. Los patrones de URL se revisan en orden, y la primera coincidencia configurará el tipo de procesamiento que WebRTC usa para el dominio. Cuando la URL del documento actual no coincide con ninguna entrada, se usa la configuración establecida por la política WebRtcIPHandling.\n\nPara obtener información detallada sobre los patrones de entrada válidos, consulta https://chromeenterprise.google/policies/url-patterns/. Se permite el uso de caracteres comodín (*). Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.\n\nValores de procesamiento válidos:\n\n* default: WebRTC usa todas las interfaces de red.\n\n* default_public_and_private_interfaces: WebRTC usa todas las interfaces públicas y privadas.\n\n* default_public_interface_only: WebRTC usa todas las interfaces públicas, pero no las privadas.\n\n* disable_non_proxied_udp: WebRTC usa el proxy SOCKS del UDP o recurrirá al proxy del TCP.\n\nConsulta el RFC 8828, sección 5.2 (https://tools.ietf.org/html/rfc8828.html#section-5.2) para obtener una descripción detallada de todos los valores de procesamiento.\nConsulta https://chromeenterprise.google/policies/?policy=WebRtcIPHandlingUrl para obtener más información sobre el esquema y el formato.";
WebRtcLocalIpsAllowedUrls.pfm_title = "Las URL para las que se exponen las IP locales en los candidatos ICE de WebRTC";
WebRtcLocalIpsAllowedUrls.pfm_description = "Se compararán los patrones de esta lista con el origen de seguridad de la URL solicitante.\nSi se encuentra una coincidencia o se inhabilita la opción chrome://flags/#enable-webrtc-hide-local-ips-with-mdns, se mostrarán las direcciones IP locales en los candidatos ICE de WebRTC.\nDe lo contrario, se ocultarán las direcciones IP locales con nombres de host de mDNS.\nTen en cuenta que esta política afecta la protección de las IP locales, si los administradores la habilitan.";
WebRtcPostQuantumKeyAgreement.pfm_title = "Habilitar el acuerdo de claves poscuántico para WebRTC";
WebRtcPostQuantumKeyAgreement.pfm_description = "Esta política permite controlar el acuerdo de claves poscuántico para WebRTC.\n\nSi habilitas esta política, se ofrecerá un acuerdo de claves poscuántico para\nWebRTC.\n\nSi la inhabilitas, no se ofrecerá el acuerdo de claves poscuántico\npara WebRTC.\n\nSi no la estableces, el valor se establecerá a través del proceso de lanzamiento predeterminado\npara el acuerdo de claves poscuántico que se ofrece para WebRTC.\n\nLa oferta del acuerdo de claves poscuántico es retrocompatible. Se espera que los pares de\nDTLS existentes y el middleware de red ignoren la opción nueva y\ncontinúen seleccionando opciones anteriores.\n\nSin embargo, es posible que los dispositivos que no implementan DTLS correctamente no funcionen bien cuando\nse les ofrezca la opción nueva. Por ejemplo, es posible que se desconecten en respuesta a\nopciones no reconocidas o a mensajes más extensos. Estos dispositivos no están\npreparados para la poscuantificación y pueden interferir en la transición poscuántica de una\nempresa. Si se detectan errores, los administradores deben comunicarse con el proveedor para corregirlos.\n\nEsta política es una medida temporal y se quitará después de algunos hitos.";
WebRtcTextLogCollectionAllowed.pfm_title = "Permitir la recopilación de registros de textos de WebRTC de los Servicios de Google";
WebRtcTextLogCollectionAllowed.pfm_description = "Si habilitas la política, Brave podrá recopilar registros de textos de WebRTC a partir de los servicios de Google, como Google Meet, y subirlos a Google. Estos registros incluyen información de diagnóstico que permite depurar problemas relacionados con llamadas de video o audio de Brave, como metadatos de texto que describen transmisiones entrantes y salientes de WebRTC, entradas de registro específicas de WebRTC y otra información adicional del sistema. Estos registros no incluyen contenido de audio o video de la reunión.\nSi inhabilitas la política, no se subirán esos registros a Google. Los registros se acumularán localmente en el dispositivo del usuario.\nSi no estableces la política, Brave podrá recopilar y subir esos registros de forma predeterminada.";
WebRtcUdpPortRange.pfm_title = "Restringir el intervalo de puertos UDP locales que usa WebRTC";
WebRtcUdpPortRange.pfm_description = "Si se establece la política, el intervalo de puertos UDP que usa WebRTC está restringido al intervalo de puertos especificado (extremos incluidos).\n\nSi la política no se establece, se establece con un intervalo de puertos no válido o se deja como una cadena vacía, WebRTC puede usar cualquier puerto UDP local disponible.";
WebUsbAllowDevicesForUrls.pfm_title = "Otorgar permiso automáticamente a estos sitios para conectarse a dispositivos USB con los ID de producto y proveedor correspondientes";
WebUsbAllowDevicesForUrls.pfm_description = "Si estableces la política, podrás crear una lista de patrones de URL que indiquen los sitios a los que se les otorga permiso automáticamente para acceder a un dispositivo USB con los IDs del producto y del proveedor especificados. Para que la política sea válida, cada elemento de la lista debe tener los campos devices y urls. Cada elemento del campo devices puede tener los campos vendor_id y product_id. Si omites el campo vendor_id, se creará una política que funcione con cualquier dispositivo. Si omites el campo product_id, se creará una política que funcione con cualquier dispositivo que tenga el ID de proveedor especificado. Las políticas que tengan el campo product_id, pero que no tengan el campo vendor_id no serán válidas.\n\nEl modelo de permisos de USB permitirá que la URL especificada acceda al dispositivo USB como origen de nivel superior. Si los marcos incorporados necesitan acceder a dispositivos USB, se deberá usar el encabezado feature-policy de \"usb\" para otorgar acceso. Si la URL no es válida, se ignorará la política.\n\nObsoleto: el modelo de permisos de USB que se usa para admitir la especificación de las URLs de incorporación y de solicitud. Este modelo está obsoleto y solo se admite con fines de retrocompatibilidad de la siguiente manera: si se especifican tanto la URL de incorporación como la de solicitud, la URL de incorporación recibirá permiso como origen de nivel superior, y se ignorará por completo la URL de solicitud.\n\nEsta política anula las políticas DefaultWebUsbGuardSetting, WebUsbAskForUrls y WebUsbBlockedForUrls, y las preferencias del usuario.\n\nEsta política solo afecta el acceso a dispositivos USB a través de la API de WebUSB. Para otorgar el acceso a dispositivos USB a través de la API de Web Serial, consulta la política SerialAllowUsbDevicesForUrls.\nConsulta https://chromeenterprise.google/policies/?policy=WebUsbAllowDevicesForUrls para obtener más información sobre el esquema y el formato.";
WebUsbAskForUrls.pfm_title = "Permite WebUSB en estos sitios";
WebUsbAskForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen qué sitios pueden pedir a los usuarios permiso para acceder a un dispositivo USB.\n\nSi no estableces la política, se aplicará DefaultWebUsbGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nLos patrones de URL no deben entrar en conflicto con WebUsbAskForUrls. Si una URL se ajusta a ambas políticas, no prevalece ninguna de las dos.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
WebUsbBlockedForUrls.pfm_title = "Bloquea WebUSB en estos sitios";
WebUsbBlockedForUrls.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de URL que indiquen qué sitios no pueden pedir a los usuarios permiso para acceder a un dispositivo USB.\n\nSi no estableces la política, se aplicará DefaultWebUsbGuardSetting para todos los sitios, en caso de haberse establecido. De lo contrario se aplicará la configuración personal del usuario.\n\nLos patrones de URL no pueden entrar en conflicto con WebUsbAskForUrls. Si una URL se ajusta a ambas políticas, no prevalece ninguna de las dos.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns. * no es un valor aceptado para esta política.";
WindowCaptureAllowedByOrigins.pfm_title = "Permitir que estos orígenes capturen pestañas y ventanas";
WindowCaptureAllowedByOrigins.pfm_description = "Si estableces la política, podrás especificar una lista de patrones de las URL que pueden usar la captura de pestañas y ventanas.\n\nSi no la estableces, los sitios no se considerarán para una anulación en este nivel de captura.\n\nNo se considerará esta política si un sitio coincide con un patrón de URL de cualquiera de las siguientes políticas: TabCaptureAllowedByOrigins, SameOriginTabCaptureAllowedByOrigins.\n\nSi un sitio coincide con un patrón de URL de esta política, no se considerarán las siguientes políticas: ScreenCaptureAllowedByOrigins, ScreenCaptureAllowed.\n\nPara obtener información detallada sobre los patrones de url válidos, consulta https://chromeenterprise.google/policies/url-patterns/.  Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.";
WindowManagementAllowedForUrls.pfm_title = "Otorgar el permiso de Administración de ventanas a estos sitios";
WindowManagementAllowedForUrls.pfm_description = "Te permite establecer una lista de patrones de URL de sitios que otorgarán automáticamente el permiso para administrar ventanas. Esto ampliará la capacidad de los sitios para ver la información sobre las pantallas del dispositivo y utilizarla para abrir y ubicar ventanas o solicitar el modo pantalla completa en pantallas específicas.\n\nPara obtener información detallada sobre los patrones de URL de sitios válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.\n\nSi no estableces esta política para un sitio, se aplicará la política de DefaultWindowManagementSetting al sitio, si se establece. De lo contrario, el permiso seguirá la configuración predeterminada del navegador y permitirá a los usuarios elegir este permiso para cada sitio.\n\nEsto reemplaza la política WindowPlacementAllowedForUrls, que dejó de estar disponible.";
WindowManagementBlockedForUrls.pfm_title = "Bloquear el permiso de Administración de ventanas en estos sitios";
WindowManagementBlockedForUrls.pfm_description = "Te permite establecer una lista de patrones de URL de sitios que rechazarán automáticamente el permiso de administración de ventanas. Esto limitará la capacidad de los sitios para ver la información sobre las pantallas del dispositivo y utilizarla para abrir y ubicar ventanas o solicitar el modo pantalla completa en pantallas específicas.\n\nPara obtener información detallada sobre los patrones de URL de sitios válidos, consulta https://chromeenterprise.google/policies/url-patterns. Se permite el uso de caracteres comodín (*). Esta política solo establece coincidencias basadas en el origen; por lo tanto, se ignoran todas las rutas de acceso que se incluyan en el patrón de URL.\n\nSi no estableces esta política para un sitio, se aplicará la política de DefaultWindowManagementSetting al sitio, si se establece. De lo contrario, el permiso seguirá la configuración predeterminada del navegador y permitirá a los usuarios elegir este permiso para cada sitio.\n\nEsto reemplaza la política WindowPlacementBlockedForUrls, que dejó de estar disponible.";
XSLTEnabled.pfm_title = "Controlar la disponibilidad de la función XSLT";
XSLTEnabled.pfm_description = "Esta política controla la disponibilidad de la función XSLT (la API de JavaScript XSLTProcessor y la instrucción de procesamiento XSL).\nSi habilitas esta política, XSLT estará disponible, independientemente del estado predeterminado de la función en el navegador.\nSi inhabilitas esta política, XSLT no estará disponible, independientemente del estado predeterminado de la función en el navegador.\nSi no estableces esta política, la disponibilidad de XSLT se determinará según la configuración predeterminada del navegador y las pruebas de campo.\nEsta política es una medida temporal y se quitará en la versión M176.";