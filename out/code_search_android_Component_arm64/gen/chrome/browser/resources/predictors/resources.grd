<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/predictors_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/predictors_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/predictors_resources_map.h"
            type="resource_map_header" />
    <output filename="predictors_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_PREDICTORS_PREDICTORS_CSS" file="${root_gen_dir}/chrome/browser/resources/predictors/preprocessed/predictors.css" resource_path="predictors.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_PREDICTORS_PREDICTORS_HTML" file="${root_gen_dir}/chrome/browser/resources/predictors/preprocessed/predictors.html" resource_path="predictors.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PREDICTORS_AUTOCOMPLETE_ACTION_PREDICTOR_JS" file="${root_gen_dir}/chrome/browser/resources/predictors/minified/autocomplete_action_predictor.js" resource_path="autocomplete_action_predictor.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PREDICTORS_PREDICTORS_JS" file="${root_gen_dir}/chrome/browser/resources/predictors/minified/predictors.js" resource_path="predictors.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_PREDICTORS_RESOURCE_PREFETCH_PREDICTOR_JS" file="${root_gen_dir}/chrome/browser/resources/predictors/minified/resource_prefetch_predictor.js" resource_path="resource_prefetch_predictor.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
