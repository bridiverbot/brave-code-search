-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--color=always
--target=x86_64-apple-darwin
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
