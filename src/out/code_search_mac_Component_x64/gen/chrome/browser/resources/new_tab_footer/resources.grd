<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/new_tab_footer_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/new_tab_footer_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/new_tab_footer_resources_map.h"
            type="resource_map_header" />
    <output filename="new_tab_footer_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_NEW_TAB_FOOTER_NEW_TAB_FOOTER_HTML" file="${root_gen_dir}/chrome/browser/resources/new_tab_footer/preprocessed/new_tab_footer.html" resource_path="new_tab_footer.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NEW_TAB_FOOTER_APP_HTML_JS" file="${root_gen_dir}/chrome/browser/resources/new_tab_footer/minified/app.html.js" resource_path="app.html.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NEW_TAB_FOOTER_APP_JS" file="${root_gen_dir}/chrome/browser/resources/new_tab_footer/minified/app.js" resource_path="app.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NEW_TAB_FOOTER_WINDOW_PROXY_JS" file="${root_gen_dir}/chrome/browser/resources/new_tab_footer/minified/window_proxy.js" resource_path="window_proxy.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NEW_TAB_FOOTER_APP_CSS_JS" file="${root_gen_dir}/chrome/browser/resources/new_tab_footer/minified/app.css.js" resource_path="app.css.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NEW_TAB_FOOTER_CUSTOMIZE_BUTTONS_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/new_tab_footer/minified/customize_buttons.mojom-webui.js" resource_path="customize_buttons.mojom-webui.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NEW_TAB_FOOTER_NEW_TAB_FOOTER_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/new_tab_footer/minified/new_tab_footer.mojom-webui.js" resource_path="new_tab_footer.mojom-webui.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NEW_TAB_FOOTER_CUSTOMIZE_CHROME_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/new_tab_footer/minified/customize_chrome.mojom-webui.js" resource_path="customize_chrome.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
