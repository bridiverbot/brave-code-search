<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/new_tab_page_extension_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/new_tab_page_extension_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/new_tab_page_extension_resources_map.h"
            type="resource_map_header" />
    <output filename="new_tab_page_extension_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_NEW_TAB_PAGE_EXTENSION_MANIFEST_JSON" file="${root_gen_dir}/chrome/browser/resources/new_tab_page_extension/preprocessed/manifest.json" resource_path="new_tab_page_extension/manifest.json" use_base_dir="false" type="BINDATA" />
      <include name="IDR_NEW_TAB_PAGE_EXTENSION_NEW_TAB_PAGE_HTML" file="${root_gen_dir}/chrome/browser/resources/new_tab_page_extension/preprocessed/new_tab_page.html" resource_path="new_tab_page_extension/new_tab_page.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NEW_TAB_PAGE_EXTENSION_APP_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/new_tab_page_extension/minified/app.rollup.js" resource_path="new_tab_page_extension/app.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
