module _Builtin_intrinsics [system] [extern_c] {
  explicit module altivec {
    requires altivec
    header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/altivec.h"
  }

  explicit module arm {
    requires arm

    explicit module acle {
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/arm_acle.h"
      export *
    }

    explicit module bf16 {
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/arm_bf16.h"
      export *
    }

    explicit module fp16 {
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/arm_fp16.h"
      export *
    }

    explicit module neon {
      requires neon
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/arm_neon.h"
      export *
    }

    explicit module sve {
      requires sve
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/arm_sve.h"
      export *
    }
  }

  explicit module arm64 {
    requires arm64
    requires windows

    header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/arm64intr.h"
    export *

    explicit module neon {
      requires neon
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/arm64_neon.h"
      export *
    }
  }

  explicit module intel {
    requires x86
    export *

    header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/immintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/f16cintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/avxintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/avx2intrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/avx512fintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/fmaintrin.h"

    header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/x86intrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/bmiintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/bmi2intrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/lzcntintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/xopintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/fma4intrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/mwaitxintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/clzerointrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/wbnoinvdintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/cldemoteintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/waitpkgintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/movdirintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/pconfigintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/sgxintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/ptwriteintrin.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/invpcidintrin.h"

    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/__wmmintrin_aes.h"
    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/__wmmintrin_pclmul.h"

    textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/mm3dnow.h"

    explicit module mm_malloc {
      requires !freestanding
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/mm_malloc.h"
      export * // note: for <stdlib.h> dependency
    }

    explicit module cpuid {
      requires gnuinlineasm
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/cpuid.h"
    }

    explicit module mmx {
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/mmintrin.h"
    }

    explicit module sse {
      export mm_malloc
      export mmx
      export sse2 // note: for hackish <emmintrin.h> dependency
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/xmmintrin.h"
    }

    explicit module sse2 {
      export sse
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/emmintrin.h"
    }

    explicit module sse3 {
      export sse2
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/pmmintrin.h"
    }

    explicit module ssse3 {
      export sse3
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/tmmintrin.h"
    }

    explicit module sse4_1 {
      export ssse3
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/smmintrin.h"
    }

    explicit module sse4_2 {
      export sse4_1
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/nmmintrin.h"
    }

    explicit module sse4a {
      export sse3
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/ammintrin.h"
    }

    explicit module popcnt {
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/popcntintrin.h"
    }

    explicit module aes_pclmul {
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/wmmintrin.h"
      export aes
      export pclmul
    }
  }

  explicit module systemz {
    requires systemz
    export *

    header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/s390intrin.h"

    explicit module htm {
      requires htm
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/htmintrin.h"
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/htmxlintrin.h"
    }

    explicit module zvector {
      requires zvector, vx
      header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/vecintrin.h"
    }
  }
}

// Start -fbuiltin-headers-in-system-modules affected modules

// The following modules all ignore their headers when
// -fbuiltin-headers-in-system-modules is passed, and many of
// those headers join system modules when present.

// e.g. if -fbuiltin-headers-in-system-modules is passed, then
// float.h will not be in the _Builtin_float module (that module
// will be empty). If there is a system module that declares
// `header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/float.h"`, then the builtin float.h will join
// that module. The system float.h (if present) will be treated
// as a textual header in the sytem module.
module _Builtin_float [system] {
  textual header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/float.h"

  explicit module float {
    header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/__float_float.h"
    export *
  }

  explicit module header_macro {
    header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/__float_header_macro.h"
    export *
  }

  explicit module infinity_nan {
    header "../../../../../third_party/llvm-build/Release+Asserts/lib/clang/24/include/__float_infinity_nan.h"
    export *
  }
}

