<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/downloads_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/downloads_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/downloads_resources_map.h"
            type="resource_map_header" />
    <output filename="downloads_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_DOWNLOADS_IMAGES_INCOGNITO_MARKER_SVG" file="${root_src_dir}/chrome/browser/resources/downloads/images/incognito_marker.svg" resource_path="images/incognito_marker.svg" use_base_dir="false" type="BINDATA" />
      <include name="IDR_DOWNLOADS_IMAGES_INCOGNITO_MARKER_OLD_SVG" file="${root_src_dir}/chrome/browser/resources/downloads/images/incognito_marker_old.svg" resource_path="images/incognito_marker_old.svg" use_base_dir="false" type="BINDATA" />
      <include name="IDR_DOWNLOADS_IMAGES_NO_DOWNLOADS_SVG" file="${root_src_dir}/chrome/browser/resources/downloads/images/no_downloads.svg" resource_path="images/no_downloads.svg" use_base_dir="false" type="BINDATA" />
      <include name="IDR_DOWNLOADS_DOWNLOADS_HTML" file="${root_gen_dir}/chrome/browser/resources/downloads/preprocessed/downloads.html" resource_path="downloads.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_DOWNLOADS_DOWNLOADS_ROLLUP_JS" file="${root_gen_dir}/chrome/browser/resources/downloads/minified/downloads.rollup.js" resource_path="downloads.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
