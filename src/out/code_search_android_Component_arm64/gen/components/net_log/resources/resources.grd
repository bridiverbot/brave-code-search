<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/net_export_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/net_export_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/net_export_resources_map.h"
            type="resource_map_header" />
    <output filename="net_export_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_NET_EXPORT_NET_EXPORT_CSS" file="${root_gen_dir}/components/net_log/resources/preprocessed/net_export.css" resource_path="net_export.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_NET_EXPORT_NET_EXPORT_HTML" file="${root_gen_dir}/components/net_log/resources/preprocessed/net_export.html" resource_path="net_export.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_NET_EXPORT_NET_EXPORT_JS" file="${root_gen_dir}/components/net_log/resources/minified/net_export.js" resource_path="net_export.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
