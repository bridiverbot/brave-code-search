<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/accessibility_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/accessibility_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/accessibility_resources_map.h"
            type="resource_map_header" />
    <output filename="accessibility_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_ACCESSIBILITY_ACCESSIBILITY_CSS" file="${root_gen_dir}/chrome/browser/resources/accessibility/preprocessed/accessibility.css" resource_path="accessibility.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_ACCESSIBILITY_ACCESSIBILITY_HTML" file="${root_gen_dir}/chrome/browser/resources/accessibility/preprocessed/accessibility.html" resource_path="accessibility.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_ACCESSIBILITY_ACCESSIBILITY_JS" file="${root_gen_dir}/chrome/browser/resources/accessibility/minified/accessibility.js" resource_path="accessibility.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
