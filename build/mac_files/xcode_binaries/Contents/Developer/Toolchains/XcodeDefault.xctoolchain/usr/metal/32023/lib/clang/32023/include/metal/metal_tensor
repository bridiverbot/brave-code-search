private:
  // Copy-like constructor (with offsets and extents)
  template <class OtherExtents>
  METAL_FUNC tensor(const thread tensor<element_type, OtherExtents, tensor_inline, Tags...> &other,
                    const thread offsets_type &other_offsets,
                    const thread array<index_type, tensor::get_rank()> &other_extents) thread
  {
    __metal_slice_tensor(handle(), other.handle(), tensor::get_rank(),
                         /* offsets = */ other_offsets.data(),
                         /* extents = */ other_extents.data(),
                         index_type());
  }

  // Copy-like constructor (with offsets)
  template <class OtherExtents>
  METAL_FUNC tensor(const thread tensor<element_type, OtherExtents, tensor_inline, Tags...> &other,
                    const thread offsets_type &other_offsets) thread
    : tensor(other, other_offsets,
             [&]<size_t... Pos>(index_sequence<Pos...>) {
               if constexpr (tensor::get_rank() > 0)
                 return array<index_type, tensor::get_rank()>{
                   (other.get_extent(Pos) - other_offsets[Pos])...
                 };
               else
                 return array<index_type, tensor::get_rank()>{};
             }(make_index_sequence<tensor::get_rank()>()))
  {
  }

public:
  // Slice
  template <size_t... OtherExtents, class... OtherIndexTypes>
  METAL_FUNC enable_if_t<
    ((tensor::get_rank() > 0) &&
     (is_convertible_v<OtherIndexTypes, index_type> && ...) &&
     (sizeof...(OtherExtents) == tensor::get_rank()) && (sizeof...(OtherIndexTypes) == tensor::get_rank())),
    __tensor_detail::__tensor_with_extents_t<extents<index_type, OtherExtents...>, tensor>>
  slice(OtherIndexTypes... index) thread const
  {
    return [&]<size_t... Pos>(index_sequence<Pos...>)
    {
      return __tensor_detail::__tensor_with_extents_t<extents<index_type, OtherExtents...>, tensor>(
          *this,
          offsets_type{static_cast<index_type>(index)...},
          offsets_type{(OtherExtents == dynamic_extent ? (this->get_extent(Pos) - static_cast<index_type>(index))
                                                       : static_cast<index_type>(OtherExtents))...}
      );
    }(make_index_sequence<tensor::get_rank()>());
  }

  template <class... OtherIndexTypes>
  METAL_FUNC enable_if_t<
    ((is_convertible_v<OtherIndexTypes, index_type> && ...) &&
     (sizeof...(OtherIndexTypes) == tensor::get_rank())),
    __tensor_detail::__tensor_with_dynamic_extents_t<tensor>>
  slice(OtherIndexTypes... index) thread const
  {
    return __tensor_detail::__tensor_with_dynamic_extents_t<tensor>(
