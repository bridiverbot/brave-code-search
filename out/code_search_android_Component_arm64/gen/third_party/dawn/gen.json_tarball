hs;\n}\ninline WGPUVertexStepMode* ToAPI(WGPUVertexStepMode* rhs) {\n    return rhs;\n}\n\ninline wgpu::VertexStepMode FromAPI(WGPUVertexStepMode rhs) {\n    return static_cast<wgpu::VertexStepMode>(rhs);\n}\ninline const wgpu::VertexStepMode* FromAPI(const WGPUVertexStepMode* rhs) {\n    return reinterpret_cast<const wgpu::VertexStepMode*>(rhs);\n}\ninline wgpu::VertexStepMode* FromAPI(WGPUVertexStepMode* rhs) {\n    return reinterpret_cast<wgpu::VertexStepMode*>(rhs);\n}\ninline WGPUWaitStatus ToAPI(WGPUWaitStatus rhs) {\n    return rhs;\n}\ninline const WGPUWaitStatus* ToAPI(const WGPUWaitStatus* rhs) {\n    return rhs;\n}\ninline WGPUWaitStatus* ToAPI(WGPUWaitStatus* rhs) {\n    return rhs;\n}\n\ninline wgpu::WaitStatus FromAPI(WGPUWaitStatus rhs) {\n    return static_cast<wgpu::WaitStatus>(rhs);\n}\ninline const wgpu::WaitStatus* FromAPI(const WGPUWaitStatus* rhs) {\n    return reinterpret_cast<const wgpu::WaitStatus*>(rhs);\n}\ninline wgpu::WaitStatus* FromAPI(WGPUWaitStatus* rhs) {\n    return reinterpret_cast<wgpu::WaitStatus*>(rhs);\n}\ninline WGPUWGSLLanguageFeatureName ToAPI(WGPUWGSLLanguageFeatureName rhs) {\n    return rhs;\n}\ninline const WGPUWGSLLanguageFeatureName* ToAPI(const WGPUWGSLLanguageFeatureName* rhs) {\n    return rhs;\n}\ninline WGPUWGSLLanguageFeatureName* ToAPI(WGPUWGSLLanguageFeatureName* rhs) {\n    return rhs;\n}\n\ninline wgpu::WGSLLanguageFeatureName FromAPI(WGPUWGSLLanguageFeatureName rhs) {\n    return static_cast<wgpu::WGSLLanguageFeatureName>(rhs);\n}\ninline const wgpu::WGSLLanguageFeatureName* FromAPI(const WGPUWGSLLanguageFeatureName* rhs) {\n    return reinterpret_cast<const wgpu::WGSLLanguageFeatureName*>(rhs);\n}\ninline wgpu::WGSLLanguageFeatureName* FromAPI(WGPUWGSLLanguageFeatureName* rhs) {\n    return reinterpret_cast<wgpu::WGSLLanguageFeatureName*>(rhs);\n}\n\n// Fallback ToAPI and FromAPI for primitive and matching pointer types.\ntemplate <typename T>\n    requires(\n        std::is_fundamental_v<std::remove_cv_t<T>> ||\n        std::is_same_v<std::remove_cv_t<T>, std::byte> ||\n        std::is_void_v<std::remove_cv_t<T>>)\ninline T* ToAPI(T* rhs) {\n    return rhs;\n}\ninline const std::byte* FromAPI(const void* rhs) {\n    return reinterpret_cast<const std::byte*>(rhs);\n}\ninline std::byte* FromAPI(void* rhs) {\n    return reinterpret_cast<std::byte*>(rhs);\n}\n\ntemplate <typename T>\n    requires(\n        std::is_fundamental_v<std::remove_cv_t<T>> ||\n        std::is_same_v<std::remove_cv_t<T>, std::byte>)\ninline T* FromAPI(T* rhs) {\n    return rhs;\n}\n\ntemplate <typename T>\n    requires(\n        (std::is_fundamental_v<std::remove_cv_t<T>> && !std::is_void_v<std::remove_cv_t<T>>) ||\n        std::is_same_v<std::remove_cv_t<T>, std::byte>)\ninline T ToAPI(T rhs) {\n    return rhs;\n}\ntemplate <typename T>\n    requires(\n        (std::is_fundamental_v<std::remove_cv_t<T>> && !std::is_void_v<std::remove_cv_t<T>>) ||\n        std::is_same_v<std::remove_cv_t<T>, std::byte>)\ninline T FromAPI(T rhs) {\n    return rhs;\n}\n\n// Templated helper for converting Spans.\ntemplate <typename T, typename Index, typename PtrType, Index Extent>\nauto ToAPI(dawn::detail::SpanBase<T, Index, PtrType, Extent> rhs) {\n    using ResultItem = std::remove_pointer_t<decltype(ToAPI(rhs.data()))>;\n    // SAFETY: The returned Span has the same lifetime as the input Span.\n    return DAWN_UNSAFE_BUFFERS(dawn::detail::SpanBase<ResultItem, Index, ResultItem*, Extent>(ToAPI(rhs.data()), rhs.size()));\n}\n\ntemplate <typename T, typename Index, typename PtrType, Index Extent>\nauto FromAPI(dawn::detail::SpanBase<T, Index, PtrType, Extent> rhs) {\n    using ResultItem = std::remove_pointer_t<decltype(FromAPI(rhs.data()))>;\n    // SAFETY: The returned Span has the same lifetime as the input Span.\n    return DAWN_UNSAFE_BUFFERS(dawn::detail::SpanBase<ResultItem, Index, ResultItem*, Extent>(FromAPI(rhs.data()), rhs.size()));\n}\n\nnamespace detail {\ntemplate <typename T>\nstruct AsAPITypeImpl {\n    using type = T;\n};\ntemplate <typename T>\n    requires requires { ToAPI(std::declval<T>()); }\nstruct AsAPITypeImpl<T> {\n    using type = decltype(ToAPI(std::declval<T>()));\n};\n}  // namespace detail\n\n// Helper useful in templating code, especially for MSVC where template deduction fails for some\n// overloads sometimes.\ntemplate <typename T>\nusing AsAPIType = typename detail::AsAPITypeImpl<T>::type;\n\n\n}  // namespace dawn::wire\n\n#endif  // DAWNWIRE_DAWN_PLATFORM_AUTOGEN_H_\n", "src/dawn/wire/client/ApiObjects_autogen.h": "\n#ifndef DAWNWIRE_CLIENT_APIOBJECTS_AUTOGEN_H_\n#define DAWNWIRE_CLIENT_APIOBJECTS_AUTOGEN_H_\n\n#include \"dawn/wire/ObjectType_autogen.h\"\n#include \"src/dawn/wire/client/ObjectBase.h\"\n\nnamespace dawn::wire::client {\n\n    template<typename T>\n    inline constexpr ObjectType ObjectTypeToTypeEnum = static_cast<ObjectType>(-1);\n\n    class Adapter;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<Adapter> = ObjectType::Adapter;\n\n    struct BindGroup final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::BindGroup;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<BindGroup> = ObjectType::BindGroup;\n\n    struct BindGroupLayout final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::BindGroupLayout;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<BindGroupLayout> = ObjectType::BindGroupLayout;\n\n    class Buffer;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<Buffer> = ObjectType::Buffer;\n\n    struct CommandBuffer final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::CommandBuffer;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<CommandBuffer> = ObjectType::CommandBuffer;\n\n    struct CommandEncoder final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::CommandEncoder;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<CommandEncoder> = ObjectType::CommandEncoder;\n\n    struct ComputePipeline final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::ComputePipeline;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<ComputePipeline> = ObjectType::ComputePipeline;\n\n    class Device;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<Device> = ObjectType::Device;\n\n    struct ExternalTexture final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::ExternalTexture;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<ExternalTexture> = ObjectType::ExternalTexture;\n\n    class Instance;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<Instance> = ObjectType::Instance;\n\n    struct PipelineLayout final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::PipelineLayout;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<PipelineLayout> = ObjectType::PipelineLayout;\n\n    class QuerySet;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<QuerySet> = ObjectType::QuerySet;\n\n    class Queue;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<Queue> = ObjectType::Queue;\n\n    struct RenderBundle final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::RenderBundle;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<RenderBundle> = ObjectType::RenderBundle;\n\n    struct RenderPipeline final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::RenderPipeline;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<RenderPipeline> = ObjectType::RenderPipeline;\n\n    class ResourceTable;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<ResourceTable> = ObjectType::ResourceTable;\n\n    struct Sampler final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::Sampler;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<Sampler> = ObjectType::Sampler;\n\n    class ShaderModule;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<ShaderModule> = ObjectType::ShaderModule;\n\n    class Surface;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<Surface> = ObjectType::Surface;\n\n    struct TexelBufferView final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::TexelBufferView;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<TexelBufferView> = ObjectType::TexelBufferView;\n\n    class Texture;\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<Texture> = ObjectType::Texture;\n\n    struct TextureView final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::TextureView;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<TextureView> = ObjectType::TextureView;\n\n    struct ComputePassEncoder final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::ComputePassEncoder;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<ComputePassEncoder> = ObjectType::ComputePassEncoder;\n\n    struct RenderBundleEncoder final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::RenderBundleEncoder;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<RenderBundleEncoder> = ObjectType::RenderBundleEncoder;\n\n    struct RenderPassEncoder final : ObjectBase {\n        using ObjectBase::ObjectBase;\n\n        ObjectType GetObjectType() const override {\n            return ObjectType::RenderPassEncoder;\n        }\n    };\n\n    template <>\n    inline constexpr ObjectType ObjectTypeToTypeEnum<RenderPassEncoder> = ObjectType::RenderPassEncoder;\n\n}  // namespace dawn::wire::client\n\n#endif  // DAWNWIRE_CLIENT_APIOBJECTS_AUTOGEN_H_\n", "src/dawn/wire/client/ApiProcs_autogen.cpp.inc": "\n#include <algorithm>\n#include <cstring>\n#include <string_view>\n#include <type_traits>\n#include <utility>\n#include <vector>\n\n#include \"absl/base/no_destructor.h\"\n#include \"absl/container/flat_hash_map.h\"\n#include \"dawn/wire/client/dawn_platform.h\"\n#include \"dawn/wire/client/webgpu.h\"\n#include \"dawn/dawn_version.h\"\n#include \"src/dawn/wire/client/Client.h\"\n#include \"src/utils/numeric.h\"\n#include \"src/utils/span.h\"\n\n\nnamespace dawn::wire::client {\n\n    // Template function for constexpr branching when creating new objects.\n    template <typename Parent, typename Child, typename... Args>\n    Child* Create(Parent p, Args... args) {\n        if constexpr (std::is_constructible_v<Child, const ObjectBaseParams&, decltype(args)...>) {\n            return p->GetClient()->template Make<Child>(args...).Detach();\n        } else if constexpr (std::is_constructible_v<Child, const ObjectBaseParams&, Ref<Instance>, decltype(args)...>) {\n            return p->GetClient()->template Make<Child>(p->GetInstance(), args...).Detach();\n        } else {\n            if constexpr (std::is_base_of_v<ObjectWithEventsBase, Child>) {\n                return p->GetClient()->template Make<Child>(p->GetInstance()).Detach();\n            } else {\n                return p->GetClient()->template Make<Child>().Detach();\n            }\n        }\n    }\n\n}  // namespace dawn::wire::client\n\nnamespace {\n// Alias the dawn::wire::client namespace in because we need a lot of the helpers, structures, and\n// types, and currently the client wgpu* implementations need to be in global namespace. This is\n// ok because this is an implementation file, and we alias the namespace into an anonymous\n// namespace in this case.\nusing namespace dawn::wire::client;\n}  // namespace\n\n\nDAWN_WIRE_EXPORT WGPUDevice wgpuDawnWireClientAdapterCreateDevice(WGPUAdapter cSelf, WGPUDeviceDescriptor const * descriptor) {\n    auto self = FromAPI(cSelf);\n    auto descriptor_ = FromAPI(descriptor);\n\nauto result =self->APICreateDevice(descriptor_);\nreturn ToAPI(result);\n\n}\n\nDAWN_WIRE_EXPORT void wgpuDawnWireClientAdapterGetFeatures(WGPUAdapter cSelf, WGPUSupportedFeatures * features) {\n    auto self = FromAPI(cSelf);\n    auto features_ = FromAPI(features);\n\nself->APIGetFeatures(features_);\n\n}\n\nDAWN_WIRE_EXPORT WGPUStatus wgpuDawnWireClientAdapterGetFormatCapabilities(WGPUAdapter cSelf, WGPUTextureFormat format, WGPUDawnFormatCapabilities * capabilities) {\n    auto self = FromAPI(cSelf);\n    auto format_ = FromAPI(format);\nauto capabilities_ = FromAPI(capabilities);\n\nauto result =self->APIGetFormatCapabilities(format_, capabilities_);\nreturn ToAPI(result);\n\n}\n\nDAWN_WIRE_EXPORT WGPUStatus wgpuDawnWireClientAdapterGetInfo(WGPUAdapter cSelf, WGPUAdapterInfo * info) {\n    auto self = FromAPI(cSelf);\n    auto info_ = FromAPI(info);\n\nauto result =self->APIGetInfo(info_);\nreturn ToAPI(result);\n\n}\n\nDAWN_WIRE_EXPORT WGPUInstance wgpuDawnWireClientAdapterGetInstance(WGPUAdapter cSelf) {\n    auto self = FromAPI(cSelf);\n    \nauto result =self->APIGetInstance();\nreturn ToAPI(result);\n\n}\n\nDAWN_WIRE_EXPORT WGPUStatus wgpuDawnWireClientAdapterGetLimits(WGPUAdapter cSelf, WGPULimits * limits) {\n    auto self = FromAPI(cSelf);\n    auto limits_ = FromAPI(limits);\n\nauto result =self->APIGetLimits(limits_);\nreturn ToAPI(result);\n\n}\n\nDAWN_WIRE_EXPORT WGPUBool wgpuDawnWireClientAdapterHasFeature(WGPUAdapter cSelf, WGPUFeatureName feature) {\n    auto self = FromAPI(cSelf);\n    auto feature_ = FromAPI(feature);\n\nauto result =self->APIHasFeature(feature_);\nreturn ToAPI(result);\n\n}\n\nDAWN_WIRE_EXPORT WGPUFuture wgpuDawnWireClientAdapterRequestDevice(WGPUAdapter cSelf, WGPUDeviceDescriptor const * descriptor, WGPURequestDeviceCallbackInfo callbackInfo) {\n    auto self = FromAPI(cSelf);\n    auto descriptor_ = FromAPI(descriptor);\nauto callbackInfo_ = callbackInfo;\n\nauto result =self->APIRequestDevice(descriptor_, callbackInfo_);\nreturn ToAPI(result);\n\n}\n\nDAWN_WIRE_EXPORT void wgpuDawnWireClientAdapterAddRef(WGPUAdapter cSelf) {\n    auto self = FromAPI(cSelf);\n    \nself->APIAddRef();\n\n}\n\nDAWN_WIRE_EXPORT void wgpuDawnWireClientAdapterRelease(WGPUAdapter cSelf) {\n    auto self = FromAPI(cSelf);\n    \nself->APIRelease();\n\n}\n\n\nDAWN_WIRE_EXPORT void wgpuDawnWireClientAdapterInfoFreeMembers(WGPUAdapterInfo cSelf) {\n    return APIAdapterInfoFreeMembers(cSelf);\n}\n\n\nDAWN_WIRE_EXPORT void wgpuDawnWireClientAdapterPropertiesMemoryHeapsFreeMembers(WGPUAdapterPropertiesMemoryHeaps cSelf) {\n    return APIAdapterPropertiesMemoryHeapsFreeMembers(cSelf);\n}\n\n\nDAWN_WIRE_EXPORT void wgpuDawnWireClientAdapterPropertiesSu