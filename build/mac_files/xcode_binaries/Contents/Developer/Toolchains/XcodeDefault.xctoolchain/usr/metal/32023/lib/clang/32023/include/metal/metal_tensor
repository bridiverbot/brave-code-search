template <class PlaneTag, class ElementType, size_t... BlockSizes>
struct tensor_blockwise
{
public:
  METAL_FUNC static constexpr size_t get_block_size(size_t r)
  {
    constexpr size_t sizes[] = {BlockSizes...};
    return r < sizeof...(BlockSizes) ? sizes[r] : 1;
  }

  static_assert(is_same_v<PlaneTag, tensor_plane_scales>,
                "tensor_blockwise: PlaneTag must be tensor_plane_scales");
  static_assert(
      is_same_v<__type_traits_detail::remove_qualifiers_t<ElementType>, metal_fp8_ue8m0_format>,
      "tensor_blockwise: ElementType must be metal_fp8_ue8m0_format");
  static_assert(sizeof...(BlockSizes) >= 1,
                "tensor_blockwise: must have a rank of at least 1");
  static_assert(get_block_size(0) == 32,
                "tensor_blockwise: first component of BlockSizes must be 32");
  static_assert([]<size_t... Is>(index_sequence<Is...>) {
      return ((get_block_size(Is + 1) == 1) && ...);
    }(make_index_sequence<sizeof...(BlockSizes) - 1>{}),
    "tensor_blockwise: remaining components of BlockSizes must be 1");

  using element_type = ElementType;
  using value_type = __tensor_detail::__tensor_value_t<element_type>;
  using data_handle_type = __tensor_detail::__tensor_data_handle_t<element_type>;

public:
  METAL_FUNC static constexpr size_t get_rank() { return sizeof...(BlockSizes); }

public:
  METAL_FUNC tensor_blockwise() thread = default;

  METAL_FUNC tensor_blockwise(data_handle_type plane_data) thread : _plane_data(plane_data)
  {
  }

  template <class, class, class, class...> friend struct tensor;

private:
  data_handle_type _plane_data;
};
#endif

