--crate-name
compiler_builtins
--crate-type
rlib
--cfg=backtrace_in_libstd
-Zforce-unstable-if-unmarked
--cap-lints=allow
--cfg
intrinsics_enabled
--cfg
optimizations_enabled
--cfg
mem_unaligned
--cfg=feature="arch"
--cfg=feature="compiler-builtins"
--cfg=feature="default"
--cfg=feature="unmangled-names"
--edition=2024
-Cforce-unwind-tables=yes
-Crelocation-model=pic
-Cdefault-linker-libraries
-Zdep-info-omit-d-target
-Zmacro-backtrace
-Zremap-cwd-prefix=.
-Zexternal-clangrt
--color=always
--target=x86_64-unknown-linux-gnu
-Cembed-bitcode=no
-Clto=no
-Cpanic=abort
-Zpanic_abort_tests
--cfg
cr_rustc_revision="110108a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-8a9dd7abdf013ec10cfeaaa3685feba18ef1c90c-1-24-14453-ge063be79"
-Copt-level=3
-Cforce-frame-pointers=yes
-Cdebug-assertions
-Zdefault-visibility=hidden
-Dwarnings
-Ccodegen-units=10000
--sysroot=clang_x64/local_rustc_sysroot
-Ldependency=clang_x64/local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib
-Clink-arg=../../third_party/llvm-build/Release+Asserts/lib/clang/24/lib/x86_64-unknown-linux-gnu/libclang_rt.builtins.a
--extern
core=clang_x64/local_rustc_sysroot/lib/rustlib/x86_64-unknown-linux-gnu/lib/libcore_core.rlib