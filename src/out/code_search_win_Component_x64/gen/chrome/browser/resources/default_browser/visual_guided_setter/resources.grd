<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/visual_guided_setter_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/visual_guided_setter_resources_map.cc"
            type="resource_file_map_source" />
    <output filename="grit/visual_guided_setter_resources_map.h"
            type="resource_map_header" />
    <output filename="visual_guided_setter_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_VISUAL_GUIDED_SETTER_VISUAL_GUIDED_SETTER_HTML" file="${root_gen_dir}/chrome/browser/resources/default_browser/visual_guided_setter/preprocessed/visual_guided_setter.html" resource_path="visual_guided_setter.html" use_base_dir="false" type="chrome_html" />
      <include name="IDR_VISUAL_GUIDED_SETTER_VISUAL_GUIDED_SETTER_CSS" file="${root_gen_dir}/chrome/browser/resources/default_browser/visual_guided_setter/preprocessed/visual_guided_setter.css" resource_path="visual_guided_setter.css" use_base_dir="false" type="BINDATA" />
      <include name="IDR_VISUAL_GUIDED_SETTER_VISUAL_GUIDED_SETTER_JS" file="${root_gen_dir}/chrome/browser/resources/default_browser/visual_guided_setter/minified/visual_guided_setter.js" resource_path="visual_guided_setter.js" use_base_dir="false" type="chrome_html" />
      <include name="IDR_VISUAL_GUIDED_SETTER_VISUAL_GUIDED_SETTER_MOJOM_WEBUI_JS" file="${root_gen_dir}/chrome/browser/resources/default_browser/visual_guided_setter/minified/visual_guided_setter.mojom-webui.js" resource_path="visual_guided_setter.mojom-webui.js" use_base_dir="false" type="chrome_html" />
    </includes>
  </release>
</grit>
