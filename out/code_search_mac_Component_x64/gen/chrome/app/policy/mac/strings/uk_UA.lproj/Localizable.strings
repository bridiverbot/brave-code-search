/* brave version: 158.1.101.0 */
Brave.pfm_title = "Brave";
Brave.pfm_description = "Налаштування Brave";
AIModeSettings.pfm_title = "Налаштування для інтеграцій режиму ШІ від Google в адресному рядку й полі пошуку на сторінці нової вкладки.";
AIModeSettings.pfm_description = "0 - Дозволити інтеграції режиму ШІ.\n1 - Заборонити інтеграції режиму ШІ.\nЦе правило керує інтеграціями режиму ШІ від Google в адресному рядку й полі пошуку на сторінці нової вкладки.\n\nЩоб отримати доступ до цієї функції, потрібно вказати Google як пошукову систему за умовчанням.\n\nЯкщо вибрати значення \"0\", функція буде доступна для користувачів.\n\nЯкщо вибрати значення \"1\", вона буде недоступна.\n\nЯкщо не налаштувати це правило, його поведінку визначатиме правило GenAiDefaultSettings.";
AbusiveExperienceInterventionEnforce.pfm_title = "Abusive Experience Intervention Enforce";
AbusiveExperienceInterventionEnforce.pfm_description = "Якщо правило SafeBrowsingEnabled активовано, а AbusiveExperienceInterventionEnforce ввімкнено або не налаштовано, сайти зі зловживаннями не зможуть відкривати нові вікна чи вкладки.\n\nЯкщо правило SafeBrowsingEnabled або AbusiveExperienceInterventionEnforce деактивовано, сайти зі зловживаннями зможуть відкривати нові вікна або вкладки.";
AccessCodeCastDeviceDuration.pfm_title = "Указує, упродовж якого часу (у секундах) пристрій для трансляції, вибраний за допомогою коду доступу або QR-коду, залишається в списку таких пристроїв у меню Google Cast.";
AccessCodeCastDeviceDuration.pfm_description = "Це правило вказує, упродовж якого часу (у секундах) пристрій для трансляції, вибраний за допомогою коду доступу або QR-коду, буде відображатися в списку таких пристроїв у меню Google Cast.\nВідлік починається з моменту введення коду доступу або сканування QR-коду.\nУпродовж заданого періоду пристрій для трансляції показуватиметься в списку меню Google Cast.\nЩоб після його завершення знову скористатися пристроєм для трансляції, потрібно буде ще раз ввести код доступу чи зісканувати QR-код.\nЗа умовчанням період становить 0 секунд, тож пристрої для трансляції не залишатимуться в меню Google Cast і перед кожним сеансом трансляції потрібно буде вводити код доступу чи сканувати QR-код.\nЗверніть увагу, що це правило впливає лише на те, скільки часу пристрої для трансляції відображаються в меню Google Cast, і не поширюється на поточний сеанс (трансляція продовжиться, навіть якщо закінчиться вказаний період).\nЦе правило діє, тільки якщо ввімкнено правило AccessCodeCastEnabled.";
AccessCodeCastEnabled.pfm_title = "Дозволити користувачам вибирати пристрої для трансляції за допомогою коду доступу чи QR-коду в меню Google Cast";
AccessCodeCastEnabled.pfm_description = "Це правило дає змогу вибрати, чи в меню Google Cast буде доступна опція трансляції на пристрої, яких немає в меню Google Cast, за допомогою коду доступу або QR-коду на екрані пристрою для трансляції.\nЗа умовчанням користувач має знову ввести код доступу чи ще раз зісканувати QR-код, щоб розпочати наступний сеанс трансляції. Однак якщо для правила AccessCodeCastDeviceDuration вибрати нестандартне (ненульове) значення, тоді пристрій залишатиметься в списку пристроїв для трансляції, доки не завершиться вказаний період часу.\nЯкщо це правило ввімкнути, користувачі зможуть вибирати пристрої для трансляції за допомогою коду доступу чи QR-коду.\nЯкщо його вимкнути або не налаштувати, користувачі не матимуть такої змоги.";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_title = "Зіставляти заголовок відповіді Access-Control-Allow-Methods у сумісній специфікації попереднього запиту CORS";
AccessControlAllowMethodsInCORSPreflightSpecConformant.pfm_description = "Це правило визначає, чи мають методи запитів писатися великими літерами, якщо вони зіставляються із заголовками відповідей Access-Control-Allow-Methods у попередньому запиті CORS.\n\nЯкщо правило вимкнути, метод запиту писатиметься великими літерами.\nЦе стосується Brave 108 або попередніх версій.\n\nЯкщо правило ввімкнути або не налаштувати, методи запиту не писатимуться великими літерами, окрім випадків, коли вони зіставляються без урахування регістра з методами DELETE, GET, HEAD, OPTIONS, POST або PUT.\nУ такому випадку заголовок відповіді fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: FOO\" відхилятиметься, а заголовок відповіді fetch(url, {method: 'Foo'}) + \"Access-Control-Allow-Methods: Foo\" прийматиметься.\n\nПримітка. Це не вплине на методи запитів \"post\" і \"put\", але вплине на метод запиту \"patch\".\n\nЦе правило тимчасове. У майбутньому його буде вилучено.";
AccessibilityImageLabelsEnabled.pfm_title = "Увімкнути функцію \"Get Image Descriptions from Google\".";
AccessibilityImageLabelsEnabled.pfm_description = "Завдяки спеціальній можливості \"Get Image Descriptions from Google\"\nлюди з вадами зору можуть дізнаватись описи зображень без міток\nв Інтернеті через програму зчитування з екрана. Користувачі\nзможуть отримувати автоматичні описи зображень без міток\nчерез анонімний сервіс Google.\n\nКоли ця функція ввімкнена, вміст зображення надсилається на сервери\nGoogle, які генерують опис. Компанія Google не отримує файли cookie й дані користувачів,\nа також не зберігає та не записує в журнали вміст зображення.\n\nЯкщо ввімкнути це правило, функція\n\"Get Image Descriptions from Google\"\nактивується, але працюватиме лише для користувачів\nпрограми зчитування з екрана або іншої схожої технології.\n\nЯкщо вимкнути його, користувачі не зможуть вмикати\nцю функцію.\n\nЯкщо це правило не налаштовано, користувачі зможуть вмикати цю функцію на власний розсуд.\n";
AdditionalDnsQueryTypesEnabled.pfm_title = "Дозволити DNS-запити для додаткових типів записів DNS";
AdditionalDnsQueryTypesEnabled.pfm_description = "Це правило керує тим, чи може Brave надсилати запити для додаткових типів записів DNS, створюючи незахищені запити DNS. Це правило не впливає на запити DNS, зроблені через захищений DNS-сервер, який завжди може надсилати запити для додаткових типів записів DNS.\n\nЯкщо це правило не налаштувати або вибрати для нього значення Enabled, крім A (тип 1 системи DNS) і AAAA (тип 28 системи DNS), запити можуть надсилатися для таких додаткових записів, як HTTPS (тип 65 системи DNS).\n\nЯкщо для цього правила вибрати значення Disabled, запити можуть надсилатися лише для записів A (тип 1 системи DNS) і/або AAAA (тип 28 системи DNS).\n\nЦе правило тимчасове. Його буде вилучено в майбутніх версіях Brave. Після цього Brave завжди зможе надсилати запити для додаткових типів записів DNS.";
AdsSettingForIntrusiveAdsSites.pfm_title = "Налаштування реклами для сайтів із нав’язливими оголошеннями";
AdsSettingForIntrusiveAdsSites.pfm_description = "1 - Дозволити рекламу на всіх сайтах\n2 - Заборонити рекламу на сайтах із нав'язливими оголошеннями\nЯкщо для правила SafeBrowsingEnabled не вибрано значення False, а для правила AdsSettingForIntrusiveAdsSites вибрано значення 1 або його не налаштовано, то рекламу буде дозволено на всіх сайтах.\n\nЯкщо для цього правила вибрано значення 2, рекламу буде заблоковано на сайтах із нав'язливими оголошеннями.";
AdvancedProtectionAllowed.pfm_title = "Увімкнути додатковий захист для користувачів, які зареєструвались у Програмі додаткового захисту";
AdvancedProtectionAllowed.pfm_description = "Це правило дає змогу вибрати, чи має користувач, який зареєструвався в Програмі додаткового захисту, доступ до функцій посиленої безпеки. Деякі з цих функцій можуть включати обмін даними з Google (наприклад, користувачі Додаткового захисту зможуть надсилати свої завантаження в Google для перевірки на наявність зловмисного програмного забезпечення). Якщо для цього правила вибрано значення true або його не налаштовано, зареєстровані користувачі отримають доступ до функцій посиленої безпеки. Якщо для нього вибрано значення false, користувачі Додаткового захисту матимуть доступ лише до стандартних користувацьких функцій.";
AllHttpAuthSchemesAllowedForOrigins.pfm_title = "Список джерел, які можуть використовувати всі схеми автентифікації за протоколом HTTP";
AllHttpAuthSchemesAllowedForOrigins.pfm_description = "За допомогою налаштувань цього правила можна вказати, які джерела можуть використовувати всі схеми автентифікації за протоколом HTTP, котрі підтримує Brave, незалежно від параметрів правила AuthSchemes.\n\nПочинаючи з версії Brave 161, це правило застосовується лише до джерел цільового сервера й не поширюється на запити автентифікації від проксі-сервера. Щоб дозволити всі схеми автентифікації за протоколом HTTP для проксі-серверів, натомість використовуйте правило AllHttpAuthSchemesAllowedForProxies. До версії 161 проксі-сервери, які відповідають цьому правилу, також можуть використовувати всі схеми автентифікації за протоколом HTTP, якщо не налаштовано правило AllHttpAuthSchemesAllowedForProxies.\n\nШаблон джерела має бути в такому форматі: https://support.google.com/chrome/a?p=url_blocklist_filter_format. У правилі AllHttpAuthSchemesAllowedForOrigins можна вказати до 1000 винятків.\nЗамість компонента хоста можна використовувати символи підстановки (наприклад, \"*:8000\" відповідає всім хостам порту 8000). Щоб включити всі схеми або всі порти, повністю вилучіть цей компонент (наприклад, \"example.com\" відповідає будь-якій схемі й будь-якому порту). Ім’я хоста (наприклад, \"example.com\") також включає його субдомени. Щоб включити лише хост і виключити його субдомени, поставте перед ним крапку (наприклад, \".example.com\"). Щоб включити всі джерела, використовуйте одну зірочку (*).";
AllHttpAuthSchemesAllowedForProxies.pfm_title = "Список проксі-серверів, які можуть використовувати всі схеми автентифікації за протоколом HTTP";
AllHttpAuthSchemesAllowedForProxies.pfm_description = "За допомогою налаштувань цього правила можна вказати, які проксі-сервери можуть використовувати всі схеми автентифікації за протоколом HTTP, котрі підтримує Brave, незалежно від параметрів правила AuthSchemes.\n\nШаблон проксі-сервера має відповідати вимогам до форматування фільтрів чорного списку URL-адрес (https://support.google.com/chrome/a?p=url_blocklist_filter_format). Можна вказати до 1000 винятків.\nЗамість компонента хоста можна використовувати символи підстановки (наприклад, \"*:8080\" відповідає всім проксі-серверам порту 8080). Ім’я хоста (наприклад, \"proxy.example.com\") також включає його субдомени. Щоб включити лише хост і виключити його субдомени, поставте перед ним крапку (наприклад, \".proxy.example.com\").\n\nЯкщо це правило не налаштувати, для автентифікації проксі-сервера підтримуватимуться лише схеми за протоколом HTTP, указані в правилі AuthSchemes (або схеми за умовчанням, якщо правило не налаштовано).";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_title = "Дозволити додавати сторінки із заголовком Cache-Control: no-store у зворотний кеш";
AllowBackForwardCacheForCacheControlNoStorePageEnabled.pfm_description = "Це правило визначає, чи можна зберігати сторінку із заголовком Cache-Control: no-store у зворотному кеші. Веб-сайт, що налаштовує цей заголовок, може не передбачати відновлення сторінки зі зворотного кешу, оскільки після відновлення може показуватися конфіденційна інформація (навіть якщо вона більше не доступна).\n\nЯкщо це правило ввімкнути або не налаштувати, сторінку із заголовком Cache-Control: no-store може бути відновлено зі зворотного кешу за умови, що кеш не було очищено (наприклад, коли на сайті дозволено файли cookie лише за протоколом HTTP).\n\nЯкщо його вимкнути, сторінка із заголовком Cache-Control: no-store не зберігатиметься у зворотному кеші.";
AllowCrossOriginAuthPrompt.pfm_title = "Міждоменні запити автентифікації HTTP";
AllowCrossOriginAuthPrompt.pfm_description = "Якщо ввімкнути це правило, розміщеним на сторінці стороннім зображенням дозволятиметься показувати запити на автентифікацію.\n\nЯкщо вимкнути це правило або не налаштувати його, сторонні зображення не можуть показувати запити на автентифікацію.\n\nЗазвичай це правило вимикають задля захисту від фішингу.";
AllowDeletingBrowserHistory.pfm_title = "Увімкнути видалення історії веб-перегляду та завантажень";
AllowDeletingBrowserHistory.pfm_description = "Якщо ввімкнути це правило або не налаштувати його, історію веб-перегляду й завантажень у Chrome можна буде видаляти. Користувачі не можуть змінити цей параметр.\n\nЯкщо вимкнути це налаштування, історію веб-перегляду й завантажень не можна буде видаляти. Навіть якщо це правило вимкнено, історія веб-перегляду й завантажень не завжди зберігається. Користувачі можуть безпосередньо редагувати чи видаляти файли бази даних історії, а веб-переглядач може будь-коли визначати строк дії чи архівувати будь-які або всі записи історії.";
AllowDinosaurEasterEgg.pfm_title = "Дозволити грати в гру Dinosaur Easter Egg";
AllowDinosaurEasterEgg.pfm_description = "Якщо для цього правила вибрати значення \"правда\", користувачі зможуть грати в гру з динозавром. Якщо для нього вибрати значення \"неправда\", користувачі не зможуть грати в цю гру, коли пристрій не в мережі.\n\nЯкщо це правило не налаштувати, користувачі не зможуть грати в гру на зареєстрованих пристроях із Google Chrome OS, але матимуть таку можливість за інших умов.";
AllowFileSelectionDialogs.pfm_title = "Дозволити виклик діалогових вікон вибору файлу";
AllowFileSelectionDialogs.pfm_description = "Якщо це правило активовано або не налаштовано, Chrome може відображати вікна вибору файлів, а користувачі можуть їх відкривати.\n\nЯкщо це правило деактивовано, з'являтиметься повідомлення, коли користувачі виконуватимуть дії, які викликають вікно вибору файлу (наприклад, імпорт закладок, завантаження файлів, зберігання посилань тощо). Користувач має натиснути кнопку \"Скасувати\" в діалоговому вікні вибору файлу.";
AllowSocketPoolSizeRandomizationForProxies.pfm_title = "Дозволити випадковий вибір розміру пулу сокетів для проксі-серверів";
AllowSocketPoolSizeRandomizationForProxies.pfm_description = "Випадковий вибір розміру пулу сокетів – це механізм безпеки, який не дає зловмисникам використовувати детерміновані обмеження пропускної спроможності для отримання інформації про інші сайти.\nЯкщо зазвичай пул містить 128 сокетів, цей механізм випадковим чином обмежує їх кількість від 128 до 256.\nУ результаті кількість підключень до проксі-сервера може збільшитися вдвічі, однак на практиці вона зростає приблизно в 1,2 разу.\n\nЦе впливає на налаштування, задані в правилах MaxConnectionsPerProxy і MaxConnectionsPerProxyForWebSocket.\nТобто фактичне обмеження може бути вдвічі більшим за значення, указані в цих правилах (хоча зазвичай воно збільшується в 1,2 разу).\n\nЗа умовчанням цей механізм увімкнено для всіх пулів, однак за допомогою цього правила її можна вимкнути спеціально для пулів проксі-серверів.";
AllowWebAuthnWithBrokenTlsCerts.pfm_title = "Дозволити запити на веб-автентифікацію на сайтах, які мають пошкоджені сертифікати TLS.";
AllowWebAuthnWithBrokenTlsCerts.pfm_description = "Якщо це правило ввімкнути, Brave дозволятиме запити на веб-автентифікацію на сайтах, які мають сертифікати TLS із помилками (тобто на сайтах, які вважаються ненадійними).\n\nЯкщо його вимкнути або не налаштувати, такі запити за умовчанням блокуватимуться.";
AllowedDomainsForApps.pfm_title = "Визначити домени, які мають доступ до Google Workspace";
AllowedDomainsForApps.pfm_description = "Якщо налаштувати це правило, у Chrome вмикається функція обмеженого входу в Google Workspace. Користувачі не можуть змінити цей параметр. Вони отримують доступ до інструментів Google лише з облікових записів указаних доменів (для облікових записів Gmail чи Googlemail потрібно додати значення consumer_accounts у список доменів). Це налаштування забороняє користувачам входити в додатковий обліковий запис і зберігати його на керованому пристрої, де потрібна автентифікація Google, якщо цього облікового запису немає в списку дозволених доменів.\n\nЯкщо не налаштувати цей параметр, користувачі матимуть доступ до Google Workspace із будь-якого облікового запису.\n\nКористувачі не можуть змінити або замінити його.\n\nПримітка. Якщо це правило застосовується, до всіх запитів HTTP та HTTPS, що надсилаються в домени google.com, додається заголовок X-GoogApps-Allowed-Domains, як описано на сторінці https://support.google.com/a/answer/1668854.";
AlternateErrorPagesEnabled.pfm_title = "Увімкнути додаткові сторінки з помилками";
AlternateErrorPagesEnabled.pfm_description = "Якщо для цього правила вибрати значення \"правда\", Brave використовуватиме вбудовані альтернативні сторінки з повідомленням про помилку (наприклад, \"Сторінку не знайдено\"). Якщо для нього вибрати значення \"неправда\", Brave ніколи не використовуватиме альтернативні сторінки з повідомленням про помилку.\n\nЯкщо налаштувати це правило, користувачі не зможуть змінювати його. Якщо це правило не налаштувати, воно буде ввімкненим, але користувачі зможуть змінювати його.";
AlternativeBrowserParameters.pfm_title = "Параметри командного рядка для альтернативного веб-переглядача.";
AlternativeBrowserParameters.pfm_description = "Якщо для правила вибрано список сегментів, кожний сегмент передається альтернативному веб-переглядачу як окремий параметр командного рядка. У Microsoft® Windows® параметри поєднані пробілами. У macOS і Linux® параметр може містити пробіли, але все одно вважатись окремим.\n\nЯкщо параметр містить елемент ${url}, ${url} замінюється URL-адресою сторінки, яку потрібно відкрити. Якщо в жодному параметрі немає елемента ${url}, URL-адреса додається в кінці командного рядка.\n\nЗмінні середовища розгорнуті. У Microsoft® Windows® замість %ABC% підставляється значення змінної середовища ABC. У macOS і Linux® замість ${ABC} підставляється значення змінної середовища ABC.\n\nЯкщо це правило не налаштувати, лише URL-адреса передається як параметр командного рядка.";
AlternativeBrowserPath.pfm_title = "Альтернативний веб-переглядач, у якому мають відкриватися налаштовані веб-сайти.";
AlternativeBrowserPath.pfm_description = "Налаштування цього правила визначають, яка команда відкриває URL-адреси в альтернативному веб-переглядачі. У цьому правилі можна вказати ${ie}, ${firefox}, ${safari}, ${opera}, ${edge} або шлях файлу. Якщо для цього правила вказано шлях файлу, такий файл використовується як виконуваний. Веб-переглядач ${ie} доступний лише для Microsoft® Windows®. Веб-переглядачі ${safari} та ${edge} доступні лише для Microsoft® Windows® і macOS.\n\nЯкщо це правило не налаштовано, застосовуються значення за умовчанням для конкретних платформ: Internet Explorer® для Microsoft® Windows® або Safari® для macOS. У Linux® альтернативний веб-переглядач не запускатиметься.";
AlwaysOpenPdfExternally.pfm_title = "Завжди відкривати файли PDF у зовнішньому додатку";
AlwaysOpenPdfExternally.pfm_description = "Якщо ввімкнути це правило, у Brave вимкнеться внутрішній засіб перегляду файлів PDF. Такі файли оброблятимуться як завантаження, і користувачі зможуть відкривати їх у додатку за умовчанням.\n\nЯкщо вимкнути це правило, файли PDF відкриватимуться через внутрішній плагін (за умови, що користувачі його не вимкнуть).\n\nЯкщо налаштувати це правило, користувачі не зможуть змінювати його в Brave. Якщо правило не налаштувати, користувачі зможуть самі вибирати, чи відкривати файли PDF у зовнішньому додатку.";
AmbientAuthenticationInPrivateModesEnabled.pfm_title = "Увімкнути фонову автентифікацію для типів профілів.";
AmbientAuthenticationInPrivateModesEnabled.pfm_description = "0 - Увімкнути фонову автентифікацію лише у звичайному сеансі.\n1 - Увімкнути фонову автентифікацію у звичайному й анонімному сеансах.\n2 - Увімкнути фонову автентифікацію у звичайних і гостьових сеансах.\n3 - Увімкнути фонову автентифікацію у звичайних, анонімних та гостьових сеансах.\nЯкщо налаштувати це правило, у Brave буде ввімкнено/вимкнено фонову автентифікацію для гостьових і анонімних профілів.\n\nФонова автентифікація – це автентифікація HTTP за допомогою облікових даних за умовчанням, якщо конкретні облікові дані не надано через схему виклик-відповідь NTLM, Kerberos або Negotiate.\n\nЯкщо вибрати параметр RegularOnly (значення 0), фонова автентифікація може відбуватися лише у звичайних сеансах. В анонімних і гостьових сеансах вона буде заборонена.\n\nЯкщо вибрати параметр IncognitoAndRegular (значення 1), фонова автентифікація може відбуватись у звичайних і анонімних сеансах. У гостьових сеансах вона буде заборонена.\n\nЯкщо вибрати параметр GuestAndRegular (значення 2), фонова автентифікація може відбуватись у звичайних і гостьових сеансах. В анонімних сеансах вона буде заборонена.\n\nЯкщо вибрати параметр All (значення 3), фонова автентифікація може відбуватися в усіх сеансах.\n\nЗауважте, що вона завжди дозволена у звичайних профілях.\n\nЯкщо це правило не налаштовано у Brave 81 і новіших версій, фонова автентифікація буде ввімкнена лише у звичайних сеансах.";
AudioCaptureAllowed.pfm_title = "Дозволити чи заборонити запис аудіо";
AudioCaptureAllowed.pfm_description = "Якщо для цього правила вибрано значення Enabled або його не налаштовано, користувачі отримуватимуть сповіщення із запитом на дозвіл записувати аудіо всюди, крім сторінок, URL-адреси яких указані в списку AudioCaptureAllowedUrls.\n\nЯкщо для цього правила вибрано значення Disabled, сповіщення буде вимкнено, а записувати аудіо зможуть лише сторінки, URL-адреси яких указані в списку AudioCaptureAllowedUrls.\n\nПримітка: це правило поширюється на всі аудіовходи, а не лише на вбудований мікрофон.";
AudioCaptureAllowedUrls.pfm_title = "URL-адреси, яким завжди надаватиметься доступ до пристроїв запису аудіо";
AudioCaptureAllowedUrls.pfm_description = "Налаштувавши це правило, ви вказуєте список URL-адрес, шаблони яких зіставлятимуться з джерелом безпеки URL-адреси, що надсилає запит. Якщо буде виявлено збіг, сторінка отримає доступ до пристроїв запису аудіо, не надсилаючи сповіщення користувачу.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns/. Однак зверніть увагу, що це правило не підтримує шаблон \"*\", який відповідає будь-якій URL-адресі.";
AudioSandboxEnabled.pfm_title = "Дозволити запуск ізольованого програмного середовища для аудіо";
AudioSandboxEnabled.pfm_description = "Це правило керує обробкою аудіо в режимі ізольованого програмного середовища.\nЯкщо це правило ввімкнено, аудіо оброблятиметься в режимі ізольованого програмного середовища.\nЯкщо це правило вимкнено, аудіо не оброблятиметься в режимі ізольованого програмного середовища, а модуль обробки аудіо WebRTC запускатиметься під час роботи засобу обробки відео.\nЧерез це користувачі можуть зіштовхнутися із загрозами безпеці, пов'язаними з підсистемою аудіо, що обробляється поза режимом ізольованого програмного середовища.\nЯкщо це правило не налаштовано, для ізольованого програмного середовища для аудіо застосовуватимуться параметри за умовчанням, які можуть відрізнятися залежно від платформи.\nЦе правило дає можливість підприємствам вимикати ізольоване програмне середовище для аудіо, якщо вони користуються програмним забезпеченням для захисту, яке конфліктує з ним.";
AuthNegotiateDelegateAllowlist.pfm_title = "Список дозволених серверів, яким можна делегувати права за протоколом Kerberos";
AuthNegotiateDelegateAllowlist.pfm_description = "Налаштування цього правила призначають сервери, яким Brave може передавати дані. Назви серверів потрібно розділяти комами. Дозволяються символи підстановки (*).\n\nЯкщо це правило не налаштовано, Brave не передаватиме облікові дані користувача, навіть якщо сервер виявлено в інтранет-мережі.";
AuthNegotiateDelegateByKdcPolicy.pfm_title = "Використовує правило KDC, щоб делегувати облікові дані.";
AuthNegotiateDelegateByKdcPolicy.pfm_description = "Якщо ввімкнути це правило, під час автентифікації HTTP враховуватиметься схвалення правилом KDC. Тобто Brave передає облікові дані користувачів відкритому сервісу, лише якщо KDC встановлює для квитків сервісу значення OK-AS-DELEGATE. Перегляньте RFC 5896 (https://tools.ietf.org/html/rfc5896.html). Правило AuthNegotiateDelegateAllowlist також має дозволяти цей сервіс.\n\nЯкщо вимкнути або не налаштувати це правило, правило KDC ігноруватиметься на підтримуваних платформах і застосовуватиметься лише правило AuthNegotiateDelegateAllowlist.\n\nУ Microsoft® Windows® правило KDC застосовується завжди.";
AuthSchemes.pfm_title = "Підтримувані схеми автентифікації";
AuthSchemes.pfm_description = "Налаштування цього правила визначають, які схеми автентифікації HTTP підтримує Brave.\n\nЯкщо це правило не налаштовано, застосовуються всі 4 схеми.\n\nДійсні значення:\n\n* basic\n\n* digest\n\n* ntlm\n\n* negotiate\n\nПримітка: значення потрібно розділяти комами.";
AuthServerAllowlist.pfm_title = "Білий список серверів автентифікації";
AuthServerAllowlist.pfm_description = "Налаштування цього правила визначають, які сервери потрібно дозволити для інтегрованої автентифікації. Інтегрована автентифікація вмикається лише тоді, коли Brave отримує виклик автентифікації від проксі-сервера або від сервера зі списку дозволених.\n\nЯкщо це правило не налаштовано, Brave намагатиметься визначити, чи сервер розміщено в інтранет-мережі, і лише тоді відповідатиме на запити IWA. Якщо сервер виявлено в інтернет-мережі, Brave ігноруватиме запити IWA від нього.\n\nПримітка: назви серверів потрібно розділяти комами. Дозволяються символи підстановки (*).";
AutoLaunchProtocolsFromOrigins.pfm_title = "Визначити список протоколів, які можуть запускати зовнішні додатки з указаних джерел без відома користувача";
AutoLaunchProtocolsFromOrigins.pfm_description = "Дає змогу налаштувати список протоколів, а для кожного протоколу – зв’язаний список дозволених шаблонів джерел, які можуть запускати зовнішні додатки без відома користувачів. Після назви протоколу не потрібно додавати роздільник, наприклад указуйте \"skype\", а не \"skype:\" чи \"skype://\".\n\nЯкщо це правило налаштовано, протокол зможе запускати зовнішні додатки без відома користувачів, лише якщо він є в списку, а джерело сайту, який намагається запустити протокол, збігається з одним із шаблонів джерел у списку allowed_origins для цього протоколу. Якщо принаймні одну умову не виконано, правило не дозволить запуск зовнішніх протоколів.\n\nЯкщо це правило не налаштовано, за умовчанням протоколи не можуть запускати додатки без запиту. Користувачі зможуть вимикати сповіщення для окремих протоколів або сайтів (якщо не вимкнено правило ExternalProtocolDialogShowAlwaysOpenCheckbox). Це правило не впливає на винятки для окремих протоколів чи сайтів, які вказали користувачі.\n\nШаблони джерел указуються приблизно в тому самому форматі, що й для чорного списку URLBlocklist (див. https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nПроте вони не можуть містити елементи \"/path\" або \"@query\" (ці шаблони ігноруватимуться).\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=AutoLaunchProtocolsFromOrigins.";
AutoOpenAllowedForURLs.pfm_title = "URL-адреси, де може застосовуватися правило AutoOpenFileTypes";
AutoOpenAllowedForURLs.pfm_description = "Список URL-адрес, до яких застосовується правило AutoOpenFileTypes. Це правило не впливає на параметри автоматичного відкривання файлів, які вказав користувач.\n\nЯкщо це правило налаштовано, файли відкриватимуться автоматично, лише якщо URL-адреса вказана в налаштуваннях, а тип файлу – у правилі AutoOpenFileTypes. Якщо принаймні одну умову не виконано, правило не дозволятиме автоматично відкривати завантажений файл.\n\nЯкщо це правило не налаштовано, усі завантажені файли, типи яких указано в правилі AutoOpenFileTypes, відкриватимуться автоматично.\n\nШаблон URL-адрес має відповідати вимогам до формату: https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
AutoOpenFileTypes.pfm_title = "Список типів файлів, які мають автоматично відкриватися після завантаження";
AutoOpenFileTypes.pfm_description = "Список типів файлів, які мають автоматично відкриватися після завантаження. Назви типів файлів потрібно вказувати без роздільника, наприклад \"txt\" замість \".txt\".\n\nФайли тих типів, які мають автоматично відкриватися, усе одно перевірятимуться функцією \"Безпечний перегляд\", якщо її ввімкнено, і не відкриються, якщо перевірка виявить проблеми.\n\nЯкщо це правило не налаштувати, після завантаження автоматично відкриватимуться лише файли тих типів, які користувач указав раніше.\n\nУ Microsoft® Windows® це правило застосовується лише для екземплярів, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS це правило доступне лише для екземплярів, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.";
AutoSelectCertificateForUrls.pfm_title = "Автоматичний вибір сертифікатів клієнтів для цих сайтів";
AutoSelectCertificateForUrls.pfm_description = "Налаштування цього правила дають змогу створити список шаблонів URL-адрес, що визначають сайти, для яких Chrome може автоматично вибирати сертифікат клієнта. Значення є масивом рядкових словників JSON у форматі { \"pattern\": \"$URL_PATTERN\", \"filter\" : $FILTER }, де $URL_PATTERN – шаблон вебконтенту. Фільтр \"$FILTER\" визначає, які сертифікати клієнта вебпереглядач може вибирати автоматично. Незалежно від фільтра вибираються лише сертифікати, які відповідають запиту сервера. На пристроях Android або iOS вебпереглядач Chrome може вибрати лише сертифікати клієнта, зареєстровані цим сервісом, і не має доступу до сертифікатів, встановлених на рівні операційної системи.\n\nПриклади використання розділу \"$FILTER\".\n\n* Якщо для фільтра \"$FILTER\" вибрано значення { \"ISSUER\": { \"CN\": \"$ISSUER_CN\" } }, вибираються лише сертифікати клієнта, видані центром сертифікації CommonName $ISSUER_CN.\n\n* Якщо фільтр \"$FILTER\" містить розділи \"ISSUER\" і \"SUBJECT\", вибираються лише ті сертифікати клієнта, що задовольняють обидві умови.\n\n* Якщо фільтр \"$FILTER\" містить розділ \"SUBJECT\" зі значенням \"O\", сертифікат має містити принаймні одну організацію, що відповідає вказаному значенню.\n\n* Якщо фільтр \"$FILTER\" містить розділ \"SUBJECT\" зі значенням \"OU\", сертифікат має містити принаймні один організаційний підрозділ, що відповідає вказаному значенню.\n\n* Якщо для фільтра \"$FILTER\" встановлено значення \"{}\", вибір сертифікатів клієнта додатково не обмежується. Зверніть увагу, що фільтри, які надає вебсервер, усе ще застосовуються.\n\nЯкщо це правило не налаштовано, для сайтів не застосовується автоматичний вибір.\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=AutoSelectCertificateForUrls.";
AutofillGenAiSettings.pfm_title = "Налаштування функцій на основі генеративного ШІ для автозаповнення";
AutofillGenAiSettings.pfm_description = "0 - Дозволити використовувати функції на основі генеративного ШІ для автозаповнення й покращувати моделі штучного інтелекту.\n1 - Дозволити використовувати функції на основі генеративного ШІ для автозаповнення без покращення моделей штучного інтелекту.\n2 - Заборонити використовувати функції на основі генеративного ШІ для автозаповнення.\nЦі функції в Brave використовують моделі генеративного штучного інтелекту, щоб допомагати користувачам заповнювати форми в Інтернеті. Щоб використовувати ці функції, Brave має збирати такі дані, як структура форм, з якими взаємодіє користувач, і (для функції \"Знайти й заповнити за допомогою Gemini\") запити у формі довільного тексту, які користувач вводить для пошуку в підключених додатках Gemini, і надсилати їх на сервер Google, який застосовує модель генеративного ШІ.\n\nЯкщо вибрати для цього правила значення 0 (\"Дозволити використовувати функції на основі генеративного ШІ для автозаповнення й покращувати моделі штучного інтелекту\"), пов’язані функції буде ввімкнено, а Google зможе використовувати відповідні дані для покращення моделей штучного інтелекту. Залежно від функції надсилатися можуть запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки. Значення 0 використовується за умовчанням, за винятком наведених нижче випадків.\n\nЯкщо вибрати значення 1 (\"Дозволити використовувати функції на основі генеративного ШІ для автозаповнення без покращення моделей штучного інтелекту\"), пов’язані функції буде ввімкнено, однак контент користувачів (зокрема запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки) не надсилатиметься в Google для покращення моделей штучного інтелекту. Значення 1 застосовується за умовчанням для корпоративних користувачів, обліковими записами яких керують через Google Admin console, і облікових записів закладів освіти, якими керують через Google Workspace.\n\nЯкщо для правила вибрати значення 2 (\"Заборонити використовувати функції на основі генеративного ШІ для автозаповнення\"), пов’язані функції будуть недоступні.\n\nЯкщо не налаштувати це правило, його поведінку визначатиме правило GenAiDefaultSettings.\n\nСписок функцій на основі генеративного ШІ для автозаповнення:\n\n– розумне автозаповнення: використовує ШІ для визначення, класифікації і заповнення більшої кількості полів у формі;\n\n– функція \"Знайти й заповнити за допомогою Gemini\": знаходить інформацію в додатках, які користувач підключив до Gemini, і пропонує її для заповнення як розумні підказки у формі або у відповідь на запит користувача.\n\nЦе правило замінює правило AutofillPredictionSettings, яке застосовується, лише якщо вказане правило не налаштовано. Щоб використовувати функцію \"Знайти й заповнити за допомогою Gemini\", потрібно також увімкнути правило GeminiSettings.\n\nЦе правило не керує функціями автозаповнення, які не використовують генеративний ШІ.\n\nЩоб дізнатися більше про обробку даних для функцій на основі генеративного ШІ, перейдіть на сторінку https://support.google.com/chrome/a?p=generative_ai_settings.";
AutofillSettings.pfm_title = "Блокувати типи даних автозаповнення для певних сайтів";
AutofillSettings.pfm_description = "За допомогою цього правила можна вказати, які типи даних автозаповнення блокуватимуться для певних шаблонів URL-адрес.\n\nПравило має структуру списку словників. Кожен із них має містити наведені нижче поля.\n* url_pattern: шаблон URL-адреси налаштувань контенту для основного фрейму (наприклад, https://[*.]example.com).\n* blocked_types: список рядків із категоріями даних автозаповнення, які потрібно заблокувати.\n\nНижче наведено допустимі значення для параметра blocked_types.\n* contact_info: блокує заповнення й зберігання контактної інформації.\n* payments: блокує заповнення й зберігання кредитних карток і способів оплати.\n* identity_docs: блокує заповнення й зберігання документів, що посвідчують особу (наприклад, паспорта, посвідчення водія, офіційного посвідчення особи державного зразка).\n* travel: блокує заповнення й зберігання інформації про подорожі (зокрема даних бронювання авіаквитків або реєстрації транспортних засобів).\n* shopping: блокує заповнення й зберігання інформації про покупки (щодо онлайн-замовлень, доставки тощо).\n* all: блокує заповнення й зберігання всіх типів даних.\n\nЯкщо тип даних заблоковано для сайту, на ньому не генеруватимуться пропозиції і не з’являтимуться запити на збереження або імпорт нових даних цього типу.\n\nЯкщо URL-адреса відповідає кільком шаблонам у списку, заблоковані типи з усіх відповідних шаблонів об’єднуються. Недійсні шаблони URL-адрес у списку ігноруються.\n\nЯкщо не налаштувати це правило, типи даних автозаповнення не блокуватимуться за доменом.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці:\nhttps://chromeenterprise.google/policies/url-patterns. Підтримується символ підстановки \"*\". Цей шаблон відповідає будь-якій URL-адресі з будь-якою схемою, портом і шляхом.\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=AutofillSettings.";
AutomatedPasswordChangeSettings.pfm_title = "Увімкнення автоматичної зміни пароля";
AutomatedPasswordChangeSettings.pfm_description = "0 - Дозволити використовувати функцію і покращувати моделі ШІ\n1 - Дозволити використовувати функцію без покращення моделей ШІ\n2 - Заборонити використовувати функцію\nЦе правило визначає, чи доступна функція автоматичної зміни пароля в Brave.\n\nЯкщо ввімкнути це правило, користувач зможе запустити процес, під час якого вебпереглядач намагатиметься автоматично змінити його пароль на вебсайті. Цим процесом керує генеративний ШІ. Новий пароль зберігається в менеджері паролів вебпереглядача.\n\n\"0\" – дозволити використовувати функцію і надсилати в Google відповідні дані для покращення моделей штучного інтелекту. Залежно від функції надсилатися можуть запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки. Спеціалісти можуть перевіряти такі матеріали, щоб покращувати моделі штучного інтелекту. Значення \"0\" використовується за умовчанням, за винятком наведених нижче випадків.\n\n\"1\" – дозволити використовувати функцію, але не надсилати в Google контент користувачів (зокрема запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки) для покращення моделей штучного інтелекту. Значення \"1\" використовується за умовчанням для корпоративних користувачів, якими керують за допомогою Консолі адміністратора Google, і облікових записів закладів освіти, якими керують за допомогою Google Workspace.\n\n\"2\" – заборонити використовувати функцію.\n\nЯкщо не налаштувати це правило, його поведінку визначатиме правило GenAiDefaultSettings.\n\nЩоб дізнатися більше про обробку даних для функцій на основі генеративного ШІ, перейдіть на сторінку https://support.google.com/chrome/a?p=generative_ai_settings.";
AutomaticDownloadsAllowedForUrls.pfm_title = "Дозволити автоматичні завантаження на цих сайтах";
AutomaticDownloadsAllowedForUrls.pfm_description = "За допомогою цього правила можна налаштувати список шаблонів URL-адрес сайтів, яким дозволено автоматично завантажувати кілька файлів.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns.\n\nЯкщо URL-адреса відповідає обом правилам (AutomaticDownloadsAllowedForUrls і AutomaticDownloadsBlockedForUrls), перевагу має правило AutomaticDownloadsBlockedForUrls.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultAutomaticDownloadsSetting (за умови, що його налаштовано). Якщо ні, застосовуватимуться особисті налаштування користувачів.";
AutomaticDownloadsBlockedForUrls.pfm_title = "Блокувати автоматичні завантаження на цих сайтах";
AutomaticDownloadsBlockedForUrls.pfm_description = "За допомогою цього правила можна налаштувати список шаблонів URL-адрес сайтів, яким заборонено автоматично завантажувати кілька файлів.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns.\n\nЯкщо URL-адреса відповідає обом правилам (AutomaticDownloadsAllowedForUrls і AutomaticDownloadsBlockedForUrls), перевагу має правило AutomaticDownloadsBlockedForUrls.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultAutomaticDownloadsSetting (за умови, що його налаштовано). Якщо ні, застосовуватимуться особисті налаштування користувачів.";
AutomaticFullscreenAllowedForUrls.pfm_title = "Дозволити автоматичний перехід у повноекранний режим на цих сайтах";
AutomaticFullscreenAllowedForUrls.pfm_description = "З міркувань безпеки API вебсервісу requestFullscreen() потребує виконання жесту користувача (\"тимчасової активації\"), інакше доступ не буде надано. Особисті налаштування користувача дають змогу певним джерелам викликати цей API без попереднього виконання жесту користувача, як описано в розділі https://chromestatus.com/feature/6218822004768768.\n\nЦе правило замінює особисті налаштування користувача й дозволяє джерелам, що відповідають переліченим шаблонам, викликати API без попереднього виконання жесту користувача.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns.\nДозволяються символи підстановки (*).\n\nДжерела, що одночасно відповідають шаблонам правил блокування й дозволу, блокуватимуться.\nДля джерел, які не вказано в правилі чи налаштуваннях користувача, потрібно попередньо виконати жест, щоб викликати цей API.";
AutomaticFullscreenBlockedForUrls.pfm_title = "Блокувати автоматичний перехід у повноекранний режим на цих сайтах";
AutomaticFullscreenBlockedForUrls.pfm_description = "З міркувань безпеки API вебсервісу requestFullscreen() потребує виконання жесту користувача (\"тимчасової активації\"), інакше доступ не буде надано. Особисті налаштування користувача дають змогу певним джерелам викликати цей API без попереднього виконання жесту користувача, як описано в розділі https://chromestatus.com/feature/6218822004768768.\n\nЦе правило замінює особисті налаштування користувача й блокує запити з джерел, що відповідають переліченим шаблонам, до API без попереднього виконання жесту користувача.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns.\nДозволяються символи підстановки (*).\n\nДжерела, що одночасно відповідають шаблонам правил блокування й дозволу, блокуватимуться.\nДля джерел, які не вказано в правилі чи налаштуваннях користувача,\nпотрібно попередньо виконати жест, щоб викликати цей API.";
AutoplayAllowed.pfm_title = "Дозволити автоматичне відтворення медіафайлів";
AutoplayAllowed.pfm_description = "Якщо для цього правила вибрати значення \"правда\", Brave зможе автоматично відтворювати медіа. Якщо вибрати для нього значення \"неправда\", Brave не зможе цього робити.\n\nЯкщо не налаштувати це правило, Brave не відтворюватиме медіа автоматично. Щоб змінити це налаштування, для деяких шаблонів URL-адрес можна використовувати правило AutoplayAllowlist.\n\nЗміни до цього правила, внесені, коли вебпереглядач Brave запущений, застосовуються лише до нових вкладок.";
AutoplayAllowlist.pfm_title = "Дозволити автоматично відтворювати медіафайли з білого списку шаблонів URL-адрес";
AutoplayAllowlist.pfm_description = "Налаштування цього правила дають змогу автоматично відтворювати відео (без згоди користувача) зі звуком у Brave. Якщо для AutoplayAllowed вибрано значення \"істина\", це правило не діє. Якщо для AutoplayAllowed вибрано значення \"хиба\", усі шаблони URL-адрес, налаштовані в цьому правилі, можуть відтворювати медіа. Зміни до цього правила, внесені, коли вебпереглядач Brave запущений, застосовуються лише до нових вкладок.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns/.";
BackgroundTabFreezingEnabled.pfm_title = "Увімкнути зависання фонових вкладок";
BackgroundTabFreezingEnabled.pfm_description = "Це правило визначає, чи може Brave призупиняти неактивні фонові вкладки, щоб заощаджувати ресурси ЦП й пам’ять.\n\nЯкщо ввімкнути цю функцію, роботу вкладок, які певний час були неактивними у фоновому режимі, буде зупинено. Також зупиняється виконання завдань щодо коду JavaScript і таймера. Призупинені вкладки залишаються завантаженими в пам’ять і миттєво відновлюють роботу, коли користувач переходить на них. Вкладки з активними фоновими завданнями (наприклад, ті, де відтворюється аудіо чи відео, записується екран або відео з камери, підтримуються активні з’єднання WebRTC або утримуються блокування Web Locks) не можна призупинити, і вони продовжують роботу. Сайти, налаштовані в правилі TabDiscardingExceptions або у винятках користувача, також не призупиняються.\n\nЯкщо ввімкнути це правило, автоматичне призупинення фонових вкладок активується для вкладок, які відповідають вимогам. Користувачі не можуть змінити це налаштування.\n\nЯкщо вимкнути це правило, робота фонових вкладок не призупинятиметься. Користувачі не можуть змінити це налаштування.\n\nЯкщо це правило не налаштувати, фонові вкладки за умовчанням призупинятимуться, однак користувачі зможуть увімкнути або вимкнути цю функцію в налаштуваннях Brave.";
BasicAuthOverHttpEnabled.pfm_title = "Дозволити автентифікацію Basic для з'єднань HTTP";
BasicAuthOverHttpEnabled.pfm_description = "Якщо це правило ввімкнено або не налаштовано, запити на автентифікацію Basic, отримані через незахищене з'єднання HTTP, буде дозволено.\n\nЯкщо це правило вимкнено, незахищені запити HTTP не можуть використовувати схему автентифікації Basic; дозволяється лише захищене з'єднання HTTPS.\n\nЯкщо встановлено правило AuthSchemes і воно не містить Basic, це налаштування правила не застосовується (а Basic завжди заборонятиметься).";
BatterySaverModeAvailability.pfm_title = "Увімкнути режим енергозбереження";
BatterySaverModeAvailability.pfm_description = "0 - Режим енергозбереження буде вимкнено.\n1 - Режим енергозбереження вмикатиметься, коли пристрій працює від акумулятора й рівень його заряду низький.\n2 - Починаючи з версії M121, це значення більше не підтримуватиметься. Натомість воно розпізнаватиметься як EnabledBelowThreshold.\nЦе правило вмикає й вимикає режим енергозбереження.\nУ Chrome цей режим обмежує пропускну спроможність частоти кадрів, щоб зменшити енергоспоживання. Якщо правило не налаштовано, кінцевий користувач може керувати параметрами режиму на сторінці chrome://settings/performance.\nУ ChromeOS цей режим обмежує пропускну спроможність частоти кадрів і частоту ЦП, затемнює підсвічування й переводить пристрій Android у режим енергозбереження. Якщо пристрій має кілька ЦП, деякі з них буде вимкнено.\nНижче наведено різні рівні.\nDisabled (0): режим енергозбереження буде вимкнено.\nEnabledBelowThreshold (1): режим енергозбереження вмикатиметься, коли пристрій працює від акумулятора й рівень його заряду низький.\nEnabledOnBattery (2): починаючи з версії M121, це значення більше не підтримується. Натомість воно розпізнаватиметься як EnabledBelowThreshold.\n";
BlockExternalExtensions.pfm_title = "Встановлення зовнішніх розширень заблоковано";
BlockExternalExtensions.pfm_description = "Це правило визначає, чи можна встановлювати зовнішні розширення.\n\nЯкщо ввімкнути це правило, зовнішні розширення не можна буде встановлювати.\n\nЯкщо вимкнути або не налаштувати його, зовнішні розширення можна буде встановлювати.\n\nДокументацію про зовнішні розширення і їх встановлення можна переглянути на сторінці https://developer.chrome.com/docs/extensions/how-to/distribute/install-extensions.\n\nПримітка. Це правило застосовується лише до платформ, які підтримують розширення.";
BlockThirdPartyCookies.pfm_title = "Блокувати файли cookie третьої сторони";
BlockThirdPartyCookies.pfm_description = "Якщо ввімкнути це правило, елементи вебсторінок за межами домену, указаного в адресному рядку вебпереглядача, не зможуть встановлювати файли cookie. Якщо вимкнути це правило, такі елементи зможуть встановлювати файли cookie, а користувачі не матимуть можливості змінити цей параметр.\n\nЯкщо це правило не налаштувати, сторонні файли cookie не блокуватимуться, але користувачі зможуть змінити цей параметр.\n\nПримітка. Це правило не застосовується в анонімному режимі, де сторонні файли cookie блокуються і їх можна дозволити лише на рівні сайту. Щоб дозволити файли cookie на рівні сайту, скористайтеся правилом CookiesAllowedForUrls.";
BookmarkBarEnabled.pfm_title = "Увімкнути панель закладок";
BookmarkBarEnabled.pfm_description = "Якщо для цього правила вибрано значення True, у Brave відображатиметься панель закладок. Якщо для нього вибрано значення False, користувачі не бачитимуть панель закладок.\n\nЯкщо це правило налаштовано, користувачі не зможуть змінювати його. Якщо це правило не налаштовано, користувачі самі вирішують, чи вмикати цю функцію.";
BraveAIChatEnabled.pfm_title = "Enable AI Chat";
BraveAIChatEnabled.pfm_description = "Enable AI Chat in Brave.\n\nThe smart AI assistant built right into your browser. Ask questions, summarize pages, create new content, and more. Privately.\n\nIf this policy is set to true, AI Chat will always be enabled.\n\nIf this policy is set to false, AI Chat will always be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, AI Chat will be enabled by default.";
BraveDeAmpEnabled.pfm_title = "Control De-AMP feature to bypass Google-hosted AMP pages.";
BraveDeAmpEnabled.pfm_description = "De-AMP allows Brave users to bypass Google-hosted AMP pages and instead visit the content's publisher directly. This protects users' privacy, security and internet experience by preventing tracking and profiling users through AMP.\n\nIf this policy is set to true, De-AMP will be enabled to redirect users away from AMP pages to the original publisher's content.\n\nIf this policy is set to false, De-AMP will be disabled and users may visit AMP pages as served by Google.\n\nIf this policy is left unset, De-AMP will be controlled by the user setting (enabled by default).";
BraveDebouncingEnabled.pfm_title = "Control debouncing feature to protect against bounce tracking.";
BraveDebouncingEnabled.pfm_description = "Debouncing protects users against bounce tracking by recognizing when the user is about to visit a known tracking domain, skipping the tracking site altogether, and instead directly navigating the user to their intended destination. This prevents trackers from circumventing third-party storage restrictions by injecting intermediate tracking sites between the user and their intended destination.\n\nIf this policy is set to true, debouncing will be enabled to protect users from bounce tracking by redirecting them directly to their intended destinations.\n\nIf this policy is set to false, debouncing will be disabled and users may be subject to bounce tracking techniques.\n\nIf this policy is left unset, debouncing will be controlled by the user setting (enabled by default).";
BraveGlobalPrivacyControlEnabled.pfm_title = "Configure Global Privacy Control";
BraveGlobalPrivacyControlEnabled.pfm_description = "Global Privacy Control allows users to signal privacy preferences to websites, such as not wanting their personal information to be sold or shared by businesses. When enabled, GPC sends a Sec-GPC request header and exposes the navigator.globalPrivacyControl JavaScript API.\n\nIf this policy is set to true, Global Privacy Control will be enabled.\n\nIf this policy is set to false, Global Privacy Control will be disabled.\n\nIf this policy is left unset, Global Privacy Control will be enabled by default.";
BraveLocalAIEnabled.pfm_title = "Enable Local AI";
BraveLocalAIEnabled.pfm_description = "Master switch for Brave's local AI features (history embeddings and any future on-device AI surfaces).\n\nWhen this policy is set to true, the local AI feature surfaces (the Semantic history search toggle in brave://settings/privacy, the brave-history-embeddings chrome://flags entry, the EmbeddingGemma model component install, etc.) become available to the user.\n\nWhen this policy is set to false, every local AI surface is hidden and the on-device AI components are not installed.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, local AI is enabled by default.";
BraveNewsDisabled.pfm_title = "Disable Brave News";
BraveNewsDisabled.pfm_description = "Disable Brave News in Brave.\n\nBrave News is a feature that allows users to view curated news content from various sources in a private feed on the new tab page.\n\nIf this policy is set to true, Brave News will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave News will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave News will be enabled by default (subject to user preferences).";
BraveP3AEnabled.pfm_title = "Enable Privacy Preserving Product Analytics (P3A)";
BraveP3AEnabled.pfm_description = "Enable Privacy Preserving Product Analytics in Brave.\n\nPrivacy Preserving Product Analytics (P3A) is an opt-in feature that helps Brave estimate (using private and non-identifying responses) the overall usage of certain features and make them better for users.\n\nIf this policy is set to true, P3A will be enabled.\n\nIf this policy is set to false, P3A will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, P3A will be enabled by default (subject to user preferences).";
BravePlaylistEnabled.pfm_title = "Enable Brave Playlist";
BravePlaylistEnabled.pfm_description = "Enable Brave Playlist functionality.\n\nBrave Playlist allows users to save videos and audio from web pages to play later offline or in the background.\n\nIf this policy is set to true, Playlist will be enabled and all related UI elements will be shown.\n\nIf this policy is set to false, Playlist will be disabled.\n\nIf this policy is unset, Playlist will be enabled by default and users can choose to disable it.\n\nIf you set this policy, users cannot change or override it.";
BraveReduceLanguageEnabled.pfm_title = "Prevent sites from fingerprinting based on language preferences.";
BraveReduceLanguageEnabled.pfm_description = "Reduces how much web sites can learn about the user's language preferences\n\nIf this policy is set to true, language preferences fingerprinting protection will be enabled.\n\nIf this policy is set to false, language preferences fingerprinting protection will be disabled.\n\nIf this policy is left unset, language preferences fingerprinting protection will be controlled by the user setting (enabled by default).";
BraveRewardsDisabled.pfm_title = "Disable Brave Rewards";
BraveRewardsDisabled.pfm_description = "Disable Brave Rewards in Brave.\n\nBrave Rewards is a feature that allows users to get paid for ads they see in Brave and send contributions to their favorite websites and content creators.\n\nIf this policy is set to true, Brave Rewards will always be disabled.\n\nIf this policy is set to false, Brave Rewards will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Rewards will be enabled by default.";
BraveShieldsDisabledForUrls.pfm_title = "Disable Brave Shields for URLs";
BraveShieldsDisabledForUrls.pfm_description = "Forces the shields in Brave to be disabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveShieldsEnabledForUrls.pfm_title = "Enable Brave Shields for URLs";
BraveShieldsEnabledForUrls.pfm_description = "Forces the shields in Brave to be enabled for specific web sites.\n\nYou can use special syntax to wildcard a domain.";
BraveSpeedreaderEnabled.pfm_title = "Enable Speedreader";
BraveSpeedreaderEnabled.pfm_description = "Enable Speedreader in Brave.\n\nSpeedreader is a feature that provides a clutter-free reading experience by automatically cleaning up articles and simplifying page layouts.\n\nIf this policy is set to true, Speedreader will always be enabled.\n\nIf this policy is set to false, Speedreader will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Speedreader will be enabled by default (subject to user preferences).";
BraveStatsPingEnabled.pfm_title = "Enable Stats Usage Ping";
BraveStatsPingEnabled.pfm_description = "Enable anonymous stats usage ping in Brave.\n\nThe anonymous stats usage ping is an opt-in feature that helps Brave estimate active user totals.\n\nIf this policy is set to true, the usage ping will be enabled.\n\nIf this policy is set to false, the usage ping will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, the usage ping will be enabled by default (subject to user preferences).";
BraveSyncUrl.pfm_title = "Specify Brave Sync server URL";
BraveSyncUrl.pfm_description = "Specify the URL for Brave to use with its sync service.\n\nIf this policy is set to a non empty string, that string will be used as the URL with Brave Sync.\nIf this policy is not set, the URL will default to Brave's sync server URL.\nThe provided URL must use the `https` scheme.";
BraveTalkDisabled.pfm_title = "Disable Brave Talk";
BraveTalkDisabled.pfm_description = "Disable Brave Talk in Brave.\n\nBrave Talk is a feature that allows users to start private video calls with friends and colleagues directly from the browser.\n\nIf this policy is set to true, Brave Talk will always be disabled and all related UI elements will be hidden.\n\nIf this policy is set to false, Brave Talk will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Talk will be enabled by default (subject to user preferences).";
BraveTrackingQueryParametersFilteringEnabled.pfm_title = "Control tracking query parameters filtering";
BraveTrackingQueryParametersFilteringEnabled.pfm_description = "This policy controls whether Brave automatically strips known tracking query parameters from URLs when Brave Shields is enabled. It has no affect when Brave Shields are disabled.\n\nIf this policy is set to true, known tracking query parameters will be filtered when Brave Shields is enabled.\n\nIf this policy is set to false, known tracking query parameters will not be filtered.\n\nIf this policy is left unset, known tracking query parameters will be filtered when Brave Shields is enabled.";
BraveVPNDisabled.pfm_title = "Disable Brave VPN";
BraveVPNDisabled.pfm_description = "Disable Brave VPN in Brave.\n\nAllows users to use Brave VPN to block trackers and encrypt every connection to the Web, on every app, even outside the Brave browser.\n\nIf this policy is set to true, Brave VPN will always be disabled.\n\nIf this policy is set to false, Brave VPN will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave VPN will be enabled by default.";
BraveWalletDisabled.pfm_title = "Disable Brave Wallet";
BraveWalletDisabled.pfm_description = "Disable Brave Wallet in Brave.\n\nThe secure, built-in crypto wallet that supercharges your browser for Web3. Get the security you trust from Brave without the hassle and risks of third-party extensions. Manage tokens, swap, bridge, and connect to decentralized applications. Supports Ethereum+EVM, Bitcoin, Solana, Filecoin, and Zcash. Get all the features of leading browser wallets in one secure and convenient place.\n\nIf this policy is set to true, Brave Wallet will always be disabled.\n\nIf this policy is set to false, Brave Wallet will always be enabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Brave Wallet will be enabled by default.";
BraveWaybackMachineEnabled.pfm_title = "Enable Wayback Machine Integration";
BraveWaybackMachineEnabled.pfm_description = "Enable Wayback Machine integration in Brave.\n\nWayback Machine integration is a feature that provides access to archived versions of web pages when encountering 404 errors or other unavailable content.\n\nIf this policy is set to true, Wayback Machine integration will always be enabled.\n\nIf this policy is set to false, Wayback Machine integration will always be disabled and all related UI elements (including the URL bar icon and settings) will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Wayback Machine integration will be enabled by default (subject to user preferences).";
BraveWebDiscoveryEnabled.pfm_title = "Enable Web Discovery";
BraveWebDiscoveryEnabled.pfm_description = "Enable Web Discovery in Brave.\n\nWeb Discovery is an opt-in feature that helps improve Brave's search index in a privacy-preserving way.\n\nIf this policy is set to true, Web Discovery will always be enabled.\n\nIf this policy is set to false, Web Discovery will be disabled.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Web Discovery will be disabled by default (subject to user preferences).";
BrowserAddPersonEnabled.pfm_title = "Додавати користувачів у диспетчері користувачів";
BrowserAddPersonEnabled.pfm_description = "Якщо правило не налаштувати або вибрати для нього значення true, у Brave і Lacros можна буде додавати нових користувачів через диспетчер користувачів.\n\nЯкщо вибрати значення false, цього не можна буде робити в Brave і Lacros.";
BrowserGuestModeEnabled.pfm_title = "Увімкнути режим гостя у веб-переглядачі";
BrowserGuestModeEnabled.pfm_description = "Якщо це правило ввімкнути або не налаштувати, у Brave буде ввімкнено вхід у режимі гостя. Увійшовши в режимі гостя, користувач бачить усі вікна в Brave в анонімному режимі.\n\nЯкщо вимкнути це правило, у Brave буде заборонений запуск профілів гостя.";
BrowserGuestModeEnforced.pfm_title = "Примусово вмикати режим гостя у веб-переглядачі";
BrowserGuestModeEnforced.pfm_description = "Якщо це правило ввімкнено, Brave примусово активовує сеанси в режимі \"Гість\" і не дозволяє входити в профіль. Вхід у режимі \"Гість\" у Brave відбувається у вікнах у режимі анонімного перегляду.\n\nЯкщо це правило вимкнено чи не налаштовано або якщо режим \"Гість\" у веб-переглядачі вимкнено (за допомогою правила BrowserGuestModeEnabled), користувачі зможуть входити в нові й наявні профілі.";
BrowserLabsEnabled.pfm_title = "Значок експериментальних функцій веб-переглядача на панелі інструментів";
BrowserLabsEnabled.pfm_description = "Якщо ввімкнути або не налаштувати це правило, користувачі матимуть доступ до експериментальних функцій веб-переглядача через значок на панелі інструментів.\n\nЯкщо вимкнути це правило, з панелі інструментів видаляється значок експериментальних функцій.\n\nВибране для правила значення не впливає на chrome://flags та інші способи ввімкнення й вимкнення функцій веб-переглядача.";
BrowserNetworkTimeQueriesEnabled.pfm_title = "Дозволити запити в службу часу Google";
BrowserNetworkTimeQueriesEnabled.pfm_description = "Якщо це правило ввімкнено або не налаштовано, Brave час від часу надсилатиме на сервер Google запити, щоб отримати точну позначку часу.\n\nЯкщо це правило вимкнено, Brave не надсилатиме таких запитів.";
BrowserSignin.pfm_title = "Налаштування входу в обліковий запис у веб-переглядачі";
BrowserSignin.pfm_description = "0 - Вимкнути вхід в обліковий запис у веб-переглядачі\n1 - Увімкнути вхід в обліковий запис у веб-переглядачі\n2 - Примусовий вхід в обліковий запис у веб-переглядачі\nЦе правило дає змогу керувати входом в обліковий запис у вебпереглядачі. Воно визначає, чи можуть користувачі входити в Brave за допомогою облікового запису й використовувати пов’язані з ним функції, як-от синхронізацію Brave.\n\nЯкщо вибрати значення \"Вимкнути вхід в обліковий запис у вебпереглядачі\", користувачі не зможуть входити в обліковий запис і користуватися відповідними сервісами, а також певними функціями вебпереглядача, наприклад синхронізацією Brave. Якщо вимкнути правило для iOS, користувачі, які ввійшли в обліковий запис, негайно вийдуть із нього. На інших платформах вихід буде виконано під час наступного запуску Brave. На всіх платформах локальні дані профілю, наприклад закладки, паролі тощо, залишаться й ними можна буде користуватися. Користувачі все одно зможуть входити у вебсервіси Google (наприклад, Gmail) і користуватися ними.\n\nЯкщо вибрати значення \"Увімкнути вхід в обліковий запис у вебпереглядачі\", користувачі зможуть виконувати цю дію. На всіх платформах, крім iOS, користувачі автоматично входитимуть в обліковий запис у вебпереглядачі під час входу у вебсервіси Google, як-от Gmail. Якщо користувач увійшов в обліковий запис, дані облікового запису зберігаються у вебпереглядачі. Однак синхронізація Brave не вмикається за умовчанням. Користувачам потрібно зробити це самостійно. Якщо ввімкнути це правило, користувачі не зможуть його вимкнути. Щоб керувати доступністю синхронізації Brave, скористайтеся правилом SyncDisabled.\n\nЯкщо вибрати значення \"Примусовий вхід в обліковий запис у вебпереглядачі\", на екрані з’являтиметься вікно з пропозицією вибрати обліковий запис і ввійти в нього, щоб користуватися вебпереглядачем. Цей варіант підходить для керованих облікових записів, оскільки забезпечує застосування правил, пов’язаних з окремими обліковими записами. Правило BrowserGuestModeEnabled за умовчанням буде вимкнено. Зверніть увагу, що після ввімкнення цього правила наявні профілі, у які не виконано вхід, буде заблоковано. Докладніше читайте в цій довідковій статті: https://support.google.com/chrome/?p=force_browser_signin. Опція примусового входу не підтримується для Google Chrome OS і Android. Якщо вибрати її, натомість застосовуватиметься опція \"Увімкнути вхід в обліковий запис у вебпереглядачі\".\n\nЯкщо це правило не налаштувати, користувачі зможуть самостійно вмикати або вимикати опцію входу в обліковий запис у налаштуваннях Brave.";
BrowserSwitcherDelay.pfm_title = "Затримка перед запуском альтернативного веб-переглядача (мілісекунди)";
BrowserSwitcherDelay.pfm_description = "Якщо для правила вказано числове значення, Brave показує повідомлення протягом зазначеної кількості мілісекунд, а тоді відкриває альтернативний веб-переглядач.\n\nЯкщо це правило не налаштовано або для нього вибрано значення 0, визначена URL-адреса одразу ж відкриватиметься в альтернативному веб-переглядачі.";
BrowserSwitcherEnabled.pfm_title = "Увімкнути функцію підтримки застарілих веб-переглядачів.";
BrowserSwitcherEnabled.pfm_description = "Якщо це правило активовано, Brave намагатиметься відкривати деякі URL-адреси в альтернативному веб-переглядачі, наприклад Internet Explorer®. Цю функцію можна налаштувати за допомогою правил у групі \"Legacy Browser support\".\n\nЯкщо це правило вимкнено або не налаштовано, Brave не намагатиметься запускати визначені URL-адреси в альтернативному веб-переглядачі.";
BrowserSwitcherExternalGreylistUrl.pfm_title = "URL-адреса файлу XML, який містить URL-адреси, що ніколи не ініціюють перехід в інший веб-переглядач.";
BrowserSwitcherExternalGreylistUrl.pfm_description = "Якщо для цього правила встановлено дійсну URL-адресу, Brave завантажує список сайтів за цією URL-адресою та застосовує правила так, наче їх налаштовано за допомогою правила BrowserSwitcherUrlGreylist. Ці правила забороняють Brave та альтернативному веб-переглядачу відкривати один одного.\n\nЯкщо це правило не налаштовано (або для нього вказано недійсну URL-адресу), Brave не використовує його як джерело для правил, що не ініціюють перехід в інший веб-переглядач.\n\nПримітка: це правило вказує на файл XML у тому ж форматі, що й правило SiteList в Internet Explorer®. Воно завантажує правила з файлу XML, не надсилаючи їх в Internet Explorer®. Докладніше про правило SiteList в Internet Explorer® читайте на сторінці https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherExternalSitelistUrl.pfm_title = "URL-адреса файлу XML, який містить URL-адреси для завантаження в альтернативному веб-переглядачі.";
BrowserSwitcherExternalSitelistUrl.pfm_description = "Якщо для цього правила вказано дійсну URL-адресу, Brave завантажує список сайтів за цією URL-адресою та застосовує правила так, наче їх налаштовано за допомогою правила BrowserSwitcherUrlList.\n\nЯкщо це правило не налаштовано (або для нього вказано недійсну URL-адресу), Brave не використовує його як джерело для правил, що ініціюють перехід в інший веб-переглядач.\n\nПримітка: це правило вказує на файл XML у тому ж форматі, що й правило SiteList в Internet Explorer®. Воно завантажує правила з файлу XML, не надсилаючи їх в Internet Explorer®. Докладніше про правило SiteList в Internet Explorer® читайте на сторінці https://docs.microsoft.com/internet-explorer/ie11-deploy-guide/what-is-enterprise-mode";
BrowserSwitcherKeepLastChromeTab.pfm_title = "Залишити останню вкладку відкритою в Chrome.";
BrowserSwitcherKeepLastChromeTab.pfm_description = "Якщо це правило ввімкнути або не налаштувати, Brave залишає відкритою принаймні одну вкладку після переходу на альтернативний веб-переглядач.\n\nЯкщо це правило вимкнути, Brave закриває вкладку після переходу на альтернативний веб-переглядач, навіть якщо це була остання вкладка. Після цього Brave повністю закриється.";
BrowserSwitcherParsingMode.pfm_title = "Режим синтаксичного аналізу списку сайтів";
BrowserSwitcherParsingMode.pfm_description = "0 - Поведінка за умовчанням для підтримки застарілих веб-переглядачів.\n1 - Більша сумісність зі списками сайтів у корпоративному режимі Microsoft IE / Edge.\nЦе правило вказує, як Google Chrome інтерпретує правила для списків сайтів або сірих списків для функції \"Підтримка застарілих веб-переглядачів\". Воно поширюється на такі правила: BrowserSwitcherUrlList, BrowserSwitcherUrlGreylist, BrowserSwitcherUseIeSitelist, BrowserSwitcherExternalSitelistUrl і BrowserSwitcherExternalGreylistUrl.\n\nЯкщо вибрати значення Default (0) або не налаштувати це правило, зіставлення URL-адрес може бути менш точним. Для правил без символу \"/\" підрядок може знаходитись у будь-якій частині імені хосту URL-адреси. Для зіставлення компонента шляху в URL-адресі враховується регістр.\n\nЯкщо вибрати значення IESiteListMode (1), застосовуються суворіші умови зіставлення URL-адрес. Для правил без символу \"/\" підрядок може знаходитися лише в кінці імені хосту. Крім того, підрядки мають бути на межі доменного імені. Для збігів компонента шляху в URL-адресі регістр не враховується. Таке налаштування більш сумісне з правилами Microsoft® Internet Explorer® і Microsoft® Edge®.\n\nНаприклад, якщо для правила вказано підрядки \"example.com\" і \"acme.com/abc\":\n\nадреси \"http://example.com/\", \"http://subdomain.example.com/\" і \"http://acme.com/abc\" збігатимуться з правилом незалежно від режиму синтаксичного аналізу;\n\n\"http://notexample.com/\", \"http://example.com.invalid.com/\" і \"http://example.comabc/\" збігатимуться лише в режимі Default;\n\n\"http://acme.com/ABC\" збігатиметься лише в режимі IESiteListMode.";
BrowserSwitcherUrlGreylist.pfm_title = "Веб-сайти, які ніколи не повинні активувати перехід в інший веб-переглядач.";
BrowserSwitcherUrlGreylist.pfm_description = "Налаштування цього правила керують списком веб-сайтів, які ніколи не ініціюють перехід в інший веб-переглядач. Кожний елемент вважається правилом. Правила, які збігаються, не відкриватимуть альтернативний веб-переглядач. На відміну від BrowserSwitcherUrlList, правила застосовуються в обох напрямках. Якщо доповнення Internet Explorer® увімкнено, воно також визначає, чи Internet Explorer® відкриватиме ці URL-адреси в Brave.\n\nЯкщо це правило не налаштовано, у список не додається жодний веб-сайт.\n\nПримітка: елементи в цей список можна також додавати за допомогою правила BrowserSwitcherExternalGreylistUrl.";
BrowserSwitcherUrlList.pfm_title = "Веб-сайти, які мають відкриватися в альтернативному веб-переглядачі";
BrowserSwitcherUrlList.pfm_description = "Налаштування цього правила визначають список веб-сайтів, які відкриваються в альтернативному веб-переглядачі. Кожний елемент вважається правилом для контенту, який потрібно відкрити в альтернативному веб-переглядачі. За допомогою цих правил Brave визначає, чи URL-адреса має відкриватися в альтернативному веб-переглядачі. Якщо доповнення Internet Explorer® увімкнено, Internet Explorer® перемикається на Brave, коли правила не збігаються. Якщо правила конфліктують, Brave використовує те, яке підходить найбільше.\n\nЯкщо це правило не налаштовано, у список не додається жодний веб-сайт.\n\nПримітка: елементи в цей список можна також додати через правила BrowserSwitcherUseIeSitelist та BrowserSwitcherExternalSitelistUrl.";
BrowserThemeColor.pfm_title = "Налаштувати колір теми веб-переглядача";
BrowserThemeColor.pfm_description = "Це правило дає змогу адміністраторам налаштувати колір теми в Brave. Як вхідне значення потрібно задати дійсний шістнадцятковий код кольору, що відповідає формату \"#RRGGBB\".\n\nНа основі вказаного кольору автоматично створюється тема й застосовується до веб-переглядача. Користувачі не зможуть змінювати визначену правилом тему.\n\nЯкщо це правило не налаштувати, користувачі зможуть вибирати тему для веб-переглядача.";
BrowsingDataLifetime.pfm_title = "Налаштування періоду збереження даних веб-перегляду";
BrowsingDataLifetime.pfm_description = "Це правило дає змогу налаштувати період збереження даних вебперегляду для Brave. За його допомогою адміністратори можуть указати, коли вебпереглядач має видаляти дані (різних типів). Це корисно для клієнтів, які працюють із чутливою інформацією.\n\nПопередження. Це правило може впливати на локальні персональні дані й назавжди видаляти їх. Щоб запобігти випадковому видаленню персональних даних, рекомендуємо перевірити налаштування, перш ніж вводити їх у дію.\n\nДоступні типи даних: 'browsing_history', 'download_history', 'cookies_and_other_site_data', 'cached_images_and_files', 'password_signin', 'autofill', 'site_settings' і 'hosted_app_data'. 'download_history' і 'hosted_app_data' не підтримуються на пристроях Android.\n\nВебпереглядач автоматично видалятиме вибрані типи даних, які зберігаються довше, ніж указано в параметрі 'time_to_live_in_hours'. Мінімальне можливе значення – 1 година.\n\nДані, період збереження яких закінчився, видалятимуться через 15 секунд після запуску вебпереглядача, а потім – кожні 30 хвилин, поки він працює.\n\nПісля видалення файлів cookie користувач залишиться в обліковому записі Google.\n\nУ Chrome 114 і старіших версіях це правило діє, якщо для правила SyncDisabled указано значення \"істина\". Починаючи з версії Chrome 115, це правило деактивуватиме синхронізацію для відповідних типів даних за умови, що функцію Chrome Sync не вимкнено за допомогою правила SyncDisabled і правило BrowserSignin також не вимкнено.\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=BrowsingDataLifetime.";
BuiltInAIAPIsEnabled.pfm_title = "Дозволити сторінкам використовувати вбудовані API ШІ.";
BuiltInAIAPIsEnabled.pfm_description = "Це правило визначає, чи може сторінка використовувати вбудовані API штучного інтелекту (наприклад, LanguageModel API, Summarization API, Writer API і Rewriter API).\n\nЯкщо це правило ввімкнено або не налаштовано, API дозволено використовувати.\n\nЯкщо його вимкнути, під час використання API виникатиме помилка.";
BuiltInDnsClientEnabled.pfm_title = "Використовувати вдубований клієнт DNS";
BuiltInDnsClientEnabled.pfm_description = "Це правило вказує, який набір програмного забезпечення використовується для обміну даними з DNS-сервером (клієнт DNS операційної системи чи вбудований клієнт DNS Brave). Це правило не впливає на те, які DNS-сервери використовуються. Наприклад, якщо операційну систему налаштовано на використання корпоративного DNS-сервера, його також застосовуватиме вбудований клієнт DNS. Воно також не контролює, чи використовується DNS-over-HTTPS. Brave завжди використовуватиме вбудований резолвер для запитів DNS-over-HTTPS. Щоб дізнатися про керування протоколом DNS-over-HTTPS, перегляньте правило DnsOverHttpsMode.\n\nЯкщо це правило ввімкнути або не налаштувати, використовуватиметься вбудований клієнт DNS.\n\nЯкщо вимкнути правило, вбудований клієнт DNS застосовується, лише коли використовується протокол DNS-over-HTTPS.";
CACertificateManagementAllowed.pfm_title = "Дозволити користувачам керувати встановленими сертифікатами центру сертифікації.";
CACertificateManagementAllowed.pfm_description = "0 - Дозволити користувачам керувати всіма сертифікатами\n1 - Дозволити користувачам керувати своїми сертифікатами\n2 - Заборонити користувачам керувати сертифікатами\nЯкщо для цього правила вибрано значення \"Усі\" або його не налаштовано, користувачі зможуть редагувати налаштування довіри для всіх сертифікатів центру сертифікації, імпортувати сертифікати й видаляти ті, які імпортували користувачі, через Менеджер сертифікатів. Якщо для цього правила вибрано значення \"Лише користувач (1)\", користувачі зможуть керувати лише сертифікатами, які імпортували користувачі, але не зможуть змінювати налаштування довіри вбудованих сертифікатів. Якщо для нього вибрано значення \"Немає (2)\", користувачі зможуть лише переглядати сертифікати центру сертифікації, але не керувати ними.";
CACertificates.pfm_title = "Сертифікати TLS, які Brave визначає як надійні для автентифікації сервера";
CACertificates.pfm_description = "Список сертифікатів TLS, які Brave визначає як надійні для автентифікації сервера.\nСертифікати мають бути закодовані у форматі base64.";
CACertificatesWithConstraints.pfm_title = "Сертифікати TLS, які Brave визначає як надійні для автентифікації сервера з обмеженнями";
CACertificatesWithConstraints.pfm_description = "Список сертифікатів TLS, які Brave визначає як надійні для автентифікації сервера з обмеженнями, доданими за межами сертифіката. Якщо не вказано обмеження певного типу, можна використовувати будь-яку назву цього типу.\nСертифікати мають бути закодовані у форматі base64. Для кожного сертифіката необхідно вказати принаймні одне обмеження.\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=CACertificatesWithConstraints.";
CADistrustedCertificates.pfm_title = "Сертифікати TLS, які Brave визначає як ненадійні для автентифікації сервера";
CADistrustedCertificates.pfm_description = "Список відкритих ключів сертифіката, які Brave визначає як ненадійні для автентифікації сервера TLS.\n\nЗначення правила – це список сертифікатів X.509 із кодуванням base64. Будь-які сертифікати, які мають таке саме значення SPKI (SubjectPublicKeyInfo), вважатимуться ненадійними.";
CAHintCertificates.pfm_title = "Сертифікати TLS, не визначені як надійні або ненадійні, які можуть використовуватися для створення шляхів під час автентифікації сервера";
CAHintCertificates.pfm_description = "Список сертифікатів, які Brave не визначає як надійні або ненадійні, але які можуть використовуватись як корективи для створення шляхів. Сертифікати мають бути закодовані у форматі base64.";
CAPlatformIntegrationEnabled.pfm_title = "Використовувати додані користувачами сертифікати сервера TLS із довірених сховищ платформи для автентифікації сервера";
CAPlatformIntegrationEnabled.pfm_description = "Якщо ввімкнути або не налаштувати це правило, додані користувачами сертифікати сервера TLS із довірених сховищ платформи використовуватимуться для створення шляхів під час автентифікації сервера TLS.\n\nЯкщо вимкнути це правило, такі сертифікати TLS не використовуватимуться для створення шляхів під час автентифікації сервера TLS.";
CORSNonWildcardRequestHeadersSupport.pfm_title = "Підтримка заголовків запитів CORS без символів підстановки";
CORSNonWildcardRequestHeadersSupport.pfm_description = "Визначає, чи підтримуються заголовки запитів CORS без символів підстановки.\n\nУ Brave версії 97 додано підтримку запитів CORS без символів підстановки. Коли скрипти виконують міждоменні запити мережі через fetch() і XMLHttpRequest із заголовками авторизації, доданими в них, заголовок потрібно явно дозволити заголовком Access-Control-Allow-Headers у відповіді на попередній запит CORS. \"Явно\" означає, що символ підстановки \"*\" не поширюється на заголовок авторизації. Докладніше читайте на сторінці https://chromestatus.com/feature/5742041264816128.\n\nЯкщо це правило не налаштувати або вибрати значення True, Brave буде підтримувати заголовки запитів CORS без символів підстановки, а поведінка відповідатиме описаній вище.\n\nЯкщо для нього вибрати значення False, символ підстановки (\"*\") у заголовках Access-Control-Allow-Headers відповідей на попередні запити CORS у Chrome поширюватиметься на заголовки авторизації.\n\nЦе корпоративне правило – тимчасове. Ми плануємо вилучити його в майбутньому.";
CacheEncryptionEnabled.pfm_title = "Це правило дає адміністраторам змогу шифрувати кеш HTTP на диску.";
CacheEncryptionEnabled.pfm_description = "Це правило дає адміністраторам змогу шифрувати кеш HTTP вебпереглядача на диску.\n\nЯкщо ввімкнути це правило, кеш вебпереглядача шифруватиметься.\n\nЯкщо його вимкнути або не налаштувати, кеш вебпереглядача не шифруватиметься.\n\nШифрування кешу вебпереглядача може вплинути на продуктивність.";
CertificateTransparencyEnforcementDisabledForCas.pfm_title = "Вимкнути застосування перевірки сертифіката для списку хешів інформації про відкритий ключ суб’єкта";
CertificateTransparencyEnforcementDisabledForCas.pfm_description = "Якщо налаштувати це правило, буде вимкнено застосування вимог щодо розголошення даних перевірки сертифіката для списку хешів subjectPublicKeyInfo. Хости підприємства можуть і надалі використовувати сертифікати, які в іншому випадку вважалися б ненадійними (оскільки їх дані не розкрили належним чином). Щоб вимкнути застосування вимог, хеш має відповідати одній із вимог нижче.\n\n* Хеш містить інформацію subjectPublicKeyInfo сертифіката сервера.\n\n* Хеш містить інформацію subjectPublicKeyInfo, яка відображається в ланцюжку сертифікатів центру сертифікації. Цей сертифікат обмежений розширенням X.509v3 nameConstraints, принаймні одне розширення directoryName nameConstraints указано в permittedSubtrees, а directoryName містить атрибут organizationName.\n\n* Хеш містить інформацію subjectPublicKeyInfo, яка відображається в ланцюжку сертифікатів центру сертифікації, сертифікат центру сертифікації має принаймні один атрибут organizationName у суб'єкті сертифіката, сертифікат сервера містить таку ж кількість атрибутів organizationName, які розміщені в такому самому порядку й мають однакову кількість байтів.\n\nЩоб указати хеш subjectPublicKeyInfo, об'єднайте назву алгоритму хешу, скісну риску та кодування Base64 алгоритму хешу, що застосовується до даних subjectPublicKeyInfo зазначеного сертифіката з DER-кодуванням. Кодування Base64 має той самий формат, що й відбиток SPKI. Розпізнається лише алгоритм хешу sha256. Усі інші ігноруються.\n\nЯкщо не налаштувати це правило, Brave не довірятиме нерозголошеним сертифікатам, дані яких мають бути розкриті внаслідок перевірки.";
CertificateTransparencyEnforcementDisabledForUrls.pfm_title = "Вимкнути застосування перевірки сертифіката для списку URL-адрес";
CertificateTransparencyEnforcementDisabledForUrls.pfm_description = "За допомогою цього правила можна вимкнути обов’язкову перевірку розкриття сертифіката за стандартом Certificate Transparency (CT) для імен хостів у вказаних URL-адресах. Через це виявляти неправильно видані сертифікати буде важче, але хости зможуть і надалі використовувати сертифікати, які в іншому випадку вважалися б ненадійними (оскільки їх дані не розкрили належним чином).\n\nЯкщо не налаштувати це правило, Brave не довірятиме сертифікатам, що не відповідають вимогам до розкриття даних за стандартом CT.\n\nШаблон URL-адрес має відповідати вимогам до формату: https://support.google.com/chrome/a?p=url_blocklist_filter_format. Однак оскільки сертифікати дійсні для певного імені хосту незалежно від схеми, порту чи шляху, Brave бере до уваги лише частину URL-адреси з іменем хосту. Замість імені хосту не можна вказувати символ підстановки.";
ChromeForTestingAllowed.pfm_title = "Дозвіл на використання Chrome for Testing";
ChromeForTestingAllowed.pfm_description = "Визначає, чи можуть користувачі використовувати версію Chrome for Testing.\n\nЯкщо ввімкнути або не налаштувати це правило, користувачі зможуть установлювати й запускати її.\n\nЯкщо його вимкнути, версія Chrome for Testing не запускатиметься. Користувачі все одно зможуть установлювати її, але вона не працюватиме в профілях, де це правило вимкнено.";
ChromeSuggestionsSettings.pfm_title = "Налаштування пропозицій Chrome";
ChromeSuggestionsSettings.pfm_description = "Це налаштування дає змогу керувати тим, чи може Chrome пропонувати функції на основі ШІ у відповідні моменти.\n\nЯкщо вибрати значення \"0\" або не налаштувати це правило, пропозиції Chrome буде ввімкнено для користувачів.\n\nЯкщо вибрати значення \"1\", пропозиції Chrome буде вимкнено.\n\nЩоб дізнатися більше, перегляньте статтю Довідкового центру за цим посиланням: https://support.google.com/chrome/a?p=chrome_suggestions.";
ChromeVariations.pfm_title = "Визначати наявність варіантів";
ChromeVariations.pfm_description = "0 - Увімкнути всі варіанти\n1 - Увімкнути варіанти, які стосуються лише важливих виправлень\n2 - Вимкнути всі варіанти\nЯкщо налаштувати це правило, буде вказано, які варіанти можна застосовувати в Brave.\n\nВаріанти дають змогу пропонувати зміни для Brave, не створюючи нову версію веб-переглядача, а вибірково вмикаючи або вимикаючи наявні функції. Докладніше читайте на сторінці https://support.google.com/chrome/a?p=Manage_the_Chrome_variations_framework.\n\nЯкщо вибрано параметр VariationsEnabled (значення 0) або це правило не налаштовано, до веб-переглядача можуть застосовуватися всі варіанти.\n\nЯкщо вибрано параметр CriticalFixesOnly (значення 1), до Brave можна застосовувати лише варіанти, які вважаються важливими виправленнями системи безпеки або стабільності.\n\nЯкщо вибрано параметр VariationsDisabled (значення 2), жодний варіант не застосовуватиметься до веб-переглядача. Зауважте, що в цьому режимі розробники Brave можуть не мати змоги вчасно надавати важливі виправлення системи безпеки, тому ми не радимо його вмикати.";
ClearBrowsingDataOnExitList.pfm_title = "Очистити дані веб-перегляду після виходу";
ClearBrowsingDataOnExitList.pfm_description = "browsing_history - Історія вебперегляду\ndownload_history - Історія завантажень\ncookies_and_other_site_data - Файли cookie та інші дані із сайтів\ncached_images_and_files - Кешовані зображення та файли\npassword_signin - Вхід із паролем\nautofill - Автозаповнення\nsite_settings - Налаштування сайту\nhosted_app_data - Дані розміщених додатків\nЦе правило дає змогу налаштувати список типів даних вебперегляду, які потрібно видаляти, коли користувач закриває всі вікна вебпереглядача.\n\nПопередження. Це правило може впливати на локальні персональні дані й назавжди видаляти їх. Щоб запобігти випадковому видаленню персональних даних, рекомендуємо перевірити налаштування, перш ніж вводити їх у дію.\n\nДоступні типи даних: історія вебперегляду (browsing_history), історія завантажень (download_history), файли cookie (cookies_and_other_site_data), кеш (cached_images_and_files), дані автозаповнення (autofill), паролі (password_signin), налаштування сайтів (site_settings) і дані розміщених додатків (hosted_app_data). Це правило не має пріоритету над правилом AllowDeletingBrowserHistory.\n\nПісля видалення файлів cookie користувач залишиться в обліковому записі Google.\n\nУ Chrome 114 і старіших версіях це правило діє, якщо для правила SyncDisabled указано значення \"істина\". Починаючи з версії Chrome 115, це правило деактивуватиме синхронізацію для відповідних типів даних за умови, що функцію Chrome Sync не вимкнено за допомогою правила SyncDisabled і правило BrowserSignin також не вимкнено.\n\nЯкщо з якоїсь причини видалення даних не завершилося, дані вебперегляду буде очищено під час наступного завантаження профілю.\n\nЯкщо Brave закривається неналежним чином (наприклад, унаслідок помилки чи збою ОС), дані вебперегляду не буде видалено, оскільки вебпереглядач закрився не внаслідок закриття всіх вікон користувачем.";
ClipboardAllowedForUrls.pfm_title = "Дозволити використання буфера обміну на цих сайтах";
ClipboardAllowedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, які можуть запитувати дозвіл на використання буфера обміну. Воно стосується не всіх операцій із буфером обміну в джерелах, які збігаються із шаблонами. Наприклад, користувачі зможуть вставляти контент за допомогою комбінацій клавіш, оскільки для таких операцій не потрібен згаданий вище дозвіл.\n\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultClipboardSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).";
ClipboardBlockedForUrls.pfm_title = "Заблокувати буфер обміну на цих сайтах";
ClipboardBlockedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, які не можуть запитувати дозвіл на використання буфера обміну. Воно стосується не всіх операцій із буфером обміну в джерелах, які збігаються із шаблонами. Наприклад, користувачі зможуть вставляти контент за допомогою комбінацій клавіш, оскільки для таких операцій не потрібен згаданий вище дозвіл.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultClipboardSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).";
CloudManagementEnrollmentMandatory.pfm_title = "Увімкнути обов’язкову реєстрацію для хмарного керування";
CloudManagementEnrollmentMandatory.pfm_description = "Якщо ввімкнути це правило, реєстрація в сервісі керування вебпереглядачами Chrome Enterprise Core стане обов’язковою, а без неї запуск Brave блокуватиметься.\n\nЯкщо вимкнути або не налаштувати це правило, реєстрація в сервісі керування вебпереглядачами Chrome Enterprise Core буде необов’язковою і Brave запускатиметься без неї.\n\nЦе правило діє для комп’ютерів і впливає на застосування правил хмарних сервісів на рівні пристрою. Докладнішу інформацію наведено на сторінці https://support.google.com/chrome/a/answer/9301891.";
CloudManagementEnrollmentToken.pfm_title = "Маркер реєстрації правил використання хмарних сервісів";
CloudManagementEnrollmentToken.pfm_description = "Якщо налаштувати це правило, Brave намагатиметься зареєструватися в сервісі керування вебпереглядачами Chrome Enterprise Core. Значенням для цього правила є маркер реєстрації. Його можна отримати, перейшовши на Google Admin console.\n\nДокладнішу інформацію наведено на сторінці https://support.google.com/chrome/a/answer/9301891.";
CloudPolicyOverridesPlatformPolicy.pfm_title = "Правила використання хмарних сервісів у Brave замінюють правила платформи.";
CloudPolicyOverridesPlatformPolicy.pfm_description = "Якщо ввімкнути це правило, правила хмарних сервісів матимуть перевагу в разі конфлікту з правилами платформи.\n\nЯкщо вимкнути або не налаштувати це правило, правила платформи матимуть перевагу в разі конфлікту з правилами хмарних сервісів.\n\nЦе обов’язкове правило впливає лише на застосування правил хмарних сервісів на рівні пристрою.\n\nЦе правило стосується Brave і не впливає на додаток Google Update, оскільки вони не залежать один від одного.\nGoogle Update має окреме правило з такою самою назвою.";
CloudUserPolicyMerge.pfm_title = "Дає змогу об'єднати правила хмари на рівні користувачів і правила на рівні пристрою";
CloudUserPolicyMerge.pfm_description = "Якщо ввімкнути це правило, пов’язані з керованим обліковим записом правила можна буде об’єднувати в правила на рівні пристрою.\n\nЯкщо вимкнути або не налаштувати це правило, правила хмарних сервісів на рівні користувачів не можна буде об’єднувати з правилами з інших джерел.\n\nЦе стосується лише правил захищених користувачів. Користувач вважається захищеним, якщо його вебпереглядачем керує організація через Chrome Enterprise Core. Усі інші правила на рівні користувачів за умовчанням матимуть вищий пріоритет.\n\nПравила, які треба об’єднати, також потрібно налаштувати в правилі PolicyListMultipleSourceMergeList або PolicyDictionaryMultipleSourceMergeList. Це правило не застосовуватиметься, якщо жодне з двох вищезгаданих правил не налаштовано.";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_title = "Дозволити правилам хмари на рівні користувачів перевизначати правила рішення Chrome Browser Cloud Management";
CloudUserPolicyOverridesCloudMachinePolicy.pfm_description = "Якщо ввімкнути це правило, пов’язані з керованим обліковим записом правила матимуть перевагу в разі конфлікту з правилами вебпереглядача, налаштованими через Chrome Enterprise Core.\n\nЯкщо вимкнути або не налаштувати це правило, правила хмарних сервісів на рівні користувачів матимуть стандартний пріоритет.\n\nЦе стосується лише правил захищених користувачів. Користувач вважається захищеним, якщо його вебпереглядачем керує організація через Chrome Enterprise Core. Усі інші правила на рівні користувачів за умовчанням матимуть вищий пріоритет.\n\nЦе правило можна використовувати разом із CloudPolicyOverridesPlatformPolicy. Якщо ввімкнути обидва правила, у разі конфлікту правила хмарних сервісів на рівні користувачів матимуть пріоритет над правилами платформи.";
CommandLineFlagSecurityWarningsEnabled.pfm_title = "Увімкнути застереження про небезпеку для позначок командного рядка";
CommandLineFlagSecurityWarningsEnabled.pfm_description = "Якщо ввімкнути або не налаштувати це правило, під час запуску Chrome із потенційно небезпечними експериментальним параметрами командного рядка з’являються попередження про небезпеку.\n\nЯкщо його вимкнути, такі застереження не відображатимуться.\n\nУ Microsoft® Windows® це правило застосовується лише для екземплярів, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS це правило доступне лише для екземплярів, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.";
ComponentUpdatesEnabled.pfm_title = "Увімкнути оновлення компонентів у Brave";
ComponentUpdatesEnabled.pfm_description = "Якщо це правило ввімкнено або не налаштовано, вмикає оновлення для всіх компонентів у Brave.\n\nЯкщо вимкнути це правило, компоненти не оновлюватимуться. Однак винятками є компоненти, які не містять виконуваний код і важливі для безпеки веб-переглядача.\nПриклади таких компонентів: списки відкликаних сертифікатів і фільтри субресурсів.";
CompressionDictionaryTransportEnabled.pfm_title = "Увімкнути підтримку передавання словника зі стисненням";
CompressionDictionaryTransportEnabled.pfm_description = "Ця функція дає змогу використовувати кодування контенту певного словника в заголовку запиту \"Accept-Encoding\" (\"sbr\" і \"zst-d\"), коли словники доступні.\n\nЯкщо ввімкнути або не налаштувати це правило, Brave прийматиме веб-контент, для якого використовується функція передавання словника зі стисненням.\nЯкщо його вимкнути, цю функцію буде вимкнено.";
CookiesAllowedForUrls.pfm_title = "Дозволити файли cookie на цих сайтах";
CookiesAllowedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким дозволено встановлювати файли cookie.\n\nУ шаблоні можна вказати одну URL-адресу, щоб дозволити сайту використовувати файли cookie на всіх сайтах верхнього рівня.\n\nШаблони також можуть містити дві URL-адреси, розділені комою. Перша URL-адреса – це сайт, якому дозволено використовувати файли cookie. Друга – це сайт верхнього рівня, на якому має застосовуватися перше значення.\n\nЯкщо використовується пара URL-адрес, перше значення в парі може бути символом *, а друге – ні. Якщо ввести символ * як перше значення, а друга URL-адреса є сайтом верхнього рівня, усі сайти зможуть використовувати файли cookie.\n\nЯкщо це правило не налаштувати, для всіх сайтів буде застосовано глобальне значення за умовчанням відповідно до правил DefaultCookiesSetting або BlockThirdPartyCookies (якщо їх налаштовано) чи особистих параметрів користувача.\n\nПерегляньте також правила CookiesBlockedForUrls і CookiesSessionOnlyForUrls. Зверніть увагу, що ці три правила не повинні містити конфліктних шаблонів URL-адрес, оскільки пріоритетне правило не визначено.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. * – недопустиме значення для цього правила.";
CookiesBlockedForUrls.pfm_title = "Блокувати файли cookie на цих сайтах";
CookiesBlockedForUrls.pfm_description = "За допомогою цього правила можна створити список шаблонів URL-адрес, що визначають сайти, які не можуть встановлювати файли cookie.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultCookiesSetting за умови, що його налаштовано. Якщо ні, використовуються особисті налаштування користувачів.\n\nХоча жодне правило не має переваги, перегляньте правила CookiesAllowedForUrls і CookiesSessionOnlyForUrls. Шаблони URL-адрес, указані в цих трьох правилах, не можуть конфліктувати.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. * – недопустиме значення для цього правила.";
CookiesSessionOnlyForUrls.pfm_title = "Не дозволяє файлам cookie зіставляти URL-адреси з поточним сеансом";
CookiesSessionOnlyForUrls.pfm_description = "Якщо в правилі RestoreOnStartup не налаштувати відновлення URL-адрес із попереднього сеансу, тоді, налаштувавши правило CookiesSessionOnlyForUrls, ви зможете створити список шаблонів URL-адрес, що визначатиме, які сайти можуть встановлювати файли cookie для одного сеансу, а які ні.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultCookiesSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів. До URL-адрес, які не відповідають указаним шаблонам, застосовуються параметри за умовчанням.\n\nХоча жодне правило не має переваги, перегляньте правила CookiesBlockedForUrls і CookiesAllowedForUrls. Шаблони URL-адрес, указані в цих трьох правилах, не можуть конфліктувати.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. * – недопустиме значення для цього правила.";
CpuPerformanceTierOverride.pfm_title = "Перевизначення рівня продуктивності ЦП";
CpuPerformanceTierOverride.pfm_description = "За допомогою цього правила компанії можуть перевизначати результати, які повертає CPU Performance API (тобто значення navigator.cpuPerformance, докладнішу інформацію про яке наведено на сторінці https://github.com/WICG/cpu-performance).\n\nЯкщо налаштувати це правило, значення navigator.cpuPerformance буде замінено на вказане. Якщо не налаштувати це правило, рівень продуктивності обчислюватиметься за умовчанням.\n\nМожливі значення цього правила: від 0 до 4.";
CreatePasskeysInICloudKeychain.pfm_title = "Налаштування параметрів за умовчанням для створення ключів доступу (за допомогою iCloud Keychain чи ні).";
CreatePasskeysInICloudKeychain.pfm_description = "Brave може спрямовувати\nзапити на створення ключа доступу або WebAuthn в iCloud Keychain на пристроях macOS 13.5\nабо новішої версії. Якщо синхронізацію iCloud Keychain ще не ввімкнено, користувачу\nбуде запропоновано ввійти в iCloud або ввімкнути синхронізацію iCloud\nKeychain.\n\nЯкщо для цього правила вибрати значення \"неправда\", за умовчанням iCloud Keychain не використовуватиметься,\nнатомість може застосовуватися попередня поведінка (створення облікових даних у профілі\nBrave). Однак користувачі зможуть вибрати опцію iCloud Keychain і\nбачитимуть облікові дані iCloud Keychain під час входу.\n\nЯкщо для цього правила вибрати значення \"правда\", iCloud Keychain буде ввімкнено за умовчанням,\nщоразу як запит WebAuthn буде сумісним із цим вибором.\n\nЯкщо це правило не налаштувати, значення за умовчанням залежатиме від того, чи ввімкнено\nДиск iCloud і чи користувач нещодавно\nстворював або використовував облікові дані у своєму\nпрофілі Brave.";
CreateThemesSettings.pfm_title = "Налаштування функції \"Створення тем за допомогою ШІ\"";
CreateThemesSettings.pfm_description = "0 - Дозволити використовувати функцію \"Створення тем\" і покращувати моделі ШІ.\n1 - Дозволити використовувати функцію \"Створення тем\" без покращення моделей ШІ.\n2 - Заборонити використовувати функцію \"Створення тем\".\nФункція \"Створення тем за допомогою ШІ\" дає користувачам змогу створювати спеціальні теми або фонові малюнки за допомогою параметрів, вибраних зі списку варіантів.\n\n\"0\" – увімкнути пов’язані функції і надсилати в Google відповідні дані для покращення моделей штучного інтелекту. Залежно від функції надсилатися можуть запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки. Спеціалісти можуть перевіряти такі матеріали, щоб покращувати моделі штучного інтелекту. Значення \"0\" використовується за умовчанням, за винятком наведених нижче випадків.\n\n\"1\" – увімкнути пов’язані функції, але не надсилати в Google контент користувачів (зокрема запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки) для покращення моделей штучного інтелекту. Значення \"1\" застосовується за умовчанням для корпоративних користувачів, якими керують через Google Admin console, і облікових записів закладів освіти, якими керують через Google Workspace.\n\n\"2\" – заборонити використовувати пов’язані функції.\n\nЯкщо не налаштувати це правило, його поведінка визначатиметься правилом GenAiDefaultSettings.\n\nЩоб дізнатися більше про обробку даних для функцій на основі генеративного ШІ, перейдіть на сторінку https://support.google.com/chrome/a?p=generative_ai_settings.";
DNSInterceptionChecksEnabled.pfm_title = "Увімкнено перевірку перехоплення системи DNS";
DNSInterceptionChecksEnabled.pfm_description = "Це правило налаштовує локальний перемикач, за допомогою якого можна вимкнути перевірки перехоплення системи DNS. Ці перевірки виявляють, чи працює веб-переглядач через проксі-сервер, який переспрямовує невідомі імена хостів.\n\nЦя процедура може бути необов'язковою в корпоративному середовищі, де конфігурація мережі відома, оскільки це спричинятиме певний трафік DNS і HTTP під час запуску, а також зміну всіх налаштувань DNS.\n\nЯкщо це правило не налаштовано або ввімкнено, перевірки перехоплення системи DNS виконуються. Якщо його вимкнено, перевірки не відбуваються.";
DataURLWhitespacePreservationEnabled.pfm_title = "Збереження пробілів у DataURL для всіх типів медіаконтенту";
DataURLWhitespacePreservationEnabled.pfm_description = "Це правило дає змогу тимчасово відмовитися від змін в обробці пробілів у URL-адресах data вебпереглядачем Chrome.\nРаніше пробіли зберігалися, лише якщо медіаконтент найвищого рівня мав тип text або містив сегмент xml.\nВідтепер пробіли зберігатимуться в усіх URL-адресах даних, незалежно від типу медіаконтенту.\n\nЯкщо це правило не налаштувати або вибрати для нього значення \"правда\", застосовуватиметься нова поведінка,\n\nа якщо вибрати \"неправда\" – стара поведінка.";
DataUrlInSvgUseEnabled.pfm_title = "Підтримка URL-адрес даних для SVGUseElement.";
DataUrlInSvgUseEnabled.pfm_description = "Це правило вмикає підтримку URL-адрес даних для SVGUseElement, яку за умовчанням буде вимкнено, починаючи з версії M119.\nЯкщо ввімкнути це правило, URL-адреси даних продовжать працювати в SVGUseElement.\nЯкщо його вимкнути або не налаштувати, URL-адреси даних не працюватимуть у SVGUseElement.";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_title = "Увімкнути непрозорі джерела для URL-адрес даних в об’єктах Web Worker";
DataUrlInWebWorkerOpaqueOriginEnabled.pfm_description = "Визначає, чи призначатиметься унікальне непрозоре джерело для об’єктів Web Worker, створених на основі URL-адрес даних.\n\nОб’єкти Web Worker можна створювати за допомогою URL-адреси даних, де міститься їх скрипт. Раніше ці об’єкти успадковували джерело сторінки, яка їх запустила, і могли отримувати доступ до того самого локального сховища, файлів cookie й інших даних, пов’язаних із джерелом. Щоб покращити безпеку й забезпечити відповідність специфікації HTML, у Chrome із версії 149 змінено режим роботи за умовчанням. Тепер об’єкти, створені з URL-адрес даних, матимуть унікальне непрозоре джерело. Це дає змогу ізолювати такі об’єкти від даних сторінки, де їх було створено.\n\nЯкщо ввімкнути або не налаштувати це правило, використовуватиметься новий режим роботи за умовчанням (безпечніший), а об’єкти Web Worker, створені з URL-адрес даних, матимуть унікальне непрозоре джерело.\n\nЯкщо вимкнути це правило, Chrome повернеться до застарілого режиму роботи, і об’єкти Web Worker, створені з URL-адрес даних, успадковуватимуть джерело сторінки, де їх було налаштовано. Завдяки цьому адміністратори зможуть тимчасово усунути проблеми із сумісністю, якщо через зміну параметрів безпеки внутрішні додатки не працюватимуть.\n\nЦе правило тимчасове. Його буде вилучено у версії 157.";
DefaultAutomaticDownloadsSetting.pfm_title = "Налаштування автоматичних завантажень за умовчанням";
DefaultAutomaticDownloadsSetting.pfm_description = "1 - Дозволити сайтам автоматично завантажувати кілька файлів\n2 - Заборонити всім сайтам автоматично завантажувати кілька файлів\n3 - Запитувати щоразу, коли сайт хоче автоматично завантажити кілька файлів\nЯкщо для цього правила вибрати значення 1, вебсайти зможуть автоматично завантажувати кілька файлів. Якщо вибрати значення 2, сайти не зможуть цього робити. У правилі можна налаштувати, щоб вебсайти запитували дозвіл на автоматичне завантаження кількох файлів.\n\nЯкщо це правило не налаштувати, застосовуватиметься правило AskAutomaticDownloads, але користувачі зможуть змінити цей параметр.";
DefaultBraveAdblockSetting.pfm_title = "Control adblock behavior";
DefaultBraveAdblockSetting.pfm_description = "1 - Allow ads\n2 - Block ads\nThis policy determines how Brave handles ads on web pages.\n\nIf this policy is set to 1 (AllowAds), ads are allowed to be displayed on websites.\n\nIf this policy is set to 2 (BlockAds), ads are blocked.\n\nIf left unset, ads are blocked by default, but users can modify this by:\n- changing the \"Trackers & ads blocking\" control to \"Disabled\" in Shields settings, or to \"Allow all trackers & ads\" in the Shields panel\n- disabling Shields on a specific site";
DefaultBraveFingerprintingV2Setting.pfm_title = "Default Brave fingerprinting protection setting";
DefaultBraveFingerprintingV2Setting.pfm_description = "1 - Disable fingerprinting protection\n3 - Enable fingerprinting protection standard mode\nEnables or disables Brave fingerprinting protection.\n\nSetting the policy to:\n- 1 disables fingerprinting protection\n- 3 enables fingerprinting protection standard mode\n\nWhen leaving it unset, fingerprinting protection is controlled by the user setting (fingerprinting protection standard mode by default).";
DefaultBraveHttpsUpgradeSetting.pfm_title = "Control HTTPS upgrade behavior";
DefaultBraveHttpsUpgradeSetting.pfm_description = "1 - Allow HTTP\n2 - Require HTTPS\n3 - Prefer HTTPS\nThis policy determines how Brave handles HTTP to HTTPS upgrades to improve connection security.\n\nIf this policy is set to 1 (Disabled), HTTP connections are allowed.\n\nIf this policy is set to 2 (Strict), HTTPS connections are required. Users get an interstitial if HTTPS upgrade not possible.\n\nIf this policy is set to 3 (Standard), HTTP is upgraded to HTTPS when available.\n\nIf left unset, users can configure the HTTPS upgrade behavior in Brave Shields settings (Standard by default).";
DefaultBraveReferrersSetting.pfm_title = "Control referrer information access for permissive referrer policy";
DefaultBraveReferrersSetting.pfm_description = "1 - Allow permissive referrer policies (i.e., \"unsafe-url\")\n2 - Cap referrer values to \"strict-origin-when-cross-origin\" policy\nThis policy determines how websites can access referrer information when a very permissive referrer policy is specified (i.e., \"unsafe-url\").\n\nIf this policy is set to 1 (AllowPermissiveReferrerPolicy), permissive referrer policies are allowed (i.e., \"unsafe-url\" requests contain the full URL of the referrer).\n\nIf this policy is set to 2 (CapToStrictReferrerPolicy), referrer values are capped to \"strict-origin-when-cross-origin\" policy, so cross-origin requests contain only the origin of the referrer or no referrer if downgraded from HTTPS to HTTP. Same-origin requests contain the full URL of the referrer.\n\nIf left unset, referrer values are capped to \"strict-origin-when-cross-origin\" policy by default, but users can modify this by:\n- changing the cookie control in the Shields panel to \"Allow all cookies\"\n- disabling Shields on a specific site";
DefaultBraveRemember1PStorageSetting.pfm_title = "Control first-party storage retention behavior";
DefaultBraveRemember1PStorageSetting.pfm_description = "1 - Remember first-party storage data\n2 - Forget first-party storage data\nThis policy determines whether Brave remembers or forgets first-party storage data when users close tabs or navigate away.\n\nIf this policy is set to 1 (RememberFirstPartyStorage), first-party storage data is preserved across sessions.\n\nIf this policy is set to 2 (ForgetFirstPartyStorage), first-party storage data is cleared when tabs are closed or users navigate away.\n\nIf left unset, Brave preserves first-party storage data across sessions by default, but users can modify this through Brave Shields settings.";
DefaultBrowserSettingEnabled.pfm_title = "Зробити Brave веб-переглядачем за умовчанням";
DefaultBrowserSettingEnabled.pfm_description = "Якщо для цього правила вибрано значення True, під час запуску Brave завжди перевіряє, чи є веб-переглядачем за умовчанням, і за можливості автоматично реєструє себе. Якщо для нього вибрано значення False, Brave не зможе перевіряти, чи є веб-переглядачем за умовчанням, а користувачі не зможуть керувати цим параметром.\n\nЯкщо це правило не налаштовано, користувачі можуть вибрати, чи Brave є веб-переглядач за умовчанням. Якщо ні, вони можуть указати, чи показувати сповіщення для користувачів.\n\nПримітка для адміністраторів Microsoft®Windows®: це налаштування можна вимкнути лише на пристроях з ОС Windows 7. У пізніших версіях потрібно ввести в дію файл \"зв'язування додатків за умовчанням\", який вибирає Brave обробником протоколів https і http (а за бажання й протоколу ftp та інших форматів файлів). Докладніше читайте в довідці Chrome (https://support.google.com/chrome?p=make_chrome_default_win).";
DefaultClipboardSetting.pfm_title = "Налаштування буфера обміну за умовчанням";
DefaultClipboardSetting.pfm_description = "2 - Не дозволяти жодному сайту запитувати дозвіл на використання буфера обміну\n3 - Дозволити сайтам запитувати в користувача дозвіл на використання буфера обміну\nЯкщо вказати для цього правила значення 2, сайти не зможуть запитувати дозвіл на використання буфера обміну. Якщо вказати значення 3 або не налаштовувати правило, користувач зможе змінювати цей параметр і вирішувати, чи доступний інтерфейс API буфера обміну, коли сайт його запитує.\n\nЦе правило можна перевизначити для певних шаблонів URL-адрес за допомогою правил ClipboardAllowedForUrls і ClipboardBlockedForUrls.\n\nВоно впливає лише на операції, які регулює дозвіл на використання буфера обміну, і не стосується очищених записів у буфері, а також надійних операцій копіювання та вставлення.";
DefaultCookiesSetting.pfm_title = "Налаштування файлів cookie за умовчанням";
DefaultCookiesSetting.pfm_description = "1 - Дозволити всім сайтам установлювати локальні дані\n2 - Забороняти всім сайтам установлювати локальні дані\n4 - Зберігати файли cookie впродовж сеансу\nЯкщо в правилі RestoreOnStartup не налаштувати відновлення URL-адрес із попереднього сеансу, тоді, налаштувавши правило CookiesSessionOnlyForUrls, ви зможете створити список шаблонів URL-адрес, що визначає, які сайти можуть встановлювати файли cookie для одного сеансу, а які ні.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultCookiesSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів. До URL-адрес, які не відповідають указаним шаблонам, застосовуються параметри за умовчанням.\n\nХоч жодне з правил не має пріоритету, перегляньте правила CookiesBlockedForUrls і CookiesAllowedForUrls. Шаблони URL-адрес, указані в цих трьох правилах, не можуть конфліктувати.";
DefaultDownloadDirectory.pfm_title = "Указати каталог для завантаження за умовчанням";
DefaultDownloadDirectory.pfm_description = "Налаштування цього правила змінюють каталог за умовчанням, у якому Chrome зберігає файли, але користувачі зможуть змінити його.\n\nЯкщо це правило не налаштовано, Chrome використовує каталог платформи за умовчанням.\n\nЦе правило не діє, якщо не налаштовано правило \"DownloadDirectory\".\n\nПримітка: список можливих змінних доступний на сторінці https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DefaultFileSystemReadGuardSetting.pfm_title = "Контролювати використання File System API для перегляду";
DefaultFileSystemReadGuardSetting.pfm_description = "2 - Заборонити всім сайтам запитувати дозвіл на перегляд файлів і каталогів через File System API\n3 - Дозволити сайтам запитувати в користувача доступ для перегляду файлів і каталогів через File System API\nЯкщо для цього правила вибрано значення 3, веб-сайти можуть запитувати дозвіл на перегляд файлів чи каталогів у файловій системі ОС хосту через File System API. Якщо для нього вибрано значення 2, доступ буде заблоковано.\n\nЯкщо це правило не налаштовано, веб-сайти зможуть запитувати дозвіл, але користувачі матимуть можливість змінити цей параметр.";
DefaultFileSystemWriteGuardSetting.pfm_title = "Контролювати використання File System API для редагування";
DefaultFileSystemWriteGuardSetting.pfm_description = "2 - Заборонити всім сайтам запитувати дозвіл на редагування файлів і каталогів\n3 - Дозволити сайтам запитувати в користувача дозвіл на редагування файлів і каталогів\nЯкщо для цього правила вибрано значення 3, веб-сайти можуть запитувати дозвіл на редагування файлів чи каталогів у файловій системі ОС хосту. Якщо для нього вибрано значення 2, доступ буде заблоковано.\n\nЯкщо це правило не налаштовано, веб-сайти зможуть запитувати дозвіл, але користувачі матимуть можливість змінити цей параметр.";
DefaultGeolocationSetting.pfm_title = "Налаштування географічного місцезнаходження за умовчанням";
DefaultGeolocationSetting.pfm_description = "1 - Дозволяти сайтам відстежувати фізичне місцезнаходження користувача\n2 - Забороняти всім сайтам відстежувати фізичне місцезнаходження користувача\n3 - Запитувати щоразу, коли сайт хоче відстежувати фізичне місцезнаходження користувача\nЯкщо для цього правила вибрати значення 1, сайти можуть за умовчанням відстежувати місцезнаходження користувачів. Якщо вибрати значення 2, відстеження буде вимкнено за умовчанням. У правилі можна налаштувати, щоб сайти запитували дозвіл на відстеження місцезнаходження користувачів.\n\nЯкщо це правило не налаштувати, застосовуватиметься правило AskGeolocation, але користувачі зможуть змінити цей параметр.";
DefaultIdleDetectionSetting.pfm_title = "Виявлення неактивності";
DefaultIdleDetectionSetting.pfm_description = "1 - Дозволити сайтам визначати неактивність, не запитуючи користувача\n2 - Заборонити всім сайтам виявляти неактивність користувача\n3 - Запитувати щоразу, коли сайт хоче визначити стан неактивності користувача\nЗа допомогою цього правила можна вказати, чи дозволено вебсайтам використовувати Idle Detection API.\n\nЯкщо вибрати для цього правила значення 1 (AllowIdleDetection), вебсайти зможуть використовувати Idle Detection API, не запитуючи дозвіл користувача.\n\nЯкщо вибрати значення 2 (BlockIdleDetection), вебсайти не зможуть використовувати Idle Detection API незалежно від дозволу користувача.\n\nЯкщо вибрати значення 3 (AskIdleDetection) або не налаштувати це правило, вебсайти не зможуть використовувати Idle Detection API без дозволу користувача.";
DefaultImagesSetting.pfm_title = "Налаштування зображень за умовчанням";
DefaultImagesSetting.pfm_description = "1 - Дозволяти всім сайтам показувати всі зображення\n2 - Забороняти всім сайтам показувати зображення\nЯкщо для цього правила вибрати значення 1, усі веб-сайти зможуть показувати зображення. Якщо вибрати значення 2, показ зображень блокуватиметься.\n\nЯкщо це правило не налаштувати, показ зображень дозволяється, але користувачі зможуть змінити цей параметр.";
DefaultInsecureContentSetting.pfm_title = "Контролювати використання винятків для незахищеного контенту";
DefaultInsecureContentSetting.pfm_description = "2 - Заборонити всім сайтам завантажувати змішаний контент\n3 - Дозволити користувачам додавати винятки, щоб дозволяти змішаний контент\nДає змогу вказати, чи можуть користувачі додавати винятки, щоб дозволити змішаний контент для певних сайтів.\n\nЦе правило можна перевизначити для конкретних шаблонів URL-адрес за допомогою правил InsecureContentAllowedForUrls і InsecureContentBlockedForUrls.\n\nЯкщо це правило не налаштувати, користувачі зможуть додавати винятки, щоб дозволити змішаний контент, який можна блокувати, і вимкнути його автоматичне оновлення.";
DefaultJavaScriptJitSetting.pfm_title = "Керувати використанням JIT-компілятора JavaScript";
DefaultJavaScriptJitSetting.pfm_description = "1 - Дозволити використання JIT-компілятора JavaScript на всіх сайтах\n2 - Заборонити всім сайтам запускати JIT-компілятор JavaScript\nДає змогу вказати, чи Brave запускатиме рушій JavaScript версії 8 з увімкненим JIT-компілятором.\n\nЯкщо вимкнути JIT-компілятор JavaScript, Brave може відображати контент повільніше, а деякі частини JavaScript (зокрема WebAssembly) вимикатимуться. Крім того, у такому випадку Brave відображатиме веб-контент у надійнішій конфігурації.\n\nЦе правило можна перевизначити для певних шаблонів URL-адрес за допомогою правил JavaScriptJitAllowedForSites і JavaScriptJitBlockedForSites.\n\nЯкщо це правило не налаштовано, JIT-компілятор JavaScript увімкнено.";
DefaultJavaScriptOptimizerSetting.pfm_title = "Керувати використанням оптимізаторів JavaScript";
DefaultJavaScriptOptimizerSetting.pfm_description = "1 - Увімкнути розширену оптимізацію JavaScript на всіх сайтах\n2 - Вимкнути розширену оптимізацію JavaScript на всіх сайтах\nЗа допомогою цього правила можна вказати, чи Brave запускатиме рушій JavaScript версії 8 з увімкненою розширеною оптимізацією JavaScript.\n\nЯкщо вимкнути оптимізацію JavaScript (указавши для цього правила значення 2), Brave може відображати вебконтент повільніше.\n\nЦе правило можна перевизначити для певних шаблонів URL-адрес за допомогою правил JavaScriptOptimizerAllowedForSites і JavaScriptOptimizerBlockedForSites.\n\nЯкщо це правило не налаштувати, оптимізацію JavaScript буде ввімкнено.";
DefaultJavaScriptSetting.pfm_title = "Налаштування JavaScript за умовчанням";
DefaultJavaScriptSetting.pfm_description = "1 - Дозволяти всім сайтам запускати JavaScript\n2 - Забороняти всім сайтам запускати JavaScript\nЯкщо для цього правила вибрати значення 1, веб-сайти зможуть запускати JavaScript. Якщо вибрати значення 2, JavaScript буде заблоковано.\n\nЯкщо це правило не налаштувати, JavaScript буде дозволено, але користувачі зможуть змінити цей параметр.";
DefaultLocalFontsSetting.pfm_title = "Налаштування доступу до локальних шрифтів за умовчанням";
DefaultLocalFontsSetting.pfm_description = "2 - Забороняє використання локальних шрифтів на всіх сайтах за умовчанням\n3 - Запитувати щоразу, коли сайт хоче отримати дозвіл на використання локальних шрифтів\nЯкщо для правила вибрати BlockLocalFonts (значення 2), дозвіл на використання локальних шрифтів буде автоматично відхилятися для всіх сайтів за умовчанням. Такі сайти не отримають доступ до інформації про локальні шрифти.\n\nЯкщо для правила вибрати AskLocalFonts (значення 3), за умовчанням користувач бачитиме сповіщення, коли буде надсилатися запит на використання локальних шрифтів. Якщо користувач погодиться, сайти отримають доступ до інформації про локальні шрифти.\n\nЯкщо правило не налаштувати, застосовуватиметься стандартна поведінка і користувачу надсилатиметься відповідне сповіщення, проте цей параметр можна змінити.";
DefaultNotificationsSetting.pfm_title = "Налаштування сповіщень за умовчанням";
DefaultNotificationsSetting.pfm_description = "1 - Дозволяти сайтам показувати сповіщення на робочому столі\n2 - Забороняти всім сайтам показувати сповіщення на робочому столі\n3 - Запитувати щоразу, коли сайт хоче показати сповіщення на робочому столі\nЯкщо для цього правила вибрати значення 1, веб-сайти зможуть показувати сповіщення на робочому столі. Якщо вибрати значення 2, сповіщення на робочому столі блокуватимуться.\n\nЯкщо це правило не налаштувати, застосовуватиметься правило AskNotifications, але користувачі зможуть змінити цей параметр.";
DefaultPopupsSetting.pfm_title = "Налаштування спливаючих вікон за умовчанням";
DefaultPopupsSetting.pfm_description = "1 - Дозволяти всім сайтам показувати спливаючі вікна\n2 - Забороняти всім сайтам показувати спливаючі вікна\nЯкщо для цього правила вибрати значення 1, веб-сайти зможуть показувати спливаючі вікна. Якщо вибрати значення 2, спливаючі вікна блокуватимуться.\n\nЯкщо це правило не налаштувати, застосовуватиметься правило BlockPopups, але користувачі зможуть змінити цей параметр.";
DefaultPrinterSelection.pfm_title = "Правила вибору принтера за умовчанням";
DefaultPrinterSelection.pfm_description = "Це правило визначає, як вибирається принтер за умовчанням у Brave, і замінює стандартні параметри. Принтер вибирається під час першої ініціації друку: Brave намагається знайти принтер, який відповідає всім указаним атрибутам. Якщо повного збігу немає, Brave може вибрати будь-який відповідний принтер залежно від того, у якому порядку їх виявлено.\n\nЯкщо це правило не налаштувати або коли принтерів з указаними атрибутами не виявлено, за умовчанням буде вибрано вбудований PDF-принтер. Якщо його немає, Brave не вибиратиме принтер.\n\nЗараз усі принтери визначаються як \"local\". Принтери, підключені до сервісу Google Cloud Print, визначаються як \"cloud\", але Google Cloud Print більше не підтримується.\n\nПримітка: якщо не вказати значення якогось атрибута, система вважатиме, що підходить будь-яке його значення. Наприклад, якщо не вказати значення атрибута idPattern, для попереднього перегляду друку прийматимуться всі ідентифікатори принтерів. Шаблони регулярних виразів мають відповідати синтаксису JavaScript RegExp. Збіги чутливі до регістру.\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=DefaultPrinterSelection.";
DefaultSearchProviderAlternateURLs.pfm_title = "Список альтернативних URL-адрес для пошукової системи за умовчанням";
DefaultSearchProviderAlternateURLs.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то параметр DefaultSearchProviderAlternateURLs указує список альтернативних URL-адрес для отримання пошукових термінів із пошукової системи. URL-адреси мають містити сегмент '{searchTerms}'.\n\nЯкщо правило DefaultSearchProviderAlternateURLs не налаштовано, для отримання пошукових термінів не використовуються альтернативні URL-адреси.";
DefaultSearchProviderContextMenuAccessAllowed.pfm_title = "Дозволити пошуковій системі за умовчанням доступ до пошуку в контекстного меню";
DefaultSearchProviderContextMenuAccessAllowed.pfm_description = "Дає змогу використовувати пошукову систему за умовчанням у контекстному меню.\n\nЯкщо для цього правила вибрано значення disabled, пошук пункту контекстного меню, що залежить від пошукової системи за умовчанням, буде недоступний.\n\nЯкщо для цього правила вибрано значення enabled або його не налаштовано, пункт контекстного меню для пошукової системи за умовчанням буде доступним.\n\nЗначення правила застосовується лише тоді, коли ввімкнено правило DefaultSearchProviderEnabled, а в інших випадках – ні.";
DefaultSearchProviderEnabled.pfm_title = "Увімкнути пошукову службу за умовчанням";
DefaultSearchProviderEnabled.pfm_description = "Якщо ввімкнути це правило, пошук за умовчанням виконуватиметься, коли користувач вводитиме в адресному рядку текст, що не є URL-адресою. Щоб указати потрібний пошуковий сервіс за умовчанням, налаштуйте решту правил пошуку за умовчанням. Якщо для цих правил не вказати значення, користувач зможе вибирати пошуковий сервіс за умовчанням. Якщо вимкнути це правило, пошук не виконуватиметься, коли користувач вводитиме в адресному рядку текст, що не є URL-адресою. Google Admin console не підтримує значення \"Вимкнено\".\n\nЯкщо налаштувати це правило, користувачі не зможуть змінювати його в Brave. Якщо це правило не налаштувати, пошуковий сервіс за умовчанням буде ввімкнено, а користувачі зможуть указати список пошукових сервісів.\n\nУ Microsoft® Windows® це правило застосовується лише для екземплярів, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS це правило доступне лише для екземплярів, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.";
DefaultSearchProviderEncodings.pfm_title = "Кодування пошукової служби за умовчанням";
DefaultSearchProviderEncodings.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то параметр DefaultSearchProviderEncodings указує кодування символів, яке підтримує пошукова система. Кодування – це закодовані назви сторінок, як-от UTF-8, GB2312 чи ISO-8859-1. Вони випробовуються в заданому порядку.\n\nЯкщо правило DefaultSearchProviderEncodings не налаштовано, використовується кодування UTF-8.";
DefaultSearchProviderImageURL.pfm_title = "Параметр, що додаає функцію пошуку за зображенням у пошукову систему за умовчанням";
DefaultSearchProviderImageURL.pfm_description = "Якщо ввімкнути правило DefaultSearchProviderEnabled, то параметр DefaultSearchProviderImageURL указує URL-адресу пошукової системи, яка використовується для пошуку зображень. (Якщо налаштувати правило DefaultSearchProviderImageURLPostParams, запити пошуку зображень натомість використовують метод POST.)\n\nЯкщо правило DefaultSearchProviderImageURL не налаштувати, пошук зображень не використовується.\n\nЯкщо для пошуку зображень використовується метод GET, у URL-адресі\nпотрібно вказати параметри зображення з дійсною комбінацією таких заповнювачів:\n'{google:imageURL}';\n'{google:imageOriginalHeight}';\n'{google:imageOriginalWidth}';\n'{google:processedImageDimensions}';\n'{google:imageSearchSource}';\n'{google:imageThumbnail}';\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderImageURLPostParams.pfm_title = "Параметри URL-адреси зображення, яка використовує метод POST";
DefaultSearchProviderImageURLPostParams.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то налаштування DefaultSearchProviderImageURLPostParams указує параметри під час пошуку зображень через метод POST. Вони складаються з пар назв і значень, розділених комами. Якщо вказано шаблонний параметр, як-от {imageThumbnail}, його замінюють дані справжнього зменшеного зображення.\n\nЯкщо правило DefaultSearchProviderImageURLPostParams не налаштувати, запити пошуку зображень надсилаються через метод GET.\n\nURL-адреса має містити параметр зображення, що складається з дійсної комбінації\nтаких заповнювачів (залежно від того, що підтримує пошукова система):\n'{google:imageURL}';\n'{google:imageOriginalHeight}';\n'{google:imageOriginalWidth}';\n'{google:processedImageDimensions}';\n'{google:imageSearchSource}';\n'{google:imageThumbnail}';\n'{google:imageThumbnailBase64}'.";
DefaultSearchProviderKeyword.pfm_title = "Ключове слово пошукової служби за умовчанням";
DefaultSearchProviderKeyword.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то параметр DefaultSearchProviderKeyword указує ключове слово або комбінацію клавіш, які використовуються в адресному рядку, щоб активувати пошук у цій системі.\n\nЯкщо правило DefaultSearchProviderKeyword не налаштовано, ключових слів, які активують цю пошукову систему, немає.";
DefaultSearchProviderName.pfm_title = "Назва пошукової служби за умовчанням";
DefaultSearchProviderName.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то параметр DefaultSearchProviderName указує назву пошукового сервісу за умовчанням.\n\nЯкщо правило DefaultSearchProviderName не налаштовано, використовується ім'я хосту, указане в URL-адресі для пошуку.";
DefaultSearchProviderNewTabURL.pfm_title = "URL-адреса сторінки нової вкладки пошукової системи за умовчанням";
DefaultSearchProviderNewTabURL.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то параметр DefaultSearchProviderNewTabURL указує URL-адресу, яку пошукова система відкриває в новій вкладці.\n\nЯкщо правило DefaultSearchProviderNewTabURL не налаштовано, сторінку нової вкладки не вказано.";
DefaultSearchProviderSearchURL.pfm_title = "URL-адреса для пошуку пошукової служби за умовчанням";
DefaultSearchProviderSearchURL.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то параметр DefaultSearchProviderSearchURL указує URL-адресу пошукової системи за умовчанням. URL-адреса має містити сегмент '{searchTerms}', який у запиті замінюється пошуковим терміном користувача.\n\nВи можете вказати URL-адресу пошуку в Google як '{google:baseURL}search?q={searchTerms}&{google:RLZ}{google:originalQueryForSuggestion}{google:assistedQueryStats}{google:searchFieldtrialParameter}{google:searchClient}{google:sourceId}ie={inputEncoding}'.";
DefaultSearchProviderSearchURLPostParams.pfm_title = "Параметри URL-адреси пошуку, яка використовує метод POST";
DefaultSearchProviderSearchURLPostParams.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то налаштування DefaultSearchProviderSearchURLPostParams указує параметри під час пошуку URL-адреси через метод POST. Вони складаються з пар назв і значень, розділених комами. Якщо вказано шаблонний параметр, як-от '{searchTerms}', його замінюють дані справжніх пошукових термінів.\n\nЯкщо правило DefaultSearchProviderSearchURLPostParams не налаштовано, пошукові запити надсилаються за допомогою методу GET.";
DefaultSearchProviderSuggestURL.pfm_title = "URL-адреса для пропозицій пошукової служби за умовчанням";
DefaultSearchProviderSuggestURL.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то параметр DefaultSearchProviderSuggestURL указує URL-адресу пошукової системи, де надаються підказки. URL-адреса має містити сегмент '{searchTerms}', який у запиті замінюється пошуковим терміном користувача.\n\nВи можете вказати URL-адресу пошуку в Google як '{google:baseURL}complete/search?output=chrome&q={searchTerms}'.";
DefaultSearchProviderSuggestURLPostParams.pfm_title = "Параметри URL-адреси пропозицій, яка використовує метод POST";
DefaultSearchProviderSuggestURLPostParams.pfm_description = "Якщо правило DefaultSearchProviderEnabled увімкнено, то налаштування DefaultSearchProviderSuggestURLPostParams указує параметри під час рекомендації пошукових запитів через метод POST. Вони складаються з пар назв і значень, розділених комами. Якщо вказано шаблонний параметр, як-от '{searchTerms}', його замінюють дані справжніх пошукових термінів.\n\nЯкщо правило DefaultSearchProviderSuggestURLPostParams не налаштовано, рекомендовані пошукові запити надсилаються через метод GET.";
DefaultSensorsSetting.pfm_title = "Налаштування датчиків за умовчанням";
DefaultSensorsSetting.pfm_description = "1 - Надати сайтам доступ до датчиків\n2 - Заборонити всім сайтам доступ до датчиків\n3 - Запитувати щоразу, коли сайт хоче отримати доступ до датчиків\nЯкщо для цього правила вибрати значення 1, вебсайти матимуть доступ до датчиків (зокрема руху й світла) і зможуть використовувати їх. Якщо для нього вибрати значення 2, доступ буде заборонено. Якщо для цього правила вибрати значення 3, користувач отримуватиме від сайтів запити на доступ до датчиків (за умови, що ввімкнено експериментальний параметр функції з трьома опціями). В іншому разі доступ до датчиків надаватиметься за умовчанням.\n\nЯкщо це правило не налаштувати, застосовуватиметься правило AllowSensors, але користувачі зможуть змінити цей параметр.";
DefaultSerialGuardSetting.pfm_title = "Контролювати використання Serial API";
DefaultSerialGuardSetting.pfm_description = "2 - Заборонити всім сайтам запитувати дозвіл на доступ до послідовних портів через Serial API\n3 - Дозволити сайтам запитувати в користувача доступ до послідовного порту\nЯкщо для цього правила вибрано значення 3, веб-сайти можуть запитувати дозвіл на доступ до послідовних портів. Якщо для нього вибрано значення 2, доступ до послідовних портів буде заблоковано.\n\nЯкщо це правило не налаштовано, веб-сайти зможуть запитувати дозвіл, але користувачі матимуть можливість змінити цей параметр.";
DefaultWebBluetoothGuardSetting.pfm_title = "Контролювати використання API Web Bluetooth";
DefaultWebBluetoothGuardSetting.pfm_description = "2 - Заборонити всім сайтам запитувати доступ до пристроїв Bluetooth через API Web Bluetooth\n3 - Дозволити сайтам запитувати в користувача доступ до пристрою Bluetooth поблизу\nЯкщо для цього правила вибрано значення 3, веб-сайти зможуть запитувати дозвіл на доступ до пристроїв із Bluetooth неподалік. Якщо для нього вибрано начення 2, доступ до пристроїв із Bluetooth неподалік буде заблоковано.\n\nЯкщо це правило не налаштовано, сайти зможуть запитувати дозвіл, але користувачі матимуть можливість змінити цей параметр.";
DefaultWebHidGuardSetting.pfm_title = "Контролювати використання WebHID API";
DefaultWebHidGuardSetting.pfm_description = "2 - Заборонити всім сайтам запитувати дозвіл на доступ до пристроїв HID через WebHID API\n3 - Дозволити сайтам запитувати в користувача дозвіл на доступ до пристроїв HID\nЯкщо для цього правила вибрати значення 3, веб-сайти зможуть запитувати дозвіл на доступ до пристроїв HID. Якщо для нього вибрати значення 2, доступ буде заблоковано.\n\nЯкщо це правило не налаштувати, веб-сайти зможуть запитувати дозвіл, але користувачі матимуть можливість змінити цей параметр.\n\nЦе правило можна перевизначити для певних шаблонів url-адрес за допомогою правил WebHidAskForUrls і WebHidBlockedForUrls.";
DefaultWebUsbGuardSetting.pfm_title = "Контролювати використання API WebUSB";
DefaultWebUsbGuardSetting.pfm_description = "2 - Заборонити всім сайтам запитувати доступ до пристроїв USB через API WebUSB\n3 - Дозволити сайтам запитувати в користувача доступ до підключеного пристрою USB\nЯкщо для цього правила вибрано значення 3, веб-сайти зможуть запитувати дозвіл на доступ до підключених пристроїв USB. Якщо для нього вибрано значення 2, доступ до пристроїв USB буде заблоковано.\n\nЯкщо це правило не налаштовано, веб-сайти зможуть запитувати дозвіл, але користувачі матимуть можливість змінити цей параметр.";
DefaultWindowManagementSetting.pfm_title = "Налаштування керування вікнами за умовчанням";
DefaultWindowManagementSetting.pfm_description = "2 - Забороняє керування вікнами на всіх сайтах за умовчанням\n3 - Запитувати щоразу, коли сайт хоче отримати дозвіл на керування вікнами\nЯкщо для правила вибрати BlockWindowManagement (значення 2), керування вікнами буде автоматично заборонено на всіх сайтах за умовчанням. Таким чином сайти не зможуть переглядати інформацію про екрани пристрою та використовувати її, щоб відкривати й розміщувати вікна чи надсилати запити на повноекранний режим на певних екранах.\n\nЯкщо для правила вибрати AskWindowManagement (значення 3), за умовчанням користувач бачитиме сповіщення, коли буде надсилатися запит на дозвіл керувати вікнами. Якщо користувач погодиться, сайти зможуть переглядати інформацію про екрани пристрою та використовувати її, щоб відкривати й розміщувати вікна чи надсилати запити на повноекранний режим на певних екранах.\n\nЯкщо це правило не налаштувати, застосовуватиметься правило AskWindowManagement, але користувачі зможуть змінити цей параметр.\n\nЦе правило замінює правило DefaultWindowPlacementSetting, яке більше не підтримується.";
DeletingUndecryptablePasswordsEnabled.pfm_title = "Видаляти паролі, які неможливо розшифрувати";
DeletingUndecryptablePasswordsEnabled.pfm_description = "Це правило визначає, чи може вбудований менеджер паролів видаляти зі своєї бази даних паролі, які неможливо розшифрувати. Це дає змогу відновити роботу всіх функцій вбудованого менеджера паролів, однак деякі дані може бути втрачено назавжди. Значення таких паролів не дешифруються автоматично. Якщо пароль можливо розшифрувати вручну, користувачу потрібно буде виконати для цього низку складних дій.\n\nЯкщо ввімкнути або не налаштувати це правило, з вбудованого менеджера паролів буде видалено збережені паролі користувачів, які неможливо розшифрувати. Дійсні паролі не зазнають змін.\n\nЯкщо вимкнути це правило, дані менеджера паролів буде збережено, але його функції не працюватимуть належним чином.\n\nЯкщо це правило налаштовано, користувачі не зможуть змінювати його в Brave.";
DesktopSharingHubEnabled.pfm_title = "Увімкнути спільний доступ в Універсальному вікні пошуку та меню з трьома крапками";
DesktopSharingHubEnabled.pfm_description = "Якщо вибрати для цього правила значення True або не налаштовувати його, користувачі зможуть зберігати поточні веб-сторінки й ділитися ними за допомогою дій у центрі спільного доступу. Відкрити центр спільного доступу можна через Універсальне вікно пошуку або меню з трьома крапками.\n\nЯкщо вибрати для цього правила значення False, з Універсального вікна пошуку буде видалено значок, а з меню з трьома крапками — відповідний пункт.";
DevToolsGenAiSettings.pfm_title = "Налаштування функцій на основі генеративного ШІ для сторінки \"Chrome DevTools\"";
DevToolsGenAiSettings.pfm_description = "0 - Дозволити використовувати функції на основі генеративного ШІ на сторінці \"Chrome DevTools\" і покращувати моделі ШІ.\n1 - Дозволити використовувати функції на основі генеративного ШІ на сторінці \"Chrome DevTools\" без покращення моделей ШІ.\n2 - Заборонити використовувати функції на основі генеративного ШІ на сторінці \"Chrome DevTools\"\nЦі функції на сторінці \"Chrome DevTools\" використовують моделі генеративного штучного інтелекту, щоб надавати додаткову інформацію про налагодження. Щоб використовувати ці функції, Brave має збирати такі дані, як повідомлення про помилки, трасування стека, фрагменти коду й запити мережі, і надсилати їх на сервер Google, який використовує модель генеративного ШІ. Заголовок відповіді, автентифікація і заголовки файлів cookie в запитах мережі не включаються в дані, які надсилаються на сервер.\n\n\"0\" – увімкнути пов’язані функції і надсилати в Google відповідні дані для покращення моделей штучного інтелекту. Залежно від функції надсилатися можуть запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки. Спеціалісти можуть перевіряти такі матеріали, щоб покращувати моделі штучного інтелекту. Значення \"0\" використовується за умовчанням, за винятком наведених нижче випадків.\n\n\"1\" – увімкнути пов’язані функції, але не надсилати в Google контент користувачів (зокрема запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки) для покращення моделей штучного інтелекту. Значення \"1\" застосовується за умовчанням для корпоративних користувачів, якими керують через Google Admin console, і облікових записів закладів освіти, якими керують через Google Workspace.\n\n\"2\" – заборонити використовувати пов’язані функції.\n\nЯкщо не налаштувати це правило, його поведінка визначатиметься правилом GenAiDefaultSettings.\n\nНижче наведено деякі функції генеративного ШІ на сторінці \"Chrome DevTools\".\n\n– Console Insights: пояснення повідомлень у консолі й надсилання пропозицій щодо виправлення помилок.\n\n– Допомога ШІ: пояснення стилів CSS (починаючи з версії 131), запитів мережі, ефективності й файлів (у версії 132 і новіших).\n\nЩоб дізнатися більше про обробку даних для функцій на основі генеративного ШІ, перейдіть на сторінку https://support.google.com/chrome/a?p=generative_ai_settings.";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_title = "Увімкнути профілі Google Developer Program у сервісі \"Chrome DevTools\"";
DevToolsGoogleDeveloperProgramProfileAvailability.pfm_description = "0 - Увімкнути інтеграцію Google Developer Program у сервісі \"Chrome DevTools\".\n1 - Увімкнути інтеграцію Google Developer Program у сервісі \"Chrome DevTools\", але не ділитися даними про використання інструментів (для присвоєння значків).\n2 - Не вмикати інтеграцію Google Developer Program у сервісі \"Chrome DevTools\".\nЦе правило керує інтеграцією Google Developer Program у сервісі \"Chrome DevTools\". Профіль користувача в Google Developer Program відображається в сервісі \"Chrome DevTools\", а користувачі отримують значки за виконання певних дій у сервісі \"Chrome DevTools\".\n\nЯкщо вибрати значення \"0\" (\"Увімкнено\") або не налаштувати це правило, буде дозволено інтегрувати Google Developer Program у сервісі \"Chrome DevTools\" і ділитися даними про використання сервісу \"Chrome DevTools\", щоб отримувати значки.\n\nЯкщо вибрати значення \"1\" (\"Увімкнено без значків\"), буде дозволено інтегрувати Google Developer Program у сервісі \"Chrome DevTools\", але дані про використання сервісу \"Chrome DevTools\" не надсилатимуться в Google Developer Program. Значки не присвоюватимуться.\n\nЯкщо для цього правила вибрати значення \"2\" (\"Вимкнено\"), буде заборонено інтегрувати Google Developer Program у сервісі \"Chrome DevTools\".";
DeveloperToolsAvailability.pfm_title = "Вибрати, де можна використовувати Chrome DevTools";
DeveloperToolsAvailability.pfm_description = "0 - Заборонити використовувати Chrome DevTools у додатках і розширеннях, установлених згідно з корпоративними правилами, і розширеннях, вбудованих у вебпереглядач (починаючи з версії 114 і якщо це керований користувач). Дозволити використовувати Chrome DevTools в інших випадках.\n1 - Дозволити використовувати Chrome DevTools\n2 - Заборонити використовувати Chrome DevTools\nЯкщо для цього правила вибрати значення \"0\" (за умовчанням), ви зможете використовувати Chrome DevTools і Консоль JavaScript, однак не в контексті розширень, установлених згідно з корпоративними правилами, і (за умови, що використовується версія 114 або новіша і йдеться про керованого користувача) розширень, вбудованих у вебпереглядач. Якщо для цього правила вибрати значення \"1\", ви зможете використовувати Chrome DevTools і Консоль JavaScript в усіх контекстах, зокрема для розширень, установлених згідно з корпоративними правилами. Якщо для цього правила вибрати значення \"2\", ви не зможете використовувати Chrome DevTools і перевіряти елементи вебсайту.\n\nЦе налаштування також вимикає комбінації клавіш і пункти меню або контекстного меню, які відкривають Chrome DevTools чи Консоль JavaScript.\n\nУ версії Brave 99 це налаштування також визначає точки входу для функції \"Переглянути джерело сторінки\". Якщо для цього правила вибрати значення \"2\" (DeveloperToolsDisallowed), користувачі не зможуть переглянути джерело за допомогою комбінації клавіш чи контекстного меню. Щоб повністю заборонити перегляд джерела, додайте елемент view-source:* до правила URLBlocklist.\n\nУ версії Brave 119 це налаштування також визначає, чи можна активувати й використовувати режим розробника для ізольованих вебдодатків.\n\nУ версії Brave 128 це налаштування не керуватиме режимом розробника на сторінці розширень, якщо ввімкнути правило ExtensionDeveloperModeSettings.\n\nЦе правило впливає на Chrome DevTools, прямий доступ до Chrome DevTools Protocol (CDP) (наприклад, у разі запуску з параметром --remote-debugging-port або --remote-debugging-pipe) і доступ до Chrome DevTools Protocol (CDP) через API chrome.debugger. Це правило застосовується разом з іншим – RemoteDebuggingAllowed. RemoteDebuggingAllowed визначає, чи можна почати дистанційне налагодження, а це – обмежує можливість перевіряти окремі цільові об’єкти, навіть коли дистанційне налагодження запущено.\n\nПравила DeveloperToolsAvailabilityAllowlist і DeveloperToolsAvailabilityBlocklist мають перевагу над цим правилом. Нижче описано, у якому порядку доступні Chrome DevTools.\n1. Якщо URL-адреса відповідає шаблону в правилі DeveloperToolsAvailabilityAllowlist, Chrome DevTools буде дозволено.\n2. Якщо налаштувати правило DeveloperToolsAvailabilityAllowlist, однак не налаштувати правило DeveloperToolsAvailabilityBlocklist, усі URL-адреси, яких немає в білому списку, буде заблоковано.\n3. Якщо URL-адреса відповідає шаблону в правилі DeveloperToolsAvailabilityBlocklist, Chrome DevTools буде заблоковано.\n4. Якщо не налаштувати ці правила або URL-адреса не відповідає жодному списку, застосовується правило DeveloperToolsAvailability.";
DeveloperToolsAvailabilityAllowlist.pfm_title = "Список шаблонів URL-адрес, для яких дозволено відкривати Chrome DevTools";
DeveloperToolsAvailabilityAllowlist.pfm_description = "За допомогою цього правила можна дозволити Chrome DevTools для певних URL-адрес.\n\nМожливість використовувати Chrome DevTools визначається на рівні цільового об’єкта. Шаблони URL-адрес зіставляються з URL-адресою кожного цільового об’єкта, що перевіряється (наприклад, основного фрейму сторінки, вбудованого підфрейму, розширення або вебдодатка). Результат залежить від того, чи налаштовано правило DeveloperToolsAvailabilityBlocklist.\n\nЯкщо налаштувати це правило, однак не налаштувати DeveloperToolsAvailabilityBlocklist, Chrome DevTools буде дозволено для цільового об’єкта лише за умови, що його URL-адреса відповідає шаблону із цього білого списку. Якщо URL-адреса цільового об’єкта не відповідає шаблону з білого списку, Chrome DevTools буде заблоковано для цього об’єкта. Наприклад, підфрейм, URL-адреси якого немає в білому списку, не можна перевірити, однак основна сторінка залишається доступною для перевірки, якщо її URL-адресу додано в білий список. Щоб дізнатися більше про формат URL-адрес, перейдіть за цим посиланням: https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nЯкщо налаштувати і це правило, і DeveloperToolsAvailabilityBlocklist, білий список матиме перевагу. Якщо URL-адреса цільового об’єкта відповідає шаблону із цього білого списку, її буде дозволено, навіть якщо вона також збігається із шаблоном у чорному списку. Якщо вона відповідає шаблону із чорного списку (однак не збігається з жодним записом у білому), її буде заблоковано. Якщо URL-адреса цільового об’єкта не відповідає жодному із цих правил, застосовуватиметься правило DeveloperToolsAvailability.\n\nЯкщо це правило не налаштувати, Chrome DevTools регулюватимуться правилами DeveloperToolsAvailabilityBlocklist і DeveloperToolsAvailability.\n\nУніверсальні символи підстановки (наприклад, \"*\" або \"[*]\") використовувати не можна. Щоб увімкнути цю функцію для всіх вебсайтів, застосуйте правило DeveloperToolsAvailability.\n\nЦе правило впливає на Chrome DevTools, прямий доступ до Chrome DevTools Protocol (CDP) (наприклад, у разі запуску з параметром --remote-debugging-port або --remote-debugging-pipe) і доступ до Chrome DevTools Protocol (CDP) через API chrome.debugger. Це правило застосовується разом з іншим – RemoteDebuggingAllowed. RemoteDebuggingAllowed визначає, чи можна почати дистанційне налагодження, а це – обмежує можливість перевіряти окремі цільові об’єкти, навіть коли дистанційне налагодження запущено.\n\nМаксимальна кількість записів у цьому правилі – 1000.";
DeveloperToolsAvailabilityBlocklist.pfm_title = "Список шаблонів URL-адрес, для яких заблоковано Chrome DevTools";
DeveloperToolsAvailabilityBlocklist.pfm_description = "За допомогою цього правила можна блокувати Chrome DevTools для певних URL-адрес. Щоб дізнатися більше про формат URL-адрес, перейдіть за цим посиланням: https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nДоступність сервісу Chrome DevTools визначається на рівні цільового об’єкта. Шаблони URL-адрес зіставляються з URL-адресою кожного цільового об’єкта, що перевіряється (наприклад, основного фрейму сторінки, вбудованого підфрейму, розширення або вебдодатка). Результат залежить від того, чи налаштовано правило DeveloperToolsAvailabilityAllowlist.\n\nЯкщо налаштувати це правило, однак не налаштувати DeveloperToolsAvailabilityAllowlist, Chrome DevTools буде заблоковано для цільового об’єкта, URL-адреса якого відповідає шаблону із цього чорного списку. Наприклад, підфрейм, URL-адреса якого є в чорному списку, не можна перевірити, однак основна сторінка залишається доступною для перевірки, якщо її URL-адреси немає в чорному списку. Якщо URL-адреса цільового об’єкта не збігається з жодним шаблоном, доступність визначатиме правило DeveloperToolsAvailability.\n\nЯкщо налаштувати і це правило, і DeveloperToolsAvailabilityAllowlist, білий список матиме перевагу. Якщо URL-адреса цільового об’єкта відповідає шаблону з білого списку, її буде дозволено, навіть якщо вона також збігається із шаблоном у чорному списку. Якщо вона відповідає шаблону із чорного списку (однак не збігається з жодним записом у білому), її буде заблоковано. Якщо URL-адреса цільового об’єкта не відповідає жодному із цих правил, застосовуватиметься правило DeveloperToolsAvailability.\n\nЯкщо це правило не налаштувати, Chrome DevTools регулюватимуться правилами DeveloperToolsAvailabilityAllowlist і DeveloperToolsAvailability.\n\nЦе правило впливає на Chrome DevTools, прямий доступ до Chrome DevTools Protocol (CDP) (наприклад, у разі запуску з параметром --remote-debugging-port або --remote-debugging-pipe) і доступ до Chrome DevTools Protocol (CDP) через API chrome.debugger. Це правило застосовується разом з іншим – RemoteDebuggingAllowed. RemoteDebuggingAllowed визначає, чи можна почати дистанційне налагодження, а це – обмежує можливість перевіряти окремі цільові об’єкти, навіть коли дистанційне налагодження запущено.\n\nМаксимальна кількість записів у цьому правилі – 1000.";
Disable3DAPIs.pfm_title = "Вимкнути підтримку API для 3D-графіки";
Disable3DAPIs.pfm_description = "Якщо для цього правила вибрати значення \"правда\" (або для правила HardwareAccelerationModeEnabled – \"неправда\"), вебсторінки не матимуть доступу до WebGL API.\n\nЯкщо для цього правила вибрати значення \"неправда\" або не налаштувати його, вебсторінки зможуть використовувати WebGL API. Можливо, для використання цих API у вебпереглядачі з налаштуваннями за умовчанням усе одно потрібно буде вводити аргументи командного рядка.";
DisableAuthNegotiateCnameLookup.pfm_title = "Вимкнути пошук CNAME під час узгодження автентифікації за протоколом Kerberos";
DisableAuthNegotiateCnameLookup.pfm_description = "Якщо ввімкнути це правило, пошук CNAME пропускатиметься. Використовується назва сервера, введена під час створення SPN для протоколу Kerberos.\n\nЯкщо вимкнути це правило або не налаштувати його, пошук CNAME визначатиме канонічну назву сервера під час створення SPN для протоколу Kerberos.";
DisablePrintPreview.pfm_title = "Вимкнути попередній перегляд друку";
DisablePrintPreview.pfm_description = "Якщо це правило ввімкнено, Brave відкриває системне вікно друку, а не вбудоване вікно попереднього перегляду.\n\nЯкщо вимкнути або не налаштувати це правило, команди друку викликають вікно попереднього перегляду.";
DisableSafeBrowsingProceedAnyway.pfm_title = "Вимикати переходи зі сторінки застереження Безпечного перегляду";
DisableSafeBrowsingProceedAnyway.pfm_description = "Якщо це правило активовано, користувачі не можуть переходити зі сторінки застереження, яку сервіс Безпечний перегляд показує на шкідливому сайті. Це правило блокує перехід лише зі сторінки застереження (наприклад, щодо зловмисного програмного забезпечення або фішингу) і не поширюється на проблеми, пов'язані з недійсними або простроченими сертифікатами SSL.\n\nЯкщо це правило деактивовано або не налаштовано, користувачі можуть вибрати, чи переходити після показу застереження на потенційно шкідливий сайт.\n\nДокладніше про Безпечний перегляд читайте на сторінці https://developers.google.com/safe-browsing.";
DisableScreenshots.pfm_title = "Вимикати знімки екрана";
DisableScreenshots.pfm_description = "Якщо ввімкнути це правило, знімки екрана не можна буде робити за допомогою комбінацій клавіш або API розширення. Якщо його вимкнути або не налаштувати, знімки екрана буде дозволено.\n\nПочинаючи з версії Brave 154, розширення також не зможуть підключати засіб налагодження за допомогою функції chrome.debugger.attach(), якщо ввімкнути це правило.\n\nЗверніть увагу: це правило не забороняє робити знімки екрана на пристроях Microsoft® Windows®, macOS і Linux за допомогою інструментів операційної системи або сторонніх додатків.";
DiskCacheDir.pfm_title = "Налаштування каталогу кешу на диску";
DiskCacheDir.pfm_description = "Якщо це правило налаштовано, Brave зберігає кешовані файли в зазначеному каталозі на диску, незалежно від того, чи користувачі вказали правило --disk-cache-dir.\n\nЯкщо його не налаштовано, Brave використовує каталог для кешу за умовчанням, але користувачі можуть змінити цей параметр за допомогою правила командного рядка --disk-cache-dir.\n\nBrave керує вмістом кореневого каталогу тому. Щоб уникнути втрат даних та інших помилок, не налаштовуйте для цього правила кореневий каталог або каталог, який використовується для інших цілей. Список можливих змінних доступний на сторінці https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DiskCacheSize.pfm_title = "Налаштування обсягу кешу диска";
DiskCacheSize.pfm_description = "Якщо для цього правила вибрати значення None, Brave використовуватиме стандартний обсяг кеш-пам’яті на диску. Користувачі не можуть змінити це правило.\n\nЯкщо ви налаштуєте його, Brave використовуватиме зазначений обсяг кеш-пам’яті на диску, незалежно від того, чи задали користувачі експериментальний параметр --disk-cache-size. (Значення, менші ніж кілька мегабайт, округлюються.)\n\nЯкщо це правило не налаштувати, Brave використовуватиме обсяг пам’яті за умовчанням. Користувачі можуть змінити цей обсяг за допомогою експериментального параметра --disk-cache-size.\n\nПримітка: задане для цього правила значення використовується як підказка для різних підсистем кешу у веб-переглядачі. Таким чином, загалом усі кеші займатимуть більше місця на диску (але в межах того ж порядку величини, що й указане значення).";
DnsOverHttpsMode.pfm_title = "Керує режимом DNS-over-HTTPS";
DnsOverHttpsMode.pfm_description = "off - Вимкнути DNS-over-HTTPS\nautomatic - Увімкнути DNS-over-HTTPS із небезпечним резервним варіантом\nsecure - Увімкнути DNS-over-HTTPS без небезпечного резервного варіанту\nControls the mode of the DNS-over-HTTPS resolver. Please note that this\npolicy will only set the default mode for each query. The mode may be\noverridden for special types of queries such as requests to resolve a\nDNS-over-HTTPS server hostname.\n\nThe \"off\" mode will disable\nDNS-over-HTTPS.\n\nThe \"automatic\" mode will send\nDNS-over-HTTPS queries first if a DNS-over-HTTPS server is available and\nmay fallback to sending insecure queries on error.\n\nThe \"secure\" mode will only send\nDNS-over-HTTPS queries and will fail to resolve on error.\n\nOn Android Pie and above, if DNS-over-TLS\nis active, Brave will not\nsend insecure DNS requests.";
DnsOverHttpsTemplates.pfm_title = "Указати шаблон URI бажаного резолвера DNS-over-HTTPS";
DnsOverHttpsTemplates.pfm_description = "Шаблон URI бажаного резолвера DNS-over-HTTPS. Щоб указати кілька резолверів DNS-over-HTTPS, розділіть відповідні шаблони URI пробілами.\n\nЯкщо для параметра DnsOverHttpsMode вибрано значення \"secure\", потрібно налаштувати це правило й указати для нього значення. Лише для Google Chrome OS: перетворення DNS неможливе, якщо не налаштувати це правило або DnsOverHttpsTemplatesWithIdentifiers.\n\nЯкщо це правило налаштовано й для параметра DnsOverHttpsMode вибрано значення \"automatic\", то використовуватимуться вказані шаблони URI. Якщо правило не налаштовано, застосовуватимуться задані в коді програми зіставлення, щоб спробувати оновити поточний резолвер DNS користувача до резолвера DoH того самого постачальника.\n\nЯкщо шаблон URI містить змінну dns, запити резолверу використовуватимуть метод GET; в інших випадках – POST.\n\nНеправильно відформатовані шаблони ігноруватимуться.";
DomainReliabilityAllowed.pfm_title = "Дозволити надсилати дані про надійність доменів";
DomainReliabilityAllowed.pfm_description = "Якщо для цього правила вибрати значення \"неправда\", надсилання діагностичних даних про надійність доменів буде вимкнено й жодні дані не передаватимуться в Google.\nЯкщо це правило не налаштувати або вибрати для цього значення \"правда\", надсилання діагностичних даних про надійність доменів залежатиме від параметрів правила MetricsReportingEnabled для Brave чи DeviceMetricsReportingEnabled для Google Chrome OS.";
DownloadDirectory.pfm_title = "Установити каталог для завантаження";
DownloadDirectory.pfm_description = "Налаштування цього правила визначають каталог, який Chrome використовуватиме для завантаження файлів. Веб-переглядач застосовуватиме наданий каталог незалежно від того, що вибрав користувач: стале розташування чи опцію щоразу вказувати потрібне розташування для завантаження.\n\nЦе правило перевизначає правило DefaultDownloadDirectory.\n\nЯкщо це правило не налаштовано, Chrome застосовує каталог для завантаження за умовчанням, але користувачі зможуть змінити цей параметр.\n\nУ Google Chrome OS можна налаштувати лише каталоги Google Диска.\n\nПримітка: список можливих змінних доступний на сторінці https://www.chromium.org/administrators/policy-list-3/user-data-directory-variables.";
DownloadRestrictions.pfm_title = "Обмеження завантажень";
DownloadRestrictions.pfm_description = "0 - Особливих обмежень немає. За умовчанням.\n1 - Блокувати шкідливі завантаження й небезпечні типи файлів.\n2 - Блокувати шкідливі завантаження, нетипові чи небажані завантаження й небезпечні типи файлів.\n3 - Блокувати всі завантаження.\n4 - Блокувати шкідливі завантаження. Рекомендовано.\nЯкщо налаштувати це правило, користувачі не зможуть обходити рішення системи безпеки щодо завантажень.\n\nУ Chrome є багато типів попереджень щодо завантажень, які можна умовно поділити на наведені нижче категорії (докладнішу інформацію про рішення в Безпечному перегляді наведено на сторінці https://support.google.com/chrome/?p=ib_download_blocked).\n\n* Небезпечні (відповідно до позначення сервером Безпечного перегляду)\n* Нетипові чи небажані (відповідно до позначення сервером Безпечного перегляду)\n* Небезпечний тип файлу (наприклад, усі завантаження SWF і багато завантажень EXE)\n\nЯкщо налаштувати це правило, блокуватимуться різні набори таких файлів (залежно від вибраного значення).\n\n0. Немає особливих обмежень. Це значення за умовчанням.\n\n1. Блокувати шкідливі файли, позначені сервером Безпечного перегляду, А ТАКОЖ блокувати всі небезпечні типи файлів. Рекомендовано лише для організаційних підрозділів, вебпереглядачів і користувачів із високою толерантністю до хибнопозитивних помилок.\n\n2. Блокувати шкідливі файли ТА нетипові чи небажані файли, позначені сервером Безпечного перегляду, А ТАКОЖ блокувати всі небезпечні типи файлів. Рекомендовано лише для організаційних підрозділів, вебпереглядачів і користувачів із високою толерантністю до хибнопозитивних помилок.\n\n3. Блокувати всі завантаження. Не рекомендовано (крім особливих випадків).\n\n4. Блокувати шкідливі файли, позначені сервером Безпечного перегляду, але не блокувати небезпечні типи файлів. Рекомендовано.\n\nПримітка. Ці обмеження застосовуються до завантажень, які активовано контентом вебсторінки або опцією меню \"Завантажити дані за посиланням…\". Вони не діють під час завантаження відкритої сторінки чи зберігання контенту у форматі PDF через параметри друку. Докладнішу інформацію про Безпечний перегляд можна переглянути на сторінці https://developers.google.com/safe-browsing.";
EditBookmarksEnabled.pfm_title = "Увімкнути або вимкнути редагування закладок";
EditBookmarksEnabled.pfm_description = "Якщо ввімкнути або не налаштувати це правило, користувачі зможуть додавати, видаляти, змінювати або завантажувати закладки.\n\nЯкщо вимкнути це правило, користувачі не зможуть виконувати наведені вище дії, однак матимуть змогу користуватися наявними закладками.";
EmailAliasesEnabled.pfm_title = "Enable Email Aliases";
EmailAliasesEnabled.pfm_description = "Enable Email Aliases in Brave.\n\nEmail Aliases is a feature that allows users to sign up for services anonymously and keep their emails free from spam.\n\nIf this policy is set to true, Email Aliases will always be enabled.\n\nIf this policy is set to false, Email Aliases will always be disabled and all related UI elements will be hidden.\n\nIf you set this policy, users cannot change or override it.\n\nIf this policy is left unset, Email Aliases will be enabled by default (subject to user preferences).";
EnableAuthNegotiatePort.pfm_title = "Включити нестандартний порт в ім’я учасника сервера (SPN) за протоколом Kerberos";
EnableAuthNegotiatePort.pfm_description = "Якщо ввімкнути це правило й указати нестандартний порт (тобто не 80 чи 443), його буде включено в SPN для протоколу Kerberos.\n\nЯкщо вимкнути або не налаштувати це правило, створена назва SPN для протоколу Kerberos не міститиме порту.";
EnableExperimentalPolicies.pfm_title = "Вмикає експериментальні правила";
EnableExperimentalPolicies.pfm_description = "Дозволяє продукту Brave завантажувати експериментальні правила.\n\nПОПЕРЕДЖЕННЯ: експериментальні правила не підтримуються. У наступних версіях веб-переглядача їх можуть змінити або видалити без попередження.\n\nЕкспериментальне правило може бути незавершеним або містити відомі й невідомі нам проблеми. Ми можемо змінити або видалити його без попередження. Увімкнувши експериментальні правила, ви можете втратити дані веб-перегляду та створити загрозу своїй безпеці чи конфіденційності.\n\nЯкщо правила немає в списку й ми не випустили його офіційно, його значення ігноруватиметься в бета- й стабільній версіях.\n\nЯкщо правило є в списку, але ми не випустили його офіційно, його значення застосовуватиметься.\n\nЦе правило не впливає на вже випущені правила.";
EnableMediaRouter.pfm_title = "Увімкнути Google Cast";
EnableMediaRouter.pfm_description = "Якщо це правило ввімкнути або не налаштувати, активується функція Google Cast, яку користувачі можуть запустити з меню додатка, контекстних меню на сторінці, елементів керування медіаконтентом на веб-сайтах із підтримкою Google Cast, а також через значок на панелі інструментів Cast (якщо відображається).\n\nЯкщо це правило вимкнути, функція Google Cast деактивується.";
EnableOnlineRevocationChecks.pfm_title = "Увімкнути перевірки OCSP/CRL онлайн";
EnableOnlineRevocationChecks.pfm_description = "Якщо для цього правила вибрано значення True, онлайн-перевірки OCSP/CRL будуть здійснюватися.\n\nЯкщо для цього правила вибрано значення False або його не налаштовано, Brave не здійснюватиме онлайн-перевірки анулювання сертифікатів у Brave 19 і новіших версій.\n\nПримітка: перевірки OCSP/CRL не забезпечують ефективне покращення безпеки.";
EnableProxyOverrideRulesForAllUsers.pfm_title = "Визначає, які керовані користувачі можуть налаштовувати правила ProxyOverrideRules і ProxyProvisioningDomains.";
EnableProxyOverrideRulesForAllUsers.pfm_description = "Якщо не налаштувати це правило або вибрати для нього значення 0, правила ProxyOverrideRules і ProxyProvisioningDomains застосовуватимуться лише на рівні афілійованих користувачів у керованому вебпереглядачі.\nЯкщо вказати для цього правила значення 1, правила ProxyOverrideRules і ProxyProvisioningDomains застосовуватимуться на рівні користувача, навіть якщо він не афілійований.";
EnableUnsafeSwiftShader.pfm_title = "Дозвіл використовувати програмний резервний варіант WebGL SwiftShader";
EnableUnsafeSwiftShader.pfm_description = "Це правило визначає, чи використовуватиметься SwiftShader як резервний варіант WebGL, коли апаратне прискорення графічного процесора недоступне.\n\nРішення SwiftShader використовувалося для підтримки WebGL у системах без прискорення графічного процесора (наприклад, у системах без графічного інтерфейсу або віртуальних машинах), але його підтримку було припинено через проблеми з безпекою. Починаючи з версії M139, WebGL API не зможе створити контекст, якщо резервним варіантом є SwiftShader. Завдяки цьому правилу вебпереглядач або адміністратор може тимчасово відкласти припинення підтримки.\n\nЯкщо ввімкнути це правило, SwiftShader використовуватиметься як програмний резервний варіант WebGL.\n\nЯкщо вимкнути це правило або не налаштувати його, WebGL API не зможе створити контекст, коли апаратне прискорення графічного процесора недоступне. Вебсторінки можуть працювати неправильно, якщо вони не обробляють помилки створення контексту WebGL.\n\nЦе тимчасове правило, яке буде вилучено в майбутньому.";
EncryptedClientHelloEnabled.pfm_title = "Увімкнути розширення Encrypted ClientHello для TLS";
EncryptedClientHelloEnabled.pfm_description = "Encrypted ClientHello (ECH) – це розширення для TLS, яке шифрує поля повідомлення ClientHello з чутливими даними, а також покращує конфіденційність.\n\nЯкщо це правило не налаштовано або ввімкнено, Brave використовуватиме для ECH процес випуску за умовчанням. Якщо правило вимкнено, Brave не вмикатиме ECH.\n\nЯкщо цю функцію ввімкнено, Brave може використовувати ECH залежно від того, чи підтримує сервер це розширення, доступності запису DNS HTTPS або статусу випуску.\n\nРобота над протоколом ECH продовжується, тому спосіб його реалізації в Brave може змінитися. Це правило є тимчасовим рішенням, яке контролює реалізацію початкової експериментальної версії. Коли протокол буде готовий, це правило замінять кінцеві налаштування.";
EnterpriseCustomLabel.pfm_title = "Налаштування власної корпоративної мітки для керованого профілю";
EnterpriseCustomLabel.pfm_description = "Це правило керує спеціальною міткою, яка використовується для ідентифікації керованих профілів. У керованих профілях ця мітка відображатиметься поруч з аватаром на панелі інструментів. Спеціальна мітка не перекладатиметься.\n\nЯкщо застосувати це правило, усі сегменти, що містять більше ніж 16 символів, скорочуватимуться за допомогою символу \"…\". Не використовуйте довгі назви.\n\nЦе правило можна налаштувати лише на рівні користувача.\n\nЗверніть увагу, що це правило не діє, якщо для правила EnterpriseProfileBadgeToolbarSettings вибрано значення hide_expanded_enterprise_toolbar_badge (1).";
EnterpriseCustomLabelForBrowser.pfm_title = "Налаштування власної корпоративної мітки для керованого вебпереглядача";
EnterpriseCustomLabelForBrowser.pfm_description = "Це правило керує спеціальною міткою, яка використовується для позначення керованого вебпереглядача. У керованих вебпереглядачах ця мітка відображатиметься в нижньому колонтитулі сторінки нової вкладки в застереженні про адміністрування. Спеціальна мітка не перекладатиметься.\n\nЗверніть увагу, що це правило застосовується лише до керованих вебпереглядачів, тому воно не діє для керованих користувачів у некерованих вебпереглядачах.\n\nУ Microsoft® Windows® це правило застосовується лише для екземплярів, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS це правило доступне лише для екземплярів, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.";
EnterpriseHardwarePlatformAPIEnabled.pfm_title = "Дозволяє керованим розширенням використовувати Enterprise Hardware Platform API";
EnterpriseHardwarePlatformAPIEnabled.pfm_description = "Якщо для цього правила вибрано значення True, розширення, установлені згідно з корпоративним правилом, зможуть використовувати Enterprise Hardware Platform API.\n\nЯкщо для цього правила вибрано значення False або його не налаштовано, розширення не зможуть використовувати API.\n\nПримітка: це правило також застосовується до розширень компонентів, наприклад розширень сервісів Hangouts.";
EnterpriseLogoUrl.pfm_title = "URL-адреса корпоративного логотипа для керованого профілю";
EnterpriseLogoUrl.pfm_description = "URL-адреса зображення, яке використовуватиметься як корпоративний значок у керованому профілі. Вона має спрямовувати на зображення.\n\nЦе правило можна налаштувати лише на рівні користувача.\n\nРекомендовано використовувати значок вебсторінки (приклад: https://www.google.com/favicon.ico) або значок розміром не менше ніж 48 x 48 пікс.";
EnterpriseLogoUrlForBrowser.pfm_title = "URL-адреса корпоративного логотипа для керованого вебпереглядача";
EnterpriseLogoUrlForBrowser.pfm_description = "URL-адреса зображення, яке використовуватиметься як корпоративний значок у керованому вебпереглядачі. Вона має спрямовувати на зображення.\n\nРекомендовано використовувати значок вебсторінки (приклад: https://www.google.com/favicon.ico) або значок розміром не менше ніж 48 x 48 пікс.\n\nЗверніть увагу, що це правило застосовується лише до керованих вебпереглядачів, тому воно не діє для керованих користувачів у некерованих вебпереглядачах.\n\nУ Microsoft® Windows® це правило застосовується лише для екземплярів, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS це правило доступне лише для екземплярів, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.";
EnterpriseProfileBadgeToolbarSettings.pfm_title = "Керує видимістю корпоративного значка профілю на панелі інструментів";
EnterpriseProfileBadgeToolbarSettings.pfm_description = "0 - Показувати розгорнутий корпоративний значок на панелі інструментів\n1 - Приховати розгорнутий корпоративний значок на панелі інструментів\nДля профілів компаній і закладів освіти поруч з аватаром на панелі інструментів за умовчанням відображатиметься мітка \"Робота\" або \"Освіта\". Ця мітка показується, лише якщо виконано вхід у керований обліковий запис.\n\nЯкщо для цього правила вибрати значення hide_expanded_enterprise_toolbar_badge (1), корпоративний значок для керованого профілю не відображатиметься на панелі інструментів.\n\nЯкщо це правило не налаштувати або вибрати для нього значення show_expanded_enterprise_toolbar_badge (0), корпоративний значок відображатиметься.\n\nМітку можна налаштувати за допомогою правила EnterpriseCustomLabel.";
EnterpriseProfileCreationKeepBrowsingData.pfm_title = "Зберігати дані веб-перегляду під час створення корпоративного профілю за умовчанням";
EnterpriseProfileCreationKeepBrowsingData.pfm_description = "Якщо це правило ввімкнено, опцію зберігання наявних даних веб-перегляду під час створення корпоративного профілю буде ввімкнено за умовчанням.\n\nЯкщо це правило не налаштувати або вимкнути, опцію зберігання наявних даних веб-перегляду під час створення корпоративного профілю не буде ввімкнено за умовчанням.\n\nНезалежно від значення правила користувач зможе вирішувати, чи зберігати наявні дані веб-перегляду під час створення корпоративного профілю.\n\nЦе правило не діє, якщо опція зберігання наявних даних веб-перегляду недоступна. Це відбувається, якщо суворо дотримується розділення корпоративних профілів або якщо будуть використовуватися дані з керованого профілю.\n";
EnterpriseSearchAggregatorSettings.pfm_title = "Налаштування агрегатора корпоративного пошуку";
EnterpriseSearchAggregatorSettings.pfm_description = "За допомогою цього правила адміністратори можуть налаштувати корпоративний агрегатор пошуку, який надаватиме підказки й результати в універсальному вікні (адресному рядку) і полі пошуку на сторінці нової вкладки.\n\nЗа умовчанням підказки, надані корпоративним агрегатором пошуку, відображатимуться разом зі звичайними підказками від Brave. Щоб бачити лише підказки від корпоративного агрегатора, користувачі можуть ввести в універсальному вікні ключове слово з поля shortcut, наприклад @work (символ @ додавати необов’язково), а потім натиснути пробіл або клавішу Tab. Обмежений пошук, який запускається за допомогою ключового слова, зараз не підтримується в полі пошуку на сторінці нової вкладки.\n\nУкажіть значення для таких полів: name, shortcut, search_url і suggest_url.\n\nУ полі name указується назва пошукової системи, що відображатиметься в адресному рядку.\n\nУ полі shortcut указується ключове слово, за допомогою якого користувач запускає пошук. Воно може складатися зі звичайних слів і символів, однак не має містити пробілів або починатися із символу @. Ключові слова мають бути унікальними.\n\nУ полі search_url указується URL-адреса, за якою потрібно виконати пошук. Введіть вебадресу сторінки результатів пошукової системи й замість запиту вставте '{searchTerms}'.\n\nУ полі suggest_url указується URL-адреса, з якої надаються підказки в пошуку. Буде надіслано запит POST, а запит користувача буде передано в параметрах POST під ключем 'query'.\n\nУ полі icon_url указується URL-адреса зображення, яке використовуватиметься для підказок у пошуку. Якщо це поле не налаштувати, використовуватиметься значок за умовчанням. Рекомендуємо використовувати значок вебсторінки (наприклад, https://www.google.com/favicon.ico). Підтримуються такі формати файлу зображення: JPEG, PNG й ICO.\n\nУ полі require_shortcut можна визначити, чи обов’язково використовувати в адресному рядку ключове слово з поля shortcut, щоб переглядати підказки в пошуку. Якщо потрібно, підказки не показуватимуться в полі пошуку на сторінці нової вкладки, проте й далі відображатимуться в універсальному вікні (адресному рядку) у режимі обмеженого пошуку. Якщо не налаштувати це поле, використовувати в адресному рядку ключове слово з поля shortcut необов’язково.\n\nУ Microsoft® Windows® це правило застосовується лише для екземплярів, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS це правило доступне лише для екземплярів, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=EnterpriseSearchAggregatorSettings.";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_title = "Вимкнути завантаження попереджень про розширення типів файлів для вибраних типів файлів у доменах";
ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.pfm_description = "Ви можете ввімкнути це правило, щоб створити список розширень типів файлів і відповідних доменів, для яких не показуватиметься попередження на основі розширень. Завдяки цьому адміністратори підприємств можуть блокувати попередження про завантаження файлів, розширення яких пов’язані з доменом у списку. Наприклад, якщо розширення jnlp пов’язане з вебсайтом website1.com, під час завантаження файлів jnlp з вебсайту website1.com користувачі не бачитимуть попередження, а якщо ті самі файли надходитимуть із вебсайту website2.com – бачитимуть.\n\nНа файли, розширення яких пов’язані з доменами за допомогою цього правила, і надалі поширюватимуться попередження про безпеку, які не стосуються розширень типів файлів, наприклад попередження про завантаження змішаного контенту й застереження Безпечного перегляду.\n\nЯкщо вимкнути або не налаштувати це правило, у разі появи типів файлів, які активують попередження про завантаження на основі розширення, користувачам показуватимуться застереження.\n\nЯкщо ввімкнути це правило:\n\n* Шаблон URL-адреси потрібно відформатувати відповідно до вказівок на сторінці https://chromeenterprise.google/policies/url-patterns/.\n\n* Введене розширення типу файлів має бути вказано малими літерами ASCII. Назви розширень потрібно вказувати без роздільника, наприклад \"jnlp\" замість \".jnlp\".\n\nПриклад\n\nУ цьому прикладі показано, як заборонити показ попереджень на основі розширення типу файлу для розширень exe і jnlp в доменах *.example.com, а також для розширень swf у всіх доменах. Користувачі бачитимуть попередження про завантаження на основі розширення типу файлу в будь-якому іншому домені для файлів exe і jnlp, але не swf.\n\n[\n{ \"file_extension\": \"jnlp\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"exe\", \"domains\": [\"example.com\"] },\n{ \"file_extension\": \"swf\", \"domains\": [\"*\"] }\n]\n\nЗверніть увагу: хоча в попередньому прикладі показано блокування попередження про завантаження на основі розширень для файлів swf у всіх доменах, з міркувань безпеки ми не радимо застосовувати блокування таких попереджень для небезпечних розширень у всіх доменах. У прикладі ми просто показали, що це можна зробити.\n\nЯкщо це правило ввімкнено разом із правилом DownloadRestrictions, винятки з попереджень про завантаження на основі розширень, указані в цьому правилі, матимуть перевагу над налаштуванням правила DownloadRestrictions, яке має блокувати небезпечні типи файлів. Указані в цьому правилі винятки застосовуються лише до поведінки \"Блокувати небезпечні типи файлів\", обумовленої значеннями 1 і 2 правила DownloadRestrictions.\n\nНаприклад, якщо це правило виключає завантаження файлів із розширенням exe із сайту website1.com, а правило DownloadRestrictions налаштовано так, щоб блокувати шкідливі завантаження й небезпечні типи файлів (значення 1), завантаження файлів із розширенням exe із сайту website1.com не блокуватимуться на основі розширення – однак блокуватимуться, якщо файли шкідливі.\n\nДокладніше про правило DownloadRestrictions читайте на сторінці https://chromeenterprise.google/policies/?policy=DownloadRestrictions.\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=ExemptDomainFileTypePairsFromFileTypeDownloadWarnings.";
ExplicitlyAllowedNetworkPorts.pfm_title = "Дозволені мережеві порти";
ExplicitlyAllowedNetworkPorts.pfm_description = "554 - порт 554 (можна розблокувати до 15.10.2021)\n10080 - порт 10080 (можна розблокувати до 01.04.2022)\n6566 - порт 6566 (можна розблокувати до 15.10.2021)\n989 - порт 989 (можна розблокувати до 01.02.2022)\n990 - порт 990 (можна розблокувати до 01.02.2022)\nІснує список портів з обмеженнями, вбудованих у Brave. Підключитися до таких портів не вдасться. Це налаштування дозволяє обійти цей список. Значення – це список із нуля або більше портів, відокремлених комами, для яких будуть дозволені вихідні з’єднання.\n\nДля портів прописано обмеження, згідно з якими Brave не можна використовувати для різних прогалин мережі. Налаштування цього правила можуть наражати мережу на атаки. Це правило діє як тимчасове рішення для помилок із кодом ERR_UNSAFE_PORT, які виникають під час перенесення сервісу, який виконується на заблокованому порті, на стандартний порт (наприклад, порт 80 або 443).\n\nШкідливі веб-сайти можуть легко виявляти, що це правило налаштоване й для яких портів, і використовувати цю інформацію для цілеспрямованих атак.\n\nКожний порт у списку має мітку з датою, до якої його можна розблокувати. Після цієї дати для порту діятимуть обмеження (незалежно від налаштування).\n\nЯкщо значення пусте або не вказане, усі порти з обмеженнями буде заблоковано. Якщо є дійсні й недійсні значення, застосовуватимуться лише дійсні.\n\nПравило замінює параметр командного рядка --explicitly-allowed-ports.";
ExtensibleEnterpriseSSOBlocklist.pfm_title = "Чорний список постачальників ідентифікаційної інформації, які не можуть використовувати Систему єдиного входу Extensible Enterprise SSO у вебпереглядачі";
ExtensibleEnterpriseSSOBlocklist.pfm_description = "all - Усі постачальники ідентифікаційної інформації\nmicrosoft - Хмарний постачальник ідентифікаційної інформації Microsoft®\nokta - Хмарний постачальник ідентифікаційної інформації Okta®\nping - Хмарний постачальник ідентифікаційної інформації Ping®\nВимкнути систему єдиного входу (Extensible Enterprise SSO) для вказаних постачальників ідентифікаційної інформації.\n\nЯкщо вибрати значення 'all', систему єдиного входу буде вимкнено для всіх підтримуваних постачальників ідентифікаційної інформації.\n\nЯкщо вказати значення 'microsoft', систему єдиного входу в Chrome буде вимкнено для хмарного постачальника ідентифікаційної інформації Microsoft®.\n\nЯкщо не налаштувати це правило, систему єдиного входу буде ввімкнено для всіх постачальників ідентифікаційної інформації, які підтримуються в Brave.\n\nЯкщо адміністратор увімкнув постачальника ідентифікаційної інформації в Brave і налаштував його на пристрої, то користувачі, які ввійшли за допомогою цього постачальника в будь-який додаток, що підтримує систему єдиного входу Extensible Enterprise SSO, можуть і далі автоматично входити у вебресурси за допомогою цього постачальника. Дані, пов’язані з автентифікацією користувача, передаються постачальнику під час кожної події автентифікації.\n\nПримітки\n\nBrave не підтримує систему єдиного входу Extensible Enterprise SSO в анонімному режимі й режимі гостя.\n\nBrave підтримує систему єдиного входу Extensible Enterprise SSO лише для таких постачальників ідентифікаційної інформації: Microsoft, Okta, Ping.\n\nЦя функція доступна на пристроях із macOS 10.15 і новіших версій.";
ExtensionAllowedTypes.pfm_title = "Типи розширень або програм, які дозволено встановлювати";
ExtensionAllowedTypes.pfm_description = "extension - Розширення\ntheme - Тема\nuser_script - Скрипт користувача\nhosted_app - Розміщений додаток\nlegacy_packaged_app - Застарілий пакетний додаток\nplatform_app - Додаток платформи\nЦе правило дає змогу налаштувати, які додатки й розширення можна встановлювати в Brave, а також указати хости, з якими вони можуть взаємодіяти, і обмежити час виконання.\n\nЯкщо не налаштувати це правило, до прийнятних типів розширень і додатків не застосовуватимуться обмеження.\n\nТипи розширень і додатків, яких немає в списку, не встановлюються. Кожне значення має бути одним із рядків нижче.\n\n* \"extension\"\n\n* \"theme\"\n\n* \"user_script\"\n\n* \"hosted_app\"\n\n* \"legacy_packaged_app\"\n\n* \"platform_app\"\n\n    Докладніше про ці типи можна дізнатися в документації Brave щодо розширень.\n\nДо версії 75 не підтримується введення кількох ідентифікаторів розширень через кому. Решта правила застосовується.\n\nПримітка: це правило також впливає на примусове встановлення розширень і додатків через ExtensionInstallForcelist.\n\nПримітка. Це правило застосовується лише до платформ, які підтримують розширення.";
ExtensionDeveloperModeSettings.pfm_title = "Керувати доступністю режиму розробника на сторінці розширень";
ExtensionDeveloperModeSettings.pfm_description = "0 - Дозволити використання режиму розробника на сторінці розширень\n1 - Заборонити використання режиму розробника на сторінці розширень\nЗа допомогою цього правила можна вибрати, чи зможуть користувачі вмикати режим розробника на сторінці chrome://extensions.\n\nЯкщо це правило не налаштувати, користувачі зможуть вмикати режим розробника на сторінці розширень за умови, що для правила DeveloperToolsAvailability не вибрано значення DeveloperToolsDisallowed (2).\nЯкщо для правила вибрати значення Allow (0), користувачі зможуть вмикати режим розробника на сторінці розширень.\nЯкщо для правила вибрати значення Disallow (1), користувачі не зможуть цього робити.\n\nЯкщо налаштувати це правило, то правило DeveloperToolsAvailability більше не керуватиме режимом розробника.\n\nПримітка. Це правило застосовується лише до платформ, які підтримують розширення.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_title = "Налаштувати список джерел, які подовжують час роботи підключених розширень у фоновому режимі.";
ExtensionExtendedBackgroundLifetimeForPortConnectionsToUrls.pfm_description = "Розширення, які підключаються до одного з цих джерел, працюватимуть, доки підключено порт.\n\nЯкщо це правило не налаштувати, використовуватимуться значення за умовчанням. Нижче перелічено джерела додатків із пакетами SDK, що не дають змоги відновити попередній стан перерваного підключення.\n– Smart Card Connector\n– Citrix Receiver (стабільна, резервна й бета-версії)\n– VMware Horizon (стабільна й бета-версії)\n\nЯкщо правило налаштувати, у список за умовчанням буде додано нові задані значення. Як стандартні, так і задані правилом значення робитимуть виняток для підключених розширень, доки підключено порт.";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_title = "Увімкнути розширення, які встановлюються правилами й перевизначають налаштування пошукової системи за умовчанням або сторінки нової вкладки";
ExtensionForceInstallWithSearchOrNewTabOverridesEnabled.pfm_description = "Це правило визначає, чи дозволено в середовищах із низьким рівнем довіри використовувати розширення, які встановлюються правилами (примусово або за рекомендацією) і змінюють налаштування пошукової системи за умовчанням або сторінки нової вкладки.\n\nЦе правило застосовується лише до середовищ із низьким рівнем довіри (наприклад, пристроїв, на яких правила налаштовуються локально й не керуються через домен або хмарний сервіс). Це правило не впливає на середовища з високим рівнем довіри.\n\nУ Microsoft® Windows® це правило не застосовується для екземплярів, які зареєстровано в доменах Microsoft® Active Directory®, Microsoft® Azure® Active Directory® чи сервісі Chrome Enterprise Core.\n\nУ macOS це правило недоступне для екземплярів, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.\n\nУ цих середовищах із високим рівнем довіри розширення, які встановлюються правилами й перевизначають налаштування пошукової системи за умовчанням і сторінки нової вкладки, залишатимуться ввімкненими.\n\nЯкщо ввімкнути це правило, у середовищах із низьким рівнем довіри в Brave буде дозволено встановлювати за допомогою правил і використовувати розширення, які перевизначають налаштування пошукової системи за умовчанням або сторінки нової вкладки.\n\nЯкщо вимкнути або не налаштувати це правило, у середовищах із низьким рівнем довіри в Brave буде заборонено встановлювати відповідні розширення, а наявні розширення такого типу буде видалено.\n\nЯкщо таке розширення перестане перевизначати ці налаштування, Brave автоматично встановить його протягом 7 днів.\n\nЦе правило тимчасове. У майбутньому його буде вилучено.";
ExtensionInstallAllowlist.pfm_title = "Ідентифікатори розширень-винятків із чорного списку";
ExtensionInstallAllowlist.pfm_description = "Налаштування цього правила визначають, які розширення не потрапляють у чорний список.\n\nЗначення \"*\" у чорному списку означає, що всі розширення заборонені й користувачі можуть встановлювати лише ті, які є в білому списку.\n\nЗа умовчанням усі розширення дозволені. Якщо всі розширення внесено правилом у чорний список, білий список може його замінити.\n\nПримітка. Це правило застосовується лише до платформ, які підтримують розширення.";
ExtensionInstallBlocklist.pfm_title = "Ідентифікатори розширень, які користувач не має права встановлювати (або * для всіх)";
ExtensionInstallBlocklist.pfm_description = "Це правило дає змогу вказати, які розширення користувачі НЕ можуть встановлювати. Якщо вже встановлені розширення є в чорному списку, їх буде вимкнено, а користувачі не зможуть увімкнути їх. Якщо вимкнене розширення вилучити із чорного списку, воно автоматично ввімкнеться.\n\nЯкщо в чорному списку вказано значення \"*\", усі розширення заблоковано за умовчанням. Розширення в білому списку дозволені, якщо вони підписані (запаковані). Усі розпаковані розширення заблоковано.\n\nЯкщо не налаштувати це правило, користувачі зможуть встановлювати в Brave усі розширення.\n\nПримітка. Це правило застосовується лише до платформ, які підтримують розширення.";
ExtensionInstallForcelist.pfm_title = "Ідентифікатори розширень або додатків і URL-адреси оновлень, які встановлюються без попередження";
ExtensionInstallForcelist.pfm_description = "Налаштування цього правила визначають список додатків і розширень, які встановлюються автоматично без взаємодії з користувачем і які він не може видалити або вимкнути через інтерфейс Brave. Дозволи, зокрема для API розширень enterprise.deviceAttributes і enterprise.platformKeys, надаються непрямо. Ці 2 API доступні лише для примусово встановлених додатків і розширень.\n\nХоча Brave намагається запобігати видаленню цих розширень, у деяких операційних системах Brave не може надійно захищати їх від змін, ініційованих користувачами.\n\nЯкщо це правило не налаштувати, додатки й розширення не встановлюватимуться автоматично, а користувачі зможуть видаляти їх у Brave.\n\nЦе правило замінює правило ExtensionInstallBlocklist. Якщо вилучити із цього списку примусово встановлені додатки або розширення, Brave автоматично видалить їх.\n\nВихідний код будь-якого розширення можна змінювати за допомогою Інструментів розробника (при цьому розширення може перестати працювати). Якщо це є проблемою, налаштуйте правило DeveloperToolsDisabled.\n\nКожний елемент у списку правила має вигляд сегмента з ідентифікатором розширення і URL-адресою оновлення (необов’язково), які розділені крапкою з комою (;). Ідентифікатор розширення – це рядок із 32 літер, приклад якого можна знайти на сторінці chrome://extensions у режимі розробника. URL-адреса оновлення (якщо її вказано) має спрямовувати на документ маніфесту оновлення у форматі XML (https://developer.chrome.com/extensions/autoupdate) і використовувати схему http, https або file. За умовчанням використовується URL-адреса для оновлення Вебмагазину Chrome. URL-адреса оновлення, указана для цього правила, використовується лише для початкового встановлення. Під час наступних оновлень розширення використовуватиметься URL-адреса, указана в його маніфесті. URL-адресу для подальших оновлень можна перевизначити за допомогою правила ExtensionSettings (докладну інформацію наведено на сторінці http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy).\n\nУ Microsoft® Windows® додатки й розширення не з Вебмагазину Chrome можна примусово встановлювати лише у версіях, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS додатки й розширення не з Вебмагазину Chrome можна примусово встановлювати лише у версіях, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.\n\nПримітка: це правило не стосується анонімного режиму. Докладніше про розміщення розширень: https://developer.chrome.com/extensions/hosting.\n\nПримітка. Це правило застосовується лише до платформ, які підтримують розширення.";
ExtensionInstallSources.pfm_title = "Шаблони URL-адрес, з яких дозволено встановлювати розширення, програми та сценарії користувача";
ExtensionInstallSources.pfm_description = "Налаштування цього правила визначають URL-адреси, з яких можна встановлювати розширення, додатки й теми. У попередніх версіях (до Brave 21) користувачі могли натиснути посилання на файл *.crx і після кількох застережень установити його в Brave. У новіших версіях такі файли потрібно завантажувати й перетягувати на сторінку налаштувань Brave. Це правило дає змогу використовувати старіший і простіший процес встановлення з певних URL-адрес.\n\nКожний елемент цього списку є шаблоном відповідності за типом розширення (докладну інформацію наведено на сторінці https://developer.chrome.com/extensions/match_patterns). Користувачі можуть легко встановлювати продукти з будь-якої URL-адреси, яка відповідає шаблону в цьому списку. Шаблони мають дозволяти розміщення файлу *.crx і сторінку, з якої починається завантаження (URL-адресу переходу).\n\nExtensionInstallBlocklist має перевагу над цим правилом. Тобто розширення із чорного списку не встановлюються, навіть якщо вони походять із сайту в цьому списку.\n\nПримітка. Це правило застосовується лише до платформ, які підтримують розширення.";
ExtensionInstallTypeBlocklist.pfm_title = "Чорний список типів файлів для встановлення розширень";
ExtensionInstallTypeBlocklist.pfm_description = "command_line - Блокувати завантаження розширень із командного рядка\nЧорний список визначає, які типи файлів для встановлення розширень забороняються.\n\nЯкщо налаштувати параметр \"command_line\", розширення не можна буде завантажити з командного рядка.";
ExtensionReviewPromptsEnabled.pfm_title = "Керувати запитами на відгуки й посиланнями для оцінювання розширень";
ExtensionReviewPromptsEnabled.pfm_description = "Це правило визначає, чи доступні в інтерфейсах користувачів Chrome вбудовані запити на відгуки й посилання для оцінювання (наприклад, \"Оцінити\") для встановлених розширень Chrome.\n\nЯкщо ввімкнути або не налаштувати це правило, користувачі зможуть бачити вбудовані точки входу для надсилання відгуків і оцінювання розширень, які відповідають вимогам, на панелі інструментів, у контекстних меню й на сторінці керування розширеннями (chrome://extensions).\n\nЯкщо вимкнути це правило, усі вбудовані запити на відгуки й посилання для оцінювання будуть недоступними й прихованими.";
ExtensionSettings.pfm_title = "Параметри керування розширенням";
ExtensionSettings.pfm_description = "Це правило визначає параметри керування розширеннями в Brave, зокрема ті, якими керують поточні правила, пов’язані з розширеннями.\n\nПравило зіставляє ідентифікатор розширення або URL-адресу оновлення лише з його налаштуванням. Для спеціального ідентифікатора \"*\" можна налаштувати конфігурацію за умовчанням, що застосовується до всіх розширень, для яких у цьому правилі не вказано власну конфігурацію.\n\nЦе правило може перевизначати конфігурацію окремих розширень, налаштовану за допомогою застарілих правил.\n\nЗверніть увагу, що конфігурації розширень, налаштовані для певних ідентифікаторів за допомогою правил ExtensionInstallForcelist, ExtensionInstallAllowlist, ExtensionInstallBlocklist або ExtensionSettings, успадковуватимуть від стандартної конфігурації \"*\" лише параметри installation_mode і update_url. Інші властивості не успадковуватимуться. Конфігурація застосовується до всіх розширень із конкретною URL-адресою оновлення, указаною в маніфесті розширення (http://support.google.com/chrome/a?p=Configure_ExtensionSettings_policy). Якщо для експериментального параметра override_update_url вибрано значення \"істина\", розширення встановлюється й оновлюється через URL-адресу оновлення, яка вказана в правилі ExtensionInstallForcelist або в полі update_url у цьому правилі. Якщо update_url – URL-адреса Вебмагазину Chrome, експериментальний параметр override_update_url ігнорується.\n\nПочинаючи з версії Brave 154, якщо застосувати правило runtime_blocked_hosts до розширення з дозволом debugger, функцію chrome.debugger.attach() буде повністю вимкнено для всіх цільових об’єктів.\n\nУ Microsoft® Windows® додатки й розширення не з Вебмагазину Chrome можна примусово встановлювати лише у версіях, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS додатки й розширення не з Вебмагазину Chrome можна примусово встановлювати лише у версіях, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.\n\nПримітка. Це правило застосовується лише до платформ, які підтримують розширення.\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=ExtensionSettings.";
ExtensionUnpublishedAvailability.pfm_title = "Керувати доступністю розширень, неопублікованих у Веб-магазині Chrome.";
ExtensionUnpublishedAvailability.pfm_description = "0 - Дозволити неопубліковані розширення\n1 - Вимкнути неопубліковані розширення\nЯкщо ввімкнути це правило, у Brave буде вимкнено розширення, не опубліковані у Веб-магазині Chrome.\nЦе правило стосується лише встановлених розширень, які оновлюються з Веб-магазину Chrome.\n\nІнші розширення, як-от розпаковані розширення, установлені в режимі розробника, а також розширення, установлені за допомогою перемикача командного рядка, примусово встановлені розширення, розміщені на власному сервері, і всі розширення для певної версії веб-переглядача ігноруються.\n\nЯкщо для цього правила вибрати значення AllowUnpublished (0) або не налаштувати його, розширення, неопубліковані у Веб-магазині Chrome, буде дозволено.\nЯкщо для цього правила вибрати значення DisableUnpublished (1), розширення, неопубліковані у Веб-магазині Chrome, буде вимкнено.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_title = "Показувати опцію \"Завжди відкривати\" у вікні зовнішнього протоколу.";
ExternalProtocolDialogShowAlwaysOpenCheckbox.pfm_description = "Це правило дає змогу вказати, чи відображати опцію \"Завжди відкривати\" в запитах щодо підтвердження запуску протоколу.\n\n     Якщо для цього правила вибрано значення true або його не налаштовано, під час показу запиту на підтвердження зовнішнього протоколу користувач може вибрати опцію \"Завжди дозволяти\", щоб не бачити такі запити в майбутньому.\n\n     Якщо для цього правила вибрано значення false, опція \"Завжди дозволяти\" не відображається, а користувач бачитиме запит щоразу, коли викликатиметься зовнішній протокол.";
FeedbackSurveysEnabled.pfm_title = "Указує, чи бачать користувачі опитування в Brave.";
FeedbackSurveysEnabled.pfm_description = "Опитування в Brave допомагають збирати відгуки користувачів про цей веб-переглядач. Відповіді на опитування не пов’язуються з обліковими записами користувачів.\nЯкщо це правило ввімкнути або не налаштувати, користувачі зможуть бачити опитування в продукті.\nЯкщо його вимкнути, користувачі не бачитимуть опитувань.\n\nЦе правило не діятиме, якщо вимкнути правилоMetricsReportingEnabled (опитування в продукті також буде вимкнено).";
FetchKeepaliveDurationSecondsOnShutdown.pfm_title = "Тривалість обробки запитів з атрибутом keepalive під час завершення роботи";
FetchKeepaliveDurationSecondsOnShutdown.pfm_description = "Контролює тривалість (у секундах), дозволену для обробки запитів з атрибутом keepalive під час завершення роботи веб-переглядача.\n\nЯкщо значення вказано, завершення роботи може блокуватися на визначену кількість секунд,\nщоб веб-переглядач обробив ці запити (https://fetch.spec.whatwg.org/#request-keepalive-flag).\n\nЯкщо вибрано значення за умовчанням (0), цю функцію вимкнено.";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_title = "Дозволити здійснювати виклики API засобу вибору файлів або каталогів, не вимагаючи попереднього виконання жесту користувача";
FileOrDirectoryPickerWithoutGestureAllowedForOrigins.pfm_description = "З міркувань безпеки API вебсервісів showOpenFilePicker(), showSaveFilePicker() і showDirectoryPicker() потребують попереднього жесту користувача (\"тимчасової активації\"), інакше доступ не буде надано.\n\nЗа допомогою цього правила адміністратори можуть визначати джерела, у яких ці API викликатимуться без попереднього жесту користувача.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns/. Символ зірочки (*) – недопустиме значення для цього правила.\n\nЯкщо це правило не налаштувати, для виклику цих API усі джерела вимагатимуть попереднього жесту користувача.";
FileSystemReadAskForUrls.pfm_title = "Дозволити перегляд через File System API на цих сайтах";
FileSystemReadAskForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким дозволено запитувати дозвіл на перегляд файлів чи каталогів у файловій системі ОС хоста через File System API.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultFileSystemReadGuardSetting за умови, що воно налаштоване. Якщо ні, використовуватимуться особисті налаштування користувачів.\n\nШаблони URL-адрес не можуть конфліктувати з правилом FileSystemReadBlockedForUrls. Якщо URL-адреса відповідає шаблонам з обох правил, жодне з них не матиме переваги.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. * – недопустиме значення для цього правила.";
FileSystemReadBlockedForUrls.pfm_title = "Заборонити перегляд через File System API на цих сайтах";
FileSystemReadBlockedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким заборонено запитувати дозвіл на перегляд файлів або каталогів у файловій системі ОС хоста через File System API.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultFileSystemReadGuardSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів.\n\nШаблони URL-адрес не можуть конфліктувати з правилом FileSystemReadAskForUrls. Якщо URL-адреса відповідає шаблонам з обох правил, жодне з них не матиме переваги.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. * – недопустиме значення для цього правила.";
FileSystemWriteAskForUrls.pfm_title = "Дозволити редагувати файли й каталоги на цих сайтах";
FileSystemWriteAskForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким дозволено запитувати дозвіл на редагування файлів чи каталогів у файловій системі ОС хоста.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultFileSystemWriteGuardSetting за умови, що воно налаштоване. Якщо ні, використовуватимуться особисті налаштування користувачів.\n\nШаблони URL-адрес не можуть конфліктувати з правилом FileSystemWriteBlockedForUrls. Якщо URL-адреса відповідає шаблонам з обох правил, жодне з них не матиме переваги.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. * – недопустиме значення для цього правила.";
FileSystemWriteBlockedForUrls.pfm_title = "Заборонити редагувати файли й каталоги на цих сайтах";
FileSystemWriteBlockedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким заборонено запитувати дозвіл на редагування файлів чи каталогів у файловій системі ОС хоста.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultFileSystemWriteGuardSetting за умови, що воно налаштоване. Якщо ні, використовуватимуться особисті налаштування користувачів.\n\nШаблони URL-адрес не можуть конфліктувати з правилом FileSystemWriteAskForUrls. Якщо URL-адреса відповідає шаблонам з обох правил, жодне з них не матиме переваги.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. * – недопустиме значення для цього правила.";
ForceEphemeralProfiles.pfm_title = "Тимчасовий профіль";
ForceEphemeralProfiles.pfm_description = "Якщо це налаштування ввімкнено, профіль переходить у режим тимчасового. Якщо це правило встановлено як правило для ОС (наприклад GPO у Windows), воно застосовуватиметься для кожного профілю в системі. Якщо це правило встановлено як правило для хмари, воно застосовуватиметься лише для профілю, у який увійшли, використовуючи обліковий запис, яким керує адміністратор.\n\nУ цьому режимі дані профілю зберігаються на диску лише протягом сеансу користувача. Функції (як-от історія перегляду, розширення та їх дані), веб-дані (як-от файли cookie й онлайнові бази даних) не зберігаються після закриття веб-переглядача. Однак користувач може завантажувати будь-які дані на диск вручну, зберігати сторінки та друкувати їх.\n\nЯкщо ввімкнено синхронізацію, усі дані зберігаються в синхронізованому профілі як у звичайних профілях. Режим анонімного перегляду також доступний, якщо його не вимкнено правилом.\n\nЯкщо це правило вимкнено чи не налаштовано, під час входу відкриваються звичайні профілі.";
ForceForegroundPriorityForAllTabs.pfm_title = "Примусово перевести всі вкладки в активний режим";
ForceForegroundPriorityForAllTabs.pfm_description = "За допомогою цього правила можна примусово переводити вебконтент із фонового режиму в активний.\n\nЗа умовчанням вебпереглядач оптимізує ресурси, знижуючи пріоритет контенту на вкладках у фоновому режимі. Увімкнувши це правило, можна перевизначити поведінку за умовчанням, щоб вкладки у фоновому режимі планувалися так само, як і в активному.\n\nЗверніть увагу, що примусове переведення контенту з фонового режиму в активний може незначно вплинути на швидкість відповіді активної вкладки.\n\nЯкщо ввімкнути це правило, увесь вебконтент буде переведено в активний режим незалежно від того, чи видимий він.\n\nЯкщо це правило вимкнути або не налаштувати, вебпереглядач визначатиме пріоритет на основі стандартних евристичних методів (наприклад, знижуватиме пріоритет вкладок, якщо вони не відображаються або на них не відтворюється аудіо чи не здійснюється відеодзвінок тощо).";
ForceForegroundPriorityForUrls.pfm_title = "Примусово переводити контент із певних URL-адрес в активний режим";
ForceForegroundPriorityForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес. Фоновий вебконтент, який відповідає цим шаблонам, примусово переводитиметься в активний режим.\n\nЯкщо ввімкнути правило ForceForegroundPriorityForAllTabs, цей список ігноруватиметься, оскільки всі вкладки примусово переводитимуться в активний режим.\n\nЯкщо вимкнути або не налаштувати правило ForceForegroundPriorityForAllTabs, примусово переводитиметься лише контент, який відповідає шаблонам у цьому списку.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nЯкщо цей список порожній або правило не налаштовано, фоновий контент не переводиться в активний режим.";
ForceGoogleSafeSearch.pfm_title = "Примусово активувати Безпечний пошук Google";
ForceGoogleSafeSearch.pfm_description = "Якщо це правило активовано, Безпечний пошук у Пошуку Google завжди активний. Користувачі не можуть змінити цей параметр.\n\nЯкщо це правило деактивовано або не налаштовано, Безпечний пошук у Пошуку Google не застосовується.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_title = "Визначає, чи можна вимкнути обробники подій 'unload'.";
ForcePermissionPolicyUnloadDefaultEnabled.pfm_description = "Припиняється підтримка обробників подій unload. Їх функціональність визначається правилом unload Permissions-Policy. Зараз вони дозволені правилом за умовчанням. У майбутньому вони поступово заборонятимуться за умовчанням, і сайтам буде потрібно вмикати їх за допомогою заголовків Permissions-Policy. За допомогою цього корпоративного правила можна відмовитися від поступового припинення підтримки функції, примусово залишивши її ввімкненою за умовчанням.\n\nЩоб зберегти дані або повідомити про завершення сеансу користувача на сервер, сторінки можуть використовувати обробники подій unload. Ми не радимо цього робити, оскільки блокується використання BackForwardCache, що може негативно вплинути на ефективність. Хоча подія unload використовувалася протягом тривалого часу, існують альтернативи. Деякі додатки все ще можуть працювати за старим принципом.\n\nЯкщо для цього правила вибрати значення \"неправда\" або не налаштувати його, підтримку обробників подій unload поступово буде припинено, а сайти, які не мають заголовка Permissions-Policy, не зможуть запускати події unload.\n\nЯкщо для цього правила вибрати значення \"правда\", обробники подій unload і надалі працюватимуть за умовчанням.\n\nПРИМІТКА. Це правило містить неправильно задокументоване значення за умовчанням \"правда\" у версії M117. Подія вивантаження не змінилася й не зміниться у версії M117, тому це правило в ній не діє.\n";
ForceYouTubeRestrict.pfm_title = "Примусово застосовувати мінімальний рівень безпечного режиму на YouTube";
ForceYouTubeRestrict.pfm_description = "0 - Вимкнути примусове застосування безпечного режиму на YouTube\n1 - Примусово застосовувати принаймні помірний безпечний режим на YouTube\n2 - Примусово застосовувати суворий безпечний режим на YouTube\nЯкщо налаштувати це правило, на YouTube застосовуватиметься мінімальний рівень безпечного режиму, який користувачі не можуть знизити. Нижче описано можливі значення.\n\n* Якщо вибрати для цього правила значення Strict, на YouTube завжди використовуватиметься суворий безпечний режим.\n\n* Якщо вибрати значення Moderate, користувачі зможуть вибрати помірний або суворий безпечний режим на YouTube, проте не матимуть змоги вимкнути його.\n\n* Якщо вимкнути це налаштування або не вказати для нього значення, Chrome не застосовуватиме безпечний режим на YouTube примусово. Водночас безпечний режим може бути застосовано зовнішнім правилом, як-от правилами YouTube.";
ForcedLanguages.pfm_title = "Налаштувати вибрані мови та їх порядок";
ForcedLanguages.pfm_description = "Це правило дає змогу адміністраторам указати порядок вибраних мов у налаштуваннях Brave.\n\nСаме в цьому порядку мови відображатимуться в розділі \"Розмістіть мови в бажаному порядку\" на сторінці chrome://settings/languages. Користувачі не зможуть видалити налаштовані в правилі мови чи змінити їх порядок, але матимуть змогу додавати нові з нижчим пріоритетом. Також вони зможуть керувати мовою інтерфейсу веб-переглядача, налаштуваннями перекладу та перевірки орфографії (якщо для них не діятимуть інші правила).\n\nЯкщо не налаштувати це правило, користувачі зможуть керувати всім списком вибраних мов.";
GeminiActOnWebAllowedForURLs.pfm_title = "Дозволити інтеграціям додатка Gemini безпосередньо виконувати дії на вказаних сайтах";
GeminiActOnWebAllowedForURLs.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, на яких інтеграції додатка Gemini можуть безпосередньо виконувати дії на вебсторінках.\n\nДля URL-адрес, які не включено в білий або чорний список, використовується правилоGeminiActOnWebSettings.\n\nURL-адреси, які включено і в білий, і в чорний список, дозволятимуться.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebBlockedForURLs.pfm_title = "Заборонити інтеграціям додатка Gemini безпосередньо виконувати дії на вказаних сайтах";
GeminiActOnWebBlockedForURLs.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, на яких інтеграції додатка Gemini не можуть безпосередньо виконувати дії на вебсторінках.\n\nДля URL-адрес, які не включено в білий або чорний список, використовується правилоGeminiActOnWebSettings.\n\nURL-адреси, які включено і в білий, і в чорний список, дозволятимуться.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://support.google.com/chrome/a?p=url_blocklist_filter_format.";
GeminiActOnWebSettings.pfm_title = "Дозволяє інтеграціям додатка Gemini виконувати дії безпосередньо на вебсторінках";
GeminiActOnWebSettings.pfm_description = "0 - Дозволити додатку Gemini виконувати дії на вебсторінках.\n1 - Заборонити додатку Gemini виконувати дії на вебсторінках.\nЦе правило визначає, чи може додаток Gemini виконувати дії на вебсторінках від імені користувача.\n\nЯкщо вибрати для цього правила значення 0 або не налаштувати його, додаток Gemini зможе виконувати дії на вебсторінках.\n\nЯкщо вибрати значення 1, додаток Gemini не зможе цього робити.\n\nЦе правило не діє, якщо додаток Gemini вимкнено (наприклад, відповідно до правила GeminiSettings).\n\nЩоб дізнатися більше про Gemini у Chrome, перегляньте інформацію за цим посиланням: https://support.google.com/chrome/a/answer/16291696.\n\nСервіс Gemini доступний не в усіх країнах і лише певними мовами. Налаштування цього правила не гарантує, що відповідний сервіс буде ввімкнено, оскільки це залежить від його доступності. Щоб дізнатися більше про запуск, перегляньте примітки до випуску Chrome Enterprise: https://support.google.com/chrome/a/answer/7679408?hl=uk";
GeminiSettings.pfm_title = "Налаштування інтеграції з Gemini";
GeminiSettings.pfm_description = "0 - Дозволити інтеграцію з Gemini.\n1 - Заборонити інтеграцію з Gemini.\nЦе налаштування дає змогу інтегрувати додаток Gemini.\n\nЯкщо вибрати значення \"0\", інтеграція з Gemini буде доступна для користувачів.\n\nЯкщо вибрати значення \"1\", інтеграція з Gemini не буде доступна для користувачів.\n\nЯкщо не налаштувати це правило, його поведінку визначатиме правило GenAiDefaultSettings.\n\nЩоб дізнатися більше, перегляньте статтю Довідкового центру за посиланням https://support.google.com/chrome/a?p=gemini_in_chrome.";
GeminiSparkSettings.pfm_title = "Дозволяє Gemini Spark підключатися до Brave і використовувати функцію автоматичного вебперегляду через Gemini у Chrome";
GeminiSparkSettings.pfm_description = "0 - Gemini Spark може підключатися до Brave і використовувати функцію автоматичного вебперегляду.\n1 - Gemini Spark не може підключатися до Brave або використовувати функцію автоматичного вебперегляду.\nЦе правило визначає, чи може агент Gemini Spark підключатися до Brave і використовувати функцію автоматичного вебперегляду. Gemini Spark може бути недоступним для вашої організації.\n\n0 = Gemini Spark може підключатися до Brave і використовувати функцію автоматичного вебперегляду\n\n1 = Gemini Spark не може підключатися до Brave або використовувати функцію автоматичного вебперегляду\n\nПопередження. Якщо дозволити Gemini Spark підключатися до Brave і використовувати функцію автоматичного вебперегляду, агент Gemini Spark зможе виконувати автономні багатоетапні дії в Brave під час активного сеансу вебпереглядача. Це може спричинити значні загрози безпеці, зокрема ризики викрадення облікових даних, несанкціонованого доступу до локальної мережі й утрати сигналів з урахуванням контексту. Наявні параметри керування й безпеки можуть не підтримуватися.\n\nПерш ніж увімкнути цю функцію, радимо адміністраторам ретельно оцінити модель загроз мережі своєї організації, а також правила щодо відповідності й конфіденційності.\n\nЦе правило не діє, якщо вимкнено додаток Google Gemini або правила автоматичного вебперегляду в Brave. Наприклад, правило GeminiSettings може вимкнути додаток Google Gemini. Щоб дізнатися більше про Google Gemini у Brave, перейдіть на сторінку https://support.google.com/chrome/a?p=gemini_in_chrome.\n\nGemini Spark і функція автоматичного вебперегляду в Brave доступні не в усіх країнах, а також лише деякими мовами. Якщо вибрати для цього правила значення \"0\", це не гарантує роботу функції, оскільки вона може бути недоступна. Щоб дізнатися більше про запуск, перегляньте примітки до випуску Chrome Enterprise: https://chromeenterprise.google/resources/release-notes/.";
GenAILocalFoundationalModelSettings.pfm_title = "Налаштування для локальної базової моделі генеративного ШІ";
GenAILocalFoundationalModelSettings.pfm_description = "0 - Автоматично завантажувати модель\n1 - Не завантажувати модель\nЗа допомогою цього правила можна налаштувати, як Brave завантажуватиме базову модель генеративного ШІ й використовуватиме її для роботи на пристрої.\n\nЯкщо для цього правила вибрати значення \"Дозволено\" (0) або не налаштувати його, модель завантажуватиметься автоматично й генеруватиме результати.\n\nЯкщо вибрати значення \"Вимкнено\" (1), модель не завантажуватиметься, а наявну модель (якщо її вже завантажено) буде видалено.\n\nНа платформах для ПК завантаження також можна заборонити, установивши для правила ComponentUpdatesEnabled значення \"хиба\".";
GeolocationBlockedForUrls.pfm_title = "Блокувати доступ до геолокації на цих сайтах";
GeolocationBlockedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес сайтів, яким заборонено отримувати доступ до геоданих користувача й запитувати відповідний дозвіл.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultGeolocationSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів.\n\nДокладніше про дійсні шаблони url можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).";
GloballyScopeHTTPAuthCacheEnabled.pfm_title = "Увімкнути загальну область кешу HTTP-авторизації";
GloballyScopeHTTPAuthCacheEnabled.pfm_description = "Це правило налаштовує один загальний кеш на профіль з обліковими даними для авторизації сервера HTTP.\n\nЯкщо це правило не налаштовано або вимкнено, вебпереглядач використовуватиме поведінку міжсайтової авторизації за умовчанням, яка охоплюватиме облікові дані сайту найвищого рівня для авторизації сервера HTTP. Тож якщо два сайти використовують ресурси того самого домену для авторизації, облікові дані потрібно буде вказувати окремо на кожному сайті. Кешовані облікові дані проксі використовуватимуться на різних сайтах.\n\nЯкщо правило ввімкнено, облікові дані для HTTP-авторизації, введені на одному сайті, автоматично використовуватимуться на іншому.\n\nЯкщо ввімкнути це правило, сайти можуть наражатися на деякі типи міжсайтових атак, а дії користувачів на сайтах можуть відстежуватися без використання файлів cookie, а шляхом додавання записів у кеш HTTP-авторизації за допомогою облікових даних, вставлених у URL-адреси.\n\nЦе правило дає можливість підприємствам із застарілою поведінкою оновити процедуру входу. У майбутньому його буде видалено.";
GoogleSearchSidePanelEnabled.pfm_title = "Увімкнути Google Search Side Panel";
GoogleSearchSidePanelEnabled.pfm_description = "Якщо правило не налаштувати або ввімкнути, Google Search Side Panel зможе показуватися на всіх веб-сторінках.\n\nЯкщо його вимкнути, Google Search Side Panel не відображатиметься на жодній веб-сторінці.\n\nМожливості генеративного ШІ, які входять до цієї функції, недоступні для облікових записів Education і Enterprise.";
HSTSPolicyBypassList.pfm_title = "Список назв, які обійдуть перевірку правил HSTS";
HSTSPolicyBypassList.pfm_description = "За допомогою цього правила можна вказати список імен хостів, які зможуть обходити перетворення протоколу запитів з HTTP на HTTPS за вимогами попереднього завантаження HSTS.\n\nУ цьому правилі можна вказувати лише однорівневі імена хостів. Воно застосовується лише до \"статичних\" записів попереднього завантаження HSTS (наприклад, \"app\", \"new\", \"search\", \"play\"). Це правило не заважає перетворенням через механізм HSTS для серверів, які \"динамічно\" запитуть їх за допомогою заголовка відповіді Strict-Transport-Security.\n\nУказані імена хостів мають бути канонікалізовані: усі інтернаціоналізовані доменні імена (IDN) потрібно конвертувати у формат A-label, а також використовувати лише малі літери ASCII. Це правило застосовується лише до конкретних указаних однорівневих імен хостів і не діє для їх субдоменів.";
HappyEyeballsV3Enabled.pfm_title = "Використання алгоритму Happy Eyeballs V3";
HappyEyeballsV3Enabled.pfm_description = "Ця функція дає змогу здійснювати спроби з’єднання за допомогою алгоритму Happy Eyeballs V3. Докладнішу інформацію можна переглянути на сторінці https://datatracker.ietf.org/doc/draft-pauly-happy-happyeyeballs-v3.\n\nЯкщо ввімкнути це правило, Brave намагатиметься встановити з’єднання за допомогою алгоритму Happy Eyeballs V3.\n\nЯкщо вимкнути це правило, алгоритм Happy Eyeballs V3 не застосовуватиметься.\n\nЯкщо це правило не налаштувати, Brave вмикатиме або вимикатиме алгоритм Happy Eyeballs V3 залежно від налаштувань на сторінці chrome://flags/#happy-eyeballs-v3.\n\nПравило підтримує динамічне оновлення.\n\nЦе правило тимчасове. У майбутніх версіях Brave його буде вилучено.";
HardwareAccelerationModeEnabled.pfm_title = "Використовувати апаратне прискорення графіки, якщо доступно";
HardwareAccelerationModeEnabled.pfm_description = "Якщо ввімкнути або не налаштувати це правило, активується апаратне прискорення графіки (якщо доступно). Якщо його вимкнути, апаратне прискорення графіки деактивується.";
HeadlessMode.pfm_title = "Керувати використанням режиму headless";
HeadlessMode.pfm_description = "1 - Дозволити використовувати режим headless\n2 - Заборонити використовувати режим headless\nЯкщо для цього правила вибрано значення Enabled або його не налаштовано, режим headless можна буде використовувати. Якщо для цього правила вибрано значення Disabled, використання такого режиму буде заборонено.";
HelpMeWriteSettings.pfm_title = "Налаштування функції \"Допомога з текстом\"";
HelpMeWriteSettings.pfm_description = "0 - Дозволити використовувати функцію \"Допомога з текстом\" і покращувати моделі ШІ.\n1 - Дозволити використовувати функцію \"Допомога з текстом\" без покращення моделей ШІ.\n2 - Заборонити використовувати функцію \"Допомога з текстом\".\nДопомога з текстом – це функція на основі штучного інтелекту, яка дає змогу створювати короткі тексти в Інтернеті. Пропозиції надаються на основі запитів, які ввів користувач, і контенту вебсторінки.\n\n\"0\" – увімкнути пов’язані функції і надсилати в Google відповідні дані для покращення моделей штучного інтелекту. Залежно від функції надсилатися можуть запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки. Спеціалісти можуть перевіряти такі матеріали, щоб покращувати моделі штучного інтелекту. Значення \"0\" використовується за умовчанням, за винятком наведених нижче випадків.\n\n\"1\" – увімкнути пов’язані функції, але не надсилати в Google контент користувачів (зокрема запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки) для покращення моделей штучного інтелекту. Значення \"1\" застосовується за умовчанням для корпоративних користувачів, якими керують через Google Admin console, і облікових записів закладів освіти, якими керують через Google Workspace.\n\n\"2\" – заборонити використовувати пов’язані функції.\n\nЯкщо не налаштувати це правило, його поведінка визначатиметься правилом GenAiDefaultSettings.\n\nЩоб дізнатися більше про обробку даних для функцій на основі генеративного ШІ, перейдіть на сторінку https://support.google.com/chrome/a?p=generative_ai_settings.";
HideWebStoreIcon.pfm_title = "Ховати значок веб-магазину на сторінці нової вкладки та на панелі запуску додатків";
HideWebStoreIcon.pfm_description = "Ховає додаток Веб-магазин Chrome і посилання внизу на сторінці нової вкладки та панелі запуску додатків Google Chrome OS.\n\nЯкщо для цього правила встановлено значення \"true\", значки сховані.\n\nЯкщо для цього правила встановлено значення \"false\" чи його не налаштовано, значки видимі.";
HighEfficiencyModeEnabled.pfm_title = "Увімкнути режим високої ефективності";
HighEfficiencyModeEnabled.pfm_description = "Це правило вмикає й вимикає режим високої ефективності. Він допомагає звільнити пам’ять, закриваючи вкладки, які працюють у фоновому режимі протягом певного часу.\nЯкщо правило не налаштовано, кінцевий користувач може керувати параметрами режиму на сторінці chrome://settings/performance.\n";
HistoryClustersVisible.pfm_title = "Показувати історію Chrome, упорядковану за групами сторінок";
HistoryClustersVisible.pfm_description = "Це правило дає змогу вказати, чи потрібно відображати історію Chrome, упорядковану за групами сторінок.\n\nЯкщо ввімкнути це правило, упорядкована в такий спосіб історія Chrome показуватиметься за адресою chrome://history/grouped.\n\nЯкщо його вимкнути, історія Chrome, упорядкована за групами сторінок, не відображатиметься за вказаною адресою.\n\nЯкщо не налаштувати це правило, історія Chrome, упорядкована за групами сторінок, за умовчанням показуватиметься за адресою chrome://history/grouped.\n\nЗверніть увагу: якщо правило ComponentUpdatesEnabled вимкнено, а правило HistoryClustersVisible увімкнено або не налаштовано, історія Chrome, упорядкована за групами сторінок, відображатиметься за адресою chrome://history/grouped, але може бути менш актуальною для користувача.\n";
HistorySearchSettings.pfm_title = "Налаштування пошуку в історії за допомогою ШІ";
HistorySearchSettings.pfm_description = "0 - Дозволити використовувати функцію \"Пошук в історії за допомогою ШІ\" й покращувати моделі ШІ.\n1 - Дозволити використовувати функцію \"Пошук в історії за допомогою ШІ\" без покращення моделей ШІ.\n2 - Заборонити використовувати функцію \"Пошук в історії за допомогою ШІ\".\nПошук в історії за допомогою ШІ – це функція, яка дає користувачам змогу виконувати пошук в історії вебперегляду й отримувати згенеровані відповіді на основі вмісту сторінки, а не лише її назви і URL-адреси.\n\n\"0\" – увімкнути пов’язані функції і надсилати в Google відповідні дані для покращення моделей штучного інтелекту. Залежно від функції надсилатися можуть запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки. Спеціалісти можуть перевіряти такі матеріали, щоб покращувати моделі штучного інтелекту. Значення \"0\" використовується за умовчанням, за винятком наведених нижче випадків.\n\n\"1\" – увімкнути пов’язані функції, але не надсилати в Google контент користувачів (зокрема запити, вихідні матеріали, вхідні й вихідні дані, а також письмові відгуки) для покращення моделей штучного інтелекту. Значення \"1\" застосовується за умовчанням для корпоративних користувачів, якими керують через Google Admin console, і облікових записів закладів освіти, якими керують через Google Workspace.\n\n\"2\" – заборонити використовувати пов’язані функції.\n\nЯкщо не налаштувати це правило, його поведінка визначатиметься правилом GenAiDefaultSettings.\n\nЩоб дізнатися більше про обробку даних для функцій на основі генеративного ШІ, перейдіть на сторінку https://support.google.com/chrome/a?p=generative_ai_settings.";
HomepageIsNewTabPage.pfm_title = "Зробити сторінку нової вкладки головною сторінкою";
HomepageIsNewTabPage.pfm_description = "Якщо ввімкнути це правило, сторінка нової вкладки використовуватиметься як головна. Указана URL-адреса головної сторінки ігноруватиметься. Якщо це правило вимкнути, сторінка нової вкладки не використовуватиметься як головна (крім випадків, коли chrome://newtab указано як URL-адресу головної сторінки).\n\nЯкщо налаштувати це правило, користувачі не зможуть змінювати тип головної сторінки в Brave. Якщо його не налаштувати, користувачі зможуть вирішувати, чи використовувати сторінку нової вкладки як головну.\n\nУ Microsoft® Windows® це правило застосовується лише для екземплярів, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS це правило доступне лише для екземплярів, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.";
HomepageLocation.pfm_title = "URL-адреса домашньої сторінки";
HomepageLocation.pfm_description = "За допомогою цього правила можна налаштувати URL-адресу головної сторінки в Brave. Щоб відкрити головну сторінку, скористайтеся відповідною кнопкою. На комп’ютері сторінками, які відкриваються після запуску, керують правила RestoreOnStartup.\n\nЯкщо сторінка нової вкладки використовується як головна відповідно до налаштувань користувача або значень правила HomepageIsNewTabPage, це правило не діє.\n\nСхема URL-адреси має бути стандартною, як-от http://example.com або https://example.com. Якщо налаштувати це правило, користувач не може змінити URL-адресу головної сторінки в Brave.\n\nЯкщо не налаштувати правила HomepageLocation і HomepageIsNewTabPage, користувачі зможуть самі вибирати головну сторінку.\n\nУ Microsoft® Windows® це правило застосовується лише для екземплярів, які зареєстровано в доменах Microsoft® Active Directory® чи Microsoft® Azure® Active Directory® або в Chrome Enterprise Core.\n\nУ macOS це правило доступне лише для екземплярів, які контролюються через Керування мобільними пристроями або зареєстровані в домені через MCX чи в Chrome Enterprise Core.";
HttpAllowlist.pfm_title = "Білий список HTTP";
HttpAllowlist.pfm_description = "За допомогою цього правила можна вказати список імен хостів або їх шаблонів (як-от [*.]example.com), для яких не використовуватиметься протокол HTTPS. Для них також не буде показуватися проміжна сторінка з помилкою, якщо ввімкнено режим HTTPS-First. Організації можуть використовувати це правило, щоб забезпечувати доступ до серверів, які не підтримують протокол HTTPS. При цьому не потрібно вимикати примусовий перехід на протокол HTTPS та/або режим HTTPS-First.\n\nУказані імена хостів мають бути канонікалізовані: усі інтернаціоналізовані доменні імена (IDN) потрібно конвертувати у формат A-label, а також використовувати лише малі літери ASCII.\n\nУніверсальні символи підстановки (наприклад, \"*\" або \"[*]\") використовувати не можна. Натомість потрібно вимкнути режим HTTPS-First і примусовий перехід на протокол HTTPS за допомогою їх спеціальних правил.\n\nПримітка: це правило не застосовується до примусового використання механізму захисту HSTS.";
HttpHeaderInjection.pfm_title = "Налаштувати вставлення заголовків HTTP для певних шаблонів URL-адрес";
HttpHeaderInjection.pfm_description = "Це правило дає змогу налаштувати список правил для вставлення спеціальних заголовків HTTP у вебзапити, які відповідають певним шаблонам URL-адрес. Заголовки, налаштовані в межах цього правила, мають пріоритет над наявними в запиті, а також над змінами, які намагаються внести користувачі або розширення.\n\nЗазвичай це правило використовується, щоб примусово застосовувати елементи керування доступом до клієнта за допомогою спеціальних заголовків (наприклад, X-Tenant-ID).\n\nПравило приймає список правил. Кожне правило містить наведені нижче елементи.\n\n* patterns: список шаблонів URL-адрес для зіставлення. Вимоги до формату шаблонів URL-адрес: https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\n* headers: список об’єктів, що представляють заголовки, які потрібно вставити. Кожен об’єкт містить наведені нижче елементи.\n\n* name: назва заголовка, який потрібно вставити.\n\n* value: значення заголовка.\n\nЯкщо запиту відповідає кілька правил, застосовуватимуться заголовки з них усіх. Якщо кілька заголовків мають однакову назву, застосовуватиметься той, який відповідає найточнішому шаблону URL-адреси. Якщо шаблони однаково точні, застосовуватиметься останній у списку.\n\nНазви заголовків мають відповідати стандарту RFC 2616 ( https://www.rfc-editor.org/rfc/rfc2616 ), а їх значення не повинні містити символів NUL, CR або LF. Розмір окремих заголовків не має перевищувати 8 КБ. Недійсні заголовки й шаблони URL-адрес ігноруватимуться.\n\nМаксимальна кількість шаблонів URL-адрес у всіх правилах – 500. Кожне правило може містити щонайбільше 20 заголовків. Шаблони й заголовки, які перевищують ці ліміти, ігноруватимуться.\n\nПримітка. Якщо шаблон URL-адреси відповідає незашифрованим схемам (http://, ws:// або схему пропущено), налаштовані заголовки можуть передаватися у вигляді простого тексту через незашифрований канал і бути видимими для мережевих спостерігачів. Щоб захистити чутливі або ідентифікаційні значення заголовків, використовуйте для шаблонів URL-адрес лише зашифровані схеми (https:// або wss://).\nДокладніше про схему й форматування на сторінці https://chromeenterprise.google/policies/?policy=HttpHeaderInjection.";
HttpsOnlyMode.pfm_title = "Дозволити вмикати режим \"Лише HTTPS\"";
HttpsOnlyMode.pfm_description = "allowed - Не обмежувати налаштування користувачів \"Режим HTTPS-Only\"\ndisallowed - Вимкнути режим HTTPS-Only\nforce_enabled - Увімкнути HTTPS-Only в строгому режимі\nforce_balanced_enabled - Увімкнути HTTPS-Only в збалансованому режимі\nЦе правило дає змогу вибрати, чи можуть користувачі вмикати режим HTTPS-Only (Завжди використовувати надійні з’єднання) у налаштуваннях. У цьому режимі весь трафік переходить на HTTPS.\n\nЯкщо це правило не налаштувати або ввімкнути, користувачі зможуть вмикати режим HTTPS-Only.\n\nЯкщо вимкнути це правило, режим HTTPS-Only буде деактивовано.\n\nЯкщо вибрати для цього правила значення force_enabled, HTTPS-Only буде ввімкнено в строгому режимі.\n\nЯкщо вказати для цього правила значення force_balanced_enabled, HTTPS-Only буде ввімкнено в збалансованому режимі.\n\nЗначення force_enabled підтримується, починаючи з версії M112, а force_balanced_enabled – з версії M129.\n\nКрім того, користувачам можна рекомендувати значення force_enabled і force_balanced_enabled.\nУ такому разі HTTPS-Only буде ввімкнено в строгому або збалансованому режимі, однак користувачі зможуть змінити це налаштування.\n\nЯкщо для цього правила вибрати значення, яке не підтримує відповідна версія Chrome, вебпереглядач за умовчанням використовуватиме дозволені налаштування.\n\nЩоб указати список імен хостів або їх шаблонів, для яких не потрібно застосовувати перехід на HTTPS, використовуйте окреме правило HttpAllowlist.";
HttpsUpgradesEnabled.pfm_title = "Увімкнути автоматичний перехід на HTTPS";
HttpsUpgradesEnabled.pfm_description = "Якщо це можливо, Brave намагається перевести трафік з HTTP на HTTPS. За допомогою цього правила можна вимкнути таку поведінку. Якщо правило не налаштувати або вибрати для нього значення \"правда\", цю функцію буде ввімкнено за умовчанням.\n\nЩоб указати список імен хостів або їх шаблонів, для яких не потрібно застосовувати перехід на HTTPS, використовуйте окреме правило HttpAllowlist.\n\nПерегляньте також правило HttpsOnlyMode.";
IPv6ReachabilityOverrideEnabled.pfm_title = "Увімкнути перевизначення перевірки доступності за протоколом IPv6";
IPv6ReachabilityOverrideEnabled.pfm_description = "Якщо для цього правила вибрати значення \"правда\", перевірку доступності за протоколом IPv6 буде перевизначено. Це означає, що під час перетворення імен хостів система завжди надсилатиме запити на записи AAAA. Це правило стосується всіх користувачів і інтерфейсів на пристрої.\n\nЯкщо це правило не налаштувати або вибрати для нього значення \"неправда\", перевірку доступності за протоколом IPv6 не буде перевизначено.\nСистема надсилатиме запит на записи AAAA, лише коли встановлюється з’єднання з глобальним хостом IPv6.";
IdleDetectionAllowedForUrls.pfm_title = "Сайти, яким дозволено виявляти неактивність";
IdleDetectionAllowedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким дозволено використовувати Idle Detection API, не надсилаючи запит користувачу. Записи із чорного списку мають вищий пріоритет, ніж записи з білого списку, які, своєю чергою, мають вищий пріоритет, ніж значення за умовчанням.\n\nДокладніше про дійсні шаблони URL-адрес сайтів можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*). Це правило враховує тільки джерела, тож шляхи в шаблонах URL-адрес ігноруються.\n\nЯкщо це правило не налаштувати, для всіх сайтів використовуватиметься глобальне значення за умовчанням, яке визначається правилом DefaultIdleDetectionSetting (якщо його налаштовано) або особистими параметрами користувача.";
IdleDetectionBlockedForUrls.pfm_title = "Сайти, яким заборонено виявляти неактивність";
IdleDetectionBlockedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким заборонено використовувати Idle Detection API.\n\nДокладніше про дійсні шаблони URL-адрес сайтів можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*). Це правило враховує тільки джерела, тож шляхи в шаблонах URL-адрес ігноруються.\n\nЯкщо це правило не налаштувати, для всіх сайтів використовуватиметься глобальне значення за умовчанням, яке визначається правилом DefaultIdleDetectionSetting (якщо його налаштовано) або особистими параметрами користувача.";
IdleTimeout.pfm_title = "Період неактивності, після якого система виконуватиме певні дії";
IdleTimeout.pfm_description = "Запускає дію, коли комп’ютер неактивний.\n\nЯкщо це правило налаштувати, воно визначає час (у хвилинах), коли не відбувається ввід користувача й після якого вебпереглядач почне виконувати дії, задані в правилі IdleTimeoutActions.\n\nЯкщо це правило не налаштувати, дії не виконуватимуться.\n\nМінімальне порогове значення – 1 хвилина.\n\nЩо саме вважається вводом користувача, визначають API операційної системи (це може бути рух мишею або введення тексту на клавіатурі).";
IdleTimeoutActions.pfm_title = "Дії, які виконуються, коли комп’ютер неактивний";
IdleTimeoutActions.pfm_description = "close_browsers - Закрити веб-переглядачі\nshow_profile_picker - Показати засіб вибору профілю\nclear_browsing_history - Очистити історію веб-перегляду\nclear_download_history - Очистити історію завантажень\nclear_cookies_and_other_site_data - Видалити файли cookie й інші дані сайтів\nclear_cached_images_and_files - Видалити кешовані зображення й файли\nclear_password_signin - Очистити дані для входу з паролем\nclear_autofill - Очистити дані автозаповнення\nclear_site_settings - Очистити налаштування сайту\nclear_hosted_app_data - Очистити дані розміщених додатків\nreload_pages - Оновити сторінки\nsign_out - Вийти\nclose_tabs - Закрити вкладки\nСписок дій, які виконуються, коли спливає час очікування, заданий у правилі IdleTimeout.\n\nПопередження. Це правило може впливати на локальні персональні дані й назавжди видаляти їх. Щоб запобігти випадковому видаленню персональних даних, рекомендуємо перевірити налаштування, перш ніж вводити їх у дію.\n\nЯкщо не налаштувати правило IdleTimeout, це правило не діятиме.\n\nКоли спливає час очікування, заданий у правилі IdleTimeout, вебпереглядач виконує дії, указані в цьому правилі.\n\nЯкщо це правило не налаштувати або не вказати для нього значення, правило IdleTimeout не діятиме.\n\nПідтримуються наведені нижче дії.\n\nclose_browsers: закрити всі вікна вебпереглядача й прогресивні вебдодатки для цього профілю. Не підтримується на пристроях Android та iOS.\n\nclose_tabs: закрити всі вкладки у відкритих вікнах. Підтримується лише на пристроях iOS.\n\nshow_profile_picker: показати вікно засобу вибору профілю. Не підтримується на пристроях Android та iOS.\n\nsign_out: вийти з поточного облікового запису користувача. Підтримується лише на пристроях iOS.\n\nclear_browsing_history, clear_download_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing, clear_autofill, clear_site_settings, clear_hosted_app_data: очистити всі відповідні дані вебперегляду. Щоб дізнатися більше, перегляньте правило ClearBrowsingDataOnExitList. На пристроях iOS підтримуються такі типи: clear_browsing_history, clear_cookies_and_other_site_data, clear_cached_images_and_files, clear_password_signing і clear_autofill.\n\nreload_pages: оновити всі вебсторінки. На деяких сторінках може знадобитися підтвердити дію. Не підтримується на пристроях iOS.\n\nЯкщо видалити файли cookie за допомогою правила clear_cookies_and_other_site_data, користувач залишиться в обліковому записі Google.\n\nЯкщо налаштувати дії clear_browsing_history, clear_password_signing, clear_autofill і clear_site_settings, синхронізацію буде деактивовано для відповідних типів даних за умови, що функцію Chrome Sync не вимкнено за допомогою правила SyncDisabled і правило BrowserSignin також не вимкнено.";
ImagesAllowedForUrls.pfm_title = "Дозволити зображення на цих сайтах";
ImagesAllowedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, які можуть показувати зображення.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultImagesSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).\n\nЗверніть увагу, що раніше це правило було помилково ввімкнено на Android, хоча його функції ніколи не підтримувалися повністю.";
ImagesBlockedForUrls.pfm_title = "Блокувати зображення на цих сайтах";
ImagesBlockedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким заборонено показувати зображення.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultImagesSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів.\n\n Докладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).\n\n Зверніть увагу: раніше це правило було помилково ввімкнено на Android, хоча його функції ніколи не підтримувалися повністю.";
ImportAutofillFormData.pfm_title = "Імпортувати дані автозаповнення форм із веб-переглядача за умовчанням під час першого запуску";
ImportAutofillFormData.pfm_description = "Якщо це правило активовано, дані автозаповнення форм із попереднього веб-переглядача за умовчанням імпортуються під час першого запуску. Якщо це правило деактивовано або не налаштовано, дані автозаповнення форм не імпортуються під час першого запуску.\n\nКористувачі можуть ініціювати вікно імпортування, а прапорець біля опції для даних автозаповнення форм буде поставлено або знято відповідно до значення правила.";
ImportBookmarks.pfm_title = "Імпорт закладок із веб-переглядача за умовчанням під час першого запуску";
ImportBookmarks.pfm_description = "Якщо це правило активовано, закладки з попереднього веб-переглядача за умовчанням імпортуються під час першого запуску. Якщо це правило деактивовано або не налаштовано, закладки не імпортуються під час першого запуску.\n\nКористувачі можуть ініціювати вікно імпортування, а прапорець біля опції для закладок буде поставлено або знято відповідно до значення правила.";
ImportHistory.pfm_title = "Імпорт історії веб-перегляду з веб-переглядача за умовчанням під час першого запуску";
ImportHistory.pfm_description = "Якщо це правило активовано, історія веб-перегляду з попереднього веб-переглядача за умовчанням імпортується під час першого запуску. Якщо це правило деактивовано або не налаштовано, історія веб-перегляду не імпортується під час першого запуску.\n\nКористувачі можуть ініціювати вікно імпортування, а прапорець біля опції для історії веб-перегляду буде поставлено або знято відповідно до значення правила.";
ImportHomepage.pfm_title = "Імпорт головної сторінки з веб-переглядача за умовчанням під час першого запуску";
ImportHomepage.pfm_description = "Якщо це правило активовано, головна сторінка з попереднього веб-переглядача за умовчанням імпортується під час першого запуску. Якщо це правило деактивовано або не налаштовано, головна сторінка не імпортується під час першого запуску.\n\nКоли користувач відкриває вікно імпорту, прапорець імпорту головної сторінки може бути встановлений або знятий відповідно до налаштувань правила.";
ImportSavedPasswords.pfm_title = "Імпорт збережених паролів із веб-переглядача за умовчанням під час першого запуску";
ImportSavedPasswords.pfm_description = "Це правило визначає, як імпортувати паролі, лише під час першого запуску після встановлення. Це допомагає спростити перехід на Brave у середовищах, де перед встановленням веб-переглядача активно використовувався інший. Це правило не впливає на можливості менеджера паролів для облікових записів Google.\n\nЯкщо ввімкнути це правило, збережені паролі з попереднього веб-переглядача за умовчанням імпортуватимуться під час першого запуску. Крім того, користувачі зможуть імпортувати їх вручну на сторінці налаштувань.\nЯкщо його вимкнути, збережені паролі не імпортуватимуться під час першого запуску й користувачі не зможуть зробити це вручну на сторінці налаштувань.\nЯкщо це правило не налаштувати, збережені паролі не імпортуватимуться під час першого запуску, але користувач зможе зробити це на сторінці налаштувань.";
ImportSearchEngine.pfm_title = "Імпорт пошукових систем із веб-переглядача за умовчанням під час першого запуску";
ImportSearchEngine.pfm_description = "Якщо це правило активовано, пошукова система за умовчанням з попереднього веб-переглядача за умовчанням імпортується під час першого запуску. Якщо це правило деактивовано або не налаштовано, пошукова система за умовчанням не імпортується під час першого запуску.\n\nКористувачі можуть вмикати вікно імпортування, а прапорець біля опції для пошукової системи буде поставлено або знято відповідно до значення правила.";
IncognitoModeAvailability.pfm_title = "Доступність режиму анонімного перегляду";
IncognitoModeAvailability.pfm_description = "0 - Режим анонімного перегляду доступний\n1 - Режим анонімного перегляду вимкнено\n2 - Примусово запускати режим анонімного перегляду\nЦе правило визначає, чи може користувач відкривати сторінки в анонімному режимі в Brave.\n\nЯкщо ввімкнути або не налаштувати це правило, сторінки можна буде відкривати в анонімному режимі.\n\nЯкщо вимкнути правило, сторінки не можна буде відкривати в анонімному режимі.\n\nЯкщо вибрати значення Forced, сторінки можна буде відкривати ЛИШЕ в анонімному режимі. Зверніть увагу: значення Forced не підтримується для Android-on-Chrome.\n\nПравило IncognitoModeUrlAllowlist має пріоритет над цим правилом і може повторно вмикати анонімний режим для певних URL-адрес. Якщо вимкнути анонімний режим за допомогою цього правила й налаштувати білий список, анонімний режим буде доступний лише для URL-адрес, які відповідають записам у білому списку, а всі інші сторінки блокуватимуться.\n\nПримітка: якщо змінити це правило під час сеансу в iOS, воно набуде чинності лише після перезапуску.";
IncognitoModeUrlAllowlist.pfm_title = "Дозволити доступ до списку URL-адрес в анонімному режимі.";
IncognitoModeUrlAllowlist.pfm_description = "За допомогою цього правила можна дозволити доступ до певного списку URL-адрес в анонімному режимі. Використовуйте його, щоб налаштувати винятки для певних шаблонів URL-адрес, визначених у правилі IncognitoModeUrlBlocklist (вимоги до формату наведено на сторінці https://support.google.com/chrome/a?p=url_blocklist_filter_format).\n\nЯкщо налаштувати обидва правила (IncognitoModeUrlBlocklist і це), білий список матиме пріоритет. Якщо URL-адреса відповідає шаблону з білого списку, її буде дозволено. Якщо вона відповідає шаблону із чорного списку (однак не збігається з жодним записом у білому), її буде заблоковано. Якщо URL-адреса не відповідає жодному із цих правил, застосовуватимуться загальні правила URLBlocklist/URLAllowlist.\n\nЯкщо налаштувати це правило, однак не налаштувати IncognitoModeUrlBlocklist, усі URL-адреси, яких немає в білому списку, буде заблоковано в анонімному режимі.\n\nЯкщо для правила IncognitoModeAvailability вибрано значення Disallow (1), однак налаштовано це правило, анонімний режим буде доступний лише для URL-адрес із білого списку.\n\nЯкщо це правило не налаштувати, для правил IncognitoModeUrlBlocklist і IncognitoModeAvailability не буде винятків.\n\nЦе правило діє лише в анонімному режимі. Щоб дозволити доступ до URL-адрес для всіх профілів користувачів, скористайтеся правилом URLAllowlist.\n\nУніверсальні символи підстановки (наприклад, \"*\" або \"[*]\") використовувати не можна. Щоб увімкнути цю функцію для всіх вебсайтів, застосуйте правило IncognitoModeAvailability.\n\nМаксимальна кількість записів у цьому правилі – 1000.";
IncognitoModeUrlBlocklist.pfm_title = "Блокувати доступ до списку URL-адрес в анонімному режимі.";
IncognitoModeUrlBlocklist.pfm_description = "За допомогою правила IncognitoModeUrlBlocklist можна заборонити завантаження вебсторінок за певними URL-адресами в анонімному режимі. Адміністратор може вказати список шаблонів URL-адрес, які потрібно блокувати. Вимоги до формату шаблонів URL-адрес наведено на сторінці https://support.google.com/chrome/a?p=url_blocklist_filter_format.\n\nЯкщо налаштувати і це правило, і IncognitoModeUrlAllowlist, білий список матиме перевагу. Якщо URL-адреса відповідає шаблону з білого списку, її буде дозволено. Якщо вона відповідає шаблону із чорного списку (однак не збігається з жодним записом у білому), її буде заблоковано. Якщо URL-адреса не відповідає жодному із цих правил, застосовуватимуться загальні правила URLBlocklist/URLAllowlist.\n\nЯкщо не налаштувати це правило, однак налаштувати IncognitoModeUrlAllowlist, усі URL-адреси, яких немає в білому списку, буде заблоковано в анонімному режимі.\n\nЯкщо для правила IncognitoModeAvailability вибрано значення Disallow (1), однак налаштовано правило IncognitoModeUrlAllowlist, анонімний режим буде доступний лише для URL-адрес із білого списку.\n\nЦе правило діє лише в анонімному режимі. Щоб заблокувати доступ до URL-адрес для всіх профілів користувачів, скористайтеся правилом URLBlocklist.\n\nМаксимальна кількість записів у цьому правилі – 1000.";
InsecureContentAllowedForUrls.pfm_title = "Дозволити незахищений контент на цих сайтах";
InsecureContentAllowedForUrls.pfm_description = "За допомогою цього правила можна налаштувати список шаблонів URL-адрес, що визначають сайти, яким дозволено показувати змішаний контент (HTTP на сайтах HTTPS), який можна блокувати (тобто активний), і для яких буде вимкнено оновлення змішаного контенту, що необов’язково блокується (тобто пасивного).\n\nЯкщо це правило не налаштувати, змішаний контент, який можна блокувати, блокуватиметься, а той, що необов’язково блокується, оновиться, і користувачі зможуть указати винятки для певних сайтів.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).";
InsecureContentBlockedForUrls.pfm_title = "Блокувати незахищений контент на цих сайтах";
InsecureContentBlockedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким заборонено показувати змішаний контент (HTTP на сайтах HTTPS), який можна блокувати (тобто активний), і для яких буде оновлено змішаний контент, що необов’язково блокується (тобто пасивний).\n\nЯкщо це правило не налаштувати, активний змішаний контент блокуватиметься, а пасивний змішаний контент буде оновлено, проте користувачі зможуть указати винятки для певних сайтів.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).";
IntensiveWakeUpThrottlingEnabled.pfm_title = "Керування функцією IntensiveWakeUpThrottling.";
IntensiveWakeUpThrottlingEnabled.pfm_description = "Якщо функцію IntensiveWakeUpThrottling увімкнено, таймери JavaScript на фонових вкладках суттєво обмежують пропускну здатність і об’єднуються, запускаючись щонайбільше раз на хвилину після того, як вкладка була у фоновому режимі принаймні 5 хвилин.\n\nЦя функція відповідає веб-стандартам, але через неї деякі веб-сайти\nможуть працювати неправильно, оскільки виникатиме затримка певних дій на\nчас до хвилини. Однак вона сприяє значній економії ЦП та\nзаряду. Докладніше читайте на сторінці https://bit.ly/30b1XR4.\n\nЯкщо правило ввімкнути, цю функцію буде примусово ввімкнено й\nкористувачі не зможуть це змінити.\n\nЯкщо правило вимкнути, цю функцію буде примусово вимкнено й\nкористувачі не зможуть це змінити.\n\nЯкщо це правило не налаштовано, функція керуватиметься\nвнутрішньою логікою, яку користувачі можуть налаштувати вручну.\n\nЗауважте, що це правило застосовується для кожного окремого процесу обробки. Коли він починається,\nдіє останнє застосоване значення правила. Щоб\nправило почало діяти для всіх завантажених вкладок, потрібно повністю\nперезапустити веб-переглядач. Процеси можуть запускатися з різними значеннями\nдля цього правила.\n";
IntranetRedirectBehavior.pfm_title = "Поведінка переспрямування інтранет";
IntranetRedirectBehavior.pfm_description = "0 - Використовувати поведінку веб-переглядача за умовчанням.\n1 - Вимкнути перевірки перехоплення системи DNS та інформаційні панелі \"можливо, ви мали на увазі\" http://intranetsite/.\n2 - Вимкнути перевірки перехоплення системи DNS; дозволити інформаційні панелі \"можливо, ви мали на увазі\" http://intranetsite/.\n3 - Дозволити перевірки перехоплення системи DNS та інформаційні панелі \"можливо, ви мали на увазі\" http://intranetsite/.\nЗа допомогою цього правила можна налаштувати поведінку переспрямування інтранет через перевірки перехоплення системи DNS. Ці перевірки виявляють, чи працює веб-переглядач через проксі-сервер, який переспрямовує невідомі імена хостів.\n\nЯкщо правило не налаштовано, веб-переглядач використовуватиме поведінку перевірки перехоплення системи DNS за умовчанням і підказки щодо переспрямування інтранет. У версії M88 ці параметри увімкнено за умовчанням, але в наступних випусках їх буде вимкнено.\n\nDNSInterceptionChecksEnabled – пов'язане правило, за допомогою якого також можна вимкнути перевірки перехоплення системи DNS. Це правило зручніше, оскільки за допомогою нього можна окремо контролювати інформаційні панелі переспрямування інтранет, а також у майбутньому його можуть розширити.\nЯкщо відповідно до налаштувань цього правила або правила DNSInterceptionChecksEnabled перевірки перехоплення треба вимкнути, їх буде вимкнено.";
IsolateOrigins.pfm_title = "Увімкнути Ізоляцію сайтів для вказаних джерел";
IsolateOrigins.pfm_description = "За допомогою цього правила можна вказати список джерел, для яких запускатимуться окремі процеси.\n\nНа пристроях Android це правило працює лише за наявності достатнього обсягу пам’яті (понад 3,2 ГБ оперативної пам’яті), оскільки ізоляція завеликої кількості сайтів на пристроях з обмеженими ресурсами може спричинити проблеми з продуктивністю. Для пристроїв Android з обмеженими ресурсами використовуйте правило IsolateOriginsShortlist.\n\nНа пристроях з обсягом пам’яті менше ніж 1 ГБ не рекомендується налаштовувати ізоляцію процесів.\n\nКожен відповідний процес може містити лише документи із цього джерела і його субдоменів. Наприклад, якщо вказати https://a1.example.com/, то https://a2.a1.example.com/ зможе відкриватися в цьому ж процесі, а https://example.com чи https://b.example.com – ні.\n\nПочинаючи з версії Brave 77, ви можете скористатися символом підстановки, щоб указати діапазон джерел для ізоляції. Наприклад, якщо вказати https://[*.]corp.example.com, кожне джерело в домені https://corp.example.com відкриватиметься окремо (зокрема https://corp.example.com, https://a1.corp.example.com і https://a2.a1.corp.example.com).\n\nЗверніть увагу, що всі сайти (схема плюс eTLD+1, як-от https://example.com) уже ізольовані за умовчанням на платформах для ПК, як зазначено в правилі SitePerProcess). Для ізоляції певних джерел із вищим рівнем деталізації (наприклад, https://a.example.com) використовують правило IsolateOrigins.\n\nЗверніть увагу, що, починаючи з версії Brave 77, Android за умовчанням ізолює окремі сайти із чутливою інформацією, а це правило розширює цей режим і ізолює окремі додаткові джерела.\n\nТакож зверніть увагу, що джерела, ізольовані правилом, не можуть створювати скрипти для інших джерел на цьому сайті, однак це можливо, коли два документи з одного сайту мають однакові значення параметра document.domain. Адміністратори повинні підтвердити, що ця нетипова поведінка не використовується в джерелі, перш ніж ізолювати його.\n\nЯкщо вказати для цього правила пустий рядок або не налаштувати його, ізоляція сайтів не вимагатиметься для певних джерел. Користувачі зможуть увімкнути ізоляцію процесів вручну через експериментальний параметр командного рядка.";
JavaScriptAllowedForUrls.pfm_title = "Дозволити JavaScript на цих сайтах";
JavaScriptAllowedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, які можуть запускати JavaScript.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultJavaScriptSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).";
JavaScriptBlockedForUrls.pfm_title = "Блокувати JavaScript на цих сайтах";
JavaScriptBlockedForUrls.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким заборонено запускати JavaScript.\n\nЯкщо це правило не налаштувати, до всіх сайтів застосовуватиметься правило DefaultJavaScriptSetting за умови, що воно налаштоване. Якщо ні, використовуються особисті налаштування користувачів.\n\nДокладніше про дійсні шаблони url-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).\n\nЗверніть увагу, що це правило блокує JavaScript на основі того, чи відповідає джерело документа верхнього рівня (зазвичай це URL-адреса сторінки, яка також відображається в адресному рядку) якомусь шаблону. Тому це правило не підходить для протидії атакам на мережу постачання. Наприклад, якщо вказати шаблон \"https://[*.]foo.com/\", на сторінці, яку розміщено в домені https://example.com, усе одно можна буде запустити скрипт, завантажений зі сторінки https://www.foo.com/example.js. Крім того, якщо вказати шаблон \"https://example.com/\", у документі із цього домену (крім документів верхнього рівня) усе одно можна буде запускати скрипти за умови, що його вбудовано як додатковий фрейм на сторінці, розміщеній в іншому джерелі (як-от https://www.bar.com).";
JavaScriptJitAllowedForSites.pfm_title = "Дозволити JavaScript використовувати JIT-компілятор на цих сайтах";
JavaScriptJitAllowedForSites.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким дозволено запускати JavaScript з увімкненим JIT-компілятором.\n\nДокладніше про дійсні шаблони URL-адрес сайтів можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).\n\nВинятки із цього правила можна налаштувати на рівні певних субдоменів або цілих сайтів. Наприклад, правило, налаштоване лише для субдомену subdomen.sait.com, застосовується до нього, однак не впливає на сайт sait.com. У деяких випадках, коли субдомен не можна ізолювати від батьківського сайту, він може успадкувати правило, налаштоване для сайту site.com. Крім того, винятки можуть не застосовуватися до фреймів, завантажених у наявній вкладці, доки сайт не буде відкрито в новій вкладці. На пристроях Android із невеликим обсягом пам’яті винятки для певних сайтів можуть не застосовуватися. Натомість сайти використовуватимуть правило DefaultJavaScriptJitSetting (якщо його налаштовано) або за умовчанням застосовуватимуть налаштування JIT-компілятора JavaScript для профілю.\n\nЩоб застосувати винятки, Brave може розміщувати сайти або субдомени, налаштування яких відрізняються від стандартних, в окремих процесах. Це може збільшити використання пам’яті, особливо на пристроях Android або коли шаблон із символом підстановки відповідає багатьом субдоменам, оскільки кожне відповідне джерело може ізолюватися окремо. Ізольовані субдомени також не можуть використовувати document.domain для доступу до батьківського сайту.\n\nПримітка: у версії 155 і раніших винятки з правила застосовувалися лише на рівні сайту (eTLD+1). Правило, налаштоване лише для субдомену subdomen.sait.com, не застосовувалося навіть до нього. Щоб воно діяло для сайтів site.com і subdomen.sait.com, його потрібно було налаштувати для сайту sait.com.\n\nЦе правило застосовується до кожного фрейму окремо, а не лише на основі URL-адреси джерела верхнього рівня. Наприклад, якщо сайт sait-odyn.com указано в правилі JavaScriptJitAllowedForSites, однак він завантажує фрейм із сайтом sait-dva.com, то для сайту site-one.com JIT-компілятор JavaScript буде ввімкнено, а для сайту sait-dva.com застосовуватиметься правило DefaultJavaScriptJitSetting (за умови, що його налаштовано) або JIT-компілятор JavaScript буде ввімкнено за умовчанням. Записи із чорного списку мають вищий пріоритет, ніж записи з білого списку, які, своєю чергою, мають вищий пріоритет, ніж значення за умовчанням.\n\nЯкщо не налаштувати це правило для сайту, застосовується правило DefaultJavaScriptJitSetting за умови, що його налаштовано. Якщо ні, для сайту буде ввімкнено JIT-компілятор JavaScript.";
JavaScriptJitBlockedForSites.pfm_title = "Заборонити JavaScript використовувати JIT-компілятор на цих сайтах";
JavaScriptJitBlockedForSites.pfm_description = "За допомогою цього правила можна вказати список шаблонів URL-адрес, що визначають сайти, яким заборонено запускати JavaScript з увімкненим JIT-компілятором.\n\nЯкщо вимкнути JIT-компілятор JavaScript, Brave може відображати контент повільніше, а деякі частини JavaScript (зокрема WebAssembly) вимикатимуться. Крім того, Brave відображатиме вебконтент у надійнішій конфігурації.\n\nДокладніше про дійсні шаблони URL-адрес можна дізнатися на сторінці https://chromeenterprise.google/policies/url-patterns. Дозволяються символи підстановки (*).\n\nВинятки із цього правила можна налаштувати на рівні певних субдоменів або цілих сайтів. Наприклад, правило, налаштоване лише для субдомену subdomain.site.com, застосовується до нього, однак не впливає на сайт site.com. У деяких випадках, коли субдомен не можна ізолювати від батьківського сайту, він може успадкувати правило, налаштоване для сайту site.com. Крім того, винятки можуть не застосовуватися до фреймів, завантажених у наявній вкладці, доки сайт не буде відкрито в новій вкладці. На пристроях Android із невеликим обсягом пам’яті винятки для певних сайтів можуть не застосовуватися. Натомість сайти використовуватимуть правило DefaultJavaScriptJitSetting (якщо його налаштовано) або за умовчанням дотримуватимуться налаштування JIT-компілятора JavaScript для профілю.\n\nЩоб застосувати винятки, Brave може розміщувати сайти або субдомени, налаштування яких відрізняються від стандартних, в окремих процесах. Це може збільшити використання пам’яті, особливо на пристроях Android або коли шаблон із символом підстановки відповідає багатьом субдоменам, оскільки кожне відповідне джерело може ізолюватися окремо. Ізольовані субдомени також не можуть використовувати document.domain для доступу до батьківського сайту.\n\nПримітка: у версії 155 і раніших винятки з правила застосовувалися лише на рівні сайту (eTLD+1). Правило, налаштоване лише для субдомену subdomain.site.com, не застосовувалося навіть до нього. Щоб воно діяло для сайтів site.com і subdomain.site.com, його потрібно було налаштувати для сайту site.com.\n\nЦе правило застосовується до кожного фрейму окремо, а не лише на основі URL-адреси джерела верхнього рівня. Наприклад, якщо сайт site-one.com указано в правилі JavaScriptJitBlockedForSites, однак він завантажує фрейм із сайтом site-two.com, то для сайту site-one.com JIT-компілятор JavaScript буде вимкнено, а для сайту site-two.com застосовуватиметься правило DefaultJavaScriptJitSetting (якщо його налаштовано) або JIT-компілятор JavaScript буде ввімкнено за умовчанням. Записи із чорного списку мають вищий пріоритет, ніж записи з білого списку, які, своєю чергою, мають вищий пріоритет, ніж значення за умовчанням.\n\nЯкщо не налаштувати це правило для сайту, застосовується правило DefaultJavaScriptJitSetting за умови, що його налаштовано. Якщо ні, для сайту буде ввімкнено JIT-компілятор JavaScript.";
JavaScriptOptimizerAllowedForSites.pfm_title = "Дозволити оптимізацію JavaScript на вибраних сайтах";
